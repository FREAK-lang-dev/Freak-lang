static inline void aria_a(uint32_t *a, uint32_t *b,
                          uint32_t *c, uint32_t *d)
{
    uint32_t ta, tb, tc;
    ta  =  *b;                      
    *b  =  *a;                      
    *a  =  ARIA_P2(ta);             
    tb  =  ARIA_P2(*d);             
    *d  =  ARIA_P1(*c);             
    *c  =  ARIA_P1(tb);             
    ta  ^= *d;                      
    tc  =  ARIA_P2(*b);             
    ta  =  ARIA_P1(ta) ^ tc ^ *c;   
    tb  ^= ARIA_P2(*d);             
    tc  ^= ARIA_P1(*a);             
    *b  ^= ta ^ tb;                 
    tb  =  ARIA_P2(tb) ^ ta;        
    *a  ^= ARIA_P1(tb);             
    ta  =  ARIA_P2(ta);             
    *d  ^= ARIA_P1(ta) ^ tc;        
    tc  =  ARIA_P2(tc);             
    *c  ^= ARIA_P1(tc) ^ ta;        
}

