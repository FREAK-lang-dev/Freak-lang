static int x509_cn_looks_like_uri(const char *cn)
{
    const char *end = strchr(cn, ':');
    if (end == NULL || end == cn) {
        return 0;
    }

    for (const char *p = cn; p < end; p++) {
        if (!((*p >= 'a' && *p <= 'z') ||
              (*p >= 'A' && *p <= 'Z') ||
              (*p >= '0' && *p <= '9') ||
              *p == '+' || *p == '-' || *p == '.')) {
            return 0;
        }
    }

    return 1;
}

