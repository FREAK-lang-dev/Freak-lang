static int x509_cn_looks_like_dns(const char *cn, int compat_mode)
{
    if (*cn == '\0') {
        return 0;
    }

    for (const char *p = cn; *p != '\0'; p++) {
         
        if ((*p >= 'a' && *p <= 'z') ||
            (*p >= 'A' && *p <= 'Z') ||
            (*p >= '0' && *p <= '9') ||
            *p == '-' || *p == '.') {
            continue;
        }

         
        if (compat_mode == 1 && (*p == '_' || (unsigned char) *p >= 0x80)) {
            continue;
        }

        return 0;
    }

    return 1;
}

