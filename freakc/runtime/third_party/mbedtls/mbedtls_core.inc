static int x509_crt_check_dns_name(const mbedtls_x509_buf *name,
                                   const char *cn, size_t cn_len)
{
     
    if (name->len == cn_len &&
        x509_memcasecmp(cn, name->p, cn_len) == 0) {
        return 0;
    }

     
    if (x509_check_dns_wildcard(cn, cn_len, name) == 0) {
        return 0;
    }

    return -1;
}

