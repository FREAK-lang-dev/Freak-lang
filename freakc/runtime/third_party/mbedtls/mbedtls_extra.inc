#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)
    mbedtls_free(ch1_sni_name);
#endif
#if defined(MBEDTLS_USE_PSA_CRYPTO)
    psa_hash_abort(&saved_transcript);
#else
    mbedtls_md_free(&saved_transcript);
#endif
    return ret;
