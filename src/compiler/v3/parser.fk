-- ===================================================================
-- FREAK v3 COMPILER — PARSER
-- ===================================================================
-- Recursive descent parser. Builds AST in parallel arrays.
-- v3 changes: flat if chains (no else-if nesting), early returns.

task cur_tok_type() -> word {
    give back array_get(tok_types, parse_idx)
}

task cur_tok_val() -> word {
    give back array_get(tok_vals, parse_idx)
}

task parser_at_eof() -> bool {
    give back cur_tok_type() == TOK_EOF or cur_tok_type() == ""
}

task current_source_col() -> int {
    if parse_idx < 0 or parse_idx >= tokens_count { give back 1 }
    pilot col = word_to_int(array_get(tok_cols, parse_idx))
    if col <= 0 { col = 1 }
    give back col
}

task parser_diag_unclosed_at(context: word, closer: word, opener_file: word, opener_line: int, opener_col: int) -> void {
    diag_error_at(
        "unexpected end of file inside " + context,
        "expected '" + closer + "' for opener here",
        opener_file,
        opener_line,
        opener_col
    )
}

task parser_take_ident(context: word) -> word {
    if cur_tok_type() == TOK_IDENT {
        pilot value = cur_tok_val()
        advance_tok()
        give back value
    }
    diag_error(
        "expected an identifier for " + context + ", found " + friendly_tok(cur_tok_type(), cur_tok_val()),
        "use an identifier here"
    )
    if not parser_at_eof() { advance_tok() }
    give back ""
}

-- V3 supports concrete dynamic-list annotations without general generics.
task parser_take_type(context: word) -> word {
    pilot name = parser_take_ident(context)
    if name == "List" and cur_tok_val() == "<" {
        advance_tok()
        pilot element = parser_take_ident("list element type")
        if cur_tok_val() == ">" { advance_tok() }
        else { diag_error("expected '>' after list element type", "use List<int>, List<num>, List<bool>, List<word>, or List<Shape>") }
        give back "List<" + element + ">"
    }
    give back name
}

task advance_tok() -> void {
    parse_idx += 1
}

task match_tok(type: word, val: word) -> bool {
    if cur_tok_type() == type {
        if val == "" or cur_tok_val() == val {
            advance_tok()
            give back true
        }
    }
    give back false
}

task expect_tok(type: word, val: word) -> void {
    if not match_tok(type, val) {
        pilot expected = ""
        if type == TOK_IDENT and val == "" { expected = "an identifier" }
        if type == TOK_PUNCT { expected = "'" + val + "'" }
        if type == TOK_KW    { expected = "keyword '" + val + "'" }
        if expected == ""    { expected = "'" + val + "'" }
        pilot found_tok = friendly_tok(cur_tok_type(), cur_tok_val())
        diag_error("expected " + expected + ", found " + found_tok, "")
        if cur_tok_type() != TOK_EOF and cur_tok_type() != "" {
            advance_tok()
        }
    }
}

task current_source_line() -> word {
    if parse_idx < 0 or parse_idx >= tokens_count {
        give back "1"
    }
    -- Origin lines are captured before legacy combined-source adjustment, so
    -- prepended std modules and the user file keep independent line spaces.
    pilot line_no = word_to_int(array_get(tok_origin_lines, parse_idx))
    if line_no <= 0 { line_no = 1 }
    give back word_from_int(line_no)
}

task current_source_file() -> word {
    if parse_idx < 0 or parse_idx >= tokens_count { give back input_file }
    give back array_get(tok_origin_files, parse_idx)
}

task current_source_location() -> word {
    pilot location_id = array_len(source_location_lines)
    array_push(source_location_lines, current_source_line())
    array_push(source_location_files, current_source_file())
    give back "@" + word_from_int(location_id)
}

-- ===================== EXPRESSION PARSING ============================

task parser_interp_path_valid(path: word) -> bool {
    if path.length() == 0 { give back false }
    pilot i = 0
    pilot at_segment_start = true
    pilot segment = ""
    repeat path.length() times {
        pilot c = path.char_at(i)
        if c == "." {
            if at_segment_start { give back false }
            if lex_ident_token_type(segment) != TOK_IDENT { give back false }
            at_segment_start = true
            segment = ""
        } else if at_segment_start {
            if not is_alphabetic(c) { give back false }
            at_segment_start = false
            segment = segment + c
        } else if not is_alnum_ext(c) {
            give back false
        } else {
            segment = segment + c
        }
        i += 1
    }
    if at_segment_start { give back false }
    give back lex_ident_token_type(segment) == TOK_IDENT
}

task parser_interp_append(segments: word, expr_id: int) -> word {
    if segments == "" { give back word_from_int(expr_id) }
    give back segments + "," + word_from_int(expr_id)
}

task parser_alloc_interp_path(path: word, origin_file: word, origin_line: word) -> int {
    pilot segment = ""
    pilot expr_id = 0 - 1
    pilot i = 0
    repeat until i > path.length() {
        pilot at_end = i == path.length()
        pilot c = ""
        if not at_end { c = path.char_at(i) }
        if at_end or c == "." {
            if expr_id < 0 {
                expr_id = alloc_expr_at(EXPR_IDENT, segment, "", "", origin_file, origin_line)
            } else {
                expr_id = alloc_expr_at(EXPR_FIELD, segment, word_from_int(expr_id), "", origin_file, origin_line)
            }
            segment = ""
        } else {
            segment = segment + c
        }
        i += 1
    }
    give back expr_id
}

task parser_interp_expression_like(body: word) -> bool {
    -- Object/JSON-like brace text has an established literal contract.
    if body.contains(":") { give back false }
    pilot text = body.trim()
    if text == "" { give back false }
    pilot first = text.char_at(0)
    give back is_alphabetic(first) or is_numeric(first) or first == "(" or first == "+" or first == "-" or first == "!"
}

task parser_interp_unclosed_expression_like(body: word) -> bool {
    if not parser_interp_expression_like(body) { give back false }
    if parser_interp_path_valid(body.trim()) { give back true }
    give back body.contains("(") or body.contains("+") or body.contains("-") or body.contains("*") or body.contains("/") or body.contains("=")
}

task parser_alloc_string_expr(value: word, origin_file: word, origin_line: word, origin_column: int) -> int {
    pilot segments = ""
    pilot literal = ""
    pilot has_path = false
    pilot i = 0
    repeat until i >= value.length() {
        pilot c = value.char_at(i)
        if c == "{" {
            pilot close = i + 1
            repeat until close >= value.length() or value.char_at(close) == "}" { close += 1 }
            if close < value.length() {
                pilot body = value.substring(i + 1, close - i - 1)
                if parser_interp_path_valid(body) {
                    if literal != "" {
                        pilot literal_id = alloc_expr_at(EXPR_STR, literal, "", "", origin_file, origin_line)
                        segments = parser_interp_append(segments, literal_id)
                        literal = ""
                    }
                    pilot path_id = parser_alloc_interp_path(body, origin_file, origin_line)
                    segments = parser_interp_append(segments, path_id)
                    has_path = true
                    i = close + 1
                } else {
                    if parser_interp_expression_like(body) {
                        diag_error_at("unsupported interpolation expression", "use a binding or field path, or escape literal braces", origin_file, word_to_int(origin_line), origin_column)
                    }
                    literal = literal + value.substring(i, close - i + 1)
                    i = close + 1
                }
            } else {
                if parser_interp_unclosed_expression_like(value.substring(i + 1, value.length() - i - 1)) {
                    diag_error_at("unterminated interpolation expression", "close the field path or escape the literal brace", origin_file, word_to_int(origin_line), origin_column)
                }
                literal = literal + c
                i += 1
            }
        } else {
            literal = literal + c
            i += 1
        }
    }
    if not has_path { give back alloc_expr_at(EXPR_STR, value, "", "", origin_file, origin_line) }
    if literal != "" {
        pilot literal_id = alloc_expr_at(EXPR_STR, literal, "", "", origin_file, origin_line)
        segments = parser_interp_append(segments, literal_id)
    }
    give back alloc_expr_at(EXPR_INTERP, "", segments, "", origin_file, origin_line)
}

task parser_decimal_integer(spelling: word) -> word {
    pilot start = 0
    repeat until start + 1 >= spelling.length() or spelling.char_at(start) != "0" {
        start += 1
    }
    give back spelling.substring(start, spelling.length() - start)
}

task parse_primary() -> int {
    pilot ttype = cur_tok_type()
    pilot tval = cur_tok_val()
    pilot expr_file = current_source_file()
    pilot expr_line = current_source_line()
    pilot expr_column = current_source_col()

    if ttype == TOK_EOF or ttype == "" {
        diag_error("expected an expression, found end of file", "complete the expression")
        give back 0 - 1
    }

    if ttype == TOK_NUM {
        advance_tok()
        pilot is_float = false
        pilot nci = 0
        pilot nclen = tval.length()
        repeat nclen times {
            if tval.char_at(nci) == "." { is_float = true }
            nci += 1
        }
        if is_float { give back alloc_expr_at(EXPR_FLOAT, tval, "", "", expr_file, expr_line) }
        give back alloc_expr_at(EXPR_INT, parser_decimal_integer(tval), "", "", expr_file, expr_line)
    }
    if ttype == TOK_STR {
        advance_tok()
        give back parser_alloc_string_expr(tval, expr_file, expr_line, expr_column)
    }
    if ttype == TOK_BOOL {
        advance_tok()
        pilot truth = tval.to_lower()
        if truth == "true" or truth == "yes" or truth == "hai" { truth = "true" }
        else { truth = "false" }
        give back alloc_expr_at(EXPR_BOOL, truth, "", "", expr_file, expr_line)
    }
    if ttype == TOK_IDENT {
        advance_tok()

        -- Namespace: foo::bar
        if match_tok(TOK_PUNCT, "::") {
            pilot ntval = ""
            -- The checked status operation is a reserved arm keyword only
            -- outside this frozen builtin namespace.
            if tval == "json_document" and cur_tok_type() == TOK_KW and cur_tok_val() == "ok" {
                ntval = cur_tok_val()
                advance_tok()
            } else {
                ntval = parser_take_ident("namespace segment after '::'")
            }
            if ntval != "" {
                tval = tval + "::" + ntval
            }
        }
        -- Shape constructor: Name { field: val, ... }
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "{" {
            if is_shape_name(tval) {
                pilot ctor_file = current_source_file()
                pilot ctor_line = word_to_int(current_source_line())
                pilot ctor_col = current_source_col()
                advance_tok()
                pilot val_ids = ""
                pilot field_labels = ""
                pilot cfin = false
                pilot cis_first = true
                if match_tok(TOK_PUNCT, "}") { cfin = true }
                repeat until cfin {
                    if parser_at_eof() {
                        parser_diag_unclosed_at("shape constructor", "}", ctor_file, ctor_line, ctor_col)
                        cfin = true
                    } else {
                        pilot fname = parser_take_ident("shape constructor field")
                        expect_tok(TOK_PUNCT, ":")
                        pilot fval_id = parse_expr()
                        if cis_first {
                            val_ids = word_from_int(fval_id)
                            field_labels = fname
                            cis_first = false
                        } else {
                            val_ids = val_ids + "," + word_from_int(fval_id)
                            field_labels = field_labels + "," + fname
                        }
                        if match_tok(TOK_PUNCT, "}") { cfin = true }
                        else if parser_at_eof() {
                            parser_diag_unclosed_at("shape constructor", "}", ctor_file, ctor_line, ctor_col)
                            cfin = true
                        } else { expect_tok(TOK_PUNCT, ",") }
                    }
                }
                pilot ctor_id = alloc_expr_at(EXPR_CALL, "shape::ctor::" + tval, val_ids, "", expr_file, expr_line)
                array_set(ast_expr_labels, ctor_id, field_labels)
                give back ctor_id
            }
        }

        -- Function call: name(args)
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "(" {
            pilot call_file = current_source_file()
            pilot call_line = word_to_int(current_source_line())
            pilot call_col = current_source_col()
            advance_tok()
            pilot args = ""
            pilot fin = false
            pilot is_first = true
            if match_tok(TOK_PUNCT, ")") { fin = true }
            repeat until fin {
                if parser_at_eof() {
                    parser_diag_unclosed_at("call argument list", ")", call_file, call_line, call_col)
                    fin = true
                } else {
                    pilot arg_id = parse_expr()
                    if is_first {
                        args = word_from_int(arg_id)
                        is_first = false
                    } else {
                        args = args + "," + word_from_int(arg_id)
                    }
                    if match_tok(TOK_PUNCT, ")") { fin = true }
                    else if parser_at_eof() {
                        parser_diag_unclosed_at("call argument list", ")", call_file, call_line, call_col)
                        fin = true
                    } else { expect_tok(TOK_PUNCT, ",") }
                }
            }
            give back alloc_expr_at(EXPR_CALL, tval, args, "", expr_file, expr_line)
        }

        give back alloc_expr_at(EXPR_IDENT, tval, "", "", expr_file, expr_line)
    }

    -- Parenthesized expression
    if ttype == TOK_PUNCT and tval == "(" {
        pilot paren_file = current_source_file()
        pilot paren_line = word_to_int(current_source_line())
        pilot paren_col = current_source_col()
        advance_tok()
        pilot inner = parse_expr()
        if parser_at_eof() {
            parser_diag_unclosed_at("parenthesized expression", ")", paren_file, paren_line, paren_col)
        } else {
            expect_tok(TOK_PUNCT, ")")
        }
        give back inner
    }

    -- Array literal: `[expr, expr, ...]`.  Stored as EXPR_ARRAY_LIT with
    -- the element expr ids encoded the same way call args are: comma-
    -- separated list of word-from-int ids in `left`.  Lowering happens
    -- in the emitters: array_new() then array_push() per element.
    if ttype == TOK_PUNCT and tval == "[" {
        pilot array_file = current_source_file()
        pilot array_line = word_to_int(current_source_line())
        pilot array_col = current_source_col()
        advance_tok()
        pilot elem_ids = ""
        pilot afin = false
        pilot afirst = true
        if match_tok(TOK_PUNCT, "]") { afin = true }
        repeat until afin {
            if parser_at_eof() {
                parser_diag_unclosed_at("array literal", "]", array_file, array_line, array_col)
                afin = true
            }
            else {
                pilot e_id = parse_expr()
                if afirst {
                    elem_ids = word_from_int(e_id)
                    afirst = false
                } else {
                    elem_ids = elem_ids + "," + word_from_int(e_id)
                }
                if match_tok(TOK_PUNCT, "]") { afin = true }
                else if parser_at_eof() {
                    parser_diag_unclosed_at("array literal", "]", array_file, array_line, array_col)
                    afin = true
                } else { expect_tok(TOK_PUNCT, ",") }
            }
        }
        give back alloc_expr_at(EXPR_ARRAY_LIT, "", elem_ids, "", expr_file, expr_line)
    }

    diag_error("unexpected " + friendly_tok(ttype, tval) + " — this token cannot start an expression", "")
    if ttype != TOK_EOF and ttype != "" { advance_tok() }
    give back 0 - 1
}

task parse_postfix() -> int {
    pilot left = parse_primary()
    pilot fin = false
    repeat until fin {
        pilot postfix_file = current_source_file()
        pilot postfix_line = current_source_line()
        if match_tok(TOK_PUNCT, ".") {
            pilot mname = parser_take_ident("member name")
            if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "(" {
                -- Method call: .name(args)
                pilot method_file = current_source_file()
                pilot method_line = word_to_int(current_source_line())
                pilot method_col = current_source_col()
                advance_tok()
                pilot args = ""
                pilot argfin = false
                pilot is_first = true
                if match_tok(TOK_PUNCT, ")") { argfin = true }
                repeat until argfin {
                    if parser_at_eof() {
                        parser_diag_unclosed_at("method argument list", ")", method_file, method_line, method_col)
                        argfin = true
                    }
                    else {
                        pilot arg_id = parse_expr()
                        if is_first {
                            args = word_from_int(arg_id)
                            is_first = false
                        } else {
                            args = args + "," + word_from_int(arg_id)
                        }
                        if match_tok(TOK_PUNCT, ")") { argfin = true }
                        else if parser_at_eof() {
                            parser_diag_unclosed_at("method argument list", ")", method_file, method_line, method_col)
                            argfin = true
                        } else { expect_tok(TOK_PUNCT, ",") }
                    }
                }
                left = alloc_expr_at(EXPR_METHOD, mname, word_from_int(left), args, postfix_file, postfix_line)
            } else {
                -- Field access: .name
                left = alloc_expr_at(EXPR_FIELD, mname, word_from_int(left), "", postfix_file, postfix_line)
            }
        } else if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "[" {
            pilot index_file = current_source_file()
            pilot index_line = word_to_int(current_source_line())
            pilot index_col = current_source_col()
            advance_tok()
            pilot idx_expr = parse_expr()
            if parser_at_eof() {
                parser_diag_unclosed_at("index expression", "]", index_file, index_line, index_col)
            } else {
                expect_tok(TOK_PUNCT, "]")
            }
            left = alloc_expr_at(EXPR_INDEX, "", word_from_int(left), word_from_int(idx_expr), postfix_file, postfix_line)
        } else if match_tok(TOK_PUNCT, "|>") {
            -- Pipe: a |> f(args) => f(a, args)
            pilot fname = parser_take_ident("pipe target")
            pilot pipe_args = word_from_int(left)
            if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "(" {
                pilot pipe_file = current_source_file()
                pilot pipe_line = word_to_int(current_source_line())
                pilot pipe_col = current_source_col()
                advance_tok()
                if not match_tok(TOK_PUNCT, ")") {
                    pilot pfin = false
                    repeat until pfin {
                        if parser_at_eof() {
                            parser_diag_unclosed_at("pipe argument list", ")", pipe_file, pipe_line, pipe_col)
                            pfin = true
                        } else {
                            pilot parg_id = parse_expr()
                            pipe_args = pipe_args + "," + word_from_int(parg_id)
                            if match_tok(TOK_PUNCT, ")") { pfin = true }
                            else if parser_at_eof() {
                                parser_diag_unclosed_at("pipe argument list", ")", pipe_file, pipe_line, pipe_col)
                                pfin = true
                            } else { expect_tok(TOK_PUNCT, ",") }
                        }
                    }
                }
            }
            left = alloc_expr_at(EXPR_CALL, fname, pipe_args, "", postfix_file, postfix_line)
        } else {
            fin = true
        }
    }
    give back left
}

-- v3: flat if with early return (no else-if nesting)
task parse_unary() -> int {
    pilot unary_file = current_source_file()
    pilot unary_line = current_source_line()
    if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "!" {
        diag_error("prefix '!' is not supported — logical NOT is spelled 'not'", "write 'not' here")
        advance_tok()
        pilot op = parse_unary()
        give back alloc_expr_at(EXPR_UNARYOP, "not", word_from_int(op), "", unary_file, unary_line)
    }
    if match_tok(TOK_KW, "not") {
        pilot op = parse_unary()
        give back alloc_expr_at(EXPR_UNARYOP, "not", word_from_int(op), "", unary_file, unary_line)
    }
    if match_tok(TOK_PUNCT, "-") {
        pilot op = parse_unary()
        give back alloc_expr_at(EXPR_UNARYOP, "-", word_from_int(op), "", unary_file, unary_line)
    }
    if match_tok(TOK_KW, "PLUS ULTRA") {
        pilot op = parse_unary()
        give back alloc_expr_at(EXPR_UNARYOP, "PLUS ULTRA", word_from_int(op), "", unary_file, unary_line)
    }
    if match_tok(TOK_KW, "FINAL FORM") {
        pilot op = parse_unary()
        give back alloc_expr_at(EXPR_UNARYOP, "FINAL FORM", word_from_int(op), "", unary_file, unary_line)
    }
    if match_tok(TOK_KW, "TSUNDERE") {
        pilot op = parse_unary()
        give back alloc_expr_at(EXPR_UNARYOP, "TSUNDERE", word_from_int(op), "", unary_file, unary_line)
    }
    give back parse_postfix()
}

-- Precedence: or < and < comparison < add < mul < unary < postfix

task parse_mul() -> int {
    pilot left = parse_unary()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "*" or tval == "/" or tval == "%" {
            pilot op_file = current_source_file()
            pilot op_line = current_source_line()
            advance_tok()
            pilot right = parse_unary()
            left = alloc_expr_at(EXPR_BINOP, tval, word_from_int(left), word_from_int(right), op_file, op_line)
        } else {
            fin = true
        }
    }
    give back left
}

task parse_add() -> int {
    pilot left = parse_mul()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "+" or tval == "-" or tval == "NAKAMA" {
            pilot op_file = current_source_file()
            pilot op_line = current_source_line()
            advance_tok()
            pilot right = parse_mul()
            left = alloc_expr_at(EXPR_BINOP, tval, word_from_int(left), word_from_int(right), op_file, op_line)
        } else {
            fin = true
        }
    }
    give back left
}

task parse_comparison() -> int {
    pilot left = parse_add()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "==" or tval == "!=" or tval == "<" or tval == ">" or tval == "<=" or tval == ">=" {
            pilot op_file = current_source_file()
            pilot op_line = current_source_line()
            advance_tok()
            pilot right = parse_add()
            left = alloc_expr_at(EXPR_BINOP, tval, word_from_int(left), word_from_int(right), op_file, op_line)
        } else {
            fin = true
        }
    }
    give back left
}

-- C-family logic operators are not FREAK: '&&', '||' and prefix '!' are
-- spelled 'and', 'or' and 'not'. Name the FREAK spelling and keep parsing as
-- if it had been written, so the typo costs one diagnostic, not a cascade.
task parser_c_logic_op() -> word {
    if cur_tok_type() != TOK_PUNCT { give back "" }
    pilot tval = cur_tok_val()
    if tval == "||" { give back "or" }
    if tval == "&" and parse_idx + 1 < tokens_count {
        if array_get(tok_types, parse_idx + 1) == TOK_PUNCT and array_get(tok_vals, parse_idx + 1) == "&" {
            give back "and"
        }
    }
    give back ""
}

task parser_take_c_logic_op(freak_op: word) -> void {
    pilot c_op = "&&"
    pilot meaning = "AND"
    if freak_op == "or" {
        c_op = "||"
        meaning = "OR"
    }
    diag_error(
        "'" + c_op + "' is not a FREAK operator — logical " + meaning + " is spelled '" + freak_op + "'",
        "write '" + freak_op + "' here"
    )
    advance_tok()
    if c_op == "&&" { advance_tok() }
}

task parse_and() -> int {
    pilot left = parse_comparison()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        pilot c_op = parser_c_logic_op()
        if tval == "and" or c_op == "and" {
            pilot op_file = current_source_file()
            pilot op_line = current_source_line()
            if c_op == "and" { parser_take_c_logic_op("and") } else { advance_tok() }
            pilot right = parse_comparison()
            left = alloc_expr_at(EXPR_BINOP, "and", word_from_int(left), word_from_int(right), op_file, op_line)
        } else {
            fin = true
        }
    }
    give back left
}

task parse_expr() -> int {
    pilot left = parse_and()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        pilot c_op = parser_c_logic_op()
        if tval == "or" or c_op == "or" {
            pilot op_file = current_source_file()
            pilot op_line = current_source_line()
            if c_op == "or" { parser_take_c_logic_op("or") } else { advance_tok() }
            pilot right = parse_and()
            left = alloc_expr_at(EXPR_BINOP, "or", word_from_int(left), word_from_int(right), op_file, op_line)
        } else {
            fin = true
        }
    }
    give back left
}

-- ===================== BLOCK + STATEMENT PARSING =====================

-- Separators belong to statement lists, not expression parsing. In
-- particular, keep header semicolons available to counted-loop parsing.
task parser_skip_statement_separators() -> void {
    repeat until cur_tok_type() != TOK_PUNCT or cur_tok_val() != ";" {
        advance_tok()
    }
}

task parse_block() -> word {
    pilot opener_file = current_source_file()
    pilot opener_line = word_to_int(current_source_line())
    pilot opener_col = 1
    if parse_idx >= 0 and parse_idx < tokens_count { opener_col = word_to_int(array_get(tok_cols, parse_idx)) }
    expect_tok(TOK_PUNCT, "{")
    pilot block = ""
    pilot fin = false
    pilot is_first = true
    parser_skip_statement_separators()
    if match_tok(TOK_PUNCT, "}") { fin = true }
    repeat until fin {
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            diag_error_at("unexpected end of file — missing '}'", "block opened here", opener_file, opener_line, opener_col)
            fin = true
        } else {
            pilot stmt_id = parse_stmt()
            if is_first {
                block = word_from_int(stmt_id)
                is_first = false
            } else {
                block = block + "," + word_from_int(stmt_id)
            }
            parser_skip_statement_separators()
            if match_tok(TOK_PUNCT, "}") { fin = true }
        }
    }
    give back block
}

task parse_stmt() -> int {
    pilot ttype = cur_tok_type()
    pilot tval = cur_tok_val()

    -- Skip @annotations
    if ttype == TOK_PUNCT and tval == "@" {
        advance_tok()
        parser_take_ident("annotation name")
        ttype = cur_tok_type()
        tval = cur_tok_val()
    }

    pilot stmt_line = current_source_location()

    -- say expr
    if match_tok(TOK_KW, "say") {
        pilot expr_id = parse_expr()
        give back alloc_stmt(STMT_SAY, "", word_from_int(expr_id), "", "", "", "", "", stmt_line)
    }

    -- shape Name { field: type, ... }
    if match_tok(TOK_KW, "shape") {
        give back parse_shape()
    }

    -- impl Name { task ... }
    if match_tok(TOK_KW, "impl") {
        give back parse_impl()
    }

    -- eventually { body }
    if match_tok(TOK_KW, "eventually") {
        pilot ev_body = parse_block()
        give back alloc_stmt(STMT_EVENTUALLY, "", "", ev_body, "", "", "", "", stmt_line)
    }

    -- The fixed marker is enforced by the always-on semantic checker.
    if ttype == TOK_KW and (tval == "fixed" or tval == "grounded pilot") {
        advance_tok()
        pilot binding_mode = "fixed"
        if tval == "grounded pilot" { binding_mode = "grounded" }
        if binding_mode == "fixed" and not match_tok(TOK_KW, "pilot") {
            diag_error("expected 'pilot' after 'fixed'", "")
        }
        pilot fname = parser_take_ident("fixed binding name")
        pilot ftype_ann = ""
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == ":" {
            advance_tok()
            ftype_ann = parser_take_type("fixed binding type")
        }
        expect_tok(TOK_PUNCT, "=")
        pilot fexpr_id = parse_expr()
        pilot fixed_id = alloc_stmt(STMT_PILOT, fname, word_from_int(fexpr_id), "", "", ftype_ann, "", "", stmt_line)
        array_set(ast_pilot_is_mut, fixed_id, binding_mode)
        give back fixed_id
    }

    -- pilot [mut] name = expr
    if match_tok(TOK_KW, "pilot") {
        pilot is_mut = true
        if match_tok(TOK_KW, "mut") { is_mut = true }
        pilot name = parser_take_ident("binding name")
        pilot type_ann = ""
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == ":" {
            advance_tok()
            type_ann = parser_take_type("binding type")
        }
        expect_tok(TOK_PUNCT, "=")
        pilot expr_id = parse_expr()
        pilot stmt_id = alloc_stmt(STMT_PILOT, name, word_from_int(expr_id), "", "", type_ann, "", "", stmt_line)
        if is_mut { array_set(ast_pilot_is_mut, stmt_id, "1") }
        give back stmt_id
    }

    -- give back expr
    if match_tok(TOK_KW, "give back") {
        pilot expr_id = 0 - 1
        if cur_tok_type() != TOK_PUNCT or (cur_tok_val() != "}" and cur_tok_val() != ";") {
            expr_id = parse_expr()
        }
        give back alloc_stmt(STMT_GIVE_BACK, "", word_from_int(expr_id), "", "", "", "", "", stmt_line)
    }

    if match_tok(TOK_KW, "for each") {
        pilot binder = parser_take_ident("iteration binding")
        expect_tok(TOK_KW, "in")
        pilot receiver = parse_expr()
        if cur_tok_type() == TOK_PUNCT and (cur_tok_val() == ".." or cur_tok_val() == "..=") {
            pilot inclusive = cur_tok_val()
            advance_tok()
            pilot upper = parse_expr()
            pilot step = alloc_expr(EXPR_INT, "1", "", "")
            if cur_tok_type() == TOK_IDENT and cur_tok_val() == "step" { advance_tok() step = parse_expr() }
            pilot body = parse_block()
            give back alloc_stmt(STMT_RANGE, binder, word_from_int(receiver), body, word_from_int(upper), word_from_int(step), inclusive, "", stmt_line)
        }
        pilot body = parse_block()
        give back alloc_stmt(STMT_FOREACH, binder, word_from_int(receiver), body, "", "", "", "", stmt_line)
    }

    -- break / continue
    if match_tok(TOK_KW, "for") {
        expect_tok(TOK_PUNCT, "(")
        pilot valid_initializer = cur_tok_type() == TOK_KW and cur_tok_val() == "pilot"
        if not valid_initializer { diag_error("counted for initializer must start with pilot", "") }
        pilot initializer = parse_stmt()
        if array_get(ast_stmt_kinds, initializer) != STMT_PILOT { diag_error("counted for initializer must be a pilot binding", "") }
        if valid_initializer { array_set(ast_pilot_is_mut, initializer, "1") }
        expect_tok(TOK_PUNCT, ";")
        pilot condition = parse_expr()
        expect_tok(TOK_PUNCT, ";")
        pilot step = parse_stmt()
        pilot step_kind: word = array_get(ast_stmt_kinds, step)
        if step_kind != STMT_ASSIGN and step_kind != STMT_EXPR { diag_error("counted for step must be an assignment or expression", "") }
        expect_tok(TOK_PUNCT, ")")
        pilot body = parse_block()
        give back alloc_stmt(STMT_FOR, "", word_from_int(condition), body, word_from_int(initializer), word_from_int(step), "", "", stmt_line)
    }

    -- break / continue
    if match_tok(TOK_KW, "break") {
        give back alloc_stmt(STMT_BREAK, "", "", "", "", "", "", "", stmt_line)
    }
    if match_tok(TOK_KW, "continue") {
        give back alloc_stmt(STMT_CONTINUE, "", "", "", "", "", "", "", stmt_line)
    }

    -- if expr { body } else { body }
    if match_tok(TOK_KW, "if") {
        pilot expr_id = parse_expr()
        pilot body_id = parse_block()
        pilot else_body = ""
        if match_tok(TOK_KW, "else") {
            if cur_tok_type() == TOK_KW and cur_tok_val() == "if" {
                pilot elif_id = parse_stmt()
                else_body = word_from_int(elif_id)
            } else {
                else_body = parse_block()
            }
        }
        give back alloc_stmt(STMT_IF, "", word_from_int(expr_id), body_id, else_body, "", "", "", stmt_line)
    }

    -- Both spellings use the same pretest loop and positive condition.
    if match_tok(TOK_KW, "while") {
        pilot expr_id = parse_expr()
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_REPEAT, "while", word_from_int(expr_id), body_id, "", "", "", "", stmt_line)
    }

    -- repeat until/while cond { body }  /  repeat N times { body }
    if match_tok(TOK_KW, "repeat") {
        if match_tok(TOK_KW, "until") {
            pilot expr_id = parse_expr()
            pilot body_id = parse_block()
            give back alloc_stmt(STMT_REPEAT, "until", word_from_int(expr_id), body_id, "", "", "", "", stmt_line)
        }
        if match_tok(TOK_KW, "while") {
            pilot expr_id = parse_expr()
            pilot body_id = parse_block()
            give back alloc_stmt(STMT_REPEAT, "while", word_from_int(expr_id), body_id, "", "", "", "", stmt_line)
        }
        pilot expr_id = parse_expr()
        expect_tok(TOK_KW, "times")
        pilot binder = ""
        if cur_tok_type() == TOK_IDENT and cur_tok_val() == "with" { advance_tok() binder = parser_take_ident("repeat iteration binding") }
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_REPEAT, "times", word_from_int(expr_id), body_id, "", binder, "", "", stmt_line)
    }

    -- training arc until cond max N sessions { body }
    if match_tok(TOK_KW, "training arc") {
        expect_tok(TOK_KW, "until")
        pilot cond_id = parse_expr()
        expect_tok(TOK_KW, "max")
        pilot max_id = parse_expr()
        expect_tok(TOK_KW, "sessions")
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_TRAINING_ARC, "", word_from_int(cond_id), body_id, "", word_from_int(max_id), "", "", stmt_line)
    }

    if match_tok(TOK_KW, "check") {
        expect_tok(TOK_KW, "result")
        give back parse_check_result()
    }

    -- when expr { val -> stmt, ... }
    if match_tok(TOK_KW, "when") {
        give back parse_when()
    }

    -- extern task name(params) -> ret
    if match_tok(TOK_KW, "extern") {
        give back parse_extern()
    }

    -- task name(params) -> ret { body }
    if match_tok(TOK_KW, "task") {
        give back parse_task_def()
    }

    -- Bare block { ... }
    if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "{" {
        pilot block_id = parse_block()
        give back alloc_stmt(STMT_BLOCK, "", "", block_id, "", "", "", "", stmt_line)
    }

    -- Expression statement (or assignment)
    pilot expr_id = parse_expr()

    if match_tok(TOK_PUNCT, "=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "+=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "+=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "-=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "-=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "*=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "*=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "/=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "/=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "%=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "%=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }

    give back alloc_stmt(STMT_EXPR, "", word_from_int(expr_id), "", "", "", "", "", stmt_line)
}

-- ===================== HELPER PARSE TASKS ============================
-- v3: Split out from parse_stmt to keep functions short.

task parse_params(opener_file: word, opener_line: int, opener_col: int) -> word {
    pilot params = ""
    pilot fin = false
    pilot is_first = true
    if match_tok(TOK_PUNCT, ")") { fin = true }
    repeat until fin {
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            parser_diag_unclosed_at("parameter list", ")", opener_file, opener_line, opener_col)
            fin = true
        } else {
            pilot pname = parser_take_ident("parameter name")
            if pname == "self" {
                if match_tok(TOK_PUNCT, ")") { fin = true }
                else { expect_tok(TOK_PUNCT, ",") }
                if is_first {
                    params = "self:word"
                    is_first = false
                } else {
                    params = params + ",self:word"
                }
            } else {
                expect_tok(TOK_PUNCT, ":")
                pilot ptype = parser_take_type("parameter type")
                pilot pstr = pname + ":" + ptype
                if is_first {
                    params = pstr
                    is_first = false
                } else {
                    params = params + "," + pstr
                }
                if match_tok(TOK_PUNCT, ")") { fin = true }
                else { expect_tok(TOK_PUNCT, ",") }
            }
        }
    }
    give back params
}

task parse_shape() -> int {
    pilot stmt_line = current_source_location()
    pilot shape_name = parser_take_ident("shape name")
    pilot shape_file = current_source_file()
    pilot shape_line = word_to_int(current_source_line())
    pilot shape_col = current_source_col()
    expect_tok(TOK_PUNCT, "{")
    pilot fields = ""
    pilot sfin = false
    pilot sis_first = true
    repeat until sfin {
        if match_tok(TOK_PUNCT, "}") {
            sfin = true
        } else if parser_at_eof() {
            parser_diag_unclosed_at("shape declaration", "}", shape_file, shape_line, shape_col)
            sfin = true
        } else {
            pilot fname = parser_take_ident("shape field name")
            expect_tok(TOK_PUNCT, ":")
            pilot ftype = parser_take_type("shape field type")
            if sis_first {
                fields = fname + ":" + ftype
                sis_first = false
            } else {
                fields = fields + "," + fname + ":" + ftype
            }
            -- Field commas are separators, including the conventional
            -- trailing comma before `}` used throughout std/math3d.fk.
            match_tok(TOK_PUNCT, ",")
        }
    }
    register_shape(shape_name, fields)
    give back alloc_stmt(STMT_SHAPE, shape_name, "", "", "", fields, "", "", stmt_line)
}

task parse_impl() -> int {
    pilot stmt_line = current_source_location()
    pilot doctrine_name = parser_take_ident("impl target")
    pilot impl_name = doctrine_name
    -- Doctrine implementations use `impl Doctrine for Shape`.  Methods are
    -- nominally owned by the shape, not by the doctrine: several shapes may
    -- implement Add/Eq without colliding in the native symbol namespace.
    -- Keep accepting the legacy/direct `impl Shape { ... }` form.
    if match_tok(TOK_KW, "for") {
        impl_name = parser_take_ident("impl owner")
    }
    pilot impl_file = current_source_file()
    pilot impl_line = word_to_int(current_source_line())
    pilot impl_col = current_source_col()
    expect_tok(TOK_PUNCT, "{")

    pilot impl_fin = false
    repeat until impl_fin {
        if match_tok(TOK_PUNCT, "}") {
            impl_fin = true
        } else if parser_at_eof() {
            parser_diag_unclosed_at("impl declaration", "}", impl_file, impl_line, impl_col)
            impl_fin = true
        } else if cur_tok_type() == TOK_KW and cur_tok_val() == "task" {
            -- Capture the method declaration's own `task` token before
            -- consuming it. Reusing the outer impl location made signature
            -- and missing-return diagnostics point at `impl` instead.
            pilot method_stmt_line = current_source_location()
            advance_tok()
            pilot mname = parser_take_ident("impl method name")
            pilot params_file = current_source_file()
            pilot params_line = word_to_int(current_source_line())
            pilot params_col = current_source_col()
            expect_tok(TOK_PUNCT, "(")
            pilot params = parse_params(params_file, params_line, params_col)
            -- `self` is parsed generically, then specialized here once the
            -- owning impl shape is known. Emitters can now resolve duplicate
            -- field and method names through the receiver's actual shape.
            if params == "self:word" { params = "self:" + impl_name }
            else if params.starts_with("self:word,") {
                params = "self:" + impl_name + params.substring(9, params.length() - 9)
            } else {
                params = params.replace(",self:word", ",self:" + impl_name)
            }
            pilot ret_type = "void"
            if match_tok(TOK_PUNCT, "->") {
                ret_type = parser_take_type("impl method return type")
            }
            pilot body_id = parse_block()
            pilot full_name = impl_name + "_" + mname
            -- Preserve impl provenance separately from the mangled task name.
            -- The always-on nominal checker must not accept a free task named
            -- `Shape_method` as proof that `Shape.method` exists.
            pilot sid = alloc_stmt(STMT_TASK, full_name, "", body_id, "", "impl:" + impl_name, params, ret_type, method_stmt_line)
            array_push(ast_top_stmts, word_from_int(sid))
        } else {
            diag_error(
                "unexpected " + friendly_tok(cur_tok_type(), cur_tok_val()) + " inside impl declaration",
                "expected keyword 'task' or '}'"
            )
            if not parser_at_eof() { advance_tok() }
        }
    }
    -- Keep the declaration itself in the AST even when it has no methods.
    -- The semantic pass must validate the owner and top-level context; method
    -- tasks remain separately indexed for instance/associated dispatch.
    give back alloc_stmt(STMT_IMPL, impl_name, "", "", "", doctrine_name, "", "", stmt_line)
}

-- The v3.5 result slice is closed to the checked file-read carrier. Each arm
-- introduces one owned word in its own block; both alternatives are required.
task parse_check_result() -> int {
    pilot stmt_line = current_source_location()
    pilot target = parse_expr()
    expect_tok(TOK_PUNCT, "{")
    pilot ok_name = ""
    pilot err_name = ""
    pilot ok_body = ""
    pilot err_body = ""
    pilot finished = false
    repeat until finished {
        parser_skip_statement_separators()
        if match_tok(TOK_PUNCT, "}") { finished = true }
        else if parser_at_eof() {
            diag_error("unclosed check result block", "expected '}'")
            finished = true
        } else {
            pilot arm = cur_tok_val()
            if not match_tok(TOK_KW, "ok") and not match_tok(TOK_KW, "err") {
                diag_error("check result arm must be ok or err", "")
                advance_tok()
            }
            expect_tok(TOK_PUNCT, "(")
            pilot binder = parser_take_ident("check result arm binding")
            expect_tok(TOK_PUNCT, ")")
            expect_tok(TOK_PUNCT, "->")
            pilot body = parse_block()
            if arm == "ok" {
                if ok_name != "" { diag_error("duplicate ok arm in check result", "") }
                ok_name = binder
                ok_body = body
            } else if arm == "err" {
                if err_name != "" { diag_error("duplicate err arm in check result", "") }
                err_name = binder
                err_body = body
            }
        }
    }
    if ok_name == "" or err_name == "" { diag_error("check result requires exactly one ok arm and one err arm", "") }
    give back alloc_stmt(STMT_CHECK_RESULT, "", word_from_int(target), ok_body, err_body, "", ok_name, err_name, stmt_line)
}

task parse_when() -> int {
    pilot stmt_line = current_source_location()
    pilot target_id = parse_expr()
    pilot when_file = current_source_file()
    pilot when_line = word_to_int(current_source_line())
    pilot when_col = current_source_col()
    expect_tok(TOK_PUNCT, "{")
    pilot cases_str = ""
    pilot fin = false
    pilot is_first = true
    repeat until fin {
        parser_skip_statement_separators()
        if match_tok(TOK_PUNCT, "}") {
            fin = true
        } else if parser_at_eof() {
            parser_diag_unclosed_at("when expression", "}", when_file, when_line, when_col)
            fin = true
        } else {
            pilot case_expr = 0 - 1
            if match_tok(TOK_IDENT, "_") {
                case_expr = 0 - 1
            } else {
                case_expr = parse_expr()
            }
            expect_tok(TOK_PUNCT, "->")
            pilot stmt_id = parse_stmt()
            pilot case_str = word_from_int(case_expr) + ":" + word_from_int(stmt_id)
            if is_first {
                cases_str = case_str
                is_first = false
            } else {
                cases_str = cases_str + "," + case_str
            }
            parser_skip_statement_separators()
        }
    }
    give back alloc_stmt(STMT_WHEN, "", word_from_int(target_id), cases_str, "", "", "", "", stmt_line)
}

-- ===================== NATIVE FFI (bible 16.2) =========================
-- extern [C, link="name"] { task f(a: c_int) -> c_int }
-- extern [C, load="name"] { ... }   -- resolved at run time on first call
-- Each member becomes an STMT_EXTERN whose params/returns are the FREAK-side
-- types (int, num, bool, void) and whose extra field carries the C ABI:
--   ffi|MODE|LIBRARY|SYMBOL|RET_ABI|PARAM_ABI,PARAM_ABI,...
-- MODE is link, load or none. ABI codes: i8 i16 i32 i64 u8 u16 u32 u64 char
-- long ulong bool f32 f64 ptr void.

task ffi_host_target_os() -> word {
    if ffi_target_os != "" { give back ffi_target_os }
    pilot triple = cross_target
    if triple != "" {
        if triple.contains("linux") or triple.contains("android") { ffi_target_os = "linux" }
        else if triple.contains("darwin") or triple.contains("macos") or triple.contains("apple") { ffi_target_os = "darwin" }
        else if triple.contains("windows") or triple.contains("mingw") or triple.contains("msvc") or triple.contains("w64") { ffi_target_os = "windows" }
    }
    if ffi_target_os == "" {
        if process::platform_is_windows() { ffi_target_os = "windows" }
        else {
            pilot uname = process::exec_capture("uname -s 2>/dev/null").trim()
            if uname == "Darwin" { ffi_target_os = "darwin" } else { ffi_target_os = "linux" }
        }
    }
    give back ffi_target_os
}

task ffi_host_target_arch() -> word {
    if ffi_target_arch != "" { give back ffi_target_arch }
    pilot triple = cross_target
    if triple != "" {
        if triple.starts_with("aarch64") or triple.starts_with("arm64") { ffi_target_arch = "aarch64" }
        else { ffi_target_arch = "x86_64" }
    }
    if ffi_target_arch == "" {
        if process::platform_is_windows() { ffi_target_arch = "x86_64" }
        else {
            pilot machine = process::exec_capture("uname -m 2>/dev/null").trim()
            if machine == "aarch64" or machine == "arm64" { ffi_target_arch = "aarch64" } else { ffi_target_arch = "x86_64" }
        }
    }
    give back ffi_target_arch
}

-- Reads one type in an extern [C] signature, returning "ABI|FREAK" or "" after
-- a diagnostic. Pointers are addresses (FREAK int) and C widths behave as int.
task ffi_take_c_type(context: word, is_return: bool) -> word {
    if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "*" {
        advance_tok()
        if cur_tok_type() == TOK_IDENT and cur_tok_val() == "const" { advance_tok() }
        else if cur_tok_type() == TOK_KW and cur_tok_val() == "mut" { advance_tok() }
        -- The pointee is documentation in V3.5; any type (including another
        -- pointer or c_void) is accepted and the value travels as an address.
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "*" { ffi_take_c_type(context, false) }
        else { ffi_take_path_ident(context) }
        give back "ptr|int"
    }
    pilot name = ffi_take_path_ident(context)
    if name == "" { give back "" }
    -- Only the bible 16.1 std::ffi aliases cross the boundary, so the same
    -- declarations compile under V4: int, num and bool promise no C width.
    if name == "isize" or name == "c_isize" { give back "i64|int" }
    if name == "usize" or name == "c_size" { give back "u64|int" }
    if name == "c_int" { give back "i32|int" }
    if name == "c_uint" { give back "u32|int" }
    if name == "c_short" { give back "i16|int" }
    if name == "c_ushort" { give back "u16|int" }
    if name == "c_uchar" { give back "u8|int" }
    if name == "c_char" { give back "char|int" }
    if name == "c_long" { give back "long|int" }
    if name == "c_ulong" { give back "ulong|int" }
    if name == "c_bool" { give back "bool|bool" }
    if name == "c_double" { give back "f64|num" }
    if name == "c_float" { give back "f32|num" }
    if is_return and (name == "void" or name == "c_void") { give back "void|void" }
    if name == "int" or name == "uint" or name == "tiny" or name == "bool" or name == "num" or name == "float" or name == "float32" or name == "char" {
        diag_error("type '" + name + "' is a FREAK type, not a C type, in " + context, "use a std::ffi alias: c_int, c_uint, c_long, c_short, c_char, c_uchar, c_bool, c_double, c_float, usize or isize")
        give back ""
    }
    if name == "word" {
        diag_error("word is not FFI-safe in " + context, "a FREAK word is not a char*; take *const c_char and pass ffi::cstring(text) (use std::ffi)")
        give back ""
    }
    if name == "void" or name == "c_void" {
        diag_error("c_void is only valid behind a pointer or as a return type in " + context, "write *mut c_void for an opaque handle")
        give back ""
    }
    diag_error("type '" + name + "' is not FFI-safe in " + context, "use a std::ffi alias (c_int, c_long, c_double, usize, ...) or a raw pointer *T")
    give back ""
}

-- std::ffi::c_int and c_int name the same type.
task ffi_take_path_ident(context: word) -> word {
    pilot name = parser_take_ident(context)
    repeat until not (cur_tok_type() == TOK_PUNCT and cur_tok_val() == "::") {
        advance_tok()
        name = parser_take_ident(context)
    }
    give back name
}

task ffi_abi_part(entry: word, index: int) -> word {
    pilot current = 0
    pilot part = ""
    pilot i = 0
    repeat entry.length() times {
        pilot c = entry.char_at(i)
        if c == "|" {
            if current == index { give back part }
            current += 1
            part = ""
        } else { part = part + c }
        i += 1
    }
    if current == index { give back part }
    give back ""
}

task ffi_record_link_lib(lib: word) -> void {
    if not ffi_link_libs.contains("|" + lib + "|") {
        if ffi_link_libs == "" { ffi_link_libs = "|" }
        ffi_link_libs = ffi_link_libs + lib + "|"
    }
}

-- The ffi|... extra of an extern [C] member named `name`, or "" for plain
-- bootstrap externs. Backends call this per call site; extern sets are small.
task ffi_extern_extra(name: word) -> word {
    pilot i = 0
    repeat array_len(ast_top_stmts) times {
        pilot sid = word_to_int(array_get(ast_top_stmts, i))
        if array_get(ast_stmt_kinds, sid) == STMT_EXTERN and array_get(ast_stmt_names, sid) == name {
            pilot extra: word = array_get(ast_stmt_extras, sid)
            if extra.starts_with("ffi|") { give back extra }
            give back ""
        }
        i += 1
    }
    give back ""
}

-- std::ffi builtins: C strings, raw memory and manual library loading.
task ffi_builtin_ret(name: word) -> word {
    if name == "ffi::cstring" or name == "ffi::alloc" or name == "ffi::open" or name == "ffi::symbol" { give back "int" }
    if name == "ffi::from_cstring" or name == "ffi::last_error" { give back "word" }
    if name == "ffi::free" or name == "ffi::close" { give back "void" }
    if name == "ffi::read_i8" or name == "ffi::read_u8" or name == "ffi::read_i16" or name == "ffi::read_u16" { give back "int" }
    if name == "ffi::read_i32" or name == "ffi::read_u32" or name == "ffi::read_i64" { give back "int" }
    if name == "ffi::read_f32" or name == "ffi::read_f64" { give back "num" }
    if name == "ffi::write_i8" or name == "ffi::write_u8" or name == "ffi::write_i16" or name == "ffi::write_u16" { give back "void" }
    if name == "ffi::write_i32" or name == "ffi::write_u32" or name == "ffi::write_i64" { give back "void" }
    if name == "ffi::write_f32" or name == "ffi::write_f64" { give back "void" }
    give back ""
}

task ffi_builtin_params(name: word) -> word {
    if name == "ffi::cstring" or name == "ffi::open" { give back "word" }
    if name == "ffi::symbol" { give back "int,word" }
    if name == "ffi::last_error" { give back "" }
    if name == "ffi::write_f32" or name == "ffi::write_f64" { give back "int,num" }
    if name.starts_with("ffi::write_") { give back "int,int" }
    give back "int"
}

-- LLVM carriers differ from the C backend for words and num bits.
task ffi_builtin_llvm_bridge(name: word) -> bool {
    if name == "ffi::cstring" or name == "ffi::from_cstring" or name == "ffi::open" or name == "ffi::symbol" or name == "ffi::last_error" { give back true }
    give back name == "ffi::read_f32" or name == "ffi::read_f64" or name == "ffi::write_f32" or name == "ffi::write_f64"
}

task ffi_builtin_names() -> word {
    pilot names = "cstring|from_cstring|alloc|free|open|symbol|close|last_error|"
    names = names + "read_i8|read_u8|read_i16|read_u16|read_i32|read_u32|read_i64|read_f32|read_f64|"
    give back names + "write_i8|write_u8|write_i16|write_u16|write_i32|write_u32|write_i64|write_f32|write_f64|"
}

task ffi_program_has_ffi() -> bool {
    pilot i = 0
    repeat array_len(ast_top_stmts) times {
        pilot sid = word_to_int(array_get(ast_top_stmts, i))
        if array_get(ast_stmt_kinds, sid) == STMT_EXTERN and array_get(ast_stmt_extras, sid).starts_with("ffi|") { give back true }
        i += 1
    }
    give back false
}

-- Field 1 mode, 2 library, 3 symbol, 4 return ABI, 5 comma-separated params.
task ffi_field(extra: word, index: int) -> word {
    give back ffi_abi_part(extra, index)
}

task ffi_param_count(extra: word) -> int {
    pilot params = ffi_field(extra, 5)
    if params == "" { give back 0 }
    pilot count = 1
    pilot i = 0
    repeat params.length() times {
        if params.char_at(i) == "," { count += 1 }
        i += 1
    }
    give back count
}

task ffi_param_abi(extra: word, index: int) -> word {
    pilot params = ffi_field(extra, 5)
    pilot current = 0
    pilot part = ""
    pilot i = 0
    repeat params.length() times {
        pilot c = params.char_at(i)
        if c == "," {
            if current == index { give back part }
            current += 1
            part = ""
        } else { part = part + c }
        i += 1
    }
    if current == index { give back part }
    give back ""
}

task ffi_abi_is_unsigned(abi: word) -> bool {
    if abi == "u8" or abi == "u16" or abi == "u32" or abi == "u64" or abi == "ulong" or abi == "bool" { give back true }
    if abi == "char" { give back ffi_host_target_arch() == "aarch64" and ffi_host_target_os() == "linux" }
    give back false
}

task ffi_abi_is_float(abi: word) -> bool {
    give back abi == "f32" or abi == "f64"
}

-- Parses one extern [ ... ] { ... } block at top level. Each member is pushed
-- to ast_top_stmts directly; members of a block whose `if target_os = "x"`
-- does not match the target are parsed and dropped.
task parse_extern_block() -> void {
    pilot block_file = current_source_file()
    pilot block_line = word_to_int(current_source_line())
    pilot block_col = current_source_col()
    expect_tok(TOK_PUNCT, "[")
    pilot mode = "none"
    pilot library = ""
    pilot language_seen = false
    pilot active = true
    pilot afin = false
    if match_tok(TOK_PUNCT, "]") { afin = true }
    repeat until afin {
        if parser_at_eof() {
            parser_diag_unclosed_at("extern ABI list", "]", block_file, block_line, block_col)
            afin = true
        } else if cur_tok_type() == TOK_KW and cur_tok_val() == "if" {
            advance_tok()
            pilot cond_name = parser_take_ident("extern target condition")
            expect_tok(TOK_PUNCT, "=")
            pilot cond_value = ""
            if cur_tok_type() == TOK_STR { cond_value = cur_tok_val() advance_tok() }
            else { diag_error("expected a quoted value after " + cond_name + " =", "write if target_os = \"windows\"") }
            if cond_name == "target_os" {
                pilot wanted = cond_value
                if wanted == "macos" { wanted = "darwin" }
                if wanted != ffi_host_target_os() { active = false }
            } else if cond_name == "target_arch" {
                pilot wanted_arch = cond_value
                if wanted_arch == "arm64" { wanted_arch = "aarch64" }
                if wanted_arch != ffi_host_target_arch() { active = false }
            } else {
                diag_error("unknown extern condition '" + cond_name + "'", "V3.5 supports if target_os = \"...\" and if target_arch = \"...\"")
            }
        } else {
            pilot opt = ""
            if cur_tok_type() == TOK_IDENT or cur_tok_type() == TOK_KW { opt = cur_tok_val() advance_tok() }
            else { diag_error("expected an extern ABI option, found " + friendly_tok(cur_tok_type(), cur_tok_val()), "write extern [C] or extern [C, link=\"name\"]") advance_tok() }
            if opt == "link" or opt == "load" {
                expect_tok(TOK_PUNCT, "=")
                if cur_tok_type() == TOK_STR {
                    if mode != "none" { diag_error("an extern block takes one link= or load= option", "split the declarations into one block per library") }
                    library = cur_tok_val()
                    mode = opt
                    advance_tok()
                    if library == "" { diag_error("extern " + opt + " needs a library name", "write " + opt + "=\"m\" or another quoted native library name") }
                } else {
                    diag_error("extern " + opt + " needs string literal", "write " + opt + "=\"m\" or another quoted native library name")
                    if not parser_at_eof() { advance_tok() }
                }
            } else if opt == "C" or opt == "cdecl" or opt == "system" {
                if language_seen and opt == "C" { diag_error("duplicate extern language ABI", "C appears more than once in this extern block") }
                if opt == "C" { language_seen = true }
            } else if opt == "win64" or opt == "sysv64" {
                -- x86_64 only has one C convention per OS; accept the native one.
                pilot native_cc = "sysv64"
                if ffi_host_target_os() == "windows" { native_cc = "win64" }
                if opt != native_cc { diag_error("calling convention " + opt + " does not match this target", "V3.5 calls with the target's C convention; use extern [C] or extern [system]") }
            } else if opt == "stdcall" or opt == "fastcall" or opt == "thiscall" or opt == "vectorcall" {
                diag_error("calling convention " + opt + " is not supported by V3.5 yet", "use extern [C] or extern [system] (x86_64 and arm64 use the C convention)")
            } else if opt != "" {
                diag_error("unknown extern ABI option " + opt, "supported: C, cdecl, system, win64, sysv64, link=\"name\", load=\"name\", if target_os = \"...\"")
            }
        }
        if not afin {
            if match_tok(TOK_PUNCT, "]") { afin = true }
            else if parser_at_eof() {
                parser_diag_unclosed_at("extern ABI list", "]", block_file, block_line, block_col)
                afin = true
            } else { expect_tok(TOK_PUNCT, ",") }
        }
    }
    pilot body_file = current_source_file()
    pilot body_line = word_to_int(current_source_line())
    pilot body_col = current_source_col()
    expect_tok(TOK_PUNCT, "{")
    pilot member_count = 0
    pilot bfin = false
    repeat until bfin {
        parser_skip_statement_separators()
        if match_tok(TOK_PUNCT, "}") { bfin = true }
        else if parser_at_eof() {
            parser_diag_unclosed_at("extern block", "}", body_file, body_line, body_col)
            bfin = true
        } else if parse_error_count > 100 {
            bfin = true
        } else {
            pilot member_id = parse_extern_member(mode, library)
            if member_id >= 0 {
                member_count += 1
                if active { array_push(ast_top_stmts, word_from_int(member_id)) }
            }
        }
    }
    if active and mode == "link" and member_count > 0 { ffi_record_link_lib(library) }
    if active and mode == "load" and member_count > 0 { ffi_uses_load = true }
}

task parse_extern_member(mode: word, library: word) -> int {
    pilot symbol = ""
    repeat until not (cur_tok_type() == TOK_PUNCT and cur_tok_val() == "@") {
        advance_tok()
        pilot attr = parser_take_ident("extern member attribute")
        if attr == "link_name" {
            expect_tok(TOK_PUNCT, "(")
            if cur_tok_type() == TOK_STR {
                if symbol != "" { diag_error("duplicate link_name attribute", "keep a single @link_name(\"symbol\")") }
                symbol = cur_tok_val()
                advance_tok()
            } else { diag_error("@link_name needs a quoted symbol", "write @link_name(\"sqrt\")") }
            expect_tok(TOK_PUNCT, ")")
        } else if attr == "allow_unwinder" {
            -- Accepted for V4 source compatibility; V3.5 has no unwinder warning.
        } else {
            diag_error("unknown extern member attribute @" + attr, "V3.5 extern members accept @link_name(\"symbol\")")
        }
    }
    pilot stmt_line = current_source_location()
    if not match_tok(TOK_KW, "task") {
        diag_error("expected 'task' in extern block, found " + friendly_tok(cur_tok_type(), cur_tok_val()), "write task name(param: c_int) -> c_int")
        if not parser_at_eof() { advance_tok() }
        give back 0 - 1
    }
    pilot ename = parser_take_ident("extern task name")
    if symbol == "" { symbol = ename }
    pilot params_file = current_source_file()
    pilot params_line = word_to_int(current_source_line())
    pilot params_col = current_source_col()
    expect_tok(TOK_PUNCT, "(")
    pilot eparams = ""
    pilot abi_params = ""
    pilot efin = false
    pilot index = 0
    if match_tok(TOK_PUNCT, ")") { efin = true }
    repeat until efin {
        if parser_at_eof() {
            parser_diag_unclosed_at("extern parameter list", ")", params_file, params_line, params_col)
            efin = true
        } else {
            pilot pname = parser_take_ident("extern parameter name")
            expect_tok(TOK_PUNCT, ":")
            if cur_tok_type() == TOK_PUNCT and cur_tok_val().starts_with(".") {
                diag_error("variadic extern tasks are not supported by V3.5 yet", "declare one extern task per argument shape, or wait for the V4 compiler")
                repeat until not (cur_tok_type() == TOK_PUNCT and cur_tok_val().starts_with(".")) { advance_tok() }
            } else {
                pilot ptype = ffi_take_c_type("extern parameter '" + pname + "' of " + ename, false)
                if ptype != "" {
                    if index > 0 {
                        eparams = eparams + ","
                        abi_params = abi_params + ","
                    }
                    eparams = eparams + pname + ":" + ffi_abi_part(ptype, 1)
                    abi_params = abi_params + ffi_abi_part(ptype, 0)
                    index += 1
                }
            }
            if match_tok(TOK_PUNCT, ")") { efin = true }
            else if parser_at_eof() {
                parser_diag_unclosed_at("extern parameter list", ")", params_file, params_line, params_col)
                efin = true
            } else { expect_tok(TOK_PUNCT, ",") }
        }
    }
    pilot ret = "void|void"
    if match_tok(TOK_PUNCT, "->") {
        ret = ffi_take_c_type("extern return of " + ename, true)
        if ret == "" { ret = "void|void" }
    }
    pilot extra = "ffi|" + mode + "|" + library + "|" + symbol + "|" + ffi_abi_part(ret, 0) + "|" + abi_params
    give back alloc_stmt(STMT_EXTERN, ename, "", "", "", extra, eparams, ffi_abi_part(ret, 1), stmt_line)
}

task parse_extern() -> int {
    pilot stmt_line = current_source_location()
    if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "[" {
        diag_error("extern blocks are only allowed at the top level", "move the extern [C] block out of the task or block")
        parse_extern_block()
        give back alloc_stmt(STMT_EXTERN, "__freak_invalid_extern", "", "", "", "", "", "void", stmt_line)
    }
    expect_tok(TOK_KW, "task")
    pilot ename = parser_take_ident("extern task name")
    pilot extern_file = current_source_file()
    pilot extern_line = word_to_int(current_source_line())
    pilot extern_col = current_source_col()
    expect_tok(TOK_PUNCT, "(")
    pilot eparams = ""
    pilot efin = false
    pilot eis_first = true
    if match_tok(TOK_PUNCT, ")") { efin = true }
    repeat until efin {
        if parser_at_eof() {
            parser_diag_unclosed_at("extern parameter list", ")", extern_file, extern_line, extern_col)
            efin = true
        } else {
            pilot epname = parser_take_ident("extern parameter name")
            expect_tok(TOK_PUNCT, ":")
            pilot eptype = parser_take_type("extern parameter type")
            pilot epstr = epname + ":" + eptype
            if eis_first {
                eparams = epstr
                eis_first = false
            } else {
                eparams = eparams + "," + epstr
            }
            if match_tok(TOK_PUNCT, ")") { efin = true }
            else if parser_at_eof() {
                parser_diag_unclosed_at("extern parameter list", ")", extern_file, extern_line, extern_col)
                efin = true
            } else { expect_tok(TOK_PUNCT, ",") }
        }
    }
    expect_tok(TOK_PUNCT, "->")
    pilot eret_type = parser_take_type("extern return type")
    give back alloc_stmt(STMT_EXTERN, ename, "", "", "", "", eparams, eret_type, stmt_line)
}

task parse_task_def() -> int {
    pilot stmt_line = current_source_location()
    pilot name = parser_take_ident("task name")
    pilot params_file = current_source_file()
    pilot params_line = word_to_int(current_source_line())
    pilot params_col = current_source_col()
    expect_tok(TOK_PUNCT, "(")
    pilot params = parse_params(params_file, params_line, params_col)
    pilot ret_type = "void"
    if match_tok(TOK_PUNCT, "->") {
        ret_type = parser_take_type("task return type")
    }
    pilot body_id = parse_block()
    give back alloc_stmt(STMT_TASK, name, "", body_id, "", "", params, ret_type, stmt_line)
}

-- ===================== TOP-LEVEL PARSING =============================

task parse_program() -> void {
    ffi_link_libs = ""
    ffi_uses_load = false
    parse_idx = 0
    tok_total = tokens_count
    parse_error_count = 0
    pilot pfin = false
    repeat until pfin {
        parser_skip_statement_separators()
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            pfin = true
        } else if parse_error_count > 100 {
            say "\x1b[1;31merror\x1b[0m: too many errors, giving up (>100 syntax errors in " + input_file + ")"
            pfin = true
        } else if cur_tok_type() == TOK_KW and cur_tok_val() == "extern" and array_get(tok_types, parse_idx + 1) == TOK_PUNCT and array_get(tok_vals, parse_idx + 1) == "[" {
            advance_tok()
            parse_extern_block()
        } else {
            pilot stmt_id = parse_stmt()
            array_push(ast_top_stmts, word_from_int(stmt_id))
        }
    }
}

task check_program() -> void {
    tc_run_program()
    -- v3 has no full type checker yet. The borrow checker (Bible §4.1)
    -- Nominal member validation always runs; broader borrow checking
    -- remains behind --strict-borrow.
    if strict_borrow {
        bc_run_program()
    }
}
