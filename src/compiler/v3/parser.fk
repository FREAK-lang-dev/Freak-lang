-- ===================================================================
-- FREAK v3 COMPILER — PARSER
-- ===================================================================
-- Recursive descent parser. Builds AST in parallel arrays.
-- v3 changes: flat if chains (no else-if nesting), early returns.

task cur_tok_type() -> word {
    give back array_get(tok_types, parse_idx)
}

task cur_tok_val() -> word {
    give back array_get(tok_vals, parse_idx)
}

task parser_at_eof() -> bool {
    give back cur_tok_type() == TOK_EOF or cur_tok_type() == ""
}

task parser_diag_unclosed(context: word, closer: word) -> void {
    diag_error("unexpected end of file inside " + context, "expected '" + closer + "'")
}

task advance_tok() -> void {
    parse_idx += 1
}

task match_tok(type: word, val: word) -> bool {
    if cur_tok_type() == type {
        if val == "" or cur_tok_val() == val {
            advance_tok()
            give back true
        }
    }
    give back false
}

task expect_tok(type: word, val: word) -> void {
    if not match_tok(type, val) {
        pilot expected = ""
        if type == TOK_IDENT and val == "" { expected = "an identifier" }
        if type == TOK_PUNCT { expected = "'" + val + "'" }
        if type == TOK_KW    { expected = "keyword '" + val + "'" }
        if expected == ""    { expected = "'" + val + "'" }
        pilot found_tok = friendly_tok(cur_tok_type(), cur_tok_val())
        diag_error("expected " + expected + ", found " + found_tok, "")
        if cur_tok_type() != TOK_EOF and cur_tok_type() != "" {
            advance_tok()
        }
    }
}

task current_source_line() -> word {
    if parse_idx < 0 or parse_idx >= tokens_count {
        give back "1"
    }
    -- Origin lines are captured before legacy combined-source adjustment, so
    -- prepended std modules and the user file keep independent line spaces.
    pilot line_no = word_to_int(array_get(tok_origin_lines, parse_idx))
    if line_no <= 0 { line_no = 1 }
    give back word_from_int(line_no)
}

task current_source_file() -> word {
    if parse_idx < 0 or parse_idx >= tokens_count { give back input_file }
    give back array_get(tok_origin_files, parse_idx)
}

task current_source_location() -> word {
    pilot location_id = array_len(source_location_lines)
    array_push(source_location_lines, current_source_line())
    array_push(source_location_files, current_source_file())
    give back "@" + word_from_int(location_id)
}

-- ===================== EXPRESSION PARSING ============================

task parse_primary() -> int {
    pilot ttype = cur_tok_type()
    pilot tval = cur_tok_val()

    if ttype == TOK_EOF or ttype == "" { give back 0 - 1 }

    if ttype == TOK_NUM {
        advance_tok()
        pilot is_float = false
        pilot nci = 0
        pilot nclen = tval.length()
        repeat nclen times {
            if tval.char_at(nci) == "." { is_float = true }
            nci += 1
        }
        if is_float { give back alloc_expr(EXPR_FLOAT, tval, "", "") }
        give back alloc_expr(EXPR_INT, tval, "", "")
    }
    if ttype == TOK_STR {
        advance_tok()
        give back alloc_expr(EXPR_STR, tval, "", "")
    }
    if ttype == TOK_BOOL {
        advance_tok()
        give back alloc_expr(EXPR_BOOL, tval, "", "")
    }
    if ttype == TOK_IDENT {
        advance_tok()

        -- Namespace: foo::bar
        if match_tok(TOK_PUNCT, "::") {
            pilot nttype = cur_tok_type()
            pilot ntval = cur_tok_val()
            if nttype == TOK_IDENT {
                tval = tval + "::" + ntval
                advance_tok()
            } else {
                diag_error("expected an identifier after '::'", "complete the namespace path")
            }
        }
        -- Shape constructor: Name { field: val, ... }
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "{" {
            if is_shape_name(tval) {
                advance_tok()
                pilot val_ids = ""
                pilot cfin = false
                pilot cis_first = true
                if match_tok(TOK_PUNCT, "}") { cfin = true }
                repeat until cfin {
                    if parser_at_eof() {
                        parser_diag_unclosed("shape constructor", "}")
                        cfin = true
                    } else {
                        pilot fname = cur_tok_val()
                        advance_tok()
                        expect_tok(TOK_PUNCT, ":")
                        pilot fval_id = parse_expr()
                        if cis_first {
                            val_ids = word_from_int(fval_id)
                            cis_first = false
                        } else {
                            val_ids = val_ids + "," + word_from_int(fval_id)
                        }
                        if match_tok(TOK_PUNCT, "}") { cfin = true }
                        else if parser_at_eof() {
                            parser_diag_unclosed("shape constructor", "}")
                            cfin = true
                        } else { expect_tok(TOK_PUNCT, ",") }
                    }
                }
                give back alloc_expr(EXPR_CALL, "shape::ctor::" + tval, val_ids, "")
            }
        }

        -- Function call: name(args)
        if match_tok(TOK_PUNCT, "(") {
            pilot args = ""
            pilot fin = false
            pilot is_first = true
            if match_tok(TOK_PUNCT, ")") { fin = true }
            repeat until fin {
                if parser_at_eof() {
                    parser_diag_unclosed("call argument list", ")")
                    fin = true
                } else {
                    pilot arg_id = parse_expr()
                    if is_first {
                        args = word_from_int(arg_id)
                        is_first = false
                    } else {
                        args = args + "," + word_from_int(arg_id)
                    }
                    if match_tok(TOK_PUNCT, ")") { fin = true }
                    else if parser_at_eof() {
                        parser_diag_unclosed("call argument list", ")")
                        fin = true
                    } else { expect_tok(TOK_PUNCT, ",") }
                }
            }
            give back alloc_expr(EXPR_CALL, tval, args, "")
        }

        give back alloc_expr(EXPR_IDENT, tval, "", "")
    }

    -- Parenthesized expression
    if ttype == TOK_PUNCT and tval == "(" {
        advance_tok()
        pilot inner = parse_expr()
        expect_tok(TOK_PUNCT, ")")
        give back inner
    }

    -- Array literal: `[expr, expr, ...]`.  Stored as EXPR_ARRAY_LIT with
    -- the element expr ids encoded the same way call args are: comma-
    -- separated list of word-from-int ids in `left`.  Lowering happens
    -- in the emitters: array_new() then array_push() per element.
    if ttype == TOK_PUNCT and tval == "[" {
        advance_tok()
        pilot elem_ids = ""
        pilot afin = false
        pilot afirst = true
        if match_tok(TOK_PUNCT, "]") { afin = true }
        repeat until afin {
            if parser_at_eof() {
                parser_diag_unclosed("array literal", "]")
                afin = true
            }
            else {
                pilot e_id = parse_expr()
                if afirst {
                    elem_ids = word_from_int(e_id)
                    afirst = false
                } else {
                    elem_ids = elem_ids + "," + word_from_int(e_id)
                }
                if match_tok(TOK_PUNCT, "]") { afin = true }
                else if parser_at_eof() {
                    parser_diag_unclosed("array literal", "]")
                    afin = true
                } else { expect_tok(TOK_PUNCT, ",") }
            }
        }
        give back alloc_expr(EXPR_ARRAY_LIT, "", elem_ids, "")
    }

    diag_error("unexpected " + friendly_tok(ttype, tval) + " — this token cannot start an expression", "")
    if ttype != TOK_EOF and ttype != "" { advance_tok() }
    give back 0 - 1
}

task parse_postfix() -> int {
    pilot left = parse_primary()
    pilot fin = false
    repeat until fin {
        if match_tok(TOK_PUNCT, ".") {
            pilot member_line = current_source_line()
            pilot member_file = current_source_file()
            pilot mname = cur_tok_val()
            expect_tok(TOK_IDENT, "")
            if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "(" {
                -- Method call: .name(args)
                advance_tok()
                pilot args = ""
                pilot argfin = false
                pilot is_first = true
                if match_tok(TOK_PUNCT, ")") { argfin = true }
                repeat until argfin {
                    if parser_at_eof() {
                        parser_diag_unclosed("method argument list", ")")
                        argfin = true
                    }
                    else {
                        pilot arg_id = parse_expr()
                        if is_first {
                            args = word_from_int(arg_id)
                            is_first = false
                        } else {
                            args = args + "," + word_from_int(arg_id)
                        }
                        if match_tok(TOK_PUNCT, ")") { argfin = true }
                        else if parser_at_eof() {
                            parser_diag_unclosed("method argument list", ")")
                            argfin = true
                        } else { expect_tok(TOK_PUNCT, ",") }
                    }
                }
                pilot member_id = alloc_expr(EXPR_METHOD, mname, word_from_int(left), args)
                array_set(ast_expr_lines, member_id, member_line)
                array_set(ast_expr_files, member_id, member_file)
                left = member_id
            } else {
                -- Field access: .name
                pilot field_id = alloc_expr(EXPR_FIELD, mname, word_from_int(left), "")
                array_set(ast_expr_lines, field_id, member_line)
                array_set(ast_expr_files, field_id, member_file)
                left = field_id
            }
        } else if match_tok(TOK_PUNCT, "[") {
            pilot idx_expr = parse_expr()
            expect_tok(TOK_PUNCT, "]")
            left = alloc_expr(EXPR_INDEX, "", word_from_int(left), word_from_int(idx_expr))
        } else if match_tok(TOK_PUNCT, "|>") {
            -- Pipe: a |> f(args) => f(a, args)
            pilot fname = cur_tok_val()
            advance_tok()
            pilot pipe_args = word_from_int(left)
            if match_tok(TOK_PUNCT, "(") {
                if not match_tok(TOK_PUNCT, ")") {
                    pilot pfin = false
                    repeat until pfin {
                        if parser_at_eof() {
                            parser_diag_unclosed("pipe argument list", ")")
                            pfin = true
                        } else {
                            pilot parg_id = parse_expr()
                            pipe_args = pipe_args + "," + word_from_int(parg_id)
                            if match_tok(TOK_PUNCT, ")") { pfin = true }
                            else if parser_at_eof() {
                                parser_diag_unclosed("pipe argument list", ")")
                                pfin = true
                            } else { expect_tok(TOK_PUNCT, ",") }
                        }
                    }
                }
            }
            left = alloc_expr(EXPR_CALL, fname, pipe_args, "")
        } else {
            fin = true
        }
    }
    give back left
}

-- v3: flat if with early return (no else-if nesting)
task parse_unary() -> int {
    if match_tok(TOK_KW, "not") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "not", word_from_int(op), "")
    }
    if match_tok(TOK_PUNCT, "-") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "-", word_from_int(op), "")
    }
    if match_tok(TOK_KW, "PLUS ULTRA") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "PLUS ULTRA", word_from_int(op), "")
    }
    if match_tok(TOK_KW, "FINAL FORM") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "FINAL FORM", word_from_int(op), "")
    }
    if match_tok(TOK_KW, "TSUNDERE") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "TSUNDERE", word_from_int(op), "")
    }
    give back parse_postfix()
}

-- Precedence: or < and < comparison < add < mul < unary < postfix

task parse_mul() -> int {
    pilot left = parse_unary()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "*" or tval == "/" or tval == "%" {
            advance_tok()
            pilot right = parse_unary()
            left = alloc_expr(EXPR_BINOP, tval, word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_add() -> int {
    pilot left = parse_mul()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "+" or tval == "-" or tval == "NAKAMA" {
            advance_tok()
            pilot right = parse_mul()
            left = alloc_expr(EXPR_BINOP, tval, word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_comparison() -> int {
    pilot left = parse_add()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "==" or tval == "!=" or tval == "<" or tval == ">" or tval == "<=" or tval == ">=" {
            advance_tok()
            pilot right = parse_add()
            left = alloc_expr(EXPR_BINOP, tval, word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_and() -> int {
    pilot left = parse_comparison()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "and" {
            advance_tok()
            pilot right = parse_comparison()
            left = alloc_expr(EXPR_BINOP, "and", word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_expr() -> int {
    pilot left = parse_and()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "or" {
            advance_tok()
            pilot right = parse_and()
            left = alloc_expr(EXPR_BINOP, "or", word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

-- ===================== BLOCK + STATEMENT PARSING =====================

task parse_block() -> word {
    pilot opener_file = current_source_file()
    pilot opener_line = word_to_int(current_source_line())
    pilot opener_col = 1
    if parse_idx >= 0 and parse_idx < tokens_count { opener_col = word_to_int(array_get(tok_cols, parse_idx)) }
    expect_tok(TOK_PUNCT, "{")
    pilot block = ""
    pilot fin = false
    pilot is_first = true
    if match_tok(TOK_PUNCT, "}") { fin = true }
    repeat until fin {
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            diag_error_at("unexpected end of file — missing '}'", "block opened here", opener_file, opener_line, opener_col)
            fin = true
        } else {
            pilot stmt_id = parse_stmt()
            if is_first {
                block = word_from_int(stmt_id)
                is_first = false
            } else {
                block = block + "," + word_from_int(stmt_id)
            }
            if match_tok(TOK_PUNCT, "}") { fin = true }
        }
    }
    give back block
}

task parse_stmt() -> int {
    pilot ttype = cur_tok_type()
    pilot tval = cur_tok_val()

    -- Skip @annotations
    if ttype == TOK_PUNCT and tval == "@" {
        advance_tok()
        advance_tok()
        ttype = cur_tok_type()
        tval = cur_tok_val()
    }

    pilot stmt_line = current_source_location()

    -- say expr
    if match_tok(TOK_KW, "say") {
        pilot expr_id = parse_expr()
        give back alloc_stmt(STMT_SAY, "", word_from_int(expr_id), "", "", "", "", "", stmt_line)
    }

    -- shape Name { field: type, ... }
    if match_tok(TOK_KW, "shape") {
        give back parse_shape()
    }

    -- impl Name { task ... }
    if match_tok(TOK_KW, "impl") {
        give back parse_impl()
    }

    -- eventually { body }
    if match_tok(TOK_KW, "eventually") {
        pilot ev_body = parse_block()
        give back alloc_stmt(STMT_EVENTUALLY, "", "", ev_body, "", "", "", "", stmt_line)
    }

    -- fixed pilot name = expr  (immutable binding; treated identically to
    --                            `pilot` here since the v3 emitter doesn't
    --                            track mutability — the type checker will
    --                            eventually enforce the `fixed` half.)
    if match_tok(TOK_KW, "fixed") {
        if not match_tok(TOK_KW, "pilot") {
            diag_error("expected 'pilot' after 'fixed'", "")
        }
        pilot fname = cur_tok_val()
        advance_tok()
        pilot ftype_ann = ""
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == ":" {
            advance_tok()
            ftype_ann = cur_tok_val()
            advance_tok()
        }
        expect_tok(TOK_PUNCT, "=")
        pilot fexpr_id = parse_expr()
        give back alloc_stmt(STMT_PILOT, fname, word_from_int(fexpr_id), "", "", ftype_ann, "", "", stmt_line)
    }

    -- pilot [mut] name = expr
    if match_tok(TOK_KW, "pilot") {
        pilot is_mut = false
        if match_tok(TOK_KW, "mut") { is_mut = true }
        pilot name = cur_tok_val()
        advance_tok()
        pilot type_ann = ""
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == ":" {
            advance_tok()
            type_ann = cur_tok_val()
            advance_tok()
        }
        expect_tok(TOK_PUNCT, "=")
        pilot expr_id = parse_expr()
        pilot stmt_id = alloc_stmt(STMT_PILOT, name, word_from_int(expr_id), "", "", type_ann, "", "", stmt_line)
        if is_mut { array_set(ast_pilot_is_mut, stmt_id, "1") }
        give back stmt_id
    }

    -- give back expr
    if match_tok(TOK_KW, "give back") {
        pilot expr_id = 0 - 1
        if cur_tok_type() != TOK_PUNCT or cur_tok_val() != "}" {
            expr_id = parse_expr()
        }
        give back alloc_stmt(STMT_GIVE_BACK, "", word_from_int(expr_id), "", "", "", "", "", stmt_line)
    }

    -- break / continue
    if match_tok(TOK_KW, "break") {
        give back alloc_stmt(STMT_BREAK, "", "", "", "", "", "", "", stmt_line)
    }
    if match_tok(TOK_KW, "continue") {
        give back alloc_stmt(STMT_CONTINUE, "", "", "", "", "", "", "", stmt_line)
    }

    -- if expr { body } else { body }
    if match_tok(TOK_KW, "if") {
        pilot expr_id = parse_expr()
        pilot body_id = parse_block()
        pilot else_body = ""
        if match_tok(TOK_KW, "else") {
            if cur_tok_type() == TOK_KW and cur_tok_val() == "if" {
                pilot elif_id = parse_stmt()
                else_body = word_from_int(elif_id)
            } else {
                else_body = parse_block()
            }
        }
        give back alloc_stmt(STMT_IF, "", word_from_int(expr_id), body_id, else_body, "", "", "", stmt_line)
    }

    -- repeat until cond { body }  /  repeat N times { body }
    if match_tok(TOK_KW, "repeat") {
        if match_tok(TOK_KW, "until") {
            pilot expr_id = parse_expr()
            pilot body_id = parse_block()
            give back alloc_stmt(STMT_REPEAT, "until", word_from_int(expr_id), body_id, "", "", "", "", stmt_line)
        }
        pilot expr_id = parse_expr()
        expect_tok(TOK_KW, "times")
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_REPEAT, "times", word_from_int(expr_id), body_id, "", "", "", "", stmt_line)
    }

    -- training arc until cond max N sessions { body }
    if match_tok(TOK_KW, "training arc") {
        expect_tok(TOK_KW, "until")
        pilot cond_id = parse_expr()
        expect_tok(TOK_KW, "max")
        pilot max_id = parse_expr()
        expect_tok(TOK_KW, "sessions")
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_TRAINING_ARC, "", word_from_int(cond_id), body_id, "", word_from_int(max_id), "", "", stmt_line)
    }

    -- when expr { val -> stmt, ... }
    if match_tok(TOK_KW, "when") {
        give back parse_when()
    }

    -- extern task name(params) -> ret
    if match_tok(TOK_KW, "extern") {
        give back parse_extern()
    }

    -- task name(params) -> ret { body }
    if match_tok(TOK_KW, "task") {
        give back parse_task_def()
    }

    -- Bare block { ... }
    if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "{" {
        pilot block_id = parse_block()
        give back alloc_stmt(STMT_BLOCK, "", "", block_id, "", "", "", "", stmt_line)
    }

    -- Expression statement (or assignment)
    pilot expr_id = parse_expr()

    if match_tok(TOK_PUNCT, "=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "+=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "+=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "-=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "-=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "*=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "*=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "/=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "/=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }
    if match_tok(TOK_PUNCT, "%=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "%=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "", stmt_line)
    }

    give back alloc_stmt(STMT_EXPR, "", word_from_int(expr_id), "", "", "", "", "", stmt_line)
}

-- ===================== HELPER PARSE TASKS ============================
-- v3: Split out from parse_stmt to keep functions short.

task parse_params() -> word {
    pilot params = ""
    pilot fin = false
    pilot is_first = true
    if match_tok(TOK_PUNCT, ")") { fin = true }
    repeat until fin {
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            diag_error("unexpected end of file inside parameter list", "")
            fin = true
        } else {
            pilot pname = cur_tok_val()
            advance_tok()
            if pname == "self" {
                if match_tok(TOK_PUNCT, ")") { fin = true }
                else { expect_tok(TOK_PUNCT, ",") }
                if is_first {
                    params = "self:word"
                    is_first = false
                } else {
                    params = params + ",self:word"
                }
            } else {
                expect_tok(TOK_PUNCT, ":")
                pilot ptype = cur_tok_val()
                advance_tok()
                pilot pstr = pname + ":" + ptype
                if is_first {
                    params = pstr
                    is_first = false
                } else {
                    params = params + "," + pstr
                }
                if match_tok(TOK_PUNCT, ")") { fin = true }
                else { expect_tok(TOK_PUNCT, ",") }
            }
        }
    }
    give back params
}

task parse_shape() -> int {
    pilot stmt_line = current_source_location()
    pilot shape_name = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "{")
    pilot fields = ""
    pilot sfin = false
    pilot sis_first = true
    repeat until sfin {
        if match_tok(TOK_PUNCT, "}") {
            sfin = true
        } else if parser_at_eof() {
            parser_diag_unclosed("shape declaration", "}")
            sfin = true
        } else {
            pilot fname = cur_tok_val()
            advance_tok()
            expect_tok(TOK_PUNCT, ":")
            pilot ftype = cur_tok_val()
            advance_tok()
            if sis_first {
                fields = fname + ":" + ftype
                sis_first = false
            } else {
                fields = fields + "," + fname + ":" + ftype
            }
            -- Field commas are separators, including the conventional
            -- trailing comma before `}` used throughout std/math3d.fk.
            match_tok(TOK_PUNCT, ",")
        }
    }
    register_shape(shape_name, fields)
    give back alloc_stmt(STMT_SHAPE, shape_name, "", "", "", fields, "", "", stmt_line)
}

task parse_impl() -> int {
    pilot doctrine_name = cur_tok_val()
    pilot impl_name = doctrine_name
    pilot stmt_line = current_source_location()
    advance_tok()
    -- Doctrine implementations use `impl Doctrine for Shape`.  Methods are
    -- nominally owned by the shape, not by the doctrine: several shapes may
    -- implement Add/Eq without colliding in the native symbol namespace.
    -- Keep accepting the legacy/direct `impl Shape { ... }` form.
    if match_tok(TOK_KW, "for") {
        impl_name = cur_tok_val()
        advance_tok()
    }
    expect_tok(TOK_PUNCT, "{")

    pilot impl_fin = false
    repeat until impl_fin {
        if match_tok(TOK_PUNCT, "}") {
            impl_fin = true
        } else if parser_at_eof() {
            parser_diag_unclosed("impl declaration", "}")
            impl_fin = true
        } else if match_tok(TOK_KW, "task") {
            pilot mname = cur_tok_val()
            advance_tok()
            expect_tok(TOK_PUNCT, "(")
            pilot params = parse_params()
            -- `self` is parsed generically, then specialized here once the
            -- owning impl shape is known. Emitters can now resolve duplicate
            -- field and method names through the receiver's actual shape.
            if params == "self:word" { params = "self:" + impl_name }
            else if params.starts_with("self:word,") {
                params = "self:" + impl_name + params.substring(9, params.length() - 9)
            } else {
                params = params.replace(",self:word", ",self:" + impl_name)
            }
            pilot ret_type = "void"
            if match_tok(TOK_PUNCT, "->") {
                ret_type = cur_tok_val()
                advance_tok()
            }
            pilot body_id = parse_block()
            pilot full_name = impl_name + "_" + mname
            -- Preserve impl provenance separately from the mangled task name.
            -- The always-on nominal checker must not accept a free task named
            -- `Shape_method` as proof that `Shape.method` exists.
            pilot sid = alloc_stmt(STMT_TASK, full_name, "", body_id, "", "impl:" + impl_name, params, ret_type, stmt_line)
            array_push(ast_top_stmts, word_from_int(sid))
        } else {
            advance_tok()
        }
    }
    give back alloc_stmt(STMT_BLOCK, "", "", "", "", "", "", "", "1")
}

task parse_when() -> int {
    pilot stmt_line = current_source_location()
    pilot target_id = parse_expr()
    expect_tok(TOK_PUNCT, "{")
    pilot cases_str = ""
    pilot fin = false
    pilot is_first = true
    repeat until fin {
        if match_tok(TOK_PUNCT, "}") {
            fin = true
        } else if parser_at_eof() {
            parser_diag_unclosed("when expression", "}")
            fin = true
        } else {
            pilot case_expr = 0 - 1
            if match_tok(TOK_IDENT, "_") {
                case_expr = 0 - 1
            } else {
                case_expr = parse_expr()
            }
            expect_tok(TOK_PUNCT, "->")
            pilot stmt_id = parse_stmt()
            pilot case_str = word_from_int(case_expr) + ":" + word_from_int(stmt_id)
            if is_first {
                cases_str = case_str
                is_first = false
            } else {
                cases_str = cases_str + "," + case_str
            }
        }
    }
    give back alloc_stmt(STMT_WHEN, "", word_from_int(target_id), cases_str, "", "", "", "", stmt_line)
}

task parse_extern() -> int {
    pilot stmt_line = current_source_location()
    expect_tok(TOK_KW, "task")
    pilot ename = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "(")
    pilot eparams = ""
    pilot efin = false
    pilot eis_first = true
    if match_tok(TOK_PUNCT, ")") { efin = true }
    repeat until efin {
        if parser_at_eof() {
            parser_diag_unclosed("extern parameter list", ")")
            efin = true
        } else {
            pilot epname = cur_tok_val()
            advance_tok()
            expect_tok(TOK_PUNCT, ":")
            pilot eptype = cur_tok_val()
            advance_tok()
            pilot epstr = epname + ":" + eptype
            if eis_first {
                eparams = epstr
                eis_first = false
            } else {
                eparams = eparams + "," + epstr
            }
            if match_tok(TOK_PUNCT, ")") { efin = true }
            else if parser_at_eof() {
                parser_diag_unclosed("extern parameter list", ")")
                efin = true
            } else { expect_tok(TOK_PUNCT, ",") }
        }
    }
    expect_tok(TOK_PUNCT, "->")
    pilot eret_type = cur_tok_val()
    advance_tok()
    give back alloc_stmt(STMT_EXTERN, ename, "", "", "", "", eparams, eret_type, stmt_line)
}

task parse_task_def() -> int {
    pilot stmt_line = current_source_location()
    pilot name = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "(")
    pilot params = parse_params()
    pilot ret_type = "void"
    if match_tok(TOK_PUNCT, "->") {
        ret_type = cur_tok_val()
        advance_tok()
    }
    pilot body_id = parse_block()
    give back alloc_stmt(STMT_TASK, name, "", body_id, "", "", params, ret_type, stmt_line)
}

-- ===================== TOP-LEVEL PARSING =============================

task parse_program() -> void {
    parse_idx = 0
    tok_total = tokens_count
    parse_error_count = 0
    pilot pfin = false
    repeat until pfin {
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            pfin = true
        } else if parse_error_count > 100 {
            say "\x1b[1;31merror\x1b[0m: too many errors, giving up (>100 syntax errors in " + input_file + ")"
            pfin = true
        } else {
            pilot stmt_id = parse_stmt()
            array_push(ast_top_stmts, word_from_int(stmt_id))
        }
    }
}

task check_program() -> void {
    tc_run_program()
    -- v3 has no full type checker yet. The borrow checker (Bible §4.1)
    -- Nominal member validation always runs; broader borrow checking
    -- remains behind --strict-borrow.
    if strict_borrow {
        bc_run_program()
    }
}
