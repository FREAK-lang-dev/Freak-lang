-- ===================================================================
-- FREAK v3 COMPILER — MAIN ENTRY POINT
-- ===================================================================
-- CLI arg parsing, file reading, backend dispatch.

task freakc_v3_main() -> void {
    pilot args_cnt = process::args_count()

    -- Handle --version and --help
    if args_cnt >= 2 {
        pilot first_arg: word = process::arg(1)
        if first_arg == "--version" or first_arg == "-V" {
            say "freakc " + FREAKC_VERSION + " (" + FREAKC_CODENAME + ")"
            give back
        }
        if first_arg == "--help" or first_arg == "-h" {
            say "FREAK Compiler " + FREAKC_VERSION + " (" + FREAKC_CODENAME + ")"
            say ""
            say "Usage: freakc <file.fk> [options]"
            say ""
            say "Options:"
            say "  --llvm             Use LLVM IR backend (default)"
            say "  --c                Use C backend"
            say "  --opt=N            Optimization level 0-3 (default: 2)"
            say "  --target=TRIPLE    Cross-compile target triple"
            say "  --strict-borrow    Enforce ownership + mutability (Bible §4.1)"
            say "  --version, -V      Show version"
            say "  --help, -h         Show this help"
            give back
        }
    }

    if args_cnt < 2 {
        say "Usage: freakc <file.fk> [--c] [--llvm] [--opt=N] [--target=TRIPLE] [--strict-borrow]"
        say "       freakc --version | --help"
        process::exit(1)
    }

    input_file = process::arg(1)

    -- Parse flags
    pilot fi = 2
    repeat until fi >= args_cnt {
        pilot flag = process::arg(fi)
        if flag == "--c" { emit_target = "c" }
        if flag == "--llvm" { emit_target = "llvm" }
        if flag == "--strict-borrow" { strict_borrow = true }
        if flag.starts_with("--opt=") { opt_level = flag.char_at(6) }
        if flag.starts_with("--target=") {
            pilot ti = 9
            pilot tval = ""
            repeat until ti >= flag.length() {
                tval = tval + flag.char_at(ti)
                ti += 1
            }
            cross_target = tval
        }
        fi += 1
    }

    -- A failed invocation must not leave a selected artifact from an older
    -- standalone-compiler run looking current. Flags are known at this point,
    -- so invalidate only the requested backend before reading or compiling.
    pilot selected_output = input_file + ".ll"
    if emit_target == "c" { selected_output = input_file + ".c" }
    if not input_file.ends_with(".fk") {
        say "Error: source path must end in .fk; neighboring outputs were preserved."
        process::exit(1)
    } else {
        -- Delete unconditionally so a dangling output symlink, which
        -- fs::exists cannot observe, is unlinked before the emitter writes.
        if not fs::delete_file_checked(selected_output) {
            say "Error: untrusted stale artifact could not be removed: " + selected_output
            process::exit(1)
        }
        if fs::exists(selected_output) {
            say "Error: untrusted stale artifact could not be removed: " + selected_output
            process::exit(1)
        }
    }

    say "FREAK v3 Compiling: " + input_file + " (Target: " + emit_target + ")"

    pilot src = fs::read(input_file)
    if src == "" {
        say "Error: Could not read file."
        process::exit(1)
    }

    error_count = 0
    init_arrays()
    diagnostic_source = src
    source_map_reset()
    source_map_register(input_file, src)

    say "[1/4] Lexing..."
    tokenize(src)

    say "[2/4] Parsing..."
    parse_program()
    if error_count > 0 {
        say "\x1b[1;31maborting: " + word_from_int(error_count) + " error(s) found\x1b[0m"
        process::exit(1)
    }

    if strict_borrow {
        say "[3/4] Borrow checking..."
    } else {
        say "[3/4] Type Checking..."
    }
    check_program()
    if error_count > 0 {
        say "\x1b[1;31maborting: " + word_from_int(error_count) + " error(s) found\x1b[0m"
        process::exit(1)
    }

    say "[4/4] Emitting..."
    if emit_target == "llvm" {
        out_file = selected_output
        emit_llvm_program()
        say "Generated LLVM IR at " + out_file
    } else {
        out_file = selected_output
        -- Clear the output file before streaming
        fs::write(out_file, "")
        emit_c_program()
        say "Generated C code at " + out_file
    }

    say "Done."
}

freakc_v3_main()
