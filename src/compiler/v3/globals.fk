-- ===================================================================
-- FREAK v3 COMPILER — GLOBALS
-- ===================================================================
-- All global state in one file. Keeps other files pure logic.

-- ===================== VERSION =====================================
-- Generated/synchronized by tools/release_version.py from the root VERSION.
-- Release bumps change the version through that one command only.
pilot FREAK_VERSION = "0.14.0"
pilot FREAKC_VERSION = FREAK_VERSION
pilot FREAKC_CODENAME = "Maverick"
pilot FREAK_V3_ABI = "freak-v3-abi-1"

-- ===================== TOKENS ======================================
pilot TOK_EOF = "0"
pilot TOK_IDENT = "1"
pilot TOK_NUM = "2"
pilot TOK_STR = "3"
pilot TOK_BOOL = "4"
pilot TOK_PUNCT = "5"
pilot TOK_KW = "6"

pilot tok_types = 0
pilot tok_vals  = 0
pilot tok_lines = 0
pilot tok_cols  = 0
pilot tok_origin_files = 0
pilot tok_origin_lines = 0
pilot tokens_count = 0

-- ===================== AST EXPRESSION KINDS ========================
pilot EXPR_INT = "1"
pilot EXPR_FLOAT = "2"
pilot EXPR_STR = "3"
pilot EXPR_BOOL = "4"
pilot EXPR_IDENT = "5"
pilot EXPR_BINOP = "6"
pilot EXPR_UNARYOP = "7"
pilot EXPR_CALL = "8"
pilot EXPR_METHOD = "9"
pilot EXPR_FIELD = "10"
pilot EXPR_INDEX = "11"
-- `[a, b, c]` — value is unused, left holds the comma-separated list of
-- element expr ids (same encoding as call args).
pilot EXPR_ARRAY_LIT = "12"

pilot ast_expr_kinds = 0
pilot ast_expr_vals = 0
pilot ast_expr_lefts = 0
pilot ast_expr_rights = 0
pilot ast_expr_files = 0
pilot ast_expr_lines = 0

-- ===================== AST STATEMENT KINDS =========================
pilot STMT_PILOT = "1"
pilot STMT_SAY = "2"
pilot STMT_TASK = "3"
pilot STMT_GIVE_BACK = "4"
pilot STMT_IF = "5"
pilot STMT_ASSIGN = "6"
pilot STMT_EXPR = "7"
pilot STMT_REPEAT = "8"
pilot STMT_TRAINING_ARC = "9"
pilot STMT_WHEN = "10"
pilot STMT_BLOCK = "11"
pilot STMT_SHAPE = "12"
pilot STMT_BREAK = "13"
pilot STMT_CONTINUE = "14"
pilot STMT_EVENTUALLY = "15"
pilot STMT_EXTERN = "16"

pilot ast_stmt_kinds = 0
