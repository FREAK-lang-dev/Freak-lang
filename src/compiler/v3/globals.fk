pilot ast_stmt_exprs = 0
pilot ast_stmt_bodies = 0
pilot ast_stmt_else_bodies = 0
pilot ast_stmt_extras = 0
pilot ast_task_params = 0
pilot ast_task_returns = 0
pilot ast_stmt_lines = 0
pilot ast_stmt_files = 0
pilot source_location_lines = 0
pilot source_location_files = 0

pilot ast_top_stmts = 0

-- Mutability flag per stmt_id. "1" iff the stmt is `pilot mut <name> = ...`.
-- Always pushed alongside the other ast_stmt_* arrays (see alloc_stmt).
pilot ast_pilot_is_mut = 0

-- ===================== BORROW CHECKER STATE ========================
-- Phase-1 borrow checker (Bible §4.1: ownership + mutability).
-- Off by default; enabled via --strict-borrow on the CLI.

pilot strict_borrow = false

-- Symbol table (parallel arrays, scope-stack discipline).
-- bc_sym_kinds: "copy" | "owned"
-- bc_sym_state: "live" | "moved"
pilot bc_sym_names  = 0
pilot bc_sym_kinds  = 0
pilot bc_sym_is_mut = 0
pilot bc_sym_state  = 0
pilot bc_sym_scopes = 0
pilot bc_sym_lines  = 0
pilot bc_sym_count  = 0
pilot bc_scope_depth = 0

-- Minimal always-on nominal member checking (shape fields/impl methods).
pilot tc_global_names = 0
pilot tc_global_types = 0
pilot tc_global_count = 0
pilot tc_local_names = 0
pilot tc_local_types = 0
pilot tc_local_count = 0

-- ===================== SHAPE REGISTRY ==============================
pilot shape_registry_names = 0
pilot shape_registry_fields = 0
pilot shape_registry_count = 0

-- ===================== LEXER STATE =================================
pilot lex_source = ""
pilot lex_len = 0
pilot lex_pos = 0
pilot lex_line = 1
pilot lex_col = 1
pilot cur_tok_line = 1
pilot cur_tok_col = 1

-- ===================== PARSER STATE ================================
pilot parse_idx = 1
pilot tok_total = 0
pilot parse_error_count = 0
pilot error_count = 0
pilot next_expr_id = 0
pilot next_stmt_id = 0

-- ===================== EMIT STATE ==================================
-- v3 KEY CHANGE: out_file replaces out_buf. All emit() calls
-- append directly to this file. No O(n^2) string buffer.
pilot out_file = ""
pilot emit_target = "llvm"

