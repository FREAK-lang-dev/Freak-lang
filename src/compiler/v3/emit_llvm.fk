    llvm_declared_funcs = llvm_declared_funcs + "freak_llvm_http_server_open|freak_llvm_http_server_bind|freak_llvm_http_server_status|freak_llvm_http_server_error|freak_llvm_http_server_local_port|freak_llvm_http_server_set_limits|freak_llvm_http_server_set_timeouts|freak_llvm_http_server_set_chunk_limits|freak_llvm_http_server_stop|freak_llvm_http_server_close|freak_llvm_http_server_next_request|freak_llvm_http_server_request_status|freak_llvm_http_server_request_error|freak_llvm_http_server_request_method|freak_llvm_http_server_request_target|freak_llvm_http_server_request_path|freak_llvm_http_server_request_query|freak_llvm_http_server_request_header_count|freak_llvm_http_server_request_header_name|freak_llvm_http_server_request_header_value|freak_llvm_http_server_request_header_value_bytes|freak_llvm_http_server_request_header_is_trailer|freak_llvm_http_server_request_header_find|freak_llvm_http_server_request_body|freak_llvm_http_server_response_status|freak_llvm_http_server_response_header|freak_llvm_http_server_send_bytes|freak_llvm_http_server_send_text|freak_llvm_http_server_request_release|freak_llvm_http_server_live_servers|freak_llvm_http_server_live_requests|freak_llvm_http_server_live_sockets|freak_llvm_http_server_retained_bytes|"
    llvm_declared_funcs = llvm_declared_funcs + "freak_llvm_process_executable_path|freak_llvm_process_platform_is_windows|freak_llvm_process_stdout_is_terminal|"
    llvm_declared_funcs = llvm_declared_funcs + "freak_llvm_process_platform_name|"
    llvm_declared_funcs = llvm_declared_funcs + "freak_llvm_fs_read_native|freak_llvm_fs_write_native|freak_llvm_fs_append_native|freak_llvm_fs_exists_native|freak_llvm_fs_delete_native|"
    llvm_declared_funcs = llvm_declared_funcs + "freak_int_add_checked|freak_int_sub_checked|freak_int_mul_checked|freak_int_div_checked|freak_int_rem_checked|freak_int_neg_checked|freak_llvm_word_index_checked|"
}

-- ===================== PROGRAM ASSEMBLY ==============================
-- v3 KEY CHANGE: proper reserved global-init + top-level wrapper split

task llvm_emit_result_drop_helper() -> void {
    ir_result_drop_helper()
}

task emit_llvm_program() -> void {
    temp_reg_counter = 0
    string_literals = ""
    string_literals_count = 0
    llvm_dbg_init()

    -- Write empty file (streaming appends from here)
    if not llvm_builder_active { fs::write(out_file, "") }

    llvm_emit_line("; FREAK LLVM IR Generator (v3)")
    llvm_emit_line("")
    llvm_emit_runtime_decls()
    llvm_emit_result_drop_helper()
    llvm_emit_line("")

    pilot top_count = array_len(ast_top_stmts)

    -- Pre-scan: register task return types + externs
    pilot prescan_i = 0
    repeat top_count times {
        pilot pid: word = array_get(ast_top_stmts, prescan_i)
        pilot pk: word = array_get(ast_stmt_kinds, word_to_int(pid))
        if pk == STMT_TASK {
            pilot pn: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot pr: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(pn, pr)
        }
        if pk == STMT_EXTERN {
            pilot en: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot er: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(en, er)
            emt_register_extern(en, er)
        }
        prescan_i += 1
    }

    -- Emit global variable declarations
    llvm_global_names = ""
    llvm_global_type_names = ""
    llvm_global_types = ""
    llvm_var_names = ""
    llvm_var_types = ""
    pilot glob_i = 0
    repeat top_count times {
        pilot gid: word = array_get(ast_top_stmts, glob_i)
        pilot gk: word = array_get(ast_stmt_kinds, word_to_int(gid))
        if gk == STMT_PILOT {
            pilot gn: word = array_get(ast_stmt_names, word_to_int(gid))
            llvm_global_names = llvm_global_names + "|" + gn + "|"
            pilot gextra: word = array_get(ast_stmt_extras, word_to_int(gid))
            pilot gtype = ""
            if gextra != "" { gtype = llvm_type_code(gextra) }
            if gtype == "" or gtype == "v" {
                pilot gexpr: word = array_get(ast_stmt_exprs, word_to_int(gid))
                gtype = llvm_infer_expr_type(gexpr)
            }
            llvm_global_type_names = llvm_global_type_names + gn + "|"
            llvm_global_types = llvm_global_types + gtype + "|"
            ir_global(gn)
        }
        glob_i += 1
    }
    llvm_emit_line("")

    -- Emit extern declarations
    pilot ext_i = 0
    repeat top_count times {
        pilot eid: word = array_get(ast_top_stmts, ext_i)
        pilot ek: word = array_get(ast_stmt_kinds, word_to_int(eid))
        if ek == STMT_EXTERN {
            pilot enm: word = array_get(ast_stmt_names, word_to_int(eid))
            pilot ert: word = array_get(ast_task_returns, word_to_int(eid))
            pilot epm: word = array_get(ast_task_params, word_to_int(eid))
            pilot llvm_ret = "i64"
            if ert == "void" { llvm_ret = "void" }
            pilot llvm_params = ""
            pilot extern_parameter_count = 0
            if epm != "" {
                pilot plen = epm.length()
                pilot pi = 0
                pilot pcount = 1
                repeat plen times {
                    if epm.char_at(pi) == "," { pcount += 1 }
                    pi += 1
                }
                pilot pj = 0
                repeat pcount times {
                    if pj > 0 { llvm_params = llvm_params + ", " }
                    llvm_params = llvm_params + "i64"
                    pj += 1
                }
                extern_parameter_count = pcount
            }
            pilot extern_symbol = llvm_map_call_name(enm)
            if extern_symbol == "" { extern_symbol = "@" + enm }
            if not llvm_is_runtime_func(extern_symbol.substring(1, extern_symbol.length())) {
                ir_declare(llvm_ret, extern_symbol, extern_parameter_count)
            }
        }
        ext_i += 1
    }
    llvm_emit_line("")

    -- Emit user tasks
    pilot i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { llvm_emit_task(cur_id) }
        i += 1
    }

    -- Detect user-defined main
    pilot has_main_task = false
    pilot main_task_return_type = "void"
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" {
                has_main_task = true
                main_task_return_type = array_get(ast_task_returns, word_to_int(cur_id))
            }
        }
        i += 1
    }

    -- Emit the global initializer for programs with task main(). Compiler
    -- wrappers use the checker-reserved __freak_ namespace so source externs
    -- such as freak_init_globals cannot collide with generated definitions.
    if has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_word_local_slots = ""
        llvm_current_word_params = ""
        llvm_loop_word_cleanup_prefix = ""
        llvm_cur_func_is_void = true
        ir_begin_function("void", "@__freak_generated_init_globals", 0, "__freak_generated_init_globals", 1)
        ir_label("entry")
        i = 0
        repeat top_count times {
            llvm_preallocate_result_slots(array_get(ast_top_stmts, i))
            i += 1
        }
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind == STMT_PILOT {
                llvm_emitting_global_init = true
                llvm_emit_stmt(cur_id)
                llvm_emitting_global_init = false
            } else if v35_bootstrap_compat and kind != STMT_TASK and kind != STMT_SHAPE and kind != STMT_IMPL and kind != STMT_EXTERN {
                llvm_emit_stmt(cur_id)
            }
            i += 1
        }
        ir_ret_void()
        llvm_emit_integer_failure_block()
        ir_end_function()
        llvm_emit_line("")
        llvm_dbg_current_scope_id = 0
        llvm_dbg_current_line = 0
    }

    -- Emit the reserved top-level wrapper (only if no user main).
    if not has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_word_local_slots = ""
        llvm_current_word_params = ""
        llvm_loop_word_cleanup_prefix = ""
        llvm_cur_func_is_void = true
        ir_begin_function("void", "@__freak_generated_top_level", 0, "__freak_generated_top_level", 1)
        ir_label("entry")
        i = 0
        repeat top_count times {
            llvm_preallocate_result_slots(array_get(ast_top_stmts, i))
            i += 1
        }
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind != STMT_TASK and kind != STMT_EXTERN {
                if kind == STMT_PILOT { llvm_emitting_global_init = true }
                llvm_emit_stmt(cur_id)
                llvm_emitting_global_init = false
            }
            i += 1
        }
        ir_ret_void()
        llvm_emit_integer_failure_block()
        ir_end_function()
        llvm_dbg_current_scope_id = 0
        llvm_dbg_current_line = 0
    }

    -- Emit C main entry
    llvm_emit_line("")
    ir_begin_c_main()
    ir_label("entry")
    ir_c_main_arguments()
    ir_call_void("@freak_llvm_setup_args", "%argc_ext" + "|" + "%argv_ptr" + "|")
    pilot native_main_result = ""
    if has_main_task {
        ir_call_void("@__freak_generated_init_globals", "")
        if main_task_return_type == "int" {
            native_main_result = next_reg()
            ir_call(native_main_result, llvm_user_task_symbol("main"), "")
        } else {
            ir_call_void(llvm_user_task_symbol("main"), "")
        }
    }
    if not has_main_task {
        ir_call_void("@__freak_generated_top_level", "")
    }
    pilot cleanup_i = 0
    repeat top_count times {
        pilot cleanup_id: word = array_get(ast_top_stmts, cleanup_i)
        pilot cleanup_kind: word = array_get(ast_stmt_kinds, word_to_int(cleanup_id))
        if cleanup_kind == STMT_PILOT {
            pilot cleanup_name: word = array_get(ast_stmt_names, word_to_int(cleanup_id))
            if llvm_v3_owned_type(llvm_get_var_type(cleanup_name)) {
                pilot previous = next_reg()
                ir_load(previous, "@g_" + cleanup_name)
                llvm_v3_release(previous, llvm_get_var_type(cleanup_name))
            }
            if llvm_get_var_type(cleanup_name).starts_with("w") {
                pilot cleanup_value = next_reg()
                ir_load(cleanup_value, "@g_" + cleanup_name)
                ir_call_void("@freak_llvm_word_release_replaced", cleanup_value + "|" + "0" + "|")
                ir_store("0", "@g_" + cleanup_name)
            }
        }
        cleanup_i += 1
    }
    if native_main_result != "" {
        pilot native_exit_code = next_reg()
        ir_ret_i32(native_exit_code, native_main_result)
    } else {
        ir_ret_i32("", "")
    }
    ir_end_function()
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0

    -- Append string literals at end
    if llvm_builder_active { give back }
    llvm_emit_line("")
    llvm_emit_line("; String Literals")
    llvm_emit_line(string_literals)
    llvm_emit_line("!llvm.dbg.cu = !\{!" + word_from_int(llvm_dbg_cu_id) + "\}")
    llvm_emit_line("!llvm.module.flags = !\{!" + word_from_int(llvm_dbg_append("!\{i32 7, !\"Dwarf Version\", i32 4\}")) + ", !" + word_from_int(llvm_dbg_append("!\{i32 2, !\"Debug Info Version\", i32 3\}")) + "\}")
    llvm_emit_line(llvm_dbg_md)
}
