-- ===================================================================
-- FREAK v3 COMPILER — LLVM IR BACKEND EMITTER
-- ===================================================================
-- v3 KEY CHANGES:
-- 1. Streaming emit via fs::append (no buffer, no flush, no O(n^2))
-- 2. Flat if + early return for call mapping (never truncated)
-- 3. Proper reserved global-init wrapper emitted (no Python post-processing)
-- 4. Split into modular tasks (each <100 lines)

-- ===================== LLVM EMIT HELPERS =============================

pilot llvm_current_return_semantic_type = "v"
pilot llvm_integer_failure_reasons = ""
pilot llvm_integer_failure_operations = ""

-- ===================== IR SINKS =======================================
-- One lowering drives two sinks. The text sink writes the historical .ll
-- module byte for byte. The builder sink hands every instruction to LLVM's
-- IRBuilder through the C bridge in llvm_builder/ib_bridge.c, which keeps
-- the module in memory and emits an object (or bitcode/text on request).
-- Operands are the same names the text sink prints: "%t3", "%binding.local.7",
-- "@g_x", "@.str.2", integer or float literals. The bridge resolves them in a
-- per-function value table, so no textual IR is ever parsed.

pilot llvm_builder_active = false
pilot llvm_builder_fallback = false
pilot llvm_integer_failure_edges = ""

extern task freak_ib2_available() -> int
extern task freak_ib2_open(module_name: word, source_file: word, source_dir: word) -> int
extern task freak_ib2_error() -> word
extern task freak_ib2_close() -> int
extern task freak_ib2_finish(output: word, kind: int, triple: word, optimization: int) -> int
extern task freak_ib2_declare(name: word, returns_void: int, parameters: int) -> int
extern task freak_ib2_declare_support(kind: int) -> int
extern task freak_ib2_global(name: word) -> int
extern task freak_ib2_string(name: word, text: word) -> int
extern task freak_ib2_begin_function(symbol: word, returns: int, parameters: int, debug_name: word, line: int) -> int
extern task freak_ib2_end_function() -> int
extern task freak_ib2_label(name: word) -> int
extern task freak_ib2_set_line(line: int) -> int
extern task freak_ib2_call(dest: word, callee: word, arguments: word, returns_void: int) -> int
extern task freak_ib2_load(dest: word, pointer: word) -> int
extern task freak_ib2_store(value: word, pointer: word) -> int
extern task freak_ib2_alloca(dest: word) -> int
extern task freak_ib2_int(dest: word, operation: word, left: word, right: word) -> int
extern task freak_ib2_icmp(dest: word, predicate: word, left: word, right: word) -> int
extern task freak_ib2_fcmp(dest: word, predicate: word, left: word, right: word) -> int
extern task freak_ib2_float(dest: word, operation: word, left: word, right: word) -> int
extern task freak_ib2_cast(dest: word, kind: word, value: word) -> int
extern task freak_ib2_and1(dest: word, left: word, right: word) -> int
extern task freak_ib2_string_pointer(dest: word, global_name: word) -> int
extern task freak_ib2_br(label: word) -> int
extern task freak_ib2_cond_br(condition: word, then_label: word, else_label: word, cold: int) -> int
extern task freak_ib2_phi2(dest: word, first: word, first_block: word, second: word, second_block: word) -> int
extern task freak_ib2_overflow(dest: word, operation: word, left: word, right: word) -> int
extern task freak_ib2_extract(dest: word, pair: word, index: int) -> int
extern task freak_ib2_ret(value: word) -> int
extern task freak_ib2_ret_void() -> int
extern task freak_ib2_ret_i32(value: word) -> int
extern task freak_ib2_unreachable() -> int
extern task freak_ib2_integer_failure(edges: word) -> int

task llvm_emit(s: word) -> void {
    if llvm_builder_active {
        if s != "" { llvm_builder_fallback = true }
        give back
    }
    fs::append(out_file, s)
}

-- Text-sink argument list: "a|b|" -> "i64 a, i64 b"
task ir_args_text(arguments: word) -> word {
    pilot text = ""
    pilot current = ""
    pilot i = 0
    repeat until i >= arguments.length() {
        pilot ch = arguments.char_at(i)
        if ch == "|" {
            if text != "" { text = text + ", " }
            text = text + "i64 " + current
            current = ""
        } else { current = current + ch }
        i += 1
    }
    give back text
}

task ir_call(dest: word, callee: word, arguments: word) -> void {
    if llvm_builder_active { freak_ib2_call(dest, callee, arguments, 0) give back }
    llvm_emit_line("    " + dest + " = call i64 " + callee + "(" + ir_args_text(arguments) + ")")
}

task ir_call_void(callee: word, arguments: word) -> void {
    if llvm_builder_active { freak_ib2_call("", callee, arguments, 1) give back }
    llvm_emit_line("    call void " + callee + "(" + ir_args_text(arguments) + ")")
}

task ir_load(dest: word, pointer: word) -> void {
    if llvm_builder_active { freak_ib2_load(dest, pointer) give back }
    llvm_emit_line("    " + dest + " = load i64, i64* " + pointer)
}

task ir_store(value: word, pointer: word) -> void {
    if llvm_builder_active { freak_ib2_store(value, pointer) give back }
    llvm_emit_line("    store i64 " + value + ", i64* " + pointer)
}

task ir_alloca(dest: word) -> void {
    if llvm_builder_active { freak_ib2_alloca(dest) give back }
    llvm_emit_line("    " + dest + " = alloca i64")
}

task ir_int(dest: word, operation: word, left: word, right: word) -> void {
    if llvm_builder_active { freak_ib2_int(dest, operation, left, right) give back }
    llvm_emit_line("    " + dest + " = " + operation + " i64 " + left + ", " + right)
}

task ir_icmp(dest: word, predicate: word, left: word, right: word) -> void {
    if llvm_builder_active { freak_ib2_icmp(dest, predicate, left, right) give back }
    llvm_emit_line("    " + dest + " = icmp " + predicate + " i64 " + left + ", " + right)
}

task ir_fcmp(dest: word, predicate: word, left: word, right: word) -> void {
    if llvm_builder_active { freak_ib2_fcmp(dest, predicate, left, right) give back }
    llvm_emit_line("    " + dest + " = fcmp " + predicate + " double " + left + ", " + right)
}

task ir_float(dest: word, operation: word, left: word, right: word) -> void {
    if llvm_builder_active { freak_ib2_float(dest, operation, left, right) give back }
    llvm_emit_line("    " + dest + " = " + operation + " double " + left + ", " + right)
}

task ir_zext(dest: word, value: word) -> void {
    if llvm_builder_active { freak_ib2_cast(dest, "zext1", value) give back }
    llvm_emit_line("    " + dest + " = zext i1 " + value + " to i64")
}

task ir_and1(dest: word, left: word, right: word) -> void {
    if llvm_builder_active { freak_ib2_and1(dest, left, right) give back }
    llvm_emit_line("    " + dest + " = and i1 " + left + ", " + right)
}

task ir_i64_to_double(dest: word, value: word) -> void {
    if llvm_builder_active { freak_ib2_cast(dest, "i2d", value) give back }
    llvm_emit_line("    " + dest + " = bitcast i64 " + value + " to double")
}

task ir_double_to_i64(dest: word, value: word) -> void {
    if llvm_builder_active { freak_ib2_cast(dest, "d2i", value) give back }
    llvm_emit_line("    " + dest + " = bitcast double " + value + " to i64")
}

task ir_sitofp(dest: word, value: word) -> void {
    if llvm_builder_active { freak_ib2_cast(dest, "sitofp", value) give back }
    llvm_emit_line("    " + dest + " = sitofp i64 " + value + " to double")
}

task ir_ptrtoint(dest: word, value: word) -> void {
    if llvm_builder_active { freak_ib2_cast(dest, "ptrtoint", value) give back }
    llvm_emit_line("    " + dest + " = ptrtoint i8* " + value + " to i64")
}

task ir_string_pointer(dest: word, length: word, global_name: word) -> void {
    if llvm_builder_active { freak_ib2_string_pointer(dest, global_name) give back }
    llvm_emit_line("    " + dest + " = getelementptr inbounds [" + length + " x i8], [" + length + " x i8]* " + global_name + ", i64 0, i64 0")
}

task ir_br(label: word) -> void {
    if llvm_builder_active { freak_ib2_br(label) give back }
    llvm_emit_line("    br label %" + label)
}

task ir_cond_br(condition: word, then_label: word, else_label: word) -> void {
    if llvm_builder_active { freak_ib2_cond_br(condition, then_label, else_label, 0) give back }
    llvm_emit_line("    br i1 " + condition + ", label %" + then_label + ", label %" + else_label)
}

-- A branch whose true edge is a cold failure path.
task ir_cond_br_cold(condition: word, then_label: word, else_label: word) -> void {
    if llvm_builder_active { freak_ib2_cond_br(condition, then_label, else_label, 1) give back }
    llvm_emit_line("    br i1 " + condition + ", label %" + then_label + ", label %" + else_label + ", !prof !\{!\"branch_weights\", i32 1, i32 1048575\}")
}

task ir_label(name: word) -> void {
    if llvm_builder_active { freak_ib2_label(name) give back }
    llvm_emit_line(name + ":")
}

task ir_phi2(dest: word, first: word, first_block: word, second: word, second_block: word) -> void {
    if llvm_builder_active { freak_ib2_phi2(dest, first, first_block, second, second_block) give back }
    llvm_emit_line("    " + dest + " = phi i64 [ " + first + ", %" + first_block + " ], [ " + second + ", %" + second_block + " ]")
}

task ir_overflow(dest: word, operation: word, left: word, right: word) -> void {
    if llvm_builder_active { freak_ib2_overflow(dest, operation, left, right) give back }
    llvm_emit_line("    " + dest + " = call \{i64, i1\} @llvm.s" + operation + ".with.overflow.i64(i64 " + left + ", i64 " + right + ")")
}

task ir_extract(dest: word, pair: word, index: int) -> void {
    if llvm_builder_active { freak_ib2_extract(dest, pair, index) give back }
    llvm_emit_line("    " + dest + " = extractvalue \{i64, i1\} " + pair + ", " + word_from_int(index))
}

task ir_ret(value: word) -> void {
    if llvm_builder_active { freak_ib2_ret(value) give back }
    llvm_emit_line("    ret i64 " + value)
}

task ir_ret_void() -> void {
    if llvm_builder_active { freak_ib2_ret_void() give back }
    llvm_emit_line("    ret void")
}

task ir_unreachable() -> void {
    if llvm_builder_active { freak_ib2_unreachable() give back }
    llvm_emit_line("    unreachable")
}

task ir_comment(text: word) -> void {
    if llvm_builder_active { give back }
    llvm_emit_line("    ; " + text)
}

task ir_declare(return_type: word, symbol: word, parameters: int) -> void {
    if llvm_builder_active {
        pilot returns_void = 0
        if return_type == "void" { returns_void = 1 }
        freak_ib2_declare(symbol, returns_void, parameters)
        give back
    }
    pilot text = ""
    pilot index = 0
    repeat parameters times {
        if index > 0 { text = text + ", " }
        text = text + "i64"
        index += 1
    }
    llvm_emit_line("declare " + return_type + " " + symbol + "(" + text + ")")
}

task ir_global(name: word) -> void {
    if llvm_builder_active { freak_ib2_global("g_" + name) give back }
    llvm_emit_line("@g_" + name + " = global i64 0")
}

-- returns: "void", "i64"
task ir_begin_function(return_type: word, symbol: word, parameters: int, debug_name: word, line_no: int) -> void {
    pilot parameter_text = ""
    pilot index = 0
    repeat parameters times {
        if index > 0 { parameter_text = parameter_text + ", " }
        parameter_text = parameter_text + "i64 %parameter.input." + word_from_int(index)
        index += 1
    }
    pilot debug_attribute = llvm_dbg_begin_func(debug_name, line_no)
    if llvm_builder_active {
        pilot returns = 1
        if return_type == "void" { returns = 0 }
        if line_no <= 0 { line_no = 1 }
        freak_ib2_begin_function(symbol, returns, parameters, debug_name, line_no)
        give back
    }
    llvm_emit_line("define " + return_type + " " + symbol + "(" + parameter_text + ")" + debug_attribute + " \{")
}

task ir_begin_c_main() -> void {
    pilot debug_attribute = llvm_dbg_begin_func("main", 1)
    if llvm_builder_active { freak_ib2_begin_function("main", 2, 2, "main", 1) give back }
    llvm_emit_line("define i32 @main(i32 %argc, i8** %argv)" + debug_attribute + " \{")
}

task ir_c_main_arguments() -> void {
    if llvm_builder_active { freak_ib2_cast("%argc_ext", "sext32", "%argc") freak_ib2_cast("%argv_ptr", "ptrtoint", "%argv") give back }
    llvm_emit_line("    %argc_ext = sext i32 %argc to i64")
    llvm_emit_line("    %argv_ptr = ptrtoint i8** %argv to i64")
}

task ir_ret_i32(dest: word, value: word) -> void {
    if llvm_builder_active { freak_ib2_ret_i32(value) give back }
    if value == "" {
        llvm_emit_line("    ret i32 0")
        give back
    }
    llvm_emit_line("    " + dest + " = trunc i64 " + value + " to i32")
    llvm_emit_line("    ret i32 " + dest)
}

task ir_end_function() -> void {
    if llvm_builder_active { freak_ib2_end_function() give back }
    llvm_emit_line("\}")
}

task ir_set_line(line_no: int) -> void {
    if llvm_builder_active { freak_ib2_set_line(line_no) }
}

task ir_string_literal(name: word, value: word, declaration: word) -> void {
    if llvm_builder_active { freak_ib2_string(name, value) give back }
    string_literals = string_literals + declaration
}

task ir_declare_integer_support() -> void {
    if llvm_builder_active { freak_ib2_declare_support(1) give back }
    llvm_emit_line("declare void @__freak_int_fail(i8*, i8*) cold noreturn")
    llvm_emit_line("declare \{i64, i1\} @llvm.sadd.with.overflow.i64(i64, i64)")
    llvm_emit_line("declare \{i64, i1\} @llvm.ssub.with.overflow.i64(i64, i64)")
    llvm_emit_line("declare \{i64, i1\} @llvm.smul.with.overflow.i64(i64, i64)")
    llvm_emit_line("@__freak_int_overflow = private unnamed_addr constant [9 x i8] c\"overflow\\00\"")
    llvm_emit_line("@__freak_int_division_by_zero = private unnamed_addr constant [17 x i8] c\"division by zero\\00\"")
    llvm_emit_line("@__freak_int_addition = private unnamed_addr constant [9 x i8] c\"addition\\00\"")
    llvm_emit_line("@__freak_int_subtraction = private unnamed_addr constant [12 x i8] c\"subtraction\\00\"")
    llvm_emit_line("@__freak_int_multiplication = private unnamed_addr constant [15 x i8] c\"multiplication\\00\"")
    llvm_emit_line("@__freak_int_division = private unnamed_addr constant [9 x i8] c\"division\\00\"")
    llvm_emit_line("@__freak_int_remainder = private unnamed_addr constant [10 x i8] c\"remainder\\00\"")
    llvm_emit_line("@__freak_int_negation = private unnamed_addr constant [9 x i8] c\"negation\\00\"")
}

task ir_declare_libc() -> void {
    if llvm_builder_active { freak_ib2_declare_support(2) give back }
    llvm_emit_line("declare i32 @puts(i8*)")
    llvm_emit_line("declare i32 @printf(i8*, ...)")
    llvm_emit_line("declare i64 @strlen(i8*)")
}

task ir_result_drop_helper() -> void {
    if llvm_builder_active { freak_ib2_declare_support(3) give back }
    llvm_emit_line("define internal void @__freak_drop_result(i64 %ticket) \{")
    llvm_emit_line("entry:")
    llvm_emit_line("    %live = icmp ne i64 %ticket, 0")
    llvm_emit_line("    br i1 %live, label %release, label %done")
    llvm_emit_line("release:")
    llvm_emit_line("    call void @freak_llvm_fs_result_release(i64 %ticket)")
    llvm_emit_line("    br label %done")
    llvm_emit_line("done:")
    llvm_emit_line("    ret void")
    llvm_emit_line("\}")
}

task ir_integer_failure_block() -> void {
    if llvm_integer_failure_reasons == "" { give back }
    if llvm_builder_active { freak_ib2_integer_failure(llvm_integer_failure_edges) give back }
    llvm_emit_line("integer.fail:")
    llvm_emit_line("    %integer.reason = phi i8* " + llvm_integer_failure_reasons)
    llvm_emit_line("    %integer.operation = phi i8* " + llvm_integer_failure_operations)
    llvm_emit_line("    call void @__freak_int_fail(i8* %integer.reason, i8* %integer.operation)")
    llvm_emit_line("    unreachable")
}

-- In builder mode every instruction goes through an ir_* sink. A raw line
-- reaching this point means some lowering has no builder form yet, so the
-- module is marked and the CLI re-emits it through the text path instead.
task llvm_emit_line(s: word) -> void {
    if llvm_builder_active {
        if s != "" and not s.starts_with(";") and not s.starts_with("    ;") { llvm_builder_fallback = true }
        give back
    }
    pilot out = s
    if llvm_dbg_current_scope_id > 0 and llvm_dbg_current_line > 0 {
        if s.starts_with("    ") and not s.starts_with("    ;") {
            pilot loc_id = llvm_dbg_emit_location(llvm_dbg_current_line)
            out = s + ", !dbg !" + word_from_int(loc_id)
        }
    }
    fs::append(out_file, out + "\n")
}

task next_reg() -> word {
    pilot r = "%t" + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    give back r
}

task llvm_escape_str(s: word) -> word {
    pilot esc_out = ""
    pilot esc_len = s.length()
    pilot esc_i = 0
    repeat until esc_i >= esc_len {
        pilot ch = s.char_at(esc_i)
        if ch == "\\" and esc_i + 3 < esc_len {
            pilot nx = s.char_at(esc_i + 1)
            if nx == "x" {
                -- \xNN hex escape from lexer -> LLVM IR \NN
                pilot h1 = s.char_at(esc_i + 2)
                pilot h2 = s.char_at(esc_i + 3)
                esc_out = esc_out + "\\" + h1 + h2
                esc_i += 4
            } else {
                esc_out = esc_out + "\\5C"
                esc_i += 1
            }
        } else if ch == "\"" { esc_out = esc_out + "\\22" esc_i += 1 }
        else if ch == "\\" { esc_out = esc_out + "\\5C" esc_i += 1 }
        else if ch == "\n" { esc_out = esc_out + "\\0A" esc_i += 1 }
        else if ch == "\r" { esc_out = esc_out + "\\0D" esc_i += 1 }
        else if ch == "\t" { esc_out = esc_out + "\\09" esc_i += 1 }
        else { esc_out = esc_out + ch esc_i += 1 }
    }
    give back esc_out
}

task llvm_dbg_escape(s: word) -> word {
    pilot out = ""
    pilot i = 0
    pilot slen = s.length()
    repeat until i >= slen {
        pilot ch = s.char_at(i)
        if ch == "\\" { out = out + "\\5C" }
        else if ch == "\"" { out = out + "\\22" }
        else { out = out + ch }
        i += 1
    }
    give back out
}

task llvm_dbg_append(defn: word) -> int {
    pilot id = llvm_dbg_next_id
    llvm_dbg_next_id += 1
    llvm_dbg_md = llvm_dbg_md + "!" + word_from_int(id) + " = " + defn + "\n"
    give back id
}

task llvm_dbg_init() -> void {
    llvm_dbg_md = ""
    llvm_dbg_next_id = 0
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0
    llvm_dbg_current_dir = "."
    llvm_dbg_current_file = input_file

    pilot slash = -1
    pilot i = 0
    pilot plen = input_file.length()
    repeat until i >= plen {
        pilot ch = input_file.char_at(i)
        if ch == "/" or ch == "\\" {
            slash = i
        }
        i += 1
    }

    if slash >= 0 {
        pilot base = ""
        i = slash + 1
        repeat until i >= plen {
            base = base + input_file.char_at(i)
            i += 1
        }
        if base != "" {
            llvm_dbg_current_file = base
        }

        pilot dir = ""
        i = 0
        repeat until i >= slash {
            dir = dir + input_file.char_at(i)
            i += 1
        }
        if dir != "" {
            llvm_dbg_current_dir = dir
        }
    }

    pilot file_name = llvm_dbg_escape(llvm_dbg_current_file)
    pilot dir_name = llvm_dbg_escape(llvm_dbg_current_dir)
    llvm_dbg_file_id = llvm_dbg_append("!DIFile(filename: \"" + file_name + "\", directory: \"" + dir_name + "\")")
    llvm_dbg_cu_id = llvm_dbg_append("distinct !DICompileUnit(language: DW_LANG_C, file: !" + word_from_int(llvm_dbg_file_id) + ", producer: \"FREAK v3\", isOptimized: false, runtimeVersion: 0, emissionKind: LineTablesOnly)")
    llvm_dbg_empty_id = llvm_dbg_append("!\{\}")
    llvm_dbg_subroutine_type_id = llvm_dbg_append("!DISubroutineType(types: !" + word_from_int(llvm_dbg_empty_id) + ")")
}

task llvm_dbg_emit_subprogram(name: word, line_no: int) -> int {
    if line_no <= 0 { line_no = 1 }
    give back llvm_dbg_append("distinct !DISubprogram(name: \"" + llvm_dbg_escape(name) + "\", scope: !" + word_from_int(llvm_dbg_file_id) + ", file: !" + word_from_int(llvm_dbg_file_id) + ", line: " + word_from_int(line_no) + ", type: !" + word_from_int(llvm_dbg_subroutine_type_id) + ", scopeLine: " + word_from_int(line_no) + ", spFlags: DISPFlagDefinition, unit: !" + word_from_int(llvm_dbg_cu_id) + ", retainedNodes: !" + word_from_int(llvm_dbg_empty_id) + ")")
}

task llvm_dbg_emit_location(line_no: int) -> int {
    if line_no <= 0 { line_no = 1 }
    give back llvm_dbg_append("!DILocation(line: " + word_from_int(line_no) + ", column: 1, scope: !" + word_from_int(llvm_dbg_current_scope_id) + ")")
}

task llvm_dbg_set_stmt_line(eid: word) -> void {
    pilot line_no = 1
    if eid.length() > 0 {
        pilot idx = word_to_int(eid)
        line_no = word_to_int(array_get(ast_stmt_lines, idx))
        if line_no <= 0 { line_no = 1 }
    }
    llvm_dbg_current_line = line_no
    ir_set_line(line_no)
}

task llvm_dbg_begin_func(name: word, line_no: int) -> word {
    llvm_integer_failure_reasons = ""
    llvm_integer_failure_operations = ""
    llvm_integer_failure_edges = ""
    -- LB10 minimal: emit a DISubprogram for this function, set the
    -- current scope so llvm_emit_line attaches `!dbg !N` to every
    -- instruction, and return the function-level attribute that
    -- links the definition to the subprogram. The `lineTablesOnly`
    -- emission kind in llvm_dbg_init keeps the metadata footprint
    -- bounded — no variable info, no type info, just enough for
    -- source-line backtraces in gdb/lldb.
    pilot sp_id = llvm_dbg_emit_subprogram(name, line_no)
    llvm_dbg_current_scope_id = sp_id
    llvm_dbg_current_line = line_no
    give back " !dbg !" + word_from_int(sp_id)
}

task llvm_string_byte_len(val: word) -> int {
    pilot source_len = val.length()
    pilot byte_len = 0
    pilot i = 0
    repeat until i >= source_len {
        if val.char_at(i) == "\\" and i + 3 < source_len {
            if val.char_at(i + 1) == "x" {
                i += 4
            } else {
                i += 1
            }
        } else {
            i += 1
        }
        byte_len += 1
    }
    give back byte_len
}

task register_string_literal(val: word) -> word {
    pilot id = "@.str." + word_from_int(string_literals_count)
    string_literals_count += 1
    pilot real_val = val
    pilot null_term_len = llvm_string_byte_len(real_val) + 1
    pilot escaped = llvm_escape_str(real_val)
    pilot decl = id + " = private unnamed_addr constant [" + word_from_int(null_term_len) + " x i8] c\"" + escaped + "\\00\", align 1\n"
    ir_string_literal(id, real_val, decl)
    give back id
}

task llvm_c_safe_ident(s: word) -> word {
    pilot res = ""
    pilot slen = s.length()
    pilot i = 0
    repeat slen times {
        pilot c = s.char_at(i)
        if c == ":" {
            if i + 1 < slen {
                if s.char_at(i + 1) == ":" {
                    res = res + "_"
                    i += 1
                } else { res = res + c }
            } else { res = res + c }
        } else { res = res + c }
        i += 1
    }
    give back res
}

-- ===================== TYPE TRACKING =================================

task llvm_set_var_type(name: word, vtype: word) -> void {
    llvm_var_names = llvm_var_names + name + "|"
    llvm_var_types = llvm_var_types + vtype + "|"
}

task llvm_type_at(types: word, wanted: int) -> word {
    pilot i = 0
    pilot idx = 0
    pilot current = ""
    repeat until i >= types.length() {
        pilot c = types.char_at(i)
        if c == "|" {
            if idx == wanted { give back current }
            idx += 1
            current = ""
        } else {
            current = current + c
        }
        i += 1
    }
    give back ""
}

task llvm_lookup_type(names: word, types: word, name: word) -> word {
    pilot nlen = names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    pilot found = ""
    repeat until i >= nlen {
        pilot c = names.char_at(i)
        if c == "|" {
            if cur_name == name {
                -- Keep scanning so the newest same-scope binding wins.
                found = llvm_type_at(types, idx)
            }
            idx += 1
            cur_name = ""
        } else { cur_name = cur_name + c }
        i += 1
    }
    give back found
}

task llvm_get_var_type(name: word) -> word {
    pilot local_type = llvm_lookup_type(llvm_var_names, llvm_var_types, name)
    if local_type != "" { give back local_type }
    pilot global_type = llvm_lookup_type(llvm_global_type_names, llvm_global_types, name)
    if global_type != "" { give back global_type }
    give back "i"
}

task llvm_type_code(type_name: word) -> word {
    if type_name == "CheckedReadResult" { give back "r" }
    if type_name.starts_with("List<") { give back "a:" + llvm_type_code(type_name.substring(5, type_name.length() - 6)) }
    if type_name.starts_with("a:") { give back type_name }
    if type_name == "q" or type_name == "ByteBuffer" { give back "q" }
    if type_name == "w" or type_name == "word" { give back "w" }
    if type_name == "n" or type_name == "num" or type_name == "float" { give back "n" }
    if type_name == "b" or type_name == "bool" { give back "b" }
    if type_name == "v" or type_name == "void" or type_name == "" { give back "v" }
    if type_name.starts_with("s:") { give back type_name }
    if is_shape_name(type_name) { give back "s:" + type_name }
    give back "i"
}

task llvm_shape_name_from_type(vtype: word) -> word {
    if vtype.starts_with("s:") and vtype.length() > 2 {
        give back vtype.substring(2, vtype.length() - 2)
    }
    give back ""
}

task llvm_register_task(name: word, ret_type: word) -> void {
    pilot t = llvm_type_code(ret_type)
    llvm_task_reg_names = llvm_task_reg_names + name + "|"
    llvm_task_reg_types = llvm_task_reg_types + t + "|"
    llvm_task_reg_count += 1
}

task llvm_get_task_ret_type(name: word) -> word {
    -- Source-associated names retain the checker's impl provenance. Their
    -- registry spelling uses underscores, but callers still use Owner::task.
    pilot associated_entry = tc_associated_callable_entry(name)
    if associated_entry >= 0 { give back llvm_type_code(array_get(tc_callable_returns, associated_entry)) }
    pilot nlen = llvm_task_reg_names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    repeat until i >= nlen {
        pilot c = llvm_task_reg_names.char_at(i)
        if c == "|" {
            if cur_name == name {
                pilot ti = 0
                pilot cur_type = ""
                pilot tidx = 0
                pilot tlen = llvm_task_reg_types.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_task_reg_types.char_at(ti)
                    if tc == "|" {
                        if tidx == idx { give back cur_type }
                        tidx += 1
                        cur_type = ""
                    } else { cur_type = cur_type + tc }
                    ti += 1
                }
            }
            idx += 1
            cur_name = ""
        } else { cur_name = cur_name + c }
        i += 1
    }
    give back ""
}

task llvm_is_global(vname: word) -> bool {
    pilot needle = "|" + vname + "|"
    give back llvm_global_names.contains(needle)
}

-- Register a FREAK→LLVM name binding (latest entry wins on lookup)
task llvm_reg_var(freak_name: word, llvm_name: word) -> void {
    llvm_var_reg_map = llvm_var_reg_map + freak_name + ":" + llvm_name + "|"
}

-- Look up the latest LLVM name for a FREAK variable name (scan from end)
-- Format: "freak_name:llvm_name|freak_name2:llvm_name2|..."
task llvm_get_llvm_name(freak_name: word) -> word {
    pilot mlen = llvm_var_reg_map.length()
    pilot i = mlen - 1
    pilot cur_llvm = ""
    pilot cur_freak = ""
    pilot in_llvm = true
    repeat until i < 0 {
        pilot ch = llvm_var_reg_map.char_at(i)
        if ch == "|" {
            -- End of an entry: check the accumulated freak name
            if cur_freak == freak_name and cur_llvm.length() > 0 { give back cur_llvm }
            cur_llvm = ""
            cur_freak = ""
            in_llvm = true
        } else if ch == ":" {
            in_llvm = false
        } else if in_llvm {
            cur_llvm = ch + cur_llvm
        } else {
            cur_freak = ch + cur_freak
        }
        i -= 1
    }
    -- Check the first entry (no leading |)
    if cur_freak == freak_name and cur_llvm.length() > 0 { give back cur_llvm }
    give back ""
}

task llvm_var_ptr(vname: word) -> word {
    pilot unique = llvm_get_llvm_name(vname)
    if unique != "" { give back "%" + unique }
    if llvm_is_global(vname) { give back "@g_" + vname }
    -- Unknown name: assume it's an unresolved top-level global. Emitting
    -- "%vname" would produce an undefined SSA register and a confusing
    -- clang error. "@g_vname" surfaces a clean linker-time missing-symbol
    -- error instead.
    give back "@g_" + vname
}

task llvm_is_runtime_func(fname: word) -> bool {
    pilot needle = "|" + fname + "|"
    give back llvm_declared_funcs.contains(needle)
}

-- ===================== TYPE INFERENCE ================================

task llvm_infer_expr_type(expr_id: word) -> word {
    if expr_id.length() == 0 { give back "i" }
    pilot i = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)

    if kind == EXPR_STR or kind == EXPR_INTERP { give back "w" }
    if kind == EXPR_INT { give back "i" }
    if kind == EXPR_FLOAT { give back "n" }
    if kind == EXPR_BOOL { give back "b" }
    if kind == EXPR_IDENT { give back llvm_get_var_type(val) }
    if kind == EXPR_ARRAY_LIT {
        pilot items: word = array_get(ast_expr_lefts, i)
        pilot item_type = "w"
        if tc_arg_count(items) > 0 { item_type = llvm_infer_expr_type(word_from_int(tc_arg_at(items, 0))) }
        pilot ai = 0
        repeat tc_arg_count(items) times {
            if llvm_infer_expr_type(word_from_int(tc_arg_at(items, ai))) == "n" { item_type = "n" }
            ai += 1
        }
        give back "a:" + item_type
    }
    if kind == EXPR_INDEX {
        pilot receiver_type = llvm_infer_expr_type(array_get(ast_expr_lefts, i))
        if receiver_type.starts_with("a:") { give back receiver_type.substring(2, receiver_type.length() - 2) }
        if receiver_type == "w" { give back "w" }
        give back "i"
    }
    if kind == EXPR_CALL and val == "List::filled" {
        pilot arguments: word = array_get(ast_expr_lefts, i)
        give back "a:" + llvm_infer_expr_type(word_from_int(tc_arg_at(arguments, 0)))
    }
    if kind == EXPR_CALL and (val == "List::new" or val == "List::with_capacity") { give back "a:w" }

    if kind == EXPR_METHOD {
        pilot recv_expr: word = array_get(ast_expr_lefts, i)
        pilot recv_type = llvm_infer_expr_type(recv_expr)
        if recv_type.starts_with("a:") {
            pilot list_elem = recv_type.substring(2, recv_type.length() - 2)
            pilot list_semantic = "int"
            if list_elem == "n" { list_semantic = "num" }
            else if list_elem == "w" { list_semantic = "word" }
            else if list_elem == "b" { list_semantic = "bool" }
            else if list_elem.starts_with("s:") { list_semantic = list_elem.substring(2, list_elem.length() - 2) }
            else if list_elem == "i" { list_semantic = "int" }
            else { list_semantic = "int" }
            pilot list_recv = "List<" + list_semantic + ">"
            pilot list_ret = tc_builtin_method_return_type(list_recv, val)
            if list_ret != "" { give back llvm_type_code(list_ret) }
        }
        pilot recv_shape = llvm_shape_name_from_type(recv_type)
        if recv_shape != "" {
            pilot exact_ret = llvm_get_task_ret_type(recv_shape + "_" + val)
            if exact_ret.length() > 0 { give back exact_ret }
        }
        pilot recv_builtin_type = "int"
        if recv_type.starts_with("q") { recv_builtin_type = "ByteBuffer" }
        else if recv_type.starts_with("w") { recv_builtin_type = "word" }
        else if recv_type.starts_with("n") { recv_builtin_type = "num" }
        else if recv_type.starts_with("b") { recv_builtin_type = "bool" }
        pilot builtin_ret = tc_builtin_method_return_type(recv_builtin_type, val)
        if builtin_ret != "" { give back llvm_type_code(builtin_ret) }
        if recv_shape == "" {
            pilot mi = 0
            repeat shape_registry_count times {
                pilot msname: word = "" + array_get(shape_registry_names, mi)
                pilot impl_ret: word = llvm_get_task_ret_type(msname + "_" + val)
                if impl_ret.length() > 0 { give back impl_ret }
                mi += 1
            }
        }
    }

    if kind == EXPR_FIELD {
        pilot recv_expr: word = array_get(ast_expr_lefts, i)
        give back llvm_infer_field_type(recv_expr, val)
    }

    if kind == EXPR_BINOP {
        if val == "==" or val == "!=" or val == "<" or val == ">" or val == "<=" or val == ">=" or val == "and" or val == "or" { give back "b" }
        pilot left: word = array_get(ast_expr_lefts, i)
        pilot right: word = array_get(ast_expr_rights, i)
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        if val == "+" {
            if lt.starts_with("w") or rt.starts_with("w") { give back "w" }
        }
        if lt.starts_with("n") or rt.starts_with("n") {
            if val == "+" or val == "-" or val == "*" or val == "/" or val == "%" { give back "n" }
        }
    }

    if kind == EXPR_UNARYOP {
        if val == "not" { give back "b" }
        give back llvm_infer_expr_type(array_get(ast_expr_lefts, i))
    }

    if kind == EXPR_CALL {
        give back llvm_infer_call_type(val)
    }

    give back "i"
}

task llvm_infer_field_type(receiver_expr: word, field_name: word) -> word {
    pilot receiver_shape = llvm_shape_name_from_type(llvm_infer_expr_type(receiver_expr))
    if receiver_shape != "" {
        pilot exact_type = get_shape_field_type(receiver_shape, field_name)
        if exact_type != "" { give back llvm_type_code(exact_type) }
        give back "i"
    }

    -- A receiver without a shape type may use the legacy fallback only when
    -- every matching shape agrees. Ambiguous names must not silently borrow a
    -- word as an integer (or vice versa).
    pilot inferred = ""
    pilot fi = 0
    repeat shape_registry_count times {
        pilot shape_name: word = array_get(shape_registry_names, fi)
        pilot raw_type = get_shape_field_type(shape_name, field_name)
        if raw_type != "" {
            pilot candidate = llvm_type_code(raw_type)
            if inferred == "" { inferred = candidate }
            else if inferred != candidate { give back "i" }
        }
        fi += 1
    }
    if inferred != "" { give back inferred }
    give back "i"
}

task llvm_infer_field_index(receiver_expr: word, field_name: word) -> int {
    pilot receiver_shape = llvm_shape_name_from_type(llvm_infer_expr_type(receiver_expr))
    if receiver_shape != "" { give back get_shape_field_index(receiver_shape, field_name) }

    pilot inferred = 0 - 1
    pilot si = 0
    repeat shape_registry_count times {
        pilot candidate = get_shape_field_index(array_get(shape_registry_names, si), field_name)
        if candidate >= 0 {
            if inferred < 0 { inferred = candidate }
            else if inferred != candidate { give back 0 - 1 }
        }
        si += 1
    }
    give back inferred
}

task llvm_shape_field_type_at(shape_name: word, wanted: int) -> word {
    pilot fields = get_shape_fields(shape_name)
    pilot field_index = 0
    pilot current_type = ""
    pilot in_type = false
    pilot i = 0
    repeat fields.length() times {
        pilot ch = fields.char_at(i)
        if ch == ":" {
            in_type = true
        } else if ch == "," {
            if field_index == wanted { give back llvm_type_code(current_type) }
            field_index += 1
            current_type = ""
            in_type = false
        } else if in_type {
            current_type = current_type + ch
        }
        i += 1
    }
    if field_index == wanted { give back llvm_type_code(current_type) }
    give back ""
}

task llvm_infer_call_type(val: word) -> word {
    pilot builtin_type = tc_builtin_call_type(val)
    if builtin_type != "" { give back llvm_type_code(builtin_type) }
    if val.starts_with("shape::ctor::") {
        give back "s:" + val.replace("shape::ctor::", "")
    }
    pilot task_ret = llvm_get_task_ret_type(val)
    if task_ret.length() > 0 { give back task_ret }
    give back "i"
}

-- ===================== NUM HELPERS ===================================

task llvm_i64_to_double(i64_reg: word) -> word {
    pilot dbl = next_reg()
    ir_i64_to_double(dbl, i64_reg)
    give back dbl
}

task llvm_double_to_i64(dbl_reg: word) -> word {
    pilot i64r = next_reg()
    ir_double_to_i64(i64r, dbl_reg)
    give back i64r
}

task llvm_numeric_to_double(i64_reg: word, expr_id: word) -> word {
    if llvm_infer_expr_type(expr_id).starts_with("n") {
        give back llvm_i64_to_double(i64_reg)
    }
    pilot dbl = next_reg()
    ir_sitofp(dbl, i64_reg)
    give back dbl
}

task llvm_coerce_num_bits(i64_reg: word, expr_id: word) -> word {
    if llvm_infer_expr_type(expr_id).starts_with("n") { give back i64_reg }
    if not llvm_infer_expr_type(expr_id).starts_with("i") { give back i64_reg }
    pilot dbl = next_reg()
    ir_sitofp(dbl, i64_reg)
    give back llvm_double_to_i64(dbl)
}

task llvm_emit_num_compound_bits(current_bits: word, rhs_reg: word, rhs_expr: word, float_op: word) -> word {
    pilot current_double = llvm_i64_to_double(current_bits)
    pilot rhs_double = llvm_numeric_to_double(rhs_reg, rhs_expr)
    pilot combined = next_reg()
    ir_float(combined, float_op, current_double, rhs_double)
    give back llvm_double_to_i64(combined)
}

task llvm_is_num_expr(expr_id: word) -> bool {
    pilot t = llvm_infer_expr_type(expr_id)
    if t.starts_with("n") { give back true }
    give back false
}

-- ===================== CALL MAPPING (FLAT) ============================
-- v3 KEY CHANGE: flat if + early return. Never truncated.

task llvm_map_call_name(val: word) -> word {
    if val == "process::platform_name" { give back "@freak_llvm_process_platform_name" }
    if val == "process::stdout_is_terminal" { give back "@freak_llvm_process_stdout_is_terminal" }
    if val == "process::platform_is_windows" { give back "@freak_llvm_process_platform_is_windows" }
    if val == "process::executable_path" { give back "@freak_llvm_process_executable_path" }
    if val.starts_with("http_server::") and tc_builtin_call_type(val) != "" { give back "@freak_llvm_" + val.replace("::", "_") }
    if tc_profile_helper_allowed(val) and val == "chr" { give back "@freak_llvm_char_to_word" }
    if tc_profile_helper_allowed(val) and val == "word_to_num" { give back "@freak_llvm_parse_num" }
    if val.starts_with("json_document::") and tc_builtin_call_type(val) != "" { give back "@freak_llvm_" + val.replace("::", "_") }
    if val == "time::sleep" { give back "@freak_llvm_time_sleep" }
    if val == "freak_word_compare" and emt_is_extern(val) { give back "@freak_llvm_word_compare" }
    if val == "fs::read" { give back "@freak_llvm_fs_read_native" }
    if val == "fs::write" { give back "@freak_llvm_fs_write_native" }
    if val == "fs::append" { give back "@freak_llvm_fs_append_native" }
    if val == "fs::exists" { give back "@freak_llvm_fs_exists_native" }
    if val == "fs::delete" { give back "@freak_llvm_fs_delete_native" }
    if val == "fs::read_checked" { give back "@freak_llvm_fs_read_source_ticket" }
    if val.starts_with("fs::") and tc_builtin_call_type(val) != "" { give back "@freak_llvm_" + val.replace("::", "_") }
    if val.starts_with("process::command_") and tc_builtin_call_type(val) != "" { give back "@freak_llvm_" + val.replace("::", "_") }
    if val == "ByteBuffer::new" { give back "@freak_llvm_byte_buffer_new" }
    if val == "ByteBuffer::with_capacity" { give back "@freak_llvm_byte_buffer_with_capacity" }
    if val == "say" { give back "@freak_llvm_say" }
    if val == "ask" { give back "@freak_llvm_ask" }
    if val == "word_from_int" { give back "@freak_llvm_word_from_int" }
    if val == "word_from_bool" { give back "@freak_llvm_word_from_bool" }
    if val == "word_to_int" { give back "@freak_llvm_word_to_int" }
    if val == "word_concat" { give back "@freak_llvm_word_concat" }
    if val == "char_to_word" { give back "@freak_llvm_char_to_word" }
    if val == "fs::list_dir" { give back "@freak_llvm_fs_list_dir" }
    if val == "fs::make_dir" { give back "@freak_llvm_fs_make_dir" }
    if val == "process::env" { give back "@freak_llvm_process_env" }
    if val == "process::set_env" { give back "@freak_llvm_process_set_env" }
    if val == "process::pid" { give back "@freak_llvm_process_pid" }
    if val == "process::input" { give back "@freak_llvm_process_input" }
    if val == "process::args_count" { give back "@freak_llvm_process_args_count" }
    if val == "process::arg" { give back "@freak_llvm_process_arg" }
    if val == "process::exit" { give back "@freak_llvm_process_exit" }
    if val == "process::exec" { give back "@freak_llvm_process_exec" }
    if val == "process::exec_capture" { give back "@freak_llvm_process_exec_capture" }
    if val == "time::now_ms" { give back "@freak_llvm_time_now_ms" }
    if val == "time::monotonic_ns" { give back "@freak_llvm_time_monotonic_ns" }
    if val == "panic" { give back "@freak_llvm_panic" }
    if val == "array_new" { give back "@freak_llvm_array_new" }
    if val == "array_push" { give back "@freak_llvm_array_push_owned" }
    if val == "array_get" { give back "@freak_llvm_array_get" }
    if val == "array_set" { give back "@freak_llvm_array_set_owned" }
    if val == "array_len" { give back "@freak_llvm_array_len" }
    if val == "array_release" { give back "@freak_llvm_array_release_owned" }
    if val == "word_join" { give back "@freak_llvm_word_join_owned" }
    if val == "word_builder::new" { give back "@freak_llvm_word_builder_new" }
    if val == "word_builder::with_capacity" { give back "@freak_llvm_word_builder_with_capacity" }
    if val == "word_builder::reserve" { give back "@freak_llvm_word_builder_reserve" }
    if val == "word_builder::capacity" { give back "@freak_llvm_word_builder_capacity" }
    if val == "word_builder::length" { give back "@freak_llvm_word_builder_length" }
    if val == "word_builder::clear" { give back "@freak_llvm_word_builder_clear" }
    if val == "word_builder::append" { give back "@freak_llvm_word_builder_append" }
    if val == "word_builder::append_char" { give back "@freak_llvm_word_builder_append_char" }
    if val == "word_builder::append_int" { give back "@freak_llvm_word_builder_append_int" }
    if val == "word_builder::finish" { give back "@freak_llvm_word_builder_finish" }
    if val == "word_builder::discard" { give back "@freak_llvm_word_builder_discard" }
    if val == "ui::create_window" { give back "@freak_llvm_ui_create_window" }
    if val == "ui::destroy_window" { give back "@freak_llvm_ui_destroy_window" }
    if val == "ui::poll_events" { give back "@freak_llvm_ui_poll_events" }
    if val == "ui::begin_frame" { give back "@freak_llvm_ui_begin_frame" }
    if val == "ui::set_clip" { give back "@freak_llvm_ui_set_clip" }
    if val == "ui::reset_clip" { give back "@freak_llvm_ui_reset_clip" }
    if val == "ui::end_frame" { give back "@freak_llvm_ui_end_frame" }
    if val == "ui::event_kind" { give back "@freak_llvm_ui_event_kind" }
    if val == "ui::event_key" { give back "@freak_llvm_ui_event_key" }
    if val == "ui::event_pressed" { give back "@freak_llvm_ui_event_pressed" }
    if val == "ui::event_character" { give back "@freak_llvm_ui_event_character" }
    if val == "ui::event_mouse_x" { give back "@freak_llvm_ui_event_mouse_x" }
    if val == "ui::event_mouse_y" { give back "@freak_llvm_ui_event_mouse_y" }
    if val == "ui::event_button" { give back "@freak_llvm_ui_event_button" }
    if val == "ui::event_repeat" { give back "@freak_llvm_ui_event_repeat" }
    if val == "ui::event_scroll_dy" { give back "@freak_llvm_ui_event_scroll_dy" }
    if val == "ui::event_width" { give back "@freak_llvm_ui_event_width" }
    if val == "ui::event_height" { give back "@freak_llvm_ui_event_height" }
    if val == "ui::event_gained" { give back "@freak_llvm_ui_event_gained" }
    if val == "ui::get_width" { give back "@freak_llvm_ui_get_width" }
    if val == "ui::get_height" { give back "@freak_llvm_ui_get_height" }
    if val == "ui::clear" { give back "@freak_llvm_ui_clear" }
    if val == "ui::fill_rect" { give back "@freak_llvm_ui_fill_rect" }
    if val == "ui::stroke_rect" { give back "@freak_llvm_ui_stroke_rect" }
    if val == "ui::fill_circle" { give back "@freak_llvm_ui_fill_circle" }
    if val == "ui::draw_line" { give back "@freak_llvm_ui_draw_line" }
    if val == "ui::draw_text" { give back "@freak_llvm_ui_draw_text" }
    if val == "ui::measure_text" { give back "@freak_llvm_ui_measure_text" }
    if val == "math::sqrt" { give back "@freak_llvm_math_sqrt" }
    if val == "math::pow" { give back "@freak_llvm_math_pow" }
    if val == "math::sin" { give back "@freak_llvm_math_sin" }
    if val == "math::cos" { give back "@freak_llvm_math_cos" }
    if val == "math::tan" { give back "@freak_llvm_math_tan" }
    if val == "math::floor" { give back "@freak_llvm_math_floor" }
    if val == "math::ceil" { give back "@freak_llvm_math_ceil" }
    if val == "parse_num" { give back "@freak_llvm_parse_num" }
    if val == "parse_status" { give back "@freak_parse_status" }
    if val == "parse_clear_status" { give back "@freak_parse_clear_status" }
    if val == "format_num" { give back "@freak_llvm_format_num" }
    if val == "shape::alloc" { give back "@freak_llvm_shape_alloc" }
    if val == "shape::get" { give back "@freak_llvm_shape_get" }
    if val == "shape::set" { give back "@freak_llvm_shape_set" }
    if val == "tcp::connect" or val == "tcp_connect" { give back "@freak_llvm_tcp_connect" }
    if val == "tcp::send" or val == "tcp_send" { give back "@freak_llvm_tcp_send" }
    if val == "tcp::recv" or val == "tcp_recv" { give back "@freak_llvm_tcp_recv" }
    if val == "tcp::recv_all" or val == "tcp_recv_all" { give back "@freak_llvm_tcp_recv_all" }
    if val == "tcp::close" or val == "tcp_close" { give back "@freak_llvm_tcp_close" }
    if val == "tcp::socket_connect" { give back "@freak_llvm_tcp_socket_connect" }
    if val == "tcp::socket_listen" { give back "@freak_llvm_tcp_socket_listen" }
    if val == "tcp::socket_accept" { give back "@freak_llvm_tcp_socket_accept" }
    if val == "tcp::socket_status" { give back "@freak_llvm_tcp_socket_status" }
    if val == "tcp::socket_eof" { give back "@freak_llvm_tcp_socket_eof" }
    if val == "tcp::socket_local_port" { give back "@freak_llvm_tcp_socket_local_port" }
    if val == "tcp::socket_send" { give back "@freak_llvm_tcp_socket_send" }
    if val == "tcp::socket_send_all" { give back "@freak_llvm_tcp_socket_send_all" }
    if val == "tcp::socket_receive" { give back "@freak_llvm_tcp_socket_receive" }
    if val == "tcp::socket_set_timeout" { give back "@freak_llvm_tcp_socket_set_timeout" }
    if val == "tcp::socket_close" { give back "@freak_llvm_tcp_socket_close" }
    give back ""
}

task llvm_user_task_symbol(name: word) -> word {
    if tc_internal_runtime_task_name(name) { give back "@freak_" + llvm_c_safe_ident(name) }
    give back "@__freak_user_" + llvm_c_safe_ident(name)
}

task llvm_is_void_call(val: word) -> bool {
    if val.starts_with("http_server::") and tc_builtin_call_type(val) == "void" { give back true }
    if val == "time::sleep" { give back true }
    if val.starts_with("json_document::") and tc_builtin_call_type(val) == "void" { give back true }
    if val.starts_with("fs::") and tc_builtin_call_type(val) == "void" { give back true }
    if val.starts_with("process::command_") and tc_builtin_call_type(val) == "void" { give back true }
    if val == "say" or val == "panic" { give back true }
    if val == "fs::write" or val == "fs::append" or val == "fs::make_dir" { give back true }
    if val == "process::exit" { give back true }
    if val == "process::set_env" { give back true }
    if val == "array_push" or val == "array_set" or val == "array_release" { give back true }
    if val == "word_builder::reserve" or val == "word_builder::clear" or val == "word_builder::append" { give back true }
    if val == "word_builder::append_char" or val == "word_builder::append_int" or val == "word_builder::discard" { give back true }
    if val == "parse_clear_status" { give back true }
    if val == "shape::set" { give back true }
    if val == "tcp::close" or val == "tcp_close" { give back true }
    if val == "tcp::socket_set_timeout" or val == "tcp::socket_close" { give back true }
    if val == "ui::destroy_window" or val == "ui::begin_frame" or val == "ui::end_frame" { give back true }
    if val == "ui::set_clip" or val == "ui::reset_clip" { give back true }
    if val == "ui::clear" or val == "ui::fill_rect" or val == "ui::stroke_rect" { give back true }
    if val == "ui::fill_circle" or val == "ui::draw_line" { give back true }
    give back false
}

-- ===================== ARGS ==========================================

task llvm_param_type_at(params: word, wanted: int) -> word {
    if params == "" { give back "" }
    pilot i = 0
    pilot param_index = 0
    pilot current_type = ""
    pilot in_type = false
    repeat until i >= params.length() {
        pilot ch = params.char_at(i)
        if ch == ":" { in_type = true }
        else if ch == "," {
            if param_index == wanted { give back llvm_type_code(current_type) }
            param_index += 1
            current_type = ""
            in_type = false
        } else if in_type {
            current_type = current_type + ch
        }
        i += 1
    }
    if param_index == wanted { give back llvm_type_code(current_type) }
    give back ""
}

task llvm_callable_param_types(name: word) -> word {
    pilot entry = tc_callable_entry(name)
    if entry < 0 { entry = tc_associated_callable_entry(name) }
    if entry >= 0 { give back array_get(tc_callable_params, entry) }
    give back ""
}

task llvm_builtin_param_types(name: word) -> word {
    if name == "math::pow" { give back "base:num,exponent:num" }
    if name == "math::sqrt" or name == "math::sin" or name == "math::cos" { give back "value:num" }
    if name == "math::tan" or name == "math::floor" or name == "math::ceil" { give back "value:num" }
    if name == "format_num" { give back "value:num" }
    give back ""
}

task llvm_v3_owned_type(vtype: word) -> bool {
    give back vtype == "r" or vtype.starts_with("a:") or vtype.starts_with("s:")
}

task llvm_v3_kind(vtype: word) -> word {
    if vtype == "n" { give back "1" }
    if vtype == "w" { give back "2" }
    if vtype.starts_with("s:") { give back "3" }
    give back "0"
}

task llvm_v3_temporary(expr_id: word) -> bool {
    if not llvm_v3_owned_type(llvm_infer_expr_type(expr_id)) { give back false }
    pilot idx = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, idx)
    if kind == EXPR_IDENT { give back false }
    if kind == EXPR_INDEX { give back true }
    if kind == EXPR_FIELD { give back llvm_v3_temporary(array_get(ast_expr_lefts, idx)) }
    give back true
}

task llvm_v3_retain(reg: word, vtype: word) -> word {
    -- Closed checked-read carriers cannot be copied by source programs.
    if vtype == "r" { give back reg }
    pilot array_result = next_reg()
    pilot helper = "freak_v3_shape_retain"
    if vtype.starts_with("a:") { helper = "freak_v3_array_retain" }
    ir_call(array_result, "@" + helper, reg + "|")
    give back array_result
}

task llvm_v3_release(reg: word, vtype: word) -> void {
    if vtype == "r" { ir_call_void("@__freak_drop_result", reg + "|") give back }
    pilot helper = "freak_v3_shape_release"
    if vtype.starts_with("a:") { helper = "freak_v3_array_release" }
    ir_call_void("@" + helper, reg + "|")
}

task llvm_v3_cleanup_temp(expr_id: word, reg: word) -> void {
    if llvm_v3_temporary(expr_id) { llvm_v3_release(reg, llvm_infer_expr_type(expr_id)) }
    if llvm_word_expr_is_owned_temporary(expr_id) {
        ir_call_void("@freak_llvm_word_release_replaced", reg + "|" + "0" + "|")
    }
}

task llvm_v3_preserve_element(reg: word, vtype: word) -> word {
    if llvm_v3_owned_type(vtype) { give back llvm_v3_retain(reg, vtype) }
    if vtype == "w" {
        pilot cloned = next_reg()
        ir_call(cloned, "@freak_llvm_word_clone", reg + "|")
        give back cloned
    }
    give back reg
}

task llvm_v3_register_slot(slot: word, vtype: word) -> void {
    pilot prefix = "shape:"
    if vtype.starts_with("a:") { prefix = "array:" }
    if vtype == "r" { prefix = "result:" }
    llvm_word_local_slots = llvm_word_local_slots + prefix + slot + "|"
}

task llvm_word_expr_needs_clone(expr_id: word) -> bool {
    pilot idx = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, idx)
    if kind == EXPR_IDENT { give back llvm_infer_expr_type(expr_id).starts_with("w") }
    if kind == EXPR_INDEX { give back false }
    if kind == EXPR_FIELD {
        give back llvm_infer_expr_type(expr_id).starts_with("w") and not llvm_v3_temporary(array_get(ast_expr_lefts, idx))
    }
    if kind == EXPR_CALL and array_get(ast_expr_vals, idx) == "array_get" {
        pilot arguments: word = array_get(ast_expr_lefts, idx)
        if llvm_infer_expr_type(word_from_int(tc_arg_at(arguments, 0))).starts_with("a:") { give back false }
        give back true
    }
    give back false
}

task llvm_word_expr_is_owned_temporary(expr_id: word) -> bool {
    if not llvm_infer_expr_type(expr_id).starts_with("w") { give back false }
    give back not llvm_word_expr_needs_clone(expr_id)
}

task llvm_emit_args(args: word, clone_borrowed_words: bool, param_types: word, param_offset: int) -> word {
    pilot res = ""
    pilot i = 0
    pilot slen = args.length()
    pilot cur_id = ""
    pilot first = true
    pilot arg_index = 0
    repeat slen times {
        pilot c = args.char_at(i)
        if c == "," {
            pilot reg: word = llvm_emit_expr(cur_id)
            pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
            if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
            if clone_borrowed_words and llvm_v3_owned_type(llvm_infer_expr_type(cur_id)) and not llvm_v3_temporary(cur_id) {
                reg = llvm_v3_retain(reg, llvm_infer_expr_type(cur_id))
            }
            if clone_borrowed_words and llvm_word_expr_needs_clone(cur_id) {
                pilot clone_reg = next_reg()
                ir_call(clone_reg, "@freak_llvm_word_clone", reg + "|")
                reg = clone_reg
            }
            res = res + reg + "|"
            cur_id = ""
            first = false
            arg_index += 1
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id.length() > 0 {
        pilot reg: word = llvm_emit_expr(cur_id)
        pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
        if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
        if clone_borrowed_words and llvm_v3_owned_type(llvm_infer_expr_type(cur_id)) and not llvm_v3_temporary(cur_id) {
            reg = llvm_v3_retain(reg, llvm_infer_expr_type(cur_id))
        }
        if clone_borrowed_words and llvm_word_expr_needs_clone(cur_id) {
            pilot clone_reg = next_reg()
            ir_call(clone_reg, "@freak_llvm_word_clone", reg + "|")
            reg = clone_reg
        }
        res = res + reg + "|"
    }
    give back res
}

task llvm_emit_borrowed_args(args: word, param_types: word, param_offset: int) -> word {
    pilot res = ""
    pilot cleanup = ""
    pilot i = 0
    pilot cur_id = ""
    pilot first = true
    pilot arg_index = 0
    repeat args.length() times {
        pilot c = args.char_at(i)
        if c == "," {
            if cur_id != "" {
                pilot reg: word = llvm_emit_expr(cur_id)
                pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
                if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
                pilot arg_type = llvm_infer_expr_type(cur_id)
                if llvm_v3_owned_type(arg_type) {
                    if not llvm_v3_temporary(cur_id) { reg = llvm_v3_retain(reg, arg_type) }
                    pilot cleanup_tag = "shape:"
                    if arg_type.starts_with("a:") { cleanup_tag = "array:" }
                    cleanup = cleanup + cleanup_tag + reg + "|"
                }
                if llvm_word_expr_is_owned_temporary(cur_id) { cleanup = cleanup + reg + "|" }
                res = res + reg + "|"
                first = false
                arg_index += 1
            }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id != "" {
        pilot reg: word = llvm_emit_expr(cur_id)
        pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
        if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
        pilot arg_type = llvm_infer_expr_type(cur_id)
        if llvm_v3_owned_type(arg_type) {
            if not llvm_v3_temporary(cur_id) { reg = llvm_v3_retain(reg, arg_type) }
            pilot cleanup_tag = "shape:"
            if arg_type.starts_with("a:") { cleanup_tag = "array:" }
            cleanup = cleanup + cleanup_tag + reg + "|"
        }
        if llvm_word_expr_is_owned_temporary(cur_id) { cleanup = cleanup + reg + "|" }
        res = res + reg + "|"
    }
    llvm_last_borrowed_cleanup = cleanup
    give back res
}

task llvm_emit_borrowed_cleanup(cleanup: word, replacement: word) -> void {
    pilot i = 0
    pilot current = ""
    repeat cleanup.length() times {
        pilot ch: word = cleanup.char_at(i)
        if ch == "|" {
            if current != "" {
                if current.starts_with("array:") {
                    ir_call_void("@freak_v3_array_release", current.substring(6, current.length() - 6) + "|")
                } else if current.starts_with("shape:") {
                    ir_call_void("@freak_v3_shape_release", current.substring(6, current.length() - 6) + "|")
                } else {
                    ir_call_void("@freak_llvm_word_release_replaced", current + "|" + replacement + "|")
                }
            }
            current = ""
        } else { current = current + ch }
        i += 1
    }
}

task llvm_finish_borrowed_method(expr_id: word, receiver_id: word, receiver_reg: word, arg_cleanup: word, result_reg: word) -> word {
    pilot replacement = "0"
    if llvm_infer_expr_type(expr_id).starts_with("w") { replacement = result_reg }
    if llvm_word_expr_is_owned_temporary(receiver_id) {
        ir_call_void("@freak_llvm_word_release_replaced", receiver_reg + "|" + replacement + "|")
    }
    llvm_emit_borrowed_cleanup(arg_cleanup, replacement)
    give back result_reg
}

-- ===================== EXPRESSION EMIT ===============================

task llvm_emit_expr(id: word) -> word {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)
    pilot left: word = array_get(ast_expr_lefts, i)
    pilot right: word = array_get(ast_expr_rights, i)

    if kind == EXPR_INT { give back val }
    if kind == EXPR_BOOL {
        if val == "true" or val == "yes" or val == "hai" { give back "1" }
        give back "0"
    }
    if kind == EXPR_FLOAT {
        pilot dbl_reg = next_reg()
        pilot cast_reg = next_reg()
        ir_float(dbl_reg, "fadd", "0.0", val)
        ir_double_to_i64(cast_reg, dbl_reg)
        give back cast_reg
    }
    if kind == EXPR_STR {
        pilot str_id = register_string_literal(val)
        pilot len = llvm_string_byte_len(val) + 1
        pilot get_ptr = next_reg()
        ir_string_pointer(get_ptr, word_from_int(len), str_id)
        pilot cast_reg = next_reg()
        ir_ptrtoint(cast_reg, get_ptr)
        give back cast_reg
    }
    if kind == EXPR_INTERP { give back llvm_emit_interp(left) }
    if kind == EXPR_IDENT {
        pilot res_reg = next_reg()
        ir_load(res_reg, llvm_var_ptr(val))
        give back res_reg
    }
    if kind == EXPR_CALL { give back llvm_emit_call(id, val, left) }
    if kind == EXPR_BINOP { give back llvm_emit_binop(val, left, right, id) }
    if kind == EXPR_UNARYOP { give back llvm_emit_unaryop(val, left) }
    if kind == EXPR_METHOD { give back llvm_emit_method(id, val, left, right) }
    if kind == EXPR_FIELD { give back llvm_emit_field(val, left) }
    if kind == EXPR_INDEX {
        if llvm_infer_expr_type(left).starts_with("a:") {
            pilot obj = llvm_emit_expr(left)
            if not llvm_v3_temporary(left) { obj = llvm_v3_retain(obj, llvm_infer_expr_type(left)) }
            pilot offset = llvm_emit_expr(right)
            pilot value = next_reg()
            ir_call(value, "@freak_v3_array_get", obj + "|" + offset + "|")
            value = llvm_v3_preserve_element(value, llvm_infer_expr_type(id))
            llvm_v3_release(obj, llvm_infer_expr_type(left))
            give back value
        }
        pilot obj_reg = llvm_emit_expr(left)
        if not llvm_word_expr_is_owned_temporary(left) {
            pilot snapshot = next_reg()
            ir_call(snapshot, "@freak_llvm_word_clone", obj_reg + "|")
            obj_reg = snapshot
        }
        pilot idx_reg = llvm_emit_expr(right)
        pilot res_reg = next_reg()
        ir_call(res_reg, "@freak_llvm_word_index_checked", obj_reg + "|" + idx_reg + "|")
        ir_call_void("@freak_llvm_word_release_replaced", obj_reg + "|" + "0" + "|")
        give back res_reg
    }
    if kind == EXPR_ARRAY_LIT {
        pilot arr_reg = next_reg()
        pilot arr_type = llvm_infer_expr_type(id)
        pilot element_type = arr_type.substring(2, arr_type.length() - 2)
        ir_call(arr_reg, "@freak_v3_array_new", llvm_v3_kind(element_type) + "|")
        pilot ai = 0
        repeat tc_arg_count(left) times {
            pilot item = word_from_int(tc_arg_at(left, ai))
            pilot value = llvm_emit_expr(item)
            if element_type == "n" { value = llvm_coerce_num_bits(value, item) }
            ir_call_void("@freak_v3_array_push", arr_reg + "|" + value + "|")
            llvm_v3_cleanup_temp(item, value)
            ai += 1
        }
        give back arr_reg
    }
    give back "0"
}

task llvm_emit_interp(segments: word) -> word {
    pilot accumulator = "0"
    pilot segment_count = tc_arg_count(segments)
    pilot segment_index = 0
    repeat segment_count times {
        pilot segment_id = word_from_int(tc_arg_at(segments, segment_index))
        pilot segment_reg = llvm_emit_expr(segment_id)
        pilot segment_type = llvm_infer_expr_type(segment_id)
        pilot release_segment = "0"
        if not segment_type.starts_with("w") {
            pilot converted_reg = next_reg()
            if segment_type.starts_with("n") {
                ir_call(converted_reg, "@freak_llvm_format_num", segment_reg + "|")
            } else if segment_type.starts_with("b") {
                ir_call(converted_reg, "@freak_llvm_word_from_bool", segment_reg + "|")
            } else {
                ir_call(converted_reg, "@freak_llvm_word_from_int", segment_reg + "|")
            }
            segment_reg = converted_reg
            release_segment = "1"
        } else if llvm_word_expr_is_owned_temporary(segment_id) {
            release_segment = "1"
        }
        pilot appended_reg = next_reg()
        ir_call(appended_reg, "@freak_llvm_word_append_owned", accumulator + "|" + segment_reg + "|" + release_segment + "|")
        accumulator = appended_reg
        segment_index += 1
    }
    give back accumulator
}

-- ===================== CALL EMIT =====================================

task llvm_emit_call(expr_id: word, val: word, left: word) -> word {
    if val == "array_get" or val == "array_set" or val == "array_push" or val == "array_len" or val == "array_release" {
        pilot receiver_id = word_from_int(tc_arg_at(left, 0))
        pilot receiver_type = llvm_infer_expr_type(receiver_id)
        if receiver_type.starts_with("a:") {
            pilot receiver = llvm_emit_expr(receiver_id)
            if val == "array_release" {
                llvm_v3_release(receiver, receiver_type)
                pilot receiver_index = word_to_int(receiver_id)
                if array_get(ast_expr_kinds, receiver_index) == EXPR_IDENT {
                    pilot binding: word = array_get(ast_expr_vals, receiver_index)
                    ir_store("0", llvm_var_ptr(binding))
                }
                give back "0"
            }
            if val == "array_len" {
                pilot array_result = next_reg()
                ir_call(array_result, "@freak_v3_array_len", receiver + "|")
                llvm_v3_cleanup_temp(receiver_id, receiver)
                give back array_result
            }
            if not llvm_v3_temporary(receiver_id) { receiver = llvm_v3_retain(receiver, receiver_type) }
            pilot arg_id = word_from_int(tc_arg_at(left, 1))
            pilot arg = llvm_emit_expr(arg_id)
            if val == "array_get" {
                pilot array_result = next_reg()
                ir_call(array_result, "@freak_v3_array_get", receiver + "|" + arg + "|")
                array_result = llvm_v3_preserve_element(array_result, "w")
                llvm_v3_release(receiver, receiver_type)
                give back array_result
            }
            if val == "array_push" {
                ir_call_void("@freak_v3_array_push", receiver + "|" + arg + "|")
                llvm_v3_cleanup_temp(arg_id, arg)
            } else {
                pilot value_id = word_from_int(tc_arg_at(left, 2))
                pilot value = llvm_emit_expr(value_id)
                ir_call_void("@freak_v3_array_set", receiver + "|" + arg + "|" + value + "|")
                llvm_v3_cleanup_temp(value_id, value)
            }
            llvm_v3_release(receiver, receiver_type)
            give back "0"
        }
    }
    if val == "List::filled" {
        pilot item_id = word_from_int(tc_arg_at(left, 0))
        pilot count_id = word_from_int(tc_arg_at(left, 1))
        pilot value = llvm_emit_expr(item_id)
        pilot item_type = llvm_infer_expr_type(item_id)
        -- Freeze the value before an effectful count can replace its owner.
        pilot preserved_value = llvm_v3_preserve_element(value, item_type)
        llvm_v3_cleanup_temp(item_id, value)
        pilot count_reg = llvm_emit_expr(count_id)
        pilot array_result = next_reg()
        ir_call(array_result, "@freak_v3_array_filled", llvm_v3_kind(item_type) + "|" + count_reg + "|" + preserved_value + "|")
        if llvm_v3_owned_type(item_type) { llvm_v3_release(preserved_value, item_type) }
        if item_type == "w" { ir_call_void("@freak_llvm_word_release_replaced", preserved_value + "|" + "0" + "|") }
        give back array_result
    }
    if val == "List::new" {
        pilot new_reg = next_reg()
        ir_call(new_reg, "@freak_v3_array_new", "2" + "|")
        give back new_reg
    }
    if val == "List::with_capacity" {
        pilot cap_id = word_from_int(tc_arg_at(left, 0))
        pilot cap_reg = llvm_emit_expr(cap_id)
        pilot cap_result = next_reg()
        ir_call(cap_result, "@freak_v3_array_with_capacity", "2" + "|" + cap_reg + "|")
        give back cap_result
    }
    -- Shape constructors have their own ownership-aware argument lowering.
    if val.starts_with("shape::ctor::") { give back llvm_emit_shape_ctor(val, left) }

    pilot arg_str = ""
    pilot mapped_name = llvm_map_call_name(val)
    pilot aggregate_call = val == "array_push" or val == "array_set"
    pilot user_call = mapped_name == "" and not emt_is_extern(val)
    pilot borrowed_cleanup = ""
    if left.length() > 0 {
        if aggregate_call {
            arg_str = llvm_emit_args(left, true, "", 0)
        } else if user_call {
            arg_str = llvm_emit_args(left, true, llvm_callable_param_types(val), 0)
        } else {
            pilot borrowed_param_types = llvm_builtin_param_types(val)
            if emt_is_extern(val) { borrowed_param_types = llvm_callable_param_types(val) }
            arg_str = llvm_emit_borrowed_args(left, borrowed_param_types, 0)
            borrowed_cleanup = llvm_last_borrowed_cleanup
        }
    }

    -- Map to LLVM function name
    pilot func_name = mapped_name
    if func_name == "" {
        if emt_is_extern(val) {
            func_name = "@" + llvm_c_safe_ident(val)
        } else {
            func_name = llvm_user_task_symbol(val)
        }
    }

    -- Check if void
    pilot is_void = llvm_is_void_call(val)
    if not is_void {
        pilot call_ret: word = llvm_get_task_ret_type(val)
        if call_ret == "v" { is_void = true }
    }

    if is_void {
        ir_call_void(func_name, arg_str)
        llvm_emit_borrowed_cleanup(borrowed_cleanup, "0")
        give back "0"
    }
    pilot res_reg = next_reg()
    ir_call(res_reg, func_name, arg_str)
    pilot replacement = "0"
    if llvm_infer_expr_type(expr_id).starts_with("w") { replacement = res_reg }
    llvm_emit_borrowed_cleanup(borrowed_cleanup, replacement)
    give back res_reg
}

task llvm_emit_shape_ctor(val: word, left: word) -> word {
    pilot sname = val.substring(13, val.length() - 13)
    pilot alloc_reg = next_reg()
    ir_call(alloc_reg, "@freak_v3_shape_new", word_from_int(get_shape_field_count(sname)) + "|")
    pilot fi = 0
    repeat tc_arg_count(left) times {
        pilot item = word_from_int(tc_arg_at(left, fi))
        pilot value = llvm_emit_expr(item)
        pilot field_type = llvm_shape_field_type_at(sname, fi)
        if field_type == "n" { value = llvm_coerce_num_bits(value, item) }
        ir_call_void("@freak_v3_shape_init", alloc_reg + "|" + word_from_int(fi) + "|" + llvm_v3_kind(field_type) + "|" + value + "|")
        llvm_v3_cleanup_temp(item, value)
        fi += 1
    }
    give back alloc_reg
}

-- ===================== BINOP EMIT ====================================

task llvm_integer_message_ptr(message: word) -> word {
    pilot size = word_from_int(message.length() + 1)
    pilot name = message.replace(" ", "_")
    give back "getelementptr inbounds ([" + size + " x i8], [" + size + " x i8]* @__freak_int_" + name + ", i64 0, i64 0)"
}

task llvm_emit_integer_guard(failed: word, reason: word, operation: word) -> void {
    pilot edge = "integer.fail.edge." + word_from_int(temp_reg_counter)
    pilot success = "integer.ok." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    if llvm_integer_failure_reasons != "" {
        llvm_integer_failure_reasons = llvm_integer_failure_reasons + ", "
        llvm_integer_failure_operations = llvm_integer_failure_operations + ", "
    }
    llvm_integer_failure_reasons = llvm_integer_failure_reasons + "[ " + llvm_integer_message_ptr(reason) + ", %" + edge + " ]"
    llvm_integer_failure_operations = llvm_integer_failure_operations + "[ " + llvm_integer_message_ptr(operation) + ", %" + edge + " ]"
    llvm_integer_failure_edges = llvm_integer_failure_edges + edge + ";" + reason.replace(" ", "_") + ";" + operation.replace(" ", "_") + "|"
    ir_cond_br_cold(failed, edge, success)
    ir_label(edge)
    ir_br("integer.fail")
    ir_label(success)
}

task llvm_emit_integer_failure_block() -> void {
    ir_integer_failure_block()
}

task llvm_emit_checked_integer(l_reg: word, r_reg: word, res_reg: word, operation: word, rhs: word) -> void {
    pilot symbol = v35_integer_arithmetic_symbol(operation)
    pilot opcode = "add"
    pilot diagnostic = "addition"
    if symbol == "freak_int_sub_checked" { opcode = "sub" diagnostic = "subtraction" }
    if symbol == "freak_int_mul_checked" { opcode = "mul" diagnostic = "multiplication" }
    if operation == "neg" { opcode = "sub" diagnostic = "negation" }
    if symbol == "freak_int_div_checked" or symbol == "freak_int_rem_checked" {
        opcode = "sdiv" diagnostic = "division"
        if symbol == "freak_int_rem_checked" { opcode = "srem" diagnostic = "remainder" }
        if not v35_integer_divisor_is_safe(rhs) {
            pilot zero = next_reg()
            ir_icmp(zero, "eq", r_reg, "0")
            llvm_emit_integer_guard(zero, "division by zero", diagnostic)
            pilot minimum = next_reg()
            pilot minus_one = next_reg()
            pilot overflow = next_reg()
            ir_icmp(minimum, "eq", l_reg, "-9223372036854775808")
            ir_icmp(minus_one, "eq", r_reg, "-1")
            ir_and1(overflow, minimum, minus_one)
            llvm_emit_integer_guard(overflow, "overflow", diagnostic)
        }
        ir_int(res_reg, opcode, l_reg, r_reg)
        give back
    }
    pilot pair = next_reg()
    pilot overflow = next_reg()
    ir_overflow(pair, opcode, l_reg, r_reg)
    ir_extract(res_reg, pair, 0)
    ir_extract(overflow, pair, 1)
    llvm_emit_integer_guard(overflow, "overflow", diagnostic)
}

task llvm_emit_short_circuit(val: word, left: word, right: word) -> word {
    pilot left_reg = llvm_emit_expr(left)
    pilot left_bool = next_reg()
    ir_icmp(left_bool, "ne", left_reg, "0")

    pilot short_block = "logic.short." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rhs_block = "logic.rhs." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rhs_done = "logic.rhs.done." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot end_block = "logic.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot short_value = "0"
    if val == "and" {
        ir_cond_br(left_bool, rhs_block, short_block)
    } else {
        short_value = "1"
        ir_cond_br(left_bool, short_block, rhs_block)
    }

    ir_label(short_block)
    ir_br(end_block)

    ir_label(rhs_block)
    pilot right_reg = llvm_emit_expr(right)
    pilot right_bool = next_reg()
    ir_icmp(right_bool, "ne", right_reg, "0")
    pilot right_value = next_reg()
    ir_zext(right_value, right_bool)
    ir_br(rhs_done)

    ir_label(rhs_done)
    ir_br(end_block)

    ir_label(end_block)
    pilot result_reg = next_reg()
    ir_phi2(result_reg, short_value, short_block, right_value, rhs_done)
    give back result_reg
}

task llvm_emit_binop(val: word, left: word, right: word, id: word) -> word {
    if val == "and" or val == "or" { give back llvm_emit_short_circuit(val, left, right) }
    pilot l_reg = llvm_emit_expr(left)
    pilot word_order = (val == "<" or val == ">" or val == "<=" or val == ">=") and llvm_infer_expr_type(left).starts_with("w")
    if word_order and not llvm_word_expr_is_owned_temporary(left) {
        pilot snapshot = next_reg()
        ir_call(snapshot, "@freak_llvm_word_clone", l_reg + "|")
        l_reg = snapshot
    }
    pilot r_reg = llvm_emit_expr(right)
    if word_order and not llvm_word_expr_is_owned_temporary(right) {
        pilot snapshot = next_reg()
        ir_call(snapshot, "@freak_llvm_word_clone", r_reg + "|")
        r_reg = snapshot
    }
    pilot res_reg = next_reg()
    pilot is_num_op = llvm_is_num_expr(left) or llvm_is_num_expr(right)

    if val == "+" { give back llvm_emit_add(l_reg, r_reg, res_reg, left, right, id, is_num_op) }
    if val == "-" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "sub", "fsub") }
    if val == "*" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "mul", "fmul") }
    if val == "/" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "sdiv", "fdiv") }
    if val == "%" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "srem", "frem") }
    if val == "==" { give back llvm_emit_cmp(l_reg, r_reg, res_reg, left, right, is_num_op, "eq", "oeq") }
    if val == "!=" { give back llvm_emit_cmp(l_reg, r_reg, res_reg, left, right, is_num_op, "ne", "une") }
    if val == "<" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "slt", "olt") }
    if val == ">" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "sgt", "ogt") }
    if val == "<=" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "sle", "ole") }
    if val == ">=" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "sge", "oge") }
    if val == "NAKAMA" {
        pilot t1 = next_reg()
        llvm_emit_checked_integer(l_reg, r_reg, t1, "+", "")
        pilot t2 = next_reg()
        llvm_emit_checked_integer(l_reg, r_reg, t2, "*", "")
        pilot t3 = next_reg()
        ir_int(t3, "sdiv", t2, "10")
        llvm_emit_checked_integer(t1, t3, res_reg, "+", "")
        give back res_reg
    }
    give back res_reg
}

task llvm_emit_add(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, id: word, is_num_op: bool) -> word {
    pilot vtype = llvm_infer_expr_type(id)
    if vtype.starts_with("w") {
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        pilot lw = l_reg
        pilot rw = r_reg
        if not lt.starts_with("w") {
            lw = next_reg()
            ir_call(lw, "@freak_llvm_word_from_int", l_reg + "|")
        }
        if not rt.starts_with("w") {
            rw = next_reg()
            ir_call(rw, "@freak_llvm_word_from_int", r_reg + "|")
        }
        ir_call(res_reg, "@freak_llvm_word_concat", lw + "|" + rw + "|")
        -- Concatenation copies both operands.  Release only owned temporaries;
        -- identifiers, fields, and array_get remain borrowed from their slot.
        if llvm_word_expr_is_owned_temporary(left) or not lt.starts_with("w") {
            ir_call_void("@freak_llvm_word_release_replaced", lw + "|" + res_reg + "|")
        }
        if llvm_word_expr_is_owned_temporary(right) or not rt.starts_with("w") {
            ir_call_void("@freak_llvm_word_release_replaced", rw + "|" + res_reg + "|")
        }
        give back res_reg
    }
    if is_num_op {
        pilot ld = llvm_numeric_to_double(l_reg, left)
        pilot rd = llvm_numeric_to_double(r_reg, right)
        pilot dres = next_reg()
        ir_float(dres, "fadd", ld, rd)
        ir_double_to_i64(res_reg, dres)
        give back res_reg
    }
    llvm_emit_checked_integer(l_reg, r_reg, res_reg, "+", right)
    give back res_reg
}

task llvm_emit_arith(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, is_num_op: bool, int_op: word, float_op: word) -> word {
    if is_num_op {
        pilot ld = llvm_numeric_to_double(l_reg, left)
        pilot rd = llvm_numeric_to_double(r_reg, right)
        pilot dres = next_reg()
        ir_float(dres, float_op, ld, rd)
        ir_double_to_i64(res_reg, dres)
        give back res_reg
    }
    llvm_emit_checked_integer(l_reg, r_reg, res_reg, int_op, right)
    give back res_reg
}

task llvm_emit_cmp(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, is_num_op: bool, int_cmp: word, float_cmp: word) -> word {
    pilot ltype = llvm_infer_expr_type(left)
    if ltype.starts_with("w") {
        if int_cmp == "eq" {
            ir_call(res_reg, "@freak_llvm_word_eq", l_reg + "|" + r_reg + "|")
        } else {
            ir_call(res_reg, "@freak_llvm_word_neq", l_reg + "|" + r_reg + "|")
        }
        if llvm_word_expr_is_owned_temporary(left) {
            ir_call_void("@freak_llvm_word_release_replaced", l_reg + "|" + "0" + "|")
        }
        if llvm_word_expr_is_owned_temporary(right) {
            ir_call_void("@freak_llvm_word_release_replaced", r_reg + "|" + "0" + "|")
        }
        give back res_reg
    }
    give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, int_cmp, float_cmp)
}

task llvm_emit_icmp(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, is_num_op: bool, int_cmp: word, float_cmp: word) -> word {
    if llvm_infer_expr_type(left).starts_with("w") {
        pilot ordering = next_reg()
        pilot compared = next_reg()
        ir_call(ordering, "@freak_llvm_word_compare", l_reg + "|" + r_reg + "|")
        ir_icmp(compared, int_cmp, ordering, "0")
        ir_zext(res_reg, compared)
        ir_call_void("@freak_llvm_word_release_replaced", l_reg + "|" + "0" + "|")
        ir_call_void("@freak_llvm_word_release_replaced", r_reg + "|" + "0" + "|")
        give back res_reg
    }
    if is_num_op {
        pilot ld = llvm_numeric_to_double(l_reg, left)
        pilot rd = llvm_numeric_to_double(r_reg, right)
        pilot cmp_reg = next_reg()
        ir_fcmp(cmp_reg, float_cmp, ld, rd)
        ir_zext(res_reg, cmp_reg)
        give back res_reg
    }
    pilot cmp_reg = next_reg()
    ir_icmp(cmp_reg, int_cmp, l_reg, r_reg)
    ir_zext(res_reg, cmp_reg)
    give back res_reg
}

-- ===================== UNARY EMIT ====================================

task llvm_emit_unaryop(val: word, left: word) -> word {
    if val == "-" and tc_literal_is_minimum(word_to_int(left)) { give back "-9223372036854775808" }
    pilot op_reg = llvm_emit_expr(left)
    pilot operand_type = llvm_infer_expr_type(left)
    if operand_type.starts_with("n") and val == "-" {
        pilot operand_double = llvm_i64_to_double(op_reg)
        pilot result_double = next_reg()
        ir_float(result_double, "fsub", "0.0", operand_double)
        give back llvm_double_to_i64(result_double)
    }
    pilot res_reg = next_reg()
    if val == "not" {
        pilot cmp_reg = next_reg()
        ir_icmp(cmp_reg, "eq", op_reg, "0")
        ir_zext(res_reg, cmp_reg)
    }
    if val == "-" or val == "TSUNDERE" { llvm_emit_checked_integer("0", op_reg, res_reg, "neg", "") }
    if val == "PLUS ULTRA" { llvm_emit_checked_integer(op_reg, "2", res_reg, "*", "") }
    if val == "FINAL FORM" { llvm_emit_checked_integer(op_reg, op_reg, res_reg, "*", "") }
    give back res_reg
}

-- ===================== METHOD EMIT ===================================

task llvm_emit_method(expr_id: word, val: word, left: word, right: word) -> word {
    pilot obj_reg = llvm_emit_expr(left)
    pilot res_reg = next_reg()
    pilot recv_ty = llvm_infer_expr_type(left)
    pilot best_sname = llvm_shape_name_from_type(recv_ty)
    pilot best_ret = ""
    if best_sname != "" { best_ret = llvm_get_task_ret_type(best_sname + "_" + val) }
    if best_sname != "" and best_ret != "" {
        if not llvm_v3_temporary(left) { obj_reg = llvm_v3_retain(obj_reg, recv_ty) }
        pilot exact_args = ""
        pilot exact_params = llvm_callable_param_types(best_sname + "_" + val)
        if right.length() > 0 { exact_args = llvm_emit_args(right, true, exact_params, 1) }
        pilot exact_fname = llvm_user_task_symbol(best_sname + "_" + val)
        if best_ret == "v" {
            ir_call_void(exact_fname, obj_reg + "|" + exact_args)
            ir_int(res_reg, "add", "0", "0")
        } else {
            ir_call(res_reg, exact_fname, obj_reg + "|" + exact_args)
        }
        give back res_reg
    }
    if val == "length" and recv_ty.starts_with("a:") {
        ir_call(res_reg, "@freak_v3_array_len", obj_reg + "|")
        llvm_v3_cleanup_temp(left, obj_reg)
        give back res_reg
    }
    if val == "capacity" and recv_ty.starts_with("a:") {
        ir_call(res_reg, "@freak_v3_array_capacity", obj_reg + "|")
        llvm_v3_cleanup_temp(left, obj_reg)
        give back res_reg
    }
    if val == "clear" and recv_ty.starts_with("a:") {
        if not llvm_v3_temporary(left) { obj_reg = llvm_v3_retain(obj_reg, recv_ty) }
        ir_call_void("@freak_v3_array_clear", obj_reg + "|")
        llvm_v3_release(obj_reg, recv_ty)
        give back "0"
    }
    if val == "reserve" and recv_ty.starts_with("a:") {
        pilot cap_id = word_from_int(tc_arg_at(right, 0))
        pilot cap_reg = llvm_emit_expr(cap_id)
        if not llvm_v3_temporary(left) { obj_reg = llvm_v3_retain(obj_reg, recv_ty) }
        ir_call_void("@freak_v3_array_reserve", obj_reg + "|" + cap_reg + "|")
        llvm_v3_release(obj_reg, recv_ty)
        give back "0"
    }
    if val == "push" and recv_ty.starts_with("a:") {
        pilot elem_ty = recv_ty.substring(2, recv_ty.length() - 2)
        pilot push_id = word_from_int(tc_arg_at(right, 0))
        pilot push_reg = llvm_emit_expr(push_id)
        if elem_ty == "n" { push_reg = llvm_coerce_num_bits(push_reg, push_id) }
        if not llvm_v3_temporary(left) { obj_reg = llvm_v3_retain(obj_reg, recv_ty) }
        ir_call_void("@freak_v3_array_push", obj_reg + "|" + push_reg + "|")
        llvm_v3_cleanup_temp(push_id, push_reg)
        llvm_v3_release(obj_reg, recv_ty)
        give back "0"
    }
    if val == "pop" and recv_ty.starts_with("a:") {
        if not llvm_v3_temporary(left) { obj_reg = llvm_v3_retain(obj_reg, recv_ty) }
        ir_call(res_reg, "@freak_v3_array_pop", obj_reg + "|")
        llvm_v3_release(obj_reg, recv_ty)
        give back res_reg
    }
    if recv_ty.starts_with("q") {
        pilot args = ""
        pilot arg_cleanup = ""
        if right.length() > 0 {
            args = llvm_emit_borrowed_args(right, "", 0)
            arg_cleanup = llvm_last_borrowed_cleanup
        }
        pilot runtime_name = "@freak_llvm_byte_buffer_" + val
        pilot byte_buffer_ret = tc_builtin_method_return_type("ByteBuffer", val)
        if byte_buffer_ret == "void" {
            ir_call_void(runtime_name, obj_reg + "|" + args)
            ir_int(res_reg, "add", "0", "0")
        } else {
            ir_call(res_reg, runtime_name, obj_reg + "|" + args)
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, arg_cleanup, res_reg)
    }
    if val == "length" {
        ir_call(res_reg, "@freak_llvm_word_length", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "byte_length" {
        ir_call(res_reg, "@freak_llvm_word_byte_length", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "checksum" {
        ir_call(res_reg, "@freak_llvm_word_checksum", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_escape" {
        ir_call(res_reg, "@freak_llvm_word_snapshot_escape", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_unescape" {
        ir_call(res_reg, "@freak_llvm_word_snapshot_unescape", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_line_count" {
        ir_call(res_reg, "@freak_llvm_word_snapshot_line_count", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_lines" {
        ir_call(res_reg, "@freak_llvm_word_snapshot_lines", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_field_count" {
        ir_call(res_reg, "@freak_llvm_word_snapshot_field_count", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_upper" {
        ir_call(res_reg, "@freak_llvm_word_to_upper", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_lower" {
        ir_call(res_reg, "@freak_llvm_word_to_lower", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "trim" {
        ir_call(res_reg, "@freak_llvm_word_trim", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_line" or val == "snapshot_field_raw" or val == "char_at" or val == "substring" or val == "contains" or val == "starts_with" or val == "ends_with" or val == "replace" or val == "repeated" {
        pilot args = llvm_emit_borrowed_args(right, "", 0)
        pilot arg_cleanup = llvm_last_borrowed_cleanup
        pilot runtime_name = "@freak_llvm_word_" + val
        ir_call(res_reg, runtime_name, obj_reg + "|" + args)
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, arg_cleanup, res_reg)
    }
    -- to_int / to_num / to_word — receiver-type-dispatched primitive
    -- conversions.  The receiver's inferred type picks which runtime
    -- helper to call.  Without these, calls like `font_size.to_num()`
    -- in cockpit landed on the unsupported-method branch and returned
    -- 0, which collapsed every layout rect to zero size.
    if val == "to_int" {
        if recv_ty.starts_with("n") {
            ir_call(res_reg, "@freak_llvm_num_to_int", obj_reg + "|")
        } else {
            ir_call(res_reg, "@freak_llvm_word_to_int", obj_reg + "|")
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_num" {
        if recv_ty.starts_with("w") {
            ir_call(res_reg, "@freak_llvm_parse_num", obj_reg + "|")
        } else {
            -- Default: treat as int → num (covers int and unknown-typed
            -- locals that hold integer values, e.g. shape fields).
            ir_call(res_reg, "@freak_llvm_int_to_num", obj_reg + "|")
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    -- Checked word parsing. Legacy to_int/to_num above stay lenient; these
    -- strict entry points report through the sticky parse status channel.
    if val == "parse_int" {
        ir_call(res_reg, "@freak_llvm_word_parse_int", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "parse_num" {
        ir_call(res_reg, "@freak_llvm_word_parse_num", obj_reg + "|")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_word" {
        if recv_ty.starts_with("n") {
            ir_call(res_reg, "@freak_llvm_word_from_num", obj_reg + "|")
        } else if recv_ty.starts_with("b") {
            ir_call(res_reg, "@freak_llvm_word_from_bool", obj_reg + "|")
        } else {
            ir_call(res_reg, "@freak_llvm_word_from_int", obj_reg + "|")
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    -- User-defined impl methods
    -- Args are stored in `right` as a comma-separated list of expr id words.
    -- Thread them through llvm_emit_args so user methods receive every arg
    -- after `self`, not just `self` alone.
    -- Nominal receiver types select the exact impl. Keep the historical
    -- last-match fallback only for legacy untyped handles.
    if best_sname == "" {
        pilot si = 0
        repeat shape_registry_count times {
            pilot sname: word = "" + array_get(shape_registry_names, si)
            pilot call_ret: word = llvm_get_task_ret_type(sname + "_" + val)
            if call_ret.length() > 0 {
                best_sname = sname
                best_ret = call_ret
            }
            si += 1
        }
    }
    if best_sname.length() > 0 and best_ret.length() > 0 {
        pilot extra_args = ""
        pilot impl_params = llvm_callable_param_types(best_sname + "_" + val)
        if right.length() > 0 { extra_args = llvm_emit_args(right, true, impl_params, 1) }
        pilot impl_fname = llvm_user_task_symbol(best_sname + "_" + val)
        if best_ret == "v" {
            ir_call_void(impl_fname, obj_reg + "|" + extra_args)
            ir_int(res_reg, "add", "0", "0")
        } else {
            ir_call(res_reg, impl_fname, obj_reg + "|" + extra_args)
        }
        give back res_reg
    }
    ir_comment("unsupported method " + val)
    ir_int(res_reg, "add", "0", "0")
    give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
}

-- ===================== FIELD EMIT ====================================

task llvm_emit_field(val: word, left: word) -> word {
    pilot obj_reg = llvm_emit_expr(left)
    pilot fidx = llvm_infer_field_index(left, val)
    if fidx < 0 {
        pilot unresolved = next_reg()
        ir_comment("unresolved field access rejected by semantic checking")
        ir_int(unresolved, "add", "0", "0")
        give back unresolved
    }
    pilot res_reg = next_reg()
    ir_call(res_reg, "@freak_v3_shape_get", obj_reg + "|" + word_from_int(fidx) + "|")
    if llvm_v3_temporary(left) {
        res_reg = llvm_v3_preserve_element(res_reg, llvm_infer_field_type(left, val))
        llvm_v3_release(obj_reg, llvm_infer_expr_type(left))
    }
    give back res_reg
}

-- ===================== BLOCK EMIT ====================================

task llvm_emit_block(block: word) -> void {
    pilot saved_var_names = llvm_var_names
    pilot saved_var_types = llvm_var_types
    pilot saved_var_map = llvm_var_reg_map
    pilot saved_word_local_slots = llvm_word_local_slots
    pilot i = 0
    pilot slen = block.length()
    pilot cur_id = ""
    repeat slen times {
        pilot c = block.char_at(i)
        if c == "," {
            if cur_id.length() > 0 { llvm_emit_stmt(cur_id) }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id.length() > 0 { llvm_emit_stmt(cur_id) }
    llvm_emit_word_local_cleanup_since(saved_word_local_slots, "")
    llvm_var_names = saved_var_names
    llvm_var_types = saved_var_types
    llvm_var_reg_map = saved_var_map
    llvm_word_local_slots = saved_word_local_slots
}

-- ===================== STATEMENT EMIT ================================

task llvm_is_current_word_param(name: word) -> bool {
    pilot slot = llvm_get_llvm_name(name)
    if slot == "" { give back false }
    give back llvm_current_word_params.contains("|" + slot + "|")
}

task llvm_active_binding_is_word_param(name: word) -> bool {
    give back llvm_is_current_word_param(name)
}

task llvm_active_binding_is_global(name: word) -> bool {
    give back llvm_get_llvm_name(name) == "" and llvm_is_global(name)
}

task llvm_emit_current_word_param_cleanup(skip_name: word) -> void {
    pilot i = 0
    pilot current = ""
    repeat until i >= llvm_current_word_params.length() {
        pilot ch: word = llvm_current_word_params.char_at(i)
        if ch == "|" {
            if current != "" and current != skip_name {
                pilot pointer = "%" + current
                pilot previous = next_reg()
                ir_load(previous, pointer)
                ir_call_void("@freak_llvm_word_release_replaced", previous + "|" + "0" + "|")
                ir_store("0", pointer)
            }
            current = ""
        } else {
            current = current + ch
        }
        i += 1
    }
}

task llvm_register_word_local_slot(slot_name: word) -> void {
    llvm_word_local_slots = llvm_word_local_slots + slot_name + "|"
}

task llvm_register_owned_word_value(value_reg: word) -> void {
    llvm_word_local_slots = llvm_word_local_slots + "ssa:" + value_reg + "|"
}

task llvm_emit_word_local_cleanup_since(prefix: word, skip_slot: word) -> void {
    pilot i = prefix.length()
    pilot current = ""
    repeat until i >= llvm_word_local_slots.length() {
        pilot ch: word = llvm_word_local_slots.char_at(i)
        if ch == "|" {
            if current != "" and current != skip_slot {
                if current.starts_with("result:") {
                    pilot slot = current.substring(7, current.length() - 7)
                    pilot previous = next_reg()
                    ir_load(previous, "%" + slot)
                    llvm_v3_release(previous, "r")
                    ir_store("0", "%" + slot)
                } else if current.starts_with("array:") or current.starts_with("shape:") {
                    pilot slot = current.substring(6, current.length() - 6)
                    pilot previous = next_reg()
                    ir_load(previous, "%" + slot)
                    pilot vtype = "s:"
                    if current.starts_with("array:") { vtype = "a:" }
                    llvm_v3_release(previous, vtype)
                    ir_store("0", "%" + slot)
                } else if current.starts_with("ssa:") {
                    pilot owned_value = current.substring(4, current.length() - 4)
                    ir_call_void("@freak_llvm_word_release_replaced", owned_value + "|" + "0" + "|")
                } else {
                    pilot pointer = "%" + current
                    pilot previous = next_reg()
                    ir_load(previous, pointer)
                    ir_call_void("@freak_llvm_word_release_replaced", previous + "|" + "0" + "|")
                    ir_store("0", pointer)
                }
            }
            current = ""
        } else {
            current = current + ch
        }
        i += 1
    }
}

task llvm_emit_return_dead_block(prefix: word) -> void {
    pilot dead = prefix + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    ir_label(dead)
}

task llvm_emit_stmt(eid: word) -> void {
    if eid.length() == 0 { give back }
    pilot i = word_to_int(eid)
    pilot kind: word = array_get(ast_stmt_kinds, i)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    llvm_dbg_set_stmt_line(eid)

    if kind == STMT_PILOT { llvm_emit_stmt_pilot(eid) give back }
    if kind == STMT_CHECK_RESULT { llvm_emit_check_result(eid) give back }
    if kind == STMT_SAY {
        pilot reg = llvm_emit_expr(expr_id_w)
        pilot say_type = llvm_infer_expr_type(expr_id_w)
        if say_type.starts_with("w") {
            ir_call_void("@freak_llvm_say", reg + "|")
            if llvm_word_expr_is_owned_temporary(expr_id_w) {
                ir_call_void("@freak_llvm_word_release_replaced", reg + "|" + "0" + "|")
            }
        } else {
            pilot say_word = next_reg()
            if say_type.starts_with("n") {
                ir_call(say_word, "@freak_llvm_format_num", reg + "|")
            } else if say_type.starts_with("b") {
                ir_call(say_word, "@freak_llvm_word_from_bool", reg + "|")
            } else {
                ir_call(say_word, "@freak_llvm_word_from_int", reg + "|")
            }
            ir_call_void("@freak_llvm_say", say_word + "|")
            ir_call_void("@freak_llvm_word_release_replaced", say_word + "|" + "0" + "|")
        }
        give back
    }
    if kind == STMT_EXPR {
        pilot discarded_reg = llvm_emit_expr(expr_id_w)
        if llvm_v3_temporary(expr_id_w) { llvm_v3_release(discarded_reg, llvm_infer_expr_type(expr_id_w)) }
        if llvm_word_expr_is_owned_temporary(expr_id_w) {
            ir_call_void("@freak_llvm_word_release_replaced", discarded_reg + "|" + "0" + "|")
        }
        give back
    }
    if kind == STMT_GIVE_BACK {
        if llvm_cur_func_is_void {
            llvm_emit_word_local_cleanup_since("", "")
            llvm_emit_current_word_param_cleanup("")
            ir_ret_void()
            llvm_emit_return_dead_block("return.dead.")
        } else if expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            pilot reg = llvm_emit_expr(expr_id_w)
            if llvm_current_return_semantic_type.starts_with("n") {
                reg = llvm_coerce_num_bits(reg, expr_id_w)
            }
            pilot return_idx = word_to_int(expr_id_w)
            pilot return_kind: word = array_get(ast_expr_kinds, return_idx)
            pilot return_name: word = array_get(ast_expr_vals, return_idx)
            if llvm_cur_func_returns_word and llvm_word_expr_needs_clone(expr_id_w) and (return_kind == EXPR_FIELD or return_kind == EXPR_INDEX or (return_kind == EXPR_CALL and return_name == "array_get") or (return_kind == EXPR_IDENT and llvm_active_binding_is_global(return_name))) {
                pilot clone_reg = next_reg()
                ir_call(clone_reg, "@freak_llvm_word_clone", reg + "|")
                reg = clone_reg
            }
            if llvm_v3_owned_type(llvm_infer_expr_type(expr_id_w)) and not llvm_v3_temporary(expr_id_w) { reg = llvm_v3_retain(reg, llvm_infer_expr_type(expr_id_w)) }
            pilot skip_name = ""
            pilot skip_local_slot = ""
            if llvm_cur_func_returns_word and return_kind == EXPR_IDENT and llvm_active_binding_is_word_param(return_name) { skip_name = llvm_get_llvm_name(return_name) }
            if llvm_cur_func_returns_word and return_kind == EXPR_IDENT and not llvm_active_binding_is_word_param(return_name) and not llvm_active_binding_is_global(return_name) {
                skip_local_slot = llvm_get_llvm_name(return_name)
            }
            llvm_emit_word_local_cleanup_since("", skip_local_slot)
            llvm_emit_current_word_param_cleanup(skip_name)
            ir_ret(reg)
            llvm_emit_return_dead_block("return.dead.")
        } else {
            llvm_emit_word_local_cleanup_since("", "")
            llvm_emit_current_word_param_cleanup("")
            ir_ret("0")
            llvm_emit_return_dead_block("return.dead.")
        }
        give back
    }
    if kind == STMT_IF { llvm_emit_stmt_if(eid) give back }
    if kind == STMT_REPEAT { llvm_emit_stmt_repeat(eid) give back }
    if kind == STMT_FOREACH { llvm_emit_stmt_foreach(eid) give back }
    if kind == STMT_RANGE { llvm_emit_stmt_range(eid) give back }
    if kind == STMT_FOR { llvm_emit_stmt_counted_for(eid) give back }
    if kind == STMT_TRAINING_ARC { llvm_emit_stmt_training_arc(eid) give back }
    if kind == STMT_WHEN { llvm_emit_stmt_when(eid) give back }
    if kind == STMT_BLOCK { llvm_emit_block(array_get(ast_stmt_bodies, i)) give back }
    if kind == STMT_ASSIGN { llvm_emit_stmt_assign(eid) give back }
    if kind == STMT_BREAK {
        llvm_emit_word_local_cleanup_since(llvm_loop_word_cleanup_prefix, "")
        ir_br(llvm_loop_end_label)
        pilot dead = "break.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        ir_label(dead)
        give back
    }
    if kind == STMT_CONTINUE {
        llvm_emit_word_local_cleanup_since(llvm_loop_word_cleanup_prefix, "")
        ir_br(llvm_loop_cond_label)
        pilot dead = "cont.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        ir_label(dead)
        give back
    }
    if kind == STMT_SHAPE {
        ir_comment("shape " + name_w + " defined")
        give back
    }
    if kind == STMT_EVENTUALLY {
        ir_comment("eventually block")
        pilot ev_body: word = array_get(ast_stmt_bodies, i)
        if ev_body.length() > 0 { llvm_emit_block(ev_body) }
        give back
    }
}

task llvm_emit_stmt_pilot(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot type_ann: word = array_get(ast_stmt_extras, i)
    pilot vtype = ""
    if type_ann != "" { vtype = llvm_type_code(type_ann) }
    if vtype == "" { vtype = llvm_infer_expr_type(expr_id_w) }
    pilot expr_idx = word_to_int(expr_id_w)
    pilot expr_kind: word = array_get(ast_expr_kinds, expr_idx)
    pilot expr_val: word = array_get(ast_expr_vals, expr_idx)
    pilot expr_left: word = array_get(ast_expr_lefts, expr_idx)
    if type_ann != "" and type_ann.starts_with("List<") {
        pilot ann_elem = type_ann.substring(5, type_ann.length() - 6)
        pilot ann_kind = llvm_v3_kind(llvm_type_code(ann_elem))
        pilot is_empty_lit = expr_kind == EXPR_ARRAY_LIT and tc_arg_count(expr_left) == 0
        pilot is_new = expr_kind == EXPR_CALL and expr_val == "List::new"
        pilot is_with_cap = expr_kind == EXPR_CALL and expr_val == "List::with_capacity"
        if is_empty_lit or is_new {
            pilot fresh = next_reg()
            ir_call(fresh, "@freak_v3_array_new", ann_kind + "|")
            llvm_set_var_type(name_w, vtype)
            if llvm_emitting_global_init {
                ir_store(fresh, "@g_" + name_w)
            } else {
                pilot uniq = "binding.local." + eid
                temp_reg_counter += 1
                llvm_reg_var(name_w, uniq)
                ir_store(fresh, "%" + uniq)
                if llvm_v3_owned_type(vtype) { llvm_v3_register_slot(uniq, vtype) }
            }
            give back
        }
        if is_with_cap {
            pilot cap_reg = llvm_emit_expr(word_from_int(tc_arg_at(expr_left, 0)))
            pilot with_cap = next_reg()
            ir_call(with_cap, "@freak_v3_array_with_capacity", ann_kind + "|" + cap_reg + "|")
            llvm_set_var_type(name_w, vtype)
            if llvm_emitting_global_init {
                ir_store(with_cap, "@g_" + name_w)
            } else {
                pilot uniq = "binding.local." + eid
                temp_reg_counter += 1
                llvm_reg_var(name_w, uniq)
                ir_store(with_cap, "%" + uniq)
                if llvm_v3_owned_type(vtype) { llvm_v3_register_slot(uniq, vtype) }
            }
            give back
        }
    }
    pilot reg = llvm_emit_expr(expr_id_w)
    pilot stored_reg = reg
    if vtype.starts_with("n") { stored_reg = llvm_coerce_num_bits(reg, expr_id_w) }
    if vtype.starts_with("w") and llvm_word_expr_needs_clone(expr_id_w) {
        pilot clone_reg = next_reg()
        ir_call(clone_reg, "@freak_llvm_word_clone", reg + "|")
        stored_reg = clone_reg
    }
    if llvm_v3_owned_type(vtype) and not llvm_v3_temporary(expr_id_w) { stored_reg = llvm_v3_retain(reg, vtype) }
    -- Initializers see the outer binding. Delay the new type entry until the
    -- RHS and its ownership decision have been lowered.
    llvm_set_var_type(name_w, vtype)
    if llvm_emitting_global_init {
        ir_store(stored_reg, "@g_" + name_w)
    } else {
        pilot uniq = "binding.local." + eid
        temp_reg_counter += 1
        if vtype == "r" { uniq = "checked.local." + eid }
        llvm_reg_var(name_w, uniq)
        ir_store(stored_reg, "%" + uniq)
        if vtype.starts_with("w") { llvm_register_word_local_slot(uniq) }
        if llvm_v3_owned_type(vtype) { llvm_v3_register_slot(uniq, vtype) }
    }
}

-- Lexical storage is allocated once at task entry, including nested loops.
-- Dynamic execution only initializes and clears slots; stack use is bounded.
task llvm_preallocate_result_slots(block: word) -> void {
    pilot index = 0
    repeat tc_arg_count(block) times {
        pilot sid = tc_arg_at(block, index)
        pilot eid = word_from_int(sid)
        pilot kind: word = array_get(ast_stmt_kinds, sid)
        if kind == STMT_PILOT {
            pilot expression = word_to_int(array_get(ast_stmt_exprs, sid))
            if array_get(ast_expr_kinds, expression) == EXPR_CALL and array_get(ast_expr_vals, expression) == "fs::read_checked" {
                ir_alloca("%checked.local." + eid)
            } else { ir_alloca("%binding.local." + eid) }
        } else if kind == STMT_CHECK_RESULT {
            ir_alloca("%checked.owner." + eid)
            ir_alloca("%checked.payload.ok." + eid)
            ir_alloca("%checked.payload.err." + eid)
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
            llvm_preallocate_result_slots(array_get(ast_stmt_else_bodies, sid))
        } else if kind == STMT_IF {
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
            llvm_preallocate_result_slots(array_get(ast_stmt_else_bodies, sid))
        } else if kind == STMT_REPEAT {
            pilot mode: word = array_get(ast_stmt_names, sid)
            if mode != "until" and mode != "while" {
                ir_alloca("%repeat.index." + eid)
                if array_get(ast_stmt_extras, sid) != "" { ir_alloca("%repeat.value." + eid) }
            }
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
        } else if kind == STMT_RANGE {
            ir_alloca("%range.index." + eid)
            ir_alloca("%range.value." + eid)
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
        } else if kind == STMT_FOREACH {
            ir_alloca("%each.owner." + eid)
            ir_alloca("%each.index." + eid)
            ir_alloca("%each.value." + eid)
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
        } else if kind == STMT_TRAINING_ARC {
            ir_alloca("%training.count." + eid)
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
        } else if kind == STMT_FOR {
            llvm_preallocate_result_slots(array_get(ast_stmt_else_bodies, sid))
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
        } else if kind == STMT_BLOCK or kind == STMT_EVENTUALLY {
            llvm_preallocate_result_slots(array_get(ast_stmt_bodies, sid))
        } else if kind == STMT_WHEN {
            pilot cases: word = array_get(ast_stmt_bodies, sid)
            pilot arm_index = 0
            repeat tc_arg_count(cases) times {
                llvm_preallocate_result_slots(tc_case_stmt_part(tc_list_item(cases, arm_index)))
                arm_index += 1
            }
        }
        index += 1
    }
}

task llvm_emit_check_result_arm(eid: word, owner: word, success: bool) -> void {
    pilot sid = word_to_int(eid)
    pilot saved_names = llvm_var_names
    pilot saved_types = llvm_var_types
    pilot saved_map = llvm_var_reg_map
    pilot saved_slots = llvm_word_local_slots
    pilot saved_locals = tc_local_count
    pilot binder: word = array_get(ast_task_params, sid)
    pilot slot = "checked.payload.ok." + eid
    pilot body: word = array_get(ast_stmt_bodies, sid)
    pilot getter = "freak_llvm_fs_result_word"
    if not success {
        binder = array_get(ast_task_returns, sid)
        slot = "checked.payload.err." + eid
        body = array_get(ast_stmt_else_bodies, sid)
        getter = "freak_llvm_fs_result_error"
    }
    pilot payload = next_reg()
    ir_call(payload, "@" + getter, owner + "|")
    ir_store(payload, "%" + slot)
    llvm_set_var_type(binder, "w")
    llvm_reg_var(binder, slot)
    tc_set_local(binder, "word")
    llvm_register_word_local_slot(slot)
    llvm_emit_block(body)
    llvm_emit_word_local_cleanup_since(saved_slots, "")
    llvm_var_names = saved_names
    llvm_var_types = saved_types
    llvm_var_reg_map = saved_map
    llvm_word_local_slots = saved_slots
    tc_local_count = saved_locals
}

task llvm_emit_check_result(eid: word) -> void {
    pilot sid = word_to_int(eid)
    pilot target: word = array_get(ast_stmt_exprs, sid)
    pilot saved_slots = llvm_word_local_slots
    pilot owner = llvm_emit_expr(target)
    pilot owns: bool = array_get(ast_expr_kinds, word_to_int(target)) != EXPR_IDENT
    if owns {
        pilot slot = "checked.owner." + eid
        ir_store(owner, "%" + slot)
        llvm_v3_register_slot(slot, "r")
    }
    pilot state = next_reg()
    pilot condition = next_reg()
    pilot ok_label = "checked.ok." + eid
    pilot err_label = "checked.err." + eid
    pilot end_label = "checked.end." + eid
    ir_call(state, "@freak_llvm_fs_result_ok", owner + "|")
    ir_icmp(condition, "ne", state, "0")
    ir_cond_br(condition, ok_label, err_label)
    ir_label(ok_label)
    llvm_emit_check_result_arm(eid, owner, true)
    ir_br(end_label)
    ir_label(err_label)
    llvm_emit_check_result_arm(eid, owner, false)
    ir_br(end_label)
    ir_label(end_label)
    llvm_emit_word_local_cleanup_since(saved_slots, "")
    llvm_word_local_slots = saved_slots
}

task llvm_emit_stmt_if(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot cond_reg = llvm_emit_expr(expr_id_w)
    pilot l_then = "if.then." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_else = "if.else." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "if.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot cmp_reg = next_reg()
    ir_icmp(cmp_reg, "ne", cond_reg, "0")

    pilot else_body_w: word = array_get(ast_stmt_else_bodies, i)
    if else_body_w.length() > 0 {
        ir_cond_br(cmp_reg, l_then, l_else)
    } else {
        ir_cond_br(cmp_reg, l_then, l_end)
    }

    ir_label(l_then)
    llvm_emit_block(array_get(ast_stmt_bodies, i))
    ir_br(l_end)

    if else_body_w.length() > 0 {
        ir_label(l_else)
        llvm_emit_block(else_body_w)
        ir_br(l_end)
    }
    ir_label(l_end)
}

task llvm_emit_stmt_repeat(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot saved_names = llvm_var_names
    pilot saved_types = llvm_var_types
    pilot saved_map = llvm_var_reg_map

    pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot save_end = llvm_loop_end_label
    pilot save_cond = llvm_loop_cond_label
    pilot save_cleanup_prefix = llvm_loop_word_cleanup_prefix
    llvm_loop_end_label = l_end
    llvm_loop_word_cleanup_prefix = llvm_word_local_slots

    if name_w == "until" or name_w == "while" {
        llvm_loop_cond_label = l_cond
        ir_br(l_cond)
        ir_label(l_cond)
        pilot cond_reg = llvm_emit_expr(expr_id_w)
        pilot cmp_reg = next_reg()
        if name_w == "until" { ir_icmp(cmp_reg, "eq", cond_reg, "0") }
        else { ir_icmp(cmp_reg, "ne", cond_reg, "0") }
        ir_cond_br(cmp_reg, l_body, l_end)
        ir_label(l_body)
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        ir_br(l_cond)
    } else {
        pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot rep_var = "repeat.index." + eid
        temp_reg_counter += 1
        llvm_loop_cond_label = l_inc

        pilot count_reg = llvm_emit_expr(expr_id_w)
        pilot binder: word = array_get(ast_stmt_extras, i)
        pilot binding_slot = "repeat.value." + eid
        temp_reg_counter += 1
        ir_store("0", "%" + rep_var)
        ir_br(l_cond)
        ir_label(l_cond)
        pilot curr_val = next_reg()
        ir_load(curr_val, "%" + rep_var)
        pilot cmp_reg = next_reg()
        ir_icmp(cmp_reg, "slt", curr_val, count_reg)
        ir_cond_br(cmp_reg, l_body, l_end)

        ir_label(l_body)
        if binder != "" {
            ir_store(curr_val, "%" + binding_slot)
            llvm_set_var_type(binder, "i")
            llvm_reg_var(binder, binding_slot)
        }
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        ir_br(l_inc)
        ir_label(l_inc)
        pilot next_val = next_reg()
        ir_load(next_val, "%" + rep_var)
        pilot inc_val = next_reg()
        ir_int(inc_val, "add", next_val, "1")
        ir_store(inc_val, "%" + rep_var)
        ir_br(l_cond)
    }

    ir_label(l_end)
    llvm_loop_end_label = save_end
    llvm_loop_cond_label = save_cond
    llvm_loop_word_cleanup_prefix = save_cleanup_prefix
    llvm_var_names = saved_names
    llvm_var_types = saved_types
    llvm_var_reg_map = saved_map
}

task llvm_emit_loop_failure(message: word) -> void {
    pilot string_id = register_string_literal(message)
    pilot length = word_from_int(llvm_string_byte_len(message) + 1)
    pilot pointer = next_reg()
    pilot value = next_reg()
    ir_string_pointer(pointer, length, string_id)
    ir_ptrtoint(value, pointer)
    ir_call_void("@freak_llvm_panic", value + "|")
    ir_unreachable()
}

task llvm_emit_stmt_range(eid: word) -> void {
    pilot sid = word_to_int(eid)
    pilot saved_names = llvm_var_names
    pilot saved_types = llvm_var_types
    pilot saved_map = llvm_var_reg_map
    pilot saved_end = llvm_loop_end_label
    pilot saved_cond = llvm_loop_cond_label
    pilot saved_prefix = llvm_loop_word_cleanup_prefix
    pilot lower = llvm_emit_expr(array_get(ast_stmt_exprs, sid))
    pilot upper = llvm_emit_expr(array_get(ast_stmt_else_bodies, sid))
    pilot step = llvm_emit_expr(array_get(ast_stmt_extras, sid))
    pilot serial = word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot cond = "range.cond." + serial
    pilot body = "range.body." + serial
    pilot increment = "range.inc." + serial
    pilot advance = "range.advance." + serial
    pilot finish = "range.end." + serial
    pilot ready = "range.ready." + serial
    pilot failure = "range.failure." + serial
    pilot slot = "range.index." + eid
    pilot binding_slot = "range.value." + eid
    pilot valid = next_reg()
    ir_icmp(valid, "sgt", step, "0")
    ir_cond_br(valid, ready, failure)
    ir_label(failure)
    llvm_emit_loop_failure("range step must be positive")
    ir_label(ready)
    ir_store(lower, "%" + slot)
    ir_br(cond)
    ir_label(cond)
    pilot current = next_reg()
    pilot more = next_reg()
    ir_load(current, "%" + slot)
    pilot comparison = "slt"
    if array_get(ast_task_params, sid) == "..=" { comparison = "sle" }
    ir_icmp(more, comparison, current, upper)
    ir_cond_br(more, body, finish)
    ir_label(body)
    ir_store(current, "%" + binding_slot)
    pilot name: word = array_get(ast_stmt_names, sid)
    llvm_set_var_type(name, "i")
    llvm_reg_var(name, binding_slot)
    llvm_loop_end_label = finish
    llvm_loop_cond_label = increment
    llvm_loop_word_cleanup_prefix = llvm_word_local_slots
    llvm_emit_block(array_get(ast_stmt_bodies, sid))
    ir_br(increment)
    ir_label(increment)
    pilot max_start = next_reg()
    pilot exhausted = next_reg()
    ir_int(max_start, "sub", "9223372036854775807", step)
    ir_icmp(exhausted, "sgt", current, max_start)
    ir_cond_br(exhausted, finish, advance)
    ir_label(advance)
    pilot next_value = next_reg()
    ir_int(next_value, "add", current, step)
    ir_store(next_value, "%" + slot)
    ir_br(cond)
    ir_label(finish)
    llvm_var_names = saved_names
    llvm_var_types = saved_types
    llvm_var_reg_map = saved_map
    llvm_loop_end_label = saved_end
    llvm_loop_cond_label = saved_cond
    llvm_loop_word_cleanup_prefix = saved_prefix
}

task llvm_emit_stmt_counted_for(eid: word) -> void {
    pilot sid = word_to_int(eid)
    pilot saved_names = llvm_var_names
    pilot saved_types = llvm_var_types
    pilot saved_map = llvm_var_reg_map
    pilot saved_end = llvm_loop_end_label
    pilot saved_cond = llvm_loop_cond_label
    pilot saved_prefix = llvm_loop_word_cleanup_prefix
    llvm_emit_stmt(array_get(ast_stmt_else_bodies, sid))
    pilot serial = word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot cond = "for.cond." + serial
    pilot body = "for.body." + serial
    pilot increment = "for.inc." + serial
    pilot finish = "for.end." + serial
    ir_br(cond)
    ir_label(cond)
    pilot condition = llvm_emit_expr(array_get(ast_stmt_exprs, sid))
    pilot more = next_reg()
    ir_icmp(more, "ne", condition, "0")
    ir_cond_br(more, body, finish)
    ir_label(body)
    llvm_loop_end_label = finish
    llvm_loop_cond_label = increment
    llvm_loop_word_cleanup_prefix = llvm_word_local_slots
    llvm_emit_block(array_get(ast_stmt_bodies, sid))
    ir_br(increment)
    ir_label(increment)
    llvm_emit_stmt(array_get(ast_stmt_extras, sid))
    ir_br(cond)
    ir_label(finish)
    llvm_var_names = saved_names
    llvm_var_types = saved_types
    llvm_var_reg_map = saved_map
    llvm_loop_end_label = saved_end
    llvm_loop_cond_label = saved_cond
    llvm_loop_word_cleanup_prefix = saved_prefix
}

task llvm_emit_stmt_foreach(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name: word = array_get(ast_stmt_names, i)
    pilot receiver_id: word = array_get(ast_stmt_exprs, i)
    pilot saved_names = llvm_var_names
    pilot saved_types = llvm_var_types
    pilot saved_map = llvm_var_reg_map
    pilot saved_slots = llvm_word_local_slots
    pilot saved_end = llvm_loop_end_label
    pilot saved_cond = llvm_loop_cond_label
    pilot saved_prefix = llvm_loop_word_cleanup_prefix
    pilot receiver = llvm_emit_expr(receiver_id)
    pilot array_type = llvm_infer_expr_type(receiver_id)
    pilot element_type = array_type.substring(2, array_type.length() - 2)
    if not llvm_v3_temporary(receiver_id) { receiver = llvm_v3_retain(receiver, array_type) }
    pilot serial = word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot owner_slot = "each.owner." + eid
    pilot index_slot = "each.index." + eid
    pilot binding_slot = "each.value." + eid
    pilot cond = "each.cond." + serial
    pilot body = "each.body." + serial
    pilot increment = "each.inc." + serial
    pilot finish = "each.end." + serial
    ir_store(receiver, "%" + owner_slot)
    llvm_v3_register_slot(owner_slot, array_type)
    pilot iteration_prefix = llvm_word_local_slots
    ir_store("0", "%" + index_slot)
    ir_store("0", "%" + binding_slot)
    ir_br(cond)
    ir_label(cond)
    pilot offset = next_reg()
    pilot length = next_reg()
    pilot more = next_reg()
    ir_load(offset, "%" + index_slot)
    ir_call(length, "@freak_v3_array_len", receiver + "|")
    ir_icmp(more, "slt", offset, length)
    ir_cond_br(more, body, finish)
    ir_label(body)
    pilot value = next_reg()
    ir_call(value, "@freak_v3_array_get", receiver + "|" + offset + "|")
    value = llvm_v3_preserve_element(value, element_type)
    ir_store(value, "%" + binding_slot)
    llvm_set_var_type(name, element_type)
    llvm_reg_var(name, binding_slot)
    if element_type == "w" { llvm_register_word_local_slot(binding_slot) }
    if llvm_v3_owned_type(element_type) { llvm_v3_register_slot(binding_slot, element_type) }
    llvm_loop_end_label = finish
    llvm_loop_cond_label = increment
    llvm_loop_word_cleanup_prefix = iteration_prefix
    llvm_emit_block(array_get(ast_stmt_bodies, i))
    llvm_emit_word_local_cleanup_since(iteration_prefix, "")
    ir_br(increment)
    ir_label(increment)
    pilot next_offset = next_reg()
    ir_int(next_offset, "add", offset, "1")
    ir_store(next_offset, "%" + index_slot)
    ir_br(cond)
    ir_label(finish)
    llvm_word_local_slots = iteration_prefix
    llvm_emit_word_local_cleanup_since(saved_slots, "")
    llvm_word_local_slots = saved_slots
    llvm_var_names = saved_names
    llvm_var_types = saved_types
    llvm_var_reg_map = saved_map
    llvm_loop_end_label = saved_end
    llvm_loop_cond_label = saved_cond
    llvm_loop_word_cleanup_prefix = saved_prefix
}

task llvm_emit_stmt_training_arc(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_until = "loop.until." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rep_var = "training.count." + eid
    temp_reg_counter += 1

    pilot max_reg = llvm_emit_expr(array_get(ast_stmt_extras, i))
    ir_store("0", "%" + rep_var)
    ir_br(l_cond)

    ir_label(l_cond)
    pilot curr_val = next_reg()
    ir_load(curr_val, "%" + rep_var)
    pilot cmp_max = next_reg()
    ir_icmp(cmp_max, "slt", curr_val, max_reg)
    ir_cond_br(cmp_max, l_until, l_end)

    ir_label(l_until)
    pilot cond_reg = llvm_emit_expr(expr_id_w)
    pilot cmp_cond = next_reg()
    ir_icmp(cmp_cond, "eq", cond_reg, "0")
    ir_cond_br(cmp_cond, l_body, l_end)

    pilot save_end = llvm_loop_end_label
    pilot save_cond = llvm_loop_cond_label
    pilot save_cleanup_prefix = llvm_loop_word_cleanup_prefix
    llvm_loop_end_label = l_end
    llvm_loop_cond_label = l_inc
    llvm_loop_word_cleanup_prefix = llvm_word_local_slots

    ir_label(l_body)
    llvm_emit_block(array_get(ast_stmt_bodies, i))

    ir_br(l_inc)
    ir_label(l_inc)
    pilot next_val = next_reg()
    ir_load(next_val, "%" + rep_var)
    pilot inc_val = next_reg()
    ir_int(inc_val, "add", next_val, "1")
    ir_store(inc_val, "%" + rep_var)
    ir_br(l_cond)

    ir_label(l_end)
    llvm_loop_end_label = save_end
    llvm_loop_cond_label = save_cond
    llvm_loop_word_cleanup_prefix = save_cleanup_prefix
}

task llvm_emit_stmt_assign(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot rhs_w: word = array_get(ast_stmt_bodies, i)
    pilot lhs_idx = word_to_int(expr_id_w)
    pilot lhs_kind: word = array_get(ast_expr_kinds, lhs_idx)

    if lhs_kind == EXPR_INDEX {
        pilot receiver_id: word = array_get(ast_expr_lefts, lhs_idx)
        pilot index_id: word = array_get(ast_expr_rights, lhs_idx)
        pilot receiver = llvm_emit_expr(receiver_id)
        if not llvm_v3_temporary(receiver_id) { receiver = llvm_v3_retain(receiver, llvm_infer_expr_type(receiver_id)) }
        pilot offset = llvm_emit_expr(index_id)
        pilot element_type = llvm_infer_expr_type(expr_id_w)
        pilot previous = ""
        if name_w != "=" {
            previous = next_reg()
            ir_call(previous, "@freak_v3_array_get", receiver + "|" + offset + "|")
            if element_type == "w" { previous = llvm_v3_preserve_element(previous, "w") }
        }
        pilot value = llvm_emit_expr(rhs_w)
        pilot stored = value
        if name_w == "=" and element_type == "n" { stored = llvm_coerce_num_bits(value, rhs_w) }
        if name_w != "=" {
            stored = next_reg()
            if element_type == "n" {
                pilot op = "fadd"
                if name_w == "-=" { op = "fsub" }
                if name_w == "*=" { op = "fmul" }
                if name_w == "/=" { op = "fdiv" }
                if name_w == "%=" { op = "frem" }
                stored = llvm_emit_num_compound_bits(previous, value, rhs_w, op)
            } else if element_type == "w" {
                ir_call(stored, "@freak_llvm_word_concat", previous + "|" + value + "|")
            } else {
                llvm_emit_checked_integer(previous, value, stored, name_w, rhs_w)
            }
        }
        ir_call_void("@freak_v3_array_set", receiver + "|" + offset + "|" + stored + "|")
        llvm_v3_cleanup_temp(rhs_w, value)
        if name_w != "=" and element_type == "w" {
            ir_call_void("@freak_llvm_word_release_replaced", previous + "|" + "0" + "|")
            ir_call_void("@freak_llvm_word_release_replaced", stored + "|" + "0" + "|")
        }
        llvm_v3_release(receiver, llvm_infer_expr_type(receiver_id))
        give back
    }

    -- Field assignment: self.field = rhs  ->  shape_set(self, fidx, rhs)
    -- (Receiver evaluated once and reused for compound ops to avoid
    --  re-running side effects.)
    if lhs_kind == EXPR_FIELD {
        pilot field_name: word = array_get(ast_expr_vals, lhs_idx)
        pilot recv_id: word = array_get(ast_expr_lefts, lhs_idx)
        pilot recv_reg = llvm_emit_expr(recv_id)
        pilot recv_type = llvm_infer_expr_type(recv_id)
        if not llvm_v3_temporary(recv_id) { recv_reg = llvm_v3_retain(recv_reg, recv_type) }

        pilot fidx = llvm_infer_field_index(recv_id, field_name)
        if fidx < 0 { llvm_v3_release(recv_reg, recv_type) give back }

        pilot fidx_w = word_from_int(fidx)
        pilot field_type = llvm_infer_field_type(recv_id, field_name)

        -- Preserve the supported LLVM shape path's linear concat behavior for
        -- a direct self-replacement such as box.value = box.value + suffix.
        -- Both receivers must be the same simple binding so evaluation remains
        -- single-shot and side-effect free.
        if name_w == "=" and field_type.starts_with("w") {
            pilot rhs_idx = word_to_int(rhs_w)
            pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
            if rhs_kind == EXPR_BINOP and array_get(ast_expr_vals, rhs_idx) == "+" {
                pilot append_left: word = array_get(ast_expr_lefts, rhs_idx)
                pilot append_right: word = array_get(ast_expr_rights, rhs_idx)
                pilot append_left_idx = word_to_int(append_left)
                pilot append_left_kind: word = array_get(ast_expr_kinds, append_left_idx)
                if append_left_kind == EXPR_FIELD and array_get(ast_expr_vals, append_left_idx) == field_name {
                    pilot append_recv: word = array_get(ast_expr_lefts, append_left_idx)
                    pilot recv_idx = word_to_int(recv_id)
                    pilot append_recv_idx = word_to_int(append_recv)
                    pilot recv_kind: word = array_get(ast_expr_kinds, recv_idx)
                    pilot append_recv_kind: word = array_get(ast_expr_kinds, append_recv_idx)
                    if recv_kind == EXPR_IDENT and append_recv_kind == EXPR_IDENT {
                        pilot recv_name: word = array_get(ast_expr_vals, recv_idx)
                        pilot append_recv_name: word = array_get(ast_expr_vals, append_recv_idx)
                        if recv_name == append_recv_name {
                            pilot previous_field = next_reg()
                            pilot suffix_kind: word = array_get(ast_expr_kinds, word_to_int(append_right))
                            pilot effect_free_suffix = suffix_kind == EXPR_IDENT or suffix_kind == EXPR_STR
                            if effect_free_suffix {
                                ir_call(previous_field, "@freak_v3_shape_take", recv_reg + "|" + fidx_w + "|")
                            } else {
                                ir_call(previous_field, "@freak_v3_shape_get", recv_reg + "|" + fidx_w + "|")
                                previous_field = llvm_v3_preserve_element(previous_field, "w")
                            }
                            pilot suffix_reg = llvm_emit_expr(append_right)
                            pilot release_suffix = "0"
                            if llvm_word_expr_is_owned_temporary(append_right) { release_suffix = "1" }
                            pilot appended_field = next_reg()
                            ir_call(appended_field, "@freak_llvm_word_append_owned", previous_field + "|" + suffix_reg + "|" + release_suffix + "|")
                            ir_call_void("@freak_v3_shape_set_owned", recv_reg + "|" + fidx_w + "|" + appended_field + "|")
                            llvm_v3_release(recv_reg, recv_type)
                            give back
                        }
                    }
                }
            }
        }

        pilot cur_reg = "0"
        if name_w != "=" {
            cur_reg = next_reg()
            ir_call(cur_reg, "@freak_v3_shape_get", recv_reg + "|" + fidx_w + "|")
            if field_type == "w" { cur_reg = llvm_v3_preserve_element(cur_reg, "w") }
        }
        pilot rhs_reg = llvm_emit_expr(rhs_w)

        if name_w == "=" {
            pilot stored_field = rhs_reg
            if field_type.starts_with("n") { stored_field = llvm_coerce_num_bits(rhs_reg, rhs_w) }
            ir_call_void("@freak_v3_shape_set", recv_reg + "|" + fidx_w + "|" + stored_field + "|")
            llvm_v3_cleanup_temp(rhs_w, rhs_reg)
            llvm_v3_release(recv_reg, recv_type)
            give back
        }

        -- Compound op on field: read, combine, write
        pilot op_reg = next_reg()
        if field_type.starts_with("n") {
            pilot float_op = "fadd"
            if name_w == "-=" { float_op = "fsub" }
            if name_w == "*=" { float_op = "fmul" }
            if name_w == "/=" { float_op = "fdiv" }
            if name_w == "%=" { float_op = "frem" }
            op_reg = llvm_emit_num_compound_bits(cur_reg, rhs_reg, rhs_w, float_op)
        } else if field_type == "w" {
            ir_call(op_reg, "@freak_llvm_word_concat", cur_reg + "|" + rhs_reg + "|")
        } else {
            llvm_emit_checked_integer(cur_reg, rhs_reg, op_reg, name_w, rhs_w)
        }
        ir_call_void("@freak_v3_shape_set", recv_reg + "|" + fidx_w + "|" + op_reg + "|")
        if field_type == "w" {
            ir_call_void("@freak_llvm_word_release_replaced", cur_reg + "|" + "0" + "|")
            ir_call_void("@freak_llvm_word_release_replaced", op_reg + "|" + "0" + "|")
        }
        llvm_v3_cleanup_temp(rhs_w, rhs_reg)
        llvm_v3_release(recv_reg, recv_type)
        give back
    }

    -- Plain variable / global assignment
    pilot var_name_expr: word = array_get(ast_expr_vals, lhs_idx)
    pilot var_ptr = llvm_var_ptr(var_name_expr)
    pilot target_type = llvm_get_var_type(var_name_expr)
    if name_w == "=" and target_type.starts_with("w") {
        pilot rhs_idx = word_to_int(rhs_w)
        pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
        if rhs_kind == EXPR_BINOP and array_get(ast_expr_vals, rhs_idx) == "+" {
            pilot append_left: word = array_get(ast_expr_lefts, rhs_idx)
            pilot append_right: word = array_get(ast_expr_rights, rhs_idx)
            pilot append_left_idx = word_to_int(append_left)
            pilot append_left_kind: word = array_get(ast_expr_kinds, append_left_idx)
            pilot append_left_name: word = array_get(ast_expr_vals, append_left_idx)
            pilot append_right_idx = word_to_int(append_right)
            pilot append_right_kind: word = array_get(ast_expr_kinds, append_right_idx)
            pilot safe_global_suffix = append_right_kind == EXPR_STR or append_right_kind == EXPR_IDENT
            pilot can_append = append_left_kind == EXPR_IDENT and append_left_name == var_name_expr
            if llvm_is_global(var_name_expr) and not safe_global_suffix { can_append = false }
            if can_append {
                pilot previous_reg = next_reg()
                ir_load(previous_reg, var_ptr)
                pilot suffix_reg = llvm_emit_expr(append_right)
                pilot release_suffix = "0"
                if llvm_word_expr_is_owned_temporary(append_right) { release_suffix = "1" }
                pilot appended_reg = next_reg()
                ir_call(appended_reg, "@freak_llvm_word_append_owned", previous_reg + "|" + suffix_reg + "|" + release_suffix + "|")
                ir_store(appended_reg, var_ptr)
                give back
            }
        }
    }
    if target_type.starts_with("w") and name_w == "+=" and llvm_is_global(var_name_expr) {
        -- Word `+=` on a global. Snapshot before emitting the RHS: a RHS
        -- that mutates the global must still append to the entry value.
        pilot word_snapshot = next_reg()
        pilot word_loaded = next_reg()
        ir_load(word_loaded, var_ptr)
        ir_call(word_snapshot, "@freak_llvm_word_clone", word_loaded + "|")
        pilot word_suffix = llvm_emit_expr(rhs_w)
        pilot word_concat = next_reg()
        ir_call(word_concat, "@freak_llvm_word_concat", word_snapshot + "|" + word_suffix + "|")
        llvm_v3_cleanup_temp(rhs_w, word_suffix)
        pilot word_prev = next_reg()
        ir_load(word_prev, var_ptr)
        ir_call_void("@freak_llvm_word_release_replaced", word_prev + "|" + word_concat + "|")
        ir_store(word_concat, var_ptr)
        ir_call_void("@freak_llvm_word_release_replaced", word_snapshot + "|" + "0" + "|")
        give back
    }
    pilot integer_previous = ""
    if name_w != "=" and target_type == "i" {
        integer_previous = next_reg()
        ir_load(integer_previous, var_ptr)
    }
    pilot reg = llvm_emit_expr(rhs_w)
    pilot stored_reg = reg
    if target_type.starts_with("w") and name_w == "+=" {
        -- Word `+=` on a plain local. `reg` already holds the single RHS
        -- evaluation; locals cannot be mutated by the RHS, so load-then-
        -- append is sound. (Globals take the snapshot path above.)
        pilot word_prev = next_reg()
        ir_load(word_prev, var_ptr)
        pilot word_release_suffix = "0"
        if llvm_word_expr_is_owned_temporary(rhs_w) { word_release_suffix = "1" }
        pilot word_appended = next_reg()
        ir_call(word_appended, "@freak_llvm_word_append_owned", word_prev + "|" + reg + "|" + word_release_suffix + "|")
        ir_store(word_appended, var_ptr)
        give back
    }
    if name_w == "=" {
        if llvm_v3_owned_type(target_type) {
            if not llvm_v3_temporary(rhs_w) { stored_reg = llvm_v3_retain(reg, target_type) }
            pilot previous = next_reg()
            ir_load(previous, var_ptr)
            llvm_v3_release(previous, target_type)
        }
        if target_type.starts_with("n") { stored_reg = llvm_coerce_num_bits(reg, rhs_w) }
        if target_type.starts_with("w") {
            pilot rhs_idx = word_to_int(rhs_w)
            pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
            if llvm_word_expr_needs_clone(rhs_w) {
                pilot clone_reg = next_reg()
                ir_call(clone_reg, "@freak_llvm_word_clone", reg + "|")
                stored_reg = clone_reg
            }
            pilot previous_reg = next_reg()
            ir_load(previous_reg, var_ptr)
            ir_call_void("@freak_llvm_word_release_replaced", previous_reg + "|" + stored_reg + "|")
        }
        ir_store(stored_reg, var_ptr)
        give back
    }
    pilot load_reg = next_reg()
    if integer_previous != "" { load_reg = integer_previous }
    else { ir_load(load_reg, var_ptr) }
    pilot op_reg = next_reg()
    if target_type.starts_with("n") {
        pilot float_op = "fadd"
        if name_w == "-=" { float_op = "fsub" }
        if name_w == "*=" { float_op = "fmul" }
        if name_w == "/=" { float_op = "fdiv" }
        if name_w == "%=" { float_op = "frem" }
        op_reg = llvm_emit_num_compound_bits(load_reg, reg, rhs_w, float_op)
    } else {
        llvm_emit_checked_integer(load_reg, reg, op_reg, name_w, rhs_w)
    }
    ir_store(op_reg, var_ptr)
}

task llvm_emit_stmt_when(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot target_reg = llvm_emit_expr(expr_id_w)
    pilot target_type = llvm_infer_expr_type(expr_id_w)
    pilot cases_str: word = array_get(ast_stmt_bodies, i)
    pilot saved_when_word_slots = llvm_word_local_slots
    if target_type.starts_with("w") and llvm_word_expr_is_owned_temporary(expr_id_w) {
        -- The SSA target dominates every case/exit path. Tracking the value
        -- directly avoids a loop-local alloca that grows the stack per
        -- iteration while preserving the existing exact-once cleanup paths.
        llvm_register_owned_word_value(target_reg)
    }

    pilot l_end = "when.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot current_block = "when.case." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    ir_br(current_block)

    pilot cases_len = cases_str.length()
    pilot ci = 0
    pilot cur_case = ""
    pilot case_fin = false

    repeat until case_fin {
        pilot cc = cases_str.char_at(ci)
        if cc == "," or ci >= cases_len {
            if cur_case.length() > 0 {
                ir_label(current_block)
                pilot c_expr = ""
                pilot c_stmt = ""
                pilot in_expr = true
                pilot c_len = cur_case.length()
                pilot cj = 0
                repeat c_len times {
                    pilot p = cur_case.char_at(cj)
                    if p == ":" { in_expr = false }
                    else {
                        if in_expr { c_expr = c_expr + p }
                        else { c_stmt = c_stmt + p }
                    }
                    cj += 1
                }
                pilot next_block = "when.case." + word_from_int(temp_reg_counter)
                temp_reg_counter += 1
                pilot do_block = "when.do." + word_from_int(temp_reg_counter)
                temp_reg_counter += 1

                if c_expr == "-1" {
                    ir_br(do_block)
                } else {
                    pilot cmp_val = llvm_emit_expr(c_expr)
                    pilot cmp_res = next_reg()
                    if target_type.starts_with("w") {
                        pilot word_cmp = next_reg()
                        ir_call(word_cmp, "@freak_llvm_word_eq", target_reg + "|" + cmp_val + "|")
                        if llvm_word_expr_is_owned_temporary(c_expr) {
                            ir_call_void("@freak_llvm_word_release_replaced", cmp_val + "|" + "0" + "|")
                        }
                        ir_icmp(cmp_res, "ne", word_cmp, "0")
                    } else if target_type.starts_with("n") or llvm_infer_expr_type(c_expr).starts_with("n") {
                        pilot target_double = llvm_numeric_to_double(target_reg, expr_id_w)
                        pilot case_double = llvm_numeric_to_double(cmp_val, c_expr)
                        ir_fcmp(cmp_res, "oeq", target_double, case_double)
                    } else {
                        ir_icmp(cmp_res, "eq", target_reg, cmp_val)
                    }
                    ir_cond_br(cmp_res, do_block, next_block)
                }
                ir_label(do_block)
                pilot saved_case_names = llvm_var_names
                pilot saved_case_types = llvm_var_types
                pilot saved_case_map = llvm_var_reg_map
                pilot saved_case_word_slots = llvm_word_local_slots
                llvm_emit_stmt(c_stmt)
                llvm_emit_word_local_cleanup_since(saved_case_word_slots, "")
                llvm_var_names = saved_case_names
                llvm_var_types = saved_case_types
                llvm_var_reg_map = saved_case_map
                llvm_word_local_slots = saved_case_word_slots
                ir_br(l_end)
                current_block = next_block
            }
            cur_case = ""
            if ci >= cases_len { case_fin = true }
        } else { cur_case = cur_case + cc }
        ci += 1
    }
    ir_label(current_block)
    ir_br(l_end)
    ir_label(l_end)
    llvm_emit_word_local_cleanup_since(saved_when_word_slots, "")
    llvm_word_local_slots = saved_when_word_slots
}

-- ===================== TASK + PARAMS =================================

task llvm_translate_params(p: word) -> word {
    pilot parameters_text = ""
    pilot index = 0
    repeat tc_arg_count(p) times {
        if index > 0 { parameters_text = parameters_text + ", " }
        parameters_text = parameters_text + "i64 %parameter.input." + word_from_int(index)
        index += 1
    }
    give back parameters_text
}

task llvm_allocate_params(p: word) -> void {
    pilot index = 0
    repeat tc_arg_count(p) times {
        pilot name = tc_param_name_at(p, index)
        pilot parameter_type = llvm_type_code(tc_param_type_at(p, index))
        pilot slot = "parameter.local." + word_from_int(index)
        pilot input = "%parameter.input." + word_from_int(index)
        ir_alloca("%" + slot)
        ir_store(input, "%" + slot)
        llvm_set_var_type(name, parameter_type)
        llvm_reg_var(name, slot)
        if parameter_type == "w" { llvm_current_word_params = llvm_current_word_params + "|" + slot + "|" }
        if llvm_v3_owned_type(parameter_type) { llvm_v3_register_slot(slot, parameter_type) }
        index += 1
    }
}

task llvm_emit_task(eid: word) -> void {
    llvm_var_names = ""
    llvm_var_types = ""
    llvm_var_reg_map = ""
    llvm_word_local_slots = ""
    llvm_loop_word_cleanup_prefix = ""
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot body_id_w: word = array_get(ast_stmt_bodies, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    llvm_current_word_params = ""
    pilot line_no = word_to_int(array_get(ast_stmt_lines, i))

    pilot ret_type = "i64"
    pilot is_void = false
    if returns_w == "void" or returns_w == "" { ret_type = "void" is_void = true }
    llvm_cur_func_is_void = is_void
    llvm_cur_func_returns_word = returns_w == "word"
    llvm_current_return_semantic_type = llvm_type_code(returns_w)

    pilot parameter_count = 0
    if params_w.length() > 0 { parameter_count = tc_arg_count(params_w) }
    ir_begin_function(ret_type, llvm_user_task_symbol(name_w), parameter_count, name_w, line_no)
    ir_label("entry")
    if params_w.length() > 0 { llvm_allocate_params(params_w) }
    llvm_preallocate_result_slots(body_id_w)
    llvm_emit_block(body_id_w)
    llvm_emit_word_local_cleanup_since("", "")
    llvm_emit_current_word_param_cleanup("")
    if is_void { ir_ret_void() }
    else { ir_ret("0") }
    llvm_emit_integer_failure_block()
    ir_end_function()
    llvm_emit_line("")
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0
}

-- ===================== RUNTIME DECLARATIONS ==========================

task llvm_emit_runtime_decls() -> void {
    ir_declare_integer_support()
    ir_declare("i64", "@freak_llvm_fs_read_native", 1)
    ir_declare("void", "@freak_llvm_fs_write_native", 2)
    ir_declare("void", "@freak_llvm_fs_append_native", 2)
    ir_declare("i64", "@freak_llvm_fs_exists_native", 1)
    ir_declare("i64", "@freak_llvm_fs_delete_native", 1)
    ir_declare("i64", "@freak_int_add_checked", 2)
    ir_declare("i64", "@freak_int_sub_checked", 2)
    ir_declare("i64", "@freak_int_mul_checked", 2)
    ir_declare("i64", "@freak_int_div_checked", 2)
    ir_declare("i64", "@freak_int_rem_checked", 2)
    ir_declare("i64", "@freak_int_neg_checked", 1)
    ir_declare("i64", "@freak_llvm_word_index_checked", 2)
    ir_declare("i64", "@freak_llvm_process_stdout_is_terminal", 0)
    ir_declare("i64", "@freak_llvm_process_platform_name", 0)
    ir_declare("i64", "@freak_llvm_process_platform_is_windows", 0)
    ir_declare("i64", "@freak_llvm_process_executable_path", 0)
    ir_declare("i64", "@freak_llvm_http_server_open", 1)
    ir_declare("i64", "@freak_llvm_http_server_bind", 3)
    ir_declare("i64", "@freak_llvm_http_server_status", 1)
    ir_declare("i64", "@freak_llvm_http_server_error", 1)
    ir_declare("i64", "@freak_llvm_http_server_local_port", 1)
    ir_declare("void", "@freak_llvm_http_server_set_limits", 5)
    ir_declare("void", "@freak_llvm_http_server_set_timeouts", 4)
    ir_declare("void", "@freak_llvm_http_server_set_chunk_limits", 3)
    ir_declare("void", "@freak_llvm_http_server_stop", 1)
    ir_declare("void", "@freak_llvm_http_server_close", 1)
    ir_declare("i64", "@freak_llvm_http_server_next_request", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_status", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_error", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_method", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_target", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_path", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_query", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_header_count", 1)
    ir_declare("i64", "@freak_llvm_http_server_request_header_name", 2)
    ir_declare("i64", "@freak_llvm_http_server_request_header_value", 2)
    ir_declare("i64", "@freak_llvm_http_server_request_header_value_bytes", 2)
    ir_declare("i64", "@freak_llvm_http_server_request_header_is_trailer", 2)
    ir_declare("i64", "@freak_llvm_http_server_request_header_find", 3)
    ir_declare("i64", "@freak_llvm_http_server_request_body", 1)
    ir_declare("i64", "@freak_llvm_http_server_response_status", 2)
    ir_declare("i64", "@freak_llvm_http_server_response_header", 3)
    ir_declare("i64", "@freak_llvm_http_server_send_bytes", 2)
    ir_declare("i64", "@freak_llvm_http_server_send_text", 2)
    ir_declare("void", "@freak_llvm_http_server_request_release", 1)
    ir_declare("i64", "@freak_llvm_http_server_live_servers", 0)
    ir_declare("i64", "@freak_llvm_http_server_live_requests", 0)
    ir_declare("i64", "@freak_llvm_http_server_live_sockets", 0)
    ir_declare("i64", "@freak_llvm_http_server_retained_bytes", 0)
    ir_declare("i64", "@freak_llvm_fs_set_mode_relative_checked", 3)
    ir_declare("i64", "@freak_llvm_fs_rename_relative_new_checked", 4)
    ir_declare("i64", "@freak_llvm_fs_directory_identity_ticket", 1)
    ir_declare("i64", "@freak_llvm_fs_open_dir_ticket", 1)
    ir_declare("i64", "@freak_llvm_fs_read_bytes_limit_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_read_relative_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_read_source_relative_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_read_relative_bytes_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_read_relative_bytes_limit_ticket", 3)
    ir_declare("i64", "@freak_llvm_fs_write_relative_bytes_checked", 3)
    ir_declare("i64", "@freak_llvm_fs_remove_temp_dir_checked", 1)
    ir_declare("i64", "@freak_llvm_fs_publish_temp_dir_checked", 3)
    ir_declare("i64", "@freak_llvm_fs_result_completed", 1)
    ir_declare("i64", "@freak_llvm_fs_lock_dir_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_lock_dir_new_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_abort_new_lock_checked", 1)
    ir_declare("i64", "@freak_llvm_fs_temp_dir_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_remove_relative_file_checked", 2)
    ir_declare("i64", "@freak_llvm_fs_mkdir_relative_checked", 2)
    ir_declare("i64", "@freak_llvm_fs_open_relative_dir_ticket", 2)
    ir_declare("i64", "@freak_llvm_fs_list_dir_ticket", 1)
    ir_declare("i64", "@freak_llvm_fs_result_missing", 1)
    ir_declare("i64", "@freak_llvm_fs_directory_path_ticket", 1)
    ir_declare("i64", "@freak_llvm_json_document_new", 0)
    ir_declare("i64", "@freak_llvm_json_document_parse", 1)
    ir_declare("i64", "@freak_llvm_json_document_parse_bytes", 1)
    ir_declare("i64", "@freak_llvm_json_document_ok", 1)
    ir_declare("i64", "@freak_llvm_json_document_error", 1)
    ir_declare("i64", "@freak_llvm_json_document_error_position", 1)
    ir_declare("i64", "@freak_llvm_json_document_root", 1)
    ir_declare("i64", "@freak_llvm_json_document_set_root", 2)
    ir_declare("void", "@freak_llvm_json_document_release", 1)
    ir_declare("i64", "@freak_llvm_json_document_kind", 2)
    ir_declare("i64", "@freak_llvm_json_document_count", 2)
    ir_declare("i64", "@freak_llvm_json_document_array_get", 3)
    ir_declare("i64", "@freak_llvm_json_document_object_get", 3)
    ir_declare("i64", "@freak_llvm_json_document_object_get_bytes", 3)
    ir_declare("i64", "@freak_llvm_json_document_object_key_bytes", 3)
    ir_declare("i64", "@freak_llvm_json_document_bool_value", 2)
    ir_declare("i64", "@freak_llvm_json_document_number_text", 2)
    ir_declare("i64", "@freak_llvm_json_document_string_word", 2)
    ir_declare("i64", "@freak_llvm_json_document_string_bytes", 2)
    ir_declare("i64", "@freak_llvm_json_document_make_null", 1)
    ir_declare("i64", "@freak_llvm_json_document_make_bool", 2)
    ir_declare("i64", "@freak_llvm_json_document_make_number", 2)
    ir_declare("i64", "@freak_llvm_json_document_make_string", 2)
    ir_declare("i64", "@freak_llvm_json_document_make_string_bytes", 2)
    ir_declare("i64", "@freak_llvm_json_document_make_array", 1)
    ir_declare("i64", "@freak_llvm_json_document_make_object", 1)
    ir_declare("i64", "@freak_llvm_json_document_array_append", 3)
    ir_declare("i64", "@freak_llvm_json_document_object_insert", 4)
    ir_declare("i64", "@freak_llvm_json_document_object_insert_bytes", 4)
    ir_declare("i64", "@freak_llvm_json_document_serialize_word", 1)
    ir_declare("i64", "@freak_llvm_json_document_serialize_bytes", 1)
    ir_declare("void", "@freak_llvm_time_sleep", 1)
