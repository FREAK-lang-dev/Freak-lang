-- ===================== PROGRAM ASSEMBLY ==============================
-- v3 KEY CHANGE: proper reserved global-init + top-level wrapper split

task emit_llvm_program() -> void {
    temp_reg_counter = 0
    string_literals = ""
    string_literals_count = 0
    llvm_dbg_init()

    -- Write empty file (streaming appends from here)
    fs::write(out_file, "")

    llvm_emit_line("; FREAK LLVM IR Generator (v3)")
    llvm_emit_line("")
    llvm_emit_runtime_decls()
    llvm_emit_line("")

    pilot top_count = array_len(ast_top_stmts)

    -- Pre-scan: register task return types + externs
    pilot prescan_i = 0
    repeat top_count times {
        pilot pid: word = array_get(ast_top_stmts, prescan_i)
        pilot pk: word = array_get(ast_stmt_kinds, word_to_int(pid))
        if pk == STMT_TASK {
            pilot pn: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot pr: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(pn, pr)
        }
        if pk == STMT_EXTERN {
            pilot en: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot er: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(en, er)
            emt_register_extern(en, er)
        }
        prescan_i += 1
    }

    -- Emit global variable declarations
    llvm_global_names = ""
    llvm_global_type_names = ""
    llvm_global_types = ""
    llvm_var_names = ""
    llvm_var_types = ""
    pilot glob_i = 0
    repeat top_count times {
        pilot gid: word = array_get(ast_top_stmts, glob_i)
        pilot gk: word = array_get(ast_stmt_kinds, word_to_int(gid))
        if gk == STMT_PILOT {
            pilot gn: word = array_get(ast_stmt_names, word_to_int(gid))
            llvm_global_names = llvm_global_names + "|" + gn + "|"
            pilot gextra: word = array_get(ast_stmt_extras, word_to_int(gid))
            pilot gtype = ""
            if gextra != "" { gtype = llvm_type_code(gextra) }
            if gtype == "" or gtype == "v" {
                pilot gexpr: word = array_get(ast_stmt_exprs, word_to_int(gid))
                gtype = llvm_infer_expr_type(gexpr)
            }
            llvm_global_type_names = llvm_global_type_names + gn + "|"
            llvm_global_types = llvm_global_types + gtype + "|"
            llvm_emit_line("@g_" + gn + " = global i64 0")
        }
        glob_i += 1
    }
    llvm_emit_line("")

    -- Emit extern declarations
    pilot ext_i = 0
    repeat top_count times {
        pilot eid: word = array_get(ast_top_stmts, ext_i)
        pilot ek: word = array_get(ast_stmt_kinds, word_to_int(eid))
        if ek == STMT_EXTERN {
            pilot enm: word = array_get(ast_stmt_names, word_to_int(eid))
            pilot ert: word = array_get(ast_task_returns, word_to_int(eid))
            pilot epm: word = array_get(ast_task_params, word_to_int(eid))
            pilot llvm_ret = "i64"
            if ert == "void" { llvm_ret = "void" }
            pilot llvm_params = ""
            if epm != "" {
                pilot plen = epm.length()
                pilot pi = 0
                pilot pcount = 1
                repeat plen times {
                    if epm.char_at(pi) == "," { pcount += 1 }
                    pi += 1
                }
                pilot pj = 0
                repeat pcount times {
                    if pj > 0 { llvm_params = llvm_params + ", " }
                    llvm_params = llvm_params + "i64"
                    pj += 1
                }
            }
            if not llvm_is_runtime_func(enm) {
                llvm_emit_line("declare " + llvm_ret + " @" + enm + "(" + llvm_params + ")")
            }
        }
        ext_i += 1
    }
    llvm_emit_line("")

    -- Emit user tasks
    pilot i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { llvm_emit_task(cur_id) }
        i += 1
    }

    -- Detect user-defined main
    pilot has_main_task = false
    pilot main_task_return_type = "void"
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" {
                has_main_task = true
                main_task_return_type = array_get(ast_task_returns, word_to_int(cur_id))
            }
        }
        i += 1
    }

    -- Emit the global initializer for programs with task main(). Compiler
    -- wrappers use the checker-reserved __freak_ namespace so source externs
    -- such as freak_init_globals cannot collide with generated definitions.
    if has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_cur_func_is_void = true
        pilot init_dbg = llvm_dbg_begin_func("__freak_generated_init_globals", 1)
        llvm_emit_line("define void @__freak_generated_init_globals()" + init_dbg + " {")
        llvm_emit_line("entry:")
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind == STMT_PILOT {
                llvm_emitting_global_init = true
                llvm_emit_stmt(cur_id)
                llvm_emitting_global_init = false
            }
            i += 1
        }
        llvm_emit_line("    ret void")
        llvm_emit_line("}")
        llvm_emit_line("")
        llvm_dbg_current_scope_id = 0
        llvm_dbg_current_line = 0
    }

    -- Emit the reserved top-level wrapper (only if no user main).
    if not has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_cur_func_is_void = true
        pilot main_dbg = llvm_dbg_begin_func("__freak_generated_top_level", 1)
        llvm_emit_line("define void @__freak_generated_top_level()" + main_dbg + " {")
        llvm_emit_line("entry:")
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind != STMT_TASK and kind != STMT_EXTERN {
                if kind == STMT_PILOT { llvm_emitting_global_init = true }
                llvm_emit_stmt(cur_id)
                llvm_emitting_global_init = false
            }
            i += 1
        }
        llvm_emit_line("    ret void")
        llvm_emit_line("}")
        llvm_dbg_current_scope_id = 0
        llvm_dbg_current_line = 0
    }

    -- Emit C main entry
    llvm_emit_line("")
    pilot cmain_dbg = llvm_dbg_begin_func("main", 1)
    llvm_emit_line("define i32 @main(i32 %argc, i8** %argv)" + cmain_dbg + " {")
    llvm_emit_line("entry:")
    llvm_emit_line("    %argc_ext = sext i32 %argc to i64")
    llvm_emit_line("    %argv_ptr = ptrtoint i8** %argv to i64")
    llvm_emit_line("    call void @freak_llvm_setup_args(i64 %argc_ext, i64 %argv_ptr)")
    pilot native_main_result = ""
    if has_main_task {
        llvm_emit_line("    call void @__freak_generated_init_globals()")
        if main_task_return_type == "int" {
            native_main_result = next_reg()
            llvm_emit_line("    " + native_main_result + " = call i64 " + llvm_user_task_symbol("main") + "()")
        } else {
            llvm_emit_line("    call void " + llvm_user_task_symbol("main") + "()")
        }
    }
    if not has_main_task {
        llvm_emit_line("    call void @__freak_generated_top_level()")
    }
    pilot cleanup_i = 0
    repeat top_count times {
        pilot cleanup_id: word = array_get(ast_top_stmts, cleanup_i)
        pilot cleanup_kind: word = array_get(ast_stmt_kinds, word_to_int(cleanup_id))
        if cleanup_kind == STMT_PILOT {
            pilot cleanup_name: word = array_get(ast_stmt_names, word_to_int(cleanup_id))
            if llvm_get_var_type(cleanup_name).starts_with("w") {
                pilot cleanup_value = next_reg()
                llvm_emit_line("    " + cleanup_value + " = load i64, i64* @g_" + cleanup_name)
                llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + cleanup_value + ", i64 0)")
                llvm_emit_line("    store i64 0, i64* @g_" + cleanup_name)
            }
        }
        cleanup_i += 1
    }
    if native_main_result != "" {
        pilot native_exit_code = next_reg()
        llvm_emit_line("    " + native_exit_code + " = trunc i64 " + native_main_result + " to i32")
        llvm_emit_line("    ret i32 " + native_exit_code)
    } else {
        llvm_emit_line("    ret i32 0")
    }
    llvm_emit_line("}")
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0

    -- Append string literals at end
    llvm_emit_line("")
    llvm_emit_line("; String Literals")
    llvm_emit_line(string_literals)
    llvm_emit_line("!llvm.dbg.cu = !{!" + word_from_int(llvm_dbg_cu_id) + "}")
    llvm_emit_line("!llvm.module.flags = !{!" + word_from_int(llvm_dbg_append("!{i32 7, !\"Dwarf Version\", i32 4}")) + ", !" + word_from_int(llvm_dbg_append("!{i32 2, !\"Debug Info Version\", i32 3}")) + "}")
    llvm_emit_line(llvm_dbg_md)
}
