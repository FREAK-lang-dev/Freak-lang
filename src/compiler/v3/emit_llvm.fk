-- ===================================================================
-- FREAK v3 COMPILER — LLVM IR BACKEND EMITTER
-- ===================================================================
-- v3 KEY CHANGES:
-- 1. Streaming emit via fs::append (no buffer, no flush, no O(n^2))
-- 2. Flat if + early return for call mapping (never truncated)
-- 3. Proper reserved global-init wrapper emitted (no Python post-processing)
-- 4. Split into modular tasks (each <100 lines)

-- ===================== LLVM EMIT HELPERS =============================

pilot llvm_current_return_semantic_type = "v"

task llvm_emit(s: word) -> void {
    fs::append(out_file, s)
}

task llvm_emit_line(s: word) -> void {
    pilot out = s
    if llvm_dbg_current_scope_id > 0 and llvm_dbg_current_line > 0 {
        if s.starts_with("    ") and not s.starts_with("    ;") {
            pilot loc_id = llvm_dbg_emit_location(llvm_dbg_current_line)
            out = s + ", !dbg !" + word_from_int(loc_id)
        }
    }
    fs::append(out_file, out + "\n")
}

task next_reg() -> word {
    pilot r = "%t" + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    give back r
}

task llvm_escape_str(s: word) -> word {
    pilot esc_out = ""
    pilot esc_len = s.length()
    pilot esc_i = 0
    repeat until esc_i >= esc_len {
        pilot ch = s.char_at(esc_i)
        if ch == "\\" and esc_i + 3 < esc_len {
            pilot nx = s.char_at(esc_i + 1)
            if nx == "x" {
                -- \xNN hex escape from lexer -> LLVM IR \NN
                pilot h1 = s.char_at(esc_i + 2)
                pilot h2 = s.char_at(esc_i + 3)
                esc_out = esc_out + "\\" + h1 + h2
                esc_i += 4
            } else {
                esc_out = esc_out + "\\5C"
                esc_i += 1
            }
        } else if ch == "\"" { esc_out = esc_out + "\\22" esc_i += 1 }
        else if ch == "\\" { esc_out = esc_out + "\\5C" esc_i += 1 }
        else if ch == "\n" { esc_out = esc_out + "\\0A" esc_i += 1 }
        else if ch == "\r" { esc_out = esc_out + "\\0D" esc_i += 1 }
        else if ch == "\t" { esc_out = esc_out + "\\09" esc_i += 1 }
        else { esc_out = esc_out + ch esc_i += 1 }
    }
    give back esc_out
}

task llvm_dbg_escape(s: word) -> word {
    pilot out = ""
    pilot i = 0
    pilot slen = s.length()
    repeat until i >= slen {
        pilot ch = s.char_at(i)
        if ch == "\\" { out = out + "\\5C" }
        else if ch == "\"" { out = out + "\\22" }
        else { out = out + ch }
        i += 1
    }
    give back out
}

task llvm_dbg_append(defn: word) -> int {
    pilot id = llvm_dbg_next_id
    llvm_dbg_next_id += 1
    llvm_dbg_md = llvm_dbg_md + "!" + word_from_int(id) + " = " + defn + "\n"
    give back id
}

task llvm_dbg_init() -> void {
    llvm_dbg_md = ""
    llvm_dbg_next_id = 0
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0
    llvm_dbg_current_dir = "."
    llvm_dbg_current_file = input_file

    pilot slash = -1
    pilot i = 0
    pilot plen = input_file.length()
    repeat until i >= plen {
        pilot ch = input_file.char_at(i)
        if ch == "/" or ch == "\\" {
            slash = i
        }
        i += 1
    }

    if slash >= 0 {
        pilot base = ""
        i = slash + 1
        repeat until i >= plen {
            base = base + input_file.char_at(i)
            i += 1
        }
        if base != "" {
            llvm_dbg_current_file = base
        }

        pilot dir = ""
        i = 0
        repeat until i >= slash {
            dir = dir + input_file.char_at(i)
            i += 1
        }
        if dir != "" {
            llvm_dbg_current_dir = dir
        }
    }

    pilot file_name = llvm_dbg_escape(llvm_dbg_current_file)
    pilot dir_name = llvm_dbg_escape(llvm_dbg_current_dir)
    llvm_dbg_file_id = llvm_dbg_append("!DIFile(filename: \"" + file_name + "\", directory: \"" + dir_name + "\")")
    llvm_dbg_cu_id = llvm_dbg_append("distinct !DICompileUnit(language: DW_LANG_C, file: !" + word_from_int(llvm_dbg_file_id) + ", producer: \"FREAK v3\", isOptimized: false, runtimeVersion: 0, emissionKind: LineTablesOnly)")
    llvm_dbg_empty_id = llvm_dbg_append("!{}")
    llvm_dbg_subroutine_type_id = llvm_dbg_append("!DISubroutineType(types: !" + word_from_int(llvm_dbg_empty_id) + ")")
}

task llvm_dbg_emit_subprogram(name: word, line_no: int) -> int {
    if line_no <= 0 { line_no = 1 }
    give back llvm_dbg_append("distinct !DISubprogram(name: \"" + llvm_dbg_escape(name) + "\", scope: !" + word_from_int(llvm_dbg_file_id) + ", file: !" + word_from_int(llvm_dbg_file_id) + ", line: " + word_from_int(line_no) + ", type: !" + word_from_int(llvm_dbg_subroutine_type_id) + ", scopeLine: " + word_from_int(line_no) + ", spFlags: DISPFlagDefinition, unit: !" + word_from_int(llvm_dbg_cu_id) + ", retainedNodes: !" + word_from_int(llvm_dbg_empty_id) + ")")
}

task llvm_dbg_emit_location(line_no: int) -> int {
    if line_no <= 0 { line_no = 1 }
    give back llvm_dbg_append("!DILocation(line: " + word_from_int(line_no) + ", column: 1, scope: !" + word_from_int(llvm_dbg_current_scope_id) + ")")
}

task llvm_dbg_set_stmt_line(eid: word) -> void {
    pilot line_no = 1
    if eid.length() > 0 {
        pilot idx = word_to_int(eid)
        line_no = word_to_int(array_get(ast_stmt_lines, idx))
        if line_no <= 0 { line_no = 1 }
    }
    llvm_dbg_current_line = line_no
}

task llvm_dbg_begin_func(name: word, line_no: int) -> word {
    -- LB10 minimal: emit a DISubprogram for this function, set the
    -- current scope so llvm_emit_line attaches `!dbg !N` to every
    -- instruction, and return the function-level attribute that
    -- links the definition to the subprogram. The `lineTablesOnly`
    -- emission kind in llvm_dbg_init keeps the metadata footprint
    -- bounded — no variable info, no type info, just enough for
    -- source-line backtraces in gdb/lldb.
    pilot sp_id = llvm_dbg_emit_subprogram(name, line_no)
    llvm_dbg_current_scope_id = sp_id
    llvm_dbg_current_line = line_no
    give back " !dbg !" + word_from_int(sp_id)
}

task llvm_string_byte_len(val: word) -> int {
    pilot source_len = val.length()
    pilot byte_len = 0
    pilot i = 0
    repeat until i >= source_len {
        if val.char_at(i) == "\\" and i + 3 < source_len {
            if val.char_at(i + 1) == "x" {
                i += 4
            } else {
                i += 1
            }
        } else {
            i += 1
        }
        byte_len += 1
    }
    give back byte_len
}

task register_string_literal(val: word) -> word {
    pilot id = "@.str." + word_from_int(string_literals_count)
    string_literals_count += 1
    pilot real_val = val
    pilot null_term_len = llvm_string_byte_len(real_val) + 1
    pilot escaped = llvm_escape_str(real_val)
    pilot decl = id + " = private unnamed_addr constant [" + word_from_int(null_term_len) + " x i8] c\"" + escaped + "\\00\", align 1\n"
    string_literals = string_literals + decl
    give back id
}

task llvm_c_safe_ident(s: word) -> word {
    pilot res = ""
    pilot slen = s.length()
    pilot i = 0
    repeat slen times {
        pilot c = s.char_at(i)
        if c == ":" {
            if i + 1 < slen {
                if s.char_at(i + 1) == ":" {
                    res = res + "_"
                    i += 1
                } else { res = res + c }
            } else { res = res + c }
        } else { res = res + c }
        i += 1
    }
    give back res
}

-- ===================== TYPE TRACKING =================================

task llvm_set_var_type(name: word, vtype: word) -> void {
    llvm_var_names = llvm_var_names + name + "|"
    llvm_var_types = llvm_var_types + vtype + "|"
}

task llvm_type_at(types: word, wanted: int) -> word {
    pilot i = 0
    pilot idx = 0
    pilot current = ""
    repeat until i >= types.length() {
        pilot c = types.char_at(i)
        if c == "|" {
            if idx == wanted { give back current }
            idx += 1
            current = ""
        } else {
            current = current + c
        }
        i += 1
    }
    give back ""
}

task llvm_lookup_type(names: word, types: word, name: word) -> word {
    pilot nlen = names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    pilot found = ""
    repeat until i >= nlen {
        pilot c = names.char_at(i)
        if c == "|" {
            if cur_name == name {
                -- Keep scanning so the newest same-scope binding wins.
                found = llvm_type_at(types, idx)
            }
            idx += 1
            cur_name = ""
        } else { cur_name = cur_name + c }
        i += 1
    }
    give back found
}

task llvm_get_var_type(name: word) -> word {
    pilot local_type = llvm_lookup_type(llvm_var_names, llvm_var_types, name)
    if local_type != "" { give back local_type }
    pilot global_type = llvm_lookup_type(llvm_global_type_names, llvm_global_types, name)
    if global_type != "" { give back global_type }
    give back "i"
}

task llvm_type_code(type_name: word) -> word {
    if type_name == "w" or type_name == "word" { give back "w" }
    if type_name == "n" or type_name == "num" or type_name == "float" { give back "n" }
    if type_name == "b" or type_name == "bool" { give back "b" }
    if type_name == "v" or type_name == "void" or type_name == "" { give back "v" }
    if type_name.starts_with("s:") { give back type_name }
    if is_shape_name(type_name) { give back "s:" + type_name }
    give back "i"
}

task llvm_shape_name_from_type(vtype: word) -> word {
    if vtype.starts_with("s:") and vtype.length() > 2 {
        give back vtype.substring(2, vtype.length() - 2)
    }
    give back ""
}

task llvm_register_task(name: word, ret_type: word) -> void {
    pilot t = llvm_type_code(ret_type)
    llvm_task_reg_names = llvm_task_reg_names + name + "|"
    llvm_task_reg_types = llvm_task_reg_types + t + "|"
    llvm_task_reg_count += 1
}

task llvm_get_task_ret_type(name: word) -> word {
    pilot nlen = llvm_task_reg_names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    repeat until i >= nlen {
        pilot c = llvm_task_reg_names.char_at(i)
        if c == "|" {
            if cur_name == name {
                pilot ti = 0
                pilot cur_type = ""
                pilot tidx = 0
                pilot tlen = llvm_task_reg_types.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_task_reg_types.char_at(ti)
                    if tc == "|" {
                        if tidx == idx { give back cur_type }
                        tidx += 1
                        cur_type = ""
                    } else { cur_type = cur_type + tc }
                    ti += 1
                }
            }
            idx += 1
            cur_name = ""
        } else { cur_name = cur_name + c }
        i += 1
    }
    give back ""
}

task llvm_is_global(vname: word) -> bool {
    pilot needle = "|" + vname + "|"
    give back llvm_global_names.contains(needle)
}

-- Register a FREAK→LLVM name binding (latest entry wins on lookup)
task llvm_reg_var(freak_name: word, llvm_name: word) -> void {
    llvm_var_reg_map = llvm_var_reg_map + freak_name + ":" + llvm_name + "|"
}

-- Look up the latest LLVM name for a FREAK variable name (scan from end)
-- Format: "freak_name:llvm_name|freak_name2:llvm_name2|..."
task llvm_get_llvm_name(freak_name: word) -> word {
    pilot mlen = llvm_var_reg_map.length()
    pilot i = mlen - 1
    pilot cur_llvm = ""
    pilot cur_freak = ""
    pilot in_llvm = true
    repeat until i < 0 {
        pilot ch = llvm_var_reg_map.char_at(i)
        if ch == "|" {
            -- End of an entry: check the accumulated freak name
            if cur_freak == freak_name and cur_llvm.length() > 0 { give back cur_llvm }
            cur_llvm = ""
            cur_freak = ""
            in_llvm = true
        } else if ch == ":" {
            in_llvm = false
        } else if in_llvm {
            cur_llvm = ch + cur_llvm
        } else {
            cur_freak = ch + cur_freak
        }
        i -= 1
    }
    -- Check the first entry (no leading |)
    if cur_freak == freak_name and cur_llvm.length() > 0 { give back cur_llvm }
    give back ""
}

task llvm_var_ptr(vname: word) -> word {
    pilot unique = llvm_get_llvm_name(vname)
    if unique != "" { give back "%" + unique }
    if llvm_is_global(vname) { give back "@g_" + vname }
    -- Unknown name: assume it's an unresolved top-level global. Emitting
    -- "%vname" would produce an undefined SSA register and a confusing
    -- clang error. "@g_vname" surfaces a clean linker-time missing-symbol
    -- error instead.
    give back "@g_" + vname
}

task llvm_is_runtime_func(fname: word) -> bool {
    pilot needle = "|" + fname + "|"
    give back llvm_declared_funcs.contains(needle)
}

-- ===================== TYPE INFERENCE ================================

task llvm_infer_expr_type(expr_id: word) -> word {
    if expr_id.length() == 0 { give back "i" }
    pilot i = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)

    if kind == EXPR_STR or kind == EXPR_INTERP { give back "w" }
    if kind == EXPR_INT { give back "i" }
    if kind == EXPR_FLOAT { give back "n" }
    if kind == EXPR_BOOL { give back "b" }
    if kind == EXPR_IDENT { give back llvm_get_var_type(val) }

    if kind == EXPR_METHOD {
        pilot recv_expr: word = array_get(ast_expr_lefts, i)
        pilot recv_type = llvm_infer_expr_type(recv_expr)
        pilot recv_shape = llvm_shape_name_from_type(recv_type)
        if recv_shape != "" {
            pilot exact_ret = llvm_get_task_ret_type(recv_shape + "_" + val)
            if exact_ret.length() > 0 { give back exact_ret }
        }
        pilot recv_builtin_type = "int"
        if recv_type.starts_with("w") { recv_builtin_type = "word" }
        else if recv_type.starts_with("n") { recv_builtin_type = "num" }
        else if recv_type.starts_with("b") { recv_builtin_type = "bool" }
        pilot builtin_ret = tc_builtin_method_return_type(recv_builtin_type, val)
        if builtin_ret != "" { give back llvm_type_code(builtin_ret) }
        if recv_shape == "" {
            pilot mi = 0
            repeat shape_registry_count times {
                pilot msname: word = "" + array_get(shape_registry_names, mi)
                pilot impl_ret: word = llvm_get_task_ret_type(msname + "_" + val)
                if impl_ret.length() > 0 { give back impl_ret }
                mi += 1
            }
        }
    }

    if kind == EXPR_FIELD {
        pilot recv_expr: word = array_get(ast_expr_lefts, i)
        give back llvm_infer_field_type(recv_expr, val)
    }

    if kind == EXPR_BINOP {
        if val == "==" or val == "!=" or val == "<" or val == ">" or val == "<=" or val == ">=" or val == "and" or val == "or" { give back "b" }
        pilot left: word = array_get(ast_expr_lefts, i)
        pilot right: word = array_get(ast_expr_rights, i)
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        if val == "+" {
            if lt.starts_with("w") or rt.starts_with("w") { give back "w" }
        }
        if lt.starts_with("n") or rt.starts_with("n") {
            if val == "+" or val == "-" or val == "*" or val == "/" or val == "%" { give back "n" }
        }
    }

    if kind == EXPR_UNARYOP {
        if val == "not" { give back "b" }
        give back llvm_infer_expr_type(array_get(ast_expr_lefts, i))
    }

    if kind == EXPR_CALL {
        give back llvm_infer_call_type(val)
    }

    give back "i"
}

task llvm_infer_field_type(receiver_expr: word, field_name: word) -> word {
    pilot receiver_shape = llvm_shape_name_from_type(llvm_infer_expr_type(receiver_expr))
    if receiver_shape != "" {
        pilot exact_type = get_shape_field_type(receiver_shape, field_name)
        if exact_type != "" { give back llvm_type_code(exact_type) }
        give back "i"
    }

    -- A receiver without a shape type may use the legacy fallback only when
    -- every matching shape agrees. Ambiguous names must not silently borrow a
    -- word as an integer (or vice versa).
    pilot inferred = ""
    pilot fi = 0
    repeat shape_registry_count times {
        pilot shape_name: word = array_get(shape_registry_names, fi)
        pilot raw_type = get_shape_field_type(shape_name, field_name)
        if raw_type != "" {
            pilot candidate = llvm_type_code(raw_type)
            if inferred == "" { inferred = candidate }
            else if inferred != candidate { give back "i" }
        }
        fi += 1
    }
    if inferred != "" { give back inferred }
    give back "i"
}

task llvm_infer_field_index(receiver_expr: word, field_name: word) -> int {
    pilot receiver_shape = llvm_shape_name_from_type(llvm_infer_expr_type(receiver_expr))
    if receiver_shape != "" { give back get_shape_field_index(receiver_shape, field_name) }

    pilot inferred = 0 - 1
    pilot si = 0
    repeat shape_registry_count times {
        pilot candidate = get_shape_field_index(array_get(shape_registry_names, si), field_name)
        if candidate >= 0 {
            if inferred < 0 { inferred = candidate }
            else if inferred != candidate { give back 0 - 1 }
        }
        si += 1
    }
    give back inferred
}

task llvm_shape_field_type_at(shape_name: word, wanted: int) -> word {
    pilot fields = get_shape_fields(shape_name)
    pilot field_index = 0
    pilot current_type = ""
    pilot in_type = false
    pilot i = 0
    repeat fields.length() times {
        pilot ch = fields.char_at(i)
        if ch == ":" {
            in_type = true
        } else if ch == "," {
            if field_index == wanted { give back llvm_type_code(current_type) }
            field_index += 1
            current_type = ""
            in_type = false
        } else if in_type {
            current_type = current_type + ch
        }
        i += 1
    }
    if field_index == wanted { give back llvm_type_code(current_type) }
    give back ""
}

task llvm_infer_call_type(val: word) -> word {
    pilot builtin_type = tc_builtin_call_type(val)
    if builtin_type != "" { give back llvm_type_code(builtin_type) }
    if val.starts_with("shape::ctor::") {
        give back "s:" + val.replace("shape::ctor::", "")
    }
    pilot task_ret = llvm_get_task_ret_type(val)
    if task_ret.length() > 0 { give back task_ret }
    give back "i"
}

-- ===================== NUM HELPERS ===================================

task llvm_i64_to_double(i64_reg: word) -> word {
    pilot dbl = next_reg()
    llvm_emit_line("    " + dbl + " = bitcast i64 " + i64_reg + " to double")
    give back dbl
}

task llvm_double_to_i64(dbl_reg: word) -> word {
    pilot i64r = next_reg()
    llvm_emit_line("    " + i64r + " = bitcast double " + dbl_reg + " to i64")
    give back i64r
}

task llvm_numeric_to_double(i64_reg: word, expr_id: word) -> word {
    if llvm_infer_expr_type(expr_id).starts_with("n") {
        give back llvm_i64_to_double(i64_reg)
    }
    pilot dbl = next_reg()
    llvm_emit_line("    " + dbl + " = sitofp i64 " + i64_reg + " to double")
    give back dbl
}

task llvm_coerce_num_bits(i64_reg: word, expr_id: word) -> word {
    if llvm_infer_expr_type(expr_id).starts_with("n") { give back i64_reg }
    if not llvm_infer_expr_type(expr_id).starts_with("i") { give back i64_reg }
    pilot dbl = next_reg()
    llvm_emit_line("    " + dbl + " = sitofp i64 " + i64_reg + " to double")
    give back llvm_double_to_i64(dbl)
}

task llvm_emit_num_compound_bits(current_bits: word, rhs_reg: word, rhs_expr: word, float_op: word) -> word {
    pilot current_double = llvm_i64_to_double(current_bits)
    pilot rhs_double = llvm_numeric_to_double(rhs_reg, rhs_expr)
    pilot combined = next_reg()
    llvm_emit_line("    " + combined + " = " + float_op + " double " + current_double + ", " + rhs_double)
    give back llvm_double_to_i64(combined)
}

task llvm_is_num_expr(expr_id: word) -> bool {
    pilot t = llvm_infer_expr_type(expr_id)
    if t.starts_with("n") { give back true }
    give back false
}

-- ===================== CALL MAPPING (FLAT) ============================
-- v3 KEY CHANGE: flat if + early return. Never truncated.

task llvm_map_call_name(val: word) -> word {
    if val == "say" { give back "@freak_llvm_say" }
    if val == "ask" { give back "@freak_llvm_ask" }
    if val == "word_from_int" { give back "@freak_llvm_word_from_int" }
    if val == "word_from_bool" { give back "@freak_llvm_word_from_bool" }
    if val == "word_to_int" { give back "@freak_llvm_word_to_int" }
    if val == "word_concat" { give back "@freak_llvm_word_concat" }
    if val == "char_to_word" { give back "@freak_llvm_char_to_word" }
    if val == "fs::read" { give back "@freak_llvm_fs_read" }
    if val == "fs::write" { give back "@freak_llvm_fs_write" }
    if val == "fs::append" { give back "@freak_llvm_fs_append" }
    if val == "fs::exists" { give back "@freak_llvm_fs_exists" }
    if val == "fs::delete" { give back "@freak_llvm_fs_delete" }
    if val == "freak_internal_delete_file_checked" {
        -- Only the compiler aggregate's explicit extern declaration maps to
        -- the runtime bridge. A same-named user task remains a normal nominal
        -- task and must never acquire filesystem authority by name alone.
        pilot internal_entry = tc_callable_entry(val)
        if internal_entry >= 0 {
            pilot declaration_id = word_to_int(array_get(tc_callable_stmt_ids, internal_entry))
            if array_get(ast_stmt_kinds, declaration_id) == STMT_EXTERN and tc_compiler_internal_source(array_get(ast_stmt_files, declaration_id)) {
                give back "@freak_llvm_fs_delete_checked"
            }
        }
    }
    if val == "fs::list_dir" { give back "@freak_llvm_fs_list_dir" }
    if val == "fs::make_dir" { give back "@freak_llvm_fs_make_dir" }
    if val == "process::env" { give back "@freak_llvm_process_env" }
    if val == "process::input" { give back "@freak_llvm_process_input" }
    if val == "process::args_count" { give back "@freak_llvm_process_args_count" }
    if val == "process::arg" { give back "@freak_llvm_process_arg" }
    if val == "process::exit" { give back "@freak_llvm_process_exit" }
    if val == "process::exec" { give back "@freak_llvm_process_exec" }
    if val == "process::exec_capture" { give back "@freak_llvm_process_exec_capture" }
    if val == "time::now_ms" { give back "@freak_llvm_time_now_ms" }
    if val == "panic" { give back "@freak_llvm_panic" }
    if val == "array_new" { give back "@freak_llvm_array_new" }
    if val == "array_push" { give back "@freak_llvm_array_push_owned" }
    if val == "array_get" { give back "@freak_llvm_array_get" }
    if val == "array_set" { give back "@freak_llvm_array_set_owned" }
    if val == "array_len" { give back "@freak_llvm_array_len" }
    if val == "array_release" { give back "@freak_llvm_array_release_owned" }
    if val == "word_join" { give back "@freak_llvm_word_join_owned" }
    if val == "ui::create_window" { give back "@freak_llvm_ui_create_window" }
    if val == "ui::destroy_window" { give back "@freak_llvm_ui_destroy_window" }
    if val == "ui::poll_events" { give back "@freak_llvm_ui_poll_events" }
    if val == "ui::begin_frame" { give back "@freak_llvm_ui_begin_frame" }
    if val == "ui::end_frame" { give back "@freak_llvm_ui_end_frame" }
    if val == "ui::event_kind" { give back "@freak_llvm_ui_event_kind" }
    if val == "ui::event_key" { give back "@freak_llvm_ui_event_key" }
    if val == "ui::event_pressed" { give back "@freak_llvm_ui_event_pressed" }
    if val == "ui::event_character" { give back "@freak_llvm_ui_event_character" }
    if val == "ui::event_mouse_x" { give back "@freak_llvm_ui_event_mouse_x" }
    if val == "ui::event_mouse_y" { give back "@freak_llvm_ui_event_mouse_y" }
    if val == "ui::event_button" { give back "@freak_llvm_ui_event_button" }
    if val == "ui::event_repeat" { give back "@freak_llvm_ui_event_repeat" }
    if val == "ui::event_scroll_dy" { give back "@freak_llvm_ui_event_scroll_dy" }
    if val == "ui::event_width" { give back "@freak_llvm_ui_event_width" }
    if val == "ui::event_height" { give back "@freak_llvm_ui_event_height" }
    if val == "ui::event_gained" { give back "@freak_llvm_ui_event_gained" }
    if val == "ui::get_width" { give back "@freak_llvm_ui_get_width" }
    if val == "ui::get_height" { give back "@freak_llvm_ui_get_height" }
    if val == "ui::clear" { give back "@freak_llvm_ui_clear" }
    if val == "ui::fill_rect" { give back "@freak_llvm_ui_fill_rect" }
    if val == "ui::stroke_rect" { give back "@freak_llvm_ui_stroke_rect" }
    if val == "ui::fill_circle" { give back "@freak_llvm_ui_fill_circle" }
    if val == "ui::draw_line" { give back "@freak_llvm_ui_draw_line" }
    if val == "ui::draw_text" { give back "@freak_llvm_ui_draw_text" }
    if val == "ui::measure_text" { give back "@freak_llvm_ui_measure_text" }
    if val == "math::sqrt" { give back "@freak_llvm_math_sqrt" }
    if val == "math::pow" { give back "@freak_llvm_math_pow" }
    if val == "math::sin" { give back "@freak_llvm_math_sin" }
    if val == "math::cos" { give back "@freak_llvm_math_cos" }
    if val == "math::tan" { give back "@freak_llvm_math_tan" }
    if val == "math::floor" { give back "@freak_llvm_math_floor" }
    if val == "math::ceil" { give back "@freak_llvm_math_ceil" }
    if val == "parse_num" { give back "@freak_llvm_parse_num" }
    if val == "format_num" { give back "@freak_llvm_format_num" }
    if val == "shape::alloc" { give back "@freak_llvm_shape_alloc" }
    if val == "shape::get" { give back "@freak_llvm_shape_get" }
    if val == "shape::set" { give back "@freak_llvm_shape_set" }
    if val == "tcp::connect" or val == "tcp_connect" { give back "@freak_llvm_tcp_connect" }
    if val == "tcp::send" or val == "tcp_send" { give back "@freak_llvm_tcp_send" }
    if val == "tcp::recv" or val == "tcp_recv" { give back "@freak_llvm_tcp_recv" }
    if val == "tcp::recv_all" or val == "tcp_recv_all" { give back "@freak_llvm_tcp_recv_all" }
    if val == "tcp::close" or val == "tcp_close" { give back "@freak_llvm_tcp_close" }
    give back ""
}

task llvm_user_task_symbol(name: word) -> word {
    if tc_internal_runtime_task_name(name) { give back "@freak_" + llvm_c_safe_ident(name) }
    give back "@__freak_user_" + llvm_c_safe_ident(name)
}

task llvm_is_void_call(val: word) -> bool {
    if val == "say" or val == "panic" { give back true }
    if val == "fs::write" or val == "fs::append" or val == "fs::delete" or val == "fs::make_dir" { give back true }
    if val == "process::exit" { give back true }
    if val == "array_push" or val == "array_set" or val == "array_release" { give back true }
    if val == "shape::set" { give back true }
    if val == "tcp::close" or val == "tcp_close" { give back true }
    if val == "ui::destroy_window" or val == "ui::begin_frame" or val == "ui::end_frame" { give back true }
    if val == "ui::clear" or val == "ui::fill_rect" or val == "ui::stroke_rect" { give back true }
    if val == "ui::fill_circle" or val == "ui::draw_line" { give back true }
    give back false
}

-- ===================== ARGS ==========================================

task llvm_param_type_at(params: word, wanted: int) -> word {
    if params == "" { give back "" }
    pilot i = 0
    pilot param_index = 0
    pilot current_type = ""
    pilot in_type = false
    repeat until i >= params.length() {
        pilot ch = params.char_at(i)
        if ch == ":" { in_type = true }
        else if ch == "," {
            if param_index == wanted { give back llvm_type_code(current_type) }
            param_index += 1
            current_type = ""
            in_type = false
        } else if in_type {
            current_type = current_type + ch
        }
        i += 1
    }
    if param_index == wanted { give back llvm_type_code(current_type) }
    give back ""
}

task llvm_callable_param_types(name: word) -> word {
    pilot entry = tc_callable_entry(name)
    if entry >= 0 { give back array_get(tc_callable_params, entry) }
    give back ""
}

task llvm_builtin_param_types(name: word) -> word {
    if name == "math::pow" { give back "base:num,exponent:num" }
    if name == "math::sqrt" or name == "math::sin" or name == "math::cos" { give back "value:num" }
    if name == "math::tan" or name == "math::floor" or name == "math::ceil" { give back "value:num" }
    if name == "format_num" { give back "value:num" }
    give back ""
}

task llvm_word_expr_needs_clone(expr_id: word) -> bool {
    pilot idx = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, idx)
    if kind == EXPR_IDENT or kind == EXPR_FIELD {
        give back llvm_infer_expr_type(expr_id).starts_with("w")
    }
    if kind == EXPR_CALL and array_get(ast_expr_vals, idx) == "array_get" { give back true }
    give back false
}

task llvm_word_expr_is_owned_temporary(expr_id: word) -> bool {
    if not llvm_infer_expr_type(expr_id).starts_with("w") { give back false }
    give back not llvm_word_expr_needs_clone(expr_id)
}

task llvm_emit_args(args: word, clone_borrowed_words: bool, param_types: word, param_offset: int) -> word {
    pilot res = ""
    pilot i = 0
    pilot slen = args.length()
    pilot cur_id = ""
    pilot first = true
    pilot arg_index = 0
    repeat slen times {
        pilot c = args.char_at(i)
        if c == "," {
            pilot reg: word = llvm_emit_expr(cur_id)
            pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
            if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
            if clone_borrowed_words and llvm_word_expr_needs_clone(cur_id) {
                pilot clone_reg = next_reg()
                llvm_emit_line("    " + clone_reg + " = call i64 @freak_llvm_word_clone(i64 " + reg + ")")
                reg = clone_reg
            }
            if not first { res = res + ", " }
            res = res + "i64 " + reg
            cur_id = ""
            first = false
            arg_index += 1
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id.length() > 0 {
        pilot reg: word = llvm_emit_expr(cur_id)
        pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
        if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
        if clone_borrowed_words and llvm_word_expr_needs_clone(cur_id) {
            pilot clone_reg = next_reg()
            llvm_emit_line("    " + clone_reg + " = call i64 @freak_llvm_word_clone(i64 " + reg + ")")
            reg = clone_reg
        }
        if not first { res = res + ", " }
        res = res + "i64 " + reg
    }
    give back res
}

task llvm_emit_borrowed_args(args: word, param_types: word, param_offset: int) -> word {
    pilot res = ""
    pilot cleanup = ""
    pilot i = 0
    pilot cur_id = ""
    pilot first = true
    pilot arg_index = 0
    repeat args.length() times {
        pilot c = args.char_at(i)
        if c == "," {
            if cur_id != "" {
                pilot reg: word = llvm_emit_expr(cur_id)
                pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
                if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
                if llvm_word_expr_is_owned_temporary(cur_id) { cleanup = cleanup + reg + "|" }
                if not first { res = res + ", " }
                res = res + "i64 " + reg
                first = false
                arg_index += 1
            }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id != "" {
        pilot reg: word = llvm_emit_expr(cur_id)
        pilot expected_type = llvm_param_type_at(param_types, arg_index + param_offset)
        if expected_type.starts_with("n") { reg = llvm_coerce_num_bits(reg, cur_id) }
        if llvm_word_expr_is_owned_temporary(cur_id) { cleanup = cleanup + reg + "|" }
        if not first { res = res + ", " }
        res = res + "i64 " + reg
    }
    llvm_last_borrowed_cleanup = cleanup
    give back res
}

task llvm_emit_borrowed_cleanup(cleanup: word, replacement: word) -> void {
    pilot i = 0
    pilot current = ""
    repeat cleanup.length() times {
        pilot ch: word = cleanup.char_at(i)
        if ch == "|" {
            if current != "" {
                llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + current + ", i64 " + replacement + ")")
            }
            current = ""
        } else { current = current + ch }
        i += 1
    }
}

task llvm_finish_borrowed_method(expr_id: word, receiver_id: word, receiver_reg: word, arg_cleanup: word, result_reg: word) -> word {
    pilot replacement = "0"
    if llvm_infer_expr_type(expr_id).starts_with("w") { replacement = result_reg }
    if llvm_word_expr_is_owned_temporary(receiver_id) {
        llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + receiver_reg + ", i64 " + replacement + ")")
    }
    llvm_emit_borrowed_cleanup(arg_cleanup, replacement)
    give back result_reg
}

-- ===================== EXPRESSION EMIT ===============================

task llvm_emit_expr(id: word) -> word {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)
    pilot left: word = array_get(ast_expr_lefts, i)
    pilot right: word = array_get(ast_expr_rights, i)

    if kind == EXPR_INT { give back val }
    if kind == EXPR_BOOL {
        if val == "true" or val == "yes" or val == "hai" { give back "1" }
        give back "0"
    }
    if kind == EXPR_FLOAT {
        pilot dbl_reg = next_reg()
        pilot cast_reg = next_reg()
        llvm_emit_line("    " + dbl_reg + " = fadd double 0.0, " + val)
        llvm_emit_line("    " + cast_reg + " = bitcast double " + dbl_reg + " to i64")
        give back cast_reg
    }
    if kind == EXPR_STR {
        pilot str_id = register_string_literal(val)
        pilot len = llvm_string_byte_len(val) + 1
        pilot get_ptr = next_reg()
        llvm_emit_line("    " + get_ptr + " = getelementptr inbounds [" + word_from_int(len) + " x i8], [" + word_from_int(len) + " x i8]* " + str_id + ", i64 0, i64 0")
        pilot cast_reg = next_reg()
        llvm_emit_line("    " + cast_reg + " = ptrtoint i8* " + get_ptr + " to i64")
        give back cast_reg
    }
    if kind == EXPR_INTERP { give back llvm_emit_interp(left) }
    if kind == EXPR_IDENT {
        pilot res_reg = next_reg()
        llvm_emit_line("    " + res_reg + " = load i64, i64* " + llvm_var_ptr(val))
        give back res_reg
    }
    if kind == EXPR_CALL { give back llvm_emit_call(id, val, left) }
    if kind == EXPR_BINOP { give back llvm_emit_binop(val, left, right, id) }
    if kind == EXPR_UNARYOP { give back llvm_emit_unaryop(val, left) }
    if kind == EXPR_METHOD { give back llvm_emit_method(id, val, left, right) }
    if kind == EXPR_FIELD { give back llvm_emit_field(val, left) }
    if kind == EXPR_INDEX {
        pilot obj_reg = llvm_emit_expr(left)
        pilot idx_reg = llvm_emit_expr(right)
        pilot res_reg = next_reg()
        pilot ptr_reg = next_reg()
        llvm_emit_line("    " + ptr_reg + " = inttoptr i64 " + obj_reg + " to i8*")
        pilot gep_reg = next_reg()
        llvm_emit_line("    " + gep_reg + " = getelementptr inbounds i8, i8* " + ptr_reg + ", i64 " + idx_reg)
        pilot char_reg = next_reg()
        llvm_emit_line("    " + char_reg + " = load i8, i8* " + gep_reg)
        llvm_emit_line("    " + res_reg + " = zext i8 " + char_reg + " to i64")
        if llvm_word_expr_is_owned_temporary(left) {
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + obj_reg + ", i64 0)")
        }
        give back res_reg
    }
    if kind == EXPR_ARRAY_LIT {
        -- Lower `[a, b, c]` to:
        --   %arr = call i64 @freak_llvm_array_new()
        --   call void @freak_llvm_array_push(i64 %arr, i64 %a)
        --   call void @freak_llvm_array_push(i64 %arr, i64 %b)
        --   ...
        -- and return %arr.  `left` is a comma-separated list of element
        -- expr ids (same encoding as call args / shape ctor args).
        pilot arr_reg = next_reg()
        llvm_emit_line("    " + arr_reg + " = call i64 @freak_llvm_array_new()")
        pilot ai = 0
        pilot alen = left.length()
        pilot cur_eid = ""
        repeat alen times {
            pilot ac = left.char_at(ai)
            if ac == "," {
                if cur_eid.length() > 0 {
                    pilot er = llvm_emit_expr(cur_eid)
                    if llvm_word_expr_needs_clone(cur_eid) {
                        pilot cloned_element = next_reg()
                        llvm_emit_line("    " + cloned_element + " = call i64 @freak_llvm_word_clone(i64 " + er + ")")
                        er = cloned_element
                    }
                    llvm_emit_line("    call void @freak_llvm_array_push_owned(i64 " + arr_reg + ", i64 " + er + ")")
                    cur_eid = ""
                }
            } else {
                cur_eid = cur_eid + ac
            }
            ai += 1
        }
        if cur_eid.length() > 0 {
            pilot er2 = llvm_emit_expr(cur_eid)
            if llvm_word_expr_needs_clone(cur_eid) {
                pilot cloned_element = next_reg()
                llvm_emit_line("    " + cloned_element + " = call i64 @freak_llvm_word_clone(i64 " + er2 + ")")
                er2 = cloned_element
            }
            llvm_emit_line("    call void @freak_llvm_array_push_owned(i64 " + arr_reg + ", i64 " + er2 + ")")
        }
        give back arr_reg
    }
    give back "0"
}

task llvm_emit_interp(segments: word) -> word {
    pilot accumulator = "0"
    pilot segment_count = tc_arg_count(segments)
    pilot segment_index = 0
    repeat segment_count times {
        pilot segment_id = word_from_int(tc_arg_at(segments, segment_index))
        pilot segment_reg = llvm_emit_expr(segment_id)
        pilot segment_type = llvm_infer_expr_type(segment_id)
        pilot release_segment = "0"
        if not segment_type.starts_with("w") {
            pilot converted_reg = next_reg()
            if segment_type.starts_with("n") {
                llvm_emit_line("    " + converted_reg + " = call i64 @freak_llvm_format_num(i64 " + segment_reg + ")")
            } else if segment_type.starts_with("b") {
                llvm_emit_line("    " + converted_reg + " = call i64 @freak_llvm_word_from_bool(i64 " + segment_reg + ")")
            } else {
                llvm_emit_line("    " + converted_reg + " = call i64 @freak_llvm_word_from_int(i64 " + segment_reg + ")")
            }
            segment_reg = converted_reg
            release_segment = "1"
        }
        pilot appended_reg = next_reg()
        llvm_emit_line("    " + appended_reg + " = call i64 @freak_llvm_word_append_owned(i64 " + accumulator + ", i64 " + segment_reg + ", i64 " + release_segment + ")")
        accumulator = appended_reg
        segment_index += 1
    }
    give back accumulator
}

-- ===================== CALL EMIT =====================================

task llvm_emit_call(expr_id: word, val: word, left: word) -> word {
    -- Shape constructors have their own ownership-aware argument lowering.
    if val.starts_with("shape::ctor::") { give back llvm_emit_shape_ctor(val, left) }

    pilot arg_str = ""
    pilot mapped_name = llvm_map_call_name(val)
    pilot aggregate_call = val == "array_push" or val == "array_set"
    pilot user_call = mapped_name == "" and not emt_is_extern(val)
    pilot borrowed_cleanup = ""
    if left.length() > 0 {
        if aggregate_call {
            arg_str = llvm_emit_args(left, true, "", 0)
        } else if user_call {
            arg_str = llvm_emit_args(left, true, llvm_callable_param_types(val), 0)
        } else {
            pilot borrowed_param_types = llvm_builtin_param_types(val)
            if emt_is_extern(val) { borrowed_param_types = llvm_callable_param_types(val) }
            arg_str = llvm_emit_borrowed_args(left, borrowed_param_types, 0)
            borrowed_cleanup = llvm_last_borrowed_cleanup
        }
    }

    -- Map to LLVM function name
    pilot func_name = mapped_name
    if func_name == "" {
        if emt_is_extern(val) {
            func_name = "@" + llvm_c_safe_ident(val)
        } else {
            func_name = llvm_user_task_symbol(val)
        }
    }

    -- Check if void
    pilot is_void = llvm_is_void_call(val)
    if not is_void {
        pilot call_ret: word = llvm_get_task_ret_type(val)
        if call_ret == "v" { is_void = true }
    }

    if is_void {
        llvm_emit_line("    call void " + func_name + "(" + arg_str + ")")
        llvm_emit_borrowed_cleanup(borrowed_cleanup, "0")
        give back "0"
    }
    pilot res_reg = next_reg()
    llvm_emit_line("    " + res_reg + " = call i64 " + func_name + "(" + arg_str + ")")
    pilot replacement = "0"
    if llvm_infer_expr_type(expr_id).starts_with("w") { replacement = res_reg }
    llvm_emit_borrowed_cleanup(borrowed_cleanup, replacement)
    give back res_reg
}

task llvm_emit_shape_ctor(val: word, left: word) -> word {
    pilot sname = ""
    pilot vi = 13
    pilot vlen = val.length()
    repeat vlen times {
        if vi < vlen { sname = sname + val.char_at(vi) }
        vi += 1
    }
    pilot fcount = get_shape_field_count(sname)
    pilot alloc_reg = next_reg()
    llvm_emit_line("    " + alloc_reg + " = call i64 @freak_llvm_shape_alloc(i64 " + word_from_int(fcount) + ")")
    if left.length() > 0 {
        pilot fi = 0
        pilot ci = 0
        pilot cslen = left.length()
        pilot cur = ""
        repeat cslen times {
            pilot cc = left.char_at(ci)
            if cc == "," {
                if cur.length() > 0 {
                    pilot fval_reg = llvm_emit_expr(cur)
                    pilot field_type = llvm_shape_field_type_at(sname, fi)
                    if field_type.starts_with("n") { fval_reg = llvm_coerce_num_bits(fval_reg, cur) }
                    if llvm_word_expr_needs_clone(cur) {
                        pilot cloned_field = next_reg()
                        llvm_emit_line("    " + cloned_field + " = call i64 @freak_llvm_word_clone(i64 " + fval_reg + ")")
                        fval_reg = cloned_field
                    }
                    llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + alloc_reg + ", i64 " + word_from_int(fi) + ", i64 " + fval_reg + ")")
                    fi += 1
                }
                cur = ""
            } else { cur = cur + cc }
            ci += 1
        }
        if cur.length() > 0 {
            pilot fval_reg = llvm_emit_expr(cur)
            pilot field_type = llvm_shape_field_type_at(sname, fi)
            if field_type.starts_with("n") { fval_reg = llvm_coerce_num_bits(fval_reg, cur) }
            if llvm_word_expr_needs_clone(cur) {
                pilot cloned_field = next_reg()
                llvm_emit_line("    " + cloned_field + " = call i64 @freak_llvm_word_clone(i64 " + fval_reg + ")")
                fval_reg = cloned_field
            }
            llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + alloc_reg + ", i64 " + word_from_int(fi) + ", i64 " + fval_reg + ")")
        }
    }
    give back alloc_reg
}

-- ===================== BINOP EMIT ====================================

task llvm_emit_short_circuit(val: word, left: word, right: word) -> word {
    pilot left_reg = llvm_emit_expr(left)
    pilot left_bool = next_reg()
    llvm_emit_line("    " + left_bool + " = icmp ne i64 " + left_reg + ", 0")

    pilot short_block = "logic.short." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rhs_block = "logic.rhs." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rhs_done = "logic.rhs.done." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot end_block = "logic.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot short_value = "0"
    if val == "and" {
        llvm_emit_line("    br i1 " + left_bool + ", label %" + rhs_block + ", label %" + short_block)
    } else {
        short_value = "1"
        llvm_emit_line("    br i1 " + left_bool + ", label %" + short_block + ", label %" + rhs_block)
    }

    llvm_emit_line(short_block + ":")
    llvm_emit_line("    br label %" + end_block)

    llvm_emit_line(rhs_block + ":")
    pilot right_reg = llvm_emit_expr(right)
    pilot right_bool = next_reg()
    llvm_emit_line("    " + right_bool + " = icmp ne i64 " + right_reg + ", 0")
    pilot right_value = next_reg()
    llvm_emit_line("    " + right_value + " = zext i1 " + right_bool + " to i64")
    llvm_emit_line("    br label %" + rhs_done)

    llvm_emit_line(rhs_done + ":")
    llvm_emit_line("    br label %" + end_block)

    llvm_emit_line(end_block + ":")
    pilot result_reg = next_reg()
    llvm_emit_line("    " + result_reg + " = phi i64 [ " + short_value + ", %" + short_block + " ], [ " + right_value + ", %" + rhs_done + " ]")
    give back result_reg
}

task llvm_emit_binop(val: word, left: word, right: word, id: word) -> word {
    if val == "and" or val == "or" { give back llvm_emit_short_circuit(val, left, right) }
    pilot l_reg = llvm_emit_expr(left)
    pilot r_reg = llvm_emit_expr(right)
    pilot res_reg = next_reg()
    pilot is_num_op = llvm_is_num_expr(left) or llvm_is_num_expr(right)

    if val == "+" { give back llvm_emit_add(l_reg, r_reg, res_reg, left, right, id, is_num_op) }
    if val == "-" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "sub", "fsub") }
    if val == "*" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "mul", "fmul") }
    if val == "/" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "sdiv", "fdiv") }
    if val == "%" { give back llvm_emit_arith(l_reg, r_reg, res_reg, left, right, is_num_op, "srem", "frem") }
    if val == "==" { give back llvm_emit_cmp(l_reg, r_reg, res_reg, left, right, is_num_op, "eq", "oeq") }
    if val == "!=" { give back llvm_emit_cmp(l_reg, r_reg, res_reg, left, right, is_num_op, "ne", "une") }
    if val == "<" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "slt", "olt") }
    if val == ">" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "sgt", "ogt") }
    if val == "<=" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "sle", "ole") }
    if val == ">=" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, "sge", "oge") }
    if val == "NAKAMA" {
        pilot t1 = next_reg()
        llvm_emit_line("    " + t1 + " = add i64 " + l_reg + ", " + r_reg)
        pilot t2 = next_reg()
        llvm_emit_line("    " + t2 + " = mul i64 " + l_reg + ", " + r_reg)
        pilot t3 = next_reg()
        llvm_emit_line("    " + t3 + " = sdiv i64 " + t2 + ", 10")
        llvm_emit_line("    " + res_reg + " = add i64 " + t1 + ", " + t3)
        give back res_reg
    }
    give back res_reg
}

task llvm_emit_add(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, id: word, is_num_op: bool) -> word {
    pilot vtype = llvm_infer_expr_type(id)
    if vtype.starts_with("w") {
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        pilot lw = l_reg
        pilot rw = r_reg
        if not lt.starts_with("w") {
            lw = next_reg()
            llvm_emit_line("    " + lw + " = call i64 @freak_llvm_word_from_int(i64 " + l_reg + ")")
        }
        if not rt.starts_with("w") {
            rw = next_reg()
            llvm_emit_line("    " + rw + " = call i64 @freak_llvm_word_from_int(i64 " + r_reg + ")")
        }
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_concat(i64 " + lw + ", i64 " + rw + ")")
        -- Concatenation copies both operands.  Release only owned temporaries;
        -- identifiers, fields, and array_get remain borrowed from their slot.
        if llvm_word_expr_is_owned_temporary(left) or not lt.starts_with("w") {
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + lw + ", i64 " + res_reg + ")")
        }
        if llvm_word_expr_is_owned_temporary(right) or not rt.starts_with("w") {
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + rw + ", i64 " + res_reg + ")")
        }
        give back res_reg
    }
    if is_num_op {
        pilot ld = llvm_numeric_to_double(l_reg, left)
        pilot rd = llvm_numeric_to_double(r_reg, right)
        pilot dres = next_reg()
        llvm_emit_line("    " + dres + " = fadd double " + ld + ", " + rd)
        llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
        give back res_reg
    }
    llvm_emit_line("    " + res_reg + " = add i64 " + l_reg + ", " + r_reg)
    give back res_reg
}

task llvm_emit_arith(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, is_num_op: bool, int_op: word, float_op: word) -> word {
    if is_num_op {
        pilot ld = llvm_numeric_to_double(l_reg, left)
        pilot rd = llvm_numeric_to_double(r_reg, right)
        pilot dres = next_reg()
        llvm_emit_line("    " + dres + " = " + float_op + " double " + ld + ", " + rd)
        llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
        give back res_reg
    }
    llvm_emit_line("    " + res_reg + " = " + int_op + " i64 " + l_reg + ", " + r_reg)
    give back res_reg
}

task llvm_emit_cmp(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, is_num_op: bool, int_cmp: word, float_cmp: word) -> word {
    pilot ltype = llvm_infer_expr_type(left)
    if ltype.starts_with("w") {
        if int_cmp == "eq" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_eq(i64 " + l_reg + ", i64 " + r_reg + ")")
        } else {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_neq(i64 " + l_reg + ", i64 " + r_reg + ")")
        }
        if llvm_word_expr_is_owned_temporary(left) {
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + l_reg + ", i64 0)")
        }
        if llvm_word_expr_is_owned_temporary(right) {
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + r_reg + ", i64 0)")
        }
        give back res_reg
    }
    give back llvm_emit_icmp(l_reg, r_reg, res_reg, left, right, is_num_op, int_cmp, float_cmp)
}

task llvm_emit_icmp(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, is_num_op: bool, int_cmp: word, float_cmp: word) -> word {
    if is_num_op {
        pilot ld = llvm_numeric_to_double(l_reg, left)
        pilot rd = llvm_numeric_to_double(r_reg, right)
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = fcmp " + float_cmp + " double " + ld + ", " + rd)
        llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
        give back res_reg
    }
    pilot cmp_reg = next_reg()
    llvm_emit_line("    " + cmp_reg + " = icmp " + int_cmp + " i64 " + l_reg + ", " + r_reg)
    llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
    give back res_reg
}

-- ===================== UNARY EMIT ====================================

task llvm_emit_unaryop(val: word, left: word) -> word {
    pilot op_reg = llvm_emit_expr(left)
    pilot operand_type = llvm_infer_expr_type(left)
    if operand_type.starts_with("n") and val == "-" {
        pilot operand_double = llvm_i64_to_double(op_reg)
        pilot result_double = next_reg()
        llvm_emit_line("    " + result_double + " = fsub double 0.0, " + operand_double)
        give back llvm_double_to_i64(result_double)
    }
    pilot res_reg = next_reg()
    if val == "not" {
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + op_reg + ", 0")
        llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
    }
    if val == "-" { llvm_emit_line("    " + res_reg + " = sub i64 0, " + op_reg) }
    if val == "PLUS ULTRA" { llvm_emit_line("    " + res_reg + " = mul i64 " + op_reg + ", 2") }
    if val == "FINAL FORM" { llvm_emit_line("    " + res_reg + " = mul i64 " + op_reg + ", " + op_reg) }
    if val == "TSUNDERE" { llvm_emit_line("    " + res_reg + " = sub i64 0, " + op_reg) }
    give back res_reg
}

-- ===================== METHOD EMIT ===================================

task llvm_emit_method(expr_id: word, val: word, left: word, right: word) -> word {
    pilot obj_reg = llvm_emit_expr(left)
    pilot res_reg = next_reg()
    pilot recv_ty = llvm_infer_expr_type(left)
    pilot best_sname = llvm_shape_name_from_type(recv_ty)
    pilot best_ret = ""
    if best_sname != "" { best_ret = llvm_get_task_ret_type(best_sname + "_" + val) }
    if best_sname != "" and best_ret != "" {
        pilot exact_args = ""
        pilot exact_params = llvm_callable_param_types(best_sname + "_" + val)
        if right.length() > 0 { exact_args = ", " + llvm_emit_args(right, true, exact_params, 1) }
        pilot exact_fname = llvm_user_task_symbol(best_sname + "_" + val)
        if best_ret == "v" {
            llvm_emit_line("    call void " + exact_fname + "(i64 " + obj_reg + exact_args + ")")
            llvm_emit_line("    " + res_reg + " = add i64 0, 0")
        } else {
            llvm_emit_line("    " + res_reg + " = call i64 " + exact_fname + "(i64 " + obj_reg + exact_args + ")")
        }
        give back res_reg
    }
    if val == "length" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_length(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "checksum" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_checksum(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_escape" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_snapshot_escape(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_unescape" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_snapshot_unescape(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_line_count" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_snapshot_line_count(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_field_count" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_snapshot_field_count(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_upper" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_to_upper(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_lower" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_to_lower(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "trim" {
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_trim(i64 " + obj_reg + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "snapshot_line" or val == "snapshot_field_raw" or val == "char_at" or val == "substring" or val == "contains" or val == "starts_with" or val == "ends_with" or val == "replace" {
        pilot args = llvm_emit_borrowed_args(right, "", 0)
        pilot arg_cleanup = llvm_last_borrowed_cleanup
        pilot runtime_name = "@freak_llvm_word_" + val
        llvm_emit_line("    " + res_reg + " = call i64 " + runtime_name + "(i64 " + obj_reg + ", " + args + ")")
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, arg_cleanup, res_reg)
    }
    -- to_int / to_num / to_word — receiver-type-dispatched primitive
    -- conversions.  The receiver's inferred type picks which runtime
    -- helper to call.  Without these, calls like `font_size.to_num()`
    -- in cockpit landed on the unsupported-method branch and returned
    -- 0, which collapsed every layout rect to zero size.
    if val == "to_int" {
        if recv_ty.starts_with("n") {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_num_to_int(i64 " + obj_reg + ")")
        } else {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_to_int(i64 " + obj_reg + ")")
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_num" {
        if recv_ty.starts_with("w") {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_parse_num(i64 " + obj_reg + ")")
        } else {
            -- Default: treat as int → num (covers int and unknown-typed
            -- locals that hold integer values, e.g. shape fields).
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_int_to_num(i64 " + obj_reg + ")")
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    if val == "to_word" {
        if recv_ty.starts_with("n") {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_from_num(i64 " + obj_reg + ")")
        } else if recv_ty.starts_with("b") {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_from_bool(i64 " + obj_reg + ")")
        } else {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_from_int(i64 " + obj_reg + ")")
        }
        give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
    }
    -- User-defined impl methods
    -- Args are stored in `right` as a comma-separated list of expr id words.
    -- Thread them through llvm_emit_args so user methods receive every arg
    -- after `self`, not just `self` alone.
    -- Nominal receiver types select the exact impl. Keep the historical
    -- last-match fallback only for legacy untyped handles.
    if best_sname == "" {
        pilot si = 0
        repeat shape_registry_count times {
            pilot sname: word = "" + array_get(shape_registry_names, si)
            pilot call_ret: word = llvm_get_task_ret_type(sname + "_" + val)
            if call_ret.length() > 0 {
                best_sname = sname
                best_ret = call_ret
            }
            si += 1
        }
    }
    if best_sname.length() > 0 and best_ret.length() > 0 {
        pilot extra_args = ""
        pilot impl_params = llvm_callable_param_types(best_sname + "_" + val)
        if right.length() > 0 { extra_args = ", " + llvm_emit_args(right, true, impl_params, 1) }
        pilot impl_fname = llvm_user_task_symbol(best_sname + "_" + val)
        if best_ret == "v" {
            llvm_emit_line("    call void " + impl_fname + "(i64 " + obj_reg + extra_args + ")")
            llvm_emit_line("    " + res_reg + " = add i64 0, 0")
        } else {
            llvm_emit_line("    " + res_reg + " = call i64 " + impl_fname + "(i64 " + obj_reg + extra_args + ")")
        }
        give back res_reg
    }
    llvm_emit_line("    ; unsupported method " + val)
    llvm_emit_line("    " + res_reg + " = add i64 0, 0")
    give back llvm_finish_borrowed_method(expr_id, left, obj_reg, "", res_reg)
}

-- ===================== FIELD EMIT ====================================

task llvm_emit_field(val: word, left: word) -> word {
    pilot obj_reg = llvm_emit_expr(left)
    pilot fidx = llvm_infer_field_index(left, val)
    if fidx < 0 {
        pilot unresolved = next_reg()
        llvm_emit_line("    ; unresolved field access rejected by semantic checking")
        llvm_emit_line("    " + unresolved + " = add i64 0, 0")
        give back unresolved
    }
    pilot res_reg = next_reg()
    llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_shape_get(i64 " + obj_reg + ", i64 " + word_from_int(fidx) + ")")
    give back res_reg
}

-- ===================== BLOCK EMIT ====================================

task llvm_emit_block(block: word) -> void {
    pilot saved_var_names = llvm_var_names
    pilot saved_var_types = llvm_var_types
    pilot saved_var_map = llvm_var_reg_map
    pilot saved_word_local_slots = llvm_word_local_slots
    pilot i = 0
    pilot slen = block.length()
    pilot cur_id = ""
    repeat slen times {
        pilot c = block.char_at(i)
        if c == "," {
            if cur_id.length() > 0 { llvm_emit_stmt(cur_id) }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id.length() > 0 { llvm_emit_stmt(cur_id) }
    llvm_emit_word_local_cleanup_since(saved_word_local_slots, "")
    llvm_var_names = saved_var_names
    llvm_var_types = saved_var_types
    llvm_var_reg_map = saved_var_map
    llvm_word_local_slots = saved_word_local_slots
}

-- ===================== STATEMENT EMIT ================================

task llvm_is_current_word_param(name: word) -> bool {
    give back llvm_current_word_params.contains("|" + name + "|")
}

task llvm_active_binding_is_word_param(name: word) -> bool {
    if not llvm_is_current_word_param(name) { give back false }
    give back llvm_get_llvm_name(name) == name
}

task llvm_active_binding_is_global(name: word) -> bool {
    give back llvm_get_llvm_name(name) == "" and llvm_is_global(name)
}

task llvm_emit_current_word_param_cleanup(skip_name: word) -> void {
    pilot i = 0
    pilot current = ""
    repeat until i >= llvm_current_word_params.length() {
        pilot ch: word = llvm_current_word_params.char_at(i)
        if ch == "|" {
            if current != "" and current != skip_name {
                pilot pointer = "%" + current
                pilot previous = next_reg()
                llvm_emit_line("    " + previous + " = load i64, i64* " + pointer)
                llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + previous + ", i64 0)")
                llvm_emit_line("    store i64 0, i64* " + pointer)
            }
            current = ""
        } else {
            current = current + ch
        }
        i += 1
    }
}

task llvm_register_word_local_slot(slot_name: word) -> void {
    llvm_word_local_slots = llvm_word_local_slots + slot_name + "|"
}

task llvm_register_owned_word_value(value_reg: word) -> void {
    llvm_word_local_slots = llvm_word_local_slots + "ssa:" + value_reg + "|"
}

task llvm_emit_word_local_cleanup_since(prefix: word, skip_slot: word) -> void {
    pilot i = prefix.length()
    pilot current = ""
    repeat until i >= llvm_word_local_slots.length() {
        pilot ch: word = llvm_word_local_slots.char_at(i)
        if ch == "|" {
            if current != "" and current != skip_slot {
                if current.starts_with("ssa:") {
                    pilot owned_value = current.substring(4, current.length() - 4)
                    llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + owned_value + ", i64 0)")
                } else {
                    pilot pointer = "%" + current
                    pilot previous = next_reg()
                    llvm_emit_line("    " + previous + " = load i64, i64* " + pointer)
                    llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + previous + ", i64 0)")
                    llvm_emit_line("    store i64 0, i64* " + pointer)
                }
            }
            current = ""
        } else {
            current = current + ch
        }
        i += 1
    }
}

task llvm_emit_return_dead_block(prefix: word) -> void {
    pilot dead = prefix + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    llvm_emit_line(dead + ":")
}

task llvm_emit_stmt(eid: word) -> void {
    if eid.length() == 0 { give back }
    pilot i = word_to_int(eid)
    pilot kind: word = array_get(ast_stmt_kinds, i)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    llvm_dbg_set_stmt_line(eid)

    if kind == STMT_PILOT { llvm_emit_stmt_pilot(eid) give back }
    if kind == STMT_SAY {
        pilot reg = llvm_emit_expr(expr_id_w)
        pilot say_type = llvm_infer_expr_type(expr_id_w)
        if say_type.starts_with("w") {
            llvm_emit_line("    call void @freak_llvm_say(i64 " + reg + ")")
            if llvm_word_expr_is_owned_temporary(expr_id_w) {
                llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + reg + ", i64 0)")
            }
        } else {
            pilot say_word = next_reg()
            if say_type.starts_with("n") {
                llvm_emit_line("    " + say_word + " = call i64 @freak_llvm_format_num(i64 " + reg + ")")
            } else if say_type.starts_with("b") {
                llvm_emit_line("    " + say_word + " = call i64 @freak_llvm_word_from_bool(i64 " + reg + ")")
            } else {
                llvm_emit_line("    " + say_word + " = call i64 @freak_llvm_word_from_int(i64 " + reg + ")")
            }
            llvm_emit_line("    call void @freak_llvm_say(i64 " + say_word + ")")
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + say_word + ", i64 0)")
        }
        give back
    }
    if kind == STMT_EXPR {
        pilot discarded_reg = llvm_emit_expr(expr_id_w)
        if llvm_word_expr_is_owned_temporary(expr_id_w) {
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + discarded_reg + ", i64 0)")
        }
        give back
    }
    if kind == STMT_GIVE_BACK {
        if llvm_cur_func_is_void {
            llvm_emit_word_local_cleanup_since("", "")
            llvm_emit_current_word_param_cleanup("")
            llvm_emit_line("    ret void")
            llvm_emit_return_dead_block("return.dead.")
        } else if expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            pilot reg = llvm_emit_expr(expr_id_w)
            if llvm_current_return_semantic_type.starts_with("n") {
                reg = llvm_coerce_num_bits(reg, expr_id_w)
            }
            pilot return_idx = word_to_int(expr_id_w)
            pilot return_kind: word = array_get(ast_expr_kinds, return_idx)
            pilot return_name: word = array_get(ast_expr_vals, return_idx)
            if llvm_cur_func_returns_word and (return_kind == EXPR_FIELD or (return_kind == EXPR_CALL and return_name == "array_get") or (return_kind == EXPR_IDENT and llvm_active_binding_is_global(return_name))) {
                pilot clone_reg = next_reg()
                llvm_emit_line("    " + clone_reg + " = call i64 @freak_llvm_word_clone(i64 " + reg + ")")
                reg = clone_reg
            }
            pilot skip_name = ""
            pilot skip_local_slot = ""
            if llvm_cur_func_returns_word and return_kind == EXPR_IDENT and llvm_active_binding_is_word_param(return_name) { skip_name = return_name }
            if llvm_cur_func_returns_word and return_kind == EXPR_IDENT and not llvm_active_binding_is_word_param(return_name) and not llvm_active_binding_is_global(return_name) {
                skip_local_slot = llvm_get_llvm_name(return_name)
            }
            llvm_emit_word_local_cleanup_since("", skip_local_slot)
            llvm_emit_current_word_param_cleanup(skip_name)
            llvm_emit_line("    ret i64 " + reg)
            llvm_emit_return_dead_block("return.dead.")
        } else {
            llvm_emit_word_local_cleanup_since("", "")
            llvm_emit_current_word_param_cleanup("")
            llvm_emit_line("    ret i64 0")
            llvm_emit_return_dead_block("return.dead.")
        }
        give back
    }
    if kind == STMT_IF { llvm_emit_stmt_if(eid) give back }
    if kind == STMT_REPEAT { llvm_emit_stmt_repeat(eid) give back }
    if kind == STMT_TRAINING_ARC { llvm_emit_stmt_training_arc(eid) give back }
    if kind == STMT_WHEN { llvm_emit_stmt_when(eid) give back }
    if kind == STMT_BLOCK { llvm_emit_block(array_get(ast_stmt_bodies, i)) give back }
    if kind == STMT_ASSIGN { llvm_emit_stmt_assign(eid) give back }
    if kind == STMT_BREAK {
        llvm_emit_word_local_cleanup_since(llvm_loop_word_cleanup_prefix, "")
        llvm_emit_line("    br label %" + llvm_loop_end_label)
        pilot dead = "break.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line(dead + ":")
        give back
    }
    if kind == STMT_CONTINUE {
        llvm_emit_word_local_cleanup_since(llvm_loop_word_cleanup_prefix, "")
        llvm_emit_line("    br label %" + llvm_loop_cond_label)
        pilot dead = "cont.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line(dead + ":")
        give back
    }
    if kind == STMT_SHAPE {
        llvm_emit_line("    ; shape " + name_w + " defined")
        give back
    }
    if kind == STMT_EVENTUALLY {
        llvm_emit_line("    ; eventually block")
        pilot ev_body: word = array_get(ast_stmt_bodies, i)
        if ev_body.length() > 0 { llvm_emit_block(ev_body) }
        give back
    }
}

task llvm_emit_stmt_pilot(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot type_ann: word = array_get(ast_stmt_extras, i)
    pilot vtype = ""
    if type_ann != "" { vtype = llvm_type_code(type_ann) }
    if vtype == "" { vtype = llvm_infer_expr_type(expr_id_w) }
    pilot reg = llvm_emit_expr(expr_id_w)
    pilot stored_reg = reg
    pilot expr_idx = word_to_int(expr_id_w)
    pilot expr_kind: word = array_get(ast_expr_kinds, expr_idx)
    if vtype.starts_with("n") { stored_reg = llvm_coerce_num_bits(reg, expr_id_w) }
    if vtype.starts_with("w") and llvm_word_expr_needs_clone(expr_id_w) {
        pilot clone_reg = next_reg()
        llvm_emit_line("    " + clone_reg + " = call i64 @freak_llvm_word_clone(i64 " + reg + ")")
        stored_reg = clone_reg
    }
    -- Initializers see the outer binding. Delay the new type entry until the
    -- RHS and its ownership decision have been lowered.
    llvm_set_var_type(name_w, vtype)
    if llvm_emitting_global_init {
        llvm_emit_line("    store i64 " + stored_reg + ", i64* @g_" + name_w)
    } else {
        pilot uniq = name_w + "_v" + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_reg_var(name_w, uniq)
        llvm_emit_line("    %" + uniq + " = alloca i64")
        llvm_emit_line("    store i64 " + stored_reg + ", i64* %" + uniq)
        if vtype.starts_with("w") { llvm_register_word_local_slot(uniq) }
    }
}

task llvm_emit_stmt_if(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot cond_reg = llvm_emit_expr(expr_id_w)
    pilot l_then = "if.then." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_else = "if.else." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "if.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot cmp_reg = next_reg()
    llvm_emit_line("    " + cmp_reg + " = icmp ne i64 " + cond_reg + ", 0")

    pilot else_body_w: word = array_get(ast_stmt_else_bodies, i)
    if else_body_w.length() > 0 {
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_then + ", label %" + l_else)
    } else {
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_then + ", label %" + l_end)
    }

    llvm_emit_line(l_then + ":")
    llvm_emit_block(array_get(ast_stmt_bodies, i))
    llvm_emit_line("    br label %" + l_end)

    if else_body_w.length() > 0 {
        llvm_emit_line(l_else + ":")
        llvm_emit_block(else_body_w)
        llvm_emit_line("    br label %" + l_end)
    }
    llvm_emit_line(l_end + ":")
}

task llvm_emit_stmt_repeat(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot save_end = llvm_loop_end_label
    pilot save_cond = llvm_loop_cond_label
    pilot save_cleanup_prefix = llvm_loop_word_cleanup_prefix
    llvm_loop_end_label = l_end
    llvm_loop_word_cleanup_prefix = llvm_word_local_slots

    if name_w == "until" {
        llvm_loop_cond_label = l_cond
        llvm_emit_line("    br label %" + l_cond)
        llvm_emit_line(l_cond + ":")
        pilot cond_reg = llvm_emit_expr(expr_id_w)
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + cond_reg + ", 0")
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_body + ", label %" + l_end)
        llvm_emit_line(l_body + ":")
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        llvm_emit_line("    br label %" + l_cond)
    } else {
        pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot rep_var = "rep." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_loop_cond_label = l_inc

        pilot count_reg = llvm_emit_expr(expr_id_w)
        llvm_emit_line("    %" + rep_var + " = alloca i64")
        llvm_emit_line("    store i64 0, i64* %" + rep_var)
        llvm_emit_line("    br label %" + l_cond)
        llvm_emit_line(l_cond + ":")
        pilot curr_val = next_reg()
        llvm_emit_line("    " + curr_val + " = load i64, i64* %" + rep_var)
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp slt i64 " + curr_val + ", " + count_reg)
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_body + ", label %" + l_end)

        llvm_emit_line(l_body + ":")
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        llvm_emit_line("    br label %" + l_inc)
        llvm_emit_line(l_inc + ":")
        pilot next_val = next_reg()
        llvm_emit_line("    " + next_val + " = load i64, i64* %" + rep_var)
        pilot inc_val = next_reg()
        llvm_emit_line("    " + inc_val + " = add i64 " + next_val + ", 1")
        llvm_emit_line("    store i64 " + inc_val + ", i64* %" + rep_var)
        llvm_emit_line("    br label %" + l_cond)
    }

    llvm_emit_line(l_end + ":")
    llvm_loop_end_label = save_end
    llvm_loop_cond_label = save_cond
    llvm_loop_word_cleanup_prefix = save_cleanup_prefix
}

task llvm_emit_stmt_training_arc(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_until = "loop.until." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rep_var = "rep." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot max_reg = llvm_emit_expr(array_get(ast_stmt_extras, i))
    llvm_emit_line("    %" + rep_var + " = alloca i64")
    llvm_emit_line("    store i64 0, i64* %" + rep_var)
    llvm_emit_line("    br label %" + l_cond)

    llvm_emit_line(l_cond + ":")
    pilot curr_val = next_reg()
    llvm_emit_line("    " + curr_val + " = load i64, i64* %" + rep_var)
    pilot cmp_max = next_reg()
    llvm_emit_line("    " + cmp_max + " = icmp slt i64 " + curr_val + ", " + max_reg)
    llvm_emit_line("    br i1 " + cmp_max + ", label %" + l_until + ", label %" + l_end)

    llvm_emit_line(l_until + ":")
    pilot cond_reg = llvm_emit_expr(expr_id_w)
    pilot cmp_cond = next_reg()
    llvm_emit_line("    " + cmp_cond + " = icmp eq i64 " + cond_reg + ", 0")
    llvm_emit_line("    br i1 " + cmp_cond + ", label %" + l_body + ", label %" + l_end)

    pilot save_end = llvm_loop_end_label
    pilot save_cond = llvm_loop_cond_label
    pilot save_cleanup_prefix = llvm_loop_word_cleanup_prefix
    llvm_loop_end_label = l_end
    llvm_loop_cond_label = l_inc
    llvm_loop_word_cleanup_prefix = llvm_word_local_slots

    llvm_emit_line(l_body + ":")
    llvm_emit_block(array_get(ast_stmt_bodies, i))

    llvm_emit_line("    br label %" + l_inc)
    llvm_emit_line(l_inc + ":")
    pilot next_val = next_reg()
    llvm_emit_line("    " + next_val + " = load i64, i64* %" + rep_var)
    pilot inc_val = next_reg()
    llvm_emit_line("    " + inc_val + " = add i64 " + next_val + ", 1")
    llvm_emit_line("    store i64 " + inc_val + ", i64* %" + rep_var)
    llvm_emit_line("    br label %" + l_cond)

    llvm_emit_line(l_end + ":")
    llvm_loop_end_label = save_end
    llvm_loop_cond_label = save_cond
    llvm_loop_word_cleanup_prefix = save_cleanup_prefix
}

task llvm_emit_stmt_assign(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot rhs_w: word = array_get(ast_stmt_bodies, i)
    pilot lhs_idx = word_to_int(expr_id_w)
    pilot lhs_kind: word = array_get(ast_expr_kinds, lhs_idx)

    -- Field assignment: self.field = rhs  ->  shape_set(self, fidx, rhs)
    -- (Receiver evaluated once and reused for compound ops to avoid
    --  re-running side effects.)
    if lhs_kind == EXPR_FIELD {
        pilot field_name: word = array_get(ast_expr_vals, lhs_idx)
        pilot recv_id: word = array_get(ast_expr_lefts, lhs_idx)
        pilot recv_reg = llvm_emit_expr(recv_id)

        pilot fidx = llvm_infer_field_index(recv_id, field_name)
        if fidx < 0 { give back }

        pilot fidx_w = word_from_int(fidx)
        pilot field_type = llvm_infer_field_type(recv_id, field_name)

        -- Preserve the supported LLVM shape path's linear concat behavior for
        -- a direct self-replacement such as box.value = box.value + suffix.
        -- Both receivers must be the same simple binding so evaluation remains
        -- single-shot and side-effect free.
        if name_w == "=" and field_type.starts_with("w") {
            pilot rhs_idx = word_to_int(rhs_w)
            pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
            if rhs_kind == EXPR_BINOP and array_get(ast_expr_vals, rhs_idx) == "+" {
                pilot append_left: word = array_get(ast_expr_lefts, rhs_idx)
                pilot append_right: word = array_get(ast_expr_rights, rhs_idx)
                pilot append_left_idx = word_to_int(append_left)
                pilot append_left_kind: word = array_get(ast_expr_kinds, append_left_idx)
                if append_left_kind == EXPR_FIELD and array_get(ast_expr_vals, append_left_idx) == field_name {
                    pilot append_recv: word = array_get(ast_expr_lefts, append_left_idx)
                    pilot recv_idx = word_to_int(recv_id)
                    pilot append_recv_idx = word_to_int(append_recv)
                    pilot recv_kind: word = array_get(ast_expr_kinds, recv_idx)
                    pilot append_recv_kind: word = array_get(ast_expr_kinds, append_recv_idx)
                    if recv_kind == EXPR_IDENT and append_recv_kind == EXPR_IDENT {
                        pilot recv_name: word = array_get(ast_expr_vals, recv_idx)
                        pilot append_recv_name: word = array_get(ast_expr_vals, append_recv_idx)
                        if recv_name == append_recv_name {
                            pilot previous_field = next_reg()
                            llvm_emit_line("    " + previous_field + " = call i64 @freak_llvm_shape_get(i64 " + recv_reg + ", i64 " + fidx_w + ")")
                            pilot suffix_reg = llvm_emit_expr(append_right)
                            pilot release_suffix = "0"
                            if llvm_word_expr_is_owned_temporary(append_right) { release_suffix = "1" }
                            pilot appended_field = next_reg()
                            llvm_emit_line("    " + appended_field + " = call i64 @freak_llvm_word_append_owned(i64 " + previous_field + ", i64 " + suffix_reg + ", i64 " + release_suffix + ")")
                            llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + recv_reg + ", i64 " + fidx_w + ", i64 " + appended_field + ")")
                            give back
                        }
                    }
                }
            }
        }

        pilot rhs_reg = llvm_emit_expr(rhs_w)

        if name_w == "=" {
            pilot stored_field = rhs_reg
            if field_type.starts_with("n") { stored_field = llvm_coerce_num_bits(rhs_reg, rhs_w) }
            -- Ownership follows the checked RHS type. Field-name-only lookup
            -- is ambiguous when two shapes reuse a field name with different
            -- types, while a valid assignment's RHS is unambiguous here.
            if field_type.starts_with("w") {
                if llvm_word_expr_needs_clone(rhs_w) {
                    pilot cloned_field = next_reg()
                    llvm_emit_line("    " + cloned_field + " = call i64 @freak_llvm_word_clone(i64 " + rhs_reg + ")")
                    stored_field = cloned_field
                }
                pilot previous_field = next_reg()
                llvm_emit_line("    " + previous_field + " = call i64 @freak_llvm_shape_get(i64 " + recv_reg + ", i64 " + fidx_w + ")")
                llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + previous_field + ", i64 " + stored_field + ")")
            }
            llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + recv_reg + ", i64 " + fidx_w + ", i64 " + stored_field + ")")
            give back
        }

        -- Compound op on field: read, combine, write
        pilot cur_reg = next_reg()
        llvm_emit_line("    " + cur_reg + " = call i64 @freak_llvm_shape_get(i64 " + recv_reg + ", i64 " + fidx_w + ")")
        pilot op_reg = next_reg()
        if field_type.starts_with("n") {
            pilot float_op = "fadd"
            if name_w == "-=" { float_op = "fsub" }
            if name_w == "*=" { float_op = "fmul" }
            if name_w == "/=" { float_op = "fdiv" }
            if name_w == "%=" { float_op = "frem" }
            op_reg = llvm_emit_num_compound_bits(cur_reg, rhs_reg, rhs_w, float_op)
        } else {
            if name_w == "+=" { llvm_emit_line("    " + op_reg + " = add i64 " + cur_reg + ", " + rhs_reg) }
            if name_w == "-=" { llvm_emit_line("    " + op_reg + " = sub i64 " + cur_reg + ", " + rhs_reg) }
            if name_w == "*=" { llvm_emit_line("    " + op_reg + " = mul i64 " + cur_reg + ", " + rhs_reg) }
            if name_w == "/=" { llvm_emit_line("    " + op_reg + " = sdiv i64 " + cur_reg + ", " + rhs_reg) }
            if name_w == "%=" { llvm_emit_line("    " + op_reg + " = srem i64 " + cur_reg + ", " + rhs_reg) }
        }
        llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + recv_reg + ", i64 " + fidx_w + ", i64 " + op_reg + ")")
        give back
    }

    -- Plain variable / global assignment
    pilot var_name_expr: word = array_get(ast_expr_vals, lhs_idx)
    pilot var_ptr = llvm_var_ptr(var_name_expr)
    pilot target_type = llvm_get_var_type(var_name_expr)
    if name_w == "=" and target_type.starts_with("w") {
        pilot rhs_idx = word_to_int(rhs_w)
        pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
        if rhs_kind == EXPR_BINOP and array_get(ast_expr_vals, rhs_idx) == "+" {
            pilot append_left: word = array_get(ast_expr_lefts, rhs_idx)
            pilot append_right: word = array_get(ast_expr_rights, rhs_idx)
            pilot append_left_idx = word_to_int(append_left)
            pilot append_left_kind: word = array_get(ast_expr_kinds, append_left_idx)
            pilot append_left_name: word = array_get(ast_expr_vals, append_left_idx)
            pilot append_right_idx = word_to_int(append_right)
            pilot append_right_kind: word = array_get(ast_expr_kinds, append_right_idx)
            pilot safe_global_suffix = append_right_kind == EXPR_STR or append_right_kind == EXPR_IDENT
            pilot can_append = append_left_kind == EXPR_IDENT and append_left_name == var_name_expr
            if llvm_is_global(var_name_expr) and not safe_global_suffix { can_append = false }
            if can_append {
                pilot previous_reg = next_reg()
                llvm_emit_line("    " + previous_reg + " = load i64, i64* " + var_ptr)
                pilot suffix_reg = llvm_emit_expr(append_right)
                pilot release_suffix = "0"
                if llvm_word_expr_is_owned_temporary(append_right) { release_suffix = "1" }
                pilot appended_reg = next_reg()
                llvm_emit_line("    " + appended_reg + " = call i64 @freak_llvm_word_append_owned(i64 " + previous_reg + ", i64 " + suffix_reg + ", i64 " + release_suffix + ")")
                llvm_emit_line("    store i64 " + appended_reg + ", i64* " + var_ptr)
                give back
            }
        }
    }
    pilot reg = llvm_emit_expr(rhs_w)
    pilot stored_reg = reg
    if name_w == "=" {
        if target_type.starts_with("n") { stored_reg = llvm_coerce_num_bits(reg, rhs_w) }
        if target_type.starts_with("w") {
            pilot rhs_idx = word_to_int(rhs_w)
            pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
            if llvm_word_expr_needs_clone(rhs_w) {
                pilot clone_reg = next_reg()
                llvm_emit_line("    " + clone_reg + " = call i64 @freak_llvm_word_clone(i64 " + reg + ")")
                stored_reg = clone_reg
            }
            pilot previous_reg = next_reg()
            llvm_emit_line("    " + previous_reg + " = load i64, i64* " + var_ptr)
            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + previous_reg + ", i64 " + stored_reg + ")")
        }
        llvm_emit_line("    store i64 " + stored_reg + ", i64* " + var_ptr)
        give back
    }
    pilot load_reg = next_reg()
    llvm_emit_line("    " + load_reg + " = load i64, i64* " + var_ptr)
    pilot op_reg = next_reg()
    if target_type.starts_with("n") {
        pilot float_op = "fadd"
        if name_w == "-=" { float_op = "fsub" }
        if name_w == "*=" { float_op = "fmul" }
        if name_w == "/=" { float_op = "fdiv" }
        if name_w == "%=" { float_op = "frem" }
        op_reg = llvm_emit_num_compound_bits(load_reg, reg, rhs_w, float_op)
    } else {
        if name_w == "+=" { llvm_emit_line("    " + op_reg + " = add i64 " + load_reg + ", " + reg) }
        if name_w == "-=" { llvm_emit_line("    " + op_reg + " = sub i64 " + load_reg + ", " + reg) }
        if name_w == "*=" { llvm_emit_line("    " + op_reg + " = mul i64 " + load_reg + ", " + reg) }
        if name_w == "/=" { llvm_emit_line("    " + op_reg + " = sdiv i64 " + load_reg + ", " + reg) }
        if name_w == "%=" { llvm_emit_line("    " + op_reg + " = srem i64 " + load_reg + ", " + reg) }
    }
    llvm_emit_line("    store i64 " + op_reg + ", i64* " + var_ptr)
}

task llvm_emit_stmt_when(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot target_reg = llvm_emit_expr(expr_id_w)
    pilot target_type = llvm_infer_expr_type(expr_id_w)
    pilot cases_str: word = array_get(ast_stmt_bodies, i)
    pilot saved_when_word_slots = llvm_word_local_slots
    if target_type.starts_with("w") and llvm_word_expr_is_owned_temporary(expr_id_w) {
        -- The SSA target dominates every case/exit path. Tracking the value
        -- directly avoids a loop-local alloca that grows the stack per
        -- iteration while preserving the existing exact-once cleanup paths.
        llvm_register_owned_word_value(target_reg)
    }

    pilot l_end = "when.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot current_block = "when.case." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    llvm_emit_line("    br label %" + current_block)

    pilot cases_len = cases_str.length()
    pilot ci = 0
    pilot cur_case = ""
    pilot case_fin = false

    repeat until case_fin {
        pilot cc = cases_str.char_at(ci)
        if cc == "," or ci >= cases_len {
            if cur_case.length() > 0 {
                llvm_emit_line(current_block + ":")
                pilot c_expr = ""
                pilot c_stmt = ""
                pilot in_expr = true
                pilot c_len = cur_case.length()
                pilot cj = 0
                repeat c_len times {
                    pilot p = cur_case.char_at(cj)
                    if p == ":" { in_expr = false }
                    else {
                        if in_expr { c_expr = c_expr + p }
                        else { c_stmt = c_stmt + p }
                    }
                    cj += 1
                }
                pilot next_block = "when.case." + word_from_int(temp_reg_counter)
                temp_reg_counter += 1
                pilot do_block = "when.do." + word_from_int(temp_reg_counter)
                temp_reg_counter += 1

                if c_expr == "-1" {
                    llvm_emit_line("    br label %" + do_block)
                } else {
                    pilot cmp_val = llvm_emit_expr(c_expr)
                    pilot cmp_res = next_reg()
                    if target_type.starts_with("w") {
                        pilot word_cmp = next_reg()
                        llvm_emit_line("    " + word_cmp + " = call i64 @freak_llvm_word_eq(i64 " + target_reg + ", i64 " + cmp_val + ")")
                        if llvm_word_expr_is_owned_temporary(c_expr) {
                            llvm_emit_line("    call void @freak_llvm_word_release_replaced(i64 " + cmp_val + ", i64 0)")
                        }
                        llvm_emit_line("    " + cmp_res + " = icmp ne i64 " + word_cmp + ", 0")
                    } else if target_type.starts_with("n") or llvm_infer_expr_type(c_expr).starts_with("n") {
                        pilot target_double = llvm_numeric_to_double(target_reg, expr_id_w)
                        pilot case_double = llvm_numeric_to_double(cmp_val, c_expr)
                        llvm_emit_line("    " + cmp_res + " = fcmp oeq double " + target_double + ", " + case_double)
                    } else {
                        llvm_emit_line("    " + cmp_res + " = icmp eq i64 " + target_reg + ", " + cmp_val)
                    }
                    llvm_emit_line("    br i1 " + cmp_res + ", label %" + do_block + ", label %" + next_block)
                }
                llvm_emit_line(do_block + ":")
                pilot saved_case_names = llvm_var_names
                pilot saved_case_types = llvm_var_types
                pilot saved_case_map = llvm_var_reg_map
                pilot saved_case_word_slots = llvm_word_local_slots
                llvm_emit_stmt(c_stmt)
                llvm_emit_word_local_cleanup_since(saved_case_word_slots, "")
                llvm_var_names = saved_case_names
                llvm_var_types = saved_case_types
                llvm_var_reg_map = saved_case_map
                llvm_word_local_slots = saved_case_word_slots
                llvm_emit_line("    br label %" + l_end)
                current_block = next_block
            }
            cur_case = ""
            if ci >= cases_len { case_fin = true }
        } else { cur_case = cur_case + cc }
        ci += 1
    }
    llvm_emit_line(current_block + ":")
    llvm_emit_line("    br label %" + l_end)
    llvm_emit_line(l_end + ":")
    llvm_emit_word_local_cleanup_since(saved_when_word_slots, "")
    llvm_word_local_slots = saved_when_word_slots
}

-- ===================== TASK + PARAMS =================================

task llvm_translate_params(p: word) -> word {
    pilot res = ""
    pilot cur_name = ""
    pilot in_type = false
    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" { in_type = true }
        else if c == "," {
            if res.length() > 0 { res = res + ", " }
            res = res + "i64 %arg_" + cur_name
            cur_name = ""
            in_type = false
        } else {
            if not in_type { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name.length() > 0 {
        if res.length() > 0 { res = res + ", " }
        res = res + "i64 %arg_" + cur_name
    }
    give back res
}

task llvm_allocate_params(p: word) -> void {
    pilot cur_name = ""
    pilot cur_type = ""
    pilot in_type = false
    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" { in_type = true }
        else if c == "," {
            llvm_emit_line("    %" + cur_name + " = alloca i64")
            pilot pt = llvm_type_code(cur_type)
            if pt == "w" {
                llvm_current_word_params = llvm_current_word_params + "|" + cur_name + "|"
            }
            llvm_emit_line("    store i64 %arg_" + cur_name + ", i64* %" + cur_name)
            llvm_set_var_type(cur_name, pt)
            -- Register the param in the llvm-name map so later references
            -- to `cur_name` resolve to `%cur_name` rather than falling
            -- through to the unknown-name path.
            llvm_reg_var(cur_name, cur_name)
            cur_name = ""
            cur_type = ""
            in_type = false
        } else {
            if in_type { cur_type = cur_type + c }
            else { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name.length() > 0 {
        llvm_emit_line("    %" + cur_name + " = alloca i64")
        pilot pt = llvm_type_code(cur_type)
        if pt == "w" {
            llvm_current_word_params = llvm_current_word_params + "|" + cur_name + "|"
        }
        llvm_emit_line("    store i64 %arg_" + cur_name + ", i64* %" + cur_name)
        llvm_set_var_type(cur_name, pt)
        llvm_reg_var(cur_name, cur_name)
    }
}

task llvm_emit_task(eid: word) -> void {
    llvm_var_names = ""
    llvm_var_types = ""
    llvm_var_reg_map = ""
    llvm_word_local_slots = ""
    llvm_loop_word_cleanup_prefix = ""
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot body_id_w: word = array_get(ast_stmt_bodies, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    llvm_current_word_params = ""
    pilot line_no = word_to_int(array_get(ast_stmt_lines, i))

    pilot ret_type = "i64"
    pilot is_void = false
    if returns_w == "void" or returns_w == "" { ret_type = "void" is_void = true }
    llvm_cur_func_is_void = is_void
    llvm_cur_func_returns_word = returns_w == "word"
    llvm_current_return_semantic_type = llvm_type_code(returns_w)

    pilot p_str = ""
    if params_w.length() > 0 { p_str = llvm_translate_params(params_w) }
    pilot dbg_attr = llvm_dbg_begin_func(name_w, line_no)
    llvm_emit_line("define " + ret_type + " " + llvm_user_task_symbol(name_w) + "(" + p_str + ")" + dbg_attr + " {")
    llvm_emit_line("entry:")
    if params_w.length() > 0 { llvm_allocate_params(params_w) }
    llvm_emit_block(body_id_w)
    llvm_emit_current_word_param_cleanup("")
    if is_void { llvm_emit_line("    ret void") }
    else { llvm_emit_line("    ret i64 0") }
    llvm_emit_line("}")
    llvm_emit_line("")
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0
}

