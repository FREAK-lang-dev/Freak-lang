-- ===================================================================
-- FREAK v3 COMPILER — C BACKEND EMITTER
-- ===================================================================
-- Streaming emit via fs::append. Flat if chains. No nesting limits.

task c_safe_ident(s: word) -> word {
    pilot res = ""
    pilot slen = s.length()
    pilot i = 0
    repeat slen times {
        pilot c = s.char_at(i)
        if c == ":" {
            if i + 1 < slen {
                if s.char_at(i + 1) == ":" {
                    res = res + "_"
                    i += 1
                } else {
                    res = res + c
                }
            } else {
                res = res + c
            }
        } else {
            res = res + c
        }
        i += 1
    }
    give back res
}

task emt_word_expr_needs_clone(expr_id: word) -> bool {
    pilot idx = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, idx)
    if kind == EXPR_IDENT or kind == EXPR_FIELD { give back emt_expr_type_code(expr_id) == "w" }
    if kind == EXPR_CALL and array_get(ast_expr_vals, idx) == "array_get" { give back true }
    give back false
}

task emt_word_expr_is_owned_temporary(expr_id: word) -> bool {
    if emt_expr_type_code(expr_id) != "w" { give back false }
    give back not emt_word_expr_needs_clone(expr_id)
}

task emit_args(args: word, clone_borrowed_words: bool) -> void {
    pilot i = 0
    pilot slen = args.length()
    pilot cur_id = ""
    pilot first = true
    repeat slen times {
        pilot c = args.char_at(i)
        if c == "," {
            if not first { emit(", ") }
            pilot clone_arg = clone_borrowed_words and emt_word_expr_needs_clone(cur_id)
            if clone_arg { emit("freak_word_clone(") }
            emit_expr(cur_id)
            if clone_arg { emit(")") }
            cur_id = ""
            first = false
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id != "" {
        if not first { emit(", ") }
        pilot clone_arg = clone_borrowed_words and emt_word_expr_needs_clone(cur_id)
        if clone_arg { emit("freak_word_clone(") }
        emit_expr(cur_id)
        if clone_arg { emit(")") }
    }
}

task emt_args_have_owned_word_temporary(args: word) -> bool {
    pilot i = 0
    pilot cur_id = ""
    repeat args.length() times {
        pilot c = args.char_at(i)
        if c == "," {
            if cur_id != "" and emt_word_expr_is_owned_temporary(cur_id) { give back true }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id != "" and emt_word_expr_is_owned_temporary(cur_id) { give back true }
    give back false
}

task emt_expr_c_type(expr_id: word) -> word {
    pilot code = emt_expr_type_code(expr_id)
    if code == "w" { give back "freak_word" }
    if code == "b" { give back "bool" }
    if code == "d" { give back "double" }
    give back "int64_t"
}

task emit_c_borrowed_arg_decls(args: word, owner_id: word) -> void {
    pilot i = 0
    pilot arg_index = 0
    pilot cur_id = ""
    repeat args.length() times {
        pilot c = args.char_at(i)
        if c == "," {
            if cur_id != "" {
                emit(emt_expr_c_type(cur_id) + " __freak_borrow_arg_" + owner_id + "_" + word_from_int(arg_index) + " = ")
                emit_expr(cur_id)
                emit_line(";")
                arg_index += 1
            }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id != "" {
        emit(emt_expr_c_type(cur_id) + " __freak_borrow_arg_" + owner_id + "_" + word_from_int(arg_index) + " = ")
        emit_expr(cur_id)
        emit_line(";")
    }
}

task emit_c_borrowed_arg_names(args: word, owner_id: word) -> void {
    pilot i = 0
    pilot arg_index = 0
    pilot cur_id = ""
    pilot first = true
    repeat args.length() times {
        pilot c = args.char_at(i)
        if c == "," {
            if cur_id != "" {
                if not first { emit(", ") }
                emit("__freak_borrow_arg_" + owner_id + "_" + word_from_int(arg_index))
                arg_index += 1
                first = false
            }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id != "" {
        if not first { emit(", ") }
        emit("__freak_borrow_arg_" + owner_id + "_" + word_from_int(arg_index))
    }
}

task emit_c_borrowed_arg_cleanup(args: word, owner_id: word, word_result_name: word) -> void {
    pilot i = 0
    pilot arg_index = 0
    pilot cur_id = ""
    repeat args.length() times {
        pilot c = args.char_at(i)
        if c == "," {
            if cur_id != "" {
                if emt_word_expr_is_owned_temporary(cur_id) {
                    pilot arg_name = "__freak_borrow_arg_" + owner_id + "_" + word_from_int(arg_index)
                    if word_result_name != "" {
                        emit_line("if (" + arg_name + ".data != " + word_result_name + ".data) { freak_word_release_owned(&" + arg_name + "); }")
                    } else { emit_line("freak_word_release_owned(&" + arg_name + ");") }
                }
                arg_index += 1
            }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id != "" and emt_word_expr_is_owned_temporary(cur_id) {
        pilot arg_name = "__freak_borrow_arg_" + owner_id + "_" + word_from_int(arg_index)
        if word_result_name != "" {
            emit_line("if (" + arg_name + ".data != " + word_result_name + ".data) { freak_word_release_owned(&" + arg_name + "); }")
        } else { emit_line("freak_word_release_owned(&" + arg_name + ");") }
    }
}

task emit_c_borrowing_call(expr_id: word, func_name: word, args: word) -> void {
    emit("({ ")
    emit_c_borrowed_arg_decls(args, expr_id)
    pilot semantic_type = tc_expr_type(word_to_int(expr_id))
    pilot is_void = semantic_type == "void"
    pilot result_name = "__freak_borrow_result_" + expr_id
    if not is_void { emit(emt_expr_c_type(expr_id) + " " + result_name + " = ") }
    emit(func_name + "(")
    emit_c_borrowed_arg_names(args, expr_id)
    emit_line(");")
    pilot word_result_name = ""
    if not is_void and emt_expr_type_code(expr_id) == "w" { word_result_name = result_name }
    emit_c_borrowed_arg_cleanup(args, expr_id, word_result_name)
    if is_void { emit("((void)0); })") }
    else { emit(result_name + "; })") }
}

-- ===================== CALL MAPPING (FLAT) ============================
-- v3 KEY CHANGE: flat if + early return. Never truncated.

task c_map_call(val: word) -> word {
    if val == "ByteBuffer::new" { give back "freak_byte_buffer_new" }
    if val == "ByteBuffer::with_capacity" { give back "freak_byte_buffer_with_capacity" }
    if val == "say" { give back "freak_say" }
    if val == "ask" { give back "freak_ask" }
    if val == "word_from_int" { give back "freak_word_from_int" }
    if val == "word_from_bool" { give back "freak_word_from_bool" }
    if val == "word_to_int" { give back "freak_word_to_int" }
    if val == "word_concat" { give back "freak_word_concat" }
    if val == "char_to_word" { give back "freak_char_to_word" }
    if val == "array_new" { give back "freak_array_new" }
    if val == "array_push" { give back "freak_array_push_owned" }
    if val == "array_get" { give back "freak_array_get" }
    if val == "array_set" { give back "freak_array_set_owned" }
    if val == "array_len" { give back "freak_array_len" }
    if val == "array_release" { give back "freak_array_release_owned" }
    if val == "word_join" { give back "freak_word_join_owned" }
    if val == "word_builder::new" { give back "freak_word_builder_new" }
    if val == "word_builder::with_capacity" { give back "freak_word_builder_with_capacity" }
    if val == "word_builder::reserve" { give back "freak_word_builder_reserve" }
    if val == "word_builder::capacity" { give back "freak_word_builder_capacity" }
    if val == "word_builder::length" { give back "freak_word_builder_length" }
    if val == "word_builder::clear" { give back "freak_word_builder_clear" }
    if val == "word_builder::append" { give back "freak_word_builder_append" }
    if val == "word_builder::append_char" { give back "freak_word_builder_append_char" }
    if val == "word_builder::append_int" { give back "freak_word_builder_append_int" }
    if val == "word_builder::finish" { give back "freak_word_builder_finish" }
    if val == "word_builder::discard" { give back "freak_word_builder_discard" }
    if val == "process::exit" { give back "freak_process_exit" }
    if val == "process::exec" { give back "freak_process_exec" }
    if val == "process::exec_capture" { give back "freak_process_exec_capture" }
    if val == "process::env" { give back "freak_process_env" }
    if val == "process::arg" { give back "freak_process_arg" }
    if val == "process::args_count" { give back "freak_process_args_count" }
    if val == "time::now_ms" { give back "freak_time_now_ms" }
    if val == "panic" { give back "freak_panic" }
    if val == "fs::read" { give back "freak_fs_read" }
    if val == "fs::write" { give back "freak_fs_write" }
    if val == "fs::append" { give back "freak_fs_append" }
    if val == "fs::exists" { give back "freak_fs_exists" }
    if val == "fs::delete" { give back "freak_fs_delete" }
    if val == "fs::list_dir" { give back "freak_fs_list_dir" }
    if val == "fs::make_dir" { give back "freak_fs_make_dir" }
    if val == "process::input" { give back "freak_process_input" }
    if val == "math::sqrt" { give back "freak_math_sqrt" }
    if val == "math::pow" { give back "freak_math_pow" }
    if val == "math::sin" { give back "freak_math_sin" }
    if val == "math::cos" { give back "freak_math_cos" }
    if val == "math::tan" { give back "freak_math_tan" }
    if val == "math::floor" { give back "freak_math_floor" }
    if val == "math::ceil" { give back "freak_math_ceil" }
    if val == "parse_num" { give back "freak_parse_num" }
    if val == "format_num" { give back "freak_format_num" }
    if val == "ui::create_window" { give back "freak_ui_create_window_word" }
    if val == "ui::destroy_window" { give back "freak_ui_destroy_window" }
    if val == "ui::begin_frame" { give back "freak_ui_begin_frame" }
    if val == "ui::end_frame" { give back "freak_ui_end_frame" }
    if val == "ui::poll_events" { give back "freak_ui_poll_events" }
    if val == "ui::clear" { give back "freak_ui_clear" }
    if val == "ui::event_kind" { give back "freak_ui_event_kind" }
    if val == "ui::event_key" { give back "freak_ui_event_key" }
    if val == "ui::event_pressed" { give back "freak_ui_event_pressed" }
    if val == "ui::event_character" { give back "freak_ui_event_character" }
    if val == "ui::event_mouse_x" { give back "freak_ui_event_mouse_x" }
    if val == "ui::event_mouse_y" { give back "freak_ui_event_mouse_y" }
    if val == "ui::event_button" { give back "freak_ui_event_button" }
    if val == "ui::event_repeat" { give back "freak_ui_event_repeat" }
    if val == "ui::event_scroll_dy" { give back "freak_ui_event_scroll_dy" }
    if val == "ui::event_width" { give back "freak_ui_event_width" }
    if val == "ui::event_height" { give back "freak_ui_event_height" }
    if val == "ui::event_gained" { give back "freak_ui_event_gained" }
    if val == "ui::get_width" { give back "freak_ui_get_width" }
    if val == "ui::get_height" { give back "freak_ui_get_height" }
    if val == "ui::fill_rect" { give back "freak_ui_fill_rect" }
    if val == "ui::stroke_rect" { give back "freak_ui_stroke_rect" }
    if val == "ui::fill_circle" { give back "freak_ui_fill_circle" }
    if val == "ui::draw_line" { give back "freak_ui_draw_line" }
    if val == "ui::draw_text" { give back "freak_ui_draw_text_word" }
    if val == "ui::measure_text" { give back "freak_ui_measure_text_word" }
    if val == "tcp::connect" { give back "freak_tcp_connect" }
    if val == "tcp::send" { give back "freak_tcp_send" }
    if val == "tcp::recv" { give back "freak_tcp_recv" }
    if val == "tcp::recv_all" { give back "freak_tcp_recv_all" }
    if val == "tcp::close" { give back "freak_tcp_close" }
    if val == "tcp_connect" { give back "freak_tcp_connect" }
    if val == "tcp_send" { give back "freak_tcp_send" }
    if val == "tcp_recv" { give back "freak_tcp_recv" }
    if val == "tcp_recv_all" { give back "freak_tcp_recv_all" }
    if val == "tcp_close" { give back "freak_tcp_close" }
    give back ""
}

-- ===================== EXPRESSION EMIT ================================

task emit_expr(id: word) -> void {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)
    pilot left: word = array_get(ast_expr_lefts, i)
    pilot right: word = array_get(ast_expr_rights, i)

    if kind == EXPR_INT { emit(val) give back }
    if kind == EXPR_FLOAT { emit(val) give back }
    if kind == EXPR_BOOL {
        if val == "true" or val == "yes" or val == "hai" { emit("true") }
        else { emit("false") }
        give back
    }
    if kind == EXPR_IDENT {
        emit(emt_get_var_c_name(val))
        give back
    }

    if kind == EXPR_STR {
        emit_c_string(val)
        give back
    }

    if kind == EXPR_INTERP {
        emit_c_interp(id, left)
        give back
    }

    if kind == EXPR_CALL {
        emit_c_call(id, val, left)
        give back
    }

    if kind == EXPR_METHOD {
        emit_c_method(id, val, left, right)
        give back
    }

    if kind == EXPR_FIELD {
        emit_c_field(val, left)
        give back
    }

    if kind == EXPR_INDEX {
        if emt_expr_type_code(left) == "w" {
            pilot index_args = left + "," + right
            if emt_args_have_owned_word_temporary(index_args) {
                emit_c_borrowing_call(id, "freak_word_char_at", index_args)
            } else {
                emit("freak_word_char_at(")
                emit_expr(left)
                emit(", ")
                emit_expr(right)
                emit(")")
            }
        } else {
            emit_expr(left)
            emit(".data[")
            emit_expr(right)
            emit("]")
        }
        give back
    }

    if kind == EXPR_ARRAY_LIT {
        -- `[a, b, c]` lowers to a clang/gcc statement-expression:
        --   ({ int64_t arr = freak_array_new();
        --      freak_array_push_owned(arr, a);
        --      freak_array_push_owned(arr, b);
        --      arr; })
        -- Element ids live in `left`, comma-separated.
        pilot array_tmp = "__freak_array_" + id
        emit("({ int64_t " + array_tmp + " = freak_array_new(); ")
        pilot ali = 0
        pilot alen2 = left.length()
        pilot cur_eid_c = ""
        repeat alen2 times {
            pilot acc = left.char_at(ali)
            if acc == "," {
                if cur_eid_c.length() > 0 {
                    emit("freak_array_push_owned(" + array_tmp + ", ")
                    pilot clone_element = emt_word_expr_needs_clone(cur_eid_c)
                    if clone_element { emit("freak_word_clone(") }
                    emit_expr(cur_eid_c)
                    if clone_element { emit(")") }
                    emit("); ")
                    cur_eid_c = ""
                }
            } else {
                cur_eid_c = cur_eid_c + acc
            }
            ali += 1
        }
        if cur_eid_c.length() > 0 {
            emit("freak_array_push_owned(" + array_tmp + ", ")
            pilot clone_element = emt_word_expr_needs_clone(cur_eid_c)
            if clone_element { emit("freak_word_clone(") }
            emit_expr(cur_eid_c)
            if clone_element { emit(")") }
            emit("); ")
        }
        emit(array_tmp + "; })")
        give back
    }

    if kind == EXPR_BINOP {
        emit_c_binop(id, val, left, right)
        give back
    }

    if kind == EXPR_UNARYOP {
        emit_c_unaryop(val, left)
        give back
    }

    emit("/* Unknown Expr */")
}

-- v3: Split emit helpers to keep functions short

task emit_c_string(val: word) -> void {
    pilot tmp = "freak_word_lit(\""
    pilot str_val = val
    pilot si = 0
    pilot sslen = str_val.length()
    repeat until si >= sslen {
        pilot sc = str_val.char_at(si)
        if sc == "\\" and si + 3 < sslen {
            pilot snx = str_val.char_at(si + 1)
            if snx == "x" {
                -- Adjacent C string literals terminate C's greedy \x escape.
                tmp = tmp + "\\x" + str_val.char_at(si + 2) + str_val.char_at(si + 3) + "\"\""
                si += 4
            } else {
                tmp = tmp + "\\\\"
                si += 1
            }
        } else if sc == "\n" { tmp = tmp + "\\n" si += 1 }
        else if sc == "\r" { tmp = tmp + "\\r" si += 1 }
        else if sc == "\t" { tmp = tmp + "\\t" si += 1 }
        else if sc == "\\" { tmp = tmp + "\\\\" si += 1 }
        else if sc == "\"" { tmp = tmp + "\\\"" si += 1 }
        else { tmp = tmp + sc si += 1 }
    }
    emit(tmp + "\")")
}

task emit_c_interp(expr_id: word, segments: word) -> void {
    pilot interp_tmp = "__freak_interp_" + expr_id
    emit("({ freak_word " + interp_tmp + " = freak_word_lit(\"\"); ")
    pilot segment_count = tc_arg_count(segments)
    pilot segment_index = 0
    repeat segment_count times {
        pilot segment_id = word_from_int(tc_arg_at(segments, segment_index))
        pilot segment_type = emt_expr_type_code(segment_id)
        emit("freak_word_append_owned(&" + interp_tmp + ", ")
        if segment_type == "w" {
            emit_expr(segment_id)
        } else {
            if segment_type == "d" { emit("freak_format_num(") }
            else if segment_type == "b" { emit("freak_word_from_bool(") }
            else { emit("freak_word_from_int(") }
            emit_expr(segment_id)
            emit(")")
        }
        if segment_type == "w" { emit(", false); ") }
        else { emit(", true); ") }
        segment_index += 1
    }
    emit(interp_tmp + "; })")
}

task emit_c_call(expr_id: word, val: word, left: word) -> void {
    -- Shape constructor
    if val.starts_with("shape::ctor::") {
        pilot sname = val.replace("shape::ctor::", "")
        pilot field_count = get_shape_field_count(sname)
        emit("freak_shape_alloc(" + word_from_int(field_count) + ", ")
        if left != "" { emit_args(left, true) }
        emit(")")
        give back
    }

    -- Known builtin mapping
    pilot mapped = c_map_call(val)
    if mapped != "" {
        pilot aggregate_call = val == "array_push" or val == "array_set"
        if not aggregate_call and left != "" and emt_args_have_owned_word_temporary(left) {
            emit_c_borrowing_call(expr_id, mapped, left)
            give back
        }
        emit(mapped + "(")
        if left != "" { emit_args(left, aggregate_call) }
        emit(")")
        give back
    }

    -- Extern function (no freak_ prefix)
    if emt_is_extern(val) {
        if left != "" and emt_args_have_owned_word_temporary(left) {
            emit_c_borrowing_call(expr_id, c_safe_ident(val), left)
            give back
        }
        emit(c_safe_ident(val) + "(")
        if left != "" { emit_args(left, false) }
        emit(")")
        give back
    }

    -- User-defined function
    emit(c_user_task_symbol(val) + "(")
    if left != "" { emit_args(left, true) }
    emit(")")
}

task emt_raw_type_code(type_name: word) -> word {
    if type_name == "word" { give back "w" }
    if type_name == "num" or type_name == "float" { give back "d" }
    if type_name == "bool" { give back "b" }
    if type_name == "void" { give back "v" }
    give back "i"
}

task emt_expr_type_code(id: word) -> word {
    pilot inferred_type = tc_expr_type(word_to_int(id))
    if inferred_type != "" { give back emt_raw_type_code(inferred_type) }
    if is_ast_word(id) { give back "w" }
    give back "i"
}

task emit_c_method(expr_id: word, val: word, left: word, right: word) -> void {
    pilot receiver_semantic_type = tc_expr_type(word_to_int(left))
    if is_shape_name(receiver_semantic_type) and tc_has_impl_method(receiver_semantic_type, val) {
        emit(c_user_task_symbol(receiver_semantic_type + "_" + val) + "(")
        emit_expr(left)
        if right != "" {
            emit(", ")
            emit_args(right, true)
        }
        emit(")")
        give back
    }
    pilot receiver_type = emt_expr_type_code(left)
    pilot method_args = left
    if right != "" { method_args = method_args + "," + right }
    if receiver_semantic_type == "ByteBuffer" {
        if emt_args_have_owned_word_temporary(method_args) {
            emit_c_borrowing_call(expr_id, "freak_byte_buffer_" + val, method_args)
            give back
        }
        emit("freak_byte_buffer_" + val + "(")
        emit_expr(left)
        if right != "" {
            emit(", ")
            emit_args(right, false)
        }
        emit(")")
        give back
    }
    if val == "length" {
        if emt_args_have_owned_word_temporary(method_args) {
            emit_c_borrowing_call(expr_id, "freak_word_length", method_args)
            give back
        }
        emit("freak_word_length(")
        emit_expr(left)
        emit(")")
        give back
    }
    if val == "to_int" {
        if receiver_type == "d" {
            emit("((int64_t)(")
            emit_expr(left)
            emit("))")
        } else {
            if emt_args_have_owned_word_temporary(method_args) {
                emit_c_borrowing_call(expr_id, "freak_word_to_int", method_args)
                give back
            }
            emit("freak_word_to_int(")
            emit_expr(left)
            emit(")")
        }
        give back
    }
    if val == "to_num" {
        if receiver_type == "w" and emt_args_have_owned_word_temporary(method_args) {
            emit_c_borrowing_call(expr_id, "freak_word_to_num", method_args)
            give back
        }
        if receiver_type == "w" { emit("freak_word_to_num(") }
        else { emit("((double)(") }
        emit_expr(left)
        if receiver_type == "w" { emit(")") }
        else { emit("))") }
        give back
    }
    if val == "to_word" {
        if receiver_type == "d" { emit("freak_format_num(") }
        else if receiver_type == "b" { emit("freak_word_from_bool(") }
        else { emit("freak_word_from_int(") }
        emit_expr(left)
        emit(")")
        give back
    }
    -- Generic word method: freak_word_METHOD(obj, args...)
    if emt_args_have_owned_word_temporary(method_args) {
        emit_c_borrowing_call(expr_id, "freak_word_" + val, method_args)
        give back
    }
    emit("freak_word_" + val + "(")
    emit_expr(left)
    if right != "" {
        emit(", ")
        emit_args(right, false)
    }
    emit(")")
}

task emit_c_field(val: word, left: word) -> void {
    pilot fidx = 0 - 1
    pilot receiver_shape = tc_expr_type(word_to_int(left))
    if is_shape_name(receiver_shape) {
        fidx = get_shape_field_index(receiver_shape, val)
    } else {
        pilot si = 0
        repeat shape_registry_count times {
            pilot tmpidx = get_shape_field_index(array_get(shape_registry_names, si), val)
            if tmpidx >= 0 { fidx = tmpidx }
            si += 1
        }
    }
    if fidx < 0 {
        -- The semantic checker hard-gates this path.  Keep the emitter
        -- defensive so a missed diagnostic never aliases an unrelated field.
        emit("0")
        give back
    }
    emit("freak_llvm_shape_get(")
    emit_expr(left)
    emit(", " + word_from_int(fidx) + ")")
}

task emit_c_binop(expr_id: word, val: word, left: word, right: word) -> void {
    if val == "+" {
        if emt_expr_type_code(left) == "w" or emt_expr_type_code(right) == "w" {
            emit("freak_word_concat_consuming(")
            emit_expr(left)
            emit(", ")
            emit_expr(right)
            emit(", ")
            if emt_word_expr_is_owned_temporary(left) { emit("true") } else { emit("false") }
            emit(", ")
            if emt_word_expr_is_owned_temporary(right) { emit("true") } else { emit("false") }
            emit(")")
            give back
        }
        emit("(")
        emit_expr(left)
        emit(" + ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "==" or val == "!=" {
        if emt_expr_type_code(left) == "w" or emt_expr_type_code(right) == "w" {
            if val == "!=" { emit("(!") }
            pilot compare_args = left + "," + right
            if emt_args_have_owned_word_temporary(compare_args) {
                emit_c_borrowing_call(expr_id, "freak_word_eq", compare_args)
            } else {
                emit("freak_word_eq(")
                emit_expr(left)
                emit(", ")
                emit_expr(right)
                emit(")")
            }
            if val == "!=" { emit(")") }
            give back
        }
        emit("(")
        emit_expr(left)
        emit(" " + val + " ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "and" {
        emit("(")
        emit_expr(left)
        emit(" && ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "or" {
        emit("(")
        emit_expr(left)
        emit(" || ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "NAKAMA" {
        emit("(")
        emit_expr(left)
        emit(" + ")
        emit_expr(right)
        emit(" + (")
        emit_expr(left)
        emit(" * ")
        emit_expr(right)
        emit(" / 10))")
        give back
    }
    -- Default: generic binary operator
    emit("(")
    emit_expr(left)
    emit(" " + val + " ")
    emit_expr(right)
    emit(")")
}

task emit_c_unaryop(val: word, left: word) -> void {
    if val == "not" { emit("(!") emit_expr(left) emit(")") give back }
    if val == "-" { emit("(-") emit_expr(left) emit(")") give back }
    if val == "PLUS ULTRA" { emit("(") emit_expr(left) emit(" * 2)") give back }
    if val == "FINAL FORM" { emit("(") emit_expr(left) emit(" * ") emit_expr(left) emit(")") give back }
    if val == "TSUNDERE" { emit("(-") emit_expr(left) emit(")") give back }
}

-- ===================== BLOCK EMIT ====================================

task emit_block(block: word) -> void {
    pilot saved_var_count = emt_var_count
    pilot saved_tc_local_count = tc_local_count
    pilot i = 0
    pilot slen = block.length()
    pilot cur_id = ""
    repeat slen times {
        pilot c = block.char_at(i)
        if c == "," {
            if cur_id != "" { emit_stmt(cur_id) }
            cur_id = ""
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id != "" { emit_stmt(cur_id) }
    emit_word_local_cleanup_range(saved_var_count, "")
    emt_var_count = saved_var_count
    tc_local_count = saved_tc_local_count
}

-- ===================== STATEMENT EMIT ================================

task emt_is_global_binding(name: word) -> bool {
    pilot i = 0
    pilot top_count = array_len(ast_top_stmts)
    repeat top_count times {
        pilot stmt_w: word = array_get(ast_top_stmts, i)
        pilot stmt_i = word_to_int(stmt_w)
        if array_get(ast_stmt_kinds, stmt_i) == STMT_PILOT {
            if array_get(ast_stmt_names, stmt_i) == name { give back true }
        }
        i += 1
    }
    give back false
}

task emt_is_current_word_param(name: word) -> bool {
    give back emt_current_word_params.contains("|" + name + "=")
}

task emt_word_param_c_name(name: word) -> word {
    pilot current_name = ""
    pilot current_c_name = ""
    pilot in_c_name = false
    pilot i = 0
    repeat until i >= emt_current_word_params.length() {
        pilot ch = emt_current_word_params.char_at(i)
        if ch == "|" {
            if current_name == name { give back current_c_name }
            current_name = ""
            current_c_name = ""
            in_c_name = false
        } else if ch == "=" { in_c_name = true }
        else if in_c_name { current_c_name = current_c_name + ch }
        else { current_name = current_name + ch }
        i += 1
    }
    give back ""
}

task c_user_task_symbol(name: word) -> word {
    if tc_internal_runtime_task_name(name) { give back "freak_" + c_safe_ident(name) }
    give back "__freak_user_" + c_safe_ident(name)
}

task emt_active_binding_is_word_param(name: word) -> bool {
    if not emt_is_current_word_param(name) { give back false }
    give back emt_get_var_c_name(name) == emt_word_param_c_name(name)
}

task emt_active_binding_is_global(name: word) -> bool {
    if emt_has_local_var(name) { give back false }
    give back emt_is_global_binding(name)
}

task emit_current_word_param_cleanup(skip_name: word) -> void {
    pilot i = 0
    pilot current_name = ""
    pilot current_c_name = ""
    pilot in_c_name = false
    repeat until i >= emt_current_word_params.length() {
        pilot ch: word = emt_current_word_params.char_at(i)
        if ch == "|" {
            if current_name != "" and current_name != skip_name {
                emit_line("freak_word_release_owned(&" + current_c_name + ");")
            }
            current_name = ""
            current_c_name = ""
            in_c_name = false
        } else if ch == "=" { in_c_name = true }
        else if in_c_name { current_c_name = current_c_name + ch }
        else { current_name = current_name + ch }
        i += 1
    }
}

task emit_word_local_cleanup_range(start_index: int, skip_c_name: word) -> void {
    pilot i = emt_var_count - 1
    repeat until i < start_index {
        pilot c_name: word = array_get(emt_var_c_names, i)
        if array_get(emt_var_types, i) == "w" and c_name != skip_c_name {
            emit_line("freak_word_release_owned(&" + c_name + ");")
        }
        i -= 1
    }
}

task emit_stmt(eid: word) -> void {
    if eid.length() == 0 { give back }

    pilot i = word_to_int(eid)
    pilot kind: word = array_get(ast_stmt_kinds, i)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    if kind == STMT_PILOT { emit_stmt_pilot(eid) give back }
    if kind == STMT_SAY {
        pilot say_type = emt_expr_type_code(expr_id_w)
        if say_type == "w" {
            if emt_word_expr_is_owned_temporary(expr_id_w) {
                emit("{ freak_word __freak_say_value = ")
                emit_expr(expr_id_w)
                emit_line("; freak_say(__freak_say_value); freak_word_release_owned(&__freak_say_value); }")
                give back
            }
            emit("freak_say(")
            emit_expr(expr_id_w)
            emit_line(");")
            give back
        }
        emit("{ freak_word __freak_say_value = ")
        if say_type == "d" { emit("freak_format_num(") }
        else if say_type == "b" { emit("freak_word_from_bool(") }
        else { emit("freak_word_from_int(") }
        emit_expr(expr_id_w)
        emit_line("); freak_say(__freak_say_value); freak_word_release_owned(&__freak_say_value); }")
        give back
    }
    if kind == STMT_EXPR {
        if emt_word_expr_is_owned_temporary(expr_id_w) {
            emit("{ freak_word __freak_discarded_word = ")
            emit_expr(expr_id_w)
            emit_line("; freak_word_release_owned(&__freak_discarded_word); }")
            give back
        }
        emit_expr(expr_id_w)
        emit_line(";")
        give back
    }
    if kind == STMT_GIVE_BACK {
        if emt_current_return_type == "word" and expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            pilot return_idx = word_to_int(expr_id_w)
            pilot return_kind: word = array_get(ast_expr_kinds, return_idx)
            pilot return_name: word = array_get(ast_expr_vals, return_idx)
            pilot clone_return = return_kind == EXPR_FIELD
            if return_kind == EXPR_IDENT and emt_active_binding_is_global(return_name) { clone_return = true }
            if return_kind == EXPR_CALL and return_name == "array_get" { clone_return = true }
            emit("{ freak_word __freak_return_value = ")
            if clone_return { emit("freak_word_clone(") }
            emit_expr(expr_id_w)
            if clone_return { emit(")") }
            emit_line(";")
            pilot skip_name = ""
            pilot skip_local_c_name = ""
            if return_kind == EXPR_IDENT and emt_active_binding_is_word_param(return_name) { skip_name = return_name }
            if return_kind == EXPR_IDENT and not emt_active_binding_is_word_param(return_name) and not emt_active_binding_is_global(return_name) {
                skip_local_c_name = emt_get_var_c_name(return_name)
            }
            emit_word_local_cleanup_range(emt_current_word_local_base, skip_local_c_name)
            emit_current_word_param_cleanup(skip_name)
            emit_line("return __freak_return_value; }")
        } else if expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            pilot return_ctype = "int64_t"
            if emt_current_return_type == "bool" { return_ctype = "bool" }
            if emt_current_return_type == "num" { return_ctype = "double" }
            emit("{ " + return_ctype + " __freak_return_value = ")
            emit_expr(expr_id_w)
            emit_line(";")
            emit_word_local_cleanup_range(emt_current_word_local_base, "")
            emit_current_word_param_cleanup("")
            emit_line("return __freak_return_value; }")
        } else {
            emit_word_local_cleanup_range(emt_current_word_local_base, "")
            emit_current_word_param_cleanup("")
            emit_line("return;")
        }
        give back
    }
    if kind == STMT_IF {
        emit("if (")
        emit_expr(expr_id_w)
        emit_line(") {")
        emit_block(array_get(ast_stmt_bodies, i))
        emit_line("}")
        pilot else_body_w: word = array_get(ast_stmt_else_bodies, i)
        if else_body_w != "" {
            emit_line("else {")
            emit_block(else_body_w)
            emit_line("}")
        }
        give back
    }
    if kind == STMT_REPEAT {
        pilot saved_loop_cleanup_base = emt_loop_word_cleanup_base
        emt_loop_word_cleanup_base = emt_var_count
        if name_w == "until" {
            emit("while (!(")
            emit_expr(expr_id_w)
            emit_line(")) {")
            emit_block(array_get(ast_stmt_bodies, i))
            emit_line("}")
        } else {
            pilot repeat_limit = "__freak_repeat_limit_" + eid
            emit("{ int64_t " + repeat_limit + " = ")
            emit_expr(expr_id_w)
            emit_line(";")
            emit("for (int64_t __freak_repeat_index = 0; __freak_repeat_index < " + repeat_limit)
            emit_line("; __freak_repeat_index++) {")
            emit_block(array_get(ast_stmt_bodies, i))
            emit_line("}")
            emit_line("}")
        }
        emt_loop_word_cleanup_base = saved_loop_cleanup_base
        give back
    }
    if kind == STMT_TRAINING_ARC {
        pilot saved_loop_cleanup_base = emt_loop_word_cleanup_base
        emt_loop_word_cleanup_base = emt_var_count
        pilot max_id_w: word = array_get(ast_stmt_extras, i)
        pilot arc_limit = "__freak_arc_limit_" + eid
        emit("{ int64_t " + arc_limit + " = ")
        emit_expr(max_id_w)
        emit_line(";")
        emit("for (int64_t __freak_arc_index = 0; __freak_arc_index < " + arc_limit)
        emit_line("; __freak_arc_index++) {")
        emit("    if (")
        emit_expr(expr_id_w)
        emit_line(") { break; }")
        emit_block(array_get(ast_stmt_bodies, i))
        emit_line("}")
        emit_line("}")
        emt_loop_word_cleanup_base = saved_loop_cleanup_base
        give back
    }
    if kind == STMT_WHEN {
        emit_stmt_when(eid)
        give back
    }
    if kind == STMT_BLOCK {
        emit_line("{")
        emit_block(array_get(ast_stmt_bodies, i))
        emit_line("}")
        give back
    }
    if kind == STMT_ASSIGN {
        pilot op_w = name_w
        pilot rhs_w: word = array_get(ast_stmt_bodies, i)
        pilot lhs_idx = word_to_int(expr_id_w)
        pilot lhs_kind: word = array_get(ast_expr_kinds, lhs_idx)

        -- Field assignment: self.field = rhs  ->  shape_set(self, fidx, rhs)
        -- For compound ops we re-evaluate the receiver (acceptable for the
        --  common `self.field +=` case; nested side-effecting receivers are
        --  rare and can be lifted to a temp by the caller).
        if lhs_kind == EXPR_FIELD {
            pilot field_name: word = array_get(ast_expr_vals, lhs_idx)
            pilot recv_id: word = array_get(ast_expr_lefts, lhs_idx)
            pilot fidx = 0 - 1
            pilot receiver_shape = tc_expr_type(word_to_int(recv_id))
            if is_shape_name(receiver_shape) {
                fidx = get_shape_field_index(receiver_shape, field_name)
            } else {
                pilot si = 0
                repeat shape_registry_count times {
                    pilot tmpidx = get_shape_field_index(array_get(shape_registry_names, si), field_name)
                    if tmpidx >= 0 { fidx = tmpidx }
                    si += 1
                }
            }
            if fidx < 0 { fidx = 0 }
            pilot fidx_w = word_from_int(fidx)

            if op_w == "=" {
                emit("freak_llvm_shape_set(")
                emit_expr(recv_id)
                emit(", " + fidx_w + ", ")
                emit_expr(rhs_w)
                emit_line(");")
                give back
            }

            pilot bin_op = "+"
            if op_w == "-=" { bin_op = "-" }
            if op_w == "*=" { bin_op = "*" }
            if op_w == "/=" { bin_op = "/" }
            if op_w == "%=" { bin_op = "%" }

            emit("freak_llvm_shape_set(")
            emit_expr(recv_id)
            emit(", " + fidx_w + ", freak_llvm_shape_get(")
            emit_expr(recv_id)
            emit(", " + fidx_w + ") " + bin_op + " ")
            emit_expr(rhs_w)
            emit_line(");")
            give back
        }

        -- A word replacement must evaluate its RHS before releasing the old
        -- owned buffer (`name = name + suffix`), and direct self-assignment
        -- must keep the shared pointer alive.
        if lhs_kind == EXPR_IDENT and op_w == "=" {
            pilot lhs_name: word = array_get(ast_expr_vals, lhs_idx)
            if emt_get_var_type(lhs_name) == "w" {
                pilot rhs_idx = word_to_int(rhs_w)
                pilot rhs_kind: word = array_get(ast_expr_kinds, rhs_idx)
                if rhs_kind == EXPR_BINOP and array_get(ast_expr_vals, rhs_idx) == "+" {
                    pilot append_left: word = array_get(ast_expr_lefts, rhs_idx)
                    pilot append_right: word = array_get(ast_expr_rights, rhs_idx)
                    pilot append_left_idx = word_to_int(append_left)
                    pilot append_left_kind: word = array_get(ast_expr_kinds, append_left_idx)
                    pilot append_left_name: word = array_get(ast_expr_vals, append_left_idx)
                    pilot append_right_idx = word_to_int(append_right)
                    pilot append_right_kind: word = array_get(ast_expr_kinds, append_right_idx)
                    pilot safe_global_suffix = append_right_kind == EXPR_STR or append_right_kind == EXPR_IDENT
                    pilot can_append = append_left_kind == EXPR_IDENT and append_left_name == lhs_name
                    if emt_active_binding_is_global(lhs_name) and not safe_global_suffix { can_append = false }
                    if can_append {
                        emit("{ freak_word __freak_append_suffix = ")
                        emit_expr(append_right)
                        emit("; freak_word_append_owned(&")
                        emit_expr(expr_id_w)
                        emit(", __freak_append_suffix, ")
                        if emt_word_expr_is_owned_temporary(append_right) { emit("true") } else { emit("false") }
                        emit_line("); }")
                        give back
                    }
                }
                emit("{ freak_word __freak_word_replacement = ")
                pilot clone_rhs = emt_word_expr_needs_clone(rhs_w)
                if clone_rhs { emit("freak_word_clone(") }
                emit_expr(rhs_w)
                if clone_rhs { emit(")") }
                emit("; freak_word_replace_owned(&")
                emit_expr(expr_id_w)
                emit_line(", __freak_word_replacement); }")
                give back
            }
        }

        emit_expr(expr_id_w)
        emit(" " + op_w + " ")
        emit_expr(rhs_w)
        emit_line(";")
        give back
    }
    if kind == STMT_SHAPE {
        emit_line("/* shape " + name_w + " */")
        give back
    }
    if kind == STMT_BREAK {
        if emt_loop_word_cleanup_base >= 0 { emit_word_local_cleanup_range(emt_loop_word_cleanup_base, "") }
        emit_line("break;")
        give back
    }
    if kind == STMT_CONTINUE {
        if emt_loop_word_cleanup_base >= 0 { emit_word_local_cleanup_range(emt_loop_word_cleanup_base, "") }
        emit_line("continue;")
        give back
    }
    if kind == STMT_EVENTUALLY {
        emit_line("/* eventually */")
        pilot ev_body_w: word = array_get(ast_stmt_bodies, i)
        if ev_body_w.length() > 0 { emit_block(ev_body_w) }
        give back
    }
}

task emit_stmt_pilot(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot e_idx = word_to_int(expr_id_w)
    pilot e_kind: word = array_get(ast_expr_kinds, e_idx)
    pilot type_ann_w: word = array_get(ast_stmt_extras, i)
    pilot ctype = "int64_t "
    pilot vtype = "i"
    if type_ann_w == "word" { ctype = "freak_word " vtype = "w" }
    if type_ann_w == "bool" { ctype = "bool " vtype = "b" }
    if type_ann_w == "num" { ctype = "double " vtype = "d" }
    if type_ann_w == "int" { ctype = "int64_t " vtype = "i" }
    pilot binding_type = type_ann_w
    if type_ann_w == "" {
        binding_type = tc_expr_type(e_idx)
        vtype = emt_expr_type_code(expr_id_w)
        if vtype == "w" { ctype = "freak_word " }
        else if vtype == "b" { ctype = "bool " }
        else if vtype == "d" { ctype = "double " }
        else { ctype = "int64_t " vtype = "i" }
        if binding_type == "" {
            if vtype == "w" { binding_type = "word" }
            else if vtype == "b" { binding_type = "bool" }
            else if vtype == "d" { binding_type = "num" }
            else { binding_type = "int" }
        }
    }
    pilot c_name = "__freak_local_" + eid
    emit(ctype + c_name + " = ")
    pilot clone_initial = vtype == "w" and emt_word_expr_needs_clone(expr_id_w)
    if clone_initial { emit("freak_word_clone(") }
    emit_expr(expr_id_w)
    if clone_initial { emit(")") }
    emit_line(";")
    -- The initializer resolves in the outer scope. Register this binding only
    -- after lowering the RHS so `pilot value: word = value` reads the
    -- parameter/global being shadowed, not the new C local.
    emt_set_var_type_named(name_w, vtype, c_name)
    tc_set_local(name_w, binding_type)
}

task emit_stmt_when(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot target_id_w: word = array_get(ast_stmt_exprs, i)
    pilot cases_str: word = array_get(ast_stmt_bodies, i)

    pilot saved_when_vars = emt_var_count
    pilot saved_when_tc_locals = tc_local_count
    pilot target_type = emt_expr_type_code(target_id_w)
    pilot target_ctype = "int64_t"
    if target_type == "w" { target_ctype = "freak_word" }
    else if target_type == "d" { target_ctype = "double" }
    else if target_type == "b" { target_ctype = "bool" }
    pilot target_tmp = "__freak_when_target_" + eid
    emit("{ " + target_ctype + " " + target_tmp + " = ")
    emit_expr(target_id_w)
    emit_line(";")
    if target_type == "w" and emt_word_expr_is_owned_temporary(target_id_w) {
        -- Track the hidden temporary for exit cleanup without entering a
        -- source-visible binding name that a legal user identifier can match.
        emt_set_var_type_named("", "w", target_tmp)
    }

    pilot cases_len = cases_str.length()
    pilot ci = 0
    pilot cur_case = ""
    pilot is_first = true
    pilot case_fin = false

    repeat until case_fin {
        pilot cc = cases_str.char_at(ci)
        if cc == "," or ci >= cases_len {
            if cur_case != "" {
                pilot c_expr = ""
                pilot c_stmt = ""
                pilot in_expr = true
                pilot c_len = cur_case.length()
                pilot cj = 0
                repeat c_len times {
                    pilot p = cur_case.char_at(cj)
                    if p == ":" { in_expr = false }
                    else {
                        if in_expr { c_expr = c_expr + p }
                        else { c_stmt = c_stmt + p }
                    }
                    cj += 1
                }
                if c_expr == "-1" {
                    if not is_first { emit("else ") }
                    emit_line("{")
                    pilot saved_case_vars = emt_var_count
                    pilot saved_case_tc_locals = tc_local_count
                    emit_stmt(c_stmt)
                    emit_word_local_cleanup_range(saved_case_vars, "")
                    emt_var_count = saved_case_vars
                    tc_local_count = saved_case_tc_locals
                    emit_line("}")
                } else {
                    if not is_first { emit("else ") }
                    if target_type == "w" {
                        if emt_word_expr_is_owned_temporary(c_expr) {
                            pilot case_tmp = "__freak_when_case_" + eid + "_" + c_expr
                            pilot match_tmp = "__freak_when_match_" + eid + "_" + c_expr
                            emit("if (({ freak_word " + case_tmp + " = ")
                            emit_expr(c_expr)
                            emit("; bool " + match_tmp + " = freak_word_eq(" + target_tmp + ", " + case_tmp + "); ")
                            emit("freak_word_release_owned(&" + case_tmp + "); " + match_tmp + "; }))")
                            emit_line(" {")
                        } else {
                            emit("if (freak_word_eq(" + target_tmp + ", ")
                            emit_expr(c_expr)
                            emit_line(")) {")
                        }
                    } else {
                        emit("if (" + target_tmp + " == ")
                        emit_expr(c_expr)
                        emit_line(") {")
                    }
                    pilot saved_case_vars = emt_var_count
                    pilot saved_case_tc_locals = tc_local_count
                    emit_stmt(c_stmt)
                    emit_word_local_cleanup_range(saved_case_vars, "")
                    emt_var_count = saved_case_vars
                    tc_local_count = saved_case_tc_locals
                    emit_line("}")
                }
                is_first = false
            }
            cur_case = ""
            if ci >= cases_len { case_fin = true }
        } else {
            cur_case = cur_case + cc
        }
        ci += 1
    }
    emit_word_local_cleanup_range(saved_when_vars, "")
    emt_var_count = saved_when_vars
    tc_local_count = saved_when_tc_locals
    emit_line("}")
}

-- ===================== TASK + GLOBAL EMIT ============================

task translate_params(p: word) -> word {
    pilot res = ""
    pilot cur_name = ""
    pilot cur_type = ""
    pilot in_type = false
    pilot i = 0
    pilot param_index = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" {
            in_type = true
        } else if c == "," {
            pilot ctype = "int64_t"
            if cur_type == "word" { ctype = "freak_word" }
            if cur_type == "bool" { ctype = "bool" }
            if cur_type == "num" { ctype = "double" }
            if res != "" { res = res + ", " }
            res = res + ctype + " __freak_param_" + word_from_int(param_index)
            param_index += 1
            cur_name = ""
            cur_type = ""
            in_type = false
        } else {
            if in_type { cur_type = cur_type + c }
            else { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name != "" {
        pilot ctype = "int64_t"
        if cur_type == "word" { ctype = "freak_word" }
        if cur_type == "bool" { ctype = "bool" }
        if cur_type == "num" { ctype = "double" }
        if res != "" { res = res + ", " }
        res = res + ctype + " __freak_param_" + word_from_int(param_index)
    }
    give back res
}

task c_ret_type(returns_w: word) -> word {
    if returns_w == "int" { give back "int64_t" }
    if returns_w == "word" { give back "freak_word" }
    if returns_w == "bool" { give back "bool" }
    if returns_w == "num" { give back "double" }
    give back "void"
}

task emit_task(eid: word) -> void {
    emt_reset_local_types()
    tc_reset_locals()
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot body_id_w: word = array_get(ast_stmt_bodies, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    emt_current_word_params = ""
    emt_current_return_type = returns_w
    emt_loop_word_cleanup_base = 0 - 1

    pilot c_ret = c_ret_type(returns_w)
    pilot c_params = "void"
    if params_w != "" {
        c_params = translate_params(params_w)
        register_param_types(params_w)
        tc_register_params(params_w)
    }
    emt_current_word_local_base = emt_var_count

    emit(c_ret + " " + c_user_task_symbol(name_w) + "(" + c_params)
    emit_line(") {")
    emit_block(body_id_w)
    emit_current_word_param_cleanup("")
    emit_line("}")
}

task register_param_types(params_w: word) -> void {
    pilot pi = 0
    pilot pslen = params_w.length()
    pilot pname = ""
    pilot ptype = ""
    pilot in_ptype = false
    pilot param_index = 0
    repeat pslen times {
        pilot pc = params_w.char_at(pi)
        if pc == ":" { in_ptype = true }
        else if pc == "," {
            if ptype == "word" {
                pilot c_name = "__freak_param_" + word_from_int(param_index)
                emt_set_var_type_named(pname, "w", c_name)
                emt_current_word_params = emt_current_word_params + "|" + pname + "=" + c_name + "|"
            }
            else if ptype == "bool" { emt_set_var_type_named(pname, "b", "__freak_param_" + word_from_int(param_index)) }
            else if ptype == "num" { emt_set_var_type_named(pname, "d", "__freak_param_" + word_from_int(param_index)) }
            else { emt_set_var_type_named(pname, "i", "__freak_param_" + word_from_int(param_index)) }
            param_index += 1
            pname = ""
            ptype = ""
            in_ptype = false
        } else {
            if in_ptype { ptype = ptype + pc }
            else { pname = pname + pc }
        }
        pi += 1
    }
    if pname != "" {
        if ptype == "word" {
            pilot c_name = "__freak_param_" + word_from_int(param_index)
            emt_set_var_type_named(pname, "w", c_name)
            emt_current_word_params = emt_current_word_params + "|" + pname + "=" + c_name + "|"
        }
        else if ptype == "bool" { emt_set_var_type_named(pname, "b", "__freak_param_" + word_from_int(param_index)) }
        else if ptype == "num" { emt_set_var_type_named(pname, "d", "__freak_param_" + word_from_int(param_index)) }
        else { emt_set_var_type_named(pname, "i", "__freak_param_" + word_from_int(param_index)) }
    }
}

task emit_global_decl(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot e_idx = word_to_int(expr_id_w)
    pilot e_kind: word = array_get(ast_expr_kinds, e_idx)
    pilot type_ann_w: word = array_get(ast_stmt_extras, i)
    pilot ctype = "int64_t "
    pilot defval = " = 0"
    pilot vtype = "i"
    if type_ann_w == "word" { ctype = "freak_word " defval = " = FREAK_WORD_EMPTY" vtype = "w" }
    if type_ann_w == "bool" { ctype = "bool " defval = " = false" vtype = "b" }
    if type_ann_w == "num" { ctype = "double " defval = " = 0.0" vtype = "d" }
    if type_ann_w == "" {
        vtype = emt_expr_type_code(expr_id_w)
        if vtype == "w" { ctype = "freak_word " defval = " = FREAK_WORD_EMPTY" }
        else if vtype == "b" { ctype = "bool " defval = " = false" }
        else if vtype == "d" { ctype = "double " defval = " = 0.0" }
        else { ctype = "int64_t " defval = " = 0" vtype = "i" }
    }
    pilot c_name = "__freak_global_" + eid
    emt_set_global_var_type(name_w, vtype, c_name)
    emit(ctype + c_name + defval)
    emit_line(";")
}

task emit_global_init(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot expr_idx = word_to_int(expr_id_w)
    pilot expr_kind: word = array_get(ast_expr_kinds, expr_idx)
    emit(emt_get_var_c_name(name_w) + " = ")
    pilot clone_initial = emt_get_var_type(name_w) == "w" and emt_word_expr_needs_clone(expr_id_w)
    if clone_initial { emit("freak_word_clone(") }
    emit_expr(expr_id_w)
    if clone_initial { emit(")") }
    emit_line(";")
}

task emit_fwd_decl(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    if returns_w == "word" { emt_register_word_task(name_w) }
    pilot c_ret = c_ret_type(returns_w)
    pilot c_params = "void"
    if params_w != "" { c_params = translate_params(params_w) }
    emit(c_ret + " " + c_user_task_symbol(name_w) + "(" + c_params)
    emit_line(");")
}

task emit_extern_decl(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    emt_register_extern(name_w, returns_w)
    pilot c_ret = c_ret_type(returns_w)
    pilot c_params = "void"
    if params_w != "" { c_params = translate_params(params_w) }
    emit("extern " + c_ret + " " + name_w + "(" + c_params)
    emit_line(");")
}

-- ===================== PROGRAM EMIT ==================================

task emit_c_program() -> void {
    emit_line("#include \"freak_runtime.h\"")

    pilot top_count = array_len(ast_top_stmts)
    pilot i = 0
    tc_reset_locals()

    -- Pass 0: Forward declarations + extern declarations
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { emit_fwd_decl(cur_id) }
        if kind == STMT_EXTERN { emit_extern_decl(cur_id) }
        i += 1
    }

    -- Pass 1: Global variable declarations
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_PILOT { emit_global_decl(cur_id) }
        i += 1
    }

    -- Pass 2: Task definitions
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { emit_task(cur_id) }
        i += 1
    }

    -- Detect user-defined main
    pilot has_user_main = false
    pilot user_main_return_type = "void"
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" {
                has_user_main = true
                user_main_return_type = array_get(ast_task_returns, word_to_int(cur_id))
            }
        }
        i += 1
    }

    -- Pass 3: Global init + top-level wrapper. Generated symbols live in the
    -- checker-reserved __freak_ namespace so legal extern names cannot collide.
    if has_user_main {
        emit_line("void __freak_generated_init_globals(void) {")
    }
    if not has_user_main {
        emit_line("void __freak_generated_top_level(void) {")
    }
    emt_reset_local_types()
    tc_reset_locals()

    -- Initialize globals
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_PILOT { emit_global_init(cur_id) }
        i += 1
    }

    -- Top-level statements
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind != STMT_TASK and kind != STMT_SHAPE and kind != STMT_PILOT and kind != STMT_EXTERN {
            emit_stmt(cur_id)
        }
        i += 1
    }
    emit_line("}")

    -- C main entry point
    emit_line("int main(int argc, char** argv) {")
    emit_line("    freak_argc = argc;")
    emit_line("    freak_argv = argv;")
    emit_line("    freak_enable_ansi();")
    if has_user_main and user_main_return_type == "int" {
        emit_line("    int64_t __freak_native_main_result = 0;")
    }
    if has_user_main {
        emit_line("    __freak_generated_init_globals();")
        if user_main_return_type == "int" {
            emit_line("    __freak_native_main_result = " + c_user_task_symbol("main") + "();")
        } else {
            emit_line("    " + c_user_task_symbol("main") + "();")
        }
    }
    if not has_user_main {
        emit_line("    __freak_generated_top_level();")
    }
    pilot cleanup_i = emt_global_var_count - 1
    repeat until cleanup_i < 0 {
        if array_get(emt_global_var_types, cleanup_i) == "w" {
            emit_line("    freak_word_release_owned(&" + array_get(emt_global_var_c_names, cleanup_i) + ");")
        }
        cleanup_i -= 1
    }
    if has_user_main and user_main_return_type == "int" {
        emit_line("    return (int)__freak_native_main_result;")
    } else {
        emit_line("    return 0;")
    }
    emit_line("}")
}
