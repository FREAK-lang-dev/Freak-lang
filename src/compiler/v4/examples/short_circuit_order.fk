extern [C] {
    task abort() -> void
}

task mark(c: int) -> bool {
    if c == 65 { say "A" }
    if c == 66 { say "B" }
    if c == 67 { say "C" }
    if c == 68 { say "D" }
    give back true
}

task fail() -> bool {
    abort()
    give back true
}

task third(a: bool, b: bool, c: bool) -> bool {
    give back a and b and c
}

task main() -> int {
    pilot a = third(mark(65), mark(66) or fail(), true)
    pilot b = mark(67) == (mark(68) or fail())
    if a and b { give back 42 }
    give back 1
}
