task fib(n: int) -> int {
    if n < 2 { give back n }
    give back fib(n - 1) + fib(n - 2)
}

task collatz_steps(start: int) -> int {
    pilot n = start
    pilot steps = 0
    repeat until n == 1 {
        if n % 2 == 0 { n = n / 2 } else { n = n * 3 + 1 }
        steps += 1
    }
    give back steps
}

task main() -> int {
    pilot ok = fib(10) == 55 and not (collatz_steps(27) != 111)
    if ok { give back fib(10) + collatz_steps(27) }
    give back 1
}
