task zero() -> int { give back 7 }
task one(value: int) -> int { give back value + 1 }
task current0() -> task() -> int { give back zero }
task current1() -> task(value: int) -> int { give back one }
task main() -> int {
    if current0()() != 7 { give back 1 }
    if current1()(7) != 8 { give back 2 }
    pilot callback = zero
    if (callback)() != 7 { give back 4 }
    if callback() != 7 { give back 5 }
    if -current0()() != -7 { give back 6 }
    if 1 + current0()() != 8 { give back 7 }
    give back 42
}
