task v35_counted_count() -> int {
    say "count"
    give back 4
}

task v35_counted_forms() -> int {
    pilot i = 40
    pilot sum = 0
    repeat v35_counted_count() times with i {
        if i == 1 { continue }
        sum += i
    }for each i in 0..=4 step 2 {
        sum += i
    }for (pilot mut i: int = 0; i < 4; i += 1) {
        if i == 1 { continue }
        sum += i
    }give back i + sum
}

task v35_counted_nested() -> int {
    pilot total = 0
    repeat 2 times with i {
        for each i in 1..=3 {
            if i == 2 { continue }
            total += i
        }
        total += i
    }
    give back total
}

task v35_counted_owned() -> int {
    pilot total = 0
    for (pilot i = 0; i < 3; i += 1) {
        pilot temporary = "owned"
        if i == 1 { continue }
        total += temporary.length
    }
    repeat 1 times with i {
        pilot kept = "kept"
        if i == 0 { give back total + kept.length }
    }
    give back 0
}

task main() -> int {
    if v35_counted_forms() != 56 { give back 1 }
    if v35_counted_nested() != 9 { give back 2 }
    if v35_counted_owned() != 14 { give back 3 }
    say "v35-counted-ok"
    give back 42
}
