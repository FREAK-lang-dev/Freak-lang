-- Native lists (tier 3 collections rows L and M): List<T> literals, push
-- with amortized growth, get and indexing with V3's bounds panic, length,
-- and `for each`, which lends the list it walks. Elements are stored by
-- value per element type: scalars, words, tuples and shapes that own words.
-- Lists are Move types in Meiya's drop plan; they cross calls by value
-- (moved), as `lend` and as `lend mut`, and come back as results.
-- tests/v4_owned_word_codegen.py runs it under ASan, UBSan and both
-- ownership audits; check_v4_native_shapes pins output and layouts.

shape Pilot { name: word, kills: int }

task total(lend xs: List<int>) -> int {
    pilot acc = 0
    for each x in xs {
        acc += x
    }
    give back acc
}

-- Pushes past the literal's length grow the buffer (4, 8, 16, ...).
task fill(lend mut xs: List<int>, n: int) -> void {
    pilot i = 0
    repeat until i >= n {
        xs.push(i * i)
        i += 1
    }
}

task names(count: int) -> List<word> {
    pilot out: List<word> = []
    pilot i = 0
    repeat until i >= count {
        out.push("p" + word_from_int(i))
        i += 1
    }
    give back out
}

-- Takes the list by value: it drops here, with every word it holds.
task consume(ws: List<word>) -> int {
    give back ws.length()
}

-- An early return out of `for each` moves only the item it returns.
task first_long(lend ws: List<word>, n: int) -> word {
    for each w in ws {
        if w.length() > n { give back w }
    }
    give back "none"
}

task rename_all(lend mut team: List<Pilot>, suffix: word) -> void {
    pilot i = 0
    repeat until i >= team.length() {
        team[i].name = team[i].name + suffix
        i += 1
    }
}

task roster() -> List<Pilot> {
    give back [Pilot { name: "Takeru", kills: 3 }, Pilot { name: "Meiya", kills: 7 }]
}

task main() -> int {
    -- Literal, push, length, get and index (read and write).
    pilot xs: List<int> = [1, 2, 3]
    xs.push(4)
    say xs.length()
    say xs.get(1) + xs[3]
    xs[0] = 10
    say xs[0]
    fill(lend mut xs, 10)
    say xs.length
    say total(lend xs)
    pilot empty: List<int> = []
    say empty.length()
    empty.push(5)
    say empty[0]

    -- Words: each item is the walker's own copy; the list keeps its words.
    pilot ws = names(3)
    for each w in ws {
        say w
    }
    ws.push("extra")
    say first_long(lend ws, 2)
    ws[1] = "replaced"
    say ws[1]
    for each w in ws {
        if w == "p0" { continue }
        if w == "extra" { break }
        say w
    }
    pilot moved = ws
    say consume(moved)

    -- Reassignment drops the old list; a pushed word moves in.
    pilot swap: List<word> = ["a", "b"]
    swap = ["c"]
    pilot solo = "solo"
    swap.push(solo)
    say swap[0] + swap[1]

    -- Tuples and shapes that own words, with pattern bindings.
    pilot pairs: List<(int, word)> = [(1, "one"), (2, "two")]
    for each (n, label) in pairs {
        say label + word_from_int(n)
    }
    pilot team = roster()
    team.push(Pilot { name: "Sumika", kills: 0 })
    rename_all(lend mut team, "!")
    pilot score = 0
    for each p in team {
        say p.name
        score += p.kills
    }
    say score

    -- Any argument indexes past the end: V3's bounds panic, exit 101.
    pilot k = 1
    if process::args_count() > 1 { k = 20 }
    say xs[k]
    give back xs.length()
}
