-- Execute zero, one and several callback parameters, including a returned
-- callback target whose producer prints once for each actual evaluation.
@extern_callback("C")
task zero() -> std::ffi::c_int { give back 7 }

@extern_callback("C")
task one(value: std::ffi::c_int) -> std::ffi::c_int { give back value + 1 }

@extern_callback("C")
task many(a: std::ffi::c_int, b: std::ffi::c_int, c: std::ffi::c_int) -> std::ffi::c_int {
    give back a + b + c
}

task invoke(cb_zero: extern [C] task() -> std::ffi::c_int, cb_one: extern [C] task(value: std::ffi::c_int) -> std::ffi::c_int, cb_many: extern [C] task(a: std::ffi::c_int, b: std::ffi::c_int, c: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int {
    give back cb_zero() + cb_one(4) + cb_many(1, 2, 3)
}

task current() -> extern [C] task() -> std::ffi::c_int {
    say "callback target evaluated"
    give back zero
}

task main() -> int {
    pilot local = zero
    pilot returned = current()
    pilot answer = invoke(local, one, many)
    answer += returned()
    answer += current()()
    give back answer + 10
}
