-- V4 diagnostics arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_diagnostics_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_diagnostics_snapshot_alias_source() -> word {
    pilot src = "alias Loop = Loop\n"
    src = src + "alias First = Second\n"
    src = src + "alias Second = First\n"
    src = src + "alias Spiral<T> = Spiral<T>\n"
    src = src + "alias Pair = (Pair, int)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_lifetime_source() -> word {
    pilot src = "shape RefBox<'a,T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape BadBox {\n"
    src = src + "    value: RefBox<'ghost,int>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_const_source() -> word {
    pilot box_braces = v4_diagnostics_snapshot_braces(" value: 1 ")
    pilot option_decl = v4_diagnostics_snapshot_braces(" value: T ")
    pilot some_braces = v4_diagnostics_snapshot_braces(" value: \"ace\" ")
    pilot src = "fixed pilot BAD_GENERIC_SHAPE = Box<int,word> " + box_braces + "\n"
    src = src + "fixed pilot TYPE_GENERIC_SHAPE = Box<int> " + v4_diagnostics_snapshot_braces(" value: \"ace\" ") + "\n"
    src = src + "fixed pilot BAD_GENERIC_ROUTE = Option<int,word>::None\n"
    src = src + "fixed pilot TYPE_GENERIC_ROUTE = Option<int>::Some " + some_braces + "\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_diagnostics_snapshot_source = "task main() -> int {\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    pilot text = \"hi\"\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    pilot bad = text - 1\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    if 1 {\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "        pilot y = 0\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    }\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    text = 1\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    give back 0\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "}\n"

pilot v4_diagnostics_snapshot_id = v4_diagnostics_text_cached("diagnostics-snapshot.fk", v4_diagnostics_snapshot_source)
pilot v4_diagnostics_snapshot_alias_id = v4_diagnostics_text_cached("diagnostics-snapshot-alias.fk", v4_diagnostics_snapshot_alias_source())
pilot v4_diagnostics_snapshot_lifetime_id = v4_diagnostics_text_cached("diagnostics-snapshot-lifetime.fk", v4_diagnostics_snapshot_lifetime_source())
pilot v4_diagnostics_snapshot_const_id = v4_diagnostics_text_cached("diagnostics-snapshot-const.fk", v4_diagnostics_snapshot_const_source())
say v4_diagnostics_summary(v4_diagnostics_snapshot_id)
say v4_diagnostics_snapshot_summary()

pilot v4_diagnostics_snapshot_payload = v4_diagnostics_snapshot()
say v4_diagnostics_snapshot_validate(v4_diagnostics_snapshot_payload)
say "diagnostics-snapshot-bytes=" + word_from_int(v4_diagnostics_snapshot_payload.length())
say "diagnostics-snapshot-escape=" + v4_diagnostics_snapshot_escape("error|Yuuko%0\nMeiya")
say "diagnostics-snapshot-unescape=" + v4_diagnostics_snapshot_unescape("error%7CYuuko%250%0AMeiya")
say v4_diagnostics_snapshot_set_line(v4_diagnostics_snapshot_id)
say v4_diagnostics_snapshot_diag_line(v4_diagnostics_snapshot_id, 0)
say "alias-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_snapshot_alias_id, 0))
say "alias-diagnostic4-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_snapshot_alias_id, 4))
say "lifetime-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_snapshot_lifetime_id, 0))
say "const-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_snapshot_const_id, 0))
say "const-diagnostic3-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_snapshot_const_id, 3))
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
say v4_ty_snapshot_restore(v4_ty_snapshot())
say v4_mir_snapshot_restore(v4_mir_snapshot())
say v4_borrowck_snapshot_restore(v4_borrowck_snapshot())
say v4_diagnostics_snapshot_restore(v4_diagnostics_snapshot_payload)
say v4_lsp_diagnostics_snapshot_text()
say v4_lsp_diagnostics_snapshot_restore_text(v4_diagnostics_snapshot_payload)
say v4_lsp_handle_text_request("workspace/diagnosticsSnapshotRestore", "diagnostics-snapshot.fk", v4_diagnostics_snapshot_payload, 0)
say v4_lsp_handle_request("workspace/diagnosticsSnapshotRestore", "diagnostics-snapshot.fk", 0)

pilot v4_diagnostics_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_diagnostics_query_payload)
say v4_driver_confirm_restored_document_text("diagnostics-snapshot.fk", v4_diagnostics_snapshot_source)
pilot v4_diagnostics_file = v4_source_find("diagnostics-snapshot.fk")
pilot v4_diagnostics_fingerprint = v4_source_fingerprint(v4_diagnostics_file)
pilot v4_diagnostics_restored_id = word_to_int(v4_query_get(v4_diagnostics_query_key("diagnostics-snapshot.fk"), v4_diagnostics_fingerprint))
say v4_diagnostics_summary(v4_diagnostics_restored_id)
say "restored-diagnostic0=" + v4_diag_message(v4_diagnostics_diag(v4_diagnostics_restored_id, 0))
say "restored-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_restored_id, 0))

say v4_driver_confirm_restored_document_text("diagnostics-snapshot-alias.fk", v4_diagnostics_snapshot_alias_source())
pilot v4_diagnostics_alias_file = v4_source_find("diagnostics-snapshot-alias.fk")
pilot v4_diagnostics_alias_fingerprint = v4_source_fingerprint(v4_diagnostics_alias_file)
pilot v4_diagnostics_alias_restored_id = word_to_int(v4_query_get(v4_diagnostics_query_key("diagnostics-snapshot-alias.fk"), v4_diagnostics_alias_fingerprint))
say "restored-alias-diagnostic0=" + v4_diag_message(v4_diagnostics_diag(v4_diagnostics_alias_restored_id, 0))
say "restored-alias-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_alias_restored_id, 0))
say "restored-alias-diagnostic4=" + v4_diag_message(v4_diagnostics_diag(v4_diagnostics_alias_restored_id, 4))
say "restored-alias-diagnostic4-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_alias_restored_id, 4))

say v4_driver_confirm_restored_document_text("diagnostics-snapshot-lifetime.fk", v4_diagnostics_snapshot_lifetime_source())
pilot v4_diagnostics_lifetime_file = v4_source_find("diagnostics-snapshot-lifetime.fk")
pilot v4_diagnostics_lifetime_fingerprint = v4_source_fingerprint(v4_diagnostics_lifetime_file)
pilot v4_diagnostics_lifetime_restored_id = word_to_int(v4_query_get(v4_diagnostics_query_key("diagnostics-snapshot-lifetime.fk"), v4_diagnostics_lifetime_fingerprint))
say "restored-lifetime-diagnostic0=" + v4_diag_message(v4_diagnostics_diag(v4_diagnostics_lifetime_restored_id, 0))
say "restored-lifetime-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_lifetime_restored_id, 0))

say v4_driver_confirm_restored_document_text("diagnostics-snapshot-const.fk", v4_diagnostics_snapshot_const_source())
pilot v4_diagnostics_const_file = v4_source_find("diagnostics-snapshot-const.fk")
pilot v4_diagnostics_const_fingerprint = v4_source_fingerprint(v4_diagnostics_const_file)
pilot v4_diagnostics_const_restored_id = word_to_int(v4_query_get(v4_diagnostics_query_key("diagnostics-snapshot-const.fk"), v4_diagnostics_const_fingerprint))
say "restored-const-diagnostic0=" + v4_diag_message(v4_diagnostics_diag(v4_diagnostics_const_restored_id, 0))
say "restored-const-diagnostic0-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_const_restored_id, 0))
say "restored-const-diagnostic3=" + v4_diag_message(v4_diagnostics_diag(v4_diagnostics_const_restored_id, 3))
say "restored-const-diagnostic3-span=" + v4_diag_span(v4_diagnostics_diag(v4_diagnostics_const_restored_id, 3))
say v4_driver_confirm_restored_document_text("diagnostics-snapshot.fk", "task changed() => 7\n")
