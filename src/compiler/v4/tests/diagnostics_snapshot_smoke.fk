-- V4 diagnostics arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_diagnostics_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_diagnostics_snapshot_alias_source() -> word {
    pilot src = "alias Loop = Loop\n"
    src = src + "alias First = Second\n"
    src = src + "alias Second = First\n"
    src = src + "alias Spiral<T> = Spiral<T>\n"
    src = src + "alias Pair = (Pair, int)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_lifetime_source() -> word {
    pilot src = "shape RefBox<'a,T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape BadBox {\n"
    src = src + "    value: RefBox<'ghost,int>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_const_source() -> word {
    pilot box_braces = v4_diagnostics_snapshot_braces(" value: 1 ")
    pilot option_decl = v4_diagnostics_snapshot_braces(" value: T ")
    pilot some_braces = v4_diagnostics_snapshot_braces(" value: \"ace\" ")
    pilot src = "fixed pilot BAD_GENERIC_SHAPE = Box<int,word> " + box_braces + "\n"
    src = src + "fixed pilot TYPE_GENERIC_SHAPE = Box<int> " + v4_diagnostics_snapshot_braces(" value: \"ace\" ") + "\n"
    src = src + "fixed pilot BAD_GENERIC_ROUTE = Option<int,word>::None\n"
    src = src + "fixed pilot TYPE_GENERIC_ROUTE = Option<int>::Some " + some_braces + "\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_const_task_source() -> word {
    pilot src = "@const task bump(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "task runtime_only(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot BAD_RUNTIME = runtime_only(BASE)\n"
    src = src + "fixed pilot BAD_ARITY = bump()\n"
    src = src + "fixed pilot BAD_TYPE = bump(\"ace\")\n"
    src = src + "@const task add(base: int, bonus: int) -> int {\n"
    src = src + "    give back base + bonus\n"
    src = src + "}\n"
    src = src + "fixed pilot BAD_UNKNOWN = add(extra: BASE, bonus: 1)\n"
    src = src + "fixed pilot BAD_DUP = add(base: BASE, base: 1)\n"
    src = src + "fixed pilot BAD_ORDER = add(base: BASE, 1)\n"
    src = src + "fixed pilot BAD_MISSING = add(base: BASE)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back BASE\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_layout_source() -> word {
    pilot src = "@layout(transparent)\n"
    src = src + "shape BrokenHandle {\n"
    src = src + "    left: std::ffi::c_int\n"
    src = src + "    right: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "@layout(C, packed=0)\n"
    src = src + "shape ZeroPacked {\n"
    src = src + "    value: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "@layout(packed=1)\n"
    src = src + "shape MissingC {\n"
    src = src + "    value: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_extern_source() -> word {
    pilot src = "@layout(C)\n"
    src = src + "shape BadHeader {\n"
    src = src + "    text: word\n"
    src = src + "}\n"
    src = src + "@layout(C)\n"
    src = src + "shape BadPointer {\n"
    src = src + "    text: *const word\n"
    src = src + "}\n"
    src = src + "shape PlainVec {\n"
    src = src + "    x: int\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task puts(text: word) -> int\n"
    src = src + "    task ship(header: BadHeader) -> void\n"
    src = src + "    task ok(text: *const tiny) -> std::ffi::c_int\n"
    src = src + "    task scan(text: *const word) -> std::ffi::c_int\n"
    src = src + "    task trace(points: *const PlainVec) -> std::ffi::c_int\n"
    src = src + "    task send(box: BadPointer) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_extern_link_source() -> word {
    pilot src = "extern [C, link=msvcrt, link=\"kernel32\", fastcall, stdcall, mystery] {\n"
    src = src + "    @link_name(puts)\n"
    src = src + "    @link_name(\"puts_again\")\n"
    src = src + "    task bad_puts(text: *const tiny) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_extern_variadic_source() -> word {
    pilot src = "task local_sum(args: ...) -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task misplaced(args: ..., seed: std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "extern [stdcall] {\n"
    src = src + "    task win_sum(seed: std::ffi::c_int, args: ...) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_extern_variadic_call_source() -> word {
    pilot src = "extern [C] {\n"
    src = src + "    task trace(seed: std::ffi::c_int, args: ...) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot label = \"not ffi\"\n"
    src = src + "    give back trace(1, label)\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_extern_callback_source() -> word {
    pilot src = "@layout(C)\n"
    src = src + "shape BadTable {\n"
    src = src + "    on_tick: task(seed: int) -> int\n"
    src = src + "}\n"
    src = src + "shape PlainState {\n"
    src = src + "    code: int\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task plain(cb: task(seed: int) -> int) -> std::ffi::c_int\n"
    src = src + "    task mystery(cb: extern [mystery] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task texty(cb: extern [C] task(text: word) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task back() -> extern [C] task(seed: std::ffi::c_int) -> word\n"
    src = src + "    task misplaced(cb: extern [C] task(args: ..., seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task win_hook(cb: extern [stdcall] task(seed: std::ffi::c_int, args: ...) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task ptr_texty(cb: extern [C] task(text: *const word) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task ptr_state(cb: extern [C] task(state: *const PlainState) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_diagnostics_snapshot_extern_callback_call_source() -> word {
    pilot src = "task run(cb: int, miss: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int, texty: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> int {\n"
    src = src + "    pilot first = cb(1)\n"
    src = src + "    pilot second = miss()\n"
    src = src + "    pilot third = texty(\"ace\")\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_diagnostics_snapshot_source = "task main() -> int {\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    pilot text = \"hi\"\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    pilot bad = text - 1\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    if 1 {\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "        pilot y = 0\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    }\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    text = 1\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "    give back 0\n"
v4_diagnostics_snapshot_source = v4_diagnostics_snapshot_source + "}\n"

