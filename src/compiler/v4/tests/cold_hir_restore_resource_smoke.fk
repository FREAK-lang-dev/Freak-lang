    v4_hir_task_param_type_spans = word_to_int(array_get(kept, 42))
    v4_hir_task_param_segment_spans = word_to_int(array_get(kept, 43))
    v4_hir_diags = word_to_int(array_get(kept, 44))
    v4_hir_file_len = 37
    v4_hir_ready = 0
