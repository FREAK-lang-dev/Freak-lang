}

task cold_hir_sentinels_intact(kept: int) -> bool {
    pilot index = 0
    repeat until index >= 45 {
        pilot handle = word_to_int(array_get(kept, index))
        pilot value: word = array_get(handle, 0)
        if array_len(handle) != 1 or value != "sentinel-" + word_from_int(index) { give back false }
        index += 1
    }
    give back true
}

-- Retire only the successful constructor/file arrays owned by this fixture.
-- Sentinel arrays remain live and are never included in this retirement.
task cold_hir_retire_admitted(kept: int) -> void {
    cold_hir_assert(v4_hir_ready == 1, "retire admitted arena")
    pilot index = 0
    repeat until index >= array_len(v4_hir_files) {
        array_release(word_to_int(array_get(v4_hir_extern_return_owner_values, index)))
        array_release(word_to_int(array_get(v4_hir_extern_return_values, index)))
        array_release(word_to_int(array_get(v4_hir_route_owner_values, index)))
        array_release(word_to_int(array_get(v4_hir_route_case_values, index)))
        array_release(word_to_int(array_get(v4_hir_route_field_values, index)))
        array_release(word_to_int(array_get(v4_hir_const_annotation_values, index)))
        array_release(word_to_int(array_get(v4_hir_word_plans, index)))
        array_release(word_to_int(array_get(v4_hir_shape_field_starts, index)))
        array_release(word_to_int(array_get(v4_hir_shape_field_counts, index)))
        array_release(word_to_int(array_get(v4_hir_shape_field_values, index)))
        array_release(word_to_int(array_get(v4_hir_item_kinds, index)))
        array_release(word_to_int(array_get(v4_hir_item_names, index)))
        array_release(word_to_int(array_get(v4_hir_item_defs, index)))
        array_release(word_to_int(array_get(v4_hir_item_spans, index)))
        array_release(word_to_int(array_get(v4_hir_item_parse_nodes, index)))
        array_release(word_to_int(array_get(v4_hir_alias_target_types, index)))
        array_release(word_to_int(array_get(v4_hir_alias_target_spans, index)))
        array_release(word_to_int(array_get(v4_hir_local_annotation_items, index)))
        array_release(word_to_int(array_get(v4_hir_local_annotation_stmt_spans, index)))
        array_release(word_to_int(array_get(v4_hir_local_annotation_types, index)))
        array_release(word_to_int(array_get(v4_hir_local_annotation_type_spans, index)))
        array_release(word_to_int(array_get(v4_hir_task_return_items, index)))
        array_release(word_to_int(array_get(v4_hir_task_return_forms, index)))
        array_release(word_to_int(array_get(v4_hir_task_return_types, index)))
        array_release(word_to_int(array_get(v4_hir_task_return_spans, index)))
        array_release(word_to_int(array_get(v4_hir_annotation_indexes, index)))
        array_release(word_to_int(array_get(v4_hir_return_indexes, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_indexes, index)))
        array_release(word_to_int(array_get(v4_hir_impl_indexes, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_owner_items, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_owner_counts, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_items, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_ordinals, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_names, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_name_spans, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_modes, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_lifetimes, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_lifetime_spans, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_types, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_type_spans, index)))
        array_release(word_to_int(array_get(v4_hir_task_param_segment_spans, index)))
        array_release(word_to_int(array_get(v4_hir_diags, index)))
        index += 1
    }
    array_release(v4_hir_extern_return_owner_values)
    array_release(v4_hir_extern_return_values)
    array_release(v4_hir_route_owner_values)
    array_release(v4_hir_route_case_values)
    array_release(v4_hir_route_field_values)
    array_release(v4_hir_const_annotation_values)
    array_release(v4_hir_word_plans)
    array_release(v4_hir_shape_field_starts)
    array_release(v4_hir_shape_field_counts)
    array_release(v4_hir_shape_field_values)
    array_release(v4_hir_files)
    array_release(v4_hir_expansions)
    array_release(v4_hir_revisions)
    array_release(v4_hir_item_kinds)
    array_release(v4_hir_item_names)
    array_release(v4_hir_item_defs)
    array_release(v4_hir_item_spans)
    array_release(v4_hir_item_parse_nodes)
    array_release(v4_hir_alias_target_types)
    array_release(v4_hir_alias_target_spans)
    array_release(v4_hir_local_annotation_items)
    array_release(v4_hir_local_annotation_stmt_spans)
    array_release(v4_hir_local_annotation_types)
    array_release(v4_hir_local_annotation_type_spans)
    array_release(v4_hir_task_return_items)
    array_release(v4_hir_task_return_forms)
    array_release(v4_hir_task_return_types)
    array_release(v4_hir_task_return_spans)
    array_release(v4_hir_annotation_indexes)
    array_release(v4_hir_return_indexes)
    array_release(v4_hir_task_param_indexes)
    array_release(v4_hir_impl_indexes)
    array_release(v4_hir_task_param_owner_items)
    array_release(v4_hir_task_param_owner_counts)
    array_release(v4_hir_task_param_items)
    array_release(v4_hir_task_param_ordinals)
    array_release(v4_hir_task_param_names)
    array_release(v4_hir_task_param_name_spans)
    array_release(v4_hir_task_param_modes)
    array_release(v4_hir_task_param_lifetimes)
    array_release(v4_hir_task_param_lifetime_spans)
    array_release(v4_hir_task_param_types)
    array_release(v4_hir_task_param_type_spans)
    array_release(v4_hir_task_param_segment_spans)
    array_release(v4_hir_diags)
    cold_hir_set_sentinels(kept)
}

task cold_hir_restore_smoke() -> void {
    pilot source = v4_source_add("cold-hir-restore.fk", "alias Kept = int\n")
    pilot source_revision = v4_source_revision(source)
    pilot fingerprint = v4_source_fingerprint(source)
    pilot generation = v4_session_semantic_restore_generation()
    pilot kept = cold_hir_sentinels()
    cold_hir_set_sentinels(kept)
    pilot original = cold_hir_state()
    pilot capacity = cold_hir_available()
    pilot empty = "hir-snapshot|format=freak-hir-snapshot-v12|files=0|items=0|alias-targets=0|local-annotations=0|task-returns=0|task-param-owners=0|task-params=0|const-annotations=0|shape-owners=0|shape-fields=0|route-owners=0|route-cases=0|route-fields=0|extern-return-owners=0|extern-returns=0|word-owners=0|word-literals=0|word-pieces=0|word-path-parts=0|diagnostics=0\nend|freak-hir-snapshot-v12"
    pilot payload = "hir-snapshot|format=freak-hir-snapshot-v12|files=1|items=1|alias-targets=1|local-annotations=0|task-returns=0|task-param-owners=0|task-params=0|const-annotations=0|shape-owners=0|shape-fields=0|route-owners=0|route-cases=0|route-fields=0|extern-return-owners=0|extern-returns=0|word-owners=0|word-literals=0|word-pieces=0|word-path-parts=0|diagnostics=0\nhir|0|0|0|1|0\nhir-item|0|0|Alias|Kept|kept-def|0@0:16|0|int|0@13:16\nend|freak-hir-snapshot-v12"
    pilot legacy = "hir-snapshot|format=freak-hir-snapshot-v10|files=0|items=0|alias-targets=0|local-annotations=0|task-returns=0|task-param-owners=0|task-params=0|const-annotations=0|shape-owners=0|shape-fields=0|route-owners=0|route-cases=0|route-fields=0|extern-return-owners=0|extern-returns=0|word-owners=0|word-literals=0|word-pieces=0|word-path-parts=0|diagnostics=0\nend|freak-hir-snapshot-v10"
    cold_hir_assert(v4_hir_snapshot_validate(empty).starts_with("hir-snapshot-import ok=1") and v4_hir_snapshot_validate(payload).starts_with("hir-snapshot-import ok=1"), "valid payload controls before pressure")
    cold_hir_assert(cold_hir_state() == original and cold_hir_available() == capacity, "pure validation stays cold")
    pilot malformed = v4_hir_snapshot_restore("malformed")
    pilot outdated = v4_hir_snapshot_restore(legacy)
    cold_hir_assert(malformed.starts_with("hir-snapshot-restore ok=0 reason=validation-failed") and outdated.starts_with("hir-snapshot-restore ok=0 reason=validation-failed"), "malformed and v10 rejected")
    cold_hir_assert(cold_hir_state() == original and cold_hir_sentinels_intact(kept) and cold_hir_available() == capacity, "malformed and v10 never warm or publish")
    cold_hir_assert(v4_session_semantic_restore_generation() == generation and v4_source_revision(source) == source_revision and v4_source_fingerprint(source) == fingerprint, "malformed and v10 source and generation atomic")
    say "cold-hir-restore malformed=true v10=true cold-refs=true capacity-stable=true"

    pilot free_count = 0
    pilot saw_init_rejection = false
    pilot saw_lookup_rejection = false
    pilot admitted = false
    repeat until free_count > 110 or admitted {
        pilot held = cold_hir_hold(free_count)
        pilot restored = v4_hir_snapshot_restore(payload)
        if restored.starts_with("hir-snapshot-restore ok=1") {
            admitted = true
            cold_hir_assert(v4_hir_ready == 1 and v4_hir_file_len == 1 and v4_session_semantic_restore_generation() == generation + 1, "cold nonempty admission state")
        } else {
            if restored.starts_with("hir-snapshot-restore ok=0 reason=hir-initialization-resource-exhausted") { saw_init_rejection = true }
            if restored.starts_with("hir-snapshot-restore ok=0 reason=lookup-index-resource-exhausted") { saw_lookup_rejection = true }
            cold_hir_assert(cold_hir_state() == original and cold_hir_sentinels_intact(kept), "every rejected admission preserves exact 45 refs and length")
            cold_hir_assert(v4_session_semantic_restore_generation() == generation, "every rejection preserves generation")
        }
        cold_hir_release_pressure(held, free_count)
        cold_hir_assert(v4_source_revision(source) == source_revision and v4_source_fingerprint(source) == fingerprint, "every boundary preserves source")
        if admitted {
            cold_hir_assert(v4_hir_snapshot() == payload and cold_hir_available() == capacity - 45 - 42, "successful cold payload exact and owns 45 plus 42")
        } else {
            cold_hir_assert(cold_hir_available() == capacity, "every rejected boundary conserves handles")
        }
        free_count += 1
    }
    cold_hir_assert(admitted and saw_init_rejection and saw_lookup_rejection, "init and post-init lookup boundaries crossed")
    say "cold-hir-restore init-boundary=true lookup-rollback=true nonempty-exact=true handles=87"

    cold_hir_retire_admitted(kept)
    cold_hir_assert(cold_hir_state() == original and cold_hir_available() == capacity, "fixture retires only admitted arena")
    generation = v4_session_semantic_restore_generation()
    cold_hir_assert(v4_hir_snapshot_restore(empty).starts_with("hir-snapshot-restore ok=1"), "cold empty restore admitted")
    cold_hir_assert(v4_hir_snapshot() == empty and v4_hir_file_len == 0 and cold_hir_available() == capacity - 45 and v4_session_semantic_restore_generation() == generation + 1, "empty payload exact and owns 45")
    cold_hir_assert(v4_hir_snapshot_restore(payload).starts_with("hir-snapshot-restore ok=1"), "warm fresh owner admitted")
    pilot warm_capacity = cold_hir_available()
    cold_hir_assert(warm_capacity == capacity - 87 and v4_hir_snapshot() == payload, "warm owner owns 42 children")
    pilot warm_state = cold_hir_state()
    generation = v4_session_semantic_restore_generation()
    pilot held = cold_hir_hold(0)
    pilot rejected = v4_hir_snapshot_restore(payload)
    cold_hir_release_pressure(held, 0)
    cold_hir_assert(rejected.starts_with("hir-snapshot-restore ok=0") and cold_hir_state() == warm_state and v4_hir_snapshot() == payload and cold_hir_available() == warm_capacity and v4_session_semantic_restore_generation() == generation, "warm pressure preserves published arena")
    cold_hir_assert(v4_hir_snapshot_restore(empty).starts_with("hir-snapshot-restore ok=1") and v4_hir_snapshot() == empty and cold_hir_available() == warm_capacity, "logical shrink retains high-water children")
    cold_hir_assert(v4_hir_snapshot_restore(payload).starts_with("hir-snapshot-restore ok=1") and v4_hir_snapshot() == payload and cold_hir_available() == warm_capacity, "warm restore reuses high-water children")
    cold_hir_assert(cold_hir_sentinels_intact(kept) and v4_source_revision(source) == source_revision and v4_source_fingerprint(source) == fingerprint, "all original sentinel and source facts preserved")
    say "cold-hir-restore empty-exact=true handles=45 warm-pressure=true high-water=true recovery=true"
}

cold_hir_restore_smoke()
