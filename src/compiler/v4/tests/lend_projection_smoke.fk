-- V4 explicit lend projection and permission smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_lend_projection_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "    callsign: word\n"
    src = src + "}\n"
    src = src + "task field_read(ship: Ship) -> int {\n"
    src = src + "    pilot view = lend ship\n"
    src = src + "    give back view.hp\n"
    src = src + "}\n"
    src = src + "task field_write(ship: Ship) -> int {\n"
    src = src + "    pilot edit = lend mut ship\n"
    src = src + "    edit.hp = 9\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task field_write_denied(ship: Ship) -> int {\n"
    src = src + "    pilot view = lend ship\n"
    src = src + "    view.hp = 9\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task index_read(items: List<int>) -> int {\n"
    src = src + "    pilot view = lend items\n"
    src = src + "    give back view[0]\n"
    src = src + "}\n"
    src = src + "task index_write(items: List<int>) -> int {\n"
    src = src + "    pilot edit = lend mut items\n"
    src = src + "    edit[0] = 9\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task index_write_denied(items: List<int>) -> int {\n"
    src = src + "    pilot view = lend items\n"
    src = src + "    view[0] = 9\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task field_move_denied(ship: Ship) -> int {\n"
    src = src + "    pilot view = lend ship\n"
    src = src + "    pilot stolen = view.callsign\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task field_mut_move_denied(ship: Ship) -> int {\n"
    src = src + "    pilot edit = lend mut ship\n"
    src = src + "    pilot stolen = edit.callsign\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task index_move_denied(items: List<word>) -> int {\n"
    src = src + "    pilot view = lend items\n"
    src = src + "    pilot stolen = view[0]\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task index_mut_move_denied(items: List<word>) -> int {\n"
    src = src + "    pilot edit = lend mut items\n"
    src = src + "    pilot stolen = edit[0]\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task read_before_write(ship: Ship) -> int {\n"
    src = src + "    pilot edit = lend mut ship\n"
    src = src + "    pilot hp = ship.hp\n"
    src = src + "    edit.hp = 9\n"
    src = src + "    give back hp\n"
    src = src + "}\n"
    src = src + "task read_after_write(ship: Ship) -> int {\n"
    src = src + "    pilot edit = lend mut ship\n"
    src = src + "    edit.hp = 9\n"
    src = src + "    pilot hp = ship.hp\n"
    src = src + "    give back hp\n"
    src = src + "}\n"
    src = src + "task move_owned_lend_field(first: Ship, replacement: Ship) -> int {\n"
    src = src + "    pilot holder = (lend mut first, 0)\n"
    src = src + "    pilot moved = holder.0\n"
    src = src + "    holder.0 = lend mut replacement\n"
    src = src + "    give back moved.hp + holder.0.hp\n"
    src = src + "}\n"
    src = src + "task move_through_aggregate_lend(first: Ship) -> int {\n"
    src = src + "    pilot holder = (lend mut first, 0)\n"
    src = src + "    pilot access = lend holder\n"
    src = src + "    pilot moved = access.0\n"
    src = src + "    give back moved.hp\n"
    src = src + "}\n"
    give back src
}

task v4_lend_projection_diag_count(borrow_id: int, message: word) -> int {
    pilot total = 0
    pilot diag_id = 0
    repeat until diag_id >= v4_borrowck_diag_count(borrow_id) {
        if v4_diag_message(v4_borrowck_diag(borrow_id, diag_id)) == message {
            total += 1
        }
        diag_id += 1
    }
    give back total
}

pilot v4_lend_projection_src = v4_lend_projection_source()
pilot v4_lend_projection_stream = v4_lex_text(0, v4_lend_projection_src)
pilot v4_lend_projection_tree = v4_parse_stream(0, v4_lend_projection_stream)
pilot v4_lend_projection_hir = v4_hir_lower_tree(0, v4_lend_projection_tree)
pilot v4_lend_projection_resolve = v4_resolve_lower_hir(0, v4_lend_projection_hir)
pilot v4_lend_projection_ty = v4_ty_lower_resolve(0, v4_lend_projection_resolve)
pilot v4_lend_projection_mir = v4_mir_lower_ty(0, v4_lend_projection_ty)
pilot v4_lend_projection_borrow = v4_borrowck_check_mir(0, v4_lend_projection_mir)

pilot v4_lend_projection_field_read_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "field_read")
pilot v4_lend_projection_field_write_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "field_write")
pilot v4_lend_projection_field_denied_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "field_write_denied")
pilot v4_lend_projection_index_read_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "index_read")
pilot v4_lend_projection_index_write_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "index_write")
pilot v4_lend_projection_index_denied_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "index_write_denied")
pilot v4_lend_projection_field_move_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "field_move_denied")
pilot v4_lend_projection_field_mut_move_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "field_mut_move_denied")
pilot v4_lend_projection_index_move_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "index_move_denied")
pilot v4_lend_projection_index_mut_move_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "index_mut_move_denied")
pilot v4_lend_projection_before_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "read_before_write")
pilot v4_lend_projection_after_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "read_after_write")
pilot v4_lend_projection_owned_field_move_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "move_owned_lend_field")
pilot v4_lend_projection_aggregate_lend_move_def = v4_resolve_def_for_name(v4_lend_projection_resolve, "move_through_aggregate_lend")

pilot v4_lend_projection_field_read_body = v4_mir_lookup_body(v4_lend_projection_mir, v4_lend_projection_field_read_def)
pilot v4_lend_projection_field_write_body = v4_mir_lookup_body(v4_lend_projection_mir, v4_lend_projection_field_write_def)
pilot v4_lend_projection_index_read_body = v4_mir_lookup_body(v4_lend_projection_mir, v4_lend_projection_index_read_def)
pilot v4_lend_projection_index_write_body = v4_mir_lookup_body(v4_lend_projection_mir, v4_lend_projection_index_write_def)

pilot v4_lend_projection_field_read_rvalue = v4_mir_stmt_rvalue(v4_lend_projection_mir, v4_lend_projection_field_read_body, 1)
pilot v4_lend_projection_field_write_place = v4_mir_stmt_place(v4_lend_projection_mir, v4_lend_projection_field_write_body, 1)
pilot v4_lend_projection_index_read_rvalue = v4_mir_stmt_rvalue(v4_lend_projection_mir, v4_lend_projection_index_read_body, 1)
pilot v4_lend_projection_index_write_place = v4_mir_stmt_place(v4_lend_projection_mir, v4_lend_projection_index_write_body, 1)

pilot v4_lend_projection_field_read_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_field_read_def)
pilot v4_lend_projection_field_write_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_field_write_def)
pilot v4_lend_projection_field_denied_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_field_denied_def)
pilot v4_lend_projection_index_read_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_index_read_def)
pilot v4_lend_projection_index_write_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_index_write_def)
pilot v4_lend_projection_index_denied_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_index_denied_def)
pilot v4_lend_projection_field_move_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_field_move_def)
pilot v4_lend_projection_field_mut_move_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_field_mut_move_def)
pilot v4_lend_projection_index_move_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_index_move_def)
pilot v4_lend_projection_index_mut_move_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_index_mut_move_def)
pilot v4_lend_projection_before_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_before_def)
pilot v4_lend_projection_after_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_after_def)
pilot v4_lend_projection_owned_field_move_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_owned_field_move_def)
pilot v4_lend_projection_aggregate_lend_move_result = v4_borrowck_lookup_result(v4_lend_projection_borrow, v4_lend_projection_aggregate_lend_move_def)

say "projection-field-read-kind=" + v4_mir_rvalue_kind(v4_lend_projection_mir, v4_lend_projection_field_read_body, v4_lend_projection_field_read_rvalue)
say "projection-field-read-ty=" + v4_mir_rvalue_ty(v4_lend_projection_mir, v4_lend_projection_field_read_body, v4_lend_projection_field_read_rvalue)
say "projection-field-write-kind=" + v4_mir_place_kind(v4_lend_projection_mir, v4_lend_projection_field_write_body, v4_lend_projection_field_write_place)
say "projection-field-write-ty=" + v4_mir_place_ty(v4_lend_projection_mir, v4_lend_projection_field_write_body, v4_lend_projection_field_write_place)
say "projection-index-read-kind=" + v4_mir_rvalue_kind(v4_lend_projection_mir, v4_lend_projection_index_read_body, v4_lend_projection_index_read_rvalue)
say "projection-index-read-ty=" + v4_mir_rvalue_ty(v4_lend_projection_mir, v4_lend_projection_index_read_body, v4_lend_projection_index_read_rvalue)
say "projection-index-write-kind=" + v4_mir_place_kind(v4_lend_projection_mir, v4_lend_projection_index_write_body, v4_lend_projection_index_write_place)
say "projection-index-write-ty=" + v4_mir_place_ty(v4_lend_projection_mir, v4_lend_projection_index_write_body, v4_lend_projection_index_write_place)
say "projection-field-read-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_field_read_result)
say "projection-field-write-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_field_write_result)
say "projection-field-denied-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_field_denied_result)
say "projection-index-read-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_index_read_result)
say "projection-index-write-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_index_write_result)
say "projection-index-denied-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_index_denied_result)
say "projection-field-move-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_field_move_result)
say "projection-field-mut-move-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_field_mut_move_result)
say "projection-index-move-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_index_move_result)
say "projection-index-mut-move-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_index_mut_move_result)
say "projection-before-write-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_before_result)
say "projection-after-write-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_after_result)
say "projection-owned-field-move-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_owned_field_move_result)
say "projection-aggregate-lend-move-status=" + v4_borrowck_result_status(v4_lend_projection_borrow, v4_lend_projection_aggregate_lend_move_result)
say "projection-diagnostics=" + word_from_int(v4_borrowck_diag_count(v4_lend_projection_borrow))
say "projection-immutable-write-diagnostics=" + word_from_int(v4_lend_projection_diag_count(v4_lend_projection_borrow, "Meiya refuses to mutate through an immutable lend"))
say "projection-holder-move-diagnostics=" + word_from_int(v4_lend_projection_diag_count(v4_lend_projection_borrow, "Meiya refuses to move out through a lend holder"))
say "projection-owner-read-diagnostics=" + word_from_int(v4_lend_projection_diag_count(v4_lend_projection_borrow, "Meiya refuses observation through an exclusive lend"))
