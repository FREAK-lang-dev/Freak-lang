-- V4 MIR fixed-array literal smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_array_literal_good_source() -> word {
    pilot src = "task take(values: [int; 3]) -> int {\n"
    src = src + "    give back values[1]\n"
    src = src + "}\n"
    src = src + "task make() -> [int; 2] {\n"
    src = src + "    give back [4, 6]\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot trio: [int; 3] = [1, 2, 3]\n"
    src = src + "    pilot levels: [num; 3] = [1, 2, 3]\n"
    src = src + "    pilot zeros = [0; 4]\n"
    src = src + "    pilot grid: [[num; 2]; 2] = [[0; 2]; 2]\n"
    src = src + "    pilot echoed = take([7, 8, 9])\n"
    src = src + "    pilot made = make()\n"
    src = src + "    trio = [echoed, trio[0], trio[2]]\n"
    src = src + "    pilot corner = grid[1][1]\n"
    src = src + "    pilot second = made[1]\n"
    src = src + "    give back trio[0] + second\n"
    src = src + "}\n"
    give back src
}

task v4_mir_array_literal_bad_length_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot trio: [int; 3] = [1, 2]\n"
    src = src + "}\n"
    give back src
}

task v4_mir_array_literal_bad_element_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot trio: [int; 2] = [1, \"oops\"]\n"
    src = src + "}\n"
    give back src
}

task v4_mir_array_literal_bad_repeat_type_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot zeros = [0; false]\n"
    src = src + "}\n"
    give back src
}

task v4_mir_array_literal_bad_repeat_const_source() -> word {
    pilot src = "task bad(count: int) -> void {\n"
    src = src + "    pilot zeros = [0; count]\n"
    src = src + "}\n"
    give back src
}

task v4_mir_array_literal_bad_repeat_negative_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot zeros = [0; -1]\n"
    src = src + "}\n"
    give back src
}

