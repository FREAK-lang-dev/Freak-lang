pilot v4_contract_region_elided_query_before_source0 = v4_ty_signature_borrowed_return_source_param_at(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, 0)
pilot v4_contract_region_elided_query_before_source1 = v4_ty_signature_borrowed_return_source_param_at(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, 1)
pilot v4_contract_region_elided_query_before_call_source0 = v4_mir_rvalue_call_borrowed_source_arg_at(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call, 0)
pilot v4_contract_region_elided_query_before_call_source1 = v4_mir_rvalue_call_borrowed_source_arg_at(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call, 1)
say "contract-region-elided-query-before-diagnostics=" + word_from_int(v4_contract_region_elided_query_before_diag_count)
