pilot v4_contract_region_elided_query_borrowck_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "borrowck")
pilot v4_contract_region_elided_query_diagnostics_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "diagnostics")
pilot v4_contract_region_elided_query_editor_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "editor")
pilot v4_contract_region_elided_query_semantic_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "semantic-at")
pilot v4_contract_region_elided_query_hover_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "hover")
pilot v4_contract_region_elided_query_definition_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "definition-at")
