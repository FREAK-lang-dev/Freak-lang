-- V4 elided returned-loan source-set query invalidation fixture.
-- Verification prepends the V4 crates before this file.
-- Replacing "lend " with five spaces preserves every downstream editor offset.

task v4_contract_region_elided_query_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    repeat until token_id >= v4_lex_token_count(stream_id) {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_contract_region_elided_query_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_contract_region_elided_query_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0 - 1
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_contract_region_elided_query_find_call(mir_id: int, body_id: int) -> int {
    pilot stmt_id = 0
    repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
        pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
        if rvalue_id >= 0 {
            if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_call {
                give back rvalue_id
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_contract_region_elided_query_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_contract_region_elided_query_source(second_mode: word) -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task choose(lend first: Ship, " + second_mode + "second: Ship) -> lend Ship {\n"
    src = src + "    give back lend first\n"
    src = src + "}\n"
    src = src + "task observe(first: Ship, second: Ship) -> int {\n"
    src = src + "    pilot view = choose(lend first, " + second_mode + "second)\n"
    src = src + "    give back view.hp\n"
    src = src + "}\n"
    give back src
}

pilot v4_contract_region_elided_query_path = "contract-region-elided-query-invalidation.fk"
pilot v4_contract_region_elided_query_before = v4_contract_region_elided_query_source("lend ")
pilot v4_contract_region_elided_query_before_stream = v4_lex_text(0, v4_contract_region_elided_query_before)
pilot v4_contract_region_elided_query_before_second_offset = v4_contract_region_elided_query_offset(v4_contract_region_elided_query_before_stream, "second", 0)

v4_lsp_open_document(v4_contract_region_elided_query_path, v4_contract_region_elided_query_before)
pilot v4_contract_region_elided_query_before_borrow = v4_borrowck_text_cached(v4_contract_region_elided_query_path, v4_contract_region_elided_query_before)
pilot v4_contract_region_elided_query_before_mir = v4_borrowck_mir_id(v4_contract_region_elided_query_before_borrow)
pilot v4_contract_region_elided_query_before_ty = v4_mir_ty_id(v4_contract_region_elided_query_before_mir)
pilot v4_contract_region_elided_query_before_resolve = v4_ty_resolve_id(v4_contract_region_elided_query_before_ty)
