pilot v4_contract_region_elided_query_before_source1 = v4_ty_signature_borrowed_return_source_param_at(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, 1)
pilot v4_contract_region_elided_query_before_call_source0 = v4_mir_rvalue_call_borrowed_source_arg_at(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call, 0)
pilot v4_contract_region_elided_query_before_call_source1 = v4_mir_rvalue_call_borrowed_source_arg_at(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call, 1)
pilot v4_contract_region_elided_query_before_observe_sig = v4_ty_lookup_signature(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_observe_def)
pilot v4_contract_region_elided_query_ty_original_def = v4_ty_signature_def(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_original_kind = v4_ty_signature_kind(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_original_name = v4_ty_signature_name(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_original_display = v4_ty_signature_display(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_original_hir_item = v4_ty_signature_hir_item(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_poison_hir_item = v4_ty_signature_hir_item(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_observe_sig)

-- Exercise restore against real signature mutation, not a no-op rewrite.
pilot v4_contract_region_elided_query_ty_cache_builds_before_poison = v4_ty_borrowed_return_source_cache_build_count()
pilot v4_contract_region_elided_query_ty_poison_slot_result = v4_ty_restore_signature_slot(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, v4_contract_region_elided_query_ty_original_def, v4_contract_region_elided_query_ty_original_kind, v4_contract_region_elided_query_ty_original_name, v4_contract_region_elided_query_ty_original_display, v4_contract_region_elided_query_ty_poison_hir_item)
pilot v4_contract_region_elided_query_ty_poison_live_hir_item = v4_ty_signature_hir_item(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_poisoned_source_count = v4_ty_signature_borrowed_return_source_param_count(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_cache_builds_after_poison = v4_ty_borrowed_return_source_cache_build_count()
pilot v4_contract_region_elided_query_ty_restore_poisoned = v4_contract_region_elided_query_ty_poison_slot_result == 1 and v4_contract_region_elided_query_ty_poison_hir_item != v4_contract_region_elided_query_ty_original_hir_item and v4_contract_region_elided_query_ty_poison_live_hir_item == v4_contract_region_elided_query_ty_poison_hir_item and v4_contract_region_elided_query_ty_poisoned_source_count == 0 and v4_contract_region_elided_query_ty_cache_builds_after_poison - v4_contract_region_elided_query_ty_cache_builds_before_poison == 1

pilot v4_contract_region_elided_query_ty_cache_builds_before_restore = v4_ty_borrowed_return_source_cache_build_count()
pilot v4_contract_region_elided_query_ty_restore_slot_result = v4_ty_restore_signature_slot(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, v4_contract_region_elided_query_ty_original_def, v4_contract_region_elided_query_ty_original_kind, v4_contract_region_elided_query_ty_original_name, v4_contract_region_elided_query_ty_original_display, v4_contract_region_elided_query_ty_original_hir_item)
pilot v4_contract_region_elided_query_ty_restored_fields_exact = v4_ty_signature_def(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig) == v4_contract_region_elided_query_ty_original_def and v4_ty_signature_kind(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig) == v4_contract_region_elided_query_ty_original_kind and v4_ty_signature_name(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig) == v4_contract_region_elided_query_ty_original_name and v4_ty_signature_display(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig) == v4_contract_region_elided_query_ty_original_display and v4_ty_signature_hir_item(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig) == v4_contract_region_elided_query_ty_original_hir_item
pilot v4_contract_region_elided_query_ty_restored_source_count = v4_ty_signature_borrowed_return_source_param_count(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
pilot v4_contract_region_elided_query_ty_restored_source0 = v4_ty_signature_borrowed_return_source_param_at(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, 0)
pilot v4_contract_region_elided_query_ty_restored_source1 = v4_ty_signature_borrowed_return_source_param_at(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, 1)
pilot v4_contract_region_elided_query_ty_cache_builds_added = v4_ty_borrowed_return_source_cache_build_count() - v4_contract_region_elided_query_ty_cache_builds_before_restore
say "contract-region-elided-query-before-diagnostics=" + word_from_int(v4_contract_region_elided_query_before_diag_count)
if v4_contract_region_elided_query_before_diag_count > 0 {
    say "contract-region-elided-query-before-message=" + v4_diag_message(v4_diagnostics_diag(v4_contract_region_elided_query_before_diagnostics, 0))
} else {
    say "contract-region-elided-query-before-message=none"
}
say "contract-region-elided-query-before-choose-status=" + v4_borrowck_result_status(v4_contract_region_elided_query_before_borrow, v4_contract_region_elided_query_before_choose_result)
say "contract-region-elided-query-before-observe-status=" + v4_borrowck_result_status(v4_contract_region_elided_query_before_borrow, v4_contract_region_elided_query_before_observe_result)
say "contract-region-elided-query-before-source-count=" + word_from_int(v4_contract_region_elided_query_before_source_count)
say "contract-region-elided-query-before-source0=" + v4_ty_signature_param_name(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, v4_contract_region_elided_query_before_source0)
say "contract-region-elided-query-before-source1=" + v4_ty_signature_param_name(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, v4_contract_region_elided_query_before_source1)
say "contract-region-elided-query-before-call-source-count=" + word_from_int(v4_mir_rvalue_call_borrowed_source_arg_count(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call))
say "contract-region-elided-query-before-call-source0=" + v4_mir_rvalue_text(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call_source0)
say "contract-region-elided-query-before-call-source1=" + v4_mir_rvalue_text(v4_contract_region_elided_query_before_mir, v4_contract_region_elided_query_before_observe_body, v4_contract_region_elided_query_before_call_source1)
say "contract-region-elided-query-before-semantic=" + v4_semantic_at_type(v4_contract_region_elided_query_before_semantic)
say "contract-region-elided-query-before-hover=" + v4_hover_type(v4_contract_region_elided_query_before_hover)
say "contract-region-elided-query-before-definition=" + word_from_int(v4_definition_at_found(v4_contract_region_elided_query_before_definition))
say "contract-region-elided-query-ty-restore-poisoned=" + v4_contract_region_elided_query_bool(v4_contract_region_elided_query_ty_restore_poisoned)
say "contract-region-elided-query-ty-restore-slot-applied=" + v4_contract_region_elided_query_bool(v4_contract_region_elided_query_ty_restore_slot_result == 1 and v4_contract_region_elided_query_ty_restored_fields_exact)
say "contract-region-elided-query-ty-restored-source-count=" + word_from_int(v4_contract_region_elided_query_ty_restored_source_count)
say "contract-region-elided-query-ty-restored-source0=" + v4_ty_signature_param_name(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, v4_contract_region_elided_query_ty_restored_source0)
say "contract-region-elided-query-ty-restored-source1=" + v4_ty_signature_param_name(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig, v4_contract_region_elided_query_ty_restored_source1)
say "contract-region-elided-query-ty-restored-source-order-stable=" + v4_contract_region_elided_query_bool(v4_contract_region_elided_query_ty_restored_source_count == v4_contract_region_elided_query_before_source_count and v4_contract_region_elided_query_ty_restored_source0 == v4_contract_region_elided_query_before_source0 and v4_contract_region_elided_query_ty_restored_source1 == v4_contract_region_elided_query_before_source1)
say "contract-region-elided-query-ty-restore-cache-builds-added=" + word_from_int(v4_contract_region_elided_query_ty_cache_builds_added)

pilot v4_contract_region_elided_query_after = v4_contract_region_elided_query_source("     ")
