pilot v4_contract_region_elided_query_completion_misses_before = v4_contract_region_elided_query_family_misses(v4_contract_region_elided_query_path, "completion")

pilot v4_contract_region_elided_query_before_diag_count = v4_diagnostics_count(v4_contract_region_elided_query_before_diagnostics)
pilot v4_contract_region_elided_query_before_source_count = v4_ty_signature_borrowed_return_source_param_count(v4_contract_region_elided_query_before_ty, v4_contract_region_elided_query_before_choose_sig)
