-- V4 root fixed-pilot const task call smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_global_const_task_call_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_global_const_task_call_source() -> word {
    pilot src = "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "@const task bump(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "@const task pack<T>(value: T) -> Box<T> {\n"
    src = src + "    give back Box " + v4_global_const_task_call_braces(" value: value ") + "\n"
    src = src + "}\n"
    src = src + "task runtime_only(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot BOOSTED = bump(BASE)\n"
    src = src + "fixed pilot PACKED = pack(BASE)\n"
    src = src + "fixed pilot BAD_RUNTIME = runtime_only(BASE)\n"
    src = src + "fixed pilot BAD_ARITY = bump()\n"
    src = src + "fixed pilot BAD_TYPE = bump(\"ace\")\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back BOOSTED\n"
    src = src + "}\n"
    give back src
}

pilot v4_global_const_task_call_stream = v4_lex_text(0, v4_global_const_task_call_source())
pilot v4_global_const_task_call_tree = v4_parse_stream(0, v4_global_const_task_call_stream)
pilot v4_global_const_task_call_hir = v4_hir_lower_tree(0, v4_global_const_task_call_tree)
pilot v4_global_const_task_call_resolve = v4_resolve_lower_hir(0, v4_global_const_task_call_hir)
pilot v4_global_const_task_call_ty = v4_ty_lower_resolve(0, v4_global_const_task_call_resolve)

pilot v4_global_const_task_call_boosted_def = v4_resolve_def_for_name(v4_global_const_task_call_resolve, "BOOSTED")
pilot v4_global_const_task_call_packed_def = v4_resolve_def_for_name(v4_global_const_task_call_resolve, "PACKED")
pilot v4_global_const_task_call_boosted_sig = v4_ty_lookup_signature(v4_global_const_task_call_ty, v4_global_const_task_call_boosted_def)
pilot v4_global_const_task_call_packed_sig = v4_ty_lookup_signature(v4_global_const_task_call_ty, v4_global_const_task_call_packed_def)

say "global-const-task-call-boosted-display=" + v4_ty_signature_display(v4_global_const_task_call_ty, v4_global_const_task_call_boosted_sig)
say "global-const-task-call-boosted-value-type=" + v4_ty_const_value_type_for_sig(v4_global_const_task_call_ty, v4_global_const_task_call_boosted_sig)
say "global-const-task-call-packed-display=" + v4_ty_signature_display(v4_global_const_task_call_ty, v4_global_const_task_call_packed_sig)
say "global-const-task-call-packed-value-type=" + v4_ty_const_value_type_for_sig(v4_global_const_task_call_ty, v4_global_const_task_call_packed_sig)
say "global-const-task-call-diag-count=" + word_from_int(v4_ty_diag_count(v4_global_const_task_call_ty))

pilot v4_global_const_task_call_diag_idx = 0
repeat until v4_global_const_task_call_diag_idx >= v4_ty_diag_count(v4_global_const_task_call_ty) {
    pilot v4_global_const_task_call_diag = v4_ty_diag(v4_global_const_task_call_ty, v4_global_const_task_call_diag_idx)
    say "global-const-task-call-diag" + word_from_int(v4_global_const_task_call_diag_idx) + "=" + v4_diag_message(v4_global_const_task_call_diag)
    say "global-const-task-call-diag" + word_from_int(v4_global_const_task_call_diag_idx) + "-help=" + v4_diag_help(v4_global_const_task_call_diag)
    v4_global_const_task_call_diag_idx += 1
}
