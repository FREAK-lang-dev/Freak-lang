pilot v4_mir_map_access_bad_key_write_tree = v4_parse_stream(2, v4_mir_map_access_bad_key_write_stream)
pilot v4_mir_map_access_bad_key_write_hir = v4_hir_lower_tree(2, v4_mir_map_access_bad_key_write_tree)
pilot v4_mir_map_access_bad_key_write_resolve = v4_resolve_lower_hir(2, v4_mir_map_access_bad_key_write_hir)
pilot v4_mir_map_access_bad_key_write_ty = v4_ty_lower_resolve(2, v4_mir_map_access_bad_key_write_resolve)
