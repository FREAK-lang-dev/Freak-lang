pilot v4_mir_map_access_bad_value_write_stream = v4_lex_text(3, v4_mir_map_access_bad_value_write_source())
pilot v4_mir_map_access_bad_value_write_tree = v4_parse_stream(3, v4_mir_map_access_bad_value_write_stream)
pilot v4_mir_map_access_bad_value_write_hir = v4_hir_lower_tree(3, v4_mir_map_access_bad_value_write_tree)
