-- V4 definition-at arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_definition_snapshot_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_definition_snapshot_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_definition_snapshot_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_definition_snapshot_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_definition_snapshot_fixture_first_id(payload: word, replacement_id: int) -> word {
    pilot out = ""
    pilot replaced = 0
    pilot line_id = 0
    pilot line_count = v4_definition_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_definition_snapshot_line(payload, line_id)
        pilot output_line = line
        if replaced == 0 and v4_definition_snapshot_field_raw(line, 0) == "definition" {
            output_line = "definition|" + word_from_int(replacement_id)
            pilot field_id = 2
            pilot field_count = v4_definition_snapshot_field_count(line)
            repeat until field_id >= field_count {
                output_line = output_line + "|" + v4_definition_snapshot_field_raw(line, field_id)
                field_id += 1
            }
            replaced = 1
        }
        if out != "" { out = out + "\n" }
        out = out + output_line
        line_id += 1
    }
    give back out
}

task v4_definition_snapshot_negative_id_atomic(payload: word) -> word {
    pilot expected_state = v4_definition_snapshot()
    pilot invalid_payload = v4_definition_snapshot_fixture_first_id(payload, 0 - 1)
    pilot restore_result = v4_definition_snapshot_restore(invalid_payload)
    give back "definition-snapshot-negative-id-atomic=" + v4_definition_snapshot_bool_word(restore_result.starts_with("definition-snapshot-restore ok=0 ") and v4_definition_snapshot() == expected_state)
}

task v4_definition_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_definition_snapshot_source_text() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "    task pack(level: int) -> Pilot {\n"
    src = src + "        give back Pilot " + v4_definition_snapshot_braces(" rank: level ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_definition_snapshot_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task util::math::double(value: int) -> int {\n"
    src = src + "    give back value + value\n"
    src = src + "}\n"
    src = src + "use util::math::*\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "doctrine Displayable {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "doctrine Ranked {\n"
    src = src + "    task rank(self) -> int\n"
    src = src + "}\n"
    src = src + "shape Wing {\n"
    src = src + "    callsign: word\n"
    src = src + "    score: int\n"
    src = src + "}\n"
    src = src + "impl Displayable for Wing {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back self.callsign\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Ranked for Wing {\n"
    src = src + "    task rank(self) -> int {\n"
    src = src + "        give back self.score\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task show<T: Displayable + Ranked>(value: T) -> word {\n"
    src = src + "    pilot score = value.rank()\n"
    src = src + "    give back value.display()\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot::pack(level: 7)\n"
    src = src + "    pilot event = Event::Key " + v4_definition_snapshot_braces(" code: 9 ") + "\n"
    src = src + "    pilot doubled = double(2)\n"
    src = src + "    give back ace.salute() + doubled + CELLS\n"
    src = src + "}\n"
    src = src + "task mix(count: uint, marker: char) -> float32 {\n"
    src = src + "    give back 1.5\n"
    src = src + "}\n"
    give back src
}

pilot v4_definition_snapshot_source = v4_definition_snapshot_source_text()
pilot v4_definition_snapshot_stream = v4_lex_text(0, v4_definition_snapshot_source)
pilot v4_definition_snapshot_salute_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "salute", 1)
pilot v4_definition_snapshot_param_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "level", 2)
pilot v4_definition_snapshot_variant_case_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "Key", 1)
pilot v4_definition_snapshot_builtin_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "float32", 0)
pilot v4_definition_snapshot_glob_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "double", 1)
pilot v4_definition_snapshot_const_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "CELLS", 1)
pilot v4_definition_snapshot_bound_offset = v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "display", 2)

pilot v4_definition_snapshot_method = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_salute_offset)
pilot v4_definition_snapshot_param = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_param_offset)
pilot v4_definition_snapshot_variant_case = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_variant_case_offset)
pilot v4_definition_snapshot_builtin = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_builtin_offset)
pilot v4_definition_snapshot_glob = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_glob_offset)
pilot v4_definition_snapshot_const = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_const_offset)
pilot v4_definition_snapshot_bound = v4_definition_at_text_cached("definition-snapshot.fk", v4_definition_snapshot_source, v4_definition_snapshot_bound_offset)
say v4_definition_at_summary(v4_definition_snapshot_method)
say v4_definition_snapshot_summary()

pilot v4_definition_snapshot_payload = v4_definition_snapshot()
say v4_definition_snapshot_validate(v4_definition_snapshot_payload)
say "definition-snapshot-bytes=" + word_from_int(v4_definition_snapshot_payload.length())
say v4_definition_snapshot_negative_id_atomic(v4_definition_snapshot_payload)
say v4_definition_snapshot_definition_line(v4_definition_snapshot_method)
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
say v4_ty_snapshot_restore(v4_ty_snapshot())
say v4_semantic_snapshot_restore(v4_semantic_snapshot())
say v4_definition_snapshot_restore(v4_definition_snapshot_payload)
say v4_lsp_definition_snapshot_text()
say v4_lsp_definition_snapshot_restore_text(v4_definition_snapshot_payload)
say v4_lsp_handle_text_request("workspace/definitionSnapshotRestore", "definition-snapshot.fk", v4_definition_snapshot_payload, 0)

pilot v4_definition_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_definition_query_payload)
say v4_driver_confirm_restored_document_text("definition-snapshot.fk", v4_definition_snapshot_source)
pilot v4_definition_file = v4_source_find("definition-snapshot.fk")
pilot v4_definition_fingerprint = v4_source_fingerprint(v4_definition_file)
pilot v4_definition_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_salute_offset), v4_definition_fingerprint))
pilot v4_definition_param_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_param_offset), v4_definition_fingerprint))
pilot v4_definition_variant_case_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_variant_case_offset), v4_definition_fingerprint))
pilot v4_definition_builtin_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_builtin_offset), v4_definition_fingerprint))
pilot v4_definition_glob_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_glob_offset), v4_definition_fingerprint))
pilot v4_definition_const_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_const_offset), v4_definition_fingerprint))
pilot v4_definition_bound_restored_id = word_to_int(v4_query_get(v4_definition_at_query_key("definition-snapshot.fk", v4_definition_snapshot_bound_offset), v4_definition_fingerprint))
say v4_definition_at_summary(v4_definition_restored_id)
say "definition-snapshot-method-kind=" + v4_definition_at_kind(v4_definition_snapshot_method)
say "definition-snapshot-method-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_method))
say "definition-snapshot-restored-kind=" + v4_definition_at_kind(v4_definition_restored_id)
say "definition-snapshot-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_restored_id))
say "definition-snapshot-restored-matches=" + v4_definition_snapshot_bool_word(v4_span_start(v4_definition_at_span(v4_definition_restored_id)) == v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "salute", 0))
say "definition-snapshot-param-kind=" + v4_definition_at_kind(v4_definition_snapshot_param)
say "definition-snapshot-param-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_param))
say "definition-snapshot-param-restored-kind=" + v4_definition_at_kind(v4_definition_param_restored_id)
say "definition-snapshot-param-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_param_restored_id))
say "definition-snapshot-param-restored-matches=" + v4_definition_snapshot_bool_word(v4_span_start(v4_definition_at_span(v4_definition_param_restored_id)) == v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "level", 0))
say "definition-snapshot-variant-case-kind=" + v4_definition_at_kind(v4_definition_snapshot_variant_case)
say "definition-snapshot-variant-case-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_variant_case))
say "definition-snapshot-variant-case-restored-kind=" + v4_definition_at_kind(v4_definition_variant_case_restored_id)
say "definition-snapshot-variant-case-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_variant_case_restored_id))
say "definition-snapshot-variant-case-restored-matches=" + v4_definition_snapshot_bool_word(v4_span_start(v4_definition_at_span(v4_definition_variant_case_restored_id)) == v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "Key", 0))
say "definition-snapshot-builtin-kind=" + v4_definition_at_kind(v4_definition_snapshot_builtin)
say "definition-snapshot-builtin-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_builtin))
say "definition-snapshot-builtin-def=" + v4_definition_at_def(v4_definition_snapshot_builtin)
say "definition-snapshot-builtin-restored-kind=" + v4_definition_at_kind(v4_definition_builtin_restored_id)
say "definition-snapshot-builtin-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_builtin_restored_id))
say "definition-snapshot-builtin-restored-def=" + v4_definition_at_def(v4_definition_builtin_restored_id)
say "definition-snapshot-glob-kind=" + v4_definition_at_kind(v4_definition_snapshot_glob)
say "definition-snapshot-glob-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_glob))
say "definition-snapshot-glob-restored-kind=" + v4_definition_at_kind(v4_definition_glob_restored_id)
say "definition-snapshot-glob-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_glob_restored_id))
say "definition-snapshot-glob-restored-matches=" + v4_definition_snapshot_bool_word(v4_span_start(v4_definition_at_span(v4_definition_glob_restored_id)) == v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "double", 0))
say "definition-snapshot-const-kind=" + v4_definition_at_kind(v4_definition_snapshot_const)
say "definition-snapshot-const-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_const))
say "definition-snapshot-const-restored-kind=" + v4_definition_at_kind(v4_definition_const_restored_id)
say "definition-snapshot-const-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_const_restored_id))
say "definition-snapshot-const-restored-matches=" + v4_definition_snapshot_bool_word(v4_span_start(v4_definition_at_span(v4_definition_const_restored_id)) == v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "CELLS", 0))
say "definition-snapshot-bound-kind=" + v4_definition_at_kind(v4_definition_snapshot_bound)
say "definition-snapshot-bound-found=" + word_from_int(v4_definition_at_found(v4_definition_snapshot_bound))
say "definition-snapshot-bound-restored-kind=" + v4_definition_at_kind(v4_definition_bound_restored_id)
say "definition-snapshot-bound-restored-found=" + word_from_int(v4_definition_at_found(v4_definition_bound_restored_id))
say "definition-snapshot-bound-restored-matches=" + v4_definition_snapshot_bool_word(v4_span_start(v4_definition_at_span(v4_definition_bound_restored_id)) == v4_definition_snapshot_token_offset(v4_definition_snapshot_stream, "display", 0))
say v4_driver_confirm_restored_document_text("definition-snapshot.fk", "task changed() => 7\n")
