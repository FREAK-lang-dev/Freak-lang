-- V4 semantic-core editor visibility smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_semantic_core_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_semantic_core_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_semantic_core_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_semantic_core_editor_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_semantic_core_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_semantic_core_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_semantic_core_editor_completion_kind_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_kind(completion_id, item_id)
}

task v4_semantic_core_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_semantic_core_editor_source_text() -> word {
    pilot src = "variant Event {\n"
    src = src + "    Key " + v4_semantic_core_editor_braces(" code: int ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "alias Score = int\n"
    src = src + "task score(event: Event, base: Score) -> Score {\n"
    src = src + "    when event {\n"
    src = src + "        Event::Key " + v4_semantic_core_editor_braces(" code ") + " -> give back code\n"
    src = src + "        Event::Closed -> give back base\n"
    src = src + "    }\n"
    src = src + "    give back base\n"
    src = src + "}\n"
    give back src
}

pilot v4_semantic_core_editor_source = v4_semantic_core_editor_source_text()
pilot v4_semantic_core_editor_stream = v4_lex_text(0, v4_semantic_core_editor_source)

pilot v4_semantic_core_editor_event_offset = v4_semantic_core_editor_token_offset(v4_semantic_core_editor_stream, "Event", 0)
pilot v4_semantic_core_editor_score_use_offset = v4_semantic_core_editor_token_offset(v4_semantic_core_editor_stream, "Score", 1)

pilot v4_semantic_core_editor_route_sem = v4_semantic_at_text_cached("semantic-core-editor.fk", v4_semantic_core_editor_source, v4_semantic_core_editor_event_offset)
pilot v4_semantic_core_editor_alias_sem = v4_semantic_at_text_cached("semantic-core-editor.fk", v4_semantic_core_editor_source, v4_semantic_core_editor_score_use_offset)
pilot v4_semantic_core_editor_hover = v4_hover_text_cached("semantic-core-editor.fk", v4_semantic_core_editor_source, v4_semantic_core_editor_score_use_offset)
pilot v4_semantic_core_editor_definition = v4_definition_at_text_cached("semantic-core-editor.fk", v4_semantic_core_editor_source, v4_semantic_core_editor_score_use_offset)
pilot v4_semantic_core_editor_symbols = v4_document_symbols_text_cached("semantic-core-editor.fk", v4_semantic_core_editor_source)
pilot v4_semantic_core_editor_completion = v4_completion_text_cached("semantic-core-editor.fk", v4_semantic_core_editor_source, 0)

pilot v4_semantic_core_editor_variant_completion = v4_semantic_core_editor_find_completion_label(v4_semantic_core_editor_completion, "variant")
pilot v4_semantic_core_editor_route_completion = v4_semantic_core_editor_find_completion_label(v4_semantic_core_editor_completion, "route")
pilot v4_semantic_core_editor_alias_completion = v4_semantic_core_editor_find_completion_label(v4_semantic_core_editor_completion, "alias")

say v4_semantic_at_summary(v4_semantic_core_editor_route_sem)
say "semantic-core-route-name=" + v4_semantic_at_name(v4_semantic_core_editor_route_sem)
say "semantic-core-route-kind=" + v4_semantic_at_kind(v4_semantic_core_editor_route_sem)
say "semantic-core-route-type=" + v4_semantic_at_type(v4_semantic_core_editor_route_sem)
say "semantic-core-alias-name=" + v4_semantic_at_name(v4_semantic_core_editor_alias_sem)
say "semantic-core-alias-kind=" + v4_semantic_at_kind(v4_semantic_core_editor_alias_sem)
say "semantic-core-alias-type=" + v4_semantic_at_type(v4_semantic_core_editor_alias_sem)
say "semantic-core-hover-name=" + v4_hover_name(v4_semantic_core_editor_hover)
say "semantic-core-hover-kind=" + v4_hover_kind(v4_semantic_core_editor_hover)
say "semantic-core-hover-type=" + v4_hover_type(v4_semantic_core_editor_hover)
say "semantic-core-definition-kind=" + v4_definition_at_kind(v4_semantic_core_editor_definition)
say "semantic-core-definition-found=" + word_from_int(v4_definition_at_found(v4_semantic_core_editor_definition))
say "semantic-core-symbol-count=" + word_from_int(v4_document_symbol_count(v4_semantic_core_editor_symbols))
say "semantic-core-symbol0-name=" + v4_document_symbol_name(v4_semantic_core_editor_symbols, 0)
say "semantic-core-symbol0-kind=" + v4_document_symbol_kind(v4_semantic_core_editor_symbols, 0)
say "semantic-core-symbol0-type=" + v4_document_symbol_type(v4_semantic_core_editor_symbols, 0)
say "semantic-core-symbol1-name=" + v4_document_symbol_name(v4_semantic_core_editor_symbols, 1)
say "semantic-core-symbol1-kind=" + v4_document_symbol_kind(v4_semantic_core_editor_symbols, 1)
say "semantic-core-symbol1-type=" + v4_document_symbol_type(v4_semantic_core_editor_symbols, 1)
say "semantic-core-definition-matches-decl=" + v4_semantic_core_editor_bool_word(v4_span_start(v4_definition_at_span(v4_semantic_core_editor_definition)) == v4_span_start(v4_document_symbol_span(v4_semantic_core_editor_symbols, 1)))
say "semantic-core-completion-count=" + word_from_int(v4_completion_count(v4_semantic_core_editor_completion))
say "semantic-core-completion-variant-found=" + v4_semantic_core_editor_bool_word(v4_semantic_core_editor_variant_completion >= 0)
say "semantic-core-completion-variant-kind=" + v4_semantic_core_editor_completion_kind_or_empty(v4_semantic_core_editor_completion, v4_semantic_core_editor_variant_completion)
say "semantic-core-completion-variant-detail=" + v4_semantic_core_editor_completion_detail_or_empty(v4_semantic_core_editor_completion, v4_semantic_core_editor_variant_completion)
say "semantic-core-completion-route-found=" + v4_semantic_core_editor_bool_word(v4_semantic_core_editor_route_completion >= 0)
say "semantic-core-completion-route-kind=" + v4_semantic_core_editor_completion_kind_or_empty(v4_semantic_core_editor_completion, v4_semantic_core_editor_route_completion)
say "semantic-core-completion-route-detail=" + v4_semantic_core_editor_completion_detail_or_empty(v4_semantic_core_editor_completion, v4_semantic_core_editor_route_completion)
say "semantic-core-completion-alias-found=" + v4_semantic_core_editor_bool_word(v4_semantic_core_editor_alias_completion >= 0)
say "semantic-core-completion-alias-kind=" + v4_semantic_core_editor_completion_kind_or_empty(v4_semantic_core_editor_completion, v4_semantic_core_editor_alias_completion)
say "semantic-core-completion-alias-detail=" + v4_semantic_core_editor_completion_detail_or_empty(v4_semantic_core_editor_completion, v4_semantic_core_editor_alias_completion)
