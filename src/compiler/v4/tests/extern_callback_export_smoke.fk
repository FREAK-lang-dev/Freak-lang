say "extern-callback-export-bad-diag-count=" + word_from_int(v4_ty_diag_count(v4_extern_callback_export_bad_ty))
say "extern-callback-export-bad-diag0-message=" + v4_diag_message(v4_ty_diag(v4_extern_callback_export_bad_ty, 0))
