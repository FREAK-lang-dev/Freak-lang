task v4_extern_callback_export_coerce_good_source() -> word {
    pilot src = "@extern_callback(\"C\")\n"
    src = src + "task on_tick(seed: std::ffi::c_int) -> std::ffi::c_int {\n"
    src = src + "    give back seed\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task install(cb: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task wire() -> std::ffi::c_int {\n"
    src = src + "    pilot rc = install(on_tick)\n"
    src = src + "    give back rc\n"
    src = src + "}\n"
    give back src
}

task v4_extern_callback_export_coerce_bad_source() -> word {
    pilot src = "task plain_task(seed: std::ffi::c_int) -> std::ffi::c_int {\n"
    src = src + "    give back seed\n"
    src = src + "}\n"
    src = src + "@extern_callback(\"system\")\n"
    src = src + "task system_task(seed: std::ffi::c_int) -> std::ffi::c_int {\n"
    src = src + "    give back seed\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task install(cb: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task wire_plain() -> std::ffi::c_int {\n"
    src = src + "    give back install(plain_task)\n"
    src = src + "}\n"
    src = src + "task wire_mismatch() -> std::ffi::c_int {\n"
    src = src + "    give back install(system_task)\n"
    src = src + "}\n"
    give back src
}

