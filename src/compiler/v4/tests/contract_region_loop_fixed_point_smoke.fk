-- V4 loop-carried returned-loan provenance fixed-point fixture.
-- Verification prepends the V4 crates before this file.
-- One cached borrowck request owns the only compiler pipeline in this executable.

task v4_contract_region_loop_fixed_point_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task direct_loop<'a>(lend 'a first: Ship, lend 'a second: Ship, ready: bool) -> lend 'a Ship {\n"
    src = src + "    pilot view = lend first\n"
    src = src + "    pilot finished = ready\n"
    src = src + "    repeat until finished {\n"
    src = src + "        view = lend second\n"
    src = src + "        finished = true\n"
    src = src + "    }\n"
    src = src + "    give back view\n"
    src = src + "}\n"
    src = src + "task alias_cycle<'a>(lend 'a first: Ship, lend 'a second: Ship, ready: bool) -> lend 'a Ship {\n"
    src = src + "    pilot view = lend first\n"
    src = src + "    pilot relay = lend second\n"
    src = src + "    pilot finished = ready\n"
    src = src + "    repeat until finished {\n"
    src = src + "        view = relay\n"
    src = src + "        relay = view\n"
    src = src + "        finished = true\n"
    src = src + "    }\n"
    src = src + "    give back view\n"
    src = src + "}\n"
    src = src + "task dedup_loop<'a>(lend 'a source: Ship, ready: bool) -> lend 'a Ship {\n"
    src = src + "    pilot view = lend source\n"
    src = src + "    pilot finished = ready\n"
    src = src + "    repeat until finished {\n"
    src = src + "        view = lend source\n"
    src = src + "        finished = true\n"
    src = src + "    }\n"
    src = src + "    give back view\n"
    src = src + "}\n"
    src = src + "task long_alias_ring<'a>("
    pilot ring_id = 0
    repeat until ring_id >= 12 {
        if ring_id > 0 {
            src = src + ", "
        }
        src = src + "lend 'a source" + word_from_int(ring_id) + ": Ship"
        ring_id += 1
    }
    src = src + ", ready: bool) -> lend 'a Ship {\n"
    ring_id = 0
    repeat until ring_id >= 12 {
        src = src + "    pilot view" + word_from_int(ring_id) + " = lend source" + word_from_int(ring_id) + "\n"
        ring_id += 1
    }
    src = src + "    pilot finished = ready\n"
    src = src + "    repeat until finished {\n"
    ring_id = 0
    repeat until ring_id >= 12 {
        pilot next_id = ring_id + 1
        if next_id >= 12 {
            next_id = 0
        }
        src = src + "        view" + word_from_int(ring_id) + " = view" + word_from_int(next_id) + "\n"
        ring_id += 1
    }
    src = src + "        finished = true\n"
    src = src + "    }\n"
    src = src + "    give back view0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_loop_fixed_point_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_contract_region_loop_fixed_point_return_source_at(borrow_id: int, result_id: int, wanted: int) -> word {
    pilot seen = 0
    pilot path_id = 0
    repeat until path_id >= v4_borrowck_result_path_count(borrow_id, result_id) {
        if v4_borrowck_path_kind(borrow_id, result_id, path_id) == v4_borrowck_path_return_loan {
            if seen == wanted {
                give back v4_borrowck_path_text(borrow_id, result_id, path_id)
            }
            seen += 1
        }
        path_id += 1
    }
    give back ""
}

task v4_contract_region_loop_fixed_point_has_source(borrow_id: int, result_id: int, wanted: word) -> bool {
    pilot path_id = 0
    repeat until path_id >= v4_borrowck_result_path_count(borrow_id, result_id) {
        if v4_borrowck_path_kind(borrow_id, result_id, path_id) == v4_borrowck_path_return_loan and v4_borrowck_path_text(borrow_id, result_id, path_id) == wanted {
            give back true
        }
        path_id += 1
    }
    give back false
}

pilot v4_contract_region_loop_fixed_point_path = "contract-region-loop-fixed-point.fk"
pilot v4_contract_region_loop_fixed_point_borrow = v4_borrowck_text_cached(v4_contract_region_loop_fixed_point_path, v4_contract_region_loop_fixed_point_source())
pilot v4_contract_region_loop_fixed_point_mir = v4_borrowck_mir_id(v4_contract_region_loop_fixed_point_borrow)
pilot v4_contract_region_loop_fixed_point_ty = v4_mir_ty_id(v4_contract_region_loop_fixed_point_mir)
pilot v4_contract_region_loop_fixed_point_resolve = v4_ty_resolve_id(v4_contract_region_loop_fixed_point_ty)
pilot v4_contract_region_loop_fixed_point_direct_def = v4_resolve_def_for_name(v4_contract_region_loop_fixed_point_resolve, "direct_loop")
pilot v4_contract_region_loop_fixed_point_alias_def = v4_resolve_def_for_name(v4_contract_region_loop_fixed_point_resolve, "alias_cycle")
pilot v4_contract_region_loop_fixed_point_dedup_def = v4_resolve_def_for_name(v4_contract_region_loop_fixed_point_resolve, "dedup_loop")
pilot v4_contract_region_loop_fixed_point_ring_def = v4_resolve_def_for_name(v4_contract_region_loop_fixed_point_resolve, "long_alias_ring")
pilot v4_contract_region_loop_fixed_point_direct_result = v4_borrowck_lookup_result(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_direct_def)
pilot v4_contract_region_loop_fixed_point_alias_result = v4_borrowck_lookup_result(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_alias_def)
pilot v4_contract_region_loop_fixed_point_dedup_result = v4_borrowck_lookup_result(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_dedup_def)
pilot v4_contract_region_loop_fixed_point_ring_result = v4_borrowck_lookup_result(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_ring_def)

say "contract-region-loop-fixed-point-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_contract_region_loop_fixed_point_ty))
say "contract-region-loop-fixed-point-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_contract_region_loop_fixed_point_mir))
say "contract-region-loop-fixed-point-borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(v4_contract_region_loop_fixed_point_borrow))
say "contract-region-loop-fixed-point-direct-status=" + v4_borrowck_result_status(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_direct_result)
say "contract-region-loop-fixed-point-direct-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_direct_result, v4_borrowck_path_return_loan))
say "contract-region-loop-fixed-point-direct-source0=" + v4_contract_region_loop_fixed_point_return_source_at(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_direct_result, 0)
say "contract-region-loop-fixed-point-direct-source1=" + v4_contract_region_loop_fixed_point_return_source_at(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_direct_result, 1)
say "contract-region-loop-fixed-point-alias-status=" + v4_borrowck_result_status(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_alias_result)
say "contract-region-loop-fixed-point-alias-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_alias_result, v4_borrowck_path_return_loan))
say "contract-region-loop-fixed-point-alias-has-first=" + v4_contract_region_loop_fixed_point_bool(v4_contract_region_loop_fixed_point_has_source(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_alias_result, "first"))
say "contract-region-loop-fixed-point-alias-has-second=" + v4_contract_region_loop_fixed_point_bool(v4_contract_region_loop_fixed_point_has_source(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_alias_result, "second"))
say "contract-region-loop-fixed-point-dedup-status=" + v4_borrowck_result_status(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_dedup_result)
say "contract-region-loop-fixed-point-dedup-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_dedup_result, v4_borrowck_path_return_loan))
say "contract-region-loop-fixed-point-dedup-source0=" + v4_contract_region_loop_fixed_point_return_source_at(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_dedup_result, 0)
say "contract-region-loop-fixed-point-ring-status=" + v4_borrowck_result_status(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_ring_result)
say "contract-region-loop-fixed-point-ring-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_ring_result, v4_borrowck_path_return_loan))
say "contract-region-loop-fixed-point-ring-source0=" + v4_contract_region_loop_fixed_point_return_source_at(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_ring_result, 0)
say "contract-region-loop-fixed-point-ring-source11=" + v4_contract_region_loop_fixed_point_return_source_at(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_ring_result, 11)
say "contract-region-loop-fixed-point-converged=" + v4_contract_region_loop_fixed_point_bool(v4_borrowck_provenance_fixed_point_converged(v4_contract_region_loop_fixed_point_borrow))
say "contract-region-loop-fixed-point-solved=" + v4_contract_region_loop_fixed_point_bool(v4_borrowck_provenance_fixed_point_solve_count(v4_contract_region_loop_fixed_point_borrow) > 0)
say "contract-region-loop-fixed-point-rounds-positive=" + v4_contract_region_loop_fixed_point_bool(v4_borrowck_provenance_fixed_point_rounds(v4_contract_region_loop_fixed_point_borrow) > 0)
say "contract-region-loop-fixed-point-rounds-bounded=" + v4_contract_region_loop_fixed_point_bool(v4_borrowck_provenance_fixed_point_rounds(v4_contract_region_loop_fixed_point_borrow) <= v4_borrowck_provenance_fixed_point_limit(v4_contract_region_loop_fixed_point_borrow))
say "contract-region-loop-fixed-point-multi-round=" + v4_contract_region_loop_fixed_point_bool(v4_borrowck_provenance_fixed_point_rounds(v4_contract_region_loop_fixed_point_borrow) > v4_borrowck_provenance_fixed_point_solve_count(v4_contract_region_loop_fixed_point_borrow) * 2)
say "contract-region-loop-fixed-point-memo-cycle-observed=" + v4_contract_region_loop_fixed_point_bool(v4_borrowck_provenance_memo_hit_count() > 0)

pilot v4_contract_region_loop_fixed_point_snapshot = v4_borrowck_snapshot()
say v4_borrowck_snapshot_validate(v4_contract_region_loop_fixed_point_snapshot)
say v4_borrowck_snapshot_restore(v4_contract_region_loop_fixed_point_snapshot)
pilot v4_contract_region_loop_fixed_point_restored_alias_result = v4_borrowck_lookup_result(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_alias_def)
pilot v4_contract_region_loop_fixed_point_restored_ring_result = v4_borrowck_lookup_result(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_ring_def)
say "contract-region-loop-fixed-point-restored-alias-status=" + v4_borrowck_result_status(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_restored_alias_result)
say "contract-region-loop-fixed-point-restored-alias-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_restored_alias_result, v4_borrowck_path_return_loan))
say "contract-region-loop-fixed-point-restored-alias-has-first=" + v4_contract_region_loop_fixed_point_bool(v4_contract_region_loop_fixed_point_has_source(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_restored_alias_result, "first"))
say "contract-region-loop-fixed-point-restored-alias-has-second=" + v4_contract_region_loop_fixed_point_bool(v4_contract_region_loop_fixed_point_has_source(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_restored_alias_result, "second"))
say "contract-region-loop-fixed-point-restored-ring-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_restored_ring_result, v4_borrowck_path_return_loan))
say "contract-region-loop-fixed-point-restored-ring-source11=" + v4_contract_region_loop_fixed_point_return_source_at(v4_contract_region_loop_fixed_point_borrow, v4_contract_region_loop_fixed_point_restored_ring_result, 11)
