-- V4 LSP zero-based position smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_lsp_position_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_lsp_position_source_text() -> word {
    pilot src = "variant Event {\n"
    src = src + "    Key " + v4_lsp_position_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot event = Event::Key " + v4_lsp_position_braces(" code: 9 ") + "\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_lsp_position_source = v4_lsp_position_source_text()

say "offset-event=" + word_from_int(v4_lsp_offset_from_position(v4_lsp_position_source, 4, 18))
say "offset-key=" + word_from_int(v4_lsp_offset_from_position(v4_lsp_position_source, 4, 25))
say v4_lsp_range_from_span(v4_span_new("0", 0, 4), v4_lsp_position_source)
say v4_lsp_hover_position_text("position.fk", v4_lsp_position_source, 4, 18)
say v4_lsp_definition_position_text("position.fk", v4_lsp_position_source, 4, 18)
say v4_lsp_completion_position_text("position.fk", v4_lsp_position_source, 0, 0)

v4_lsp_open_document("position-live.fk", v4_lsp_position_source)
say v4_lsp_handle_position_request("textDocument/hover", "position-live.fk", 4, 18)
say v4_lsp_handle_position_request("textDocument/definition", "position-live.fk", 4, 18)
say v4_lsp_handle_position_request("textDocument/completion", "position-live.fk", 0, 0)
