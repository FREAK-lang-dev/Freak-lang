-- V4 contract-region conservative loop-carried source-set fixture.
-- Verification prepends the V4 crates before this file.
-- One cached borrowck request owns the only compiler pipeline in this executable.

task v4_contract_region_loop_negative_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task loop_carried<'a>(lend 'a first: Ship, lend 'a second: Ship, ready: bool) -> lend 'a Ship {\n"
    src = src + "    pilot view = lend first\n"
    src = src + "    pilot finished = ready\n"
    src = src + "    repeat until finished {\n"
    src = src + "        view = lend second\n"
    src = src + "        finished = true\n"
    src = src + "    }\n"
    src = src + "    give back view\n"
    src = src + "}\n"
    give back src
}

pilot v4_contract_region_loop_negative_borrow = v4_borrowck_text_cached("contract-region-loop-negative.fk", v4_contract_region_loop_negative_source())
pilot v4_contract_region_loop_negative_mir = v4_borrowck_mir_id(v4_contract_region_loop_negative_borrow)
pilot v4_contract_region_loop_negative_ty = v4_mir_ty_id(v4_contract_region_loop_negative_mir)
pilot v4_contract_region_loop_negative_resolve = v4_ty_resolve_id(v4_contract_region_loop_negative_ty)
pilot v4_contract_region_loop_negative_def = v4_resolve_def_for_name(v4_contract_region_loop_negative_resolve, "loop_carried")
pilot v4_contract_region_loop_negative_result = v4_borrowck_lookup_result(v4_contract_region_loop_negative_borrow, v4_contract_region_loop_negative_def)

say "contract-region-loop-negative-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_contract_region_loop_negative_ty))
say "contract-region-loop-negative-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_contract_region_loop_negative_mir))
say "contract-region-loop-negative-status=" + v4_borrowck_result_status(v4_contract_region_loop_negative_borrow, v4_contract_region_loop_negative_result)
say "contract-region-loop-negative-borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(v4_contract_region_loop_negative_borrow))
pilot v4_contract_region_loop_negative_diag_id = 0
repeat until v4_contract_region_loop_negative_diag_id >= v4_borrowck_diag_count(v4_contract_region_loop_negative_borrow) {
    pilot v4_contract_region_loop_negative_diag = v4_borrowck_diag(v4_contract_region_loop_negative_borrow, v4_contract_region_loop_negative_diag_id)
    say "contract-region-loop-negative-diag" + word_from_int(v4_contract_region_loop_negative_diag_id) + "=" + v4_diag_message(v4_contract_region_loop_negative_diag)
    say "contract-region-loop-negative-diag" + word_from_int(v4_contract_region_loop_negative_diag_id) + "-span=" + v4_diag_span(v4_contract_region_loop_negative_diag)
    v4_contract_region_loop_negative_diag_id += 1
}
