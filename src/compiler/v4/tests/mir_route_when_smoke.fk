say "route-ctor-bad-case-message=" + v4_diag_message(v4_mir_diag(v4_mir_route_when_bad_ctor_mir, 0))
say "route-ctor-bad-case-help=" + v4_diag_help(v4_mir_diag(v4_mir_route_when_bad_ctor_mir, 0))

pilot v4_mir_route_when_bad_ctor_route_stream = v4_lex_text(5, v4_mir_route_when_bad_ctor_route_source())
pilot v4_mir_route_when_bad_ctor_route_tree = v4_parse_stream(5, v4_mir_route_when_bad_ctor_route_stream)
pilot v4_mir_route_when_bad_ctor_route_hir = v4_hir_lower_tree(5, v4_mir_route_when_bad_ctor_route_tree)
pilot v4_mir_route_when_bad_ctor_route_resolve = v4_resolve_lower_hir(5, v4_mir_route_when_bad_ctor_route_hir)
