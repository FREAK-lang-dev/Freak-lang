pilot v4_mir_route_when_bad_case_stream = v4_lex_text(3, v4_mir_route_when_bad_case_source())
pilot v4_mir_route_when_bad_case_tree = v4_parse_stream(3, v4_mir_route_when_bad_case_stream)
pilot v4_mir_route_when_bad_case_hir = v4_hir_lower_tree(3, v4_mir_route_when_bad_case_tree)
