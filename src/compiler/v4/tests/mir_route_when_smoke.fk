say "route-when-bad-case-help=" + v4_diag_help(v4_mir_diag(v4_mir_route_when_bad_case_mir, 0))

pilot v4_mir_route_when_bad_ctor_stream = v4_lex_text(4, v4_mir_route_when_bad_ctor_source())
pilot v4_mir_route_when_bad_ctor_tree = v4_parse_stream(4, v4_mir_route_when_bad_ctor_stream)
pilot v4_mir_route_when_bad_ctor_hir = v4_hir_lower_tree(4, v4_mir_route_when_bad_ctor_tree)
pilot v4_mir_route_when_bad_ctor_resolve = v4_resolve_lower_hir(4, v4_mir_route_when_bad_ctor_hir)
pilot v4_mir_route_when_bad_ctor_ty = v4_ty_lower_resolve(4, v4_mir_route_when_bad_ctor_resolve)
pilot v4_mir_route_when_bad_ctor_mir = v4_mir_lower_ty(4, v4_mir_route_when_bad_ctor_ty)

