-- V4 MIR route constructor and when-lowering smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_route_when_good_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat / Retreat\n"
    src = src + "}\n"
    src = src + "task seed() -> Outcome {\n"
    src = src + "    pilot chosen: Outcome = Victory\n"
    src = src + "    give back chosen\n"
    src = src + "}\n"
    src = src + "task score(outcome: Outcome) -> int {\n"
    src = src + "    when outcome {\n"
    src = src + "        Victory -> give back 3\n"
    src = src + "        Outcome::Defeat -> give back 1\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_when_bad_nonroute_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "task bad(score: int) -> int {\n"
    src = src + "    when score {\n"
    src = src + "        Outcome::Victory -> give back 1\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_when_bad_other_route_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "route Result {\n"
    src = src + "    Win / Lose\n"
    src = src + "}\n"
    src = src + "task bad(outcome: Outcome) -> int {\n"
    src = src + "    when outcome {\n"
    src = src + "        Result::Win -> give back 1\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_when_bad_case_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "task bad(outcome: Outcome) -> int {\n"
    src = src + "    when outcome {\n"
    src = src + "        Outcome::Ghost -> give back 1\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_when_bad_ctor_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "task bad() -> Outcome {\n"
    src = src + "    pilot chosen = Outcome::Ghost\n"
    src = src + "    give back Outcome::Victory\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_when_bad_ctor_route_source() -> word {
    pilot src = "task bad() -> int {\n"
    src = src + "    pilot chosen = Result::Win\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_when_find_branch_stmt(mir_id: int, body_id: int, condition: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_branch {
            if v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == condition {
                give back stmt_id
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_mir_route_when_find_local_stmt(mir_id: int, body_id: int, local_name: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_local {
            if v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == local_name {
                give back stmt_id
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

pilot v4_mir_route_when_stream = v4_lex_text(0, v4_mir_route_when_good_source())
pilot v4_mir_route_when_tree = v4_parse_stream(0, v4_mir_route_when_stream)
pilot v4_mir_route_when_hir = v4_hir_lower_tree(0, v4_mir_route_when_tree)
pilot v4_mir_route_when_resolve = v4_resolve_lower_hir(0, v4_mir_route_when_hir)
pilot v4_mir_route_when_ty = v4_ty_lower_resolve(0, v4_mir_route_when_resolve)
pilot v4_mir_route_when_mir = v4_mir_lower_ty(0, v4_mir_route_when_ty)

pilot v4_mir_route_when_outcome_sig = v4_ty_route_signature_id_for_name(v4_mir_route_when_ty, "Outcome")

pilot v4_mir_route_when_seed_def = v4_resolve_def_for_name(v4_mir_route_when_resolve, "seed")
pilot v4_mir_route_when_seed_body = v4_mir_lookup_body(v4_mir_route_when_mir, v4_mir_route_when_seed_def)
pilot v4_mir_route_when_chosen_stmt = v4_mir_route_when_find_local_stmt(v4_mir_route_when_mir, v4_mir_route_when_seed_body, "chosen")
pilot v4_mir_route_when_chosen_rvalue = v4_mir_stmt_rvalue(v4_mir_route_when_mir, v4_mir_route_when_seed_body, v4_mir_route_when_chosen_stmt)

pilot v4_mir_route_when_score_def = v4_resolve_def_for_name(v4_mir_route_when_resolve, "score")
pilot v4_mir_route_when_score_body = v4_mir_lookup_body(v4_mir_route_when_mir, v4_mir_route_when_score_def)
pilot v4_mir_route_when_arm0_stmt = v4_mir_route_when_find_branch_stmt(v4_mir_route_when_mir, v4_mir_route_when_score_body, "outcome == Victory")
pilot v4_mir_route_when_arm1_stmt = v4_mir_route_when_find_branch_stmt(v4_mir_route_when_mir, v4_mir_route_when_score_body, "outcome == Outcome::Defeat")
pilot v4_mir_route_when_arm0_rvalue = v4_mir_stmt_rvalue(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_stmt)
pilot v4_mir_route_when_arm1_rvalue = v4_mir_stmt_rvalue(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_stmt)
pilot v4_mir_route_when_arm0_rhs = v4_mir_rvalue_rhs(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rvalue)
pilot v4_mir_route_when_arm1_rhs = v4_mir_rvalue_rhs(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rvalue)

say v4_mir_summary(v4_mir_route_when_mir)
say "route-outcome-sig-kind=" + v4_ty_signature_kind(v4_mir_route_when_ty, v4_mir_route_when_outcome_sig)
say "route-outcome-display=" + v4_ty_signature_display(v4_mir_route_when_ty, v4_mir_route_when_outcome_sig)
say "route-outcome-cases=" + word_from_int(v4_ty_route_case_count(v4_mir_route_when_ty, v4_mir_route_when_outcome_sig))
say "route-outcome-case0=" + v4_ty_route_case_name(v4_mir_route_when_ty, v4_mir_route_when_outcome_sig, 0)
say "route-outcome-case1=" + v4_ty_route_case_name(v4_mir_route_when_ty, v4_mir_route_when_outcome_sig, 1)
say "route-outcome-case2=" + v4_ty_route_case_name(v4_mir_route_when_ty, v4_mir_route_when_outcome_sig, 2)
say "route-seed-chosen-kind=" + v4_mir_rvalue_kind(v4_mir_route_when_mir, v4_mir_route_when_seed_body, v4_mir_route_when_chosen_rvalue)
say "route-seed-chosen-text=" + v4_mir_rvalue_text(v4_mir_route_when_mir, v4_mir_route_when_seed_body, v4_mir_route_when_chosen_rvalue)
say "route-seed-chosen-op=" + v4_mir_rvalue_op(v4_mir_route_when_mir, v4_mir_route_when_seed_body, v4_mir_route_when_chosen_rvalue)
say "route-seed-chosen-ty=" + v4_mir_rvalue_ty(v4_mir_route_when_mir, v4_mir_route_when_seed_body, v4_mir_route_when_chosen_rvalue)
say "route-score-arm0-kind=" + v4_mir_stmt_kind(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_stmt)
say "route-score-arm0-lhs=" + v4_mir_stmt_lhs(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_stmt)
say "route-score-arm0-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rvalue)
say "route-score-arm0-rvalue-op=" + v4_mir_rvalue_op(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rvalue)
say "route-score-arm0-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rvalue)
say "route-score-arm0-rhs-kind=" + v4_mir_rvalue_kind(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rhs)
say "route-score-arm0-rhs-text=" + v4_mir_rvalue_text(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rhs)
say "route-score-arm0-rhs-ty=" + v4_mir_rvalue_ty(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm0_rhs)
say "route-score-arm1-kind=" + v4_mir_stmt_kind(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_stmt)
say "route-score-arm1-lhs=" + v4_mir_stmt_lhs(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_stmt)
say "route-score-arm1-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rvalue)
say "route-score-arm1-rvalue-op=" + v4_mir_rvalue_op(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rvalue)
say "route-score-arm1-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rvalue)
say "route-score-arm1-rhs-kind=" + v4_mir_rvalue_kind(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rhs)
say "route-score-arm1-rhs-text=" + v4_mir_rvalue_text(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rhs)
say "route-score-arm1-rhs-ty=" + v4_mir_rvalue_ty(v4_mir_route_when_mir, v4_mir_route_when_score_body, v4_mir_route_when_arm1_rhs)
say "route-when-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_when_mir))

pilot v4_mir_route_when_bad_nonroute_stream = v4_lex_text(1, v4_mir_route_when_bad_nonroute_source())
pilot v4_mir_route_when_bad_nonroute_tree = v4_parse_stream(1, v4_mir_route_when_bad_nonroute_stream)
pilot v4_mir_route_when_bad_nonroute_hir = v4_hir_lower_tree(1, v4_mir_route_when_bad_nonroute_tree)
pilot v4_mir_route_when_bad_nonroute_resolve = v4_resolve_lower_hir(1, v4_mir_route_when_bad_nonroute_hir)
pilot v4_mir_route_when_bad_nonroute_ty = v4_ty_lower_resolve(1, v4_mir_route_when_bad_nonroute_resolve)
pilot v4_mir_route_when_bad_nonroute_mir = v4_mir_lower_ty(1, v4_mir_route_when_bad_nonroute_ty)

say "route-when-bad-nonroute-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_when_bad_nonroute_mir))
say "route-when-bad-nonroute-message=" + v4_diag_message(v4_mir_diag(v4_mir_route_when_bad_nonroute_mir, 0))
say "route-when-bad-nonroute-help=" + v4_diag_help(v4_mir_diag(v4_mir_route_when_bad_nonroute_mir, 0))

pilot v4_mir_route_when_bad_other_stream = v4_lex_text(2, v4_mir_route_when_bad_other_route_source())
pilot v4_mir_route_when_bad_other_tree = v4_parse_stream(2, v4_mir_route_when_bad_other_stream)
pilot v4_mir_route_when_bad_other_hir = v4_hir_lower_tree(2, v4_mir_route_when_bad_other_tree)
pilot v4_mir_route_when_bad_other_resolve = v4_resolve_lower_hir(2, v4_mir_route_when_bad_other_hir)
pilot v4_mir_route_when_bad_other_ty = v4_ty_lower_resolve(2, v4_mir_route_when_bad_other_resolve)
pilot v4_mir_route_when_bad_other_mir = v4_mir_lower_ty(2, v4_mir_route_when_bad_other_ty)

say "route-when-bad-other-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_when_bad_other_mir))
