-- V4 generic doctrine bound editor smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_generic_bounds_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_generic_bounds_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_generic_bounds_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_generic_bounds_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_generic_bounds_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_generic_bounds_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_generic_bounds_editor_source_text() -> word {
    pilot src = "doctrine Displayable {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "doctrine Ranked {\n"
    src = src + "    task rank(self) -> int\n"
    src = src + "}\n"
    src = src + "shape Pilot {\n"
    src = src + "    callsign: word\n"
    src = src + "    score: int\n"
    src = src + "}\n"
    src = src + "impl Displayable for Pilot {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back self.callsign\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Ranked for Pilot {\n"
    src = src + "    task rank(self) -> int {\n"
    src = src + "        give back self.score\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task show<T: Displayable + Ranked>(value: T) -> word {\n"
    src = src + "    pilot score = value.rank()\n"
    src = src + "    give back value.display()\n"
    src = src + "}\n"
    src = src + "task main(ship: Pilot) -> word {\n"
    src = src + "    give back show(ship)\n"
    src = src + "}\n"
    give back src
}

pilot v4_generic_bounds_editor_source = v4_generic_bounds_editor_source_text()
pilot v4_generic_bounds_editor_stream = v4_lex_text(0, v4_generic_bounds_editor_source)

pilot v4_generic_bounds_editor_bound_offset = v4_generic_bounds_editor_token_offset(v4_generic_bounds_editor_stream, "Displayable", 1)
pilot v4_generic_bounds_editor_rank_bound_offset = v4_generic_bounds_editor_token_offset(v4_generic_bounds_editor_stream, "Ranked", 1)
pilot v4_generic_bounds_editor_show_call_offset = v4_generic_bounds_editor_token_offset(v4_generic_bounds_editor_stream, "show", 1)
pilot v4_generic_bounds_editor_rank_call_offset = v4_generic_bounds_editor_token_offset(v4_generic_bounds_editor_stream, "rank", 2)
pilot v4_generic_bounds_editor_display_call_offset = v4_generic_bounds_editor_token_offset(v4_generic_bounds_editor_stream, "display", 2)

pilot v4_generic_bounds_editor_bound_sem = v4_semantic_at_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source, v4_generic_bounds_editor_bound_offset)
pilot v4_generic_bounds_editor_rank_hover = v4_hover_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source, v4_generic_bounds_editor_rank_bound_offset)
pilot v4_generic_bounds_editor_show_definition = v4_definition_at_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source, v4_generic_bounds_editor_show_call_offset)
pilot v4_generic_bounds_editor_rank_sem = v4_semantic_at_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source, v4_generic_bounds_editor_rank_call_offset)
pilot v4_generic_bounds_editor_display_sem = v4_semantic_at_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source, v4_generic_bounds_editor_display_call_offset)
pilot v4_generic_bounds_editor_completion = v4_completion_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source, v4_generic_bounds_editor_rank_call_offset)
pilot v4_generic_bounds_editor_hir = v4_hir_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source)
pilot v4_generic_bounds_editor_ty = v4_ty_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source)
pilot v4_generic_bounds_editor_mir = v4_mir_text_cached("generic-bounds-editor.fk", v4_generic_bounds_editor_source)
pilot v4_generic_bounds_editor_hir_item = v4_editor_hir_item_at(v4_generic_bounds_editor_hir, v4_generic_bounds_editor_rank_call_offset)
pilot v4_generic_bounds_editor_body = v4_editor_body_for_offset(v4_generic_bounds_editor_hir, v4_generic_bounds_editor_stream, v4_generic_bounds_editor_ty, v4_generic_bounds_editor_mir, v4_generic_bounds_editor_hir_item, v4_generic_bounds_editor_rank_call_offset)

pilot v4_generic_bounds_editor_rank_item = v4_generic_bounds_editor_find_completion_label(v4_generic_bounds_editor_completion, "rank")
pilot v4_generic_bounds_editor_display_item = v4_generic_bounds_editor_find_completion_label(v4_generic_bounds_editor_completion, "display")

say v4_semantic_at_summary(v4_generic_bounds_editor_bound_sem)
say "generic-bounds-bound-kind=" + v4_semantic_at_kind(v4_generic_bounds_editor_bound_sem)
say "generic-bounds-bound-type=" + v4_semantic_at_type(v4_generic_bounds_editor_bound_sem)
say "generic-bounds-rank-hover-kind=" + v4_hover_kind(v4_generic_bounds_editor_rank_hover)
say "generic-bounds-rank-hover-type=" + v4_hover_type(v4_generic_bounds_editor_rank_hover)
say "generic-bounds-show-definition-kind=" + v4_definition_at_kind(v4_generic_bounds_editor_show_definition)
say "generic-bounds-show-definition-found=" + word_from_int(v4_definition_at_found(v4_generic_bounds_editor_show_definition))
say "generic-bounds-show-definition-matches=" + v4_generic_bounds_editor_bool_word(v4_definition_at_found(v4_generic_bounds_editor_show_definition) > 0)
say "generic-bounds-rank-call-kind=" + v4_semantic_at_kind(v4_generic_bounds_editor_rank_sem)
say "generic-bounds-rank-call-type=" + v4_semantic_at_type(v4_generic_bounds_editor_rank_sem)
say "generic-bounds-display-call-kind=" + v4_semantic_at_kind(v4_generic_bounds_editor_display_sem)
say "generic-bounds-display-call-type=" + v4_semantic_at_type(v4_generic_bounds_editor_display_sem)
say "generic-bounds-completion-rank-found=" + v4_generic_bounds_editor_bool_word(v4_generic_bounds_editor_rank_item >= 0)
say "generic-bounds-completion-rank-detail=" + v4_generic_bounds_editor_completion_detail_or_empty(v4_generic_bounds_editor_completion, v4_generic_bounds_editor_rank_item)
say "generic-bounds-completion-display-found=" + v4_generic_bounds_editor_bool_word(v4_generic_bounds_editor_display_item >= 0)
say "generic-bounds-completion-display-detail=" + v4_generic_bounds_editor_completion_detail_or_empty(v4_generic_bounds_editor_completion, v4_generic_bounds_editor_display_item)
