-- V4 MIR list and array destructuring smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_list_destructure_good_source() -> word {
    pilot src = "task main() -> int {\n"
    src = src + "    pilot squad = [3, 5, 8]\n"
    src = src + "    pilot [front, flank] = squad\n"
    src = src + "    pilot board: [int;2] = [7, 9]\n"
    src = src + "    pilot [left, right] = board\n"
    src = src + "    pilot nested = [[1, 2], [3, 4]]\n"
    src = src + "    pilot [[x, y], _] = nested\n"
    src = src + "    give back front + right + y\n"
    src = src + "}\n"
    give back src
}

task v4_mir_list_destructure_bad_non_sequence_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot [left, right] = 7\n"
    src = src + "}\n"
    give back src
}

task v4_mir_list_destructure_bad_arity_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot board: [int;2] = [1, 2]\n"
    src = src + "    pilot [a, b, c] = board\n"
    src = src + "}\n"
    give back src
}

task v4_mir_list_destructure_bad_duplicate_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot [a, a] = [1, 2]\n"
    src = src + "}\n"
    give back src
}

task v4_mir_list_destructure_bad_type_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot [left, right]: List<int> = (1, 2)\n"
    src = src + "}\n"
    give back src
}

