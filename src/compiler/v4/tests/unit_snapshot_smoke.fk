-- V4 current 00-Unit snapshot and restore smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_unit_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_unit_snapshot_const_source() -> word {
    pilot box_braces = v4_unit_snapshot_braces(" value: 1 ")
    pilot option_decl = v4_unit_snapshot_braces(" value: T ")
    pilot some_braces = v4_unit_snapshot_braces(" value: \"ace\" ")
    pilot src = "fixed pilot BAD_GENERIC_SHAPE = Box<int,word> " + box_braces + "\n"
    src = src + "fixed pilot TYPE_GENERIC_SHAPE = Box<int> " + v4_unit_snapshot_braces(" value: \"ace\" ") + "\n"
    src = src + "fixed pilot BAD_GENERIC_ROUTE = Option<int,word>::None\n"
    src = src + "fixed pilot TYPE_GENERIC_ROUTE = Option<int>::Some " + some_braces + "\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_unit_snapshot_source = "task main() -> int {\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    pilot name = \"Yuuko|Meiya\"\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    pilot bad = name - 1\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    give back 0\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "}\n"

say v4_check_syntax_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_diagnostics_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_lsp_hover_text("unit-snapshot.fk", v4_unit_snapshot_source, 8)
say v4_lsp_definition_text("unit-snapshot.fk", v4_unit_snapshot_source, 5)
say v4_lsp_document_symbols_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_lsp_completion_text("unit-snapshot.fk", v4_unit_snapshot_source, 0)

say v4_unit_snapshot_ref_store("before", v4_unit_snapshot())
say v4_unit_snapshot_validate(v4_unit_snapshot_ref_text("before"))
say v4_unit_snapshot_manifest(v4_unit_snapshot_ref_text("before"))
say v4_unit_snapshot_health(v4_unit_snapshot_ref_text("before"))

pilot v4_unit_diagnostics_payload = v4_unit_snapshot_section_payload(v4_unit_snapshot_ref_text("before"), "diagnostics")
v4_unit_diagnostics_payload = v4_diagnostics_snapshot()
say "unit-diagnostics-section-validation=" + v4_diagnostics_snapshot_validate(v4_unit_diagnostics_payload)
pilot v4_unit_diagnostics_line_idx = 0
pilot v4_unit_diagnostics_line_count = v4_diagnostics_snapshot_line_count(v4_unit_diagnostics_payload)
repeat until v4_unit_diagnostics_line_idx >= v4_unit_diagnostics_line_count {
    pilot v4_unit_diagnostics_line = v4_diagnostics_snapshot_line(v4_unit_diagnostics_payload, v4_unit_diagnostics_line_idx)
    if v4_unit_diagnostics_line.starts_with("diagnostic|") {
        say "unit-diagnostics-diag-line=" + v4_unit_diagnostics_line
    }
    v4_unit_diagnostics_line_idx += 1
}

pilot v4_unit_snapshot_source_changed = "task main() -> int {\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "    pilot name = \"Yuuko|Meiya|XM3\"\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "    pilot good = name + \"!\"\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "    give back 0\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "}\n"

say v4_lsp_handle_text_request("textDocument/didOpen", "unit-snapshot.fk", v4_unit_snapshot_source, 0)
say v4_lsp_handle_text_request("textDocument/didChange", "unit-snapshot.fk", v4_unit_snapshot_source_changed, 0)
say v4_check_syntax_text("unit-snapshot.fk", v4_unit_snapshot_source_changed)
say v4_diagnostics_text("unit-snapshot.fk", v4_unit_snapshot_source_changed)

say v4_unit_snapshot_manifest(v4_unit_snapshot())
say v4_unit_snapshot_health(v4_unit_snapshot())
pilot v4_unit_diagnostics_payload_changed = v4_unit_snapshot_section_payload(v4_unit_snapshot(), "diagnostics")
say "unit-diagnostics-changed-section-validation=" + v4_diagnostics_snapshot_validate(v4_unit_diagnostics_payload_changed)
say v4_lsp_handle_text_request("workspace/unitSnapshotManifest", "unit-snapshot.fk", v4_unit_snapshot(), 0)
say v4_lsp_handle_text_request("workspace/unitSnapshotHealth", "unit-snapshot.fk", v4_unit_snapshot(), 0)

say v4_unit_snapshot_restore(v4_unit_snapshot_ref_text("before"))
say v4_lsp_handle_text_request("workspace/unitSnapshotRestore", "unit-snapshot.fk", v4_unit_snapshot_ref_text("before"), 0)
say v4_lsp_handle_request("workspace/unitSnapshotRestore", "unit-snapshot.fk", 0)
say v4_unit_snapshot_restore("00-unit-snapshot|format=wrong\nend|wrong")

pilot v4_unit_snapshot_const_text = v4_unit_snapshot_const_source()
say v4_lsp_handle_text_request("textDocument/didOpen", "unit-snapshot-const.fk", v4_unit_snapshot_const_text, 0)
say v4_diagnostics_text("unit-snapshot-const.fk", v4_unit_snapshot_const_text)
say v4_unit_snapshot_ref_store("const-before", v4_unit_snapshot())
say v4_unit_snapshot_restore(v4_unit_snapshot_ref_text("const-before"))
say v4_driver_confirm_restored_document_text("unit-snapshot-const.fk", v4_unit_snapshot_const_text)
