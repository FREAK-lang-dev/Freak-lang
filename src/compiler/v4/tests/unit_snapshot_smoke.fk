-- V4 current 00-Unit snapshot and restore smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_unit_snapshot_integrity_assert(case_name: word, passed: bool) -> word {
    pilot out = "unit-snapshot-integrity|case=" + case_name
    if passed {
        out = out + "|ok=1"
    } else {
        out = out + "|ok=0"
    }
    give back out
}

task v4_unit_snapshot_fixture_header_with_sections(line: word, sections: int) -> word {
    pilot out = "00-unit-snapshot"
    out = out + "|format=" + v4_unit_snapshot_key_value(line, "format")
    out = out + "|sources=" + v4_unit_snapshot_key_value(line, "sources")
    out = out + "|sections=" + word_from_int(sections)
    give back out
}

task v4_unit_snapshot_fixture_variant(payload: word, section_name: word, mode: word) -> word {
    pilot out = ""
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(payload, line_id)
        pilot output_line = line
        pilot copies = 1
        pilot kind = v4_unit_snapshot_field_raw(line, 0)

        if kind == "00-unit-snapshot" {
            pilot declared_sections = word_to_int(v4_unit_snapshot_key_value(line, "sections"))
            if mode == "missing" {
                declared_sections -= 1
            } else if mode == "duplicate" {
                declared_sections += 1
            }
            output_line = v4_unit_snapshot_fixture_header_with_sections(line, declared_sections)
        } else if kind == "unit-section" and v4_unit_snapshot_field_raw(line, 1) == section_name {
            if mode == "missing" {
                copies = 0
            } else if mode == "duplicate" {
                copies = 2
            } else if mode == "corrupt" {
                output_line = v4_unit_snapshot_section_line(section_name, "corrupt-inner-payload")
            } else if mode == "unknown" {
                output_line = v4_unit_snapshot_section_line("unknown", v4_unit_snapshot_field(line, 2))
            }
        }

        pilot copy_id = 0
        repeat until copy_id >= copies {
            if out != "" { out = out + "\n" }
            out = out + output_line
            copy_id += 1
        }
        line_id += 1
    }
    give back out
}

pilot v4_unit_snapshot_source = "task main() -> int {\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    pilot name = \"Yuuko|Meiya\"\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    pilot bad = name - 1\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    give back 0\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "}\n"

say v4_check_syntax_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_diagnostics_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_lsp_hover_text("unit-snapshot.fk", v4_unit_snapshot_source, 8)
say v4_lsp_definition_text("unit-snapshot.fk", v4_unit_snapshot_source, 5)
say v4_lsp_document_symbols_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_lsp_completion_text("unit-snapshot.fk", v4_unit_snapshot_source, 0)

pilot v4_unit_snapshot_current_validation = ""
pilot v4_unit_snapshot_current_manifest = ""
pilot v4_unit_snapshot_current_health = ""
say v4_unit_snapshot_ref_store("before", v4_unit_snapshot())
v4_unit_snapshot_current_validation = v4_unit_snapshot_validate(v4_unit_snapshot_ref_text("before"))
v4_unit_snapshot_current_manifest = v4_unit_snapshot_manifest(v4_unit_snapshot_ref_text("before"))
v4_unit_snapshot_current_health = v4_unit_snapshot_health(v4_unit_snapshot_ref_text("before"))
say v4_unit_snapshot_current_validation
say v4_unit_snapshot_current_manifest
say v4_unit_snapshot_current_health
say v4_unit_snapshot_integrity_assert("current-snapshot-validated", v4_unit_snapshot_current_validation.starts_with("00-unit-snapshot-import ok=1 "))
say v4_unit_snapshot_integrity_assert("current-manifest-valid", v4_unit_snapshot_current_manifest.starts_with("00-unit-manifest|format=freak-00-unit-manifest-v1|ok=1|"))
say v4_unit_snapshot_integrity_assert("current-health-valid", v4_unit_snapshot_current_health.starts_with("00-unit-health|format=freak-00-unit-health-v1|ok=1|"))

pilot v4_unit_snapshot_before = ""
pilot v4_unit_snapshot_before_semantic_count = 0
pilot v4_unit_snapshot_before_hover_count = 0
pilot v4_unit_snapshot_before_definition_count = 0
pilot v4_unit_snapshot_missing = ""
pilot v4_unit_snapshot_duplicate = ""
pilot v4_unit_snapshot_corrupt = ""
pilot v4_unit_snapshot_unknown = ""
pilot v4_unit_snapshot_missing_validation = ""
pilot v4_unit_snapshot_duplicate_validation = ""
pilot v4_unit_snapshot_corrupt_validation = ""
pilot v4_unit_snapshot_unknown_validation = ""
v4_unit_snapshot_before = v4_unit_snapshot_ref_text("before")
v4_unit_snapshot_before_semantic_count = v4_semantic_fact_count()
v4_unit_snapshot_before_hover_count = v4_hover_count()
v4_unit_snapshot_before_definition_count = v4_definition_at_count()
v4_unit_snapshot_missing = v4_unit_snapshot_fixture_variant(v4_unit_snapshot_before, "completion", "missing")
v4_unit_snapshot_duplicate = v4_unit_snapshot_fixture_variant(v4_unit_snapshot_before, "completion", "duplicate")
v4_unit_snapshot_corrupt = v4_unit_snapshot_fixture_variant(v4_unit_snapshot_before, "lex", "corrupt")
v4_unit_snapshot_unknown = v4_unit_snapshot_fixture_variant(v4_unit_snapshot_before, "completion", "unknown")
v4_unit_snapshot_missing_validation = v4_unit_snapshot_validate(v4_unit_snapshot_missing)
v4_unit_snapshot_duplicate_validation = v4_unit_snapshot_validate(v4_unit_snapshot_duplicate)
v4_unit_snapshot_corrupt_validation = v4_unit_snapshot_validate(v4_unit_snapshot_corrupt)
v4_unit_snapshot_unknown_validation = v4_unit_snapshot_validate(v4_unit_snapshot_unknown)
say v4_unit_snapshot_missing_validation
say v4_unit_snapshot_duplicate_validation
say v4_unit_snapshot_corrupt_validation
say v4_unit_snapshot_unknown_validation
say v4_unit_snapshot_integrity_assert("missing-section", v4_unit_snapshot_missing_validation.starts_with("00-unit-snapshot-import ok=0 "))
say v4_unit_snapshot_integrity_assert("duplicate-section", v4_unit_snapshot_duplicate_validation.starts_with("00-unit-snapshot-import ok=0 "))
say v4_unit_snapshot_integrity_assert("corrupt-inner-payload", v4_unit_snapshot_corrupt_validation.starts_with("00-unit-snapshot-import ok=0 "))
say v4_unit_snapshot_integrity_assert("unknown-section", v4_unit_snapshot_unknown_validation.starts_with("00-unit-snapshot-import ok=0 "))
pilot v4_unit_snapshot_before_file_id = 0
pilot v4_unit_snapshot_before_revision = 0
v4_unit_snapshot_before_file_id = v4_source_find("unit-snapshot.fk")
v4_unit_snapshot_before_revision = v4_source_revision(v4_unit_snapshot_before_file_id)

pilot v4_unit_diagnostics_payload = ""
pilot v4_unit_diagnostics_validation = ""
v4_unit_diagnostics_payload = v4_diagnostics_snapshot()
v4_unit_diagnostics_validation = v4_diagnostics_snapshot_validate(v4_unit_diagnostics_payload)
say "unit-diagnostics-section-validation=" + v4_unit_diagnostics_validation
say v4_unit_snapshot_integrity_assert("current-diagnostics-valid", v4_unit_diagnostics_validation.starts_with("diagnostics-snapshot-import ok=1 "))
pilot v4_unit_diagnostics_line_idx = 0
pilot v4_unit_diagnostics_line_count = 0
v4_unit_diagnostics_line_count = v4_diagnostics_snapshot_line_count(v4_unit_diagnostics_payload)
repeat until v4_unit_diagnostics_line_idx >= v4_unit_diagnostics_line_count {
    pilot v4_unit_diagnostics_line = v4_diagnostics_snapshot_line(v4_unit_diagnostics_payload, v4_unit_diagnostics_line_idx)
    if v4_unit_diagnostics_line.starts_with("diagnostic|") {
        say "unit-diagnostics-diag-line=" + v4_unit_diagnostics_line
    }
    v4_unit_diagnostics_line_idx += 1
}

pilot v4_unit_snapshot_source_changed = "task main() -> int {\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "    pilot name = \"Yuuko|Meiya|XM3\"\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "    pilot good = name + \"!\"\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "    give back 0\n"
v4_unit_snapshot_source_changed = v4_unit_snapshot_source_changed + "}\n"

say v4_lsp_handle_text_request("textDocument/didOpen", "unit-snapshot.fk", v4_unit_snapshot_source, 0)
say v4_lsp_handle_text_request("textDocument/didChange", "unit-snapshot.fk", v4_unit_snapshot_source_changed, 0)
say v4_check_syntax_text("unit-snapshot.fk", v4_unit_snapshot_source_changed)
say v4_diagnostics_text("unit-snapshot.fk", v4_unit_snapshot_source_changed)

say v4_unit_snapshot_manifest(v4_unit_snapshot())
say v4_unit_snapshot_health(v4_unit_snapshot())
pilot v4_unit_diagnostics_payload_changed = ""
pilot v4_unit_diagnostics_validation_changed = ""
v4_unit_diagnostics_payload_changed = v4_unit_snapshot_section_payload(v4_unit_snapshot(), "diagnostics")
v4_unit_diagnostics_validation_changed = v4_diagnostics_snapshot_validate(v4_unit_diagnostics_payload_changed)
say "unit-diagnostics-changed-section-validation=" + v4_unit_diagnostics_validation_changed
say v4_unit_snapshot_integrity_assert("changed-diagnostics-valid", v4_unit_diagnostics_validation_changed.starts_with("diagnostics-snapshot-import ok=1 "))
say v4_lsp_handle_text_request("workspace/unitSnapshotManifest", "unit-snapshot.fk", v4_unit_snapshot(), 0)
say v4_lsp_handle_text_request("workspace/unitSnapshotHealth", "unit-snapshot.fk", v4_unit_snapshot(), 0)

pilot v4_unit_snapshot_preflight_text = ""
pilot v4_unit_snapshot_preflight_revision = 0
pilot v4_unit_snapshot_failed_restore = ""
v4_unit_snapshot_preflight_text = v4_source_text(v4_unit_snapshot_before_file_id)
v4_unit_snapshot_preflight_revision = v4_source_revision(v4_unit_snapshot_before_file_id)
v4_unit_snapshot_failed_restore = v4_unit_snapshot_restore(v4_unit_snapshot_missing)
say v4_unit_snapshot_failed_restore
say v4_unit_snapshot_integrity_assert("invalid-restore-rejected", v4_unit_snapshot_failed_restore.starts_with("00-unit-snapshot-restore ok=0 "))
say v4_unit_snapshot_integrity_assert("preflight-preserves-source-text", v4_source_text(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_preflight_text)
say v4_unit_snapshot_integrity_assert("preflight-preserves-source-revision", v4_source_revision(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_preflight_revision)

pilot v4_unit_snapshot_extra_path = "unit-snapshot-extra.fk"
pilot v4_unit_snapshot_extra_source = "task extra() -> int {\n"
v4_unit_snapshot_extra_source = v4_unit_snapshot_extra_source + "    give back 1\n"
v4_unit_snapshot_extra_source = v4_unit_snapshot_extra_source + "}\n"
pilot v4_unit_snapshot_extra_file_id = 0
pilot v4_unit_snapshot_extra_semantic_id = 0
pilot v4_unit_snapshot_extra_hover_id = 0
pilot v4_unit_snapshot_extra_definition_id = 0
pilot v4_unit_snapshot_extra_query_key = ""
pilot v4_unit_snapshot_extra_query_input = "snapshot-extra-input"
v4_unit_snapshot_extra_file_id = v4_source_set_text(v4_unit_snapshot_extra_path, v4_unit_snapshot_extra_source)
v4_unit_snapshot_extra_semantic_id = v4_editor_semantic_fact_new(v4_unit_snapshot_extra_path, 5, 0 - 1, "identifier", "extra", V4_NO_SPAN, 0 - 1, "extra", "task", 0 - 1, "extra", "task", "extra::task", "task() -> int")
v4_unit_snapshot_extra_hover_id = v4_editor_hover_new(v4_unit_snapshot_extra_path, 5, v4_unit_snapshot_extra_semantic_id, "extra", "task", "task() -> int", "**extra**")
v4_unit_snapshot_extra_definition_id = v4_editor_definition_new(v4_unit_snapshot_extra_path, 5, v4_unit_snapshot_extra_semantic_id, "extra", "task", "extra::task", 0 - 1, V4_NO_SPAN, 1)
v4_unit_snapshot_extra_query_key = "snapshot-extra:" + v4_unit_snapshot_extra_path
v4_query_store(v4_unit_snapshot_extra_query_key, v4_unit_snapshot_extra_query_input, "stale-cache-hit")
say v4_unit_snapshot_integrity_assert("extras-visible-before-restore", v4_source_find(v4_unit_snapshot_extra_path) == v4_unit_snapshot_extra_file_id and v4_semantic_fact_exists(v4_unit_snapshot_extra_semantic_id) and v4_hover_exists(v4_unit_snapshot_extra_hover_id) and v4_definition_at_exists(v4_unit_snapshot_extra_definition_id))
say v4_unit_snapshot_integrity_assert("extra-cache-hit-before-restore", v4_query_get(v4_unit_snapshot_extra_query_key, v4_unit_snapshot_extra_query_input) == "stale-cache-hit")

pilot v4_unit_snapshot_valid_restore = ""
v4_unit_snapshot_valid_restore = v4_unit_snapshot_restore(v4_unit_snapshot_before)
say v4_unit_snapshot_valid_restore
say v4_unit_snapshot_integrity_assert("valid-restore", v4_unit_snapshot_valid_restore.starts_with("00-unit-snapshot-restore ok=1 "))
say v4_unit_snapshot_integrity_assert("valid-restore-source-text", v4_source_text(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_source)
say v4_unit_snapshot_integrity_assert("valid-restore-source-revision", v4_source_revision(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_before_revision)
say v4_unit_snapshot_integrity_assert("extra-source-removed", v4_source_find(v4_unit_snapshot_extra_path) < 0 and v4_source_path(v4_unit_snapshot_extra_file_id) == "")
say v4_unit_snapshot_integrity_assert("extra-semantic-removed", v4_semantic_fact_count() == v4_unit_snapshot_before_semantic_count and v4_semantic_fact_exists(v4_unit_snapshot_extra_semantic_id) == false and v4_semantic_at_path(v4_unit_snapshot_extra_semantic_id) == "")
say v4_unit_snapshot_integrity_assert("extra-hover-removed", v4_hover_count() == v4_unit_snapshot_before_hover_count and v4_hover_exists(v4_unit_snapshot_extra_hover_id) == false and v4_hover_path(v4_unit_snapshot_extra_hover_id) == "")
say v4_unit_snapshot_integrity_assert("extra-definition-removed", v4_definition_at_count() == v4_unit_snapshot_before_definition_count and v4_definition_at_exists(v4_unit_snapshot_extra_definition_id) == false and v4_definition_at_path(v4_unit_snapshot_extra_definition_id) == "")
say v4_unit_snapshot_integrity_assert("extra-query-removed", v4_query_entry_count_for_key(v4_unit_snapshot_extra_query_key) == 0)
say v4_unit_snapshot_integrity_assert("extra-cache-miss-after-restore", v4_query_get(v4_unit_snapshot_extra_query_key, v4_unit_snapshot_extra_query_input) == "")
say v4_lsp_handle_text_request("workspace/unitSnapshotRestore", "unit-snapshot.fk", v4_unit_snapshot_ref_text("before"), 0)
say v4_lsp_handle_request("workspace/unitSnapshotRestore", "unit-snapshot.fk", 0)
say v4_unit_snapshot_restore("00-unit-snapshot|format=wrong\nend|wrong")
