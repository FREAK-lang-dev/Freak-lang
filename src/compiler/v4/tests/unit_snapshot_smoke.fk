-- V4 current 00-Unit snapshot and restore smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_unit_snapshot_integrity_assert(case_name: word, passed: bool) -> word {
    pilot out = "unit-snapshot-integrity|case=" + case_name
    if passed {
        out = out + "|ok=1"
    } else {
        out = out + "|ok=0"
    }
    give back out
}

task v4_unit_snapshot_restore_is_atomic(restore_text: word, expected_state: word) -> int {
    if restore_text.starts_with("00-unit-snapshot-restore ok=0 ") {
        if v4_unit_snapshot() == expected_state {
            give back 1
        }
    }
    give back 0
}

task v4_unit_snapshot_fixture_header_with_sections(line: word, sections: int) -> word {
    pilot out = "00-unit-snapshot"
    out = out + "|format=" + v4_unit_snapshot_key_value(line, "format")
    out = out + "|sources=" + v4_unit_snapshot_key_value(line, "sources")
    out = out + "|sections=" + word_from_int(sections)
    out = out + "|identity=" + v4_unit_snapshot_escape(v4_unit_snapshot_key_value(line, "identity"))
    give back out
}

task v4_unit_snapshot_fixture_variant(payload: word, section_name: word, mode: word) -> word {
    pilot out = ""
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(payload, line_id)
        pilot output_line = line
        pilot copies = 1
        pilot kind = v4_unit_snapshot_field_raw(line, 0)

        if kind == "00-unit-snapshot" {
            pilot declared_sections = word_to_int(v4_unit_snapshot_key_value(line, "sections"))
            if mode == "missing" {
                declared_sections -= 1
            } else if mode == "duplicate" {
                declared_sections += 1
            }
            output_line = v4_unit_snapshot_fixture_header_with_sections(line, declared_sections)
        } else if kind == "unit-section" and v4_unit_snapshot_field_raw(line, 1) == section_name {
            if mode == "missing" {
                copies = 0
            } else if mode == "duplicate" {
                copies = 2
            } else if mode == "corrupt" {
                output_line = v4_unit_snapshot_section_line_with_identity(section_name, v4_unit_snapshot_field(line, 2), "corrupt-inner-payload")
            } else if mode == "unknown" {
                output_line = v4_unit_snapshot_section_line_with_identity("unknown", v4_unit_snapshot_field(line, 2), v4_unit_snapshot_field(line, 3))
            }
        }

        pilot copy_id = 0
        repeat until copy_id >= copies {
            if out != "" { out = out + "\n" }
            out = out + output_line
            copy_id += 1
        }
        line_id += 1
    }
    give back out
}

task v4_unit_snapshot_fixture_header_with_sources(line: word, sources: int) -> word {
    pilot out = "00-unit-snapshot"
    out = out + "|format=" + v4_unit_snapshot_key_value(line, "format")
    out = out + "|sources=" + word_from_int(sources)
    out = out + "|sections=" + v4_unit_snapshot_key_value(line, "sections")
    out = out + "|identity=" + v4_unit_snapshot_escape(v4_unit_snapshot_key_value(line, "identity"))
    give back out
}

task v4_unit_snapshot_fixture_source_line(line: word, source_id: int, path: word, fingerprint: word) -> word {
    pilot out = "unit-source|" + word_from_int(source_id)
    out = out + "|" + v4_unit_snapshot_escape(path)
    out = out + "|" + v4_unit_snapshot_field_raw(line, 3)
    out = out + "|" + v4_unit_snapshot_escape(fingerprint)
    out = out + "|" + v4_unit_snapshot_escape(v4_unit_snapshot_field(line, 5))
    give back out
}

task v4_unit_snapshot_fixture_source_variant(payload: word, mode: word) -> word {
    pilot out = ""
    pilot declared_sources = 0
    pilot changed_source = 0
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(payload, line_id)
        pilot output_line = line
        pilot kind = v4_unit_snapshot_field_raw(line, 0)
        if kind == "00-unit-snapshot" {
            declared_sources = word_to_int(v4_unit_snapshot_key_value(line, "sources"))
            pilot output_sources = declared_sources
            if mode == "duplicate-id" or mode == "duplicate-path" { output_sources += 1 }
            output_line = v4_unit_snapshot_fixture_header_with_sources(line, output_sources)
        } else if kind == "unit-source" and changed_source == 0 {
            pilot source_id = word_to_int(v4_unit_snapshot_field_raw(line, 1))
            pilot source_path = v4_unit_snapshot_field(line, 2)
            pilot fingerprint = v4_unit_snapshot_field(line, 4)
            if mode == "negative-id" {
                output_line = v4_unit_snapshot_fixture_source_line(line, 0 - 1, source_path, fingerprint)
            } else if mode == "sparse-id" {
                output_line = v4_unit_snapshot_fixture_source_line(line, declared_sources, source_path, fingerprint)
            } else if mode == "forged-fingerprint" {
                output_line = v4_unit_snapshot_fixture_source_line(line, source_id, source_path, "forged-fingerprint")
            } else if mode == "duplicate-id" {
                output_line = line + "\n" + line
            } else if mode == "duplicate-path" {
                output_line = line + "\n" + v4_unit_snapshot_fixture_source_line(line, declared_sources, source_path, fingerprint)
            }
            changed_source = 1
        }
        if out != "" { out = out + "\n" }
        out = out + output_line
        line_id += 1
    }
    give back out
}

task v4_unit_snapshot_fixture_section_line(payload: word, section_name: word) -> word {
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(payload, line_id)
        if v4_unit_snapshot_field_raw(line, 0) == "unit-section" and v4_unit_snapshot_field_raw(line, 1) == section_name {
            give back line
        }
        line_id += 1
    }
    give back ""
}

task v4_unit_snapshot_fixture_splice_section(base_payload: word, donor_payload: word, section_name: word) -> word {
    pilot donor_line = v4_unit_snapshot_fixture_section_line(donor_payload, section_name)
    pilot out = ""
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(base_payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(base_payload, line_id)
        pilot output_line = line
        if v4_unit_snapshot_field_raw(line, 0) == "unit-section" and v4_unit_snapshot_field_raw(line, 1) == section_name {
            output_line = donor_line
        }
        if out != "" { out = out + "\n" }
        out = out + output_line
        line_id += 1
    }
    give back out
}

task v4_unit_snapshot_fixture_splice_section_rebound(base_payload: word, donor_payload: word, section_name: word) -> word {
    pilot donor_line = v4_unit_snapshot_fixture_section_line(donor_payload, section_name)
    pilot base_header = v4_unit_snapshot_line(base_payload, 0)
    pilot base_identity = v4_unit_snapshot_key_value(base_header, "identity")
    pilot rebound_line = v4_unit_snapshot_section_line_with_identity(section_name, base_identity, v4_unit_snapshot_field(donor_line, 3))
    pilot out = ""
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(base_payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(base_payload, line_id)
        if v4_unit_snapshot_field_raw(line, 0) == "unit-section" and v4_unit_snapshot_field_raw(line, 1) == section_name {
            line = rebound_line
        }
        if out != "" { out = out + "\n" }
        out = out + line
        line_id += 1
    }
    give back out
}

task v4_unit_snapshot_splice_is_atomic(base_payload: word, donor_payload: word, section_name: word) -> word {
    pilot spliced = v4_unit_snapshot_fixture_splice_section(base_payload, donor_payload, section_name)
    pilot restore_result = v4_unit_snapshot_restore(spliced)
    give back v4_unit_snapshot_integrity_assert("cross-snapshot-splice-atomic", restore_result.starts_with("00-unit-snapshot-restore ok=0 ") and v4_unit_snapshot() == base_payload)
}

task v4_unit_snapshot_reset_compiler_state() -> void {
    v4_source_ready = 0
    v4_query_ready = 0
    v4_query_entry_len = 0
    v4_query_dep_len = 0
    v4_query_hit_total = 0
    v4_query_miss_total = 0
    v4_query_store_total = 0
    v4_query_revision = 1
    v4_lex_ready = 0
    v4_parse_ready = 0
    v4_hir_ready = 0
    v4_resolve_ready = 0
    v4_ty_ready = 0
    v4_ty_file_active_count_value = 0
    v4_ty_lifetime_outlives_scratch_active = 0
    v4_ty_lifetime_outlives_scratch_generation_value = 0
    v4_ty_borrowed_return_source_cache_entry_count_value = 0
    v4_ty_borrowed_return_source_cache_next_row_value = 0
    v4_ty_borrowed_return_source_cache_builds_value = 0
    v4_mir_ready = 0
    v4_borrowck_ready = 0
    v4_borrowck_provenance_state_active = 0
    v4_borrowck_provenance_source_active = 0
    v4_borrowck_provenance_generation_value = 0
    v4_borrowck_provenance_memo_active = 0
    v4_borrowck_provenance_memo_hits_value = 0
    v4_borrowck_provenance_integer_cache_cursor = 0
    v4_borrowck_provenance_integer_cache_evictions = 0
    v4_borrowck_path_canon_cache_cursor = 0
    v4_borrowck_path_canon_cache_evictions = 0
    v4_borrowck_path_canon_value_cache_cursor = 0
    v4_borrowck_path_canon_value_cache_evictions = 0
    v4_driver_ready = 0
    v4_editor_ready = 0
    v4_editor_sem_len = 0
    v4_editor_hover_len = 0
    v4_editor_defn_len = 0
    v4_editor_doc_len = 0
    v4_editor_comp_len = 0
    v4_session_init()
    v4_query_init()
    v4_lex_init()
    v4_parse_init()
    v4_hir_init()
    v4_resolve_init()
    v4_ty_init()
    v4_mir_init()
    v4_borrowck_init()
    v4_driver_init()
    v4_editor_init()
}

task v4_unit_snapshot_fresh_restore_assert(payload: word) -> void {
    v4_unit_snapshot_reset_compiler_state()
    pilot parents_empty = v4_source_count() == 0 and v4_lex_stream_count() == 0 and v4_parse_tree_count() == 0 and v4_hir_file_count() == 0 and v4_resolve_index_count() == 0 and v4_ty_file_count() == 0
    say v4_unit_snapshot_integrity_assert("fresh-parent-arenas-empty", parents_empty)
    pilot validation = v4_unit_snapshot_validate(payload)
    say v4_unit_snapshot_integrity_assert("fresh-preflight-accepted", validation.starts_with("00-unit-snapshot-import ok=1 "))
    pilot restore_result = v4_unit_snapshot_restore(payload)
    say v4_unit_snapshot_integrity_assert("fresh-complete-restore", restore_result.starts_with("00-unit-snapshot-restore ok=1 "))
    pilot ty_payload = v4_unit_snapshot_section_payload(payload, "ty")
    say v4_unit_snapshot_integrity_assert("fresh-post-restore-ty-strict", v4_ty_snapshot_validate(ty_payload).starts_with("ty-snapshot-import ok=1"))
}

pilot v4_unit_snapshot_source = "task main() -> int {\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    pilot name = \"Yuuko|Meiya\"\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    pilot bad = name - 1\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "    give back 0\n"
v4_unit_snapshot_source = v4_unit_snapshot_source + "}\n"

say v4_check_syntax_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_diagnostics_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_lsp_hover_text("unit-snapshot.fk", v4_unit_snapshot_source, 8)
say v4_lsp_definition_text("unit-snapshot.fk", v4_unit_snapshot_source, 5)
say v4_lsp_document_symbols_text("unit-snapshot.fk", v4_unit_snapshot_source)
say v4_lsp_completion_text("unit-snapshot.fk", v4_unit_snapshot_source, 0)

pilot v4_unit_snapshot_current_validation = ""
pilot v4_unit_snapshot_current_manifest = ""
pilot v4_unit_snapshot_current_health = ""
say v4_unit_snapshot_ref_store("before", v4_unit_snapshot())
v4_unit_snapshot_current_validation = v4_unit_snapshot_validate(v4_unit_snapshot_ref_text("before"))
v4_unit_snapshot_current_manifest = v4_unit_snapshot_manifest(v4_unit_snapshot_ref_text("before"))
v4_unit_snapshot_current_health = v4_unit_snapshot_health(v4_unit_snapshot_ref_text("before"))
say v4_unit_snapshot_current_validation
say v4_unit_snapshot_current_manifest
say v4_unit_snapshot_current_health
say v4_unit_snapshot_integrity_assert("current-snapshot-validated", v4_unit_snapshot_current_validation.starts_with("00-unit-snapshot-import ok=1 "))
say v4_unit_snapshot_integrity_assert("current-manifest-valid", v4_unit_snapshot_current_manifest.starts_with("00-unit-manifest|format=freak-00-unit-manifest-v1|ok=1|"))
say v4_unit_snapshot_integrity_assert("current-health-valid", v4_unit_snapshot_current_health.starts_with("00-unit-health|format=freak-00-unit-health-v1|ok=1|"))

pilot v4_unit_snapshot_before = ""
pilot v4_unit_snapshot_before_semantic_count = 0
pilot v4_unit_snapshot_before_hover_count = 0
pilot v4_unit_snapshot_before_definition_count = 0
pilot v4_unit_snapshot_missing = ""
pilot v4_unit_snapshot_duplicate = ""
pilot v4_unit_snapshot_corrupt = ""
pilot v4_unit_snapshot_unknown = ""
pilot v4_unit_snapshot_missing_validation = ""
pilot v4_unit_snapshot_duplicate_validation = ""
pilot v4_unit_snapshot_corrupt_validation = ""
pilot v4_unit_snapshot_unknown_validation = ""
