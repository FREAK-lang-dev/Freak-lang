say v4_unit_snapshot_integrity_assert("duplicate-section", v4_unit_snapshot_duplicate_validation.starts_with("00-unit-snapshot-import ok=0 "))
say v4_unit_snapshot_integrity_assert("corrupt-inner-payload", v4_unit_snapshot_corrupt_validation.starts_with("00-unit-snapshot-import ok=0 "))
