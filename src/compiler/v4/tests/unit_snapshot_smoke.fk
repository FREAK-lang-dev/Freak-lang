say v4_unit_snapshot_integrity_assert("current-diagnostics-valid", v4_unit_diagnostics_validation.starts_with("diagnostics-snapshot-import ok=1 "))
pilot v4_unit_diagnostics_line_idx = 0
pilot v4_unit_diagnostics_line_count = 0
v4_unit_diagnostics_line_count = v4_diagnostics_snapshot_line_count(v4_unit_diagnostics_payload)
repeat until v4_unit_diagnostics_line_idx >= v4_unit_diagnostics_line_count {
    pilot v4_unit_diagnostics_line = v4_diagnostics_snapshot_line(v4_unit_diagnostics_payload, v4_unit_diagnostics_line_idx)
    if v4_unit_diagnostics_line.starts_with("diagnostic|") {
        say "unit-diagnostics-diag-line=" + v4_unit_diagnostics_line
    }
    v4_unit_diagnostics_line_idx += 1
}

pilot v4_unit_snapshot_same_source_base = ""
pilot v4_unit_snapshot_same_source_file = 0
pilot v4_unit_snapshot_same_source_fingerprint = ""
pilot v4_unit_snapshot_same_source_donor = ""
pilot v4_unit_snapshot_same_source_base_identity = ""
pilot v4_unit_snapshot_same_source_donor_identity = ""
pilot v4_unit_snapshot_same_source_spliced = ""
pilot v4_unit_snapshot_same_source_validation = ""
pilot v4_unit_snapshot_same_source_restore = ""
v4_unit_snapshot_same_source_base = v4_unit_snapshot_before
v4_unit_snapshot_same_source_file = v4_source_find("unit-snapshot.fk")
v4_unit_snapshot_same_source_fingerprint = v4_source_fingerprint(v4_unit_snapshot_same_source_file)
v4_query_store("unit-snapshot:same-source-checkpoint", v4_unit_snapshot_same_source_fingerprint, "donor-only-query")
v4_unit_snapshot_same_source_donor = v4_unit_snapshot()
v4_unit_snapshot_same_source_base_identity = v4_unit_snapshot_key_value(v4_unit_snapshot_line(v4_unit_snapshot_same_source_base, 0), "identity")
v4_unit_snapshot_same_source_donor_identity = v4_unit_snapshot_key_value(v4_unit_snapshot_line(v4_unit_snapshot_same_source_donor, 0), "identity")
say v4_unit_snapshot_integrity_assert("same-source-checkpoint-setup", v4_unit_snapshot_same_source_base_identity != v4_unit_snapshot_same_source_donor_identity)
v4_unit_snapshot_same_source_spliced = v4_unit_snapshot_fixture_splice_section_rebound(v4_unit_snapshot_same_source_base, v4_unit_snapshot_same_source_donor, "query")
v4_unit_snapshot_same_source_validation = v4_unit_snapshot_validate(v4_unit_snapshot_same_source_spliced)
say v4_unit_snapshot_integrity_assert("same-source-rebound-splice-rejected", v4_unit_snapshot_same_source_validation.starts_with("00-unit-snapshot-import ok=0 ") and v4_unit_snapshot_same_source_validation.contains("identity-matches=0") and v4_unit_snapshot_same_source_validation.contains("section-identity-mismatches=0"))
v4_unit_snapshot_same_source_restore = v4_unit_snapshot_restore(v4_unit_snapshot_same_source_spliced)
say v4_unit_snapshot_integrity_assert("same-source-rebound-splice-atomic", v4_unit_snapshot_same_source_restore.starts_with("00-unit-snapshot-restore ok=0 ") and v4_unit_snapshot() == v4_unit_snapshot_same_source_donor)

