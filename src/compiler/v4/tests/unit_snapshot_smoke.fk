v4_unit_snapshot_atomic_state = v4_unit_snapshot()
v4_unit_snapshot_negative_id = v4_unit_snapshot_fixture_source_variant(v4_unit_snapshot_atomic_state, "negative-id")
v4_unit_snapshot_sparse_id = v4_unit_snapshot_fixture_source_variant(v4_unit_snapshot_atomic_state, "sparse-id")
v4_unit_snapshot_duplicate_id = v4_unit_snapshot_fixture_source_variant(v4_unit_snapshot_atomic_state, "duplicate-id")
v4_unit_snapshot_duplicate_path = v4_unit_snapshot_fixture_source_variant(v4_unit_snapshot_atomic_state, "duplicate-path")
v4_unit_snapshot_forged_fingerprint = v4_unit_snapshot_fixture_source_variant(v4_unit_snapshot_atomic_state, "forged-fingerprint")
v4_unit_snapshot_atomic_result = v4_unit_snapshot_restore(v4_unit_snapshot_negative_id)
v4_unit_snapshot_atomic_ok = v4_unit_snapshot_atomic_ok * v4_unit_snapshot_restore_is_atomic(v4_unit_snapshot_atomic_result, v4_unit_snapshot_atomic_state)
say v4_unit_snapshot_integrity_assert("negative-source-id-atomic", v4_unit_snapshot_atomic_ok == 1)
v4_unit_snapshot_atomic_result = v4_unit_snapshot_restore(v4_unit_snapshot_sparse_id)
v4_unit_snapshot_atomic_ok = v4_unit_snapshot_atomic_ok * v4_unit_snapshot_restore_is_atomic(v4_unit_snapshot_atomic_result, v4_unit_snapshot_atomic_state)
say v4_unit_snapshot_integrity_assert("sparse-source-id-atomic", v4_unit_snapshot_atomic_ok == 1)
v4_unit_snapshot_atomic_result = v4_unit_snapshot_restore(v4_unit_snapshot_duplicate_id)
v4_unit_snapshot_atomic_ok = v4_unit_snapshot_atomic_ok * v4_unit_snapshot_restore_is_atomic(v4_unit_snapshot_atomic_result, v4_unit_snapshot_atomic_state)
say v4_unit_snapshot_integrity_assert("duplicate-source-id-atomic", v4_unit_snapshot_atomic_ok == 1)
v4_unit_snapshot_atomic_result = v4_unit_snapshot_restore(v4_unit_snapshot_duplicate_path)
v4_unit_snapshot_atomic_ok = v4_unit_snapshot_atomic_ok * v4_unit_snapshot_restore_is_atomic(v4_unit_snapshot_atomic_result, v4_unit_snapshot_atomic_state)
say v4_unit_snapshot_integrity_assert("duplicate-source-path-atomic", v4_unit_snapshot_atomic_ok == 1)
v4_unit_snapshot_atomic_result = v4_unit_snapshot_restore(v4_unit_snapshot_forged_fingerprint)
v4_unit_snapshot_atomic_ok = v4_unit_snapshot_atomic_ok * v4_unit_snapshot_restore_is_atomic(v4_unit_snapshot_atomic_result, v4_unit_snapshot_atomic_state)
say v4_unit_snapshot_integrity_assert("forged-source-fingerprint-atomic", v4_unit_snapshot_atomic_ok == 1)

pilot v4_unit_snapshot_preflight_text = ""
pilot v4_unit_snapshot_preflight_revision = 0
pilot v4_unit_snapshot_failed_restore = ""
v4_unit_snapshot_preflight_text = v4_source_text(v4_unit_snapshot_before_file_id)
v4_unit_snapshot_preflight_revision = v4_source_revision(v4_unit_snapshot_before_file_id)
v4_unit_snapshot_failed_restore = v4_unit_snapshot_restore(v4_unit_snapshot_missing)
say v4_unit_snapshot_failed_restore
say v4_unit_snapshot_integrity_assert("invalid-restore-rejected", v4_unit_snapshot_failed_restore.starts_with("00-unit-snapshot-restore ok=0 ") and v4_unit_snapshot_atomic_ok == 1)
say v4_unit_snapshot_integrity_assert("preflight-preserves-source-text", v4_source_text(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_preflight_text)
say v4_unit_snapshot_integrity_assert("preflight-preserves-source-revision", v4_source_revision(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_preflight_revision)

pilot v4_unit_snapshot_extra_path = "unit-snapshot-extra.fk"
pilot v4_unit_snapshot_extra_source = "task extra() -> int {\n"
v4_unit_snapshot_extra_source = v4_unit_snapshot_extra_source + "    give back 1\n"
v4_unit_snapshot_extra_source = v4_unit_snapshot_extra_source + "}\n"
pilot v4_unit_snapshot_extra_file_id = 0
pilot v4_unit_snapshot_extra_semantic_id = 0
pilot v4_unit_snapshot_extra_hover_id = 0
pilot v4_unit_snapshot_extra_definition_id = 0
pilot v4_unit_snapshot_extra_query_key = ""
pilot v4_unit_snapshot_extra_query_input = "snapshot-extra-input"
pilot v4_unit_snapshot_extra_state = ""
v4_unit_snapshot_extra_file_id = v4_source_set_text(v4_unit_snapshot_extra_path, v4_unit_snapshot_extra_source)
v4_check_syntax_text(v4_unit_snapshot_extra_path, v4_unit_snapshot_extra_source)
v4_unit_snapshot_extra_semantic_id = v4_editor_semantic_fact_new(v4_unit_snapshot_extra_path, 5, 0 - 1, "identifier", "extra", V4_NO_SPAN, 0 - 1, "extra", "task", 0 - 1, "extra", "task", "extra::task", "task() -> int")
v4_unit_snapshot_extra_hover_id = v4_editor_hover_new(v4_unit_snapshot_extra_path, 5, v4_unit_snapshot_extra_semantic_id, "extra", "task", "task() -> int", "**extra**")
v4_unit_snapshot_extra_definition_id = v4_editor_definition_new(v4_unit_snapshot_extra_path, 5, v4_unit_snapshot_extra_semantic_id, "extra", "task", "extra::task", 0 - 1, V4_NO_SPAN, 1)
v4_unit_snapshot_extra_query_key = "snapshot-extra:" + v4_unit_snapshot_extra_path
v4_query_store(v4_unit_snapshot_extra_query_key, v4_unit_snapshot_extra_query_input, "stale-cache-hit")
v4_unit_snapshot_extra_state = v4_unit_snapshot()
say v4_unit_snapshot_integrity_assert("extras-visible-before-restore", v4_source_find(v4_unit_snapshot_extra_path) == v4_unit_snapshot_extra_file_id and v4_semantic_fact_exists(v4_unit_snapshot_extra_semantic_id) and v4_hover_exists(v4_unit_snapshot_extra_hover_id) and v4_definition_at_exists(v4_unit_snapshot_extra_definition_id))
say v4_unit_snapshot_integrity_assert("extra-cache-hit-before-restore", v4_query_get(v4_unit_snapshot_extra_query_key, v4_unit_snapshot_extra_query_input) == "stale-cache-hit")

pilot v4_unit_snapshot_valid_restore = ""
v4_unit_snapshot_valid_restore = v4_unit_snapshot_restore(v4_unit_snapshot_before)
say v4_unit_snapshot_valid_restore
say v4_unit_snapshot_integrity_assert("valid-restore", v4_unit_snapshot_valid_restore.starts_with("00-unit-snapshot-restore ok=1 "))
say v4_unit_snapshot_integrity_assert("valid-restore-source-text", v4_source_text(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_source)
say v4_unit_snapshot_integrity_assert("valid-restore-source-revision", v4_source_revision(v4_unit_snapshot_before_file_id) == v4_unit_snapshot_before_revision)
say v4_unit_snapshot_integrity_assert("extra-source-removed", v4_source_find(v4_unit_snapshot_extra_path) < 0 and v4_source_path(v4_unit_snapshot_extra_file_id) == "")
say v4_unit_snapshot_integrity_assert("extra-semantic-removed", v4_semantic_fact_count() == v4_unit_snapshot_before_semantic_count and v4_semantic_fact_exists(v4_unit_snapshot_extra_semantic_id) == false and v4_semantic_at_path(v4_unit_snapshot_extra_semantic_id) == "")
say v4_unit_snapshot_integrity_assert("extra-hover-removed", v4_hover_count() == v4_unit_snapshot_before_hover_count and v4_hover_exists(v4_unit_snapshot_extra_hover_id) == false and v4_hover_path(v4_unit_snapshot_extra_hover_id) == "")
say v4_unit_snapshot_integrity_assert("extra-definition-removed", v4_definition_at_count() == v4_unit_snapshot_before_definition_count and v4_definition_at_exists(v4_unit_snapshot_extra_definition_id) == false and v4_definition_at_path(v4_unit_snapshot_extra_definition_id) == "")
say v4_unit_snapshot_integrity_assert("extra-query-removed", v4_query_entry_count_for_key(v4_unit_snapshot_extra_query_key) == 0)
say v4_unit_snapshot_integrity_assert("extra-cache-miss-after-restore", v4_query_get(v4_unit_snapshot_extra_query_key, v4_unit_snapshot_extra_query_input) == "")
pilot v4_unit_snapshot_foreign_validation = ""
pilot v4_unit_snapshot_reused_source = ""
pilot v4_unit_snapshot_reused_source_id = 0
v4_unit_snapshot_foreign_validation = v4_unit_snapshot_validate(v4_unit_snapshot_extra_state)
v4_unit_snapshot_reused_source = "task reused() -> int {\n"
v4_unit_snapshot_reused_source = v4_unit_snapshot_reused_source + "    give back 2\n"
v4_unit_snapshot_reused_source = v4_unit_snapshot_reused_source + "}\n"
v4_unit_snapshot_reused_source_id = v4_source_set_text("unit-snapshot-reused.fk", v4_unit_snapshot_reused_source)
say v4_unit_snapshot_integrity_assert("foreign-context-validation-accepted", v4_unit_snapshot_foreign_validation.starts_with("00-unit-snapshot-import ok=1 "))
say v4_unit_snapshot_integrity_assert("foreign-context-source-id-reused", v4_unit_snapshot_reused_source_id == v4_unit_snapshot_extra_file_id)
v4_unit_snapshot_restore(v4_unit_snapshot_before)
pilot v4_unit_snapshot_soak_id = 0
pilot v4_unit_snapshot_soak_ok = true
repeat until v4_unit_snapshot_soak_id >= 80 {
    pilot v4_unit_snapshot_soak_payload = v4_unit_snapshot()
    if not v4_unit_snapshot_soak_payload.starts_with("00-unit-snapshot|format=freak-00-unit-snapshot-v2") {
        v4_unit_snapshot_soak_ok = false
    }
    v4_unit_snapshot_soak_id += 1
}
say v4_unit_snapshot_integrity_assert("snapshot-soak-80", v4_unit_snapshot_soak_ok)
say v4_lsp_handle_text_request("workspace/unitSnapshotRestore", "unit-snapshot.fk", v4_unit_snapshot_ref_text("before"), 0)
say v4_lsp_handle_request("workspace/unitSnapshotRestore", "unit-snapshot.fk", 0)
pilot v4_unit_snapshot_wrong_format_restore = ""
v4_unit_snapshot_wrong_format_restore = v4_unit_snapshot_restore("00-unit-snapshot|format=wrong\nend|wrong")
say v4_unit_snapshot_wrong_format_restore
say v4_unit_snapshot_integrity_assert("wrong-format-restore-rejected", v4_unit_snapshot_wrong_format_restore.starts_with("00-unit-snapshot-restore ok=0 "))
v4_unit_snapshot_fresh_restore_assert(v4_unit_snapshot_before)
