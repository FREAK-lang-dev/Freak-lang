    src = src + "    give back holder.0.hp + duplicate.hp\n"
    src = src + "}\n"
    src = src + "task dynamic_index_rebind<'a,'b>(lend 'a first: Ship, lend 'b second: Ship, index: int) -> lend 'a Ship {\n"
    src = src + "    pilot slots: [lend Ship;2] = [lend first, lend first]\n"
    src = src + "    slots[index] = lend second\n"
    src = src + "    give back slots[0]\n"
    src = src + "}\n"
    give back src
}

task v4_fixed_aggregate_result_for(borrow_id: int, body_name: word) -> int {
    pilot mir_id = v4_borrowck_mir_id(borrow_id)
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot def_id = v4_resolve_def_for_name(resolve_id, body_name)
    give back v4_borrowck_lookup_result(borrow_id, def_id)
}

task v4_fixed_aggregate_body_for(mir_id: int, body_name: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot def_id = v4_resolve_def_for_name(resolve_id, body_name)
    give back v4_mir_lookup_body(mir_id, def_id)
}

task v4_fixed_aggregate_local_stmt(mir_id: int, body_id: int, local_name: word) -> int {
    pilot stmt_id = 0
    repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
        pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
        if place_id >= 0 and v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_local {
            if v4_mir_place_text(mir_id, body_id, place_id) == local_name { give back stmt_id }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_fixed_aggregate_local_rvalue(mir_id: int, body_id: int, local_name: word) -> int {
    pilot stmt_id = 0
    repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
        pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
        if place_id >= 0 and v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_local {
            if v4_mir_place_text(mir_id, body_id, place_id) == local_name {
                give back v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_fixed_aggregate_status(borrow_id: int, body_name: word) -> word {
    pilot result_id = v4_fixed_aggregate_result_for(borrow_id, body_name)
    give back v4_borrowck_result_status(borrow_id, result_id)
}

task v4_fixed_aggregate_mir_diag_contains(mir_id: int, needle: word) -> bool {
    pilot diag_id = 0
    repeat until diag_id >= v4_mir_diag_count(mir_id) {
        if v4_diag_message(v4_mir_diag(mir_id, diag_id)) == needle { give back true }
        diag_id += 1
    }
    give back false
}

task v4_fixed_aggregate_mir_diag_count(mir_id: int, needle: word) -> int {
    pilot count = 0
    pilot diag_id = 0
    repeat until diag_id >= v4_mir_diag_count(mir_id) {
        if v4_diag_message(v4_mir_diag(mir_id, diag_id)) == needle { count += 1 }
        diag_id += 1
    }
    give back count
}

task v4_fixed_aggregate_borrow_diag_contains(borrow_id: int, needle: word) -> bool {
    pilot diag_id = 0
    repeat until diag_id >= v4_borrowck_diag_count(borrow_id) {
        if v4_diag_message(v4_borrowck_diag(borrow_id, diag_id)) == needle { give back true }
        diag_id += 1
    }
    give back false
}

