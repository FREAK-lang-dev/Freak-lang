    src = src + "}\n"
    src = src + "task identity<T>(value: T) -> T {\n"
    src = src + "    give back value\n"
    src = src + "}\n"
    src = src + "task tuple_sibling_dead(first: Ship, second: Ship) -> int {\n"
    src = src + "    pilot views = (lend mut first, lend second)\n"
    src = src + "    second.hp = 2\n"
    src = src + "    pilot final_use = views.0.hp\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task tuple_left_live(first: Ship, second: Ship) -> int {\n"
