    src = src + "    pilot final_use = views[0].hp\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task shape_sibling_dead(first: Ship, second: Ship) -> int {\n"
    src = src + "    pilot views = Pair<lend mut Ship,lend mut Ship> " + v4_fixed_aggregate_braces(" right: lend mut second, left: lend mut first ") + "\n"
    src = src + "    second.hp = 6\n"
    src = src + "    pilot final_use = views.left.hp\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task shape_left_live(first: Ship, second: Ship) -> int {\n"
