-- V4 local fixed-layout loan storage, projection, and liveness fixture.
-- Verification prepends the V4 crates before this file.

task v4_fixed_aggregate_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_fixed_aggregate_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_fixed_aggregate_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "doctrine Cloneable {\n"
    src = src + "}\n"
    src = src + "shape Owned {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape CloneOwned {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "impl Cloneable for CloneOwned {\n"
    src = src + "}\n"
    src = src + "shape SharedOwned<'a> {\n"
    src = src + "    view: lend 'a Ship\n"
    src = src + "    owned: Owned\n"
    src = src + "}\n"
    src = src + "shape Pair<A,B> {\n"
