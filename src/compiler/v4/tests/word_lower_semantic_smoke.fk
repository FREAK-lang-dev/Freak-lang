-- One compiler document per argv case; clone proves the unmodified generic path.
task v4_word_lower_assert(condition: bool, label: word) -> void {
    if not condition { panic("word-lower " + label) }
}

task v4_word_lower_source(method: word) -> word {
    pilot src = "task fresh(lend source: word) -> word " + chr(123) + "\n"
    src = src + " give back source." + method + "()." + method + "()\n" + chr(125) + "\n"
    src = src + "task main() -> int " + chr(123) + "\n"
    src = src + " pilot mut source: word = \"A\\0B\"\n"
    src = src + " pilot outcome = fresh(lend source)\n"
    src = src + " say source\n source = source." + method + "()\n say outcome\n"
    src = src + " take(\"TEMP\")." + method + "()\n give back 0\n" + chr(125) + "\n"
    src = src + "task take(source: word) -> word " + chr(123) + " give back source " + chr(125) + "\n"
    give back src
}

task v4_word_lower_status(borrow: int, name: word) -> word {
    pilot mir = v4_borrowck_mir_id(borrow)
    pilot body = v4_mir_lookup_body_name(mir, name)
    pilot outcome = v4_borrowck_lookup_result(borrow, v4_mir_body_def(mir, body))
    give back v4_borrowck_result_status(borrow, outcome)
}

task v4_word_lower_generic(method: word, code: int) -> void {
    pilot borrow = v4_borrowck_text_cached("word-lower-generic.fk", v4_word_lower_source(method))
    pilot mir = v4_borrowck_mir_id(borrow)
    pilot ty = v4_mir_ty_id(mir)
    v4_word_lower_assert(v4_ty_diag_count(ty) == 0 and v4_mir_diag_count(mir) == 0, "generic frontend")
    pilot diag = 0
    repeat until diag >= v4_borrowck_diag_count(borrow) {
        say v4_borrowck_diag(borrow, diag)
        diag += 1
    }
    if v4_borrowck_diag_count(borrow) > 0 {
        pilot inspect = 0
        repeat until inspect >= v4_mir_body_count(mir) {
            pilot body_name = v4_mir_body_name(mir, inspect)
            say "word-lower-debug body=" + body_name + " status=" + v4_word_lower_status(borrow, body_name)
            inspect += 1
        }
    }
    pilot body = v4_mir_lookup_body_name(mir, "fresh")
    pilot count = 0
    pilot rv = 0
    repeat until rv >= v4_mir_body_rvalue_count(mir, body) {
        if v4_mir_word_intrinsic_kind(mir, body, rv) == method {
            v4_word_lower_assert(v4_mir_rvalue_is_builtin_word(mir, body, rv), "closed valid identity")
            v4_word_lower_assert(v4_mir_builtin_method_identity_code(v4_mir_rvalue_builtin_method(mir, body, rv)) == code, "closed code")
            pilot argument = v4_mir_rvalue_call_arg(mir, body, rv, 0)
            v4_word_lower_assert(v4_mir_rvalue_kind(mir, body, argument) == v4_mir_rvalue_lend and v4_mir_rvalue_ty(mir, body, argument) == "lend word", "borrow wrapper")
            pilot child = v4_mir_rvalue_lhs(mir, body, argument)
            v4_word_lower_assert(child < argument and v4_mir_rvalue_ty(mir, body, child) == v4_ty_word, "prior owned receiver")
            count += 1
        }
        rv += 1
    }
    v4_word_lower_assert(count == 2, "both chained method calls")
    v4_word_lower_assert(v4_borrowck_diag_count(borrow) == 0, "generic ownership")
    pilot codegen = v4_codegen_llvm_lower_owned_mir(0, mir)
    v4_word_lower_assert(v4_codegen_llvm_diag_count(codegen) == 0 and v4_codegen_llvm_native_module_error(codegen) == "", "generic native seal")
    v4_word_lower_assert(v4_codegen_llvm_module_text(codegen, v4_target_spec_new("x86_64-unknown-linux-gnu")) != "", "generic module")
    say "word-lower generic=" + method + " chained=2 borrowed=true temporary=true self-replace=true sealed=true"
}

task v4_word_lower_ordered() -> void {
    pilot src = "task consume(value: word) -> int " + chr(123) + " give back value.length() " + chr(125) + "\n"
    src = src + "task bad() -> int " + chr(123) + " pilot value = \"A\"; give back consume(value) + value.to_lower().length() " + chr(125) + "\n"
    src = src + "task good() -> int " + chr(123) + " pilot value = \"A\"; give back value.to_lower().length() + consume(value) " + chr(125) + "\n"
    pilot borrow = v4_borrowck_text_cached("word-lower-ordered.fk", src)
    pilot mir = v4_borrowck_mir_id(borrow)
    v4_word_lower_assert(v4_ty_diag_count(v4_mir_ty_id(mir)) == 0 and v4_mir_diag_count(mir) == 0, "ordered frontend")
    v4_word_lower_assert(v4_word_lower_status(borrow, "bad") == v4_borrowck_blocked, "consume before observer")
    v4_word_lower_assert(v4_word_lower_status(borrow, "good") == v4_borrowck_clean, "observer before consume")
    pilot rejected = v4_codegen_llvm_lower_owned_mir(0, mir)
    v4_word_lower_assert(v4_codegen_llvm_native_module_error(rejected) != "" and v4_codegen_llvm_module_text(rejected, v4_target_spec_new("x86_64-unknown-linux-gnu")) == "", "ordered bad cannot seal")
    say "word-lower ordered-consume-rejected=true reverse-accepted=true"
}

task v4_word_lower_negative(mode: word) -> void {
    pilot expression = "source.to_lower(1)"
    pilot wanted = "word intrinsic argument count mismatch"
    pilot declaration = "pilot source = \"A\"; "
    if mode == "4" { declaration = "pilot source = 1; "; expression = "source.to_lower()"; wanted = "receiver has no matching method" }
    if mode == "5" { expression = "source.to_lower<int>()"; wanted = "method takes no type arguments" }
    if mode == "6" { expression = "source.to_lower(value: 1)"; wanted = "word intrinsic named arguments" }
    pilot source = "task main() -> int " + chr(123) + declaration + expression + "; give back 0 " + chr(125) + "\n"
    pilot mir = v4_mir_text_cached("word-lower-negative.fk", source)
    pilot found: bool = false
    pilot idx = 0
    repeat until idx >= v4_mir_diag_count(mir) {
        if v4_mir_diag(mir, idx).contains(wanted) { found = true }
        idx += 1
    }
    v4_word_lower_assert(found, "targeted diagnostic " + wanted)
    pilot rejected = v4_codegen_llvm_lower_owned_mir(0, mir)
    v4_word_lower_assert(v4_codegen_llvm_native_module_error(rejected) != "" and v4_codegen_llvm_module_text(rejected, v4_target_spec_new("x86_64-unknown-linux-gnu")) == "", "negative has no module")
    say "word-lower negative=" + mode + " diagnosed=true no-module=true"
}

task v4_word_lower_semantic_run() -> void {
    pilot mode = "0"
    if process::args_count() > 1 { mode = process::arg(1) }
    if mode == "0" { v4_word_lower_generic("clone", 118) } else if mode == "1" { v4_word_lower_generic("to_lower", 119) } else if mode == "2" { v4_word_lower_ordered() } else if mode == "3" or mode == "4" or mode == "5" or mode == "6" { v4_word_lower_negative(mode) } else { panic("word-lower unknown semantic case") }
}
v4_word_lower_semantic_run()
