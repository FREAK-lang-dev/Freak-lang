pilot v4_mir_tuple_access_assign_rvalue = v4_mir_stmt_rvalue(v4_mir_tuple_access_mir, v4_mir_tuple_access_main_body, 5)
pilot v4_mir_tuple_access_return_rvalue = v4_mir_stmt_rvalue(v4_mir_tuple_access_mir, v4_mir_tuple_access_main_body, 6)
