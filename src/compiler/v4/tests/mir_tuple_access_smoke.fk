-- V4 MIR typed tuple access smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_tuple_access_good_source() -> word {
    pilot src = "task main() -> int {\n"
    src = src + "    pilot pair: (int,word) = (7, \"ace\")\n"
    src = src + "    pilot left = pair.0\n"
    src = src + "    pilot label = pair.1\n"
    src = src + "    pilot nested: ((int,int),word) = ((1, 2), \"team\")\n"
    src = src + "    pilot inner = nested.0.1\n"
    src = src + "    pair.0 = left + 1\n"
    src = src + "    give back inner\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_access_bad_range_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair = (7, \"ace\")\n"
    src = src + "    pilot nope = pair.2\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_access_bad_non_tuple_source() -> word {
    pilot src = "task bad(power: int) -> void {\n"
    src = src + "    pilot nope = power.0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_access_bad_named_slot_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair = (7, \"ace\")\n"
    src = src + "    pilot nope = pair.name\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_tuple_access_stream = v4_lex_text(0, v4_mir_tuple_access_good_source())
