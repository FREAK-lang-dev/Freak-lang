-- V4 MIR only-on route-locked scope smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_only_on_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_mir_only_on_find_stmt(mir_id: int, body_id: int, kind: word, lhs: word) -> int {
    pilot stmt_id = 0
    repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == kind and v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == lhs {
            give back stmt_id
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_mir_only_on_good_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_only_on_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task score(event: Event) -> int {\n"
    src = src + "    only on Event::Key " + v4_mir_only_on_braces(" code, repeat: held ") + " from event {\n"
    src = src + "        say held\n"
    src = src + "        give back code\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_only_on_bad_nonroute_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task bad(score: int) -> int {\n"
    src = src + "    only on Event::Key from score {\n"
    src = src + "        give back 1\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_only_on_bad_other_route_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "route Result {\n"
    src = src + "    Win / Lose\n"
    src = src + "}\n"
    src = src + "task bad(outcome: Outcome) -> int {\n"
    src = src + "    only on Result::Win from outcome {\n"
    src = src + "        give back 1\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

