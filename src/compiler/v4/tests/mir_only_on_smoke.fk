task v4_mir_only_on_bad_pattern_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "task bad(outcome: Outcome) -> int {\n"
    src = src + "    only on 7 from outcome {\n"
    src = src + "        give back 1\n"
    src = src + "    }\n"
