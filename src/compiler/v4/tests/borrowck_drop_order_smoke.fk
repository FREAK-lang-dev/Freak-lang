say "drop-branch-partial-if-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_borrowck_drop_order_check, v4_borrowck_drop_order_branch_partial_result, v4_borrowck_path_drop_if))
say "drop-branch-partial-if-0=" + v4_borrowck_drop_order_nth_path_text(v4_borrowck_drop_order_check, v4_borrowck_drop_order_branch_partial_result, v4_borrowck_path_drop_if, 0)
say "drop-branch-partial-if-1=" + v4_borrowck_drop_order_nth_path_text(v4_borrowck_drop_order_check, v4_borrowck_drop_order_branch_partial_result, v4_borrowck_path_drop_if, 1)
