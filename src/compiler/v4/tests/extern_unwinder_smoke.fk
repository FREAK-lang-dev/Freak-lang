-- V4 extern unwinder-import diagnostic smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_extern_unwinder_good_source() -> word {
    pilot src = "extern [C] {\n"
    src = src + "    task puts(s: *const std::ffi::c_char) -> std::ffi::c_int\n"
    src = src + "    task abs(x: std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_unwinder_bad_source() -> word {
    pilot src = "extern [C] {\n"
    src = src + "    @link_name(\"longjmp\")\n"
    src = src + "    task safe_jump(buf: *mut std::ffi::c_void, val: std::ffi::c_int) -> void\n"
    src = src + "    task setjmp(buf: *mut std::ffi::c_void) -> std::ffi::c_int\n"
    src = src + "    task _Unwind_RaiseException(obj: *mut std::ffi::c_void) -> std::ffi::c_int\n"
    src = src + "    task __cxa_throw(obj: *mut std::ffi::c_void, ti: *mut std::ffi::c_void, dtor: *mut std::ffi::c_void) -> void\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_extern_unwinder_good_text = v4_extern_unwinder_good_source()
pilot v4_extern_unwinder_good_stream = v4_lex_text(0, v4_extern_unwinder_good_text)
pilot v4_extern_unwinder_good_tree = v4_parse_stream(0, v4_extern_unwinder_good_stream)
pilot v4_extern_unwinder_good_hir = v4_hir_lower_tree(0, v4_extern_unwinder_good_tree)
pilot v4_extern_unwinder_good_resolve = v4_resolve_lower_hir(0, v4_extern_unwinder_good_hir)
pilot v4_extern_unwinder_good_ty = v4_ty_lower_resolve(0, v4_extern_unwinder_good_resolve)

say "extern-unwinder-good-diag-count=" + word_from_int(v4_ty_diag_count(v4_extern_unwinder_good_ty))

pilot v4_extern_unwinder_bad_text = v4_extern_unwinder_bad_source()
pilot v4_extern_unwinder_bad_stream = v4_lex_text(1, v4_extern_unwinder_bad_text)
pilot v4_extern_unwinder_bad_tree = v4_parse_stream(1, v4_extern_unwinder_bad_stream)
pilot v4_extern_unwinder_bad_hir = v4_hir_lower_tree(1, v4_extern_unwinder_bad_tree)
pilot v4_extern_unwinder_bad_resolve = v4_resolve_lower_hir(1, v4_extern_unwinder_bad_hir)
pilot v4_extern_unwinder_bad_ty = v4_ty_lower_resolve(1, v4_extern_unwinder_bad_resolve)

say "extern-unwinder-bad-diag-count=" + word_from_int(v4_ty_diag_count(v4_extern_unwinder_bad_ty))
say "extern-unwinder-bad-diag0-severity=" + v4_diag_severity_name(v4_diag_severity(v4_ty_diag(v4_extern_unwinder_bad_ty, 0)))
say "extern-unwinder-bad-diag0-message=" + v4_diag_message(v4_ty_diag(v4_extern_unwinder_bad_ty, 0))
say "extern-unwinder-bad-diag0-help=" + v4_diag_help(v4_ty_diag(v4_extern_unwinder_bad_ty, 0))
say "extern-unwinder-bad-diag1-severity=" + v4_diag_severity_name(v4_diag_severity(v4_ty_diag(v4_extern_unwinder_bad_ty, 1)))
say "extern-unwinder-bad-diag1-message=" + v4_diag_message(v4_ty_diag(v4_extern_unwinder_bad_ty, 1))
say "extern-unwinder-bad-diag1-help=" + v4_diag_help(v4_ty_diag(v4_extern_unwinder_bad_ty, 1))
say "extern-unwinder-bad-diag2-severity=" + v4_diag_severity_name(v4_diag_severity(v4_ty_diag(v4_extern_unwinder_bad_ty, 2)))
say "extern-unwinder-bad-diag2-message=" + v4_diag_message(v4_ty_diag(v4_extern_unwinder_bad_ty, 2))
say "extern-unwinder-bad-diag2-help=" + v4_diag_help(v4_ty_diag(v4_extern_unwinder_bad_ty, 2))
say "extern-unwinder-bad-diag3-severity=" + v4_diag_severity_name(v4_diag_severity(v4_ty_diag(v4_extern_unwinder_bad_ty, 3)))
say "extern-unwinder-bad-diag3-message=" + v4_diag_message(v4_ty_diag(v4_extern_unwinder_bad_ty, 3))
say "extern-unwinder-bad-diag3-help=" + v4_diag_help(v4_ty_diag(v4_extern_unwinder_bad_ty, 3))
