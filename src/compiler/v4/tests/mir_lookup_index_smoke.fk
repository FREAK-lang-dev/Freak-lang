-- MIR-owned derived indexes: exact identities, physical order and cold readers.
task mir_index_assert(condition: bool, label: word) -> void {
    if not condition { panic("MIR lookup index: " + label) }
}

task mir_index_available_handles() -> int {
    pilot holders = array_new()
    pilot count = 0
    pilot exhausted = false
    repeat until exhausted or count >= 2048 {
        pilot handle = array_new()
        if handle < 0 { exhausted = true } else {
            array_push(holders, word_from_int(handle))
            count += 1
        }
    }
    pilot row = 0
    repeat until row >= count {
        array_release(word_to_int(array_get(holders, row)))
        row += 1
    }
    array_release(holders)
    give back count
}

task mir_index_name_scale(mir: int, host_body: int, say_call: int, count: int) -> void {
    -- Identity-only columns exercise the hash with hundreds of physical rows
    -- under the 1,024-handle cap. These rows have no body graphs: this owner
    -- must not be snapshotted, validated or executed after this extension.
    pilot stable = v4_mir_body_lookup_index_handle(mir)
    pilot available = mir_index_available_handles()
    pilot built = v4_mir_body_lookup_build_records
    pilot row = v4_mir_body_count(mir)
    repeat until row >= count {
        pilot key = "indexed" + word_from_int(row)
        pilot def_key = "def-" + key
        pilot expected = row
        if row == 12 {
            key = ""
            def_key = ""
            expected = 2
        }
        array_push(v4_mir_defs_handle(mir), def_key)
        array_push(v4_mir_names_handle(mir), key)
        v4_mir_body_lookup_added(mir, row)
        mir_index_assert(v4_mir_lookup_body(mir, def_key) == expected and v4_mir_lookup_body_name(mir, key) == expected, "identity column append and empty placeholder")
        row += 1
    }
    pilot packed = v4_mir_body_lookup_index_handle(mir)
    pilot buckets = word_to_int(array_get(packed, 1))
    mir_index_assert(packed == stable and v4_mir_body_lookup_index_is_ready(mir) and array_len(packed) == 3 + 2 * buckets and v4_mir_body_lookup_build_records - built <= 2 * count and mir_index_available_handles() == available, "bounded identity construction")

    -- Negative control: the unchanged cold semantics read every physical name.
    v4_mir_invalidate_body_lookup_index(mir)
    pilot reads = v4_mir_body_name_reads
    built = v4_mir_body_lookup_build_records
    mir_index_assert(v4_codegen_llvm_find_mir_body(mir, v4_mir_call_say_literal) < 0 and v4_mir_body_name_reads - reads == count and v4_mir_body_lookup_build_records == built and not v4_mir_body_lookup_index_is_ready(mir) and mir_index_available_handles() == available, "cold actual name-reader control")
    mir_index_assert(v4_mir_finalize_body_lookup_index(mir) and v4_mir_body_lookup_index_handle(mir) == stable, "name explicit publication")
    reads = v4_mir_body_name_reads
    built = v4_mir_body_lookup_build_records
    pilot probes = v4_mir_body_lookup_probes
    pilot linear = v4_mir_body_lookup_linear_steps
    row = 0
    repeat until row >= 64 {
        mir_index_assert(v4_mir_lookup_body_name(mir, v4_mir_call_say_literal) < 0 and v4_codegen_llvm_find_mir_body(mir, v4_mir_call_say_literal) < 0 and v4_codegen_llvm_variadic_arg_promoted_type(mir, host_body, say_call, 0) == v4_ty_word, "warm codegen literal-say name miss")
        row += 1
    }
    mir_index_assert(v4_mir_body_name_reads - reads <= 24 * 3 * 64 and v4_mir_body_lookup_probes - probes <= 25 * 3 * 64 and v4_mir_body_lookup_linear_steps == linear and v4_mir_body_lookup_build_records == built and mir_index_available_handles() == available, "warm actual name-reader work bounded")
}

task mir_index_run() -> void {
    pilot foreign = array_new()
    pilot foreign_value = word_from_int(foreign)
    array_push(foreign, foreign_value)
    pilot cold_capacity = mir_index_available_handles()
    mir_index_assert(v4_mir_lookup_body(0, "") < 0 and v4_mir_lookup_body_name(0, "") < 0 and v4_codegen_llvm_find_mir_body(0, "") < 0 and v4_mir_block_first_stmt(0, 0, 0) < 0 and v4_mir_block_next_stmt(0, 0, 0, 0) < 0 and v4_mir_ready == 0 and mir_index_available_handles() == cold_capacity, "uninitialized readers allocate nothing")
    -- Runtime handles are tagged: array_new does not return literal zero.
    -- Simulate stale storage references with an actual live foreign handle.
    -- Readiness must reject them before any authoritative handle is followed.
    pilot original_files = v4_mir_files
    pilot original_defs = v4_mir_body_defs
    pilot original_names = v4_mir_body_names
    pilot original_blocks = v4_mir_body_blocks
    pilot original_kinds = v4_mir_body_stmt_kinds
    pilot original_stmt_blocks = v4_mir_body_stmt_blocks
    v4_mir_files = foreign
    v4_mir_body_defs = foreign
    v4_mir_body_names = foreign
    v4_mir_body_blocks = foreign
    v4_mir_body_stmt_kinds = foreign
    v4_mir_body_stmt_blocks = foreign
    mir_index_assert(not v4_mir_lookup_owner_exists(0) and not v4_mir_lookup_body_exists(0, 0), "preinit logical owner rejected")
    mir_index_assert(v4_mir_lookup_body(0, foreign_value) < 0 and v4_mir_lookup_body(0 - 1, foreign_value) < 0 and v4_mir_lookup_body_name(0, foreign_value) < 0 and v4_codegen_llvm_find_mir_body(0, foreign_value) < 0, "preinit identity storage rejected")
    mir_index_assert(v4_mir_block_first_stmt(0, 0, foreign) < 0 and v4_mir_block_next_stmt(0, 0, foreign, 0 - 1) < 0 and v4_mir_block_next_stmt_linear(0, 0, foreign, 0 - 1) < 0, "preinit statement storage rejected")
    mir_index_assert(v4_mir_body_stmt_count_for_block(0, 0, foreign) == 0 and v4_mir_body_stmt_kind_count_for_block(0, 0, foreign, foreign_value) == 0, "preinit count readers rejected")
    mir_index_assert(not v4_mir_block_has_return_stmt(0, 0, foreign) and not v4_mir_block_has_terminal_stmt(0, 0, foreign) and not v4_mir_body_block_has_stmt_after_return(0, 0, foreign), "preinit summary readers rejected")
    mir_index_assert(not v4_mir_body_lookup_index_is_ready(0) and not v4_mir_block_stmt_index_is_ready(0, 0) and v4_mir_body_lookup_index_handle(0) < 0 and v4_mir_block_stmt_index_handle(0, 0) < 0 and v4_mir_stmt_next_index_handle(0, 0) < 0, "preinit derived readers rejected")
    mir_index_assert(not v4_mir_lookup_outer_ensure() and not v4_mir_lookup_file_ensure(0) and not v4_mir_finalize_body_lookup_index(0) and not v4_mir_finalize_block_stmt_index(0, 0) and not v4_mir_finalize_lookup_indexes(0) and not v4_mir_finalize_lookup_indexes(0 - 1), "preinit publication rejected")
    v4_mir_invalidate_body_lookup_index(0)
    v4_mir_invalidate_block_stmt_index(0, 0)
    v4_mir_release_lookup_indexes(0)
    v4_mir_release_lookup_indexes(0 - 1)
    pilot retained_foreign: word = array_get(foreign, 0)
    mir_index_assert(v4_mir_ready == 0 and v4_mir_body_lookup_indexes < 0 and v4_mir_block_stmt_indexes < 0 and v4_mir_stmt_next_indexes < 0 and array_len(foreign) == 1 and retained_foreign == foreign_value and mir_index_available_handles() == cold_capacity, "preinit no state allocation or foreign mutation")
    v4_mir_files = original_files
    v4_mir_body_defs = original_defs
    v4_mir_body_names = original_names
    v4_mir_body_blocks = original_blocks
    v4_mir_body_stmt_kinds = original_kinds
    v4_mir_body_stmt_blocks = original_stmt_blocks
    array_release(foreign)
    -- One real pipeline and one complete restore, before the larger manual
    -- construction. Repeated authoritative restoration has a separate policy.
    pilot stream = v4_lex_text(0, "task main() -> int {" + "\n give back 6\n" + "}\n")
    pilot tree = v4_parse_stream(0, stream)
    pilot hir = v4_hir_lower_tree(0, tree)
    pilot resolve = v4_resolve_lower_hir(0, hir)
    pilot ty = v4_ty_lower_resolve(0, resolve)
    pilot lowered = v4_mir_lower_ty(0, ty)
    mir_index_assert(v4_mir_diag_count(lowered) == 0 and v4_mir_body_lookup_index_is_ready(lowered) and v4_mir_block_stmt_index_is_ready(lowered, 0), "lowering publication")
    pilot target = v4_target_spec_new("x86_64-unknown-linux-gnu")
    pilot plan = v4_codegen_llvm_lower_mir(0, lowered)
    pilot module = v4_codegen_llvm_module_text(plan, target)
    pilot payload = v4_mir_snapshot()
    pilot stable = v4_mir_body_lookup_index_handle(lowered)
    pilot rejected = v4_mir_snapshot_restore_component(payload + "\nmir-body")
    mir_index_assert(rejected.starts_with("mir-snapshot-restore ok=0") and v4_mir_snapshot() == payload and v4_mir_body_lookup_index_handle(lowered) == stable, "rejected restore atomic")
    mir_index_assert(v4_mir_snapshot_restore_component(payload).starts_with("mir-snapshot-restore ok=1"), "valid restore")
    mir_index_assert(v4_mir_snapshot() == payload and v4_mir_body_lookup_index_is_ready(lowered) and v4_mir_block_stmt_index_is_ready(lowered, 0), "restore publication and exact wire")
    mir_index_assert(array_len(stable) == 0 and v4_codegen_llvm_module_text(plan, target) == module, "released index and sealed module")
    say "mir-index lowering=true restore=true rejected-atomic=true wire-exact=true retained-plan=true"

    pilot mir = v4_mir_file_new(0, ty)
    cold_capacity = mir_index_available_handles()
    mir_index_assert(not v4_mir_lookup_owner_exists(0 - 1) and not v4_mir_lookup_owner_exists(array_len(v4_mir_files)) and not v4_mir_lookup_body_exists(mir, 0 - 1) and not v4_mir_lookup_body_exists(mir, v4_mir_body_count(mir)), "initialized logical bounds")
    mir_index_assert(v4_mir_lookup_body(0 - 1, "") < 0 and v4_mir_lookup_body_name(0 - 1, "") < 0 and v4_mir_lookup_body_name(array_len(v4_mir_files), "") < 0 and v4_mir_block_first_stmt(0 - 1, 0, 0 - 1) < 0 and v4_mir_block_next_stmt(mir, 0 - 1, 0 - 1, 0 - 1) < 0 and v4_mir_body_stmt_count_for_block(0 - 1, 0, 0 - 1) == 0 and v4_mir_body_stmt_kind_count_for_block(mir, 0 - 1, 0 - 1, v4_mir_stmt_return) == 0, "initialized invalid readers")
    mir_index_assert(not v4_mir_lookup_file_ensure(0 - 1) and not v4_mir_finalize_lookup_indexes(array_len(v4_mir_files)), "initialized invalid publication")
    v4_mir_release_lookup_indexes(0 - 1)
    v4_mir_release_lookup_indexes(array_len(v4_mir_files))
    mir_index_assert(mir_index_available_handles() == cold_capacity, "initialized invalid operations consume no handles")
    pilot def_id = v4_ty_signature_def(ty, 0)
    pilot built = v4_mir_body_lookup_build_records
    pilot linear = v4_mir_body_lookup_linear_steps
    pilot body = v4_mir_add_body(mir, def_id, "main", "task main() -> int")
    v4_mir_add_body(mir, def_id, "duplicate", "")
    v4_mir_add_body(mir, "", "", "")
    pilot first = "collision0"
    pilot second = ""
    pilot candidate_id = 1
    repeat until second != "" or candidate_id >= 256 {
        pilot candidate = "collision" + word_from_int(candidate_id)
        if candidate.checksum() % 32 == first.checksum() % 32 { second = candidate }
        candidate_id += 1
    }
    v4_mir_add_body(mir, first, first, "")
    v4_mir_add_body(mir, second, second, "")
    pilot row = 5
    repeat until row >= 12 {
        pilot key = "body" + word_from_int(row)
        mir_index_assert(v4_mir_lookup_body(mir, key) < 0, "lookup before append")
        pilot name = key
        if row == 11 { name = "main" }
        v4_mir_add_body(mir, key, name, "")
        mir_index_assert(v4_mir_lookup_body(mir, key) == row, "append lookup")
        row += 1
    }
    mir_index_assert(second != "" and v4_mir_lookup_body(mir, def_id) == 0 and v4_mir_lookup_body(mir, "") == 2 and v4_mir_lookup_body(mir, first) == 3 and v4_mir_lookup_body(mir, second) == 4, "duplicate empty and collision keys")
    mir_index_assert(v4_mir_lookup_body_name(mir, "main") == 0 and v4_mir_lookup_body_name(mir, "duplicate") == 1 and v4_mir_lookup_body_name(mir, "") == 2 and v4_mir_lookup_body_name(mir, first) == 3 and v4_mir_lookup_body_name(mir, second) == 4 and v4_mir_lookup_body(mir, "body11") == 11, "independent duplicate empty and colliding name keys")
    mir_index_assert(v4_mir_body_lookup_linear_steps == linear and v4_mir_body_lookup_build_records - built <= 24, "geometric construction")
    pilot probes = v4_mir_body_lookup_probes
    row = 5
    repeat until row >= 12 {
        mir_index_assert(v4_mir_lookup_body(mir, "body" + word_from_int(row)) == row and v4_mir_lookup_body(mir, "absent" + word_from_int(row)) < 0, "exact keyed lookup")
        row += 1
    }
    mir_index_assert(v4_mir_body_lookup_probes - probes <= 128 and v4_mir_body_lookup_linear_steps == linear, "bounded lookup work")
    say "mir-index definitions=true duplicates=true empty=true collisions=true append-work=true"

    pilot other = v4_mir_add_block(mir, body, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot empty = v4_mir_add_block(mir, body, v4_mir_term_return, 0 - 1, 0 - 1, "")
    -- Imported legacy numeric Bool values normalize to canonical LLVM operands;
    -- the physical-order assertion must still select the first true condition.
    pilot yes_value = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_const_bool, "1", "", 0 - 1, 0 - 1, V4_NO_SPAN, v4_ty_bool)
    pilot no_value = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_const_bool, "0", "", 0 - 1, 0 - 1, V4_NO_SPAN, v4_ty_bool)
    pilot one = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_const_int, "1", "", 0 - 1, 0 - 1, V4_NO_SPAN, v4_ty_int)
    pilot live = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_binary, "", v4_mir_bin_add, one, one, V4_NO_SPAN, v4_ty_int)
    pilot dead = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_binary, "", v4_mir_bin_add, one, one, V4_NO_SPAN, v4_ty_int)
    v4_mir_add_stmt(mir, body, other, v4_mir_stmt_expr, "", "", V4_NO_SPAN, 0 - 1, live)
    v4_mir_add_stmt(mir, body, 0, v4_mir_stmt_branch, "", "", V4_NO_SPAN, 0 - 1, yes_value)
    v4_mir_add_stmt(mir, body, other, v4_mir_stmt_return, "", "", V4_NO_SPAN, 0 - 1, one)
    v4_mir_add_stmt(mir, body, 0, v4_mir_stmt_loop, "", "", V4_NO_SPAN, 0 - 1, no_value)
    v4_mir_add_stmt(mir, body, other, v4_mir_stmt_expr, "", "", V4_NO_SPAN, 0 - 1, dead)
    v4_mir_set_body_block(mir, body, 0, v4_mir_block_new_full(0, v4_mir_term_if, other, empty, ""))
    mir_index_assert(v4_mir_block_first_stmt(mir, body, 0) == 1 and v4_mir_block_next_stmt(mir, body, 0, 1) == 3 and v4_mir_block_next_stmt(mir, body, 0, 3) < 0, "entry physical order")
    mir_index_assert(v4_mir_block_first_stmt(mir, body, other) == 0 and v4_mir_block_next_stmt(mir, body, other, 0) == 2 and v4_mir_block_next_stmt(mir, body, other, 2) == 4 and v4_mir_block_first_stmt(mir, body, empty) < 0, "interleaved physical order")
    pilot text = v4_codegen_llvm_body_line_from_mir(mir, body)
    mir_index_assert(v4_codegen_llvm_block_terminator_line(mir, body, 0) == "  br i1 true, label %bb1, label %bb2\n", "first condition selected")
    mir_index_assert(text.contains("ret i64 1") and not text.contains("%rv.0." + word_from_int(dead)), "first return suppression")
    pilot wire = v4_mir_snapshot()
    v4_mir_invalidate_body_lookup_index(mir)
    v4_mir_invalidate_block_stmt_index(mir, body)
    pilot capacity = mir_index_available_handles()
    built = v4_mir_block_stmt_build_records
    mir_index_assert(v4_mir_lookup_body(mir, def_id) == 0 and v4_mir_lookup_body_name(mir, "main") == 0 and v4_mir_lookup_body_name(mir, "duplicate") == 1 and v4_mir_lookup_body_name(mir, "") == 2 and v4_codegen_llvm_find_mir_body(mir, second) == 4 and v4_mir_block_first_stmt(mir, body, 0) == 1 and v4_codegen_llvm_body_line_from_mir(mir, body) == text, "cold exact queries")
    mir_index_assert(mir_index_available_handles() == capacity and v4_mir_block_stmt_build_records == built and not v4_mir_block_stmt_index_is_ready(mir, body), "cold no publication or handle consumption")
    mir_index_assert(v4_mir_finalize_lookup_indexes(mir) and v4_mir_snapshot() == wire, "derived state absent from wire")

    -- Slot edits may keep cardinality unchanged, move between blocks, and add
    -- sparse placeholders. Cold invalid-block queries retain the old scans.
    v4_mir_restore_stmt_slot(mir, body, 0, v4_mir_stmt_expr, "", "", V4_NO_SPAN, 0, 0 - 1, live)
    v4_mir_restore_stmt_slot(mir, body, 7, "Odd", "", "", V4_NO_SPAN, 0 - 1, 0 - 1, 0 - 1)
    mir_index_assert(not v4_mir_block_stmt_index_is_ready(mir, body) and v4_mir_block_first_stmt(mir, body, 0) == 0 and v4_mir_block_next_stmt(mir, body, 0, 0) == 1, "direct movement invalidates")
    mir_index_assert(v4_mir_block_first_stmt(mir, body, 0 - 1) == 5 and v4_mir_block_next_stmt(mir, body, 0 - 1, 5) == 6 and v4_mir_block_next_stmt(mir, body, 0 - 1, 6) == 7 and v4_mir_body_stmt_count_for_block(mir, body, 0 - 1) == 3 and v4_mir_body_stmt_kind_count_for_block(mir, body, 0 - 1, "Odd") == 1, "negative block and sparse semantics")
    mir_index_assert(not v4_mir_finalize_block_stmt_index(mir, body), "malformed membership stays cold")
    row = 5
    repeat until row >= 8 {
        v4_mir_restore_stmt_slot(mir, body, row, "Odd", "", "", V4_NO_SPAN, empty, 0 - 1, 0 - 1)
        row += 1
    }
    pilot cold = v4_codegen_llvm_body_line_from_mir(mir, body)
    mir_index_assert(v4_mir_finalize_block_stmt_index(mir, body) and v4_codegen_llvm_body_line_from_mir(mir, body) == cold and v4_mir_body_stmt_kind_count_for_block(mir, body, empty, "Odd") == 3, "final physical rebuild and unknown kind")
    -- A name-only raw edit finishes with the shared owner invalidation hook.
    pilot identity_stable = v4_mir_body_lookup_index_handle(mir)
    array_set(v4_mir_names_handle(mir), 1, "rename-only")
    v4_mir_invalidate_body_lookup_index(mir)
    mir_index_assert(not v4_mir_body_lookup_index_is_ready(mir) and v4_mir_lookup_body(mir, def_id) == 0 and v4_mir_lookup_body_name(mir, "rename-only") == 1 and v4_mir_lookup_body_name(mir, "duplicate") < 0, "same-size independent name overwrite cold")
    mir_index_assert(v4_mir_finalize_body_lookup_index(mir) and v4_mir_body_lookup_index_handle(mir) == identity_stable and v4_mir_lookup_body_name(mir, "rename-only") == 1, "same-size name publication and reuse")
    array_set(v4_mir_names_handle(mir), 1, "duplicate")
    v4_mir_invalidate_body_lookup_index(mir)
    mir_index_assert(v4_mir_finalize_body_lookup_index(mir), "restore direct name edit")
    stable = v4_mir_block_stmt_index_handle(mir, 1)
    v4_mir_restore_body_slot(mir, 1, "changed", "changed", "")
    mir_index_assert(not v4_mir_body_lookup_index_is_ready(mir) and v4_mir_lookup_body(mir, "changed") == 1 and v4_mir_lookup_body(mir, def_id) == 0 and v4_mir_lookup_body_name(mir, "changed") == 1 and v4_mir_lookup_body_name(mir, "duplicate") < 0 and v4_mir_lookup_body_name(mir, "main") == 0 and v4_mir_block_stmt_index_handle(mir, 1) == stable, "identity overwrite and derived reuse")
    v4_mir_add_block(mir, 1, v4_mir_term_return, 0 - 1, 0 - 1, "")
    mir_index_assert(v4_mir_finalize_lookup_indexes(mir), "finalize edited owner")
    say "mir-index interleaved=true first-condition=true first-return=true cold-exact=true sparse=true direct-edits=true"

    -- A large statement group exercises the actual append-maintained index,
    -- including the per-statement terminal query used during MIR lowering.
    linear = v4_mir_block_stmt_linear_steps
    built = v4_mir_block_stmt_build_records
    row = 0
    repeat until row >= 1024 {
        v4_mir_add_stmt(mir, 1, 0, v4_mir_stmt_expr, "", "", V4_NO_SPAN, 0 - 1, 0 - 1)
        mir_index_assert(not v4_mir_block_has_terminal_stmt(mir, 1, 0), "live terminal count")
        row += 1
    }
    pilot steps = v4_mir_block_stmt_lookup_steps
    pilot stmt = v4_mir_block_first_stmt(mir, 1, 0)
    row = 0
    repeat until stmt < 0 {
        mir_index_assert(stmt == row, "every physical statement")
        stmt = v4_mir_block_next_stmt(mir, 1, 0, stmt)
        row += 1
    }
    mir_index_assert(row == 1024 and v4_mir_block_stmt_lookup_steps - steps == 1025 and v4_mir_block_stmt_build_records == built and v4_mir_block_stmt_linear_steps == linear, "linear iteration and append work")
    capacity = mir_index_available_handles()
    stable = v4_mir_block_stmt_index_handle(mir, 1)
    row = 0
    repeat until row >= 32 {
        v4_mir_invalidate_block_stmt_index(mir, 1)
        mir_index_assert(v4_mir_finalize_block_stmt_index(mir, 1), "repeated finalize")
        row += 1
    }
    mir_index_assert(v4_mir_block_stmt_build_records - built == 32768 and v4_mir_block_stmt_index_handle(mir, 1) == stable and mir_index_available_handles() == capacity, "bounded rebuild and handles")
    say "mir-index statements=1024 linear-iteration=true append-work=true rebuild-work=true handles-stable=true"

    -- Optional index storage fails cold under the harness's 1,024-handle cap.
    v4_mir_release_lookup_indexes(mir)
    pilot holders = array_new()
    pilot held = 0
    pilot exhausted = false
    repeat until exhausted or held >= 2048 {
        pilot handle = array_new()
        if handle < 0 { exhausted = true } else {
            array_push(holders, word_from_int(handle))
            held += 1
        }
    }
    mir_index_assert(exhausted and not v4_mir_finalize_lookup_indexes(mir) and v4_mir_lookup_body(mir, "changed") == 1 and v4_mir_lookup_body_name(mir, "changed") == 1 and v4_codegen_llvm_find_mir_body(mir, "main") == 0 and v4_mir_block_first_stmt(mir, 1, 0) == 0 and v4_mir_block_next_stmt(mir, 1, 0, 0) == 1 and not v4_mir_block_stmt_index_is_ready(mir, 1), "exhaustion cold fallback")
    row = 0
    repeat until row >= held {
        array_release(word_to_int(array_get(holders, row)))
        row += 1
    }
    array_release(holders)
    mir_index_assert(v4_mir_finalize_lookup_indexes(mir) and v4_mir_lookup_body(mir, "changed") == 1 and v4_mir_lookup_body_name(mir, "changed") == 1 and v4_mir_body_stmt_count_for_block(mir, 1, 0) == 1024 and mir_index_available_handles() == capacity, "resource recovery without derived leak")
    say "mir-index exhaustion-cold=true resource-recovery=true derived-handles-bounded=true"

    -- A real literal-say argument reproduces the codegen promotion miss path.
    pilot word_arg = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_const_word, "literal", "", 0 - 1, 0 - 1, V4_NO_SPAN, v4_ty_word)
    pilot say_call = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_call, "", v4_mir_call_say_literal, 0 - 1, 0 - 1, V4_NO_SPAN, v4_ty_void)
    v4_mir_set_rvalue_args_payload(mir, body, say_call, word_from_int(word_arg))
    mir_index_name_scale(mir, body, say_call, 200)
    mir_index_name_scale(mir, body, say_call, 800)
    say "mir-index names=true independent-keys=true cold-exact=true codegen-misses=200,800 bounded-name-reads=true handles-stable=true"
}

mir_index_run()
