-- V4 MIR return-coverage smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_return_coverage_good_source() -> word {
    pilot src = "task full(flag: bool) -> int {\n"
    src = src + "    if flag {\n"
    src = src + "        give back 1\n"
    src = src + "    } else {\n"
    src = src + "        give back 0\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task quiet(flag: bool) -> void {\n"
    src = src + "    if flag {\n"
    src = src + "        pilot x = 1\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_return_coverage_missing_source() -> word {
    pilot src = "task missing() -> int {\n"
    src = src + "    pilot x = 1\n"
    src = src + "}\n"
    give back src
}

task v4_mir_return_coverage_partial_source() -> word {
    pilot src = "task partial(flag: bool) -> int {\n"
    src = src + "    if flag {\n"
    src = src + "        give back 1\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_return_coverage_loop_source() -> word {
    pilot src = "task loop_only(power: int) -> int {\n"
    src = src + "    repeat until power > 0 {\n"
    src = src + "        give back 1\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_return_coverage_good_stream = v4_lex_text(0, v4_mir_return_coverage_good_source())
pilot v4_mir_return_coverage_good_tree = v4_parse_stream(0, v4_mir_return_coverage_good_stream)
pilot v4_mir_return_coverage_good_hir = v4_hir_lower_tree(0, v4_mir_return_coverage_good_tree)
pilot v4_mir_return_coverage_good_resolve = v4_resolve_lower_hir(0, v4_mir_return_coverage_good_hir)
pilot v4_mir_return_coverage_good_ty = v4_ty_lower_resolve(0, v4_mir_return_coverage_good_resolve)
pilot v4_mir_return_coverage_good_mir = v4_mir_lower_ty(0, v4_mir_return_coverage_good_ty)
say "return-coverage-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_return_coverage_good_mir))

pilot v4_mir_return_coverage_missing_stream = v4_lex_text(1, v4_mir_return_coverage_missing_source())
pilot v4_mir_return_coverage_missing_tree = v4_parse_stream(1, v4_mir_return_coverage_missing_stream)
pilot v4_mir_return_coverage_missing_hir = v4_hir_lower_tree(1, v4_mir_return_coverage_missing_tree)
pilot v4_mir_return_coverage_missing_resolve = v4_resolve_lower_hir(1, v4_mir_return_coverage_missing_hir)
pilot v4_mir_return_coverage_missing_ty = v4_ty_lower_resolve(1, v4_mir_return_coverage_missing_resolve)
pilot v4_mir_return_coverage_missing_mir = v4_mir_lower_ty(1, v4_mir_return_coverage_missing_ty)
say "return-coverage-missing-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_return_coverage_missing_mir))
say "return-coverage-missing-message=" + v4_diag_message(v4_mir_diag(v4_mir_return_coverage_missing_mir, 0))
say "return-coverage-missing-help=" + v4_diag_help(v4_mir_diag(v4_mir_return_coverage_missing_mir, 0))

pilot v4_mir_return_coverage_partial_stream = v4_lex_text(2, v4_mir_return_coverage_partial_source())
pilot v4_mir_return_coverage_partial_tree = v4_parse_stream(2, v4_mir_return_coverage_partial_stream)
pilot v4_mir_return_coverage_partial_hir = v4_hir_lower_tree(2, v4_mir_return_coverage_partial_tree)
pilot v4_mir_return_coverage_partial_resolve = v4_resolve_lower_hir(2, v4_mir_return_coverage_partial_hir)
pilot v4_mir_return_coverage_partial_ty = v4_ty_lower_resolve(2, v4_mir_return_coverage_partial_resolve)
pilot v4_mir_return_coverage_partial_mir = v4_mir_lower_ty(2, v4_mir_return_coverage_partial_ty)
say "return-coverage-partial-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_return_coverage_partial_mir))
say "return-coverage-partial-message=" + v4_diag_message(v4_mir_diag(v4_mir_return_coverage_partial_mir, 0))
say "return-coverage-partial-help=" + v4_diag_help(v4_mir_diag(v4_mir_return_coverage_partial_mir, 0))

pilot v4_mir_return_coverage_loop_stream = v4_lex_text(3, v4_mir_return_coverage_loop_source())
pilot v4_mir_return_coverage_loop_tree = v4_parse_stream(3, v4_mir_return_coverage_loop_stream)
pilot v4_mir_return_coverage_loop_hir = v4_hir_lower_tree(3, v4_mir_return_coverage_loop_tree)
pilot v4_mir_return_coverage_loop_resolve = v4_resolve_lower_hir(3, v4_mir_return_coverage_loop_hir)
pilot v4_mir_return_coverage_loop_ty = v4_ty_lower_resolve(3, v4_mir_return_coverage_loop_resolve)
pilot v4_mir_return_coverage_loop_mir = v4_mir_lower_ty(3, v4_mir_return_coverage_loop_ty)
say "return-coverage-loop-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_return_coverage_loop_mir))
say "return-coverage-loop-message=" + v4_diag_message(v4_mir_diag(v4_mir_return_coverage_loop_mir, 0))
say "return-coverage-loop-help=" + v4_diag_help(v4_mir_diag(v4_mir_return_coverage_loop_mir, 0))
