-- V4 hover arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_hover_snapshot_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_hover_snapshot_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_hover_snapshot_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_hover_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_hover_snapshot_source_text() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_hover_snapshot_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot " + v4_hover_snapshot_braces(" rank: 7 ") + "\n"
    src = src + "    pilot event = Event::Key " + v4_hover_snapshot_braces(" code: 9 ") + "\n"
    src = src + "    give back ace.salute()\n"
    src = src + "}\n"
    give back src
}

pilot v4_hover_snapshot_source = v4_hover_snapshot_source_text()
pilot v4_hover_snapshot_stream = v4_lex_text(0, v4_hover_snapshot_source)
pilot v4_hover_snapshot_main_offset = v4_hover_snapshot_token_offset(v4_hover_snapshot_stream, "main", 0)
pilot v4_hover_snapshot_method_offset = v4_hover_snapshot_token_offset(v4_hover_snapshot_stream, "salute", 1)
pilot v4_hover_snapshot_variant_offset = v4_hover_snapshot_token_offset(v4_hover_snapshot_stream, "Event", 1)
pilot v4_hover_snapshot_variant_case_offset = v4_hover_snapshot_token_offset(v4_hover_snapshot_stream, "Key", 1)

pilot v4_hover_snapshot_main = v4_hover_text_cached("hover-snapshot.fk", v4_hover_snapshot_source, v4_hover_snapshot_main_offset)
pilot v4_hover_snapshot_method = v4_hover_text_cached("hover-snapshot.fk", v4_hover_snapshot_source, v4_hover_snapshot_method_offset)
pilot v4_hover_snapshot_variant = v4_hover_text_cached("hover-snapshot.fk", v4_hover_snapshot_source, v4_hover_snapshot_variant_offset)
pilot v4_hover_snapshot_variant_case = v4_hover_text_cached("hover-snapshot.fk", v4_hover_snapshot_source, v4_hover_snapshot_variant_case_offset)
say v4_hover_summary(v4_hover_snapshot_main)
say v4_hover_snapshot_summary()

pilot v4_hover_snapshot_payload = v4_hover_snapshot()
say v4_hover_snapshot_validate(v4_hover_snapshot_payload)
say "hover-snapshot-bytes=" + word_from_int(v4_hover_snapshot_payload.length())
say v4_hover_snapshot_hover_line(v4_hover_snapshot_method)
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
say v4_ty_snapshot_restore(v4_ty_snapshot())
say v4_semantic_snapshot_restore(v4_semantic_snapshot())
say v4_hover_snapshot_restore(v4_hover_snapshot_payload)
say v4_lsp_hover_snapshot_text()
say v4_lsp_hover_snapshot_restore_text(v4_hover_snapshot_payload)
say v4_lsp_handle_text_request("workspace/hoverSnapshotRestore", "hover-snapshot.fk", v4_hover_snapshot_payload, 0)

pilot v4_hover_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_hover_query_payload)
say v4_driver_confirm_restored_document_text("hover-snapshot.fk", v4_hover_snapshot_source)
pilot v4_hover_file = v4_source_find("hover-snapshot.fk")
pilot v4_hover_fingerprint = v4_source_fingerprint(v4_hover_file)
pilot v4_hover_restored_id = word_to_int(v4_query_get(v4_hover_query_key("hover-snapshot.fk", v4_hover_snapshot_method_offset), v4_hover_fingerprint))
pilot v4_hover_variant_restored_id = word_to_int(v4_query_get(v4_hover_query_key("hover-snapshot.fk", v4_hover_snapshot_variant_offset), v4_hover_fingerprint))
pilot v4_hover_variant_case_restored_id = word_to_int(v4_query_get(v4_hover_query_key("hover-snapshot.fk", v4_hover_snapshot_variant_case_offset), v4_hover_fingerprint))
say v4_hover_summary(v4_hover_restored_id)
say "hover-snapshot-method-kind=" + v4_hover_kind(v4_hover_snapshot_method)
say "hover-snapshot-method-type=" + v4_hover_type(v4_hover_snapshot_method)
say "hover-snapshot-restored-kind=" + v4_hover_kind(v4_hover_restored_id)
say "hover-snapshot-restored-type=" + v4_hover_type(v4_hover_restored_id)
say "hover-snapshot-variant-kind=" + v4_hover_kind(v4_hover_snapshot_variant)
say "hover-snapshot-variant-type=" + v4_hover_type(v4_hover_snapshot_variant)
say "hover-snapshot-variant-restored-kind=" + v4_hover_kind(v4_hover_variant_restored_id)
say "hover-snapshot-variant-restored-type=" + v4_hover_type(v4_hover_variant_restored_id)
say "hover-snapshot-variant-case-kind=" + v4_hover_kind(v4_hover_snapshot_variant_case)
say "hover-snapshot-variant-case-type=" + v4_hover_type(v4_hover_snapshot_variant_case)
say "hover-snapshot-variant-case-restored-kind=" + v4_hover_kind(v4_hover_variant_case_restored_id)
say "hover-snapshot-variant-case-restored-type=" + v4_hover_type(v4_hover_variant_case_restored_id)
say v4_driver_confirm_restored_document_text("hover-snapshot.fk", "task changed() => 7\n")
