-- V4 contract-region edge query invalidation and recomputation fixture.
-- Verification prepends the V4 crates before this file.
-- One live document owns the only cached compiler pipeline in this executable.

task v4_contract_region_query_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    repeat until token_id >= v4_lex_token_count(stream_id) {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_contract_region_query_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_contract_region_query_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0 - 1
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_contract_region_query_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_contract_region_query_span_positions_equal(left: word, right: word) -> bool {
    if v4_span_start(left) != v4_span_start(right) {
        give back false
    }
    give back v4_span_end(left) == v4_span_end(right)
}

task v4_contract_region_query_positive(report: word, key: word) -> word {
    give back v4_contract_region_query_bool(word_to_int(v4_unit_snapshot_key_value(report, key)) > 0)
}

task v4_contract_region_query_family_misses(path: word, family: word) -> int {
    pilot misses = 0
    pilot telemetry_id = 0
    repeat until telemetry_id >= v4_query_telemetry_key_count() {
        pilot key = v4_query_telemetry_key(telemetry_id)
        if v4_unit_invalidation_family_matches_path_key(path, family, key) {
            misses += v4_query_telemetry_misses_for(telemetry_id)
        }
        telemetry_id += 1
    }
    give back misses
}

task v4_contract_region_query_family_recomputed(path: word, family: word, misses_before: int) -> word {
    give back v4_contract_region_query_bool(v4_contract_region_query_family_misses(path, family) > misses_before)
}

task v4_contract_region_query_all_invalidations_positive(report: word) -> word {
    if v4_contract_region_query_positive(report, "query-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "core-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "syntax-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "lex-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "parse-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "hir-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "resolve-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "ty-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "mir-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "borrowck-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "diagnostics-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "editor-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "semantic-at-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "hover-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "definition-at-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "document-symbols-invalidations-added") != "true" { give back "false" }
    if v4_contract_region_query_positive(report, "completion-invalidations-added") != "true" { give back "false" }
    give back "true"
}

task v4_contract_region_query_source(bound_name: word) -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task shorten<'long: " + bound_name + ", 'out, 'alt>(lend 'long value: Ship, lend 'out fallback: Ship, lend 'alt spare: Ship) -> lend 'out Ship {\n"
    src = src + "    give back lend value\n"
    src = src + "}\n"
    give back src
}

pilot v4_contract_region_query_path = "contract-region-query-invalidation.fk"
pilot v4_contract_region_query_before = v4_contract_region_query_source("'out")
pilot v4_contract_region_query_before_stream = v4_lex_text(0, v4_contract_region_query_before)
pilot v4_contract_region_query_before_bound_offset = v4_contract_region_query_offset(v4_contract_region_query_before_stream, "'out", 0)
pilot v4_contract_region_query_before_binder_token = v4_contract_region_query_find_token(v4_contract_region_query_before_stream, "'out", 1)
pilot v4_contract_region_query_before_binder_span = v4_lex_token_span(v4_contract_region_query_before_stream, v4_contract_region_query_before_binder_token)

v4_lsp_open_document(v4_contract_region_query_path, v4_contract_region_query_before)
pilot v4_contract_region_query_before_syntax = v4_check_syntax_text(v4_contract_region_query_path, v4_contract_region_query_before)
pilot v4_contract_region_query_before_borrow = v4_borrowck_text_cached(v4_contract_region_query_path, v4_contract_region_query_before)
pilot v4_contract_region_query_before_mir = v4_borrowck_mir_id(v4_contract_region_query_before_borrow)
pilot v4_contract_region_query_before_ty = v4_mir_ty_id(v4_contract_region_query_before_mir)
pilot v4_contract_region_query_before_resolve = v4_ty_resolve_id(v4_contract_region_query_before_ty)
pilot v4_contract_region_query_before_def = v4_resolve_def_for_name(v4_contract_region_query_before_resolve, "shorten")
pilot v4_contract_region_query_before_sig = v4_ty_lookup_signature(v4_contract_region_query_before_ty, v4_contract_region_query_before_def)
pilot v4_contract_region_query_before_result = v4_borrowck_lookup_result(v4_contract_region_query_before_borrow, v4_contract_region_query_before_def)
pilot v4_contract_region_query_before_diagnostics = v4_diagnostics_text_cached(v4_contract_region_query_path, v4_contract_region_query_before)
pilot v4_contract_region_query_before_semantic = v4_semantic_at_text_cached(v4_contract_region_query_path, v4_contract_region_query_before, v4_contract_region_query_before_bound_offset)
pilot v4_contract_region_query_before_hover = v4_hover_text_cached(v4_contract_region_query_path, v4_contract_region_query_before, v4_contract_region_query_before_bound_offset)
pilot v4_contract_region_query_before_definition = v4_definition_at_text_cached(v4_contract_region_query_path, v4_contract_region_query_before, v4_contract_region_query_before_bound_offset)
pilot v4_contract_region_query_before_document_symbols = v4_document_symbols_text_cached(v4_contract_region_query_path, v4_contract_region_query_before)
pilot v4_contract_region_query_before_completion = v4_completion_text_cached(v4_contract_region_query_path, v4_contract_region_query_before, v4_contract_region_query_before_bound_offset)

pilot v4_contract_region_query_query_misses_before = v4_contract_region_query_family_misses(v4_contract_region_query_path, "all")
pilot v4_contract_region_query_core_misses_before = v4_contract_region_query_family_misses(v4_contract_region_query_path, "core")
pilot v4_contract_region_query_syntax_misses_before = v4_contract_region_query_family_misses(v4_contract_region_query_path, "syntax")
pilot v4_contract_region_query_lex_misses_before = v4_contract_region_query_family_misses(v4_contract_region_query_path, "lex")
