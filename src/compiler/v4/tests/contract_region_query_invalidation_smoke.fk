pilot v4_contract_region_query_after_binder_token = v4_contract_region_query_find_token(v4_contract_region_query_after_stream, "'alt", 1)
pilot v4_contract_region_query_after_binder_span = v4_lex_token_span(v4_contract_region_query_after_stream, v4_contract_region_query_after_binder_token)
say "contract-region-query-bound-offset-stable=" + v4_contract_region_query_bool(v4_contract_region_query_after_bound_offset == v4_contract_region_query_before_bound_offset)

pilot v4_contract_region_query_change_response = ""
pilot v4_contract_region_query_report = ""
v4_contract_region_query_change_response = v4_lsp_handle_text_request("textDocument/didChange", v4_contract_region_query_path, v4_contract_region_query_after, 0)
say v4_contract_region_query_change_response
v4_contract_region_query_report = v4_unit_snapshot_line(v4_contract_region_query_change_response, 2)
say "contract-region-query-query-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "query-invalidations-added")
say "contract-region-query-core-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "core-invalidations-added")
say "contract-region-query-syntax-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "syntax-invalidations-added")
say "contract-region-query-lex-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "lex-invalidations-added")
say "contract-region-query-parse-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "parse-invalidations-added")
say "contract-region-query-hir-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "hir-invalidations-added")
say "contract-region-query-resolve-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "resolve-invalidations-added")
say "contract-region-query-ty-invalidated=" + v4_contract_region_query_positive(v4_contract_region_query_report, "ty-invalidations-added")
