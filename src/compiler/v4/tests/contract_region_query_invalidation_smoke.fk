say "contract-region-query-query-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "all", v4_contract_region_query_query_misses_before)
say "contract-region-query-core-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "core", v4_contract_region_query_core_misses_before)
