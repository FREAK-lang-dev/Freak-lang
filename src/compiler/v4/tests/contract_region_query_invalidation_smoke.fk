say "contract-region-query-all-17-invalidations-positive=" + v4_contract_region_query_all_invalidations_positive(v4_contract_region_query_report)

pilot v4_contract_region_query_after_syntax = ""
pilot v4_contract_region_query_after_borrow = 0 - 1
pilot v4_contract_region_query_after_mir = 0 - 1
pilot v4_contract_region_query_after_ty = 0 - 1
pilot v4_contract_region_query_after_resolve = 0 - 1
pilot v4_contract_region_query_after_def = ""
