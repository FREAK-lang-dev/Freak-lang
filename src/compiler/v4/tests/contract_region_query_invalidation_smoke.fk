say "contract-region-query-diagnostics-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "diagnostics", v4_contract_region_query_diagnostics_misses_before)
say "contract-region-query-editor-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "editor", v4_contract_region_query_editor_misses_before)
say "contract-region-query-semantic-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "semantic-at", v4_contract_region_query_semantic_misses_before)
say "contract-region-query-hover-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "hover", v4_contract_region_query_hover_misses_before)
say "contract-region-query-definition-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "definition-at", v4_contract_region_query_definition_misses_before)
say "contract-region-query-document-symbols-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "document-symbols", v4_contract_region_query_document_symbols_misses_before)
say "contract-region-query-completion-recomputed=" + v4_contract_region_query_family_recomputed(v4_contract_region_query_path, "completion", v4_contract_region_query_completion_misses_before)
say "contract-region-query-all-17-recomputations-positive=" + v4_contract_region_query_bool(v4_contract_region_query_all_recomputations_positive)
v4_contract_region_query_after_diagnostic_count = v4_diagnostics_count(v4_contract_region_query_after_diagnostics)
say "contract-region-query-after-diagnostics=" + word_from_int(v4_contract_region_query_after_diagnostic_count)
if v4_contract_region_query_after_diagnostic_count > 0 {
    say "contract-region-query-after-message=" + v4_diag_message(v4_diagnostics_diag(v4_contract_region_query_after_diagnostics, 0))
} else {
    say "contract-region-query-after-message=none"
}
say "contract-region-query-after-status=" + v4_borrowck_result_status(v4_contract_region_query_after_borrow, v4_contract_region_query_after_result)
say "contract-region-query-after-source-count=" + word_from_int(v4_ty_signature_borrowed_return_source_param_count(v4_contract_region_query_after_ty, v4_contract_region_query_after_sig))
say "contract-region-query-after-long-outlives-out=" + v4_contract_region_query_bool(v4_ty_signature_lifetime_outlives(v4_contract_region_query_after_ty, v4_contract_region_query_after_sig, "'long", "'out"))
say "contract-region-query-after-long-outlives-alt=" + v4_contract_region_query_bool(v4_ty_signature_lifetime_outlives(v4_contract_region_query_after_ty, v4_contract_region_query_after_sig, "'long", "'alt"))
say "contract-region-query-after-bound-semantic=" + v4_semantic_at_type(v4_contract_region_query_after_semantic)
say "contract-region-query-after-bound-hover=" + v4_hover_type(v4_contract_region_query_after_hover)
say "contract-region-query-after-bound-definition=" + word_from_int(v4_definition_at_found(v4_contract_region_query_after_definition))
say "contract-region-query-after-bound-definition-matches-alt-binder=" + v4_contract_region_query_bool(v4_contract_region_query_span_positions_equal(v4_definition_at_span(v4_contract_region_query_after_definition), v4_contract_region_query_after_binder_span))
say "contract-region-query-bound-definition-changed=" + v4_contract_region_query_bool(v4_span_start(v4_definition_at_span(v4_contract_region_query_after_definition)) != v4_span_start(v4_definition_at_span(v4_contract_region_query_before_definition)))
say v4_lsp_diagnostics_text(v4_contract_region_query_path, v4_contract_region_query_after)
