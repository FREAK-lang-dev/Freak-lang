v4_contract_region_query_after_sig = v4_ty_lookup_signature(v4_contract_region_query_after_ty, v4_contract_region_query_after_def)
v4_contract_region_query_after_result = v4_borrowck_lookup_result(v4_contract_region_query_after_borrow, v4_contract_region_query_after_def)
v4_contract_region_query_after_diagnostics = v4_diagnostics_text_cached(v4_contract_region_query_path, v4_contract_region_query_after)
v4_contract_region_query_after_semantic = v4_semantic_at_text_cached(v4_contract_region_query_path, v4_contract_region_query_after, v4_contract_region_query_after_bound_offset)
v4_contract_region_query_after_hover = v4_hover_text_cached(v4_contract_region_query_path, v4_contract_region_query_after, v4_contract_region_query_after_bound_offset)
v4_contract_region_query_after_definition = v4_definition_at_text_cached(v4_contract_region_query_path, v4_contract_region_query_after, v4_contract_region_query_after_bound_offset)
v4_contract_region_query_after_document_symbols = v4_document_symbols_text_cached(v4_contract_region_query_path, v4_contract_region_query_after)
v4_contract_region_query_after_completion = v4_completion_text_cached(v4_contract_region_query_path, v4_contract_region_query_after, v4_contract_region_query_after_bound_offset)

if v4_contract_region_query_family_misses(v4_contract_region_query_path, "all") <= v4_contract_region_query_query_misses_before { v4_contract_region_query_all_recomputations_positive = false }
if v4_contract_region_query_family_misses(v4_contract_region_query_path, "core") <= v4_contract_region_query_core_misses_before { v4_contract_region_query_all_recomputations_positive = false }
