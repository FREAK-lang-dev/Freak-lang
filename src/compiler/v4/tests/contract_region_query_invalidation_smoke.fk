pilot v4_contract_region_query_after_result = 0 - 1
pilot v4_contract_region_query_after_diagnostics = 0 - 1
pilot v4_contract_region_query_after_semantic = 0 - 1
pilot v4_contract_region_query_after_hover = 0 - 1
pilot v4_contract_region_query_after_definition = 0 - 1
