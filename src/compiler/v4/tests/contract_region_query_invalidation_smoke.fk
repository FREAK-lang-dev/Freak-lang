pilot v4_contract_region_query_after_diagnostic_count = 0
pilot v4_contract_region_query_all_recomputations_positive = true

v4_contract_region_query_after_syntax = v4_check_syntax_text(v4_contract_region_query_path, v4_contract_region_query_after)
v4_contract_region_query_after_borrow = v4_borrowck_text_cached(v4_contract_region_query_path, v4_contract_region_query_after)
