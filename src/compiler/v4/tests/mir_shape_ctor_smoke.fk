-- V4 MIR shape constructor smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_shape_ctor_good_source() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "    callsign: word\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ship = Pilot " + "{" + " callsign: \"Valkyrie-1\", hp: 7 " + "}\n"
    src = src + "    pilot power = ship.hp\n"
    src = src + "    give back power\n"
    src = src + "}\n"
    give back src
}

