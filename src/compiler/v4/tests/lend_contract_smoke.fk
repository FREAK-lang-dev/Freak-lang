-- V4 lend / lend mut parameter contract smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_lend_contract_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    repeat until token_id >= v4_lex_token_count(stream_id) {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back v4_span_start(v4_lex_token_span(stream_id, token_id))
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0
}

task v4_lend_contract_source() -> word {
    pilot src = "task mutate_immutable(lend value: int) -> int {\n"
    src = src + "    value = 2\n"
    src = src + "    give back value\n"
    src = src + "}\n"
    src = src + "task mutate_mut(lend mut value: int) -> int {\n"
    src = src + "    value = 2\n"
    src = src + "    give back value\n"
    src = src + "}\n"
    src = src + "task move_lend(lend value: word) -> word {\n"
    src = src + "    give back value\n"
    src = src + "}\n"
    give back src
}

pilot v4_lend_contract_src = v4_lend_contract_source()
pilot v4_lend_contract_stream = v4_lex_text(0, v4_lend_contract_src)
pilot v4_lend_contract_tree = v4_parse_stream(0, v4_lend_contract_stream)
pilot v4_lend_contract_hir = v4_hir_lower_tree(0, v4_lend_contract_tree)
pilot v4_lend_contract_resolve = v4_resolve_lower_hir(0, v4_lend_contract_hir)
pilot v4_lend_contract_ty = v4_ty_lower_resolve(0, v4_lend_contract_resolve)
pilot v4_lend_contract_mir = v4_mir_lower_ty(0, v4_lend_contract_ty)
pilot v4_lend_contract_borrow = v4_borrowck_check_mir(0, v4_lend_contract_mir)

pilot v4_lend_contract_imm_def = v4_resolve_def_for_name(v4_lend_contract_resolve, "mutate_immutable")
pilot v4_lend_contract_mut_def = v4_resolve_def_for_name(v4_lend_contract_resolve, "mutate_mut")
pilot v4_lend_contract_move_def = v4_resolve_def_for_name(v4_lend_contract_resolve, "move_lend")
pilot v4_lend_contract_imm_sig = v4_ty_lookup_signature(v4_lend_contract_ty, v4_lend_contract_imm_def)
pilot v4_lend_contract_mut_sig = v4_ty_lookup_signature(v4_lend_contract_ty, v4_lend_contract_mut_def)
pilot v4_lend_contract_imm_body = v4_mir_lookup_body(v4_lend_contract_mir, v4_lend_contract_imm_def)
pilot v4_lend_contract_mut_body = v4_mir_lookup_body(v4_lend_contract_mir, v4_lend_contract_mut_def)
pilot v4_lend_contract_imm_local = v4_mir_find_local(v4_lend_contract_mir, v4_lend_contract_imm_body, "value")
pilot v4_lend_contract_mut_local = v4_mir_find_local(v4_lend_contract_mir, v4_lend_contract_mut_body, "value")
pilot v4_lend_contract_imm_result = v4_borrowck_lookup_result(v4_lend_contract_borrow, v4_lend_contract_imm_def)
pilot v4_lend_contract_mut_result = v4_borrowck_lookup_result(v4_lend_contract_borrow, v4_lend_contract_mut_def)
pilot v4_lend_contract_move_result = v4_borrowck_lookup_result(v4_lend_contract_borrow, v4_lend_contract_move_def)

pilot v4_lend_contract_value_offset = v4_lend_contract_token_offset(v4_lend_contract_stream, "value", 3)
pilot v4_lend_contract_sem = v4_semantic_at_text_cached("lend-contract.fk", v4_lend_contract_src, v4_lend_contract_value_offset)
pilot v4_lend_contract_hover = v4_hover_text_cached("lend-contract.fk", v4_lend_contract_src, v4_lend_contract_value_offset)

say "lend-param-name=" + v4_ty_signature_param_name(v4_lend_contract_ty, v4_lend_contract_imm_sig, 0)
say "lend-param-mode=" + v4_ty_signature_param_mode(v4_lend_contract_ty, v4_lend_contract_imm_sig, 0)
say "lend-param-type=" + v4_ty_signature_param_type(v4_lend_contract_ty, v4_lend_contract_imm_sig, 0)
say "lend-mut-param-mode=" + v4_ty_signature_param_mode(v4_lend_contract_ty, v4_lend_contract_mut_sig, 0)
say "lend-local-mode=" + v4_mir_local_mode(v4_lend_contract_mir, v4_lend_contract_imm_body, v4_lend_contract_imm_local)
say "lend-mut-local-mode=" + v4_mir_local_mode(v4_lend_contract_mir, v4_lend_contract_mut_body, v4_lend_contract_mut_local)
say "lend-mut-local-display=" + v4_mir_local_type_display(v4_lend_contract_mir, v4_lend_contract_mut_body, v4_lend_contract_mut_local)
say "lend-editor-kind=" + v4_semantic_at_kind(v4_lend_contract_sem)
say "lend-editor-type=" + v4_semantic_at_type(v4_lend_contract_sem)
say "lend-hover-type=" + v4_hover_type(v4_lend_contract_hover)
say "lend-immutable-status=" + v4_borrowck_result_status(v4_lend_contract_borrow, v4_lend_contract_imm_result)
say "lend-mut-status=" + v4_borrowck_result_status(v4_lend_contract_borrow, v4_lend_contract_mut_result)
say "lend-mut-drops=" + word_from_int(v4_borrowck_result_drops(v4_lend_contract_borrow, v4_lend_contract_mut_result))
say "lend-move-status=" + v4_borrowck_result_status(v4_lend_contract_borrow, v4_lend_contract_move_result)
say "lend-diag-count=" + word_from_int(v4_borrowck_diag_count(v4_lend_contract_borrow))
pilot v4_lend_contract_diag_idx = 0
repeat until v4_lend_contract_diag_idx >= v4_borrowck_diag_count(v4_lend_contract_borrow) {
    pilot v4_lend_contract_diag = v4_borrowck_diag(v4_lend_contract_borrow, v4_lend_contract_diag_idx)
    say "lend-diag" + word_from_int(v4_lend_contract_diag_idx) + "=" + v4_diag_message(v4_lend_contract_diag)
    say "lend-diag" + word_from_int(v4_lend_contract_diag_idx) + "-help=" + v4_diag_help(v4_lend_contract_diag)
    v4_lend_contract_diag_idx += 1
}
