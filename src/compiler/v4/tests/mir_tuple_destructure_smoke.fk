-- V4 MIR tuple destructuring smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_tuple_destructure_good_source() -> word {
    pilot src = "task main() -> int {\n"
    src = src + "    pilot pair = (7, \"ace\")\n"
    src = src + "    pilot (left, label): (int,word) = pair\n"
    src = src + "    pilot ((x, y), _) = ((1, 2), \"team\")\n"
    src = src + "    give back left + y\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_destructure_bad_non_tuple_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot (left, label) = 7\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_destructure_bad_arity_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot (a, b, c) = (1, 2)\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_destructure_bad_duplicate_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot (a, a) = (1, 2)\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_destructure_bad_type_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot (left, label): (int,word) = (7, 9)\n"
    src = src + "}\n"
    give back src
}

