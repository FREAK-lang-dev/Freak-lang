-- V4 @allow_unwinder opt-out smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_allow_unwinder_member_source() -> word {
    -- Member-level opt-out: only the annotated member skips the warning.
    -- The un-annotated unwinder still trips the diagnostic.
    pilot src = "extern [C] {\n"
    src = src + "    @allow_unwinder\n"
    src = src + "    task setjmp(buf: *mut std::ffi::c_void) -> std::ffi::c_int\n"
    src = src + "    task longjmp(buf: *mut std::ffi::c_void, val: std::ffi::c_int) -> void\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_allow_unwinder_block_source() -> word {
    -- Block-level opt-out: silences every unwinder in the block.
    pilot src = "@allow_unwinder\n"
    src = src + "extern [C] {\n"
    src = src + "    task setjmp(buf: *mut std::ffi::c_void) -> std::ffi::c_int\n"
    src = src + "    task longjmp(buf: *mut std::ffi::c_void, val: std::ffi::c_int) -> void\n"
    src = src + "    task __cxa_throw(obj: *mut std::ffi::c_void, ti: *mut std::ffi::c_void, dtor: *mut std::ffi::c_void) -> void\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_allow_unwinder_no_optout_source() -> word {
    -- Baseline: same content, no @allow_unwinder. All three warn.
    pilot src = "extern [C] {\n"
    src = src + "    task setjmp(buf: *mut std::ffi::c_void) -> std::ffi::c_int\n"
    src = src + "    task longjmp(buf: *mut std::ffi::c_void, val: std::ffi::c_int) -> void\n"
    src = src + "    task __cxa_throw(obj: *mut std::ffi::c_void, ti: *mut std::ffi::c_void, dtor: *mut std::ffi::c_void) -> void\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_allow_unwinder_member_text = v4_allow_unwinder_member_source()
pilot v4_allow_unwinder_member_stream = v4_lex_text(0, v4_allow_unwinder_member_text)
pilot v4_allow_unwinder_member_tree = v4_parse_stream(0, v4_allow_unwinder_member_stream)
pilot v4_allow_unwinder_member_hir = v4_hir_lower_tree(0, v4_allow_unwinder_member_tree)
pilot v4_allow_unwinder_member_resolve = v4_resolve_lower_hir(0, v4_allow_unwinder_member_hir)
pilot v4_allow_unwinder_member_ty = v4_ty_lower_resolve(0, v4_allow_unwinder_member_resolve)

say "allow-unwinder-member-diag-count=" + word_from_int(v4_ty_diag_count(v4_allow_unwinder_member_ty))
say "allow-unwinder-member-diag0-severity=" + v4_diag_severity_name(v4_diag_severity(v4_ty_diag(v4_allow_unwinder_member_ty, 0)))
say "allow-unwinder-member-diag0-help=" + v4_diag_help(v4_ty_diag(v4_allow_unwinder_member_ty, 0))

pilot v4_allow_unwinder_block_text = v4_allow_unwinder_block_source()
pilot v4_allow_unwinder_block_stream = v4_lex_text(1, v4_allow_unwinder_block_text)
pilot v4_allow_unwinder_block_tree = v4_parse_stream(1, v4_allow_unwinder_block_stream)
pilot v4_allow_unwinder_block_hir = v4_hir_lower_tree(1, v4_allow_unwinder_block_tree)
pilot v4_allow_unwinder_block_resolve = v4_resolve_lower_hir(1, v4_allow_unwinder_block_hir)
pilot v4_allow_unwinder_block_ty = v4_ty_lower_resolve(1, v4_allow_unwinder_block_resolve)

say "allow-unwinder-block-diag-count=" + word_from_int(v4_ty_diag_count(v4_allow_unwinder_block_ty))

pilot v4_allow_unwinder_no_optout_text = v4_allow_unwinder_no_optout_source()
pilot v4_allow_unwinder_no_optout_stream = v4_lex_text(2, v4_allow_unwinder_no_optout_text)
pilot v4_allow_unwinder_no_optout_tree = v4_parse_stream(2, v4_allow_unwinder_no_optout_stream)
pilot v4_allow_unwinder_no_optout_hir = v4_hir_lower_tree(2, v4_allow_unwinder_no_optout_tree)
pilot v4_allow_unwinder_no_optout_resolve = v4_resolve_lower_hir(2, v4_allow_unwinder_no_optout_hir)
pilot v4_allow_unwinder_no_optout_ty = v4_ty_lower_resolve(2, v4_allow_unwinder_no_optout_resolve)

say "allow-unwinder-no-optout-diag-count=" + word_from_int(v4_ty_diag_count(v4_allow_unwinder_no_optout_ty))
say "allow-unwinder-no-optout-diag0-severity=" + v4_diag_severity_name(v4_diag_severity(v4_ty_diag(v4_allow_unwinder_no_optout_ty, 0)))
