say "arm-growth-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_arm_growth_mir))

pilot v4_mir_base_growth_source = v4_mir_loop_make_base_growth_source()
pilot v4_mir_base_growth_stream = v4_lex_text(5, v4_mir_base_growth_source)
