say "bad-field-growth-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_bad_field_growth_mir))
say "bad-field-growth-help=" + v4_diag_help(v4_mir_diag(v4_mir_bad_field_growth_mir, 0))

pilot v4_mir_arm_growth_source = v4_mir_loop_make_arm_growth_source()
pilot v4_mir_arm_growth_stream = v4_lex_text(4, v4_mir_arm_growth_source)
pilot v4_mir_arm_growth_tree = v4_parse_stream(4, v4_mir_arm_growth_stream)
pilot v4_mir_arm_growth_hir = v4_hir_lower_tree(4, v4_mir_arm_growth_tree)
pilot v4_mir_arm_growth_resolve = v4_resolve_lower_hir(4, v4_mir_arm_growth_hir)
