-- V4 MIR generic doctrine bound smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_generic_bounds_good_source() -> word {
    pilot src = "doctrine Displayable {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "shape Pilot {\n"
    src = src + "    callsign: word\n"
    src = src + "}\n"
    src = src + "impl Displayable for Pilot {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back self.callsign\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task show<T: Displayable>(value: T) -> word {\n"
    src = src + "    give back value.display()\n"
    src = src + "}\n"
    src = src + "task main(ship: Pilot) -> word {\n"
    src = src + "    give back show(ship)\n"
    src = src + "}\n"
    give back src
}

task v4_mir_generic_bounds_bad_source() -> word {
    pilot src = "doctrine Displayable {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "shape Rock {\n"
    src = src + "    mass: int\n"
    src = src + "}\n"
    src = src + "task show<T: Displayable>(value: T) -> word {\n"
    src = src + "    give back value.display()\n"
    src = src + "}\n"
    src = src + "task main(rock: Rock) -> word {\n"
    src = src + "    give back show(rock)\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_generic_bounds_good_text = v4_mir_generic_bounds_good_source()
pilot v4_mir_generic_bounds_good_stream = v4_lex_text(0, v4_mir_generic_bounds_good_text)
pilot v4_mir_generic_bounds_good_tree = v4_parse_stream(0, v4_mir_generic_bounds_good_stream)
pilot v4_mir_generic_bounds_good_hir = v4_hir_lower_tree(0, v4_mir_generic_bounds_good_tree)
pilot v4_mir_generic_bounds_good_resolve = v4_resolve_lower_hir(0, v4_mir_generic_bounds_good_hir)
pilot v4_mir_generic_bounds_good_ty = v4_ty_lower_resolve(0, v4_mir_generic_bounds_good_resolve)
pilot v4_mir_generic_bounds_good_mir = v4_mir_lower_ty(0, v4_mir_generic_bounds_good_ty)
pilot v4_mir_generic_bounds_show_def = v4_resolve_def_for_name(v4_mir_generic_bounds_good_resolve, "show")
pilot v4_mir_generic_bounds_show_body = v4_mir_lookup_body(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_show_def)
pilot v4_mir_generic_bounds_show_return = v4_mir_stmt_rvalue(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_show_body, 0)
pilot v4_mir_generic_bounds_main_def = v4_resolve_def_for_name(v4_mir_generic_bounds_good_resolve, "main")
pilot v4_mir_generic_bounds_main_body = v4_mir_lookup_body(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_main_def)
pilot v4_mir_generic_bounds_main_return = v4_mir_stmt_rvalue(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_main_body, 0)

say v4_mir_summary(v4_mir_generic_bounds_good_mir)
say "bound-good-show-return-kind=" + v4_mir_rvalue_kind(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_show_body, v4_mir_generic_bounds_show_return)
say "bound-good-show-return-op=" + v4_mir_rvalue_op(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_show_body, v4_mir_generic_bounds_show_return)
say "bound-good-show-return-ty=" + v4_mir_rvalue_ty(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_show_body, v4_mir_generic_bounds_show_return)
say "bound-good-main-return-ty=" + v4_mir_rvalue_ty(v4_mir_generic_bounds_good_mir, v4_mir_generic_bounds_main_body, v4_mir_generic_bounds_main_return)
say "bound-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_generic_bounds_good_mir))

pilot v4_mir_generic_bounds_bad_text = v4_mir_generic_bounds_bad_source()
pilot v4_mir_generic_bounds_bad_stream = v4_lex_text(1, v4_mir_generic_bounds_bad_text)
pilot v4_mir_generic_bounds_bad_tree = v4_parse_stream(1, v4_mir_generic_bounds_bad_stream)
pilot v4_mir_generic_bounds_bad_hir = v4_hir_lower_tree(1, v4_mir_generic_bounds_bad_tree)
pilot v4_mir_generic_bounds_bad_resolve = v4_resolve_lower_hir(1, v4_mir_generic_bounds_bad_hir)
pilot v4_mir_generic_bounds_bad_ty = v4_ty_lower_resolve(1, v4_mir_generic_bounds_bad_resolve)
pilot v4_mir_generic_bounds_bad_mir = v4_mir_lower_ty(1, v4_mir_generic_bounds_bad_ty)

say "bound-bad-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_generic_bounds_bad_mir))
say "bound-bad-message=" + v4_diag_message(v4_mir_diag(v4_mir_generic_bounds_bad_mir, 0))
say "bound-bad-help=" + v4_diag_help(v4_mir_diag(v4_mir_generic_bounds_bad_mir, 0))
