-- Cold expansion and query facade admission at the unchanged handle ceiling.
task v4_cold_expand_assert(condition: bool, label: word) -> void {
    if not condition { panic("cold-expand-admission " + label) }
}

task v4_cold_expand_capacity() -> int {
    pilot held = array_new()
    v4_cold_expand_assert(held >= 0, "capacity tracker")
    pilot count = 0
    pilot exhausted = false
    repeat until exhausted or count >= 2048 {
        pilot candidate = array_new()
        if candidate < 0 { exhausted = true } else { array_push(held, word_from_int(candidate)) count += 1 }
    }
    pilot index = 0
    repeat until index >= array_len(held) { array_release(word_to_int(array_get(held, index))) index += 1 }
    array_release(held)
    v4_cold_expand_assert(exhausted, "1024 guard reached")
    give back count
}

task v4_cold_expand_hold(free_count: int) -> int {
    pilot held = array_new()
    v4_cold_expand_assert(held >= 0, "pressure tracker")
    pilot exhausted = false
    repeat until exhausted {
        pilot candidate = array_new()
        if candidate < 0 { exhausted = true } else { array_push(held, word_from_int(candidate)) }
    }
    v4_cold_expand_assert(array_len(held) >= free_count, "pressure headroom")
    pilot index = 0
    repeat until index >= free_count { array_release(word_to_int(array_get(held, index))) index += 1 }
    give back held
}

task v4_cold_expand_release(held: int, free_count: int) -> void {
    pilot index = free_count
    repeat until index >= array_len(held) { array_release(word_to_int(array_get(held, index))) index += 1 }
    array_release(held)
}

-- Deliberately distinct cold sentinels detect any partial global publication.
task v4_cold_expand_seed_sentinels() -> void {
    v4_query_keys = 0 - 101
    v4_query_inputs = 0 - 102
    v4_query_outputs = 0 - 103
    v4_query_states = 0 - 104
    v4_query_entry_generations = 0 - 105
    v4_query_entry_last_generations = 0 - 106
    v4_query_entry_last_events = 0 - 107
    v4_query_dep_from = 0 - 108
    v4_query_dep_to = 0 - 109
    v4_query_generation_reasons = 0 - 110
    v4_query_invalidated_keys = 0 - 111
    v4_query_invalidated_generations = 0 - 112
    v4_query_invalidated_reasons = 0 - 113
    v4_query_telemetry_keys = 0 - 114
    v4_query_telemetry_hits = 0 - 115
    v4_query_telemetry_misses = 0 - 116
    v4_query_telemetry_stores = 0 - 117
    v4_query_entry_len = 11
    v4_query_dep_len = 12
    v4_query_hit_total = 13
    v4_query_miss_total = 14
    v4_query_store_total = 15
    v4_query_ready = 0
    v4_query_revision = 37
}

task v4_cold_expand_original_facts() -> word {
    pilot out = ""
    out = out + ":" + word_from_int(v4_query_keys)
    out = out + ":" + word_from_int(v4_query_inputs)
    out = out + ":" + word_from_int(v4_query_outputs)
    out = out + ":" + word_from_int(v4_query_states)
    out = out + ":" + word_from_int(v4_query_entry_generations)
    out = out + ":" + word_from_int(v4_query_entry_last_generations)
    out = out + ":" + word_from_int(v4_query_entry_last_events)
    out = out + ":" + word_from_int(v4_query_dep_from)
    out = out + ":" + word_from_int(v4_query_dep_to)
    out = out + ":" + word_from_int(v4_query_generation_reasons)
    out = out + ":" + word_from_int(v4_query_invalidated_keys)
    out = out + ":" + word_from_int(v4_query_invalidated_generations)
    out = out + ":" + word_from_int(v4_query_invalidated_reasons)
    out = out + ":" + word_from_int(v4_query_telemetry_keys)
    out = out + ":" + word_from_int(v4_query_telemetry_hits)
    out = out + ":" + word_from_int(v4_query_telemetry_misses)
    out = out + ":" + word_from_int(v4_query_telemetry_stores)
    out = out + ":" + word_from_int(v4_query_entry_len)
    out = out + ":" + word_from_int(v4_query_dep_len)
    out = out + ":" + word_from_int(v4_query_hit_total)
    out = out + ":" + word_from_int(v4_query_miss_total)
    out = out + ":" + word_from_int(v4_query_store_total)
    out = out + ":" + word_from_int(v4_query_ready)
    out = out + ":" + word_from_int(v4_query_revision)
    give back out
}


task v4_cold_expand_seed_expand() -> void {
    v4_expand_files = 0 - 201
    v4_expand_trees = 0 - 202
    v4_expand_provenance_kinds = 0 - 203
    v4_expand_generations = 0 - 204
    v4_expand_file_len = 23
    v4_expand_ready = 0
}

task v4_cold_expand_expand_facts() -> word {
    give back word_from_int(v4_expand_files) + ":" + word_from_int(v4_expand_trees) + ":" + word_from_int(v4_expand_provenance_kinds) + ":" + word_from_int(v4_expand_generations) + ":" + word_from_int(v4_expand_file_len) + ":" + word_from_int(v4_expand_ready) + ":" + word_from_int(v4_session_semantic_restore_generation())
}

task v4_cold_expand_empty_payload() -> word {
    give back "expand-snapshot|format=freak-expand-snapshot-v1|files=0\nend|freak-expand-snapshot-v1"
}

task v4_cold_expand_failed_mutators() -> void {
    v4_expand_init()
    v4_cold_expand_assert(v4_expand_file_count() == 0 and not v4_expand_file_exists(0), "failed observers")
    v4_cold_expand_assert(v4_expand_find_identity(0, 0) < 0 and v4_expand_identity(0, 0) < 0, "failed identity")
    v4_cold_expand_assert(v4_expand_restore_file_slot(0, 0, 0, "identity") == 0, "failed raw slot")
    v4_expand_begin_snapshot_restore()
    v4_cold_expand_assert(v4_expand_snapshot() == "", "failed serializer admits no collector")
    v4_cold_expand_assert(v4_expand_snapshot_restore(v4_cold_expand_empty_payload()) == "expand-snapshot-restore ok=0 reason=expand-initialization-resource-exhausted", "named raw admission failure")
}

task v4_cold_expand_canonical_query() -> void {
    v4_query_keys = 0
    v4_query_inputs = 0
    v4_query_outputs = 0
    v4_query_states = 0
    v4_query_entry_generations = 0
    v4_query_entry_last_generations = 0
    v4_query_entry_last_events = 0
    v4_query_dep_from = 0
    v4_query_dep_to = 0
    v4_query_generation_reasons = 0
    v4_query_invalidated_keys = 0
    v4_query_invalidated_generations = 0
    v4_query_invalidated_reasons = 0
    v4_query_telemetry_keys = 0
    v4_query_telemetry_hits = 0
    v4_query_telemetry_misses = 0
    v4_query_telemetry_stores = 0
    v4_query_entry_len = 0
    v4_query_dep_len = 0
    v4_query_hit_total = 0
    v4_query_miss_total = 0
    v4_query_store_total = 0
    v4_query_ready = 0
    v4_query_revision = 1
}

task v4_cold_expand_admission_run() -> void {
    v4_cold_expand_assert(v4_query_ready == 0 and v4_expand_ready == 0, "both registries start cold")
    pilot capacity = v4_cold_expand_capacity()
    v4_cold_expand_assert(capacity == 1023, "actual 1024 live-array ceiling")
    pilot cycle = 0
    repeat until cycle >= 3 {
        pilot free_count = 0
        repeat until free_count > 4 {
            v4_cold_expand_seed_expand()
            pilot original = v4_cold_expand_expand_facts()
            pilot held = v4_cold_expand_hold(free_count)
            pilot admitted = v4_expand_try_init()
            if free_count < 4 {
                v4_cold_expand_assert(not admitted, "four constructor failure positions")
                v4_cold_expand_failed_mutators()
                v4_cold_expand_assert(v4_cold_expand_expand_facts() == original, "failed expansion mutation and epoch atomic")
            } else {
                v4_cold_expand_assert(admitted and v4_expand_ready == 1 and v4_expand_file_len == 0, "exact four success")
                v4_cold_expand_assert(v4_expand_files >= 0 and v4_expand_trees >= 0 and v4_expand_provenance_kinds >= 0 and v4_expand_generations >= 0, "all four published")
                v4_expand_rollback_cold_init(0 - 201, 0 - 202, 0 - 203, 0 - 204, 23)
                v4_cold_expand_assert(v4_cold_expand_expand_facts() == original, "four exact prior refs restored")
            }
            v4_cold_expand_release(held, free_count)
            v4_cold_expand_assert(v4_cold_expand_capacity() == capacity, "four partial stages retired")
            free_count += 1
        }
        cycle += 1
    }

    cycle = 0
    repeat until cycle >= 2 {
        pilot free_count = 0
        repeat until free_count > 20 {
            v4_cold_expand_seed_sentinels()
            v4_cold_expand_seed_expand()
            pilot query_original = v4_cold_expand_original_facts()
            pilot expand_original = v4_cold_expand_expand_facts()
            pilot held = v4_cold_expand_hold(free_count)
            pilot restore_result = v4_expand_snapshot_restore_with_queries(v4_cold_expand_empty_payload())
            if free_count < 17 {
                v4_cold_expand_assert(restore_result == "expand-snapshot-restore ok=0 reason=query-initialization-resource-exhausted", "joint query rejection")
            } else {
                v4_cold_expand_assert(restore_result == "expand-snapshot-restore ok=0 reason=expand-initialization-resource-exhausted", "joint expansion rejection")
            }
            v4_cold_expand_assert(v4_cold_expand_original_facts() == query_original and v4_cold_expand_expand_facts() == expand_original, "joint failure preserves both cold registries and epoch")
            v4_cold_expand_release(held, free_count)
            v4_cold_expand_assert(v4_cold_expand_capacity() == capacity, "joint admission retired")
            free_count += 1
        }
        cycle += 1
    }

    v4_cold_expand_seed_sentinels()
    v4_cold_expand_seed_expand()
    pilot query_original = v4_cold_expand_original_facts()
    pilot expand_original = v4_cold_expand_expand_facts()
    pilot held = v4_cold_expand_hold(21)
    v4_cold_expand_assert(v4_expand_snapshot_restore_with_queries("malformed").starts_with("expand-snapshot-restore ok=0 reason=validation-failed"), "malformed after query admission")
    v4_cold_expand_assert(v4_cold_expand_original_facts() == query_original and v4_cold_expand_expand_facts() == expand_original, "malformed restores exact cold facts")
    v4_cold_expand_release(held, 21)
    v4_cold_expand_assert(v4_cold_expand_capacity() == capacity, "malformed admission retired")

    v4_cold_expand_canonical_query()
    v4_expand_files = 0
    v4_expand_trees = 0
    v4_expand_provenance_kinds = 0
    v4_expand_generations = 0
    v4_expand_file_len = 0
    v4_expand_ready = 0
    pilot epoch = v4_session_semantic_restore_generation()
    held = v4_cold_expand_hold(21)
    v4_cold_expand_assert(v4_expand_snapshot_restore_with_queries(v4_cold_expand_empty_payload()) == "expand-snapshot-restore ok=1 files=0 skipped-other=0 live-files=0 query-invalidations=0", "exact twenty-one success")
    v4_cold_expand_assert(v4_query_ready == 1 and v4_expand_ready == 1 and v4_query_revision == 2 and v4_session_semantic_restore_generation() == epoch + 1, "joint successful publication and generations")
    v4_cold_expand_assert(v4_query_cache_size() == 0 and v4_query_hit_count() == 0 and v4_query_miss_count() == 0 and v4_query_store_count() == 0, "successful empty query facts")
    v4_cold_expand_release(held, 21)
    v4_cold_expand_assert(v4_cold_expand_capacity() == capacity - 21, "exact twenty-one persistent owners")
    say "cold-expand-admission positions=4 cycles=3 exact-capacity=true failed-mutations-atomic=true"
    say "cold-expand-admission joint=0..21 cycles=2 malformed-atomic=true recovery=true handles-conserved=true"
}

v4_cold_expand_admission_run()
