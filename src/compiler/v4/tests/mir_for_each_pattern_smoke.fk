pilot v4_mir_for_each_pattern_first_loop_stmt = v4_mir_for_each_pattern_find_stmt(v4_mir_for_each_pattern_mir, v4_mir_for_each_pattern_main_body, v4_mir_stmt_loop, "( power , label )")
pilot v4_mir_for_each_pattern_second_item_stmt = v4_mir_for_each_pattern_find_stmt(v4_mir_for_each_pattern_mir, v4_mir_for_each_pattern_main_body, v4_mir_stmt_local, "_for_each_item2")
pilot v4_mir_for_each_pattern_right_stmt = v4_mir_for_each_pattern_find_stmt(v4_mir_for_each_pattern_mir, v4_mir_for_each_pattern_main_body, v4_mir_stmt_local, "right")
