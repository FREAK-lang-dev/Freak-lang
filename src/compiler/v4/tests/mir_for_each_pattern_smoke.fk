pilot v4_mir_for_each_pattern_return_stmt = v4_mir_for_each_pattern_find_stmt(v4_mir_for_each_pattern_mir, v4_mir_for_each_pattern_main_body, v4_mir_stmt_return, "")
pilot v4_mir_for_each_pattern_first_item_rvalue = v4_mir_stmt_rvalue(v4_mir_for_each_pattern_mir, v4_mir_for_each_pattern_main_body, v4_mir_for_each_pattern_first_item_stmt)
