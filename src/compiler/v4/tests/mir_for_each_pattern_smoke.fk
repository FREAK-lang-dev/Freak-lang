-- V4 MIR for-each pattern binding smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_for_each_pattern_good_source() -> word {
    pilot src = "task tuples() -> List<(int,word)> {\n"
    src = src + "    give back [(7, \"ace\"), (9, \"beta\")]\n"
    src = src + "}\n"
    src = src + "task rows() -> List<List<int>> {\n"
    src = src + "    give back [[1, 2], [3, 4]]\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot total = 0\n"
    src = src + "    pilot pairs = tuples()\n"
    src = src + "    pilot rowset = rows()\n"
    src = src + "    for each (power, label) in pairs {\n"
    src = src + "        total = total + power\n"
    src = src + "    }\n"
    src = src + "    for each [left, right] in rowset {\n"
    src = src + "        total = total + right\n"
    src = src + "    }\n"
    src = src + "    give back total\n"
    src = src + "}\n"
    give back src
}

task v4_mir_for_each_pattern_bad_non_iterable_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    for each item in 7 {\n"
    src = src + "        pilot seen = item\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_for_each_pattern_bad_tuple_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot squad = [1, 2]\n"
    src = src + "    for each (left, right) in squad {\n"
    src = src + "        pilot seen = left\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_for_each_pattern_bad_sequence_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot squad = [1, 2]\n"
    src = src + "    for each [left, right] in squad {\n"
    src = src + "        pilot seen = left\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_for_each_pattern_bad_duplicate_local_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot item = 0\n"
    src = src + "    pilot squad = [1, 2]\n"
    src = src + "    for each item in squad {\n"
    src = src + "        pilot seen = item\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_for_each_pattern_bad_duplicate_pattern_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot squad = [(1, 2)]\n"
    src = src + "    for each (left, left) in squad {\n"
    src = src + "        pilot seen = left\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_for_each_pattern_find_stmt(mir_id: int, body_id: int, kind: word, lhs: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == kind and (lhs == "" or v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == lhs) {
            give back stmt_id
        }
        stmt_id += 1
    }
    give back 0 - 1
}

pilot v4_mir_for_each_pattern_stream = v4_lex_text(0, v4_mir_for_each_pattern_good_source())
pilot v4_mir_for_each_pattern_tree = v4_parse_stream(0, v4_mir_for_each_pattern_stream)
