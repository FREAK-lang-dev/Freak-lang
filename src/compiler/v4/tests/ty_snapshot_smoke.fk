-- V4 type arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_ty_snapshot_bool_text(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_ty_snapshot_signature_variant_line(line: word, mode: word) -> word {
    pilot sig_kind = v4_ty_snapshot_field(line, 4)
    pilot hir_item = v4_ty_snapshot_field_raw(line, 7)
    if mode == "unknown-kind" {
        sig_kind = "causality-signature"
    } else if mode == "dangling-hir" {
        pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
        pilot resolve_id = v4_ty_resolve_id(ty_id)
        pilot hir_id = v4_resolve_hir_id(resolve_id)
        hir_item = word_from_int(v4_hir_item_count(hir_id))
    }

    pilot out = "signature"
    out = out + "|" + v4_ty_snapshot_field_raw(line, 1)
    out = out + "|" + v4_ty_snapshot_field_raw(line, 2)
    out = out + "|" + v4_ty_snapshot_field_raw(line, 3)
    out = out + "|" + v4_ty_snapshot_escape(sig_kind)
    out = out + "|" + v4_ty_snapshot_field_raw(line, 5)
    out = out + "|" + v4_ty_snapshot_field_raw(line, 6)
    out = out + "|" + hir_item
    give back out
}

task v4_ty_snapshot_signature_variant(payload: word, mode: word) -> word {
    pilot out = ""
    pilot replaced = false
    pilot line_id = 0
    pilot line_count = v4_ty_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if replaced == false and v4_ty_snapshot_field_raw(line, 0) == "signature" {
            line = v4_ty_snapshot_signature_variant_line(line, mode)
            replaced = true
        }
        if line_id > 0 { out = out + "\n" }
        out = out + line
        line_id += 1
    }
    give back out
}

task v4_ty_snapshot_signature_assert(mode: word) -> void {
    pilot before = v4_ty_snapshot()
    pilot corrupt = v4_ty_snapshot_signature_variant(before, mode)
    pilot validation = v4_ty_snapshot_validate(corrupt)
    say "ty-signature-" + mode + "-validate-rejected=" + v4_ty_snapshot_bool_text(validation.starts_with("ty-snapshot-import ok=0"))
    pilot restore = v4_ty_snapshot_restore(corrupt)
    say "ty-signature-" + mode + "-restore-rejected=" + v4_ty_snapshot_bool_text(restore.starts_with("ty-snapshot-restore ok=0 reason=validation-failed"))
    say "ty-signature-" + mode + "-state-stable=" + v4_ty_snapshot_bool_text(v4_ty_snapshot() == before)
}

task v4_ty_snapshot_run() -> void {
pilot v4_ty_snapshot_source = "task main() => \"hi|there\"\n"
v4_ty_snapshot_source = v4_ty_snapshot_source + "shape Pilot\n"
v4_ty_snapshot_source = v4_ty_snapshot_source + "doctrine Display\n"
v4_ty_snapshot_source = v4_ty_snapshot_source + "task main() => \"again\"\n"

pilot v4_ty_snapshot_id = v4_ty_text_cached("ty-snapshot.fk", v4_ty_snapshot_source)
say v4_ty_summary(v4_ty_snapshot_id)
say v4_ty_snapshot_summary()

pilot v4_ty_snapshot_payload = v4_ty_snapshot()
v4_ty_snapshot_signature_assert("unknown-kind")
v4_ty_snapshot_signature_assert("dangling-hir")
pilot v4_ty_snapshot_file_count_before = v4_ty_file_count()
pilot v4_ty_snapshot_retained_defs_handle = v4_ty_defs_handle(v4_ty_snapshot_id)
pilot v4_ty_snapshot_retained_diags_handle = v4_ty_diags_handle(v4_ty_snapshot_id)
pilot v4_ty_snapshot_retained_signature_capacity = v4_ty_signature_capacity(v4_ty_snapshot_id)
pilot v4_ty_snapshot_retained_diag_capacity = v4_ty_diag_capacity(v4_ty_snapshot_id)
pilot v4_ty_snapshot_state_before_invalid = v4_ty_snapshot()
pilot v4_ty_snapshot_invalid_payload = "ty-snapshot|format=freak-ty-snapshot-v1|files=1|signatures=0|diagnostics=0\nend|freak-ty-snapshot-v1"
pilot v4_ty_snapshot_invalid_restore = v4_ty_snapshot_restore(v4_ty_snapshot_invalid_payload)
say "ty-restore-malformed-rejected=" + v4_ty_snapshot_bool_text(v4_ty_snapshot_invalid_restore.starts_with("ty-snapshot-restore ok=0 reason=validation-failed"))
say "ty-restore-malformed-atomic=" + v4_ty_snapshot_bool_text(v4_ty_snapshot() == v4_ty_snapshot_state_before_invalid)
say v4_ty_snapshot_validate(v4_ty_snapshot_payload)
say "ty-snapshot-bytes=" + word_from_int(v4_ty_snapshot_payload.length())
say "ty-snapshot-escape=" + v4_ty_snapshot_escape("signature|value%z\nspan")
say "ty-snapshot-unescape=" + v4_ty_snapshot_unescape("signature%7Cvalue%25z%0Aspan")
say v4_ty_snapshot_file_line(v4_ty_snapshot_id)
say v4_ty_snapshot_signature_line(v4_ty_snapshot_id, 0)
say v4_ty_snapshot_diag_line(v4_ty_snapshot_id, 0)

pilot v4_ty_snapshot_extra_source = "task extra() -> int {\n"
v4_ty_snapshot_extra_source = v4_ty_snapshot_extra_source + "    give back 1\n"
v4_ty_snapshot_extra_source = v4_ty_snapshot_extra_source + "}\n"
pilot v4_ty_snapshot_extra_id = v4_ty_text_cached("ty-snapshot-extra.fk", v4_ty_snapshot_extra_source)
pilot v4_ty_snapshot_capacity_after_extra = v4_ty_file_capacity()
say "ty-restore-extra-visible-before=" + v4_ty_snapshot_bool_text(v4_ty_file_exists(v4_ty_snapshot_extra_id))
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
pilot v4_ty_snapshot_restore_result = v4_ty_snapshot_restore(v4_ty_snapshot_payload)
say v4_ty_snapshot_restore_result
say "ty-restore-active-files-exact=" + v4_ty_snapshot_bool_text(v4_ty_file_count() == v4_ty_snapshot_file_count_before)
say "ty-restore-extra-file-hidden=" + v4_ty_snapshot_bool_text(v4_ty_file_exists(v4_ty_snapshot_extra_id) == false and v4_ty_file_id(v4_ty_snapshot_extra_id) < 0 and v4_ty_resolve_id(v4_ty_snapshot_extra_id) < 0)
say "ty-restore-extra-children-hidden=" + v4_ty_snapshot_bool_text(v4_ty_signature_count(v4_ty_snapshot_extra_id) == 0 and v4_ty_diag_count(v4_ty_snapshot_extra_id) == 0 and v4_ty_signature_def(v4_ty_snapshot_extra_id, 0) == "" and v4_ty_diag(v4_ty_snapshot_extra_id, 0) == "")
say "ty-restore-retained-handles-reused=" + v4_ty_snapshot_bool_text(v4_ty_defs_handle(v4_ty_snapshot_id) == v4_ty_snapshot_retained_defs_handle and v4_ty_diags_handle(v4_ty_snapshot_id) == v4_ty_snapshot_retained_diags_handle)
say "ty-restore-retained-capacity-stable=" + v4_ty_snapshot_bool_text(v4_ty_signature_capacity(v4_ty_snapshot_id) == v4_ty_snapshot_retained_signature_capacity and v4_ty_diag_capacity(v4_ty_snapshot_id) == v4_ty_snapshot_retained_diag_capacity)

pilot v4_ty_snapshot_reused_id = v4_ty_text_cached("ty-snapshot-reused.fk", v4_ty_snapshot_extra_source)
say "ty-restore-top-slot-reused=" + v4_ty_snapshot_bool_text(v4_ty_snapshot_reused_id == v4_ty_snapshot_extra_id)
say "ty-restore-top-capacity-stable=" + v4_ty_snapshot_bool_text(v4_ty_file_capacity() == v4_ty_snapshot_capacity_after_extra)
say v4_ty_snapshot_restore(v4_ty_snapshot_payload)
say "ty-restore-repeat-no-growth=" + v4_ty_snapshot_bool_text(v4_ty_file_capacity() == v4_ty_snapshot_capacity_after_extra and v4_ty_signature_capacity(v4_ty_snapshot_id) == v4_ty_snapshot_retained_signature_capacity and v4_ty_diag_capacity(v4_ty_snapshot_id) == v4_ty_snapshot_retained_diag_capacity)
say v4_lsp_ty_snapshot_text()
say v4_lsp_ty_snapshot_restore_text(v4_ty_snapshot_payload)
say v4_lsp_handle_text_request("workspace/tySnapshotRestore", "ty-snapshot.fk", v4_ty_snapshot_payload, 0)
say v4_lsp_handle_request("workspace/tySnapshotRestore", "ty-snapshot.fk", 0)

pilot v4_ty_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_ty_query_payload)
say v4_driver_confirm_restored_document_text("ty-snapshot.fk", v4_ty_snapshot_source)
pilot v4_ty_file = v4_source_find("ty-snapshot.fk")
pilot v4_ty_fingerprint = v4_source_fingerprint(v4_ty_file)
pilot v4_ty_restored_id = word_to_int(v4_query_get(v4_ty_query_key("ty-snapshot.fk"), v4_ty_fingerprint))
pilot v4_ty_main_def = v4_resolve_def_for_name(v4_ty_resolve_id(v4_ty_restored_id), "main")
say v4_ty_summary(v4_ty_restored_id)
say "restored-main-signature=" + v4_ty_signature_of(v4_ty_restored_id, v4_ty_main_def)
say v4_driver_confirm_restored_document_text("ty-snapshot.fk", "task changed() => 7\n")
}

v4_ty_snapshot_run()
