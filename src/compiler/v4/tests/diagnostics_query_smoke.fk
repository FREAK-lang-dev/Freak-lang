say "lifetime-query-diag0-message=" + v4_diag_message(v4_diagnostics_diag(v4_lifetime_diag_query_id, 0))
say "lifetime-query-diag0-span=" + v4_diag_span(v4_diagnostics_diag(v4_lifetime_diag_query_id, 0))
