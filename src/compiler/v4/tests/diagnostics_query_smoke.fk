-- V4 query-facing diagnostics smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_diag_query_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_alias_query_diag_source() -> word {
    pilot src = "alias Loop = Loop\n"
    src = src + "alias First = Second\n"
    src = src + "alias Second = First\n"
    src = src + "alias Spiral<T> = Spiral<T>\n"
    src = src + "alias Pair = (Pair, int)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lifetime_query_diag_source() -> word {
    pilot src = "shape RefBox<'a,T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape BadBox {\n"
    src = src + "    value: RefBox<'ghost,int>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_const_query_diag_source() -> word {
    pilot ace_braces = v4_diag_query_braces(" hp: \"ace\" ")
    pilot route_decl_braces = v4_diag_query_braces(" code: int ")
    pilot box_braces = v4_diag_query_braces(" value: 1 ")
    pilot option_decl_braces = v4_diag_query_braces(" value: T ")
    pilot some_braces = v4_diag_query_braces(" value: \"ace\" ")
    pilot src = "fixed pilot PAIR: (int,word) = (1, 2)\n"
    src = src + "fixed pilot GRID: [int; 3] = [0; 2]\n"
    src = src + "fixed pilot ACE: Pilot = Pilot " + ace_braces + "\n"
    src = src + "fixed pilot SIGNAL = Event::Key\n"
    src = src + "fixed pilot BAD_GENERIC_SHAPE = Box<int,word> " + box_braces + "\n"
    src = src + "fixed pilot TYPE_GENERIC_SHAPE = Box<int> " + v4_diag_query_braces(" value: \"ace\" ") + "\n"
    src = src + "fixed pilot BAD_GENERIC_ROUTE = Option<int,word>::None\n"
    src = src + "fixed pilot TYPE_GENERIC_ROUTE = Option<int>::Some " + some_braces + "\n"
    src = src + "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Event {\n"
    src = src + "    Key " + route_decl_braces + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl_braces + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_const_task_query_diag_source() -> word {
    pilot src = "@const task bump(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "task runtime_only(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot BAD_RUNTIME = runtime_only(BASE)\n"
    src = src + "fixed pilot BAD_ARITY = bump()\n"
    src = src + "fixed pilot BAD_TYPE = bump(\"ace\")\n"
    src = src + "@const task add(base: int, bonus: int) -> int {\n"
    src = src + "    give back base + bonus\n"
    src = src + "}\n"
    src = src + "fixed pilot BAD_UNKNOWN = add(extra: BASE, bonus: 1)\n"
    src = src + "fixed pilot BAD_DUP = add(base: BASE, base: 1)\n"
    src = src + "fixed pilot BAD_ORDER = add(base: BASE, 1)\n"
    src = src + "fixed pilot BAD_MISSING = add(base: BASE)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back BASE\n"
    src = src + "}\n"
    give back src
}

task v4_layout_query_diag_source() -> word {
    pilot src = "@layout(transparent)\n"
    src = src + "shape BrokenHandle {\n"
    src = src + "    left: int\n"
    src = src + "    right: int\n"
    src = src + "}\n"
    src = src + "@layout(C, packed=0)\n"
    src = src + "shape ZeroPacked {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "@layout(packed=1)\n"
    src = src + "shape MissingC {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_diag_query_source = "task main() -> int {\n"
v4_diag_query_source = v4_diag_query_source + "    pilot text = \"hi\"\n"
v4_diag_query_source = v4_diag_query_source + "    pilot bad = text - 1\n"
v4_diag_query_source = v4_diag_query_source + "    if 1 {\n"
v4_diag_query_source = v4_diag_query_source + "        pilot y = 0\n"
v4_diag_query_source = v4_diag_query_source + "    }\n"
v4_diag_query_source = v4_diag_query_source + "    text = 1\n"
v4_diag_query_source = v4_diag_query_source + "    give back 0\n"
v4_diag_query_source = v4_diag_query_source + "}\n"

pilot v4_diag_query_id = v4_diagnostics_text_cached("diag_query.fk", v4_diag_query_source)
pilot v4_alias_diag_query_id = v4_diagnostics_text_cached("alias_cycle_query.fk", v4_alias_query_diag_source())
pilot v4_lifetime_diag_query_id = v4_diagnostics_text_cached("lifetime_query.fk", v4_lifetime_query_diag_source())
pilot v4_const_diag_query_id = v4_diagnostics_text_cached("const_query.fk", v4_const_query_diag_source())
pilot v4_const_task_diag_query_id = v4_diagnostics_text_cached("const_task_query.fk", v4_const_task_query_diag_source())
pilot v4_layout_diag_query_id = v4_diagnostics_text_cached("layout_query.fk", v4_layout_query_diag_source())

say v4_diagnostics_summary(v4_diag_query_id)
say "query-diag-count=" + word_from_int(v4_diagnostics_count(v4_diag_query_id))
say "query-diag0-message=" + v4_diag_message(v4_diagnostics_diag(v4_diag_query_id, 0))
say "alias-query-diag-count=" + word_from_int(v4_diagnostics_count(v4_alias_diag_query_id))
say "alias-query-diag0-message=" + v4_diag_message(v4_diagnostics_diag(v4_alias_diag_query_id, 0))
say "alias-query-diag0-span=" + v4_diag_span(v4_diagnostics_diag(v4_alias_diag_query_id, 0))
