pilot v4_extern_callback_diag_query_id = v4_diagnostics_text_cached("extern_callback_query.fk", v4_extern_callback_query_diag_source())
pilot v4_extern_callback_call_diag_query_id = v4_diagnostics_text_cached("extern_callback_call_query.fk", v4_extern_callback_call_query_diag_source())

say v4_diagnostics_summary(v4_diag_query_id)
say "query-diag-count=" + word_from_int(v4_diagnostics_count(v4_diag_query_id))
