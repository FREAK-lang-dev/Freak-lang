-- V4 query-facing diagnostics smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_diag_query_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_alias_query_diag_source() -> word {
    pilot src = "alias Loop = Loop\n"
    src = src + "alias First = Second\n"
    src = src + "alias Second = First\n"
    src = src + "alias Spiral<T> = Spiral<T>\n"
    src = src + "alias Pair = (Pair, int)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lifetime_query_diag_source() -> word {
    pilot src = "shape RefBox<'a,T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape BadBox {\n"
    src = src + "    value: RefBox<'ghost,int>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_const_query_diag_source() -> word {
    pilot ace_braces = v4_diag_query_braces(" hp: \"ace\" ")
    pilot route_decl_braces = v4_diag_query_braces(" code: int ")
    pilot box_braces = v4_diag_query_braces(" value: 1 ")
    pilot option_decl_braces = v4_diag_query_braces(" value: T ")
    pilot some_braces = v4_diag_query_braces(" value: \"ace\" ")
    pilot src = "fixed pilot PAIR: (int,word) = (1, 2)\n"
    src = src + "fixed pilot GRID: [int; 3] = [0; 2]\n"
    src = src + "fixed pilot ACE: Pilot = Pilot " + ace_braces + "\n"
    src = src + "fixed pilot SIGNAL = Event::Key\n"
    src = src + "fixed pilot BAD_GENERIC_SHAPE = Box<int,word> " + box_braces + "\n"
    src = src + "fixed pilot TYPE_GENERIC_SHAPE = Box<int> " + v4_diag_query_braces(" value: \"ace\" ") + "\n"
    src = src + "fixed pilot BAD_GENERIC_ROUTE = Option<int,word>::None\n"
    src = src + "fixed pilot TYPE_GENERIC_ROUTE = Option<int>::Some " + some_braces + "\n"
    src = src + "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Event {\n"
    src = src + "    Key " + route_decl_braces + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl_braces + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_const_task_query_diag_source() -> word {
    pilot src = "@const task bump(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "task runtime_only(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot BAD_RUNTIME = runtime_only(BASE)\n"
    src = src + "fixed pilot BAD_ARITY = bump()\n"
    src = src + "fixed pilot BAD_TYPE = bump(\"ace\")\n"
    src = src + "@const task add(base: int, bonus: int) -> int {\n"
    src = src + "    give back base + bonus\n"
    src = src + "}\n"
    src = src + "fixed pilot BAD_UNKNOWN = add(extra: BASE, bonus: 1)\n"
    src = src + "fixed pilot BAD_DUP = add(base: BASE, base: 1)\n"
    src = src + "fixed pilot BAD_ORDER = add(base: BASE, 1)\n"
    src = src + "fixed pilot BAD_MISSING = add(base: BASE)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back BASE\n"
    src = src + "}\n"
    give back src
}

task v4_layout_query_diag_source() -> word {
    pilot src = "@layout(transparent)\n"
    src = src + "shape BrokenHandle {\n"
    src = src + "    left: std::ffi::c_int\n"
    src = src + "    right: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "@layout(C, packed=0)\n"
    src = src + "shape ZeroPacked {\n"
    src = src + "    value: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "@layout(packed=1)\n"
    src = src + "shape MissingC {\n"
    src = src + "    value: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_repr_query_diag_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_repr_query_diag_source() -> word {
    pilot src = "@repr(bytes)\n"
    src = src + "variant BadRepr {\n"
    src = src + "    A\n"
    src = src + "}\n"
    src = src + "@repr(u16)\n"
    src = src + "variant PayloadKind {\n"
    src = src + "    Data " + v4_repr_query_diag_braces(" value: int ") + "\n"
    src = src + "}\n"
    src = src + "@repr(u8)\n"
    src = src + "shape Nope {\n"
    src = src + "    value: std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "@repr(i16)\n"
    src = src + "variant BadExpr {\n"
    src = src + "    A = nope\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_query_diag_source() -> word {
    pilot src = "@layout(C)\n"
    src = src + "shape BadHeader {\n"
    src = src + "    text: word\n"
    src = src + "}\n"
    src = src + "@layout(C)\n"
    src = src + "shape BadPointer {\n"
    src = src + "    text: *const word\n"
    src = src + "}\n"
    src = src + "shape PlainVec {\n"
    src = src + "    x: int\n"
    src = src + "}\n"
    src = src + "variant PlainPaint {\n"
    src = src + "    Idle\n"
    src = src + "    Fire\n"
    src = src + "}\n"
    src = src + "@repr(u32)\n"
    src = src + "variant PayloadPaint {\n"
    src = src + "    Fire " + v4_diag_query_braces(" power: std::ffi::c_int ") + "\n"
    src = src + "}\n"
    src = src + "@layout(C)\n"
    src = src + "shape BadRouteFrame {\n"
    src = src + "    mode: PlainPaint\n"
    src = src + "}\n"
    src = src + "@layout(C)\n"
    src = src + "shape BadPayloadFrame {\n"
    src = src + "    mode: PayloadPaint\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task puts(text: word) -> int\n"
    src = src + "    task ship(header: BadHeader) -> void\n"
    src = src + "    task ok(text: *const tiny) -> std::ffi::c_int\n"
    src = src + "    task scan(text: *const word) -> std::ffi::c_int\n"
    src = src + "    task trace(points: *const PlainVec) -> std::ffi::c_int\n"
    src = src + "    task send(box: BadPointer) -> std::ffi::c_int\n"
    src = src + "    task tint(mode: PlainPaint) -> std::ffi::c_int\n"
    src = src + "    task current() -> PlainPaint\n"
    src = src + "    task payload(mode: PayloadPaint) -> std::ffi::c_int\n"
    src = src + "    task palette(modes: *const PlainPaint) -> std::ffi::c_int\n"
    src = src + "    task payloads(modes: *const PayloadPaint) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_link_query_diag_source() -> word {
    pilot src = "extern [C, link=msvcrt, link=\"kernel32\", fastcall, stdcall, mystery] {\n"
    src = src + "    @link_name(puts)\n"
    src = src + "    @link_name(\"puts_again\")\n"
    src = src + "    task bad_puts(text: *const tiny) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_variadic_query_diag_source() -> word {
    pilot src = "task local_sum(args: ...) -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task misplaced(args: ..., seed: std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "extern [stdcall] {\n"
    src = src + "    task win_sum(seed: std::ffi::c_int, args: ...) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_variadic_call_query_diag_source() -> word {
    pilot src = "extern [C] {\n"
    src = src + "    task trace(seed: std::ffi::c_int, args: ...) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot label = \"not ffi\"\n"
    src = src + "    give back trace(1, label)\n"
    src = src + "}\n"
    give back src
}

task v4_extern_callback_query_diag_source() -> word {
    pilot src = "@layout(C)\n"
    src = src + "shape BadTable {\n"
    src = src + "    on_tick: task(seed: int) -> int\n"
    src = src + "}\n"
    src = src + "shape PlainState {\n"
    src = src + "    code: int\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task plain(cb: task(seed: int) -> int) -> std::ffi::c_int\n"
    src = src + "    task mystery(cb: extern [mystery] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task texty(cb: extern [C] task(text: word) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task back() -> extern [C] task(seed: std::ffi::c_int) -> word\n"
    src = src + "    task misplaced(cb: extern [C] task(args: ..., seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task win_hook(cb: extern [stdcall] task(seed: std::ffi::c_int, args: ...) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task ptr_texty(cb: extern [C] task(text: *const word) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "    task ptr_state(cb: extern [C] task(state: *const PlainState) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_callback_call_query_diag_source() -> word {
    pilot src = "extern [C] {\n"
    src = src + "    task install(cb: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task bridge(seed: std::ffi::c_int) -> std::ffi::c_int {\n"
    src = src + "    give back seed\n"
    src = src + "}\n"
    src = src + "task run(cb: int, miss: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int, texty: extern [C] task(seed: std::ffi::c_int) -> std::ffi::c_int) -> int {\n"
    src = src + "    pilot first = cb(1)\n"
    src = src + "    pilot second = miss()\n"
    src = src + "    pilot third = texty(\"ace\")\n"
    src = src + "    pilot fourth = install(bridge)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_diag_query_source = "task main() -> int {\n"
v4_diag_query_source = v4_diag_query_source + "    pilot text = \"hi\"\n"
v4_diag_query_source = v4_diag_query_source + "    pilot bad = text - 1\n"
v4_diag_query_source = v4_diag_query_source + "    if 1 {\n"
v4_diag_query_source = v4_diag_query_source + "        pilot y = 0\n"
v4_diag_query_source = v4_diag_query_source + "    }\n"
v4_diag_query_source = v4_diag_query_source + "    text = 1\n"
v4_diag_query_source = v4_diag_query_source + "    give back 0\n"
v4_diag_query_source = v4_diag_query_source + "}\n"

pilot v4_diag_query_id = v4_diagnostics_text_cached("diag_query.fk", v4_diag_query_source)
