pilot v4_mir_when_pattern_pair_arm0_rvalue = v4_mir_stmt_rvalue(v4_mir_when_pattern_mir, v4_mir_when_pattern_pair_body, v4_mir_when_pattern_pair_arm0_stmt)
pilot v4_mir_when_pattern_pair_arm1_rvalue = v4_mir_stmt_rvalue(v4_mir_when_pattern_mir, v4_mir_when_pattern_pair_body, v4_mir_when_pattern_pair_arm1_stmt)
