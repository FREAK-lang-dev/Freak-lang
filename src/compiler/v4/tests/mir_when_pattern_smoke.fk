pilot v4_mir_when_pattern_row_arm_stmt = v4_mir_when_pattern_find_branch_stmt(v4_mir_when_pattern_mir, v4_mir_when_pattern_row_body, "row[0] == 1")
pilot v4_mir_when_pattern_row_arm_rvalue = v4_mir_stmt_rvalue(v4_mir_when_pattern_mir, v4_mir_when_pattern_row_body, v4_mir_when_pattern_row_arm_stmt)
