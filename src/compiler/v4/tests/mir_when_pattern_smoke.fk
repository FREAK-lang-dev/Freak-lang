-- V4 MIR when-pattern lowering smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_when_pattern_good_source() -> word {
    pilot src = "task pair_grade(pair: (int,int)) -> int {\n"
    src = src + "    when pair {\n"
    src = src + "        (7, bonus) -> give back bonus\n"
    src = src + "        (9, power) -> give back power\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task row_grade(row: [int;2]) -> int {\n"
    src = src + "    when row {\n"
    src = src + "        [1, right] -> give back right\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_when_pattern_bad_tuple_source() -> word {
    pilot src = "task bad(pair: int) -> int {\n"
    src = src + "    when pair {\n"
    src = src + "        (left, right) -> give back 1\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

