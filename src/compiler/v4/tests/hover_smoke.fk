-- V4 LSP-facing hover query smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_hover_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_hover_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_hover_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_hover_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_hover_source_text() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "    task boost(self, bonus: int) -> int {\n"
    src = src + "        give back self.rank + bonus\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_hover_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task util::math::double(value: int) -> int {\n"
    src = src + "    give back value + value\n"
    src = src + "}\n"
    src = src + "use util::math::*\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot " + v4_hover_braces(" rank: 7 ") + "\n"
    src = src + "    pilot event = Event::Key " + v4_hover_braces(" code: 9 ") + "\n"
    src = src + "    pilot doubled = double(2)\n"
    src = src + "    pilot power = ace.boost(bonus: 2)\n"
    src = src + "    give back ace.salute() + power + doubled + CELLS\n"
    src = src + "}\n"
    give back src
}

pilot v4_hover_source = v4_hover_source_text()
pilot v4_hover_stream = v4_lex_text(0, v4_hover_source)

pilot v4_hover_main = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "main", 0))
pilot v4_hover_body = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "ace", 1))
pilot v4_hover_method = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "salute", 1))
pilot v4_hover_variant = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "Event", 1))
pilot v4_hover_variant_case = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "Key", 1))
pilot v4_hover_param = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "bonus", 2))
pilot v4_hover_glob = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "double", 1))
pilot v4_hover_const = v4_hover_text_cached("hover.fk", v4_hover_source, v4_hover_token_offset(v4_hover_stream, "CELLS", 1))

say v4_hover_summary(v4_hover_main)
say "hover-name=" + v4_hover_name(v4_hover_main)
say "hover-kind=" + v4_hover_kind(v4_hover_main)
say "hover-type=" + v4_hover_type(v4_hover_main)
say "hover-markdown=" + v4_hover_markdown(v4_hover_main)
say "body-hover=" + v4_hover_summary(v4_hover_body)
say "method-hover-kind=" + v4_hover_kind(v4_hover_method)
say "method-hover-type=" + v4_hover_type(v4_hover_method)
say "variant-hover-kind=" + v4_hover_kind(v4_hover_variant)
say "variant-hover-type=" + v4_hover_type(v4_hover_variant)
say "variant-case-hover-kind=" + v4_hover_kind(v4_hover_variant_case)
say "variant-case-hover-type=" + v4_hover_type(v4_hover_variant_case)
say "param-hover-kind=" + v4_hover_kind(v4_hover_param)
say "param-hover-type=" + v4_hover_type(v4_hover_param)
say "glob-hover-kind=" + v4_hover_kind(v4_hover_glob)
say "glob-hover-type=" + v4_hover_type(v4_hover_glob)
say "const-hover-kind=" + v4_hover_kind(v4_hover_const)
say "const-hover-type=" + v4_hover_type(v4_hover_const)
