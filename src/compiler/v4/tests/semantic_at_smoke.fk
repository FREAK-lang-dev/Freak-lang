-- V4 position-indexed semantic query smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_semantic_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_semantic_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_semantic_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_semantic_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_semantic_source_text() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_semantic_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task util::math::double(value: int) -> int {\n"
    src = src + "    give back value + value\n"
    src = src + "}\n"
    src = src + "task util::math::triple(value: int) -> int {\n"
    src = src + "    give back value + value + value\n"
    src = src + "}\n"
    src = src + "task compose(host: word, port: int) -> int {\n"
    src = src + "    give back port\n"
    src = src + "}\n"
    src = src + "use util::math::*\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot " + v4_semantic_braces(" rank: 7 ") + "\n"
    src = src + "    pilot event = Event::Key " + v4_semantic_braces(" code: 9 ") + "\n"
    src = src + "    pilot tuned = compose(host: \"relay\", port: 9)\n"
    src = src + "    pilot doubled = double(2)\n"
    src = src + "    give back ace.salute() + tuned + doubled + CELLS\n"
    src = src + "}\n"
    give back src
}

pilot v4_sem_source = v4_semantic_source_text()
pilot v4_sem_stream = v4_lex_text(0, v4_sem_source)

pilot v4_sem_main_fact = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "main", 0))
pilot v4_sem_body_fact = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "ace", 1))
pilot v4_sem_method_decl = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "salute", 0))
pilot v4_sem_method_use = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "salute", 1))
pilot v4_sem_variant = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "Event", 1))
pilot v4_sem_variant_case = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "Key", 1))
pilot v4_sem_param = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "host", 1))
pilot v4_sem_glob = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "double", 1))
pilot v4_sem_const = v4_semantic_at_text_cached("semantic_at.fk", v4_sem_source, v4_semantic_token_offset(v4_sem_stream, "CELLS", 1))

say v4_semantic_at_summary(v4_sem_main_fact)
say "semantic-main-name=" + v4_semantic_at_name(v4_sem_main_fact)
say "semantic-main-kind=" + v4_semantic_at_kind(v4_sem_main_fact)
say "semantic-main-type=" + v4_semantic_at_type(v4_sem_main_fact)
say "semantic-body-token=" + v4_semantic_at_token_value(v4_sem_body_fact)
say "semantic-body-item=" + v4_semantic_at_item_name(v4_sem_body_fact)
say "semantic-body-item-kind=" + v4_semantic_at_item_kind(v4_sem_body_fact)
say "semantic-method-decl-kind=" + v4_semantic_at_kind(v4_sem_method_decl)
say "semantic-method-decl-type=" + v4_semantic_at_type(v4_sem_method_decl)
say "semantic-method-use-kind=" + v4_semantic_at_kind(v4_sem_method_use)
say "semantic-method-use-type=" + v4_semantic_at_type(v4_sem_method_use)
say "semantic-variant-kind=" + v4_semantic_at_kind(v4_sem_variant)
say "semantic-variant-type=" + v4_semantic_at_type(v4_sem_variant)
say "semantic-variant-case-kind=" + v4_semantic_at_kind(v4_sem_variant_case)
say "semantic-variant-case-type=" + v4_semantic_at_type(v4_sem_variant_case)
say "semantic-param-kind=" + v4_semantic_at_kind(v4_sem_param)
say "semantic-param-type=" + v4_semantic_at_type(v4_sem_param)
say "semantic-glob-kind=" + v4_semantic_at_kind(v4_sem_glob)
say "semantic-glob-type=" + v4_semantic_at_type(v4_sem_glob)
say "semantic-const-kind=" + v4_semantic_at_kind(v4_sem_const)
say "semantic-const-type=" + v4_semantic_at_type(v4_sem_const)
