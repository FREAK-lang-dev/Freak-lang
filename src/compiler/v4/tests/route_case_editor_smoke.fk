-- V4 route-case editor facts smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_route_case_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_route_case_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_route_case_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_route_case_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_route_case_editor_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_route_case_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_route_case_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_route_case_editor_source_text() -> word {
    pilot src = "variant Event {\n"
    src = src + "    Key " + v4_route_case_editor_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task make() -> Event {\n"
    src = src + "    give back Event::Key " + v4_route_case_editor_braces(" code: 7, repeat: false ") + "\n"
    src = src + "}\n"
    src = src + "task score(event: Event) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Event::Key " + v4_route_case_editor_braces(" code ") + " -> give back code\n"
    src = src + "        Event::Closed -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_route_case_editor_source = v4_route_case_editor_source_text()
pilot v4_route_case_editor_stream = v4_lex_text(0, v4_route_case_editor_source)

pilot v4_route_case_editor_decl_offset = v4_route_case_editor_token_offset(v4_route_case_editor_stream, "Key", 0)
pilot v4_route_case_editor_ctor_offset = v4_route_case_editor_token_offset(v4_route_case_editor_stream, "Key", 1)
pilot v4_route_case_editor_when_offset = v4_route_case_editor_token_offset(v4_route_case_editor_stream, "Key", 2)

pilot v4_route_case_editor_decl_sem = v4_semantic_at_text_cached("route-case-editor.fk", v4_route_case_editor_source, v4_route_case_editor_decl_offset)
pilot v4_route_case_editor_ctor_sem = v4_semantic_at_text_cached("route-case-editor.fk", v4_route_case_editor_source, v4_route_case_editor_ctor_offset)
pilot v4_route_case_editor_when_sem = v4_semantic_at_text_cached("route-case-editor.fk", v4_route_case_editor_source, v4_route_case_editor_when_offset)
pilot v4_route_case_editor_hover = v4_hover_text_cached("route-case-editor.fk", v4_route_case_editor_source, v4_route_case_editor_when_offset)
pilot v4_route_case_editor_definition = v4_definition_at_text_cached("route-case-editor.fk", v4_route_case_editor_source, v4_route_case_editor_when_offset)
pilot v4_route_case_editor_symbols = v4_document_symbols_text_cached("route-case-editor.fk", v4_route_case_editor_source)
pilot v4_route_case_editor_completion = v4_completion_text_cached("route-case-editor.fk", v4_route_case_editor_source, v4_route_case_editor_when_offset)

pilot v4_route_case_editor_key_completion = v4_route_case_editor_find_completion_label(v4_route_case_editor_completion, "Event::Key")
pilot v4_route_case_editor_closed_completion = v4_route_case_editor_find_completion_label(v4_route_case_editor_completion, "Event::Closed")

say "route-case-decl-kind=" + v4_semantic_at_kind(v4_route_case_editor_decl_sem)
say "route-case-decl-type=" + v4_semantic_at_type(v4_route_case_editor_decl_sem)
say "route-case-ctor-kind=" + v4_semantic_at_kind(v4_route_case_editor_ctor_sem)
say "route-case-ctor-type=" + v4_semantic_at_type(v4_route_case_editor_ctor_sem)
say "route-case-when-name=" + v4_semantic_at_name(v4_route_case_editor_when_sem)
say "route-case-when-kind=" + v4_semantic_at_kind(v4_route_case_editor_when_sem)
say "route-case-when-type=" + v4_semantic_at_type(v4_route_case_editor_when_sem)
say "route-case-hover-name=" + v4_hover_name(v4_route_case_editor_hover)
say "route-case-hover-kind=" + v4_hover_kind(v4_route_case_editor_hover)
say "route-case-hover-type=" + v4_hover_type(v4_route_case_editor_hover)
say "route-case-definition-kind=" + v4_definition_at_kind(v4_route_case_editor_definition)
say "route-case-definition-found=" + word_from_int(v4_definition_at_found(v4_route_case_editor_definition))
say "route-case-definition-matches-decl=" + v4_route_case_editor_bool_word(v4_span_start(v4_definition_at_span(v4_route_case_editor_definition)) == v4_route_case_editor_decl_offset)
say "route-case-symbol-count=" + word_from_int(v4_document_symbol_count(v4_route_case_editor_symbols))
say "route-case-symbol0-name=" + v4_document_symbol_name(v4_route_case_editor_symbols, 0)
say "route-case-symbol0-kind=" + v4_document_symbol_kind(v4_route_case_editor_symbols, 0)
say "route-case-symbol1-name=" + v4_document_symbol_name(v4_route_case_editor_symbols, 1)
say "route-case-symbol1-kind=" + v4_document_symbol_kind(v4_route_case_editor_symbols, 1)
say "route-case-symbol1-type=" + v4_document_symbol_type(v4_route_case_editor_symbols, 1)
say "route-case-symbol2-name=" + v4_document_symbol_name(v4_route_case_editor_symbols, 2)
say "route-case-symbol2-kind=" + v4_document_symbol_kind(v4_route_case_editor_symbols, 2)
say "route-case-symbol2-type=" + v4_document_symbol_type(v4_route_case_editor_symbols, 2)
say "route-case-completion-count=" + word_from_int(v4_completion_count(v4_route_case_editor_completion))
say "route-case-completion-key-found=" + v4_route_case_editor_bool_word(v4_route_case_editor_key_completion >= 0)
say "route-case-completion-key-detail=" + v4_route_case_editor_completion_detail_or_empty(v4_route_case_editor_completion, v4_route_case_editor_key_completion)
say "route-case-completion-closed-found=" + v4_route_case_editor_bool_word(v4_route_case_editor_closed_completion >= 0)
say "route-case-completion-closed-detail=" + v4_route_case_editor_completion_detail_or_empty(v4_route_case_editor_completion, v4_route_case_editor_closed_completion)
