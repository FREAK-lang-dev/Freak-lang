-- Completed inner observers release their own loans; outer arguments retain them.
task v4_call_lifetime_assert(condition: bool, label: word) -> void {
    if not condition { panic("call-lifetime " + label) }
}
task v4_call_lifetime_named(borrow: int, message: word) -> bool {
    pilot row = 0
    repeat until row >= v4_borrowck_diag_count(borrow) {
        if v4_diag_message(v4_borrowck_diag(borrow, row)) == message { give back true }
        row += 1
    }
    give back false
}
task v4_call_lifetime_find(mir: int, body: int, name: word) -> int {
    pilot row = 0
    repeat until row >= v4_mir_body_rvalue_count(mir, body) {
        if v4_mir_rvalue_kind(mir, body, row) == v4_mir_rvalue_call and v4_mir_rvalue_op(mir, body, row) == name { give back row }
        row += 1
    }
    give back -1
}
task v4_call_lifetime_run() -> void {
    pilot mode = process::arg(1)
    pilot raw: bool = mode.starts_with("raw-")
    pilot helpers = "task consume(value: word) -> int " + chr(123) + " give back 1 " + chr(125) + "\n"
    helpers = helpers + "task sum(first: int, second: int) -> int " + chr(123) + " give back first + second " + chr(125) + "\n"
    helpers = helpers + "task observe(lend source: word, count: int) -> int " + chr(123) + " give back source.length() + count " + chr(125) + "\n"
    pilot expression = "sum(observe(lend text, 1), consume(text))"
    pilot statements = "pilot mut text = \"owned\"; give back " + expression
    pilot message = ""
    if mode == "1" { statements = "pilot text = \"owned\"; give back sum(text.length(), consume(text))" }
    if mode == "2" {
        helpers = helpers + "task marker(lend source: word, ch: char) -> int " + chr(123) + " give back source.length() " + chr(125) + "\n"
        statements = "pilot text = \"owned\"; give back sum(marker(lend text, 'a'), consume(text))"
    }
    if mode == "3" or mode == "5" or mode == "9" {
        helpers = helpers + "task outer(lend view: word, next: int) -> int " + chr(123) + " give back next " + chr(125) + "\n"
        statements = "pilot text = \"owned\"; give back outer(lend text, consume(text))"
        message = "Meiya refuses this move while the value is borrowed"
        if mode == "5" { statements = "pilot text = \"owned\"; give back outer(next: consume(text), view: lend text)" }
        if mode == "9" {
            helpers = helpers + "task share(lend source: word) -> lend word " + chr(123) + " give back lend source " + chr(125) + "\n"
            statements = "pilot text = \"owned\"; give back outer(share(lend text), consume(text))"
        }
    }
    if mode == "4" {
        helpers = helpers + "task mixed(lend view: word, observed: int, next: int) -> int " + chr(123) + " give back observed + next " + chr(125) + "\n"
        statements = "pilot text = \"owned\"; give back mixed(lend text, observe(lend text, 1), consume(text))"
        message = "Meiya refuses this move while the value is borrowed"
    }
    if mode == "6" {
        statements = "pilot text = \"owned\"; give back sum(consume(text), observe(lend text, 1))"
        message = "Meiya refuses a use of an unavailable word binding"
    }
    if mode == "7" {
        helpers = helpers + "task exclusive(lend mut first: word, lend second: word) -> int " + chr(123) + " give back 0 " + chr(125) + "\n"
        statements = "pilot mut text = \"owned\"; give back exclusive(lend mut text, lend text)"
        message = "Meiya refuses overlapping mutable lends"
    }
    if mode == "8" {
        helpers = helpers + "task peek(lend mut edit: word, observed: int) -> int " + chr(123) + " give back observed " + chr(125) + "\n"
        statements = "pilot mut text = \"owned\"; give back peek(lend mut text, text.length())"
        message = "Meiya refuses observation through an exclusive lend"
    }
    if mode == "10" {
        helpers = helpers + "task share(lend source: word) -> lend word " + chr(123) + " give back lend source " + chr(125) + "\n"
        statements = "pilot text = \"owned\"; pilot view = share(lend text); consume(text); give back observe(view, 1)"
        message = "Meiya refuses this move while the value is borrowed"
    }
    if mode == "11" {
        helpers = helpers + "task generic<T>(lend source: word, sample: T) -> int " + chr(123) + " give back source.length() " + chr(125) + "\n"
        statements = "pilot text = \"owned\"; give back sum(generic(lend text, 1), consume(text))"
        message = "Meiya refuses this move while the value is borrowed"
    }
    if mode == "12" {
        helpers = helpers + "task fresh(lend source: word) -> word " + chr(123) + " give back source.clone() " + chr(125) + "\n"
        statements = "pilot text = \"owned\"; give back sum(fresh(lend text).length(), consume(text))"
    }
    if raw or mode == "bounds" { statements = "pilot mut text = \"owned\"; pilot count: int = 1; give back sum(observe(lend text, -count), consume(text))" }
    if mode == "raw-scalar-facade" { statements = "give back 1" }
    pilot source = helpers + "task main() -> int " + chr(123) + " " + statements + " " + chr(125) + "\n"
    pilot mir = v4_mir_text_cached("word-call-lifetime.fk", source)
    v4_call_lifetime_assert(v4_ty_diag_count(v4_mir_ty_id(mir)) == 0 and v4_mir_diag_count(mir) == 0 and v4_mir_word_plan_preflight(mir) == "", "clean frontend and typed identities")
    pilot body = v4_mir_lookup_body_name(mir, "main")
    pilot local = v4_mir_find_local(mir, body, "text")
    pilot call = v4_call_lifetime_find(mir, body, "observe")
    pilot target = v4_target_spec_new("x86_64-unknown-linux-gnu")
    if raw or mode == "bounds" {
        pilot sealed = v4_codegen_llvm_lower_owned_mir(0, mir)
        pilot module: word = v4_codegen_llvm_module_text(sealed, target)
        v4_call_lifetime_assert(v4_codegen_llvm_native_module_error(sealed) == "" and module != "", "baseline seals with completed observer")
        pilot baseline = v4_mir_snapshot()
        if mode == "bounds" {
            pilot root = v4_call_lifetime_find(mir, body, "sum")
            v4_call_lifetime_assert(root >= 0 and call >= 0 and v4_borrowck_empty_scalar_call_status(mir, body, call) == 1 and v4_borrowck_call_return_lend_leaf_count(mir, body, call) == 0, "checked ordinary observer has empty returned source")
            v4_borrowck_word_plan_visit_budget = 0
            v4_call_lifetime_assert(v4_borrowck_word_loan_rvalue_state(mir, body, root, local, false, false, 0) == -1, "exhausted work cannot certify completion")
            v4_borrowck_word_plan_visit_budget = 8192
            v4_call_lifetime_assert(v4_borrowck_word_loan_rvalue_state(mir, body, root, local, false, false, 257) == -1, "depth cannot certify completion")
            v4_borrowck_word_plan_visit_budget = 8192
            v4_call_lifetime_assert(v4_borrowck_word_loan_rvalue_state(mir, body, -2, local, false, false, 0) == -1, "malformed negative rvalue cannot certify completion")
            v4_borrowck_word_plan_visit_budget = 8192
            v4_call_lifetime_assert(v4_borrowck_word_loan_place_state(mir, body, -1, local, false, false, 0) == -1, "absent place cannot certify completion")
            v4_borrowck_word_plan_visit_budget = 8192
            v4_call_lifetime_assert(v4_borrowck_word_loan_rvalue_state(mir, body, root, local, false, false, 0) == 0, "fresh work restores completed observer proof")
            say "call-lifetime case=bounds bounded=true fail-closed=true recovery=true"
            give back
        }
        pilot first = v4_mir_rvalue_call_arg(mir, body, call, 0)
        pilot second = v4_mir_rvalue_call_arg(mir, body, call, 1)
        if mode == "raw-arity" { v4_mir_set_rvalue_args_payload(mir, body, call, "") } else if mode == "raw-extra" { v4_mir_set_rvalue_args_payload(mir, body, call, word_from_int(first) + "," + word_from_int(second) + "," + word_from_int(second)) } else if mode == "raw-reordered" { v4_mir_set_rvalue_args_payload(mir, body, call, word_from_int(second) + "," + word_from_int(first)) } else if mode == "raw-abi" { v4_mir_set_rvalue_abi(mir, body, call, "C") } else if mode == "raw-result" { v4_mir_set_rvalue_ty(mir, body, call, v4_ty_bool) } else if mode == "raw-mode" { array_set(v4_mir_body_rvalue_kinds_handle(mir, body), first, v4_mir_rvalue_lend_mut) } else if mode == "raw-id" { array_set(v4_mir_body_rvalue_ops_handle(mir, body), v4_mir_rvalue_lhs(mir, body, first), "local#999") } else if mode == "raw-symbol" { array_set(v4_mir_body_rvalue_ops_handle(mir, body), call, "forged_observer") } else if mode == "raw-header" {
            pilot callee = v4_mir_lookup_body_name(mir, "observe")
            array_set(v4_mir_sigs_handle(mir), callee, "task observe(lend source: word, count: int) -> bool")
        } else if mode == "raw-unknown" {
            pilot count_local = v4_mir_find_local(mir, body, "count")
            pilot child = v4_mir_rvalue_lhs(mir, body, second)
            v4_call_lifetime_assert(v4_mir_rvalue_kind(mir, body, second) == v4_mir_rvalue_unary and v4_mir_rvalue_local_id(mir, body, child) == count_local, "unknown mutation targets hidden known-typed wrapper leaf")
            array_set(v4_mir_body_local_tys_handle(mir, body), count_local, v4_ty_unknown)
            v4_mir_set_rvalue_ty(mir, body, child, v4_ty_unknown)
            v4_borrowck_word_plan_visit_budget = 8192
            v4_call_lifetime_assert(v4_borrowck_word_loan_rvalue_state(mir, body, second, local, false, false, 0) == -1, "unknown leaf cannot certify completion through known wrapper")
        } else if mode == "raw-cycle" {
            v4_mir_set_rvalue_args_payload(mir, body, call, word_from_int(call) + "," + word_from_int(second))
        } else if mode == "raw-sentinel" { v4_mir_set_rvalue_children(mir, body, call, -2, -1) } else if mode == "raw-scalar-facade" {
            call = v4_mir_stmt_rvalue(mir, body, 0)
            v4_call_lifetime_assert(v4_mir_body_local_count(mir, body) == 0 and v4_mir_rvalue_kind(mir, body, call) == v4_mir_rvalue_const_int, "scalar caller has no Word node or local before forgery")
            array_set(v4_mir_body_rvalue_kinds_handle(mir, body), call, v4_mir_rvalue_call)
            array_set(v4_mir_body_rvalue_ops_handle(mir, body), call, "observe")
        } else { panic("call-lifetime unknown raw case") }
        pilot forged = v4_mir_snapshot()
        v4_call_lifetime_assert(forged != baseline and (v4_borrowck_empty_scalar_call_status(mir, body, call) != 1 or mode == "raw-unknown"), "setup really changed and cannot certify malformed ordinary facade")
        -- Raw restore may reject an invalid shape or preserve a shape whose
        -- semantic argument contract Meiya checks. Both outcomes stay explicit.
        pilot restore = v4_mir_snapshot_restore(forged)
        v4_call_lifetime_assert(restore.starts_with("mir-snapshot-restore ok=0") or restore.starts_with("mir-snapshot-restore ok=1"), "raw restore has explicit outcome")
        if restore.starts_with("mir-snapshot-restore ok=0") { v4_call_lifetime_assert(v4_mir_snapshot() == forged, "rejected raw restore is atomic") }
        pilot expected_message = v4_mir_word_plan_preflight(mir)
        if expected_message == "" { expected_message = v4_mir_control_plan_preflight(mir) }
        if expected_message == "" {
            expected_message = "Meiya refuses this move while the value is borrowed"
            if v4_borrowck_empty_scalar_call_status(mir, body, call) == 0 { expected_message = "Meiya cannot validate this no-lend scalar call contract" }
        }
        pilot checked = v4_borrowck_check_mir(0, mir)
        pilot failed_outcome = v4_borrowck_lookup_result(checked, v4_mir_body_def(mir, body))
        v4_call_lifetime_assert(v4_call_lifetime_named(checked, expected_message) and v4_borrowck_result_status(checked, failed_outcome) == v4_borrowck_blocked, "fresh Meiya emits exact preflight, malformed facade or retained-loan rejection")
        pilot rejected = v4_codegen_llvm_lower_owned_mir(0, mir)
        v4_call_lifetime_assert(v4_codegen_llvm_native_module_error(rejected) != "" and v4_codegen_llvm_module_text(rejected, target) == "" and v4_codegen_llvm_module_text(sealed, target) == module, "fresh malformed plan cannot seal and old plan is stable")
        if mode == "raw-arity" or mode == "raw-extra" or mode == "raw-reordered" or mode == "raw-abi" or mode == "raw-result" or mode == "raw-header" or mode == "raw-scalar-facade" {
            v4_call_lifetime_assert(v4_call_lifetime_named(checked, "Meiya cannot validate this no-lend scalar call contract"), "exact malformed ordinary facade diagnostic")
        }
        v4_call_lifetime_assert(v4_mir_snapshot_restore(baseline).starts_with("mir-snapshot-restore ok=1"), "baseline restore after malformed call")
        pilot recovered = v4_codegen_llvm_lower_owned_mir(0, mir)
        v4_call_lifetime_assert(v4_codegen_llvm_native_module_error(recovered) == "" and v4_codegen_llvm_module_text(recovered, target) == module and v4_codegen_llvm_module_text(sealed, target) == module, "fresh recovery and preserved seal exact")
        say "call-lifetime case=" + mode + " setup=true named-rejected=true no-module=true restore=true old-seal=true recovery=true"
        give back
    }
    pilot checked = v4_borrowck_check_mir(0, mir)
    pilot outcome = v4_borrowck_lookup_result(checked, v4_mir_body_def(mir, body))
    if message != "" {
        v4_call_lifetime_assert(v4_call_lifetime_named(checked, message) and v4_borrowck_result_status(checked, outcome) == v4_borrowck_blocked, "exact retained loan or unavailable binding diagnostic")
        pilot rejected = v4_codegen_llvm_lower_owned_mir(0, mir)
        v4_call_lifetime_assert(v4_codegen_llvm_native_module_error(rejected) != "" and v4_codegen_llvm_module_text(rejected, target) == "", "retained loan cannot seal")
        say "call-lifetime case=" + mode + " named-rejected=true no-module=true"
    } else {
        v4_call_lifetime_assert(v4_borrowck_diag_count(checked) == 0 and v4_borrowck_result_status(checked, outcome) == v4_borrowck_clean, "completed observer loan ends before move")
        pilot admitted = v4_codegen_llvm_lower_owned_mir(0, mir)
        v4_call_lifetime_assert(v4_codegen_llvm_native_module_error(admitted) == "" and v4_codegen_llvm_module_text(admitted, target) != "", "completed observer seals")
        say "call-lifetime case=" + mode + " completed=true clean=true sealed=true"
    }
}
v4_call_lifetime_run()
