-- Failed optional Lex boundary registry publication must allocate nothing.
-- Verification prepends V4 crates; run with 1024 live array handles.

task v4_lex_publication_available_handles() -> int {
    pilot holders = array_new()
    pilot count = 0
    pilot exhausted = false
    repeat until exhausted or count >= 2048 {
        pilot handle = array_new()
        if handle < 0 { exhausted = true } else {
            array_push(holders, word_from_int(handle))
            count += 1
        }
    }
    pilot idx = 0
    repeat until idx >= array_len(holders) {
        array_release(word_to_int(array_get(holders, idx)))
        idx += 1
    }
    array_release(holders)
    give back count
}

task v4_lex_publication_pressure_run() -> void {
    pilot holders = array_new()
    pilot count = 0
    pilot exhausted = false
    repeat until exhausted or count >= 2048 {
        pilot handle = array_new()
        if handle < 0 { exhausted = true } else {
            array_push(holders, word_from_int(handle))
            count += 1
        }
    }
    -- Seven free slots retain authoritative Lex metadata. Both optional
    -- boundary and revision outer arrays must fail during initialization.
    pilot idx = count - 7
    repeat until idx >= count {
        array_release(word_to_int(array_get(holders, idx)))
        array_set(holders, idx, "-1")
        idx += 1
    }
    v4_lex_init()
    pilot authoritative: bool = v4_lex_stream_files >= 0 and v4_lex_stream_types >= 0 and v4_lex_stream_values >= 0 and v4_lex_stream_spans >= 0 and v4_lex_stream_lines >= 0 and v4_lex_stream_cols >= 0 and v4_lex_stream_diags >= 0
    say "lex-publication-outer-storage-exhausted=" + word_from_bool(exhausted and v4_lex_ready == 1 and authoritative and v4_lex_stream_boundaries < 0 and v4_lex_stream_revisions < 0)
    idx = 0
    repeat until idx >= array_len(holders) {
        array_release(word_to_int(array_get(holders, idx)))
        idx += 1
    }
    array_release(holders)
    pilot stream = v4_lex_stream_new(0)
    pilot empty_snapshot = v4_lex_snapshot()
    pilot available = v4_lex_publication_available_handles()
    pilot denied = true
    idx = 0
    repeat until idx >= 32 {
        if v4_lex_rebuild_boundaries(stream) { denied = false }
        idx += 1
    }
    say "lex-publication-empty-fails-without-allocation=" + word_from_bool(denied and available > 0 and available < 2048 and v4_lex_publication_available_handles() == available and v4_lex_snapshot() == empty_snapshot and v4_lex_boundaries_handle(stream) < 0)
    v4_lex_add_token(stream, v4_tok_ident, "first", v4_span_new("0", 0, 5), 0, 0)
    v4_lex_add_token(stream, v4_tok_ident, "second", v4_span_new("0", 10, 20), 0, 10)
    pilot token_snapshot = v4_lex_snapshot()
    idx = 0
    repeat until idx >= 32 {
        if v4_lex_rebuild_boundaries(stream) { denied = false }
        idx += 1
    }
    pilot original: bool = v4_lex_token_count(stream) == 2 and v4_lex_first_boundary(stream, 15, false) == 2 and v4_lex_first_boundary(stream, 15, true) == 1
    say "lex-publication-nonempty-fails-without-allocation=" + word_from_bool(denied and original and v4_lex_publication_available_handles() == available and v4_lex_snapshot() == token_snapshot and v4_lex_boundaries_handle(stream) < 0)
    array_set(v4_lex_spans_handle(stream), 0, v4_span_new("0", 16, 18))
    v4_lex_note_stream_mutation(stream)
    pilot mutated_snapshot = v4_lex_snapshot()
    pilot cold: bool = v4_lex_boundaries_handle(stream) < 0 and v4_lex_first_boundary(stream, 15, false) == 0 and v4_lex_first_boundary(stream, 15, true) == 0
    say "lex-publication-raw-mutation-cold-correct=" + word_from_bool(cold and v4_lex_token_count(stream) == 2 and v4_lex_stream_revision(stream) == 0 - 1)
    idx = 0
    repeat until idx >= 32 {
        if v4_lex_rebuild_boundaries(stream) { denied = false }
        idx += 1
    }
    say "lex-publication-repeated-denial-stable=" + word_from_bool(denied and v4_lex_publication_available_handles() == available and v4_lex_snapshot() == mutated_snapshot and v4_lex_first_boundary(stream, 15, false) == 0 and v4_lex_first_boundary(stream, 15, true) == 0)
}

v4_lex_publication_pressure_run()
