-- Scalar HIR numeric readers preserve raw field framing and canonical parsing.
-- The reference retains the original field_raw + number/bounded-id pipeline.

task v4_hir_scalar_field_equivalent(line: word, wanted: int) -> bool {
    pilot raw = v4_hir_snapshot_field_raw(line, wanted)
    pilot expected = -1
    if v4_hir_snapshot_nonnegative_int_is_valid(raw) {
        expected = v4_nonnegative_int_range(raw, 0, raw.length())
    }
    if v4_hir_snapshot_nonnegative_field(line, wanted) != expected { give back false }
    pilot limit = -1
    repeat until limit > 20 {
        if v4_hir_snapshot_bounded_field_id(line, wanted, limit) != v4_hir_snapshot_bounded_id(raw, limit) { give back false }
        limit += 1
    }
    if v4_hir_snapshot_bounded_field_id(line, wanted, 9223372036854775807) != v4_hir_snapshot_bounded_id(raw, 9223372036854775807) { give back false }
    give back true
}

task v4_hir_scalar_line_equivalent(line: word) -> bool {
    pilot wanted = -2
    repeat until wanted > 7 {
        if not v4_hir_scalar_field_equivalent(line, wanted) { give back false }
        wanted += 1
    }
    give back true
}

task v4_hir_scalar_span_file_equivalent(span: word, source_file: word) -> bool {
    pilot expected: bool = v4_span_file(span) == source_file
    give back v4_hir_snapshot_span_file_equals(span, source_file) == expected
}

task v4_hir_scalar_span_files_equivalent(prefix: word) -> bool {
    pilot spans = array_new()
    array_push(spans, prefix)
    array_push(spans, prefix + "@0:1")
    array_push(spans, prefix + "@")
    array_push(spans, prefix + "@bad@0:1")
    array_push(spans, prefix + "@" + chr(0))
    array_push(spans, "@" + prefix)
    array_push(spans, prefix + chr(0) + "@0:1")
    array_push(spans, prefix + "x@0:1")
    pilot equivalent = true
    pilot index = 0
    repeat until index >= array_len(spans) {
        pilot span: word = array_get(spans, index)
        if not v4_hir_scalar_span_file_equivalent(span, prefix) { equivalent = false }
        if not v4_hir_scalar_span_file_equivalent(span, prefix + "x") { equivalent = false }
        if not v4_hir_scalar_span_file_equivalent(span, prefix + chr(0)) { equivalent = false }
        if not v4_hir_scalar_span_file_equivalent(span, "") { equivalent = false }
        if not v4_hir_scalar_span_file_equivalent(span, V4_NO_FILE) { equivalent = false }
        index += 1
    }
    array_release(spans)
    give back equivalent
}

task v4_hir_scalar_fields_run() -> void {
    pilot ready_before = v4_hir_ready
    pilot files_before = v4_hir_file_len
    pilot files_handle_before = v4_hir_files
    pilot revision_handle_before = v4_hir_revisions
    pilot generations_before = v4_session_semantic_restore_generation()
    pilot lambda_word = chr(955)
    pilot snow_word = chr(38634)
    pilot emoji_word = chr(128512)
    pilot acute_word = chr(233)
    pilot values = array_new()
    array_push(values, "")
    array_push(values, "0")
    array_push(values, "00")
    array_push(values, "01")
    array_push(values, "1")
    array_push(values, "9")
    array_push(values, "10")
    array_push(values, "19")
    array_push(values, "20")
    array_push(values, "511")
    array_push(values, "512")
    array_push(values, "-1")
    array_push(values, "+1")
    array_push(values, " 1")
    array_push(values, "1 ")
    array_push(values, "1x")
    array_push(values, "1.0")
    array_push(values, "1\r")
    array_push(values, "1\n")
    array_push(values, "1\t")
    array_push(values, "%31")
    array_push(values, "1%30")
    array_push(values, "%7C")
    array_push(values, "1|2")
    array_push(values, "0||10")
    array_push(values, "9223372036854775807")
    array_push(values, "9223372036854775808")
    array_push(values, "18446744073709551616")
    array_push(values, chr(1633) + chr(1634))
    array_push(values, chr(65297) + chr(65298))
    array_push(values, chr(128512))
    array_push(values, "123456789012345678901234567890")
    array_push(values, chr(0))
    array_push(values, "1" + chr(0))
    array_push(values, "1" + chr(0) + "2")
    pilot framing_ok = true
    pilot utf8_ok = true
    pilot index = 0
    repeat until index >= array_len(values) {
        pilot raw: word = array_get(values, index)
        if not v4_hir_scalar_line_equivalent(raw) { framing_ok = false }
        if not v4_hir_scalar_line_equivalent("kind|" + raw) { framing_ok = false }
        if not v4_hir_scalar_line_equivalent("kind||" + raw + "|tail") { framing_ok = false }
        if not v4_hir_scalar_line_equivalent("kind|%7C|" + raw + "|") { framing_ok = false }
        if not v4_hir_scalar_line_equivalent("kind\nname|" + raw + "\r") { framing_ok = false }
        if not v4_hir_scalar_line_equivalent("kind|" + raw + "||") { framing_ok = false }
        if not v4_hir_scalar_line_equivalent(lambda_word + "|" + snow_word + "|" + raw + "|" + emoji_word) { utf8_ok = false }
        if not v4_hir_scalar_line_equivalent(emoji_word + "|" + raw + "|" + acute_word + "|19") { utf8_ok = false }
        if not v4_hir_scalar_span_files_equivalent(raw) { framing_ok = false }
        index += 1
    }
    if not v4_hir_scalar_span_files_equivalent(lambda_word + snow_word + emoji_word) { utf8_ok = false }
    if not v4_hir_scalar_span_files_equivalent(lambda_word + chr(0) + snow_word) { utf8_ok = false }
    array_release(values)
    -- These exact expected values additionally fix byte/character framing:
    -- selected numbers follow 2-, 3-, and 4-byte UTF-8 fields respectively.
    pilot unicode = lambda_word + "|12|" + snow_word + "|19|" + emoji_word + "|511"
    if v4_hir_snapshot_nonnegative_field(unicode, 1) != 12 or v4_hir_snapshot_nonnegative_field(unicode, 3) != 19 or v4_hir_snapshot_nonnegative_field(unicode, 5) != 511 { utf8_ok = false }
    pilot boundaries_ok = v4_hir_snapshot_nonnegative_field("", 0) == -1 and v4_hir_snapshot_nonnegative_field("0|", 0) == 0 and v4_hir_snapshot_nonnegative_field("0|", 1) == -1 and v4_hir_snapshot_nonnegative_field("0|", 2) == -1
    boundaries_ok = boundaries_ok and v4_hir_snapshot_nonnegative_field("kind|9223372036854775807", 1) == 9223372036854775807 and v4_hir_snapshot_nonnegative_field("kind|9223372036854775808", 1) == -1
    boundaries_ok = boundaries_ok and v4_hir_snapshot_bounded_field_id("kind|19", 1, 19) == -1 and v4_hir_snapshot_bounded_field_id("kind|19", 1, 20) == 19 and v4_hir_snapshot_bounded_field_id("kind|9223372036854775807", 1, 9223372036854775807) == -1
    -- Independent fixed expectations reject wrong delimiter/fallback/length
    -- contracts even when reference and candidate might share a framing bug.
    boundaries_ok = boundaries_ok and v4_hir_snapshot_span_file_equals("@garbage", "") and v4_hir_snapshot_span_file_equals("plain", V4_NO_FILE) and not v4_hir_snapshot_span_file_equals("plain", "plain")
    boundaries_ok = boundaries_ok and v4_hir_snapshot_span_file_equals("1@2@3", "1") and not v4_hir_snapshot_span_file_equals("1@2@3", "1@2") and not v4_hir_snapshot_span_file_equals("1@0:1", "1x")
    boundaries_ok = boundaries_ok and v4_hir_snapshot_span_file_equals("%31@bad", "%31") and not v4_hir_snapshot_span_file_equals("%31@bad", "1")
    boundaries_ok = boundaries_ok and v4_hir_snapshot_span_file_equals("1" + chr(0) + "@bad", "1" + chr(0)) and not v4_hir_snapshot_span_file_equals("1" + chr(0) + "@bad", "1") and not v4_hir_snapshot_span_file_equals("1@bad", "1" + chr(0))
    utf8_ok = utf8_ok and v4_hir_snapshot_span_file_equals(lambda_word + snow_word + emoji_word + "@bad", lambda_word + snow_word + emoji_word) and not v4_hir_snapshot_span_file_equals(lambda_word + "@0:1", snow_word)
    pilot state_ok = ready_before == v4_hir_ready and files_before == v4_hir_file_len and files_handle_before == v4_hir_files and revision_handle_before == v4_hir_revisions and generations_before == v4_session_semantic_restore_generation()
    say "hir-scalar-fields-framing-equivalence=" + word_from_bool(framing_ok)
    say "hir-scalar-fields-utf8-byte-framing=" + word_from_bool(utf8_ok)
    say "hir-scalar-fields-boundaries=" + word_from_bool(boundaries_ok)
    say "hir-scalar-fields-state-unchanged=" + word_from_bool(state_ok)
}

v4_hir_scalar_fields_run()
