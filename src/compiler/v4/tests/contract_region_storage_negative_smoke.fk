-- V4 contract-region scalar-holder and conservative aggregate storage fixture.
-- Verification prepends the V4 crates before this file.
-- One cached borrowck request owns the only compiler pipeline in this executable.
-- Outer ordinary-task lends and scalar holders stay legal. Every constructor that
-- cannot preserve a lend child's provenance must reject it before creating its node.

task v4_contract_region_storage_negative_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_contract_region_storage_negative_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_contract_region_storage_negative_status(borrow_id: int, resolve_id: int, body_name: word) -> word {
    pilot def_id = v4_resolve_def_for_name(resolve_id, body_name)
    pilot result_id = v4_borrowck_lookup_result(borrow_id, def_id)
    give back v4_borrowck_result_status(borrow_id, result_id)
}

task v4_contract_region_storage_negative_diags_match(borrow_id: int, mir_id: int) -> bool {
    pilot diag_count = v4_mir_diag_count(mir_id)
    if v4_borrowck_diag_count(borrow_id) != diag_count {
        give back false
    }
    pilot diag_id = 0
    repeat until diag_id >= diag_count {
        if v4_borrowck_diag(borrow_id, diag_id) != v4_mir_diag(mir_id, diag_id) {
            give back false
        }
        diag_id += 1
    }
    give back true
}

task v4_contract_region_storage_negative_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task choose<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> lend 'a Ship {\n"
    src = src + "    if take_first {\n"
    src = src + "        give back lend first\n"
    src = src + "    }\n"
    src = src + "    give back lend second\n"
    src = src + "}\n"
    src = src + "task stored_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> lend 'a Ship {\n"
    src = src + "    pilot view = choose(lend first, lend second, take_first)\n"
    src = src + "    give back view\n"
    src = src + "}\n"
    src = src + "task elided_scalar_holder(lend value: Ship) -> lend Ship {\n"
    src = src + "    pilot view = lend value\n"
    src = src + "    give back view\n"
    src = src + "}\n"
    src = src + "task aggregate_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> int {\n"
    src = src + "    pilot views = (choose(lend first, lend second, take_first), lend first)\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    src = src + "task maybe_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> int {\n"
    src = src + "    pilot view: maybe<lend Ship> = some(choose(lend first, lend second, take_first))\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    src = src + "task result_ok_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> int {\n"
    src = src + "    pilot view: result<lend Ship,word> = ok(choose(lend first, lend second, take_first))\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    src = src + "task result_err_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> int {\n"
    src = src + "    pilot view: result<int,lend Ship> = err(choose(lend first, lend second, take_first))\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    src = src + "task map_key_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> int {\n"
    src = src + "    pilot views: Map<lend Ship,int> = " + v4_contract_region_storage_negative_braces("choose(lend first, lend second, take_first): 1") + "\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    src = src + "task map_value_source_set<'a>(lend 'a first: Ship, lend 'a second: Ship, take_first: bool) -> int {\n"
    src = src + "    pilot views: Map<word,lend Ship> = " + v4_contract_region_storage_negative_braces("\"ship\": choose(lend first, lend second, take_first)") + "\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    src = src + "task named_signature_escape<'a>(value: maybe<result<Map<word,lend 'a Ship>,int>>) -> maybe<result<Map<word,lend 'a Ship>,int>> {\n"
    src = src + "    give back nobody\n"
    src = src + "}\n"
    src = src + "task elided_signature_escape(value: maybe<result<Map<word,lend Ship>,int>>) -> maybe<result<Map<word,lend Ship>,int>> {\n"
    src = src + "    give back nobody\n"
    src = src + "}\n"
    give back src
}

pilot v4_contract_region_storage_negative_borrow = v4_borrowck_text_cached("contract-region-storage-negative.fk", v4_contract_region_storage_negative_source())
pilot v4_contract_region_storage_negative_mir = v4_borrowck_mir_id(v4_contract_region_storage_negative_borrow)
pilot v4_contract_region_storage_negative_ty = v4_mir_ty_id(v4_contract_region_storage_negative_mir)
pilot v4_contract_region_storage_negative_resolve = v4_ty_resolve_id(v4_contract_region_storage_negative_ty)

pilot v4_contract_region_storage_negative_ty_count = v4_ty_diag_count(v4_contract_region_storage_negative_ty)
say "contract-region-storage-ty-diagnostics=" + word_from_int(v4_contract_region_storage_negative_ty_count)
say "contract-region-storage-ty-diagnostics-exact-four=" + v4_contract_region_storage_negative_bool(v4_contract_region_storage_negative_ty_count == 4)
pilot v4_contract_region_storage_negative_ty_diag_id = 0
repeat until v4_contract_region_storage_negative_ty_diag_id >= v4_contract_region_storage_negative_ty_count {
    pilot v4_contract_region_storage_negative_ty_diag = v4_ty_diag(v4_contract_region_storage_negative_ty, v4_contract_region_storage_negative_ty_diag_id)
    say "contract-region-storage-ty-diag" + word_from_int(v4_contract_region_storage_negative_ty_diag_id) + "=" + v4_diag_message(v4_contract_region_storage_negative_ty_diag)
    say "contract-region-storage-ty-diag" + word_from_int(v4_contract_region_storage_negative_ty_diag_id) + "-help=" + v4_diag_help(v4_contract_region_storage_negative_ty_diag)
    say "contract-region-storage-ty-diag" + word_from_int(v4_contract_region_storage_negative_ty_diag_id) + "-span=" + v4_diag_span(v4_contract_region_storage_negative_ty_diag)
    v4_contract_region_storage_negative_ty_diag_id += 1
}

pilot v4_contract_region_storage_negative_mir_count = v4_mir_diag_count(v4_contract_region_storage_negative_mir)
say "contract-region-storage-mir-diagnostics=" + word_from_int(v4_contract_region_storage_negative_mir_count)
say "contract-region-storage-mir-diagnostics-exact-ten=" + v4_contract_region_storage_negative_bool(v4_contract_region_storage_negative_mir_count == 10)
pilot v4_contract_region_storage_negative_mir_diag_id = 0
repeat until v4_contract_region_storage_negative_mir_diag_id >= v4_contract_region_storage_negative_mir_count {
    pilot v4_contract_region_storage_negative_mir_diag = v4_mir_diag(v4_contract_region_storage_negative_mir, v4_contract_region_storage_negative_mir_diag_id)
    say "contract-region-storage-mir-diag" + word_from_int(v4_contract_region_storage_negative_mir_diag_id) + "=" + v4_diag_message(v4_contract_region_storage_negative_mir_diag)
    say "contract-region-storage-mir-diag" + word_from_int(v4_contract_region_storage_negative_mir_diag_id) + "-help=" + v4_diag_help(v4_contract_region_storage_negative_mir_diag)
    say "contract-region-storage-mir-diag" + word_from_int(v4_contract_region_storage_negative_mir_diag_id) + "-span=" + v4_diag_span(v4_contract_region_storage_negative_mir_diag)
    v4_contract_region_storage_negative_mir_diag_id += 1
}

say "contract-region-storage-choose-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "choose")
say "contract-region-storage-local-holder-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "stored_source_set")
say "contract-region-storage-elided-holder-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "elided_scalar_holder")
say "contract-region-storage-tuple-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "aggregate_source_set")
say "contract-region-storage-some-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "maybe_source_set")
say "contract-region-storage-ok-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "result_ok_source_set")
say "contract-region-storage-err-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "result_err_source_set")
say "contract-region-storage-map-key-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "map_key_source_set")
say "contract-region-storage-map-value-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "map_value_source_set")
say "contract-region-storage-named-signature-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "named_signature_escape")
say "contract-region-storage-elided-signature-status=" + v4_contract_region_storage_negative_status(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_resolve, "elided_signature_escape")

pilot v4_contract_region_storage_negative_borrow_count = v4_borrowck_diag_count(v4_contract_region_storage_negative_borrow)
say "contract-region-storage-borrow-diagnostics=" + word_from_int(v4_contract_region_storage_negative_borrow_count)
say "contract-region-storage-borrow-diagnostics-exact-ten=" + v4_contract_region_storage_negative_bool(v4_contract_region_storage_negative_borrow_count == 10)
say "contract-region-storage-borrow-diags-match-mir=" + v4_contract_region_storage_negative_bool(v4_contract_region_storage_negative_diags_match(v4_contract_region_storage_negative_borrow, v4_contract_region_storage_negative_mir))
