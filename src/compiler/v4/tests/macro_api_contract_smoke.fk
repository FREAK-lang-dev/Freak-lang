-- Dedicated macro API contract smoke. No macro is executed.

task v4_macro_api_smoke_bool(value: bool) -> word {
    if value { give back "true" }
    give back "false"
}

pilot v4_macro_api_smoke_source_id = v4_file_id(7, 42)
pilot v4_macro_api_smoke_expansion = v4_expansion_id_new(v4_macro_api_smoke_source_id, 3, 1)
pilot v4_macro_api_smoke_context = v4_macro_context_new(v4_macro_api_smoke_expansion, v4_macro_cap_all)
pilot v4_macro_api_smoke_source = v4_macro_source_view_new(v4_macro_api_smoke_source_id, 9, 128)
pilot v4_macro_api_smoke_raw_span = v4_span_new(v4_macro_api_smoke_source_id, 4, 16)
pilot v4_macro_api_smoke_span = v4_macro_span_view_new(v4_macro_api_smoke_source, v4_macro_api_smoke_raw_span)
pilot v4_macro_api_smoke_ast = v4_macro_ast_view_new(v4_macro_api_smoke_source, "root-opaque")
pilot v4_macro_api_smoke_provenance = v4_generated_node_provenance_new(v4_macro_api_smoke_expansion, v4_macro_api_smoke_raw_span, 2)
pilot v4_macro_api_smoke_node = v4_macro_node_view_new(v4_macro_api_smoke_ast, "node-opaque", "Task", v4_macro_api_smoke_span, v4_macro_api_smoke_provenance)
pilot v4_macro_api_smoke_diagnostic = v4_macro_diagnostic_new(v4_macro_api_smoke_expansion, v4_diag_warning, v4_macro_api_smoke_span, "macro.contract", "contract diagnostic", "host owns delivery")
pilot v4_macro_api_smoke_compiler_diag = v4_macro_diagnostic_to_compiler_diag(v4_macro_api_smoke_diagnostic)
pilot v4_macro_api_smoke_unrepresentable_diagnostic = v4_macro_diagnostic_new(v4_macro_api_smoke_expansion, v4_diag_warning, v4_macro_api_smoke_span, "macro.contract", "bad|worse", "original help")
pilot v4_macro_api_smoke_bridge_source = "task bridge() => 0\n"
pilot v4_macro_api_smoke_bridge_file = 0
pilot v4_macro_api_smoke_bridge_stream = 0
pilot v4_macro_api_smoke_bridge_tree = 0
pilot v4_macro_api_smoke_bridge_expanded_file = 0
pilot v4_macro_api_smoke_bridge_expansion = ""
pilot v4_macro_api_smoke_bridge_origin = ""
pilot v4_macro_api_smoke_bridge_provenance = ""

v4_macro_api_smoke_bridge_file = v4_source_set_text("macro-api-bridge.fk", v4_macro_api_smoke_bridge_source)
v4_macro_api_smoke_bridge_stream = v4_lex_text(v4_macro_api_smoke_bridge_file, v4_macro_api_smoke_bridge_source)
v4_macro_api_smoke_bridge_tree = v4_parse_stream(v4_macro_api_smoke_bridge_file, v4_macro_api_smoke_bridge_stream)
v4_macro_api_smoke_bridge_expanded_file = v4_expand_identity(v4_macro_api_smoke_bridge_file, v4_macro_api_smoke_bridge_tree)
v4_macro_api_smoke_bridge_expansion = v4_expand_contract_expansion_id(v4_macro_api_smoke_bridge_expanded_file)
v4_macro_api_smoke_bridge_origin = v4_expand_node_span(v4_macro_api_smoke_bridge_expanded_file, 1)
v4_macro_api_smoke_bridge_provenance = v4_expand_contract_generated_provenance(v4_macro_api_smoke_bridge_expanded_file, v4_macro_api_smoke_bridge_origin, 0)

pilot v4_macro_api_smoke_sources_before = v4_source_count()
pilot v4_macro_api_smoke_parse_before = v4_parse_tree_count()
pilot v4_macro_api_smoke_hir_before = v4_hir_file_count()
pilot v4_macro_api_smoke_ty_before = v4_ty_file_count()
pilot v4_macro_api_smoke_mir_before = v4_mir_file_count()
pilot v4_macro_api_smoke_query_before = v4_query_store_count()

pilot v4_macro_api_smoke_builder = v4_macro_builder_open(v4_macro_api_smoke_context, v4_macro_api_smoke_provenance)
pilot v4_macro_api_smoke_add_first = v4_macro_builder_add_node(v4_macro_api_smoke_builder, "GeneratedTask", v4_macro_api_smoke_span)
pilot v4_macro_api_smoke_add_second = v4_macro_builder_add_node(v4_macro_api_smoke_builder, "GeneratedTask", v4_macro_api_smoke_span)
pilot v4_macro_api_smoke_finish = v4_macro_builder_finish(v4_macro_api_smoke_builder)
pilot v4_macro_api_smoke_submit = v4_macro_context_submit_diagnostic(v4_macro_api_smoke_context, v4_macro_api_smoke_diagnostic)

pilot v4_macro_api_smoke_state_unchanged: bool = v4_macro_api_smoke_sources_before == v4_source_count() and v4_macro_api_smoke_parse_before == v4_parse_tree_count() and v4_macro_api_smoke_hir_before == v4_hir_file_count() and v4_macro_api_smoke_ty_before == v4_ty_file_count() and v4_macro_api_smoke_mir_before == v4_mir_file_count() and v4_macro_api_smoke_query_before == v4_query_store_count()

say "macro-api-format=" + v4_macro_api_wire_format
say "macro-api-version=" + v4_macro_api_version()
say "macro-api-version-supported=" + v4_macro_api_smoke_bool(v4_macro_api_version_supported(1, 0))
say "macro-api-future-version-rejected=" + v4_macro_api_smoke_bool(not v4_macro_api_version_supported(2, 0))
say "macro-api-unknown-capabilities-rejected=" + v4_macro_api_smoke_bool(v4_macro_context_new(v4_macro_api_smoke_expansion, 8) == "")
say "macro-api-host-unavailable=" + v4_macro_api_smoke_bool(not v4_macro_api_host_available())
say "macro-api-effects-denied=" + v4_macro_api_smoke_bool(not v4_macro_api_host_effect_allowed("filesystem") and not v4_macro_api_host_effect_allowed("network") and not v4_macro_api_host_effect_allowed("environment") and not v4_macro_api_host_effect_allowed("time"))
say "macro-api-context-valid=" + v4_macro_api_smoke_bool(v4_macro_context_valid(v4_macro_api_smoke_context))
say "macro-api-context-capabilities=" + v4_macro_api_smoke_bool(v4_macro_context_has_capability(v4_macro_api_smoke_context, v4_macro_cap_read_views) and v4_macro_context_has_capability(v4_macro_api_smoke_context, v4_macro_cap_emit_diagnostic) and v4_macro_context_has_capability(v4_macro_api_smoke_context, v4_macro_cap_build_syntax))
say "macro-api-expansion-owned=" + v4_macro_api_smoke_bool(v4_expansion_id_valid(v4_macro_api_smoke_expansion) and v4_expansion_id_source(v4_macro_api_smoke_expansion) == v4_macro_api_smoke_source_id and v4_expansion_id_invocation(v4_macro_api_smoke_expansion) == 3 and v4_expansion_id_generation(v4_macro_api_smoke_expansion) == 1)
say "macro-api-provenance-owned=" + v4_macro_api_smoke_bool(v4_generated_node_provenance_valid(v4_macro_api_smoke_provenance) and v4_generated_node_provenance_expansion(v4_macro_api_smoke_provenance) == v4_macro_api_smoke_expansion and v4_generated_node_provenance_output_index(v4_macro_api_smoke_provenance) == 2)
say "macro-api-cross-source-provenance-rejected=" + v4_macro_api_smoke_bool(v4_generated_node_provenance_new(v4_macro_api_smoke_expansion, v4_span_new(v4_file_id(7, 43), 4, 16), 2) == "")
say "macro-api-reversed-provenance-rejected=" + v4_macro_api_smoke_bool(v4_generated_node_provenance_new(v4_macro_api_smoke_expansion, v4_span_new(v4_macro_api_smoke_source_id, 16, 4), 2) == "")
say "macro-api-malformed-span-rejected=" + v4_macro_api_smoke_bool(v4_macro_span_view_new(v4_macro_api_smoke_source, v4_macro_api_smoke_source_id + "@garbage") == "")
say "macro-api-out-of-bounds-span-rejected=" + v4_macro_api_smoke_bool(v4_macro_span_view_new(v4_macro_api_smoke_source, v4_span_new(v4_macro_api_smoke_source_id, 0, 129)) == "")
say "macro-api-expand-bridge-id=" + v4_macro_api_smoke_bool(v4_expand_contract_expansion_matches(v4_macro_api_smoke_bridge_expanded_file, v4_macro_api_smoke_bridge_expansion) and v4_expansion_id_source(v4_macro_api_smoke_bridge_expansion) == word_from_int(v4_macro_api_smoke_bridge_file) and v4_expansion_id_invocation(v4_macro_api_smoke_bridge_expansion) == v4_macro_api_smoke_bridge_expanded_file and v4_expansion_id_generation(v4_macro_api_smoke_bridge_expansion) == 0)
say "macro-api-expand-bridge-provenance=" + v4_macro_api_smoke_bool(v4_generated_node_provenance_valid(v4_macro_api_smoke_bridge_provenance) and v4_generated_node_provenance_expansion(v4_macro_api_smoke_bridge_provenance) == v4_macro_api_smoke_bridge_expansion and v4_generated_node_provenance_origin_span(v4_macro_api_smoke_bridge_provenance) == v4_macro_api_smoke_bridge_origin)
say "macro-api-source-view-readonly=" + v4_macro_api_smoke_bool(v4_macro_source_view_valid(v4_macro_api_smoke_source) and v4_macro_source_view_revision(v4_macro_api_smoke_source) == 9 and v4_macro_source_view_byte_length(v4_macro_api_smoke_source) == 128)
say "macro-api-ast-view-readonly=" + v4_macro_api_smoke_bool(v4_macro_ast_view_valid(v4_macro_api_smoke_ast) and v4_macro_ast_view_root(v4_macro_api_smoke_ast) == "root-opaque")
say "macro-api-span-view-readonly=" + v4_macro_api_smoke_bool(v4_macro_span_view_valid(v4_macro_api_smoke_span) and v4_macro_span_view_span(v4_macro_api_smoke_span) == v4_macro_api_smoke_raw_span)
say "macro-api-node-view-readonly=" + v4_macro_api_smoke_bool(v4_macro_node_view_valid(v4_macro_api_smoke_node) and v4_macro_node_view_handle(v4_macro_api_smoke_node) == "node-opaque" and v4_macro_node_view_kind(v4_macro_api_smoke_node) == "Task" and v4_macro_node_view_provenance(v4_macro_api_smoke_node) == v4_macro_api_smoke_provenance)
say "macro-api-diagnostic-structured=" + v4_macro_api_smoke_bool(v4_macro_diagnostic_valid(v4_macro_api_smoke_diagnostic) and v4_macro_diagnostic_code(v4_macro_api_smoke_diagnostic) == "macro.contract" and v4_macro_diagnostic_message(v4_macro_api_smoke_diagnostic) == "contract diagnostic" and v4_diag_message(v4_macro_api_smoke_compiler_diag) == "contract diagnostic")
say "macro-api-diagnostic-adapter-fails-closed=" + v4_macro_api_smoke_bool(v4_macro_diagnostic_valid(v4_macro_api_smoke_unrepresentable_diagnostic) and v4_macro_diagnostic_message(v4_macro_api_smoke_unrepresentable_diagnostic) == "bad|worse" and not v4_macro_diagnostic_compiler_representable(v4_macro_api_smoke_unrepresentable_diagnostic) and v4_macro_diagnostic_to_compiler_diag(v4_macro_api_smoke_unrepresentable_diagnostic) == "")
say "macro-api-diagnostic-submit-unsupported=" + v4_macro_api_smoke_bool(v4_macro_api_result_status(v4_macro_api_smoke_submit) == v4_macro_result_unsupported)
say "macro-api-builder-valid=" + v4_macro_api_smoke_bool(v4_macro_builder_valid(v4_macro_api_smoke_builder))
say "macro-api-builder-cannot-execute=" + v4_macro_api_smoke_bool(not v4_macro_builder_can_execute(v4_macro_api_smoke_builder))
say "macro-api-builder-add-unsupported=" + v4_macro_api_smoke_bool(v4_macro_api_result_status(v4_macro_api_smoke_add_first) == v4_macro_result_unsupported)
say "macro-api-builder-finish-unsupported=" + v4_macro_api_smoke_bool(v4_macro_api_result_status(v4_macro_api_smoke_finish) == v4_macro_result_unsupported)
say "macro-api-builder-deterministic=" + v4_macro_api_smoke_bool(v4_macro_api_smoke_add_first == v4_macro_api_smoke_add_second)
say "macro-api-compiler-state-unchanged=" + v4_macro_api_smoke_bool(v4_macro_api_smoke_state_unchanged)
