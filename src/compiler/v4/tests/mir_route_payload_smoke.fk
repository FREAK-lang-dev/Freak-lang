-- V4 MIR route payload constructor and pattern smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_route_payload_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_mir_route_payload_good_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_route_payload_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task make() -> Event {\n"
    src = src + "    pilot event: Event = Key " + v4_mir_route_payload_braces(" code: 7, repeat: false ") + "\n"
    src = src + "    give back event\n"
    src = src + "}\n"
    src = src + "task score(event: Event) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Key " + v4_mir_route_payload_braces(" code ") + " -> give back code\n"
    src = src + "        Event::Key " + v4_mir_route_payload_braces(" code: 9, repeat: held ") + " -> give back 90\n"
    src = src + "        Event::Closed -> give back 0\n"
    src = src + "        _ -> give back -1\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_payload_bad_missing_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_route_payload_braces(" code: int, repeat: bool ") + "\n"
    src = src + "}\n"
    src = src + "task bad() -> Event {\n"
    src = src + "    give back Event::Key " + v4_mir_route_payload_braces(" code: 7 ") + "\n"
    src = src + "}\n"
    give back src
}

