task v4_mir_route_payload_find_branch_stmt(mir_id: int, body_id: int, condition: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_branch {
            if v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == condition {
                give back stmt_id
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_mir_route_payload_find_local_stmt(mir_id: int, body_id: int, local_name: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_local {
            if v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == local_name {
                give back stmt_id
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

pilot v4_mir_route_payload_stream = v4_lex_text(0, v4_mir_route_payload_good_source())
pilot v4_mir_route_payload_tree = v4_parse_stream(0, v4_mir_route_payload_stream)
pilot v4_mir_route_payload_hir = v4_hir_lower_tree(0, v4_mir_route_payload_tree)
pilot v4_mir_route_payload_resolve = v4_resolve_lower_hir(0, v4_mir_route_payload_hir)
pilot v4_mir_route_payload_ty = v4_ty_lower_resolve(0, v4_mir_route_payload_resolve)
pilot v4_mir_route_payload_mir = v4_mir_lower_ty(0, v4_mir_route_payload_ty)

pilot v4_mir_route_payload_sig = v4_ty_route_signature_id_for_name(v4_mir_route_payload_ty, "Event")

pilot v4_mir_route_payload_make_def = v4_resolve_def_for_name(v4_mir_route_payload_resolve, "make")
pilot v4_mir_route_payload_make_body = v4_mir_lookup_body(v4_mir_route_payload_mir, v4_mir_route_payload_make_def)
pilot v4_mir_route_payload_event_stmt = v4_mir_route_payload_find_local_stmt(v4_mir_route_payload_mir, v4_mir_route_payload_make_body, "event")
pilot v4_mir_route_payload_event_rvalue = v4_mir_stmt_rvalue(v4_mir_route_payload_mir, v4_mir_route_payload_make_body, v4_mir_route_payload_event_stmt)

pilot v4_mir_route_payload_score_def = v4_resolve_def_for_name(v4_mir_route_payload_resolve, "score")
pilot v4_mir_route_payload_score_body = v4_mir_lookup_body(v4_mir_route_payload_mir, v4_mir_route_payload_score_def)
pilot v4_mir_route_payload_arm0_stmt = v4_mir_route_payload_find_branch_stmt(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, "event == Key")
pilot v4_mir_route_payload_arm1_stmt = v4_mir_route_payload_find_branch_stmt(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, "event == Event::Key and event.code == 9")
pilot v4_mir_route_payload_arm0_rvalue = v4_mir_stmt_rvalue(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm0_stmt)
pilot v4_mir_route_payload_arm1_rvalue = v4_mir_stmt_rvalue(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_stmt)
pilot v4_mir_route_payload_arm1_lhs = v4_mir_rvalue_lhs(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rvalue)
pilot v4_mir_route_payload_arm1_rhs = v4_mir_rvalue_rhs(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rvalue)
pilot v4_mir_route_payload_code_stmt = v4_mir_route_payload_find_local_stmt(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, "code")
pilot v4_mir_route_payload_held_stmt = v4_mir_route_payload_find_local_stmt(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, "held")
pilot v4_mir_route_payload_code_rvalue = v4_mir_stmt_rvalue(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_code_stmt)
pilot v4_mir_route_payload_held_rvalue = v4_mir_stmt_rvalue(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_held_stmt)
pilot v4_mir_route_payload_code_place = v4_mir_rvalue_lhs(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_code_rvalue)
pilot v4_mir_route_payload_held_place = v4_mir_rvalue_lhs(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_held_rvalue)

say v4_mir_summary(v4_mir_route_payload_mir)
say "route-payload-sig-kind=" + v4_ty_signature_kind(v4_mir_route_payload_ty, v4_mir_route_payload_sig)
say "route-payload-case-count=" + word_from_int(v4_ty_route_case_count(v4_mir_route_payload_ty, v4_mir_route_payload_sig))
say "route-payload-case0-name=" + v4_ty_route_case_name(v4_mir_route_payload_ty, v4_mir_route_payload_sig, 0)
say "route-payload-case0-fields=" + word_from_int(v4_ty_route_case_field_count(v4_mir_route_payload_ty, "Event", "Key"))
say "route-payload-case0-field0-name=" + v4_ty_route_case_field_name(v4_mir_route_payload_ty, "Event", "Key", 0)
say "route-payload-case0-field0-type=" + v4_ty_route_case_field_type(v4_mir_route_payload_ty, "Event", "Key", 0)
say "route-payload-case0-field1-name=" + v4_ty_route_case_field_name(v4_mir_route_payload_ty, "Event", "Key", 1)
say "route-payload-case0-field1-type=" + v4_ty_route_case_field_type(v4_mir_route_payload_ty, "Event", "Key", 1)
say "route-payload-ctor-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_make_body, v4_mir_route_payload_event_rvalue)
say "route-payload-ctor-op=" + v4_mir_rvalue_op(v4_mir_route_payload_mir, v4_mir_route_payload_make_body, v4_mir_route_payload_event_rvalue)
say "route-payload-ctor-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_make_body, v4_mir_route_payload_event_rvalue)
say "route-payload-arm0-kind=" + v4_mir_stmt_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm0_stmt)
say "route-payload-arm0-lhs=" + v4_mir_stmt_lhs(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm0_stmt)
say "route-payload-arm0-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm0_rvalue)
say "route-payload-arm0-rvalue-op=" + v4_mir_rvalue_op(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm0_rvalue)
say "route-payload-arm0-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm0_rvalue)
say "route-payload-arm1-kind=" + v4_mir_stmt_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_stmt)
say "route-payload-arm1-lhs=" + v4_mir_stmt_lhs(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_stmt)
say "route-payload-arm1-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rvalue)
say "route-payload-arm1-rvalue-op=" + v4_mir_rvalue_op(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rvalue)
say "route-payload-arm1-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rvalue)
say "route-payload-arm1-left-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_lhs)
say "route-payload-arm1-left-text=" + v4_mir_rvalue_text(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_lhs)
say "route-payload-arm1-left-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_lhs)
say "route-payload-arm1-right-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rhs)
say "route-payload-arm1-right-text=" + v4_mir_rvalue_text(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rhs)
say "route-payload-arm1-right-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_arm1_rhs)
say "route-payload-code-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_code_rvalue)
say "route-payload-code-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_code_rvalue)
say "route-payload-code-place-field=" + v4_mir_place_field(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_code_place)
say "route-payload-code-place-ty=" + v4_mir_place_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_code_place)
say "route-payload-held-kind=" + v4_mir_rvalue_kind(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_held_rvalue)
say "route-payload-held-ty=" + v4_mir_rvalue_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_held_rvalue)
say "route-payload-held-place-field=" + v4_mir_place_field(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_held_place)
say "route-payload-held-place-ty=" + v4_mir_place_ty(v4_mir_route_payload_mir, v4_mir_route_payload_score_body, v4_mir_route_payload_held_place)
say "route-payload-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_payload_mir))

pilot v4_mir_route_payload_bad_missing_stream = v4_lex_text(1, v4_mir_route_payload_bad_missing_source())
