-- V4 builtin primitive editor smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_primitive_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_primitive_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_primitive_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_primitive_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_primitive_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_primitive_editor_completion_kind_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_kind(completion_id, item_id)
}

task v4_primitive_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_primitive_editor_contains(text: word, needle: word) -> bool {
    if needle == "" {
        give back true
    }
    if needle.length() > text.length() {
        give back false
    }
    pilot idx = 0
    repeat until idx + needle.length() > text.length() {
        if v4_slice(text, idx, idx + needle.length()) == needle {
            give back true
        }
        idx += 1
    }
    give back false
}

task v4_primitive_editor_source_text() -> word {
    pilot src = "task mix(count: uint, marker: char) -> float32 {\n"
    src = src + "    pilot byte: tiny = 7t\n"
    src = src + "    pilot power: big = 999b\n"
    src = src + "    pilot note: word = \"ace\"\n"
    src = src + "    give back 1.5\n"
    src = src + "}\n"
    give back src
}

pilot v4_primitive_editor_source = v4_primitive_editor_source_text()
pilot v4_primitive_editor_stream = v4_lex_text(0, v4_primitive_editor_source)

pilot v4_primitive_editor_uint_offset = v4_primitive_editor_token_offset(v4_primitive_editor_stream, "uint", 0)
pilot v4_primitive_editor_char_offset = v4_primitive_editor_token_offset(v4_primitive_editor_stream, "char", 0)
pilot v4_primitive_editor_float32_offset = v4_primitive_editor_token_offset(v4_primitive_editor_stream, "float32", 0)

pilot v4_primitive_editor_uint_sem = v4_semantic_at_text_cached("primitive-editor.fk", v4_primitive_editor_source, v4_primitive_editor_uint_offset)
pilot v4_primitive_editor_char_sem = v4_semantic_at_text_cached("primitive-editor.fk", v4_primitive_editor_source, v4_primitive_editor_char_offset)
pilot v4_primitive_editor_hover = v4_hover_text_cached("primitive-editor.fk", v4_primitive_editor_source, v4_primitive_editor_char_offset)
pilot v4_primitive_editor_definition = v4_definition_at_text_cached("primitive-editor.fk", v4_primitive_editor_source, v4_primitive_editor_float32_offset)
pilot v4_primitive_editor_completion = v4_completion_text_cached("primitive-editor.fk", v4_primitive_editor_source, 0)

pilot v4_primitive_editor_uint_completion = v4_primitive_editor_find_completion_label(v4_primitive_editor_completion, "uint")
pilot v4_primitive_editor_float32_completion = v4_primitive_editor_find_completion_label(v4_primitive_editor_completion, "float32")
pilot v4_primitive_editor_char_completion = v4_primitive_editor_find_completion_label(v4_primitive_editor_completion, "char")
pilot v4_primitive_editor_big_completion = v4_primitive_editor_find_completion_label(v4_primitive_editor_completion, "big")

say v4_semantic_at_summary(v4_primitive_editor_uint_sem)
say "primitive-editor-uint-kind=" + v4_semantic_at_kind(v4_primitive_editor_uint_sem)
say "primitive-editor-uint-type=" + v4_semantic_at_type(v4_primitive_editor_uint_sem)
say "primitive-editor-uint-def=" + v4_semantic_at_def(v4_primitive_editor_uint_sem)
say "primitive-editor-char-kind=" + v4_semantic_at_kind(v4_primitive_editor_char_sem)
say "primitive-editor-char-type=" + v4_semantic_at_type(v4_primitive_editor_char_sem)
say "primitive-editor-char-def=" + v4_semantic_at_def(v4_primitive_editor_char_sem)
say "primitive-editor-hover-kind=" + v4_hover_kind(v4_primitive_editor_hover)
say "primitive-editor-hover-type=" + v4_hover_type(v4_primitive_editor_hover)
say "primitive-editor-hover-has-kind=" + v4_primitive_editor_bool_word(v4_primitive_editor_contains(v4_hover_markdown(v4_primitive_editor_hover), "`BuiltinType`"))
say "primitive-editor-definition-kind=" + v4_definition_at_kind(v4_primitive_editor_definition)
say "primitive-editor-definition-found=" + word_from_int(v4_definition_at_found(v4_primitive_editor_definition))
say "primitive-editor-definition-def=" + v4_definition_at_def(v4_primitive_editor_definition)
say "primitive-editor-completion-uint-found=" + v4_primitive_editor_bool_word(v4_primitive_editor_uint_completion >= 0)
say "primitive-editor-completion-uint-kind=" + v4_primitive_editor_completion_kind_or_empty(v4_primitive_editor_completion, v4_primitive_editor_uint_completion)
say "primitive-editor-completion-uint-detail=" + v4_primitive_editor_completion_detail_or_empty(v4_primitive_editor_completion, v4_primitive_editor_uint_completion)
say "primitive-editor-completion-float32-found=" + v4_primitive_editor_bool_word(v4_primitive_editor_float32_completion >= 0)
say "primitive-editor-completion-float32-detail=" + v4_primitive_editor_completion_detail_or_empty(v4_primitive_editor_completion, v4_primitive_editor_float32_completion)
say "primitive-editor-completion-char-found=" + v4_primitive_editor_bool_word(v4_primitive_editor_char_completion >= 0)
say "primitive-editor-completion-char-detail=" + v4_primitive_editor_completion_detail_or_empty(v4_primitive_editor_completion, v4_primitive_editor_char_completion)
say "primitive-editor-completion-big-found=" + v4_primitive_editor_bool_word(v4_primitive_editor_big_completion >= 0)
say "primitive-editor-completion-big-detail=" + v4_primitive_editor_completion_detail_or_empty(v4_primitive_editor_completion, v4_primitive_editor_big_completion)
