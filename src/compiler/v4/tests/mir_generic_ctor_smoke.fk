-- V4 MIR generic shape and route constructor inference smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_generic_ctor_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_mir_generic_ctor_good_source() -> word {
    pilot src = "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + v4_mir_generic_ctor_braces(" value: T ") + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task shape_infer() -> int {\n"
    src = src + "    pilot box = Box " + v4_mir_generic_ctor_braces(" value: 7 ") + "\n"
    src = src + "    give back box.value\n"
    src = src + "}\n"
    src = src + "task shape_expected() -> Box<int> {\n"
    src = src + "    give back Box " + v4_mir_generic_ctor_braces(" value: 9 ") + "\n"
    src = src + "}\n"
    src = src + "task route_infer() -> Option<int> {\n"
    src = src + "    pilot some = Option::Some " + v4_mir_generic_ctor_braces(" value: 11 ") + "\n"
    src = src + "    give back some\n"
    src = src + "}\n"
    src = src + "task route_expected() -> Option<int> {\n"
    src = src + "    pilot empty: Option<int> = Option::None\n"
    src = src + "    give back empty\n"
    src = src + "}\n"
    give back src
}

task v4_mir_generic_ctor_bad_shape_source() -> word {
    pilot src = "shape Empty<T> {\n"
    src = src + "}\n"
    src = src + "task bad() -> void {\n"
    src = src + "    pilot ghost = Empty " + v4_mir_generic_ctor_braces(" ") + "\n"
    src = src + "}\n"
    give back src
}

task v4_mir_generic_ctor_bad_route_source() -> word {
    pilot src = "route Option<T> {\n"
