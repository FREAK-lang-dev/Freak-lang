-- V4 MIR destructuring assignment smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_destructure_assignment_good_source() -> word {
    pilot src = "task main() -> int {\n"
    src = src + "    pilot pair = (7, 9)\n"
    src = src + "    pilot left = 0\n"
    src = src + "    pilot right = 0\n"
    src = src + "    (left, right) = pair\n"
    src = src + "    pilot squad = [3, 5]\n"
    src = src + "    pilot front = 0\n"
    src = src + "    pilot flank = 0\n"
    src = src + "    [front, flank] = squad\n"
    src = src + "    pilot nested = ([1, 2], (3, 4))\n"
    src = src + "    pilot x = 0\n"
    src = src + "    pilot y = 0\n"
    src = src + "    pilot a = 0\n"
    src = src + "    pilot b = 0\n"
    src = src + "    ([x, y], (a, b)) = nested\n"
    src = src + "    give back left + flank + b\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_non_tuple_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot left = 0\n"
    src = src + "    pilot right = 0\n"
    src = src + "    (left, right) = 7\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_tuple_arity_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair = (1, 2)\n"
    src = src + "    pilot left = 0\n"
    src = src + "    pilot right = 0\n"
    src = src + "    pilot extra = 0\n"
    src = src + "    (left, right, extra) = pair\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_non_sequence_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot front = 0\n"
    src = src + "    pilot flank = 0\n"
    src = src + "    [front, flank] = 7\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_sequence_arity_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot board: [int;2] = [1, 2]\n"
    src = src + "    pilot a = 0\n"
    src = src + "    pilot b = 0\n"
    src = src + "    pilot c = 0\n"
    src = src + "    [a, b, c] = board\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_missing_target_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair = (1, 2)\n"
    src = src + "    pilot left = 0\n"
    src = src + "    (left, ghost) = pair\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_compound_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair = (1, 2)\n"
    src = src + "    pilot left = 0\n"
    src = src + "    pilot right = 0\n"
    src = src + "    (left, right) += pair\n"
    src = src + "}\n"
    give back src
}

task v4_mir_destructure_assignment_bad_leaf_type_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair = (1, 2)\n"
    src = src + "    pilot left = 0\n"
    src = src + "    pilot label = \"ace\"\n"
    src = src + "    (left, label) = pair\n"
    src = src + "}\n"
    give back src
}

