-- V4 semantic-at arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_semantic_snapshot_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_semantic_snapshot_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_semantic_snapshot_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_semantic_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_semantic_snapshot_source_text() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_semantic_snapshot_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task util::math::double(value: int) -> int {\n"
    src = src + "    give back value + value\n"
    src = src + "}\n"
    src = src + "task compose(host: word, port: int) -> int {\n"
    src = src + "    give back port\n"
    src = src + "}\n"
    src = src + "use util::math::*\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "doctrine Displayable {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "doctrine Ranked {\n"
    src = src + "    task rank(self) -> int\n"
    src = src + "}\n"
    src = src + "shape Wing {\n"
    src = src + "    callsign: word\n"
    src = src + "    score: int\n"
    src = src + "}\n"
    src = src + "impl Displayable for Wing {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back self.callsign\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Ranked for Wing {\n"
    src = src + "    task rank(self) -> int {\n"
    src = src + "        give back self.score\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task show<T: Displayable + Ranked>(value: T) -> word {\n"
    src = src + "    pilot score = value.rank()\n"
    src = src + "    give back value.display()\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot " + v4_semantic_snapshot_braces(" rank: 7 ") + "\n"
    src = src + "    pilot event = Event::Key " + v4_semantic_snapshot_braces(" code: 9 ") + "\n"
    src = src + "    pilot tuned = compose(host: \"relay\", port: 9)\n"
    src = src + "    pilot doubled = double(2)\n"
    src = src + "    give back ace.salute() + tuned + doubled + CELLS\n"
    src = src + "}\n"
    src = src + "task mix(count: uint, marker: char) -> float32 {\n"
    src = src + "    give back 1.5\n"
    src = src + "}\n"
    give back src
}

pilot v4_semantic_snapshot_source = v4_semantic_snapshot_source_text()
pilot v4_semantic_snapshot_stream = v4_lex_text(0, v4_semantic_snapshot_source)
pilot v4_semantic_snapshot_main_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "main", 0)
pilot v4_semantic_snapshot_method_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "salute", 1)
pilot v4_semantic_snapshot_variant_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "Event", 1)
pilot v4_semantic_snapshot_variant_case_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "Key", 1)
pilot v4_semantic_snapshot_param_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "host", 1)
pilot v4_semantic_snapshot_builtin_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "uint", 0)
pilot v4_semantic_snapshot_glob_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "double", 1)
pilot v4_semantic_snapshot_const_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "CELLS", 1)
pilot v4_semantic_snapshot_bound_offset = v4_semantic_snapshot_token_offset(v4_semantic_snapshot_stream, "display", 2)

pilot v4_semantic_snapshot_main = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_main_offset)
pilot v4_semantic_snapshot_method = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_method_offset)
pilot v4_semantic_snapshot_variant = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_variant_offset)
pilot v4_semantic_snapshot_variant_case = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_variant_case_offset)
pilot v4_semantic_snapshot_param = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_param_offset)
pilot v4_semantic_snapshot_builtin = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_builtin_offset)
pilot v4_semantic_snapshot_glob = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_glob_offset)
pilot v4_semantic_snapshot_const = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_const_offset)
pilot v4_semantic_snapshot_bound = v4_semantic_at_text_cached("semantic-snapshot.fk", v4_semantic_snapshot_source, v4_semantic_snapshot_bound_offset)
say v4_semantic_at_summary(v4_semantic_snapshot_main)
say v4_semantic_snapshot_summary()

pilot v4_semantic_snapshot_payload = v4_semantic_snapshot()
say v4_semantic_snapshot_validate(v4_semantic_snapshot_payload)
say "semantic-snapshot-bytes=" + word_from_int(v4_semantic_snapshot_payload.length())
say v4_semantic_snapshot_fact_line(v4_semantic_snapshot_method)
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
say v4_ty_snapshot_restore(v4_ty_snapshot())
say v4_semantic_snapshot_restore(v4_semantic_snapshot_payload)
say v4_lsp_semantic_snapshot_text()
say v4_lsp_semantic_snapshot_restore_text(v4_semantic_snapshot_payload)
say v4_lsp_handle_text_request("workspace/semanticSnapshotRestore", "semantic-snapshot.fk", v4_semantic_snapshot_payload, 0)

pilot v4_semantic_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_semantic_query_payload)
say v4_driver_confirm_restored_document_text("semantic-snapshot.fk", v4_semantic_snapshot_source)
pilot v4_semantic_file = v4_source_find("semantic-snapshot.fk")
pilot v4_semantic_fingerprint = v4_source_fingerprint(v4_semantic_file)
pilot v4_semantic_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_method_offset), v4_semantic_fingerprint))
pilot v4_semantic_variant_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_variant_offset), v4_semantic_fingerprint))
pilot v4_semantic_variant_case_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_variant_case_offset), v4_semantic_fingerprint))
pilot v4_semantic_param_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_param_offset), v4_semantic_fingerprint))
pilot v4_semantic_builtin_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_builtin_offset), v4_semantic_fingerprint))
pilot v4_semantic_glob_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_glob_offset), v4_semantic_fingerprint))
pilot v4_semantic_const_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_const_offset), v4_semantic_fingerprint))
pilot v4_semantic_bound_restored_id = word_to_int(v4_query_get(v4_semantic_at_query_key("semantic-snapshot.fk", v4_semantic_snapshot_bound_offset), v4_semantic_fingerprint))
say v4_semantic_at_summary(v4_semantic_restored_id)
say "semantic-snapshot-method-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_method)
say "semantic-snapshot-method-type=" + v4_semantic_at_type(v4_semantic_snapshot_method)
say "semantic-snapshot-restored-kind=" + v4_semantic_at_kind(v4_semantic_restored_id)
say "semantic-snapshot-restored-type=" + v4_semantic_at_type(v4_semantic_restored_id)
say "semantic-snapshot-variant-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_variant)
say "semantic-snapshot-variant-type=" + v4_semantic_at_type(v4_semantic_snapshot_variant)
say "semantic-snapshot-variant-restored-kind=" + v4_semantic_at_kind(v4_semantic_variant_restored_id)
say "semantic-snapshot-variant-restored-type=" + v4_semantic_at_type(v4_semantic_variant_restored_id)
say "semantic-snapshot-variant-case-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_variant_case)
say "semantic-snapshot-variant-case-type=" + v4_semantic_at_type(v4_semantic_snapshot_variant_case)
say "semantic-snapshot-variant-case-restored-kind=" + v4_semantic_at_kind(v4_semantic_variant_case_restored_id)
say "semantic-snapshot-variant-case-restored-type=" + v4_semantic_at_type(v4_semantic_variant_case_restored_id)
say "semantic-snapshot-param-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_param)
say "semantic-snapshot-param-type=" + v4_semantic_at_type(v4_semantic_snapshot_param)
say "semantic-snapshot-param-restored-kind=" + v4_semantic_at_kind(v4_semantic_param_restored_id)
say "semantic-snapshot-param-restored-type=" + v4_semantic_at_type(v4_semantic_param_restored_id)
say "semantic-snapshot-builtin-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_builtin)
say "semantic-snapshot-builtin-type=" + v4_semantic_at_type(v4_semantic_snapshot_builtin)
say "semantic-snapshot-builtin-restored-kind=" + v4_semantic_at_kind(v4_semantic_builtin_restored_id)
say "semantic-snapshot-builtin-restored-type=" + v4_semantic_at_type(v4_semantic_builtin_restored_id)
say "semantic-snapshot-glob-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_glob)
say "semantic-snapshot-glob-type=" + v4_semantic_at_type(v4_semantic_snapshot_glob)
say "semantic-snapshot-glob-restored-kind=" + v4_semantic_at_kind(v4_semantic_glob_restored_id)
say "semantic-snapshot-glob-restored-type=" + v4_semantic_at_type(v4_semantic_glob_restored_id)
say "semantic-snapshot-const-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_const)
say "semantic-snapshot-const-type=" + v4_semantic_at_type(v4_semantic_snapshot_const)
say "semantic-snapshot-const-restored-kind=" + v4_semantic_at_kind(v4_semantic_const_restored_id)
say "semantic-snapshot-const-restored-type=" + v4_semantic_at_type(v4_semantic_const_restored_id)
say "semantic-snapshot-bound-kind=" + v4_semantic_at_kind(v4_semantic_snapshot_bound)
say "semantic-snapshot-bound-type=" + v4_semantic_at_type(v4_semantic_snapshot_bound)
say "semantic-snapshot-bound-restored-kind=" + v4_semantic_at_kind(v4_semantic_bound_restored_id)
say "semantic-snapshot-bound-restored-type=" + v4_semantic_at_type(v4_semantic_bound_restored_id)
say v4_driver_confirm_restored_document_text("semantic-snapshot.fk", "task changed() => 7\n")
