-- V4 generic alias-backed shape editor facts smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_generic_alias_shape_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_generic_alias_shape_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_generic_alias_shape_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_generic_alias_shape_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_generic_alias_shape_editor_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_generic_alias_shape_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_generic_alias_shape_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_generic_alias_shape_editor_source_text() -> word {
    pilot src = "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "alias Crate<T> = Box<T>\n"
    src = src + "alias IntCrate = Crate<int>\n"
    src = src + "task inspect() -> int {\n"
    src = src + "    pilot box = IntCrate " + v4_generic_alias_shape_editor_braces(" value: 7 ") + "\n"
    src = src + "    give back box.value\n"
    src = src + "}\n"
    give back src
}

pilot v4_generic_alias_shape_editor_source = v4_generic_alias_shape_editor_source_text()
pilot v4_generic_alias_shape_editor_stream = v4_lex_text(0, v4_generic_alias_shape_editor_source)

pilot v4_generic_alias_shape_editor_ctor_offset = v4_generic_alias_shape_editor_token_offset(v4_generic_alias_shape_editor_stream, "IntCrate", 1)
pilot v4_generic_alias_shape_editor_box_decl_offset = v4_generic_alias_shape_editor_token_offset(v4_generic_alias_shape_editor_stream, "box", 0)
pilot v4_generic_alias_shape_editor_box_use_offset = v4_generic_alias_shape_editor_token_offset(v4_generic_alias_shape_editor_stream, "box", 1)
pilot v4_generic_alias_shape_editor_value_offset = v4_generic_alias_shape_editor_token_offset(v4_generic_alias_shape_editor_stream, "value", 1)

pilot v4_generic_alias_shape_editor_ctor_sem = v4_semantic_at_text_cached("generic-alias-shape-editor.fk", v4_generic_alias_shape_editor_source, v4_generic_alias_shape_editor_ctor_offset)
pilot v4_generic_alias_shape_editor_box_sem = v4_semantic_at_text_cached("generic-alias-shape-editor.fk", v4_generic_alias_shape_editor_source, v4_generic_alias_shape_editor_box_use_offset)
pilot v4_generic_alias_shape_editor_box_hover = v4_hover_text_cached("generic-alias-shape-editor.fk", v4_generic_alias_shape_editor_source, v4_generic_alias_shape_editor_box_use_offset)
pilot v4_generic_alias_shape_editor_box_definition = v4_definition_at_text_cached("generic-alias-shape-editor.fk", v4_generic_alias_shape_editor_source, v4_generic_alias_shape_editor_box_use_offset)
pilot v4_generic_alias_shape_editor_completion = v4_completion_text_cached("generic-alias-shape-editor.fk", v4_generic_alias_shape_editor_source, v4_generic_alias_shape_editor_value_offset)

pilot v4_generic_alias_shape_editor_box_item = v4_generic_alias_shape_editor_find_completion_label(v4_generic_alias_shape_editor_completion, "box")
pilot v4_generic_alias_shape_editor_alias_item = v4_generic_alias_shape_editor_find_completion_label(v4_generic_alias_shape_editor_completion, "IntCrate")
pilot v4_generic_alias_shape_editor_temp_item = v4_generic_alias_shape_editor_find_completion_label(v4_generic_alias_shape_editor_completion, "_ctor")

say "generic-alias-shape-editor-ctor-kind=" + v4_semantic_at_kind(v4_generic_alias_shape_editor_ctor_sem)
say "generic-alias-shape-editor-ctor-type=" + v4_semantic_at_type(v4_generic_alias_shape_editor_ctor_sem)
say "generic-alias-shape-editor-box-kind=" + v4_semantic_at_kind(v4_generic_alias_shape_editor_box_sem)
say "generic-alias-shape-editor-box-type=" + v4_semantic_at_type(v4_generic_alias_shape_editor_box_sem)
say "generic-alias-shape-editor-box-hover-kind=" + v4_hover_kind(v4_generic_alias_shape_editor_box_hover)
say "generic-alias-shape-editor-box-hover-type=" + v4_hover_type(v4_generic_alias_shape_editor_box_hover)
say "generic-alias-shape-editor-box-definition-kind=" + v4_definition_at_kind(v4_generic_alias_shape_editor_box_definition)
say "generic-alias-shape-editor-box-definition-found=" + word_from_int(v4_definition_at_found(v4_generic_alias_shape_editor_box_definition))
say "generic-alias-shape-editor-box-definition-matches=" + v4_generic_alias_shape_editor_bool_word(v4_span_start(v4_definition_at_span(v4_generic_alias_shape_editor_box_definition)) == v4_generic_alias_shape_editor_box_decl_offset)
say "generic-alias-shape-editor-box-found=" + v4_generic_alias_shape_editor_bool_word(v4_generic_alias_shape_editor_box_item >= 0)
say "generic-alias-shape-editor-box-detail=" + v4_generic_alias_shape_editor_completion_detail_or_empty(v4_generic_alias_shape_editor_completion, v4_generic_alias_shape_editor_box_item)
say "generic-alias-shape-editor-alias-found=" + v4_generic_alias_shape_editor_bool_word(v4_generic_alias_shape_editor_alias_item >= 0)
say "generic-alias-shape-editor-alias-detail=" + v4_generic_alias_shape_editor_completion_detail_or_empty(v4_generic_alias_shape_editor_completion, v4_generic_alias_shape_editor_alias_item)
say "generic-alias-shape-editor-temp-found=" + v4_generic_alias_shape_editor_bool_word(v4_generic_alias_shape_editor_temp_item >= 0)
