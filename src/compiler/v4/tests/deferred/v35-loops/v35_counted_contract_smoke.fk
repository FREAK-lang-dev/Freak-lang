-- Each process builds one source to keep component arenas bounded.
task v35_counted_contract_assert(condition: bool, label: word) -> void {
    if not condition { panic("v35-counted-contract " + label) }
}

task v35_counted_contract_source(mode: int) -> word {
    pilot open = chr(123)
    pilot close = chr(125)
    pilot head = "task main() -> int " + open + " "
    pilot tail = "; give back 0 " + close + "\n"
    if mode == 0 { give back head + "pilot i = 9; pilot total = 0; repeat 2 times with i " + open + " total += i " + close + "for each i in 0..=2 step 2 " + open + " total += i " + close + "for (pilot i: int = 0; i < 2; i += 1) " + open + " total += i " + close + "give back i + total " + close + "\n" }
    if mode == 1 { give back head + "repeat true times with i " + open + close + tail }
    if mode == 2 { give back head + "for each i in false..3 " + open + close + tail }
    if mode == 3 { give back head + "for each i in 0..3.5 " + open + close + tail }
    if mode == 4 { give back head + "for each i in 0..3 step 0 " + open + close + tail }
    if mode == 5 { give back head + "for each i in 0..3 step -2 " + open + close + tail }
    if mode == 6 { give back head + "repeat 2 times with i " + open + " i += 1 " + close + tail }
    if mode == 7 { give back head + "for each i in 0..3 " + open + " i = 9 " + close + tail }
    if mode == 8 { give back "task touch(value: lend mut int) " + open + close + "\n" + head + "repeat 2 times with i " + open + " touch(lend mut i) " + close + tail }
    if mode == 9 { give back head + "for (pilot i = true; i < 3; i += 1) " + open + close + tail }
    if mode == 10 { give back head + "for (pilot i = 0; 3; i += 1) " + open + close + tail }
    if mode == 11 { give back head + "for (pilot i = 0; i < 3; i = false) " + open + close + tail }
    if mode == 12 { give back head + "for (pilot i = 0; i < 3; true) " + open + close + tail }
    if mode == 13 { give back head + "for (fixed pilot i = 0; i < 3; i += 1) " + open + close + tail }
    if mode == 14 { give back head + "repeat 2 times with " + open + close + tail }
    if mode == 15 { give back head + "for each (i, j) in 0..3 " + open + close + tail }
    if mode == 16 { give back head + "for (pilot i: bool = 0; i < 3; i += 1) " + open + close + tail }
    if mode == 17 { give back head + "repeat 1 times with i " + open + close + "; say i" + tail }
    if mode == 18 { give back head + "for each i in 0..1 " + open + close + "; say i" + tail }
    if mode == 19 { give back head + "for (pilot i = 0; i < 1; i += 1) " + open + close + "; say i" + tail }
    if mode == 20 { give back head + "for (pilot i = 0; i < 1; inside += 1) " + open + " pilot inside = 0; i += 1 " + close + tail }
    if mode == 21 { give back "task touch(value: lend mut int) " + open + close + "\n" + head + "for each i in 0..3 " + open + " touch(lend mut i) " + close + tail }
    if mode == 22 { give back head + "for (pilot i = 0; i < 1;) " + open + close + tail }
    if mode == 23 { give back head + "pilot with = 2; pilot step = 3; pilot result = 0; for each i in 0..step " + open + " result += i " + close + "for each i in 0..with + step step with " + open + " result += i " + close + "repeat with times with step " + open + " result += step " + close + "give back result " + close + "\n" }
    if mode == 26 { give back head + "pilot slots: [int; 1] = [0]; for (pilot i = 0; i < 3; slots[0] += 1) " + open + " i += 1 " + close + "give back slots[0] " + close + "\n" }
    if mode == 27 { give back "task bound(value: bool) -> int " + open + " give back 4 " + close + "\n" + head + "for each i in 0..bound(0 < 1) step 0 " + open + close + tail }
    if mode == 28 { give back head + "for (pilot i = 0; i < 3; true) " + open + " break " + close + tail }
    if mode == 25 { give back head + "repeat 2 times with i " + open + " pilot callback = mut | | " + open + " i += 1 " + close + close + tail }
    panic("unknown counted contract case")
    give back ""
}

task v35_counted_contract_expected(mode: int) -> word {
    if mode == 1 { give back "repeat N times count must be int" }
    if mode == 2 or mode == 3 { give back "range bounds and step must be int" }
    if mode == 4 or mode == 5 or mode == 27 { give back "range step must be positive" }
    if mode == 6 or mode == 7 or mode == 8 or mode == 21 or mode == 25 { give back "iteration binding is immutable" }
    if mode == 9 or mode == 16 { give back "counted for initializer must have type int" }
    if mode == 10 { give back "counted for condition must be bool" }
    if mode == 11 or mode == 20 { give back "counted for assignment step must have type int" }
    if mode == 12 or mode == 28 { give back "counted for expression step must have type int or void" }
    if mode == 13 { give back "counted for initializer must be a pilot int binding" }
    if mode == 14 { give back "repeat index binding requires with name" }
    if mode == 15 { give back "range iteration requires one index binding" }
    if mode == 22 { give back "counted for requires a step" }
    give back ""
}

task v35_counted_contract_run(mode: int) -> void {
    if mode == 24 {
        pilot stream = v4_lex_text(0, "1..2 1..=2 1.5..2 step with")
        pilot token = 0
        pilot values = ""
        pilot ranges = 0
        repeat until token >= v4_lex_token_count(stream) {
            pilot kind = v4_lex_token_type(stream, token)
            if kind != v4_tok_trivia and kind != v4_tok_eof {
                pilot value = v4_lex_token_value(stream, token)
                values = values + value + "|"
                if value == ".." or value == "..=" { v35_counted_contract_assert(kind == v4_tok_symbol, "range symbol kind"); ranges += 1 }
                if value == "step" or value == "with" { v35_counted_contract_assert(kind == v4_tok_ident, "contextual identifier kind") }
            }
            token += 1
        }
        v35_counted_contract_assert(values == "1|..|2|1|..=|2|1.5|..|2|step|with|" and ranges == 3 and v4_lex_diag_count(stream) == 0, "adjacent range token boundaries")
        say "v35-counted-contract case=24 ranges=true contextual=true"
        give back
    }
    pilot source = v35_counted_contract_source(mode)
    pilot stream = v4_lex_text(0, source)
    pilot tree = v4_parse_stream(0, stream)
    pilot hir = v4_hir_lower_tree(0, tree)
    pilot resolve = v4_resolve_lower_hir(0, hir)
    pilot ty = v4_ty_lower_resolve(0, resolve)
    pilot mir = v4_mir_lower_ty(0, ty)
    pilot body = v4_mir_lookup_body_name(mir, "main")
    if (mode >= 1 and mode <= 22) or mode == 25 or mode == 27 or mode == 28 {
        pilot expected = v35_counted_contract_expected(mode)
        pilot found: bool = false
        pilot row = 0
        repeat until row >= v4_mir_diag_count(mir) {
            if v4_diag_message(v4_mir_diag(mir, row)) == expected { found = true }
            row += 1
        }
        if mode >= 17 and mode <= 19 {
            pilot unresolved: bool = false
            row = 0
            repeat until row >= v4_mir_diag_count(mir) {
                if v4_diag_message(v4_mir_diag(mir, row)) == "say value has no supported display contract" { unresolved = true }
                row += 1
            }
            pilot value = 0
            pilot after_loop = 0
            repeat until after_loop >= source.length() or v4_slice(source, after_loop, after_loop + 5) == "say i" { after_loop += 1 }
            v35_counted_contract_assert(after_loop < source.length() and v4_mir_find_local_visible_at(mir, body, "i", after_loop) < 0, "out-of-scope lookup has no binding")
            repeat until value >= v4_mir_body_rvalue_count(mir, body) {
                -- Unresolved identifiers may retain a UseSymbol recovery fact.
                -- They must have unknown type and no valid scoped local ID.
                if v4_mir_rvalue_text(mir, body, value) == "i" and v4_span_start(v4_mir_rvalue_span(mir, body, value)) >= after_loop {
                    v35_counted_contract_assert(v4_mir_rvalue_ty(mir, body, value) == v4_ty_unknown and v4_mir_rvalue_local_id(mir, body, value) < 0, "out-of-scope index has no binding identity")
                }
                value += 1
            }
            v35_counted_contract_assert(unresolved, "out-of-scope index is unresolved")
        } else {
            v35_counted_contract_assert(found, "specific counted diagnostic: " + expected)
        }
        pilot rejected = v4_codegen_llvm_lower_owned_mir(0, mir)
        v35_counted_contract_assert(v4_codegen_llvm_native_module_error(rejected) != "" and v4_codegen_llvm_module_text(rejected, v4_target_spec_new("x86_64-unknown-linux-gnu")) == "", "invalid counted program has no native module")
        if mode >= 17 and mode <= 19 { say "v35-counted-contract case=" + word_from_int(mode) + " scope=true unresolved=true module=false" } else { say "v35-counted-contract case=" + word_from_int(mode) + " rejected=true diagnostic=" + expected + " module=false" }
        give back
    }
    pilot borrow = v4_borrowck_check_mir(0, mir)
    v35_counted_contract_assert(v4_lex_diag_count(stream) + v4_parse_diag_count(tree) + v4_hir_diag_count(hir) + v4_resolve_diag_count(resolve) + v4_ty_diag_count(ty) + v4_mir_diag_count(mir) + v4_borrowck_diag_count(borrow) == 0, "clean frontend and Meiya")
    if mode == 0 {
        pilot local = 0
        pilot bindings = 0
        pilot immutable = 0
        repeat until local >= v4_mir_body_local_count(mir, body) {
            if v4_mir_local_name(mir, body, local) == "i" { bindings += 1; if v4_mir_counted_binding_is_immutable(mir, body, local) { immutable += 1 } }
            local += 1
        }
        v35_counted_contract_assert(bindings == 4 and immutable == 2, "fresh scoped source index identities")
        pilot signature = v4_mir_body_signature_id(mir, body)
        v35_counted_contract_assert(v4_ty_signature_local_annotation_count(ty, signature) == 1 and v4_ty_signature_local_annotation_type(ty, signature, 0) == v4_ty_int, "C header HIR/TY annotation fact")
        pilot annotation_span = v4_ty_signature_local_annotation_type_span(ty, signature, 0)
        v35_counted_contract_assert(v4_slice(source, v4_span_start(annotation_span), v4_span_end(annotation_span)) == "int", "annotation original source span")
        pilot statement = 0
        pilot restored_outer: bool = false
        repeat until statement >= v4_mir_body_stmt_count(mir, body) {
            if v4_mir_stmt_kind(mir, body, statement) == v4_mir_stmt_return {
                pilot value = v4_mir_stmt_rvalue(mir, body, statement)
                restored_outer = v4_mir_rvalue_local_id(mir, body, v4_mir_rvalue_lhs(mir, body, value)) == 0
            }
            statement += 1
        }
        v35_counted_contract_assert(restored_outer, "after-loop reference restores outer identity")
    }
    pilot snapshot = v4_mir_snapshot()
    v35_counted_contract_assert(v4_mir_snapshot_validate(snapshot).starts_with("mir-snapshot-import ok=1") and v4_mir_snapshot_restore_component(snapshot).starts_with("mir-snapshot-restore ok=1") and v4_mir_snapshot() == snapshot, "snapshot roundtrip")
    if mode == 0 {
        pilot bad_span = v4_span_new("file#0", 0, 1)
        pilot bad = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_use_local, "i", "local#999999", -1, -1, bad_span, v4_ty_int)
        v35_counted_contract_assert(v4_mir_rvalue_local_id(mir, body, bad) < 0 and not v4_mir_snapshot_validate(v4_mir_snapshot()).starts_with("mir-snapshot-import ok=1"), "forged binding identity rejected")
        say "v35-counted-contract case=0 frontend=true meiya=true identity=true annotation=true restore=true forged=false"
    } else if mode == 26 {
        say "v35-counted-contract case=26 frontend=true meiya=true projection=true restore=true"
    } else {
        say "v35-counted-contract case=23 frontend=true meiya=true contextual=true restore=true"
    }
}

pilot v35_counted_contract_mode = 0
if process::args_count() > 1 { v35_counted_contract_mode = word_to_int(process::arg(1)) }
v35_counted_contract_run(v35_counted_contract_mode)
