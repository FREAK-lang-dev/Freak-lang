-- Ordered loan candidates: physical diagnostics and actual-reader growth.
-- Modes isolate direct scaling (0), authored semantics (1), and resources (2).
-- This independent reference is the unchanged pre-optimization checker at
-- 8ffb389; it knows nothing about candidate construction or classification.
task borrow_candidate_reference(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    -- Summary counts are populated after checking and can be loose restored
    -- facts. Reject loan-free bodies from their actual stored path kinds only.
    pilot has_loan: bool = false
    pilot path_idx = 0
    repeat until path_idx >= path_count or has_loan {
        has_loan = v4_borrowck_path_is_loan_kind(v4_borrowck_path_kind(borrow_id, result_id, path_idx))
        path_idx += 1
    }
    if not has_loan { give back 0 }
    pilot write_idx = 0
    repeat until write_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, write_idx) == v4_borrowck_path_write {
            pilot write_stmt = v4_borrowck_path_stmt(borrow_id, result_id, write_idx)
            pilot write_block = v4_borrowck_path_block(borrow_id, result_id, write_idx)
            pilot write_text = v4_borrowck_path_text(borrow_id, result_id, write_idx)
            pilot loan_idx = 0
            repeat until loan_idx >= path_count {
                if v4_borrowck_path_is_loan_kind(v4_borrowck_path_kind(borrow_id, result_id, loan_idx)) {
                    pilot loan_stmt = v4_borrowck_path_stmt(borrow_id, result_id, loan_idx)
                    pilot loan_block = v4_borrowck_path_block(borrow_id, result_id, loan_idx)
                    pilot loan_text = v4_borrowck_path_text(borrow_id, result_id, loan_idx)
                    pilot loan_conflicts = false
                    pilot help = ""
                    if loan_block == write_block and loan_stmt >= 0 and write_stmt >= 0 and loan_stmt < write_stmt {
                        if v4_borrowck_paths_overlap(loan_text, write_text) {
                            if v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, loan_stmt, loan_text, write_stmt, write_block) {
                                loan_conflicts = true
                                help = v4_borrowck_mutable_conflict_help(loan_text, loan_stmt, write_block, write_text, write_stmt)
                                if v4_borrowck_repeat_projection_scan_exhausted() {
                                    help = v4_borrowck_repeat_projection_scan_help(v4_borrowck_repeat_projection_scan_slot_count())
                                }
                            }
                        }
                    } else if loan_stmt >= 0 and write_stmt >= 0 and loan_block >= 0 and write_block >= 0 and loan_block != write_block {
                        pilot loan_spans = v4_borrowck_loan_spans_successors(mir_id, body_id, loan_stmt)
                        if v4_borrowck_explicit_loan_holder(mir_id, body_id, loan_stmt, loan_text) != "" {
                            loan_spans = true
                        }
                        if loan_spans {
                            if v4_borrowck_block_reaches(mir_id, body_id, loan_block, write_block) {
                                if v4_borrowck_paths_overlap(loan_text, write_text) {
                                    if v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, loan_stmt, loan_text, write_stmt, write_block) {
                                        loan_conflicts = true
                                        help = v4_borrowck_cross_block_conflict_help(loan_text, loan_stmt, loan_block, write_text, write_stmt, write_block)
                                        if v4_borrowck_repeat_projection_scan_exhausted() {
                                            help = v4_borrowck_repeat_projection_scan_help(v4_borrowck_repeat_projection_scan_slot_count())
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if loan_conflicts {
                        pilot stmt_span = v4_borrowck_write_diag_span(mir_id, body_id, write_stmt)
                        pilot message = v4_borrowck_mutable_conflict_message(loan_block, write_block)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, message, help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                        loan_idx = path_count
                    }
                }
                loan_idx += 1
            }
        }
        write_idx += 1
    }
    give back conflicts
}

pilot borrow_candidate_last_reads = 0
pilot borrow_candidate_last_visits = 0

task borrow_candidate_assert(value: bool, label: word) -> void {
    if not value { panic("borrow-candidate " + label) }
}

task borrow_candidate_pad(borrow: int, result_id: int, count: int) -> void {
    pilot path = 0
    repeat until path >= count {
        v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_copy, "irrelevant", -1, -1)
        path += 1
    }
}

task borrow_candidate_clone(borrow: int, result_id: int) -> int {
    pilot cloned = v4_borrowck_add_result(borrow, v4_borrowck_result_def(borrow, result_id), "reference", v4_borrowck_result_status(borrow, result_id), v4_borrowck_result_loans(borrow, result_id), v4_borrowck_result_moves(borrow, result_id), v4_borrowck_result_drops(borrow, result_id))
    pilot path = 0
    repeat until path >= v4_borrowck_result_path_count(borrow, result_id) {
        v4_borrowck_add_path(borrow, cloned, v4_borrowck_path_kind(borrow, result_id, path), v4_borrowck_path_text(borrow, result_id, path), v4_borrowck_path_stmt(borrow, result_id, path), v4_borrowck_path_block(borrow, result_id, path))
        path += 1
    }
    give back cloned
}

task borrow_candidate_compare(borrow: int, result_id: int, mir: int, body: int, expected: int) -> void {
    pilot reference = borrow_candidate_clone(borrow, result_id)
    pilot start = v4_borrowck_diag_count(borrow)
    pilot conflicts = v4_borrowck_check_mutable_exclusivity(borrow, result_id, mir, body)
    pilot middle = v4_borrowck_diag_count(borrow)
    pilot old_conflicts = borrow_candidate_reference(borrow, reference, mir, body)
    borrow_candidate_assert(conflicts == expected and old_conflicts == expected and middle - start == conflicts and v4_borrowck_diag_count(borrow) - middle == conflicts, "exact conflict count")
    borrow_candidate_assert(v4_borrowck_result_status(borrow, result_id) == v4_borrowck_result_status(borrow, reference) and v4_borrowck_result_loans(borrow, result_id) == v4_borrowck_result_loans(borrow, reference) and v4_borrowck_result_moves(borrow, result_id) == v4_borrowck_result_moves(borrow, reference) and v4_borrowck_result_drops(borrow, result_id) == v4_borrowck_result_drops(borrow, reference), "status and false summaries")
    pilot diag = 0
    repeat until diag >= conflicts {
        borrow_candidate_assert(v4_borrowck_diag(borrow, start + diag) == v4_borrowck_diag(borrow, middle + diag), "physical first conflict message help span severity")
        diag += 1
    }
}

task borrow_candidate_scaling_case(mir: int, borrow: int, count: int, fixed: bool) -> void {
    pilot body = v4_mir_add_body(mir, "scale" + word_from_int(count) + word_from_bool(fixed), "scale", "")
    pilot result_id = v4_borrowck_add_result(borrow, v4_mir_body_def(mir, body), "scale", v4_borrowck_clean, -19, 7, 11)
    if fixed {
        v4_mir_add_block(mir, body, v4_mir_term_return, -1, -1, "")
        v4_mir_add_stmt(mir, body, 0, v4_mir_stmt_expr, "", "", V4_NO_SPAN, -1, -1)
        v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_loan, "source", 0, 0)
    }
    pilot row = 0
    repeat until row >= count {
        pilot block = 0
        if not fixed { block = v4_mir_add_block(mir, body, v4_mir_term_return, -1, -1, "") }
        pilot value = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_binary, "source + 1", v4_mir_bin_add, -1, -1, V4_NO_SPAN, v4_ty_int)
        pilot statement = v4_mir_add_stmt(mir, body, block, v4_mir_stmt_assign, "other", "source + 1", V4_NO_SPAN, -1, value)
        if not fixed { v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_loan, "source", statement, block) }
        statement = v4_mir_add_stmt(mir, body, block, v4_mir_stmt_assign, "other", "1", V4_NO_SPAN, -1, value)
        v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_write, "other", statement, block)
        borrow_candidate_pad(borrow, result_id, 3)
        row += 1
    }
    pilot count_paths = v4_borrowck_result_path_count(borrow, result_id)
    pilot reads = v4_borrowck_path_kind_reads
    pilot visits = v4_borrowck_mutable_exclusivity_candidate_visits
    pilot builds = v4_borrowck_mutable_exclusivity_candidate_builds
    pilot steps = v4_borrowck_mutable_exclusivity_candidate_build_steps
    pilot conflicts = v4_borrowck_check_mutable_exclusivity(borrow, result_id, mir, body)
    borrow_candidate_last_reads = v4_borrowck_path_kind_reads - reads
    borrow_candidate_last_visits = v4_borrowck_mutable_exclusivity_candidate_visits - visits
    borrow_candidate_assert(conflicts == 0 and v4_borrowck_result_status(borrow, result_id) == v4_borrowck_clean and v4_borrowck_result_loans(borrow, result_id) == -19 and v4_borrowck_result_drops(borrow, result_id) == 11, "scaling facts")
    -- Independent reader count catches restoring the old Write x all-path scan.
    borrow_candidate_assert(borrow_candidate_last_reads <= count_paths * 3 and borrow_candidate_last_visits == count and v4_borrowck_mutable_exclusivity_candidate_builds == builds + 1 and v4_borrowck_mutable_exclusivity_candidate_build_steps - steps <= count_paths * 3, "actual reads candidate visits and construction bounded")
}

task borrow_candidate_scaling() -> void {
    pilot mir = v4_mir_file_new(41, -1)
    pilot borrow = v4_borrowck_file_new(41, mir)
    borrow_candidate_scaling_case(mir, borrow, 64, false)
    pilot reads64 = borrow_candidate_last_reads
    borrow_candidate_scaling_case(mir, borrow, 128, false)
    pilot reads128 = borrow_candidate_last_reads
    borrow_candidate_scaling_case(mir, borrow, 256, false)
    borrow_candidate_assert(reads128 <= reads64 * 2 + 2 and borrow_candidate_last_reads <= reads128 * 2 + 2, "bounded-block doubling")
    borrow_candidate_scaling_case(mir, borrow, 64, true)
    reads64 = borrow_candidate_last_reads
    borrow_candidate_scaling_case(mir, borrow, 128, true)
    borrow_candidate_assert(borrow_candidate_last_reads <= reads64 * 2 + 2, "fixed-loan irrelevant-path doubling")
    say "borrow-candidate scaling=true fixed-loans=true actual-reader-doubling=true"
}

task borrow_candidate_source() -> word {
    -- Character-built delimiters keep bootstrap Word interpolation out of the
    -- generated source. Statement boundaries remain ordinary physical lines.
    pilot open: word = chr(123)
    pilot close: word = chr(125)
    pilot src = "shape Ship " + open + "\n    hp: int\n" + close + "\n"
    src = src + "task loan<'a>(lend 'a ship: Ship) -> lend 'a Ship " + open + "\n    give back lend ship\n" + close + "\n"
    src = src + "task same(ship: Ship) -> int " + open + "\n"
    src = src + "    ship\n    ship.hp = 7\n    give back ship.hp\n" + close + "\n"
    src = src + "task cross(ship: Ship, ready: bool) -> int " + open + "\n"
    src = src + "    if ready " + open + "\n        ship\n    " + close + "\n"
    src = src + "    ship.hp = 7\n    give back ship.hp\n" + close + "\n"
    src = src + "task explicit(ship: Ship, ready: bool) -> int " + open + "\n"
    src = src + "    pilot view = lend ship\n    if ready " + open + "\n        ship.hp = 7\n    " + close + "\n"
    src = src + "    give back view.hp\n" + close + "\n"
    src = src + "task aggregate(ship: Ship, ready: bool) -> int " + open + "\n"
    src = src + "    pilot holder = (lend ship, 0)\n    if ready " + open + "\n        ship.hp = 7\n    " + close + "\n"
    src = src + "    give back holder.0.hp\n" + close + "\n"
    src = src + "task call(ship: Ship, ready: bool) -> int " + open + "\n"
    src = src + "    pilot view = loan(lend ship)\n    if ready " + open + "\n        ship.hp = 7\n    " + close + "\n"
    src = src + "    give back view.hp\n" + close + "\n"
    src = src + "task closure(ship: Ship, ready: bool) -> int " + open + "\n"
    src = src + "    pilot reader = |_| => ship.hp\n    if ready " + open + "\n        ship.hp = 7\n    " + close + "\n"
    src = src + "    give back reader()\n" + close + "\n"
    src = src + "task rebind(first: Ship, second: Ship) -> int " + open + "\n"
    src = src + "    pilot view = lend first\n    view = lend second\n    first.hp = 7\n    give back view.hp\n" + close + "\n"
    src = src + "task looped(ship: Ship, ready: bool) -> int " + open + "\n"
    src = src + "    pilot view = lend ship\n    repeat while ready " + open + "\n        ship.hp = 7\n        ready = false\n    " + close + "\n"
    src = src + "    give back view.hp\n" + close + "\n"
    src = src + "task symbolic(items: [int; 2], slot: int) -> int " + open + "\n"
    src = src + "    pilot view = lend items\n    items[slot] = 7\n    give back view[0]\n" + close + "\n"
    give back src
}

task borrow_candidate_semantic_case(borrow: int, mir: int, name: word, expected: int) -> void {
    pilot body = v4_mir_lookup_body_name(mir, name)
    borrow_candidate_assert(body >= 0, "authored body " + name)
    pilot result_id = v4_borrowck_add_result(borrow, v4_mir_body_def(mir, body), name, v4_borrowck_clean, -19, 7, 11)
    v4_borrowck_collect_body_paths(borrow, result_id, mir, body)
    borrow_candidate_pad(borrow, result_id, 64)
    pilot builds = v4_borrowck_mutable_exclusivity_candidate_builds
    borrow_candidate_compare(borrow, result_id, mir, body, expected)
    borrow_candidate_assert(v4_borrowck_mutable_exclusivity_candidate_builds == builds + 1, "authored case exercises candidates " + name)
}

task borrow_candidate_frontend_context(mir: int, ty: int, hir: int) -> void {
    pilot resolved = v4_ty_resolve_id(ty)
    pilot tree = v4_hir_tree_id(hir)
    pilot stage = 0
    repeat until stage >= 5 {
        pilot name: word = "parse"
        pilot count = v4_parse_diag_count(tree)
        if stage == 1 { name = "hir"; count = v4_hir_diag_count(hir) }
        if stage == 2 { name = "resolve"; count = v4_resolve_diag_count(resolved) }
        if stage == 3 { name = "ty"; count = v4_ty_diag_count(ty) }
        if stage == 4 { name = "mir"; count = v4_mir_diag_count(mir) }
        pilot row = 0
        repeat until row >= count {
            pilot diag: word = v4_parse_diag(tree, row)
            if stage == 1 { diag = v4_hir_diag(hir, row) }
            if stage == 2 { diag = v4_resolve_diag(resolved, row) }
            if stage == 3 { diag = v4_ty_diag(ty, row) }
            if stage == 4 { diag = v4_mir_diag(mir, row) }
            say "borrow-candidate frontend " + name + " " + v4_diag_span(diag) + " " + v4_diag_message(diag) + " " + v4_diag_help(diag)
            row += 1
        }
        stage += 1
    }
}

task borrow_candidate_semantics() -> void {
    -- Exactly one complete front-end pipeline in this process.
    pilot mir = v4_mir_text_cached("borrow-candidate-authored.fk", borrow_candidate_source())
    pilot ty = v4_mir_ty_id(mir)
    pilot hir = v4_resolve_hir_id(v4_ty_resolve_id(ty))
    pilot frontend_clean = v4_parse_diag_count(v4_hir_tree_id(hir)) == 0 and v4_hir_diag_count(hir) == 0 and v4_resolve_diag_count(v4_ty_resolve_id(ty)) == 0 and v4_ty_diag_count(ty) == 0 and v4_mir_diag_count(mir) == 0
    if not frontend_clean { borrow_candidate_frontend_context(mir, ty, hir) }
    borrow_candidate_assert(frontend_clean, "authored front end")
    pilot borrow = v4_borrowck_file_new(42, mir)
    v4_borrowck_provenance_scratch_reset()
    borrow_candidate_semantic_case(borrow, mir, "same", 1)
    borrow_candidate_semantic_case(borrow, mir, "cross", 1)
    borrow_candidate_semantic_case(borrow, mir, "explicit", 1)
    borrow_candidate_semantic_case(borrow, mir, "aggregate", 1)
    borrow_candidate_semantic_case(borrow, mir, "call", 1)
    borrow_candidate_semantic_case(borrow, mir, "closure", 1)
    borrow_candidate_semantic_case(borrow, mir, "rebind", 0)
    borrow_candidate_semantic_case(borrow, mir, "looped", 1)
    borrow_candidate_semantic_case(borrow, mir, "symbolic", 1)
    say "borrow-candidate authored=true expression=true explicit=true aggregate=true call=true closure=true"
    say "borrow-candidate rebind=true loop=true symbolic-index=true exact-reference-diagnostics=true"
}

task borrow_candidate_available_handles() -> int {
    pilot holders = array_new()
    pilot count = 0
    pilot exhausted = false
    repeat until count >= 2048 or exhausted {
        pilot handle = array_new()
        if handle < 0 { exhausted = true } else { array_push(holders, word_from_int(handle)); count += 1 }
    }
    pilot index = 0
    repeat until index >= count {
        array_release(word_to_int(array_get(holders, index)))
        index += 1
    }
    array_release(holders)
    give back count
}

task borrow_candidate_resource_case(mir: int, borrow: int, body: int) -> void {
    pilot result_id = v4_borrowck_add_result(borrow, "resource", "resource", v4_borrowck_clean, 999, 7, 11)
    v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_loan, "source", 0, 0)
    pilot row = 0
    repeat until row >= 64 {
        v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_write, "other", 1, 0)
        row += 1
    }
    -- Warm semantic readers before measuring request-scoped handle ownership.
    borrow_candidate_assert(v4_borrowck_check_mutable_exclusivity(borrow, result_id, mir, body) == 0, "warm request")
    pilot available = borrow_candidate_available_handles()
    pilot round = 0
    repeat until round >= 16 {
        borrow_candidate_assert(v4_borrowck_check_mutable_exclusivity(borrow, result_id, mir, body) == 0 and borrow_candidate_available_handles() == available, "scratch released after request")
        round += 1
    }
    pilot holders = array_new()
    pilot held = 0
    pilot exhausted = false
    repeat until held >= 2048 or exhausted {
        pilot handle = array_new()
        if handle < 0 { exhausted = true } else { array_push(holders, word_from_int(handle)); held += 1 }
    }
    borrow_candidate_assert(exhausted, "real capped-runtime exhaustion")
    pilot fallbacks = v4_borrowck_mutable_exclusivity_candidate_fallbacks
    pilot builds = v4_borrowck_mutable_exclusivity_candidate_builds
    pilot reads = v4_borrowck_path_kind_reads
    borrow_candidate_assert(v4_borrowck_check_mutable_exclusivity(borrow, result_id, mir, body) == 0 and v4_borrowck_mutable_exclusivity_candidate_fallbacks == fallbacks + 1 and v4_borrowck_mutable_exclusivity_candidate_builds == builds and v4_borrowck_path_kind_reads - reads > 4096 and v4_borrowck_result_status(borrow, result_id) == v4_borrowck_clean and v4_borrowck_result_loans(borrow, result_id) == 999, "original scanner and authoritative facts under exhaustion")
    row = 0
    repeat until row >= held {
        array_release(word_to_int(array_get(holders, row)))
        row += 1
    }
    array_release(holders)
    reads = v4_borrowck_path_kind_reads
    borrow_candidate_assert(v4_borrowck_check_mutable_exclusivity(borrow, result_id, mir, body) == 0 and v4_borrowck_mutable_exclusivity_candidate_builds == builds + 1 and v4_borrowck_path_kind_reads - reads < 256 and borrow_candidate_available_handles() == available, "recovered request releases scratch")
}

task borrow_candidate_resources() -> void {
    pilot mir = v4_mir_file_new(43, -1)
    pilot body = v4_mir_add_body(mir, "resources", "resources", "")
    -- add_body already owns physical entry block 0. Append its successor,
    -- then replace the entry through MIR's normal live-construction setter.
    pilot exit_block = v4_mir_add_block(mir, body, v4_mir_term_return, -1, -1, "")
    v4_mir_set_body_block(mir, body, 0, v4_mir_block_new_full(0, v4_mir_term_goto, exit_block, -1, ""))
    borrow_candidate_assert(exit_block == 1 and v4_mir_body_block_count(mir, body) == 2 and v4_borrowck_block_reaches(mir, body, 0, 1) and not v4_borrowck_block_can_cycle(mir, body, 0), "physical entry reaches successor without a loop")
    pilot simple = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_binary, "source + 1", v4_mir_bin_add, -1, -1, V4_NO_SPAN, v4_ty_int)
    pilot literal = v4_mir_add_rvalue(mir, body, v4_mir_rvalue_const_int, "1", "", -1, -1, V4_NO_SPAN, v4_ty_int)
    v4_mir_add_stmt(mir, body, 0, v4_mir_stmt_assign, "other", "source + 1", v4_span_new("43", 0, 1), -1, simple)
    v4_mir_add_stmt(mir, body, 0, v4_mir_stmt_expr, "", "source", v4_span_new("43", 1, 2), -1, literal)
    v4_mir_add_stmt(mir, body, 1, v4_mir_stmt_assign, "other", "1", v4_span_new("43", 2, 3), -1, literal)
    v4_mir_add_stmt(mir, body, 1, v4_mir_stmt_assign, "other", "source + 1", v4_span_new("43", 3, 4), -1, simple)
    v4_mir_add_stmt(mir, body, 1, v4_mir_stmt_assign, "source.hp", "1", v4_span_new("43", 4, 5), -1, literal)
    pilot borrow = v4_borrowck_file_new(43, mir)
    pilot result_id = v4_borrowck_add_result(borrow, "ordered", "ordered", v4_borrowck_clean, -19, 7, 11)
    v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_loan, "source", 3, 1)
    v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_loan_mut, "source", 1, 0)
    v4_borrowck_add_path(borrow, result_id, v4_borrowck_path_write, "source.hp", 4, 1)
    borrow_candidate_pad(borrow, result_id, 64)
    pilot start = v4_borrowck_diag_count(borrow)
    borrow_candidate_compare(borrow, result_id, mir, body, 1)
    borrow_candidate_assert(v4_diag_span(v4_borrowck_diag(borrow, start)) == v4_span_new("43", 4, 5) and v4_diag_help(v4_borrowck_diag(borrow, start)) == "source stays on loan in block 1 from statement 3, so statement 4 cannot rewrite source.hp yet", "local before global physical diagnostic")
    -- Direct replacement changes the winning chain with no persistent cache.
    v4_borrowck_restore_path_slot(borrow, result_id, 0, v4_borrowck_path_loan_mut, "source", 1, 0)
    v4_borrowck_restore_path_slot(borrow, result_id, 1, v4_borrowck_path_loan, "source", 3, 1)
    v4_borrowck_set_result_status(borrow, result_id, v4_borrowck_clean)
    start = v4_borrowck_diag_count(borrow)
    borrow_candidate_compare(borrow, result_id, mir, body, 1)
    borrow_candidate_assert(v4_diag_message(v4_borrowck_diag(borrow, start)) == "Meiya tracks this loan into a later block" and v4_diag_help(v4_borrowck_diag(borrow, start)) == "source stays on loan from block 0 into block 1 after statement 1, so statement 4 cannot rewrite source.hp yet", "global before local physical diagnostic")
    -- Sparse, negative, mismatched and unknown restored coordinates remain
    -- conservative candidates; loose summary counts are never admission facts.
    v4_borrowck_restore_path_slot(borrow, result_id, 0, v4_borrowck_path_loan, "source[i]", -1, -1)
    v4_borrowck_restore_path_slot(borrow, result_id, 1, v4_borrowck_path_loan_mut, "source", 3, 0)
    v4_borrowck_restore_path_slot(borrow, result_id, 31, v4_borrowck_path_loan, "source", 999999, 999999)
    v4_borrowck_restore_path_slot(borrow, result_id, 63, "LoanMut ", "source", 1, 0)
    v4_borrowck_restore_path_slot(borrow, result_id, 2, v4_borrowck_path_write, "unrelated", 4, 1)
    v4_borrowck_set_result_status(borrow, result_id, v4_borrowck_clean)
    v4_borrowck_set_result_counts(borrow, result_id, 999, -7, -11)
    borrow_candidate_compare(borrow, result_id, mir, body, 0)
    pilot payload = v4_borrowck_snapshot_header() + "\n" + v4_borrowck_snapshot_file_line(borrow) + "\n" + v4_borrowck_snapshot_result_line(borrow, result_id) + "\n"
    payload = payload + "borrowck-path|" + word_from_int(borrow) + "|0|63|Loan|source[i]|-1|-1\n"
    payload = payload + "borrowck-path|" + word_from_int(borrow) + "|0|2|Write|other|4|1\n"
    payload = payload + "borrowck-path|" + word_from_int(borrow) + "|0|63|LoanMut|source[i]|1|0\nend|" + v4_borrowck_snapshot_format
    borrow_candidate_assert(v4_borrowck_snapshot_restore(payload).starts_with("borrowck-snapshot-restore ok=1") and v4_borrowck_result_path_count(borrow, 0) == 64 and v4_borrowck_path_kind(borrow, 0, 63) == v4_borrowck_path_loan_mut and v4_borrowck_path_stmt(borrow, 0, 63) == 1, "accepted reordered sparse overwritten wire rows")
    borrow_candidate_compare(borrow, 0, mir, body, 0)
    pilot before = v4_borrowck_snapshot()
    pilot generation = v4_borrowck_provenance_scratch_generation()
    pilot builds = v4_borrowck_mutable_exclusivity_candidate_builds
    borrow_candidate_assert(v4_borrowck_snapshot_restore(before + "\nborrowck-path").starts_with("borrowck-snapshot-restore ok=0") and v4_borrowck_snapshot() == before and v4_borrowck_provenance_scratch_generation() == generation and v4_borrowck_mutable_exclusivity_candidate_builds == builds, "rejected restore atomic facts generation and candidates")
    borrow_candidate_resource_case(mir, borrow, body)
    say "borrow-candidate physical-merge=true cold-overwrite=true malformed=true restored=true atomic-rejection=true"
    say "borrow-candidate scratch-released=true exhausted-fallback=true recovered=true"
}

pilot borrow_candidate_mode = process::arg(1)
if borrow_candidate_mode == "1" { borrow_candidate_semantics() } else if borrow_candidate_mode == "2" { borrow_candidate_resources() } else { borrow_candidate_scaling() }
