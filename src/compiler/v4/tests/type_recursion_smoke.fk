-- V4 direct type recursion smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_type_recursion_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_type_recursion_source() -> word {
    pilot src = "shape Direct {\n"
    src = src + "    next: Direct\n"
    src = src + "}\n"
    src = src + "shape Left {\n"
    src = src + "    right: Right\n"
    src = src + "}\n"
    src = src + "shape Right {\n"
    src = src + "    left: Left\n"
    src = src + "}\n"
    src = src + "shape InlineBox<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape GenericNode {\n"
    src = src + "    box: InlineBox<GenericNode>\n"
    src = src + "}\n"
    src = src + "alias GenericAlias = Box<Node>\n"
    src = src + "shape Node {\n"
    src = src + "    bad: Box<GenericAlias>\n"
    src = src + "}\n"
    src = src + "alias AliasNode = AliasHolder\n"
    src = src + "shape AliasHolder {\n"
    src = src + "    next: AliasNode\n"
    src = src + "}\n"
    src = src + "alias DeepA1 = DeepA2\n"
    src = src + "alias DeepA2 = DeepA3\n"
    src = src + "alias DeepA3 = DeepA4\n"
    src = src + "alias DeepA4 = DeepA5\n"
    src = src + "alias DeepA5 = DeepA6\n"
    src = src + "alias DeepA6 = DeepA7\n"
    src = src + "alias DeepA7 = DeepA8\n"
    src = src + "alias DeepA8 = DeepA9\n"
    src = src + "alias DeepA9 = DeepA10\n"
    src = src + "alias DeepA10 = DeepNode\n"
    src = src + "shape DeepNode {\n"
    src = src + "    next: DeepA1\n"
    src = src + "}\n"
    src = src + "alias BadAlias = Box<BadAlias>\n"
    src = src + "variant BadRoute {\n"
    src = src + "    Branch " + v4_type_recursion_braces(" child: BadRoute ") + "\n"
    src = src + "    Leaf\n"
    src = src + "}\n"
    src = src + "variant GenericRoute {\n"
    src = src + "    Wrap " + v4_type_recursion_braces(" inner: InlineBox<GenericRoute> ") + "\n"
    src = src + "    Done\n"
    src = src + "}\n"
    src = src + "shape SafeNode {\n"
    src = src + "    next: Shared<SafeNode>\n"
    src = src + "    weak: Weak<SafeNode>\n"
    src = src + "    many: List<SafeNode>\n"
    src = src + "    raw: *SafeNode\n"
    src = src + "}\n"
    src = src + "variant SafeTree {\n"
    src = src + "    Branch " + v4_type_recursion_braces(" left: Shared<SafeTree>, rest: List<SafeTree>, raw: *SafeTree ") + "\n"
    src = src + "    Leaf\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_type_recursion_shadow_source() -> word {
    pilot src = "shape Shared<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape ShadowNode {\n"
    src = src + "    next: Shared<ShadowNode>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_type_recursion_import_source() -> word {
    pilot src = "shape util::ImportedNode {\n"
    src = src + "    next: ImportedNode\n"
    src = src + "}\n"
    src = src + "use util::ImportedNode as ImportedNode\n"
    src = src + "shape util::Shared<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "use util::Shared as Shared\n"
    src = src + "shape ImportShadowNode {\n"
    src = src + "    next: Shared<ImportShadowNode>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_type_recursion_alias_erased_source() -> word {
    pilot src = "alias Ignore<T> = int\n"
    src = src + "alias GoodAlias = Ignore<GoodAlias>\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_type_recursion_generic_growth_source() -> word {
    pilot src = "shape Wrap<T> {\n"
    src = src + "    next: Wrap<List<T>>\n"
    src = src + "}\n"
    src = src + "shape Holder {\n"
    src = src + "    w: Wrap<Holder>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_type_recursion_generic_shadow_source() -> word {
    pilot src = "shape Node<Node> {\n"
    src = src + "    value: Node\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_type_recursion_import_local_source() -> word {
    pilot src = "shape Node {\n"
    src = src + "    next: Node\n"
    src = src + "}\n"
    src = src + "shape util::Node {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "use util::Node as Node\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_type_recursion_stream = v4_lex_text(0, v4_type_recursion_source())
pilot v4_type_recursion_tree = v4_parse_stream(0, v4_type_recursion_stream)
pilot v4_type_recursion_hir = v4_hir_lower_tree(0, v4_type_recursion_tree)
pilot v4_type_recursion_resolve = v4_resolve_lower_hir(0, v4_type_recursion_hir)
pilot v4_type_recursion_ty = v4_ty_lower_resolve(0, v4_type_recursion_resolve)
pilot v4_type_recursion_mir = v4_mir_lower_ty(0, v4_type_recursion_ty)

pilot v4_type_recursion_shadow_stream = v4_lex_text(1, v4_type_recursion_shadow_source())
pilot v4_type_recursion_shadow_tree = v4_parse_stream(1, v4_type_recursion_shadow_stream)
pilot v4_type_recursion_shadow_hir = v4_hir_lower_tree(1, v4_type_recursion_shadow_tree)
pilot v4_type_recursion_shadow_resolve = v4_resolve_lower_hir(1, v4_type_recursion_shadow_hir)
pilot v4_type_recursion_shadow_ty = v4_ty_lower_resolve(1, v4_type_recursion_shadow_resolve)
pilot v4_type_recursion_shadow_mir = v4_mir_lower_ty(1, v4_type_recursion_shadow_ty)

pilot v4_type_recursion_import_stream = v4_lex_text(2, v4_type_recursion_import_source())
pilot v4_type_recursion_import_tree = v4_parse_stream(2, v4_type_recursion_import_stream)
pilot v4_type_recursion_import_hir = v4_hir_lower_tree(2, v4_type_recursion_import_tree)
pilot v4_type_recursion_import_resolve = v4_resolve_lower_hir(2, v4_type_recursion_import_hir)
pilot v4_type_recursion_import_ty = v4_ty_lower_resolve(2, v4_type_recursion_import_resolve)
pilot v4_type_recursion_import_mir = v4_mir_lower_ty(2, v4_type_recursion_import_ty)

pilot v4_type_recursion_alias_erased_tree = v4_parse_stream(3, v4_lex_text(3, v4_type_recursion_alias_erased_source()))
pilot v4_type_recursion_alias_erased_hir = v4_hir_lower_tree(3, v4_type_recursion_alias_erased_tree)
pilot v4_type_recursion_alias_erased_resolve = v4_resolve_lower_hir(3, v4_type_recursion_alias_erased_hir)
pilot v4_type_recursion_alias_erased_ty = v4_ty_lower_resolve(3, v4_type_recursion_alias_erased_resolve)
pilot v4_type_recursion_alias_erased_mir = v4_mir_lower_ty(3, v4_type_recursion_alias_erased_ty)

pilot v4_type_recursion_generic_growth_tree = v4_parse_stream(4, v4_lex_text(4, v4_type_recursion_generic_growth_source()))
pilot v4_type_recursion_generic_growth_hir = v4_hir_lower_tree(4, v4_type_recursion_generic_growth_tree)
pilot v4_type_recursion_generic_growth_resolve = v4_resolve_lower_hir(4, v4_type_recursion_generic_growth_hir)
pilot v4_type_recursion_generic_growth_ty = v4_ty_lower_resolve(4, v4_type_recursion_generic_growth_resolve)
pilot v4_type_recursion_generic_growth_mir = v4_mir_lower_ty(4, v4_type_recursion_generic_growth_ty)

pilot v4_type_recursion_generic_shadow_tree = v4_parse_stream(5, v4_lex_text(5, v4_type_recursion_generic_shadow_source()))
pilot v4_type_recursion_generic_shadow_hir = v4_hir_lower_tree(5, v4_type_recursion_generic_shadow_tree)
pilot v4_type_recursion_generic_shadow_resolve = v4_resolve_lower_hir(5, v4_type_recursion_generic_shadow_hir)
pilot v4_type_recursion_generic_shadow_ty = v4_ty_lower_resolve(5, v4_type_recursion_generic_shadow_resolve)
pilot v4_type_recursion_generic_shadow_mir = v4_mir_lower_ty(5, v4_type_recursion_generic_shadow_ty)

pilot v4_type_recursion_import_local_tree = v4_parse_stream(6, v4_lex_text(6, v4_type_recursion_import_local_source()))
pilot v4_type_recursion_import_local_hir = v4_hir_lower_tree(6, v4_type_recursion_import_local_tree)
pilot v4_type_recursion_import_local_resolve = v4_resolve_lower_hir(6, v4_type_recursion_import_local_hir)
pilot v4_type_recursion_import_local_ty = v4_ty_lower_resolve(6, v4_type_recursion_import_local_resolve)
pilot v4_type_recursion_import_local_mir = v4_mir_lower_ty(6, v4_type_recursion_import_local_ty)

say "type-recursion-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_tree))
say "type-recursion-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_ty))
say "type-recursion-safe-shared-path=" + v4_ty_type_recursion_path_in_type(v4_type_recursion_ty, "SafeNode", "Shared<SafeNode>", "SafeNode")
say "type-recursion-safe-weak-path=" + v4_ty_type_recursion_path_in_type(v4_type_recursion_ty, "SafeNode", "Weak<SafeNode>", "SafeNode")
say "type-recursion-safe-list-path=" + v4_ty_type_recursion_path_in_type(v4_type_recursion_ty, "SafeNode", "List<SafeNode>", "SafeNode")
say "type-recursion-safe-raw-path=" + v4_ty_type_recursion_path_in_type(v4_type_recursion_ty, "SafeNode", "*SafeNode", "SafeNode")

pilot v4_type_recursion_diag_idx = 0
repeat until v4_type_recursion_diag_idx >= v4_ty_diag_count(v4_type_recursion_ty) {
    pilot v4_type_recursion_diag = v4_ty_diag(v4_type_recursion_ty, v4_type_recursion_diag_idx)
    say "type-recursion-diag" + word_from_int(v4_type_recursion_diag_idx) + "=" + v4_diag_message(v4_type_recursion_diag)
    say "type-recursion-diag" + word_from_int(v4_type_recursion_diag_idx) + "-span=" + v4_diag_span(v4_type_recursion_diag)
    v4_type_recursion_diag_idx += 1
}

say "type-recursion-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_mir))

say "type-recursion-shadow-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_shadow_tree))
say "type-recursion-shadow-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_shadow_ty))
pilot v4_type_recursion_shadow_diag = v4_ty_diag(v4_type_recursion_shadow_ty, 0)
say "type-recursion-shadow-diag0=" + v4_diag_message(v4_type_recursion_shadow_diag)
say "type-recursion-shadow-diag0-span=" + v4_diag_span(v4_type_recursion_shadow_diag)
say "type-recursion-shadow-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_shadow_mir))

say "type-recursion-import-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_import_tree))
say "type-recursion-import-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_import_ty))
pilot v4_type_recursion_import_diag_idx = 0
repeat until v4_type_recursion_import_diag_idx >= v4_ty_diag_count(v4_type_recursion_import_ty) {
    pilot v4_type_recursion_import_diag = v4_ty_diag(v4_type_recursion_import_ty, v4_type_recursion_import_diag_idx)
    say "type-recursion-import-diag" + word_from_int(v4_type_recursion_import_diag_idx) + "=" + v4_diag_message(v4_type_recursion_import_diag)
    say "type-recursion-import-diag" + word_from_int(v4_type_recursion_import_diag_idx) + "-span=" + v4_diag_span(v4_type_recursion_import_diag)
    v4_type_recursion_import_diag_idx += 1
}
say "type-recursion-import-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_import_mir))

say "type-recursion-alias-erased-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_alias_erased_tree))
say "type-recursion-alias-erased-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_alias_erased_ty))
say "type-recursion-alias-erased-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_alias_erased_mir))

say "type-recursion-generic-growth-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_generic_growth_tree))
say "type-recursion-generic-growth-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_generic_growth_ty))
pilot v4_type_recursion_generic_growth_diag_idx = 0
repeat until v4_type_recursion_generic_growth_diag_idx >= v4_ty_diag_count(v4_type_recursion_generic_growth_ty) {
    pilot v4_type_recursion_generic_growth_diag = v4_ty_diag(v4_type_recursion_generic_growth_ty, v4_type_recursion_generic_growth_diag_idx)
    say "type-recursion-generic-growth-diag" + word_from_int(v4_type_recursion_generic_growth_diag_idx) + "=" + v4_diag_message(v4_type_recursion_generic_growth_diag)
    say "type-recursion-generic-growth-diag" + word_from_int(v4_type_recursion_generic_growth_diag_idx) + "-span=" + v4_diag_span(v4_type_recursion_generic_growth_diag)
    v4_type_recursion_generic_growth_diag_idx += 1
}
say "type-recursion-generic-growth-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_generic_growth_mir))

say "type-recursion-generic-shadow-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_generic_shadow_tree))
say "type-recursion-generic-shadow-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_generic_shadow_ty))
pilot v4_type_recursion_generic_shadow_diag = v4_ty_diag(v4_type_recursion_generic_shadow_ty, 0)
say "type-recursion-generic-shadow-diag0=" + v4_diag_message(v4_type_recursion_generic_shadow_diag)
say "type-recursion-generic-shadow-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_generic_shadow_mir))

say "type-recursion-import-local-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_type_recursion_import_local_tree))
say "type-recursion-import-local-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_type_recursion_import_local_ty))
pilot v4_type_recursion_import_local_diag = v4_ty_diag(v4_type_recursion_import_local_ty, 0)
say "type-recursion-import-local-diag0=" + v4_diag_message(v4_type_recursion_import_local_diag)
say "type-recursion-import-local-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_type_recursion_import_local_mir))
