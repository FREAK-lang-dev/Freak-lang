task v4_alias_nominality_inherent_source() -> word {
    pilot src = "shape Box {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "alias Name = Box\n"
    src = src + "impl Name {\n"
    src = src + "    task get(self) -> int {\n"
    src = src + "        give back 7\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

pilot v4_alias_nominality_bad_text = v4_alias_nominality_bad_source()
pilot v4_alias_nominality_bad_stream = v4_lex_text(0, v4_alias_nominality_bad_text)
pilot v4_alias_nominality_bad_tree = v4_parse_stream(0, v4_alias_nominality_bad_stream)
pilot v4_alias_nominality_bad_hir = v4_hir_lower_tree(0, v4_alias_nominality_bad_tree)
pilot v4_alias_nominality_bad_resolve = v4_resolve_lower_hir(0, v4_alias_nominality_bad_hir)
pilot v4_alias_nominality_bad_ty = v4_ty_lower_resolve(0, v4_alias_nominality_bad_resolve)
pilot v4_alias_nominality_bad_mir = v4_mir_lower_ty(0, v4_alias_nominality_bad_ty)

