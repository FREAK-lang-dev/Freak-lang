-- V4 alias nominality smoke fixture.
-- expected aggregate marker: alias-nominality-diagnostics=1
-- expected method marker: alias-nominality-bad-method-ref-empty=true
-- expected import marker: alias-nominality-imported-ty-diagnostics=1
-- expected glob marker: alias-nominality-glob-ty-diagnostics=1
-- expected inherent marker: alias-nominality-inherent-name-method-ref-present=true
-- Verification prepends the V4 crates before this file.

task v4_alias_nominality_bool_text(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_alias_nominality_bad_source() -> word {
    pilot src = "doctrine Display {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "alias Name = int\n"
    src = src + "impl Display for Name {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back \"bad\"\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_alias_nominality_shape_source() -> word {
    pilot src = "doctrine Display {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "shape Name {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "impl Display for Name {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back \"shape\"\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

