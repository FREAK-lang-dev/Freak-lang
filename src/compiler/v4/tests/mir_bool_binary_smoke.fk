pilot v4_mir_bad_and_source = v4_mir_bad_and_make_source()
pilot v4_mir_bad_and_stream = v4_lex_text(1, v4_mir_bad_and_source)
pilot v4_mir_bad_and_tree = v4_parse_stream(1, v4_mir_bad_and_stream)
pilot v4_mir_bad_and_hir = v4_hir_lower_tree(1, v4_mir_bad_and_tree)
