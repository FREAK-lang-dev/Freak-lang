-- V4 MIR boolean short-circuit smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_bool_binary_find_nth_stmt_with_lhs(mir_id: int, body_id: int, wanted_kind: word, wanted_lhs: word, wanted_ordinal: int) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    pilot seen = 0
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == wanted_kind and v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == wanted_lhs {
            seen += 1
            if seen == wanted_ordinal {
                give back stmt_id
            }
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_mir_bool_binary_make_source() -> word {
    pilot src = "task calc(left: bool, right: bool, power: int) -> bool {\n"
    src = src + "    pilot both: bool = left and right\n"
    src = src + "    pilot either: bool = left or right\n"
    src = src + "    pilot guarded: bool = power > 4 and both\n"
    src = src + "    give back either\n"
    src = src + "}\n"
    give back src
}

task v4_mir_bad_and_make_source() -> word {
    pilot src = "task bad_and() -> bool {\n"
    src = src + "    pilot x: bool = true and 1\n"
    src = src + "    give back true\n"
    src = src + "}\n"
    give back src
}

task v4_mir_bad_or_make_source() -> word {
    pilot src = "task bad_or() -> bool {\n"
    src = src + "    pilot x: bool = \"nope\" or false\n"
    src = src + "    give back true\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_bool_binary_source = v4_mir_bool_binary_make_source()
pilot v4_mir_bool_binary_stream = v4_lex_text(0, v4_mir_bool_binary_source)
pilot v4_mir_bool_binary_tree = v4_parse_stream(0, v4_mir_bool_binary_stream)
pilot v4_mir_bool_binary_hir = v4_hir_lower_tree(0, v4_mir_bool_binary_tree)
pilot v4_mir_bool_binary_resolve = v4_resolve_lower_hir(0, v4_mir_bool_binary_hir)
pilot v4_mir_bool_binary_ty = v4_ty_lower_resolve(0, v4_mir_bool_binary_resolve)
pilot v4_mir_bool_binary_mir = v4_mir_lower_ty(0, v4_mir_bool_binary_ty)
pilot v4_mir_bool_binary_calc_def = v4_resolve_def_for_name(v4_mir_bool_binary_resolve, "calc")
pilot v4_mir_bool_binary_calc_body = v4_mir_lookup_body(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_def)

pilot v4_mir_bool_binary_both_stmt = v4_mir_bool_binary_find_nth_stmt_with_lhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_local, "both", 1)
pilot v4_mir_bool_binary_either_stmt = v4_mir_bool_binary_find_nth_stmt_with_lhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_local, "either", 1)
pilot v4_mir_bool_binary_guarded_stmt = v4_mir_bool_binary_find_nth_stmt_with_lhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_local, "guarded", 1)
pilot v4_mir_bool_binary_left_and_branch = v4_mir_bool_binary_find_nth_stmt_with_lhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_branch, "left", 1)
pilot v4_mir_bool_binary_left_or_branch = v4_mir_bool_binary_find_nth_stmt_with_lhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_branch, "left", 2)
pilot v4_mir_bool_binary_guard_branch = v4_mir_bool_binary_find_nth_stmt_with_lhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_branch, "power > 4", 1)

pilot v4_mir_bool_binary_both_rvalue = v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_both_stmt)
pilot v4_mir_bool_binary_either_rvalue = v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_either_stmt)
pilot v4_mir_bool_binary_guarded_rvalue = v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guarded_stmt)

pilot v4_mir_bool_binary_left_and_block = v4_mir_body_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_and_branch))
pilot v4_mir_bool_binary_left_or_block = v4_mir_body_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_or_branch))
pilot v4_mir_bool_binary_guard_block = v4_mir_body_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guard_branch))

say v4_mir_summary(v4_mir_bool_binary_mir)
say "bool-binary-body-blocks=" + word_from_int(v4_mir_body_block_count(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body))
say "bool-binary-body-stmts=" + word_from_int(v4_mir_body_stmt_count(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body))
say "bool-binary-body-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body))
say "bool-binary-local0-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 0)
say "bool-binary-local0-ty=" + v4_mir_local_ty(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 0)
say "bool-binary-local3-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 3)
say "bool-binary-local3-ty=" + v4_mir_local_ty(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 3)
say "bool-binary-local4-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 4)
say "bool-binary-local5-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 5)
say "bool-binary-local6-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 6)
say "bool-binary-local7-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 7)
say "bool-binary-local8-name=" + v4_mir_local_name(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, 8)
say "bool-binary-both-block=" + word_from_int(v4_mir_stmt_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_both_stmt))
say "bool-binary-both-kind=" + v4_mir_rvalue_kind(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_both_rvalue)
say "bool-binary-both-op=" + v4_mir_rvalue_op(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_both_rvalue)
say "bool-binary-both-ty=" + v4_mir_rvalue_ty(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_both_rvalue)
say "bool-binary-either-block=" + word_from_int(v4_mir_stmt_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_either_stmt))
say "bool-binary-either-kind=" + v4_mir_rvalue_kind(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_either_rvalue)
say "bool-binary-either-op=" + v4_mir_rvalue_op(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_either_rvalue)
say "bool-binary-either-ty=" + v4_mir_rvalue_ty(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_either_rvalue)
say "bool-binary-guarded-block=" + word_from_int(v4_mir_stmt_block(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guarded_stmt))
say "bool-binary-guarded-kind=" + v4_mir_rvalue_kind(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guarded_rvalue)
say "bool-binary-guarded-op=" + v4_mir_rvalue_op(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guarded_rvalue)
say "bool-binary-guarded-ty=" + v4_mir_rvalue_ty(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guarded_rvalue)
say "bool-binary-left-and-block-cond=" + v4_mir_block_condition(v4_mir_bool_binary_left_and_block)
say "bool-binary-left-and-branch-rhs=" + v4_mir_stmt_rhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_and_branch)
say "bool-binary-left-and-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_and_branch))
say "bool-binary-left-and-rvalue-op=" + v4_mir_rvalue_op(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_and_branch))
say "bool-binary-left-or-block-cond=" + v4_mir_block_condition(v4_mir_bool_binary_left_or_block)
say "bool-binary-left-or-branch-rhs=" + v4_mir_stmt_rhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_or_branch)
say "bool-binary-left-or-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_or_branch))
say "bool-binary-left-or-rvalue-op=" + v4_mir_rvalue_op(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_left_or_branch))
say "bool-binary-guard-branch-cond=" + v4_mir_block_condition(v4_mir_bool_binary_guard_block)
say "bool-binary-guard-branch-rhs=" + v4_mir_stmt_rhs(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guard_branch)
say "bool-binary-guard-branch-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guard_branch))
say "bool-binary-guard-branch-rvalue-op=" + v4_mir_rvalue_op(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_stmt_rvalue(v4_mir_bool_binary_mir, v4_mir_bool_binary_calc_body, v4_mir_bool_binary_guard_branch))
say "bool-binary-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_bool_binary_mir))

pilot v4_mir_bad_and_source = v4_mir_bad_and_make_source()
pilot v4_mir_bad_and_stream = v4_lex_text(1, v4_mir_bad_and_source)
pilot v4_mir_bad_and_tree = v4_parse_stream(1, v4_mir_bad_and_stream)
pilot v4_mir_bad_and_hir = v4_hir_lower_tree(1, v4_mir_bad_and_tree)
pilot v4_mir_bad_and_resolve = v4_resolve_lower_hir(1, v4_mir_bad_and_hir)
pilot v4_mir_bad_and_ty = v4_ty_lower_resolve(1, v4_mir_bad_and_resolve)
pilot v4_mir_bad_and_mir = v4_mir_lower_ty(1, v4_mir_bad_and_ty)

say "bad-and-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_bad_and_mir))
say "bad-and-message=" + v4_diag_message(v4_mir_diag(v4_mir_bad_and_mir, 0))
say "bad-and-help=" + v4_diag_help(v4_mir_diag(v4_mir_bad_and_mir, 0))

pilot v4_mir_bad_or_source = v4_mir_bad_or_make_source()
pilot v4_mir_bad_or_stream = v4_lex_text(2, v4_mir_bad_or_source)
pilot v4_mir_bad_or_tree = v4_parse_stream(2, v4_mir_bad_or_stream)
pilot v4_mir_bad_or_hir = v4_hir_lower_tree(2, v4_mir_bad_or_tree)
pilot v4_mir_bad_or_resolve = v4_resolve_lower_hir(2, v4_mir_bad_or_hir)
pilot v4_mir_bad_or_ty = v4_ty_lower_resolve(2, v4_mir_bad_or_resolve)
pilot v4_mir_bad_or_mir = v4_mir_lower_ty(2, v4_mir_bad_or_ty)

say "bad-or-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_bad_or_mir))
say "bad-or-message=" + v4_diag_message(v4_mir_diag(v4_mir_bad_or_mir, 0))
say "bad-or-help=" + v4_diag_help(v4_mir_diag(v4_mir_bad_or_mir, 0))
