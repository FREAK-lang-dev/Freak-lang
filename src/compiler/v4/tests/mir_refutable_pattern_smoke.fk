say "refutable-pattern-bad-assign-message=" + v4_diag_message(v4_mir_diag(v4_mir_refutable_pattern_bad_assign_mir, 0))
say "refutable-pattern-bad-assign-help=" + v4_diag_help(v4_mir_diag(v4_mir_refutable_pattern_bad_assign_mir, 0))

pilot v4_mir_refutable_pattern_bad_assign_nested_stream = v4_lex_text(3, v4_mir_refutable_pattern_bad_assign_nested_source())
pilot v4_mir_refutable_pattern_bad_assign_nested_tree = v4_parse_stream(3, v4_mir_refutable_pattern_bad_assign_nested_stream)
pilot v4_mir_refutable_pattern_bad_assign_nested_hir = v4_hir_lower_tree(3, v4_mir_refutable_pattern_bad_assign_nested_tree)
pilot v4_mir_refutable_pattern_bad_assign_nested_resolve = v4_resolve_lower_hir(3, v4_mir_refutable_pattern_bad_assign_nested_hir)
pilot v4_mir_refutable_pattern_bad_assign_nested_ty = v4_ty_lower_resolve(3, v4_mir_refutable_pattern_bad_assign_nested_resolve)
pilot v4_mir_refutable_pattern_bad_assign_nested_mir = v4_mir_lower_ty(3, v4_mir_refutable_pattern_bad_assign_nested_ty)
