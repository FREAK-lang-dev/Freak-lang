say "refutable-pattern-bad-assign-nested-message=" + v4_diag_message(v4_mir_diag(v4_mir_refutable_pattern_bad_assign_nested_mir, 0))
say "refutable-pattern-bad-assign-nested-help=" + v4_diag_help(v4_mir_diag(v4_mir_refutable_pattern_bad_assign_nested_mir, 0))
