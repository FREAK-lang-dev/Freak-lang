-- V4 closure capture diagnostic and ownership smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_closure_capture_negative_source() -> word {
    pilot src = "task copy_bad() -> void {\n"
    src = src + "    pilot title: word = \"ace\"\n"
    src = src + "    pilot copied = copy |_| => title\n"
    src = src + "}\n"
    src = src + "task immutable_bad() -> void {\n"
    src = src + "    pilot threshold: int = 100\n"
    src = src + "    pilot changer = |_| " + "{" + " say threshold; threshold += 1 " + "}" + "\n"
    src = src + "}\n"
    src = src + "task oneshot_bad() -> void {\n"
    src = src + "    pilot title: word = \"ace\"\n"
    src = src + "    pilot owned = move |_| " + "{" + " say title " + "}" + "\n"
    src = src + "    owned()\n"
    src = src + "    owned()\n"
    src = src + "}\n"
    src = src + "task mut_alias_bad() -> void {\n"
    src = src + "    pilot count: int = 0\n"
    src = src + "    pilot counter = mut |_| " + "{" + " count += 1 " + "}" + "\n"
    src = src + "    pilot observed = count\n"
    src = src + "    counter()\n"
    src = src + "}\n"
    src = src + "task borrow_write_bad() -> void {\n"
    src = src + "    pilot threshold: int = 100\n"
    src = src + "    pilot check = |x: int| => x > threshold\n"
    src = src + "    threshold = 101\n"
    src = src + "    pilot observed = check(102)\n"
    src = src + "}\n"
    give back src
}

task v4_closure_capture_negative_has_mir_message(mir_id: int, wanted: word) -> bool {
    pilot diag_id = 0
    pilot diag_count = v4_mir_diag_count(mir_id)
    repeat until diag_id >= diag_count {
        if v4_diag_message(v4_mir_diag(mir_id, diag_id)) == wanted {
            give back true
        }
        diag_id += 1
    }
    give back false
}

task v4_closure_capture_negative_has_borrow_message(borrow_id: int, wanted: word) -> bool {
    pilot diag_id = 0
    pilot diag_count = v4_borrowck_diag_count(borrow_id)
    repeat until diag_id >= diag_count {
        if v4_diag_message(v4_borrowck_diag(borrow_id, diag_id)) == wanted {
            give back true
        }
        diag_id += 1
    }
    give back false
}

task v4_closure_capture_negative_bool(value: bool) -> word {
    if value { give back "true" }
    give back "false"
}

task v4_closure_capture_negative_status(borrow_id: int, resolve_id: int, name: word) -> word {
    pilot def_id = v4_resolve_def_for_name(resolve_id, name)
    pilot result_id = v4_borrowck_lookup_result(borrow_id, def_id)
    give back v4_borrowck_result_status(borrow_id, result_id)
}

pilot v4_closure_capture_negative_stream = v4_lex_text(0, v4_closure_capture_negative_source())
pilot v4_closure_capture_negative_tree = v4_parse_stream(0, v4_closure_capture_negative_stream)
pilot v4_closure_capture_negative_hir = v4_hir_lower_tree(0, v4_closure_capture_negative_tree)
pilot v4_closure_capture_negative_resolve = v4_resolve_lower_hir(0, v4_closure_capture_negative_hir)
pilot v4_closure_capture_negative_ty = v4_ty_lower_resolve(0, v4_closure_capture_negative_resolve)
pilot v4_closure_capture_negative_mir = v4_mir_lower_ty(0, v4_closure_capture_negative_ty)
pilot v4_closure_capture_negative_borrow = v4_borrowck_check_mir(0, v4_closure_capture_negative_mir)
say "closure-negative-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_closure_capture_negative_tree))
say "closure-negative-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_closure_capture_negative_mir))
say "closure-negative-borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(v4_closure_capture_negative_borrow))
say "closure-negative-copy-message=" + v4_closure_capture_negative_bool(v4_closure_capture_negative_has_mir_message(v4_closure_capture_negative_mir, "Yuuko cannot copy this closure capture"))
say "closure-negative-immutable-message=" + v4_closure_capture_negative_bool(v4_closure_capture_negative_has_mir_message(v4_closure_capture_negative_mir, "Meiya keeps this closure capture immutable"))
say "closure-negative-oneshot-status=" + v4_closure_capture_negative_status(v4_closure_capture_negative_borrow, v4_closure_capture_negative_resolve, "oneshot_bad")
say "closure-negative-mut-alias-status=" + v4_closure_capture_negative_status(v4_closure_capture_negative_borrow, v4_closure_capture_negative_resolve, "mut_alias_bad")
say "closure-negative-borrow-write-status=" + v4_closure_capture_negative_status(v4_closure_capture_negative_borrow, v4_closure_capture_negative_resolve, "borrow_write_bad")
say "closure-negative-oneshot-message=" + v4_closure_capture_negative_bool(v4_closure_capture_negative_has_borrow_message(v4_closure_capture_negative_borrow, "Meiya remembers the field you already moved"))
say "closure-negative-mut-read-message=" + v4_closure_capture_negative_bool(v4_closure_capture_negative_has_borrow_message(v4_closure_capture_negative_borrow, "Meiya refuses observation through an exclusive lend"))
say "closure-negative-borrow-write-message=" + v4_closure_capture_negative_bool(v4_closure_capture_negative_has_borrow_message(v4_closure_capture_negative_borrow, "Meiya refuses this rewrite while the value is borrowed"))
