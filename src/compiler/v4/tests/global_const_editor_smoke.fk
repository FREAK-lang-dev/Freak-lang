-- V4 root fixed-pilot editor visibility smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_global_const_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_global_const_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_global_const_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_global_const_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_global_const_editor_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_global_const_editor_find_symbol(doc_id: int, name: word) -> int {
    pilot symbol_id = 0
    pilot symbol_count = v4_document_symbol_count(doc_id)
    repeat until symbol_id >= symbol_count {
        if v4_document_symbol_name(doc_id, symbol_id) == name {
            give back symbol_id
        }
        symbol_id += 1
    }
    give back 0 - 1
}

task v4_global_const_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_global_const_editor_source_text() -> word {
    pilot ace_braces = v4_global_const_editor_braces(" hp: BASE ")
    pilot signal_braces = v4_global_const_editor_braces(" code: DEPTH ")
    pilot route_decl_braces = v4_global_const_editor_braces(" code: int ")
    pilot box_braces = v4_global_const_editor_braces(" value: BASE ")
    pilot some_braces = v4_global_const_editor_braces(" value: BASE ")
    pilot option_decl_braces = v4_global_const_editor_braces(" value: T ")
    pilot src = "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "fixed pilot PAIR = (BASE, \"ace\")\n"
    src = src + "fixed pilot GRID = [0; CELLS]\n"
    src = src + "fixed pilot ACE = Pilot " + ace_braces + "\n"
    src = src + "fixed pilot SIGNAL = Event::Key " + signal_braces + "\n"
    src = src + "fixed pilot INT_BOX = Box<int> " + box_braces + "\n"
    src = src + "fixed pilot INFER_BOX = Box " + box_braces + "\n"
    src = src + "fixed pilot SOME = Option::Some " + some_braces + "\n"
    src = src + "fixed pilot EMPTY = Option<int>::None\n"
    src = src + "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Event {\n"
    src = src + "    Key " + route_decl_braces + "\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl_braces + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot pair = PAIR\n"
    src = src + "    pilot grid = GRID\n"
    src = src + "    pilot ace = ACE\n"
    src = src + "    pilot signal = SIGNAL\n"
    src = src + "    pilot int_box = INT_BOX\n"
    src = src + "    pilot infer_box = INFER_BOX\n"
    src = src + "    pilot some = SOME\n"
    src = src + "    pilot empty = EMPTY\n"
    src = src + "    give back CELLS\n"
    src = src + "}\n"
    give back src
}

task v4_global_const_editor_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

pilot v4_global_const_editor_source = v4_global_const_editor_source_text()
pilot v4_global_const_editor_stream = v4_lex_text(0, v4_global_const_editor_source)

pilot v4_global_const_editor_depth_decl_offset = v4_global_const_editor_token_offset(v4_global_const_editor_stream, "DEPTH", 0)
