pilot v4_mir_alias_route_stream = v4_lex_text(0, v4_mir_alias_route_source_text())
pilot v4_mir_alias_route_tree = v4_parse_stream(0, v4_mir_alias_route_stream)
pilot v4_mir_alias_route_hir = v4_hir_lower_tree(0, v4_mir_alias_route_tree)
pilot v4_mir_alias_route_resolve = v4_resolve_lower_hir(0, v4_mir_alias_route_hir)
pilot v4_mir_alias_route_ty = v4_ty_lower_resolve(0, v4_mir_alias_route_resolve)
pilot v4_mir_alias_route_mir = v4_mir_lower_ty(0, v4_mir_alias_route_ty)

pilot v4_mir_alias_route_missing_when_stream = v4_lex_text(1, v4_mir_alias_route_missing_when_source_text())
pilot v4_mir_alias_route_missing_when_tree = v4_parse_stream(1, v4_mir_alias_route_missing_when_stream)
pilot v4_mir_alias_route_missing_when_hir = v4_hir_lower_tree(1, v4_mir_alias_route_missing_when_tree)
pilot v4_mir_alias_route_missing_when_resolve = v4_resolve_lower_hir(1, v4_mir_alias_route_missing_when_hir)
pilot v4_mir_alias_route_missing_when_ty = v4_ty_lower_resolve(1, v4_mir_alias_route_missing_when_resolve)
pilot v4_mir_alias_route_missing_when_mir = v4_mir_lower_ty(1, v4_mir_alias_route_missing_when_ty)

pilot v4_mir_alias_route_duplicate_when_stream = v4_lex_text(2, v4_mir_alias_route_duplicate_when_source_text())
pilot v4_mir_alias_route_duplicate_when_tree = v4_parse_stream(2, v4_mir_alias_route_duplicate_when_stream)
pilot v4_mir_alias_route_duplicate_when_hir = v4_hir_lower_tree(2, v4_mir_alias_route_duplicate_when_tree)
pilot v4_mir_alias_route_duplicate_when_resolve = v4_resolve_lower_hir(2, v4_mir_alias_route_duplicate_when_hir)
pilot v4_mir_alias_route_duplicate_when_ty = v4_ty_lower_resolve(2, v4_mir_alias_route_duplicate_when_resolve)
pilot v4_mir_alias_route_duplicate_when_mir = v4_mir_lower_ty(2, v4_mir_alias_route_duplicate_when_ty)

pilot v4_mir_alias_route_missing_check_stream = v4_lex_text(3, v4_mir_alias_route_missing_check_source_text())
pilot v4_mir_alias_route_missing_check_tree = v4_parse_stream(3, v4_mir_alias_route_missing_check_stream)
pilot v4_mir_alias_route_missing_check_hir = v4_hir_lower_tree(3, v4_mir_alias_route_missing_check_tree)
pilot v4_mir_alias_route_missing_check_resolve = v4_resolve_lower_hir(3, v4_mir_alias_route_missing_check_hir)
pilot v4_mir_alias_route_missing_check_ty = v4_ty_lower_resolve(3, v4_mir_alias_route_missing_check_resolve)
pilot v4_mir_alias_route_missing_check_mir = v4_mir_lower_ty(3, v4_mir_alias_route_missing_check_ty)

pilot v4_mir_alias_route_duplicate_check_stream = v4_lex_text(4, v4_mir_alias_route_duplicate_check_source_text())
pilot v4_mir_alias_route_duplicate_check_tree = v4_parse_stream(4, v4_mir_alias_route_duplicate_check_stream)
pilot v4_mir_alias_route_duplicate_check_hir = v4_hir_lower_tree(4, v4_mir_alias_route_duplicate_check_tree)
pilot v4_mir_alias_route_duplicate_check_resolve = v4_resolve_lower_hir(4, v4_mir_alias_route_duplicate_check_hir)
pilot v4_mir_alias_route_duplicate_check_ty = v4_ty_lower_resolve(4, v4_mir_alias_route_duplicate_check_resolve)
pilot v4_mir_alias_route_duplicate_check_mir = v4_mir_lower_ty(4, v4_mir_alias_route_duplicate_check_ty)

pilot v4_mir_alias_route_only_body = v4_mir_lookup_body(v4_mir_alias_route_mir, v4_resolve_def_for_name(v4_mir_alias_route_resolve, "only_score"))
pilot v4_mir_alias_route_when_body = v4_mir_lookup_body(v4_mir_alias_route_mir, v4_resolve_def_for_name(v4_mir_alias_route_resolve, "when_score"))
pilot v4_mir_alias_route_check_body = v4_mir_lookup_body(v4_mir_alias_route_mir, v4_resolve_def_for_name(v4_mir_alias_route_resolve, "check_score"))

pilot v4_mir_alias_route_only_branch_stmt = v4_mir_alias_route_find_stmt(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_stmt_branch, "event == Event::Key")
pilot v4_mir_alias_route_only_code_stmt = v4_mir_alias_route_find_stmt(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_stmt_local, "code")
pilot v4_mir_alias_route_only_held_stmt = v4_mir_alias_route_find_stmt(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_stmt_local, "held")
pilot v4_mir_alias_route_when_code_stmt = v4_mir_alias_route_find_stmt(v4_mir_alias_route_mir, v4_mir_alias_route_when_body, v4_mir_stmt_local, "code")
pilot v4_mir_alias_route_check_code_stmt = v4_mir_alias_route_find_stmt(v4_mir_alias_route_mir, v4_mir_alias_route_check_body, v4_mir_stmt_local, "code")

pilot v4_mir_alias_route_only_code_rvalue = v4_mir_stmt_rvalue(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_code_stmt)
pilot v4_mir_alias_route_only_held_rvalue = v4_mir_stmt_rvalue(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_held_stmt)
pilot v4_mir_alias_route_when_code_rvalue = v4_mir_stmt_rvalue(v4_mir_alias_route_mir, v4_mir_alias_route_when_body, v4_mir_alias_route_when_code_stmt)
pilot v4_mir_alias_route_check_code_rvalue = v4_mir_stmt_rvalue(v4_mir_alias_route_mir, v4_mir_alias_route_check_body, v4_mir_alias_route_check_code_stmt)

say "alias-route-diag-count=" + word_from_int(v4_mir_diag_count(v4_mir_alias_route_mir))
say "alias-route-only-branch-kind=" + v4_mir_stmt_kind(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_branch_stmt)
say "alias-route-only-branch-lhs=" + v4_mir_stmt_lhs(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_branch_stmt)
say "alias-route-only-code-kind=" + v4_mir_rvalue_kind(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_code_rvalue)
say "alias-route-only-code-ty=" + v4_mir_rvalue_ty(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_code_rvalue)
say "alias-route-only-held-kind=" + v4_mir_rvalue_kind(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_held_rvalue)
say "alias-route-only-held-ty=" + v4_mir_rvalue_ty(v4_mir_alias_route_mir, v4_mir_alias_route_only_body, v4_mir_alias_route_only_held_rvalue)
say "alias-route-when-code-kind=" + v4_mir_rvalue_kind(v4_mir_alias_route_mir, v4_mir_alias_route_when_body, v4_mir_alias_route_when_code_rvalue)
say "alias-route-when-code-ty=" + v4_mir_rvalue_ty(v4_mir_alias_route_mir, v4_mir_alias_route_when_body, v4_mir_alias_route_when_code_rvalue)
say "alias-route-check-code-kind=" + v4_mir_rvalue_kind(v4_mir_alias_route_mir, v4_mir_alias_route_check_body, v4_mir_alias_route_check_code_rvalue)
say "alias-route-check-code-ty=" + v4_mir_rvalue_ty(v4_mir_alias_route_mir, v4_mir_alias_route_check_body, v4_mir_alias_route_check_code_rvalue)
say "alias-route-missing-when-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_alias_route_missing_when_mir))
say "alias-route-missing-when-message=" + v4_diag_message(v4_mir_diag(v4_mir_alias_route_missing_when_mir, 0))
say "alias-route-missing-when-help=" + v4_diag_help(v4_mir_diag(v4_mir_alias_route_missing_when_mir, 0))
say "alias-route-duplicate-when-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_alias_route_duplicate_when_mir))
say "alias-route-duplicate-when-message=" + v4_diag_message(v4_mir_diag(v4_mir_alias_route_duplicate_when_mir, 0))
say "alias-route-duplicate-when-help=" + v4_diag_help(v4_mir_diag(v4_mir_alias_route_duplicate_when_mir, 0))
say "alias-route-missing-check-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_alias_route_missing_check_mir))
say "alias-route-missing-check-message=" + v4_diag_message(v4_mir_diag(v4_mir_alias_route_missing_check_mir, 0))
say "alias-route-missing-check-help=" + v4_diag_help(v4_mir_diag(v4_mir_alias_route_missing_check_mir, 0))
say "alias-route-duplicate-check-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_alias_route_duplicate_check_mir))
say "alias-route-duplicate-check-message=" + v4_diag_message(v4_mir_diag(v4_mir_alias_route_duplicate_check_mir, 0))
say "alias-route-duplicate-check-help=" + v4_diag_help(v4_mir_diag(v4_mir_alias_route_duplicate_check_mir, 0))
