-- V4 MIR alias-backed route scope smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_alias_route_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_mir_alias_route_find_stmt(mir_id: int, body_id: int, kind: word, lhs: word) -> int {
    pilot stmt_id = 0
    repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == kind and v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == lhs {
            give back stmt_id
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_mir_alias_route_source_text() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_alias_route_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "alias Alarm = Event\n"
    src = src + "task only_score(event: Alarm) -> int {\n"
    src = src + "    only on Event::Key " + v4_mir_alias_route_braces(" code, repeat: held ") + " from event {\n"
    src = src + "        if held {\n"
    src = src + "            give back code\n"
    src = src + "        }\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task when_score(event: Alarm) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Event::Closed -> give back 0\n"
    src = src + "        Event::Key " + v4_mir_alias_route_braces(" code ") + " -> give back code\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task check_score(event: Alarm) -> int {\n"
    src = src + "    check route event {\n"
    src = src + "        Event::Closed -> give back 0\n"
    src = src + "        Event::Key " + v4_mir_alias_route_braces(" code ") + " -> give back code\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_alias_route_missing_when_source_text() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_alias_route_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "alias Alarm = Event\n"
    src = src + "task score(event: Alarm) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Event::Key " + v4_mir_alias_route_braces(" code ") + " -> give back code\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_alias_route_duplicate_when_source_text() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_alias_route_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "alias Alarm = Event\n"
    src = src + "task score(event: Alarm) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Event::Key " + v4_mir_alias_route_braces(" code ") + " -> give back code\n"
    src = src + "        Key " + v4_mir_alias_route_braces(" repeat ") + " -> give back 1\n"
    src = src + "        Closed -> give back 0\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

