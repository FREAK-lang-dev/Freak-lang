-- V4 document-symbols arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_doc_snapshot_find_symbol(doc_id: int, name: word) -> int {
    pilot symbol_id = 0
    pilot symbol_count = v4_document_symbol_count(doc_id)
    repeat until symbol_id >= symbol_count {
        if v4_document_symbol_name(doc_id, symbol_id) == name {
            give back symbol_id
        }
        symbol_id += 1
    }
    give back 0 - 1
}

task v4_doc_snapshot_kind_or_empty(doc_id: int, symbol_id: int) -> word {
    if symbol_id < 0 {
        give back ""
    }
    give back v4_document_symbol_kind(doc_id, symbol_id)
}

task v4_doc_snapshot_type_or_empty(doc_id: int, symbol_id: int) -> word {
    if symbol_id < 0 {
        give back ""
    }
    give back v4_document_symbol_type(doc_id, symbol_id)
}

task v4_doc_snapshot_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_doc_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_doc_snapshot_source_text() -> word {
    pilot src = "@protagonist\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "    task pack(level: int) -> Pilot {\n"
    src = src + "        give back Pilot " + v4_doc_snapshot_braces(" rank: level ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_doc_snapshot_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot::pack(7)\n"
    src = src + "    pilot event = Event::Key " + v4_doc_snapshot_braces(" code: 9 ") + "\n"
    src = src + "    give back ace.salute() + CELLS\n"
    src = src + "}\n"
    give back src
}

pilot v4_doc_snapshot_source = v4_doc_snapshot_source_text()
pilot v4_doc_snapshot_id = v4_document_symbols_text_cached("document-symbols-snapshot.fk", v4_doc_snapshot_source)
pilot v4_doc_snapshot_base = v4_doc_snapshot_find_symbol(v4_doc_snapshot_id, "BASE")
pilot v4_doc_snapshot_cells = v4_doc_snapshot_find_symbol(v4_doc_snapshot_id, "CELLS")
pilot v4_doc_snapshot_event = v4_doc_snapshot_find_symbol(v4_doc_snapshot_id, "Event")
pilot v4_doc_snapshot_event_key = v4_doc_snapshot_find_symbol(v4_doc_snapshot_id, "Event::Key")
pilot v4_doc_snapshot_salute = v4_doc_snapshot_find_symbol(v4_doc_snapshot_id, "Pilot::salute")
pilot v4_doc_snapshot_pack = v4_doc_snapshot_find_symbol(v4_doc_snapshot_id, "Pilot::pack")
say v4_document_symbols_summary(v4_doc_snapshot_id)
say v4_document_symbols_snapshot_summary()

pilot v4_doc_snapshot_payload = v4_document_symbols_snapshot()
say v4_document_symbols_snapshot_validate(v4_doc_snapshot_payload)
say "document-symbols-snapshot-bytes=" + word_from_int(v4_doc_snapshot_payload.length())
say v4_document_symbols_snapshot_document_line(v4_doc_snapshot_id)
say v4_document_symbols_snapshot_symbol_line(v4_doc_snapshot_id, v4_doc_snapshot_salute)
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
say v4_ty_snapshot_restore(v4_ty_snapshot())
say v4_document_symbols_snapshot_restore(v4_doc_snapshot_payload)
say v4_lsp_document_symbols_snapshot_text()
say v4_lsp_document_symbols_snapshot_restore_text(v4_doc_snapshot_payload)
say v4_lsp_handle_text_request("workspace/documentSymbolsSnapshotRestore", "document-symbols-snapshot.fk", v4_doc_snapshot_payload, 0)

pilot v4_doc_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_doc_query_payload)
say v4_driver_confirm_restored_document_text("document-symbols-snapshot.fk", v4_doc_snapshot_source)
pilot v4_doc_file = v4_source_find("document-symbols-snapshot.fk")
pilot v4_doc_fingerprint = v4_source_fingerprint(v4_doc_file)
pilot v4_doc_restored_id = word_to_int(v4_query_get(v4_document_symbols_query_key("document-symbols-snapshot.fk"), v4_doc_fingerprint))
pilot v4_doc_restored_base = v4_doc_snapshot_find_symbol(v4_doc_restored_id, "BASE")
pilot v4_doc_restored_cells = v4_doc_snapshot_find_symbol(v4_doc_restored_id, "CELLS")
pilot v4_doc_restored_event = v4_doc_snapshot_find_symbol(v4_doc_restored_id, "Event")
pilot v4_doc_restored_event_key = v4_doc_snapshot_find_symbol(v4_doc_restored_id, "Event::Key")
pilot v4_doc_restored_salute = v4_doc_snapshot_find_symbol(v4_doc_restored_id, "Pilot::salute")
pilot v4_doc_restored_pack = v4_doc_snapshot_find_symbol(v4_doc_restored_id, "Pilot::pack")
say v4_document_symbols_summary(v4_doc_restored_id)
say "document-symbols-snapshot-base-found=" + v4_doc_snapshot_bool_word(v4_doc_snapshot_base >= 0)
say "document-symbols-snapshot-base-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_base)
say "document-symbols-snapshot-base-type=" + v4_doc_snapshot_type_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_base)
say "document-symbols-snapshot-cells-found=" + v4_doc_snapshot_bool_word(v4_doc_snapshot_cells >= 0)
say "document-symbols-snapshot-cells-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_cells)
say "document-symbols-snapshot-cells-type=" + v4_doc_snapshot_type_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_cells)
say "document-symbols-snapshot-event-found=" + v4_doc_snapshot_bool_word(v4_doc_snapshot_event >= 0)
say "document-symbols-snapshot-event-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_event)
say "document-symbols-snapshot-event-type=" + v4_doc_snapshot_type_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_event)
say "document-symbols-snapshot-event-key-found=" + v4_doc_snapshot_bool_word(v4_doc_snapshot_event_key >= 0)
say "document-symbols-snapshot-event-key-type=" + v4_doc_snapshot_type_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_event_key)
say "document-symbols-snapshot-salute-found=" + v4_doc_snapshot_bool_word(v4_doc_snapshot_salute >= 0)
say "document-symbols-snapshot-salute-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_salute)
say "document-symbols-snapshot-salute-type=" + v4_doc_snapshot_type_or_empty(v4_doc_snapshot_id, v4_doc_snapshot_salute)
say "document-symbols-snapshot-restored-base-found=" + v4_doc_snapshot_bool_word(v4_doc_restored_base >= 0)
say "document-symbols-snapshot-restored-base-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_restored_id, v4_doc_restored_base)
say "document-symbols-snapshot-restored-base-type=" + v4_doc_snapshot_type_or_empty(v4_doc_restored_id, v4_doc_restored_base)
say "document-symbols-snapshot-restored-cells-found=" + v4_doc_snapshot_bool_word(v4_doc_restored_cells >= 0)
say "document-symbols-snapshot-restored-cells-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_restored_id, v4_doc_restored_cells)
say "document-symbols-snapshot-restored-cells-type=" + v4_doc_snapshot_type_or_empty(v4_doc_restored_id, v4_doc_restored_cells)
say "document-symbols-snapshot-restored-event-found=" + v4_doc_snapshot_bool_word(v4_doc_restored_event >= 0)
say "document-symbols-snapshot-restored-event-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_restored_id, v4_doc_restored_event)
say "document-symbols-snapshot-restored-event-key-found=" + v4_doc_snapshot_bool_word(v4_doc_restored_event_key >= 0)
say "document-symbols-snapshot-restored-event-key-type=" + v4_doc_snapshot_type_or_empty(v4_doc_restored_id, v4_doc_restored_event_key)
say "document-symbols-snapshot-restored-salute-found=" + v4_doc_snapshot_bool_word(v4_doc_restored_salute >= 0)
say "document-symbols-snapshot-restored-salute-kind=" + v4_doc_snapshot_kind_or_empty(v4_doc_restored_id, v4_doc_restored_salute)
say "document-symbols-snapshot-restored-pack-found=" + v4_doc_snapshot_bool_word(v4_doc_restored_pack >= 0)
say "document-symbols-snapshot-restored-pack-type=" + v4_doc_snapshot_type_or_empty(v4_doc_restored_id, v4_doc_restored_pack)
say v4_driver_confirm_restored_document_text("document-symbols-snapshot.fk", "task changed() => 7\n")

pilot v4_doc_contract_small = ""
pilot v4_doc_contract_child_first = ""
pilot v4_doc_contract_duplicate_child = ""
pilot v4_doc_contract_declared_mismatch = ""
pilot v4_doc_contract_atomic_state = ""
pilot v4_doc_contract_result = ""
v4_doc_contract_small = "document-symbols-snapshot|format=" + v4_document_symbols_snapshot_format + "|documents=1|symbols=1\n"
v4_doc_contract_small = v4_doc_contract_small + "document-symbols|0|retained-document.fk|1\n"
v4_doc_contract_small = v4_doc_contract_small + "document-symbol|0|0|kept|Task|kept::task|0|0:0:0|task() -> int\n"
v4_doc_contract_small = v4_doc_contract_small + "end|" + v4_document_symbols_snapshot_format
v4_doc_contract_result = v4_document_symbols_snapshot_restore(v4_doc_contract_small)
say "document-symbols-snapshot-exact-restore=" + v4_doc_snapshot_bool_word(v4_doc_contract_result.starts_with("document-symbols-snapshot-restore ok=1 ") and v4_document_symbols_snapshot() == v4_doc_contract_small)
say "document-symbols-snapshot-stale-child-hidden=" + v4_doc_snapshot_bool_word(v4_document_symbol_count(0) == 1 and v4_document_symbol_name(0, 1) == "" and v4_document_symbol_hir_item(0, 1) < 0 and v4_document_symbol_type(0, 1) == v4_ty_unknown)
v4_doc_contract_atomic_state = v4_document_symbols_snapshot()
v4_doc_contract_child_first = "document-symbols-snapshot|format=" + v4_document_symbols_snapshot_format + "|documents=1|symbols=1\n"
v4_doc_contract_child_first = v4_doc_contract_child_first + "document-symbol|0|0|bad|Task|bad::task|0|0:0:0|task() -> int\n"
v4_doc_contract_child_first = v4_doc_contract_child_first + "document-symbols|0|bad-document.fk|1\n"
v4_doc_contract_child_first = v4_doc_contract_child_first + "end|" + v4_document_symbols_snapshot_format
v4_doc_contract_result = v4_document_symbols_snapshot_restore(v4_doc_contract_child_first)
say "document-symbols-snapshot-child-first-atomic=" + v4_doc_snapshot_bool_word(v4_doc_contract_result.starts_with("document-symbols-snapshot-restore ok=0 ") and v4_document_symbols_snapshot() == v4_doc_contract_atomic_state)
v4_doc_contract_duplicate_child = "document-symbols-snapshot|format=" + v4_document_symbols_snapshot_format + "|documents=1|symbols=2\n"
v4_doc_contract_duplicate_child = v4_doc_contract_duplicate_child + "document-symbols|0|bad-document.fk|2\n"
v4_doc_contract_duplicate_child = v4_doc_contract_duplicate_child + "document-symbol|0|0|first|Task|first::task|0|0:0:0|task() -> int\n"
v4_doc_contract_duplicate_child = v4_doc_contract_duplicate_child + "document-symbol|0|0|duplicate|Task|duplicate::task|1|0:0:0|task() -> int\n"
v4_doc_contract_duplicate_child = v4_doc_contract_duplicate_child + "end|" + v4_document_symbols_snapshot_format
v4_doc_contract_result = v4_document_symbols_snapshot_restore(v4_doc_contract_duplicate_child)
say "document-symbols-snapshot-duplicate-child-atomic=" + v4_doc_snapshot_bool_word(v4_doc_contract_result.starts_with("document-symbols-snapshot-restore ok=0 ") and v4_document_symbols_snapshot() == v4_doc_contract_atomic_state)
v4_doc_contract_declared_mismatch = "document-symbols-snapshot|format=" + v4_document_symbols_snapshot_format + "|documents=1|symbols=2\n"
v4_doc_contract_declared_mismatch = v4_doc_contract_declared_mismatch + "document-symbols|0|bad-document.fk|1\n"
v4_doc_contract_declared_mismatch = v4_doc_contract_declared_mismatch + "document-symbol|0|0|only|Task|only::task|0|0:0:0|task() -> int\n"
v4_doc_contract_declared_mismatch = v4_doc_contract_declared_mismatch + "end|" + v4_document_symbols_snapshot_format
v4_doc_contract_result = v4_document_symbols_snapshot_restore(v4_doc_contract_declared_mismatch)
say "document-symbols-snapshot-declared-count-atomic=" + v4_doc_snapshot_bool_word(v4_doc_contract_result.starts_with("document-symbols-snapshot-restore ok=0 ") and v4_document_symbols_snapshot() == v4_doc_contract_atomic_state)
