-- V4 named lend lifetime editor and LSP smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_named_lifetime_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    repeat until token_id >= v4_lex_token_count(stream_id) {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_named_lifetime_editor_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_named_lifetime_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0 - 1
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_named_lifetime_editor_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_named_lifetime_editor_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_named_lifetime_editor_source_text() -> word {
    pilot src = "shape Ship " + v4_named_lifetime_editor_braces(" hp: int ") + "\n"
    src = src + "task select_left<'left, 'right>(lend 'left left: Ship, lend 'right right: Ship) -> lend 'left Ship {\n"
    src = src + "    give back lend left\n"
    src = src + "}\n"
    give back src
}

pilot v4_named_lifetime_editor_source = v4_named_lifetime_editor_source_text()
pilot v4_named_lifetime_editor_stream = v4_lex_text(0, v4_named_lifetime_editor_source)
pilot v4_named_lifetime_editor_decl_region_offset = v4_named_lifetime_editor_offset(v4_named_lifetime_editor_stream, "'left", 0)
pilot v4_named_lifetime_editor_param_region_offset = v4_named_lifetime_editor_offset(v4_named_lifetime_editor_stream, "'left", 1)
pilot v4_named_lifetime_editor_return_region_offset = v4_named_lifetime_editor_offset(v4_named_lifetime_editor_stream, "'left", 2)
pilot v4_named_lifetime_editor_param_decl_offset = v4_named_lifetime_editor_offset(v4_named_lifetime_editor_stream, "left", 0)
pilot v4_named_lifetime_editor_param_use_offset = v4_named_lifetime_editor_offset(v4_named_lifetime_editor_stream, "left", 1)

pilot v4_named_lifetime_editor_param_region = v4_semantic_at_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_param_region_offset)
pilot v4_named_lifetime_editor_return_region = v4_hover_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_return_region_offset)
pilot v4_named_lifetime_editor_region_definition = v4_definition_at_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_return_region_offset)
pilot v4_named_lifetime_editor_param = v4_semantic_at_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_param_use_offset)
pilot v4_named_lifetime_editor_param_hover = v4_hover_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_param_use_offset)
pilot v4_named_lifetime_editor_param_definition = v4_definition_at_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_param_use_offset)
pilot v4_named_lifetime_editor_diagnostics = v4_diagnostics_text_cached("named-lifetime-editor.fk", v4_named_lifetime_editor_source)

say "named-lifetime-editor-param-region-kind=" + v4_semantic_at_kind(v4_named_lifetime_editor_param_region)
say "named-lifetime-editor-param-region-type=" + v4_semantic_at_type(v4_named_lifetime_editor_param_region)
say "named-lifetime-editor-return-region-kind=" + v4_hover_kind(v4_named_lifetime_editor_return_region)
say "named-lifetime-editor-return-region-type=" + v4_hover_type(v4_named_lifetime_editor_return_region)
say "named-lifetime-editor-region-definition=" + word_from_int(v4_definition_at_found(v4_named_lifetime_editor_region_definition))
say "named-lifetime-editor-region-definition-matches=" + v4_named_lifetime_editor_bool(v4_span_start(v4_definition_at_span(v4_named_lifetime_editor_region_definition)) == v4_named_lifetime_editor_decl_region_offset)
say "named-lifetime-editor-param-kind=" + v4_semantic_at_kind(v4_named_lifetime_editor_param)
say "named-lifetime-editor-param-type=" + v4_semantic_at_type(v4_named_lifetime_editor_param)
say "named-lifetime-editor-param-hover=" + v4_hover_type(v4_named_lifetime_editor_param_hover)
say "named-lifetime-editor-param-definition=" + word_from_int(v4_definition_at_found(v4_named_lifetime_editor_param_definition))
say "named-lifetime-editor-param-definition-matches=" + v4_named_lifetime_editor_bool(v4_span_start(v4_definition_at_span(v4_named_lifetime_editor_param_definition)) == v4_named_lifetime_editor_param_decl_offset)
say "named-lifetime-editor-diagnostics=" + word_from_int(v4_diagnostics_count(v4_named_lifetime_editor_diagnostics))
say v4_lsp_hover_text("named-lifetime-editor.fk", v4_named_lifetime_editor_source, v4_named_lifetime_editor_param_use_offset)
say v4_lsp_diagnostics_text("named-lifetime-editor.fk", v4_named_lifetime_editor_source)
