-- One complete constructed-Sum source pipeline per mode; no runtime bridge is needed.
task v4_sum_semantic_assert(condition: bool, label: word) -> void { if not condition { panic("scalar-sum-semantic " + label) } }

task v4_sum_semantic_source(mode: int) -> word {
    if mode == 0 { give back "task relay(value: result<word,word>) -> result<word,word> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot empty: maybe<int> = nobody\ncheck empty " + chr(123) + " got _ -> " + chr(123) + " give back 1 " + chr(125) + " nobody -> " + chr(123) + " " + chr(125) + " " + chr(125) + "\npilot zero: maybe<int> = some(0)\ncheck zero " + chr(123) + " got number -> " + chr(123) + " if number != 0 " + chr(123) + " give back 2 " + chr(125) + " " + chr(125) + " nobody -> " + chr(123) + " give back 3 " + chr(125) + " " + chr(125) + "\npilot value: result<word,word> = ok(\"\")\npilot moved = relay(value)\ncheck result moved " + chr(123) + " ok(text) -> " + chr(123) + " say text " + chr(125) + " err(message) -> " + chr(123) + " say message " + chr(125) + " " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 1 { give back "task relay(value: result<word,word>) -> result<word,word> " + chr(123) + " give back value " + chr(125) + "\ntask relay_maybe(value: maybe<int>) -> maybe<int> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot mut choice: maybe<int> = some(1)\nchoice = relay_maybe(choice)\ncheck choice " + chr(123) + " got number -> " + chr(123) + " if number != 1 " + chr(123) + " give back 1 " + chr(125) + " " + chr(125) + " nobody -> " + chr(123) + " give back 2 " + chr(125) + " " + chr(125) + "\npilot mut value: result<word,word> = ok(\"old\")\nvalue = relay(value)\nvalue = err(\"new\")\ncheck result value " + chr(123) + " ok(text) -> " + chr(123) + " say text " + chr(125) + " err(message) -> " + chr(123) + " say message " + chr(125) + " " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 2 { give back "task main() -> int " + chr(123) + "\npilot text = \"outer\"\npilot value: result<word,word> = ok(\"inner\")\ncheck result value " + chr(123) + " ok(text) -> " + chr(123) + " say text " + chr(125) + " err(text) -> " + chr(123) + " say text " + chr(125) + " " + chr(125) + "\nsay text\ngive back 0\n" + chr(125) + "\n" }
    if mode == 3 { give back "task main() -> int " + chr(123) + "\npilot mut count = 0\nrepeat until count >= 3 " + chr(123) + " pilot value: result<word,word> = ok(\"loop\"); count += 1; check result value " + chr(123) + " ok(text) -> " + chr(123) + " say text; if count == 1 " + chr(123) + " continue " + chr(125) + " " + chr(125) + " err(message) -> " + chr(123) + " say message; break " + chr(125) + " " + chr(125) + "; if count == 2 " + chr(123) + " break " + chr(125) + " " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 4 { give back "task make_ok() -> result<word,word> " + chr(123) + " give back ok(\"discard\") " + chr(125) + "\ntask make_none() -> maybe<int> " + chr(123) + " give back nobody " + chr(125) + "\ntask main() -> int " + chr(123) + "\nmake_ok()\nmake_none()\npilot value: result<word,word> = err(\"ignored\")\ncheck result value " + chr(123) + " ok(_) -> " + chr(123) + " " + chr(125) + " err(_) -> " + chr(123) + " " + chr(125) + " " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 5 { give back "alias Choice = maybe<int>\nalias Outcome = result<word,word>\ntask main() -> int " + chr(123) + "\npilot choice: Choice = some(9)\ncheck choice " + chr(123) + " got number -> " + chr(123) + " say number " + chr(125) + " nobody -> " + chr(123) + " give back 1 " + chr(125) + " " + chr(125) + "\npilot value: Outcome = ok(\"alias\")\ncheck result value " + chr(123) + " ok(text) -> " + chr(123) + " say text " + chr(125) + " err(message) -> " + chr(123) + " say message " + chr(125) + " " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 6 { give back "task relay_maybe(value: maybe<int>) -> maybe<int> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot value: maybe<int> = some(1)\npilot first = relay_maybe(value)\npilot second = relay_maybe(value)\ngive back 0\n" + chr(125) + "\n" }
    if mode == 7 { give back "task relay(value: result<word,word>) -> result<word,word> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot value: result<word,word> = ok(\"once\")\npilot first = relay(value)\npilot second = relay(value)\ngive back 0\n" + chr(125) + "\n" }
    if mode == 8 { give back "task relay_maybe(value: maybe<int>) -> maybe<int> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot value: maybe<int> = some(1)\ncheck value " + chr(123) + " got number -> " + chr(123) + " " + chr(125) + " nobody -> " + chr(123) + " " + chr(125) + " " + chr(125) + "\npilot moved = relay_maybe(value)\ngive back 0\n" + chr(125) + "\n" }
    if mode == 9 { give back "task main() -> int " + chr(123) + "\npilot value: result<word,word> = ok(\"once\")\npilot mut count = 0\nrepeat until count >= 2 " + chr(123) + " check result value " + chr(123) + " ok(text) -> " + chr(123) + " say text " + chr(125) + " err(message) -> " + chr(123) + " say message " + chr(125) + " " + chr(125) + "; count += 1 " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 10 { give back "task main() -> int " + chr(123) + "\npilot value: maybe<int> = some(true)\ngive back 0\n" + chr(125) + "\n" }
    if mode == 11 { give back "task main() -> int " + chr(123) + "\npilot value: result<word,word> = ok(1)\ngive back 0\n" + chr(125) + "\n" }
    if mode == 12 { give back "task some(value: int) -> int " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\ngive back some(3)\n" + chr(125) + "\n" }
    if mode == 13 { give back "task ok(value: int) -> int " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\ngive back ok(3)\n" + chr(125) + "\n" }
    if mode == 14 { give back "task observer(lend value: maybe<int>) -> int " + chr(123) + " give back 0 " + chr(125) + "\ntask main() -> int " + chr(123) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 15 { give back "task observer(lend value: result<word,word>) -> int " + chr(123) + " give back 0 " + chr(125) + "\ntask main() -> int " + chr(123) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 16 { give back "task relay(value: result<word,word>) -> result<word,word> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot value: result<word,word> = ok(\"original\")\nif true " + chr(123) + " pilot moved = relay(value) " + chr(125) + "\npilot second = relay(value)\ngive back 0\n" + chr(125) + "\n" }
    if mode == 17 { give back "task relay(value: result<word,word>) -> result<word,word> " + chr(123) + " give back value " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot mut value: result<word,word> = ok(\"original\")\nif true " + chr(123) + " pilot moved = relay(value); value = ok(\"then\") " + chr(125) + " else " + chr(123) + " pilot moved = relay(value); value = err(\"else\") " + chr(125) + "\ncheck result value " + chr(123) + " ok(text) -> " + chr(123) + " say text " + chr(125) + " err(message) -> " + chr(123) + " say message " + chr(125) + " " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if mode == 18 { give back "task make_maybe() -> maybe<int> " + chr(123) + " give back some(0) " + chr(125) + "\ntask make_result() -> result<word,word> " + chr(123) + " give back err(\"ignored temporary\") " + chr(125) + "\ntask main() -> int " + chr(123) + "\n check make_maybe() " + chr(123) + " got _ -> " + chr(123) + " " + chr(125) + " nobody -> " + chr(123) + " give back 1 " + chr(125) + " " + chr(125) + "\n check result make_result() " + chr(123) + " ok(_) -> " + chr(123) + " " + chr(125) + " err(_) -> " + chr(123) + " " + chr(125) + " " + chr(125) + "\n say \"ignored temporary cleanup\"\n give back 0\n" + chr(125) + "\n" }
    panic("scalar-sum-semantic unknown mode")
}

task v4_sum_semantic_error(mode: int) -> word {
    if mode == 6 { give back "scalar sum use requires a live owner" }
    if mode == 7 { give back "scalar sum use requires a live owner" }
    if mode == 8 { give back "scalar sum use requires a live owner" }
    if mode == 9 { give back "scalar sum use requires a live owner" }
    if mode == 10 { give back "some payload type mismatch" }
    if mode == 11 { give back "ok payload type mismatch" }
    if mode == 14 { give back "borrowed scalar sum storage is not yet supported" }
    if mode == 15 { give back "borrowed scalar sum storage is not yet supported" }
    if mode == 16 { give back "scalar sum use requires a live owner" }
    give back ""
}

task v4_sum_semantic_run() -> void {
    pilot mode = word_to_int(process::arg(1))
    pilot source = v4_sum_semantic_source(mode)
    pilot mir = v4_mir_text_cached("scalar-sum-semantic.fk", source)
    pilot expected = v4_sum_semantic_error(mode)
    pilot frontend_error = false
    pilot diag = 0
    repeat until diag >= v4_mir_diag_count(mir) {
        if v4_mir_diag(mir, diag).contains(expected) and expected != "" { frontend_error = true }
        diag += 1
    }
    pilot plan_error = v4_mir_scalar_sum_plan_preflight(mir)
    if expected == "" {
        v4_sum_semantic_assert(v4_ty_diag_count(v4_mir_ty_id(mir)) == 0 and v4_mir_diag_count(mir) == 0 and plan_error == "", "clean source and exact ownership plan")
        pilot borrow = v4_borrowck_check_mir(0, mir)
        v4_sum_semantic_assert(v4_borrowck_diag_count(borrow) == 0, "fresh Meiya has no conflicts")
        pilot body = 0
        repeat until body >= v4_mir_body_count(mir) {
            v4_sum_semantic_assert(v4_borrowck_result_status(borrow, v4_borrowck_lookup_result(borrow, v4_mir_body_def(mir, body))) == v4_borrowck_clean, "every source task clean")
            body += 1
        }
        pilot codegen = v4_codegen_llvm_lower_owned_mir(0, mir)
        v4_sum_semantic_assert(v4_codegen_llvm_native_module_error(codegen) == "" and v4_codegen_llvm_module_text(codegen, v4_target_spec_new("x86_64-unknown-linux-gnu")) != "", "owned module sealed")
        v4_sum_semantic_assert(not v4_borrowck_ty_is_copy(mir, 0, "maybe<int>") and not v4_borrowck_ty_is_copy(mir, 0, "result<word,word>"), "both carriers stay nonCopy")
        say "scalar-sum-semantic " + word_from_int(mode) + "=passed clean=true nonCopy=true sealed=true"
    } else {
        v4_sum_semantic_assert(frontend_error or plan_error.contains(expected), "exact named rejection " + expected)
        pilot codegen = v4_codegen_llvm_lower_owned_mir(0, mir)
        v4_sum_semantic_assert(v4_codegen_llvm_native_module_error(codegen) != "" and v4_codegen_llvm_module_text(codegen, v4_target_spec_new("x86_64-unknown-linux-gnu")) == "", "negative cannot publish module")
        say "scalar-sum-semantic " + word_from_int(mode) + "=passed named=true no-module=true"
    }
}
v4_sum_semantic_run()
