-- V4 route aggregate loan and owned-escape task-boundary fixture.
-- Verification prepends the V4 crates before this file.

task v4_aggregate_route_boundary_bool(value: bool) -> word {
    if value { give back "true" }
    give back "false"
}

task v4_aggregate_route_boundary_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_aggregate_route_boundary_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape SingleView<'a> {\n"
    src = src + "    view: lend 'a Ship\n"
    src = src + "}\n"
    src = src + "route RoutedView<'a> {\n"
    src = src + "    Hold " + v4_aggregate_route_boundary_braces(" view: lend 'a Ship ") + "\n"
    src = src + "    Empty\n"
    src = src + "}\n"
    src = src + "route InnerView<'a> {\n"
    src = src + "    Hold " + v4_aggregate_route_boundary_braces(" view: lend 'a Ship ") + "\n"
    src = src + "    Empty\n"
    src = src + "}\n"
    src = src + "route OuterView<'a> {\n"
    src = src + "    Wrap " + v4_aggregate_route_boundary_braces(" inner: InnerView<'a> ") + "\n"
    src = src + "    Empty\n"
    src = src + "}\n"
    src = src + "task route_pass<'a>(views: RoutedView<'a>) -> RoutedView<'a> {\n"
    src = src + "    give back views\n"
    src = src + "}\n"
    src = src + "task route_use<'a>(views: RoutedView<'a>) -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task shape_to_route<'a>(views: SingleView<'a>) -> RoutedView<'a> {\n"
    src = src + "    give back RoutedView<'a>::Hold " + v4_aggregate_route_boundary_braces(" view: views.view ") + "\n"
    src = src + "}\n"
    src = src + "task shape_to_route_forward<'a>(views: SingleView<'a>) -> RoutedView<'a> {\n"
    src = src + "    give back shape_to_route(views)\n"
    src = src + "}\n"
    src = src + "task nested_owned_escape<'a>(lend 'a borrowed: Ship, owned: Ship) -> OuterView<'a> {\n"
    src = src + "    give back OuterView<'a>::Wrap " + v4_aggregate_route_boundary_braces(" inner: InnerView<'a>::Hold " + v4_aggregate_route_boundary_braces(" view: lend owned ") + " ") + "\n"
    src = src + "}\n"
    src = src + "task nested_empty<'a>(lend 'a borrowed: Ship) -> OuterView<'a> {\n"
    src = src + "    give back OuterView<'a>::Empty\n"
    src = src + "}\n"
    src = src + "task aggregate_owned_escape<'a>(owned: Ship) -> (lend 'a Ship,int) {\n"
    src = src + "    give back (lend owned, 0)\n"
    src = src + "}\n"
    src = src + "task route_roundtrip(first: Ship) -> int {\n"
    src = src + "    pilot input = RoutedView<'_>::Hold " + v4_aggregate_route_boundary_braces(" view: lend first ") + "\n"
    src = src + "    pilot returned = route_pass(input)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task route_owner_live(first: Ship) -> int {\n"
    src = src + "    pilot input = RoutedView<'_>::Hold " + v4_aggregate_route_boundary_braces(" view: lend first ") + "\n"
    src = src + "    pilot returned = route_pass(input)\n"
    src = src + "    first.hp = 40\n"
    src = src + "    give back route_use(returned)\n"
    src = src + "}\n"
    src = src + "task route_empty_clean(first: Ship) -> int {\n"
    src = src + "    pilot returned = route_pass(RoutedView<'_>::Empty)\n"
    src = src + "    first.hp = 41\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task shape_to_route_roundtrip(first: Ship) -> int {\n"
    src = src + "    pilot input = SingleView<'_> " + v4_aggregate_route_boundary_braces(" view: lend first ") + "\n"
    src = src + "    pilot returned = shape_to_route_forward(input)\n"
    src = src + "    give back route_use(returned)\n"
    src = src + "}\n"
    give back src
}

task v4_aggregate_route_boundary_status(borrow_id: int, resolve_id: int, name: word) -> word {
    pilot def_id = v4_resolve_def_for_name(resolve_id, name)
    pilot result_id = v4_borrowck_lookup_result(borrow_id, def_id)
    give back v4_borrowck_result_status(borrow_id, result_id)
}

task v4_aggregate_route_boundary_borrow_diag_contains(borrow_id: int, needle: word) -> bool {
    pilot diag_id = 0
    repeat until diag_id >= v4_borrowck_diag_count(borrow_id) {
        if v4_diag_message(v4_borrowck_diag(borrow_id, diag_id)).contains(needle) { give back true }
        diag_id += 1
    }
    give back false
}

pilot v4_aggregate_route_boundary_borrow = v4_borrowck_text_cached("contract-region-aggregate-route-boundary.fk", v4_aggregate_route_boundary_source())
pilot v4_aggregate_route_boundary_mir = v4_borrowck_mir_id(v4_aggregate_route_boundary_borrow)
pilot v4_aggregate_route_boundary_ty = v4_mir_ty_id(v4_aggregate_route_boundary_mir)
pilot v4_aggregate_route_boundary_resolve = v4_ty_resolve_id(v4_aggregate_route_boundary_ty)
pilot v4_aggregate_route_boundary_hir = v4_resolve_hir_id(v4_aggregate_route_boundary_resolve)
pilot v4_aggregate_route_boundary_tree = v4_hir_tree_id(v4_aggregate_route_boundary_hir)

say "aggregate-boundary-route-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_aggregate_route_boundary_tree))
say "aggregate-boundary-route-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_aggregate_route_boundary_ty))
say "aggregate-boundary-route-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_aggregate_route_boundary_mir))
say "aggregate-boundary-route-borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(v4_aggregate_route_boundary_borrow))
say "aggregate-boundary-route-roundtrip=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "route_roundtrip")
say "aggregate-boundary-route-owner-live=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "route_owner_live")
say "aggregate-boundary-route-empty-clean=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "route_empty_clean")
say "aggregate-boundary-shape-to-route=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "shape_to_route")
say "aggregate-boundary-shape-to-route-forward=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "shape_to_route_forward")
say "aggregate-boundary-shape-to-route-roundtrip=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "shape_to_route_roundtrip")
say "aggregate-boundary-nested-empty=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "nested_empty")
say "aggregate-boundary-owned-escape=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "aggregate_owned_escape")
say "aggregate-boundary-nested-owned-escape=" + v4_aggregate_route_boundary_status(v4_aggregate_route_boundary_borrow, v4_aggregate_route_boundary_resolve, "nested_owned_escape")

pilot v4_aggregate_route_boundary_ty_diag_id = 0
repeat until v4_aggregate_route_boundary_ty_diag_id >= v4_ty_diag_count(v4_aggregate_route_boundary_ty) {
    pilot diag = v4_ty_diag(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_ty_diag_id)
    say "aggregate-boundary-route-ty-diag" + word_from_int(v4_aggregate_route_boundary_ty_diag_id) + "=" + v4_diag_message(diag)
    say "aggregate-boundary-route-ty-diag" + word_from_int(v4_aggregate_route_boundary_ty_diag_id) + "-help=" + v4_diag_help(diag)
    v4_aggregate_route_boundary_ty_diag_id += 1
}

pilot v4_aggregate_route_boundary_route_def = v4_resolve_def_for_name(v4_aggregate_route_boundary_resolve, "route_pass")
pilot v4_aggregate_route_boundary_route_sig = v4_ty_lookup_signature(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_route_def)
say "aggregate-boundary-route-leaves=" + word_from_int(v4_ty_signature_return_lend_leaf_count(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_route_sig))
say "aggregate-boundary-route-guard=" + v4_ty_signature_return_lend_leaf_route_guard_at(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_route_sig, 0)
say "aggregate-boundary-route-source-guard=" + v4_ty_signature_return_lend_source_route_guard_at(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_route_sig, 0, 0)
pilot v4_aggregate_route_boundary_nested_def = v4_resolve_def_for_name(v4_aggregate_route_boundary_resolve, "nested_owned_escape")
pilot v4_aggregate_route_boundary_nested_sig = v4_ty_lookup_signature(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_nested_def)
say "aggregate-boundary-nested-route-guard=" + v4_ty_signature_return_lend_leaf_route_guard_at(v4_aggregate_route_boundary_ty, v4_aggregate_route_boundary_nested_sig, 0)
say "aggregate-boundary-owned-diagnostic=" + v4_aggregate_route_boundary_bool(v4_aggregate_route_boundary_borrow_diag_contains(v4_aggregate_route_boundary_borrow, "return an aggregate loan of an owned value"))
