pilot v4_mir_check_route_bad_case_stream = v4_lex_text(5, v4_mir_check_route_bad_case_source())
pilot v4_mir_check_route_bad_case_tree = v4_parse_stream(5, v4_mir_check_route_bad_case_stream)
pilot v4_mir_check_route_bad_case_hir = v4_hir_lower_tree(5, v4_mir_check_route_bad_case_tree)
pilot v4_mir_check_route_bad_case_resolve = v4_resolve_lower_hir(5, v4_mir_check_route_bad_case_hir)
pilot v4_mir_check_route_bad_case_ty = v4_ty_lower_resolve(5, v4_mir_check_route_bad_case_resolve)
pilot v4_mir_check_route_bad_case_mir = v4_mir_lower_ty(5, v4_mir_check_route_bad_case_ty)
say "check-route-bad-case-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_check_route_bad_case_mir))
say "check-route-bad-case-message=" + v4_diag_message(v4_mir_diag(v4_mir_check_route_bad_case_mir, 0))
