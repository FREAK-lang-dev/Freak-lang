say "check-route-bad-nonroute-message=" + v4_diag_message(v4_mir_diag(v4_mir_check_route_bad_nonroute_mir, 0))
say "check-route-bad-nonroute-help=" + v4_diag_help(v4_mir_diag(v4_mir_check_route_bad_nonroute_mir, 0))

pilot v4_mir_check_route_bad_missing_stream = v4_lex_text(2, v4_mir_check_route_bad_missing_source())
pilot v4_mir_check_route_bad_missing_tree = v4_parse_stream(2, v4_mir_check_route_bad_missing_stream)
