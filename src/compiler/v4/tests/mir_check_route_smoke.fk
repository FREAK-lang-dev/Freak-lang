pilot v4_mir_check_route_bad_missing_resolve = v4_resolve_lower_hir(2, v4_mir_check_route_bad_missing_hir)
pilot v4_mir_check_route_bad_missing_ty = v4_ty_lower_resolve(2, v4_mir_check_route_bad_missing_resolve)
pilot v4_mir_check_route_bad_missing_mir = v4_mir_lower_ty(2, v4_mir_check_route_bad_missing_ty)
say "check-route-bad-missing-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_check_route_bad_missing_mir))
say "check-route-bad-missing-message=" + v4_diag_message(v4_mir_diag(v4_mir_check_route_bad_missing_mir, 0))
say "check-route-bad-missing-help=" + v4_diag_help(v4_mir_diag(v4_mir_check_route_bad_missing_mir, 0))

pilot v4_mir_check_route_bad_duplicate_stream = v4_lex_text(3, v4_mir_check_route_bad_duplicate_source())
