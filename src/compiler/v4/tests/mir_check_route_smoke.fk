say "check-route-bad-duplicate-help=" + v4_diag_help(v4_mir_diag(v4_mir_check_route_bad_duplicate_mir, 0))

pilot v4_mir_check_route_bad_other_stream = v4_lex_text(4, v4_mir_check_route_bad_other_route_source())
pilot v4_mir_check_route_bad_other_tree = v4_parse_stream(4, v4_mir_check_route_bad_other_stream)
pilot v4_mir_check_route_bad_other_hir = v4_hir_lower_tree(4, v4_mir_check_route_bad_other_tree)
pilot v4_mir_check_route_bad_other_resolve = v4_resolve_lower_hir(4, v4_mir_check_route_bad_other_hir)
pilot v4_mir_check_route_bad_other_ty = v4_ty_lower_resolve(4, v4_mir_check_route_bad_other_resolve)
pilot v4_mir_check_route_bad_other_mir = v4_mir_lower_ty(4, v4_mir_check_route_bad_other_ty)
