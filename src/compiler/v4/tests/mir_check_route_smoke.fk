pilot v4_mir_check_route_stream = v4_lex_text(0, v4_mir_check_route_good_source())
pilot v4_mir_check_route_tree = v4_parse_stream(0, v4_mir_check_route_stream)
pilot v4_mir_check_route_hir = v4_hir_lower_tree(0, v4_mir_check_route_tree)
pilot v4_mir_check_route_resolve = v4_resolve_lower_hir(0, v4_mir_check_route_hir)
pilot v4_mir_check_route_ty = v4_ty_lower_resolve(0, v4_mir_check_route_resolve)
pilot v4_mir_check_route_mir = v4_mir_lower_ty(0, v4_mir_check_route_ty)

pilot v4_mir_check_route_score_def = v4_resolve_def_for_name(v4_mir_check_route_resolve, "score")
pilot v4_mir_check_route_score_body = v4_mir_lookup_body(v4_mir_check_route_mir, v4_mir_check_route_score_def)
pilot v4_mir_check_route_arm_stmt = v4_mir_check_route_find_stmt(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_stmt_branch, "event == Event::Key")
pilot v4_mir_check_route_key_code_stmt = v4_mir_check_route_find_stmt(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_stmt_local, "key_code")
pilot v4_mir_check_route_held_stmt = v4_mir_check_route_find_stmt(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_stmt_local, "held")
pilot v4_mir_check_route_key_code_rvalue = v4_mir_stmt_rvalue(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_key_code_stmt)
pilot v4_mir_check_route_held_rvalue = v4_mir_stmt_rvalue(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_held_stmt)
pilot v4_mir_check_route_key_code_place = v4_mir_rvalue_lhs(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_key_code_rvalue)
pilot v4_mir_check_route_held_place = v4_mir_rvalue_lhs(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_held_rvalue)

say v4_mir_summary(v4_mir_check_route_mir)
say "check-route-arm-kind=" + v4_mir_stmt_kind(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_arm_stmt)
say "check-route-arm-lhs=" + v4_mir_stmt_lhs(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_arm_stmt)
say "check-route-key-code-kind=" + v4_mir_rvalue_kind(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_key_code_rvalue)
say "check-route-key-code-ty=" + v4_mir_rvalue_ty(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_key_code_rvalue)
say "check-route-key-code-source-field=" + v4_mir_place_field(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_key_code_place)
say "check-route-key-code-source-ty=" + v4_mir_place_ty(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_key_code_place)
say "check-route-held-kind=" + v4_mir_rvalue_kind(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_held_rvalue)
say "check-route-held-ty=" + v4_mir_rvalue_ty(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_held_rvalue)
say "check-route-held-source-field=" + v4_mir_place_field(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_held_place)
say "check-route-held-source-ty=" + v4_mir_place_ty(v4_mir_check_route_mir, v4_mir_check_route_score_body, v4_mir_check_route_held_place)
say "check-route-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_check_route_mir))

pilot v4_mir_check_route_bad_nonroute_stream = v4_lex_text(1, v4_mir_check_route_bad_nonroute_source())
pilot v4_mir_check_route_bad_nonroute_tree = v4_parse_stream(1, v4_mir_check_route_bad_nonroute_stream)
pilot v4_mir_check_route_bad_nonroute_hir = v4_hir_lower_tree(1, v4_mir_check_route_bad_nonroute_tree)
