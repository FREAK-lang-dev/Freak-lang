-- V4 MIR check-route lowering smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_check_route_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_mir_check_route_find_stmt(mir_id: int, body_id: int, kind: word, lhs: word) -> int {
    pilot stmt_id = 0
    repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == kind and v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == lhs {
            give back stmt_id
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_mir_check_route_good_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_check_route_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task score(event: Event) -> int {\n"
    src = src + "    check route event {\n"
    src = src + "        Event::Key " + v4_mir_check_route_braces(" code: key_code, repeat: held ") + " -> give back key_code\n"
    src = src + "        Event::Closed -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back -1\n"
    src = src + "}\n"
    give back src
}

task v4_mir_check_route_bad_nonroute_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task bad(score: int) -> int {\n"
    src = src + "    check route score {\n"
    src = src + "        Key -> give back 1\n"
    src = src + "        _ -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_mir_check_route_bad_missing_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "task bad(outcome: Outcome) -> int {\n"
    src = src + "    check route outcome {\n"
    src = src + "        Victory -> give back 1\n"
    src = src + "    }\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

