-- Emits a scalar program that proves mutable defaults and both immutable aliases.
task v4_prerelease_grounded_execute() -> void {
    pilot source = fs::read(process::arg(1))
    pilot stream = v4_lex_text(0, source)
    pilot tree = v4_parse_stream(0, stream)
    pilot hir = v4_hir_lower_tree(0, tree)
    pilot resolve = v4_resolve_lower_hir(0, hir)
    pilot ty = v4_ty_lower_resolve(0, resolve)
    pilot mir = v4_mir_lower_ty(0, ty)
    pilot borrow = v4_borrowck_check_mir(0, mir)
    pilot codegen = v4_codegen_llvm_lower_mir(0, mir)
    pilot total = v4_lex_diag_count(stream) + v4_parse_diag_count(tree) + v4_hir_diag_count(hir) + v4_resolve_diag_count(resolve) + v4_ty_diag_count(ty) + v4_mir_diag_count(mir) + v4_borrowck_diag_count(borrow) + v4_codegen_llvm_diag_count(codegen)
    if total != 0 { panic("prerelease grounded native frontend diagnostics") }
    pilot target = v4_target_spec_new(process::arg(2))
    pilot module = v4_codegen_llvm_module_text(codegen, target)
    if v4_codegen_llvm_native_module_error(codegen) != "" or module == "" { panic("prerelease grounded native module: " + v4_codegen_llvm_native_module_error(codegen) + "; target=" + process::arg(2)) }
    say "prerelease-grounded-execute diagnostics=0"
    say "@@LLVM-MODULE-BEGIN"
    say module
    say "@@LLVM-MODULE-END"
}
v4_prerelease_grounded_execute()
