-- V4 MIR typed field/index mutation smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_place_mutation_good_source() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "    callsign: word\n"
    src = src + "}\n"
    src = src + "task main(ship: Pilot, items: List<int>) -> int {\n"
    src = src + "    ship.hp += 2\n"
    src = src + "    items[0] = ship.hp\n"
    src = src + "    items[1] += ship.hp\n"
    src = src + "    give back items[1]\n"
    src = src + "}\n"
    give back src
}

task v4_mir_place_mutation_bad_field_type_source() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task bad(ship: Pilot) -> void {\n"
    src = src + "    ship.hp = \"broken\"\n"
    src = src + "}\n"
    give back src
}

task v4_mir_place_mutation_bad_index_type_source() -> word {
    pilot src = "task bad(items: List<int>) -> void {\n"
    src = src + "    items[0] = \"broken\"\n"
    src = src + "}\n"
    give back src
}

task v4_mir_place_mutation_bad_field_compound_source() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    callsign: word\n"
    src = src + "}\n"
    src = src + "task bad(ship: Pilot) -> void {\n"
    src = src + "    ship.callsign += 1\n"
    src = src + "}\n"
    give back src
}

task v4_mir_place_mutation_bad_index_target_source() -> word {
    pilot src = "task bad(power: int) -> void {\n"
    src = src + "    power[0] += 1\n"
    src = src + "}\n"
    give back src
}

task v4_mir_place_mutation_bad_index_expr_source() -> word {
    pilot src = "task bad(items: List<int>) -> void {\n"
    src = src + "    items[\"zero\"] += 1\n"
    src = src + "}\n"
    give back src
}

