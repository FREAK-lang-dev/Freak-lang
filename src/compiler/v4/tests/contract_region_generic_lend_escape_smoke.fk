-- V4 contract-region generic-call lend escape fixture.
-- Verification prepends the V4 crates before this file.

task v4_contract_region_generic_lend_escape_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_contract_region_generic_lend_escape_diag_count(mir_id: int, message: word) -> int {
    pilot total = 0
    pilot diag_id = 0
    repeat until diag_id >= v4_mir_diag_count(mir_id) {
        if v4_diag_message(v4_mir_diag(mir_id, diag_id)) == message {
            total += 1
        }
        diag_id += 1
    }
    give back total
}

task v4_contract_region_generic_lend_escape_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_contract_region_impl_for_target(ty_id: int, target_ty: word) -> int {
    pilot hir_id = v4_resolve_hir_id(v4_ty_resolve_id(ty_id))
    pilot hir_item = 0
    repeat until hir_item >= v4_hir_item_count(hir_id) {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl and v4_ty_impl_target_type_from_hir(ty_id, hir_item) == target_ty {
            give back hir_item
        }
        hir_item += 1
    }
    give back 0 - 1
}

task v4_contract_region_generic_lend_escape_local_rvalue(mir_id: int, body_id: int, local_name: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_local and v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == local_name {
            give back v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_contract_region_mir_snapshot_integrity(mir_id: int, body_id: int, borrow_rvalue: int, forged_rvalue: int, shadow_mir: int, shadow_body: int, shadow_rvalue: int) -> void {
    pilot snapshot = v4_mir_snapshot()
    array_set(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), borrow_rvalue, v4_mir_builtin_shared_clone)
    say "contract-region-builtin-identity-poisoned-before-restore=" + v4_contract_region_generic_lend_escape_bool(v4_mir_rvalue_builtin_method(mir_id, body_id, borrow_rvalue) == v4_mir_builtin_shared_clone)

    pilot missing_field_snapshot = "mir-snapshot|format=freak-mir-snapshot-v5|files=1|bodies=1|blocks=0|locals=0|statements=0|places=0|rvalues=1|diagnostics=0\n"
    missing_field_snapshot = missing_field_snapshot + "mir|0|0|0|1|0\n"
    missing_field_snapshot = missing_field_snapshot + "mir-body|0|0||||0|0|0|0|1\n"
    missing_field_snapshot = missing_field_snapshot + "mir-rvalue|0|0|0||||-1|-1||||\n"
    missing_field_snapshot = missing_field_snapshot + "end|freak-mir-snapshot-v5"
    pilot missing_field_validation = v4_mir_snapshot_validate(missing_field_snapshot)
    pilot missing_field_restore = v4_mir_snapshot_restore(missing_field_snapshot)
    say "contract-region-mir-snapshot-missing-field-validation-rejected=" + v4_contract_region_generic_lend_escape_bool(missing_field_validation.starts_with("mir-snapshot-import ok=0"))
    say "contract-region-mir-snapshot-missing-field-restore-rejected=" + v4_contract_region_generic_lend_escape_bool(missing_field_restore.starts_with("mir-snapshot-restore ok=0"))

    pilot legacy_snapshot = "mir-snapshot|format=freak-mir-snapshot-v4|files=0|bodies=0|blocks=0|locals=0|statements=0|places=0|rvalues=0|diagnostics=0\n"
    legacy_snapshot = legacy_snapshot + "end|freak-mir-snapshot-v4"
    pilot legacy_validation = v4_mir_snapshot_validate(legacy_snapshot)
    pilot legacy_restore = v4_mir_snapshot_restore(legacy_snapshot)
    say "contract-region-mir-snapshot-v4-validation-rejected=" + v4_contract_region_generic_lend_escape_bool(legacy_validation.starts_with("mir-snapshot-import ok=0"))
    say "contract-region-mir-snapshot-v4-restore-rejected=" + v4_contract_region_generic_lend_escape_bool(legacy_restore.starts_with("mir-snapshot-restore ok=0"))

    pilot child_first_snapshot = "mir-snapshot|format=freak-mir-snapshot-v5|files=1|bodies=1|blocks=1|locals=0|statements=0|places=0|rvalues=0|diagnostics=0\n"
    child_first_snapshot = child_first_snapshot + "mir|0|0|0|1|0\n"
    child_first_snapshot = child_first_snapshot + "mir-block|0|0|0|\n"
    child_first_snapshot = child_first_snapshot + "mir-body|0|0||||0|0|0|0|0\n"
    child_first_snapshot = child_first_snapshot + "end|freak-mir-snapshot-v5"
    pilot child_first_validation = v4_mir_snapshot_validate(child_first_snapshot)
    pilot child_first_restore = v4_mir_snapshot_restore(child_first_snapshot)
    say "contract-region-mir-snapshot-child-before-parent-validation-rejected=" + v4_contract_region_generic_lend_escape_bool(child_first_validation.starts_with("mir-snapshot-import ok=0"))
    say "contract-region-mir-snapshot-child-before-parent-restore-rejected=" + v4_contract_region_generic_lend_escape_bool(child_first_restore.starts_with("mir-snapshot-restore ok=0"))
    say "contract-region-mir-snapshot-invalid-restore-state-stable=" + v4_contract_region_generic_lend_escape_bool(v4_mir_rvalue_builtin_method(mir_id, body_id, borrow_rvalue) == v4_mir_builtin_shared_clone)

    pilot restore = v4_mir_snapshot_restore(snapshot)
    say "contract-region-builtin-identity-restore-ok=" + v4_contract_region_generic_lend_escape_bool(restore.starts_with("mir-snapshot-restore ok=1"))
    say "contract-region-builtin-identity-borrow-after-restore=" + v4_contract_region_generic_lend_escape_bool(v4_mir_rvalue_is_builtin_shared_method(mir_id, body_id, borrow_rvalue, v4_mir_builtin_shared_borrow))
    say "contract-region-builtin-identity-forged-after-restore=" + v4_contract_region_generic_lend_escape_bool(v4_mir_rvalue_is_builtin_shared_method(mir_id, body_id, forged_rvalue, v4_mir_builtin_shared_borrow))
    say "contract-region-builtin-identity-shadow-after-restore=" + v4_contract_region_generic_lend_escape_bool(v4_mir_rvalue_is_builtin_shared_method(shadow_mir, shadow_body, shadow_rvalue, v4_mir_builtin_shared_borrow))
}

task v4_contract_region_generic_lend_escape_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Direct<'a> {\n"
    src = src + "    view: lend 'a Ship\n"
    src = src + "}\n"
    src = src + "task wrap<T>(value: T) -> maybe<T> {\n"
    src = src + "    give back some(value)\n"
    src = src + "}\n"
    src = src + "task identity<T>(value: T) -> T {\n"
    src = src + "    give back value\n"
    src = src + "}\n"
    src = src + "task reviewer_escape<'a>(lend 'a value: Ship) -> int {\n"
    src = src + "    pilot wrapped = wrap(lend value)\n"
    src = src + "    pilot direct = identity(lend value)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task reviewer_nominal_escape<'a>(lend 'a value: Ship) -> int {\n"
    src = src + "    pilot stored = Direct<'a> " + v4_contract_region_generic_lend_escape_braces(" view: lend value ") + "\n"
    src = src + "    pilot escaped = identity(stored)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_owner_generic_happy_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Direct<'a> {\n"
    src = src + "    view: lend 'a Ship\n"
    src = src + "}\n"
    src = src + "impl Direct<'a> {\n"
    src = src + "    task relay(self, value: Direct<'a>) -> Direct<'a> {\n"
    src = src + "        give back value\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "impl Box<T> {\n"
    src = src + "    task keep(self) -> Box<T> {\n"
    src = src + "        give back self\n"
    src = src + "    }\n"
    src = src + "    task pack(value: T) -> Box<T> {\n"
    src = src + "        give back Box<T> " + v4_contract_region_generic_lend_escape_braces(" value: value ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task owner_happy(box: Box<Ship>, first: Ship, second: Ship) -> int {\n"
    src = src + "    pilot kept = box.keep()\n"
    src = src + "    pilot packed = Box<Ship>::pack(first)\n"
    src = src + "    pilot shared = Shared<Ship>::new(second)\n"
    src = src + "    pilot borrowed = shared.borrow()\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_owner_generic_negative_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Direct<'a> {\n"
    src = src + "    view: lend 'a Ship\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "doctrine Add " + v4_contract_region_generic_lend_escape_braces(" task add(self, other: Self) -> Self ") + "\n"
    src = src + "impl Box<T> {\n"
    src = src + "    task keep(self) -> Box<T> {\n"
    src = src + "        give back self\n"
    src = src + "    }\n"
    src = src + "    task pack(value: T) -> Box<T> {\n"
    src = src + "        give back Box<T> " + v4_contract_region_generic_lend_escape_braces(" value: value ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Direct<'a> {\n"
    src = src + "    task keep(self) -> Direct<'a> {\n"
    src = src + "        give back self\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Add for Box<T> {\n"
    src = src + "    task add(self, other: Box<T>) -> Box<T> {\n"
    src = src + "        give back self\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task instance_escape(box: Box<lend Ship>) -> int {\n"
    src = src + "    pilot hidden_instance = box.keep()\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task owner_escape<'a>(lend 'a first: Ship, lend 'a second: Ship) -> int {\n"
    src = src + "    pilot hidden_associated = Box<lend Ship>::pack(lend first)\n"
    src = src + "    pilot hidden_shared = Shared<lend Ship>::new(lend second)\n"
    src = src + "    pilot stored = Direct<'a> " + v4_contract_region_generic_lend_escape_braces(" view: lend first ") + "\n"
    src = src + "    pilot hidden_nominal_associated = Box<Direct<'a>>::pack(stored)\n"
    src = src + "    pilot wrapped = Box<Direct<'a>> " + v4_contract_region_generic_lend_escape_braces(" value: stored ") + "\n"
    src = src + "    pilot hidden_nominal_instance = wrapped.keep()\n"
    src = src + "    pilot hidden_nominal_shared = Shared<Direct<'a>>::new(stored)\n"
    src = src + "    pilot hidden_direct_instance = stored.keep()\n"
    src = src + "    pilot hidden_operator = wrapped + wrapped\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_shadowed_shared_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Shared<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "impl Shared<T> {\n"
    src = src + "    task borrow(self) -> T {\n"
    src = src + "        give back self.value\n"
    src = src + "    }\n"
    src = src + "    task new(value: T) -> Shared<T> {\n"
    src = src + "        give back Shared<T> " + v4_contract_region_generic_lend_escape_braces(" value: value ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task shadowed_shared(box: Shared<Ship>, ship: Ship) -> int {\n"
    src = src + "    pilot view = box.borrow()\n"
    src = src + "    pilot made = Shared<Ship>::new(ship)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_contract_region_generic_lend_escape_mir = v4_mir_text_cached("contract-region-generic-lend-escape.fk", v4_contract_region_generic_lend_escape_source())
pilot v4_contract_region_generic_lend_escape_ty = v4_mir_ty_id(v4_contract_region_generic_lend_escape_mir)
pilot v4_contract_region_generic_lend_escape_resolve = v4_ty_resolve_id(v4_contract_region_generic_lend_escape_ty)
pilot v4_contract_region_generic_lend_escape_hir = v4_resolve_hir_id(v4_contract_region_generic_lend_escape_resolve)
pilot v4_contract_region_generic_lend_escape_tree = v4_hir_tree_id(v4_contract_region_generic_lend_escape_hir)
pilot v4_contract_region_generic_lend_escape_def = v4_resolve_def_for_name(v4_contract_region_generic_lend_escape_resolve, "reviewer_escape")
pilot v4_contract_region_generic_lend_escape_body = v4_mir_lookup_body(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_def)
pilot v4_contract_region_generic_lend_escape_wrapped = v4_mir_find_local(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_body, "wrapped")
pilot v4_contract_region_generic_lend_escape_direct = v4_mir_find_local(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_body, "direct")
pilot v4_contract_region_generic_lend_escape_wrapped_ty = v4_mir_local_ty(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_body, v4_contract_region_generic_lend_escape_wrapped)
pilot v4_contract_region_generic_lend_escape_direct_ty = v4_mir_local_ty(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_body, v4_contract_region_generic_lend_escape_direct)
pilot v4_contract_region_generic_lend_escape_nominal_def = v4_resolve_def_for_name(v4_contract_region_generic_lend_escape_resolve, "reviewer_nominal_escape")
pilot v4_contract_region_generic_lend_escape_nominal_body = v4_mir_lookup_body(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_nominal_def)
pilot v4_contract_region_generic_lend_escape_nominal_local = v4_mir_find_local(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_nominal_body, "escaped")
pilot v4_contract_region_generic_lend_escape_nominal_ty = v4_mir_local_ty(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_nominal_body, v4_contract_region_generic_lend_escape_nominal_local)
pilot v4_contract_region_generic_lend_escape_message = "Meiya cannot substitute a lend-bearing type for a generic call yet"

say "contract-region-generic-lend-escape-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_contract_region_generic_lend_escape_tree))
say "contract-region-generic-lend-escape-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_contract_region_generic_lend_escape_ty))
say "contract-region-generic-lend-escape-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_contract_region_generic_lend_escape_mir))
pilot v4_contract_region_method_boundary_message = "Meiya cannot carry a lend-bearing aggregate across a method call yet"
say "contract-region-generic-lend-escape-meiya-count=" + word_from_int(v4_contract_region_generic_lend_escape_diag_count(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_message))
say "contract-region-generic-lend-escape-wrap-type=" + v4_contract_region_generic_lend_escape_wrapped_ty
say "contract-region-generic-lend-escape-wrap-hidden-loan=" + v4_contract_region_generic_lend_escape_bool(v4_ty_type_contains_lend(v4_contract_region_generic_lend_escape_wrapped_ty))
say "contract-region-generic-lend-escape-identity-type=" + v4_contract_region_generic_lend_escape_direct_ty
say "contract-region-generic-lend-escape-identity-outer-loan=" + v4_contract_region_generic_lend_escape_bool(v4_ty_type_contains_lend(v4_contract_region_generic_lend_escape_direct_ty))
say "contract-region-generic-lend-escape-diag0-message=" + v4_diag_message(v4_mir_diag(v4_contract_region_generic_lend_escape_mir, 0))
