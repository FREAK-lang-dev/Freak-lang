-- V4 contract-region generic-call lend escape fixture.
-- Verification prepends the V4 crates before this file.

task v4_contract_region_generic_lend_escape_bool(value: bool) -> word {
    if value {
        give back "true"
    }
    give back "false"
}

task v4_contract_region_generic_lend_escape_diag_count(mir_id: int, message: word) -> int {
    pilot total = 0
    pilot diag_id = 0
    repeat until diag_id >= v4_mir_diag_count(mir_id) {
        if v4_diag_message(v4_mir_diag(mir_id, diag_id)) == message {
            total += 1
        }
        diag_id += 1
    }
    give back total
}

task v4_contract_region_generic_lend_escape_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_contract_region_generic_lend_escape_local_rvalue(mir_id: int, body_id: int, local_name: word) -> int {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_local and v4_mir_stmt_lhs(mir_id, body_id, stmt_id) == local_name {
            give back v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
        }
        stmt_id += 1
    }
    give back 0 - 1
}

task v4_contract_region_generic_lend_escape_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task wrap<T>(value: T) -> maybe<T> {\n"
    src = src + "    give back some(value)\n"
    src = src + "}\n"
    src = src + "task identity<T>(value: T) -> T {\n"
    src = src + "    give back value\n"
    src = src + "}\n"
    src = src + "task reviewer_escape<'a>(lend 'a value: Ship) -> int {\n"
    src = src + "    pilot wrapped = wrap(lend value)\n"
    src = src + "    pilot direct = identity(lend value)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_owner_generic_happy_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "impl Box<T> {\n"
    src = src + "    task keep(self) -> Box<T> {\n"
    src = src + "        give back self\n"
    src = src + "    }\n"
    src = src + "    task pack(value: T) -> Box<T> {\n"
    src = src + "        give back Box<T> " + v4_contract_region_generic_lend_escape_braces(" value: value ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task owner_happy(box: Box<Ship>, first: Ship, second: Ship) -> int {\n"
    src = src + "    pilot kept = box.keep()\n"
    src = src + "    pilot packed = Box<Ship>::pack(first)\n"
    src = src + "    pilot shared = Shared<Ship>::new(second)\n"
    src = src + "    pilot borrowed = shared.borrow()\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_owner_generic_negative_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "impl Box<T> {\n"
    src = src + "    task keep(self) -> Box<T> {\n"
    src = src + "        give back self\n"
    src = src + "    }\n"
    src = src + "    task pack(value: T) -> Box<T> {\n"
    src = src + "        give back Box<T> " + v4_contract_region_generic_lend_escape_braces(" value: value ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task instance_escape(box: Box<lend Ship>) -> int {\n"
    src = src + "    pilot hidden_instance = box.keep()\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    src = src + "task owner_escape<'a>(lend 'a first: Ship, lend 'a second: Ship) -> int {\n"
    src = src + "    pilot hidden_associated = Box<lend Ship>::pack(lend first)\n"
    src = src + "    pilot hidden_shared = Shared<lend Ship>::new(lend second)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_contract_region_shadowed_shared_source() -> word {
    pilot src = "shape Ship {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Shared<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "impl Shared<T> {\n"
    src = src + "    task borrow(self) -> T {\n"
    src = src + "        give back self.value\n"
    src = src + "    }\n"
    src = src + "    task new(value: T) -> Shared<T> {\n"
    src = src + "        give back Shared<T> " + v4_contract_region_generic_lend_escape_braces(" value: value ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task shadowed_shared(box: Shared<Ship>, ship: Ship) -> int {\n"
    src = src + "    pilot view = box.borrow()\n"
    src = src + "    pilot made = Shared<Ship>::new(ship)\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_contract_region_generic_lend_escape_mir = v4_mir_text_cached("contract-region-generic-lend-escape.fk", v4_contract_region_generic_lend_escape_source())
pilot v4_contract_region_generic_lend_escape_ty = v4_mir_ty_id(v4_contract_region_generic_lend_escape_mir)
