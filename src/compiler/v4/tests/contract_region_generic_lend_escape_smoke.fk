say "contract-region-generic-lend-escape-diag2-message=" + v4_diag_message(v4_mir_diag(v4_contract_region_generic_lend_escape_mir, 2))
say "contract-region-generic-lend-escape-diag2-help=" + v4_diag_help(v4_mir_diag(v4_contract_region_generic_lend_escape_mir, 2))

pilot v4_contract_region_owner_generic_happy_mir = v4_mir_text_cached("contract-region-owner-generic-happy.fk", v4_contract_region_owner_generic_happy_source())
pilot v4_contract_region_owner_generic_happy_ty = v4_mir_ty_id(v4_contract_region_owner_generic_happy_mir)
pilot v4_contract_region_owner_generic_happy_resolve = v4_ty_resolve_id(v4_contract_region_owner_generic_happy_ty)
pilot v4_contract_region_owner_generic_happy_hir = v4_resolve_hir_id(v4_contract_region_owner_generic_happy_resolve)
pilot v4_contract_region_owner_generic_happy_tree = v4_hir_tree_id(v4_contract_region_owner_generic_happy_hir)
pilot v4_contract_region_owner_generic_happy_def = v4_resolve_def_for_name(v4_contract_region_owner_generic_happy_resolve, "owner_happy")
pilot v4_contract_region_owner_generic_happy_body = v4_mir_lookup_body(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_def)
pilot v4_contract_region_owner_generic_happy_new_rvalue = v4_contract_region_generic_lend_escape_local_rvalue(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, "shared")
pilot v4_contract_region_owner_generic_happy_borrow_rvalue = v4_contract_region_generic_lend_escape_local_rvalue(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, "borrowed")
pilot v4_contract_region_owner_generic_happy_borrow_arg = v4_mir_rvalue_call_arg(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, v4_contract_region_owner_generic_happy_borrow_rvalue, 0)
pilot v4_contract_region_owner_generic_happy_forged_borrow = v4_mir_add_rvalue(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, v4_mir_rvalue_call, "forged shared.borrow()", "Shared<Ship>.borrow", 0 - 1, 0 - 1, V4_NO_SPAN, "lend Ship")
v4_mir_set_rvalue_args_payload(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, v4_contract_region_owner_generic_happy_forged_borrow, v4_mir_call_args_payload_append("", v4_contract_region_owner_generic_happy_borrow_arg))
pilot v4_contract_region_owner_generic_happy_direct_impl = v4_contract_region_impl_for_target(v4_contract_region_owner_generic_happy_ty, "Direct<'a>")
pilot v4_contract_region_owner_generic_happy_alpha_param = v4_ty_impl_method_explicit_param_type_for_owner(v4_contract_region_owner_generic_happy_ty, v4_contract_region_owner_generic_happy_direct_impl, 0, 0, "Direct<'b>")
pilot v4_contract_region_owner_generic_happy_alpha_return = v4_ty_impl_method_return_type_for_owner(v4_contract_region_owner_generic_happy_ty, v4_contract_region_owner_generic_happy_direct_impl, 0, "Direct<'b>")

say "contract-region-owner-generic-happy-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_contract_region_owner_generic_happy_tree))
say "contract-region-owner-generic-happy-ty-diagnostics=" + word_from_int(v4_ty_diag_count(v4_contract_region_owner_generic_happy_ty))
say "contract-region-owner-generic-happy-mir-diagnostics=" + word_from_int(v4_mir_diag_count(v4_contract_region_owner_generic_happy_mir))
say "contract-region-owner-generic-happy-instance-type=" + v4_mir_local_ty_for_name(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, "kept")
say "contract-region-owner-generic-happy-associated-type=" + v4_mir_local_ty_for_name(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, "packed")
say "contract-region-owner-generic-happy-shared-type=" + v4_mir_local_ty_for_name(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, "shared")
say "contract-region-owner-generic-happy-borrow-type=" + v4_mir_local_ty_for_name(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, "borrowed")
say "contract-region-owner-generic-happy-new-identity=" + v4_mir_rvalue_builtin_method(v4_contract_region_owner_generic_happy_mir, v4_contract_region_owner_generic_happy_body, v4_contract_region_owner_generic_happy_new_rvalue)
