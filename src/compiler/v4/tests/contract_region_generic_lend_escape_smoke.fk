pilot v4_contract_region_generic_lend_escape_direct_ty = v4_mir_local_ty(v4_contract_region_generic_lend_escape_mir, v4_contract_region_generic_lend_escape_body, v4_contract_region_generic_lend_escape_direct)
pilot v4_contract_region_generic_lend_escape_message = "Meiya cannot substitute a lend-bearing type for a generic call yet"

say "contract-region-generic-lend-escape-parse-diagnostics=" + word_from_int(v4_parse_diag_count(v4_contract_region_generic_lend_escape_tree))
