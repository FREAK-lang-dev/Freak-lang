-- V4 extern FFI-safety smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_extern_ffi_good_source() -> word {
    pilot src = "@layout(C)\n"
    src = src + "shape Vec2 {\n"
    src = src + "    x: std::ffi::c_double\n"
    src = src + "    y: std::ffi::c_double\n"
    src = src + "}\n"
    src = src + "@layout(C)\n"
    src = src + "shape Node {\n"
    src = src + "    next: *mut Node\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task distance(points: *const Vec2, count: std::ffi::c_size) -> std::ffi::c_double\n"
    src = src + "    task walk(node: *const Node) -> std::ffi::c_int\n"
    src = src + "    task fill(dst: *mut tiny, value: std::ffi::c_uchar, len: std::ffi::c_size) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_extern_ffi_bad_source() -> word {
    pilot src = "@layout(C)\n"
    src = src + "shape BadHeader {\n"
    src = src + "    text: word\n"
    src = src + "}\n"
    src = src + "@layout(C)\n"
    src = src + "shape BadPointer {\n"
    src = src + "    text: *const word\n"
    src = src + "}\n"
    src = src + "shape PlainVec {\n"
    src = src + "    x: int\n"
    src = src + "}\n"
    src = src + "extern [C] {\n"
    src = src + "    task puts(text: word) -> int\n"
    src = src + "    task ship(header: BadHeader) -> void\n"
    src = src + "    task ok(text: *const tiny) -> std::ffi::c_int\n"
    src = src + "    task scan(text: *const word) -> std::ffi::c_int\n"
    src = src + "    task trace(points: *const PlainVec) -> std::ffi::c_int\n"
    src = src + "    task send(box: BadPointer) -> std::ffi::c_int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

pilot v4_extern_ffi_good_text = v4_extern_ffi_good_source()
pilot v4_extern_ffi_good_stream = v4_lex_text(0, v4_extern_ffi_good_text)
pilot v4_extern_ffi_good_tree = v4_parse_stream(0, v4_extern_ffi_good_stream)
pilot v4_extern_ffi_good_hir = v4_hir_lower_tree(0, v4_extern_ffi_good_tree)
pilot v4_extern_ffi_good_resolve = v4_resolve_lower_hir(0, v4_extern_ffi_good_hir)
pilot v4_extern_ffi_good_ty = v4_ty_lower_resolve(0, v4_extern_ffi_good_resolve)

pilot v4_extern_ffi_vec2_def = v4_resolve_def_for_name(v4_extern_ffi_good_resolve, "Vec2")
pilot v4_extern_ffi_distance_def = v4_resolve_def_for_name(v4_extern_ffi_good_resolve, "distance")
pilot v4_extern_ffi_walk_def = v4_resolve_def_for_name(v4_extern_ffi_good_resolve, "walk")
pilot v4_extern_ffi_fill_def = v4_resolve_def_for_name(v4_extern_ffi_good_resolve, "fill")
pilot v4_extern_ffi_vec2_sig = v4_ty_lookup_signature(v4_extern_ffi_good_ty, v4_extern_ffi_vec2_def)
pilot v4_extern_ffi_distance_sig = v4_ty_lookup_signature(v4_extern_ffi_good_ty, v4_extern_ffi_distance_def)
pilot v4_extern_ffi_walk_sig = v4_ty_lookup_signature(v4_extern_ffi_good_ty, v4_extern_ffi_walk_def)
pilot v4_extern_ffi_fill_sig = v4_ty_lookup_signature(v4_extern_ffi_good_ty, v4_extern_ffi_fill_def)

say "extern-ffi-good-vec2-layout=" + v4_ty_signature_layout(v4_extern_ffi_good_ty, v4_extern_ffi_vec2_sig)
say "extern-ffi-good-distance-param0=" + v4_ty_signature_param_type(v4_extern_ffi_good_ty, v4_extern_ffi_distance_sig, 0)
say "extern-ffi-good-distance-param1=" + v4_ty_signature_param_type(v4_extern_ffi_good_ty, v4_extern_ffi_distance_sig, 1)
say "extern-ffi-good-distance-return=" + v4_ty_signature_return_type(v4_extern_ffi_good_ty, v4_extern_ffi_distance_sig)
say "extern-ffi-good-walk-param0=" + v4_ty_signature_param_type(v4_extern_ffi_good_ty, v4_extern_ffi_walk_sig, 0)
say "extern-ffi-good-fill-param0=" + v4_ty_signature_param_type(v4_extern_ffi_good_ty, v4_extern_ffi_fill_sig, 0)
say "extern-ffi-good-fill-param1=" + v4_ty_signature_param_type(v4_extern_ffi_good_ty, v4_extern_ffi_fill_sig, 1)
say "extern-ffi-good-fill-param2=" + v4_ty_signature_param_type(v4_extern_ffi_good_ty, v4_extern_ffi_fill_sig, 2)
say "extern-ffi-good-fill-return=" + v4_ty_signature_return_type(v4_extern_ffi_good_ty, v4_extern_ffi_fill_sig)
say "extern-ffi-good-diag-count=" + word_from_int(v4_ty_diag_count(v4_extern_ffi_good_ty))

pilot v4_extern_ffi_bad_text = v4_extern_ffi_bad_source()
pilot v4_extern_ffi_bad_stream = v4_lex_text(1, v4_extern_ffi_bad_text)
pilot v4_extern_ffi_bad_tree = v4_parse_stream(1, v4_extern_ffi_bad_stream)
pilot v4_extern_ffi_bad_hir = v4_hir_lower_tree(1, v4_extern_ffi_bad_tree)
pilot v4_extern_ffi_bad_resolve = v4_resolve_lower_hir(1, v4_extern_ffi_bad_hir)
pilot v4_extern_ffi_bad_ty = v4_ty_lower_resolve(1, v4_extern_ffi_bad_resolve)

say "extern-ffi-bad-diag-count=" + word_from_int(v4_ty_diag_count(v4_extern_ffi_bad_ty))
say "extern-ffi-bad-diag0-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 0))
say "extern-ffi-bad-diag0-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 0))
say "extern-ffi-bad-diag1-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 1))
say "extern-ffi-bad-diag1-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 1))
say "extern-ffi-bad-diag2-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 2))
say "extern-ffi-bad-diag2-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 2))
say "extern-ffi-bad-diag3-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 3))
say "extern-ffi-bad-diag3-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 3))
say "extern-ffi-bad-diag4-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 4))
say "extern-ffi-bad-diag4-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 4))
say "extern-ffi-bad-diag5-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 5))
say "extern-ffi-bad-diag5-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 5))
say "extern-ffi-bad-diag6-message=" + v4_diag_message(v4_ty_diag(v4_extern_ffi_bad_ty, 6))
say "extern-ffi-bad-diag6-help=" + v4_diag_help(v4_ty_diag(v4_extern_ffi_bad_ty, 6))
