-- V4 MIR smoke fixture.
-- Verification prepends the V4 crates before this file.

pilot v4_mir_smoke_source = "task main() -> int {\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot x = 40\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot y = x + 2\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    if y > 40 {\n"
v4_mir_smoke_source = v4_mir_smoke_source + "        pilot z = y\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    } else {\n"
v4_mir_smoke_source = v4_mir_smoke_source + "        pilot z = 0\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    }\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    repeat until y > 45 {\n"
v4_mir_smoke_source = v4_mir_smoke_source + "        y = y + 1\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    }\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot ship = helper()\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    ship.hp = y\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot items = helper()\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    items[0] = y\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot w = helper()\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    give back y\n"
v4_mir_smoke_source = v4_mir_smoke_source + "}\n"
v4_mir_smoke_source = v4_mir_smoke_source + "shape Pilot\n"
v4_mir_smoke_source = v4_mir_smoke_source + "task helper() => \"ok\"\n"

pilot v4_mir_smoke_stream = v4_lex_text(0, v4_mir_smoke_source)
pilot v4_mir_smoke_tree = v4_parse_stream(0, v4_mir_smoke_stream)
pilot v4_mir_smoke_hir = v4_hir_lower_tree(0, v4_mir_smoke_tree)
pilot v4_mir_smoke_resolve = v4_resolve_lower_hir(0, v4_mir_smoke_hir)
pilot v4_mir_smoke_ty = v4_ty_lower_resolve(0, v4_mir_smoke_resolve)
pilot v4_mir_smoke_mir = v4_mir_lower_ty(0, v4_mir_smoke_ty)
pilot v4_mir_main_def = v4_resolve_def_for_name(v4_mir_smoke_resolve, "main")
pilot v4_mir_main_body = v4_mir_lookup_body(v4_mir_smoke_mir, v4_mir_main_def)
pilot v4_mir_entry_block = v4_mir_body_block(v4_mir_smoke_mir, v4_mir_main_body, 0)
pilot v4_mir_y_stmt_rvalue = v4_mir_stmt_rvalue(v4_mir_smoke_mir, v4_mir_main_body, 1)
pilot v4_mir_y_stmt_place = v4_mir_stmt_place(v4_mir_smoke_mir, v4_mir_main_body, 1)
pilot v4_mir_field_stmt_place = v4_mir_stmt_place(v4_mir_smoke_mir, v4_mir_main_body, 8)
pilot v4_mir_index_stmt_place = v4_mir_stmt_place(v4_mir_smoke_mir, v4_mir_main_body, 10)

say v4_mir_summary(v4_mir_smoke_mir)
say "main-body=" + word_from_int(v4_mir_main_body)
say "entry-term=" + v4_mir_block_terminator(v4_mir_entry_block)
say "entry-cond=" + v4_mir_block_condition(v4_mir_entry_block)
say "entry-target=" + word_from_int(v4_mir_block_target(v4_mir_entry_block))
say "entry-else=" + word_from_int(v4_mir_block_else_target(v4_mir_entry_block))
say "main-blocks=" + word_from_int(v4_mir_body_block_count(v4_mir_smoke_mir, v4_mir_main_body))
say "main-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_smoke_mir, v4_mir_main_body))
say "main-stmts=" + word_from_int(v4_mir_body_stmt_count(v4_mir_smoke_mir, v4_mir_main_body))
say "main-places=" + word_from_int(v4_mir_body_place_count(v4_mir_smoke_mir, v4_mir_main_body))
say "main-rvalues=" + word_from_int(v4_mir_body_rvalue_count(v4_mir_smoke_mir, v4_mir_main_body))
say "first-local=" + v4_mir_local_name(v4_mir_smoke_mir, v4_mir_main_body, 0)
say "first-local-ty=" + v4_mir_local_ty(v4_mir_smoke_mir, v4_mir_main_body, 0)
say "stmt0-block=" + word_from_int(v4_mir_stmt_block(v4_mir_smoke_mir, v4_mir_main_body, 0))
say "stmt1-place-kind=" + v4_mir_place_kind(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_y_stmt_place)
say "stmt1-place-ty=" + v4_mir_place_ty(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_y_stmt_place)
say "stmt1-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_y_stmt_rvalue)
say "stmt1-rvalue-op=" + v4_mir_rvalue_op(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_y_stmt_rvalue)
say "stmt1-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_y_stmt_rvalue)
say "field-place-kind=" + v4_mir_place_kind(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_field_stmt_place)
say "field-place-name=" + v4_mir_place_field(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_field_stmt_place)
say "index-place-kind=" + v4_mir_place_kind(v4_mir_smoke_mir, v4_mir_main_body, v4_mir_index_stmt_place)
say "body-count=" + word_from_int(v4_mir_body_count(v4_mir_smoke_mir))
