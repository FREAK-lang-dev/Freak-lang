-- V4 MIR smoke fixture.
-- Verification prepends the V4 crates before this file.

pilot v4_mir_smoke_source = "task main() -> int {\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot x = 40\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    pilot y = x + 2\n"
v4_mir_smoke_source = v4_mir_smoke_source + "    give back y\n"
v4_mir_smoke_source = v4_mir_smoke_source + "}\n"
v4_mir_smoke_source = v4_mir_smoke_source + "shape Pilot\n"
v4_mir_smoke_source = v4_mir_smoke_source + "task helper() => \"ok\"\n"

pilot v4_mir_smoke_stream = v4_lex_text(0, v4_mir_smoke_source)
pilot v4_mir_smoke_tree = v4_parse_stream(0, v4_mir_smoke_stream)
pilot v4_mir_smoke_hir = v4_hir_lower_tree(0, v4_mir_smoke_tree)
pilot v4_mir_smoke_resolve = v4_resolve_lower_hir(0, v4_mir_smoke_hir)
pilot v4_mir_smoke_ty = v4_ty_lower_resolve(0, v4_mir_smoke_resolve)
pilot v4_mir_smoke_mir = v4_mir_lower_ty(0, v4_mir_smoke_ty)
pilot v4_mir_main_def = v4_resolve_def_for_name(v4_mir_smoke_resolve, "main")
pilot v4_mir_main_body = v4_mir_lookup_body(v4_mir_smoke_mir, v4_mir_main_def)
pilot v4_mir_entry_block = v4_mir_body_block(v4_mir_smoke_mir, v4_mir_main_body, 0)

say v4_mir_summary(v4_mir_smoke_mir)
say "main-body=" + word_from_int(v4_mir_main_body)
say "entry-term=" + v4_mir_block_terminator(v4_mir_entry_block)
say "main-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_smoke_mir, v4_mir_main_body))
say "main-stmts=" + word_from_int(v4_mir_body_stmt_count(v4_mir_smoke_mir, v4_mir_main_body))
say "first-local=" + v4_mir_local_name(v4_mir_smoke_mir, v4_mir_main_body, 0)
say "return-rhs=" + v4_mir_stmt_rhs(v4_mir_smoke_mir, v4_mir_main_body, 2)
say "body-count=" + word_from_int(v4_mir_body_count(v4_mir_smoke_mir))
