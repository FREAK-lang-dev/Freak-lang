-- Bounded training arcs retain typed counter identity and canonical native facts.
-- The native driver asks this same fixture for source bytes and sealed modules.
task v4_training_cap_assert(value: bool, label: word) -> void {
    if not value { panic("training-cap " + label) }
}
task v4_training_cap_source(case_id: int) -> word {
    if case_id == 0 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until drills > 10 max 3 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 1 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 4 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 2 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 0 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 3 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max -3 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 4 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until drills >= 2 max 9 sessions with growth " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 5 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 3 sessions " + chr(123) + " drills += 1; continue " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 6 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 9 sessions " + chr(123) + " drills += 1; break " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 7 { give back "task main() -> int " + chr(123) + "\ntraining arc until false max 9 sessions " + chr(123) + " give back 9 " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if case_id == 8 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 2 sessions " + chr(123) + " training arc until false max 3 sessions " + chr(123) + " drills += 1 " + chr(125) + " " + chr(125) + "\ntraining arc until false max 3 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 9 { give back "task main() -> int " + chr(123) + "\npilot sessions = 0\ntraining arc until sessions >= 3 max 10 sessions " + chr(123) + " sessions += 1 " + chr(125) + "\ngive back sessions\n" + chr(125) + "\n" }
    if case_id == 10 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\npilot limit = 5\ntraining arc until false max limit sessions " + chr(123) + " drills += 1; limit -= 2 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 11 { give back "task observe(value: int) -> bool " + chr(123) + " say value; give back false " + chr(125) + "\ntask budget() -> int " + chr(123) + " say \"cap\"; give back 2 " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until observe(drills) max budget() sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 12 { give back "task observe() -> bool " + chr(123) + " say \"condition\"; give back true " + chr(125) + "\ntask budget() -> int " + chr(123) + " say \"forbidden cap\"; give back 2 " + chr(125) + "\ntask main() -> int " + chr(123) + "\ntraining arc until observe() max budget() sessions " + chr(123) + " give back 9 " + chr(125) + "\ngive back 0\n" + chr(125) + "\n" }
    if case_id == 13 { give back "task observe(value: int) -> bool " + chr(123) + " say value; give back value >= 1 " + chr(125) + "\ntask budget() -> int " + chr(123) + " say \"cap\"; give back 1 " + chr(125) + "\ntask main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until observe(drills) max budget() sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 14 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 2.5 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 15 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 9223372036854775807 sessions " + chr(123) + " drills += 1; break " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 16 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max -9223372036854775808 sessions " + chr(123) + " drills += 1 " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    if case_id == 17 { give back "task main() -> int " + chr(123) + "\npilot drills = 0\ntraining arc until false max 3 sessions " + chr(123) + " pilot owner = \"loop\"; say owner; drills += 1; continue " + chr(125) + "\ngive back drills\n" + chr(125) + "\n" }
    panic("unknown training-cap case")
    give back ""
}

task v4_training_cap_check_identity(mir: int, body: int) -> void {
    pilot local = 0
    repeat until local >= v4_mir_body_local_count(mir, body) {
        pilot name = v4_mir_local_name(mir, body, local)
        if name.starts_with("$training_sessions#") {
            v4_training_cap_assert(name == "$training_sessions#" + word_from_int(local) and v4_mir_local_ty(mir, body, local) == v4_ty_int, "unique hidden int identity")
            pilot initializations = 0
            pilot checks = 0
            pilot increments = 0
            pilot stmt = 0
            repeat until stmt >= v4_mir_body_stmt_count(mir, body) {
                pilot value = v4_mir_stmt_rvalue(mir, body, stmt)
                if v4_mir_stmt_lhs(mir, body, stmt) == name and v4_mir_stmt_kind(mir, body, stmt) == v4_mir_stmt_local {
                    v4_training_cap_assert(v4_mir_rvalue_kind(mir, body, value) == v4_mir_rvalue_const_int and v4_mir_rvalue_text(mir, body, value) == "0" and v4_mir_place_base(mir, body, v4_mir_stmt_place(mir, body, stmt)) == local, "counter zero initialization by identity")
                    initializations += 1
                }
                if value >= 0 and v4_mir_rvalue_kind(mir, body, value) == v4_mir_rvalue_binary {
                    pilot left = v4_mir_rvalue_lhs(mir, body, value)
                    if left >= 0 and v4_mir_rvalue_kind(mir, body, left) == v4_mir_rvalue_use_local and v4_mir_rvalue_local_id(mir, body, left) == local {
                        if v4_mir_rvalue_op(mir, body, value) == v4_mir_bin_lt {
                            v4_training_cap_assert(v4_mir_stmt_kind(mir, body, stmt) == v4_mir_stmt_branch and v4_mir_rvalue_ty(mir, body, value) == v4_ty_bool, "cap comparison is real branch root")
                            checks += 1
                        }
                        if v4_mir_rvalue_op(mir, body, value) == v4_mir_bin_add {
                            pilot right = v4_mir_rvalue_rhs(mir, body, value)
                            v4_training_cap_assert(v4_mir_stmt_kind(mir, body, stmt) == v4_mir_stmt_assign and v4_mir_rvalue_kind(mir, body, right) == v4_mir_rvalue_const_int and v4_mir_rvalue_text(mir, body, right) == "1", "one shared session increment")
                            increments += 1
                        }
                    }
                }
                stmt += 1
            }
            v4_training_cap_assert(initializations == 1 and checks == 1 and increments <= 1, "closed counter root inventory")
        }
        local += 1
    }
}

task v4_training_cap_run(case_id: int, target_name: word, emit: bool) -> void {
    pilot source = v4_training_cap_source(case_id)
    pilot stream = v4_lex_text(0, source)
    pilot tree = v4_parse_stream(0, stream)
    pilot hir = v4_hir_lower_tree(0, tree)
    pilot resolve = v4_resolve_lower_hir(0, hir)
    pilot ty = v4_ty_lower_resolve(0, resolve)
    pilot mir = v4_mir_lower_ty(0, ty)
    v4_training_cap_assert(v4_lex_diag_count(stream) == 0 and v4_parse_diag_count(tree) == 0 and v4_hir_diag_count(hir) == 0 and v4_resolve_diag_count(resolve) == 0 and v4_ty_diag_count(ty) == 0 and v4_mir_diag_count(mir) == 0, "clean source diagnostics")
    pilot body = 0
    repeat until body >= v4_mir_body_count(mir) { v4_training_cap_check_identity(mir, body); body += 1 }
    pilot borrow = v4_borrowck_check_mir(0, mir)
    v4_training_cap_assert(v4_borrowck_diag_count(borrow) == 0, "real Meiya cleanliness")
    pilot sealed = v4_codegen_llvm_lower_owned_mir(0, mir)
    pilot target = v4_target_spec_new(target_name)
    pilot module = v4_codegen_llvm_module_text(sealed, target)
    if v4_codegen_llvm_native_module_error(sealed) != "" { say "training-cap native-error=" + v4_codegen_llvm_native_module_error(sealed) }
    v4_training_cap_assert(v4_codegen_llvm_diag_count(sealed) == 0 and v4_codegen_llvm_native_module_error(sealed) == "" and module != "", "owned native seal")
    pilot payload = v4_mir_snapshot()
    v4_training_cap_assert(not payload.contains("$closed-check-continuation") and not payload.contains("$control-diagnostic") and v4_mir_snapshot_validate(payload).starts_with("mir-snapshot-import ok=1"), "canonical published snapshot")
    v4_training_cap_assert(v4_mir_snapshot_restore(payload).starts_with("mir-snapshot-restore ok=1") and v4_mir_snapshot() == payload, "canonical restore exact")
    v4_training_cap_assert(v4_codegen_llvm_module_text(sealed, target) == module, "old sealed module stable")
    pilot fresh = v4_codegen_llvm_lower_owned_mir(0, mir)
    v4_training_cap_assert(v4_codegen_llvm_native_module_error(fresh) == "" and v4_codegen_llvm_module_text(fresh, target) == module, "restored native module byte exact")
    say "training-cap case=" + word_from_int(case_id) + " identity=true Meiya=true restore=true old-seal=true fresh-module=true"
    if emit { say "@@LLVM-MODULE-BEGIN"; say module; say "@@LLVM-MODULE-END" }
}
pilot v4_training_case = 0
pilot v4_training_target = "x86_64-unknown-linux-gnu"
pilot v4_training_action = ""
if process::args_count() > 1 { v4_training_case = word_to_int(process::arg(1)) }
if process::args_count() > 2 { v4_training_target = process::arg(2) }
if process::args_count() > 3 { v4_training_action = process::arg(3) }
if v4_training_action == "--source" { say v4_training_cap_source(v4_training_case) }
else { v4_training_cap_run(v4_training_case, v4_training_target, v4_training_action == "--emit") }
