v4_contract_region_loop_query_restored_syntax = v4_check_syntax_text(v4_contract_region_loop_query_path, v4_contract_region_loop_query_after)
v4_contract_region_loop_query_restored_diagnostics = v4_diagnostics_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_after)
