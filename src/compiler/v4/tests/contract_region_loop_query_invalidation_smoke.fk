say "contract-region-loop-query-health-ok=" + v4_contract_region_loop_query_bool(v4_contract_region_loop_query_health.starts_with("00-unit-health|format=" + v4_unit_snapshot_health_format + "|ok=1") and v4_contract_region_loop_query_health.contains("health-diff|ok=1"))

