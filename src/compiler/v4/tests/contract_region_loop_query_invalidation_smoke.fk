v4_contract_region_loop_query_before_unit = v4_unit_snapshot()
v4_contract_region_loop_query_change = v4_lsp_handle_text_request("textDocument/didChange", v4_contract_region_loop_query_path, v4_contract_region_loop_query_after, 0)
v4_contract_region_loop_query_report = v4_unit_snapshot_line(v4_contract_region_loop_query_change, 2)
v4_contract_region_loop_query_invalidated_unit = v4_unit_snapshot()
v4_contract_region_loop_query_diff = v4_unit_snapshot_diff(v4_contract_region_loop_query_before_unit, v4_contract_region_loop_query_invalidated_unit)
