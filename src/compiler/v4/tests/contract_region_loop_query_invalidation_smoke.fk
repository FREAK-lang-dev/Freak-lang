pilot v4_contract_region_loop_query_before_mir = v4_mir_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before)
pilot v4_contract_region_loop_query_before_borrow = v4_borrowck_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before)
pilot v4_contract_region_loop_query_before_diagnostics = v4_diagnostics_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before)
pilot v4_contract_region_loop_query_before_semantic = v4_semantic_at_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before, v4_contract_region_loop_query_before_use)
pilot v4_contract_region_loop_query_before_hover = v4_hover_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before, v4_contract_region_loop_query_before_use)
pilot v4_contract_region_loop_query_before_definition = v4_definition_at_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before, v4_contract_region_loop_query_before_use)
pilot v4_contract_region_loop_query_before_symbols = v4_document_symbols_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before)
pilot v4_contract_region_loop_query_before_completion = v4_completion_text_cached(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before, v4_contract_region_loop_query_before_use)
pilot v4_contract_region_loop_query_before_syntax = v4_check_syntax_text(v4_contract_region_loop_query_path, v4_contract_region_loop_query_before)
pilot v4_contract_region_loop_query_before_def = v4_resolve_def_for_name(v4_contract_region_loop_query_before_resolve, "loop_choose")
pilot v4_contract_region_loop_query_before_sig = v4_ty_lookup_signature(v4_contract_region_loop_query_before_ty, v4_contract_region_loop_query_before_def)
pilot v4_contract_region_loop_query_before_result = v4_borrowck_lookup_result(v4_contract_region_loop_query_before_borrow, v4_contract_region_loop_query_before_def)
pilot v4_contract_region_loop_query_families_value = v4_contract_region_loop_query_families()
pilot v4_contract_region_loop_query_misses_before = v4_contract_region_loop_query_capture_misses(v4_contract_region_loop_query_path, v4_contract_region_loop_query_families_value)

say "contract-region-loop-query-byte-length-stable=" + v4_contract_region_loop_query_bool(v4_contract_region_loop_query_before.length() == v4_contract_region_loop_query_after.length())
say "contract-region-loop-query-offset-stable=" + v4_contract_region_loop_query_bool(v4_contract_region_loop_query_before_use == v4_contract_region_loop_query_after_use)
