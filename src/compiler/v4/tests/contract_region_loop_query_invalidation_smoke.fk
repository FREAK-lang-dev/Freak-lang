say "contract-region-loop-query-before-source0=" + v4_contract_region_loop_query_return_source_at(v4_contract_region_loop_query_before_borrow, v4_contract_region_loop_query_before_result, 0)
say "contract-region-loop-query-before-source1=" + v4_contract_region_loop_query_return_source_at(v4_contract_region_loop_query_before_borrow, v4_contract_region_loop_query_before_result, 1)
