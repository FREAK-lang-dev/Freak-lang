say "contract-region-loop-query-restored-source-count=" + word_from_int(v4_borrowck_path_count_by_kind(v4_contract_region_loop_query_after_borrow, v4_contract_region_loop_query_restored_result, v4_borrowck_path_return_loan))
say "contract-region-loop-query-restored-editor-coherent=" + v4_contract_region_loop_query_bool(v4_contract_region_loop_query_restored_syntax.starts_with("syntax-ok") and v4_diagnostics_count(v4_contract_region_loop_query_restored_diagnostics) == 0 and v4_semantic_at_type(v4_contract_region_loop_query_restored_semantic) == v4_hover_type(v4_contract_region_loop_query_restored_hover) and v4_definition_at_found(v4_contract_region_loop_query_restored_definition) == 1 and v4_span_start(v4_definition_at_span(v4_contract_region_loop_query_restored_definition)) == v4_contract_region_loop_query_after_decl and v4_document_symbol_count(v4_contract_region_loop_query_restored_symbols) > 0 and v4_completion_count(v4_contract_region_loop_query_restored_completion) > 0)
