say "contract-region-loop-query-before-editor-coherent=" + v4_contract_region_loop_query_bool(v4_semantic_at_type(v4_contract_region_loop_query_before_semantic) == v4_hover_type(v4_contract_region_loop_query_before_hover) and v4_definition_at_found(v4_contract_region_loop_query_before_definition) == 1 and v4_span_start(v4_definition_at_span(v4_contract_region_loop_query_before_definition)) == v4_contract_region_loop_query_before_decl and v4_document_symbol_count(v4_contract_region_loop_query_before_symbols) > 0 and v4_completion_count(v4_contract_region_loop_query_before_completion) > 0)

