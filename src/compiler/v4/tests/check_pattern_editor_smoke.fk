-- V4 check-pattern editor smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_check_pattern_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_check_pattern_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_check_pattern_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_check_pattern_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_check_pattern_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_check_pattern_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_check_pattern_editor_source_text() -> word {
    pilot src = "task inspect(seed: int, value: maybe<int>, parsed: result<int,word>) -> int {\n"
    src = src + "    check value {\n"
    src = src + "        got x -> say x + seed\n"
    src = src + "        nobody -> say seed\n"
    src = src + "    }\n"
    src = src + "    check result parsed {\n"
    src = src + "        ok(n) -> give back n + seed\n"
    src = src + "        err(e) -> give back seed\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

pilot v4_check_pattern_editor_source = v4_check_pattern_editor_source_text()
pilot v4_check_pattern_editor_stream = v4_lex_text(0, v4_check_pattern_editor_source)

pilot v4_check_pattern_editor_x_decl_offset = v4_check_pattern_editor_token_offset(v4_check_pattern_editor_stream, "x", 0)
pilot v4_check_pattern_editor_x_use_offset = v4_check_pattern_editor_token_offset(v4_check_pattern_editor_stream, "x", 1)
pilot v4_check_pattern_editor_parsed_offset = v4_check_pattern_editor_token_offset(v4_check_pattern_editor_stream, "parsed", 1)
pilot v4_check_pattern_editor_n_decl_offset = v4_check_pattern_editor_token_offset(v4_check_pattern_editor_stream, "n", 0)
pilot v4_check_pattern_editor_n_use_offset = v4_check_pattern_editor_token_offset(v4_check_pattern_editor_stream, "n", 1)

pilot v4_check_pattern_editor_x_sem = v4_semantic_at_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_x_use_offset)
pilot v4_check_pattern_editor_x_hover = v4_hover_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_x_use_offset)
pilot v4_check_pattern_editor_x_definition = v4_definition_at_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_x_use_offset)
pilot v4_check_pattern_editor_x_completion = v4_completion_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_x_use_offset)

pilot v4_check_pattern_editor_outer_completion = v4_completion_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_parsed_offset)
pilot v4_check_pattern_editor_n_sem = v4_semantic_at_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_n_use_offset)
pilot v4_check_pattern_editor_n_definition = v4_definition_at_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_n_use_offset)
pilot v4_check_pattern_editor_n_completion = v4_completion_text_cached("check-pattern-editor.fk", v4_check_pattern_editor_source, v4_check_pattern_editor_n_use_offset)

pilot v4_check_pattern_editor_x_item = v4_check_pattern_editor_find_completion_label(v4_check_pattern_editor_x_completion, "x")
pilot v4_check_pattern_editor_outer_x_item = v4_check_pattern_editor_find_completion_label(v4_check_pattern_editor_outer_completion, "x")
pilot v4_check_pattern_editor_n_item = v4_check_pattern_editor_find_completion_label(v4_check_pattern_editor_n_completion, "n")
pilot v4_check_pattern_editor_temp_item = v4_check_pattern_editor_find_completion_label(v4_check_pattern_editor_x_completion, "_check_subject")
pilot v4_check_pattern_editor_result_temp_item = v4_check_pattern_editor_find_completion_label(v4_check_pattern_editor_n_completion, "_check_result_subject")

say v4_semantic_at_summary(v4_check_pattern_editor_x_sem)
say "check-editor-x-kind=" + v4_semantic_at_kind(v4_check_pattern_editor_x_sem)
say "check-editor-x-type=" + v4_semantic_at_type(v4_check_pattern_editor_x_sem)
say "check-editor-x-hover-kind=" + v4_hover_kind(v4_check_pattern_editor_x_hover)
say "check-editor-x-hover-type=" + v4_hover_type(v4_check_pattern_editor_x_hover)
say "check-editor-x-definition-kind=" + v4_definition_at_kind(v4_check_pattern_editor_x_definition)
say "check-editor-x-definition-found=" + word_from_int(v4_definition_at_found(v4_check_pattern_editor_x_definition))
say "check-editor-x-definition-matches=" + v4_check_pattern_editor_bool_word(v4_span_start(v4_definition_at_span(v4_check_pattern_editor_x_definition)) == v4_check_pattern_editor_x_decl_offset)
say "check-editor-x-completion-count=" + word_from_int(v4_completion_count(v4_check_pattern_editor_x_completion))
say "check-editor-x-completion-found=" + v4_check_pattern_editor_bool_word(v4_check_pattern_editor_x_item >= 0)
say "check-editor-x-completion-detail=" + v4_check_pattern_editor_completion_detail_or_empty(v4_check_pattern_editor_x_completion, v4_check_pattern_editor_x_item)
say "check-editor-x-temp-found=" + v4_check_pattern_editor_bool_word(v4_check_pattern_editor_temp_item >= 0)
say "check-editor-outer-x-found=" + v4_check_pattern_editor_bool_word(v4_check_pattern_editor_outer_x_item >= 0)
say "check-editor-n-kind=" + v4_semantic_at_kind(v4_check_pattern_editor_n_sem)
say "check-editor-n-type=" + v4_semantic_at_type(v4_check_pattern_editor_n_sem)
say "check-editor-n-definition-kind=" + v4_definition_at_kind(v4_check_pattern_editor_n_definition)
say "check-editor-n-definition-found=" + word_from_int(v4_definition_at_found(v4_check_pattern_editor_n_definition))
say "check-editor-n-definition-matches=" + v4_check_pattern_editor_bool_word(v4_span_start(v4_definition_at_span(v4_check_pattern_editor_n_definition)) == v4_check_pattern_editor_n_decl_offset)
say "check-editor-n-completion-count=" + word_from_int(v4_completion_count(v4_check_pattern_editor_n_completion))
say "check-editor-n-completion-found=" + v4_check_pattern_editor_bool_word(v4_check_pattern_editor_n_item >= 0)
say "check-editor-n-completion-detail=" + v4_check_pattern_editor_completion_detail_or_empty(v4_check_pattern_editor_n_completion, v4_check_pattern_editor_n_item)
say "check-editor-result-temp-found=" + v4_check_pattern_editor_bool_word(v4_check_pattern_editor_result_temp_item >= 0)
