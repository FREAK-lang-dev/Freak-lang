say "try-bad-source-message=" + v4_diag_message(v4_mir_diag(v4_mir_try_or_else_bad_try_mir, 0))
say "try-bad-source-help=" + v4_diag_help(v4_mir_diag(v4_mir_try_or_else_bad_try_mir, 0))

