-- V4 LSP facade smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_lsp_alias_diag_source() -> word {
    pilot src = "alias Loop = Loop\n"
    src = src + "alias First = Second\n"
    src = src + "alias Second = First\n"
    src = src + "alias Spiral<T> = Spiral<T>\n"
    src = src + "alias Pair = (Pair, int)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_lifetime_diag_source() -> word {
    pilot src = "shape RefBox<'a,T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape BadBox {\n"
    src = src + "    value: RefBox<'ghost,int>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_const_diag_source() -> word {
    pilot ace_braces = v4_lsp_braces(" hp: \"ace\" ")
    pilot route_decl_braces = v4_lsp_braces(" code: int ")
    pilot box_braces = v4_lsp_braces(" value: 1 ")
    pilot option_decl_braces = v4_lsp_braces(" value: T ")
    pilot some_braces = v4_lsp_braces(" value: \"ace\" ")
    pilot src = "fixed pilot PAIR: (int,word) = (1, 2)\n"
    src = src + "fixed pilot GRID: [int; 3] = [0; 2]\n"
    src = src + "fixed pilot ACE: Pilot = Pilot " + ace_braces + "\n"
    src = src + "fixed pilot SIGNAL = Event::Key\n"
    src = src + "fixed pilot BAD_GENERIC_SHAPE = Box<int,word> " + box_braces + "\n"
    src = src + "fixed pilot TYPE_GENERIC_SHAPE = Box<int> " + v4_lsp_braces(" value: \"ace\" ") + "\n"
    src = src + "fixed pilot BAD_GENERIC_ROUTE = Option<int,word>::None\n"
    src = src + "fixed pilot TYPE_GENERIC_ROUTE = Option<int>::Some " + some_braces + "\n"
    src = src + "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Event {\n"
    src = src + "    Key " + route_decl_braces + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl_braces + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_const_task_diag_source() -> word {
    pilot src = "@const task bump(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "task runtime_only(n: int) -> int {\n"
    src = src + "    give back n + 1\n"
    src = src + "}\n"
    src = src + "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot BAD_RUNTIME = runtime_only(BASE)\n"
    src = src + "fixed pilot BAD_ARITY = bump()\n"
    src = src + "fixed pilot BAD_TYPE = bump(\"ace\")\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back BASE\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_lsp_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_lsp_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_lsp_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_lsp_variant_source() -> word {
    pilot src = "variant Event {\n"
    src = src + "    Key " + v4_lsp_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot event = Event::Key " + v4_lsp_braces(" code: 9 ") + "\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_primitive_source() -> word {
    pilot src = "task mix(count: uint, marker: char) -> float32 {\n"
    src = src + "    pilot byte: tiny = 7t\n"
    src = src + "    pilot power: big = 999b\n"
    src = src + "    give back 1.5\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_named_source() -> word {
    pilot src = "task compose(host: word, port: int, timeout: int) -> int {\n"
    src = src + "    give back port + timeout\n"
    src = src + "}\n"
    src = src + "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task boost(self, bonus: int) -> int {\n"
    src = src + "        give back self.hp + bonus\n"
    src = src + "    }\n"
    src = src + "    task ace(callsign: word) -> Pilot {\n"
    src = src + "        give back Pilot " + v4_lsp_braces(" hp: 9 ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ship = Pilot " + v4_lsp_braces(" hp: 7 ") + "\n"
    src = src + "    pilot routed = compose(host: \"localhost\", port: 8080)\n"
    src = src + "    pilot boosted = ship.boost(2)\n"
    src = src + "    pilot ace = Pilot::ace(\"Valkyrie-1\")\n"
    src = src + "    pilot boosted_named = ship.boost(bonus: 4)\n"
    src = src + "    pilot ace_named = Pilot::ace(callsign: \"Valkyrie-2\")\n"
    src = src + "    give back routed + boosted + ace.hp\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_glob_source() -> word {
    pilot src = "task util::math::double(value: int) -> int {\n"
    src = src + "    give back value + value\n"
    src = src + "}\n"
    src = src + "task util::math::triple(value: int) -> int {\n"
    src = src + "    give back value + value + value\n"
    src = src + "}\n"
    src = src + "use util::math::*\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot a = double(2)\n"
    src = src + "    pilot b = triple(3)\n"
    src = src + "    give back a + b\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_const_source() -> word {
    pilot src = "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back CELLS\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_const_generic_source() -> word {
    pilot box_braces = v4_lsp_braces(" value: BASE ")
    pilot option_decl_braces = v4_lsp_braces(" value: T ")
    pilot some_braces = v4_lsp_braces(" value: BASE ")
    pilot src = "fixed pilot BASE: int = 2\n"
    src = src + "shape Box<T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "route Option<T> {\n"
    src = src + "    Some " + option_decl_braces + "\n"
    src = src + "    None\n"
    src = src + "}\n"
    src = src + "fixed pilot INT_BOX = Box<int> " + box_braces + "\n"
    src = src + "fixed pilot INFER_BOX = Box " + box_braces + "\n"
    src = src + "fixed pilot SOME = Option::Some " + some_braces + "\n"
    src = src + "fixed pilot EMPTY = Option<int>::None\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot int_box = INT_BOX\n"
    src = src + "    pilot some = SOME\n"
    src = src + "    give back int_box.value + BASE\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_bounds_source() -> word {
    pilot src = "doctrine Displayable {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "doctrine Ranked {\n"
    src = src + "    task rank(self) -> int\n"
    src = src + "}\n"
    src = src + "shape Wing {\n"
    src = src + "    callsign: word\n"
    src = src + "    score: int\n"
    src = src + "}\n"
    src = src + "impl Displayable for Wing {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back self.callsign\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Ranked for Wing {\n"
    src = src + "    task rank(self) -> int {\n"
    src = src + "        give back self.score\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task show<T: Displayable + Ranked>(value: T) -> word {\n"
    src = src + "    pilot score = value.rank()\n"
    src = src + "    give back value.display()\n"
    src = src + "}\n"
    src = src + "task main(ship: Wing) -> word {\n"
    src = src + "    give back show(ship)\n"
    src = src + "}\n"
    give back src
}

pilot v4_lsp_source = "task main() => \"hi\"\n"
v4_lsp_source = v4_lsp_source + "shape Pilot\n"
pilot v4_lsp_variant = v4_lsp_variant_source()
pilot v4_lsp_variant_stream = v4_lex_text(0, v4_lsp_variant)
pilot v4_lsp_variant_event_offset = v4_lsp_token_offset(v4_lsp_variant_stream, "Event", 1)
pilot v4_lsp_variant_key_offset = v4_lsp_token_offset(v4_lsp_variant_stream, "Key", 1)
pilot v4_lsp_primitive = v4_lsp_primitive_source()
pilot v4_lsp_primitive_stream = v4_lex_text(1, v4_lsp_primitive)
pilot v4_lsp_primitive_uint_offset = v4_lsp_token_offset(v4_lsp_primitive_stream, "uint", 0)
pilot v4_lsp_named = v4_lsp_named_source()
pilot v4_lsp_named_stream = v4_lex_text(2, v4_lsp_named)
pilot v4_lsp_named_host_label_offset = v4_lsp_token_offset(v4_lsp_named_stream, "host", 1)
pilot v4_lsp_named_bonus_label_offset = v4_lsp_token_offset(v4_lsp_named_stream, "bonus", 2)
pilot v4_lsp_named_callsign_label_offset = v4_lsp_token_offset(v4_lsp_named_stream, "callsign", 1)
pilot v4_lsp_named_timeout_offset = v4_lsp_token_offset(v4_lsp_named_stream, "8080", 0)
pilot v4_lsp_named_bonus_offset = v4_lsp_token_offset(v4_lsp_named_stream, "2", 0)
pilot v4_lsp_named_callsign_offset = v4_lsp_token_offset(v4_lsp_named_stream, "Valkyrie-1", 0)
pilot v4_lsp_glob = v4_lsp_glob_source()
pilot v4_lsp_glob_stream = v4_lex_text(3, v4_lsp_glob)
pilot v4_lsp_glob_double_offset = v4_lsp_token_offset(v4_lsp_glob_stream, "double", 1)
pilot v4_lsp_glob_triple_offset = v4_lsp_token_offset(v4_lsp_glob_stream, "triple", 1)
pilot v4_lsp_const = v4_lsp_const_source()
pilot v4_lsp_const_stream = v4_lex_text(4, v4_lsp_const)
pilot v4_lsp_const_cells_offset = v4_lsp_token_offset(v4_lsp_const_stream, "CELLS", 1)
pilot v4_lsp_const_generic = v4_lsp_const_generic_source()
pilot v4_lsp_const_generic_stream = v4_lex_text(5, v4_lsp_const_generic)
pilot v4_lsp_const_generic_int_box_offset = v4_lsp_token_offset(v4_lsp_const_generic_stream, "INT_BOX", 1)
pilot v4_lsp_const_generic_some_offset = v4_lsp_token_offset(v4_lsp_const_generic_stream, "SOME", 1)
pilot v4_lsp_bounds = v4_lsp_bounds_source()
pilot v4_lsp_bounds_stream = v4_lex_text(6, v4_lsp_bounds)
pilot v4_lsp_bounds_display_offset = v4_lsp_token_offset(v4_lsp_bounds_stream, "rank", 2)

say v4_lsp_hover_text("lsp.fk", v4_lsp_source, 5)
say v4_lsp_definition_text("lsp.fk", v4_lsp_source, 5)
say v4_lsp_document_symbols_text("lsp.fk", v4_lsp_source)
say v4_lsp_completion_text("lsp.fk", v4_lsp_source, 0)
