-- V4 MIR route exhaustiveness and unreachable-arm smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_route_exhaustive_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_mir_route_exhaustive_good_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat / Retreat\n"
    src = src + "}\n"
    src = src + "task score(outcome: Outcome) -> int {\n"
    src = src + "    when outcome {\n"
    src = src + "        Victory -> give back 3\n"
    src = src + "        Outcome::Defeat -> give back 1\n"
    src = src + "        Retreat -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back -1\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_exhaustive_payload_good_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_route_exhaustive_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task score(event: Event) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Key " + v4_mir_route_exhaustive_braces(" code ") + " -> give back code\n"
    src = src + "        Closed -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back -1\n"
    src = src + "}\n"
    give back src
}

