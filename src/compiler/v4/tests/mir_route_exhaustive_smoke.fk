    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat / Retreat\n"
    src = src + "}\n"
    src = src + "task score(outcome: Outcome) -> int {\n"
    src = src + "    when outcome {\n"
    src = src + "        Victory -> give back 3\n"
    src = src + "        Outcome::Victory -> give back 1\n"
    src = src + "        Retreat -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back -1\n"
    src = src + "}\n"
