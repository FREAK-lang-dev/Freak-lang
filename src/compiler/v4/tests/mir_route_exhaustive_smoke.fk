pilot v4_mir_route_exhaustive_payload_good_ty = v4_ty_lower_resolve(1, v4_mir_route_exhaustive_payload_good_resolve)
pilot v4_mir_route_exhaustive_payload_good_mir = v4_mir_lower_ty(1, v4_mir_route_exhaustive_payload_good_ty)
say "route-exhaustive-payload-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_exhaustive_payload_good_mir))

pilot v4_mir_route_exhaustive_missing_stream = v4_lex_text(2, v4_mir_route_exhaustive_missing_source())
pilot v4_mir_route_exhaustive_missing_tree = v4_parse_stream(2, v4_mir_route_exhaustive_missing_stream)
pilot v4_mir_route_exhaustive_missing_hir = v4_hir_lower_tree(2, v4_mir_route_exhaustive_missing_tree)
pilot v4_mir_route_exhaustive_missing_resolve = v4_resolve_lower_hir(2, v4_mir_route_exhaustive_missing_hir)
pilot v4_mir_route_exhaustive_missing_ty = v4_ty_lower_resolve(2, v4_mir_route_exhaustive_missing_resolve)
pilot v4_mir_route_exhaustive_missing_mir = v4_mir_lower_ty(2, v4_mir_route_exhaustive_missing_ty)
say "route-exhaustive-missing-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_exhaustive_missing_mir))
say "route-exhaustive-missing-message=" + v4_diag_message(v4_mir_diag(v4_mir_route_exhaustive_missing_mir, 0))
say "route-exhaustive-missing-help=" + v4_diag_help(v4_mir_diag(v4_mir_route_exhaustive_missing_mir, 0))

pilot v4_mir_route_exhaustive_duplicate_stream = v4_lex_text(3, v4_mir_route_exhaustive_duplicate_source())
pilot v4_mir_route_exhaustive_duplicate_tree = v4_parse_stream(3, v4_mir_route_exhaustive_duplicate_stream)
