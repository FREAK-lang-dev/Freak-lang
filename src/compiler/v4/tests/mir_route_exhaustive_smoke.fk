task v4_mir_route_exhaustive_after_wildcard_source() -> word {
    pilot src = "route Outcome {\n"
    src = src + "    Victory / Defeat\n"
    src = src + "}\n"
    src = src + "task score(outcome: Outcome) -> int {\n"
    src = src + "    when outcome {\n"
    src = src + "        _ -> give back 0\n"
    src = src + "        Victory -> give back 1\n"
    src = src + "    }\n"
    src = src + "    give back -1\n"
    src = src + "}\n"
    give back src
}

task v4_mir_route_exhaustive_payload_duplicate_source() -> word {
    pilot src = "route Event {\n"
    src = src + "    Key " + v4_mir_route_exhaustive_braces(" code: int, repeat: bool ") + "\n"
    src = src + "    Closed\n"
    src = src + "}\n"
    src = src + "task score(event: Event) -> int {\n"
    src = src + "    when event {\n"
    src = src + "        Key " + v4_mir_route_exhaustive_braces(" code ") + " -> give back code\n"
    src = src + "        Event::Key " + v4_mir_route_exhaustive_braces(" code: 9 ") + " -> give back 9\n"
    src = src + "        Closed -> give back 0\n"
    src = src + "    }\n"
    src = src + "    give back -1\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_route_exhaustive_good_stream = v4_lex_text(0, v4_mir_route_exhaustive_good_source())
pilot v4_mir_route_exhaustive_good_tree = v4_parse_stream(0, v4_mir_route_exhaustive_good_stream)
pilot v4_mir_route_exhaustive_good_hir = v4_hir_lower_tree(0, v4_mir_route_exhaustive_good_tree)
pilot v4_mir_route_exhaustive_good_resolve = v4_resolve_lower_hir(0, v4_mir_route_exhaustive_good_hir)
pilot v4_mir_route_exhaustive_good_ty = v4_ty_lower_resolve(0, v4_mir_route_exhaustive_good_resolve)
pilot v4_mir_route_exhaustive_good_mir = v4_mir_lower_ty(0, v4_mir_route_exhaustive_good_ty)
say "route-exhaustive-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_route_exhaustive_good_mir))

pilot v4_mir_route_exhaustive_payload_good_stream = v4_lex_text(1, v4_mir_route_exhaustive_payload_good_source())
pilot v4_mir_route_exhaustive_payload_good_tree = v4_parse_stream(1, v4_mir_route_exhaustive_payload_good_stream)
