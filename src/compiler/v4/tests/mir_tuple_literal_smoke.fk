-- V4 MIR typed tuple literal smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_tuple_literal_good_source() -> word {
    pilot src = "task main() -> int {\n"
    src = src + "    pilot pair: (int,word) = (7, \"ace\")\n"
    src = src + "    pilot trio = (1, 2.5, true)\n"
    src = src + "    pilot nested = ((1, 2), \"team\")\n"
    src = src + "    give back 7\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_literal_bad_mismatch_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot pair: (int,word) = (7, 9)\n"
    src = src + "}\n"
    give back src
}

task v4_mir_tuple_literal_bad_slot_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot broken = (1,)\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_tuple_literal_stream = v4_lex_text(0, v4_mir_tuple_literal_good_source())
pilot v4_mir_tuple_literal_tree = v4_parse_stream(0, v4_mir_tuple_literal_stream)
pilot v4_mir_tuple_literal_hir = v4_hir_lower_tree(0, v4_mir_tuple_literal_tree)
pilot v4_mir_tuple_literal_resolve = v4_resolve_lower_hir(0, v4_mir_tuple_literal_hir)
pilot v4_mir_tuple_literal_ty = v4_ty_lower_resolve(0, v4_mir_tuple_literal_resolve)
pilot v4_mir_tuple_literal_mir = v4_mir_lower_ty(0, v4_mir_tuple_literal_ty)
pilot v4_mir_tuple_literal_main_def = v4_resolve_def_for_name(v4_mir_tuple_literal_resolve, "main")
pilot v4_mir_tuple_literal_main_body = v4_mir_lookup_body(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_def)
pilot v4_mir_tuple_literal_pair_rvalue = v4_mir_stmt_rvalue(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 0)
pilot v4_mir_tuple_literal_trio_rvalue = v4_mir_stmt_rvalue(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 1)
pilot v4_mir_tuple_literal_nested_rvalue = v4_mir_stmt_rvalue(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 2)

say v4_mir_summary(v4_mir_tuple_literal_mir)
say "tuple-body-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body))
say "tuple-local0-name=" + v4_mir_local_name(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 0)
say "tuple-local0-ty=" + v4_mir_local_ty(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 0)
say "tuple-local1-name=" + v4_mir_local_name(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 1)
say "tuple-local1-ty=" + v4_mir_local_ty(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 1)
say "tuple-local2-name=" + v4_mir_local_name(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 2)
say "tuple-local2-ty=" + v4_mir_local_ty(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, 2)
say "pair-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_pair_rvalue)
say "pair-rvalue-op=" + v4_mir_rvalue_op(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_pair_rvalue)
say "pair-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_pair_rvalue)
say "trio-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_trio_rvalue)
say "trio-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_trio_rvalue)
say "nested-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_nested_rvalue)
say "nested-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_tuple_literal_mir, v4_mir_tuple_literal_main_body, v4_mir_tuple_literal_nested_rvalue)
say "tuple-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_tuple_literal_mir))

pilot v4_mir_tuple_literal_bad_mismatch_stream = v4_lex_text(1, v4_mir_tuple_literal_bad_mismatch_source())
pilot v4_mir_tuple_literal_bad_mismatch_tree = v4_parse_stream(1, v4_mir_tuple_literal_bad_mismatch_stream)
pilot v4_mir_tuple_literal_bad_mismatch_hir = v4_hir_lower_tree(1, v4_mir_tuple_literal_bad_mismatch_tree)
pilot v4_mir_tuple_literal_bad_mismatch_resolve = v4_resolve_lower_hir(1, v4_mir_tuple_literal_bad_mismatch_hir)
pilot v4_mir_tuple_literal_bad_mismatch_ty = v4_ty_lower_resolve(1, v4_mir_tuple_literal_bad_mismatch_resolve)
pilot v4_mir_tuple_literal_bad_mismatch_mir = v4_mir_lower_ty(1, v4_mir_tuple_literal_bad_mismatch_ty)

say "tuple-bad-mismatch-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_tuple_literal_bad_mismatch_mir))
say "tuple-bad-mismatch-message=" + v4_diag_message(v4_mir_diag(v4_mir_tuple_literal_bad_mismatch_mir, 0))
say "tuple-bad-mismatch-help=" + v4_diag_help(v4_mir_diag(v4_mir_tuple_literal_bad_mismatch_mir, 0))

pilot v4_mir_tuple_literal_bad_slot_stream = v4_lex_text(2, v4_mir_tuple_literal_bad_slot_source())
pilot v4_mir_tuple_literal_bad_slot_tree = v4_parse_stream(2, v4_mir_tuple_literal_bad_slot_stream)
pilot v4_mir_tuple_literal_bad_slot_hir = v4_hir_lower_tree(2, v4_mir_tuple_literal_bad_slot_tree)
pilot v4_mir_tuple_literal_bad_slot_resolve = v4_resolve_lower_hir(2, v4_mir_tuple_literal_bad_slot_hir)
pilot v4_mir_tuple_literal_bad_slot_ty = v4_ty_lower_resolve(2, v4_mir_tuple_literal_bad_slot_resolve)
pilot v4_mir_tuple_literal_bad_slot_mir = v4_mir_lower_ty(2, v4_mir_tuple_literal_bad_slot_ty)

say "tuple-bad-slot-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_tuple_literal_bad_slot_mir))
say "tuple-bad-slot-message=" + v4_diag_message(v4_mir_diag(v4_mir_tuple_literal_bad_slot_mir, 0))
say "tuple-bad-slot-help=" + v4_diag_help(v4_mir_diag(v4_mir_tuple_literal_bad_slot_mir, 0))
