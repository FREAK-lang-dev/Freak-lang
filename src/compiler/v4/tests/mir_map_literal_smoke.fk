-- V4 MIR typed map literal smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_map_literal_good_source() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot fleet = " + "{" + "\"alpha\": 1, \"beta\": 2" + "}\n"
    src = src + "    pilot scaled = " + "{" + "1: 2.5, 2: 3" + "}\n"
    src = src + "    pilot nested = " + "{" + "\"hp\": " + "{" + "\"front\": 7" + "}" + "}\n"
    src = src + "    pilot ship = Pilot " + "{" + " hp: 9 " + "}\n"
    src = src + "    give back ship.hp\n"
    src = src + "}\n"
    give back src
}

task v4_mir_map_literal_bad_key_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot fleet = " + "{" + "\"alpha\": 1, 2: 3" + "}\n"
    src = src + "}\n"
    give back src
}

task v4_mir_map_literal_bad_value_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot fleet = " + "{" + "\"alpha\": 1, \"beta\": \"oops\"" + "}\n"
    src = src + "}\n"
    give back src
}

task v4_mir_map_literal_bad_empty_source() -> word {
    pilot src = "task bad() -> void {\n"
    src = src + "    pilot fleet = " + "{" + "}" + "\n"
    src = src + "}\n"
    give back src
}

pilot v4_mir_map_literal_stream = v4_lex_text(0, v4_mir_map_literal_good_source())
pilot v4_mir_map_literal_tree = v4_parse_stream(0, v4_mir_map_literal_stream)
pilot v4_mir_map_literal_hir = v4_hir_lower_tree(0, v4_mir_map_literal_tree)
pilot v4_mir_map_literal_resolve = v4_resolve_lower_hir(0, v4_mir_map_literal_hir)
pilot v4_mir_map_literal_ty = v4_ty_lower_resolve(0, v4_mir_map_literal_resolve)
pilot v4_mir_map_literal_mir = v4_mir_lower_ty(0, v4_mir_map_literal_ty)
pilot v4_mir_map_literal_main_def = v4_resolve_def_for_name(v4_mir_map_literal_resolve, "main")
pilot v4_mir_map_literal_main_body = v4_mir_lookup_body(v4_mir_map_literal_mir, v4_mir_map_literal_main_def)
pilot v4_mir_map_literal_fleet_rvalue = v4_mir_stmt_rvalue(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 0)
pilot v4_mir_map_literal_scaled_rvalue = v4_mir_stmt_rvalue(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 1)
pilot v4_mir_map_literal_nested_rvalue = v4_mir_stmt_rvalue(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 2)
pilot v4_mir_map_literal_ship_rvalue = v4_mir_stmt_rvalue(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 3)

say v4_mir_summary(v4_mir_map_literal_mir)
say "map-body-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_map_literal_mir, v4_mir_map_literal_main_body))
say "map-local0-name=" + v4_mir_local_name(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 0)
say "map-local0-ty=" + v4_mir_local_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 0)
say "map-local1-name=" + v4_mir_local_name(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 1)
say "map-local1-ty=" + v4_mir_local_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 1)
say "map-local2-name=" + v4_mir_local_name(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 2)
say "map-local2-ty=" + v4_mir_local_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 2)
say "map-local3-name=" + v4_mir_local_name(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 3)
say "map-local3-ty=" + v4_mir_local_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, 3)
say "fleet-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_fleet_rvalue)
say "fleet-rvalue-op=" + v4_mir_rvalue_op(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_fleet_rvalue)
say "fleet-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_fleet_rvalue)
say "scaled-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_scaled_rvalue)
say "scaled-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_scaled_rvalue)
say "nested-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_nested_rvalue)
say "nested-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_nested_rvalue)
say "ship-rvalue-kind=" + v4_mir_rvalue_kind(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_ship_rvalue)
say "ship-rvalue-ty=" + v4_mir_rvalue_ty(v4_mir_map_literal_mir, v4_mir_map_literal_main_body, v4_mir_map_literal_ship_rvalue)
say "map-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_map_literal_mir))

pilot v4_mir_map_literal_bad_key_stream = v4_lex_text(1, v4_mir_map_literal_bad_key_source())
pilot v4_mir_map_literal_bad_key_tree = v4_parse_stream(1, v4_mir_map_literal_bad_key_stream)
pilot v4_mir_map_literal_bad_key_hir = v4_hir_lower_tree(1, v4_mir_map_literal_bad_key_tree)
pilot v4_mir_map_literal_bad_key_resolve = v4_resolve_lower_hir(1, v4_mir_map_literal_bad_key_hir)
pilot v4_mir_map_literal_bad_key_ty = v4_ty_lower_resolve(1, v4_mir_map_literal_bad_key_resolve)
pilot v4_mir_map_literal_bad_key_mir = v4_mir_lower_ty(1, v4_mir_map_literal_bad_key_ty)

say "map-bad-key-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_map_literal_bad_key_mir))
say "map-bad-key-message=" + v4_diag_message(v4_mir_diag(v4_mir_map_literal_bad_key_mir, 0))
say "map-bad-key-help=" + v4_diag_help(v4_mir_diag(v4_mir_map_literal_bad_key_mir, 0))

pilot v4_mir_map_literal_bad_value_stream = v4_lex_text(2, v4_mir_map_literal_bad_value_source())
pilot v4_mir_map_literal_bad_value_tree = v4_parse_stream(2, v4_mir_map_literal_bad_value_stream)
pilot v4_mir_map_literal_bad_value_hir = v4_hir_lower_tree(2, v4_mir_map_literal_bad_value_tree)
pilot v4_mir_map_literal_bad_value_resolve = v4_resolve_lower_hir(2, v4_mir_map_literal_bad_value_hir)
pilot v4_mir_map_literal_bad_value_ty = v4_ty_lower_resolve(2, v4_mir_map_literal_bad_value_resolve)
pilot v4_mir_map_literal_bad_value_mir = v4_mir_lower_ty(2, v4_mir_map_literal_bad_value_ty)

say "map-bad-value-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_map_literal_bad_value_mir))
say "map-bad-value-message=" + v4_diag_message(v4_mir_diag(v4_mir_map_literal_bad_value_mir, 0))
say "map-bad-value-help=" + v4_diag_help(v4_mir_diag(v4_mir_map_literal_bad_value_mir, 0))

pilot v4_mir_map_literal_bad_empty_stream = v4_lex_text(3, v4_mir_map_literal_bad_empty_source())
pilot v4_mir_map_literal_bad_empty_tree = v4_parse_stream(3, v4_mir_map_literal_bad_empty_stream)
pilot v4_mir_map_literal_bad_empty_hir = v4_hir_lower_tree(3, v4_mir_map_literal_bad_empty_tree)
pilot v4_mir_map_literal_bad_empty_resolve = v4_resolve_lower_hir(3, v4_mir_map_literal_bad_empty_hir)
pilot v4_mir_map_literal_bad_empty_ty = v4_ty_lower_resolve(3, v4_mir_map_literal_bad_empty_resolve)
pilot v4_mir_map_literal_bad_empty_mir = v4_mir_lower_ty(3, v4_mir_map_literal_bad_empty_ty)

say "map-bad-empty-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_map_literal_bad_empty_mir))
say "map-bad-empty-message=" + v4_diag_message(v4_mir_diag(v4_mir_map_literal_bad_empty_mir, 0))
say "map-bad-empty-help=" + v4_diag_help(v4_mir_diag(v4_mir_map_literal_bad_empty_mir, 0))
