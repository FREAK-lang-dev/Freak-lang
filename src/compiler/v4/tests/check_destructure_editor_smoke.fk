-- V4 checked-pattern destructure editor smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_check_destructure_editor_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_check_destructure_editor_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_check_destructure_editor_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_check_destructure_editor_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_check_destructure_editor_find_completion_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_check_destructure_editor_completion_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_check_destructure_editor_source_text() -> word {
    pilot src = "alias Pair = (int,word)\n"
    src = src + "alias Wing = [int;2]\n"
    src = src + "task inspect(value: maybe<Pair>, parsed: result<Wing,word>) -> int {\n"
    src = src + "    check value {\n"
    src = src + "        got (power, label) -> say label\n"
    src = src + "        nobody -> say \"none\"\n"
    src = src + "    }\n"
    src = src + "    check result parsed {\n"
    src = src + "        ok([left, right]) -> give back right\n"
    src = src + "        err(msg) -> give back 0\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

pilot v4_check_destructure_editor_source = v4_check_destructure_editor_source_text()
pilot v4_check_destructure_editor_stream = v4_lex_text(0, v4_check_destructure_editor_source)

pilot v4_check_destructure_editor_label_decl_offset = v4_check_destructure_editor_token_offset(v4_check_destructure_editor_stream, "label", 0)
pilot v4_check_destructure_editor_label_use_offset = v4_check_destructure_editor_token_offset(v4_check_destructure_editor_stream, "label", 1)
pilot v4_check_destructure_editor_right_decl_offset = v4_check_destructure_editor_token_offset(v4_check_destructure_editor_stream, "right", 0)
pilot v4_check_destructure_editor_right_use_offset = v4_check_destructure_editor_token_offset(v4_check_destructure_editor_stream, "right", 1)
pilot v4_check_destructure_editor_parsed_offset = v4_check_destructure_editor_token_offset(v4_check_destructure_editor_stream, "parsed", 1)

pilot v4_check_destructure_editor_label_sem = v4_semantic_at_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_label_use_offset)
pilot v4_check_destructure_editor_label_definition = v4_definition_at_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_label_use_offset)
pilot v4_check_destructure_editor_label_completion = v4_completion_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_label_use_offset)
pilot v4_check_destructure_editor_right_hover = v4_hover_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_right_use_offset)
pilot v4_check_destructure_editor_right_definition = v4_definition_at_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_right_use_offset)
pilot v4_check_destructure_editor_right_completion = v4_completion_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_right_use_offset)
pilot v4_check_destructure_editor_outer_completion = v4_completion_text_cached("check-destructure-editor.fk", v4_check_destructure_editor_source, v4_check_destructure_editor_parsed_offset)

pilot v4_check_destructure_editor_power_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_label_completion, "power")
pilot v4_check_destructure_editor_label_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_label_completion, "label")
pilot v4_check_destructure_editor_left_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_right_completion, "left")
pilot v4_check_destructure_editor_right_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_right_completion, "right")
pilot v4_check_destructure_editor_outer_power_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_outer_completion, "power")
pilot v4_check_destructure_editor_outer_right_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_outer_completion, "right")
pilot v4_check_destructure_editor_temp_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_label_completion, "_check_subject")
pilot v4_check_destructure_editor_result_temp_item = v4_check_destructure_editor_find_completion_label(v4_check_destructure_editor_right_completion, "_check_result_subject")

say "check-destructure-editor-label-kind=" + v4_semantic_at_kind(v4_check_destructure_editor_label_sem)
say "check-destructure-editor-label-type=" + v4_semantic_at_type(v4_check_destructure_editor_label_sem)
say "check-destructure-editor-label-definition-kind=" + v4_definition_at_kind(v4_check_destructure_editor_label_definition)
say "check-destructure-editor-label-definition-found=" + word_from_int(v4_definition_at_found(v4_check_destructure_editor_label_definition))
say "check-destructure-editor-label-definition-matches=" + v4_check_destructure_editor_bool_word(v4_span_start(v4_definition_at_span(v4_check_destructure_editor_label_definition)) == v4_check_destructure_editor_label_decl_offset)
say "check-destructure-editor-label-completion-count=" + word_from_int(v4_completion_count(v4_check_destructure_editor_label_completion))
say "check-destructure-editor-power-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_power_item >= 0)
say "check-destructure-editor-power-detail=" + v4_check_destructure_editor_completion_detail_or_empty(v4_check_destructure_editor_label_completion, v4_check_destructure_editor_power_item)
say "check-destructure-editor-label-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_label_item >= 0)
say "check-destructure-editor-label-detail=" + v4_check_destructure_editor_completion_detail_or_empty(v4_check_destructure_editor_label_completion, v4_check_destructure_editor_label_item)
say "check-destructure-editor-temp-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_temp_item >= 0)
say "check-destructure-editor-right-hover-kind=" + v4_hover_kind(v4_check_destructure_editor_right_hover)
say "check-destructure-editor-right-hover-type=" + v4_hover_type(v4_check_destructure_editor_right_hover)
say "check-destructure-editor-right-definition-kind=" + v4_definition_at_kind(v4_check_destructure_editor_right_definition)
say "check-destructure-editor-right-definition-found=" + word_from_int(v4_definition_at_found(v4_check_destructure_editor_right_definition))
say "check-destructure-editor-right-definition-matches=" + v4_check_destructure_editor_bool_word(v4_span_start(v4_definition_at_span(v4_check_destructure_editor_right_definition)) == v4_check_destructure_editor_right_decl_offset)
say "check-destructure-editor-right-completion-count=" + word_from_int(v4_completion_count(v4_check_destructure_editor_right_completion))
say "check-destructure-editor-left-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_left_item >= 0)
say "check-destructure-editor-left-detail=" + v4_check_destructure_editor_completion_detail_or_empty(v4_check_destructure_editor_right_completion, v4_check_destructure_editor_left_item)
say "check-destructure-editor-right-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_right_item >= 0)
say "check-destructure-editor-right-detail=" + v4_check_destructure_editor_completion_detail_or_empty(v4_check_destructure_editor_right_completion, v4_check_destructure_editor_right_item)
say "check-destructure-editor-result-temp-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_result_temp_item >= 0)
say "check-destructure-editor-outer-power-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_outer_power_item >= 0)
say "check-destructure-editor-outer-right-found=" + v4_check_destructure_editor_bool_word(v4_check_destructure_editor_outer_right_item >= 0)
