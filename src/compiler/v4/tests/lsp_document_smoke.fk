say v4_lsp_hover_document("named-live.fk", v4_lsp_named_bonus_label_offset)
say v4_lsp_definition_document("named-live.fk", v4_lsp_named_bonus_label_offset)
say v4_lsp_hover_document("named-live.fk", v4_lsp_named_callsign_label_offset)
