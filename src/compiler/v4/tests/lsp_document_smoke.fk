say v4_lsp_completion_document("named-live.fk", v4_lsp_named_callsign_offset)

pilot v4_lsp_glob_doc_source = "task main() => 0\n"
pilot v4_lsp_glob_doc_id = v4_lsp_open_document("glob-live.fk", v4_lsp_glob_doc_source)
