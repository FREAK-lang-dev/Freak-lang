-- V4 LSP document lifecycle smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_lsp_doc_alias_diag_source() -> word {
    pilot src = "alias Loop = Loop\n"
    src = src + "alias First = Second\n"
    src = src + "alias Second = First\n"
    src = src + "alias Spiral<T> = Spiral<T>\n"
    src = src + "alias Pair = (Pair, int)\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_doc_lifetime_diag_source() -> word {
    pilot src = "shape RefBox<'a,T> {\n"
    src = src + "    value: T\n"
    src = src + "}\n"
    src = src + "shape BadBox {\n"
    src = src + "    value: RefBox<'ghost,int>\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_doc_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_lsp_doc_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_lsp_doc_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_lsp_doc_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_lsp_doc_variant_source() -> word {
    pilot src = "variant Event {\n"
    src = src + "    Key " + v4_lsp_doc_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot event = Event::Key " + v4_lsp_doc_braces(" code: 9 ") + "\n"
    src = src + "    give back 0\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_doc_named_source() -> word {
    pilot src = "task compose(host: word, port: int, timeout: int) -> int {\n"
    src = src + "    give back port + timeout\n"
    src = src + "}\n"
    src = src + "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task boost(self, bonus: int) -> int {\n"
    src = src + "        give back self.hp + bonus\n"
    src = src + "    }\n"
    src = src + "    task ace(callsign: word) -> Pilot {\n"
    src = src + "        give back Pilot " + v4_lsp_doc_braces(" hp: 9 ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ship = Pilot " + v4_lsp_doc_braces(" hp: 7 ") + "\n"
    src = src + "    pilot routed = compose(host: \"localhost\", port: 8080)\n"
    src = src + "    pilot boosted = ship.boost(2)\n"
    src = src + "    pilot ace = Pilot::ace(\"Valkyrie-1\")\n"
    src = src + "    pilot boosted_named = ship.boost(bonus: 4)\n"
    src = src + "    pilot ace_named = Pilot::ace(callsign: \"Valkyrie-2\")\n"
    src = src + "    give back routed + boosted + ace.hp\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_doc_glob_source() -> word {
    pilot src = "task util::math::double(value: int) -> int {\n"
    src = src + "    give back value + value\n"
    src = src + "}\n"
    src = src + "task util::math::triple(value: int) -> int {\n"
    src = src + "    give back value + value + value\n"
    src = src + "}\n"
    src = src + "use util::math::*\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot a = double(2)\n"
    src = src + "    pilot b = triple(3)\n"
    src = src + "    give back a + b\n"
    src = src + "}\n"
    give back src
}

task v4_lsp_doc_const_source() -> word {
    pilot src = "fixed pilot BASE: int = 2\n"
    src = src + "fixed pilot WIDTH: uint = 2u\n"
    src = src + "fixed pilot DEPTH: int = BASE + WIDTH\n"
    src = src + "fixed pilot CELLS = DEPTH * BASE\n"
    src = src + "task main() -> int {\n"
    src = src + "    give back CELLS\n"
    src = src + "}\n"
    give back src
}

pilot v4_lsp_doc_source = "task main() => \"hi\"\n"
pilot v4_lsp_doc_id = v4_lsp_open_document("live.fk", v4_lsp_doc_source)

say "opened-doc=" + word_from_int(v4_lsp_doc_id)
say v4_lsp_document_summary("live.fk")
say v4_lsp_hover_document("live.fk", 5)
say v4_lsp_definition_document("live.fk", 5)

pilot v4_lsp_doc_changed = v4_lsp_doc_variant_source()
v4_lsp_change_document("live.fk", v4_lsp_doc_changed)

say v4_lsp_document_summary("live.fk")
say v4_lsp_document_symbols_document("live.fk")
say v4_lsp_completion_document("live.fk", 0)
say v4_lsp_diagnostics_document("live.fk")

