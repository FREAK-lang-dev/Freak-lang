-- V4 canonical release-target contract smoke fixture.
-- Verification prepends freak_target before this file.

task v4_target_smoke_bool(value: bool) -> word {
    if value { give back "true" }
    give back "false"
}

pilot v4_target_smoke_linux_x64 = v4_target_spec_new(v4_target_triple_linux_x86_64)
pilot v4_target_smoke_linux_arm64 = v4_target_spec_new(v4_target_triple_linux_aarch64)
pilot v4_target_smoke_macos_arm64 = v4_target_spec_new(v4_target_triple_macos_aarch64)
pilot v4_target_smoke_windows_x64 = v4_target_spec_new(v4_target_triple_windows_x86_64)

pilot v4_target_smoke_noncanonical_frame = "0" + v4_target_smoke_linux_x64
pilot v4_target_smoke_noncanonical_pointer = ""
v4_target_smoke_noncanonical_pointer = v4_target_pack_field(v4_target_tag_spec) + v4_target_pack_field(v4_target_wire_format) + v4_target_pack_field(v4_target_triple_linux_x86_64) + v4_target_pack_field(v4_target_arch_x86_64) + v4_target_pack_field(v4_target_os_linux) + v4_target_pack_field(v4_target_environment_gnu) + v4_target_pack_field("064") + v4_target_pack_field(v4_target_endian_little) + v4_target_pack_field(v4_target_c_data_model_lp64) + v4_target_pack_field(v4_target_object_format_elf) + v4_target_pack_field("C,cdecl,system,sysv64") + v4_target_pack_field("") + v4_target_pack_field("") + v4_target_pack_field("") + v4_target_pack_field(".o") + v4_target_pack_field(v4_target_link_clang_gnu) + v4_target_pack_field(v4_target_entry_posix_main)

say "target-count=" + word_from_int(v4_target_spec_count())
say "target-linux-x64-summary=" + v4_target_spec_summary(v4_target_smoke_linux_x64)
say "target-linux-arm64-summary=" + v4_target_spec_summary(v4_target_smoke_linux_arm64)
say "target-macos-arm64-summary=" + v4_target_spec_summary(v4_target_smoke_macos_arm64)
say "target-windows-x64-summary=" + v4_target_spec_summary(v4_target_smoke_windows_x64)

say "target-all-valid=" + v4_target_smoke_bool(v4_target_spec_valid(v4_target_smoke_linux_x64) and v4_target_spec_valid(v4_target_smoke_linux_arm64) and v4_target_spec_valid(v4_target_smoke_macos_arm64) and v4_target_spec_valid(v4_target_smoke_windows_x64))
say "target-index-stable=" + v4_target_smoke_bool(v4_target_spec_at(0) == v4_target_smoke_linux_x64 and v4_target_spec_at(1) == v4_target_smoke_linux_arm64 and v4_target_spec_at(2) == v4_target_smoke_macos_arm64 and v4_target_spec_at(3) == v4_target_smoke_windows_x64 and v4_target_spec_at(4) == "")
say "target-release-names=" + v4_target_release_name(v4_target_smoke_linux_x64) + "," + v4_target_release_name(v4_target_smoke_linux_arm64) + "," + v4_target_release_name(v4_target_smoke_macos_arm64) + "," + v4_target_release_name(v4_target_smoke_windows_x64)
say "target-c-models=" + v4_target_spec_c_data_model(v4_target_smoke_linux_x64) + "," + v4_target_spec_c_data_model(v4_target_smoke_linux_arm64) + "," + v4_target_spec_c_data_model(v4_target_smoke_macos_arm64) + "," + v4_target_spec_c_data_model(v4_target_smoke_windows_x64)
say "target-lp64-vs-llp64=" + v4_target_smoke_bool(v4_target_spec_c_data_model(v4_target_smoke_linux_x64) == v4_target_c_data_model_lp64 and v4_target_spec_c_data_model(v4_target_smoke_linux_arm64) == v4_target_c_data_model_lp64 and v4_target_spec_c_data_model(v4_target_smoke_macos_arm64) == v4_target_c_data_model_lp64 and v4_target_spec_c_data_model(v4_target_smoke_windows_x64) == v4_target_c_data_model_llp64)
say "target-pointer-widths=" + word_from_int(v4_target_spec_pointer_width(v4_target_smoke_linux_x64)) + "," + word_from_int(v4_target_spec_pointer_width(v4_target_smoke_linux_arm64)) + "," + word_from_int(v4_target_spec_pointer_width(v4_target_smoke_macos_arm64)) + "," + word_from_int(v4_target_spec_pointer_width(v4_target_smoke_windows_x64))
say "target-endianness=" + v4_target_spec_endianness(v4_target_smoke_linux_x64) + "," + v4_target_spec_endianness(v4_target_smoke_linux_arm64) + "," + v4_target_spec_endianness(v4_target_smoke_macos_arm64) + "," + v4_target_spec_endianness(v4_target_smoke_windows_x64)
say "target-object-formats=" + v4_target_spec_object_format(v4_target_smoke_linux_x64) + "," + v4_target_spec_object_format(v4_target_smoke_linux_arm64) + "," + v4_target_spec_object_format(v4_target_smoke_macos_arm64) + "," + v4_target_spec_object_format(v4_target_smoke_windows_x64)
say "target-artifact-names=" + v4_target_executable_name(v4_target_smoke_linux_x64, "maverick") + "," + v4_target_object_name(v4_target_smoke_linux_x64, "maverick") + "," + v4_target_executable_name(v4_target_smoke_windows_x64, "maverick") + "," + v4_target_object_name(v4_target_smoke_windows_x64, "maverick")
say "target-link-policies=" + v4_target_spec_link_policy(v4_target_smoke_linux_x64) + "," + v4_target_spec_link_policy(v4_target_smoke_macos_arm64) + "," + v4_target_spec_link_policy(v4_target_smoke_windows_x64)
say "target-entry-policies=" + v4_target_spec_entry_policy(v4_target_smoke_linux_x64) + "," + v4_target_spec_entry_policy(v4_target_smoke_macos_arm64) + "," + v4_target_spec_entry_policy(v4_target_smoke_windows_x64)

say "target-linux-x64-conventions=" + v4_target_smoke_bool(v4_target_calling_convention_supported(v4_target_smoke_linux_x64, v4_target_cc_c) and v4_target_calling_convention_supported(v4_target_smoke_linux_x64, v4_target_cc_cdecl) and v4_target_calling_convention_supported(v4_target_smoke_linux_x64, v4_target_cc_system) and v4_target_calling_convention_supported(v4_target_smoke_linux_x64, v4_target_cc_sysv64))
say "target-arm64-rejects-x64-conventions=" + v4_target_smoke_bool(not v4_target_calling_convention_supported(v4_target_smoke_linux_arm64, v4_target_cc_sysv64) and not v4_target_calling_convention_supported(v4_target_smoke_macos_arm64, v4_target_cc_win64) and not v4_target_calling_convention_supported(v4_target_smoke_macos_arm64, v4_target_cc_vectorcall))
say "target-windows-x64-conventions=" + v4_target_smoke_bool(v4_target_calling_convention_supported(v4_target_smoke_windows_x64, v4_target_cc_c) and v4_target_calling_convention_supported(v4_target_smoke_windows_x64, v4_target_cc_win64) and v4_target_calling_convention_supported(v4_target_smoke_windows_x64, v4_target_cc_vectorcall) and not v4_target_calling_convention_supported(v4_target_smoke_windows_x64, v4_target_cc_sysv64))
say "target-legacy-x86-conventions-rejected=" + v4_target_smoke_bool(not v4_target_calling_convention_supported(v4_target_smoke_linux_x64, "stdcall") and not v4_target_calling_convention_supported(v4_target_smoke_windows_x64, "stdcall") and not v4_target_calling_convention_supported(v4_target_smoke_windows_x64, "fastcall") and not v4_target_calling_convention_supported(v4_target_smoke_windows_x64, "thiscall"))
say "target-unknown-convention-rejected=" + v4_target_smoke_bool(not v4_target_calling_convention_supported(v4_target_smoke_linux_x64, "rust-call") and not v4_target_calling_convention_supported(v4_target_smoke_windows_x64, "CDECL"))
say "target-round-trip=" + v4_target_smoke_bool(v4_target_spec_decode(v4_target_spec_encode(v4_target_smoke_linux_x64)) == v4_target_smoke_linux_x64 and v4_target_spec_decode(v4_target_spec_encode(v4_target_smoke_linux_arm64)) == v4_target_smoke_linux_arm64 and v4_target_spec_decode(v4_target_spec_encode(v4_target_smoke_macos_arm64)) == v4_target_smoke_macos_arm64 and v4_target_spec_decode(v4_target_spec_encode(v4_target_smoke_windows_x64)) == v4_target_smoke_windows_x64)
say "target-aliases-rejected=" + v4_target_smoke_bool(v4_target_spec_new("linux-x64") == "" and v4_target_spec_new("amd64-unknown-linux-gnu") == "" and v4_target_spec_new("X86_64-UNKNOWN-LINUX-GNU") == "")
say "target-unknown-triple-rejected=" + v4_target_smoke_bool(v4_target_spec_new("wasm32-unknown-unknown") == "" and v4_target_normalize_triple("host") == "")
say "target-invalid-records-rejected=" + v4_target_smoke_bool(not v4_target_spec_valid(v4_target_smoke_noncanonical_frame) and not v4_target_spec_valid(v4_target_smoke_noncanonical_pointer) and v4_target_spec_decode(v4_target_smoke_noncanonical_frame) == "" and v4_target_spec_decode(v4_target_smoke_noncanonical_pointer) == "")
say "target-invalid-accessors-fail-closed=" + v4_target_smoke_bool(v4_target_spec_triple("") == "" and v4_target_spec_pointer_width("") == 0 - 1 and v4_target_executable_name("", "maverick") == "" and v4_target_object_name(v4_target_smoke_linux_x64, "") == "")
say "target-summary-deterministic=" + v4_target_smoke_bool(v4_target_spec_summary(v4_target_smoke_linux_x64) == v4_target_spec_summary(v4_target_spec_new(v4_target_triple_linux_x86_64)) and v4_target_spec_summary("") == "target-invalid")
