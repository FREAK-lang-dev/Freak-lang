pilot v4_mir_check_result_n_stmt = v4_mir_check_find_stmt(v4_mir_check_result_mir, v4_mir_check_result_body, v4_mir_stmt_local, "n")
pilot v4_mir_check_result_parsed_rvalue = v4_mir_stmt_rvalue(v4_mir_check_result_mir, v4_mir_check_result_body, v4_mir_check_result_parsed_stmt)
pilot v4_mir_check_result_failed_rvalue = v4_mir_stmt_rvalue(v4_mir_check_result_mir, v4_mir_check_result_body, v4_mir_check_result_failed_stmt)
