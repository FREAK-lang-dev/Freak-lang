-- V4 dyn doctrine MIR smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_dyn_mir_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_dyn_mir_source() -> word {
    pilot src = "alias Score = int\n"
    src = src + "doctrine Widget {\n"
    src = src + "    task draw(self) -> word\n"
    src = src + "}\n"
    src = src + "doctrine Displayable<T> {\n"
    src = src + "    task display(self) -> word\n"
    src = src + "}\n"
    src = src + "doctrine Holder<T> {\n"
    src = src + "    task get(self) -> T\n"
    src = src + "}\n"
    src = src + "shape Button {\n"
    src = src + "    label: word\n"
    src = src + "}\n"
    src = src + "shape Rock {\n"
    src = src + "    mass: int\n"
    src = src + "}\n"
    src = src + "shape NumberLabel {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "shape IntBox {\n"
    src = src + "    value: int\n"
    src = src + "}\n"
    src = src + "shape PaintBox {\n"
    src = src + "    slot: int\n"
    src = src + "}\n"
    src = src + "impl Widget for Button {\n"
    src = src + "    task draw(self) -> word {\n"
    src = src + "        give back self.label\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Displayable<Score> for NumberLabel {\n"
    src = src + "    task display(self) -> word {\n"
    src = src + "        give back \"number\"\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl Holder<int> for IntBox {\n"
    src = src + "    task get(self) -> int {\n"
    src = src + "        give back self.value\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl PaintBox {\n"
    src = src + "    task set(self, w: dyn Widget) -> word {\n"
    src = src + "        give back w.draw()\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task paint(button: Button) -> word {\n"
    src = src + "    pilot widget: dyn Widget = button\n"
    src = src + "    give back widget.draw()\n"
    src = src + "}\n"
    src = src + "task repaint(button: Button) -> word {\n"
    src = src + "    pilot widget: dyn Widget = button\n"
    src = src + "    widget = button\n"
    src = src + "    give back widget.draw()\n"
    src = src + "}\n"
    src = src + "task erase<T: Widget>(value: T) -> dyn Widget {\n"
    src = src + "    pilot widget: dyn Widget = value\n"
    src = src + "    give back widget\n"
    src = src + "}\n"
    src = src + "task erase_direct(button: Button) -> dyn Widget {\n"
    src = src + "    give back button\n"
    src = src + "}\n"
    src = src + "task consume(w: dyn Widget) -> word {\n"
    src = src + "    give back w.draw()\n"
    src = src + "}\n"
    src = src + "task forward<T: Widget>(value: T) -> word {\n"
    src = src + "    give back consume(value)\n"
    src = src + "}\n"
    src = src + "task accept<T>(d: dyn Displayable<T>, sample: T) -> T {\n"
    src = src + "    give back sample\n"
    src = src + "}\n"
    src = src + "task use<T, U: Displayable<T>>(u: U, sample: T) -> T {\n"
    src = src + "    give back sample\n"
    src = src + "}\n"
    src = src + "task use_accept(label: NumberLabel) -> int {\n"
    src = src + "    give back accept(label, 1)\n"
    src = src + "}\n"
    src = src + "task use_bound(label: NumberLabel) -> int {\n"
    src = src + "    give back use(label, 1)\n"
    src = src + "}\n"
    src = src + "task show_one<T>(d: dyn Displayable<T>) -> word {\n"
    src = src + "    give back d.display()\n"
    src = src + "}\n"
    src = src + "task forward_accept<U: Displayable<int>>(u: U) -> word {\n"
    src = src + "    give back show_one(u)\n"
    src = src + "}\n"
    src = src + "task read_box(h: dyn Holder<int>) -> int {\n"
    src = src + "    give back h.get()\n"
    src = src + "}\n"
    src = src + "task share(button: Button) -> Shared<dyn Widget> {\n"
    src = src + "    give back Shared<Button>::new(button)\n"
    src = src + "}\n"
    src = src + "task weaken(root: Shared<Button>) -> Weak<dyn Widget> {\n"
    src = src + "    give back root.downgrade()\n"
    src = src + "}\n"
    src = src + "task lend_erase(lend button: Button) -> lend dyn Widget {\n"
    src = src + "    give back lend button\n"
    src = src + "}\n"
    src = src + "task paint_lend(lend button: Button) -> word {\n"
    src = src + "    pilot widget: lend dyn Widget = lend button\n"
    src = src + "    give back widget.draw()\n"
    src = src + "}\n"
    src = src + "task call_set(box: PaintBox, button: Button) -> word {\n"
    src = src + "    give back box.set(button)\n"
    src = src + "}\n"
    src = src + "task consume_shared(w: Shared<dyn Widget>) -> word {\n"
    src = src + "    give back \"shared\"\n"
    src = src + "}\n"
    src = src + "task consume_weak(w: Weak<dyn Widget>) -> word {\n"
    src = src + "    give back \"weak\"\n"
    src = src + "}\n"
    src = src + "task forward_shared<T: Widget>(value: Shared<T>) -> word {\n"
    src = src + "    give back consume_shared(value)\n"
    src = src + "}\n"
    src = src + "task forward_weak<T: Widget>(value: Weak<T>) -> word {\n"
    src = src + "    give back consume_weak(value)\n"
    src = src + "}\n"
    give back src
}

task v4_dyn_mir_bad_source() -> word {
    pilot src = v4_dyn_mir_source()
    src = src + "task bad(rock: Rock) -> void {\n"
    src = src + "    pilot widget: dyn Widget = rock\n"
    src = src + "}\n"
    give back src
}

task v4_dyn_mir_bad_list_source() -> word {
    pilot src = v4_dyn_mir_source()
    src = src + "task take_list(items: List<dyn Widget>) -> void {\n"
    src = src + "}\n"
    src = src + "task bad_list(buttons: List<Button>) -> void {\n"
    src = src + "    take_list(buttons)\n"
    src = src + "}\n"
    give back src
}

task v4_dyn_mir_bad_holder_source() -> word {
    pilot src = v4_dyn_mir_source()
    src = src + "task bad_holder(button: Button) -> void {\n"
    src = src + "    pilot erased: dyn Holder = button\n"
    src = src + "}\n"
    give back src
}

