-- V4 dyn doctrine MIR smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_dyn_mir_source() -> word {
    pilot src = "doctrine Widget {\n"
    src = src + "    task draw(self) -> word\n"
    src = src + "}\n"
    src = src + "shape Button {\n"
    src = src + "    label: word\n"
    src = src + "}\n"
    src = src + "shape PaintBox {\n"
    src = src + "    slot: int\n"
    src = src + "}\n"
    src = src + "impl Widget for Button {\n"
    src = src + "    task draw(self) -> word {\n"
    src = src + "        give back self.label\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "impl PaintBox {\n"
    src = src + "    task set(self, w: dyn Widget) -> word {\n"
    src = src + "        give back w.draw()\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "task paint(button: Button) -> word {\n"
    src = src + "    pilot widget: dyn Widget = button\n"
    src = src + "    give back widget.draw()\n"
    src = src + "}\n"
    src = src + "task repaint(button: Button) -> word {\n"
    src = src + "    pilot widget: dyn Widget = button\n"
    src = src + "    widget = button\n"
    src = src + "    give back widget.draw()\n"
    src = src + "}\n"
    src = src + "task erase<T: Widget>(value: T) -> dyn Widget {\n"
    src = src + "    pilot widget: dyn Widget = value\n"
    src = src + "    give back widget\n"
    src = src + "}\n"
    src = src + "task erase_direct(button: Button) -> dyn Widget {\n"
    src = src + "    give back button\n"
    src = src + "}\n"
    src = src + "task consume(w: dyn Widget) -> word {\n"
    src = src + "    give back w.draw()\n"
    src = src + "}\n"
    src = src + "task invoke(cb: extern [C] task(x: dyn Widget) -> void, button: Button) -> void {\n"
    src = src + "    cb(button)\n"
    src = src + "}\n"
    src = src + "task forward<T: Widget>(value: T) -> word {\n"
    src = src + "    give back consume(value)\n"
    src = src + "}\n"
    src = src + "task lend_erase(lend button: Button) -> lend dyn Widget {\n"
    src = src + "    give back lend button\n"
    src = src + "}\n"
    src = src + "task paint_lend(lend button: Button) -> word {\n"
    src = src + "    pilot widget: lend dyn Widget = lend button\n"
    src = src + "    give back widget.draw()\n"
    src = src + "}\n"
    src = src + "task call_set(box: PaintBox, button: Button) -> word {\n"
    src = src + "    give back box.set(button)\n"
    src = src + "}\n"
    give back src
}

pilot v4_dyn_mir_text = v4_dyn_mir_source()
pilot v4_dyn_mir_stream = v4_lex_text(0, v4_dyn_mir_text)
pilot v4_dyn_mir_tree = v4_parse_stream(0, v4_dyn_mir_stream)
pilot v4_dyn_mir_hir = v4_hir_lower_tree(0, v4_dyn_mir_tree)
pilot v4_dyn_mir_resolve = v4_resolve_lower_hir(0, v4_dyn_mir_hir)
pilot v4_dyn_mir_ty = v4_ty_lower_resolve(0, v4_dyn_mir_resolve)
pilot v4_dyn_mir_id = v4_mir_lower_ty(0, v4_dyn_mir_ty)
pilot v4_dyn_mir_paint_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "paint")
pilot v4_dyn_mir_paint_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_paint_def)
pilot v4_dyn_mir_widget_local = v4_mir_find_local(v4_dyn_mir_id, v4_dyn_mir_paint_body, "widget")
pilot v4_dyn_mir_widget_init = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_paint_body, 0)
pilot v4_dyn_mir_paint_return = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_paint_body, 1)
pilot v4_dyn_mir_repaint_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "repaint")
pilot v4_dyn_mir_repaint_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_repaint_def)
pilot v4_dyn_mir_repaint_assign = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_repaint_body, 1)
pilot v4_dyn_mir_erase_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "erase")
pilot v4_dyn_mir_erase_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_erase_def)
pilot v4_dyn_mir_erase_widget = v4_mir_find_local(v4_dyn_mir_id, v4_dyn_mir_erase_body, "widget")
pilot v4_dyn_mir_erase_direct_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "erase_direct")
pilot v4_dyn_mir_erase_direct_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_erase_direct_def)
pilot v4_dyn_mir_erase_direct_return_place = v4_mir_stmt_place(v4_dyn_mir_id, v4_dyn_mir_erase_direct_body, 0)
pilot v4_dyn_mir_forward_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "forward")
pilot v4_dyn_mir_forward_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_forward_def)
pilot v4_dyn_mir_forward_return = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_forward_body, 0)
pilot v4_dyn_mir_forward_arg = v4_mir_rvalue_call_arg(v4_dyn_mir_id, v4_dyn_mir_forward_body, v4_dyn_mir_forward_return, 0)
pilot v4_dyn_mir_invoke_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "invoke")
pilot v4_dyn_mir_invoke_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_invoke_def)
pilot v4_dyn_mir_invoke_call = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_invoke_body, 0)
pilot v4_dyn_mir_invoke_arg = v4_mir_rvalue_call_arg(v4_dyn_mir_id, v4_dyn_mir_invoke_body, v4_dyn_mir_invoke_call, 0)
pilot v4_dyn_mir_lend_erase_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "lend_erase")
pilot v4_dyn_mir_lend_erase_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_lend_erase_def)
pilot v4_dyn_mir_lend_erase_return_place = v4_mir_stmt_place(v4_dyn_mir_id, v4_dyn_mir_lend_erase_body, 0)
pilot v4_dyn_mir_paint_lend_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "paint_lend")
pilot v4_dyn_mir_paint_lend_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_paint_lend_def)
pilot v4_dyn_mir_paint_lend_return = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_paint_lend_body, 1)
pilot v4_dyn_mir_call_set_def = v4_resolve_def_for_name(v4_dyn_mir_resolve, "call_set")
pilot v4_dyn_mir_call_set_body = v4_mir_lookup_body(v4_dyn_mir_id, v4_dyn_mir_call_set_def)
pilot v4_dyn_mir_call_set_return = v4_mir_stmt_rvalue(v4_dyn_mir_id, v4_dyn_mir_call_set_body, 0)
pilot v4_dyn_mir_call_set_arg = v4_mir_rvalue_call_arg(v4_dyn_mir_id, v4_dyn_mir_call_set_body, v4_dyn_mir_call_set_return, 1)

say v4_mir_summary(v4_dyn_mir_id)
say "dyn-mir-paint-diagnostics=" + word_from_int(v4_mir_diag_count(v4_dyn_mir_id))
say "dyn-mir-widget-local-type=" + v4_mir_local_type_display(v4_dyn_mir_id, v4_dyn_mir_paint_body, v4_dyn_mir_widget_local)
say "dyn-mir-widget-init-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_paint_body, v4_dyn_mir_widget_init)
say "dyn-mir-repaint-assign-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_repaint_body, v4_dyn_mir_repaint_assign)
say "dyn-mir-return-kind=" + v4_mir_rvalue_kind(v4_dyn_mir_id, v4_dyn_mir_paint_body, v4_dyn_mir_paint_return)
say "dyn-mir-return-op=" + v4_mir_rvalue_op(v4_dyn_mir_id, v4_dyn_mir_paint_body, v4_dyn_mir_paint_return)
say "dyn-mir-return-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_paint_body, v4_dyn_mir_paint_return)
say "dyn-mir-erase-widget-local-type=" + v4_mir_local_type_display(v4_dyn_mir_id, v4_dyn_mir_erase_body, v4_dyn_mir_erase_widget)
say "dyn-mir-erase-direct-return-place-ty=" + v4_mir_place_ty(v4_dyn_mir_id, v4_dyn_mir_erase_direct_body, v4_dyn_mir_erase_direct_return_place)
say "dyn-mir-forward-arg-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_forward_body, v4_dyn_mir_forward_arg)
say "dyn-mir-callback-arg-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_invoke_body, v4_dyn_mir_invoke_arg)
say "dyn-mir-lend-erase-return-place-ty=" + v4_mir_place_ty(v4_dyn_mir_id, v4_dyn_mir_lend_erase_body, v4_dyn_mir_lend_erase_return_place)
say "dyn-mir-paint-lend-return-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_paint_lend_body, v4_dyn_mir_paint_lend_return)
say "dyn-mir-call-set-return-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_call_set_body, v4_dyn_mir_call_set_return)
say "dyn-mir-call-set-arg-ty=" + v4_mir_rvalue_ty(v4_dyn_mir_id, v4_dyn_mir_call_set_body, v4_dyn_mir_call_set_arg)
say "dyn-mir-compact-dynwidget=" + v4_mir_compact_type_text("dynWidget")
say "dyn-mir-compact-list-dyn=" + v4_mir_compact_type_text("List<dyn Widget>")
