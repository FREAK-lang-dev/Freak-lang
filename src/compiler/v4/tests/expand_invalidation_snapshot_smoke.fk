-- V4 expansion invalidation and snapshot contract smoke fixture.
-- Verification prepends the V4 crates before this file.

pilot v4_expand_contract_path = "expand-contract.fk"
pilot v4_expand_contract_source = "task main() => \"before\"\nshape Pilot\n"
pilot v4_expand_contract_changed = "shape Pilot\ntask main() => \"after\"\n"
pilot v4_expand_contract_doc = 0
pilot v4_expand_contract_syntax = ""
pilot v4_expand_contract_file = 0
pilot v4_expand_contract_fingerprint = ""
pilot v4_expand_contract_key = ""
pilot v4_expand_contract_id = 0
pilot v4_expand_contract_public_id = ""
pilot v4_expand_contract_component = ""
pilot v4_expand_contract_lsp_snapshot = ""
pilot v4_expand_contract_before = ""
pilot v4_expand_contract_manifest = ""
pilot v4_expand_contract_change = ""
pilot v4_expand_contract_report = ""
pilot v4_expand_contract_hir_after = 0
pilot v4_expand_contract_fingerprint_after = ""
pilot v4_expand_contract_id_after = 0
pilot v4_expand_contract_public_id_after = ""
pilot v4_expand_contract_tree_after = 0
pilot v4_expand_contract_recomputed = false
pilot v4_expand_contract_after = ""
pilot v4_expand_contract_diff = ""
pilot v4_expand_contract_health = ""
pilot v4_expand_contract_lsp_restore = ""
pilot v4_expand_contract_component_truncated = false
pilot v4_expand_contract_reintroduced = 0
pilot v4_expand_contract_public_reintroduced = ""
pilot v4_expand_contract_restore_generation_unique = false
pilot v4_expand_contract_unit_restore = ""
pilot v4_expand_contract_unit_truncated = false
pilot v4_expand_contract_lsp_missing = ""

v4_expand_contract_doc = v4_lsp_open_document(v4_expand_contract_path, v4_expand_contract_source)
v4_expand_contract_syntax = v4_check_syntax_text(v4_expand_contract_path, v4_expand_contract_source)
v4_expand_contract_file = v4_source_find(v4_expand_contract_path)
v4_expand_contract_fingerprint = v4_source_fingerprint(v4_expand_contract_file)
v4_expand_contract_key = v4_expand_query_key(v4_expand_contract_path)
v4_expand_contract_id = word_to_int(v4_query_get(v4_expand_contract_key, v4_expand_contract_fingerprint))
v4_expand_contract_public_id = v4_expand_contract_expansion_id(v4_expand_contract_id)
v4_expand_contract_component = v4_expand_snapshot()
v4_expand_contract_lsp_snapshot = v4_lsp_expand_snapshot_text()
v4_expand_contract_before = v4_unit_snapshot()
v4_expand_contract_manifest = v4_unit_snapshot_manifest(v4_expand_contract_before)

say "expand-query-dependency=" + word_from_bool(v4_query_direct_dependency_count(v4_expand_contract_key) == 1 and v4_query_direct_dependency_at(v4_expand_contract_key, 0) == v4_parse_query_key(v4_expand_contract_path))
say "expand-snapshot-validation=" + word_from_bool(v4_expand_snapshot_validate(v4_expand_contract_component).starts_with("expand-snapshot-import ok=1 "))
say "expand-lsp-snapshot=" + word_from_bool(v4_expand_contract_lsp_snapshot.starts_with("ok|workspace/expandSnapshot\nexpand-snapshot|format=freak-expand-snapshot-v1"))
say "expand-unit-section=" + word_from_bool(v4_unit_snapshot_section_payload(v4_expand_contract_before, "expand") == v4_expand_contract_component)
say "expand-unit-manifest=" + word_from_bool(v4_expand_contract_manifest.starts_with("00-unit-manifest|format=freak-00-unit-manifest-v1|ok=1"))

v4_expand_contract_change = v4_lsp_handle_text_request("textDocument/didChange", v4_expand_contract_path, v4_expand_contract_changed, 0)
v4_expand_contract_report = v4_unit_snapshot_line(v4_expand_contract_change, 2)
say "expand-invalidation-count=" + v4_unit_snapshot_key_value(v4_expand_contract_report, "expand-invalidations-added")
say "expand-parse-invalidation-count=" + v4_unit_snapshot_key_value(v4_expand_contract_report, "parse-invalidations-added")
say "expand-lex-invalidation-count=" + v4_unit_snapshot_key_value(v4_expand_contract_report, "lex-invalidations-added")

v4_expand_contract_hir_after = v4_hir_text_cached(v4_expand_contract_path, v4_expand_contract_changed)
v4_expand_contract_fingerprint_after = v4_source_fingerprint(v4_expand_contract_file)
v4_expand_contract_id_after = word_to_int(v4_query_get(v4_expand_contract_key, v4_expand_contract_fingerprint_after))
v4_expand_contract_public_id_after = v4_expand_contract_expansion_id(v4_expand_contract_id_after)
v4_expand_contract_tree_after = v4_expand_parse_tree_id(v4_expand_contract_id_after)
v4_expand_contract_recomputed = v4_expand_contract_id_after > v4_expand_contract_id and v4_hir_expansion_id(v4_expand_contract_hir_after) == v4_expand_contract_id_after and v4_expand_contract_tree_after != v4_expand_parse_tree_id(v4_expand_contract_id)
v4_expand_contract_after = v4_unit_snapshot()
v4_expand_contract_diff = v4_unit_snapshot_diff(v4_expand_contract_before, v4_expand_contract_after)
v4_expand_contract_health = v4_unit_snapshot_health(v4_expand_contract_after)
v4_expand_contract_lsp_restore = v4_lsp_expand_snapshot_restore_text(v4_expand_contract_component)
v4_expand_contract_component_truncated = v4_expand_file_count() == 1 and v4_expand_file_exists(v4_expand_contract_id_after) == false and v4_expand_snapshot() == v4_expand_contract_component
v4_expand_contract_reintroduced = v4_expand_identity(v4_expand_contract_file, v4_expand_contract_tree_after)
v4_expand_contract_public_reintroduced = v4_expand_contract_expansion_id(v4_expand_contract_reintroduced)
v4_expand_contract_restore_generation_unique = v4_expansion_id_valid(v4_expand_contract_public_id) and v4_expand_contract_reintroduced == v4_expand_contract_id_after and v4_expansion_id_source(v4_expand_contract_public_reintroduced) == v4_expansion_id_source(v4_expand_contract_public_id_after) and v4_expansion_id_invocation(v4_expand_contract_public_reintroduced) == v4_expansion_id_invocation(v4_expand_contract_public_id_after) and v4_expansion_id_generation(v4_expand_contract_public_reintroduced) > v4_expansion_id_generation(v4_expand_contract_public_id_after) and v4_expand_contract_public_reintroduced != v4_expand_contract_public_id_after and not v4_expand_contract_expansion_matches(v4_expand_contract_reintroduced, v4_expand_contract_public_id_after) and v4_expand_contract_expansion_matches(v4_expand_contract_reintroduced, v4_expand_contract_public_reintroduced)
v4_expand_contract_unit_restore = v4_unit_snapshot_restore(v4_expand_contract_before)
v4_expand_contract_unit_truncated = v4_expand_contract_unit_restore.starts_with("00-unit-snapshot-restore ok=1 ") and v4_expand_file_count() == 1 and v4_expand_file_exists(v4_expand_contract_reintroduced) == false and v4_expand_snapshot() == v4_expand_contract_component
v4_expand_contract_lsp_missing = v4_lsp_handle_request("workspace/expandSnapshotRestore", v4_expand_contract_path, 0)

say "expand-unit-diff=" + word_from_bool(v4_expand_contract_diff.starts_with("00-unit-diff|format=freak-00-unit-snapshot-diff-v1|ok=1") and v4_expand_contract_diff.contains("expand-invalidations-added=1") and v4_expand_contract_diff.contains("section-diff|name=expand|state=changed"))
say "expand-unit-health=" + word_from_bool(v4_expand_contract_health.starts_with("00-unit-health|format=freak-00-unit-health-v1|ok=1"))
say "expand-lsp-restore=" + word_from_bool(v4_expand_contract_lsp_restore.starts_with("ok|workspace/expandSnapshotRestore\nexpand-snapshot-restore ok=1 ") and v4_expand_contract_lsp_restore.contains("live-files=1"))
say "expand-component-restore-truncated=" + word_from_bool(v4_expand_contract_component_truncated)
say "expand-unit-restore-truncated=" + word_from_bool(v4_expand_contract_unit_truncated)
say "expand-lsp-missing-payload=" + word_from_bool(v4_expand_contract_lsp_missing == "error|workspace/expandSnapshotRestore|-32602|method requires snapshot text")
say "expand-query-recomputed=" + word_from_bool(v4_expand_contract_recomputed)
say "expand-contract-restore-generation=" + word_from_bool(v4_expand_contract_restore_generation_unique)
