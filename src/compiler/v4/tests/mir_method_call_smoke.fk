-- V4 MIR impl method and associated call smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_mir_method_prelude() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    hp: int\n"
    src = src + "    callsign: word\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task boost(self, bonus: int) -> int {\n"
    src = src + "        give back self.hp + bonus\n"
    src = src + "    }\n"
    src = src + "    task ace(callsign: word) -> Pilot {\n"
    src = src + "        give back Pilot " + "{" + " hp: 9, callsign: callsign " + "}\n"
    src = src + "    }\n"
    src = src + "}\n"
    give back src
}

task v4_mir_method_good_source() -> word {
    pilot src = v4_mir_method_prelude()
    src = src + "task main() -> int {\n"
    src = src + "    pilot ship = Pilot " + "{" + " hp: 7, callsign: \"Shirogane\" " + "}\n"
    src = src + "    pilot boosted = ship.boost(2)\n"
    src = src + "    pilot ace = Pilot::ace(\"Valkyrie-1\")\n"
    src = src + "    give back boosted + ace.hp\n"
    src = src + "}\n"
    give back src
}

task v4_mir_method_bad_receiver_static_source() -> word {
