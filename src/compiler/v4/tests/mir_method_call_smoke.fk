say "method-good-diagnostics=" + word_from_int(v4_mir_diag_count(v4_mir_method_good_mir))

pilot v4_mir_method_bad_receiver_static_stream = v4_lex_text(1, v4_mir_method_bad_receiver_static_source())
pilot v4_mir_method_bad_receiver_static_tree = v4_parse_stream(1, v4_mir_method_bad_receiver_static_stream)
