say "boost-return-ty=" + v4_mir_rvalue_ty(v4_mir_method_good_mir, v4_mir_method_boost_body, v4_mir_method_boost_return)
say "boost-return-lhs-kind=" + v4_mir_rvalue_kind(v4_mir_method_good_mir, v4_mir_method_boost_body, v4_mir_method_boost_lhs)
say "boost-return-lhs-ty=" + v4_mir_rvalue_ty(v4_mir_method_good_mir, v4_mir_method_boost_body, v4_mir_method_boost_lhs)
say "ace-body-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_method_good_mir, v4_mir_method_ace_body))
say "ace-local0-name=" + v4_mir_local_name(v4_mir_method_good_mir, v4_mir_method_ace_body, 0)
say "ace-local0-ty=" + v4_mir_local_ty(v4_mir_method_good_mir, v4_mir_method_ace_body, 0)
say "ace-return-kind=" + v4_mir_rvalue_kind(v4_mir_method_good_mir, v4_mir_method_ace_body, v4_mir_method_ace_return)
say "ace-return-ty=" + v4_mir_rvalue_ty(v4_mir_method_good_mir, v4_mir_method_ace_body, v4_mir_method_ace_return)
say "method-main-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_method_good_mir, v4_mir_method_main_body))
say "method-main-local1-name=" + v4_mir_local_name(v4_mir_method_good_mir, v4_mir_method_main_body, 1)
say "method-main-local1-ty=" + v4_mir_local_ty(v4_mir_method_good_mir, v4_mir_method_main_body, 1)
say "method-main-local2-name=" + v4_mir_local_name(v4_mir_method_good_mir, v4_mir_method_main_body, 2)
say "method-main-local2-ty=" + v4_mir_local_ty(v4_mir_method_good_mir, v4_mir_method_main_body, 2)
say "instance-call-kind=" + v4_mir_rvalue_kind(v4_mir_method_good_mir, v4_mir_method_main_body, v4_mir_method_instance_call)
say "instance-call-op=" + v4_mir_rvalue_op(v4_mir_method_good_mir, v4_mir_method_main_body, v4_mir_method_instance_call)
say "instance-call-ty=" + v4_mir_rvalue_ty(v4_mir_method_good_mir, v4_mir_method_main_body, v4_mir_method_instance_call)
