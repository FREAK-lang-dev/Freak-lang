task v4_mir_method_find_impl_item(hir_id: int, ty_id: int, owner_ty: word) -> int {
    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            if v4_ty_impl_target_type_from_hir(ty_id, hir_item) == owner_ty {
                give back hir_item
            }
        }
        hir_item += 1
    }
    give back 0 - 1
}

task v4_mir_method_find_method_id(ty_id: int, hir_item: int, method_name: word) -> int {
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot method_id = 0
    pilot method_count = v4_ty_impl_method_count(ty_id, hir_item)
    repeat until method_id >= method_count {
        if v4_ty_impl_method_name(ty_id, hir_item, method_id) == method_name {
            give back method_id
        }
        method_id += 1
    }
    give back 0 - 1
}

task v4_mir_method_lookup_body(mir_id: int, ty_id: int, hir_item: int, method_name: word) -> int {
    pilot method_id = v4_mir_method_find_method_id(ty_id, hir_item, method_name)
    if method_id < 0 {
        give back 0 - 1
    }
    give back v4_mir_lookup_body(mir_id, v4_ty_impl_method_def(ty_id, hir_item, method_id))
}

pilot v4_mir_method_good_stream = v4_lex_text(0, v4_mir_method_good_source())
pilot v4_mir_method_good_tree = v4_parse_stream(0, v4_mir_method_good_stream)
pilot v4_mir_method_good_hir = v4_hir_lower_tree(0, v4_mir_method_good_tree)
pilot v4_mir_method_good_resolve = v4_resolve_lower_hir(0, v4_mir_method_good_hir)
pilot v4_mir_method_good_ty = v4_ty_lower_resolve(0, v4_mir_method_good_resolve)
pilot v4_mir_method_good_mir = v4_mir_lower_ty(0, v4_mir_method_good_ty)
pilot v4_mir_method_main_def = v4_resolve_def_for_name(v4_mir_method_good_resolve, "main")
pilot v4_mir_method_main_body = v4_mir_lookup_body(v4_mir_method_good_mir, v4_mir_method_main_def)
pilot v4_mir_method_impl_item = v4_mir_method_find_impl_item(v4_mir_method_good_hir, v4_mir_method_good_ty, "Pilot")
pilot v4_mir_method_boost_body = v4_mir_method_lookup_body(v4_mir_method_good_mir, v4_mir_method_good_ty, v4_mir_method_impl_item, "boost")
pilot v4_mir_method_ace_body = v4_mir_method_lookup_body(v4_mir_method_good_mir, v4_mir_method_good_ty, v4_mir_method_impl_item, "ace")
pilot v4_mir_method_boost_return = v4_mir_stmt_rvalue(v4_mir_method_good_mir, v4_mir_method_boost_body, 0)
pilot v4_mir_method_boost_lhs = v4_mir_rvalue_lhs(v4_mir_method_good_mir, v4_mir_method_boost_body, v4_mir_method_boost_return)
pilot v4_mir_method_ace_return = v4_mir_stmt_rvalue(v4_mir_method_good_mir, v4_mir_method_ace_body, 0)
pilot v4_mir_method_instance_call = v4_mir_stmt_rvalue(v4_mir_method_good_mir, v4_mir_method_main_body, 1)
pilot v4_mir_method_associated_call = v4_mir_stmt_rvalue(v4_mir_method_good_mir, v4_mir_method_main_body, 2)

pilot v4_mir_method_boost_found = "no"
if v4_mir_method_boost_body >= 0 {
    v4_mir_method_boost_found = "yes"
}
pilot v4_mir_method_ace_found = "no"
if v4_mir_method_ace_body >= 0 {
    v4_mir_method_ace_found = "yes"
}

say v4_mir_summary(v4_mir_method_good_mir)
say "method-body-count=" + word_from_int(v4_mir_body_count(v4_mir_method_good_mir))
say "boost-body-found=" + v4_mir_method_boost_found
say "ace-body-found=" + v4_mir_method_ace_found
say "boost-body-locals=" + word_from_int(v4_mir_body_local_count(v4_mir_method_good_mir, v4_mir_method_boost_body))
say "boost-local0-name=" + v4_mir_local_name(v4_mir_method_good_mir, v4_mir_method_boost_body, 0)
say "boost-local0-ty=" + v4_mir_local_ty(v4_mir_method_good_mir, v4_mir_method_boost_body, 0)
say "boost-local1-name=" + v4_mir_local_name(v4_mir_method_good_mir, v4_mir_method_boost_body, 1)
