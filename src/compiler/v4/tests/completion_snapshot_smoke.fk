-- V4 completion arena snapshot smoke fixture.
-- Verification prepends the V4 crates before this file.

task v4_completion_snapshot_find_token(stream_id: int, value: word, ordinal: int) -> int {
    pilot seen = 0
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_lex_token_value(stream_id, token_id) == value {
            if seen == ordinal {
                give back token_id
            }
            seen += 1
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_completion_snapshot_token_offset(stream_id: int, value: word, ordinal: int) -> int {
    pilot token_id = v4_completion_snapshot_find_token(stream_id, value, ordinal)
    if token_id < 0 {
        give back 0
    }
    give back v4_span_start(v4_lex_token_span(stream_id, token_id))
}

task v4_completion_snapshot_find_label(completion_id: int, label: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_completion_snapshot_detail_or_empty(completion_id: int, item_id: int) -> word {
    if item_id < 0 {
        give back ""
    }
    give back v4_completion_detail(completion_id, item_id)
}

task v4_completion_snapshot_bool_word(flag: bool) -> word {
    if flag {
        give back "true"
    }
    give back "false"
}

task v4_completion_snapshot_braces(inner: word) -> word {
    give back "{" + inner + "}"
}

task v4_completion_snapshot_source_text() -> word {
    pilot src = "shape Pilot {\n"
    src = src + "    rank: int\n"
    src = src + "}\n"
    src = src + "impl Pilot {\n"
    src = src + "    task salute(self) -> int {\n"
    src = src + "        give back self.rank\n"
    src = src + "    }\n"
    src = src + "    task pack(level: int) -> Pilot {\n"
    src = src + "        give back Pilot " + v4_completion_snapshot_braces(" rank: level ") + "\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "variant Event {\n"
    src = src + "    Key " + v4_completion_snapshot_braces(" code: int ") + "\n"
    src = src + "}\n"
    src = src + "task main() -> int {\n"
    src = src + "    pilot ace = Pilot::pack(7)\n"
    src = src + "    pilot event = Event::Key " + v4_completion_snapshot_braces(" code: 9 ") + "\n"
    src = src + "    give back ace.salute()\n"
    src = src + "}\n"
    give back src
}

pilot v4_completion_snapshot_source = v4_completion_snapshot_source_text()
pilot v4_completion_snapshot_stream = v4_lex_text(0, v4_completion_snapshot_source)
pilot v4_completion_snapshot_global_offset = 0
pilot v4_completion_snapshot_offset = v4_completion_snapshot_token_offset(v4_completion_snapshot_stream, "salute", 1)

pilot v4_completion_snapshot_global_id = v4_completion_text_cached("completion-snapshot.fk", v4_completion_snapshot_source, v4_completion_snapshot_global_offset)
pilot v4_completion_snapshot_id = v4_completion_text_cached("completion-snapshot.fk", v4_completion_snapshot_source, v4_completion_snapshot_offset)
pilot v4_completion_snapshot_event = v4_completion_snapshot_find_label(v4_completion_snapshot_global_id, "Event")
pilot v4_completion_snapshot_event_key = v4_completion_snapshot_find_label(v4_completion_snapshot_global_id, "Event::Key")
pilot v4_completion_snapshot_uint = v4_completion_snapshot_find_label(v4_completion_snapshot_global_id, "uint")
pilot v4_completion_snapshot_float32 = v4_completion_snapshot_find_label(v4_completion_snapshot_global_id, "float32")
pilot v4_completion_snapshot_salute = v4_completion_snapshot_find_label(v4_completion_snapshot_id, "salute")
pilot v4_completion_snapshot_pack = v4_completion_snapshot_find_label(v4_completion_snapshot_id, "pack")
say v4_completion_summary(v4_completion_snapshot_id)
say v4_completion_snapshot_summary()

pilot v4_completion_snapshot_payload = v4_completion_snapshot()
say v4_completion_snapshot_validate(v4_completion_snapshot_payload)
say "completion-snapshot-bytes=" + word_from_int(v4_completion_snapshot_payload.length())
say v4_completion_snapshot_completion_line(v4_completion_snapshot_id)
say v4_completion_snapshot_item_line(v4_completion_snapshot_id, v4_completion_snapshot_salute)
say v4_parse_snapshot_restore(v4_parse_snapshot())
say v4_hir_snapshot_restore(v4_hir_snapshot())
say v4_resolve_snapshot_restore(v4_resolve_snapshot())
say v4_ty_snapshot_restore(v4_ty_snapshot())
say v4_document_symbols_snapshot_restore(v4_document_symbols_snapshot())
say v4_completion_snapshot_restore(v4_completion_snapshot_payload)
say v4_lsp_completion_snapshot_text()
say v4_lsp_completion_snapshot_restore_text(v4_completion_snapshot_payload)
say v4_lsp_handle_text_request("workspace/completionSnapshotRestore", "completion-snapshot.fk", v4_completion_snapshot_payload, 0)

pilot v4_completion_query_payload = v4_query_snapshot()
say v4_query_snapshot_restore(v4_completion_query_payload)
say v4_driver_confirm_restored_document_text("completion-snapshot.fk", v4_completion_snapshot_source)
pilot v4_completion_file = v4_source_find("completion-snapshot.fk")
pilot v4_completion_fingerprint = v4_source_fingerprint(v4_completion_file)
pilot v4_completion_global_restored_id = word_to_int(v4_query_get(v4_completion_query_key("completion-snapshot.fk", v4_completion_snapshot_global_offset), v4_completion_fingerprint))
pilot v4_completion_restored_id = word_to_int(v4_query_get(v4_completion_query_key("completion-snapshot.fk", v4_completion_snapshot_offset), v4_completion_fingerprint))
pilot v4_completion_restored_event = v4_completion_snapshot_find_label(v4_completion_global_restored_id, "Event")
pilot v4_completion_restored_event_key = v4_completion_snapshot_find_label(v4_completion_global_restored_id, "Event::Key")
pilot v4_completion_restored_uint = v4_completion_snapshot_find_label(v4_completion_global_restored_id, "uint")
pilot v4_completion_restored_float32 = v4_completion_snapshot_find_label(v4_completion_global_restored_id, "float32")
pilot v4_completion_restored_salute = v4_completion_snapshot_find_label(v4_completion_restored_id, "salute")
pilot v4_completion_restored_pack = v4_completion_snapshot_find_label(v4_completion_restored_id, "pack")
say v4_completion_summary(v4_completion_restored_id)
say "completion-snapshot-event-found=" + v4_completion_snapshot_bool_word(v4_completion_snapshot_event >= 0)
say "completion-snapshot-event-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_snapshot_global_id, v4_completion_snapshot_event)
say "completion-snapshot-event-key-found=" + v4_completion_snapshot_bool_word(v4_completion_snapshot_event_key >= 0)
say "completion-snapshot-event-key-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_snapshot_global_id, v4_completion_snapshot_event_key)
say "completion-snapshot-uint-found=" + v4_completion_snapshot_bool_word(v4_completion_snapshot_uint >= 0)
say "completion-snapshot-uint-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_snapshot_global_id, v4_completion_snapshot_uint)
say "completion-snapshot-float32-found=" + v4_completion_snapshot_bool_word(v4_completion_snapshot_float32 >= 0)
say "completion-snapshot-float32-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_snapshot_global_id, v4_completion_snapshot_float32)
say "completion-snapshot-salute-found=" + v4_completion_snapshot_bool_word(v4_completion_snapshot_salute >= 0)
say "completion-snapshot-salute-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_snapshot_id, v4_completion_snapshot_salute)
say "completion-snapshot-pack-found=" + v4_completion_snapshot_bool_word(v4_completion_snapshot_pack >= 0)
say "completion-snapshot-restored-event-found=" + v4_completion_snapshot_bool_word(v4_completion_restored_event >= 0)
say "completion-snapshot-restored-event-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_global_restored_id, v4_completion_restored_event)
say "completion-snapshot-restored-event-key-found=" + v4_completion_snapshot_bool_word(v4_completion_restored_event_key >= 0)
say "completion-snapshot-restored-event-key-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_global_restored_id, v4_completion_restored_event_key)
say "completion-snapshot-restored-uint-found=" + v4_completion_snapshot_bool_word(v4_completion_restored_uint >= 0)
say "completion-snapshot-restored-uint-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_global_restored_id, v4_completion_restored_uint)
say "completion-snapshot-restored-float32-found=" + v4_completion_snapshot_bool_word(v4_completion_restored_float32 >= 0)
say "completion-snapshot-restored-float32-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_global_restored_id, v4_completion_restored_float32)
say "completion-snapshot-restored-salute-found=" + v4_completion_snapshot_bool_word(v4_completion_restored_salute >= 0)
say "completion-snapshot-restored-salute-detail=" + v4_completion_snapshot_detail_or_empty(v4_completion_restored_id, v4_completion_restored_salute)
say "completion-snapshot-restored-pack-found=" + v4_completion_snapshot_bool_word(v4_completion_restored_pack >= 0)
say v4_driver_confirm_restored_document_text("completion-snapshot.fk", "task changed() => 7\n")
