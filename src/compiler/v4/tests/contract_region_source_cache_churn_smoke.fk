pilot v4_contract_region_source_cache_churn_empty_builds_after_second = v4_ty_borrowed_return_source_cache_build_count()

pilot v4_contract_region_source_cache_churn_first_sig_def = v4_ty_signature_def(v4_contract_region_source_cache_churn_ty, v4_contract_region_source_cache_churn_first_sig)
pilot v4_contract_region_source_cache_churn_first_sig_kind = v4_ty_signature_kind(v4_contract_region_source_cache_churn_ty, v4_contract_region_source_cache_churn_first_sig)
pilot v4_contract_region_source_cache_churn_first_sig_name = v4_ty_signature_name(v4_contract_region_source_cache_churn_ty, v4_contract_region_source_cache_churn_first_sig)
