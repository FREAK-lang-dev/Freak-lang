    out = out + "|" + v4_definition_snapshot_escape(v4_definition_at_path(defn_id))
    out = out + "|" + word_from_int(v4_definition_at_offset(defn_id))
    out = out + "|" + word_from_int(v4_definition_at_semantic_id(defn_id))
    out = out + "|" + v4_definition_snapshot_escape(v4_definition_at_name(defn_id))
    out = out + "|" + v4_definition_snapshot_escape(v4_definition_at_kind(defn_id))
