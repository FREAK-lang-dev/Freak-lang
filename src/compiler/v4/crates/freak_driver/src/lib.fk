    }

    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_lower_resolve(file_id, resolve_id)
    v4_query_store(key, fingerprint, word_from_int(ty_id))
    v4_query_record_dep(key, v4_resolve_query_key(path))
