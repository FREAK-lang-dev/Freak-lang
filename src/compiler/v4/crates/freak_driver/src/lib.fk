task v4_semantic_snapshot_summary() -> word {
    pilot summary = "semantic-snapshot"
    summary = summary + " format=" + v4_semantic_snapshot_format
    summary = summary + " facts=" + word_from_int(v4_semantic_fact_count())
    give back summary
}

task v4_semantic_snapshot_header() -> word {
    pilot out = "semantic-snapshot"
    out = out + "|format=" + v4_semantic_snapshot_format
    out = out + "|facts=" + word_from_int(v4_semantic_fact_count())
    give back out
}

task v4_semantic_snapshot_fact_line(fact_id: int) -> word {
    pilot out = "semantic"
    out = out + "|" + word_from_int(fact_id)
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_path(fact_id))
    out = out + "|" + word_from_int(v4_semantic_at_offset(fact_id))
    out = out + "|" + word_from_int(v4_semantic_at_token_id(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_token_kind(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_token_value(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_token_span(fact_id))
    out = out + "|" + word_from_int(v4_semantic_at_hir_item(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_item_name(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_item_kind(fact_id))
    out = out + "|" + word_from_int(v4_semantic_at_symbol_id(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_name(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_kind(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_def(fact_id))
    out = out + "|" + v4_semantic_snapshot_escape(v4_semantic_at_type(fact_id))
    give back out
}

task v4_semantic_snapshot() -> word {
    v4_driver_init()
    pilot out = v4_semantic_snapshot_header()
    pilot fact_id = 0
    pilot fact_count = v4_semantic_fact_count()
    repeat until fact_id >= fact_count {
        out = out + "\n" + v4_semantic_snapshot_fact_line(fact_id)
        fact_id += 1
    }
    out = out + "\nend|" + v4_semantic_snapshot_format
    give back out
}

task v4_semantic_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "semantic-snapshot" { give back 3 }
    if kind == "semantic" { give back 16 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_semantic_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_semantic_snapshot_field_raw(line, 0)
    pilot expected = v4_semantic_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_semantic_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_semantic_snapshot_validate(payload: word) -> word {
    pilot lines = v4_semantic_snapshot_line_count(payload)
    pilot facts = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_semantic_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_semantic_snapshot_field_raw(line, 0)
            if v4_semantic_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "semantic-snapshot" {
                saw_header += 1
                format = v4_semantic_snapshot_key_value(line, "format")
                if format != v4_semantic_snapshot_format {
                    malformed += 1
                }
            } else if kind == "semantic" {
                facts += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_semantic_snapshot_field(line, 1) != v4_semantic_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "semantic-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " facts=" + word_from_int(facts)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_semantic_restore_fact_slot(fact_id: int, path: word, offset: int, token_id: int, token_kind: word, token_value: word, token_span: word, hir_item: int, item_name: word, item_kind: word, symbol_id: int, name: word, kind: word, def_id: word, type_display: word) -> int {
    v4_driver_init()
    repeat until array_len(v4_driver_sem_paths) > fact_id {
        v4_driver_semantic_fact_new("", 0, 0 - 1, "", "", V4_NO_SPAN, 0 - 1, "", "", 0 - 1, "", "", "", v4_ty_unknown)
    }

    array_set(v4_driver_sem_paths, fact_id, path)
    array_set(v4_driver_sem_offsets, fact_id, word_from_int(offset))
    array_set(v4_driver_sem_token_ids, fact_id, word_from_int(token_id))
    array_set(v4_driver_sem_token_kinds, fact_id, token_kind)
    array_set(v4_driver_sem_token_values, fact_id, token_value)
    array_set(v4_driver_sem_token_spans, fact_id, token_span)
    array_set(v4_driver_sem_hir_items, fact_id, word_from_int(hir_item))
    array_set(v4_driver_sem_item_names, fact_id, item_name)
    array_set(v4_driver_sem_item_kinds, fact_id, item_kind)
    array_set(v4_driver_sem_symbol_ids, fact_id, word_from_int(symbol_id))
    array_set(v4_driver_sem_names, fact_id, name)
    array_set(v4_driver_sem_kinds, fact_id, kind)
    array_set(v4_driver_sem_defs, fact_id, def_id)
    array_set(v4_driver_sem_types, fact_id, type_display)
    give back 1
}

task v4_semantic_snapshot_restore_fact_line(line: word) -> int {
    if v4_semantic_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_semantic_snapshot_field_raw(line, 0) != "semantic" { give back 0 }
    pilot fact_id = word_to_int(v4_semantic_snapshot_field_raw(line, 1))
    pilot path = v4_semantic_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_semantic_snapshot_field_raw(line, 3))
    pilot token_id = word_to_int(v4_semantic_snapshot_field_raw(line, 4))
    pilot token_kind = v4_semantic_snapshot_field(line, 5)
    pilot token_value = v4_semantic_snapshot_field(line, 6)
    pilot token_span = v4_semantic_snapshot_field(line, 7)
    pilot hir_item = word_to_int(v4_semantic_snapshot_field_raw(line, 8))
    pilot item_name = v4_semantic_snapshot_field(line, 9)
    pilot item_kind = v4_semantic_snapshot_field(line, 10)
    pilot symbol_id = word_to_int(v4_semantic_snapshot_field_raw(line, 11))
    pilot name = v4_semantic_snapshot_field(line, 12)
    pilot kind = v4_semantic_snapshot_field(line, 13)
    pilot def_id = v4_semantic_snapshot_field(line, 14)
    pilot type_display = v4_semantic_snapshot_field(line, 15)
    give back v4_semantic_restore_fact_slot(fact_id, path, offset, token_id, token_kind, token_value, token_span, hir_item, item_name, item_kind, symbol_id, name, kind, def_id, type_display)
}

task v4_semantic_snapshot_restore(payload: word) -> word {
    pilot validation = v4_semantic_snapshot_validate(payload)
    if validation.starts_with("semantic-snapshot-import ok=1") == false {
        give back "semantic-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_facts = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_semantic_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_semantic_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_semantic_snapshot_field_raw(line, 0)
            if kind == "semantic" {
                restored_facts += v4_semantic_snapshot_restore_fact_line(line)
            } else if kind != "semantic-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "semantic-snapshot-restore ok=1"
    out = out + " facts=" + word_from_int(restored_facts)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-facts=" + word_from_int(v4_semantic_fact_count())
    give back out
}

task v4_semantic_at_text_cached(path: word, text: word, offset: int) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_semantic_at_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot token_id = v4_driver_token_at(stream_id, offset)
    pilot token_kind = ""
    pilot token_value = ""
    pilot token_span = V4_NO_SPAN
    if token_id >= 0 {
        token_kind = v4_lex_token_type(stream_id, token_id)
        token_value = v4_lex_token_value(stream_id, token_id)
        token_span = v4_lex_token_span(stream_id, token_id)
    }

    pilot hir_item = v4_driver_hir_item_at(hir_id, offset)
    pilot item_name = ""
    pilot item_kind = ""
    if hir_item >= 0 {
        item_name = v4_hir_item_name(hir_id, hir_item)
        item_kind = v4_hir_item_kind(hir_id, hir_item)
    }

    pilot symbol_id = 0 - 1
    if token_value != "" {
        symbol_id = v4_resolve_lookup_any(resolve_id, token_value)
    }

    pilot name = token_value
    pilot kind = token_kind
    pilot def_id = ""
    pilot type_display = v4_ty_unknown
    if symbol_id >= 0 {
        name = v4_resolve_symbol_name(resolve_id, symbol_id)
        kind = v4_resolve_symbol_kind(resolve_id, symbol_id)
        def_id = v4_resolve_symbol_def(resolve_id, symbol_id)
        pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
        if sig_id >= 0 {
            type_display = v4_ty_signature_display(ty_id, sig_id)
        }
    } else if token_value == item_name and hir_item >= 0 {
        name = item_name
        kind = item_kind
        def_id = v4_hir_item_def(hir_id, hir_item)
        pilot item_sig_id = v4_driver_ty_signature_for_hir_item(ty_id, hir_item)
        if item_sig_id >= 0 {
            type_display = v4_ty_signature_display(ty_id, item_sig_id)
        }
    }

    pilot fact_id = v4_driver_semantic_fact_new(path, offset, token_id, token_kind, token_value, token_span, hir_item, item_name, item_kind, symbol_id, name, kind, def_id, type_display)
    v4_query_store(key, fingerprint, word_from_int(fact_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    give back fact_id
}

task v4_semantic_at_text(path: word, text: word, offset: int) -> word {
    pilot fact_id = v4_semantic_at_text_cached(path, text, offset)
    give back v4_semantic_at_summary(fact_id)
}

task v4_semantic_at_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_semantic_at_text(path, text, offset)
}

task v4_driver_hover_new(path: word, offset: int, semantic_id: int, name: word, kind: word, type_display: word, markdown: word) -> int {
    v4_driver_init()
    pilot hover_id = array_len(v4_driver_hover_paths)
    array_push(v4_driver_hover_paths, path)
    array_push(v4_driver_hover_offsets, word_from_int(offset))
    array_push(v4_driver_hover_semantic_ids, word_from_int(semantic_id))
    array_push(v4_driver_hover_names, name)
    array_push(v4_driver_hover_kinds, kind)
    array_push(v4_driver_hover_types, type_display)
    array_push(v4_driver_hover_markdowns, markdown)
    give back hover_id
}

task v4_hover_count() -> int {
    v4_driver_init()
    give back array_len(v4_driver_hover_paths)
}

task v4_hover_exists(hover_id: int) -> bool {
    v4_driver_init()
    if hover_id < 0 {
        give back false
    }
    if hover_id >= array_len(v4_driver_hover_paths) {
        give back false
    }
    give back true
}

task v4_hover_path(hover_id: int) -> word {
