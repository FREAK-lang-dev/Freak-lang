task v4_definition_at_text_cached(path: word, text: word, offset: int) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_definition_at_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot semantic_id = v4_semantic_at_text_cached(path, text, offset)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot name = v4_semantic_at_name(semantic_id)
    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot def_id = v4_semantic_at_def(semantic_id)
    pilot hir_item = 0 - 1
    pilot span = V4_NO_SPAN
    pilot found = 0

    if def_id != "" {
        hir_item = v4_driver_hir_item_for_def(hir_id, def_id)
        if hir_item >= 0 {
            span = v4_hir_item_span(hir_id, hir_item)
            found = 1
        }
    }

    pilot defn_id = v4_driver_definition_new(path, offset, semantic_id, name, kind, def_id, hir_item, span, found)
    v4_query_store(key, fingerprint, word_from_int(defn_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_semantic_at_query_key(path, offset))
    v4_query_record_dep(key, v4_hir_query_key(path))
    give back defn_id
}

task v4_definition_at_text(path: word, text: word, offset: int) -> word {
    pilot defn_id = v4_definition_at_text_cached(path, text, offset)
    give back v4_definition_at_summary(defn_id)
}

task v4_definition_at_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_definition_at_text(path, text, offset)
}

task v4_check_syntax_text(path: word, text: word) -> word {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_check_syntax_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back cached
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot tree_id = v4_parse_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot borrow_id = v4_borrowck_text_cached(path, text)
    pilot diagnostics_id = v4_diagnostics_text_cached(path, text)
    pilot lines = v4_line_count(text)
    pilot syntax_summary = "syntax-ok file=" + word_from_int(file_id)
    syntax_summary = syntax_summary + " rev=" + word_from_int(v4_source_revision(file_id))
    syntax_summary = syntax_summary + " lines=" + word_from_int(lines)
    syntax_summary = syntax_summary + " bytes=" + word_from_int(text.length())
    syntax_summary = syntax_summary + " tokens=" + word_from_int(v4_lex_token_count(stream_id))
    syntax_summary = syntax_summary + " lex-diagnostics=" + word_from_int(v4_lex_diag_count(stream_id))
    syntax_summary = syntax_summary + " parse-nodes=" + word_from_int(v4_parse_node_count(tree_id))
    syntax_summary = syntax_summary + " parse-diagnostics=" + word_from_int(v4_parse_diag_count(tree_id))
    syntax_summary = syntax_summary + " hir-items=" + word_from_int(v4_hir_item_count(hir_id))
    syntax_summary = syntax_summary + " hir-diagnostics=" + word_from_int(v4_hir_diag_count(hir_id))
    syntax_summary = syntax_summary + " symbols=" + word_from_int(v4_resolve_symbol_count(resolve_id))
    syntax_summary = syntax_summary + " resolve-diagnostics=" + word_from_int(v4_resolve_diag_count(resolve_id))
    syntax_summary = syntax_summary + " signatures=" + word_from_int(v4_ty_signature_count(ty_id))
    syntax_summary = syntax_summary + " ty-diagnostics=" + word_from_int(v4_ty_diag_count(ty_id))
    syntax_summary = syntax_summary + " mir-bodies=" + word_from_int(v4_mir_body_count(mir_id))
    syntax_summary = syntax_summary + " mir-diagnostics=" + word_from_int(v4_mir_diag_count(mir_id))
    syntax_summary = syntax_summary + " borrow-results=" + word_from_int(v4_borrowck_result_count(borrow_id))
    syntax_summary = syntax_summary + " borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(borrow_id))
    syntax_summary = syntax_summary + " diagnostics=" + word_from_int(v4_diagnostics_count(diagnostics_id))

    v4_query_store(key, fingerprint, syntax_summary)
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_parse_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    v4_query_record_dep(key, v4_borrowck_query_key(path))
    v4_query_record_dep(key, v4_diagnostics_query_key(path))
    give back syntax_summary
}

task v4_check_syntax_file(path: word) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_check_syntax_text(path, text)
}

task v4_driver_status() -> word {
    v4_driver_init()
    pilot status = "freakc_v4 " + FREAKC_V4_VERSION + " (" + FREAKC_V4_CODENAME + ")"
    status = status + " queries=" + word_from_int(v4_query_cache_size())
    status = status + " deps=" + word_from_int(v4_query_dep_count())
    give back status
}
