task v4_hover_markdown(hover_id: int) -> word {
    give back array_get(v4_driver_hover_markdowns, hover_id)
}

task v4_hover_markdown_for_semantic(semantic_id: int) -> word {
    pilot name = v4_semantic_at_name(semantic_id)
    if name == "" {
        give back ""
    }

    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot type_display = v4_semantic_at_type(semantic_id)
    pilot item_name = v4_semantic_at_item_name(semantic_id)
    pilot item_kind = v4_semantic_at_item_kind(semantic_id)
    pilot markdown = "**" + name + "**"
    if kind != "" {
        markdown = markdown + " `" + kind + "`"
    }
    if type_display != "" and type_display != v4_ty_unknown {
        markdown = markdown + "\n\n```freak\n" + type_display + "\n```"
    } else {
        markdown = markdown + "\n\n`type: unknown`"
    }
    if item_name != "" {
        markdown = markdown + "\n\nin " + item_kind + " `" + item_name + "`"
    }
    markdown = markdown + "\n\nYuuko cache: hover <- semantic-at <- 00-Unit."
    give back markdown
}

task v4_hover_summary(hover_id: int) -> word {
    pilot summary = "hover id=" + word_from_int(hover_id)
    summary = summary + " path=" + v4_hover_path(hover_id)
    summary = summary + " offset=" + word_from_int(v4_hover_offset(hover_id))
    summary = summary + " semantic=" + word_from_int(v4_hover_semantic_id(hover_id))
    summary = summary + " name=" + v4_hover_name(hover_id)
    summary = summary + " kind=" + v4_hover_kind(hover_id)
    summary = summary + " type=" + v4_hover_type(hover_id)
    summary = summary + " markdown-bytes=" + word_from_int(v4_hover_markdown(hover_id).length())
    give back summary
}

