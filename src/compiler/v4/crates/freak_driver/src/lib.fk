task v4_definition_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "definition-snapshot" { give back 3 }
    if kind == "definition" { give back 11 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_definition_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_definition_snapshot_field_raw(line, 0)
    pilot expected = v4_definition_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_definition_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_definition_snapshot_validate(payload: word) -> word {
    pilot lines = v4_definition_snapshot_line_count(payload)
    pilot definitions = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_definition_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_definition_snapshot_field_raw(line, 0)
            if v4_definition_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "definition-snapshot" {
                saw_header += 1
                format = v4_definition_snapshot_key_value(line, "format")
                if format != v4_definition_snapshot_format {
                    malformed += 1
                }
            } else if kind == "definition" {
                definitions += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_definition_snapshot_field(line, 1) != v4_definition_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "definition-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " definitions=" + word_from_int(definitions)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_definition_restore_slot(defn_id: int, path: word, offset: int, semantic_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, found: int) -> int {
    v4_driver_init()
    repeat until array_len(v4_driver_defn_paths) > defn_id {
        v4_driver_definition_new("", 0, 0 - 1, "", "", "", 0 - 1, V4_NO_SPAN, 0)
    }

    array_set(v4_driver_defn_paths, defn_id, path)
    array_set(v4_driver_defn_offsets, defn_id, word_from_int(offset))
    array_set(v4_driver_defn_semantic_ids, defn_id, word_from_int(semantic_id))
    array_set(v4_driver_defn_names, defn_id, name)
    array_set(v4_driver_defn_kinds, defn_id, kind)
    array_set(v4_driver_defn_defs, defn_id, def_id)
    array_set(v4_driver_defn_hir_items, defn_id, word_from_int(hir_item))
    array_set(v4_driver_defn_spans, defn_id, span)
    array_set(v4_driver_defn_found, defn_id, word_from_int(found))
    give back 1
}

task v4_definition_snapshot_restore_definition_line(line: word) -> int {
    if v4_definition_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_definition_snapshot_field_raw(line, 0) != "definition" { give back 0 }
    pilot defn_id = word_to_int(v4_definition_snapshot_field_raw(line, 1))
    pilot path = v4_definition_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_definition_snapshot_field_raw(line, 3))
    pilot semantic_id = word_to_int(v4_definition_snapshot_field_raw(line, 4))
    pilot name = v4_definition_snapshot_field(line, 5)
    pilot kind = v4_definition_snapshot_field(line, 6)
    pilot def_id = v4_definition_snapshot_field(line, 7)
    pilot hir_item = word_to_int(v4_definition_snapshot_field_raw(line, 8))
    pilot span = v4_definition_snapshot_field(line, 9)
    pilot found = word_to_int(v4_definition_snapshot_field_raw(line, 10))
    give back v4_definition_restore_slot(defn_id, path, offset, semantic_id, name, kind, def_id, hir_item, span, found)
}

task v4_definition_snapshot_restore(payload: word) -> word {
    pilot validation = v4_definition_snapshot_validate(payload)
    if validation.starts_with("definition-snapshot-import ok=1") == false {
        give back "definition-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_definitions = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_definition_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_definition_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_definition_snapshot_field_raw(line, 0)
            if kind == "definition" {
                restored_definitions += v4_definition_snapshot_restore_definition_line(line)
            } else if kind != "definition-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "definition-snapshot-restore ok=1"
    out = out + " definitions=" + word_from_int(restored_definitions)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-definitions=" + word_from_int(v4_definition_at_count())
    give back out
}

task v4_definition_at_text_cached(path: word, text: word, offset: int) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_definition_at_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot semantic_id = v4_semantic_at_text_cached(path, text, offset)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot name = v4_semantic_at_name(semantic_id)
    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot def_id = v4_semantic_at_def(semantic_id)
    pilot hir_item = 0 - 1
    pilot span = V4_NO_SPAN
    pilot found = 0

    if def_id != "" {
        hir_item = v4_driver_hir_item_for_def(hir_id, def_id)
        if hir_item >= 0 {
            span = v4_hir_item_span(hir_id, hir_item)
            found = 1
        }
    }

    pilot defn_id = v4_driver_definition_new(path, offset, semantic_id, name, kind, def_id, hir_item, span, found)
    v4_query_store(key, fingerprint, word_from_int(defn_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_semantic_at_query_key(path, offset))
    v4_query_record_dep(key, v4_hir_query_key(path))
    give back defn_id
}

task v4_definition_at_text(path: word, text: word, offset: int) -> word {
    pilot defn_id = v4_definition_at_text_cached(path, text, offset)
    give back v4_definition_at_summary(defn_id)
}

task v4_definition_at_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_definition_at_text(path, text, offset)
}

task v4_driver_document_symbols_new(path: word) -> int {
    v4_driver_init()
    pilot doc_id = array_len(v4_driver_doc_paths)
    array_push(v4_driver_doc_paths, path)
    array_push(v4_driver_doc_names, word_from_int(array_new()))
    array_push(v4_driver_doc_kinds, word_from_int(array_new()))
    array_push(v4_driver_doc_defs, word_from_int(array_new()))
    array_push(v4_driver_doc_hir_items, word_from_int(array_new()))
    array_push(v4_driver_doc_spans, word_from_int(array_new()))
    array_push(v4_driver_doc_types, word_from_int(array_new()))
    give back doc_id
}

task v4_document_symbols_count() -> int {
    v4_driver_init()
    give back array_len(v4_driver_doc_paths)
}

task v4_document_symbols_exists(doc_id: int) -> bool {
    v4_driver_init()
    if doc_id < 0 {
        give back false
    }
    if doc_id >= array_len(v4_driver_doc_paths) {
        give back false
    }
    give back true
}

task v4_document_symbols_path(doc_id: int) -> word {
    if v4_document_symbols_exists(doc_id) == false {
        give back ""
    }
    give back array_get(v4_driver_doc_paths, doc_id)
}

task v4_driver_doc_names_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_names, doc_id))
}

task v4_driver_doc_kinds_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_kinds, doc_id))
}

task v4_driver_doc_defs_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_defs, doc_id))
}

task v4_driver_doc_hir_items_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_hir_items, doc_id))
}

task v4_driver_doc_spans_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_spans, doc_id))
}

task v4_driver_doc_types_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_types, doc_id))
}

task v4_document_symbols_add(doc_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, type_display: word) -> int {
    pilot symbol_id = array_len(v4_driver_doc_names_handle(doc_id))
    array_push(v4_driver_doc_names_handle(doc_id), name)
    array_push(v4_driver_doc_kinds_handle(doc_id), kind)
    array_push(v4_driver_doc_defs_handle(doc_id), def_id)
    array_push(v4_driver_doc_hir_items_handle(doc_id), word_from_int(hir_item))
    array_push(v4_driver_doc_spans_handle(doc_id), span)
    array_push(v4_driver_doc_types_handle(doc_id), type_display)
    give back symbol_id
}

task v4_document_symbol_count(doc_id: int) -> int {
    give back array_len(v4_driver_doc_names_handle(doc_id))
}

task v4_document_symbol_name(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_driver_doc_names_handle(doc_id), symbol_id)
}

task v4_document_symbol_kind(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_driver_doc_kinds_handle(doc_id), symbol_id)
}

task v4_document_symbol_def(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_driver_doc_defs_handle(doc_id), symbol_id)
}

task v4_document_symbol_hir_item(doc_id: int, symbol_id: int) -> int {
    give back word_to_int(array_get(v4_driver_doc_hir_items_handle(doc_id), symbol_id))
}

task v4_document_symbol_span(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_driver_doc_spans_handle(doc_id), symbol_id)
}

task v4_document_symbol_type(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_driver_doc_types_handle(doc_id), symbol_id)
}

task v4_document_symbols_summary(doc_id: int) -> word {
    pilot summary = "document-symbols id=" + word_from_int(doc_id)
    summary = summary + " path=" + v4_document_symbols_path(doc_id)
    summary = summary + " count=" + word_from_int(v4_document_symbol_count(doc_id))
    if v4_document_symbol_count(doc_id) > 0 {
        summary = summary + " first=" + v4_document_symbol_name(doc_id, 0)
        summary = summary + " first-kind=" + v4_document_symbol_kind(doc_id, 0)
    }
    give back summary
}

task v4_document_symbols_snapshot_escape(value: word) -> word {
    give back v4_definition_snapshot_escape(value)
}

task v4_document_symbols_snapshot_unescape(value: word) -> word {
    give back v4_definition_snapshot_unescape(value)
}

task v4_document_symbols_snapshot_line_count(payload: word) -> int {
    give back v4_definition_snapshot_line_count(payload)
}

task v4_document_symbols_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_definition_snapshot_line(payload, wanted)
}

task v4_document_symbols_snapshot_field_count(line: word) -> int {
    give back v4_definition_snapshot_field_count(line)
}

task v4_document_symbols_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_definition_snapshot_field_raw(line, wanted)
}

task v4_document_symbols_snapshot_field(line: word, wanted: int) -> word {
    give back v4_definition_snapshot_field(line, wanted)
}

task v4_document_symbols_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_definition_snapshot_key_value(line, wanted_key)
}

task v4_document_symbols_snapshot_symbol_total() -> int {
    v4_driver_init()
    pilot total = 0
    pilot doc_id = 0
    repeat until doc_id >= v4_document_symbols_count() {
        total += v4_document_symbol_count(doc_id)
        doc_id += 1
    }
    give back total
}

task v4_document_symbols_snapshot_summary() -> word {
    pilot summary = "document-symbols-snapshot"
    summary = summary + " format=" + v4_document_symbols_snapshot_format
    summary = summary + " documents=" + word_from_int(v4_document_symbols_count())
    summary = summary + " symbols=" + word_from_int(v4_document_symbols_snapshot_symbol_total())
    give back summary
}

task v4_document_symbols_snapshot_header() -> word {
    pilot out = "document-symbols-snapshot"
    out = out + "|format=" + v4_document_symbols_snapshot_format
    out = out + "|documents=" + word_from_int(v4_document_symbols_count())
    out = out + "|symbols=" + word_from_int(v4_document_symbols_snapshot_symbol_total())
    give back out
}

task v4_document_symbols_snapshot_document_line(doc_id: int) -> word {
    pilot out = "document-symbols"
    out = out + "|" + word_from_int(doc_id)
    out = out + "|" + v4_document_symbols_snapshot_escape(v4_document_symbols_path(doc_id))
    out = out + "|" + word_from_int(v4_document_symbol_count(doc_id))
    give back out
}

task v4_document_symbols_snapshot_symbol_line(doc_id: int, symbol_id: int) -> word {
    pilot out = "document-symbol"
    out = out + "|" + word_from_int(doc_id)
    out = out + "|" + word_from_int(symbol_id)
    out = out + "|" + v4_document_symbols_snapshot_escape(v4_document_symbol_name(doc_id, symbol_id))
    out = out + "|" + v4_document_symbols_snapshot_escape(v4_document_symbol_kind(doc_id, symbol_id))
    out = out + "|" + v4_document_symbols_snapshot_escape(v4_document_symbol_def(doc_id, symbol_id))
    out = out + "|" + word_from_int(v4_document_symbol_hir_item(doc_id, symbol_id))
    out = out + "|" + v4_document_symbols_snapshot_escape(v4_document_symbol_span(doc_id, symbol_id))
    out = out + "|" + v4_document_symbols_snapshot_escape(v4_document_symbol_type(doc_id, symbol_id))
    give back out
}

task v4_document_symbols_snapshot() -> word {
    v4_driver_init()
    pilot out = v4_document_symbols_snapshot_header()
    pilot doc_id = 0
    pilot doc_count = v4_document_symbols_count()
    repeat until doc_id >= doc_count {
        out = out + "\n" + v4_document_symbols_snapshot_document_line(doc_id)
        pilot symbol_id = 0
        pilot symbol_count = v4_document_symbol_count(doc_id)
        repeat until symbol_id >= symbol_count {
            out = out + "\n" + v4_document_symbols_snapshot_symbol_line(doc_id, symbol_id)
            symbol_id += 1
        }
        doc_id += 1
    }
    out = out + "\nend|" + v4_document_symbols_snapshot_format
    give back out
}

task v4_document_symbols_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "document-symbols-snapshot" { give back 4 }
    if kind == "document-symbols" { give back 4 }
    if kind == "document-symbol" { give back 9 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_document_symbols_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_document_symbols_snapshot_field_raw(line, 0)
    pilot expected = v4_document_symbols_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_document_symbols_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_document_symbols_snapshot_validate(payload: word) -> word {
    pilot lines = v4_document_symbols_snapshot_line_count(payload)
    pilot documents = 0
    pilot symbols = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_document_symbols_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_document_symbols_snapshot_field_raw(line, 0)
            if v4_document_symbols_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "document-symbols-snapshot" {
                saw_header += 1
                format = v4_document_symbols_snapshot_key_value(line, "format")
                if format != v4_document_symbols_snapshot_format {
                    malformed += 1
                }
            } else if kind == "document-symbols" {
                documents += 1
            } else if kind == "document-symbol" {
                symbols += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_document_symbols_snapshot_field(line, 1) != v4_document_symbols_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "document-symbols-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " documents=" + word_from_int(documents)
    out = out + " symbols=" + word_from_int(symbols)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_document_symbols_restore_document_slot(doc_id: int, path: word) -> int {
    v4_driver_init()
    repeat until array_len(v4_driver_doc_paths) > doc_id {
        v4_driver_document_symbols_new("")
    }

    array_set(v4_driver_doc_paths, doc_id, path)
    array_set(v4_driver_doc_names, doc_id, word_from_int(array_new()))
    array_set(v4_driver_doc_kinds, doc_id, word_from_int(array_new()))
    array_set(v4_driver_doc_defs, doc_id, word_from_int(array_new()))
    array_set(v4_driver_doc_hir_items, doc_id, word_from_int(array_new()))
    array_set(v4_driver_doc_spans, doc_id, word_from_int(array_new()))
    array_set(v4_driver_doc_types, doc_id, word_from_int(array_new()))
    give back 1
}

task v4_document_symbols_restore_symbol_slot(doc_id: int, symbol_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, type_display: word) -> int {
    if v4_document_symbols_exists(doc_id) == false {
        give back 0
    }
    repeat until v4_document_symbol_count(doc_id) > symbol_id {
        v4_document_symbols_add(doc_id, "", "", "", 0 - 1, V4_NO_SPAN, v4_ty_unknown)
    }

    array_set(v4_driver_doc_names_handle(doc_id), symbol_id, name)
    array_set(v4_driver_doc_kinds_handle(doc_id), symbol_id, kind)
    array_set(v4_driver_doc_defs_handle(doc_id), symbol_id, def_id)
    array_set(v4_driver_doc_hir_items_handle(doc_id), symbol_id, word_from_int(hir_item))
    array_set(v4_driver_doc_spans_handle(doc_id), symbol_id, span)
    array_set(v4_driver_doc_types_handle(doc_id), symbol_id, type_display)
    give back 1
}

task v4_document_symbols_snapshot_restore_document_line(line: word) -> int {
    if v4_document_symbols_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_document_symbols_snapshot_field_raw(line, 0) != "document-symbols" { give back 0 }
    pilot doc_id = word_to_int(v4_document_symbols_snapshot_field_raw(line, 1))
    pilot path = v4_document_symbols_snapshot_field(line, 2)
    give back v4_document_symbols_restore_document_slot(doc_id, path)
}

task v4_document_symbols_snapshot_restore_symbol_line(line: word) -> int {
    if v4_document_symbols_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_document_symbols_snapshot_field_raw(line, 0) != "document-symbol" { give back 0 }
    pilot doc_id = word_to_int(v4_document_symbols_snapshot_field_raw(line, 1))
    pilot symbol_id = word_to_int(v4_document_symbols_snapshot_field_raw(line, 2))
    pilot name = v4_document_symbols_snapshot_field(line, 3)
    pilot kind = v4_document_symbols_snapshot_field(line, 4)
    pilot def_id = v4_document_symbols_snapshot_field(line, 5)
    pilot hir_item = word_to_int(v4_document_symbols_snapshot_field_raw(line, 6))
    pilot span = v4_document_symbols_snapshot_field(line, 7)
    pilot type_display = v4_document_symbols_snapshot_field(line, 8)
    give back v4_document_symbols_restore_symbol_slot(doc_id, symbol_id, name, kind, def_id, hir_item, span, type_display)
}

task v4_document_symbols_snapshot_restore(payload: word) -> word {
    pilot validation = v4_document_symbols_snapshot_validate(payload)
    if validation.starts_with("document-symbols-snapshot-import ok=1") == false {
        give back "document-symbols-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_documents = 0
    pilot restored_symbols = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_document_symbols_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_document_symbols_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_document_symbols_snapshot_field_raw(line, 0)
            if kind == "document-symbols" {
                restored_documents += v4_document_symbols_snapshot_restore_document_line(line)
            } else if kind == "document-symbol" {
                restored_symbols += v4_document_symbols_snapshot_restore_symbol_line(line)
            } else if kind != "document-symbols-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "document-symbols-snapshot-restore ok=1"
    out = out + " documents=" + word_from_int(restored_documents)
    out = out + " symbols=" + word_from_int(restored_symbols)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-documents=" + word_from_int(v4_document_symbols_count())
    give back out
}

task v4_document_symbols_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_document_symbols_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot doc_id = v4_driver_document_symbols_new(path)
    pilot symbol_id = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    repeat until symbol_id >= symbol_count {
        pilot name = v4_resolve_symbol_name(resolve_id, symbol_id)
        pilot kind = v4_resolve_symbol_kind(resolve_id, symbol_id)
        pilot def_id = v4_resolve_symbol_def(resolve_id, symbol_id)
        pilot hir_item = v4_resolve_symbol_hir_item(resolve_id, symbol_id)
        pilot span = V4_NO_SPAN
        if hir_item >= 0 {
            span = v4_hir_item_span(hir_id, hir_item)
        }
        pilot type_display = v4_ty_unknown
        pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
        if sig_id >= 0 {
            type_display = v4_ty_signature_display(ty_id, sig_id)
        }
        v4_document_symbols_add(doc_id, name, kind, def_id, hir_item, span, type_display)
        symbol_id += 1
    }

    v4_query_store(key, fingerprint, word_from_int(doc_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    give back doc_id
}

task v4_document_symbols_text(path: word, text: word) -> word {
    pilot doc_id = v4_document_symbols_text_cached(path, text)
    give back v4_document_symbols_summary(doc_id)
}

task v4_document_symbols_file(path: word) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_document_symbols_text(path, text)
}

task v4_driver_completion_new(path: word, offset: int) -> int {
    v4_driver_init()
    pilot completion_id = array_len(v4_driver_comp_paths)
    array_push(v4_driver_comp_paths, path)
    array_push(v4_driver_comp_offsets, word_from_int(offset))
    array_push(v4_driver_comp_labels, word_from_int(array_new()))
    array_push(v4_driver_comp_kinds, word_from_int(array_new()))
    array_push(v4_driver_comp_details, word_from_int(array_new()))
    array_push(v4_driver_comp_inserts, word_from_int(array_new()))
    give back completion_id
}

task v4_completion_set_count() -> int {
    v4_driver_init()
    give back array_len(v4_driver_comp_paths)
}

task v4_completion_exists(completion_id: int) -> bool {
    v4_driver_init()
    if completion_id < 0 {
        give back false
    }
    if completion_id >= array_len(v4_driver_comp_paths) {
        give back false
    }
    give back true
}

task v4_completion_path(completion_id: int) -> word {
    if v4_completion_exists(completion_id) == false {
        give back ""
    }
    give back array_get(v4_driver_comp_paths, completion_id)
}

task v4_completion_offset(completion_id: int) -> int {
    if v4_completion_exists(completion_id) == false {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_driver_comp_offsets, completion_id))
}

task v4_driver_comp_labels_handle(completion_id: int) -> int {
    give back word_to_int(array_get(v4_driver_comp_labels, completion_id))
}

task v4_driver_comp_kinds_handle(completion_id: int) -> int {
    give back word_to_int(array_get(v4_driver_comp_kinds, completion_id))
}

task v4_driver_comp_details_handle(completion_id: int) -> int {
    give back word_to_int(array_get(v4_driver_comp_details, completion_id))
}

task v4_driver_comp_inserts_handle(completion_id: int) -> int {
    give back word_to_int(array_get(v4_driver_comp_inserts, completion_id))
}

task v4_completion_add(completion_id: int, label: word, kind: word, detail: word, insert_text: word) -> int {
    pilot item_id = array_len(v4_driver_comp_labels_handle(completion_id))
    array_push(v4_driver_comp_labels_handle(completion_id), label)
    array_push(v4_driver_comp_kinds_handle(completion_id), kind)
    array_push(v4_driver_comp_details_handle(completion_id), detail)
    array_push(v4_driver_comp_inserts_handle(completion_id), insert_text)
    give back item_id
}

task v4_completion_count(completion_id: int) -> int {
    give back array_len(v4_driver_comp_labels_handle(completion_id))
}

task v4_completion_label(completion_id: int, item_id: int) -> word {
    give back array_get(v4_driver_comp_labels_handle(completion_id), item_id)
}

task v4_completion_kind(completion_id: int, item_id: int) -> word {
    give back array_get(v4_driver_comp_kinds_handle(completion_id), item_id)
}

task v4_completion_detail(completion_id: int, item_id: int) -> word {
    give back array_get(v4_driver_comp_details_handle(completion_id), item_id)
}

task v4_completion_insert_text(completion_id: int, item_id: int) -> word {
    give back array_get(v4_driver_comp_inserts_handle(completion_id), item_id)
}

task v4_completion_add_keywords(completion_id: int) -> void {
    v4_completion_add(completion_id, "task", "keyword", "declare a task", "task ")
    v4_completion_add(completion_id, "shape", "keyword", "declare a shape", "shape ")
    v4_completion_add(completion_id, "doctrine", "keyword", "declare a doctrine", "doctrine ")
    v4_completion_add(completion_id, "impl", "keyword", "implement a shape or doctrine", "impl ")
    v4_completion_add(completion_id, "use", "keyword", "import a module", "use ")
    v4_completion_add(completion_id, "extern", "keyword", "declare native bindings", "extern ")
    v4_completion_add(completion_id, "pilot", "keyword", "declare a local pilot", "pilot ")
    v4_completion_add(completion_id, "give back", "keyword", "return from a task", "give back ")
    v4_completion_add(completion_id, "if", "keyword", "conditional branch", "if ")
    v4_completion_add(completion_id, "repeat until", "keyword", "loop until a condition", "repeat until ")
    v4_completion_add(completion_id, "when", "keyword", "route matching", "when ")
}

task v4_completion_add_document_symbols(completion_id: int, doc_id: int) -> void {
    pilot symbol_id = 0
    pilot symbol_count = v4_document_symbol_count(doc_id)
    repeat until symbol_id >= symbol_count {
        pilot label = v4_document_symbol_name(doc_id, symbol_id)
        pilot kind = v4_document_symbol_kind(doc_id, symbol_id)
        pilot detail = v4_document_symbol_type(doc_id, symbol_id)
        if detail == "" or detail == v4_ty_unknown {
            detail = v4_document_symbol_def(doc_id, symbol_id)
        }
        v4_completion_add(completion_id, label, kind, detail, label)
        symbol_id += 1
    }
}

task v4_completion_summary(completion_id: int) -> word {
    pilot summary = "completion id=" + word_from_int(completion_id)
    summary = summary + " path=" + v4_completion_path(completion_id)
    summary = summary + " offset=" + word_from_int(v4_completion_offset(completion_id))
    summary = summary + " count=" + word_from_int(v4_completion_count(completion_id))
    if v4_completion_count(completion_id) > 0 {
        summary = summary + " first=" + v4_completion_label(completion_id, 0)
        summary = summary + " first-kind=" + v4_completion_kind(completion_id, 0)
    }
    give back summary
}

task v4_completion_snapshot_escape(value: word) -> word {
    give back v4_document_symbols_snapshot_escape(value)
}

task v4_completion_snapshot_unescape(value: word) -> word {
    give back v4_document_symbols_snapshot_unescape(value)
}

task v4_completion_snapshot_line_count(payload: word) -> int {
    give back v4_document_symbols_snapshot_line_count(payload)
}

task v4_completion_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_document_symbols_snapshot_line(payload, wanted)
}

task v4_completion_snapshot_field_count(line: word) -> int {
    give back v4_document_symbols_snapshot_field_count(line)
}

task v4_completion_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_document_symbols_snapshot_field_raw(line, wanted)
}

task v4_completion_snapshot_field(line: word, wanted: int) -> word {
    give back v4_document_symbols_snapshot_field(line, wanted)
}

task v4_completion_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_document_symbols_snapshot_key_value(line, wanted_key)
}

task v4_completion_snapshot_item_total() -> int {
    v4_driver_init()
    pilot total = 0
    pilot completion_id = 0
    repeat until completion_id >= v4_completion_set_count() {
        total += v4_completion_count(completion_id)
        completion_id += 1
    }
    give back total
}

task v4_completion_snapshot_summary() -> word {
    pilot summary = "completion-snapshot"
    summary = summary + " format=" + v4_completion_snapshot_format
    summary = summary + " completions=" + word_from_int(v4_completion_set_count())
    summary = summary + " items=" + word_from_int(v4_completion_snapshot_item_total())
    give back summary
}

task v4_completion_snapshot_header() -> word {
    pilot out = "completion-snapshot"
    out = out + "|format=" + v4_completion_snapshot_format
    out = out + "|completions=" + word_from_int(v4_completion_set_count())
    out = out + "|items=" + word_from_int(v4_completion_snapshot_item_total())
    give back out
}

task v4_completion_snapshot_completion_line(completion_id: int) -> word {
    pilot out = "completion"
    out = out + "|" + word_from_int(completion_id)
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_path(completion_id))
    out = out + "|" + word_from_int(v4_completion_offset(completion_id))
    out = out + "|" + word_from_int(v4_completion_count(completion_id))
    give back out
}

task v4_completion_snapshot_item_line(completion_id: int, item_id: int) -> word {
    pilot out = "completion-item"
    out = out + "|" + word_from_int(completion_id)
    out = out + "|" + word_from_int(item_id)
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_label(completion_id, item_id))
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_kind(completion_id, item_id))
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_detail(completion_id, item_id))
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_insert_text(completion_id, item_id))
    give back out
}

task v4_completion_snapshot() -> word {
    v4_driver_init()
    pilot out = v4_completion_snapshot_header()
    pilot completion_id = 0
    pilot completion_count = v4_completion_set_count()
    repeat until completion_id >= completion_count {
        out = out + "\n" + v4_completion_snapshot_completion_line(completion_id)
        pilot item_id = 0
        pilot item_count = v4_completion_count(completion_id)
        repeat until item_id >= item_count {
            out = out + "\n" + v4_completion_snapshot_item_line(completion_id, item_id)
            item_id += 1
        }
        completion_id += 1
    }
    out = out + "\nend|" + v4_completion_snapshot_format
    give back out
}

task v4_completion_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "completion-snapshot" { give back 4 }
    if kind == "completion" { give back 5 }
    if kind == "completion-item" { give back 7 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_completion_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_completion_snapshot_field_raw(line, 0)
    pilot expected = v4_completion_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_completion_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_completion_snapshot_validate(payload: word) -> word {
    pilot lines = v4_completion_snapshot_line_count(payload)
    pilot completions = 0
    pilot items = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_completion_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_completion_snapshot_field_raw(line, 0)
            if v4_completion_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "completion-snapshot" {
                saw_header += 1
                format = v4_completion_snapshot_key_value(line, "format")
                if format != v4_completion_snapshot_format {
                    malformed += 1
                }
            } else if kind == "completion" {
                completions += 1
            } else if kind == "completion-item" {
                items += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_completion_snapshot_field(line, 1) != v4_completion_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "completion-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " completions=" + word_from_int(completions)
    out = out + " items=" + word_from_int(items)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_completion_restore_completion_slot(completion_id: int, path: word, offset: int) -> int {
    v4_driver_init()
    repeat until array_len(v4_driver_comp_paths) > completion_id {
        v4_driver_completion_new("", 0)
    }

    array_set(v4_driver_comp_paths, completion_id, path)
    array_set(v4_driver_comp_offsets, completion_id, word_from_int(offset))
    array_set(v4_driver_comp_labels, completion_id, word_from_int(array_new()))
    array_set(v4_driver_comp_kinds, completion_id, word_from_int(array_new()))
    array_set(v4_driver_comp_details, completion_id, word_from_int(array_new()))
    array_set(v4_driver_comp_inserts, completion_id, word_from_int(array_new()))
    give back 1
}

task v4_completion_restore_item_slot(completion_id: int, item_id: int, label: word, kind: word, detail: word, insert_text: word) -> int {
    if v4_completion_exists(completion_id) == false {
        give back 0
    }
    repeat until v4_completion_count(completion_id) > item_id {
        v4_completion_add(completion_id, "", "", "", "")
    }

    array_set(v4_driver_comp_labels_handle(completion_id), item_id, label)
    array_set(v4_driver_comp_kinds_handle(completion_id), item_id, kind)
    array_set(v4_driver_comp_details_handle(completion_id), item_id, detail)
    array_set(v4_driver_comp_inserts_handle(completion_id), item_id, insert_text)
    give back 1
}

task v4_completion_snapshot_restore_completion_line(line: word) -> int {
    if v4_completion_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_completion_snapshot_field_raw(line, 0) != "completion" { give back 0 }
    pilot completion_id = word_to_int(v4_completion_snapshot_field_raw(line, 1))
    pilot path = v4_completion_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_completion_snapshot_field_raw(line, 3))
    give back v4_completion_restore_completion_slot(completion_id, path, offset)
}

task v4_completion_snapshot_restore_item_line(line: word) -> int {
    if v4_completion_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_completion_snapshot_field_raw(line, 0) != "completion-item" { give back 0 }
    pilot completion_id = word_to_int(v4_completion_snapshot_field_raw(line, 1))
    pilot item_id = word_to_int(v4_completion_snapshot_field_raw(line, 2))
    pilot label = v4_completion_snapshot_field(line, 3)
    pilot kind = v4_completion_snapshot_field(line, 4)
    pilot detail = v4_completion_snapshot_field(line, 5)
    pilot insert_text = v4_completion_snapshot_field(line, 6)
    give back v4_completion_restore_item_slot(completion_id, item_id, label, kind, detail, insert_text)
}

task v4_completion_snapshot_restore(payload: word) -> word {
    pilot validation = v4_completion_snapshot_validate(payload)
    if validation.starts_with("completion-snapshot-import ok=1") == false {
        give back "completion-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_completions = 0
    pilot restored_items = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_completion_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_completion_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_completion_snapshot_field_raw(line, 0)
            if kind == "completion" {
                restored_completions += v4_completion_snapshot_restore_completion_line(line)
            } else if kind == "completion-item" {
                restored_items += v4_completion_snapshot_restore_item_line(line)
            } else if kind != "completion-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "completion-snapshot-restore ok=1"
    out = out + " completions=" + word_from_int(restored_completions)
    out = out + " items=" + word_from_int(restored_items)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-completions=" + word_from_int(v4_completion_set_count())
    give back out
}

task v4_completion_text_cached(path: word, text: word, offset: int) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_completion_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot doc_id = v4_document_symbols_text_cached(path, text)
    pilot completion_id = v4_driver_completion_new(path, offset)
    v4_completion_add_document_symbols(completion_id, doc_id)
    v4_completion_add_keywords(completion_id)

    v4_query_store(key, fingerprint, word_from_int(completion_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_document_symbols_query_key(path))
    give back completion_id
}

task v4_completion_text(path: word, text: word, offset: int) -> word {
    pilot completion_id = v4_completion_text_cached(path, text, offset)
    give back v4_completion_summary(completion_id)
}

task v4_completion_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_completion_text(path, text, offset)
}

task v4_check_syntax_text(path: word, text: word) -> word {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_check_syntax_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back cached
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot tree_id = v4_parse_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot borrow_id = v4_borrowck_text_cached(path, text)
    pilot diagnostics_id = v4_diagnostics_text_cached(path, text)
    pilot lines = v4_line_count(text)
    pilot syntax_summary = "syntax-ok file=" + word_from_int(file_id)
    syntax_summary = syntax_summary + " rev=" + word_from_int(v4_source_revision(file_id))
    syntax_summary = syntax_summary + " lines=" + word_from_int(lines)
    syntax_summary = syntax_summary + " bytes=" + word_from_int(text.length())
    syntax_summary = syntax_summary + " tokens=" + word_from_int(v4_lex_token_count(stream_id))
    syntax_summary = syntax_summary + " lex-diagnostics=" + word_from_int(v4_lex_diag_count(stream_id))
    syntax_summary = syntax_summary + " parse-nodes=" + word_from_int(v4_parse_node_count(tree_id))
    syntax_summary = syntax_summary + " parse-diagnostics=" + word_from_int(v4_parse_diag_count(tree_id))
    syntax_summary = syntax_summary + " hir-items=" + word_from_int(v4_hir_item_count(hir_id))
    syntax_summary = syntax_summary + " hir-diagnostics=" + word_from_int(v4_hir_diag_count(hir_id))
    syntax_summary = syntax_summary + " symbols=" + word_from_int(v4_resolve_symbol_count(resolve_id))
    syntax_summary = syntax_summary + " resolve-diagnostics=" + word_from_int(v4_resolve_diag_count(resolve_id))
    syntax_summary = syntax_summary + " signatures=" + word_from_int(v4_ty_signature_count(ty_id))
    syntax_summary = syntax_summary + " ty-diagnostics=" + word_from_int(v4_ty_diag_count(ty_id))
    syntax_summary = syntax_summary + " mir-bodies=" + word_from_int(v4_mir_body_count(mir_id))
    syntax_summary = syntax_summary + " mir-diagnostics=" + word_from_int(v4_mir_diag_count(mir_id))
    syntax_summary = syntax_summary + " borrow-results=" + word_from_int(v4_borrowck_result_count(borrow_id))
    syntax_summary = syntax_summary + " borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(borrow_id))
    syntax_summary = syntax_summary + " diagnostics=" + word_from_int(v4_diagnostics_count(diagnostics_id))

    v4_query_store(key, fingerprint, syntax_summary)
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_parse_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    v4_query_record_dep(key, v4_borrowck_query_key(path))
    v4_query_record_dep(key, v4_diagnostics_query_key(path))
    give back syntax_summary
}

task v4_check_syntax_file(path: word) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_check_syntax_text(path, text)
}

task v4_driver_status() -> word {
    v4_driver_init()
    pilot status = "freakc_v4 " + FREAKC_V4_VERSION + " (" + FREAKC_V4_CODENAME + ")"
    status = status + " generation=" + word_from_int(v4_query_generation())
    status = status + " queries=" + word_from_int(v4_query_cache_size())
    status = status + " deps=" + word_from_int(v4_query_dep_count())
    status = status + " dirty=" + word_from_int(v4_query_dirty_count())
    status = status + " hits=" + word_from_int(v4_query_hit_count())
    status = status + " misses=" + word_from_int(v4_query_miss_count())
    give back status
}
