task v4_driver_diag_items_handle(diag_set_id: int) -> int {
    if v4_driver_ready == 0 or diag_set_id < 0 { give back 0 - 1 }
    if diag_set_id >= array_len(v4_driver_diag_paths) or diag_set_id >= array_len(v4_driver_diag_items) { give back 0 - 1 }
    give back word_to_int(array_get(v4_driver_diag_items, diag_set_id))
}

task v4_driver_diag_set_new(path: word) -> int {
    v4_driver_init()
    if v4_driver_ready == 0 { give back 0 - 1 }
    pilot child = array_new()
    if child < 0 { give back 0 - 1 }
    pilot diag_set_id = array_len(v4_driver_diag_paths)
    array_push(v4_driver_diag_paths, path)
    array_push(v4_driver_diag_items, word_from_int(child))
    give back diag_set_id
}

task v4_diagnostics_set_count() -> int {
    v4_driver_init()
    give back array_len(v4_driver_diag_paths)
}

task v4_diagnostics_set_exists(diag_set_id: int) -> bool {
    v4_driver_init()
    if diag_set_id < 0 {
        give back false
    }
    if diag_set_id >= array_len(v4_driver_diag_paths) {
        give back false
    }
    give back true
}

task v4_diagnostics_path(diag_set_id: int) -> word {
    if v4_diagnostics_set_exists(diag_set_id) == false {
        give back ""
    }
    give back array_get(v4_driver_diag_paths, diag_set_id)
}

task v4_diagnostics_count(diag_set_id: int) -> int {
    give back array_len(v4_driver_diag_items_handle(diag_set_id))
}

task v4_diagnostics_diag(diag_set_id: int, diag_id: int) -> word {
    give back array_get(v4_driver_diag_items_handle(diag_set_id), diag_id)
}

task v4_diagnostics_add(diag_set_id: int, diag: word) -> void {
    array_push(v4_driver_diag_items_handle(diag_set_id), diag)
}

task v4_diagnostics_copy_lex(diag_set_id: int, stream_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_lex_diag_count(stream_id)
    repeat until diag_idx >= diag_count {
        v4_diagnostics_add(diag_set_id, v4_lex_diag(stream_id, diag_idx))
        diag_idx += 1
    }
}

task v4_diagnostics_copy_borrowck(diag_set_id: int, borrow_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_borrowck_diag_count(borrow_id)
    repeat until diag_idx >= diag_count {
        v4_diagnostics_add(diag_set_id, v4_borrowck_diag(borrow_id, diag_idx))
        diag_idx += 1
    }
}

task v4_diagnostics_error_count(diag_set_id: int) -> int {
    pilot errors = 0
    pilot diag_idx = 0
    pilot diag_count = v4_diagnostics_count(diag_set_id)
    repeat until diag_idx >= diag_count {
        pilot diag = v4_diagnostics_diag(diag_set_id, diag_idx)
        pilot severity = v4_diag_severity(diag)
        if severity == v4_diag_error or severity == v4_diag_fatal {
            errors += 1
        }
        diag_idx += 1
    }
    give back errors
}

task v4_diagnostics_warning_count(diag_set_id: int) -> int {
    pilot warnings = 0
    pilot diag_idx = 0
    pilot diag_count = v4_diagnostics_count(diag_set_id)
    repeat until diag_idx >= diag_count {
        pilot diag = v4_diagnostics_diag(diag_set_id, diag_idx)
        if v4_diag_severity(diag) == v4_diag_warning {
            warnings += 1
        }
        diag_idx += 1
    }
    give back warnings
}

task v4_diagnostics_summary(diag_set_id: int) -> word {
    pilot summary = "diagnostics id=" + word_from_int(diag_set_id)
    summary = summary + " count=" + word_from_int(v4_diagnostics_count(diag_set_id))
    summary = summary + " errors=" + word_from_int(v4_diagnostics_error_count(diag_set_id))
    summary = summary + " warnings=" + word_from_int(v4_diagnostics_warning_count(diag_set_id))
    give back summary
}

-- Reserve every new child before changing a diagnostic arena. Direct restore
-- is an ownership replacement: successful publication releases the old child.
-- Sparse slots are filled atomically; a failed reservation leaves both columns.
task v4_driver_diag_restore_set_into(paths: int, items: int, diag_set_id: int, path: word) -> int {
    give back v4_driver_diag_restore_set_into_bound(paths, items, diag_set_id, path, array_len(paths))
}

task v4_driver_diag_restore_set_into_bound(paths: int, items: int, diag_set_id: int, path: word, coordinate_bound: int) -> int {
    if paths < 0 or items < 0 or diag_set_id < 0 { give back 0 - 1 }
    pilot count = array_len(paths)
    if coordinate_bound < 0 { give back 0 - 1 }
    if diag_set_id > coordinate_bound and diag_set_id - coordinate_bound > v4_driver_diag_restore_gap_limit { give back 0 - 1 }
    if count != array_len(items) { give back 0 - 1 }
    if diag_set_id < count {
        pilot child = array_new()
        if child < 0 { give back 0 - 1 }
        pilot old = word_to_int(array_get(items, diag_set_id))
        array_set(paths, diag_set_id, path)
        array_set(items, diag_set_id, word_from_int(child))
        array_release(old)
        give back diag_set_id
    }
    pilot children = array_new()
    if children < 0 { give back 0 - 1 }
    pilot slot = count
    repeat until slot > diag_set_id {
        pilot child = array_new()
        if child < 0 {
            pilot index = 0
            repeat until index >= array_len(children) {
                array_release(word_to_int(array_get(children, index)))
                index += 1
            }
            array_release(children)
            give back 0 - 1
        }
        array_push(children, word_from_int(child))
        slot += 1
    }
    slot = count
    repeat until slot > diag_set_id {
        pilot slot_path = ""
        if slot == diag_set_id { slot_path = path }
        array_push(paths, slot_path)
        array_push(items, array_get(children, slot - count))
        slot += 1
    }
    array_release(children)
    give back diag_set_id
}

task v4_driver_diag_restore_diag_into(paths: int, items: int, diag_set_id: int, diag_id: int, diag: word) -> int {
    pilot bound = 0
    if diag_set_id >= 0 and diag_set_id < array_len(items) { bound = array_len(word_to_int(array_get(items, diag_set_id))) }
    give back v4_driver_diag_restore_diag_into_bound(paths, items, diag_set_id, diag_id, diag, bound)
}

task v4_driver_diag_restore_diag_into_bound(paths: int, items: int, diag_set_id: int, diag_id: int, diag: word, coordinate_bound: int) -> int {
    if diag_set_id < 0 or diag_id < 0 { give back 0 }
    if diag_set_id >= array_len(paths) or diag_set_id >= array_len(items) { give back 0 }
    pilot child = word_to_int(array_get(items, diag_set_id))
    if child < 0 { give back 0 }
    if coordinate_bound < 0 { give back 0 }
    if diag_id > coordinate_bound and diag_id - coordinate_bound > v4_driver_diag_restore_gap_limit { give back 0 }
    repeat until array_len(child) > diag_id {
        array_push(child, "")
    }
    array_set(child, diag_id, diag)
    give back 1
}

task v4_diagnostics_restore_set_slot(diag_set_id: int, path: word) -> int {
    if diag_set_id < 0 { give back 0 - 1 }
    v4_driver_init()
    if v4_driver_ready == 0 { give back 0 - 1 }
    give back v4_driver_diag_restore_set_into(v4_driver_diag_paths, v4_driver_diag_items, diag_set_id, path)
}

task v4_diagnostics_restore_diag_slot(diag_set_id: int, diag_id: int, diag: word) -> int {
    if v4_driver_ready == 0 { give back 0 }
    give back v4_driver_diag_restore_diag_into(v4_driver_diag_paths, v4_driver_diag_items, diag_set_id, diag_id, diag)
}

-- Snapshot owns decoding, validation and overlay order. Driver owns only the
-- arena storage transaction: a private copy, abort, and one atomic publication.
task v4_driver_diag_arena_release(paths: int, items: int) -> void {
    pilot slot = 0
    repeat until slot >= array_len(items) {
        array_release(word_to_int(array_get(items, slot)))
        slot += 1
    }
    array_release(items)
    array_release(paths)
}

task v4_diagnostics_restore_stage_release(stage: int) -> void {
    if array_len(stage) == 2 {
        v4_driver_diag_arena_release(word_to_int(array_get(stage, 0)), word_to_int(array_get(stage, 1)))
    }
    array_release(stage)
}

task v4_diagnostics_restore_stage_new() -> int {
    v4_driver_init()
    if v4_driver_ready == 0 { give back 0 - 1 }
    pilot stage = array_new()
    pilot paths = array_new()
    pilot items = array_new()
    if stage < 0 or paths < 0 or items < 0 {
        array_release(stage)
        array_release(paths)
        array_release(items)
        give back 0 - 1
    }
    array_push(stage, word_from_int(paths))
    array_push(stage, word_from_int(items))
    pilot slot = 0
    repeat until slot >= array_len(v4_driver_diag_paths) {
        pilot child = array_new()
        if child < 0 {
            v4_diagnostics_restore_stage_release(stage)
            give back 0 - 1
        }
        array_push(paths, array_get(v4_driver_diag_paths, slot))
        array_push(items, word_from_int(child))
        pilot old = v4_driver_diag_items_handle(slot)
        pilot diag_id = 0
        repeat until diag_id >= array_len(old) {
            array_push(child, array_get(old, diag_id))
            diag_id += 1
        }
        slot += 1
    }
    give back stage
}

task v4_diagnostics_restore_stage_set_slot(stage: int, diag_set_id: int, path: word, observed_rows: int) -> int {
    if array_len(stage) != 2 { give back 0 - 1 }
    if observed_rows < 0 { give back 0 - 1 }
    pilot bound = observed_rows
    if array_len(v4_driver_diag_paths) > bound { bound = array_len(v4_driver_diag_paths) }
    give back v4_driver_diag_restore_set_into_bound(word_to_int(array_get(stage, 0)), word_to_int(array_get(stage, 1)), diag_set_id, path, bound)
}

task v4_diagnostics_restore_stage_diag_slot(stage: int, diag_set_id: int, diag_id: int, diag: word, observed_rows: int) -> int {
    if array_len(stage) != 2 { give back 0 }
    if observed_rows < 0 { give back 0 }
    -- Live arenas retain the validator's original bounds until publication;
    -- resetting a staged set must not narrow an already admitted coordinate.
    pilot bound = observed_rows
    if v4_diagnostics_count(diag_set_id) > bound { bound = v4_diagnostics_count(diag_set_id) }
    give back v4_driver_diag_restore_diag_into_bound(word_to_int(array_get(stage, 0)), word_to_int(array_get(stage, 1)), diag_set_id, diag_id, diag, bound)
}

task v4_diagnostics_restore_stage_publish(stage: int) -> bool {
    if array_len(stage) != 2 { give back false }
    pilot paths = word_to_int(array_get(stage, 0))
    pilot items = word_to_int(array_get(stage, 1))
    if paths < 0 or items < 0 or array_len(paths) != array_len(items) { give back false }
    pilot old_paths = v4_driver_diag_paths
    pilot old_items = v4_driver_diag_items
    v4_driver_diag_paths = paths
    v4_driver_diag_items = items
    v4_driver_ready = 1
    array_release(stage)
    v4_driver_diag_arena_release(old_paths, old_items)
    give back true
}


task v4_diagnostics_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_diagnostics_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot tree_id = v4_parse_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    if hir_id < 0 { give back 0 - 1 }
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot borrow_id = v4_borrowck_text_cached(path, text)
    pilot diag_set_id = v4_driver_diag_set_new(path)
    if diag_set_id < 0 { give back 0 - 1 }
    v4_diagnostics_copy_lex(diag_set_id, stream_id)
    v4_diagnostics_copy_borrowck(diag_set_id, borrow_id)

    v4_query_store(key, fingerprint, word_from_int(diag_set_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_parse_query_key(path))
    v4_query_record_dep(key, v4_expand_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    v4_query_record_dep(key, v4_borrowck_query_key(path))
    give back diag_set_id
}

task v4_diagnostics_text(path: word, text: word) -> word {
    pilot diag_set_id = v4_diagnostics_text_cached(path, text)
    if diag_set_id < 0 { give back v4_driver_resource_failure("diagnostics") }
    give back v4_diagnostics_summary(diag_set_id)
}

task v4_diagnostics_file(path: word) -> word {
    pilot source_read = fs::read_checked(path)
    check result source_read {
        ok(text) -> {
            give back v4_diagnostics_text(path, text)
        }
        err(error) -> {
            give back v4_driver_read_error(path, error)
        }
    }
}

task v4_check_syntax_text(path: word, text: word) -> word {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_check_syntax_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back cached
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot tree_id = v4_parse_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    if hir_id < 0 { give back v4_driver_resource_failure("syntax") }
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot borrow_id = v4_borrowck_text_cached(path, text)
    pilot diagnostics_id = v4_diagnostics_text_cached(path, text)
    pilot lines = v4_line_count(text)
    pilot syntax_summary = "syntax-ok file=" + word_from_int(file_id)
    syntax_summary = syntax_summary + " rev=" + word_from_int(v4_source_revision(file_id))
    syntax_summary = syntax_summary + " lines=" + word_from_int(lines)
    syntax_summary = syntax_summary + " bytes=" + word_from_int(text.length())
    syntax_summary = syntax_summary + " tokens=" + word_from_int(v4_lex_token_count(stream_id))
    syntax_summary = syntax_summary + " lex-diagnostics=" + word_from_int(v4_lex_diag_count(stream_id))
    syntax_summary = syntax_summary + " parse-nodes=" + word_from_int(v4_parse_node_count(tree_id))
    syntax_summary = syntax_summary + " parse-diagnostics=" + word_from_int(v4_parse_diag_count(tree_id))
    syntax_summary = syntax_summary + " hir-items=" + word_from_int(v4_hir_item_count(hir_id))
    syntax_summary = syntax_summary + " hir-diagnostics=" + word_from_int(v4_hir_diag_count(hir_id))
    syntax_summary = syntax_summary + " symbols=" + word_from_int(v4_resolve_symbol_count(resolve_id))
    syntax_summary = syntax_summary + " resolve-diagnostics=" + word_from_int(v4_resolve_diag_count(resolve_id))
    syntax_summary = syntax_summary + " signatures=" + word_from_int(v4_ty_signature_count(ty_id))
    syntax_summary = syntax_summary + " ty-diagnostics=" + word_from_int(v4_ty_diag_count(ty_id))
    syntax_summary = syntax_summary + " mir-bodies=" + word_from_int(v4_mir_body_count(mir_id))
    syntax_summary = syntax_summary + " mir-diagnostics=" + word_from_int(v4_mir_diag_count(mir_id))
    syntax_summary = syntax_summary + " borrow-results=" + word_from_int(v4_borrowck_result_count(borrow_id))
    syntax_summary = syntax_summary + " borrow-diagnostics=" + word_from_int(v4_borrowck_diag_count(borrow_id))
    syntax_summary = syntax_summary + " diagnostics=" + word_from_int(v4_diagnostics_count(diagnostics_id))

    v4_query_store(key, fingerprint, syntax_summary)
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_parse_query_key(path))
    v4_query_record_dep(key, v4_expand_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    v4_query_record_dep(key, v4_borrowck_query_key(path))
    v4_query_record_dep(key, v4_diagnostics_query_key(path))
    give back syntax_summary
}

task v4_check_syntax_file(path: word) -> word {
    pilot source_read = fs::read_checked(path)
    check result source_read {
        ok(text) -> {
            give back v4_check_syntax_text(path, text)
        }
        err(error) -> {
            give back v4_driver_read_error(path, error)
        }
    }
}

task v4_driver_status() -> word {
    v4_driver_init()
    pilot status = "freakc_v4 " + FREAKC_V4_VERSION + " (" + FREAKC_V4_CODENAME + ")"
    status = status + " generation=" + word_from_int(v4_query_generation())
    status = status + " queries=" + word_from_int(v4_query_cache_size())
    status = status + " deps=" + word_from_int(v4_query_dep_count())
    status = status + " dirty=" + word_from_int(v4_query_dirty_count())
    status = status + " hits=" + word_from_int(v4_query_hit_count())
    status = status + " misses=" + word_from_int(v4_query_miss_count())
    give back status
}

