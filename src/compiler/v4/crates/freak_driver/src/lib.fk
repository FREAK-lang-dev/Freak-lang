-- ===================================================================
-- freak_driver - early V4 driver facade
-- ===================================================================
-- Depends on freak_span, freak_diag, freak_session, freak_lex, freak_parse,
-- freak_hir, freak_resolve, freak_ty, freak_mir, freak_borrowck, and
-- freak_query. Syntax checking is currently a query-backed source, lexing,
-- parse, HIR, resolve, type signature, MIR, and Meiya scaffold path.

pilot FREAKC_V4_VERSION = "0.1.0-bootstrap"
pilot FREAKC_V4_CODENAME = "00-Unit"
pilot v4_unit_snapshot_format = "freak-00-unit-snapshot-v1"
pilot v4_unit_snapshot_manifest_format = "freak-00-unit-manifest-v1"
pilot v4_diagnostics_snapshot_format = "freak-diagnostics-snapshot-v1"
pilot v4_semantic_snapshot_format = "freak-semantic-snapshot-v1"
pilot v4_hover_snapshot_format = "freak-hover-snapshot-v1"
pilot v4_definition_snapshot_format = "freak-definition-snapshot-v1"
pilot v4_document_symbols_snapshot_format = "freak-document-symbols-snapshot-v1"
pilot v4_completion_snapshot_format = "freak-completion-snapshot-v1"

pilot v4_driver_diag_paths = 0
pilot v4_driver_diag_items = 0
pilot v4_driver_sem_paths = 0
pilot v4_driver_sem_offsets = 0
pilot v4_driver_sem_token_ids = 0
pilot v4_driver_sem_token_kinds = 0
pilot v4_driver_sem_token_values = 0
pilot v4_driver_sem_token_spans = 0
pilot v4_driver_sem_hir_items = 0
pilot v4_driver_sem_item_names = 0
pilot v4_driver_sem_item_kinds = 0
pilot v4_driver_sem_symbol_ids = 0
pilot v4_driver_sem_names = 0
pilot v4_driver_sem_kinds = 0
pilot v4_driver_sem_defs = 0
pilot v4_driver_sem_types = 0
pilot v4_driver_hover_paths = 0
pilot v4_driver_hover_offsets = 0
pilot v4_driver_hover_semantic_ids = 0
pilot v4_driver_hover_names = 0
pilot v4_driver_hover_kinds = 0
pilot v4_driver_hover_types = 0
pilot v4_driver_hover_markdowns = 0
pilot v4_driver_defn_paths = 0
pilot v4_driver_defn_offsets = 0
pilot v4_driver_defn_semantic_ids = 0
pilot v4_driver_defn_names = 0
pilot v4_driver_defn_kinds = 0
pilot v4_driver_defn_defs = 0
pilot v4_driver_defn_hir_items = 0
pilot v4_driver_defn_spans = 0
pilot v4_driver_defn_found = 0
pilot v4_driver_doc_paths = 0
pilot v4_driver_doc_names = 0
pilot v4_driver_doc_kinds = 0
pilot v4_driver_doc_defs = 0
pilot v4_driver_doc_hir_items = 0
pilot v4_driver_doc_spans = 0
pilot v4_driver_doc_types = 0
pilot v4_driver_comp_paths = 0
pilot v4_driver_comp_offsets = 0
pilot v4_driver_comp_labels = 0
pilot v4_driver_comp_kinds = 0
pilot v4_driver_comp_details = 0
pilot v4_driver_comp_inserts = 0
pilot v4_driver_ready = 0

task v4_driver_init() -> void {
    v4_session_init()
    v4_query_init()
    if v4_driver_ready == 0 {
        v4_driver_diag_paths = array_new()
        v4_driver_diag_items = array_new()
        v4_driver_sem_paths = array_new()
        v4_driver_sem_offsets = array_new()
        v4_driver_sem_token_ids = array_new()
        v4_driver_sem_token_kinds = array_new()
        v4_driver_sem_token_values = array_new()
        v4_driver_sem_token_spans = array_new()
        v4_driver_sem_hir_items = array_new()
        v4_driver_sem_item_names = array_new()
        v4_driver_sem_item_kinds = array_new()
        v4_driver_sem_symbol_ids = array_new()
        v4_driver_sem_names = array_new()
        v4_driver_sem_kinds = array_new()
        v4_driver_sem_defs = array_new()
        v4_driver_sem_types = array_new()
        v4_driver_hover_paths = array_new()
        v4_driver_hover_offsets = array_new()
        v4_driver_hover_semantic_ids = array_new()
        v4_driver_hover_names = array_new()
        v4_driver_hover_kinds = array_new()
        v4_driver_hover_types = array_new()
        v4_driver_hover_markdowns = array_new()
        v4_driver_defn_paths = array_new()
        v4_driver_defn_offsets = array_new()
        v4_driver_defn_semantic_ids = array_new()
        v4_driver_defn_names = array_new()
        v4_driver_defn_kinds = array_new()
        v4_driver_defn_defs = array_new()
        v4_driver_defn_hir_items = array_new()
        v4_driver_defn_spans = array_new()
        v4_driver_defn_found = array_new()
        v4_driver_doc_paths = array_new()
        v4_driver_doc_names = array_new()
        v4_driver_doc_kinds = array_new()
        v4_driver_doc_defs = array_new()
        v4_driver_doc_hir_items = array_new()
        v4_driver_doc_spans = array_new()
        v4_driver_doc_types = array_new()
        v4_driver_comp_paths = array_new()
        v4_driver_comp_offsets = array_new()
        v4_driver_comp_labels = array_new()
        v4_driver_comp_kinds = array_new()
        v4_driver_comp_details = array_new()
        v4_driver_comp_inserts = array_new()
        v4_driver_ready = 1
    }
}

task v4_check_syntax_query_key(path: word) -> word {
    give back "syntax:" + path
}

task v4_diagnostics_query_key(path: word) -> word {
    give back "diagnostics:" + path
}

task v4_semantic_at_query_key(path: word, offset: int) -> word {
    give back "semantic-at:" + path + ":" + word_from_int(offset)
}

task v4_hover_query_key(path: word, offset: int) -> word {
    give back "hover:" + path + ":" + word_from_int(offset)
}

task v4_definition_at_query_key(path: word, offset: int) -> word {
    give back "definition-at:" + path + ":" + word_from_int(offset)
}

task v4_document_symbols_query_key(path: word) -> word {
    give back "document-symbols:" + path
}

task v4_completion_query_key(path: word, offset: int) -> word {
    give back "completion:" + path + ":" + word_from_int(offset)
}

task v4_lex_query_key(path: word) -> word {
    give back "lex:" + path
}

task v4_parse_query_key(path: word) -> word {
    give back "parse:" + path
}

task v4_hir_query_key(path: word) -> word {
    give back "hir:" + path
}

task v4_resolve_query_key(path: word) -> word {
    give back "resolve:" + path
}

task v4_ty_query_key(path: word) -> word {
    give back "ty:" + path
}

task v4_mir_query_key(path: word) -> word {
    give back "mir:" + path
}

task v4_borrowck_query_key(path: word) -> word {
    give back "borrowck:" + path
}

task v4_driver_query_key_matches_path(path: word, key: word) -> bool {
    if key == v4_check_syntax_query_key(path) { give back true }
    if key == v4_lex_query_key(path) { give back true }
    if key == v4_parse_query_key(path) { give back true }
    if key == v4_hir_query_key(path) { give back true }
    if key == v4_resolve_query_key(path) { give back true }
    if key == v4_ty_query_key(path) { give back true }
    if key == v4_mir_query_key(path) { give back true }
    if key == v4_borrowck_query_key(path) { give back true }
    if key == v4_diagnostics_query_key(path) { give back true }
    if key.starts_with("semantic-at:" + path + ":") { give back true }
    if key.starts_with("hover:" + path + ":") { give back true }
    if key.starts_with("definition-at:" + path + ":") { give back true }
    if key == v4_document_symbols_query_key(path) { give back true }
    if key.starts_with("completion:" + path + ":") { give back true }
    give back false
}

task v4_driver_query_output_can_promote(path: word, key: word) -> int {
    if key == v4_check_syntax_query_key(path) {
        give back 1
    }
    give back 0
}

task v4_driver_query_entry_can_promote(path: word, entry_id: int) -> int {
    pilot key = v4_query_entry_key(entry_id)
    if v4_driver_query_output_can_promote(path, key) == 1 {
        give back 1
    }
    if key == v4_lex_query_key(path) {
        pilot stream_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_lex_stream_exists(stream_id) {
            give back 1
        }
    }
    if key == v4_parse_query_key(path) {
        pilot tree_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_parse_tree_exists(tree_id) {
            pilot stream_id = v4_parse_stream_id(tree_id)
            if v4_lex_stream_exists(stream_id) {
                give back 1
            }
        }
    }
    if key == v4_hir_query_key(path) {
        pilot hir_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_hir_file_exists(hir_id) {
            pilot tree_id = v4_hir_tree_id(hir_id)
            if v4_parse_tree_exists(tree_id) {
                pilot stream_id = v4_parse_stream_id(tree_id)
                if v4_lex_stream_exists(stream_id) {
                    give back 1
                }
            }
        }
    }
    if key == v4_resolve_query_key(path) {
        pilot resolve_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_resolve_exists(resolve_id) {
            pilot hir_id = v4_resolve_hir_id(resolve_id)
            if v4_hir_file_exists(hir_id) {
                pilot tree_id = v4_hir_tree_id(hir_id)
                if v4_parse_tree_exists(tree_id) {
                    pilot stream_id = v4_parse_stream_id(tree_id)
                    if v4_lex_stream_exists(stream_id) {
                        give back 1
                    }
                }
            }
        }
    }
    if key == v4_ty_query_key(path) {
        pilot ty_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_ty_file_exists(ty_id) {
            pilot resolve_id = v4_ty_resolve_id(ty_id)
            if v4_resolve_exists(resolve_id) {
                pilot hir_id = v4_resolve_hir_id(resolve_id)
                if v4_hir_file_exists(hir_id) {
                    pilot tree_id = v4_hir_tree_id(hir_id)
                    if v4_parse_tree_exists(tree_id) {
                        pilot stream_id = v4_parse_stream_id(tree_id)
                        if v4_lex_stream_exists(stream_id) {
                            give back 1
                        }
                    }
                }
            }
        }
    }
    if key == v4_mir_query_key(path) {
        pilot mir_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_mir_file_exists(mir_id) {
            pilot ty_id = v4_mir_ty_id(mir_id)
            if v4_ty_file_exists(ty_id) {
                pilot resolve_id = v4_ty_resolve_id(ty_id)
                if v4_resolve_exists(resolve_id) {
                    pilot hir_id = v4_resolve_hir_id(resolve_id)
                    if v4_hir_file_exists(hir_id) {
                        pilot tree_id = v4_hir_tree_id(hir_id)
                        if v4_parse_tree_exists(tree_id) {
                            pilot stream_id = v4_parse_stream_id(tree_id)
                            if v4_lex_stream_exists(stream_id) {
                                give back 1
                            }
                        }
                    }
                }
            }
        }
    }
    if key == v4_borrowck_query_key(path) {
        pilot borrow_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_borrowck_file_exists(borrow_id) {
            pilot mir_id = v4_borrowck_mir_id(borrow_id)
            if v4_mir_file_exists(mir_id) {
                pilot ty_id = v4_mir_ty_id(mir_id)
                if v4_ty_file_exists(ty_id) {
                    pilot resolve_id = v4_ty_resolve_id(ty_id)
                    if v4_resolve_exists(resolve_id) {
                        pilot hir_id = v4_resolve_hir_id(resolve_id)
                        if v4_hir_file_exists(hir_id) {
                            pilot tree_id = v4_hir_tree_id(hir_id)
                            if v4_parse_tree_exists(tree_id) {
                                pilot stream_id = v4_parse_stream_id(tree_id)
                                if v4_lex_stream_exists(stream_id) {
                                    give back 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if key == v4_diagnostics_query_key(path) {
        pilot diag_set_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_diagnostics_set_exists(diag_set_id) {
            if v4_diagnostics_path(diag_set_id) == path {
                pilot fingerprint = v4_query_entry_input(entry_id)
                pilot lex_entry = v4_query_find(v4_lex_query_key(path), fingerprint)
                pilot borrow_entry = v4_query_find(v4_borrowck_query_key(path), fingerprint)
                if lex_entry >= 0 and borrow_entry >= 0 {
                    pilot stream_id = word_to_int(v4_query_entry_output(lex_entry))
                    pilot borrow_id = word_to_int(v4_query_entry_output(borrow_entry))
                    if v4_lex_stream_exists(stream_id) and v4_borrowck_file_exists(borrow_id) {
                        pilot mir_id = v4_borrowck_mir_id(borrow_id)
                        if v4_mir_file_exists(mir_id) {
                            pilot ty_id = v4_mir_ty_id(mir_id)
                            if v4_ty_file_exists(ty_id) {
                                pilot resolve_id = v4_ty_resolve_id(ty_id)
                                if v4_resolve_exists(resolve_id) {
                                    pilot hir_id = v4_resolve_hir_id(resolve_id)
                                    if v4_hir_file_exists(hir_id) {
                                        pilot tree_id = v4_hir_tree_id(hir_id)
                                        if v4_parse_tree_exists(tree_id) {
                                            give back 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if key.starts_with("semantic-at:" + path + ":") {
        pilot fact_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_semantic_fact_exists(fact_id) {
            if v4_semantic_at_path(fact_id) == path {
                if v4_semantic_at_query_key(path, v4_semantic_at_offset(fact_id)) == key {
                    pilot fingerprint = v4_query_entry_input(entry_id)
                    pilot lex_entry = v4_query_find(v4_lex_query_key(path), fingerprint)
                    pilot hir_entry = v4_query_find(v4_hir_query_key(path), fingerprint)
                    pilot resolve_entry = v4_query_find(v4_resolve_query_key(path), fingerprint)
                    pilot ty_entry = v4_query_find(v4_ty_query_key(path), fingerprint)
                    if lex_entry >= 0 and hir_entry >= 0 and resolve_entry >= 0 and ty_entry >= 0 {
                        pilot stream_id = word_to_int(v4_query_entry_output(lex_entry))
                        pilot hir_id = word_to_int(v4_query_entry_output(hir_entry))
                        pilot resolve_id = word_to_int(v4_query_entry_output(resolve_entry))
                        pilot ty_id = word_to_int(v4_query_entry_output(ty_entry))
                        if v4_lex_stream_exists(stream_id) and v4_hir_file_exists(hir_id) and v4_resolve_exists(resolve_id) and v4_ty_file_exists(ty_id) {
                            give back 1
                        }
                    }
                }
            }
        }
    }
    if key.starts_with("hover:" + path + ":") {
        pilot hover_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_hover_exists(hover_id) {
            if v4_hover_path(hover_id) == path {
                pilot offset = v4_hover_offset(hover_id)
                if v4_hover_query_key(path, offset) == key {
                    pilot semantic_id = v4_hover_semantic_id(hover_id)
                    if v4_semantic_fact_exists(semantic_id) {
                        pilot fingerprint = v4_query_entry_input(entry_id)
                        pilot semantic_entry = v4_query_find(v4_semantic_at_query_key(path, offset), fingerprint)
                        if semantic_entry >= 0 {
                            pilot restored_semantic = word_to_int(v4_query_entry_output(semantic_entry))
                            if restored_semantic == semantic_id {
                                give back 1
                            }
                        }
                    }
                }
            }
        }
    }
    if key.starts_with("definition-at:" + path + ":") {
        pilot defn_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_definition_at_exists(defn_id) {
            if v4_definition_at_path(defn_id) == path {
                pilot offset = v4_definition_at_offset(defn_id)
                if v4_definition_at_query_key(path, offset) == key {
                    pilot semantic_id = v4_definition_at_semantic_id(defn_id)
                    if v4_semantic_fact_exists(semantic_id) {
                        pilot fingerprint = v4_query_entry_input(entry_id)
                        pilot semantic_entry = v4_query_find(v4_semantic_at_query_key(path, offset), fingerprint)
                        pilot hir_entry = v4_query_find(v4_hir_query_key(path), fingerprint)
                        if semantic_entry >= 0 and hir_entry >= 0 {
                            pilot restored_semantic = word_to_int(v4_query_entry_output(semantic_entry))
                            pilot hir_id = word_to_int(v4_query_entry_output(hir_entry))
                            if restored_semantic == semantic_id and v4_hir_file_exists(hir_id) {
                                give back 1
                            }
                        }
                    }
                }
            }
        }
    }
    if key == v4_document_symbols_query_key(path) {
        pilot doc_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_document_symbols_exists(doc_id) {
            if v4_document_symbols_path(doc_id) == path {
                pilot fingerprint = v4_query_entry_input(entry_id)
                pilot hir_entry = v4_query_find(v4_hir_query_key(path), fingerprint)
                pilot resolve_entry = v4_query_find(v4_resolve_query_key(path), fingerprint)
                pilot ty_entry = v4_query_find(v4_ty_query_key(path), fingerprint)
                if hir_entry >= 0 and resolve_entry >= 0 and ty_entry >= 0 {
                    pilot hir_id = word_to_int(v4_query_entry_output(hir_entry))
                    pilot resolve_id = word_to_int(v4_query_entry_output(resolve_entry))
                    pilot ty_id = word_to_int(v4_query_entry_output(ty_entry))
                    if v4_hir_file_exists(hir_id) and v4_resolve_exists(resolve_id) and v4_ty_file_exists(ty_id) {
                        give back 1
                    }
                }
            }
        }
    }
    if key.starts_with("completion:" + path + ":") {
        pilot completion_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_completion_exists(completion_id) {
            if v4_completion_path(completion_id) == path {
                pilot offset = v4_completion_offset(completion_id)
                if v4_completion_query_key(path, offset) == key {
                    pilot fingerprint = v4_query_entry_input(entry_id)
                    pilot doc_entry = v4_query_find(v4_document_symbols_query_key(path), fingerprint)
                    if doc_entry >= 0 {
                        pilot doc_id = word_to_int(v4_query_entry_output(doc_entry))
                        if v4_document_symbols_exists(doc_id) {
                            give back 1
                        }
                    }
                }
            }
        }
    }
    give back 0
}

task v4_driver_confirm_restored_key(path: word, key: word) -> word {
    v4_driver_init()
    pilot file_id = v4_source_find(path)
    if file_id < 0 {
        give back "query-confirm-key ok=0 reason=source-missing path=" + path + " key=" + key
    }
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot allow_promote = v4_driver_query_output_can_promote(path, key)
    give back v4_query_confirm_key_input(key, fingerprint, "source-confirm:" + path, allow_promote)
}

task v4_driver_confirm_restored_document(path: word) -> word {
    v4_driver_init()
    pilot file_id = v4_source_find(path)
    if file_id < 0 {
        give back "query-confirm ok=0 reason=source-missing path=" + path
    }

    pilot generation = v4_query_bump_generation("source-confirm:" + path)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot considered = 0
    pilot matched = 0
    pilot promoted = 0
    pilot blocked = 0
    pilot already_valid = 0
    pilot dirty_nonrestored = 0
    pilot mismatched = 0

    pilot entry_id = 0
    pilot entry_count = v4_query_cache_size()
    repeat until entry_id >= entry_count {
        pilot key = v4_query_entry_key(entry_id)
        if v4_driver_query_key_matches_path(path, key) {
            considered += 1
            pilot allow_promote = v4_driver_query_entry_can_promote(path, entry_id)
            pilot code = v4_query_confirm_entry_input(entry_id, fingerprint, "source-confirm:" + path, allow_promote)
            if code == 1 {
                matched += 1
                promoted += 1
            } else if code == 2 {
                matched += 1
                blocked += 1
            } else if code == 3 {
                matched += 1
                already_valid += 1
            } else if code == 4 {
                matched += 1
                dirty_nonrestored += 1
            } else {
                mismatched += 1
            }
        }
        entry_id += 1
    }

    pilot out = "query-confirm ok=1"
    out = out + " path=" + path
    out = out + " generation=" + word_from_int(generation)
    out = out + " considered=" + word_from_int(considered)
    out = out + " matched=" + word_from_int(matched)
    out = out + " promoted=" + word_from_int(promoted)
    out = out + " blocked=" + word_from_int(blocked)
    out = out + " already-valid=" + word_from_int(already_valid)
    out = out + " dirty-nonrestored=" + word_from_int(dirty_nonrestored)
    out = out + " mismatched=" + word_from_int(mismatched)
    out = out + " dirty=" + word_from_int(v4_query_dirty_count())
    give back out
}

task v4_driver_confirm_restored_document_text(path: word, text: word) -> word {
    v4_source_set_text(path, text)
    give back v4_driver_confirm_restored_document(path)
}

task v4_lex_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_lex_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text(file_id, text)
    v4_query_store(key, fingerprint, word_from_int(stream_id))
    v4_query_record_dep(key, "source:" + path)
    give back stream_id
}

task v4_lex_file(path: word) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot file_id = v4_source_find(path)
    pilot summary = v4_lex_summary(stream_id)
    summary = summary + " file=" + word_from_int(file_id)
    summary = summary + " rev=" + word_from_int(v4_source_revision(file_id))
    give back summary
}

task v4_parse_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_parse_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot tree_id = v4_parse_stream(file_id, stream_id)
    v4_query_store(key, fingerprint, word_from_int(tree_id))
    v4_query_record_dep(key, v4_lex_query_key(path))
    give back tree_id
}

task v4_parse_file(path: word) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }

    pilot tree_id = v4_parse_text_cached(path, text)
    pilot file_id = v4_source_find(path)
    pilot summary = v4_parse_summary(tree_id)
    summary = summary + " file=" + word_from_int(file_id)
    summary = summary + " rev=" + word_from_int(v4_source_revision(file_id))
    give back summary
}

