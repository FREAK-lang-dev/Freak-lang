    give back v4_semantic_snapshot_key_value(line, wanted_key)
}

task v4_hover_snapshot_summary() -> word {
    pilot summary = "hover-snapshot"
    summary = summary + " format=" + v4_hover_snapshot_format
    summary = summary + " hovers=" + word_from_int(v4_hover_count())
    give back summary
}

task v4_hover_snapshot_header() -> word {
    pilot out = "hover-snapshot"
    out = out + "|format=" + v4_hover_snapshot_format
    out = out + "|hovers=" + word_from_int(v4_hover_count())
    give back out
}

task v4_hover_snapshot_hover_line(hover_id: int) -> word {
    pilot out = "hover"
    out = out + "|" + word_from_int(hover_id)
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_path(hover_id))
    out = out + "|" + word_from_int(v4_hover_offset(hover_id))
    out = out + "|" + word_from_int(v4_hover_semantic_id(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_name(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_kind(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_type(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_markdown(hover_id))
    give back out
}

task v4_hover_snapshot() -> word {
    v4_driver_init()
    pilot out = v4_hover_snapshot_header()
    pilot hover_id = 0
    pilot hover_count = v4_hover_count()
    repeat until hover_id >= hover_count {
        out = out + "\n" + v4_hover_snapshot_hover_line(hover_id)
        hover_id += 1
    }
    out = out + "\nend|" + v4_hover_snapshot_format
    give back out
}

task v4_hover_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "hover-snapshot" { give back 3 }
    if kind == "hover" { give back 9 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_hover_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_hover_snapshot_field_raw(line, 0)
    pilot expected = v4_hover_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_hover_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_hover_snapshot_validate(payload: word) -> word {
    pilot lines = v4_hover_snapshot_line_count(payload)
    pilot hovers = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_hover_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_hover_snapshot_field_raw(line, 0)
            if v4_hover_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "hover-snapshot" {
                saw_header += 1
                format = v4_hover_snapshot_key_value(line, "format")
                if format != v4_hover_snapshot_format {
                    malformed += 1
                }
            } else if kind == "hover" {
                hovers += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_hover_snapshot_field(line, 1) != v4_hover_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "hover-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " hovers=" + word_from_int(hovers)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_hover_restore_slot(hover_id: int, path: word, offset: int, semantic_id: int, name: word, kind: word, type_display: word, markdown: word) -> int {
    v4_driver_init()
    repeat until array_len(v4_driver_hover_paths) > hover_id {
        v4_driver_hover_new("", 0, 0 - 1, "", "", v4_ty_unknown, "")
    }

    array_set(v4_driver_hover_paths, hover_id, path)
    array_set(v4_driver_hover_offsets, hover_id, word_from_int(offset))
    array_set(v4_driver_hover_semantic_ids, hover_id, word_from_int(semantic_id))
    array_set(v4_driver_hover_names, hover_id, name)
    array_set(v4_driver_hover_kinds, hover_id, kind)
    array_set(v4_driver_hover_types, hover_id, type_display)
    array_set(v4_driver_hover_markdowns, hover_id, markdown)
    give back 1
}

task v4_hover_snapshot_restore_hover_line(line: word) -> int {
    if v4_hover_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_hover_snapshot_field_raw(line, 0) != "hover" { give back 0 }
    pilot hover_id = word_to_int(v4_hover_snapshot_field_raw(line, 1))
    pilot path = v4_hover_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_hover_snapshot_field_raw(line, 3))
    pilot semantic_id = word_to_int(v4_hover_snapshot_field_raw(line, 4))
    pilot name = v4_hover_snapshot_field(line, 5)
    pilot kind = v4_hover_snapshot_field(line, 6)
    pilot type_display = v4_hover_snapshot_field(line, 7)
    pilot markdown = v4_hover_snapshot_field(line, 8)
    give back v4_hover_restore_slot(hover_id, path, offset, semantic_id, name, kind, type_display, markdown)
}

task v4_hover_snapshot_restore(payload: word) -> word {
    pilot validation = v4_hover_snapshot_validate(payload)
    if validation.starts_with("hover-snapshot-import ok=1") == false {
        give back "hover-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_hovers = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_hover_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_hover_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_hover_snapshot_field_raw(line, 0)
            if kind == "hover" {
                restored_hovers += v4_hover_snapshot_restore_hover_line(line)
            } else if kind != "hover-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "hover-snapshot-restore ok=1"
    out = out + " hovers=" + word_from_int(restored_hovers)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-hovers=" + word_from_int(v4_hover_count())
    give back out
}

task v4_hover_text_cached(path: word, text: word, offset: int) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_hover_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot semantic_id = v4_semantic_at_text_cached(path, text, offset)
    pilot name = v4_semantic_at_name(semantic_id)
    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot type_display = v4_semantic_at_type(semantic_id)
    pilot markdown = v4_hover_markdown_for_semantic(semantic_id)
    pilot hover_id = v4_driver_hover_new(path, offset, semantic_id, name, kind, type_display, markdown)

    v4_query_store(key, fingerprint, word_from_int(hover_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_semantic_at_query_key(path, offset))
    give back hover_id
}

task v4_hover_text(path: word, text: word, offset: int) -> word {
    pilot hover_id = v4_hover_text_cached(path, text, offset)
    give back v4_hover_summary(hover_id)
}

task v4_hover_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_hover_text(path, text, offset)
}

task v4_driver_definition_new(path: word, offset: int, semantic_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, found: int) -> int {
    v4_driver_init()
    pilot defn_id = array_len(v4_driver_defn_paths)
    array_push(v4_driver_defn_paths, path)
    array_push(v4_driver_defn_offsets, word_from_int(offset))
    array_push(v4_driver_defn_semantic_ids, word_from_int(semantic_id))
    array_push(v4_driver_defn_names, name)
    array_push(v4_driver_defn_kinds, kind)
    array_push(v4_driver_defn_defs, def_id)
    array_push(v4_driver_defn_hir_items, word_from_int(hir_item))
    array_push(v4_driver_defn_spans, span)
    array_push(v4_driver_defn_found, word_from_int(found))
    give back defn_id
}

task v4_definition_at_count() -> int {
    v4_driver_init()
    give back array_len(v4_driver_defn_paths)
}

task v4_definition_at_exists(defn_id: int) -> bool {
    v4_driver_init()
    if defn_id < 0 {
        give back false
    }
    if defn_id >= array_len(v4_driver_defn_paths) {
        give back false
    }
    give back true
}

task v4_definition_at_path(defn_id: int) -> word {
    if v4_definition_at_exists(defn_id) == false {
        give back ""
    }
    give back array_get(v4_driver_defn_paths, defn_id)
}

task v4_definition_at_offset(defn_id: int) -> int {
    give back word_to_int(array_get(v4_driver_defn_offsets, defn_id))
}

task v4_definition_at_semantic_id(defn_id: int) -> int {
