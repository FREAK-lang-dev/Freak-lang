-- ===================================================================
-- freak_driver - early V4 driver facade
-- ===================================================================
-- Depends on freak_span, freak_diag, freak_session, freak_lex, freak_parse,
-- freak_expand, freak_hir, freak_resolve, freak_ty, freak_mir, freak_borrowck, and
-- freak_query. Syntax checking is currently a query-backed source, lexing,
-- parse, identity expansion, HIR, resolve, type signature, MIR, and Meiya path.

pilot FREAKC_V4_VERSION = "0.1.0-bootstrap"
pilot FREAKC_V4_CODENAME = "00-Unit"

pilot v4_driver_diag_paths = 0
pilot v4_driver_diag_items = 0
pilot v4_driver_ready = 0
-- Bound one sparse expansion, while dense arenas may grow beyond this limit.
-- Coordinates must not infer unbounded holes from unchecked snapshot integers.
pilot v4_driver_diag_restore_gap_limit = 65536

task v4_driver_init() -> void {
    v4_session_init()
    v4_query_init()
    if v4_driver_ready == 0 {
        pilot paths = array_new()
        pilot items = array_new()
        if paths < 0 or items < 0 {
            array_release(paths)
            array_release(items)
            give back
        }
        v4_driver_diag_paths = paths
        v4_driver_diag_items = items
        v4_driver_ready = 1
    }
}

task v4_check_syntax_query_key(path: word) -> word {
    give back "syntax:" + path
}

task v4_diagnostics_query_key(path: word) -> word {
    give back "diagnostics:" + path
}

task v4_lex_query_key(path: word) -> word {
    give back "lex:" + path
}

task v4_parse_query_key(path: word) -> word {
    give back "parse:" + path
}

task v4_expand_query_key(path: word) -> word {
    give back "expand:" + path
}

task v4_hir_query_key(path: word) -> word {
    give back "hir:" + path
}

task v4_resolve_query_key(path: word) -> word {
    give back "resolve:" + path
}

task v4_ty_query_key(path: word) -> word {
    give back "ty:" + path
}

task v4_mir_query_key(path: word) -> word {
    give back "mir:" + path
}

task v4_borrowck_query_key(path: word) -> word {
    give back "borrowck:" + path
}

task v4_lex_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_lex_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text(file_id, text)
    v4_query_store(key, fingerprint, word_from_int(stream_id))
    v4_query_record_dep(key, "source:" + path)
    give back stream_id
}

task v4_driver_read_error(path: word, error: word) -> word {
    pilot span = v4_span_new("0", 0, 0)
    pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path + ": " + error)
    give back v4_diag_render(diag, "")
}

task v4_lex_file(path: word) -> word {
    pilot source_read = fs::read_checked(path)
    check result source_read {
        ok(text) -> {
            pilot stream_id = v4_lex_text_cached(path, text)
            pilot file_id = v4_source_find(path)
            pilot summary = v4_lex_summary(stream_id)
            summary = summary + " file=" + word_from_int(file_id)
            summary = summary + " rev=" + word_from_int(v4_source_revision(file_id))
            give back summary
        }
        err(error) -> {
            give back v4_driver_read_error(path, error)
        }
    }
}

task v4_parse_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_parse_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot tree_id = v4_parse_stream(file_id, stream_id)
    v4_query_store(key, fingerprint, word_from_int(tree_id))
    v4_query_record_dep(key, v4_lex_query_key(path))
    give back tree_id
}

task v4_parse_file(path: word) -> word {
    pilot source_read = fs::read_checked(path)
    check result source_read {
        ok(text) -> {
            pilot tree_id = v4_parse_text_cached(path, text)
            pilot file_id = v4_source_find(path)
            pilot summary = v4_parse_summary(tree_id)
            summary = summary + " file=" + word_from_int(file_id)
            summary = summary + " rev=" + word_from_int(v4_source_revision(file_id))
            give back summary
        }
        err(error) -> {
            give back v4_driver_read_error(path, error)
        }
    }
}

task v4_expand_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_expand_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot tree_id = v4_parse_text_cached(path, text)
    pilot expansion_id = v4_expand_identity(file_id, tree_id)
    v4_query_store(key, fingerprint, word_from_int(expansion_id))
    v4_query_record_dep(key, v4_parse_query_key(path))
    give back expansion_id
}

task v4_expand_file(path: word) -> word {
    pilot source_read = fs::read_checked(path)
    check result source_read {
        ok(text) -> {
            pilot expansion_id = v4_expand_text_cached(path, text)
            pilot file_id = v4_source_find(path)
            pilot summary = v4_expand_summary(expansion_id)
            summary = summary + " rev=" + word_from_int(v4_source_revision(file_id))
            give back summary
        }
        err(error) -> {
            give back v4_driver_read_error(path, error)
        }
    }
}

-- Resource failures are retryable outcomes, never query values or empty arenas.
task v4_driver_resource_failure(stage: word) -> word {
    give back stage + "-failed reason=hir-resource-exhausted"
}

task v4_hir_text_cached(path: word, text: word) -> int {
    v4_driver_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_hir_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot expansion_id = v4_expand_text_cached(path, text)
    pilot hir_id = v4_hir_lower_expanded(file_id, expansion_id)
    if hir_id < 0 { give back 0 - 1 }
    v4_query_store(key, fingerprint, word_from_int(hir_id))
    v4_query_record_dep(key, v4_expand_query_key(path))
    give back hir_id
}

task v4_hir_file(path: word) -> word {
    pilot source_read = fs::read_checked(path)
    check result source_read {
        ok(text) -> {
            pilot hir_id = v4_hir_text_cached(path, text)
            if hir_id < 0 { give back v4_driver_resource_failure("hir") }
            pilot file_id = v4_source_find(path)
            pilot summary = v4_hir_summary(hir_id)
            summary = summary + " file=" + word_from_int(file_id)
            summary = summary + " rev=" + word_from_int(v4_source_revision(file_id))
            give back summary
        }
        err(error) -> {
            give back v4_driver_read_error(path, error)
        }
    }
}

