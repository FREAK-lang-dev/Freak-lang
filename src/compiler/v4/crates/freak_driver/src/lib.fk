    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_lower_hir(file_id, hir_id)
    v4_query_store(key, fingerprint, word_from_int(resolve_id))
    v4_query_record_dep(key, v4_hir_query_key(path))
