task v4_editor_comp_kinds_handle(completion_id: int) -> int {
    give back word_to_int(array_get(v4_editor_comp_kinds, completion_id))
}

task v4_editor_comp_details_handle(completion_id: int) -> int {
    give back word_to_int(array_get(v4_editor_comp_details, completion_id))
