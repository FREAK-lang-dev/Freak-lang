    array_push(v4_editor_defn_semantic_ids, word_from_int(semantic_id))
    array_push(v4_editor_defn_names, name)
    array_push(v4_editor_defn_kinds, kind)
    array_push(v4_editor_defn_defs, def_id)
    array_push(v4_editor_defn_hir_items, word_from_int(hir_item))
    array_push(v4_editor_defn_spans, span)
    array_push(v4_editor_defn_found, word_from_int(found))
