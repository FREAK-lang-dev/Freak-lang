-- ===================================================================
-- freak_editor - editor analysis over the V4 query engine
-- ===================================================================
-- Depends on freak_driver and owns semantic-at, hover, definition,
-- document-symbol, and completion arenas plus their query APIs. The
-- driver remains the orchestration layer; freak_lsp remains transport.

pilot v4_editor_sem_paths = 0
pilot v4_editor_sem_offsets = 0
pilot v4_editor_sem_token_ids = 0
pilot v4_editor_sem_token_kinds = 0
pilot v4_editor_sem_token_values = 0
pilot v4_editor_sem_token_spans = 0
pilot v4_editor_sem_hir_items = 0
pilot v4_editor_sem_item_names = 0
pilot v4_editor_sem_item_kinds = 0
pilot v4_editor_sem_symbol_ids = 0
pilot v4_editor_sem_names = 0
pilot v4_editor_sem_kinds = 0
pilot v4_editor_sem_defs = 0
pilot v4_editor_sem_types = 0
pilot v4_editor_hover_paths = 0
pilot v4_editor_hover_offsets = 0
pilot v4_editor_hover_semantic_ids = 0
pilot v4_editor_hover_names = 0
pilot v4_editor_hover_kinds = 0
pilot v4_editor_hover_types = 0
pilot v4_editor_hover_markdowns = 0
pilot v4_editor_defn_paths = 0
pilot v4_editor_defn_offsets = 0
pilot v4_editor_defn_semantic_ids = 0
pilot v4_editor_defn_names = 0
pilot v4_editor_defn_kinds = 0
pilot v4_editor_defn_defs = 0
pilot v4_editor_defn_hir_items = 0
pilot v4_editor_defn_spans = 0
pilot v4_editor_defn_found = 0
pilot v4_editor_doc_paths = 0
pilot v4_editor_doc_names = 0
pilot v4_editor_doc_kinds = 0
pilot v4_editor_doc_defs = 0
pilot v4_editor_doc_hir_items = 0
pilot v4_editor_doc_spans = 0
pilot v4_editor_doc_types = 0
pilot v4_editor_comp_paths = 0
pilot v4_editor_comp_offsets = 0
pilot v4_editor_comp_labels = 0
pilot v4_editor_comp_kinds = 0
pilot v4_editor_comp_details = 0
pilot v4_editor_comp_inserts = 0

pilot v4_editor_ready = 0

task v4_editor_init() -> void {
    v4_driver_init()
    if v4_editor_ready == 0 {
        v4_editor_sem_paths = array_new()
        v4_editor_sem_offsets = array_new()
        v4_editor_sem_token_ids = array_new()
        v4_editor_sem_token_kinds = array_new()
        v4_editor_sem_token_values = array_new()
        v4_editor_sem_token_spans = array_new()
        v4_editor_sem_hir_items = array_new()
        v4_editor_sem_item_names = array_new()
        v4_editor_sem_item_kinds = array_new()
        v4_editor_sem_symbol_ids = array_new()
        v4_editor_sem_names = array_new()
        v4_editor_sem_kinds = array_new()
        v4_editor_sem_defs = array_new()
        v4_editor_sem_types = array_new()
        v4_editor_hover_paths = array_new()
        v4_editor_hover_offsets = array_new()
        v4_editor_hover_semantic_ids = array_new()
        v4_editor_hover_names = array_new()
        v4_editor_hover_kinds = array_new()
        v4_editor_hover_types = array_new()
        v4_editor_hover_markdowns = array_new()
        v4_editor_defn_paths = array_new()
        v4_editor_defn_offsets = array_new()
        v4_editor_defn_semantic_ids = array_new()
        v4_editor_defn_names = array_new()
        v4_editor_defn_kinds = array_new()
        v4_editor_defn_defs = array_new()
        v4_editor_defn_hir_items = array_new()
        v4_editor_defn_spans = array_new()
        v4_editor_defn_found = array_new()
        v4_editor_doc_paths = array_new()
        v4_editor_doc_names = array_new()
        v4_editor_doc_kinds = array_new()
        v4_editor_doc_defs = array_new()
        v4_editor_doc_hir_items = array_new()
        v4_editor_doc_spans = array_new()
        v4_editor_doc_types = array_new()
        v4_editor_comp_paths = array_new()
        v4_editor_comp_offsets = array_new()
        v4_editor_comp_labels = array_new()
        v4_editor_comp_kinds = array_new()
        v4_editor_comp_details = array_new()
        v4_editor_comp_inserts = array_new()
        v4_editor_ready = 1
    }
}

task v4_semantic_at_query_key(path: word, offset: int) -> word {
    give back "semantic-at:" + path + ":" + word_from_int(offset)
}

task v4_hover_query_key(path: word, offset: int) -> word {
    give back "hover:" + path + ":" + word_from_int(offset)
}

task v4_definition_at_query_key(path: word, offset: int) -> word {
    give back "definition-at:" + path + ":" + word_from_int(offset)
}

task v4_document_symbols_query_key(path: word) -> word {
    give back "document-symbols:" + path
}

task v4_completion_query_key(path: word, offset: int) -> word {
    give back "completion:" + path + ":" + word_from_int(offset)
}

task v4_editor_token_at(stream_id: int, offset: int) -> int {
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        pilot token_type = v4_lex_token_type(stream_id, token_id)
        if token_type != v4_tok_trivia and token_type != v4_tok_eof {
            pilot span = v4_lex_token_span(stream_id, token_id)
            if offset >= v4_span_start(span) and offset < v4_span_end(span) {
                give back token_id
            }
        }
        token_id += 1
    }
    give back 0 - 1
}

task v4_editor_hir_item_at(hir_id: int, offset: int) -> int {
    pilot best_item = 0 - 1
    pilot best_len = 0
    pilot item_id = 0
    pilot item_count = v4_hir_item_count(hir_id)
    repeat until item_id >= item_count {
        pilot span = v4_hir_item_span(hir_id, item_id)
        if offset >= v4_span_start(span) and offset < v4_span_end(span) {
            pilot span_len = v4_span_len(span)
            if best_item < 0 or span_len < best_len {
                best_item = item_id
                best_len = span_len
            }
        }
        item_id += 1
    }
    give back best_item
}

task v4_editor_ty_signature_for_hir_item(ty_id: int, hir_item: int) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_hir_item(ty_id, sig_id) == hir_item {
            give back sig_id
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_editor_lifetime_def(ty_id: int, sig_id: int, lifetime_name: word) -> word {
    if sig_id < 0 {
        give back ""
    }
    if lifetime_name == "" {
        give back ""
    }
    give back v4_ty_signature_def(ty_id, sig_id) + "::Lifetime::" + lifetime_name
}

task v4_editor_lifetime_detail(ty_id: int, sig_id: int, lifetime_name: word) -> word {
    if sig_id < 0 or lifetime_name == "" {
        give back v4_ty_unknown
    }
    if v4_ty_signature_declares_lifetime_name(ty_id, sig_id, lifetime_name) {
        give back "lifetime " + lifetime_name + " on " + v4_ty_signature_display(ty_id, sig_id)
    }
    if v4_ty_lifetime_is_implicit(lifetime_name) {
        give back "implicit lifetime " + lifetime_name
    }
    give back "undeclared lifetime " + lifetime_name + " near " + v4_ty_signature_name(ty_id, sig_id)
}

task v4_editor_lifetime_decl_span(stream_id: int, item_span: word, lifetime_name: word) -> word {
    if lifetime_name == "" {
        give back item_span
    }

    pilot item_start = v4_span_start(item_span)
    pilot item_end = v4_span_end(item_span)
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        pilot token_span = v4_lex_token_span(stream_id, token_id)
        if v4_span_start(token_span) >= item_start and v4_span_end(token_span) <= item_end {
            if v4_lex_token_type(stream_id, token_id) == v4_tok_lifetime and v4_lex_token_value(stream_id, token_id) == lifetime_name {
                give back token_span
            }
        }
        token_id += 1
    }
    give back item_span
}

task v4_editor_local_decl_span(stream_id: int, local_span: word, local_name: word) -> word {
    if local_name == "" {
        give back local_span
    }

    pilot local_start = v4_span_start(local_span)
    pilot local_end = v4_span_end(local_span)
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        pilot token_span = v4_lex_token_span(stream_id, token_id)
        if v4_span_start(token_span) >= local_start and v4_span_end(token_span) <= local_end {
            if v4_lex_token_type(stream_id, token_id) != v4_tok_trivia and v4_lex_token_value(stream_id, token_id) == local_name {
                give back token_span
            }
        }
        token_id += 1
    }
    give back local_span
}

task v4_editor_hir_item_for_def(hir_id: int, def_id: word) -> int {
    pilot item_id = 0
    pilot item_count = v4_hir_item_count(hir_id)
    repeat until item_id >= item_count {
        if v4_hir_item_def(hir_id, item_id) == def_id {
            give back item_id
        }
        item_id += 1
    }
    give back 0 - 1
}

task v4_editor_impl_method_body_for_offset(stream_id: int, ty_id: int, mir_id: int, hir_item: int, offset: int) -> int {
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot method_id = 0
    pilot method_count = v4_ty_impl_method_count(ty_id, hir_item)
    repeat until method_id >= method_count {
        pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
        pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
        if start_token >= 0 and end_token >= start_token {
            pilot start_span = v4_lex_token_span(stream_id, start_token)
            pilot end_span = v4_lex_token_span(stream_id, end_token)
            if offset >= v4_span_start(start_span) and offset < v4_span_end(end_span) {
                give back v4_mir_lookup_body(mir_id, v4_ty_impl_method_def(ty_id, hir_item, method_id))
            }
        }
        method_id += 1
    }
    give back 0 - 1
}

task v4_editor_body_for_offset(hir_id: int, stream_id: int, ty_id: int, mir_id: int, hir_item: int, offset: int) -> int {
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot item_kind = v4_hir_item_kind(hir_id, hir_item)
    if item_kind == "Task" {
        give back v4_mir_lookup_body(mir_id, v4_hir_item_def(hir_id, hir_item))
    }
    if item_kind == v4_hir_impl {
        give back v4_editor_impl_method_body_for_offset(stream_id, ty_id, mir_id, hir_item, offset)
    }
    give back 0 - 1
}

task v4_editor_local_def(owner_def: word, local_id: int, local_name: word) -> word {
    if owner_def == "" or local_id < 0 or local_name == "" {
        give back ""
    }
    give back owner_def + "::Local::" + word_from_int(local_id) + "::" + local_name
}

task v4_editor_prev_nontrivia_token(stream_id: int, token_id: int) -> int {
    pilot idx = token_id - 1
    repeat until idx < 0 {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_editor_next_nontrivia_token(stream_id: int, token_id: int) -> int {
    pilot idx = token_id + 1
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until idx >= token_count {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_editor_route_case_def(ty_id: int, sig_id: int, case_name: word) -> word {
    if sig_id < 0 or case_name == "" {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back ""
    }
    give back v4_ty_signature_def(ty_id, sig_id) + "::Case::" + case_name
}

task v4_editor_route_case_detail(ty_id: int, sig_id: int, case_name: word) -> word {
    if sig_id < 0 or case_name == "" {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back v4_ty_unknown
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    if route_name == "" {
        give back v4_ty_unknown
    }

    pilot detail = "route case " + route_name + "::" + case_name
    pilot field_id = 0
    pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
    if field_count > 0 {
        detail = detail + " { "
        repeat until field_id >= field_count {
            if field_id > 0 {
                detail = detail + ", "
            }
            detail = detail + v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id)
            detail = detail + ": " + v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id)
            field_id += 1
        }
        detail = detail + " }"
    }
    give back detail
}

task v4_editor_route_case_name_span(ty_id: int, sig_id: int, case_name: word) -> word {
    if sig_id < 0 or case_name == "" {
        give back V4_NO_SPAN
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back V4_NO_SPAN
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back V4_NO_SPAN
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 {
        give back V4_NO_SPAN
    }

    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token < 0 {
        give back V4_NO_SPAN
    }
    give back v4_lex_token_span(stream_id, name_token)
}

task v4_editor_route_case_decl_id_at_token(ty_id: int, sig_id: int, stream_id: int, token_id: int, token_value: word) -> int {
    if sig_id < 0 or token_id < 0 or token_value == "" {
        give back 0 - 1
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0 - 1
    }

    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_start = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
        if case_start >= 0 {
            pilot case_token = v4_ty_skip_trivia(stream_id, case_start)
            if case_token == token_id and v4_ty_route_case_name(ty_id, sig_id, case_id) == token_value {
                give back case_id
            }
        }
        case_id += 1
    }
    give back 0 - 1
}

task v4_editor_route_field_def(ty_id: int, sig_id: int, case_name: word, field_name: word) -> word {
    if sig_id < 0 or case_name == "" or field_name == "" {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back ""
    }
    give back v4_ty_signature_def(ty_id, sig_id) + "::Case::" + case_name + "::Field::" + field_name
}

task v4_editor_route_field_detail(ty_id: int, sig_id: int, case_name: word, field_name: word) -> word {
    if sig_id < 0 or case_name == "" or field_name == "" {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back v4_ty_unknown
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    if route_name == "" {
        give back v4_ty_unknown
    }

    give back "route field " + route_name + "::" + case_name + "." + field_name + ": " + v4_ty_route_case_field_type_for_name(ty_id, route_name, case_name, field_name)
}

task v4_editor_route_field_name_span(ty_id: int, sig_id: int, case_name: word, field_name: word) -> word {
    if sig_id < 0 or case_name == "" or field_name == "" {
        give back V4_NO_SPAN
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back V4_NO_SPAN
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_name, case_name, field_name)
    if field_id < 0 {
        give back V4_NO_SPAN
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 {
        give back V4_NO_SPAN
    }

    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token < 0 {
        give back V4_NO_SPAN
    }
    give back v4_lex_token_span(stream_id, name_token)
}

task v4_editor_route_field_decl_case_name_at_token(ty_id: int, sig_id: int, stream_id: int, token_id: int, token_value: word) -> word {
    if sig_id < 0 or token_id < 0 or token_value == "" {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back ""
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        pilot field_id = 0
        pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
        repeat until field_id >= field_count {
            pilot field_start = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
            if field_start >= 0 {
                pilot field_token = v4_ty_skip_trivia(stream_id, field_start)
                if field_token == token_id and v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) == token_value {
                    give back case_name
                }
            }
            field_id += 1
        }
        case_id += 1
    }
    give back ""
}

task v4_editor_route_payload_open_token(stream_id: int, token_id: int) -> int {
    pilot depth = 0
    pilot idx = token_id - 1
    repeat until idx < 0 {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "{" {
                if depth == 0 {
                    give back idx
                }
                depth -= 1
            } else if value == "[" or value == "(" {
                if depth > 0 {
                    depth -= 1
                }
            } else if value == "}" or value == "]" or value == ")" {
                depth += 1
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_editor_route_case_name_for_payload_token(resolve_id: int, ty_id: int, stream_id: int, token_id: int) -> word {
    pilot open_token = v4_editor_route_payload_open_token(stream_id, token_id)
    if open_token < 0 {
        give back ""
    }

    pilot case_token = v4_editor_prev_nontrivia_token(stream_id, open_token)
    pilot scope_token = v4_editor_prev_nontrivia_token(stream_id, case_token)
    pilot route_token = v4_editor_prev_nontrivia_token(stream_id, scope_token)
    if case_token < 0 or scope_token < 0 or route_token < 0 {
        give back ""
    }
    if v4_lex_token_value(stream_id, scope_token) != "::" {
        give back ""
    }

    pilot route_name = v4_lex_token_value(stream_id, route_token)
    pilot case_name = v4_lex_token_value(stream_id, case_token)
    pilot sig_id = v4_editor_route_case_sig_for_reference(resolve_id, ty_id, stream_id, case_token)
    if sig_id < 0 {
        give back ""
    }
    if v4_ty_route_has_case(ty_id, route_name, case_name) == false {
        give back ""
    }
    give back case_name
}

task v4_editor_route_field_ref_case_name_at_token(resolve_id: int, ty_id: int, stream_id: int, token_id: int, token_value: word) -> word {
    if token_id < 0 or token_value == "" {
        give back ""
    }
    pilot colon_token = v4_editor_next_nontrivia_token(stream_id, token_id)
    if colon_token < 0 or v4_lex_token_value(stream_id, colon_token) != ":" {
        give back ""
    }

    pilot case_name = v4_editor_route_case_name_for_payload_token(resolve_id, ty_id, stream_id, token_id)
    if case_name == "" {
        give back ""
    }
    pilot sig_id = v4_editor_route_case_sig_for_payload_token(resolve_id, ty_id, stream_id, token_id)
    if sig_id < 0 {
        give back ""
    }
    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    if v4_ty_route_case_field_id_for_name(ty_id, route_name, case_name, token_value) < 0 {
        give back ""
    }
    give back case_name
}

task v4_editor_route_case_sig_for_payload_token(resolve_id: int, ty_id: int, stream_id: int, token_id: int) -> int {
    pilot case_name = v4_editor_route_case_name_for_payload_token(resolve_id, ty_id, stream_id, token_id)
    if case_name == "" {
        give back 0 - 1
    }
    pilot open_token = v4_editor_route_payload_open_token(stream_id, token_id)
    if open_token < 0 {
        give back 0 - 1
    }
    pilot case_token = v4_editor_prev_nontrivia_token(stream_id, open_token)
    if case_token < 0 {
        give back 0 - 1
    }
    give back v4_editor_route_case_sig_for_reference(resolve_id, ty_id, stream_id, case_token)
}

task v4_editor_route_field_marker_index(def_id: word) -> int {
    pilot marker = "::Field::"
    pilot marker_len = marker.length()
    pilot def_len = def_id.length()
    pilot idx = 0
    repeat until idx + marker_len > def_len {
        if v4_slice(def_id, idx, idx + marker_len) == marker {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_editor_route_field_case_def(def_id: word) -> word {
    pilot marker = v4_editor_route_field_marker_index(def_id)
    if marker < 0 {
        give back ""
    }
    give back v4_slice(def_id, 0, marker)
}

task v4_editor_route_field_name_from_def(def_id: word) -> word {
    pilot marker = v4_editor_route_field_marker_index(def_id)
    if marker < 0 {
        give back ""
    }
    pilot start = marker + "::Field::".length()
    if start >= def_id.length() {
        give back ""
    }
    give back v4_slice(def_id, start, def_id.length())
}

task v4_editor_route_case_sig_for_reference(resolve_id: int, ty_id: int, stream_id: int, token_id: int) -> int {
    if token_id < 0 {
        give back 0 - 1
    }

    pilot scope_token = v4_editor_prev_nontrivia_token(stream_id, token_id)
    if scope_token < 0 or v4_lex_token_value(stream_id, scope_token) != "::" {
        give back 0 - 1
    }

    pilot route_token = v4_editor_prev_nontrivia_token(stream_id, scope_token)
    if route_token < 0 {
        give back 0 - 1
    }

    pilot route_name = v4_lex_token_value(stream_id, route_token)
    pilot route_symbol = v4_resolve_lookup_symbol(resolve_id, route_name, v4_hir_route)
    if route_symbol >= 0 {
        give back v4_ty_lookup_signature(ty_id, v4_resolve_symbol_def(resolve_id, route_symbol))
    }
    give back v4_ty_route_signature_id_for_name(ty_id, route_name)
}

task v4_editor_route_case_marker_index(def_id: word) -> int {
    pilot marker = "::Case::"
    pilot marker_len = marker.length()
    pilot def_len = def_id.length()
    pilot idx = 0
    repeat until idx + marker_len > def_len {
        if v4_slice(def_id, idx, idx + marker_len) == marker {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_editor_route_case_route_def(def_id: word) -> word {
    pilot marker = v4_editor_route_case_marker_index(def_id)
    if marker < 0 {
        give back ""
    }
    give back v4_slice(def_id, 0, marker)
}

task v4_editor_route_case_name_from_def(def_id: word) -> word {
    pilot marker = v4_editor_route_case_marker_index(def_id)
    if marker < 0 {
        give back ""
    }
    pilot start = marker + "::Case::".length()
    if start >= def_id.length() {
        give back ""
    }
    give back v4_slice(def_id, start, def_id.length())
}

task v4_editor_document_symbols_add_route_cases(doc_id: int, ty_id: int, sig_id: int, hir_item: int) -> void {
    if sig_id < 0 {
        give back
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if case_name != "" {
            v4_document_symbols_add(doc_id, route_name + "::" + case_name, "RouteCase", v4_editor_route_case_def(ty_id, sig_id, case_name), hir_item, v4_editor_route_case_name_span(ty_id, sig_id, case_name), v4_editor_route_case_detail(ty_id, sig_id, case_name))
        }
        case_id += 1
    }
}

task v4_editor_local_has_decl_token(stream_id: int, local_span: word, local_name: word) -> bool {
    if local_name == "" {
        give back false
    }
    pilot local_start = v4_span_start(local_span)
    pilot local_end = v4_span_end(local_span)
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        pilot token_span = v4_lex_token_span(stream_id, token_id)
        if v4_span_start(token_span) >= local_start and v4_span_end(token_span) <= local_end {
            if v4_lex_token_type(stream_id, token_id) != v4_tok_trivia and v4_lex_token_value(stream_id, token_id) == local_name {
                give back true
            }
        }
        token_id += 1
    }
    give back false
}

task v4_editor_local_is_source_declared(stream_id: int, mir_id: int, body_id: int, local_id: int) -> bool {
    give back v4_editor_local_has_decl_token(stream_id, v4_mir_local_span(mir_id, body_id, local_id), v4_mir_local_name(mir_id, body_id, local_id))
}

task v4_editor_local_visible_at(mir_id: int, body_id: int, local_id: int, offset: int) -> bool {
    give back v4_mir_local_visible_at(mir_id, body_id, local_id, offset)
}

task v4_editor_semantic_fact_new(path: word, offset: int, token_id: int, token_kind: word, token_value: word, token_span: word, hir_item: int, item_name: word, item_kind: word, symbol_id: int, name: word, kind: word, def_id: word, type_display: word) -> int {
    v4_editor_init()
    pilot fact_id = array_len(v4_editor_sem_paths)
    array_push(v4_editor_sem_paths, path)
    array_push(v4_editor_sem_offsets, word_from_int(offset))
    array_push(v4_editor_sem_token_ids, word_from_int(token_id))
    array_push(v4_editor_sem_token_kinds, token_kind)
    array_push(v4_editor_sem_token_values, token_value)
    array_push(v4_editor_sem_token_spans, token_span)
    array_push(v4_editor_sem_hir_items, word_from_int(hir_item))
    array_push(v4_editor_sem_item_names, item_name)
    array_push(v4_editor_sem_item_kinds, item_kind)
    array_push(v4_editor_sem_symbol_ids, word_from_int(symbol_id))
    array_push(v4_editor_sem_names, name)
    array_push(v4_editor_sem_kinds, kind)
    array_push(v4_editor_sem_defs, def_id)
    array_push(v4_editor_sem_types, type_display)
    give back fact_id
}

task v4_semantic_fact_count() -> int {
    v4_editor_init()
    give back array_len(v4_editor_sem_paths)
}

task v4_semantic_fact_exists(fact_id: int) -> bool {
    v4_editor_init()
    if fact_id < 0 {
        give back false
    }
    if fact_id >= array_len(v4_editor_sem_paths) {
        give back false
    }
    give back true
}

task v4_semantic_at_path(fact_id: int) -> word {
    if v4_semantic_fact_exists(fact_id) == false {
        give back ""
    }
    give back array_get(v4_editor_sem_paths, fact_id)
}

task v4_semantic_at_offset(fact_id: int) -> int {
    give back word_to_int(array_get(v4_editor_sem_offsets, fact_id))
}

task v4_semantic_at_token_id(fact_id: int) -> int {
    give back word_to_int(array_get(v4_editor_sem_token_ids, fact_id))
}

task v4_semantic_at_token_kind(fact_id: int) -> word {
    give back array_get(v4_editor_sem_token_kinds, fact_id)
}

task v4_semantic_at_token_value(fact_id: int) -> word {
    give back array_get(v4_editor_sem_token_values, fact_id)
}

task v4_semantic_at_token_span(fact_id: int) -> word {
    give back array_get(v4_editor_sem_token_spans, fact_id)
}

task v4_semantic_at_hir_item(fact_id: int) -> int {
    give back word_to_int(array_get(v4_editor_sem_hir_items, fact_id))
}

task v4_semantic_at_item_name(fact_id: int) -> word {
    give back array_get(v4_editor_sem_item_names, fact_id)
}

task v4_semantic_at_item_kind(fact_id: int) -> word {
    give back array_get(v4_editor_sem_item_kinds, fact_id)
}

task v4_semantic_at_symbol_id(fact_id: int) -> int {
    give back word_to_int(array_get(v4_editor_sem_symbol_ids, fact_id))
}

task v4_semantic_at_name(fact_id: int) -> word {
    give back array_get(v4_editor_sem_names, fact_id)
}

task v4_semantic_at_kind(fact_id: int) -> word {
    give back array_get(v4_editor_sem_kinds, fact_id)
}

task v4_semantic_at_def(fact_id: int) -> word {
    give back array_get(v4_editor_sem_defs, fact_id)
}

task v4_semantic_at_type(fact_id: int) -> word {
    give back array_get(v4_editor_sem_types, fact_id)
}

task v4_semantic_at_summary(fact_id: int) -> word {
    pilot summary = "semantic-at id=" + word_from_int(fact_id)
    summary = summary + " path=" + v4_semantic_at_path(fact_id)
    summary = summary + " offset=" + word_from_int(v4_semantic_at_offset(fact_id))
    summary = summary + " token=" + v4_semantic_at_token_value(fact_id)
    summary = summary + " token-kind=" + v4_semantic_at_token_kind(fact_id)
    summary = summary + " item=" + v4_semantic_at_item_name(fact_id)
    summary = summary + " item-kind=" + v4_semantic_at_item_kind(fact_id)
    summary = summary + " name=" + v4_semantic_at_name(fact_id)
    summary = summary + " kind=" + v4_semantic_at_kind(fact_id)
    summary = summary + " type=" + v4_semantic_at_type(fact_id)
    give back summary
}

task v4_semantic_restore_fact_slot(fact_id: int, path: word, offset: int, token_id: int, token_kind: word, token_value: word, token_span: word, hir_item: int, item_name: word, item_kind: word, symbol_id: int, name: word, kind: word, def_id: word, type_display: word) -> int {
    v4_editor_init()
    repeat until array_len(v4_editor_sem_paths) > fact_id {
        v4_editor_semantic_fact_new("", 0, 0 - 1, "", "", V4_NO_SPAN, 0 - 1, "", "", 0 - 1, "", "", "", v4_ty_unknown)
    }

    array_set(v4_editor_sem_paths, fact_id, path)
    array_set(v4_editor_sem_offsets, fact_id, word_from_int(offset))
    array_set(v4_editor_sem_token_ids, fact_id, word_from_int(token_id))
    array_set(v4_editor_sem_token_kinds, fact_id, token_kind)
    array_set(v4_editor_sem_token_values, fact_id, token_value)
    array_set(v4_editor_sem_token_spans, fact_id, token_span)
    array_set(v4_editor_sem_hir_items, fact_id, word_from_int(hir_item))
    array_set(v4_editor_sem_item_names, fact_id, item_name)
    array_set(v4_editor_sem_item_kinds, fact_id, item_kind)
    array_set(v4_editor_sem_symbol_ids, fact_id, word_from_int(symbol_id))
    array_set(v4_editor_sem_names, fact_id, name)
    array_set(v4_editor_sem_kinds, fact_id, kind)
    array_set(v4_editor_sem_defs, fact_id, def_id)
    array_set(v4_editor_sem_types, fact_id, type_display)
    give back 1
}

task v4_semantic_at_text_cached(path: word, text: word, offset: int) -> int {
    v4_editor_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_semantic_at_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot stream_id = v4_lex_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot token_id = v4_editor_token_at(stream_id, offset)
    pilot token_kind = ""
    pilot token_value = ""
    pilot token_span = V4_NO_SPAN
    if token_id >= 0 {
        token_kind = v4_lex_token_type(stream_id, token_id)
        token_value = v4_lex_token_value(stream_id, token_id)
        token_span = v4_lex_token_span(stream_id, token_id)
    }

    pilot hir_item = v4_editor_hir_item_at(hir_id, offset)
    pilot item_name = ""
    pilot item_kind = ""
    if hir_item >= 0 {
        item_name = v4_hir_item_name(hir_id, hir_item)
        item_kind = v4_hir_item_kind(hir_id, hir_item)
    }

    pilot symbol_id = 0 - 1
    if token_value != "" {
        symbol_id = v4_resolve_lookup_any(resolve_id, token_value)
    }

    pilot name = token_value
    pilot kind = token_kind
    pilot def_id = ""
    pilot type_display = v4_ty_unknown
    if symbol_id >= 0 {
        name = v4_resolve_symbol_name(resolve_id, symbol_id)
        kind = v4_resolve_symbol_kind(resolve_id, symbol_id)
        def_id = v4_resolve_symbol_def(resolve_id, symbol_id)
        pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
        if sig_id >= 0 {
            type_display = v4_ty_signature_display(ty_id, sig_id)
        }
    } else if token_value == item_name and hir_item >= 0 {
        name = item_name
        kind = item_kind
        def_id = v4_hir_item_def(hir_id, hir_item)
        pilot item_sig_id = v4_editor_ty_signature_for_hir_item(ty_id, hir_item)
        if item_sig_id >= 0 {
            type_display = v4_ty_signature_display(ty_id, item_sig_id)
        }
    }
    if token_kind == v4_tok_lifetime and hir_item >= 0 {
        pilot lifetime_sig_id = v4_editor_ty_signature_for_hir_item(ty_id, hir_item)
        if lifetime_sig_id >= 0 {
            name = token_value
            kind = "Lifetime"
            def_id = v4_editor_lifetime_def(ty_id, lifetime_sig_id, token_value)
            type_display = v4_editor_lifetime_detail(ty_id, lifetime_sig_id, token_value)
        }
    } else if token_kind == v4_tok_ident or token_kind == v4_tok_keyword {
        pilot decl_route_sig_id = 0 - 1
        if hir_item >= 0 and item_kind == v4_hir_route {
            decl_route_sig_id = v4_editor_ty_signature_for_hir_item(ty_id, hir_item)
        }
        pilot decl_route_field_case = ""
        if decl_route_sig_id >= 0 {
            decl_route_field_case = v4_editor_route_field_decl_case_name_at_token(ty_id, decl_route_sig_id, stream_id, token_id, token_value)
        }
        if decl_route_field_case != "" {
            name = token_value
            kind = "RouteField"
            def_id = v4_editor_route_field_def(ty_id, decl_route_sig_id, decl_route_field_case, token_value)
            type_display = v4_editor_route_field_detail(ty_id, decl_route_sig_id, decl_route_field_case, token_value)
        } else if decl_route_sig_id >= 0 and v4_editor_route_case_decl_id_at_token(ty_id, decl_route_sig_id, stream_id, token_id, token_value) >= 0 {
            name = token_value
            kind = "RouteCase"
            def_id = v4_editor_route_case_def(ty_id, decl_route_sig_id, token_value)
            type_display = v4_editor_route_case_detail(ty_id, decl_route_sig_id, token_value)
        } else if symbol_id < 0 {
            pilot ref_route_field_sig_id = v4_editor_route_case_sig_for_payload_token(resolve_id, ty_id, stream_id, token_id)
            pilot ref_route_field_case = v4_editor_route_field_ref_case_name_at_token(resolve_id, ty_id, stream_id, token_id, token_value)
            if ref_route_field_sig_id >= 0 and ref_route_field_case != "" {
                name = token_value
                kind = "RouteField"
                def_id = v4_editor_route_field_def(ty_id, ref_route_field_sig_id, ref_route_field_case, token_value)
                type_display = v4_editor_route_field_detail(ty_id, ref_route_field_sig_id, ref_route_field_case, token_value)
            } else {
                pilot ref_route_sig_id = v4_editor_route_case_sig_for_reference(resolve_id, ty_id, stream_id, token_id)
                if ref_route_sig_id >= 0 and v4_ty_route_has_case(ty_id, v4_ty_signature_name(ty_id, ref_route_sig_id), token_value) {
                    name = token_value
                    kind = "RouteCase"
                    def_id = v4_editor_route_case_def(ty_id, ref_route_sig_id, token_value)
                    type_display = v4_editor_route_case_detail(ty_id, ref_route_sig_id, token_value)
                } else {
                    pilot body_id = v4_editor_body_for_offset(hir_id, stream_id, ty_id, mir_id, hir_item, offset)
                    if body_id >= 0 {
                        pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, token_value, offset)
                        if local_id >= 0 and v4_editor_local_visible_at(mir_id, body_id, local_id, offset) {
                            name = token_value
                            kind = "Local"
                            def_id = v4_editor_local_def(v4_mir_body_def(mir_id, body_id), local_id, token_value)
                            type_display = v4_mir_local_ty(mir_id, body_id, local_id)
                        }
                    }
                }
            }
        }
    }

    pilot fact_id = v4_editor_semantic_fact_new(path, offset, token_id, token_kind, token_value, token_span, hir_item, item_name, item_kind, symbol_id, name, kind, def_id, type_display)
    v4_query_store(key, fingerprint, word_from_int(fact_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    give back fact_id
}

task v4_semantic_at_text(path: word, text: word, offset: int) -> word {
    pilot fact_id = v4_semantic_at_text_cached(path, text, offset)
    give back v4_semantic_at_summary(fact_id)
}

task v4_semantic_at_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_semantic_at_text(path, text, offset)
}

task v4_editor_hover_new(path: word, offset: int, semantic_id: int, name: word, kind: word, type_display: word, markdown: word) -> int {
    v4_editor_init()
    pilot hover_id = array_len(v4_editor_hover_paths)
    array_push(v4_editor_hover_paths, path)
    array_push(v4_editor_hover_offsets, word_from_int(offset))
    array_push(v4_editor_hover_semantic_ids, word_from_int(semantic_id))
    array_push(v4_editor_hover_names, name)
    array_push(v4_editor_hover_kinds, kind)
    array_push(v4_editor_hover_types, type_display)
    array_push(v4_editor_hover_markdowns, markdown)
    give back hover_id
}

task v4_hover_count() -> int {
    v4_editor_init()
    give back array_len(v4_editor_hover_paths)
}

task v4_hover_exists(hover_id: int) -> bool {
    v4_editor_init()
    if hover_id < 0 {
        give back false
    }
    if hover_id >= array_len(v4_editor_hover_paths) {
        give back false
    }
    give back true
}

task v4_hover_path(hover_id: int) -> word {
    if v4_hover_exists(hover_id) == false {
        give back ""
    }
    give back array_get(v4_editor_hover_paths, hover_id)
}

task v4_hover_offset(hover_id: int) -> int {
    give back word_to_int(array_get(v4_editor_hover_offsets, hover_id))
}

task v4_hover_semantic_id(hover_id: int) -> int {
    give back word_to_int(array_get(v4_editor_hover_semantic_ids, hover_id))
}

task v4_hover_name(hover_id: int) -> word {
    give back array_get(v4_editor_hover_names, hover_id)
}

task v4_hover_kind(hover_id: int) -> word {
    give back array_get(v4_editor_hover_kinds, hover_id)
}

task v4_hover_type(hover_id: int) -> word {
    give back array_get(v4_editor_hover_types, hover_id)
}

task v4_hover_markdown(hover_id: int) -> word {
    give back array_get(v4_editor_hover_markdowns, hover_id)
}

task v4_hover_markdown_for_semantic(semantic_id: int) -> word {
    pilot name = v4_semantic_at_name(semantic_id)
    if name == "" {
        give back ""
    }

    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot type_display = v4_semantic_at_type(semantic_id)
    pilot item_name = v4_semantic_at_item_name(semantic_id)
    pilot item_kind = v4_semantic_at_item_kind(semantic_id)
    pilot markdown = "**" + name + "**"
    if kind != "" {
        markdown = markdown + " `" + kind + "`"
    }
    if type_display != "" and type_display != v4_ty_unknown {
        markdown = markdown + "\n\n```freak\n" + type_display + "\n```"
    } else {
        markdown = markdown + "\n\n`type: unknown`"
    }
    if item_name != "" {
        markdown = markdown + "\n\nin " + item_kind + " `" + item_name + "`"
    }
    markdown = markdown + "\n\nYuuko cache: hover <- semantic-at <- 00-Unit."
    give back markdown
}

task v4_hover_summary(hover_id: int) -> word {
    pilot summary = "hover id=" + word_from_int(hover_id)
    summary = summary + " path=" + v4_hover_path(hover_id)
    summary = summary + " offset=" + word_from_int(v4_hover_offset(hover_id))
    summary = summary + " semantic=" + word_from_int(v4_hover_semantic_id(hover_id))
    summary = summary + " name=" + v4_hover_name(hover_id)
    summary = summary + " kind=" + v4_hover_kind(hover_id)
    summary = summary + " type=" + v4_hover_type(hover_id)
    summary = summary + " markdown-bytes=" + word_from_int(v4_hover_markdown(hover_id).length())
    give back summary
}

task v4_hover_restore_slot(hover_id: int, path: word, offset: int, semantic_id: int, name: word, kind: word, type_display: word, markdown: word) -> int {
    v4_editor_init()
    repeat until array_len(v4_editor_hover_paths) > hover_id {
        v4_editor_hover_new("", 0, 0 - 1, "", "", v4_ty_unknown, "")
    }

    array_set(v4_editor_hover_paths, hover_id, path)
    array_set(v4_editor_hover_offsets, hover_id, word_from_int(offset))
    array_set(v4_editor_hover_semantic_ids, hover_id, word_from_int(semantic_id))
    array_set(v4_editor_hover_names, hover_id, name)
    array_set(v4_editor_hover_kinds, hover_id, kind)
    array_set(v4_editor_hover_types, hover_id, type_display)
    array_set(v4_editor_hover_markdowns, hover_id, markdown)
    give back 1
}

task v4_hover_text_cached(path: word, text: word, offset: int) -> int {
    v4_editor_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_hover_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot semantic_id = v4_semantic_at_text_cached(path, text, offset)
    pilot name = v4_semantic_at_name(semantic_id)
    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot type_display = v4_semantic_at_type(semantic_id)
    pilot markdown = v4_hover_markdown_for_semantic(semantic_id)
    pilot hover_id = v4_editor_hover_new(path, offset, semantic_id, name, kind, type_display, markdown)

    v4_query_store(key, fingerprint, word_from_int(hover_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_semantic_at_query_key(path, offset))
    give back hover_id
}

task v4_hover_text(path: word, text: word, offset: int) -> word {
    pilot hover_id = v4_hover_text_cached(path, text, offset)
    give back v4_hover_summary(hover_id)
}

task v4_hover_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_hover_text(path, text, offset)
}

task v4_editor_definition_new(path: word, offset: int, semantic_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, found: int) -> int {
    v4_editor_init()
    pilot defn_id = array_len(v4_editor_defn_paths)
