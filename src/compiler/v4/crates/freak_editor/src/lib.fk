task v4_definition_at_summary(defn_id: int) -> word {
    pilot summary = "definition-at id=" + word_from_int(defn_id)
    summary = summary + " path=" + v4_definition_at_path(defn_id)
    summary = summary + " offset=" + word_from_int(v4_definition_at_offset(defn_id))
    summary = summary + " semantic=" + word_from_int(v4_definition_at_semantic_id(defn_id))
    summary = summary + " found=" + word_from_int(v4_definition_at_found(defn_id))
    summary = summary + " name=" + v4_definition_at_name(defn_id)
    summary = summary + " kind=" + v4_definition_at_kind(defn_id)
    summary = summary + " def=" + v4_definition_at_def(defn_id)
    summary = summary + " span=" + v4_definition_at_span(defn_id)
    give back summary
}

task v4_definition_restore_slot(defn_id: int, path: word, offset: int, semantic_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, found: int) -> int {
    v4_editor_init()
    repeat until array_len(v4_editor_defn_paths) > defn_id {
        v4_editor_definition_new("", 0, 0 - 1, "", "", "", 0 - 1, V4_NO_SPAN, 0)
    }

    array_set(v4_editor_defn_paths, defn_id, path)
    array_set(v4_editor_defn_offsets, defn_id, word_from_int(offset))
    array_set(v4_editor_defn_semantic_ids, defn_id, word_from_int(semantic_id))
    array_set(v4_editor_defn_names, defn_id, name)
    array_set(v4_editor_defn_kinds, defn_id, kind)
    array_set(v4_editor_defn_defs, defn_id, def_id)
    array_set(v4_editor_defn_hir_items, defn_id, word_from_int(hir_item))
    array_set(v4_editor_defn_spans, defn_id, span)
    array_set(v4_editor_defn_found, defn_id, word_from_int(found))
    give back 1
}

task v4_definition_at_text_cached(path: word, text: word, offset: int) -> int {
    v4_editor_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_definition_at_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot semantic_id = v4_semantic_at_text_cached(path, text, offset)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot stream_id = v4_lex_text_cached(path, text)
    pilot name = v4_semantic_at_name(semantic_id)
    pilot kind = v4_semantic_at_kind(semantic_id)
    pilot def_id = v4_semantic_at_def(semantic_id)
    pilot hir_item = 0 - 1
    pilot span = V4_NO_SPAN
    pilot found = 0

    if kind == "Lifetime" {
        hir_item = v4_semantic_at_hir_item(semantic_id)
        if hir_item >= 0 {
            span = v4_hir_item_span(hir_id, hir_item)
            span = v4_editor_lifetime_decl_span(stream_id, span, name)
            found = 1
        }
    } else if kind == "RouteField" {
        pilot case_def = v4_editor_route_field_case_def(def_id)
        pilot field_name = v4_editor_route_field_name_from_def(def_id)
        pilot route_def = v4_editor_route_case_route_def(case_def)
        pilot case_name = v4_editor_route_case_name_from_def(case_def)
        pilot sig_id = v4_ty_lookup_signature(ty_id, route_def)
        if sig_id >= 0 {
            hir_item = v4_editor_hir_item_for_def(hir_id, route_def)
            span = v4_editor_route_field_name_span(ty_id, sig_id, case_name, field_name)
            found = 1
        }
    } else if kind == "RouteCase" {
        pilot route_def = v4_editor_route_case_route_def(def_id)
        pilot case_name = v4_editor_route_case_name_from_def(def_id)
        pilot sig_id = v4_ty_lookup_signature(ty_id, route_def)
        if sig_id >= 0 {
            hir_item = v4_editor_hir_item_for_def(hir_id, route_def)
            span = v4_editor_route_case_name_span(ty_id, sig_id, case_name)
            found = 1
        }
    } else if kind == "Local" {
        hir_item = v4_semantic_at_hir_item(semantic_id)
        pilot body_id = v4_editor_body_for_offset(hir_id, stream_id, ty_id, mir_id, hir_item, offset)
        if body_id >= 0 {
            pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, name, offset)
            if local_id >= 0 {
                span = v4_mir_local_span(mir_id, body_id, local_id)
                span = v4_editor_local_decl_span(stream_id, span, name)
                found = 1
            }
        }
    } else if def_id != "" {
        hir_item = v4_editor_hir_item_for_def(hir_id, def_id)
        if hir_item >= 0 {
            span = v4_hir_item_span(hir_id, hir_item)
            found = 1
        }
    }

    pilot defn_id = v4_editor_definition_new(path, offset, semantic_id, name, kind, def_id, hir_item, span, found)
    v4_query_store(key, fingerprint, word_from_int(defn_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_semantic_at_query_key(path, offset))
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    give back defn_id
}

task v4_definition_at_text(path: word, text: word, offset: int) -> word {
    pilot defn_id = v4_definition_at_text_cached(path, text, offset)
    give back v4_definition_at_summary(defn_id)
}

task v4_definition_at_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_definition_at_text(path, text, offset)
}

