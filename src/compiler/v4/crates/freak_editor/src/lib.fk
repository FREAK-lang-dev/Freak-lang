    v4_editor_init()
    pilot doc_id = array_len(v4_editor_doc_paths)
    array_push(v4_editor_doc_paths, path)
    array_push(v4_editor_doc_names, word_from_int(array_new()))
    array_push(v4_editor_doc_kinds, word_from_int(array_new()))
    array_push(v4_editor_doc_defs, word_from_int(array_new()))
    array_push(v4_editor_doc_hir_items, word_from_int(array_new()))
    array_push(v4_editor_doc_spans, word_from_int(array_new()))
    array_push(v4_editor_doc_types, word_from_int(array_new()))
    give back doc_id
}

task v4_document_symbols_count() -> int {
    v4_editor_init()
    give back array_len(v4_editor_doc_paths)
}

task v4_document_symbols_exists(doc_id: int) -> bool {
    v4_editor_init()
    if doc_id < 0 {
        give back false
    }
    if doc_id >= array_len(v4_editor_doc_paths) {
        give back false
    }
    give back true
