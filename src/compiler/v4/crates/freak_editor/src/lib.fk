task v4_completion_add(completion_id: int, label: word, kind: word, detail: word, insert_text: word) -> int {
    pilot item_id = array_len(v4_editor_comp_labels_handle(completion_id))
    array_push(v4_editor_comp_labels_handle(completion_id), label)
    array_push(v4_editor_comp_kinds_handle(completion_id), kind)
    array_push(v4_editor_comp_details_handle(completion_id), detail)
    array_push(v4_editor_comp_inserts_handle(completion_id), insert_text)
    give back item_id
}

task v4_completion_count(completion_id: int) -> int {
    give back array_len(v4_editor_comp_labels_handle(completion_id))
}

task v4_completion_label(completion_id: int, item_id: int) -> word {
    give back array_get(v4_editor_comp_labels_handle(completion_id), item_id)
}

task v4_completion_kind(completion_id: int, item_id: int) -> word {
    give back array_get(v4_editor_comp_kinds_handle(completion_id), item_id)
}

task v4_completion_detail(completion_id: int, item_id: int) -> word {
    give back array_get(v4_editor_comp_details_handle(completion_id), item_id)
}

task v4_completion_insert_text(completion_id: int, item_id: int) -> word {
    give back array_get(v4_editor_comp_inserts_handle(completion_id), item_id)
}

task v4_completion_add_keywords(completion_id: int) -> void {
    v4_completion_add(completion_id, "task", "keyword", "declare a task", "task ")
    v4_completion_add(completion_id, "shape", "keyword", "declare a shape", "shape ")
    v4_completion_add(completion_id, "route", "keyword", "declare a route", "route ")
    v4_completion_add(completion_id, "variant", "keyword", "declare a variant route", "variant ")
    v4_completion_add(completion_id, "alias", "keyword", "declare a type alias", "alias ")
    v4_completion_add(completion_id, "doctrine", "keyword", "declare a doctrine", "doctrine ")
    v4_completion_add(completion_id, "impl", "keyword", "implement a shape or doctrine", "impl ")
    v4_completion_add(completion_id, "use", "keyword", "import a module", "use ")
    v4_completion_add(completion_id, "extern", "keyword", "declare native bindings", "extern ")
    v4_completion_add(completion_id, "pilot", "keyword", "declare a local pilot", "pilot ")
    v4_completion_add(completion_id, "give back", "keyword", "return from a task", "give back ")
    v4_completion_add(completion_id, "if", "keyword", "conditional branch", "if ")
    v4_completion_add(completion_id, "repeat until", "keyword", "loop until a condition", "repeat until ")
    v4_completion_add(completion_id, "when", "keyword", "route matching", "when ")
}

task v4_completion_add_document_symbols(completion_id: int, doc_id: int) -> void {
    pilot symbol_id = 0
    pilot symbol_count = v4_document_symbol_count(doc_id)
    repeat until symbol_id >= symbol_count {
        pilot label = v4_document_symbol_name(doc_id, symbol_id)
        pilot kind = v4_document_symbol_kind(doc_id, symbol_id)
        pilot detail = v4_document_symbol_type(doc_id, symbol_id)
        if detail == "" or detail == v4_ty_unknown {
            detail = v4_document_symbol_def(doc_id, symbol_id)
        }
        v4_completion_add(completion_id, label, kind, detail, label)
        symbol_id += 1
    }
}

task v4_completion_has_label(completion_id: int, label: word) -> bool {
    if label == "" {
        give back false
    }
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        if v4_completion_label(completion_id, item_id) == label {
            give back true
        }
        item_id += 1
    }
    give back false
}

task v4_completion_add_locals_for_offset(completion_id: int, path: word, text: word, offset: int) -> void {
    pilot stream_id = v4_lex_text_cached(path, text)
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot mir_id = v4_mir_text_cached(path, text)
    pilot hir_item = v4_editor_hir_item_at(hir_id, offset)
    pilot body_id = v4_editor_body_for_offset(hir_id, stream_id, ty_id, mir_id, hir_item, offset)
    if body_id < 0 {
        give back
    }

    pilot local_id = 0
    pilot local_count = v4_mir_body_local_count(mir_id, body_id)
    repeat until local_id >= local_count {
        pilot label = v4_mir_local_name(mir_id, body_id, local_id)
        if label != "" and v4_editor_local_is_source_declared(stream_id, mir_id, body_id, local_id) and v4_editor_local_visible_at(mir_id, body_id, local_id, offset) {
            if not v4_completion_has_label(completion_id, label) {
                v4_completion_add(completion_id, label, "local", v4_mir_local_ty(mir_id, body_id, local_id), label)
            }
        }
        local_id += 1
    }
}

task v4_completion_add_route_fields_for_offset(completion_id: int, path: word, text: word, offset: int) -> void {
    pilot stream_id = v4_lex_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot token_id = v4_editor_token_at(stream_id, offset)
    if token_id < 0 {
        give back
    }

    pilot sig_id = v4_editor_route_case_sig_for_payload_token(resolve_id, ty_id, stream_id, token_id)
    pilot case_name = v4_editor_route_case_name_for_payload_token(resolve_id, ty_id, stream_id, token_id)
    if sig_id < 0 or case_name == "" {
        give back
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot field_id = 0
    pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
    repeat until field_id >= field_count {
        pilot field_name = v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id)
        if field_name != "" and not v4_completion_has_label(completion_id, field_name) {
            v4_completion_add(completion_id, field_name, "route-field", v4_editor_route_field_detail(ty_id, sig_id, case_name, field_name), field_name)
        }
        field_id += 1
    }
}

task v4_completion_add_lifetimes_for_offset(completion_id: int, path: word, text: word, offset: int) -> void {
    pilot hir_id = v4_hir_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot hir_item = v4_editor_hir_item_at(hir_id, offset)
    if hir_item < 0 {
        give back
    }
    pilot sig_id = v4_editor_ty_signature_for_hir_item(ty_id, hir_item)
    if sig_id < 0 {
        give back
    }

    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_signature_lifetime_count(ty_id, sig_id)
    repeat until lifetime_id >= lifetime_count {
        pilot lifetime_name = v4_ty_signature_lifetime_name(ty_id, sig_id, lifetime_id)
        v4_completion_add(completion_id, lifetime_name, "lifetime", v4_editor_lifetime_detail(ty_id, sig_id, lifetime_name), lifetime_name)
        lifetime_id += 1
    }
}

task v4_completion_summary(completion_id: int) -> word {
    pilot summary = "completion id=" + word_from_int(completion_id)
    summary = summary + " path=" + v4_completion_path(completion_id)
    summary = summary + " offset=" + word_from_int(v4_completion_offset(completion_id))
    summary = summary + " count=" + word_from_int(v4_completion_count(completion_id))
    if v4_completion_count(completion_id) > 0 {
        summary = summary + " first=" + v4_completion_label(completion_id, 0)
        summary = summary + " first-kind=" + v4_completion_kind(completion_id, 0)
    }
    give back summary
}

task v4_completion_restore_completion_slot(completion_id: int, path: word, offset: int) -> int {
    v4_editor_init()
    repeat until array_len(v4_editor_comp_paths) > completion_id {
        v4_editor_completion_new("", 0)
    }

    array_set(v4_editor_comp_paths, completion_id, path)
    array_set(v4_editor_comp_offsets, completion_id, word_from_int(offset))
    array_set(v4_editor_comp_labels, completion_id, word_from_int(array_new()))
    array_set(v4_editor_comp_kinds, completion_id, word_from_int(array_new()))
    array_set(v4_editor_comp_details, completion_id, word_from_int(array_new()))
    array_set(v4_editor_comp_inserts, completion_id, word_from_int(array_new()))
    give back 1
}

task v4_completion_restore_item_slot(completion_id: int, item_id: int, label: word, kind: word, detail: word, insert_text: word) -> int {
    if v4_completion_exists(completion_id) == false {
        give back 0
    }
    repeat until v4_completion_count(completion_id) > item_id {
        v4_completion_add(completion_id, "", "", "", "")
    }

    array_set(v4_editor_comp_labels_handle(completion_id), item_id, label)
    array_set(v4_editor_comp_kinds_handle(completion_id), item_id, kind)
    array_set(v4_editor_comp_details_handle(completion_id), item_id, detail)
    array_set(v4_editor_comp_inserts_handle(completion_id), item_id, insert_text)
    give back 1
}

task v4_completion_text_cached(path: word, text: word, offset: int) -> int {
    v4_editor_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_completion_query_key(path, offset)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot doc_id = v4_document_symbols_text_cached(path, text)
    pilot completion_id = v4_editor_completion_new(path, offset)
    v4_completion_add_document_symbols(completion_id, doc_id)
    v4_completion_add_locals_for_offset(completion_id, path, text, offset)
    v4_completion_add_route_fields_for_offset(completion_id, path, text, offset)
    v4_completion_add_lifetimes_for_offset(completion_id, path, text, offset)
    v4_completion_add_keywords(completion_id)

    v4_query_store(key, fingerprint, word_from_int(completion_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_document_symbols_query_key(path))
    v4_query_record_dep(key, v4_lex_query_key(path))
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_mir_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    give back completion_id
}

task v4_completion_text(path: word, text: word, offset: int) -> word {
    pilot completion_id = v4_completion_text_cached(path, text, offset)
    give back v4_completion_summary(completion_id)
}

task v4_completion_file(path: word, offset: int) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_completion_text(path, text, offset)
}


