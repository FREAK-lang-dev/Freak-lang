    if v4_document_symbols_exists(doc_id) == false {
        give back ""
    }
    give back array_get(v4_editor_doc_paths, doc_id)
}

task v4_editor_doc_names_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_names, doc_id))
}

task v4_editor_doc_kinds_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_kinds, doc_id))
}

task v4_editor_doc_defs_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_defs, doc_id))
}

task v4_editor_doc_hir_items_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_hir_items, doc_id))
}

task v4_editor_doc_spans_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_spans, doc_id))
}

task v4_editor_doc_types_handle(doc_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_types, doc_id))
}

task v4_document_symbols_add(doc_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, type_display: word) -> int {
    pilot symbol_id = array_len(v4_editor_doc_names_handle(doc_id))
    array_push(v4_editor_doc_names_handle(doc_id), name)
    array_push(v4_editor_doc_kinds_handle(doc_id), kind)
    array_push(v4_editor_doc_defs_handle(doc_id), def_id)
    array_push(v4_editor_doc_hir_items_handle(doc_id), word_from_int(hir_item))
    array_push(v4_editor_doc_spans_handle(doc_id), span)
    array_push(v4_editor_doc_types_handle(doc_id), type_display)
    give back symbol_id
}

task v4_document_symbol_count(doc_id: int) -> int {
    give back array_len(v4_editor_doc_names_handle(doc_id))
}

task v4_document_symbol_name(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_editor_doc_names_handle(doc_id), symbol_id)
}

task v4_document_symbol_kind(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_editor_doc_kinds_handle(doc_id), symbol_id)
}

task v4_document_symbol_def(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_editor_doc_defs_handle(doc_id), symbol_id)
}

task v4_document_symbol_hir_item(doc_id: int, symbol_id: int) -> int {
    give back word_to_int(array_get(v4_editor_doc_hir_items_handle(doc_id), symbol_id))
}

task v4_document_symbol_span(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_editor_doc_spans_handle(doc_id), symbol_id)
}

task v4_document_symbol_type(doc_id: int, symbol_id: int) -> word {
    give back array_get(v4_editor_doc_types_handle(doc_id), symbol_id)
}

task v4_document_symbols_summary(doc_id: int) -> word {
    pilot summary = "document-symbols id=" + word_from_int(doc_id)
    summary = summary + " path=" + v4_document_symbols_path(doc_id)
    summary = summary + " count=" + word_from_int(v4_document_symbol_count(doc_id))
    if v4_document_symbol_count(doc_id) > 0 {
        summary = summary + " first=" + v4_document_symbol_name(doc_id, 0)
        summary = summary + " first-kind=" + v4_document_symbol_kind(doc_id, 0)
    }
    give back summary
}

task v4_document_symbols_restore_document_slot(doc_id: int, path: word) -> int {
    v4_editor_init()
    repeat until array_len(v4_editor_doc_paths) > doc_id {
        v4_editor_document_symbols_new("")
    }

    array_set(v4_editor_doc_paths, doc_id, path)
    array_set(v4_editor_doc_names, doc_id, word_from_int(array_new()))
    array_set(v4_editor_doc_kinds, doc_id, word_from_int(array_new()))
    array_set(v4_editor_doc_defs, doc_id, word_from_int(array_new()))
    array_set(v4_editor_doc_hir_items, doc_id, word_from_int(array_new()))
    array_set(v4_editor_doc_spans, doc_id, word_from_int(array_new()))
    array_set(v4_editor_doc_types, doc_id, word_from_int(array_new()))
    give back 1
}

task v4_document_symbols_restore_symbol_slot(doc_id: int, symbol_id: int, name: word, kind: word, def_id: word, hir_item: int, span: word, type_display: word) -> int {
    if v4_document_symbols_exists(doc_id) == false {
        give back 0
    }
    repeat until v4_document_symbol_count(doc_id) > symbol_id {
        v4_document_symbols_add(doc_id, "", "", "", 0 - 1, V4_NO_SPAN, v4_ty_unknown)
    }

    array_set(v4_editor_doc_names_handle(doc_id), symbol_id, name)
    array_set(v4_editor_doc_kinds_handle(doc_id), symbol_id, kind)
    array_set(v4_editor_doc_defs_handle(doc_id), symbol_id, def_id)
    array_set(v4_editor_doc_hir_items_handle(doc_id), symbol_id, word_from_int(hir_item))
    array_set(v4_editor_doc_spans_handle(doc_id), symbol_id, span)
    array_set(v4_editor_doc_types_handle(doc_id), symbol_id, type_display)
    give back 1
}

task v4_document_symbols_text_cached(path: word, text: word) -> int {
    v4_editor_init()

    pilot file_id = v4_source_set_text(path, text)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot key = v4_document_symbols_query_key(path)
    pilot cached = v4_query_get(key, fingerprint)
    if cached != "" {
        give back word_to_int(cached)
    }

    pilot hir_id = v4_hir_text_cached(path, text)
    pilot resolve_id = v4_resolve_text_cached(path, text)
    pilot ty_id = v4_ty_text_cached(path, text)
    pilot doc_id = v4_editor_document_symbols_new(path)
    pilot symbol_id = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    repeat until symbol_id >= symbol_count {
        pilot name = v4_resolve_symbol_name(resolve_id, symbol_id)
        pilot kind = v4_resolve_symbol_kind(resolve_id, symbol_id)
        pilot def_id = v4_resolve_symbol_def(resolve_id, symbol_id)
        pilot hir_item = v4_resolve_symbol_hir_item(resolve_id, symbol_id)
        pilot span = V4_NO_SPAN
        if hir_item >= 0 {
            span = v4_hir_item_span(hir_id, hir_item)
        }
        pilot type_display = v4_ty_unknown
        pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
        if sig_id >= 0 {
            type_display = v4_ty_signature_display(ty_id, sig_id)
        }
        v4_document_symbols_add(doc_id, name, kind, def_id, hir_item, span, type_display)
        if kind == v4_hir_route and sig_id >= 0 {
            v4_editor_document_symbols_add_route_cases(doc_id, ty_id, sig_id, hir_item)
        }
        symbol_id += 1
    }

    v4_query_store(key, fingerprint, word_from_int(doc_id))
    v4_query_record_dep(key, "source:" + path)
    v4_query_record_dep(key, v4_hir_query_key(path))
    v4_query_record_dep(key, v4_resolve_query_key(path))
    v4_query_record_dep(key, v4_ty_query_key(path))
    give back doc_id
}

task v4_document_symbols_text(path: word, text: word) -> word {
    pilot doc_id = v4_document_symbols_text_cached(path, text)
    give back v4_document_symbols_summary(doc_id)
}

task v4_document_symbols_file(path: word) -> word {
    pilot text = fs::read(path)
    if text == "" {
        pilot span = v4_span_new("0", 0, 0)
        pilot diag = v4_diag_new(v4_diag_error, span, "could not read source file", path)
        give back v4_diag_render(diag, "")
    }
    give back v4_document_symbols_text(path, text)
}

