-- ===================================================================
-- freak_mir_transform - the Runtime MIR stage (architecture lane A4)
-- ===================================================================
-- Depends on freak_diag, freak_mir and freak_borrowck.
--
-- Analysis MIR (Built MIR plus Meiya's side facts for the same revision)
-- becomes Runtime MIR here, between Meiya and codegen. The target is the
-- "Runtime MIR contract" in the V4 README: every ownership action explicit,
-- and a consumer that never asks Meiya anything.
--
-- This first slice owns the Meiya handoff codegen used to make itself: a
-- current Meiya result for the MIR (reusing one the build tool already
-- has), no Meiya errors, a clean result with valid local drop facts for
-- every body Runtime MIR carries, and the published, sealed drop plan.
-- Codegen asks this crate, never Meiya. Turning the drop plan into Drop,
-- DropIf and DropSlot statements and cleanup blocks is the next slice; until
-- then the sealed drop plan is the Runtime MIR's ownership record.
--
-- The crate references no lexer, parser, expansion, HIR, Resolve or LLVM
-- emission task (guarded in check_v4.py).

pilot v4_mir_transform_mir = 0 - 1
pilot v4_mir_transform_borrow = 0 - 1

-- Drops the Runtime MIR facts (and the drop plan they own).
task v4_mir_transform_release() -> void {
    v4_mir_drop_plan_release()
    v4_mir_transform_mir = 0 - 1
    v4_mir_transform_borrow = 0 - 1
}

-- The next body at or after body_id that Runtime MIR carries. Generic
-- templates are lowered per instance, never as themselves.
task v4_mir_transform_next_body(mir_id: int, body_id: int) -> int {
    pilot body = body_id
    repeat until body >= v4_mir_body_count(mir_id) or not v4_mir_body_is_generic_template(mir_id, body) { body += 1 }
    give back body
}

-- Meiya must have checked this MIR without errors, and every carried body
-- needs a clean result whose word locals have a Drop or DropIf fact (or
-- none). Returns "" or the reason.
task v4_mir_transform_meiya_error(borrow_id: int, mir_id: int) -> word {
    if v4_borrowck_mir_id(borrow_id) != mir_id { give back "native word ownership plan does not match MIR" }
    pilot diag = 0
    repeat until diag >= v4_borrowck_diag_count(borrow_id) {
        if v4_diag_severity(v4_borrowck_diag(borrow_id, diag)) >= v4_diag_error { give back "Meiya errors prevent native word ownership lowering" }
        diag += 1
    }
    pilot results = v4_borrowck_result_def_index_new(borrow_id)
    pilot error = ""
    pilot body = 0
    body = v4_mir_transform_next_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) or error != "" {
        pilot borrow_result = v4_borrowck_result_def_index_find(results, borrow_id, v4_mir_body_def(mir_id, body))
        if borrow_result < 0 or v4_borrowck_result_status(borrow_id, borrow_result) != "clean" { error = "missing clean Meiya result for native word ownership lowering" } else {
            v4_borrowck_mention_begin(mir_id, body)
            pilot local = 0
            repeat until local >= v4_mir_body_local_count(mir_id, body) or error != "" {
                pilot drop_kind = v4_borrowck_word_local_drop_kind(borrow_id, borrow_result, mir_id, body, local)
                if drop_kind != "" and drop_kind != v4_borrowck_path_drop and drop_kind != v4_borrowck_path_drop_if { error = "invalid native word local drop fact" }
                local += 1
            }
            v4_borrowck_mention_end()
        }
        body = v4_mir_transform_next_body(mir_id, body + 1)
    }
    if results >= 0 { array_release(results) }
    give back error
}

-- Make mir_id Runtime MIR. borrow_id is a Meiya result the caller already
-- holds, or -1; one that is not the latest check of this MIR's current
-- shape is replaced by a fresh check. Returns "" or why the MIR cannot
-- become Runtime MIR; on failure nothing stays published.
task v4_mir_transform_runtime(file_id: int, mir_id: int, borrow_id: int) -> word {
    v4_mir_transform_release()
    pilot borrow = borrow_id
    if not v4_borrowck_result_is_current(borrow, mir_id) { borrow = v4_borrowck_check_mir(file_id, mir_id) }
    pilot error = v4_mir_transform_meiya_error(borrow, mir_id)
    -- Meiya publishes and seals the drop plan Runtime MIR carries.
    if error == "" { error = v4_borrowck_publish_drop_plan(borrow, mir_id) }
    if error == "" and not v4_mir_drop_plan_ready(mir_id) { error = "native drop plan is not sealed for this MIR" }
    if error != "" {
        v4_mir_transform_release()
        give back error
    }
    v4_mir_transform_mir = mir_id
    v4_mir_transform_borrow = borrow
    give back ""
}

task v4_mir_transform_ready(mir_id: int) -> bool {
    give back mir_id >= 0 and v4_mir_transform_mir == mir_id and v4_mir_drop_plan_ready(mir_id)
}

-- The Meiya result this Runtime MIR was built from, or -1. An identity for
-- bookkeeping only: a consumer must not query Meiya with it.
task v4_mir_transform_borrow_id(mir_id: int) -> int {
    if not v4_mir_transform_ready(mir_id) { give back 0 - 1 }
    give back v4_mir_transform_borrow
}
