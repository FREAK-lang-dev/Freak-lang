task v4_lsp_unit_snapshot_health_text(payload: word) -> word {
    if payload.starts_with("00-unit-diff-input") {
        give back v4_lsp_response_ok("workspace/unitSnapshotHealth", v4_unit_snapshot_health_from_diff_input(payload))
    }
    give back v4_lsp_response_ok("workspace/unitSnapshotHealth", v4_unit_snapshot_health(payload))
}

