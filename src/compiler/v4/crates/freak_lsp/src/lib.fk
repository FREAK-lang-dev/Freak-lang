task v4_lsp_query_snapshot_confirm_document(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("workspace/querySnapshotConfirm", 0 - 32004, "document not open")
    }
    give back v4_lsp_query_snapshot_confirm_text(path, v4_lsp_document_text(doc_id))
}

task v4_lsp_response_ok(method: word, body: word) -> word {
    give back "ok|" + method + "\n" + body
}

task v4_lsp_response_error(method: word, code: int, message: word) -> word {
    give back "error|" + method + "|" + word_from_int(code) + "|" + message
}

task v4_lsp_line_from_offset(source: word, offset: int) -> int {
    give back v4_offset_line(source, offset) - 1
}

task v4_lsp_character_from_offset(source: word, offset: int) -> int {
    give back v4_offset_col(source, offset) - 1
}

task v4_lsp_offset_from_position(source: word, line: int, character_pos: int) -> int {
    pilot safe_line = line
    pilot safe_character = character_pos
    if safe_line < 0 {
        safe_line = 0
    }
    if safe_character < 0 {
        safe_character = 0
    }

    pilot start_pos = v4_line_start(source, safe_line + 1)
    pilot end_pos = start_pos
    repeat until end_pos >= source.length() or source.char_at(end_pos) == "\n" {
        end_pos += 1
    }
    pilot wanted = start_pos + safe_character
    if wanted > end_pos {
        give back end_pos
    }
    give back wanted
}

task v4_lsp_range_from_span(span: word, source: word) -> word {
    pilot start_pos = v4_span_start(span)
    pilot end_pos = v4_span_end(span)
    pilot range = "range"
    range = range + "|" + word_from_int(v4_lsp_line_from_offset(source, start_pos))
    range = range + "|" + word_from_int(v4_lsp_character_from_offset(source, start_pos))
    range = range + "|" + word_from_int(v4_lsp_line_from_offset(source, end_pos))
    range = range + "|" + word_from_int(v4_lsp_character_from_offset(source, end_pos))
    give back range
}

task v4_lsp_location(path: word, span: word, source: word) -> word {
    pilot start_pos = v4_span_start(span)
    pilot end_pos = v4_span_end(span)
    pilot location = "location|" + path
    location = location + "|" + word_from_int(v4_lsp_line_from_offset(source, start_pos))
    location = location + "|" + word_from_int(v4_lsp_character_from_offset(source, start_pos))
    location = location + "|" + word_from_int(v4_lsp_line_from_offset(source, end_pos))
    location = location + "|" + word_from_int(v4_lsp_character_from_offset(source, end_pos))
    give back location
}

task v4_lsp_completion_item(label: word, kind: word, detail: word, insert_text: word) -> word {
    give back "completion-item|" + label + "|" + kind + "|" + detail + "|" + insert_text
}

task v4_lsp_symbol_item(name: word, kind: word, span: word, source: word) -> word {
    give back "symbol|" + name + "|" + kind + "|" + v4_lsp_range_from_span(span, source)
}

task v4_lsp_diagnostic_item(diag: word, source: word) -> word {
    pilot item = "diagnostic"
    item = item + "|" + v4_diag_severity_name(v4_diag_severity(diag))
    item = item + "|" + v4_lsp_range_from_span(v4_diag_span(diag), source)
    item = item + "|" + v4_diag_message(diag)
    item = item + "|" + v4_diag_help(diag)
    give back item
}

task v4_lsp_hover_text(path: word, text: word, offset: int) -> word {
    pilot hover_id = v4_hover_text_cached(path, text, offset)
    pilot markdown = v4_hover_markdown(hover_id)
    if markdown == "" {
        give back v4_lsp_response_error("textDocument/hover", 0 - 32001, "no hover available")
    }
    give back v4_lsp_response_ok("textDocument/hover", "hover|markdown\n" + markdown)
}

task v4_lsp_definition_text(path: word, text: word, offset: int) -> word {
    pilot defn_id = v4_definition_at_text_cached(path, text, offset)
    if v4_definition_at_found(defn_id) == 0 {
        give back v4_lsp_response_ok("textDocument/definition", "location|missing")
    }
    pilot out = v4_lsp_location(path, v4_definition_at_span(defn_id), text)
    out = out + "|" + v4_definition_at_name(defn_id)
    out = out + "|" + v4_definition_at_kind(defn_id)
    give back v4_lsp_response_ok("textDocument/definition", out)
}

task v4_lsp_document_symbols_text(path: word, text: word) -> word {
    pilot doc_id = v4_document_symbols_text_cached(path, text)
    pilot out = "document-symbols|" + word_from_int(v4_document_symbol_count(doc_id))
    pilot symbol_id = 0
    pilot symbol_count = v4_document_symbol_count(doc_id)
    repeat until symbol_id >= symbol_count {
        out = out + "\n"
        out = out + v4_lsp_symbol_item(v4_document_symbol_name(doc_id, symbol_id), v4_document_symbol_kind(doc_id, symbol_id), v4_document_symbol_span(doc_id, symbol_id), text)
        out = out + "|" + v4_document_symbol_type(doc_id, symbol_id)
        symbol_id += 1
    }
    give back v4_lsp_response_ok("textDocument/documentSymbol", out)
}

task v4_lsp_completion_text(path: word, text: word, offset: int) -> word {
    pilot completion_id = v4_completion_text_cached(path, text, offset)
    pilot out = "completion|" + word_from_int(v4_completion_count(completion_id))
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        out = out + "\n"
        out = out + v4_lsp_completion_item(v4_completion_label(completion_id, item_id), v4_completion_kind(completion_id, item_id), v4_completion_detail(completion_id, item_id), v4_completion_insert_text(completion_id, item_id))
        item_id += 1
    }
    give back v4_lsp_response_ok("textDocument/completion", out)
}

task v4_lsp_diagnostics_text(path: word, text: word) -> word {
    pilot diagnostics_id = v4_diagnostics_text_cached(path, text)
    pilot out = "diagnostics|" + word_from_int(v4_diagnostics_count(diagnostics_id))
    pilot diag_id = 0
    pilot diag_count = v4_diagnostics_count(diagnostics_id)
    repeat until diag_id >= diag_count {
        pilot diag = v4_diagnostics_diag(diagnostics_id, diag_id)
        out = out + "\n"
        out = out + v4_lsp_diagnostic_item(diag, text)
        diag_id += 1
    }
    give back v4_lsp_response_ok("textDocument/publishDiagnostics", out)
}

task v4_lsp_query_telemetry_text() -> word {
    pilot out = v4_query_telemetry_summary()
    pilot telemetry_id = 0
    pilot telemetry_count = v4_query_telemetry_key_count()
    repeat until telemetry_id >= telemetry_count {
        out = out + "\n"
        out = out + "query"
        out = out + "|" + v4_query_telemetry_key(telemetry_id)
        out = out + "|hits=" + word_from_int(v4_query_telemetry_hits_for(telemetry_id))
        out = out + "|misses=" + word_from_int(v4_query_telemetry_misses_for(telemetry_id))
        out = out + "|stores=" + word_from_int(v4_query_telemetry_stores_for(telemetry_id))
        telemetry_id += 1
    }
    give back v4_lsp_response_ok("workspace/queryTelemetry", out)
}

task v4_lsp_query_graph_text(root_key: word) -> word {
    pilot out = v4_query_graph_summary()
    if root_key != "" {
        out = out + "\n"
        out = out + v4_query_dependency_summary(root_key)
        pilot dependent_id = 0
        pilot dependent_count = v4_query_direct_dependent_count(root_key)
        repeat until dependent_id >= dependent_count {
            out = out + "\n"
            out = out + "dependent"
            out = out + "|" + root_key
            out = out + "|" + v4_query_direct_dependent_at(root_key, dependent_id)
            dependent_id += 1
        }
    }

    pilot dep_id = 0
    pilot dep_count = v4_query_dep_count()
    repeat until dep_id >= dep_count {
        out = out + "\n"
        out = out + "edge"
        out = out + "|" + v4_query_dep_from_key(dep_id)
        out = out + "|" + v4_query_dep_to_key(dep_id)
        dep_id += 1
    }
    give back v4_lsp_response_ok("workspace/queryGraph", out)
}

task v4_lsp_query_explain_text(key: word) -> word {
    give back v4_lsp_response_ok("workspace/queryExplain", v4_query_explain(key))
}

task v4_lsp_query_snapshot_text() -> word {
