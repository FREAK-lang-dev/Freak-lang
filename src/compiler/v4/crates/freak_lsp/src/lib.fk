task v4_lsp_hover_position_text(path: word, text: word, line: int, character_pos: int) -> word {
    pilot offset = v4_lsp_offset_from_position(text, line, character_pos)
    give back v4_lsp_hover_text(path, text, offset)
}

task v4_lsp_definition_position_text(path: word, text: word, line: int, character_pos: int) -> word {
    pilot offset = v4_lsp_offset_from_position(text, line, character_pos)
    give back v4_lsp_definition_text(path, text, offset)
}

task v4_lsp_completion_position_text(path: word, text: word, line: int, character_pos: int) -> word {
    pilot offset = v4_lsp_offset_from_position(text, line, character_pos)
    give back v4_lsp_completion_text(path, text, offset)
}

task v4_lsp_hover_position_document(path: word, line: int, character_pos: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/hover", 0 - 32004, "document not open")
    }
    give back v4_lsp_hover_position_text(path, v4_lsp_document_text(doc_id), line, character_pos)
}

task v4_lsp_definition_position_document(path: word, line: int, character_pos: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/definition", 0 - 32004, "document not open")
    }
    give back v4_lsp_definition_position_text(path, v4_lsp_document_text(doc_id), line, character_pos)
}

task v4_lsp_completion_position_document(path: word, line: int, character_pos: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/completion", 0 - 32004, "document not open")
    }
    give back v4_lsp_completion_position_text(path, v4_lsp_document_text(doc_id), line, character_pos)
}

task v4_lsp_initialize_payload() -> word {
    pilot out = "capabilities"
    out = out + "|textDocument/hover"
    out = out + "|textDocument/definition"
    out = out + "|textDocument/documentSymbol"
    out = out + "|textDocument/completion"
    out = out + "|textDocument/publishDiagnostics"
    out = out + "|workspace/queryTelemetry"
    out = out + "|workspace/queryGraph"
    out = out + "|workspace/queryExplain"
    out = out + "|workspace/querySnapshot"
    out = out + "|workspace/querySnapshotImport"
    out = out + "|workspace/querySnapshotRestore"
    out = out + "|workspace/querySnapshotConfirm"
    out = out + "|workspace/lexSnapshot"
    out = out + "|workspace/lexSnapshotRestore"
    out = out + "|workspace/parseSnapshot"
    out = out + "|workspace/parseSnapshotRestore"
    out = out + "|workspace/hirSnapshot"
    out = out + "|workspace/hirSnapshotRestore"
    out = out + "|workspace/resolveSnapshot"
    out = out + "|workspace/resolveSnapshotRestore"
    out = out + "|workspace/tySnapshot"
    out = out + "|workspace/tySnapshotRestore"
    out = out + "|workspace/mirSnapshot"
    out = out + "|workspace/mirSnapshotRestore"
    out = out + "|workspace/borrowckSnapshot"
    out = out + "|workspace/borrowckSnapshotRestore"
    out = out + "|workspace/diagnosticsSnapshot"
    out = out + "|workspace/diagnosticsSnapshotRestore"
    out = out + "|workspace/semanticSnapshot"
    out = out + "|workspace/semanticSnapshotRestore"
    out = out + "|workspace/hoverSnapshot"
    out = out + "|workspace/hoverSnapshotRestore"
    out = out + "|workspace/definitionSnapshot"
    out = out + "|workspace/definitionSnapshotRestore"
    out = out + "|workspace/documentSymbolsSnapshot"
    out = out + "|workspace/documentSymbolsSnapshotRestore"
    out = out + "|workspace/completionSnapshot"
    out = out + "|workspace/completionSnapshotRestore"
    out = out + "|workspace/unitSnapshot"
    out = out + "|workspace/unitSnapshotManifest"
    out = out + "|workspace/unitSnapshotHealth"
    out = out + "|workspace/unitSnapshotDiff"
    out = out + "|workspace/unitSnapshotRestore"
    out = out + "|textDocument/didOpen"
    out = out + "|textDocument/didChange"
    give back out
}

task v4_lsp_handle_text_request(method: word, path: word, text: word, offset: int) -> word {
    if method == "initialize" {
        give back v4_lsp_response_ok(method, v4_lsp_initialize_payload())
    }
    if method == "shutdown" {
        give back v4_lsp_response_ok(method, "shutdown|ok")
    }
    if method == "textDocument/didOpen" {
        v4_lsp_open_document(path, text)
        give back v4_lsp_response_ok(method, v4_lsp_document_summary(path))
    }
    if method == "textDocument/didChange" {
        pilot generation = v4_lsp_change_document_generation(path, text)
        give back v4_lsp_response_ok(method, v4_lsp_document_summary(path) + "\n" + v4_lsp_invalidation_summary_at_generation(path, generation))
    }
    if method == "textDocument/hover" {
        give back v4_lsp_hover_text(path, text, offset)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_text(path, text, offset)
    }
    if method == "textDocument/documentSymbol" {
        give back v4_lsp_document_symbols_text(path, text)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_text(path, text, offset)
    }
    if method == "textDocument/publishDiagnostics" {
        give back v4_lsp_diagnostics_text(path, text)
    }
    if method == "workspace/queryTelemetry" {
        give back v4_lsp_query_telemetry_text()
    }
    if method == "workspace/queryGraph" {
        give back v4_lsp_query_graph_text("source:" + path)
    }
    if method == "workspace/queryExplain" {
        give back v4_lsp_query_explain_text("source:" + path)
    }
    if method == "workspace/querySnapshot" {
        give back v4_lsp_query_snapshot_text()
    }
    if method == "workspace/querySnapshotImport" {
        give back v4_lsp_query_snapshot_import_text(text)
    }
    if method == "workspace/querySnapshotRestore" {
        give back v4_lsp_query_snapshot_restore_text(text)
    }
    if method == "workspace/querySnapshotConfirm" {
        give back v4_lsp_query_snapshot_confirm_text(path, text)
    }
    if method == "workspace/lexSnapshot" {
        give back v4_lsp_lex_snapshot_text()
    }
    if method == "workspace/lexSnapshotRestore" {
        give back v4_lsp_lex_snapshot_restore_text(text)
    }
    if method == "workspace/parseSnapshot" {
        give back v4_lsp_parse_snapshot_text()
    }
    if method == "workspace/parseSnapshotRestore" {
        give back v4_lsp_parse_snapshot_restore_text(text)
    }
    if method == "workspace/hirSnapshot" {
        give back v4_lsp_hir_snapshot_text()
    }
    if method == "workspace/hirSnapshotRestore" {
        give back v4_lsp_hir_snapshot_restore_text(text)
    }
    if method == "workspace/resolveSnapshot" {
        give back v4_lsp_resolve_snapshot_text()
    }
    if method == "workspace/resolveSnapshotRestore" {
        give back v4_lsp_resolve_snapshot_restore_text(text)
    }
    if method == "workspace/tySnapshot" {
        give back v4_lsp_ty_snapshot_text()
    }
    if method == "workspace/tySnapshotRestore" {
        give back v4_lsp_ty_snapshot_restore_text(text)
    }
    if method == "workspace/mirSnapshot" {
        give back v4_lsp_mir_snapshot_text()
    }
    if method == "workspace/mirSnapshotRestore" {
        give back v4_lsp_mir_snapshot_restore_text(text)
    }
    if method == "workspace/borrowckSnapshot" {
        give back v4_lsp_borrowck_snapshot_text()
    }
    if method == "workspace/borrowckSnapshotRestore" {
        give back v4_lsp_borrowck_snapshot_restore_text(text)
    }
    if method == "workspace/diagnosticsSnapshot" {
        give back v4_lsp_diagnostics_snapshot_text()
    }
    if method == "workspace/diagnosticsSnapshotRestore" {
        give back v4_lsp_diagnostics_snapshot_restore_text(text)
    }
    if method == "workspace/semanticSnapshot" {
        give back v4_lsp_semantic_snapshot_text()
    }
    if method == "workspace/semanticSnapshotRestore" {
        give back v4_lsp_semantic_snapshot_restore_text(text)
    }
    if method == "workspace/hoverSnapshot" {
        give back v4_lsp_hover_snapshot_text()
    }
    if method == "workspace/hoverSnapshotRestore" {
        give back v4_lsp_hover_snapshot_restore_text(text)
    }
    if method == "workspace/definitionSnapshot" {
        give back v4_lsp_definition_snapshot_text()
    }
    if method == "workspace/definitionSnapshotRestore" {
        give back v4_lsp_definition_snapshot_restore_text(text)
    }
    if method == "workspace/documentSymbolsSnapshot" {
        give back v4_lsp_document_symbols_snapshot_text()
    }
    if method == "workspace/documentSymbolsSnapshotRestore" {
        give back v4_lsp_document_symbols_snapshot_restore_text(text)
    }
    if method == "workspace/completionSnapshot" {
        give back v4_lsp_completion_snapshot_text()
    }
    if method == "workspace/completionSnapshotRestore" {
        give back v4_lsp_completion_snapshot_restore_text(text)
    }
    if method == "workspace/unitSnapshot" {
        give back v4_lsp_unit_snapshot_text()
    }
    if method == "workspace/unitSnapshotManifest" {
        give back v4_lsp_unit_snapshot_manifest_text(text)
    }
    if method == "workspace/unitSnapshotHealth" {
        give back v4_lsp_unit_snapshot_health_text(text)
    }
    if method == "workspace/unitSnapshotDiff" {
        give back v4_lsp_unit_snapshot_diff_text(text)
    }
    if method == "workspace/unitSnapshotRestore" {
        give back v4_lsp_unit_snapshot_restore_text(text)
    }
    give back v4_lsp_response_error(method, 0 - 32601, "method not found")
}

task v4_lsp_handle_position_text_request(method: word, path: word, text: word, line: int, character_pos: int) -> word {
    if method == "textDocument/hover" {
        give back v4_lsp_hover_position_text(path, text, line, character_pos)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_position_text(path, text, line, character_pos)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_position_text(path, text, line, character_pos)
    }
    if method == "textDocument/documentSymbol" {
        give back v4_lsp_document_symbols_text(path, text)
    }
    if method == "textDocument/publishDiagnostics" {
        give back v4_lsp_diagnostics_text(path, text)
    }
    give back v4_lsp_handle_text_request(method, path, text, v4_lsp_offset_from_position(text, line, character_pos))
}

task v4_lsp_handle_request(method: word, path: word, offset: int) -> word {
    if method == "initialize" {
        give back v4_lsp_response_ok(method, v4_lsp_initialize_payload())
    }
    if method == "shutdown" {
        give back v4_lsp_response_ok(method, "shutdown|ok")
    }
    if method == "textDocument/hover" {
        give back v4_lsp_hover_document(path, offset)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_document(path, offset)
    }
    if method == "textDocument/documentSymbol" {
        give back v4_lsp_document_symbols_document(path)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_document(path, offset)
    }
    if method == "textDocument/publishDiagnostics" {
        give back v4_lsp_diagnostics_document(path)
    }
    if method == "workspace/queryTelemetry" {
        give back v4_lsp_query_telemetry_text()
    }
    if method == "workspace/queryGraph" {
        give back v4_lsp_query_graph_text("source:" + path)
    }
    if method == "workspace/queryExplain" {
        give back v4_lsp_query_explain_text("source:" + path)
    }
    if method == "workspace/querySnapshot" {
        give back v4_lsp_query_snapshot_text()
    }
    if method == "workspace/querySnapshotImport" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/querySnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/querySnapshotConfirm" {
        give back v4_lsp_query_snapshot_confirm_document(path)
    }
    if method == "workspace/lexSnapshot" {
        give back v4_lsp_lex_snapshot_text()
    }
    if method == "workspace/lexSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/parseSnapshot" {
        give back v4_lsp_parse_snapshot_text()
    }
    if method == "workspace/parseSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/hirSnapshot" {
        give back v4_lsp_hir_snapshot_text()
    }
    if method == "workspace/hirSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/resolveSnapshot" {
        give back v4_lsp_resolve_snapshot_text()
    }
    if method == "workspace/resolveSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/tySnapshot" {
        give back v4_lsp_ty_snapshot_text()
    }
    if method == "workspace/tySnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/mirSnapshot" {
        give back v4_lsp_mir_snapshot_text()
    }
    if method == "workspace/mirSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/borrowckSnapshot" {
        give back v4_lsp_borrowck_snapshot_text()
    }
    if method == "workspace/borrowckSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/diagnosticsSnapshot" {
        give back v4_lsp_diagnostics_snapshot_text()
    }
    if method == "workspace/diagnosticsSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/semanticSnapshot" {
        give back v4_lsp_semantic_snapshot_text()
    }
    if method == "workspace/semanticSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/hoverSnapshot" {
        give back v4_lsp_hover_snapshot_text()
    }
    if method == "workspace/hoverSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/definitionSnapshot" {
        give back v4_lsp_definition_snapshot_text()
    }
    if method == "workspace/definitionSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/documentSymbolsSnapshot" {
        give back v4_lsp_document_symbols_snapshot_text()
    }
    if method == "workspace/documentSymbolsSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/completionSnapshot" {
        give back v4_lsp_completion_snapshot_text()
    }
    if method == "workspace/completionSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "workspace/unitSnapshot" {
        give back v4_lsp_unit_snapshot_text()
    }
    if method == "workspace/unitSnapshotManifest" {
        give back v4_lsp_unit_snapshot_manifest_current()
    }
    if method == "workspace/unitSnapshotHealth" {
        give back v4_lsp_unit_snapshot_health_current()
    }
    if method == "workspace/unitSnapshotDiff" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot diff input")
    }
    if method == "workspace/unitSnapshotRestore" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "textDocument/didOpen" or method == "textDocument/didChange" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires source text")
    }
    give back v4_lsp_response_error(method, 0 - 32601, "method not found")
}

task v4_lsp_handle_position_request(method: word, path: word, line: int, character_pos: int) -> word {
    if method == "textDocument/hover" {
        give back v4_lsp_hover_position_document(path, line, character_pos)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_position_document(path, line, character_pos)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_position_document(path, line, character_pos)
    }
    give back v4_lsp_handle_request(method, path, 0)
}
