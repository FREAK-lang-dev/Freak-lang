-- ===================================================================
-- freak_lsp - V4 editor-facing query facade
-- ===================================================================
-- Depends on freak_driver. This crate owns no compiler facts; it only
-- formats driver query results into stable line payloads that a future
-- JSON-RPC daemon can wrap as Language Server Protocol responses.

pilot v4_lsp_doc_paths = 0
pilot v4_lsp_doc_texts = 0
pilot v4_lsp_doc_revisions = 0
pilot v4_lsp_ready = 0

task v4_lsp_init() -> void {
    v4_driver_init()
    if v4_lsp_ready == 0 {
        v4_lsp_doc_paths = array_new()
        v4_lsp_doc_texts = array_new()
        v4_lsp_doc_revisions = array_new()
        v4_lsp_ready = 1
    }
}

task v4_lsp_find_document(path: word) -> int {
    v4_lsp_init()
    pilot doc_id = 0
    pilot doc_count = array_len(v4_lsp_doc_paths)
    repeat until doc_id >= doc_count {
        if array_get(v4_lsp_doc_paths, doc_id) == path {
            give back doc_id
        }
        doc_id += 1
    }
    give back 0 - 1
}

task v4_lsp_document_count() -> int {
    v4_lsp_init()
    give back array_len(v4_lsp_doc_paths)
}

task v4_lsp_document_path(doc_id: int) -> word {
    v4_lsp_init()
    give back array_get(v4_lsp_doc_paths, doc_id)
}

task v4_lsp_document_text(doc_id: int) -> word {
    v4_lsp_init()
    give back array_get(v4_lsp_doc_texts, doc_id)
}

task v4_lsp_document_revision(doc_id: int) -> int {
    v4_lsp_init()
    give back word_to_int(array_get(v4_lsp_doc_revisions, doc_id))
}

task v4_lsp_open_document(path: word, text: word) -> int {
    v4_lsp_init()
    pilot existing = v4_lsp_find_document(path)
    v4_source_set_text(path, text)
    if existing >= 0 {
        pilot revision = v4_lsp_document_revision(existing) + 1
        array_set(v4_lsp_doc_texts, existing, text)
        array_set(v4_lsp_doc_revisions, existing, word_from_int(revision))
        give back existing
    }

    pilot doc_id = array_len(v4_lsp_doc_paths)
    array_push(v4_lsp_doc_paths, path)
    array_push(v4_lsp_doc_texts, text)
    array_push(v4_lsp_doc_revisions, "1")
    give back doc_id
}

task v4_lsp_change_document(path: word, text: word) -> int {
    pilot doc_id = v4_lsp_open_document(path, text)
    v4_lsp_invalidate_document_queries(path)
    give back doc_id
}

task v4_lsp_document_id_or_missing(path: word) -> int {
    pilot doc_id = v4_lsp_find_document(path)
    give back doc_id
}

task v4_lsp_document_summary(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back "document missing path=" + path
    }
    pilot out = "document id=" + word_from_int(doc_id)
    out = out + " path=" + v4_lsp_document_path(doc_id)
    out = out + " rev=" + word_from_int(v4_lsp_document_revision(doc_id))
    out = out + " bytes=" + word_from_int(v4_lsp_document_text(doc_id).length())
    give back out
}

task v4_lsp_invalidation_key_matches(path: word, key: word) -> bool {
    if key.starts_with(v4_check_syntax_query_key(path)) { give back true }
    if key.starts_with(v4_lex_query_key(path)) { give back true }
    if key.starts_with(v4_parse_query_key(path)) { give back true }
    if key.starts_with(v4_hir_query_key(path)) { give back true }
    if key.starts_with(v4_resolve_query_key(path)) { give back true }
    if key.starts_with(v4_ty_query_key(path)) { give back true }
    if key.starts_with(v4_mir_query_key(path)) { give back true }
    if key.starts_with(v4_borrowck_query_key(path)) { give back true }
    if key.starts_with(v4_diagnostics_query_key(path)) { give back true }
    if key.starts_with("semantic-at:" + path + ":") { give back true }
    if key.starts_with("hover:" + path + ":") { give back true }
    if key.starts_with("definition-at:" + path + ":") { give back true }
    if key.starts_with(v4_document_symbols_query_key(path)) { give back true }
    if key.starts_with("completion:" + path + ":") { give back true }
    give back false
}

task v4_lsp_invalidate_document_queries(path: word) -> int {
    pilot generation = v4_query_bump_generation("didChange:" + path)
    pilot reason = "didChange:" + path
    give back v4_query_invalidate_dependents_at_generation("source:" + path, generation, reason)
}

task v4_lsp_invalidation_summary(path: word) -> word {
    pilot invalidated = 0
    pilot last_generation = 0
    pilot first_key = ""
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        if v4_lsp_invalidation_key_matches(path, key) {
            invalidated += 1
            last_generation = v4_query_invalidated_generation(idx)
            if first_key == "" {
                first_key = key
            }
        }
        idx += 1
    }

    pilot out = "invalidation path=" + path
    out = out + " generation=" + word_from_int(last_generation)
    out = out + " invalidated=" + word_from_int(invalidated)
    out = out + " dirty=" + word_from_int(v4_query_dirty_count())
    if first_key != "" {
        out = out + " first=" + first_key
    }
    give back out
}

task v4_lsp_hover_document(path: word, offset: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/hover", 0 - 32004, "document not open")
    }
    give back v4_lsp_hover_text(path, v4_lsp_document_text(doc_id), offset)
}

task v4_lsp_definition_document(path: word, offset: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/definition", 0 - 32004, "document not open")
    }
    give back v4_lsp_definition_text(path, v4_lsp_document_text(doc_id), offset)
}

task v4_lsp_document_symbols_document(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/documentSymbol", 0 - 32004, "document not open")
    }
    give back v4_lsp_document_symbols_text(path, v4_lsp_document_text(doc_id))
}

task v4_lsp_completion_document(path: word, offset: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/completion", 0 - 32004, "document not open")
    }
    give back v4_lsp_completion_text(path, v4_lsp_document_text(doc_id), offset)
}

task v4_lsp_diagnostics_document(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/publishDiagnostics", 0 - 32004, "document not open")
    }
    give back v4_lsp_diagnostics_text(path, v4_lsp_document_text(doc_id))
}

task v4_lsp_response_ok(method: word, body: word) -> word {
    give back "ok|" + method + "\n" + body
}

task v4_lsp_response_error(method: word, code: int, message: word) -> word {
    give back "error|" + method + "|" + word_from_int(code) + "|" + message
}

task v4_lsp_line_from_offset(source: word, offset: int) -> int {
    give back v4_offset_line(source, offset) - 1
}

task v4_lsp_character_from_offset(source: word, offset: int) -> int {
    give back v4_offset_col(source, offset) - 1
}

task v4_lsp_offset_from_position(source: word, line: int, character_pos: int) -> int {
    pilot safe_line = line
    pilot safe_character = character_pos
    if safe_line < 0 {
        safe_line = 0
    }
    if safe_character < 0 {
        safe_character = 0
    }

    pilot start_pos = v4_line_start(source, safe_line + 1)
    pilot end_pos = start_pos
    repeat until end_pos >= source.length() or source.char_at(end_pos) == "\n" {
        end_pos += 1
    }
    pilot wanted = start_pos + safe_character
    if wanted > end_pos {
        give back end_pos
    }
    give back wanted
}

task v4_lsp_range_from_span(span: word, source: word) -> word {
    pilot start_pos = v4_span_start(span)
    pilot end_pos = v4_span_end(span)
    pilot range = "range"
    range = range + "|" + word_from_int(v4_lsp_line_from_offset(source, start_pos))
    range = range + "|" + word_from_int(v4_lsp_character_from_offset(source, start_pos))
    range = range + "|" + word_from_int(v4_lsp_line_from_offset(source, end_pos))
    range = range + "|" + word_from_int(v4_lsp_character_from_offset(source, end_pos))
    give back range
}

task v4_lsp_location(path: word, span: word, source: word) -> word {
    pilot start_pos = v4_span_start(span)
    pilot end_pos = v4_span_end(span)
    pilot location = "location|" + path
    location = location + "|" + word_from_int(v4_lsp_line_from_offset(source, start_pos))
    location = location + "|" + word_from_int(v4_lsp_character_from_offset(source, start_pos))
    location = location + "|" + word_from_int(v4_lsp_line_from_offset(source, end_pos))
    location = location + "|" + word_from_int(v4_lsp_character_from_offset(source, end_pos))
    give back location
}

task v4_lsp_completion_item(label: word, kind: word, detail: word, insert_text: word) -> word {
    give back "completion-item|" + label + "|" + kind + "|" + detail + "|" + insert_text
}

task v4_lsp_symbol_item(name: word, kind: word, span: word, source: word) -> word {
    give back "symbol|" + name + "|" + kind + "|" + v4_lsp_range_from_span(span, source)
}

task v4_lsp_diagnostic_item(diag: word, source: word) -> word {
    pilot item = "diagnostic"
    item = item + "|" + v4_diag_severity_name(v4_diag_severity(diag))
    item = item + "|" + v4_lsp_range_from_span(v4_diag_span(diag), source)
    item = item + "|" + v4_diag_message(diag)
    item = item + "|" + v4_diag_help(diag)
    give back item
}

task v4_lsp_hover_text(path: word, text: word, offset: int) -> word {
    pilot hover_id = v4_hover_text_cached(path, text, offset)
    pilot markdown = v4_hover_markdown(hover_id)
    if markdown == "" {
        give back v4_lsp_response_error("textDocument/hover", 0 - 32001, "no hover available")
    }
    give back v4_lsp_response_ok("textDocument/hover", "hover|markdown\n" + markdown)
}

task v4_lsp_definition_text(path: word, text: word, offset: int) -> word {
    pilot defn_id = v4_definition_at_text_cached(path, text, offset)
    if v4_definition_at_found(defn_id) == 0 {
        give back v4_lsp_response_ok("textDocument/definition", "location|missing")
    }
    pilot out = v4_lsp_location(path, v4_definition_at_span(defn_id), text)
    out = out + "|" + v4_definition_at_name(defn_id)
    out = out + "|" + v4_definition_at_kind(defn_id)
    give back v4_lsp_response_ok("textDocument/definition", out)
}

task v4_lsp_document_symbols_text(path: word, text: word) -> word {
    pilot doc_id = v4_document_symbols_text_cached(path, text)
    pilot out = "document-symbols|" + word_from_int(v4_document_symbol_count(doc_id))
    pilot symbol_id = 0
    pilot symbol_count = v4_document_symbol_count(doc_id)
    repeat until symbol_id >= symbol_count {
        out = out + "\n"
        out = out + v4_lsp_symbol_item(v4_document_symbol_name(doc_id, symbol_id), v4_document_symbol_kind(doc_id, symbol_id), v4_document_symbol_span(doc_id, symbol_id), text)
        out = out + "|" + v4_document_symbol_type(doc_id, symbol_id)
        symbol_id += 1
    }
    give back v4_lsp_response_ok("textDocument/documentSymbol", out)
}

task v4_lsp_completion_text(path: word, text: word, offset: int) -> word {
    pilot completion_id = v4_completion_text_cached(path, text, offset)
    pilot out = "completion|" + word_from_int(v4_completion_count(completion_id))
    pilot item_id = 0
    pilot item_count = v4_completion_count(completion_id)
    repeat until item_id >= item_count {
        out = out + "\n"
        out = out + v4_lsp_completion_item(v4_completion_label(completion_id, item_id), v4_completion_kind(completion_id, item_id), v4_completion_detail(completion_id, item_id), v4_completion_insert_text(completion_id, item_id))
        item_id += 1
    }
    give back v4_lsp_response_ok("textDocument/completion", out)
}

task v4_lsp_diagnostics_text(path: word, text: word) -> word {
    pilot diagnostics_id = v4_diagnostics_text_cached(path, text)
    pilot out = "diagnostics|" + word_from_int(v4_diagnostics_count(diagnostics_id))
    pilot diag_id = 0
    pilot diag_count = v4_diagnostics_count(diagnostics_id)
    repeat until diag_id >= diag_count {
        pilot diag = v4_diagnostics_diag(diagnostics_id, diag_id)
        out = out + "\n"
        out = out + v4_lsp_diagnostic_item(diag, text)
        diag_id += 1
    }
    give back v4_lsp_response_ok("textDocument/publishDiagnostics", out)
}

task v4_lsp_query_telemetry_text() -> word {
    pilot out = v4_query_telemetry_summary()
    pilot telemetry_id = 0
    pilot telemetry_count = v4_query_telemetry_key_count()
    repeat until telemetry_id >= telemetry_count {
        out = out + "\n"
        out = out + "query"
        out = out + "|" + v4_query_telemetry_key(telemetry_id)
        out = out + "|hits=" + word_from_int(v4_query_telemetry_hits_for(telemetry_id))
        out = out + "|misses=" + word_from_int(v4_query_telemetry_misses_for(telemetry_id))
        out = out + "|stores=" + word_from_int(v4_query_telemetry_stores_for(telemetry_id))
        telemetry_id += 1
    }
    give back v4_lsp_response_ok("workspace/queryTelemetry", out)
}

task v4_lsp_query_graph_text(root_key: word) -> word {
    pilot out = v4_query_graph_summary()
    if root_key != "" {
        out = out + "\n"
        out = out + v4_query_dependency_summary(root_key)
        pilot dependent_id = 0
        pilot dependent_count = v4_query_direct_dependent_count(root_key)
        repeat until dependent_id >= dependent_count {
            out = out + "\n"
            out = out + "dependent"
            out = out + "|" + root_key
            out = out + "|" + v4_query_direct_dependent_at(root_key, dependent_id)
            dependent_id += 1
        }
    }

    pilot dep_id = 0
    pilot dep_count = v4_query_dep_count()
    repeat until dep_id >= dep_count {
        out = out + "\n"
        out = out + "edge"
        out = out + "|" + v4_query_dep_from_key(dep_id)
        out = out + "|" + v4_query_dep_to_key(dep_id)
        dep_id += 1
    }
    give back v4_lsp_response_ok("workspace/queryGraph", out)
}

task v4_lsp_query_explain_text(key: word) -> word {
    give back v4_lsp_response_ok("workspace/queryExplain", v4_query_explain(key))
}

task v4_lsp_query_snapshot_text() -> word {
    give back v4_lsp_response_ok("workspace/querySnapshot", v4_query_snapshot())
}

task v4_lsp_query_snapshot_import_text(payload: word) -> word {
    give back v4_lsp_response_ok("workspace/querySnapshotImport", v4_query_snapshot_validate(payload))
}

task v4_lsp_hover_position_text(path: word, text: word, line: int, character_pos: int) -> word {
    pilot offset = v4_lsp_offset_from_position(text, line, character_pos)
    give back v4_lsp_hover_text(path, text, offset)
}

task v4_lsp_definition_position_text(path: word, text: word, line: int, character_pos: int) -> word {
    pilot offset = v4_lsp_offset_from_position(text, line, character_pos)
    give back v4_lsp_definition_text(path, text, offset)
}

task v4_lsp_completion_position_text(path: word, text: word, line: int, character_pos: int) -> word {
    pilot offset = v4_lsp_offset_from_position(text, line, character_pos)
    give back v4_lsp_completion_text(path, text, offset)
}

task v4_lsp_hover_position_document(path: word, line: int, character_pos: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/hover", 0 - 32004, "document not open")
    }
    give back v4_lsp_hover_position_text(path, v4_lsp_document_text(doc_id), line, character_pos)
}

task v4_lsp_definition_position_document(path: word, line: int, character_pos: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/definition", 0 - 32004, "document not open")
    }
    give back v4_lsp_definition_position_text(path, v4_lsp_document_text(doc_id), line, character_pos)
}

task v4_lsp_completion_position_document(path: word, line: int, character_pos: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/completion", 0 - 32004, "document not open")
    }
    give back v4_lsp_completion_position_text(path, v4_lsp_document_text(doc_id), line, character_pos)
}

task v4_lsp_initialize_payload() -> word {
    pilot out = "capabilities"
    out = out + "|textDocument/hover"
    out = out + "|textDocument/definition"
    out = out + "|textDocument/documentSymbol"
    out = out + "|textDocument/completion"
    out = out + "|textDocument/publishDiagnostics"
    out = out + "|workspace/queryTelemetry"
    out = out + "|workspace/queryGraph"
    out = out + "|workspace/queryExplain"
    out = out + "|workspace/querySnapshot"
    out = out + "|workspace/querySnapshotImport"
    out = out + "|textDocument/didOpen"
    out = out + "|textDocument/didChange"
    give back out
}

task v4_lsp_handle_text_request(method: word, path: word, text: word, offset: int) -> word {
    if method == "initialize" {
        give back v4_lsp_response_ok(method, v4_lsp_initialize_payload())
    }
    if method == "shutdown" {
        give back v4_lsp_response_ok(method, "shutdown|ok")
    }
    if method == "textDocument/didOpen" {
        v4_lsp_open_document(path, text)
        give back v4_lsp_response_ok(method, v4_lsp_document_summary(path))
    }
    if method == "textDocument/didChange" {
        v4_lsp_change_document(path, text)
        give back v4_lsp_response_ok(method, v4_lsp_document_summary(path) + "\n" + v4_lsp_invalidation_summary(path))
    }
    if method == "textDocument/hover" {
        give back v4_lsp_hover_text(path, text, offset)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_text(path, text, offset)
    }
    if method == "textDocument/documentSymbol" {
        give back v4_lsp_document_symbols_text(path, text)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_text(path, text, offset)
    }
    if method == "textDocument/publishDiagnostics" {
        give back v4_lsp_diagnostics_text(path, text)
    }
    if method == "workspace/queryTelemetry" {
        give back v4_lsp_query_telemetry_text()
    }
    if method == "workspace/queryGraph" {
        give back v4_lsp_query_graph_text("source:" + path)
    }
    if method == "workspace/queryExplain" {
        give back v4_lsp_query_explain_text("source:" + path)
    }
    if method == "workspace/querySnapshot" {
        give back v4_lsp_query_snapshot_text()
    }
    if method == "workspace/querySnapshotImport" {
        give back v4_lsp_query_snapshot_import_text(text)
    }
    give back v4_lsp_response_error(method, 0 - 32601, "method not found")
}

task v4_lsp_handle_position_text_request(method: word, path: word, text: word, line: int, character_pos: int) -> word {
    if method == "textDocument/hover" {
        give back v4_lsp_hover_position_text(path, text, line, character_pos)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_position_text(path, text, line, character_pos)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_position_text(path, text, line, character_pos)
    }
    if method == "textDocument/documentSymbol" {
        give back v4_lsp_document_symbols_text(path, text)
    }
    if method == "textDocument/publishDiagnostics" {
        give back v4_lsp_diagnostics_text(path, text)
    }
    give back v4_lsp_handle_text_request(method, path, text, v4_lsp_offset_from_position(text, line, character_pos))
}

task v4_lsp_handle_request(method: word, path: word, offset: int) -> word {
    if method == "initialize" {
        give back v4_lsp_response_ok(method, v4_lsp_initialize_payload())
    }
    if method == "shutdown" {
        give back v4_lsp_response_ok(method, "shutdown|ok")
    }
    if method == "textDocument/hover" {
        give back v4_lsp_hover_document(path, offset)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_document(path, offset)
    }
    if method == "textDocument/documentSymbol" {
        give back v4_lsp_document_symbols_document(path)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_document(path, offset)
    }
    if method == "textDocument/publishDiagnostics" {
        give back v4_lsp_diagnostics_document(path)
    }
    if method == "workspace/queryTelemetry" {
        give back v4_lsp_query_telemetry_text()
    }
    if method == "workspace/queryGraph" {
        give back v4_lsp_query_graph_text("source:" + path)
    }
    if method == "workspace/queryExplain" {
        give back v4_lsp_query_explain_text("source:" + path)
    }
    if method == "workspace/querySnapshot" {
        give back v4_lsp_query_snapshot_text()
    }
    if method == "workspace/querySnapshotImport" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires snapshot text")
    }
    if method == "textDocument/didOpen" or method == "textDocument/didChange" {
        give back v4_lsp_response_error(method, 0 - 32602, "method requires source text")
    }
    give back v4_lsp_response_error(method, 0 - 32601, "method not found")
}

task v4_lsp_handle_position_request(method: word, path: word, line: int, character_pos: int) -> word {
    if method == "textDocument/hover" {
        give back v4_lsp_hover_position_document(path, line, character_pos)
    }
    if method == "textDocument/definition" {
        give back v4_lsp_definition_position_document(path, line, character_pos)
    }
    if method == "textDocument/completion" {
        give back v4_lsp_completion_position_document(path, line, character_pos)
    }
    give back v4_lsp_handle_request(method, path, 0)
}
