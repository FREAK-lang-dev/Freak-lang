-- ===================================================================
-- freak_lsp - V4 editor-facing query facade
-- ===================================================================
-- Depends on freak_driver and freak_snapshot. This crate owns no compiler facts; it only
-- formats driver query results into stable line payloads that a future
-- JSON-RPC daemon can wrap as Language Server Protocol responses.

pilot v4_lsp_doc_paths = 0
pilot v4_lsp_doc_texts = 0
pilot v4_lsp_doc_revisions = 0
pilot v4_lsp_ready = 0

task v4_lsp_init() -> void {
    v4_driver_init()
    if v4_lsp_ready == 0 {
        v4_lsp_doc_paths = array_new()
        v4_lsp_doc_texts = array_new()
        v4_lsp_doc_revisions = array_new()
        v4_lsp_ready = 1
    }
}

task v4_lsp_find_document(path: word) -> int {
    v4_lsp_init()
    pilot doc_id = 0
    pilot doc_count = array_len(v4_lsp_doc_paths)
    repeat until doc_id >= doc_count {
        pilot doc_path: word = array_get(v4_lsp_doc_paths, doc_id)
        if doc_path == path {
            give back doc_id
        }
        doc_id += 1
    }
    give back 0 - 1
}

task v4_lsp_document_count() -> int {
    v4_lsp_init()
    give back array_len(v4_lsp_doc_paths)
}

task v4_lsp_document_path(doc_id: int) -> word {
    v4_lsp_init()
    give back array_get(v4_lsp_doc_paths, doc_id)
}

task v4_lsp_document_text(doc_id: int) -> word {
    v4_lsp_init()
    give back array_get(v4_lsp_doc_texts, doc_id)
}

task v4_lsp_document_revision(doc_id: int) -> int {
    v4_lsp_init()
    give back word_to_int(array_get(v4_lsp_doc_revisions, doc_id))
}

task v4_lsp_open_document(path: word, text: word) -> int {
    v4_lsp_init()
    pilot existing = v4_lsp_find_document(path)
    v4_source_set_text(path, text)
    if existing >= 0 {
        pilot revision = v4_lsp_document_revision(existing) + 1
        array_set(v4_lsp_doc_texts, existing, text)
        array_set(v4_lsp_doc_revisions, existing, word_from_int(revision))
        give back existing
    }

    pilot doc_id = array_len(v4_lsp_doc_paths)
    array_push(v4_lsp_doc_paths, path)
    array_push(v4_lsp_doc_texts, text)
    array_push(v4_lsp_doc_revisions, "1")
    give back doc_id
}

task v4_lsp_change_document(path: word, text: word) -> int {
    pilot doc_id = v4_lsp_open_document(path, text)
    v4_lsp_invalidate_document_queries(path)
    give back doc_id
}

task v4_lsp_change_document_generation(path: word, text: word) -> int {
    v4_lsp_open_document(path, text)
    give back v4_lsp_invalidate_document_queries(path)
}

task v4_lsp_document_id_or_missing(path: word) -> int {
    pilot doc_id = v4_lsp_find_document(path)
    give back doc_id
}

task v4_lsp_document_summary(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back "document missing path=" + path
    }
    pilot out = "document id=" + word_from_int(doc_id)
    out = out + " path=" + v4_lsp_document_path(doc_id)
    out = out + " rev=" + word_from_int(v4_lsp_document_revision(doc_id))
    out = out + " bytes=" + word_from_int(v4_lsp_document_text(doc_id).length())
    give back out
}

task v4_lsp_invalidation_key_matches(path: word, key: word) -> bool {
    give back v4_unit_invalidation_family_matches_path_key(path, "all", key)
}

task v4_lsp_invalidate_document_queries(path: word) -> int {
    pilot generation = v4_query_bump_generation("didChange:" + path)
    pilot reason = "didChange:" + path
    v4_query_invalidate_dependents_at_generation("source:" + path, generation, reason)
    give back generation
}

task v4_lsp_invalidation_summary(path: word) -> word {
    give back v4_unit_invalidation_report(path)
}

task v4_lsp_invalidation_summary_at_generation(path: word, generation: int) -> word {
    give back v4_unit_invalidation_report_at_generation(path, generation)
}

task v4_lsp_hover_document(path: word, offset: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/hover", 0 - 32004, "document not open")
    }
    give back v4_lsp_hover_text(path, v4_lsp_document_text(doc_id), offset)
}

task v4_lsp_definition_document(path: word, offset: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/definition", 0 - 32004, "document not open")
    }
    give back v4_lsp_definition_text(path, v4_lsp_document_text(doc_id), offset)
}

task v4_lsp_document_symbols_document(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/documentSymbol", 0 - 32004, "document not open")
    }
    give back v4_lsp_document_symbols_text(path, v4_lsp_document_text(doc_id))
}

task v4_lsp_completion_document(path: word, offset: int) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/completion", 0 - 32004, "document not open")
    }
    give back v4_lsp_completion_text(path, v4_lsp_document_text(doc_id), offset)
}

task v4_lsp_diagnostics_document(path: word) -> word {
    pilot doc_id = v4_lsp_document_id_or_missing(path)
    if doc_id < 0 {
        give back v4_lsp_response_error("textDocument/publishDiagnostics", 0 - 32004, "document not open")
