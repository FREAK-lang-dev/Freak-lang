-- ===================================================================
-- freak_ty - V4 type signature and primitive type helpers
-- ===================================================================
-- Depends on freak_span, freak_diag, freak_lex, freak_parse,
-- freak_hir, and freak_resolve.
-- This first type layer builds item-level signatures and owns the
-- primitive type vocabulary. MIR uses these helpers while lowering
-- rvalues so the pipeline can start carrying concrete type facts
-- without introducing a cyclic dependency.

pilot v4_ty_unknown = "unknown"
pilot v4_ty_int = "int"
pilot v4_ty_uint = "uint"
pilot v4_ty_tiny = "tiny"
pilot v4_ty_num = "num"
pilot v4_ty_float = "float"
pilot v4_ty_float32 = "float32"
pilot v4_ty_big = "big"
pilot v4_ty_word = "word"
pilot v4_ty_bool = "bool"
pilot v4_ty_char = "char"
pilot v4_ty_void = "void"
pilot v4_ty_never = "never"

pilot v4_ty_task_sig = "task-signature"
pilot v4_ty_const_sig = "const-signature"
pilot v4_ty_shape_sig = "shape-signature"
pilot v4_ty_route_sig = "route-signature"
pilot v4_ty_alias_sig = "alias-signature"
pilot v4_ty_doctrine_sig = "doctrine-signature"
pilot v4_ty_extern_sig = "extern-signature"
pilot v4_ty_import_sig = "import-signature"
pilot v4_ty_attribute_sig = "attribute-signature"
pilot v4_ty_error_sig = "error-signature"
pilot v4_ty_snapshot_format = "freak-ty-snapshot-v1"
pilot v4_ty_generic_env_fail = "#fail"
pilot v4_ty_lend_storage_none = "none"
pilot v4_ty_lend_storage_fixed = "fixed"
pilot v4_ty_lend_storage_unsupported = "unsupported"
pilot v4_ty_lend_storage_opaque = "opaque"
pilot v4_ty_lend_storage_exhausted = "exhausted"
pilot v4_ty_lend_storage_depth_limit = 32
pilot v4_ty_fixed_lend_leaf_limit = 256
pilot v4_ty_return_lend_source_limit = 256
pilot v4_ty_return_lend_source_opaque = "#opaque"
pilot v4_ty_generic_kind_type = "type"
pilot v4_ty_generic_kind_lifetime = "lifetime"
pilot v4_ty_param_mode_value = "value"
pilot v4_ty_param_mode_lend = "lend"
pilot v4_ty_param_mode_lend_mut = "lend mut"
pilot v4_ty_closure_mode_borrow = "borrow"
pilot v4_ty_closure_mode_copy = "copy"
pilot v4_ty_closure_mode_move = "move"
pilot v4_ty_closure_mode_mut = "mut"
pilot v4_ty_closure_callable = "Callable"
pilot v4_ty_closure_mut_callable = "MutCallable"
pilot v4_ty_closure_one_shot = "OneShot"

pilot v4_ty_files = 0
pilot v4_ty_resolves = 0
pilot v4_ty_defs = 0
pilot v4_ty_kinds = 0
pilot v4_ty_names = 0
pilot v4_ty_displays = 0
pilot v4_ty_hir_items = 0
pilot v4_ty_diags = 0
-- Restores retain top-level and child handles; these values hold logical lengths.
pilot v4_ty_file_active_count_value = 0
pilot v4_ty_signature_active_counts = 0
pilot v4_ty_diag_active_counts = 0
pilot v4_ty_lifetime_outlives_scratch_links = 0
pilot v4_ty_lifetime_outlives_scratch_ids = 0
pilot v4_ty_lifetime_outlives_scratch_active = 0
pilot v4_ty_lifetime_outlives_scratch_generation_value = 0
-- Returned-source rows are globally bounded; payloads encode ordered formal ids without child arrays.
pilot v4_ty_borrowed_return_source_cache_capacity_value = 32
pilot v4_ty_borrowed_return_source_cache_ty_ids = 0
pilot v4_ty_borrowed_return_source_cache_sig_ids = 0
pilot v4_ty_borrowed_return_source_cache_payloads = 0
pilot v4_ty_borrowed_return_source_cache_entry_count_value = 0
pilot v4_ty_borrowed_return_source_cache_next_row_value = 0
pilot v4_ty_borrowed_return_source_cache_builds_value = 0
pilot v4_ty_copy_doctrine_cache_ty_ids = 0
pilot v4_ty_copy_doctrine_cache_sig_ids = 0
pilot v4_ty_copy_doctrine_cache_types = 0
pilot v4_ty_copy_doctrine_cache_values = 0
pilot v4_ty_copy_doctrine_cache_entry_count_value = 0
pilot v4_ty_copy_doctrine_cache_capacity_value = 128
pilot v4_ty_copy_doctrine_cache_next_row_value = 0
pilot v4_ty_ready = 0

task v4_ty_init() -> void {
    if v4_ty_ready == 0 {
        v4_ty_files = array_new()
        v4_ty_resolves = array_new()
        v4_ty_defs = array_new()
        v4_ty_kinds = array_new()
        v4_ty_names = array_new()
        v4_ty_displays = array_new()
        v4_ty_hir_items = array_new()
        v4_ty_diags = array_new()
        v4_ty_signature_active_counts = array_new()
        v4_ty_diag_active_counts = array_new()
        v4_ty_lifetime_outlives_scratch_links = array_new()
        v4_ty_lifetime_outlives_scratch_ids = array_new()
        v4_ty_borrowed_return_source_cache_ty_ids = array_new()
        v4_ty_borrowed_return_source_cache_sig_ids = array_new()
        v4_ty_borrowed_return_source_cache_payloads = array_new()
        v4_ty_copy_doctrine_cache_ty_ids = array_new()
        v4_ty_copy_doctrine_cache_sig_ids = array_new()
        v4_ty_copy_doctrine_cache_types = array_new()
        v4_ty_copy_doctrine_cache_values = array_new()
        v4_ty_ready = 1
    }
}

task v4_ty_file_new(file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    v4_ty_copy_doctrine_cache_reset()
    pilot ty_id = v4_ty_file_active_count_value
    if ty_id < array_len(v4_ty_files) {
        v4_ty_borrowed_return_source_cache_invalidate_file(ty_id)
        array_set(v4_ty_files, ty_id, word_from_int(file_id))
        array_set(v4_ty_resolves, ty_id, word_from_int(resolve_id))
        v4_ty_restore_clear_file_children(ty_id)
    } else {
        array_push(v4_ty_files, word_from_int(file_id))
        array_push(v4_ty_resolves, word_from_int(resolve_id))
        array_push(v4_ty_defs, word_from_int(array_new()))
        array_push(v4_ty_kinds, word_from_int(array_new()))
        array_push(v4_ty_names, word_from_int(array_new()))
        array_push(v4_ty_displays, word_from_int(array_new()))
        array_push(v4_ty_hir_items, word_from_int(array_new()))
        array_push(v4_ty_diags, word_from_int(array_new()))
        array_push(v4_ty_signature_active_counts, "0")
        array_push(v4_ty_diag_active_counts, "0")
    }
    v4_ty_file_active_count_value = ty_id + 1
    give back ty_id
}

task v4_ty_defs_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_defs, ty_id))
}

task v4_ty_kinds_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_kinds, ty_id))
}

task v4_ty_names_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_names, ty_id))
}

task v4_ty_displays_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_displays, ty_id))
}

task v4_ty_hir_items_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_hir_items, ty_id))
}

task v4_ty_diags_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_diags, ty_id))
}

task v4_ty_child_handle_ensure_slot(handle: int, slot_id: int, empty_value: word) -> bool {
    if slot_id < 0 {
        give back false
    }
    repeat until array_len(handle) > slot_id {
        pilot before_len = array_len(handle)
        array_push(handle, empty_value)
        if array_len(handle) <= before_len {
            give back false
        }
    }
    give back true
}

task v4_ty_file_id(ty_id: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_ty_files, ty_id))
}

task v4_ty_resolve_id(ty_id: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_ty_resolves, ty_id))
}

task v4_ty_file_count() -> int {
    v4_ty_init()
    give back v4_ty_file_active_count_value
}

task v4_ty_file_capacity() -> int {
    v4_ty_init()
    give back array_len(v4_ty_files)
}

task v4_ty_file_exists(ty_id: int) -> bool {
    v4_ty_init()
    if ty_id < 0 {
        give back false
    }
    if ty_id >= v4_ty_file_active_count_value {
        give back false
    }
    give back true
}

task v4_ty_signature_count(ty_id: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    give back word_to_int(array_get(v4_ty_signature_active_counts, ty_id))
}

task v4_ty_diag_count(ty_id: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    give back word_to_int(array_get(v4_ty_diag_active_counts, ty_id))
}

task v4_ty_signature_capacity(ty_id: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    give back array_len(v4_ty_defs_handle(ty_id))
}

task v4_ty_diag_capacity(ty_id: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    give back array_len(v4_ty_diags_handle(ty_id))
}

task v4_ty_signature_def(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    give back array_get(v4_ty_defs_handle(ty_id), sig_id)
}

task v4_ty_signature_kind(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    give back array_get(v4_ty_kinds_handle(ty_id), sig_id)
}

task v4_ty_signature_name(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    give back array_get(v4_ty_names_handle(ty_id), sig_id)
}

task v4_ty_signature_source_display(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    give back array_get(v4_ty_displays_handle(ty_id), sig_id)
}

task v4_ty_signature_display(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    pilot display = v4_ty_signature_source_display(ty_id, sig_id)
    pilot sig_kind: word = array_get(v4_ty_kinds_handle(ty_id), sig_id)
    if sig_kind == v4_ty_const_sig {
        if v4_ty_const_declared_type_for_sig(ty_id, sig_id) == "" {
            pilot inferred_ty: word = v4_ty_const_value_type_for_sig(ty_id, sig_id)
            if inferred_ty != v4_ty_unknown {
                pilot sig_name: word = array_get(v4_ty_names_handle(ty_id), sig_id)
                give back "fixed pilot " + sig_name + ": " + inferred_ty
            }
        }
    }
    give back display
}

task v4_ty_signature_hir_item(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_ty_hir_items_handle(ty_id), sig_id))
}

task v4_ty_diag(ty_id: int, diag_id: int) -> word {
    if diag_id < 0 or diag_id >= v4_ty_diag_count(ty_id) {
        give back ""
    }
    give back array_get(v4_ty_diags_handle(ty_id), diag_id)
}

task v4_ty_add_diag(ty_id: int, diag: word) -> void {
    pilot diag_id = v4_ty_diag_count(ty_id)
    pilot diags_handle = v4_ty_diags_handle(ty_id)
    if v4_ty_child_handle_ensure_slot(diags_handle, diag_id, "") == false {
        give back
    }
    array_set(diags_handle, diag_id, diag)
    array_set(v4_ty_diag_active_counts, ty_id, word_from_int(diag_id + 1))
}

task v4_ty_add_error_diag(ty_id: int, span: word, message: word, help: word) -> void {
    pilot diag_span = span
    if diag_span == "" {
        diag_span = V4_NO_SPAN
    }
    v4_ty_add_diag(ty_id, v4_diag_new(v4_diag_error, diag_span, message, help))
}

task v4_ty_add_warning_diag(ty_id: int, span: word, message: word, help: word) -> void {
    pilot diag_span = span
    if diag_span == "" {
        diag_span = V4_NO_SPAN
    }
    v4_ty_add_diag(ty_id, v4_diag_new(v4_diag_warning, diag_span, message, help))
}

task v4_ty_copy_resolve_diags(ty_id: int, resolve_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_resolve_diag_count(resolve_id)
    repeat until diag_idx >= diag_count {
        v4_ty_add_diag(ty_id, v4_resolve_diag(resolve_id, diag_idx))
        diag_idx += 1
    }
}

task v4_ty_alias_signature_id_for_name(ty_id: int, alias_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_alias_sig {
            if v4_ty_signature_name(ty_id, sig_id) == alias_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_alias_target_type_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_alias_sig {
        give back v4_ty_unknown
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id >= 0 and start_token >= 0 and end_token > start_token {
        pilot eq_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, "=")
        if eq_token >= 0 {
            pilot target_start = v4_ty_skip_trivia(stream_id, eq_token + 1)
            if target_start < end_token {
                pilot normalized_target = v4_ty_type_text(stream_id, target_start, end_token)
                if normalized_target != "" {
                    give back normalized_target
                }
            }
        }
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back v4_ty_unknown
    }
    pilot target = v4_hir_alias_target(hir_id, hir_item)
    if target == "" {
        give back v4_ty_unknown
    }
    give back target
}

task v4_ty_alias_target_type(ty_id: int, alias_name: word) -> word {
    pilot sig_id = v4_ty_alias_signature_id_for_name(ty_id, alias_name)
    if sig_id >= 0 {
        give back v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    }
    if v4_ty_is_generic_instance_type(alias_name) {
        pilot base_name = v4_ty_generic_base_name(alias_name)
        if base_name != v4_ty_unknown {
            sig_id = v4_ty_alias_signature_id_for_name(ty_id, base_name)
            if sig_id >= 0 {
                if v4_ty_signature_generic_count(ty_id, sig_id) == v4_ty_generic_arg_count(alias_name) {
                    pilot target = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
                    if target != "" and target != v4_ty_unknown {
                        give back v4_ty_apply_signature_generics(ty_id, sig_id, alias_name, target)
                    }
                }
            }
        }
    }
    give back v4_ty_unknown
}

task v4_ty_surface_ffi_alias_name(type_text: word) -> word {
    if type_text.starts_with("std::ffi::") {
        give back v4_slice(type_text, 10, type_text.length())
    }
    give back type_text
}

task v4_ty_normalize_ffi_alias_type(type_text: word) -> word {
    pilot alias_name = v4_ty_surface_ffi_alias_name(type_text)
    if alias_name == "c_int" or alias_name == "c_long" or alias_name == "c_isize" or alias_name == "isize" {
        give back v4_ty_int
    }
    if alias_name == "c_uint" or alias_name == "c_ulong" or alias_name == "c_size" or alias_name == "usize" {
        give back v4_ty_uint
    }
    if alias_name == "c_float" {
        give back v4_ty_float32
    }
    if alias_name == "c_double" {
        give back v4_ty_float
    }
    if alias_name == "c_char" or alias_name == "c_uchar" {
        give back v4_ty_tiny
    }
    if alias_name == "c_bool" {
        give back v4_ty_bool
    }
    if alias_name == "c_void" {
        give back v4_ty_void
    }
    if alias_name == "wchar" {
        give back v4_ty_char
    }
    give back ""
}

task v4_ty_is_surface_ffi_alias_type(type_text: word) -> bool {
    give back v4_ty_normalize_ffi_alias_type(type_text) != ""
}

task v4_ty_raw_pointer_prefix(type_text: word) -> word {
    if type_text.starts_with("*const") and type_text.length() > 6 {
        give back "*const"
    }
    if type_text.starts_with("*mut") and type_text.length() > 4 {
        give back "*mut"
    }
    if type_text.starts_with("*") and type_text.length() > 1 {
        give back "*"
    }
    give back ""
}

task v4_ty_is_raw_pointer_type(type_text: word) -> bool {
    give back v4_ty_raw_pointer_prefix(type_text) != ""
}

task v4_ty_is_mutable_raw_pointer_type(type_text: word) -> bool {
    give back v4_ty_raw_pointer_prefix(type_text) == "*mut"
}

task v4_ty_raw_pointer_target_type(type_text: word) -> word {
    pilot prefix = v4_ty_raw_pointer_prefix(type_text)
    if prefix == "" {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, prefix.length(), type_text.length())
}

task v4_ty_raw_pointer_with_target_type(type_text: word, target_type: word) -> word {
    pilot prefix = v4_ty_raw_pointer_prefix(type_text)
    if prefix == "" or target_type == "" {
        give back v4_ty_unknown
    }
    give back prefix + target_type
}

task v4_ty_function_type_task_pos(type_text: word) -> int {
    if type_text.starts_with("task(") {
        give back 0
    }
    if type_text.starts_with("extern[") == false {
        give back 0 - 1
    }

    pilot abi_end = v4_ty_find_top_level_type_char(type_text, "]", 7, type_text.length())
    if abi_end < 0 or abi_end + 5 >= type_text.length() {
        give back 0 - 1
    }
    if v4_slice(type_text, abi_end + 1, abi_end + 5) != "task" {
        give back 0 - 1
    }
    if type_text.char_at(abi_end + 5) != "(" {
        give back 0 - 1
    }
    give back abi_end + 1
}

task v4_ty_is_surface_task_function_type(type_text: word) -> bool {
    pilot task_pos = v4_ty_function_type_task_pos(type_text)
    if task_pos < 0 {
        give back false
    }
    pilot open_pos = task_pos + 4
    if open_pos >= type_text.length() or type_text.char_at(open_pos) != "(" {
        give back false
    }
    pilot close_pos = v4_ty_find_top_level_type_char(type_text, ")", open_pos + 1, type_text.length())
    if close_pos < 0 or close_pos + 2 >= type_text.length() {
        give back false
    }
    give back type_text.char_at(close_pos + 1) == "-" and type_text.char_at(close_pos + 2) == ">"
}

task v4_ty_is_surface_extern_function_pointer_type(type_text: word) -> bool {
    give back type_text.starts_with("extern[") and v4_ty_is_surface_task_function_type(type_text)
}

task v4_ty_closure_doctrine_for_mode(mode: word) -> word {
    if mode == v4_ty_closure_mode_mut {
        give back v4_ty_closure_mut_callable
    }
    if mode == v4_ty_closure_mode_move {
        give back v4_ty_closure_one_shot
    }
    give back v4_ty_closure_callable
}

task v4_ty_closure_type_prefix(mode: word) -> word {
    give back "closure[" + v4_ty_closure_doctrine_for_mode(mode) + "," + mode + "]"
}

task v4_ty_is_closure_type(type_text: word) -> bool {
    if type_text.starts_with("closure[") == false {
        give back false
    }
    pilot close_bracket = v4_index_of_from(type_text, "]", 8)
    if close_bracket < 0 or close_bracket + 1 >= type_text.length() {
        give back false
    }
    give back type_text.char_at(close_bracket + 1) == "("
}

task v4_ty_closure_spec(type_text: word) -> word {
    if v4_ty_is_closure_type(type_text) == false {
        give back ""
    }
    pilot close_bracket = v4_index_of_from(type_text, "]", 8)
    give back v4_slice(type_text, 8, close_bracket)
}

task v4_ty_closure_doctrine(type_text: word) -> word {
    pilot spec = v4_ty_closure_spec(type_text)
    pilot comma = v4_index_of_from(spec, ",", 0)
    if comma < 0 {
        give back ""
    }
    give back v4_slice(spec, 0, comma)
}

task v4_ty_closure_mode(type_text: word) -> word {
    pilot spec = v4_ty_closure_spec(type_text)
    pilot comma = v4_index_of_from(spec, ",", 0)
    if comma < 0 or comma + 1 >= spec.length() {
        give back ""
    }
    give back v4_slice(spec, comma + 1, spec.length())
}

task v4_ty_closure_as_task_type(type_text: word) -> word {
    if v4_ty_is_closure_type(type_text) == false {
        give back v4_ty_unknown
    }
    pilot close_bracket = v4_index_of_from(type_text, "]", 8)
    give back "task" + v4_slice(type_text, close_bracket + 1, type_text.length())
}

task v4_ty_closure_param_count(type_text: word) -> int {
    give back v4_ty_function_type_param_count(v4_ty_closure_as_task_type(type_text))
}

task v4_ty_closure_param_type(type_text: word, param_id: int) -> word {
    give back v4_ty_function_type_param_surface(v4_ty_closure_as_task_type(type_text), param_id)
}

task v4_ty_closure_return_type(type_text: word) -> word {
    give back v4_ty_function_type_return_text(v4_ty_closure_as_task_type(type_text))
}

task v4_ty_function_type_open_paren(type_text: word) -> int {
    pilot task_pos = v4_ty_function_type_task_pos(type_text)
    if task_pos < 0 {
        give back 0 - 1
    }
    give back task_pos + 4
}

task v4_ty_function_type_close_paren(type_text: word) -> int {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    if open_pos < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_type_char(type_text, ")", open_pos + 1, type_text.length())
}

task v4_ty_function_type_return_text(type_text: word) -> word {
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if close_pos < 0 or close_pos + 2 >= type_text.length() {
        give back v4_ty_unknown
    }
    if type_text.char_at(close_pos + 1) != "-" or type_text.char_at(close_pos + 2) != ">" {
        give back v4_ty_unknown
    }
    if close_pos + 3 >= type_text.length() {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, close_pos + 3, type_text.length())
}

task v4_ty_function_type_abi_specs(type_text: word) -> word {
    if type_text.starts_with("extern[") == false {
        give back ""
    }
    pilot abi_end = v4_ty_find_top_level_type_char(type_text, "]", 7, type_text.length())
    if abi_end < 0 {
        give back ""
    }
    give back v4_slice(type_text, 7, abi_end)
}

task v4_ty_function_type_param_surface(type_text: word, param_id: int) -> word {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if open_pos < 0 or close_pos < 0 or param_id < 0 or open_pos + 1 > close_pos {
        give back v4_ty_unknown
    }
    if open_pos + 1 == close_pos {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= close_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == param_id {
                pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, idx)
                if colon_pos >= 0 {
                    give back v4_slice(type_text, colon_pos + 1, idx)
                }
                give back v4_slice(type_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == param_id and segment_start < close_pos {
        pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, close_pos)
        if colon_pos >= 0 {
            give back v4_slice(type_text, colon_pos + 1, close_pos)
        }
        give back v4_slice(type_text, segment_start, close_pos)
    }
    give back v4_ty_unknown
}

task v4_ty_function_type_param_name(type_text: word, param_id: int) -> word {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if open_pos < 0 or close_pos < 0 or param_id < 0 or open_pos + 1 > close_pos {
        give back ""
    }
    if open_pos + 1 == close_pos {
        give back ""
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= close_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == param_id {
                pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, idx)
                if colon_pos >= 0 {
                    give back v4_slice(type_text, segment_start, colon_pos)
                }
                give back ""
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == param_id and segment_start < close_pos {
        pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, close_pos)
        if colon_pos >= 0 {
            give back v4_slice(type_text, segment_start, colon_pos)
        }
    }
    give back ""
}

task v4_ty_function_type_param_count(type_text: word) -> int {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if open_pos < 0 or close_pos < 0 or open_pos + 1 > close_pos {
        give back 0
    }
    if open_pos + 1 == close_pos {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= close_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_function_type_fixed_param_count(type_text: word) -> int {
    pilot param_count = v4_ty_function_type_param_count(type_text)
    pilot variadic_param = v4_ty_function_type_variadic_param_id(type_text)
    if variadic_param >= 0 {
        give back variadic_param
    }
    give back param_count
}

task v4_ty_function_type_variadic_param_id(type_text: word) -> int {
    pilot param_id = 0
    pilot param_count = v4_ty_function_type_param_count(type_text)
    repeat until param_id >= param_count {
        if v4_ty_function_type_param_surface(type_text, param_id) == "..." {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_ty_function_type_call_abi(type_text: word) -> word {
    pilot abi_specs = v4_ty_function_type_abi_specs(type_text)
    if abi_specs == "" {
        give back ""
    }

    pilot item_start = 0
    repeat until item_start >= abi_specs.length() {
        pilot item_end = v4_ty_find_top_level_type_char(abi_specs, ",", item_start, abi_specs.length())
        if item_end < 0 {
            item_end = abi_specs.length()
        }
        pilot item = v4_slice(abi_specs, item_start, item_end)
        if item != "" {
            give back v4_ty_normalize_call_abi(item)
        }
        item_start = item_end + 1
    }
    give back ""
}

task v4_ty_function_type_abi_valid(abi_specs: word, allow_variadic: bool) -> bool {
    if abi_specs == "" {
        give back false
    }

    pilot seen_cc = ""
    pilot item_start = 0
    repeat until item_start >= abi_specs.length() {
        pilot item_end = v4_ty_find_top_level_type_char(abi_specs, ",", item_start, abi_specs.length())
        if item_end < 0 {
            item_end = abi_specs.length()
        }
        pilot item = v4_slice(abi_specs, item_start, item_end)
        if item == "" or item.starts_with("link=") or item.starts_with("if") {
            give back false
        }
        pilot abi = v4_ty_normalize_call_abi(item)
        if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
            give back false
        }
        if v4_ty_is_calling_convention_abi(abi) {
            if seen_cc != "" and seen_cc != abi {
                give back false
            }
            seen_cc = abi
        }
        item_start = item_end + 1
    }

    if allow_variadic == false {
        give back true
    }
    if seen_cc == "" {
        give back true
    }
    give back v4_ty_is_variadic_abi_compatible(seen_cc)
}

task v4_ty_surface_extern_function_pointer_ffi_safe(ty_id: int, type_text: word, seen_types: word) -> bool {
    if v4_ty_is_surface_extern_function_pointer_type(type_text) == false {
        give back false
    }

    pilot variadic_param = v4_ty_function_type_variadic_param_id(type_text)
    if v4_ty_function_type_abi_valid(v4_ty_function_type_abi_specs(type_text), variadic_param >= 0) == false {
        give back false
    }

    pilot param_id = 0
    pilot param_count = v4_ty_function_type_param_count(type_text)
    repeat until param_id >= param_count {
        pilot param_surface = v4_ty_function_type_param_surface(type_text, param_id)
        if param_surface == "..." {
            if param_id != param_count - 1 {
                give back false
            }
        } else if v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, seen_types) == false {
            give back false
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_function_type_return_text(type_text)
    if return_surface == "" or return_surface == v4_ty_unknown {
        give back false
    }
    give back v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, seen_types)
}

task v4_ty_validate_callback_surface_contract(ty_id: int, surface_type: word, span: word, context: word, seen_types: word) -> bool {
    if v4_ty_is_surface_extern_function_pointer_type(surface_type) == false {
        if v4_ty_is_surface_task_function_type(surface_type) {
            v4_ty_add_error_diag(ty_id, span, "callback type must use extern ABI", v4_ty_ffi_boundary_help(ty_id, surface_type, context))
            give back true
        }
        give back false
    }

    pilot variadic_param = v4_ty_function_type_variadic_param_id(surface_type)
    pilot abi_specs = v4_ty_function_type_abi_specs(surface_type)
    if v4_ty_function_type_abi_valid(abi_specs, variadic_param >= 0) == false {
        if variadic_param >= 0 {
            v4_ty_add_error_diag(ty_id, span, "callback ABI is invalid", context + " uses " + surface_type + "; variadic callbacks need extern[C], [cdecl], [system], [sysv64], or [win64], and args: ... must be the final parameter.")
        } else {
            v4_ty_add_error_diag(ty_id, span, "callback ABI is invalid", context + " uses " + surface_type + "; use extern[C], extern[system], or one supported calling convention without link=..., if..., or duplicate call-convention entries.")
        }
        give back true
    }

    pilot param_id = 0
    pilot param_count = v4_ty_function_type_param_count(surface_type)
    repeat until param_id >= param_count {
        pilot param_surface = v4_ty_function_type_param_surface(surface_type, param_id)
        if param_surface == "..." {
            if param_id != param_count - 1 {
                v4_ty_add_error_diag(ty_id, span, "callback variadic parameter must be final", "move args: ... to the end of " + context)
                give back true
            }
        } else if v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, seen_types) == false {
            pilot param_name = v4_ty_function_type_param_name(surface_type, param_id)
            pilot param_context = context + " argument " + word_from_int(param_id + 1)
            if param_name != "" {
                param_context = context + "." + param_name
            }
            v4_ty_add_error_diag(ty_id, span, "callback parameter type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, param_surface, param_context))
            give back true
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_function_type_return_text(surface_type)
    if return_surface == "" or return_surface == v4_ty_unknown {
        v4_ty_add_error_diag(ty_id, span, "callback return type is not FFI-safe", context + " must return an explicit FFI-safe type")
        give back true
    }
    if v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, seen_types) == false {
        v4_ty_add_error_diag(ty_id, span, "callback return type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, return_surface, context + " return"))
        give back true
    }

    give back true
}

task v4_ty_variadic_arg_promoted_type_seen(ty_id: int, surface_type: word, seen_types: word) -> word {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back v4_ty_unknown
    }

    pilot normalized = v4_ty_normalize_ffi_alias_type(surface_type)
    if normalized != "" {
        surface_type = normalized
    }

    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        if target_type == "" or target_type == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back surface_type
    }

    if surface_type == v4_ty_bool or surface_type == v4_ty_tiny or surface_type == v4_ty_char {
        give back v4_ty_int
    }
    if surface_type == v4_ty_float32 {
        give back v4_ty_float
    }
    if surface_type == v4_ty_int or surface_type == v4_ty_uint or surface_type == v4_ty_num or surface_type == v4_ty_float {
        give back surface_type
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back v4_ty_unknown
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, surface_type)
    if alias_target != "" and alias_target != v4_ty_unknown {
        give back v4_ty_variadic_arg_promoted_type_seen(ty_id, alias_target, v4_ty_ffi_seen_append(seen_types, surface_type))
    }

    give back v4_ty_unknown
}

task v4_ty_variadic_arg_promoted_type(ty_id: int, surface_type: word) -> word {
    give back v4_ty_variadic_arg_promoted_type_seen(ty_id, surface_type, "")
}

task v4_ty_variadic_arg_help(surface_type: word) -> word {
    if surface_type == v4_ty_word {
        give back "extern variadic calls need scalar std::ffi-style values or raw pointers; word should cross the boundary as *const tiny or another explicit buffer."
    }
    if v4_ty_is_tuple_type(surface_type) or v4_ty_is_fixed_array_type(surface_type) {
        give back "extern variadic calls currently accept only scalar std::ffi-style values or raw pointers; pass aggregates through an explicit fixed signature slot instead."
    }
    give back "extern variadic calls currently accept only scalar std::ffi-style values or raw pointers; got " + surface_type
}

task v4_ty_alias_cycle_seen_contains(seen_aliases: word, alias_name: word) -> bool {
    if seen_aliases == "" or alias_name == "" {
        give back false
    }
    give back ("|" + seen_aliases + "|").contains("|" + alias_name + "|")
}

task v4_ty_alias_cycle_seen_append(seen_aliases: word, alias_name: word) -> word {
    if alias_name == "" {
        give back seen_aliases
    }
    if seen_aliases == "" {
        give back alias_name
    }
    give back seen_aliases + "|" + alias_name
}

task v4_ty_alias_cycle_chain_display(chain: word) -> word {
    if chain == "" {
        give back ""
    }

    pilot out = ""
    pilot segment_start = 0
    repeat until segment_start >= chain.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(chain, "|", segment_start, chain.length())
        if segment_end < 0 {
            segment_end = chain.length()
        }
        pilot segment = v4_slice(chain, segment_start, segment_end)
        if segment != "" {
            if out != "" {
                out = out + " -> "
            }
            out = out + segment
        }
        segment_start = segment_end + 1
    }
    give back out
}

task v4_ty_alias_cycle_path_in_type(ty_id: int, type_text: word, seen_aliases: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_surface_ffi_alias_type(type_text) {
        give back ""
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_raw_pointer_target_type(type_text), seen_aliases)
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_dyn_doctrine_name(type_text), seen_aliases)
    }
    if v4_ty_is_primitive_type(type_text) or v4_ty_is_lifetime_name(type_text) {
        give back ""
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_path = v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_aliases)
            if slot_path != "" {
                give back slot_path
            }
            slot_id += 1
        }
        give back ""
    }

    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_fixed_array_element_type(type_text), seen_aliases)
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if base_name != v4_ty_unknown {
            if v4_ty_alias_signature_id_for_name(ty_id, base_name) >= 0 {
                if v4_ty_alias_cycle_seen_contains(seen_aliases, base_name) {
                    give back v4_ty_alias_cycle_seen_append(seen_aliases, base_name)
                }
                pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
                if alias_target != "" and alias_target != v4_ty_unknown {
                    pilot alias_path = v4_ty_alias_cycle_path_in_type(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, base_name))
                    if alias_path != "" {
                        give back alias_path
                    }
                }
                give back ""
            }
        }

        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_id >= arg_count {
            pilot arg_path = v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_generic_arg(type_text, arg_id), seen_aliases)
            if arg_path != "" {
                give back arg_path
            }
            arg_id += 1
        }
        give back ""
    }

    if v4_ty_alias_signature_id_for_name(ty_id, type_text) >= 0 {
        if v4_ty_alias_cycle_seen_contains(seen_aliases, type_text) {
            give back v4_ty_alias_cycle_seen_append(seen_aliases, type_text)
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_alias_cycle_path_in_type(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, type_text))
        }
    }

    give back ""
}

task v4_ty_canonical_type_depth_seen(ty_id: int, type_text: word, seen_aliases: word, depth: int) -> word {
    if depth > 8 {
        give back type_text
    }
    if type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }

    pilot ffi_alias = v4_ty_normalize_ffi_alias_type(type_text)
    if ffi_alias != "" {
        give back ffi_alias
    }

    if v4_ty_is_lend_type(type_text) {
        pilot lend_target = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_lend_target_type(type_text), seen_aliases, depth + 1)
        if lend_target == "" or lend_target == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back v4_ty_lend_type_with_lifetime(lend_target, v4_ty_lend_mode(type_text), v4_ty_lend_lifetime(type_text))
    }

    if v4_ty_is_dyn_type(type_text) {
        pilot dyn_doctrine = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_dyn_doctrine_name(type_text), seen_aliases, depth + 1)
        if dyn_doctrine == "" or dyn_doctrine == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back v4_ty_dyn_type(dyn_doctrine)
    }

    if v4_ty_is_raw_pointer_type(type_text) {
        pilot pointer_prefix = v4_ty_raw_pointer_prefix(type_text)
        pilot pointer_target = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_raw_pointer_target_type(type_text), seen_aliases, depth + 1)
        if pointer_target == "" or pointer_target == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back pointer_prefix + pointer_target
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_canonical_type_depth_seen(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_aliases, depth + 1) == v4_ty_unknown {
                give back v4_ty_unknown
            }
            slot_id += 1
        }
        give back type_text
    }

    if v4_ty_is_fixed_array_type(type_text) {
        pilot element_ty = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_aliases, depth + 1)
        if element_ty == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back "[" + element_ty + ";" + v4_ty_fixed_array_length_normalized_text(ty_id, type_text) + "]"
    }

    pilot alias_name = ""
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if base_name != v4_ty_unknown and v4_ty_alias_signature_id_for_name(ty_id, base_name) >= 0 {
            alias_name = base_name
        }
    } else if v4_ty_alias_signature_id_for_name(ty_id, type_text) >= 0 {
        alias_name = type_text
    }

    if alias_name != "" {
        if v4_ty_alias_cycle_seen_contains(seen_aliases, alias_name) {
            give back v4_ty_unknown
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_canonical_type_depth_seen(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, alias_name), depth + 1)
        }
    }

    give back type_text
}

task v4_ty_canonical_type(ty_id: int, type_text: word) -> word {
    give back v4_ty_canonical_type_depth_seen(ty_id, type_text, "", 0)
}

task v4_ty_canonical_type_in_signature_depth(ty_id: int, sig_id: int, type_text: word, depth: int) -> word {
    if depth > 8 or type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }
    if sig_id >= 0 and v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text) {
        give back type_text
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
    if alias_target != "" and alias_target != v4_ty_unknown and alias_target != type_text {
        give back v4_ty_canonical_type_in_signature_depth(ty_id, sig_id, alias_target, depth + 1)
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_dyn_type(v4_ty_canonical_type_in_signature_depth(ty_id, sig_id, v4_ty_dyn_doctrine_name(type_text), depth + 1))
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        give back v4_ty_canonical_type(ty_id, type_text)
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_ty_lend_type_with_lifetime(v4_ty_canonical_type_in_signature_depth(ty_id, sig_id, v4_ty_lend_target_type(type_text), depth + 1), v4_ty_lend_mode(type_text), v4_ty_lend_lifetime(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_raw_pointer_with_target_type(type_text, v4_ty_canonical_type_in_signature_depth(ty_id, sig_id, v4_ty_raw_pointer_target_type(type_text), depth + 1))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        give back v4_ty_canonical_type(ty_id, type_text)
    }
    if v4_ty_is_tuple_type(type_text) {
        give back v4_ty_canonical_type(ty_id, type_text)
    }
    if v4_ty_is_fixed_array_type(type_text) {
        pilot element_ty = v4_ty_canonical_type_in_signature_depth(ty_id, sig_id, v4_ty_fixed_array_element_type(type_text), depth + 1)
        give back "[" + element_ty + ";" + v4_ty_fixed_array_length_normalized_text(ty_id, type_text) + "]"
    }
    give back v4_ty_canonical_type(ty_id, type_text)
}

task v4_ty_canonical_type_in_signature(ty_id: int, sig_id: int, type_text: word) -> word {
    give back v4_ty_canonical_type_in_signature_depth(ty_id, sig_id, type_text, 0)
}

task v4_ty_is_numeric(ty_name: word) -> bool {
    give back v4_ty_is_integer(ty_name) or v4_ty_is_float(ty_name)
}

task v4_ty_is_integer(ty_name: word) -> bool {
    give back ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_big
}

task v4_ty_is_float(ty_name: word) -> bool {
    give back ty_name == v4_ty_num or ty_name == v4_ty_float or ty_name == v4_ty_float32
}

task v4_ty_is_integer_text_literal(value: word) -> bool {
    give back v4_ty_integer_literal_value_text(value) != v4_ty_unknown
}

task v4_ty_is_copy_type(ty_name: word) -> bool {
    if v4_ty_is_lend_type(ty_name) {
        give back v4_ty_is_lend_mut_type(ty_name) == false
    }
    if v4_ty_is_closure_type(ty_name) {
        give back v4_ty_closure_doctrine(ty_name) == v4_ty_closure_callable
    }
    if ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_num {
        give back true
    }
    if ty_name == v4_ty_float or ty_name == v4_ty_float32 or ty_name == v4_ty_big or ty_name == v4_ty_bool or ty_name == v4_ty_char or ty_name == v4_ty_void {
        give back true
    }
    if v4_ty_is_raw_pointer_type(ty_name) {
        give back true
    }
    give back false
}

task v4_ty_type_is_structurally_copy(ty_id: int, type_text: word, depth: int) -> bool {
    if depth > v4_ty_lend_storage_depth_limit or not v4_ty_is_known(type_text) {
        give back false
    }
    if v4_ty_is_copy_type(type_text) {
        give back true
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if not v4_ty_type_is_structurally_copy(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), depth + 1) {
                give back false
            }
            slot_id += 1
        }
        give back true
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_is_structurally_copy(ty_id, v4_ty_fixed_array_element_type(type_text), depth + 1)
    }
    give back false
}

task v4_ty_type_is_doctrinal_copy_eligible(ty_id: int, sig_id: int, type_text: word, seen_types: word, depth: int) -> bool {
    if depth > v4_ty_lend_storage_depth_limit or not v4_ty_is_known(type_text) {
        give back false
    }
    if v4_ty_is_copy_type(type_text) {
        give back true
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if not v4_ty_type_is_doctrinal_copy_eligible(ty_id, sig_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_types, depth + 1) {
                give back false
            }
            slot_id += 1
        }
        give back true
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_is_doctrinal_copy_eligible(ty_id, sig_id, v4_ty_fixed_array_element_type(type_text), seen_types, depth + 1)
    }

    pilot alias_lookup = v4_ty_alias_lookup_type_from_surface_type(ty_id, type_text)
    if alias_lookup != "" {
        pilot alias_key = "copy-alias:" + alias_lookup
        if v4_ty_alias_cycle_seen_contains(seen_types, alias_key) {
            give back false
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, alias_lookup)
        if alias_target == "" or alias_target == v4_ty_unknown {
            give back false
        }
        give back v4_ty_type_is_doctrinal_copy_eligible(ty_id, sig_id, alias_target, v4_ty_alias_cycle_seen_append(seen_types, alias_key), depth + 1)
    }

    if sig_id >= 0 and v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text) {
        give back v4_ty_match_type_satisfies_doctrine_env(ty_id, sig_id, type_text, "Copy", "") != v4_ty_generic_env_fail
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown {
        storage_type = type_text
    }
    if v4_ty_match_type_satisfies_doctrine_env(ty_id, sig_id, storage_type, "Copy", "") == v4_ty_generic_env_fail {
        give back false
    }
    -- Concrete Copy impl matching validates every nominal field before succeeding.
    give back true
}

task v4_ty_type_satisfies_repeat_doctrine(ty_id: int, sig_id: int, type_text: word, doctrine_name: word) -> bool {
    if v4_ty_match_type_satisfies_doctrine_env(ty_id, sig_id, type_text, doctrine_name, "") == v4_ty_generic_env_fail {
        give back false
    }
    if doctrine_name == "Copy" {
        give back v4_ty_type_is_doctrinal_copy_eligible(ty_id, sig_id, type_text, "", 0)
    }
    give back true
}

task v4_ty_type_is_array_repeatable(ty_id: int, sig_id: int, type_text: word) -> bool {
    if v4_ty_type_is_structurally_copy(ty_id, type_text, 0) {
        give back true
    }
    if v4_ty_type_satisfies_repeat_doctrine(ty_id, sig_id, type_text, "Copy") {
        give back true
    }
    give back v4_ty_type_satisfies_repeat_doctrine(ty_id, sig_id, type_text, "Cloneable")
}

task v4_ty_is_primitive_type(ty_name: word) -> bool {
    if ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_num {
        give back true
    }
    if ty_name == v4_ty_float or ty_name == v4_ty_float32 or ty_name == v4_ty_big or ty_name == v4_ty_word {
        give back true
    }
    if ty_name == v4_ty_bool or ty_name == v4_ty_char or ty_name == v4_ty_void or ty_name == v4_ty_never {
        give back true
    }
    give back false
}

task v4_ty_numeric_rank(ty_name: word) -> int {
    if ty_name == v4_ty_tiny {
        give back 1
    }
    if ty_name == v4_ty_int or ty_name == v4_ty_uint {
        give back 2
    }
    if ty_name == v4_ty_big {
        give back 3
    }
    if ty_name == v4_ty_float32 {
        give back 4
    }
    if ty_name == v4_ty_num or ty_name == v4_ty_float {
        give back 5
    }
    give back 0
}

task v4_ty_contextual_numeric_literal_type(default_ty: word, expected_ty: word) -> word {
    if not v4_ty_is_known(expected_ty) {
        give back default_ty
    }
    if default_ty == v4_ty_int {
        if v4_ty_is_numeric(expected_ty) {
            give back expected_ty
        }
    }
    if default_ty == v4_ty_num {
        if v4_ty_is_float(expected_ty) {
            give back expected_ty
        }
    }
    give back default_ty
}

task v4_ty_numeric_literal_suffix(value: word) -> word {
    if value.length() <= 0 {
        give back ""
    }
    pilot suffix = value.char_at(value.length() - 1)
    if suffix == "u" or suffix == "t" or suffix == "b" or suffix == "f" {
        give back suffix
    }
    give back ""
}

task v4_ty_numeric_literal_value(value: word) -> word {
    pilot suffix = v4_ty_numeric_literal_suffix(value)
    if suffix == "" {
        give back value
    }
    give back value.substring(0, value.length() - 1)
}

task v4_ty_int_literal_type(value: word, expected_ty: word) -> word {
    pilot suffix = v4_ty_numeric_literal_suffix(value)
    if suffix == "u" {
        give back v4_ty_uint
    }
    if suffix == "t" {
        give back v4_ty_tiny
    }
    if suffix == "b" {
        give back v4_ty_big
    }
    give back v4_ty_contextual_numeric_literal_type(v4_ty_int, expected_ty)
}

task v4_ty_float_literal_type(value: word, expected_ty: word) -> word {
    if v4_ty_numeric_literal_suffix(value) == "f" {
        give back v4_ty_float
    }
    give back v4_ty_contextual_numeric_literal_type(v4_ty_num, expected_ty)
}

task v4_ty_is_known(ty_name: word) -> bool {
    give back ty_name != "" and ty_name != v4_ty_unknown
}

task v4_ty_lend_type_with_lifetime(target_ty: word, mode: word, lifetime_name: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    if lifetime_name != "" and not v4_ty_is_lifetime_name(lifetime_name) {
        give back v4_ty_unknown
    }
    pilot lifetime_prefix = ""
    if v4_ty_is_lifetime_name(lifetime_name) {
        lifetime_prefix = lifetime_name + " "
    }
    if mode == v4_ty_param_mode_lend_mut {
        give back "lend mut " + lifetime_prefix + target_ty
    }
    give back "lend " + lifetime_prefix + target_ty
}

task v4_ty_lend_type(target_ty: word, mode: word) -> word {
    give back v4_ty_lend_type_with_lifetime(target_ty, mode, "")
}

task v4_ty_is_lend_mut_type(ty_name: word) -> bool {
    give back ty_name.starts_with("lend mut ") and ty_name.length() > 9
}

task v4_ty_is_lend_type(ty_name: word) -> bool {
    if v4_ty_is_lend_mut_type(ty_name) {
        give back true
    }
    give back ty_name.starts_with("lend ") and ty_name.length() > 5
}

task v4_ty_lend_mode(ty_name: word) -> word {
    if v4_ty_is_lend_mut_type(ty_name) {
        give back v4_ty_param_mode_lend_mut
    }
    if v4_ty_is_lend_type(ty_name) {
        give back v4_ty_param_mode_lend
    }
    give back v4_ty_param_mode_value
}

task v4_ty_lend_payload_start(ty_name: word) -> int {
    if v4_ty_is_lend_mut_type(ty_name) {
        give back 9
    }
    if v4_ty_is_lend_type(ty_name) {
        give back 5
    }
    give back 0 - 1
}

task v4_ty_lend_lifetime(ty_name: word) -> word {
    pilot payload_start = v4_ty_lend_payload_start(ty_name)
    if payload_start < 0 or payload_start >= ty_name.length() {
        give back ""
    }
    if ty_name.char_at(payload_start) != "'" {
        give back ""
    }
    pilot lifetime_end = v4_ty_lifetime_name_end(ty_name, payload_start)
    if lifetime_end <= payload_start {
        give back ""
    }
    if lifetime_end == ty_name.length() {
        give back v4_slice(ty_name, payload_start, lifetime_end)
    }
    if ty_name.char_at(lifetime_end) != " " {
        give back ""
    }
    give back v4_slice(ty_name, payload_start, lifetime_end)
}

task v4_ty_lend_target_type(ty_name: word) -> word {
    pilot payload_start = v4_ty_lend_payload_start(ty_name)
    if payload_start < 0 or payload_start >= ty_name.length() {
        give back v4_ty_unknown
    }
    pilot lifetime_name = v4_ty_lend_lifetime(ty_name)
    if lifetime_name != "" {
        payload_start += lifetime_name.length() + 1
    }
    if payload_start >= ty_name.length() {
        give back v4_ty_unknown
    }
    give back v4_slice(ty_name, payload_start, ty_name.length())
}

task v4_ty_dyn_type(doctrine_name: word) -> word {
    if doctrine_name == "" or doctrine_name == v4_ty_unknown {
        give back v4_ty_unknown
    }
    give back "dyn " + doctrine_name
}

task v4_ty_is_dyn_type(type_text: word) -> bool {
    give back type_text.starts_with("dyn ") and type_text.length() > 4
}

task v4_ty_dyn_doctrine_name(type_text: word) -> word {
    if not v4_ty_is_dyn_type(type_text) {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, 4, type_text.length())
}

task v4_ty_dyn_doctrine_lookup_name(type_text: word) -> word {
    pilot doctrine_name = v4_ty_dyn_doctrine_name(type_text)
    if doctrine_name == "" or doctrine_name == v4_ty_unknown {
        give back ""
    }
    give back doctrine_name
}

task v4_ty_doctrine_lookup_base_name(doctrine_name: word) -> word {
    if doctrine_name == "" or doctrine_name == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_generic_instance_type(doctrine_name) {
        give back v4_ty_generic_base_name(doctrine_name)
    }
    give back doctrine_name
}

task v4_ty_dyn_doctrine_base_name(type_text: word) -> word {
    give back v4_ty_doctrine_lookup_base_name(v4_ty_dyn_doctrine_name(type_text))
}

task v4_ty_type_contains_dyn(type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_dyn_type(type_text) {
        give back true
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_ty_type_contains_dyn(v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_contains_dyn(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if v4_ty_type_contains_dyn(v4_ty_generic_arg(type_text, arg_idx)) {
                give back true
            }
            arg_idx += 1
        }
        give back false
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if v4_ty_type_contains_dyn(v4_ty_tuple_slot_type(type_text, slot_idx)) {
                give back true
            }
            slot_idx += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_contains_dyn(v4_ty_fixed_array_element_type(type_text))
    }
    give back false
}

task v4_ty_doctrine_refs_match(wanted_doctrine: word, candidate_doctrine: word) -> bool {
    if wanted_doctrine == "" or candidate_doctrine == "" {
        give back false
    }
    if wanted_doctrine == candidate_doctrine {
        give back true
    }
    if v4_ty_is_generic_instance_type(wanted_doctrine) or v4_ty_is_generic_instance_type(candidate_doctrine) {
        if not v4_ty_is_generic_instance_type(wanted_doctrine) or not v4_ty_is_generic_instance_type(candidate_doctrine) {
            give back false
        }
        if v4_ty_generic_base_name(wanted_doctrine) != v4_ty_generic_base_name(candidate_doctrine) {
            give back false
        }
        if v4_ty_generic_arg_count(wanted_doctrine) != v4_ty_generic_arg_count(candidate_doctrine) {
            give back false
        }
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(wanted_doctrine)
        repeat until arg_id >= arg_count {
            if v4_ty_generic_arg(wanted_doctrine, arg_id) != v4_ty_generic_arg(candidate_doctrine, arg_id) {
                give back false
            }
            arg_id += 1
        }
        give back true
    }
    give back false
}

task v4_ty_canonical_or_self(ty_id: int, type_text: word) -> word {
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    if canonical == "" or canonical == v4_ty_unknown {
        give back type_text
    }
    give back canonical
}

task v4_ty_doctrine_refs_match_canonical(ty_id: int, wanted_doctrine: word, candidate_doctrine: word) -> bool {
    if v4_ty_doctrine_refs_match(wanted_doctrine, candidate_doctrine) {
        give back true
    }
    if wanted_doctrine == "" or candidate_doctrine == "" {
        give back false
    }
    if v4_ty_is_generic_instance_type(wanted_doctrine) or v4_ty_is_generic_instance_type(candidate_doctrine) {
        if not v4_ty_is_generic_instance_type(wanted_doctrine) or not v4_ty_is_generic_instance_type(candidate_doctrine) {
            give back false
        }
        if v4_ty_generic_base_name(wanted_doctrine) != v4_ty_generic_base_name(candidate_doctrine) {
            give back false
        }
        if v4_ty_generic_arg_count(wanted_doctrine) != v4_ty_generic_arg_count(candidate_doctrine) {
            give back false
        }
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(wanted_doctrine)
        repeat until arg_id >= arg_count {
            pilot wanted_arg = v4_ty_canonical_or_self(ty_id, v4_ty_generic_arg(wanted_doctrine, arg_id))
            pilot candidate_arg = v4_ty_canonical_or_self(ty_id, v4_ty_generic_arg(candidate_doctrine, arg_id))
            if wanted_arg != candidate_arg {
                give back false
            }
            arg_id += 1
        }
        give back true
    }
    give back false
}

task v4_ty_doctrine_ref_resolve(ty_id: int, doctrine_ref: word) -> word {
    if doctrine_ref == "" or doctrine_ref == v4_ty_unknown {
        give back doctrine_ref
    }
    pilot lookup = v4_ty_doctrine_lookup_type_from_surface_type(ty_id, doctrine_ref)
    if lookup != "" {
        give back lookup
    }
    give back doctrine_ref
}

task v4_ty_shared_type(target_ty: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    give back "Shared<" + target_ty + ">"
}

task v4_ty_weak_type(target_ty: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    give back "Weak<" + target_ty + ">"
}

task v4_ty_shared_mut_type(target_ty: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    give back "SharedMut<" + target_ty + ">"
}

task v4_ty_generic_base_is(type_text: word, base_name: word) -> bool {
    if not v4_ty_is_generic_instance_type(type_text) {
        give back false
    }
    if v4_ty_generic_base_name(type_text) != base_name {
        give back false
    }
    give back v4_ty_generic_arg_count(type_text) == 1
}

task v4_ty_is_nominal_prelude_dyn_carrier(ty_id: int, type_text: word) -> bool {
    if not v4_ty_is_generic_instance_type(type_text) {
        give back false
    }
    if v4_ty_generic_arg_count(type_text) != 1 {
        give back false
    }
    pilot base_name = v4_ty_generic_base_name(type_text)
    if base_name != "Shared" and base_name != "Weak" {
        give back false
    }
    if v4_ty_type_signature_id_for_name(ty_id, base_name) >= 0 {
        give back false
    }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot expanded = v4_resolve_expand_import_name(resolve_id, base_name)
        if expanded != "" and expanded != base_name {
            give back false
        }
    }
    give back true
}

task v4_ty_is_shared_type(type_text: word) -> bool {
    give back v4_ty_generic_base_is(type_text, "Shared")
}

task v4_ty_is_weak_type(type_text: word) -> bool {
    give back v4_ty_generic_base_is(type_text, "Weak")
}

task v4_ty_is_shared_mut_type(type_text: word) -> bool {
    give back v4_ty_generic_base_is(type_text, "SharedMut")
}

task v4_ty_shared_target_type(type_text: word) -> word {
    if v4_ty_is_shared_type(type_text) or v4_ty_is_weak_type(type_text) or v4_ty_is_shared_mut_type(type_text) {
        give back v4_ty_generic_arg(type_text, 0)
    }
    give back v4_ty_unknown
}

task v4_ty_type_contains_shared_mut(type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_shared_mut_type(type_text) {
        give back true
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_ty_type_contains_shared_mut(v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_contains_shared_mut(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_type_contains_shared_mut(v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back true
            }
            slot_id += 1
        }
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_contains_shared_mut(v4_ty_fixed_array_element_type(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_id >= arg_count {
            if v4_ty_type_contains_shared_mut(v4_ty_generic_arg(type_text, arg_id)) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_ty_is_lifetime_name(ty_name: word) -> bool {
    give back ty_name.length() > 1 and ty_name.char_at(0) == "'"
}

task v4_ty_lifetime_name_end(type_text: word, start_pos: int) -> int {
    if start_pos < 0 or start_pos >= type_text.length() {
        give back start_pos
    }
    if type_text.char_at(start_pos) != "'" {
        give back start_pos
    }
    if start_pos + 1 >= type_text.length() {
        give back start_pos
    }
    if v4_lex_is_ident_start(type_text.char_at(start_pos + 1)) == false {
        give back start_pos
    }

    pilot idx = start_pos + 2
    repeat until idx >= type_text.length() or v4_lex_is_ident_continue(type_text.char_at(idx)) == false {
        idx += 1
    }
    give back idx
}

task v4_ty_type_lifetime_count(type_text: word) -> int {
    pilot count = 0
    pilot idx = 0
    repeat until idx >= type_text.length() {
        if type_text.char_at(idx) == "'" {
            pilot lifetime_end = v4_ty_lifetime_name_end(type_text, idx)
            if lifetime_end > idx {
                count += 1
                idx = lifetime_end
            } else {
                idx += 1
            }
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_type_lifetime_name(type_text: word, lifetime_id: int) -> word {
    if lifetime_id < 0 {
        give back ""
    }

    pilot seen = 0
    pilot idx = 0
    repeat until idx >= type_text.length() {
        if type_text.char_at(idx) == "'" {
            pilot lifetime_end = v4_ty_lifetime_name_end(type_text, idx)
            if lifetime_end > idx {
                if seen == lifetime_id {
                    give back v4_slice(type_text, idx, lifetime_end)
                }
                seen += 1
                idx = lifetime_end
            } else {
                idx += 1
            }
        } else {
            idx += 1
        }
    }
    give back ""
}

task v4_ty_type_mentions_lifetime(type_text: word, lifetime_name: word) -> bool {
    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        if v4_ty_type_lifetime_name(type_text, lifetime_id) == lifetime_name {
            give back true
        }
        lifetime_id += 1
    }
    give back false
}

task v4_ty_type_contains_named_lend(type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_lend_type(type_text) {
        pilot lifetime_name = v4_ty_lend_lifetime(type_text)
        if lifetime_name != "" and lifetime_name != "'_" {
            give back true
        }
        give back v4_ty_type_contains_named_lend(v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        pilot param_id = 0
        repeat until param_id >= v4_ty_function_type_param_count(type_text) {
            if v4_ty_type_contains_named_lend(v4_ty_function_type_param_surface(type_text, param_id)) {
                give back true
            }
            param_id += 1
        }
        give back v4_ty_type_contains_named_lend(v4_ty_function_type_return_text(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_contains_named_lend(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_type_contains_named_lend(v4_ty_dyn_doctrine_name(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_id = 0
        repeat until arg_id >= v4_ty_generic_arg_count(type_text) {
            if v4_ty_type_contains_named_lend(v4_ty_generic_arg(type_text, arg_id)) {
                give back true
            }
            arg_id += 1
        }
        give back false
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        repeat until slot_id >= v4_ty_tuple_slot_count(type_text) {
            if v4_ty_type_contains_named_lend(v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back true
            }
            slot_id += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_contains_named_lend(v4_ty_fixed_array_element_type(type_text))
    }
    give back false
}

task v4_ty_type_contains_lend(type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_lend_type(type_text) {
        give back true
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        pilot param_id = 0
        repeat until param_id >= v4_ty_function_type_param_count(type_text) {
            if v4_ty_type_contains_lend(v4_ty_function_type_param_surface(type_text, param_id)) {
                give back true
            }
            param_id += 1
        }
        give back v4_ty_type_contains_lend(v4_ty_function_type_return_text(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_contains_lend(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_type_contains_lend(v4_ty_dyn_doctrine_name(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_id = 0
        repeat until arg_id >= v4_ty_generic_arg_count(type_text) {
            if v4_ty_type_contains_lend(v4_ty_generic_arg(type_text, arg_id)) {
                give back true
            }
            arg_id += 1
        }
        give back false
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        repeat until slot_id >= v4_ty_tuple_slot_count(type_text) {
            if v4_ty_type_contains_lend(v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back true
            }
            slot_id += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_contains_lend(v4_ty_fixed_array_element_type(type_text))
    }
    give back false
}

-- Fixed lend storage may recurse only through tuples, arrays, shapes, and routes.
task v4_ty_lend_storage_class_merge(left_kind: word, right_kind: word) -> word {
    if left_kind == v4_ty_lend_storage_unsupported or right_kind == v4_ty_lend_storage_unsupported {
        give back v4_ty_lend_storage_unsupported
    }
    if left_kind == v4_ty_lend_storage_exhausted or right_kind == v4_ty_lend_storage_exhausted {
        give back v4_ty_lend_storage_exhausted
    }
    if left_kind == v4_ty_lend_storage_opaque or right_kind == v4_ty_lend_storage_opaque {
        give back v4_ty_lend_storage_opaque
    }
    if left_kind == v4_ty_lend_storage_fixed or right_kind == v4_ty_lend_storage_fixed {
        give back v4_ty_lend_storage_fixed
    }
    give back v4_ty_lend_storage_none
}

task v4_ty_lend_storage_wrap_unsupported(child_kind: word) -> word {
    if child_kind == v4_ty_lend_storage_none {
        give back v4_ty_lend_storage_none
    }
    if child_kind == v4_ty_lend_storage_exhausted {
        give back v4_ty_lend_storage_exhausted
    }
    if child_kind == v4_ty_lend_storage_opaque {
        give back v4_ty_lend_storage_opaque
    }
    give back v4_ty_lend_storage_unsupported
}

task v4_ty_lend_storage_class_seen(ty_id: int, type_text: word, seen_types: word, depth: int, named_only: bool, mutable_only: bool) -> word {
    if type_text == "" or type_text == v4_ty_unknown or v4_ty_is_lifetime_name(type_text) {
        give back v4_ty_lend_storage_none
    }
    if depth > v4_ty_lend_storage_depth_limit {
        give back v4_ty_lend_storage_exhausted
    }

    if v4_ty_is_lend_type(type_text) {
        pilot lifetime_name = v4_ty_lend_lifetime(type_text)
        pilot lifetime_matches: bool = not named_only or (lifetime_name != "" and lifetime_name != "'_")
        pilot mutability_matches: bool = not mutable_only or v4_ty_is_lend_mut_type(type_text)
        if lifetime_matches and mutability_matches {
            give back v4_ty_lend_storage_fixed
        }
        -- A lend stores only its own capability; fields in the referent are not nested in the lend value.
        give back v4_ty_lend_storage_none
    }

    if v4_ty_is_surface_task_function_type(type_text) {
        pilot function_kind = v4_ty_lend_storage_none
        pilot param_id = 0
        pilot param_count = v4_ty_function_type_param_count(type_text)
        repeat until param_id >= param_count {
            pilot param_surface = v4_ty_function_type_param_surface(type_text, param_id)
            if param_surface != "..." {
                function_kind = v4_ty_lend_storage_class_merge(function_kind, v4_ty_lend_storage_class_seen(ty_id, param_surface, seen_types, depth + 1, named_only, mutable_only))
            }
            param_id += 1
        }
        function_kind = v4_ty_lend_storage_class_merge(function_kind, v4_ty_lend_storage_class_seen(ty_id, v4_ty_function_type_return_text(type_text), seen_types, depth + 1, named_only, mutable_only))
        give back v4_ty_lend_storage_wrap_unsupported(function_kind)
    }

    if v4_ty_is_raw_pointer_type(type_text) {
        pilot pointer_kind = v4_ty_lend_storage_class_seen(ty_id, v4_ty_raw_pointer_target_type(type_text), seen_types, depth + 1, named_only, mutable_only)
        give back v4_ty_lend_storage_wrap_unsupported(pointer_kind)
    }

    if v4_ty_is_dyn_type(type_text) {
        pilot doctrine_kind = v4_ty_lend_storage_class_seen(ty_id, v4_ty_dyn_doctrine_name(type_text), seen_types, depth + 1, named_only, mutable_only)
        give back v4_ty_lend_storage_wrap_unsupported(doctrine_kind)
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot tuple_kind = v4_ty_lend_storage_none
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            tuple_kind = v4_ty_lend_storage_class_merge(tuple_kind, v4_ty_lend_storage_class_seen(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_types, depth + 1, named_only, mutable_only))
            slot_id += 1
        }
        give back tuple_kind
    }

    if v4_ty_is_fixed_array_type(type_text) {
        if v4_ty_fixed_array_length_normalized_text(ty_id, type_text) == "0" {
            give back v4_ty_lend_storage_none
        }
        give back v4_ty_lend_storage_class_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_types, depth + 1, named_only, mutable_only)
    }

    pilot alias_lookup = v4_ty_alias_lookup_type_from_surface_type(ty_id, type_text)
    if alias_lookup != "" {
        pilot alias_key = "alias:" + alias_lookup
        if v4_ty_alias_cycle_seen_contains(seen_types, alias_key) {
            give back v4_ty_lend_storage_none
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, alias_lookup)
        if alias_target == "" or alias_target == v4_ty_unknown {
            give back v4_ty_lend_storage_none
        }
        pilot alias_kind = v4_ty_lend_storage_class_seen(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_types, alias_key), depth + 1, named_only, mutable_only)
        give back v4_ty_lend_storage_wrap_unsupported(alias_kind)
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown {
        storage_type = type_text
    }

    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, storage_type)
    if shape_sig >= 0 {
        pilot shape_key = "shape:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, shape_key) {
            give back v4_ty_lend_storage_none
        }
        pilot shape_seen = v4_ty_alias_cycle_seen_append(seen_types, shape_key)
        pilot shape_kind = v4_ty_lend_storage_none
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            pilot field_type = v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id)
            field_type = v4_ty_apply_signature_generics(ty_id, shape_sig, storage_type, field_type)
            shape_kind = v4_ty_lend_storage_class_merge(shape_kind, v4_ty_lend_storage_class_seen(ty_id, field_type, shape_seen, depth + 1, named_only, mutable_only))
            field_id += 1
        }
        give back shape_kind
    }

    pilot route_sig = v4_ty_route_signature_id_for_name(ty_id, storage_type)
    if route_sig >= 0 {
        pilot route_key = "route:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, route_key) {
            give back v4_ty_lend_storage_none
        }
        pilot route_seen = v4_ty_alias_cycle_seen_append(seen_types, route_key)
        pilot route_kind = v4_ty_lend_storage_none
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, route_sig)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, route_sig, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, storage_type, case_name)
            repeat until field_id >= field_count {
                pilot field_type = v4_ty_route_case_field_surface_type(ty_id, storage_type, case_name, field_id)
                field_type = v4_ty_apply_signature_generics(ty_id, route_sig, storage_type, field_type)
                route_kind = v4_ty_lend_storage_class_merge(route_kind, v4_ty_lend_storage_class_seen(ty_id, field_type, route_seen, depth + 1, named_only, mutable_only))
                field_id += 1
            }
            case_id += 1
        }
        give back route_kind
    }

    if v4_ty_is_generic_instance_type(storage_type) {
        pilot generic_kind = v4_ty_lend_storage_none
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(storage_type)
        repeat until arg_id >= arg_count {
            pilot arg_type = v4_ty_generic_arg(storage_type, arg_id)
            if not v4_ty_is_lifetime_name(arg_type) {
                generic_kind = v4_ty_lend_storage_class_merge(generic_kind, v4_ty_lend_storage_class_seen(ty_id, arg_type, seen_types, depth + 1, named_only, mutable_only))
            }
            arg_id += 1
        }
        give back v4_ty_lend_storage_wrap_unsupported(generic_kind)
    }

    give back v4_ty_lend_storage_none
}

task v4_ty_type_lend_storage_class(ty_id: int, type_text: word) -> word {
    give back v4_ty_lend_storage_class_seen(ty_id, type_text, "", 0, false, false)
}

task v4_ty_lend_storage_class_confirms_lend(storage_kind: word) -> bool {
    give back storage_kind == v4_ty_lend_storage_fixed or storage_kind == v4_ty_lend_storage_unsupported
}

task v4_ty_lend_storage_class_is_incomplete(storage_kind: word) -> bool {
    give back storage_kind == v4_ty_lend_storage_exhausted or storage_kind == v4_ty_lend_storage_opaque
}

task v4_ty_type_lend_storage_exhausted(ty_id: int, type_text: word) -> bool {
    give back v4_ty_lend_storage_class_is_incomplete(v4_ty_type_lend_storage_class(ty_id, type_text))
}

task v4_ty_type_stores_lend(ty_id: int, type_text: word) -> bool {
    give back v4_ty_lend_storage_class_confirms_lend(v4_ty_type_lend_storage_class(ty_id, type_text))
}

task v4_ty_type_may_store_lend(ty_id: int, type_text: word) -> bool {
    give back v4_ty_type_lend_storage_class(ty_id, type_text) != v4_ty_lend_storage_none
}

task v4_ty_type_stores_mut_lend(ty_id: int, type_text: word) -> bool {
    give back v4_ty_lend_storage_class_confirms_lend(v4_ty_lend_storage_class_seen(ty_id, type_text, "", 0, false, true))
}

task v4_ty_type_may_store_mut_lend(ty_id: int, type_text: word) -> bool {
    give back v4_ty_lend_storage_class_seen(ty_id, type_text, "", 0, false, true) != v4_ty_lend_storage_none
}

task v4_ty_type_stores_named_lend(ty_id: int, type_text: word) -> bool {
    give back v4_ty_lend_storage_class_confirms_lend(v4_ty_lend_storage_class_seen(ty_id, type_text, "", 0, true, false))
}

task v4_ty_type_supports_fixed_lend_storage(ty_id: int, type_text: word) -> bool {
    pilot storage_kind = v4_ty_type_lend_storage_class(ty_id, type_text)
    give back storage_kind == v4_ty_lend_storage_none or storage_kind == v4_ty_lend_storage_fixed
}

task v4_ty_fixed_lend_leaf_count_seen(ty_id: int, type_text: word, seen_types: word, depth: int) -> int {
    if type_text == "" or type_text == v4_ty_unknown or v4_ty_is_lifetime_name(type_text) {
        give back 0
    }
    if depth > v4_ty_lend_storage_depth_limit {
        give back 0 - 1
    }
    if v4_ty_is_lend_type(type_text) {
        give back 1
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot count = 0
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_types, depth + 1)
            if child_count < 0 {
                give back 0 - 1
            }
            count += child_count
            if count > v4_ty_fixed_lend_leaf_limit { give back 0 - 1 }
            slot_id += 1
        }
        give back count
    }
    if v4_ty_is_fixed_array_type(type_text) {
        pilot length_text = v4_ty_fixed_array_length_normalized_text(ty_id, type_text)
        if length_text == "0" {
            give back 0
        }
        give back v4_ty_fixed_lend_leaf_count_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_types, depth + 1)
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown {
        storage_type = type_text
    }
    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, storage_type)
    if shape_sig >= 0 {
        pilot shape_key = "shape:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, shape_key) {
            give back 0 - 1
        }
        pilot shape_seen = v4_ty_alias_cycle_seen_append(seen_types, shape_key)
        pilot count = 0
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            pilot field_type = v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id)
            field_type = v4_ty_apply_signature_generics(ty_id, shape_sig, storage_type, field_type)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, shape_seen, depth + 1)
            if child_count < 0 {
                give back 0 - 1
            }
            count += child_count
            if count > v4_ty_fixed_lend_leaf_limit { give back 0 - 1 }
            field_id += 1
        }
        give back count
    }

    pilot route_sig = v4_ty_route_signature_id_for_name(ty_id, storage_type)
    if route_sig >= 0 {
        pilot route_key = "route:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, route_key) {
            give back 0 - 1
        }
        pilot route_seen = v4_ty_alias_cycle_seen_append(seen_types, route_key)
        pilot count = 0
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, route_sig)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, route_sig, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, storage_type, case_name)
            repeat until field_id >= field_count {
                pilot field_type = v4_ty_route_case_field_surface_type(ty_id, storage_type, case_name, field_id)
                field_type = v4_ty_apply_signature_generics(ty_id, route_sig, storage_type, field_type)
                pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, route_seen, depth + 1)
                if child_count < 0 {
                    give back 0 - 1
                }
                count += child_count
                if count > v4_ty_fixed_lend_leaf_limit { give back 0 - 1 }
                field_id += 1
            }
            case_id += 1
        }
        give back count
    }
    give back 0
}

task v4_ty_fixed_lend_leaf_count(ty_id: int, type_text: word) -> int {
    if not v4_ty_type_supports_fixed_lend_storage(ty_id, type_text) {
        give back 0 - 1
    }
    give back v4_ty_fixed_lend_leaf_count_seen(ty_id, type_text, "", 0)
}
task v4_ty_fixed_lend_leaf_type_at_seen(ty_id: int, type_text: word, seen_types: word, depth: int, leaf_id: int) -> word {
    if leaf_id < 0 or depth > v4_ty_lend_storage_depth_limit {
        give back v4_ty_unknown
    }
    if v4_ty_is_lend_type(type_text) {
        if leaf_id == 0 {
            give back type_text
        }
        give back v4_ty_unknown
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_type = v4_ty_tuple_slot_type(type_text, slot_id)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, slot_type, seen_types, depth + 1)
            if child_count < 0 {
                give back v4_ty_unknown
            }
            if leaf_id < child_count {
                give back v4_ty_fixed_lend_leaf_type_at_seen(ty_id, slot_type, seen_types, depth + 1, leaf_id)
            }
            leaf_id -= child_count
            slot_id += 1
        }
        give back v4_ty_unknown
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_fixed_lend_leaf_type_at_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_types, depth + 1, leaf_id)
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown {
        storage_type = type_text
    }
    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, storage_type)
    if shape_sig >= 0 {
        pilot shape_key = "shape:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, shape_key) {
            give back v4_ty_unknown
        }
        pilot shape_seen = v4_ty_alias_cycle_seen_append(seen_types, shape_key)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            pilot field_type = v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id)
            field_type = v4_ty_apply_signature_generics(ty_id, shape_sig, storage_type, field_type)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, shape_seen, depth + 1)
            if child_count < 0 {
                give back v4_ty_unknown
            }
            if leaf_id < child_count {
                give back v4_ty_fixed_lend_leaf_type_at_seen(ty_id, field_type, shape_seen, depth + 1, leaf_id)
            }
            leaf_id -= child_count
            field_id += 1
        }
        give back v4_ty_unknown
    }

    pilot route_sig = v4_ty_route_signature_id_for_name(ty_id, storage_type)
    if route_sig >= 0 {
        pilot route_key = "route:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, route_key) {
            give back v4_ty_unknown
        }
        pilot route_seen = v4_ty_alias_cycle_seen_append(seen_types, route_key)
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, route_sig)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, route_sig, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, storage_type, case_name)
            repeat until field_id >= field_count {
                pilot field_type = v4_ty_route_case_field_surface_type(ty_id, storage_type, case_name, field_id)
                field_type = v4_ty_apply_signature_generics(ty_id, route_sig, storage_type, field_type)
                pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, route_seen, depth + 1)
                if child_count < 0 {
                    give back v4_ty_unknown
                }
                if leaf_id < child_count {
                    give back v4_ty_fixed_lend_leaf_type_at_seen(ty_id, field_type, route_seen, depth + 1, leaf_id)
                }
                leaf_id -= child_count
                field_id += 1
            }
            case_id += 1
        }
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_lend_leaf_type_at(ty_id: int, type_text: word, leaf_id: int) -> word {
    if not v4_ty_type_supports_fixed_lend_storage(ty_id, type_text) {
        give back v4_ty_unknown
    }
    give back v4_ty_fixed_lend_leaf_type_at_seen(ty_id, type_text, "", 0, leaf_id)
}
task v4_ty_fixed_lend_leaf_projection_at_seen(ty_id: int, type_text: word, seen_types: word, depth: int, leaf_id: int) -> word {
    if leaf_id < 0 or depth > v4_ty_lend_storage_depth_limit or v4_ty_is_lend_type(type_text) {
        give back ""
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_type = v4_ty_tuple_slot_type(type_text, slot_id)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, slot_type, seen_types, depth + 1)
            if child_count < 0 { give back "" }
            if leaf_id < child_count {
                give back "." + word_from_int(slot_id) + v4_ty_fixed_lend_leaf_projection_at_seen(ty_id, slot_type, seen_types, depth + 1, leaf_id)
            }
            leaf_id -= child_count
            slot_id += 1
        }
        give back ""
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back "[*]" + v4_ty_fixed_lend_leaf_projection_at_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_types, depth + 1, leaf_id)
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown { storage_type = type_text }
    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, storage_type)
    if shape_sig >= 0 {
        pilot shape_key = "shape:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, shape_key) { give back "" }
        pilot shape_seen = v4_ty_alias_cycle_seen_append(seen_types, shape_key)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            pilot field_type = v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id)
            field_type = v4_ty_apply_signature_generics(ty_id, shape_sig, storage_type, field_type)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, shape_seen, depth + 1)
            if child_count < 0 { give back "" }
            if leaf_id < child_count {
                give back "." + v4_ty_shape_field_name(ty_id, shape_sig, field_id) + v4_ty_fixed_lend_leaf_projection_at_seen(ty_id, field_type, shape_seen, depth + 1, leaf_id)
            }
            leaf_id -= child_count
            field_id += 1
        }
        give back ""
    }

    pilot route_sig = v4_ty_route_signature_id_for_name(ty_id, storage_type)
    if route_sig >= 0 {
        pilot route_key = "route:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, route_key) { give back "" }
        pilot route_seen = v4_ty_alias_cycle_seen_append(seen_types, route_key)
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, route_sig)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, route_sig, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, storage_type, case_name)
            repeat until field_id >= field_count {
                pilot field_type = v4_ty_route_case_field_surface_type(ty_id, storage_type, case_name, field_id)
                field_type = v4_ty_apply_signature_generics(ty_id, route_sig, storage_type, field_type)
                pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, route_seen, depth + 1)
                if child_count < 0 { give back "" }
                if leaf_id < child_count {
                    give back "." + v4_ty_route_case_field_name(ty_id, storage_type, case_name, field_id) + v4_ty_fixed_lend_leaf_projection_at_seen(ty_id, field_type, route_seen, depth + 1, leaf_id)
                }
                leaf_id -= child_count
                field_id += 1
            }
            case_id += 1
        }
    }
    give back ""
}

task v4_ty_fixed_lend_leaf_projection_at(ty_id: int, type_text: word, leaf_id: int) -> word {
    if leaf_id < 0 or not v4_ty_type_supports_fixed_lend_storage(ty_id, type_text) {
        give back ""
    }
    give back v4_ty_fixed_lend_leaf_projection_at_seen(ty_id, type_text, "", 0, leaf_id)
}

task v4_ty_fixed_lend_leaf_route_guard_at_seen(ty_id: int, type_text: word, seen_types: word, depth: int, leaf_id: int) -> word {
    if leaf_id < 0 or depth > v4_ty_lend_storage_depth_limit or v4_ty_is_lend_type(type_text) { give back "" }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_type = v4_ty_tuple_slot_type(type_text, slot_id)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, slot_type, seen_types, depth + 1)
            if child_count < 0 { give back "" }
            if leaf_id < child_count { give back v4_ty_fixed_lend_leaf_route_guard_at_seen(ty_id, slot_type, seen_types, depth + 1, leaf_id) }
            leaf_id -= child_count
            slot_id += 1
        }
        give back ""
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_fixed_lend_leaf_route_guard_at_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_types, depth + 1, leaf_id)
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown { storage_type = type_text }
    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, storage_type)
    if shape_sig >= 0 {
        pilot shape_key = "shape:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, shape_key) { give back "" }
        pilot shape_seen = v4_ty_alias_cycle_seen_append(seen_types, shape_key)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            pilot field_type = v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id)
            field_type = v4_ty_apply_signature_generics(ty_id, shape_sig, storage_type, field_type)
            pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, shape_seen, depth + 1)
            if child_count < 0 { give back "" }
            if leaf_id < child_count { give back v4_ty_fixed_lend_leaf_route_guard_at_seen(ty_id, field_type, shape_seen, depth + 1, leaf_id) }
            leaf_id -= child_count
            field_id += 1
        }
        give back ""
    }

    pilot route_sig = v4_ty_route_signature_id_for_name(ty_id, storage_type)
    if route_sig >= 0 {
        pilot route_key = "route:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, route_key) { give back "" }
        pilot route_seen = v4_ty_alias_cycle_seen_append(seen_types, route_key)
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, route_sig)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, route_sig, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, storage_type, case_name)
            repeat until field_id >= field_count {
                pilot field_type = v4_ty_route_case_field_surface_type(ty_id, storage_type, case_name, field_id)
                field_type = v4_ty_apply_signature_generics(ty_id, route_sig, storage_type, field_type)
                pilot child_count = v4_ty_fixed_lend_leaf_count_seen(ty_id, field_type, route_seen, depth + 1)
                if child_count < 0 { give back "" }
                if leaf_id < child_count {
                    pilot child_guard = v4_ty_fixed_lend_leaf_route_guard_at_seen(ty_id, field_type, route_seen, depth + 1, leaf_id)
                    pilot guard = storage_type + "::" + case_name
                    if child_guard != "" { guard = guard + "/" + child_guard }
                    give back guard
                }
                leaf_id -= child_count
                field_id += 1
            }
            case_id += 1
        }
    }
    give back ""
}

task v4_ty_fixed_lend_leaf_route_guard_at(ty_id: int, type_text: word, leaf_id: int) -> word {
    if leaf_id < 0 or not v4_ty_type_supports_fixed_lend_storage(ty_id, type_text) { give back "" }
    give back v4_ty_fixed_lend_leaf_route_guard_at_seen(ty_id, type_text, "", 0, leaf_id)
}

task v4_ty_types_compatible(expected_ty: word, actual_ty: word) -> bool {
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back true
    }
    if actual_ty == v4_ty_never {
        give back true
    }
    if expected_ty == actual_ty {
        give back true
    }
    if v4_ty_is_lifetime_name(expected_ty) and v4_ty_is_lifetime_name(actual_ty) {
        give back true
    }
    if v4_ty_is_lend_type(expected_ty) or v4_ty_is_lend_type(actual_ty) {
        if not v4_ty_is_lend_type(expected_ty) or not v4_ty_is_lend_type(actual_ty) {
            give back false
        }
        if v4_ty_lend_mode(expected_ty) != v4_ty_lend_mode(actual_ty) {
            give back false
        }
        give back v4_ty_types_compatible(v4_ty_lend_target_type(expected_ty), v4_ty_lend_target_type(actual_ty))
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back true
    }
    if v4_ty_is_tuple_type(expected_ty) or v4_ty_is_tuple_type(actual_ty) {
        if not v4_ty_is_tuple_type(expected_ty) or not v4_ty_is_tuple_type(actual_ty) {
            give back false
        }
        pilot expected_slots = v4_ty_tuple_slot_count(expected_ty)
        if expected_slots != v4_ty_tuple_slot_count(actual_ty) {
            give back false
        }
        pilot slot_id = 0
        repeat until slot_id >= expected_slots {
            if not v4_ty_types_compatible(v4_ty_tuple_slot_type(expected_ty, slot_id), v4_ty_tuple_slot_type(actual_ty, slot_id)) {
                give back false
            }
            slot_id += 1
        }
        give back true
    }
    if v4_ty_is_fixed_array_type(expected_ty) or v4_ty_is_fixed_array_type(actual_ty) {
        if not v4_ty_is_fixed_array_type(expected_ty) or not v4_ty_is_fixed_array_type(actual_ty) {
            give back false
        }
        if v4_ty_fixed_array_length_text(expected_ty) != v4_ty_fixed_array_length_text(actual_ty) {
            give back false
        }
        give back v4_ty_types_compatible(v4_ty_fixed_array_element_type(expected_ty), v4_ty_fixed_array_element_type(actual_ty))
    }
    if v4_ty_is_raw_pointer_type(expected_ty) and v4_ty_is_raw_pointer_type(actual_ty) {
        if v4_ty_raw_pointer_prefix(expected_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back false
        }
        give back v4_ty_types_compatible(v4_ty_raw_pointer_target_type(expected_ty), v4_ty_raw_pointer_target_type(actual_ty))
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back false
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back false
        }
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        repeat until arg_idx >= arg_count {
            if not v4_ty_types_compatible(v4_ty_generic_arg(expected_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx)) {
                give back false
            }
            arg_idx += 1
        }
        give back true
    }
    give back false
}

task v4_ty_is_declared_simple_type_name(ty_id: int, type_name: word) -> bool {
    if type_name == "" or type_name == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_primitive_type(type_name) {
        give back true
    }
    if type_name == "maybe" or type_name == "result" or type_name == "List" or type_name == "Map" or type_name == "Set" or type_name == "Lineup" {
        give back true
    }
    if type_name == "Shared" or type_name == "Weak" or type_name == "SharedMut" or type_name == "BorrowError" {
        give back true
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_name(ty_id, sig_id) == type_name {
            give back true
        }
        sig_id += 1
    }
    give back false
}

task v4_ty_builtin_generic_arg_count(type_name: word) -> int {
    if type_name == "maybe" or type_name == "List" or type_name == "Set" or type_name == "Lineup" {
        give back 1
    }
    if type_name == "Shared" or type_name == "Weak" or type_name == "SharedMut" {
        give back 1
    }
    if type_name == "result" or type_name == "Map" {
        give back 2
    }
    give back 0 - 1
}

task v4_ty_type_signature_id_for_name(ty_id: int, type_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
        if sig_kind == v4_ty_shape_sig or sig_kind == v4_ty_route_sig or sig_kind == v4_ty_alias_sig or sig_kind == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == type_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_expected_generic_arg_count(ty_id: int, type_name: word) -> int {
    pilot builtin_count = v4_ty_builtin_generic_arg_count(type_name)
    if builtin_count >= 0 {
        give back builtin_count
    }

    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id >= 0 {
        give back v4_ty_signature_generic_count(ty_id, sig_id)
    }
    give back 0 - 1
}

task v4_ty_generic_slot_accepts_lifetime(ty_id: int, type_name: word, arg_id: int) -> bool {
    if arg_id < 0 {
        give back false
    }
    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id < 0 {
        give back false
    }
    if arg_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        give back false
    }
    give back v4_ty_signature_generic_is_lifetime(ty_id, sig_id, arg_id)
}

task v4_ty_generic_slot_accepts_type(ty_id: int, type_name: word, arg_id: int) -> bool {
    if arg_id < 0 {
        give back false
    }

    pilot builtin_count = v4_ty_builtin_generic_arg_count(type_name)
    if builtin_count >= 0 {
        give back arg_id < builtin_count
    }

    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id < 0 {
        give back false
    }
    if arg_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        give back false
    }
    give back v4_ty_signature_generic_is_lifetime(ty_id, sig_id, arg_id) == false
}

task v4_ty_numeric_result(left_ty: word, right_ty: word) -> word {
    if left_ty == v4_ty_unknown or right_ty == v4_ty_unknown {
        give back v4_ty_unknown
    }
    if not v4_ty_is_numeric(left_ty) or not v4_ty_is_numeric(right_ty) {
        give back v4_ty_unknown
    }
    if left_ty == right_ty {
        give back left_ty
    }
    if left_ty == v4_ty_num or right_ty == v4_ty_num {
        give back v4_ty_num
    }
    if left_ty == v4_ty_float or right_ty == v4_ty_float {
        give back v4_ty_float
    }
    if left_ty == v4_ty_float32 or right_ty == v4_ty_float32 {
        give back v4_ty_float32
    }
    if left_ty == v4_ty_big or right_ty == v4_ty_big {
        give back v4_ty_big
    }
    if left_ty == v4_ty_int or right_ty == v4_ty_int {
        give back v4_ty_int
    }
    if left_ty == v4_ty_uint or right_ty == v4_ty_uint {
        give back v4_ty_uint
    }
    if left_ty == v4_ty_tiny or right_ty == v4_ty_tiny {
        give back v4_ty_tiny
    }
    give back v4_ty_unknown
}

task v4_ty_unary_valid(op: word, operand_ty: word) -> bool {
    if not v4_ty_is_known(operand_ty) {
        give back true
    }
    if op == "Neg" {
        give back v4_ty_is_numeric(operand_ty)
    }
    if op == "Not" {
        give back operand_ty == v4_ty_bool
    }
    if op == "Deref" {
        give back v4_ty_is_raw_pointer_type(operand_ty)
    }
    give back true
}

task v4_ty_unary_result(op: word, operand_ty: word) -> word {
    if not v4_ty_unary_valid(op, operand_ty) {
        give back v4_ty_unknown
    }
    if op == "Neg" {
        if v4_ty_is_numeric(operand_ty) {
            give back operand_ty
        }
    }
    if op == "Not" {
        if operand_ty == v4_ty_bool {
            give back v4_ty_bool
        }
    }
    if op == "Deref" {
        if v4_ty_is_raw_pointer_type(operand_ty) {
            give back v4_ty_raw_pointer_target_type(operand_ty)
        }
    }
    give back v4_ty_unknown
}

task v4_ty_binary_operator_doctrine(op: word) -> word {
    if op == "Add" { give back "Add" }
    if op == "Sub" { give back "Sub" }
    if op == "Mul" { give back "Mul" }
    if op == "Div" { give back "Div" }
    if op == "Mod" { give back "Rem" }
    if op == "Eq" or op == "Ne" { give back "Eq" }
    give back ""
}

task v4_ty_binary_operator_method(op: word) -> word {
    if op == "Add" { give back "add" }
    if op == "Sub" { give back "sub" }
    if op == "Mul" { give back "mul" }
    if op == "Div" { give back "div" }
    if op == "Mod" { give back "rem" }
    if op == "Eq" or op == "Ne" { give back "equals" }
    give back ""
}

task v4_ty_unary_operator_doctrine(op: word) -> word {
    if op == "Neg" { give back "Neg" }
    give back ""
}

task v4_ty_unary_operator_method(op: word) -> word {
    if op == "Neg" { give back "neg" }
    give back ""
}

task v4_ty_binary_valid(op: word, left_ty: word, right_ty: word) -> bool {
    if not v4_ty_is_known(left_ty) or not v4_ty_is_known(right_ty) {
        give back true
    }
    if op == "Eq" or op == "Ne" {
        give back v4_ty_types_compatible(left_ty, right_ty)
    }
    if op == "And" or op == "Or" {
        give back left_ty == v4_ty_bool and right_ty == v4_ty_bool
    }
    if op == "Gt" or op == "Lt" or op == "Ge" or op == "Le" {
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Add" {
        if left_ty == v4_ty_word and right_ty == v4_ty_word {
            give back true
        }
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Sub" or op == "Mul" or op == "Div" {
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Mod" {
        give back v4_ty_is_integer(left_ty) and v4_ty_is_integer(right_ty)
    }
    give back true
}

task v4_ty_binary_result(op: word, left_ty: word, right_ty: word) -> word {
    if not v4_ty_binary_valid(op, left_ty, right_ty) {
        give back v4_ty_unknown
    }
    if op == "Eq" or op == "Ne" or op == "Gt" or op == "Lt" or op == "Ge" or op == "Le" {
        give back v4_ty_bool
    }
    if op == "And" or op == "Or" {
        give back v4_ty_bool
    }
    if op == "Add" {
        if left_ty == v4_ty_word and right_ty == v4_ty_word {
            give back v4_ty_word
        }
        give back v4_ty_numeric_result(left_ty, right_ty)
    }
    if op == "Sub" or op == "Mul" or op == "Div" or op == "Mod" {
        give back v4_ty_numeric_result(left_ty, right_ty)
    }
    give back v4_ty_unknown
}

task v4_ty_kind_for_symbol(symbol_kind: word) -> word {
    if symbol_kind == v4_hir_task { give back v4_ty_task_sig }
    if symbol_kind == v4_hir_const { give back v4_ty_const_sig }
    if symbol_kind == v4_hir_shape { give back v4_ty_shape_sig }
    if symbol_kind == v4_hir_route { give back v4_ty_route_sig }
    if symbol_kind == v4_hir_alias { give back v4_ty_alias_sig }
    if symbol_kind == v4_hir_doctrine { give back v4_ty_doctrine_sig }
    if symbol_kind == v4_hir_extern { give back v4_ty_extern_sig }
    if symbol_kind == v4_hir_import { give back v4_ty_import_sig }
    if symbol_kind == v4_hir_attribute { give back v4_ty_attribute_sig }
    if symbol_kind == v4_hir_error { give back v4_ty_error_sig }
    give back v4_ty_unknown
}

task v4_ty_display_for_symbol(symbol_kind: word, symbol_name: word) -> word {
    if symbol_kind == v4_hir_task {
        give back "task " + symbol_name + "(...) -> unknown"
    }
    if symbol_kind == v4_hir_const {
        give back "fixed pilot " + symbol_name
    }
    if symbol_kind == v4_hir_shape {
        give back "shape " + symbol_name
    }
    if symbol_kind == v4_hir_route {
        give back "route " + symbol_name
    }
    if symbol_kind == v4_hir_alias {
        give back "alias " + symbol_name
    }
    if symbol_kind == v4_hir_doctrine {
        give back "doctrine " + symbol_name
    }
    if symbol_kind == v4_hir_extern {
        give back "extern " + symbol_name
    }
    if symbol_kind == v4_hir_import {
        give back "use " + symbol_name
    }
    if symbol_kind == v4_hir_attribute {
        give back "@" + symbol_name
    }
    if symbol_kind == v4_hir_error {
        give back "error " + symbol_name
    }
    give back "unknown " + symbol_name
}

task v4_ty_signature_attribute_count(ty_id: int, sig_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    give back v4_hir_item_attribute_count(hir_id, hir_item)
}

task v4_ty_signature_attribute_name(ty_id: int, sig_id: int, attr_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_name(hir_id, hir_item, attr_id)
}

task v4_ty_signature_attribute_arg(ty_id: int, sig_id: int, attr_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_arg(hir_id, hir_item, attr_id)
}

task v4_ty_signature_has_attribute(ty_id: int, sig_id: int, wanted_name: word) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    give back v4_hir_item_has_attribute(hir_id, hir_item, wanted_name)
}

task v4_ty_signature_attribute_arg_for_name(ty_id: int, sig_id: int, wanted_name: word) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_arg_for_name(hir_id, hir_item, wanted_name)
}

task v4_ty_signature_layout(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "layout")
}

task v4_ty_signature_repr(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "repr")
}

task v4_ty_is_space_char(ch: word) -> bool {
    give back ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
}

task v4_ty_trim_spaces(value: word) -> word {
    if value == "" {
        give back ""
    }

    pilot leading = 0
    repeat until leading >= value.length() or v4_ty_is_space_char(value.char_at(leading)) == false {
        leading += 1
    }
    if leading >= value.length() {
        give back ""
    }

    pilot end = value.length()
    repeat until end <= leading or v4_ty_is_space_char(value.char_at(end - 1)) == false {
        end -= 1
    }
    give back v4_slice(value, leading, end)
}

task v4_ty_layout_arg_count(layout_text: word) -> int {
    pilot text = v4_ty_trim_spaces(layout_text)
    if text == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot ch = text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_layout_arg(layout_text: word, arg_id: int) -> word {
    pilot text = v4_ty_trim_spaces(layout_text)
    if text == "" or arg_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 0
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot ch = text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == arg_id {
                give back v4_ty_trim_spaces(v4_slice(text, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == arg_id {
        give back v4_ty_trim_spaces(v4_slice(text, segment_start, text.length()))
    }
    give back ""
}

task v4_ty_layout_option_name(layout_text: word) -> word {
    pilot option_text = v4_ty_trim_spaces(layout_text)
    if option_text == "" {
        give back ""
    }
    pilot eq_pos = v4_ty_find_top_level_type_char(option_text, "=", 0, option_text.length())
    if eq_pos < 0 {
        give back option_text.to_lower()
    }
    give back v4_ty_trim_spaces(v4_slice(option_text, 0, eq_pos)).to_lower()
}

task v4_ty_layout_option_value(layout_text: word) -> word {
    pilot option_text = v4_ty_trim_spaces(layout_text)
    if option_text == "" {
        give back ""
    }
    pilot eq_pos = v4_ty_find_top_level_type_char(option_text, "=", 0, option_text.length())
    if eq_pos < 0 or eq_pos + 1 >= option_text.length() {
        give back ""
    }
    give back v4_ty_trim_spaces(v4_slice(option_text, eq_pos + 1, option_text.length()))
}

task v4_ty_strip_string_quotes(value: word) -> word {
    pilot text = v4_ty_trim_spaces(value)
    if text.length() >= 2 and text.char_at(0) == "\"" and text.char_at(text.length() - 1) == "\"" {
        give back text.substring(1, text.length() - 1)
    }
    give back ""
}

task v4_ty_extern_spec_arg_count(spec_text: word) -> int {
    give back v4_ty_layout_arg_count(spec_text)
}

task v4_ty_extern_spec_arg(spec_text: word, arg_id: int) -> word {
    give back v4_ty_layout_arg(spec_text, arg_id)
}

task v4_ty_extern_spec_option_name(spec_text: word) -> word {
    give back v4_ty_layout_option_name(spec_text)
}

task v4_ty_extern_spec_option_value(spec_text: word) -> word {
    give back v4_ty_layout_option_value(spec_text)
}

task v4_ty_extern_spec_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_abi_open_token(tree_id, parse_node)
}

task v4_ty_extern_spec_close_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_abi_close_token(tree_id, parse_node)
}

task v4_ty_extern_spec_item_start_token(ty_id: int, sig_id: int, item_id: int) -> int {
    if item_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_extern_spec_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_extern_spec_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot depth = 0
    pilot segment_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                if current == item_id {
                    give back segment_start
                }
                current += 1
                segment_start = v4_ty_skip_trivia(stream_id, idx + 1)
            } else {
                depth = v4_ty_type_depth_after_char(depth, val)
            }
        }
        idx += 1
    }
    if current == item_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_extern_spec_item_end_token(ty_id: int, sig_id: int, item_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_spec_item_start_token(ty_id, sig_id, item_id)
    pilot close_token = v4_ty_extern_spec_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_type_depth_after_char(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_extern_spec_item_value_token(ty_id: int, sig_id: int, item_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_spec_item_start_token(ty_id, sig_id, item_id)
    pilot end_token = v4_ty_extern_spec_item_end_token(ty_id, sig_id, item_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "=" {
                give back v4_ty_skip_trivia(stream_id, idx + 1)
            }
            depth = v4_ty_type_depth_after_char(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_extern_spec_item_value_is_string(ty_id: int, sig_id: int, item_id: int) -> bool {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot value_token = v4_ty_extern_spec_item_value_token(ty_id, sig_id, item_id)
    if stream_id < 0 or value_token < 0 {
        give back false
    }
    give back v4_lex_token_type(stream_id, value_token) == v4_tok_string
}

task v4_ty_extern_member_attribute_arg_is_string(ty_id: int, sig_id: int, member_id: int, attr_id: int) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if hir_id < 0 or hir_item < 0 or stream_id < 0 {
        give back false
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot start_token = v4_parse_extern_member_attribute_start_token(tree_id, parse_node, member_id, attr_id)
    pilot end_token = v4_parse_extern_member_attribute_end_token(tree_id, parse_node, member_id, attr_id)
    if start_token < 0 or end_token <= start_token {
        give back false
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    pilot open_token = v4_ty_skip_trivia(stream_id, name_token + 1)
    if open_token >= end_token or v4_lex_token_value(stream_id, open_token) != "(" {
        give back false
    }
    pilot value_token = v4_ty_skip_trivia(stream_id, open_token + 1)
    if value_token >= end_token {
        give back false
    }
    give back v4_lex_token_type(stream_id, value_token) == v4_tok_string
}

task v4_ty_signature_layout_kind(ty_id: int, sig_id: int) -> word {
    pilot layout_text = v4_ty_signature_layout(ty_id, sig_id)
    pilot head = v4_ty_layout_arg(layout_text, 0)
    if head == "" {
        give back ""
    }
    pilot lower = head.to_lower()
    if lower == "c" {
        give back "C"
    }
    if lower == "transparent" {
        give back "transparent"
    }
    give back ""
}

task v4_ty_signature_repr_kind(ty_id: int, sig_id: int) -> word {
    pilot repr_text = v4_ty_trim_spaces(v4_ty_signature_repr(ty_id, sig_id)).to_lower()
    if repr_text == "u8" or repr_text == "u16" or repr_text == "u32" or repr_text == "u64" or repr_text == "i8" or repr_text == "i16" or repr_text == "i32" or repr_text == "i64" {
        give back repr_text
    }
    give back ""
}

task v4_ty_signature_layout_packed(ty_id: int, sig_id: int) -> word {
    pilot layout_text = v4_ty_signature_layout(ty_id, sig_id)
    pilot arg_idx = 1
    pilot arg_count = v4_ty_layout_arg_count(layout_text)
    repeat until arg_idx >= arg_count {
        pilot option_name = v4_ty_layout_option_name(v4_ty_layout_arg(layout_text, arg_idx))
        if option_name == "packed" {
            give back v4_ty_layout_option_value(v4_ty_layout_arg(layout_text, arg_idx))
        }
        arg_idx += 1
    }
    give back ""
}

task v4_ty_signature_attribute_span_for_name(ty_id: int, sig_id: int, wanted_name: word) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back V4_NO_SPAN
    }

    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, hir_item)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, hir_item, attr_idx) == wanted_name {
            pilot attr_item = v4_hir_item_attribute_item(hir_id, hir_item, attr_idx)
            if attr_item >= 0 {
                give back v4_hir_item_span(hir_id, attr_item)
            }
        }
        attr_idx += 1
    }
    give back V4_NO_SPAN
}

task v4_ty_signature_extern_callback_abi_raw(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "extern_callback")
}

task v4_ty_signature_extern_callback_abi(ty_id: int, sig_id: int) -> word {
    pilot raw = v4_ty_signature_extern_callback_abi_raw(ty_id, sig_id)
    if raw == "" {
        give back ""
    }
    pilot first_arg = v4_ty_layout_arg(raw, 0)
    if first_arg == "" {
        give back ""
    }
    pilot unquoted = v4_ty_strip_string_quotes(first_arg)
    if unquoted == "" {
        unquoted = first_arg
    }
    give back v4_ty_normalize_call_abi(unquoted)
}

task v4_ty_signature_extern_callback_arg_count(ty_id: int, sig_id: int) -> int {
    pilot raw = v4_ty_signature_extern_callback_abi_raw(ty_id, sig_id)
    if raw == "" {
        give back 0
    }
    give back v4_ty_layout_arg_count(raw)
}

task v4_ty_signature_has_extern_callback(ty_id: int, sig_id: int) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, hir_item)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, hir_item, attr_idx) == "extern_callback" {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_ty_extern_callback_trampoline_name(task_name: word) -> word {
    give back "__freak_callback_" + task_name
}

task v4_ty_task_callback_value_type(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        give back v4_ty_unknown
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        give back v4_ty_unknown
    }
    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        give back v4_ty_unknown
    }

    pilot out = "extern[" + abi + "]task("
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if param_id > 0 {
            out = out + ","
        }
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
        pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
        if param_name != "" {
            out = out + v4_ty_param_contract_prefix(v4_ty_signature_param_mode(ty_id, sig_id, param_id), v4_ty_signature_param_lifetime(ty_id, sig_id, param_id)) + param_name + ":"
        }
        out = out + param_surface
        param_id += 1
    }
    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface == "" or return_surface == v4_ty_unknown {
        return_surface = v4_ty_void
    }
    out = out + ")->" + return_surface
    give back out
}

task v4_ty_task_callback_value_type_for_name(ty_id: int, task_name: word) -> word {
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, task_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back v4_ty_unknown
    }
    give back v4_ty_task_callback_value_type(ty_id, sig_id)
}

task v4_ty_extern_callback_export_symbol_name(ty_id: int, task_name: word) -> word {
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, task_name)
    if sig_id < 0 {
        give back ""
    }
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back ""
    }
    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        give back ""
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        give back ""
    }
    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        give back ""
    }
    give back v4_ty_extern_callback_trampoline_name(task_name)
}

task v4_ty_normalize_call_abi(abi: word) -> word {
    if abi == "" {
        give back ""
    }
    if abi == "C" or abi == "c" {
        give back "C"
    }
    if abi == "cdecl" or abi == "CDECL" {
        give back "cdecl"
    }
    if abi == "stdcall" or abi == "STDCALL" {
        give back "stdcall"
    }
    if abi == "fastcall" or abi == "FASTCALL" {
        give back "fastcall"
    }
    if abi == "thiscall" or abi == "THISCALL" {
        give back "thiscall"
    }
    if abi == "vectorcall" or abi == "VECTORCALL" {
        give back "vectorcall"
    }
    if abi == "win64" or abi == "WIN64" {
        give back "win64"
    }
    if abi == "sysv64" or abi == "SYSV64" {
        give back "sysv64"
    }
    if abi == "system" or abi == "SYSTEM" {
        give back "system"
    }
    give back abi
}

task v4_ty_is_language_abi(abi: word) -> bool {
    give back abi == "C"
}

task v4_ty_is_calling_convention_abi(abi: word) -> bool {
    if abi == "cdecl" or abi == "stdcall" or abi == "fastcall" { give back true }
    if abi == "thiscall" or abi == "vectorcall" { give back true }
    if abi == "win64" or abi == "sysv64" or abi == "system" { give back true }
    give back false
}

task v4_ty_is_variadic_abi_compatible(abi: word) -> bool {
    if abi == "C" or abi == "cdecl" or abi == "system" { give back true }
    give back abi == "sysv64" or abi == "win64"
}

task v4_ty_extern_spec_text(ty_id: int, sig_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_ty_trim_spaces(v4_hir_extern_abi(hir_id, hir_item))
}

task v4_ty_extern_abi(ty_id: int, sig_id: int) -> word {
    pilot spec_text = v4_ty_extern_spec_text(ty_id, sig_id)
    if spec_text == "" {
        give back ""
    }

    pilot item_idx = 0
    pilot item_count = v4_ty_extern_spec_arg_count(spec_text)
    pilot fallback = ""
    repeat until item_idx >= item_count {
        pilot item = v4_ty_extern_spec_arg(spec_text, item_idx)
        pilot normalized = v4_ty_normalize_call_abi(item)
        if v4_ty_is_calling_convention_abi(normalized) {
            give back normalized
        }
        if v4_ty_is_language_abi(normalized) {
            fallback = normalized
        }
        item_idx += 1
    }
    give back fallback
}

task v4_ty_extern_link_library(ty_id: int, sig_id: int) -> word {
    pilot spec_text = v4_ty_extern_spec_text(ty_id, sig_id)
    if spec_text == "" {
        give back ""
    }

    pilot item_idx = 0
    pilot item_count = v4_ty_extern_spec_arg_count(spec_text)
    repeat until item_idx >= item_count {
        pilot item = v4_ty_extern_spec_arg(spec_text, item_idx)
        if v4_ty_extern_spec_option_name(item) == "link" {
            pilot link_name = v4_ty_strip_string_quotes(v4_ty_extern_spec_option_value(item))
            if link_name != "" {
                give back link_name
            }
            give back v4_ty_extern_spec_option_value(item)
        }
        item_idx += 1
    }
    give back ""
}

task v4_ty_extern_member_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    give back v4_hir_extern_member_count(hir_id, hir_item)
}

task v4_ty_extern_member_name(ty_id: int, sig_id: int, member_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_extern_member_name(hir_id, hir_item, member_id)
}

task v4_ty_extern_member_attribute_count(ty_id: int, sig_id: int, member_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    give back v4_hir_extern_member_attribute_count(hir_id, hir_item, member_id)
}

task v4_ty_extern_member_attribute_name(ty_id: int, sig_id: int, member_id: int, attr_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_extern_member_attribute_name(hir_id, hir_item, member_id, attr_id)
}

task v4_ty_extern_member_attribute_arg(ty_id: int, sig_id: int, member_id: int, attr_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_extern_member_attribute_arg(hir_id, hir_item, member_id, attr_id)
}

task v4_ty_extern_member_attribute_span(ty_id: int, sig_id: int, member_id: int, attr_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back V4_NO_SPAN
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back V4_NO_SPAN
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot start_token = v4_parse_extern_member_attribute_start_token(tree_id, parse_node, member_id, attr_id)
    pilot end_token = v4_parse_extern_member_attribute_end_token(tree_id, parse_node, member_id, attr_id)
    if start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }
    give back v4_ty_span_from_tokens(v4_ty_signature_stream_id(ty_id), start_token, end_token)
}

task v4_ty_extern_member_start_token(ty_id: int, sig_id: int, member_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
}

task v4_ty_extern_member_end_token(ty_id: int, sig_id: int, member_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
}

task v4_ty_extern_member_return_type(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_member_start_token(ty_id, sig_id, member_id)
    pilot end_token = v4_ty_extern_member_end_token(ty_id, sig_id, member_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_extern_member_return_surface_type(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_member_start_token(ty_id, sig_id, member_id)
    pilot end_token = v4_ty_extern_member_end_token(ty_id, sig_id, member_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_extern_member_display(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot member_name = v4_ty_extern_member_name(ty_id, sig_id, member_id)
    if member_name == "" {
        give back ""
    }
    give back "task " + member_name + "(...) -> " + v4_ty_extern_member_return_type(ty_id, sig_id, member_id)
}

task v4_ty_extern_member_link_name_raw(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot attr_idx = 0
    pilot attr_count = v4_ty_extern_member_attribute_count(ty_id, sig_id, member_id)
    repeat until attr_idx >= attr_count {
        if v4_ty_extern_member_attribute_name(ty_id, sig_id, member_id, attr_idx) == "link_name" {
            give back v4_ty_extern_member_attribute_arg(ty_id, sig_id, member_id, attr_idx)
        }
        attr_idx += 1
    }
    give back ""
}

task v4_ty_extern_member_link_name(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot link_name = v4_ty_strip_string_quotes(v4_ty_extern_member_link_name_raw(ty_id, sig_id, member_id))
    if link_name != "" {
        give back link_name
    }
    give back v4_ty_extern_member_link_name_raw(ty_id, sig_id, member_id)
}

task v4_ty_signature_extern_member_id(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    give back v4_resolve_extern_member_id_from_def(v4_ty_signature_def(ty_id, sig_id))
}

task v4_ty_signature_extern_block_sig(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
        give back sig_id
    }
    if v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    pilot scan_idx = 0
    pilot scan_count = v4_ty_signature_count(ty_id)
    repeat until scan_idx >= scan_count {
        if v4_ty_signature_kind(ty_id, scan_idx) == v4_ty_extern_sig and v4_ty_signature_hir_item(ty_id, scan_idx) == hir_item {
            give back scan_idx
        }
        scan_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_link_library(ty_id: int, sig_id: int) -> word {
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if extern_sig < 0 {
        give back ""
    }
    give back v4_ty_extern_link_library(ty_id, extern_sig)
}

task v4_ty_signature_link_name(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id < 0 {
        give back ""
    }
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if extern_sig < 0 {
        give back ""
    }
    pilot link_name = v4_ty_extern_member_link_name(ty_id, extern_sig, member_id)
    if link_name != "" {
        give back link_name
    }
    give back v4_ty_signature_name(ty_id, sig_id)
}

task v4_ty_signature_symbol_name(ty_id: int, sig_id: int) -> word {
    pilot link_name = v4_ty_signature_link_name(ty_id, sig_id)
    if link_name != "" {
        give back link_name
    }
    give back v4_ty_signature_name(ty_id, sig_id)
}

task v4_ty_signature_call_abi(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
        give back v4_ty_extern_abi(ty_id, sig_id)
    }
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if extern_sig >= 0 {
        give back v4_ty_extern_abi(ty_id, extern_sig)
    }
    give back ""
}

task v4_ty_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot idx = 0
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count {
        pilot token_span = v4_lex_token_span(stream_id, idx)
        if v4_span_start(token_span) >= offset {
            give back idx
        }
        idx += 1
    }
    give back count
}

task v4_ty_skip_trivia(stream_id: int, token_id: int) -> int {
    pilot idx = token_id
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count or v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
        idx += 1
    }
    give back idx
}

task v4_ty_next_nontrivia(stream_id: int, token_id: int, end_token: int) -> int {
    pilot idx = token_id
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_prev_nontrivia(stream_id: int, token_id: int, start_token: int) -> int {
    pilot idx = token_id
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_ty_find_token_value(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if v4_lex_token_value(stream_id, idx) == wanted {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_type_text_suffix_is_keyword(out: word, keyword: word) -> bool {
    if keyword == "" or out.length() < keyword.length() {
        give back false
    }
    if v4_slice(out, out.length() - keyword.length(), out.length()) != keyword {
        give back false
    }
    if out.length() == keyword.length() {
        give back true
    }
    pilot before = out.char_at(out.length() - keyword.length() - 1)
    give back before == " " or before == "<" or before == "," or before == "(" or before == "[" or before == ":"
}

task v4_ty_type_text_suffix_is_dyn_keyword(out: word) -> bool {
    give back v4_ty_type_text_suffix_is_keyword(out, "dyn")
}

task v4_ty_type_text_suffix_is_lend_lifetime(out: word) -> bool {
    pilot lifetime_count = v4_ty_type_lifetime_count(out)
    if lifetime_count <= 0 {
        give back false
    }
    pilot lifetime_name = v4_ty_type_lifetime_name(out, lifetime_count - 1)
    if lifetime_name == "" or not out.ends_with(lifetime_name) {
        give back false
    }
    pilot before_lifetime = v4_slice(out, 0, out.length() - lifetime_name.length())
    give back before_lifetime.ends_with("lend ") or before_lifetime.ends_with("lend mut ")
}

task v4_ty_type_text_needs_separator_after_lifetime(out: word, value: word) -> bool {
    pilot lifetime_count = v4_ty_type_lifetime_count(out)
    if lifetime_count <= 0 {
        give back false
    }
    pilot lifetime_name = v4_ty_type_lifetime_name(out, lifetime_count - 1)
    if lifetime_name == "" or not out.ends_with(lifetime_name) {
        give back false
    }
    give back value != ":" and value != "+" and value != "," and value != ">" and value != ")" and value != "]" and value != ";"
}

task v4_ty_type_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            pilot lend_suffix: bool = v4_ty_type_text_suffix_is_keyword(out, "lend")
            if lend_suffix and value == "mut" {
                out = out + " mut"
            } else if lend_suffix or v4_ty_type_text_suffix_is_keyword(out, "lend mut") or v4_ty_type_text_suffix_is_lend_lifetime(out) or v4_ty_type_text_needs_separator_after_lifetime(out, value) or v4_ty_type_text_suffix_is_dyn_keyword(out) {
                out = out + " " + value
            } else {
                out = out + value
            }
        }
        idx += 1
    }
    give back out
}

task v4_ty_signature_hir_id(ty_id: int) -> int {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if v4_resolve_exists(resolve_id) == false {
        give back 0 - 1
    }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) == false {
        give back 0 - 1
    }
    give back hir_id
}

task v4_ty_signature_stream_id(ty_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    give back v4_parse_stream_id(tree_id)
}

task v4_ty_signature_item_start_token(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id >= 0 {
        give back v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
    }
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    give back v4_ty_first_token_at_or_after(stream_id, v4_span_start(item_span))
}

task v4_ty_signature_item_end_token(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id >= 0 {
        give back v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
    }
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    pilot end_token = v4_ty_first_token_at_or_after(stream_id, v4_span_end(item_span))
    if end_token <= v4_ty_signature_item_start_token(ty_id, sig_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_ty_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back V4_NO_SPAN
    }

    pilot last = end_token
    repeat until last <= first {
        last -= 1
        if v4_lex_token_type(stream_id, last) != v4_tok_trivia {
            pilot start_span = v4_lex_token_span(stream_id, first)
            pilot end_span = v4_lex_token_span(stream_id, last)
            give back v4_span_new(v4_span_file(start_span), v4_span_start(start_span), v4_span_end(end_span))
        }
    }

    pilot only_span = v4_lex_token_span(stream_id, first)
    give back v4_span_new(v4_span_file(only_span), v4_span_start(only_span), v4_span_end(only_span))
}

task v4_ty_hir_item_start_token(hir_id: int, item_id: int) -> int {
    if hir_id < 0 {
        give back 0 - 1
    }
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, item_id)
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    give back v4_ty_first_token_at_or_after(stream_id, v4_span_start(item_span))
}

task v4_ty_hir_item_end_token(hir_id: int, item_id: int) -> int {
    if hir_id < 0 {
        give back 0 - 1
    }
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, item_id)
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    pilot end_token = v4_ty_first_token_at_or_after(stream_id, v4_span_end(item_span))
    if end_token <= v4_ty_hir_item_start_token(hir_id, item_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_ty_find_matching_paren(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "(" {
                depth += 1
            } else if val == ")" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_square(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "[" {
                depth += 1
            } else if val == "]" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_brace(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" {
                depth += 1
            } else if val == "}" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_angle(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "<" {
                depth += 1
            } else if val == ">" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_param_open_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0 - 1
    }
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_signature_param_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_depth_after_token(depth: int, val: word) -> int {
    pilot next_depth = depth
    if val == "(" or val == "[" or val == "{" or val == "<" {
        next_depth += 1
    } else if val == ")" or val == "]" or val == "}" or val == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_ty_item_name_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back name_token
}

task v4_ty_item_header_end_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot idx = start_token + 1
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (val == "(" or val == "{" or val == "=" or val == "=>" or val == "->") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_item_generic_open_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    pilot name_token = v4_ty_item_name_token_from_tokens(stream_id, start_token, end_token)
    pilot header_end = v4_ty_item_header_end_token_from_tokens(stream_id, start_token, end_token)
    if name_token < 0 or header_end <= name_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, header_end, "<")
}

task v4_ty_item_generic_close_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    pilot open_token = v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_angle(stream_id, open_token, v4_ty_item_header_end_token_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_item_generic_text_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot open_token = v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
    pilot close_token = v4_ty_item_generic_close_token_from_tokens(stream_id, start_token, end_token)
    if open_token < 0 or close_token <= open_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, open_token, close_token + 1)
}

task v4_ty_hir_item_generic_text(hir_id: int, item_id: int) -> word {
    if hir_id < 0 or item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_item_generic_text_from_tokens(stream_id, v4_ty_hir_item_start_token(hir_id, item_id), v4_ty_hir_item_end_token(hir_id, item_id))
}

task v4_ty_signature_generic_open_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_close_token_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_text(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_text_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_generic_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
}

task v4_ty_signature_param_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
}

task v4_ty_is_variadic_param_surface(type_text: word) -> bool {
    give back v4_ty_trim_spaces(type_text) == "..."
}

task v4_ty_param_count_from_tokens(stream_id: int, open_token: int, close_token: int) -> int {
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot first = v4_ty_skip_trivia(stream_id, open_token + 1)
    if first >= close_token {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                count += 1
            } else {
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_signature_param_segment_start(ty_id: int, sig_id: int, param_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
}

task v4_ty_param_segment_start_from_tokens(stream_id: int, open_token: int, close_token: int, param_id: int) -> int {
    if stream_id < 0 or open_token < 0 or close_token <= open_token or param_id < 0 {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                if current == param_id {
                    give back segment_start
                }
                current += 1
                segment_start = v4_ty_skip_trivia(stream_id, idx + 1)
            } else {
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    if current == param_id and segment_start < close_token {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_signature_param_segment_end(ty_id: int, sig_id: int, param_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
}

task v4_ty_param_segment_end_from_tokens(stream_id: int, start_token: int, close_token: int) -> int {
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_find_top_level_token(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == wanted {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_generic_segment_start(ty_id: int, sig_id: int, generic_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_generic_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, generic_id)
}

task v4_ty_signature_generic_segment_end(ty_id: int, sig_id: int, generic_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
}

task v4_ty_signature_generic_segment_span(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_generic_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_type_text(stream_id, start_token, end_token)
    }
    give back v4_ty_type_text(stream_id, start_token, colon_token)
}

task v4_ty_generic_bounds_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back ""
    }
    pilot bound_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if bound_start >= end_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, bound_start, end_token)
}

task v4_ty_generic_has_empty_bound_clause_from_tokens(stream_id: int, start_token: int, end_token: int) -> bool {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back false
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back false
    }
    give back v4_ty_skip_trivia(stream_id, colon_token + 1) >= end_token
}

task v4_ty_signature_generic_name(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_bounds(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_bounds_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_has_empty_bound_clause(ty_id: int, sig_id: int, generic_id: int) -> bool {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_has_empty_bound_clause_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_kind(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_generic_kind_type
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < end_token and v4_lex_token_type(stream_id, first) == v4_tok_lifetime {
        give back v4_ty_generic_kind_lifetime
    }
    give back v4_ty_generic_kind_type
}

task v4_ty_signature_generic_is_lifetime(ty_id: int, sig_id: int, generic_id: int) -> bool {
    give back v4_ty_signature_generic_kind(ty_id, sig_id, generic_id) == v4_ty_generic_kind_lifetime
}

task v4_ty_signature_lifetime_count(ty_id: int, sig_id: int) -> int {
    pilot total = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            total += 1
        }
        generic_id += 1
    }
    give back total
}

task v4_ty_signature_type_generic_count(ty_id: int, sig_id: int) -> int {
    pilot total = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            total += 1
        }
        generic_id += 1
    }
    give back total
}

task v4_ty_signature_lifetime_name(ty_id: int, sig_id: int, lifetime_id: int) -> word {
    pilot seen = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            if seen == lifetime_id {
                give back v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
            }
            seen += 1
        }
        generic_id += 1
    }
    give back ""
}

task v4_ty_signature_type_generic_name(ty_id: int, sig_id: int, type_generic_id: int) -> word {
    pilot seen = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            if seen == type_generic_id {
                give back v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
            }
            seen += 1
        }
        generic_id += 1
    }
    give back ""
}

task v4_ty_generic_bound_count(bounds_text: word) -> int {
    if bounds_text == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= bounds_text.length() {
        pilot ch = bounds_text.char_at(idx)
        if depth == 0 and ch == "+" {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_generic_bound_name(bounds_text: word, bound_id: int) -> word {
    if bounds_text == "" or bound_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 0
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= bounds_text.length() {
        pilot ch = bounds_text.char_at(idx)
        if depth == 0 and ch == "+" {
            if current == bound_id {
                give back v4_ty_trim_spaces(v4_slice(bounds_text, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == bound_id and segment_start < bounds_text.length() {
        give back v4_ty_trim_spaces(v4_slice(bounds_text, segment_start, bounds_text.length()))
    }
    give back ""
}

task v4_ty_signature_generic_raw_bound_count(ty_id: int, sig_id: int, generic_id: int) -> int {
    give back v4_ty_generic_bound_count(v4_ty_signature_generic_bounds(ty_id, sig_id, generic_id))
}

task v4_ty_signature_generic_raw_bound_name(ty_id: int, sig_id: int, generic_id: int, bound_id: int) -> word {
    give back v4_ty_generic_bound_name(v4_ty_signature_generic_bounds(ty_id, sig_id, generic_id), bound_id)
}

task v4_ty_signature_generic_bound_count(ty_id: int, sig_id: int, generic_id: int) -> int {
    if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
        give back 0
    }

    pilot doctrine_count = 0
    pilot raw_bound_id = 0
    pilot raw_bound_count = v4_ty_signature_generic_raw_bound_count(ty_id, sig_id, generic_id)
    repeat until raw_bound_id >= raw_bound_count {
        pilot bound_name = v4_ty_signature_generic_raw_bound_name(ty_id, sig_id, generic_id, raw_bound_id)
        if bound_name != "" and not v4_ty_is_lifetime_name(bound_name) {
            doctrine_count += 1
        }
        raw_bound_id += 1
    }
    give back doctrine_count
}

task v4_ty_signature_generic_bound_name(ty_id: int, sig_id: int, generic_id: int, bound_id: int) -> word {
    if bound_id < 0 or v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
        give back ""
    }

    pilot seen_doctrines = 0
    pilot raw_bound_id = 0
    pilot raw_bound_count = v4_ty_signature_generic_raw_bound_count(ty_id, sig_id, generic_id)
    repeat until raw_bound_id >= raw_bound_count {
        pilot bound_name = v4_ty_signature_generic_raw_bound_name(ty_id, sig_id, generic_id, raw_bound_id)
        if bound_name != "" and not v4_ty_is_lifetime_name(bound_name) {
            if seen_doctrines == bound_id {
                give back bound_name
            }
            seen_doctrines += 1
        }
        raw_bound_id += 1
    }
    give back ""
}

task v4_ty_signature_generic_has_bound(ty_id: int, sig_id: int, generic_id: int, wanted_bound: word) -> bool {
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        if v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx) == wanted_bound {
            give back true
        }
        bound_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_generic_name(ty_id: int, sig_id: int, type_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
            give back true
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_lifetime_name(ty_id: int, sig_id: int, lifetime_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) {
            if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == lifetime_name {
                give back true
            }
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_type_generic_name(ty_id: int, sig_id: int, type_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
                give back true
            }
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_generic_id_for_name(ty_id: int, sig_id: int, type_name: word) -> int {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
            give back generic_idx
        }
        generic_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_lifetime_generic_id_for_name(ty_id: int, sig_id: int, lifetime_name: word) -> int {
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, sig_id, lifetime_name)
    if generic_id < 0 or not v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
        give back 0 - 1
    }
    give back generic_id
}

-- Bootstrap arrays live for the process lifetime, so keep a high-water
-- queue/visited workspace with cached link IDs for query and LSP checks.
task v4_ty_lifetime_outlives_scratch_prepare(slot_count: int) -> void {
    v4_ty_init()
    pilot slot_id = array_len(v4_ty_lifetime_outlives_scratch_links)
    repeat until array_len(v4_ty_lifetime_outlives_scratch_links) >= slot_count {
        array_push(v4_ty_lifetime_outlives_scratch_links, "-2")
        array_push(v4_ty_lifetime_outlives_scratch_ids, word_from_int(slot_id))
        slot_id += 1
    }

    slot_id = 0
    repeat until slot_id >= slot_count {
        array_set(v4_ty_lifetime_outlives_scratch_links, slot_id, "-2")
        slot_id += 1
    }
    v4_ty_lifetime_outlives_scratch_active = slot_count
    v4_ty_lifetime_outlives_scratch_generation_value += 1
}

task v4_ty_lifetime_outlives_scratch_active_count() -> int {
    give back v4_ty_lifetime_outlives_scratch_active
}

task v4_ty_lifetime_outlives_scratch_capacity() -> int {
    v4_ty_init()
    give back array_len(v4_ty_lifetime_outlives_scratch_links)
}

task v4_ty_lifetime_outlives_scratch_generation() -> int {
    give back v4_ty_lifetime_outlives_scratch_generation_value
}

task v4_ty_signature_lifetime_outlives_ids(ty_id: int, sig_id: int, longer_generic_id: int, shorter_generic_id: int) -> bool {
    if longer_generic_id == shorter_generic_id {
        give back true
    }

    -- The table is both the visited set and a linked FIFO: -2 is unseen,
    -- -1 is the tail, and every nonnegative value links to the next generic.
    pilot unseen_generic_id = 0 - 2
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    v4_ty_lifetime_outlives_scratch_prepare(generic_count)
    pilot visit_next = v4_ty_lifetime_outlives_scratch_links

    pilot current_generic_id = longer_generic_id
    pilot tail_generic_id = longer_generic_id
    array_set(visit_next, longer_generic_id, "-1")
    repeat until current_generic_id < 0 {
        pilot bound_id = 0
        pilot bound_count = v4_ty_signature_generic_raw_bound_count(ty_id, sig_id, current_generic_id)
        repeat until bound_id >= bound_count {
            pilot bound_name = v4_ty_signature_generic_raw_bound_name(ty_id, sig_id, current_generic_id, bound_id)
            if bound_name != "'static" and bound_name != "'_" {
                pilot bound_generic_id = v4_ty_signature_lifetime_generic_id_for_name(ty_id, sig_id, bound_name)
                if bound_generic_id == shorter_generic_id {
                    give back true
                }
                if bound_generic_id >= 0 and word_to_int(array_get(visit_next, bound_generic_id)) == unseen_generic_id {
                    array_set(visit_next, tail_generic_id, array_get(v4_ty_lifetime_outlives_scratch_ids, bound_generic_id))
                    array_set(visit_next, bound_generic_id, "-1")
                    tail_generic_id = bound_generic_id
                }
            }
            bound_id += 1
        }
        current_generic_id = word_to_int(array_get(visit_next, current_generic_id))
    }
    give back false
}

task v4_ty_signature_is_ordinary_static_task(ty_id: int, sig_id: int) -> bool {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back false
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_task_sig {
        give back false
    }
    give back v4_ty_signature_extern_member_id(ty_id, sig_id) < 0
}

task v4_ty_signature_lifetime_outlives(ty_id: int, sig_id: int, longer_name: word, shorter_name: word) -> bool {
    if not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back false
    }
    if longer_name == "'static" or longer_name == "'_" or shorter_name == "'static" or shorter_name == "'_" {
        give back false
    }
    if not v4_ty_signature_declares_lifetime_name(ty_id, sig_id, longer_name) or not v4_ty_signature_declares_lifetime_name(ty_id, sig_id, shorter_name) {
        give back false
    }
    if longer_name == shorter_name {
        give back true
    }
    pilot longer_generic_id = v4_ty_signature_lifetime_generic_id_for_name(ty_id, sig_id, longer_name)
    pilot shorter_generic_id = v4_ty_signature_lifetime_generic_id_for_name(ty_id, sig_id, shorter_name)
    if longer_generic_id < 0 or shorter_generic_id < 0 {
        give back false
    }
    give back v4_ty_signature_lifetime_outlives_ids(ty_id, sig_id, longer_generic_id, shorter_generic_id)
}

task v4_ty_signature_param_name(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_param_index_for_name(ty_id: int, sig_id: int, wanted_name: word) -> int {
    pilot param_idx = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_idx >= param_count {
        if v4_ty_signature_param_name(ty_id, sig_id, param_idx) == wanted_name {
            give back param_idx
        }
        param_idx += 1
    }
    give back 0 - 1
}

task v4_ty_param_lifetime_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot token_id = v4_ty_skip_trivia(stream_id, start_token)
    if token_id >= end_token or v4_lex_token_value(stream_id, token_id) != "lend" {
        give back 0 - 1
    }
    token_id = v4_ty_skip_trivia(stream_id, token_id + 1)
    if token_id < end_token and v4_lex_token_value(stream_id, token_id) == "mut" {
        token_id = v4_ty_skip_trivia(stream_id, token_id + 1)
    }
    if token_id < end_token and v4_lex_token_type(stream_id, token_id) == v4_tok_lifetime {
        give back token_id
    }
    give back 0 - 1
}

task v4_ty_param_lifetime_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot token_id = v4_ty_param_lifetime_token_from_tokens(stream_id, start_token, end_token)
    if token_id < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, token_id)
}

task v4_ty_param_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    if v4_lex_token_value(stream_id, first) == "lend" {
        first = v4_ty_skip_trivia(stream_id, first + 1)
        if first < end_token and v4_lex_token_value(stream_id, first) == "mut" {
            first = v4_ty_skip_trivia(stream_id, first + 1)
        }
        if first < end_token and v4_lex_token_type(stream_id, first) == v4_tok_lifetime {
            first = v4_ty_skip_trivia(stream_id, first + 1)
        }
    }
    if first >= end_token {
        give back ""
    }
    pilot param_name = v4_lex_token_value(stream_id, first)
    if param_name == ":" or param_name == "," or param_name == ")" {
        give back ""
    }
    give back param_name
}

task v4_ty_param_mode_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_param_mode_value
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back v4_ty_param_mode_value
    }
    if v4_lex_token_value(stream_id, first) != "lend" {
        give back v4_ty_param_mode_value
    }
    pilot after_lend = v4_ty_skip_trivia(stream_id, first + 1)
    if after_lend < end_token and v4_lex_token_value(stream_id, after_lend) == "mut" {
        give back v4_ty_param_mode_lend_mut
    }
    give back v4_ty_param_mode_lend
}

task v4_ty_param_mode_prefix(mode: word) -> word {
    if mode == v4_ty_param_mode_lend {
        give back "lend "
    }
    if mode == v4_ty_param_mode_lend_mut {
        give back "lend mut "
    }
    give back ""
}

task v4_ty_param_contract_prefix(mode: word, lifetime_name: word) -> word {
    pilot out = v4_ty_param_mode_prefix(mode)
    if out != "" and lifetime_name != "" {
        out = out + lifetime_name + " "
    }
    give back out
}

task v4_ty_signature_param_mode(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_mode_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_param_lifetime(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_lifetime_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_param_lifetime_span(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    pilot lifetime_token = v4_ty_param_lifetime_token_from_tokens(stream_id, start_token, end_token)
    if lifetime_token < 0 {
        give back V4_NO_SPAN
    }
    give back v4_ty_span_from_tokens(stream_id, lifetime_token, lifetime_token + 1)
}

task v4_ty_param_type_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_signature_param_type(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    if v4_ty_is_variadic_param_surface(v4_ty_param_type_from_tokens(stream_id, start_token, end_token)) {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type_in_signature(ty_id, sig_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_signature_param_surface_type(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_type_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_function_value_type(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot out = ""
    pilot call_abi = v4_ty_signature_call_abi(ty_id, sig_id)
    if call_abi != "" {
        out = "extern[" + call_abi + "]"
    }
    out = out + "task("

    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if param_id > 0 {
            out = out + ","
        }
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
        pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
        if param_surface == "" {
            param_surface = v4_ty_unknown
        }
        if param_surface == "..." {
            out = out + "..."
        } else {
            if param_name != "" {
                out = out + v4_ty_param_contract_prefix(v4_ty_signature_param_mode(ty_id, sig_id, param_id), v4_ty_signature_param_lifetime(ty_id, sig_id, param_id)) + param_name + ":"
            }
            out = out + param_surface
        }
        param_id += 1
    }

    out = out + ")->"
    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface == "" {
        return_surface = v4_ty_unknown
    }
    give back out + return_surface
}

task v4_ty_signature_param_type_span(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_type_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_param_is_variadic(ty_id: int, sig_id: int, param_id: int) -> bool {
    give back v4_ty_is_variadic_param_surface(v4_ty_signature_param_surface_type(ty_id, sig_id, param_id))
}

task v4_ty_signature_variadic_param_id(ty_id: int, sig_id: int) -> int {
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_is_variadic(ty_id, sig_id, param_id) {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_ty_signature_is_variadic(ty_id: int, sig_id: int) -> bool {
    give back v4_ty_signature_variadic_param_id(ty_id, sig_id) >= 0
}

task v4_ty_signature_fixed_param_count(ty_id: int, sig_id: int) -> int {
    pilot variadic_param = v4_ty_signature_variadic_param_id(ty_id, sig_id)
    if variadic_param >= 0 {
        give back variadic_param
    }
    give back v4_ty_signature_param_count(ty_id, sig_id)
}

task v4_ty_param_type_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot param_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if param_ty == "" {
        give back v4_ty_unknown
    }
    give back param_ty
}

task v4_ty_return_type_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (val == "{" or val == "=>") {
                give back idx
            }
            if val == "(" or val == "[" or val == "<" {
                depth += 1
            } else if val == ")" or val == "]" or val == ">" {
                if depth > 0 {
                    depth -= 1
                }
            }
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_infer_arrow_expr_return(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back v4_ty_void
    }

    pilot first_type = v4_lex_token_type(stream_id, first)
    pilot first_value = v4_lex_token_value(stream_id, first)
    if first_type == v4_tok_int {
        give back v4_ty_int
    }
    if first_type == v4_tok_float {
        give back v4_ty_num
    }
    if first_type == v4_tok_string {
        give back v4_ty_word
    }
    if first_type == v4_tok_bool {
        give back v4_ty_bool
    }
    if first_value == "nobody" {
        give back "maybe<unknown>"
    }
    give back v4_ty_unknown
}

task v4_ty_closure_param_type_for_name(ty_id: int, hir_item: int, closure_id: int, param_name: word) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot owner_sig = v4_ty_signature_for_hir_item(ty_id, hir_item)
    pilot param_id = 0
    pilot param_count = v4_hir_closure_param_count(hir_id, hir_item, closure_id)
    repeat until param_id >= param_count {
        if v4_hir_closure_param_name(hir_id, hir_item, closure_id, param_id) == param_name {
            pilot param_ty = v4_hir_closure_param_type(hir_id, hir_item, closure_id, param_id)
            if param_ty == "" {
                give back v4_ty_unknown
            }
            if owner_sig >= 0 {
                param_ty = v4_ty_canonical_type_in_signature(ty_id, owner_sig, param_ty)
            }
            give back param_ty
        }
        param_id += 1
    }
    give back v4_ty_unknown
}

task v4_ty_infer_closure_block_return(ty_id: int, hir_item: int, closure_id: int, stream_id: int, start_token: int, end_token: int) -> word {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia and v4_lex_token_value(stream_id, idx) == "give" {
            pilot back_token = v4_ty_next_nontrivia(stream_id, idx + 1, end_token)
            if back_token < end_token and v4_lex_token_value(stream_id, back_token) == "back" {
                pilot expr_token = v4_ty_next_nontrivia(stream_id, back_token + 1, end_token)
                if expr_token >= end_token or v4_lex_token_value(stream_id, expr_token) == "}" {
                    give back v4_ty_void
                }
                pilot inferred = v4_ty_infer_arrow_expr_return(stream_id, expr_token, end_token)
                if inferred != v4_ty_unknown {
                    give back inferred
                }
                pilot token_type = v4_lex_token_type(stream_id, expr_token)
                if token_type == v4_tok_ident or token_type == v4_tok_keyword {
                    pilot after_expr = v4_ty_next_nontrivia(stream_id, expr_token + 1, end_token)
                    if after_expr >= end_token or v4_lex_token_value(stream_id, after_expr) == ";" or v4_lex_token_value(stream_id, after_expr) == "}" {
                        give back v4_ty_closure_param_type_for_name(ty_id, hir_item, closure_id, v4_lex_token_value(stream_id, expr_token))
                    }
                }
                give back v4_ty_unknown
            }
        }
        idx += 1
    }
    give back v4_ty_void
}

task v4_ty_validate_closure_params(ty_id: int) -> void {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back
    }
    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        pilot closure_id = 0
        pilot closure_count = v4_hir_closure_count(hir_id, hir_item)
        repeat until closure_id >= closure_count {
            pilot param_id = 0
            pilot param_count = v4_hir_closure_param_count(hir_id, hir_item, closure_id)
            repeat until param_id >= param_count {
                pilot param_name = v4_hir_closure_param_name(hir_id, hir_item, closure_id, param_id)
                if param_name != "" and param_name != "_" {
                    pilot earlier_id = 0
                    repeat until earlier_id >= param_id {
                        if v4_hir_closure_param_name(hir_id, hir_item, closure_id, earlier_id) == param_name {
                            v4_ty_add_error_diag(ty_id, v4_hir_closure_param_span(hir_id, hir_item, closure_id, param_id), "Yuuko found a repeated closure parameter", "rename the second " + param_name + " parameter so every role in the closure cast is unambiguous")
                            earlier_id = param_id
                        } else {
                            earlier_id += 1
                        }
                    }
                }
                param_id += 1
            }
            closure_id += 1
        }
        hir_item += 1
    }
}

task v4_ty_signature_for_hir_item(ty_id: int, hir_item: int) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_hir_item(ty_id, sig_id) == hir_item and v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
            give back sig_id
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_closure_type_at(ty_id: int, hir_item: int, closure_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or closure_id < 0 or closure_id >= v4_hir_closure_count(hir_id, hir_item) {
        give back v4_ty_unknown
    }

    pilot mode = v4_hir_closure_mode(hir_id, hir_item, closure_id)
    if mode == "" {
        mode = v4_ty_closure_mode_borrow
    }
    pilot owner_sig = v4_ty_signature_for_hir_item(ty_id, hir_item)
    pilot out = v4_ty_closure_type_prefix(mode) + "("
    pilot param_id = 0
    pilot param_count = v4_hir_closure_param_count(hir_id, hir_item, closure_id)
    if param_count == 1 and v4_hir_closure_param_name(hir_id, hir_item, closure_id, 0) == "_" and v4_hir_closure_param_type(hir_id, hir_item, closure_id, 0) == "" {
        param_count = 0
    }
    repeat until param_id >= param_count {
        if param_id > 0 {
            out = out + ","
        }
        pilot param_name = v4_hir_closure_param_name(hir_id, hir_item, closure_id, param_id)
        pilot param_ty = v4_hir_closure_param_type(hir_id, hir_item, closure_id, param_id)
        if param_ty == "" {
            param_ty = v4_ty_unknown
        } else if owner_sig >= 0 {
            param_ty = v4_ty_canonical_type_in_signature(ty_id, owner_sig, param_ty)
        }
        if param_name != "" {
            out = out + param_name + ":"
        }
        out = out + param_ty
        param_id += 1
    }

    pilot return_ty = v4_ty_void
    pilot body_kind = v4_hir_closure_body_kind(hir_id, hir_item, closure_id)
    pilot stream_id = v4_hir_item_stream_id(hir_id)
    if body_kind == "expr" {
        return_ty = v4_ty_infer_arrow_expr_return(stream_id, v4_hir_closure_body_start_token(hir_id, hir_item, closure_id), v4_hir_closure_body_end_token(hir_id, hir_item, closure_id))
    } else if body_kind == "block" {
        return_ty = v4_ty_infer_closure_block_return(ty_id, hir_item, closure_id, stream_id, v4_hir_closure_body_start_token(hir_id, hir_item, closure_id), v4_hir_closure_body_end_token(hir_id, hir_item, closure_id))
    }
    give back out + ")->" + return_ty
}

task v4_ty_closure_type_for_offset(ty_id: int, hir_item: int, offset: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot closure_id = v4_hir_closure_at_offset(hir_id, hir_item, offset)
    if closure_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_closure_type_at(ty_id, hir_item, closure_id)
}

task v4_ty_route_surface_keyword(hir_id: int, hir_item: int) -> word {
    if hir_item >= 0 and v4_hir_route_is_variant(hir_id, hir_item) {
        give back "variant"
    }
    give back "route"
}

task v4_ty_route_surface_keyword_for_signature(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back "route"
    }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back "route"
    }
    give back v4_ty_route_surface_keyword(hir_id, v4_ty_signature_hir_item(ty_id, sig_id))
}

task v4_ty_task_return_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot return_arrow = v4_ty_find_top_level_token(stream_id, start_token, end_token, "->")
    if return_arrow >= 0 {
        pilot return_start = v4_ty_skip_trivia(stream_id, return_arrow + 1)
        pilot return_end = v4_ty_return_type_end(stream_id, return_start, end_token)
        pilot return_ty = v4_ty_type_text(stream_id, return_start, return_end)
        if return_ty != "" {
            give back return_ty
        }
    }

    pilot fat_arrow = v4_ty_find_token_value(stream_id, start_token, end_token, "=>")
    if fat_arrow >= 0 {
        give back v4_ty_infer_arrow_expr_return(stream_id, fat_arrow + 1, end_token)
    }

    give back v4_ty_unknown
}

task v4_ty_task_return_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot return_arrow = v4_ty_find_top_level_token(stream_id, start_token, end_token, "->")
    if return_arrow >= 0 {
        pilot return_start = v4_ty_skip_trivia(stream_id, return_arrow + 1)
        pilot return_end = v4_ty_return_type_end(stream_id, return_start, end_token)
        if return_start < return_end {
            give back v4_ty_span_from_tokens(stream_id, return_start, return_end)
        }
    }
    give back V4_NO_SPAN
}

task v4_ty_signature_return_span(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_task_return_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_task_return_from_hir(hir_id: int, hir_item: int) -> word {
    if hir_item < 0 {
        give back v4_ty_unknown
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_const_signature_id_for_name(ty_id: int, const_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_const_sig and v4_ty_signature_name(ty_id, sig_id) == const_name {
            give back sig_id
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_task_signature_id_for_name(ty_id: int, task_name: word) -> int {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot def_id = v4_resolve_def_for_name(resolve_id, task_name)
        if def_id != "" {
            pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
            if sig_id >= 0 {
                pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
                if sig_kind == v4_ty_task_sig or sig_kind == v4_ty_extern_sig {
                    give back sig_id
                }
            }
        }
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_task_sig and v4_ty_signature_name(ty_id, sig_id) == task_name {
            give back sig_id
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_const_declared_type_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_const_type(hir_id, hir_item)
}

task v4_ty_const_init_text_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_const_init(hir_id, hir_item)
}

task v4_ty_const_name_span(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }
    pilot fixed_token = v4_ty_find_token_value(stream_id, start_token, end_token, "fixed")
    if fixed_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot pilot_token = v4_ty_next_nontrivia(stream_id, fixed_token + 1, end_token)
    if pilot_token >= end_token or v4_lex_token_value(stream_id, pilot_token) != "pilot" {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot name_token = v4_ty_next_nontrivia(stream_id, pilot_token + 1, end_token)
    if name_token >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_lex_token_span(stream_id, name_token)
}

task v4_ty_const_equals_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot fixed_token = v4_ty_find_token_value(stream_id, start_token, end_token, "fixed")
    if fixed_token < 0 {
        give back 0 - 1
    }
    pilot pilot_token = v4_ty_next_nontrivia(stream_id, fixed_token + 1, end_token)
    if pilot_token >= end_token or v4_lex_token_value(stream_id, pilot_token) != "pilot" {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, pilot_token + 1, end_token, "=")
}

task v4_ty_const_init_start_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot eq_token = v4_ty_const_equals_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or eq_token < 0 or end_token <= eq_token {
        give back 0 - 1
    }
    pilot start_token = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if start_token >= end_token {
        give back 0 - 1
    }
    give back start_token
}

task v4_ty_const_init_end_token(ty_id: int, sig_id: int) -> int {
    give back v4_ty_signature_item_end_token(ty_id, sig_id)
}

task v4_ty_const_merge_literal_type(current_ty: word, next_ty: word) -> word {
    if not v4_ty_is_known(current_ty) {
        give back next_ty
    }
    if not v4_ty_is_known(next_ty) {
        give back current_ty
    }
    if current_ty == next_ty {
        give back current_ty
    }
    if v4_ty_is_numeric(current_ty) and v4_ty_is_numeric(next_ty) {
        give back v4_ty_numeric_result(current_ty, next_ty)
    }
    give back current_ty
}

task v4_ty_const_path_scope_separator(path: word) -> int {
    pilot idx = 0
    pilot depth = 0
    pilot found = 0 - 1
    repeat until idx + 1 >= path.length() {
        pilot ch = path.char_at(idx)
        if depth == 0 and ch == ":" and path.char_at(idx + 1) == ":" {
            found = idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back found
}

task v4_ty_const_path_left(path: word) -> word {
    pilot sep = v4_ty_const_path_scope_separator(path)
    if sep < 0 {
        give back ""
    }
    give back v4_slice(path, 0, sep)
}

task v4_ty_const_path_right(path: word) -> word {
    pilot sep = v4_ty_const_path_scope_separator(path)
    if sep < 0 {
        give back ""
    }
    give back v4_slice(path, sep + 2, path.length())
}

task v4_ty_const_constructor_head_is_valid(stream_id: int, start_token: int, end_token: int) -> bool {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_token = false
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            saw_token = true
            if tok_type == v4_tok_ident or tok_type == v4_tok_keyword or tok_type == v4_tok_lifetime or tok_type == v4_tok_int or tok_type == v4_tok_float {
                -- allowed
            } else if val == "::" or val == "<" or val == ">" or val == "," or val == "(" or val == ")" or val == "[" or val == "]" or val == ";" {
                -- allowed
            } else {
                give back false
            }
            depth = v4_ty_depth_after_token(depth, val)
            if depth < 0 {
                give back false
            }
        }
        idx += 1
    }
    give back saw_token and depth == 0
}

task v4_ty_const_constructor_head_name(stream_id: int, start_token: int, end_token: int) -> word {
    if not v4_ty_const_constructor_head_is_valid(stream_id, start_token, end_token) {
        give back ""
    }
    give back v4_ty_type_text(stream_id, start_token, end_token)
}

task v4_ty_call_arg_label(stream_id: int, start_token: int, end_token: int) -> word {
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back ""
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token < 0 or name_token >= colon_token {
        give back ""
    }
    pilot next_token = v4_ty_skip_trivia(stream_id, name_token + 1)
    if next_token != colon_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, name_token)
}

task v4_ty_call_arg_value_start(stream_id: int, start_token: int, end_token: int) -> int {
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back start_token
    }
    give back v4_ty_skip_trivia(stream_id, colon_token + 1)
}

task v4_ty_call_arg_segment(start_token: int, end_token: int) -> word {
    give back word_from_int(start_token) + "|" + word_from_int(end_token)
}

task v4_ty_call_arg_segment_pipe(segment: word) -> int {
    pilot idx = 0
    repeat until idx >= segment.length() {
        if segment.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_call_arg_segment_start(segment: word) -> int {
    pilot pipe = v4_ty_call_arg_segment_pipe(segment)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(v4_slice(segment, 0, pipe))
}

task v4_ty_call_arg_segment_end(segment: word) -> int {
    pilot pipe = v4_ty_call_arg_segment_pipe(segment)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(v4_slice(segment, pipe + 1, segment.length()))
}

task v4_ty_call_arg_segment_payload_append(payload: word, start_token: int, end_token: int) -> word {
    pilot segment = v4_ty_call_arg_segment(start_token, end_token)
    if payload == "" {
        give back segment
    }
    give back payload + "\n" + segment
}

task v4_ty_call_arg_segment_payload_at(payload: word, wanted: int) -> word {
    if wanted < 0 {
        give back ""
    }
    pilot current = 0
    pilot start_idx = 0
    pilot idx = 0
    repeat until idx > payload.length() {
        if idx == payload.length() or payload.char_at(idx) == "\n" {
            if current == wanted {
                give back v4_slice(payload, start_idx, idx)
            }
            current += 1
            start_idx = idx + 1
        }
        idx += 1
    }
    give back ""
}

task v4_ty_call_arg_slot_payload_new(slot_count: int) -> word {
    pilot payload = ""
    pilot idx = 0
    repeat until idx >= slot_count {
        payload = v4_ty_call_arg_segment_payload_append(payload, 0 - 1, 0 - 1)
        idx += 1
    }
    give back payload
}

task v4_ty_call_arg_slot_assigned(payload: word, slot_id: int) -> bool {
    pilot segment = v4_ty_call_arg_segment_payload_at(payload, slot_id)
    give back v4_ty_call_arg_segment_start(segment) >= 0
}

task v4_ty_call_arg_slot_start(payload: word, slot_id: int) -> int {
    give back v4_ty_call_arg_segment_start(v4_ty_call_arg_segment_payload_at(payload, slot_id))
}

task v4_ty_call_arg_slot_end(payload: word, slot_id: int) -> int {
    give back v4_ty_call_arg_segment_end(v4_ty_call_arg_segment_payload_at(payload, slot_id))
}

task v4_ty_call_arg_slot_set(payload: word, slot_count: int, slot_id: int, start_token: int, end_token: int) -> word {
    pilot rewritten = ""
    pilot idx = 0
    repeat until idx >= slot_count {
        pilot segment = v4_ty_call_arg_segment_payload_at(payload, idx)
        if idx == slot_id {
            segment = v4_ty_call_arg_segment(start_token, end_token)
        }
        rewritten = v4_ty_call_arg_segment_payload_append(rewritten, v4_ty_call_arg_segment_start(segment), v4_ty_call_arg_segment_end(segment))
        idx += 1
    }
    give back rewritten
}

task v4_ty_const_task_call_env_seen(ty_id: int, owner_sig: int, stream_id: int, sig_id: int, callee_name: word, open_token: int, close_token: int, seed_env: word, seen_consts: word, emit_diags: bool, expr_span: word) -> word {
    pilot expected_count = v4_ty_signature_param_count(ty_id, sig_id)
    pilot actual_count = v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
    pilot planned_slots = v4_ty_call_arg_slot_payload_new(expected_count)
    pilot named_seen = false
    pilot next_positional = 0
    pilot env = seed_env
    pilot valid = true
    pilot arg_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    if arg_start < close_token {
        repeat until arg_start >= close_token {
            pilot arg_end = v4_ty_const_ctor_field_end(stream_id, arg_start, close_token)
            if arg_end <= arg_start {
                if emit_diags {
                    v4_ty_add_error_diag(ty_id, expr_span, "const task call arity drift", callee_name + " arguments are malformed")
                }
                give back v4_ty_generic_env_fail
            }

            pilot arg_span = v4_ty_span_from_tokens(stream_id, arg_start, arg_end)
            pilot arg_label = v4_ty_call_arg_label(stream_id, arg_start, arg_end)
            pilot value_start = v4_ty_call_arg_value_start(stream_id, arg_start, arg_end)
            if arg_label != "" {
                named_seen = true
                if value_start < arg_end {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, value_start, arg_end, seen_consts)
                }
                pilot param_idx = v4_ty_signature_param_index_for_name(ty_id, sig_id, arg_label)
                if param_idx < 0 {
                    if emit_diags {
                        v4_ty_add_error_diag(ty_id, arg_span, "unknown call argument", callee_name + " has no parameter " + arg_label)
                    }
                    valid = false
                } else if v4_ty_call_arg_slot_assigned(planned_slots, param_idx) {
                    if emit_diags {
                        v4_ty_add_error_diag(ty_id, arg_span, "duplicate call argument", arg_label + " already has an assignment in " + callee_name)
                    }
                    valid = false
                } else {
                    planned_slots = v4_ty_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
                }
            } else {
                if named_seen {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, arg_start, arg_end, seen_consts)
                    if emit_diags {
                        v4_ty_add_error_diag(ty_id, arg_span, "positional call argument after named", "place positional arguments before named ones in " + callee_name)
                    }
                    valid = false
                } else if next_positional < expected_count {
                    planned_slots = v4_ty_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                    next_positional += 1
                } else {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, arg_start, arg_end, seen_consts)
                    valid = false
                }
            }

            arg_start = v4_ty_skip_trivia(stream_id, arg_end + 1)
        }
    }

    pilot param_idx = 0
    repeat until param_idx >= expected_count {
        if named_seen and not v4_ty_call_arg_slot_assigned(planned_slots, param_idx) {
            if emit_diags {
                pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
                v4_ty_add_error_diag(ty_id, expr_span, "missing call argument", callee_name + " still needs parameter " + param_name)
            }
            valid = false
        }

        pilot planned_start = v4_ty_call_arg_slot_start(planned_slots, param_idx)
        pilot planned_end = v4_ty_call_arg_slot_end(planned_slots, param_idx)
        if planned_start >= 0 and planned_end > planned_start {
            v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, planned_start, planned_end, seen_consts)
            pilot raw_expected_ty = v4_ty_signature_param_type(ty_id, sig_id, param_idx)
            pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, planned_start, planned_end, seen_consts)
            pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
            if next_env == v4_ty_generic_env_fail {
                if emit_diags {
                    pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                    if expected_ty == "" {
                        expected_ty = raw_expected_ty
                    }
                    pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
                    if param_name == "" {
                        param_name = "parameter " + word_from_int(param_idx)
                    }
                    v4_ty_add_error_diag(ty_id, v4_ty_span_from_tokens(stream_id, planned_start, planned_end), "const task call argument mismatch", callee_name + "." + param_name + " expects " + expected_ty + " but got " + actual_ty)
                }
                valid = false
            } else {
                env = next_env
            }
        }
        param_idx += 1
    }

    if actual_count != expected_count {
        if emit_diags {
            v4_ty_add_error_diag(ty_id, expr_span, "const task call arity drift", callee_name + " takes " + word_from_int(expected_count) + " arguments but got " + word_from_int(actual_count))
        }
        valid = false
    }

    if not valid {
        give back v4_ty_generic_env_fail
    }
    give back env
}

task v4_ty_const_task_call_return_type_seen(ty_id: int, owner_sig: int, stream_id: int, callee_name: word, open_token: int, close_token: int, seen_consts: word) -> word {
    pilot lookup_name = callee_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, lookup_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    if not v4_ty_signature_has_attribute(ty_id, sig_id, "const") {
        give back v4_ty_unknown
    }

    pilot env = ""
    if v4_ty_is_generic_instance_type(callee_name) {
        pilot instance_name = v4_ty_canonical_type(ty_id, callee_name)
        if instance_name == "" or instance_name == v4_ty_unknown {
            instance_name = callee_name
        }
        env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
        if env == v4_ty_generic_env_fail {
            give back v4_ty_unknown
        }
    }

    env = v4_ty_const_task_call_env_seen(ty_id, owner_sig, stream_id, sig_id, callee_name, open_token, close_token, env, seen_consts, false, V4_NO_SPAN)
    if env == v4_ty_generic_env_fail {
        give back v4_ty_unknown
    }

    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if not v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            give back v4_ty_unknown
        }
        give back v4_ty_signature_return_type_for_env(ty_id, sig_id, env)
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_signature_return_type(ty_id, sig_id))
}

task v4_ty_const_shape_ctor_result_type_seen(ty_id: int, owner_sig: int, stream_id: int, ctor_name: word, open_token: int, close_token: int, seen_consts: word) -> word {
    pilot lookup_name = ctor_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, lookup_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot instance_name = v4_ty_canonical_type(ty_id, ctor_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = ctor_name
    }
    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
    if env == v4_ty_generic_env_fail {
        give back v4_ty_unknown
    }
    pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    if field_start < close_token {
        repeat until field_start >= close_token {
            pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, close_token)
            pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
            pilot field_name = ""
            if name_token < field_end {
                field_name = v4_lex_token_value(stream_id, name_token)
            }
            pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
            if colon_token >= 0 and field_name != "" {
                pilot field_id = v4_ty_shape_field_id_for_name(ty_id, lookup_name, field_name)
                if field_id >= 0 {
                    pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                    pilot raw_expected_ty = v4_ty_shape_field_type(ty_id, sig_id, field_id)
                    pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                    env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                    if env == v4_ty_generic_env_fail {
                        give back v4_ty_unknown
                    }
                }
            }
            field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
        }
    }

    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            give back v4_ty_signature_instance_type_for_env(ty_id, sig_id, env)
        }
        if v4_ty_is_generic_instance_type(instance_name) {
            give back instance_name
        }
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_signature_name(ty_id, sig_id))
}

task v4_ty_const_route_ctor_result_type_seen(ty_id: int, owner_sig: int, stream_id: int, route_name: word, case_name: word, open_token: int, close_token: int, seen_consts: word) -> word {
    pilot lookup_name = route_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, lookup_name)
    if sig_id < 0 or not v4_ty_route_has_case(ty_id, lookup_name, case_name) {
        give back v4_ty_unknown
    }

    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = route_name
    }
    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
    if env == v4_ty_generic_env_fail {
        give back v4_ty_unknown
    }
    pilot route_sig_name = v4_ty_signature_name(ty_id, sig_id)
    pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    if field_start < close_token {
        repeat until field_start >= close_token {
            pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, close_token)
            pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
            pilot field_name = ""
            if name_token < field_end {
                field_name = v4_lex_token_value(stream_id, name_token)
            }
            pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
            if colon_token >= 0 and field_name != "" {
                pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, lookup_name, case_name, field_name)
                if field_id >= 0 {
                    pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                    pilot raw_expected_ty = v4_ty_route_case_field_type(ty_id, route_sig_name, case_name, field_id)
                    pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                    env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                    if env == v4_ty_generic_env_fail {
                        give back v4_ty_unknown
                    }
                }
            }
            field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
        }
    }

    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            give back v4_ty_signature_instance_type_for_env(ty_id, sig_id, env)
        }
        if v4_ty_is_generic_instance_type(instance_name) {
            give back instance_name
        }
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_signature_name(ty_id, sig_id))
}

task v4_ty_const_expr_type_from_tokens_seen(ty_id: int, owner_sig: int, stream_id: int, start_token: int, end_token: int, seen_consts: word) -> word {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < 0 or first >= end_token {
        give back v4_ty_unknown
    }

    pilot last = end_token - 1
    repeat until last <= first or v4_lex_token_type(stream_id, last) != v4_tok_trivia {
        last -= 1
    }
    if last < first {
        give back v4_ty_unknown
    }

    pilot first_value = v4_lex_token_value(stream_id, first)
    if first_value == "(" and v4_ty_find_matching_paren(stream_id, first, end_token) == last {
        pilot tuple_comma = v4_ty_find_top_level_token(stream_id, first + 1, last, ",")
        if tuple_comma >= 0 {
            pilot tuple_ty = "("
            pilot slot_start = v4_ty_skip_trivia(stream_id, first + 1)
            pilot slot_idx = 0
            repeat until slot_start >= last {
                pilot slot_end = v4_ty_find_top_level_token(stream_id, slot_start, last, ",")
                if slot_end < 0 {
                    slot_end = last
                }
                if slot_end <= slot_start {
                    give back v4_ty_unknown
                }
                pilot slot_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, slot_start, slot_end, seen_consts)
                if slot_ty == v4_ty_unknown {
                    give back v4_ty_unknown
                }
                if slot_idx > 0 {
                    tuple_ty = tuple_ty + ","
                }
                tuple_ty = tuple_ty + slot_ty
                slot_idx += 1
                if slot_end >= last {
                    give back tuple_ty + ")"
                }
                slot_start = v4_ty_skip_trivia(stream_id, slot_end + 1)
            }
            give back v4_ty_unknown
        }
        give back v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, first + 1, last, seen_consts)
    }

    if first_value == "[" and v4_ty_find_matching_square(stream_id, first, end_token) == last {
        pilot repeat_token = v4_ty_find_top_level_token(stream_id, first + 1, last, ";")
        if repeat_token >= 0 {
            pilot value_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, first + 1, repeat_token, seen_consts)
            if value_ty == v4_ty_unknown {
                give back v4_ty_unknown
            }
            pilot count_start = v4_ty_skip_trivia(stream_id, repeat_token + 1)
            if count_start >= last {
                give back v4_ty_unknown
            }
            pilot count_text = v4_ty_type_text(stream_id, count_start, last)
            pilot resolved_length = v4_ty_const_integer_text_from_expr_seen(ty_id, count_text, seen_consts)
            if resolved_length == v4_ty_unknown {
                give back v4_ty_unknown
            }
            if resolved_length.starts_with("-") {
                give back v4_ty_unknown
            }
            give back "[" + value_ty + ";" + resolved_length + "]"
        }

        pilot element_start = v4_ty_skip_trivia(stream_id, first + 1)
        if element_start >= last {
            give back v4_ty_unknown
        }
        pilot element_ty = v4_ty_unknown
        repeat until element_start >= last {
            pilot element_end = v4_ty_find_top_level_token(stream_id, element_start, last, ",")
            if element_end < 0 {
                element_end = last
            }
            if element_end <= element_start {
                give back v4_ty_unknown
            }
            pilot next_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, element_start, element_end, seen_consts)
            if next_ty == v4_ty_unknown {
                give back v4_ty_unknown
            }
            element_ty = v4_ty_const_merge_literal_type(element_ty, next_ty)
            if element_end >= last {
                if element_ty == v4_ty_unknown {
                    give back v4_ty_unknown
                }
                give back "List<" + element_ty + ">"
            }
            element_start = v4_ty_skip_trivia(stream_id, element_end + 1)
        }
        give back v4_ty_unknown
    }

    pilot first_type = v4_lex_token_type(stream_id, first)
    if v4_lex_token_value(stream_id, last) == ")" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "(")
        if open_token > first and v4_ty_find_matching_paren(stream_id, open_token, end_token) == last {
            pilot callee_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if callee_name != "" {
                pilot call_ty = v4_ty_const_task_call_return_type_seen(ty_id, owner_sig, stream_id, callee_name, open_token, last, seen_consts)
                if call_ty != v4_ty_unknown {
                    give back call_ty
                }
            }
        }
    }
    if v4_lex_token_value(stream_id, last) == "}" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "{")
        if open_token > first and v4_ty_find_matching_brace(stream_id, open_token, end_token) == last {
            pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if ctor_name != "" {
                pilot scope_sep = v4_ty_const_path_scope_separator(ctor_name)
                if scope_sep >= 0 {
                    pilot route_name = v4_ty_const_path_left(ctor_name)
                    pilot case_name = v4_ty_const_path_right(ctor_name)
                    if v4_ty_route_signature_id_for_name(ty_id, route_name) >= 0 and case_name != "" {
                        give back v4_ty_const_route_ctor_result_type_seen(ty_id, owner_sig, stream_id, route_name, case_name, open_token, last, seen_consts)
                    }
                } else if v4_ty_shape_signature_id_for_name(ty_id, ctor_name) >= 0 {
                    give back v4_ty_const_shape_ctor_result_type_seen(ty_id, owner_sig, stream_id, ctor_name, open_token, last, seen_consts)
                }
            }
        }
    }

    pilot second = v4_ty_next_nontrivia(stream_id, first + 1, end_token)
    if second < end_token {
        pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, end_token)
        if ctor_name != "" {
            pilot scope_sep = v4_ty_const_path_scope_separator(ctor_name)
            if scope_sep >= 0 {
                pilot route_name = v4_ty_const_path_left(ctor_name)
                pilot case_name = v4_ty_const_path_right(ctor_name)
                pilot lookup_name = route_name
                if v4_ty_is_generic_instance_type(lookup_name) {
                    lookup_name = v4_ty_generic_base_name(lookup_name)
                }
                if v4_ty_route_signature_id_for_name(ty_id, lookup_name) >= 0 and case_name != "" and v4_ty_route_has_case(ty_id, lookup_name, case_name) and not v4_ty_route_case_has_payload(ty_id, lookup_name, case_name) {
                    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, lookup_name)
                    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
                    if instance_name == "" or instance_name == v4_ty_unknown {
                        instance_name = route_name
                    }
                    if v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name) == v4_ty_generic_env_fail {
                        give back v4_ty_unknown
                    }
                    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 and not v4_ty_is_generic_instance_type(instance_name) {
                        give back v4_ty_unknown
                    }
                    give back v4_ty_canonical_type(ty_id, instance_name)
                }
            }
        }
        pilot expr_text = v4_ty_type_text(stream_id, first, end_token)
        if v4_ty_const_integer_text_from_expr_seen(ty_id, expr_text, seen_consts) != v4_ty_unknown {
            give back v4_ty_int
        }
        give back v4_ty_unknown
    }

    if first_type == v4_tok_int {
        give back v4_ty_int_literal_type(first_value, v4_ty_unknown)
    }
    if first_type == v4_tok_float {
        give back v4_ty_float_literal_type(first_value, v4_ty_unknown)
    }
    if first_type == v4_tok_string {
        give back v4_ty_word
    }
    if first_type == v4_tok_bool {
        give back v4_ty_bool
    }
    if first_type == v4_tok_char {
        give back v4_ty_char
    }
    if first_type == v4_tok_ident or first_type == v4_tok_keyword {
        pilot dep_sig = v4_ty_const_signature_id_for_name(ty_id, first_value)
        if dep_sig >= 0 and dep_sig != owner_sig {
            give back v4_ty_const_value_type_for_sig_seen(ty_id, dep_sig, seen_consts)
        }
    }

    pilot expr_text = v4_ty_type_text(stream_id, first, end_token)
    if v4_ty_const_integer_text_from_expr_seen(ty_id, expr_text, seen_consts) != v4_ty_unknown {
        give back v4_ty_int
    }
    give back v4_ty_unknown
}

task v4_ty_const_name_list_contains(names: word, name: word) -> bool {
    if names == "" or name == "" {
        give back false
    }
    give back ("|" + names + "|").contains("|" + name + "|")
}

task v4_ty_const_name_list_add(names: word, name: word) -> word {
    if name == "" {
        give back names
    }
    if names == "" {
        give back name
    }
    give back names + "|" + name
}

task v4_ty_const_ctor_field_end(stream_id: int, start_token: int, close_token: int) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_validate_const_expr_seen(ty_id: int, owner_sig: int, stream_id: int, start_token: int, end_token: int, seen_consts: word) -> void {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < 0 or first >= end_token {
        give back
    }

    pilot last = end_token - 1
    repeat until last <= first or v4_lex_token_type(stream_id, last) != v4_tok_trivia {
        last -= 1
    }
    if last < first {
        give back
    }

    pilot first_value = v4_lex_token_value(stream_id, first)
    pilot expr_span = v4_ty_span_from_tokens(stream_id, first, last + 1)
    if first_value == "(" and v4_ty_find_matching_paren(stream_id, first, end_token) == last {
        pilot tuple_comma = v4_ty_find_top_level_token(stream_id, first + 1, last, ",")
        if tuple_comma >= 0 {
            pilot slot_start = v4_ty_skip_trivia(stream_id, first + 1)
            repeat until slot_start >= last {
                pilot slot_end = v4_ty_find_top_level_token(stream_id, slot_start, last, ",")
                if slot_end < 0 {
                    slot_end = last
                }
                if slot_end > slot_start {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, slot_start, slot_end, seen_consts)
                }
                if slot_end >= last {
                    give back
                }
                slot_start = v4_ty_skip_trivia(stream_id, slot_end + 1)
            }
            give back
        }
        v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, first + 1, last, seen_consts)
        give back
    }

    if first_value == "[" and v4_ty_find_matching_square(stream_id, first, end_token) == last {
        pilot repeat_token = v4_ty_find_top_level_token(stream_id, first + 1, last, ";")
        if repeat_token >= 0 {
            v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, first + 1, repeat_token, seen_consts)
            give back
        }

        pilot element_start = v4_ty_skip_trivia(stream_id, first + 1)
        repeat until element_start >= last {
            pilot element_end = v4_ty_find_top_level_token(stream_id, element_start, last, ",")
            if element_end < 0 {
                element_end = last
            }
            if element_end > element_start {
                v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, element_start, element_end, seen_consts)
            }
            if element_end >= last {
                give back
            }
            element_start = v4_ty_skip_trivia(stream_id, element_end + 1)
        }
        give back
    }

    if v4_lex_token_value(stream_id, last) == ")" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "(")
        if open_token > first and v4_ty_find_matching_paren(stream_id, open_token, end_token) == last {
            pilot callee_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if callee_name != "" {
                pilot lookup_name = callee_name
                if v4_ty_is_generic_instance_type(lookup_name) {
                    lookup_name = v4_ty_generic_base_name(lookup_name)
                }
                pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, lookup_name)
                if sig_id >= 0 {
                    v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, callee_name, "const task call " + callee_name, expr_span)

                    pilot env = ""
                    if v4_ty_is_generic_instance_type(callee_name) {
                        pilot instance_name = v4_ty_canonical_type(ty_id, callee_name)
                        if instance_name == "" or instance_name == v4_ty_unknown {
                            instance_name = callee_name
                        }
                        env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
                        if env == v4_ty_generic_env_fail {
                            give back
                        }
                    }

                    if not v4_ty_signature_has_attribute(ty_id, sig_id, "const") {
                        v4_ty_add_error_diag(ty_id, expr_span, "root constant task call needs @const", callee_name + " must be declared with @const before a fixed pilot can call it")
                        give back
                    }

                    pilot ignored_env = v4_ty_const_task_call_env_seen(ty_id, owner_sig, stream_id, sig_id, callee_name, open_token, last, env, seen_consts, true, expr_span)
                    give back
                }
            }
        }
    }

    if v4_lex_token_value(stream_id, last) == "}" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "{")
        if open_token > first and v4_ty_find_matching_brace(stream_id, open_token, end_token) == last {
            pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if ctor_name != "" {
                pilot scope_sep = v4_ty_const_path_scope_separator(ctor_name)
                if scope_sep >= 0 {
                    pilot route_name = v4_ty_const_path_left(ctor_name)
                    pilot case_name = v4_ty_const_path_right(ctor_name)
                    pilot route_lookup_name = route_name
                    if v4_ty_is_generic_instance_type(route_lookup_name) {
                        route_lookup_name = v4_ty_generic_base_name(route_lookup_name)
                    }
                    v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, route_name, "route constructor " + route_name + "::" + case_name, expr_span)
                    if case_name == "" {
                        v4_ty_add_error_diag(ty_id, expr_span, "route constructor needs case name", "use " + route_name + "::CaseName")
                        give back
                    }
                    if not v4_ty_is_route_type(ty_id, route_lookup_name) {
                        v4_ty_add_error_diag(ty_id, expr_span, "unknown route constructor", route_name + " is not a known route")
                        give back
                    }
                    if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
                        v4_ty_add_error_diag(ty_id, expr_span, "unknown route case", route_name + " exposes no case " + case_name)
                        give back
                    }

                    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_lookup_name)
                    pilot route_sig_name = v4_ty_signature_name(ty_id, sig_id)
                    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
                    if instance_name == "" or instance_name == v4_ty_unknown {
                        instance_name = route_name
                    }
                    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
                    if env == v4_ty_generic_env_fail {
                        give back
                    }

                    pilot field_count = v4_ty_route_case_field_count(ty_id, route_lookup_name, case_name)
                    if field_count <= 0 {
                        v4_ty_add_error_diag(ty_id, expr_span, "route case has no payload", route_name + "::" + case_name + " carries no fields")
                        give back
                    }

                    pilot seen_fields = ""
                    pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
                    if field_start < last {
                        repeat until field_start >= last {
                            pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, last)
                            pilot field_span = v4_ty_span_from_tokens(stream_id, field_start, field_end)
                            pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
                            pilot field_name = ""
                            if name_token < field_end {
                                field_name = v4_lex_token_value(stream_id, name_token)
                            }
                            pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
                            if colon_token < 0 or field_name == "" {
                                v4_ty_add_error_diag(ty_id, field_span, "malformed route field", "expected field: value inside " + route_name + "::" + case_name)
                            } else {
                                if v4_ty_const_name_list_contains(seen_fields, field_name) {
                                    v4_ty_add_error_diag(ty_id, field_span, "duplicate route case field", field_name + " already set on " + route_name + "::" + case_name)
                                } else {
                                    seen_fields = v4_ty_const_name_list_add(seen_fields, field_name)
                                }

                                pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                                v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)

                                pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_lookup_name, case_name, field_name)
                                if field_id < 0 {
                                    v4_ty_add_error_diag(ty_id, field_span, "unknown route case field", route_name + "::" + case_name + " has no field " + field_name)
                                } else {
                                    pilot raw_expected_ty = v4_ty_route_case_field_type(ty_id, route_sig_name, case_name, field_id)
                                    pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                                    pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                                    pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                                    if next_env == v4_ty_generic_env_fail {
                                        if expected_ty == "" {
                                            expected_ty = raw_expected_ty
                                        }
                                        v4_ty_add_error_diag(ty_id, field_span, "route case field type mismatch", route_name + "::" + case_name + "." + field_name + " expects " + expected_ty + " but got " + actual_ty)
                                    } else {
                                        env = next_env
                                    }
                                }
                            }
                            field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
                        }
                    }

                    pilot required_field_id = 0
                    repeat until required_field_id >= field_count {
                        pilot required_name = v4_ty_route_case_field_name(ty_id, route_lookup_name, case_name, required_field_id)
                        if required_name != "" and not v4_ty_const_name_list_contains(seen_fields, required_name) {
                            v4_ty_add_error_diag(ty_id, expr_span, "missing route case field", route_name + "::" + case_name + " requires field " + required_name)
                        }
                        required_field_id += 1
                    }
                    give back
                }

                pilot shape_lookup_name = ctor_name
                if v4_ty_is_generic_instance_type(shape_lookup_name) {
                    shape_lookup_name = v4_ty_generic_base_name(shape_lookup_name)
                }
                v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, ctor_name, "shape constructor " + ctor_name, expr_span)
                pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_lookup_name)
                if sig_id < 0 {
                    v4_ty_add_error_diag(ty_id, expr_span, "unknown shape constructor", ctor_name + " is not a known shape")
                    give back
                }

                pilot instance_name = v4_ty_canonical_type(ty_id, ctor_name)
                if instance_name == "" or instance_name == v4_ty_unknown {
                    instance_name = ctor_name
                }
                pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
                if env == v4_ty_generic_env_fail {
                    give back
                }
                pilot seen_fields = ""
                pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
                if field_start < last {
                    repeat until field_start >= last {
                        pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, last)
                        pilot field_span = v4_ty_span_from_tokens(stream_id, field_start, field_end)
                        pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
                        pilot field_name = ""
                        if name_token < field_end {
                            field_name = v4_lex_token_value(stream_id, name_token)
                        }
                        pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
                        if colon_token < 0 or field_name == "" {
                            v4_ty_add_error_diag(ty_id, field_span, "malformed shape field", "expected field: value inside " + ctor_name)
                        } else {
                            if v4_ty_const_name_list_contains(seen_fields, field_name) {
                                v4_ty_add_error_diag(ty_id, field_span, "duplicate shape field", field_name + " already set on " + ctor_name)
                            } else {
                                seen_fields = v4_ty_const_name_list_add(seen_fields, field_name)
                            }

                            pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                            v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)

                            pilot shape_field_id = v4_ty_shape_field_id_for_name(ty_id, shape_lookup_name, field_name)
                            if shape_field_id < 0 {
                                v4_ty_add_error_diag(ty_id, field_span, "unknown shape field", ctor_name + " has no field " + field_name)
                            } else {
                                pilot raw_expected_ty = v4_ty_shape_field_type(ty_id, sig_id, shape_field_id)
                                pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                                pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                                pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                                if next_env == v4_ty_generic_env_fail {
                                    if expected_ty == "" {
                                        expected_ty = raw_expected_ty
                                    }
                                    v4_ty_add_error_diag(ty_id, field_span, "shape field type mismatch", ctor_name + "." + field_name + " expects " + expected_ty + " but got " + actual_ty)
                                } else {
                                    env = next_env
                                }
                            }
                        }
                        field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
                    }
                }

                pilot required_field_id = 0
                pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
                repeat until required_field_id >= field_count {
                    pilot required_name = v4_ty_shape_field_name(ty_id, sig_id, required_field_id)
                    if required_name != "" and not v4_ty_const_name_list_contains(seen_fields, required_name) {
                        v4_ty_add_error_diag(ty_id, expr_span, "missing shape field", ctor_name + " requires field " + required_name)
                    }
                    required_field_id += 1
                }
                give back
            }
        }
    }

    pilot second = v4_ty_next_nontrivia(stream_id, first + 1, end_token)
    if second < end_token {
        pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, end_token)
        if ctor_name != "" {
            pilot route_name = v4_ty_const_path_left(ctor_name)
            pilot case_name = v4_ty_const_path_right(ctor_name)
            pilot route_lookup_name = route_name
            if v4_ty_is_generic_instance_type(route_lookup_name) {
                route_lookup_name = v4_ty_generic_base_name(route_lookup_name)
            }
            v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, route_name, "route constructor " + route_name + "::" + case_name, expr_span)
            if route_name != "" {
                if case_name == "" {
                    v4_ty_add_error_diag(ty_id, expr_span, "route constructor needs case name", "use " + route_name + "::CaseName")
                    give back
                }
                if not v4_ty_is_route_type(ty_id, route_lookup_name) {
                    v4_ty_add_error_diag(ty_id, expr_span, "unknown route constructor", route_name + " is not a known route")
                    give back
                }
                if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
                    v4_ty_add_error_diag(ty_id, expr_span, "unknown route case", route_name + " exposes no case " + case_name)
                    give back
                }
                pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_lookup_name)
                pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
                if instance_name == "" or instance_name == v4_ty_unknown {
                    instance_name = route_name
                }
                if v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name) == v4_ty_generic_env_fail {
                    give back
                }
                if v4_ty_route_case_has_payload(ty_id, route_lookup_name, case_name) {
                    v4_ty_add_error_diag(ty_id, expr_span, "route payload constructor needs fields", route_name + "::" + case_name + " expects named fields")
                }
            }
        }
    }
}

task v4_ty_const_value_type_for_sig_seen(ty_id: int, sig_id: int, seen_consts: word) -> word {
    pilot const_name = v4_ty_signature_name(ty_id, sig_id)
    if v4_ty_const_cycle_seen_contains(seen_consts, const_name) {
        give back v4_ty_unknown
    }
    pilot declared_ty = v4_ty_const_declared_type_for_sig(ty_id, sig_id)
    if declared_ty != "" {
        give back v4_ty_canonical_type(ty_id, declared_ty)
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot init_start = v4_ty_const_init_start_token(ty_id, sig_id)
    pilot init_end = v4_ty_const_init_end_token(ty_id, sig_id)
    if stream_id < 0 or init_start < 0 or init_end <= init_start {
        give back v4_ty_unknown
    }
    pilot next_seen = v4_ty_const_cycle_seen_append(seen_consts, const_name)
    give back v4_ty_const_expr_type_from_tokens_seen(ty_id, sig_id, stream_id, init_start, init_end, next_seen)
}

task v4_ty_const_value_type_for_sig(ty_id: int, sig_id: int) -> word {
    give back v4_ty_const_value_type_for_sig_seen(ty_id, sig_id, "")
}

task v4_ty_const_value_type_for_name(ty_id: int, const_name: word) -> word {
    pilot sig_id = v4_ty_const_signature_id_for_name(ty_id, const_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_const_value_type_for_sig(ty_id, sig_id)
}

task v4_ty_const_cycle_seen_contains(seen_consts: word, const_name: word) -> bool {
    if seen_consts == "" or const_name == "" {
        give back false
    }
    give back ("|" + seen_consts + "|").contains("|" + const_name + "|")
}

task v4_ty_const_cycle_seen_append(seen_consts: word, const_name: word) -> word {
    if const_name == "" {
        give back seen_consts
    }
    if seen_consts == "" {
        give back const_name
    }
    give back seen_consts + "|" + const_name
}

task v4_ty_compact_const_expr_text(expr: word) -> word {
    pilot out = ""
    pilot idx = 0
    repeat until idx >= expr.length() {
        pilot ch = expr.char_at(idx)
        if ch != " " and ch != "\t" and ch != "\n" and ch != "\r" {
            out = out + ch
        }
        idx += 1
    }
    give back out
}

task v4_ty_const_expr_is_wrapped(expr: word) -> bool {
    if expr.length() < 2 {
        give back false
    }
    if expr.char_at(0) != "(" or expr.char_at(expr.length() - 1) != ")" {
        give back false
    }

    pilot depth = 0
    pilot idx = 0
    repeat until idx >= expr.length() {
        pilot ch = expr.char_at(idx)
        if ch == "(" {
            depth += 1
        } else if ch == ")" {
            depth -= 1
            if depth == 0 and idx < expr.length() - 1 {
                give back false
            }
        }
        idx += 1
    }
    give back depth == 0
}

task v4_ty_strip_const_expr_wrappers(expr: word) -> word {
    pilot out = v4_ty_compact_const_expr_text(expr)
    repeat until out.length() < 2 or v4_ty_const_expr_is_wrapped(out) == false {
        out = out.substring(1, out.length() - 1)
    }
    give back out
}

task v4_ty_integer_literal_value_text(value: word) -> word {
    pilot compact = v4_ty_strip_const_expr_wrappers(value)
    if compact == "" {
        give back v4_ty_unknown
    }

    pilot negative = false
    if compact.char_at(0) == "-" {
        if compact.length() <= 1 {
            give back v4_ty_unknown
        }
        negative = true
        compact = compact.substring(1, compact.length())
    }

    pilot digits = v4_ty_numeric_literal_value(compact)
    if digits == "" {
        give back v4_ty_unknown
    }

    pilot idx = 0
    repeat until idx >= digits.length() {
        pilot ch = digits.char_at(idx)
        if not v4_lex_is_digit(ch) {
            give back v4_ty_unknown
        }
        idx += 1
    }

    if negative {
        give back "-" + digits
    }
    give back digits
}

task v4_ty_const_expr_is_prefix_operator(expr: word, idx: int) -> bool {
    if idx <= 0 {
        give back true
    }
    pilot prev = expr.char_at(idx - 1)
    give back prev == "+" or prev == "-" or prev == "*" or prev == "/" or prev == "%" or prev == "("
}

task v4_ty_const_expr_last_top_level_operator(expr: word, first: word, second: word) -> int {
    pilot depth = 0
    pilot idx = expr.length() - 1
    repeat until idx < 0 {
        pilot ch = expr.char_at(idx)
        if ch == ")" {
            depth += 1
        } else if ch == "(" {
            if depth > 0 {
                depth -= 1
            }
        } else if depth == 0 {
            if ch == first or (second != "" and ch == second) {
                if (ch == "+" or ch == "-") and v4_ty_const_expr_is_prefix_operator(expr, idx) {
                    -- unary prefix, not a binary split point
                } else {
                    give back idx
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_ty_const_expr_last_top_level_mul_operator(expr: word) -> int {
    pilot depth = 0
    pilot idx = expr.length() - 1
    repeat until idx < 0 {
        pilot ch = expr.char_at(idx)
        if ch == ")" {
            depth += 1
        } else if ch == "(" {
            if depth > 0 {
                depth -= 1
            }
        } else if depth == 0 {
            if ch == "*" or ch == "/" or ch == "%" {
                give back idx
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_ty_const_integer_apply_binary(op: word, left_text: word, right_text: word) -> word {
    if not v4_ty_is_integer_text_literal(left_text) or not v4_ty_is_integer_text_literal(right_text) {
        give back v4_ty_unknown
    }

    pilot left = word_to_int(left_text)
    pilot right = word_to_int(right_text)
    if op == "+" {
        give back word_from_int(left + right)
    }
    if op == "-" {
        give back word_from_int(left - right)
    }
    if op == "*" {
        give back word_from_int(left * right)
    }
    if op == "/" {
        if right == 0 {
            give back v4_ty_unknown
        }
        give back word_from_int(left / right)
    }
    if op == "%" {
        if right == 0 {
            give back v4_ty_unknown
        }
        give back word_from_int(left % right)
    }
    give back v4_ty_unknown
}

task v4_ty_const_integer_text_from_expr_seen(ty_id: int, expr_text: word, seen_consts: word) -> word {
    pilot expr = v4_ty_strip_const_expr_wrappers(expr_text)
    if expr == "" {
        give back v4_ty_unknown
    }

    pilot literal = v4_ty_integer_literal_value_text(expr)
    if literal != v4_ty_unknown {
        give back literal
    }

    pilot additive_split = v4_ty_const_expr_last_top_level_operator(expr, "+", "-")
    if additive_split >= 0 {
        pilot left = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(0, additive_split), seen_consts)
        pilot right = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(additive_split + 1, expr.length()), seen_consts)
        give back v4_ty_const_integer_apply_binary(expr.char_at(additive_split), left, right)
    }

    pilot multiplicative_split = v4_ty_const_expr_last_top_level_mul_operator(expr)
    if multiplicative_split >= 0 {
        pilot left = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(0, multiplicative_split), seen_consts)
        pilot right = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(multiplicative_split + 1, expr.length()), seen_consts)
        give back v4_ty_const_integer_apply_binary(expr.char_at(multiplicative_split), left, right)
    }

    if expr.char_at(0) == "+" and expr.length() > 1 {
        give back v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(1, expr.length()), seen_consts)
    }
    if expr.char_at(0) == "-" and expr.length() > 1 {
        pilot inner = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(1, expr.length()), seen_consts)
        if inner != v4_ty_unknown and inner.char_at(0) != "-" {
            give back "-" + inner
        }
    }

    pilot sig_id = v4_ty_const_signature_id_for_name(ty_id, expr)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_const_integer_text_for_sig_seen(ty_id, sig_id, seen_consts)
}

task v4_ty_const_integer_text_from_expr(ty_id: int, expr_text: word) -> word {
    give back v4_ty_const_integer_text_from_expr_seen(ty_id, expr_text, "")
}

task v4_ty_const_integer_text_for_sig_seen(ty_id: int, sig_id: int, seen_consts: word) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back v4_ty_unknown
    }

    pilot const_name = v4_ty_signature_name(ty_id, sig_id)
    if const_name == "" {
        give back v4_ty_unknown
    }
    if v4_ty_const_cycle_seen_contains(seen_consts, const_name) {
        give back v4_ty_unknown
    }
    pilot declared_ty = v4_ty_const_declared_type_for_sig(ty_id, sig_id)
    if declared_ty != "" {
        declared_ty = v4_ty_canonical_type(ty_id, declared_ty)
    }
    if declared_ty != "" and not v4_ty_is_integer(declared_ty) {
        give back v4_ty_unknown
    }
    give back v4_ty_const_integer_text_from_expr_seen(ty_id, v4_ty_const_init_text_for_sig(ty_id, sig_id), v4_ty_const_cycle_seen_append(seen_consts, const_name))
}

task v4_ty_const_integer_text_for_sig(ty_id: int, sig_id: int) -> word {
    give back v4_ty_const_integer_text_for_sig_seen(ty_id, sig_id, "")
}

task v4_ty_const_integer_text_for_name(ty_id: int, const_name: word) -> word {
    pilot sig_id = v4_ty_const_signature_id_for_name(ty_id, const_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_const_integer_text_for_sig(ty_id, sig_id)
}

task v4_ty_const_dep_name_at_token(ty_id: int, stream_id: int, token_id: int, start_token: int, end_token: int) -> word {
    pilot tok_type = v4_lex_token_type(stream_id, token_id)
    if tok_type != v4_tok_ident and tok_type != v4_tok_keyword {
        give back ""
    }

    pilot token_value = v4_lex_token_value(stream_id, token_id)
    if v4_ty_const_signature_id_for_name(ty_id, token_value) < 0 {
        give back ""
    }

    pilot prev_token = v4_ty_prev_nontrivia(stream_id, token_id - 1, start_token)
    if prev_token >= start_token {
        pilot prev_value = v4_lex_token_value(stream_id, prev_token)
        if prev_value == "." or prev_value == "::" {
            give back ""
        }
    }

    pilot next_token = v4_ty_next_nontrivia(stream_id, token_id + 1, end_token)
    if next_token < end_token {
        pilot next_value = v4_lex_token_value(stream_id, next_token)
        if next_value == ":" or next_value == "::" or next_value == "(" {
            give back ""
        }
    }

    give back token_value
}

task v4_ty_const_cycle_path_for_sig(ty_id: int, sig_id: int, seen_consts: word) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back ""
    }

    pilot const_name = v4_ty_signature_name(ty_id, sig_id)
    pilot next_seen = v4_ty_const_cycle_seen_append(seen_consts, const_name)
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_const_init_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_const_init_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }

    pilot token_id = start_token
    repeat until token_id >= end_token {
        pilot dep_name = v4_ty_const_dep_name_at_token(ty_id, stream_id, token_id, start_token, end_token)
        if dep_name != "" {
            if v4_ty_const_cycle_seen_contains(next_seen, dep_name) {
                give back v4_ty_const_cycle_seen_append(next_seen, dep_name)
            }
            pilot dep_sig = v4_ty_const_signature_id_for_name(ty_id, dep_name)
            if dep_sig >= 0 {
                pilot dep_path = v4_ty_const_cycle_path_for_sig(ty_id, dep_sig, next_seen)
                if dep_path != "" {
                    give back dep_path
                }
            }
        }
        token_id += 1
    }
    give back ""
}

task v4_ty_validate_const_cycles(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_const_sig {
            pilot cycle_path = v4_ty_const_cycle_path_for_sig(ty_id, sig_id, "")
            if cycle_path != "" {
                pilot const_name = v4_ty_signature_name(ty_id, sig_id)
                pilot span = v4_ty_const_name_span(ty_id, sig_id)
                v4_ty_add_error_diag(ty_id, span, "Yuuko constant loop: fixed pilot " + const_name + " depends on itself via " + v4_ty_alias_cycle_chain_display(cycle_path), "break the constant cycle with a literal or a const task boundary")
            }
        }
        sig_id += 1
    }
}

task v4_ty_validate_const_initializers(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_const_sig {
            pilot const_name = v4_ty_signature_name(ty_id, sig_id)
            pilot declared_ty = v4_ty_const_declared_type_for_sig(ty_id, sig_id)
            pilot stream_id = v4_ty_signature_stream_id(ty_id)
            pilot init_start = v4_ty_const_init_start_token(ty_id, sig_id)
            pilot init_end = v4_ty_const_init_end_token(ty_id, sig_id)
            if stream_id >= 0 and init_start >= 0 and init_end > init_start {
                v4_ty_validate_const_expr_seen(ty_id, sig_id, stream_id, init_start, init_end, v4_ty_const_cycle_seen_append("", const_name))
            }
            if declared_ty != "" {
                declared_ty = v4_ty_canonical_type(ty_id, declared_ty)
                if stream_id >= 0 and init_start >= 0 and init_end > init_start {
                    pilot init_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, sig_id, stream_id, init_start, init_end, const_name)
                    if init_ty != v4_ty_unknown and not v4_ty_types_compatible_in_signature(ty_id, sig_id, declared_ty, init_ty) {
                        pilot span = v4_ty_span_from_tokens(stream_id, init_start, init_end)
                        v4_ty_add_error_diag(ty_id, span, "constant initializer type mismatch", "fixed pilot " + const_name + " expects " + declared_ty + " but got " + init_ty)
                    }
                }
            }
        }
        sig_id += 1
    }
}

task v4_ty_skip_item(stream_id: int, start_token: int, end_limit: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_body = false
    pilot count = end_limit
    if count > v4_lex_token_count(stream_id) {
        count = v4_lex_token_count(stream_id)
    }

    repeat until idx >= count {
        if v4_lex_token_type(stream_id, idx) == v4_tok_eof {
            give back idx
        }

        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia and val == "\n" and not saw_body and depth == 0 {
            give back idx + 1
        }

        if tok_type != v4_tok_trivia {
            if val == "{" {
                depth += 1
                saw_body = true
            } else if val == "}" {
                if depth > 0 {
                    depth -= 1
                }
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "done" {
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "=>" {
                saw_body = true
            }
        }
        idx += 1
    }
    give back idx
}

task v4_ty_impl_target_type_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back ""
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back ""
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token >= 0 {
        pilot type_start = v4_ty_skip_trivia(stream_id, for_token + 1)
        give back v4_ty_type_text(stream_id, type_start, open_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    give back v4_ty_type_text(stream_id, type_start, open_token)
}

task v4_ty_impl_doctrine_name_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back ""
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back ""
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token < 0 {
        give back ""
    }
    pilot doctrine_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    if doctrine_start >= for_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, doctrine_start, for_token)
}

task v4_ty_impl_target_span_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back V4_NO_SPAN
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back V4_NO_SPAN
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back V4_NO_SPAN
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token >= 0 {
        pilot type_start = v4_ty_skip_trivia(stream_id, for_token + 1)
        give back v4_ty_span_from_tokens(stream_id, type_start, open_token)
    }

    pilot type_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    give back v4_ty_span_from_tokens(stream_id, type_start, open_token)
}

task v4_ty_alias_lookup_name_from_surface_name(ty_id: int, surface_name: word) -> word {
    if surface_name == "" or surface_name == v4_ty_unknown {
        give back ""
    }
    if v4_ty_alias_signature_id_for_name(ty_id, surface_name) >= 0 {
        give back surface_name
    }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot direct_symbol = v4_resolve_lookup_any(resolve_id, surface_name)
        if direct_symbol >= 0 {
            if v4_resolve_symbol_kind(resolve_id, direct_symbol) == v4_hir_alias {
                pilot target_name = v4_resolve_symbol_target_name(resolve_id, direct_symbol)
                if target_name != "" and target_name != surface_name {
                    if v4_ty_alias_signature_id_for_name(ty_id, target_name) >= 0 {
                        give back target_name
                    }
                }
            }
        }
        pilot expanded = v4_resolve_expand_import_name(resolve_id, surface_name)
        if expanded != "" and expanded != surface_name {
            if v4_ty_alias_signature_id_for_name(ty_id, expanded) >= 0 {
                give back expanded
            }
        }
    }
    give back ""
}

task v4_ty_alias_lookup_type_from_surface_type(ty_id: int, type_text: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot lookup_base = v4_ty_alias_lookup_name_from_surface_name(ty_id, base_name)
        if lookup_base != "" {
            give back lookup_base + v4_slice(type_text, base_name.length(), type_text.length())
        }
        give back ""
    }
    give back v4_ty_alias_lookup_name_from_surface_name(ty_id, type_text)
}

task v4_ty_alias_name_from_surface_type(ty_id: int, type_text: word) -> word {
    pilot lookup_type = v4_ty_alias_lookup_type_from_surface_type(ty_id, type_text)
    if lookup_type == "" {
        give back ""
    }
    if v4_ty_is_generic_instance_type(lookup_type) {
        give back v4_ty_generic_base_name(lookup_type)
    }
    give back lookup_type
}

task v4_ty_impl_target_alias_name_from_hir(ty_id: int, hir_item: int) -> word {
    give back v4_ty_alias_name_from_surface_type(ty_id, v4_ty_impl_target_type_from_hir(ty_id, hir_item))
}

task v4_ty_impl_body_open_token_from_hir(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_impl_body_close_token_from_hir(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_hir_item_end_token(hir_id, hir_item))
}

task v4_ty_impl_method_count(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_impl_method_start_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 or method_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == method_id {
                give back idx
            }
            current += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_ty_impl_method_end_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_skip_item(stream_id, start_token, close_token)
}

task v4_ty_impl_method_name(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    if start_token < 0 {
        give back ""
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    if name_token < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, name_token)
}

task v4_ty_impl_method_param_open_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_impl_method_param_close_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
    if open_token < 0 or end_token <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, end_token)
}

task v4_ty_impl_method_param_count(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id), v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id))
}

task v4_ty_impl_method_param_name(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_impl_method_param_mode(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_param_mode_value
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_mode_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_impl_method_param_type(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    pilot param_name = v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
    if param_name == "self" {
        give back v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_impl_method_is_instance(ty_id: int, hir_item: int, method_id: int) -> bool {
    if v4_ty_impl_method_param_count(ty_id, hir_item, method_id) <= 0 {
        give back false
    }
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, 0) == "self"
}

task v4_ty_impl_method_explicit_param_count(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot count = v4_ty_impl_method_param_count(ty_id, hir_item, method_id)
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        if count > 0 {
            give back count - 1
        }
    }
    give back count
}

task v4_ty_impl_method_explicit_param_name(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_impl_method_explicit_param_type(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_impl_method_explicit_param_mode(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_mode(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_match_type_pattern_env(ty_id: int, pattern_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    pilot canonical_pattern = v4_ty_canonical_type(ty_id, pattern_ty)
    if canonical_pattern != "" and canonical_pattern != v4_ty_unknown {
        pattern_ty = canonical_pattern
    }
    pilot canonical_actual = v4_ty_canonical_type(ty_id, actual_ty)
    if canonical_actual != "" and canonical_actual != v4_ty_unknown {
        actual_ty = canonical_actual
    }
    if pattern_ty == "" or pattern_ty == v4_ty_unknown or not v4_ty_is_known(actual_ty) {
        give back v4_ty_generic_env_fail
    }
    if pattern_ty == actual_ty {
        give back env
    }
    if v4_ty_is_numeric(pattern_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_raw_pointer_type(pattern_ty) or v4_ty_is_raw_pointer_type(actual_ty) {
        if not v4_ty_is_raw_pointer_type(pattern_ty) or not v4_ty_is_raw_pointer_type(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_raw_pointer_prefix(pattern_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_type_pattern_env(ty_id, v4_ty_raw_pointer_target_type(pattern_ty), v4_ty_raw_pointer_target_type(actual_ty), env)
    }
    if v4_ty_is_generic_instance_type(pattern_ty) or v4_ty_is_generic_instance_type(actual_ty) {
        if not v4_ty_is_generic_instance_type(pattern_ty) or not v4_ty_is_generic_instance_type(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_base_name(pattern_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(pattern_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(pattern_ty)
        repeat until arg_idx >= arg_count {
            next_env = v4_ty_match_type_pattern_env(ty_id, v4_ty_generic_arg(pattern_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(pattern_ty) or v4_ty_is_tuple_type(actual_ty) {
        if not v4_ty_is_tuple_type(pattern_ty) or not v4_ty_is_tuple_type(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_tuple_slot_count(pattern_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(pattern_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_type_pattern_env(ty_id, v4_ty_tuple_slot_type(pattern_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(pattern_ty) or v4_ty_is_fixed_array_type(actual_ty) {
        if not v4_ty_is_fixed_array_type(pattern_ty) or not v4_ty_is_fixed_array_type(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_fixed_array_length_normalized_text(ty_id, pattern_ty) != v4_ty_fixed_array_length_normalized_text(ty_id, actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_type_pattern_env(ty_id, v4_ty_fixed_array_element_type(pattern_ty), v4_ty_fixed_array_element_type(actual_ty), env)
    }
    if not v4_ty_is_declared_simple_type_name(ty_id, pattern_ty) {
        give back v4_ty_generic_env_bind(env, pattern_ty, actual_ty)
    }
    if v4_ty_types_compatible(pattern_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_impl_generic_env_for_owner(ty_id: int, hir_item: int, owner_ty: word) -> word {
    give back v4_ty_match_type_pattern_env(ty_id, v4_ty_impl_target_type_from_hir(ty_id, hir_item), owner_ty, "")
}

task v4_ty_impl_matches_owner(ty_id: int, hir_item: int, owner_ty: word) -> bool {
    if v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item) != "" and v4_ty_impl_target_alias_name_from_hir(ty_id, hir_item) != "" {
        give back false
    }
    give back v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty) != v4_ty_generic_env_fail
}

task v4_ty_apply_impl_generics(ty_id: int, hir_item: int, owner_ty: word, member_ty: word) -> word {
    pilot env = v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty)
    if env == v4_ty_generic_env_fail {
        give back member_ty
    }
    give back v4_ty_apply_generic_env(member_ty, env)
}

task v4_ty_impl_method_param_type_for_owner(ty_id: int, hir_item: int, method_id: int, param_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id)))
}

task v4_ty_impl_method_explicit_param_type_for_owner(ty_id: int, hir_item: int, method_id: int, param_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_explicit_param_type(ty_id, hir_item, method_id, param_id)))
}

task v4_ty_impl_method_return_type(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, v4_ty_impl_method_start_token(ty_id, hir_item, method_id), v4_ty_impl_method_end_token(ty_id, hir_item, method_id)))
}

task v4_ty_impl_method_return_type_for_owner(ty_id: int, hir_item: int, method_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_return_type(ty_id, hir_item, method_id)))
}

task v4_ty_impl_method_def(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
    pilot file_id = v4_hir_file_id(hir_id)
    give back "file" + word_from_int(file_id) + "::Method::" + owner_ty + "." + method_name + "#" + word_from_int(hir_item) + ":" + word_from_int(method_id)
}

task v4_ty_impl_method_display(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
    pilot return_ty = v4_ty_impl_method_return_type(ty_id, hir_item, method_id)
    give back "task " + owner_ty + "::" + method_name + "(...) -> " + return_ty
}

task v4_ty_doctrine_signature_id_for_name(ty_id: int, doctrine_name: word) -> int {
    pilot lookup_name = v4_ty_doctrine_lookup_type_from_surface_type(ty_id, doctrine_name)
    if lookup_name == "" {
        lookup_name = doctrine_name
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_doctrine_lookup_name_from_surface_name(ty_id: int, surface_name: word) -> word {
    if surface_name == "" or surface_name == v4_ty_unknown {
        give back ""
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == surface_name {
                give back surface_name
            }
        }
        sig_id += 1
    }

    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot expanded = v4_resolve_expand_import_name(resolve_id, surface_name)
        if expanded != "" and expanded != surface_name {
            sig_id = 0
            repeat until sig_id >= sig_count {
                if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_doctrine_sig {
                    if v4_ty_signature_name(ty_id, sig_id) == expanded {
                        give back expanded
                    }
                }
                sig_id += 1
            }
        }
    }
    give back ""
}

task v4_ty_doctrine_lookup_type_from_surface_type(ty_id: int, type_text: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot lookup_base = v4_ty_doctrine_lookup_name_from_surface_name(ty_id, base_name)
        if lookup_base != "" {
            give back lookup_base + v4_slice(type_text, base_name.length(), type_text.length())
        }
        give back ""
    }
    give back v4_ty_doctrine_lookup_name_from_surface_name(ty_id, type_text)
}

task v4_ty_doctrine_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_doctrine_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_doctrine_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_doctrine_method_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_doctrine_method_start_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token or method_id < 0 {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == method_id {
                give back idx
            }
            current += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_ty_doctrine_method_end_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_skip_item(stream_id, start_token, close_token)
}

task v4_ty_doctrine_method_name(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, v4_ty_skip_trivia(stream_id, start_token + 1))
}

task v4_ty_doctrine_method_name_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_skip_trivia(stream_id, start_token + 1)
}

task v4_ty_doctrine_method_param_open_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_doctrine_method_generic_open_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot name_token = v4_ty_doctrine_method_name_token(ty_id, sig_id, method_id)
    pilot param_open = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    if stream_id < 0 or name_token < 0 or param_open <= name_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, param_open, "<")
}

task v4_ty_doctrine_method_generic_close_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_generic_open_token(ty_id, sig_id, method_id)
    pilot param_open = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or param_open <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_angle(stream_id, open_token, param_open)
}

task v4_ty_doctrine_method_generic_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0
    }
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_doctrine_method_generic_open_token(ty_id, sig_id, method_id), v4_ty_doctrine_method_generic_close_token(ty_id, sig_id, method_id))
}

task v4_ty_doctrine_method_param_close_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or end_token <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, end_token)
}

task v4_ty_doctrine_method_param_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0
    }
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id), v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id))
}

task v4_ty_doctrine_method_param_name(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back ""
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_param_mode(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back v4_ty_param_mode_value
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_mode_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_param_surface_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back v4_ty_unknown
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    if v4_ty_param_name_from_tokens(stream_id, start_token, end_token) == "self" {
        give back "Self"
    }
    give back v4_ty_param_type_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_param_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    give back v4_ty_canonical_type_in_signature(ty_id, sig_id, v4_ty_doctrine_method_param_surface_type(ty_id, sig_id, method_id, param_id))
}

task v4_ty_doctrine_method_param_type_span(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back V4_NO_SPAN
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_type_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_is_instance(ty_id: int, sig_id: int, method_id: int) -> bool {
    if v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id) <= 0 {
        give back false
    }
    give back v4_ty_doctrine_method_param_name(ty_id, sig_id, method_id, 0) == "self"
}

task v4_ty_doctrine_method_explicit_param_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot count = v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id)
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) and count > 0 {
        give back count - 1
    }
    give back count
}

task v4_ty_doctrine_method_explicit_param_name(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        shift = 1
    }
    give back v4_ty_doctrine_method_param_name(ty_id, sig_id, method_id, param_id + shift)
}

task v4_ty_doctrine_method_explicit_param_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        shift = 1
    }
    give back v4_ty_doctrine_method_param_type(ty_id, sig_id, method_id, param_id + shift)
}

task v4_ty_doctrine_method_explicit_param_surface_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        shift = 1
    }
    give back v4_ty_doctrine_method_param_surface_type(ty_id, sig_id, method_id, param_id + shift)
}

task v4_ty_doctrine_method_return_surface_type(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_return_type(ty_id: int, sig_id: int, method_id: int) -> word {
    give back v4_ty_canonical_type_in_signature(ty_id, sig_id, v4_ty_doctrine_method_return_surface_type(ty_id, sig_id, method_id))
}

task v4_ty_doctrine_method_return_span(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    give back v4_ty_task_return_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_apply_self_type(type_text: word, self_ty: word) -> word {
    pilot env = v4_ty_generic_env_bind("", "Self", self_ty)
    if env == v4_ty_generic_env_fail {
        give back type_text
    }
    give back v4_ty_apply_generic_env(type_text, env)
}

task v4_ty_apply_self_and_doctrine_instance(ty_id: int, sig_id: int, type_text: word, self_ty: word, doctrine_instance: word) -> word {
    pilot applied = v4_ty_apply_self_type(type_text, self_ty)
    if doctrine_instance != "" and doctrine_instance != v4_ty_unknown {
        pilot doctrine_env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, doctrine_instance)
        if doctrine_env != "" and doctrine_env != v4_ty_generic_env_fail {
            applied = v4_ty_apply_generic_env(applied, doctrine_env)
        }
    }
    give back applied
}

task v4_ty_apply_self_and_doctrine_type_args(ty_id: int, sig_id: int, type_text: word, self_ty: word) -> word {
    pilot doctrine_instance = ""
    pilot dyn_self_ty = self_ty
    if v4_ty_is_lend_type(dyn_self_ty) {
        dyn_self_ty = v4_ty_lend_target_type(dyn_self_ty)
    }
    if v4_ty_is_dyn_type(dyn_self_ty) {
        doctrine_instance = v4_ty_dyn_doctrine_name(dyn_self_ty)
    }
    give back v4_ty_apply_self_and_doctrine_instance(ty_id, sig_id, type_text, self_ty, doctrine_instance)
}

task v4_ty_doctrine_method_explicit_param_type_for_self(ty_id: int, sig_id: int, method_id: int, param_id: int, self_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_and_doctrine_type_args(ty_id, sig_id, v4_ty_doctrine_method_explicit_param_surface_type(ty_id, sig_id, method_id, param_id), self_ty))
}

task v4_ty_doctrine_method_return_type_for_self(ty_id: int, sig_id: int, method_id: int, self_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_and_doctrine_type_args(ty_id, sig_id, v4_ty_doctrine_method_return_surface_type(ty_id, sig_id, method_id), self_ty))
}

task v4_ty_doctrine_method_explicit_param_type_for_bound(ty_id: int, sig_id: int, method_id: int, param_id: int, self_ty: word, doctrine_instance: word) -> word {
    pilot surface_ty = v4_ty_doctrine_method_explicit_param_surface_type(ty_id, sig_id, method_id, param_id)
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_and_doctrine_instance(ty_id, sig_id, surface_ty, self_ty, doctrine_instance))
}

task v4_ty_doctrine_method_return_type_for_bound(ty_id: int, sig_id: int, method_id: int, self_ty: word, doctrine_instance: word) -> word {
    pilot surface_ty = v4_ty_doctrine_method_return_surface_type(ty_id, sig_id, method_id)
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_and_doctrine_instance(ty_id, sig_id, surface_ty, self_ty, doctrine_instance))
}

task v4_ty_type_mentions_self(type_text: word) -> bool {
    if type_text == "Self" {
        give back true
    }
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        pilot param_id = 0
        pilot param_count = v4_ty_function_type_param_count(type_text)
        repeat until param_id >= param_count {
            pilot param_ty = v4_ty_function_type_param_surface(type_text, param_id)
            if param_ty != "..." and v4_ty_type_mentions_self(param_ty) {
                give back true
            }
            param_id += 1
        }
        give back v4_ty_type_mentions_self(v4_ty_function_type_return_text(type_text))
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_dyn_doctrine_name(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_type_mentions_self(v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back true
            }
            slot_id += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_fixed_array_element_type(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        if v4_ty_generic_base_name(type_text) == "Self" {
            give back true
        }
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_id >= arg_count {
            if v4_ty_type_mentions_self(v4_ty_generic_arg(type_text, arg_id)) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_ty_doctrine_method_object_safety_issue(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot method_name = v4_ty_doctrine_method_name(ty_id, sig_id, method_id)
    if not v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        give back "method " + method_name + " has no receiver"
    }
    if v4_ty_doctrine_method_generic_count(ty_id, sig_id, method_id) > 0 {
        give back "method " + method_name + " has generic parameters"
    }

    pilot explicit_id = 0
    pilot explicit_count = v4_ty_doctrine_method_explicit_param_count(ty_id, sig_id, method_id)
    repeat until explicit_id >= explicit_count {
        pilot param_ty = v4_ty_doctrine_method_explicit_param_type(ty_id, sig_id, method_id, explicit_id)
        if v4_ty_type_mentions_self(param_ty) {
            pilot param_name = v4_ty_doctrine_method_explicit_param_name(ty_id, sig_id, method_id, explicit_id)
            if param_name == "" {
                param_name = word_from_int(explicit_id + 1)
            }
            give back "method " + method_name + " parameter " + param_name + " mentions Self"
        }
        explicit_id += 1
    }

    if v4_ty_type_mentions_self(v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id)) {
        give back "method " + method_name + " return mentions Self"
    }
    give back ""
}

task v4_ty_dyn_object_safety_issue(ty_id: int, dyn_ty: word) -> word {
    if not v4_ty_is_dyn_type(dyn_ty) {
        give back ""
    }
    pilot doctrine_name = v4_ty_dyn_doctrine_base_name(dyn_ty)
    if doctrine_name == "" {
        give back "dyn doctrine is malformed"
    }
    pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
    if doctrine_sig < 0 {
        give back "dyn " + doctrine_name + " needs a declared doctrine"
    }

    pilot method_id = 0
    pilot method_count = v4_ty_doctrine_method_count(ty_id, doctrine_sig)
    repeat until method_id >= method_count {
        pilot issue = v4_ty_doctrine_method_object_safety_issue(ty_id, doctrine_sig, method_id)
        if issue != "" {
            give back doctrine_name + "::" + issue
        }
        method_id += 1
    }
    give back ""
}

task v4_ty_dyn_type_is_object_safe(ty_id: int, dyn_ty: word) -> bool {
    give back v4_ty_dyn_object_safety_issue(ty_id, dyn_ty) == ""
}

task v4_ty_type_satisfies_doctrine(ty_id: int, actual_ty: word, doctrine_name: word) -> bool {
    give back v4_ty_match_type_satisfies_doctrine_env(ty_id, 0 - 1, actual_ty, doctrine_name, "") != v4_ty_generic_env_fail
}

task v4_ty_signature_type_satisfies_doctrine(ty_id: int, sig_id: int, actual_ty: word, doctrine_name: word) -> bool {
    give back v4_ty_match_type_satisfies_doctrine_env(ty_id, sig_id, actual_ty, doctrine_name, "") != v4_ty_generic_env_fail
}

task v4_ty_signature_type_satisfies_doctrine_env(ty_id: int, sig_id: int, actual_ty: word, doctrine_name: word, env: word) -> bool {
    give back v4_ty_match_type_satisfies_doctrine_env(ty_id, sig_id, actual_ty, doctrine_name, env) != v4_ty_generic_env_fail
}

task v4_ty_match_doctrine_ref_env(ty_id: int, sig_id: int, wanted_doctrine: word, candidate_doctrine: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    wanted_doctrine = v4_ty_doctrine_ref_resolve(ty_id, wanted_doctrine)
    candidate_doctrine = v4_ty_doctrine_ref_resolve(ty_id, candidate_doctrine)
    if v4_ty_doctrine_refs_match_canonical(ty_id, wanted_doctrine, candidate_doctrine) {
        give back env
    }
    if wanted_doctrine == "" or candidate_doctrine == "" {
        give back v4_ty_generic_env_fail
    }
    if v4_ty_is_generic_instance_type(wanted_doctrine) or v4_ty_is_generic_instance_type(candidate_doctrine) {
        if not v4_ty_is_generic_instance_type(wanted_doctrine) or not v4_ty_is_generic_instance_type(candidate_doctrine) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_base_name(wanted_doctrine) != v4_ty_generic_base_name(candidate_doctrine) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(wanted_doctrine) != v4_ty_generic_arg_count(candidate_doctrine) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(wanted_doctrine)
        repeat until arg_id >= arg_count {
            next_env = v4_ty_match_doctrine_generic_arg_env(ty_id, sig_id, v4_ty_generic_arg(wanted_doctrine, arg_id), v4_ty_generic_arg(candidate_doctrine, arg_id), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_id += 1
        }
        give back next_env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_match_doctrine_generic_arg_env(ty_id: int, sig_id: int, wanted_ty: word, candidate_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(wanted_ty) or not v4_ty_is_known(candidate_ty) {
        give back env
    }
    if sig_id >= 0 and v4_ty_signature_declares_type_generic_name(ty_id, sig_id, wanted_ty) {
        give back v4_ty_generic_env_bind(env, wanted_ty, v4_ty_canonical_or_self(ty_id, candidate_ty))
    }
    if sig_id >= 0 and (v4_ty_signature_declares_lifetime_name(ty_id, sig_id, wanted_ty) or v4_ty_signature_declares_lifetime_name(ty_id, sig_id, candidate_ty)) {
        if wanted_ty == candidate_ty {
            give back env
        }
        give back v4_ty_generic_env_fail
    }

    pilot wanted = v4_ty_canonical_or_self(ty_id, wanted_ty)
    pilot candidate = v4_ty_canonical_or_self(ty_id, candidate_ty)
    if wanted == candidate {
        give back env
    }
    if v4_ty_is_lend_type(wanted) or v4_ty_is_lend_type(candidate) {
        if not v4_ty_is_lend_type(wanted) or not v4_ty_is_lend_type(candidate) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_lend_mode(wanted) != v4_ty_lend_mode(candidate) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_doctrine_generic_arg_env(ty_id, sig_id, v4_ty_lend_target_type(wanted), v4_ty_lend_target_type(candidate), env)
    }
    if v4_ty_is_raw_pointer_type(wanted) or v4_ty_is_raw_pointer_type(candidate) {
        if not v4_ty_is_raw_pointer_type(wanted) or not v4_ty_is_raw_pointer_type(candidate) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_raw_pointer_prefix(wanted) != v4_ty_raw_pointer_prefix(candidate) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_doctrine_generic_arg_env(ty_id, sig_id, v4_ty_raw_pointer_target_type(wanted), v4_ty_raw_pointer_target_type(candidate), env)
    }
    if v4_ty_is_generic_instance_type(wanted) or v4_ty_is_generic_instance_type(candidate) {
        if not v4_ty_is_generic_instance_type(wanted) or not v4_ty_is_generic_instance_type(candidate) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_base_name(wanted) != v4_ty_generic_base_name(candidate) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(wanted) != v4_ty_generic_arg_count(candidate) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(wanted)
        repeat until arg_idx >= arg_count {
            next_env = v4_ty_match_doctrine_generic_arg_env(ty_id, sig_id, v4_ty_generic_arg(wanted, arg_idx), v4_ty_generic_arg(candidate, arg_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(wanted) or v4_ty_is_tuple_type(candidate) {
        if not v4_ty_is_tuple_type(wanted) or not v4_ty_is_tuple_type(candidate) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_tuple_slot_count(wanted) != v4_ty_tuple_slot_count(candidate) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(wanted)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_doctrine_generic_arg_env(ty_id, sig_id, v4_ty_tuple_slot_type(wanted, slot_idx), v4_ty_tuple_slot_type(candidate, slot_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(wanted) or v4_ty_is_fixed_array_type(candidate) {
        if not v4_ty_is_fixed_array_type(wanted) or not v4_ty_is_fixed_array_type(candidate) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_fixed_array_length_normalized_text(ty_id, wanted) != v4_ty_fixed_array_length_normalized_text(ty_id, candidate) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_doctrine_generic_arg_env(ty_id, sig_id, v4_ty_fixed_array_element_type(wanted), v4_ty_fixed_array_element_type(candidate), env)
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_copy_doctrine_cache_lookup(ty_id: int, sig_id: int, actual_ty: word) -> word {
    v4_ty_init()
    pilot row = 0
    repeat until row >= v4_ty_copy_doctrine_cache_entry_count_value {
        pilot cached_type: word = array_get(v4_ty_copy_doctrine_cache_types, row)
        if word_to_int(array_get(v4_ty_copy_doctrine_cache_ty_ids, row)) == ty_id and word_to_int(array_get(v4_ty_copy_doctrine_cache_sig_ids, row)) == sig_id and cached_type == actual_ty {
            pilot cached_value: word = array_get(v4_ty_copy_doctrine_cache_values, row)
            give back cached_value
        }
        row += 1
    }
    give back ""
}

task v4_ty_copy_doctrine_cache_store(ty_id: int, sig_id: int, actual_ty: word, match_result: word) -> void {
    v4_ty_init()
    pilot encoded = match_result
    if encoded == "" { encoded = "#ok" }
    pilot row = v4_ty_copy_doctrine_cache_entry_count_value
    if row >= v4_ty_copy_doctrine_cache_capacity_value {
        row = v4_ty_copy_doctrine_cache_next_row_value
        v4_ty_copy_doctrine_cache_next_row_value += 1
        if v4_ty_copy_doctrine_cache_next_row_value >= v4_ty_copy_doctrine_cache_capacity_value {
            v4_ty_copy_doctrine_cache_next_row_value = 0
        }
    } else {
        v4_ty_copy_doctrine_cache_entry_count_value += 1
    }
    if row < array_len(v4_ty_copy_doctrine_cache_types) {
        array_set(v4_ty_copy_doctrine_cache_ty_ids, row, word_from_int(ty_id))
        array_set(v4_ty_copy_doctrine_cache_sig_ids, row, word_from_int(sig_id))
        array_set(v4_ty_copy_doctrine_cache_types, row, actual_ty)
        array_set(v4_ty_copy_doctrine_cache_values, row, encoded)
    } else {
        array_push(v4_ty_copy_doctrine_cache_ty_ids, word_from_int(ty_id))
        array_push(v4_ty_copy_doctrine_cache_sig_ids, word_from_int(sig_id))
        array_push(v4_ty_copy_doctrine_cache_types, actual_ty)
        array_push(v4_ty_copy_doctrine_cache_values, encoded)
    }
}

task v4_ty_copy_doctrine_cache_reset() -> void {
    v4_ty_init()
    v4_ty_copy_doctrine_cache_entry_count_value = 0
    v4_ty_copy_doctrine_cache_next_row_value = 0
}

task v4_ty_copy_doctrine_cache_count() -> int {
    give back v4_ty_copy_doctrine_cache_entry_count_value
}

task v4_ty_copy_doctrine_cache_capacity() -> int {
    give back v4_ty_copy_doctrine_cache_capacity_value
}

task v4_ty_copy_impl_storage_is_eligible(ty_id: int, sig_id: int, type_text: word, seen_types: word, depth: int) -> bool {
    if depth > v4_ty_lend_storage_depth_limit or not v4_ty_is_known(type_text) {
        give back false
    }
    if v4_ty_type_is_structurally_copy(ty_id, type_text, depth) {
        give back true
    }

    pilot storage_type = v4_ty_type_recursion_expand_import_type(ty_id, type_text)
    if storage_type == "" or storage_type == v4_ty_unknown {
        storage_type = type_text
    }

    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, storage_type)
    if shape_sig >= 0 {
        pilot shape_key = "copy-impl-shape:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, shape_key) { give back false }
        pilot shape_seen = v4_ty_alias_cycle_seen_append(seen_types, shape_key)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            pilot field_type = v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id)
            field_type = v4_ty_apply_signature_generics(ty_id, shape_sig, storage_type, field_type)
            if not v4_ty_type_is_doctrinal_copy_eligible(ty_id, sig_id, field_type, shape_seen, depth + 1) {
                give back false
            }
            field_id += 1
        }
        give back true
    }

    pilot route_sig = v4_ty_route_signature_id_for_name(ty_id, storage_type)
    if route_sig >= 0 {
        pilot route_key = "copy-impl-route:" + storage_type
        if v4_ty_alias_cycle_seen_contains(seen_types, route_key) { give back false }
        pilot route_seen = v4_ty_alias_cycle_seen_append(seen_types, route_key)
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, route_sig)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, route_sig, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, storage_type, case_name)
            repeat until field_id >= field_count {
                pilot field_type = v4_ty_route_case_field_surface_type(ty_id, storage_type, case_name, field_id)
                field_type = v4_ty_apply_signature_generics(ty_id, route_sig, storage_type, field_type)
                if not v4_ty_type_is_doctrinal_copy_eligible(ty_id, sig_id, field_type, route_seen, depth + 1) {
                    give back false
                }
                field_id += 1
            }
            case_id += 1
        }
        give back true
    }
    give back false
}

task v4_ty_match_type_satisfies_doctrine_env_uncached(ty_id: int, sig_id: int, actual_ty: word, doctrine_name: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(actual_ty) or doctrine_name == "" {
        give back env
    }

    pilot wanted_doctrine = doctrine_name
    pilot wanted_lookup = v4_ty_doctrine_lookup_base_name(wanted_doctrine)
    if v4_ty_doctrine_signature_id_for_name(ty_id, wanted_lookup) < 0 {
        give back v4_ty_generic_env_fail
    }

    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id >= 0 {
        pilot hir_item = 0
        pilot hir_count = v4_hir_item_count(hir_id)
        repeat until hir_item >= hir_count {
            if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
                if v4_ty_impl_target_alias_name_from_hir(ty_id, hir_item) == "" {
                    if v4_ty_impl_matches_owner(ty_id, hir_item, actual_ty) {
                        pilot impl_doctrine = v4_ty_apply_impl_generics(ty_id, hir_item, actual_ty, v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item))
                        pilot next_env = v4_ty_match_doctrine_ref_env(ty_id, sig_id, wanted_doctrine, impl_doctrine, env)
                        if next_env != v4_ty_generic_env_fail {
                            if wanted_lookup != "Copy" or v4_ty_copy_impl_storage_is_eligible(ty_id, sig_id, actual_ty, "", 0) {
                                give back next_env
                            }
                        }
                    }
                }
            }
            hir_item += 1
        }
    }

    if sig_id < 0 or actual_ty == "" {
        give back v4_ty_generic_env_fail
    }
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, sig_id, actual_ty)
    if generic_id < 0 or v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
        give back v4_ty_generic_env_fail
    }
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        pilot bound_name = v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx)
        pilot next_env = v4_ty_match_doctrine_ref_env(ty_id, sig_id, wanted_doctrine, bound_name, env)
        if next_env != v4_ty_generic_env_fail {
            give back next_env
        }
        bound_idx += 1
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_match_type_satisfies_doctrine_env(ty_id: int, sig_id: int, actual_ty: word, doctrine_name: word, env: word) -> word {
    pilot cacheable: bool = env == "" and doctrine_name == "Copy" and v4_ty_is_known(actual_ty)
    pilot cache_sig_id = sig_id
    if cacheable and not v4_ty_type_mentions_signature_generics(ty_id, sig_id, actual_ty) {
        cache_sig_id = 0 - 1
    }
    if cacheable {
        pilot cached = v4_ty_copy_doctrine_cache_lookup(ty_id, cache_sig_id, actual_ty)
        if cached != "" {
            if cached == "#ok" { give back "" }
            give back cached
        }
    }
    pilot match_result = v4_ty_match_type_satisfies_doctrine_env_uncached(ty_id, sig_id, actual_ty, doctrine_name, env)
    if cacheable {
        v4_ty_copy_doctrine_cache_store(ty_id, cache_sig_id, actual_ty, match_result)
    }
    give back match_result
}

task v4_ty_match_type_can_coerce_to_dyn_env(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_dyn_type(expected_ty) {
        give back v4_ty_generic_env_fail
    }
    if not v4_ty_dyn_type_is_object_safe(ty_id, expected_ty) {
        give back v4_ty_generic_env_fail
    }
    if v4_ty_is_dyn_type(actual_ty) {
        give back v4_ty_match_doctrine_ref_env(ty_id, sig_id, v4_ty_dyn_doctrine_name(expected_ty), v4_ty_dyn_doctrine_name(actual_ty), env)
    }
    give back v4_ty_match_type_satisfies_doctrine_env(ty_id, sig_id, actual_ty, v4_ty_dyn_doctrine_lookup_name(expected_ty), env)
}

task v4_ty_match_type_satisfies_doctrine_env_with_bounds(ty_id: int, doctrine_sig_id: int, actual_bound_sig_id: int, actual_ty: word, doctrine_name: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(actual_ty) or doctrine_name == "" {
        give back env
    }

    pilot wanted_doctrine = doctrine_name
    pilot wanted_lookup = v4_ty_doctrine_lookup_base_name(wanted_doctrine)
    if v4_ty_doctrine_signature_id_for_name(ty_id, wanted_lookup) < 0 {
        give back v4_ty_generic_env_fail
    }

    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id >= 0 {
        pilot hir_item = 0
        pilot hir_count = v4_hir_item_count(hir_id)
        repeat until hir_item >= hir_count {
            if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
                if v4_ty_impl_target_alias_name_from_hir(ty_id, hir_item) == "" {
                    if v4_ty_impl_matches_owner(ty_id, hir_item, actual_ty) {
                        pilot impl_doctrine = v4_ty_apply_impl_generics(ty_id, hir_item, actual_ty, v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item))
                        pilot next_env = v4_ty_match_doctrine_ref_env(ty_id, doctrine_sig_id, wanted_doctrine, impl_doctrine, env)
                        if next_env != v4_ty_generic_env_fail {
                            if wanted_lookup != "Copy" or v4_ty_copy_impl_storage_is_eligible(ty_id, doctrine_sig_id, actual_ty, "", 0) {
                                give back next_env
                            }
                        }
                    }
                }
            }
            hir_item += 1
        }
    }

    if actual_bound_sig_id < 0 or actual_ty == "" {
        give back v4_ty_generic_env_fail
    }
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, actual_bound_sig_id, actual_ty)
    if generic_id < 0 or v4_ty_signature_generic_is_lifetime(ty_id, actual_bound_sig_id, generic_id) {
        give back v4_ty_generic_env_fail
    }
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, actual_bound_sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        pilot bound_name = v4_ty_signature_generic_bound_name(ty_id, actual_bound_sig_id, generic_id, bound_idx)
        pilot next_env = v4_ty_match_doctrine_ref_env(ty_id, doctrine_sig_id, wanted_doctrine, bound_name, env)
        if next_env != v4_ty_generic_env_fail {
            give back next_env
        }
        bound_idx += 1
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_match_type_can_coerce_to_dyn_env_with_bounds(ty_id: int, doctrine_sig_id: int, actual_bound_sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_dyn_type(expected_ty) {
        give back v4_ty_generic_env_fail
    }
    if not v4_ty_dyn_type_is_object_safe(ty_id, expected_ty) {
        give back v4_ty_generic_env_fail
    }
    if v4_ty_is_dyn_type(actual_ty) {
        give back v4_ty_match_doctrine_ref_env(ty_id, doctrine_sig_id, v4_ty_dyn_doctrine_name(expected_ty), v4_ty_dyn_doctrine_name(actual_ty), env)
    }
    give back v4_ty_match_type_satisfies_doctrine_env_with_bounds(ty_id, doctrine_sig_id, actual_bound_sig_id, actual_ty, v4_ty_dyn_doctrine_lookup_name(expected_ty), env)
}

task v4_ty_match_signature_type_env_between_signatures_mode(ty_id: int, doctrine_sig_id: int, actual_bound_sig_id: int, expected_ty: word, actual_ty: word, env: word, allow_dyn_coerce: bool) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back env
    }
    if expected_ty == actual_ty {
        give back env
    }
    if doctrine_sig_id >= 0 {
        if v4_ty_signature_declares_lifetime_name(ty_id, doctrine_sig_id, expected_ty) {
            give back env
        }
        if v4_ty_signature_declares_type_generic_name(ty_id, doctrine_sig_id, expected_ty) {
            give back v4_ty_generic_env_bind(env, expected_ty, actual_ty)
        }
    }
    if v4_ty_is_lend_type(expected_ty) or v4_ty_is_lend_type(actual_ty) {
        if not v4_ty_is_lend_type(expected_ty) or not v4_ty_is_lend_type(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_lend_mode(expected_ty) != v4_ty_lend_mode(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env_between_signatures_mode(ty_id, doctrine_sig_id, actual_bound_sig_id, v4_ty_lend_target_type(expected_ty), v4_ty_lend_target_type(actual_ty), env, allow_dyn_coerce)
    }
    if v4_ty_is_dyn_type(expected_ty) {
        if allow_dyn_coerce or v4_ty_is_dyn_type(actual_ty) {
            give back v4_ty_match_type_can_coerce_to_dyn_env_with_bounds(ty_id, doctrine_sig_id, actual_bound_sig_id, expected_ty, actual_ty, env)
        }
        give back v4_ty_generic_env_fail
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_raw_pointer_type(expected_ty) and v4_ty_is_raw_pointer_type(actual_ty) {
        if v4_ty_raw_pointer_prefix(expected_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env_between_signatures_mode(ty_id, doctrine_sig_id, actual_bound_sig_id, v4_ty_raw_pointer_target_type(expected_ty), v4_ty_raw_pointer_target_type(actual_ty), env, false)
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        pilot base_name = v4_ty_generic_base_name(expected_ty)
        repeat until arg_idx >= arg_count {
            pilot expected_arg = v4_ty_generic_arg(expected_ty, arg_idx)
            pilot actual_arg = v4_ty_generic_arg(actual_ty, arg_idx)
            if v4_ty_is_dyn_type(expected_arg) and not v4_ty_is_dyn_type(actual_arg) {
                if allow_dyn_coerce and v4_ty_is_nominal_prelude_dyn_carrier(ty_id, expected_ty) {
                    next_env = v4_ty_match_signature_type_env_between_signatures_mode(ty_id, doctrine_sig_id, actual_bound_sig_id, expected_arg, actual_arg, next_env, true)
                } else {
                    give back v4_ty_generic_env_fail
                }
            } else {
                next_env = v4_ty_match_signature_type_env_between_signatures_mode(ty_id, doctrine_sig_id, actual_bound_sig_id, expected_arg, actual_arg, next_env, false)
            }
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(expected_ty) and v4_ty_is_tuple_type(actual_ty) {
        if v4_ty_tuple_slot_count(expected_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(expected_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_signature_type_env_between_signatures_mode(ty_id, doctrine_sig_id, actual_bound_sig_id, v4_ty_tuple_slot_type(expected_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env, false)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(expected_ty) and v4_ty_is_fixed_array_type(actual_ty) {
        if v4_ty_fixed_array_length_normalized_text(ty_id, expected_ty) != v4_ty_fixed_array_length_normalized_text(ty_id, actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env_between_signatures_mode(ty_id, doctrine_sig_id, actual_bound_sig_id, v4_ty_fixed_array_element_type(expected_ty), v4_ty_fixed_array_element_type(actual_ty), env, false)
    }
    if v4_ty_types_compatible(expected_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_match_type_can_coerce_to_dyn_between_signatures_env(ty_id: int, primary_sig_id: int, fallback_sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_type_contains_dyn(expected_ty) {
        give back v4_ty_generic_env_fail
    }
    pilot next_env = v4_ty_match_signature_type_env(ty_id, primary_sig_id, expected_ty, actual_ty, env)
    if next_env != v4_ty_generic_env_fail {
        give back next_env
    }
    if fallback_sig_id >= 0 and fallback_sig_id != primary_sig_id {
        give back v4_ty_match_signature_type_env_between_signatures_mode(ty_id, primary_sig_id, fallback_sig_id, expected_ty, actual_ty, env, true)
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_type_can_coerce_to_dyn_in_signature(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    if not v4_ty_type_contains_dyn(expected_ty) {
        give back false
    }
    give back v4_ty_match_signature_type_env(ty_id, sig_id, expected_ty, actual_ty, "") != v4_ty_generic_env_fail
}

task v4_ty_type_can_coerce_to_dyn_between_signatures(ty_id: int, primary_sig_id: int, fallback_sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    give back v4_ty_match_type_can_coerce_to_dyn_between_signatures_env(ty_id, primary_sig_id, fallback_sig_id, expected_ty, actual_ty, "") != v4_ty_generic_env_fail
}

task v4_ty_types_compatible_with_context(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    give back v4_ty_types_compatible_in_signature(ty_id, sig_id, expected_ty, actual_ty)
}

task v4_ty_display_for_hir_item(symbol_kind: word, symbol_name: word, symbol_def: word, hir_id: int, hir_item: int) -> word {
    pilot generic_text = v4_ty_hir_item_generic_text(hir_id, hir_item)
    if symbol_kind == v4_hir_task {
        if v4_resolve_is_extern_member_def(symbol_def) {
            pilot tree_id = v4_hir_tree_id(hir_id)
            pilot stream_id = v4_parse_stream_id(tree_id)
            pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
            pilot member_id = v4_resolve_extern_member_id_from_def(symbol_def)
            pilot member_start = v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
            pilot member_end = v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
            give back "task " + symbol_name + "(...) -> " + v4_ty_task_return_from_tokens(stream_id, member_start, member_end)
        }
        give back "task " + symbol_name + generic_text + "(...) -> " + v4_ty_task_return_from_hir(hir_id, hir_item)
    }
    if symbol_kind == v4_hir_const {
        pilot const_ty = v4_hir_const_type(hir_id, hir_item)
        if const_ty != "" {
            give back "fixed pilot " + symbol_name + ": " + const_ty
        }
        give back "fixed pilot " + symbol_name
    }
    if symbol_kind == v4_hir_shape {
        give back "shape " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_route {
        give back v4_ty_route_surface_keyword(hir_id, hir_item) + " " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_alias {
        pilot alias_target = v4_hir_alias_target(hir_id, hir_item)
        if alias_target != "" {
            give back "alias " + symbol_name + " = " + alias_target
        }
        give back "alias " + symbol_name
    }
    if symbol_kind == v4_hir_doctrine {
        give back "doctrine " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_extern {
        pilot extern_spec = v4_ty_trim_spaces(v4_hir_extern_abi(hir_id, hir_item))
        if extern_spec != "" {
            give back "extern [" + extern_spec + "]"
        }
        give back "extern"
    }
    if symbol_kind == v4_hir_import {
        pilot import_path = v4_hir_import_path(hir_id, hir_item)
        pilot import_alias = v4_hir_import_alias(hir_id, hir_item)
        if import_path != "" {
            if import_alias != "" {
                give back "use " + import_path + " as " + import_alias
            }
            give back "use " + import_path
        }
    }
    if symbol_kind == v4_hir_attribute {
        pilot attr_arg = v4_hir_attribute_arg(hir_id, hir_item)
        if attr_arg != "" {
            give back "@" + symbol_name + "(" + attr_arg + ")"
        }
        give back "@" + symbol_name
    }
    give back v4_ty_display_for_symbol(symbol_kind, symbol_name)
}

task v4_ty_signature_return_type(ty_id: int, sig_id: int) -> word {
    give back v4_ty_canonical_type_in_signature(ty_id, sig_id, v4_ty_signature_return_surface_type(ty_id, sig_id))
}

task v4_ty_signature_return_lend_leaf_count(ty_id: int, sig_id: int) -> int {
    if not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back 0 - 1
    }
    pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
    if v4_ty_is_lend_type(return_ty) {
        give back 1
    }

    give back v4_ty_fixed_lend_leaf_count(ty_id, return_ty)
}

task v4_ty_signature_return_lend_leaf_type_at(ty_id: int, sig_id: int, leaf_id: int) -> word {
    if leaf_id < 0 or not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back v4_ty_unknown
    }
    pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
    if v4_ty_is_lend_type(return_ty) {
        if leaf_id == 0 { give back return_ty }
        give back v4_ty_unknown
    }

    give back v4_ty_fixed_lend_leaf_type_at(ty_id, return_ty, leaf_id)
}

task v4_ty_signature_return_lend_leaf_projection_at(ty_id: int, sig_id: int, leaf_id: int) -> word {
    if leaf_id < 0 or not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back ""
    }
    pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
    if v4_ty_is_lend_type(return_ty) {
        give back ""
    }
    give back v4_ty_fixed_lend_leaf_projection_at(ty_id, return_ty, leaf_id)
}

task v4_ty_signature_return_lend_leaf_route_guard_at(ty_id: int, sig_id: int, leaf_id: int) -> word {
    if leaf_id < 0 or not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back ""
    }
    pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
    if v4_ty_is_lend_type(return_ty) {
        give back ""
    }
    give back v4_ty_fixed_lend_leaf_route_guard_at(ty_id, return_ty, leaf_id)
}

task v4_ty_signature_param_lend_leaf_count(ty_id: int, sig_id: int, param_id: int) -> int {
    if param_id < 0 or param_id >= v4_ty_signature_param_count(ty_id, sig_id) {
        give back 0 - 1
    }
    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        give back 1
    }
    give back v4_ty_fixed_lend_leaf_count(ty_id, v4_ty_signature_param_type(ty_id, sig_id, param_id))
}

task v4_ty_signature_param_lend_leaf_type_at(ty_id: int, sig_id: int, param_id: int, leaf_id: int) -> word {
    if leaf_id < 0 or param_id < 0 or param_id >= v4_ty_signature_param_count(ty_id, sig_id) {
        give back v4_ty_unknown
    }
    pilot param_type = v4_ty_signature_param_type(ty_id, sig_id, param_id)
    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        if leaf_id == 0 {
            give back v4_ty_lend_type_with_lifetime(param_type, param_mode, v4_ty_signature_param_lifetime(ty_id, sig_id, param_id))
        }
        give back v4_ty_unknown
    }
    give back v4_ty_fixed_lend_leaf_type_at(ty_id, param_type, leaf_id)
}

task v4_ty_signature_param_lend_leaf_projection_at(ty_id: int, sig_id: int, param_id: int, leaf_id: int) -> word {
    if leaf_id < 0 or param_id < 0 or param_id >= v4_ty_signature_param_count(ty_id, sig_id) {
        give back ""
    }
    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        give back ""
    }
    give back v4_ty_fixed_lend_leaf_projection_at(ty_id, v4_ty_signature_param_type(ty_id, sig_id, param_id), leaf_id)
}

task v4_ty_signature_param_lend_leaf_route_guard_at(ty_id: int, sig_id: int, param_id: int, leaf_id: int) -> word {
    if leaf_id < 0 or param_id < 0 or param_id >= v4_ty_signature_param_count(ty_id, sig_id) {
        give back ""
    }
    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        give back ""
    }
    give back v4_ty_fixed_lend_leaf_route_guard_at(ty_id, v4_ty_signature_param_type(ty_id, sig_id, param_id), leaf_id)
}

task v4_ty_signature_lend_leaf_contract_matches(ty_id: int, sig_id: int, source_type: word, return_type: word, require_target_match: bool) -> bool {
    if not v4_ty_is_lend_type(source_type) or not v4_ty_is_lend_type(return_type) {
        give back false
    }
    if v4_ty_is_lend_mut_type(return_type) and not v4_ty_is_lend_mut_type(source_type) {
        give back false
    }
    if require_target_match and not v4_ty_types_same_in_signature(ty_id, sig_id, v4_ty_lend_target_type(return_type), v4_ty_lend_target_type(source_type)) {
        give back false
    }

    pilot return_lifetime = v4_ty_lend_lifetime(return_type)
    pilot source_lifetime = v4_ty_lend_lifetime(source_type)
    if return_lifetime == "'static" or source_lifetime == "'static" {
        give back false
    }
    if return_lifetime == "" or return_lifetime == "'_" {
        give back true
    }
    if source_lifetime == "" or source_lifetime == "'_" {
        give back false
    }
    give back v4_ty_signature_lifetime_outlives(ty_id, sig_id, source_lifetime, return_lifetime)
}

task v4_ty_return_lend_source_payload_append(payload: word, edge: word) -> word {
    if payload == "" { give back edge }
    give back payload + "\n" + edge
}

task v4_ty_return_lend_source_payload_append_bounded(payload: word, edge: word, relation_count: int) -> word {
    if payload == v4_ty_return_lend_source_opaque or relation_count < 0 or relation_count >= v4_ty_return_lend_source_limit {
        give back v4_ty_return_lend_source_opaque
    }
    give back v4_ty_return_lend_source_payload_append(payload, edge)
}

task v4_ty_return_lend_source_payload_count(payload: word) -> int {
    if payload == v4_ty_return_lend_source_opaque { give back 0 - 1 }
    if payload == "" { give back 0 }
    pilot count = 1
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "\n" { count += 1 }
        idx += 1
    }
    give back count
}

task v4_ty_return_lend_source_payload_at(payload: word, source_id: int) -> word {
    if payload == v4_ty_return_lend_source_opaque or payload == "" or source_id < 0 { give back "" }
    pilot current = 0
    pilot segment_start = 0
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "\n" {
            if current == source_id { give back v4_slice(payload, segment_start, idx) }
            current += 1
            segment_start = idx + 1
        }
        idx += 1
    }
    if current == source_id and segment_start < payload.length() {
        give back v4_slice(payload, segment_start, payload.length())
    }
    give back ""
}

task v4_ty_signature_return_lend_source_payload(ty_id: int, sig_id: int, return_leaf_id: int) -> word {
    if return_leaf_id < 0 or not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back v4_ty_return_lend_source_opaque
    }
    pilot return_type = v4_ty_signature_return_lend_leaf_type_at(ty_id, sig_id, return_leaf_id)
    if not v4_ty_is_lend_type(return_type) {
        give back v4_ty_return_lend_source_opaque
    }

    pilot payload = ""
    pilot relation_count = 0
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        pilot source_leaf_id = 0
        pilot source_leaf_count = v4_ty_signature_param_lend_leaf_count(ty_id, sig_id, param_id)
        if source_leaf_count < 0 {
            give back v4_ty_return_lend_source_opaque
        }
        repeat until source_leaf_id >= source_leaf_count {
            pilot source_type = v4_ty_signature_param_lend_leaf_type_at(ty_id, sig_id, param_id, source_leaf_id)
            pilot param_mode: word = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
            pilot source_is_outer_lend: bool = param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut
            pilot require_target_match: bool = not source_is_outer_lend
            if v4_ty_signature_lend_leaf_contract_matches(ty_id, sig_id, source_type, return_type, require_target_match) {
                pilot projection = v4_ty_signature_param_lend_leaf_projection_at(ty_id, sig_id, param_id, source_leaf_id)
                pilot guard = v4_ty_signature_param_lend_leaf_route_guard_at(ty_id, sig_id, param_id, source_leaf_id)
                payload = v4_ty_return_lend_source_payload_append_bounded(payload, word_from_int(param_id) + "|" + projection + "|" + guard, relation_count)
                if payload == v4_ty_return_lend_source_opaque { give back payload }
                relation_count += 1
            }
            source_leaf_id += 1
        }
        param_id += 1
    }
    give back payload
}

task v4_ty_signature_return_lend_source_edge_at(ty_id: int, sig_id: int, return_leaf_id: int, source_id: int) -> word {
    give back v4_ty_return_lend_source_payload_at(v4_ty_signature_return_lend_source_payload(ty_id, sig_id, return_leaf_id), source_id)
}

task v4_ty_signature_return_lend_source_count(ty_id: int, sig_id: int, return_leaf_id: int) -> int {
    give back v4_ty_return_lend_source_payload_count(v4_ty_signature_return_lend_source_payload(ty_id, sig_id, return_leaf_id))
}

task v4_ty_signature_return_lend_source_param_at(ty_id: int, sig_id: int, return_leaf_id: int, source_id: int) -> int {
    pilot edge = v4_ty_signature_return_lend_source_edge_at(ty_id, sig_id, return_leaf_id, source_id)
    if edge == "" { give back 0 - 1 }
    give back word_to_int(v4_resolve_snapshot_field_raw(edge, 0))
}

task v4_ty_signature_return_lend_source_projection_at(ty_id: int, sig_id: int, return_leaf_id: int, source_id: int) -> word {
    pilot edge = v4_ty_signature_return_lend_source_edge_at(ty_id, sig_id, return_leaf_id, source_id)
    if edge == "" { give back "" }
    give back v4_resolve_snapshot_field_raw(edge, 1)
}

task v4_ty_signature_return_lend_source_route_guard_at(ty_id: int, sig_id: int, return_leaf_id: int, source_id: int) -> word {
    pilot edge = v4_ty_signature_return_lend_source_edge_at(ty_id, sig_id, return_leaf_id, source_id)
    if edge == "" { give back "" }
    give back v4_resolve_snapshot_field_raw(edge, 2)
}

task v4_ty_signature_param_is_borrowed_return_source(ty_id: int, sig_id: int, param_id: int, return_ty: word) -> bool {
    if not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back false
    }
    if param_id < 0 or param_id >= v4_ty_signature_param_count(ty_id, sig_id) {
        give back false
    }

    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    pilot mode_matches: bool = param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut
    if v4_ty_is_lend_mut_type(return_ty) {
        mode_matches = param_mode == v4_ty_param_mode_lend_mut
    }
    if not mode_matches {
        give back false
    }

    pilot return_lifetime = v4_ty_lend_lifetime(return_ty)
    if return_lifetime == "" or return_lifetime == "'_" {
        give back true
    }
    if return_lifetime == "'static" {
        give back false
    }
    pilot param_lifetime = v4_ty_signature_param_lifetime(ty_id, sig_id, param_id)
    if param_lifetime == "" or param_lifetime == "'static" or param_lifetime == "'_" {
        give back false
    }
    give back v4_ty_signature_lifetime_outlives(ty_id, sig_id, param_lifetime, return_lifetime)
}

task v4_ty_borrowed_return_source_cache_capacity() -> int {
    v4_ty_init()
    give back v4_ty_borrowed_return_source_cache_capacity_value
}

task v4_ty_borrowed_return_source_cache_entry_count() -> int {
    v4_ty_init()
    give back v4_ty_borrowed_return_source_cache_entry_count_value
}

task v4_ty_borrowed_return_source_cache_lookup_row(ty_id: int, sig_id: int) -> int {
    v4_ty_init()
    if ty_id < 0 or sig_id < 0 {
        give back 0 - 1
    }
    pilot row = 0
    pilot row_count = array_len(v4_ty_borrowed_return_source_cache_ty_ids)
    repeat until row >= row_count {
        if word_to_int(array_get(v4_ty_borrowed_return_source_cache_ty_ids, row)) == ty_id {
            if word_to_int(array_get(v4_ty_borrowed_return_source_cache_sig_ids, row)) == sig_id {
                give back row
            }
        }
        row += 1
    }
    give back 0 - 1
}

task v4_ty_borrowed_return_source_cache_first_empty_row() -> int {
    pilot row = 0
    pilot row_count = array_len(v4_ty_borrowed_return_source_cache_ty_ids)
    repeat until row >= row_count {
        if word_to_int(array_get(v4_ty_borrowed_return_source_cache_ty_ids, row)) < 0 {
            give back row
        }
        row += 1
    }
    give back 0 - 1
}

task v4_ty_borrowed_return_source_cache_store(ty_id: int, sig_id: int, payload: word) -> int {
    pilot existing_row = v4_ty_borrowed_return_source_cache_lookup_row(ty_id, sig_id)
    if existing_row >= 0 {
        array_set(v4_ty_borrowed_return_source_cache_payloads, existing_row, payload)
        give back existing_row
    }

    pilot row = v4_ty_borrowed_return_source_cache_first_empty_row()
    pilot row_count = array_len(v4_ty_borrowed_return_source_cache_ty_ids)
    if row < 0 and row_count < v4_ty_borrowed_return_source_cache_capacity_value {
        row = row_count
        array_push(v4_ty_borrowed_return_source_cache_ty_ids, word_from_int(ty_id))
        array_push(v4_ty_borrowed_return_source_cache_sig_ids, word_from_int(sig_id))
        array_push(v4_ty_borrowed_return_source_cache_payloads, payload)
        v4_ty_borrowed_return_source_cache_entry_count_value += 1
    } else {
        if row < 0 {
            row = v4_ty_borrowed_return_source_cache_next_row_value
            if row < 0 or row >= row_count {
                row = 0
            }
        } else {
            v4_ty_borrowed_return_source_cache_entry_count_value += 1
        }
        array_set(v4_ty_borrowed_return_source_cache_ty_ids, row, word_from_int(ty_id))
        array_set(v4_ty_borrowed_return_source_cache_sig_ids, row, word_from_int(sig_id))
        array_set(v4_ty_borrowed_return_source_cache_payloads, row, payload)
    }

    v4_ty_borrowed_return_source_cache_next_row_value = row + 1
    if v4_ty_borrowed_return_source_cache_next_row_value >= v4_ty_borrowed_return_source_cache_capacity_value {
        v4_ty_borrowed_return_source_cache_next_row_value = 0
    }
    give back row
}

task v4_ty_borrowed_return_source_cache_invalidate_row(row: int) -> void {
    if row < 0 or row >= array_len(v4_ty_borrowed_return_source_cache_ty_ids) {
        give back
    }
    if word_to_int(array_get(v4_ty_borrowed_return_source_cache_ty_ids, row)) < 0 {
        give back
    }
    array_set(v4_ty_borrowed_return_source_cache_ty_ids, row, "-1")
    array_set(v4_ty_borrowed_return_source_cache_sig_ids, row, "-1")
    array_set(v4_ty_borrowed_return_source_cache_payloads, row, "")
    if v4_ty_borrowed_return_source_cache_entry_count_value > 0 {
        v4_ty_borrowed_return_source_cache_entry_count_value -= 1
    }
}

task v4_ty_borrowed_return_source_cache_invalidate_file(ty_id: int) -> void {
    pilot row = 0
    pilot row_count = array_len(v4_ty_borrowed_return_source_cache_ty_ids)
    repeat until row >= row_count {
        if word_to_int(array_get(v4_ty_borrowed_return_source_cache_ty_ids, row)) == ty_id {
            v4_ty_borrowed_return_source_cache_invalidate_row(row)
        }
        row += 1
    }
}

task v4_ty_borrowed_return_source_cache_invalidate_signature(ty_id: int, sig_id: int) -> void {
    v4_ty_borrowed_return_source_cache_invalidate_row(v4_ty_borrowed_return_source_cache_lookup_row(ty_id, sig_id))
}

task v4_ty_borrowed_return_source_payload_append(payload: word, param_id: int) -> word {
    if payload == "" {
        give back word_from_int(param_id)
    }
    give back payload + "," + word_from_int(param_id)
}

task v4_ty_borrowed_return_source_payload_count(payload: word) -> int {
    if payload == "" {
        give back 0
    }
    pilot count = 1
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            count += 1
        }
        idx += 1
    }
    give back count
}

task v4_ty_borrowed_return_source_payload_at(payload: word, source_id: int) -> int {
    if payload == "" or source_id < 0 {
        give back 0 - 1
    }
    pilot current = 0
    pilot segment_start = 0
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            if current == source_id {
                give back word_to_int(v4_slice(payload, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        }
        idx += 1
    }
    if current == source_id and segment_start < payload.length() {
        give back word_to_int(v4_slice(payload, segment_start, payload.length()))
    }
    give back 0 - 1
}

task v4_ty_signature_borrowed_return_source_cache(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot cached_row = v4_ty_borrowed_return_source_cache_lookup_row(ty_id, sig_id)
    if cached_row >= 0 {
        give back cached_row
    }

    pilot payload = ""
    if v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
        if v4_ty_is_lend_type(return_ty) {
            pilot param_id = 0
            pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
            repeat until param_id >= param_count {
                if v4_ty_signature_param_is_borrowed_return_source(ty_id, sig_id, param_id, return_ty) {
                    payload = v4_ty_borrowed_return_source_payload_append(payload, param_id)
                }
                param_id += 1
            }
        }
    }
    v4_ty_borrowed_return_source_cache_builds_value += 1
    give back v4_ty_borrowed_return_source_cache_store(ty_id, sig_id, payload)
}

task v4_ty_borrowed_return_source_cache_build_count() -> int {
    give back v4_ty_borrowed_return_source_cache_builds_value
}

task v4_ty_signature_borrowed_return_source_param_count(ty_id: int, sig_id: int) -> int {
    pilot row = v4_ty_signature_borrowed_return_source_cache(ty_id, sig_id)
    if row < 0 {
        give back 0
    }
    give back v4_ty_borrowed_return_source_payload_count(array_get(v4_ty_borrowed_return_source_cache_payloads, row))
}

task v4_ty_signature_borrowed_return_source_param_at(ty_id: int, sig_id: int, source_id: int) -> int {
    if source_id < 0 {
        give back 0 - 1
    }
    pilot row = v4_ty_signature_borrowed_return_source_cache(ty_id, sig_id)
    if row < 0 {
        give back 0 - 1
    }
    give back v4_ty_borrowed_return_source_payload_at(array_get(v4_ty_borrowed_return_source_cache_payloads, row), source_id)
}

-- Compatibility query: -1 means no source; -2 means the source set is ambiguous.
task v4_ty_signature_borrowed_return_source_param(ty_id: int, sig_id: int) -> int {
    pilot source_count = v4_ty_signature_borrowed_return_source_param_count(ty_id, sig_id)
    if source_count <= 0 {
        give back 0 - 1
    }
    if source_count > 1 {
        give back 0 - 2
    }
    give back v4_ty_signature_borrowed_return_source_param_at(ty_id, sig_id, 0)
}

task v4_ty_signature_return_surface_type(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_shape_signature_id_for_name(ty_id: int, shape_name: word) -> int {
    pilot lookup_name = shape_name
    pilot alias_lookup = v4_ty_alias_target_type(ty_id, lookup_name)
    if alias_lookup != "" and alias_lookup != v4_ty_unknown {
        lookup_name = v4_ty_canonical_type(ty_id, alias_lookup)
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_shape_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_signature_id_for_name(ty_id: int, route_name: word) -> int {
    pilot lookup_name = route_name
    pilot alias_lookup = v4_ty_alias_target_type(ty_id, lookup_name)
    if alias_lookup != "" and alias_lookup != v4_ty_unknown {
        lookup_name = v4_ty_canonical_type(ty_id, alias_lookup)
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_route_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_is_route_type(ty_id: int, route_name: word) -> bool {
    give back v4_ty_route_signature_id_for_name(ty_id, route_name) >= 0
}

task v4_ty_route_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_route_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_route_is_case_separator(val: word) -> bool {
    give back val == "," or val == ";" or val == "/"
}

task v4_ty_route_case_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_case = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_case = false
            }
        } else {
            if depth == 0 and v4_ty_route_is_case_separator(val) {
                in_case = false
            } else {
                if not in_case {
                    count += 1
                    in_case = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_route_case_segment_start(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == case_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and v4_ty_route_is_case_separator(val) {
                if segment_start >= 0 {
                    if current == case_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == case_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_route_case_segment_end(ty_id: int, sig_id: int, case_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and v4_ty_route_is_case_separator(val) {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_route_case_segment_span(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_route_case_name(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_route_case_discriminant_equals_token(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, end_token, "=")
}

task v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot eq_token = v4_ty_route_case_discriminant_equals_token(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or eq_token < 0 or end_token <= eq_token {
        give back ""
    }
    pilot value_token = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if value_token >= end_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, value_token, end_token)
}

task v4_ty_route_case_explicit_discriminant_span_by_sig(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot eq_token = v4_ty_route_case_discriminant_equals_token(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or eq_token < 0 or end_token <= eq_token {
        give back V4_NO_SPAN
    }
    pilot value_token = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if value_token >= end_token {
        give back v4_lex_token_span(stream_id, eq_token)
    }
    give back v4_ty_span_from_tokens(stream_id, value_token, end_token)
}

task v4_ty_route_case_id_for_name(ty_id: int, route_name: word, case_name: word) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        if v4_ty_route_case_name(ty_id, sig_id, case_id) == case_name {
            give back case_id
        }
        case_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_has_case(ty_id: int, route_name: word, case_name: word) -> bool {
    give back v4_ty_route_case_id_for_name(ty_id, route_name, case_name) >= 0
}

task v4_ty_route_case_explicit_discriminant_text(ty_id: int, route_name: word, case_name: word) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if sig_id < 0 or case_id < 0 {
        give back ""
    }
    give back v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
}

task v4_ty_route_case_discriminant_value_by_sig(ty_id: int, sig_id: int, case_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back ""
    }
    pilot current = 0
    pilot scan_id = 0
    repeat until scan_id > case_id {
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, scan_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown {
                give back ""
            }
            current = word_to_int(resolved)
        }
        if scan_id == case_id {
            give back word_from_int(current)
        }
        current += 1
        scan_id += 1
    }
    give back ""
}

task v4_ty_route_case_discriminant_value(ty_id: int, route_name: word, case_name: word) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if sig_id < 0 or case_id < 0 {
        give back ""
    }
    give back v4_ty_route_case_discriminant_value_by_sig(ty_id, sig_id, case_id)
}

task v4_ty_route_case_payload_open_token(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, end_token, "{")
}

task v4_ty_route_case_payload_close_token(ty_id: int, sig_id: int, case_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_route_case_segment_end(ty_id, sig_id, case_id))
}

task v4_ty_route_case_has_payload(ty_id: int, route_name: word, case_name: word) -> bool {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back false
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back false
    }
    give back v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id) >= 0
}

task v4_ty_route_case_field_count(ty_id: int, route_name: word, case_name: word) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_field = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_field = false
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                in_field = false
            } else {
                if not in_field {
                    count += 1
                    in_field = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_route_case_field_segment_start(ty_id: int, route_name: word, case_name: word, field_id: int) -> int {
    if field_id < 0 {
        give back 0 - 1
    }
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == field_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                if segment_start >= 0 {
                    if current == field_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == field_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_route_case_field_segment_end(ty_id: int, route_name: word, case_name: word, field_id: int) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and (val == "," or val == ";") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_route_case_field_name(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }

    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_route_case_field_surface_type(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    give back field_ty
}

task v4_ty_route_case_field_type(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot field_ty = v4_ty_route_case_field_surface_type(ty_id, route_name, case_name, field_id)
    if sig_id < 0 or field_ty == "" or field_ty == v4_ty_unknown {
        give back v4_ty_unknown
    }
    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = route_name
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_signature_generics(ty_id, sig_id, instance_name, field_ty))
}

task v4_ty_route_case_field_type_span(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_route_case_field_id_for_name(ty_id: int, route_name: word, case_name: word, field_name: word) -> int {
    pilot field_id = 0
    pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
    repeat until field_id >= field_count {
        if v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) == field_name {
            give back field_id
        }
        field_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_case_field_type_for_name(ty_id: int, route_name: word, case_name: word, field_name: word) -> word {
    pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_name, case_name, field_name)
    if field_id >= 0 {
        give back v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id)
    }
    give back v4_ty_unknown
}

task v4_ty_shape_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_shape_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_shape_field_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_field = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_field = false
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                in_field = false
            } else {
                if not in_field {
                    count += 1
                    in_field = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_shape_field_segment_start(ty_id: int, sig_id: int, field_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig or field_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == field_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                if segment_start >= 0 {
                    if current == field_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == field_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_shape_field_segment_end(ty_id: int, sig_id: int, field_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and (val == "," or val == ";") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_shape_field_name(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_shape_field_type(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, field_ty)
}

task v4_ty_shape_field_surface_type(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    give back field_ty
}

task v4_ty_shape_field_type_span(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_shape_field_id_for_name(ty_id: int, shape_name: word, field_name: word) -> int {
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        if v4_ty_shape_field_name(ty_id, sig_id, field_id) == field_name {
            give back field_id
        }
        field_id += 1
    }
    give back 0 - 1
}

task v4_ty_shape_field_type_for_name(ty_id: int, shape_name: word, field_name: word) -> word {
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot field_id = v4_ty_shape_field_id_for_name(ty_id, shape_name, field_name)
    if field_id >= 0 {
        pilot instance_name = v4_ty_canonical_type(ty_id, shape_name)
        if instance_name == "" or instance_name == v4_ty_unknown {
            instance_name = shape_name
        }
        give back v4_ty_apply_signature_generics(ty_id, sig_id, instance_name, v4_ty_shape_field_type(ty_id, sig_id, field_id))
    }
    give back v4_ty_unknown
}

task v4_ty_lifetime_is_implicit(lifetime_name: word) -> bool {
    give back lifetime_name == "'static" or lifetime_name == "'_"
}

task v4_ty_signature_accepts_lifetime(ty_id: int, sig_id: int, lifetime_name: word) -> bool {
    if v4_ty_lifetime_is_implicit(lifetime_name) {
        give back true
    }
    give back v4_ty_signature_declares_lifetime_name(ty_id, sig_id, lifetime_name)
}

task v4_ty_alias_target_span(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot eq_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, "=")
    if eq_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_validate_signature_generic_names(ty_id: int, sig_id: int) -> void {
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    pilot owner_name = v4_ty_signature_name(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
        pilot generic_span = v4_ty_signature_generic_segment_span(ty_id, sig_id, generic_id)
        if generic_name == "" {
            v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: empty generic slot on " + v4_ty_signature_name(ty_id, sig_id), "")
        }
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) and (generic_name == "'static" or generic_name == "'_") {
            v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: " + generic_name + " is reserved and cannot be declared on " + v4_ty_signature_name(ty_id, sig_id), "use a named lifetime such as 'a; 'static and '_ are compiler-owned")
        }
        if owner_name != "" and generic_name == owner_name and v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: generic " + generic_name + " shadows its owner " + owner_name + "; Yuuko needs one identity per timeline", "")
        }

        pilot previous_id = 0
        repeat until previous_id >= generic_id {
            if v4_ty_signature_generic_name(ty_id, sig_id, previous_id) == generic_name {
                v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: duplicate generic " + generic_name + " on " + v4_ty_signature_name(ty_id, sig_id) + "; every route through Alternative IV needs one owner", "")
            }
            previous_id += 1
        }
        generic_id += 1
    }
}

task v4_ty_signature_can_declare_generics(ty_id: int, sig_id: int) -> bool {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back false
    }
    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    -- Extern members lower as task signatures; extern block signatures carry ABI only.
    give back sig_kind == v4_ty_task_sig or sig_kind == v4_ty_shape_sig or sig_kind == v4_ty_route_sig or sig_kind == v4_ty_doctrine_sig or sig_kind == v4_ty_alias_sig
}

task v4_ty_validate_signature_generic_bounds(ty_id: int, sig_id: int) -> void {
    if not v4_ty_signature_can_declare_generics(ty_id, sig_id) {
        give back
    }

    pilot generic_owner = "declaration"
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_task_sig {
        generic_owner = "task"
    }
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
        pilot generic_is_lifetime = v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id)
        pilot generic_span = v4_ty_signature_generic_segment_span(ty_id, sig_id, generic_id)
        if v4_ty_signature_generic_has_empty_bound_clause(ty_id, sig_id, generic_id) {
            v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: empty generic bound on " + generic_name + " in " + v4_ty_signature_name(ty_id, sig_id), "separate declared lifetime or doctrine bounds with one +")
        }
        pilot bound_id = 0
        pilot bound_count = v4_ty_signature_generic_raw_bound_count(ty_id, sig_id, generic_id)
        repeat until bound_id >= bound_count {
            pilot bound_name = v4_ty_signature_generic_raw_bound_name(ty_id, sig_id, generic_id, bound_id)
            if bound_name == "" {
                v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: empty generic bound on " + generic_name + " in " + v4_ty_signature_name(ty_id, sig_id), "separate declared lifetime or doctrine bounds with one +")
            } else if v4_ty_is_lifetime_name(bound_name) {
                if bound_name == "'static" {
                    v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: 'static is reserved and cannot be used as a lifetime bound on " + generic_name, "use a declared named lifetime; static outlives expansion is not supported for ordinary task contracts yet")
                } else if bound_name == "'_" {
                    v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: '_ is elided and cannot be used as a lifetime bound on " + generic_name, "use a declared named lifetime so Yuuko can build the signature relation")
                } else if not v4_ty_signature_declares_lifetime_name(ty_id, sig_id, bound_name) {
                    v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: lifetime bound " + bound_name + " on " + generic_name + " is not declared on " + v4_ty_signature_name(ty_id, sig_id), "declare " + bound_name + " in the " + generic_owner + "'s generic lifetime list")
                } else if not generic_is_lifetime {
                    v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: type generic " + generic_name + " cannot use lifetime bound " + bound_name, "type binders retain doctrine bounds; put outlives constraints on a lifetime binder")
                }
            } else if generic_is_lifetime {
                v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: lifetime " + generic_name + " may only use lifetime bounds, but found " + bound_name, "write " + generic_name + ": 'shorter and keep doctrine bounds on type binders")
            }
            bound_id += 1
        }
        generic_id += 1
    }
}

task v4_ty_validate_signature_type_lifetimes(ty_id: int, sig_id: int, type_text: word, context: word, context_span: word) -> void {
    if type_text == "" or type_text == v4_ty_unknown {
        give back
    }

    if v4_ty_is_lifetime_name(type_text) {
        v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + type_text + " cannot be used as a value type in " + context, "")
    }

    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        pilot lifetime_name = v4_ty_type_lifetime_name(type_text, lifetime_id)
        if v4_ty_signature_accepts_lifetime(ty_id, sig_id, lifetime_name) == false {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + lifetime_name + " is used in " + context + " but is not declared on " + v4_ty_signature_name(ty_id, sig_id), "")
        }
        lifetime_id += 1
    }

    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, type_text, context, context_span)
}

task v4_ty_validate_signature_type_generic_contracts(ty_id: int, sig_id: int, type_text: word, context: word, context_span: word) -> void {
    if type_text == "" or type_text == v4_ty_unknown {
        give back
    }

    if v4_ty_is_lend_type(type_text) {
        pilot lend_target = v4_ty_lend_target_type(type_text)
        if lend_target == "" or lend_target == v4_ty_unknown or v4_ty_is_lifetime_name(lend_target) or lend_target.char_at(0) == "'" {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: lend type has no valid target in " + context, "write lend 'a T or lend mut 'a T with exactly one lifetime and one value type")
        } else {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, lend_target, "lend target of " + context, context_span)
        }
        give back
    }

    if v4_ty_is_surface_task_function_type(type_text) {
        pilot param_id = 0
        pilot param_count = v4_ty_function_type_param_count(type_text)
        repeat until param_id >= param_count {
            pilot param_surface = v4_ty_function_type_param_surface(type_text, param_id)
            if param_surface != "..." {
                v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, param_surface, "callback parameter " + word_from_int(param_id) + " of " + context, context_span)
            }
            param_id += 1
        }

        pilot return_surface = v4_ty_function_type_return_text(type_text)
        if return_surface != "" and return_surface != v4_ty_unknown {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, return_surface, "callback return of " + context, context_span)
        }
        give back
    }

    if v4_ty_is_raw_pointer_type(type_text) {
        pilot target_type = v4_ty_raw_pointer_target_type(type_text)
        if v4_ty_is_lifetime_name(target_type) {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + target_type + " cannot be used as a value type behind pointer in " + context, "")
        } else {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, target_type, "pointer target of " + context, context_span)
        }
        give back
    }

    if v4_ty_is_dyn_type(type_text) {
        pilot doctrine_type = v4_ty_dyn_doctrine_name(type_text)
        pilot doctrine_name = v4_ty_dyn_doctrine_base_name(type_text)
        if doctrine_name == "" or v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name) < 0 {
            v4_ty_add_error_diag(ty_id, context_span, "dyn doctrine is unknown", "dyn " + doctrine_name + " needs a declared doctrine before Yuuko can build a vtable")
        } else {
            pilot dyn_issue = v4_ty_dyn_object_safety_issue(ty_id, type_text)
            if dyn_issue != "" {
                v4_ty_add_error_diag(ty_id, context_span, "dyn doctrine is not object safe", dyn_issue)
            }
            pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
            pilot expected_count = 0
            if doctrine_sig >= 0 {
                expected_count = v4_ty_signature_generic_count(ty_id, doctrine_sig)
            }
            pilot actual_count = 0
            if v4_ty_is_generic_instance_type(doctrine_type) {
                actual_count = v4_ty_generic_arg_count(doctrine_type)
            }
            if expected_count >= 0 and expected_count != actual_count {
                v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + doctrine_name + " expects " + word_from_int(expected_count) + " generic arguments in dyn doctrine of " + context + " but received " + word_from_int(actual_count), "")
            }
        }
        v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, doctrine_type, "dyn doctrine of " + context, context_span)
        give back
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot actual_count = v4_ty_generic_arg_count(type_text)
        pilot expected_count = v4_ty_expected_generic_arg_count(ty_id, base_name)
        if expected_count >= 0 and expected_count != actual_count {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + base_name + " expects " + word_from_int(expected_count) + " generic arguments in " + context + " but received " + word_from_int(actual_count), "")
        }

        pilot arg_id = 0
        repeat until arg_id >= actual_count {
            pilot arg_text = v4_ty_generic_arg(type_text, arg_id)
            if v4_ty_generic_slot_accepts_lifetime(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) == false {
                    v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context + " must be a lifetime like 'a", "")
                }
            } else if v4_ty_generic_slot_accepts_type(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) {
                    v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + arg_text + " cannot be used as a value type in generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context, "")
                } else {
                    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, arg_text, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context, context_span)
                }
            } else {
                if v4_ty_is_lifetime_name(arg_text) == false {
                    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, arg_text, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context, context_span)
                }
            }
            arg_id += 1
        }
        give back
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_text = v4_ty_tuple_slot_type(type_text, slot_id)
            if v4_ty_is_lifetime_name(slot_text) {
                v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + slot_text + " cannot be used as a value type in tuple slot " + word_from_int(slot_id) + " of " + context, "")
            } else {
                v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, slot_text, "tuple slot " + word_from_int(slot_id) + " of " + context, context_span)
            }
            slot_id += 1
        }
        give back
    }

    if v4_ty_is_fixed_array_type(type_text) {
        pilot element_type = v4_ty_fixed_array_element_type(type_text)
        if v4_ty_is_lifetime_name(element_type) {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + element_type + " cannot be used as a value type in array element of " + context, "")
        } else {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, element_type, "array element of " + context, context_span)
        }
        pilot length_text = v4_ty_fixed_array_length_text(type_text)
        pilot resolved_length = v4_ty_const_integer_text_from_expr(ty_id, length_text)
        if resolved_length == v4_ty_unknown {
            pilot const_ty = v4_ty_const_value_type_for_name(ty_id, v4_ty_strip_const_expr_wrappers(length_text))
            if const_ty != v4_ty_unknown and not v4_ty_is_integer(const_ty) {
                v4_ty_add_error_diag(ty_id, context_span, "array length of " + context + " must use int or uint constant, but " + v4_ty_strip_const_expr_wrappers(length_text) + " has type " + const_ty, "")
            } else {
                v4_ty_add_error_diag(ty_id, context_span, "array length of " + context + " must be compile-time constant", "use a literal length like 4 or a root fixed pilot int/uint constant")
            }
        } else if resolved_length.char_at(0) == "-" {
            v4_ty_add_error_diag(ty_id, context_span, "array length of " + context + " must be non-negative", "got " + resolved_length)
        }
    }
}

task v4_ty_add_lend_storage_exhausted_diag(ty_id: int, type_text: word, context: word, context_span: word) -> void {
    pilot message = "Meiya's lend-storage analysis exhausted its depth budget"
    pilot help = context + " has type " + type_text
    help = help + "; split deeply nested aggregate types or introduce a nominal shape before this ownership boundary"
    v4_ty_add_error_diag(ty_id, context_span, message, help)
}

task v4_ty_validate_no_lend_storage(ty_id: int, type_text: word, context: word, context_span: word) -> void {
    pilot storage_kind = v4_ty_type_lend_storage_class(ty_id, type_text)
    if v4_ty_lend_storage_class_is_incomplete(storage_kind) {
        v4_ty_add_lend_storage_exhausted_diag(ty_id, type_text, context, context_span)
        give back
    }
    if storage_kind == v4_ty_lend_storage_none {
        give back
    }
    pilot named_kind = v4_ty_lend_storage_class_seen(ty_id, type_text, "", 0, true, false)
    if v4_ty_lend_storage_class_is_incomplete(named_kind) {
        v4_ty_add_lend_storage_exhausted_diag(ty_id, type_text, context, context_span)
        give back
    }
    if v4_ty_lend_storage_class_confirms_lend(named_kind) {
        v4_ty_add_error_diag(ty_id, context_span, "Meiya cannot store a named lend in " + context + " yet", "keep named lifetimes on ordinary task lend parameters and outer borrowed returns until aggregate provenance lands")
        give back
    }
    v4_ty_add_error_diag(ty_id, context_span, "Meiya cannot store a lend in " + context + " yet", "keep elided lends on ordinary task lend parameters and outer borrowed returns until aggregate provenance lands")
}

task v4_ty_validate_fixed_lend_storage(ty_id: int, type_text: word, context: word, context_span: word) -> void {
    pilot storage_kind = v4_ty_type_lend_storage_class(ty_id, type_text)
    if v4_ty_lend_storage_class_is_incomplete(storage_kind) {
        v4_ty_add_lend_storage_exhausted_diag(ty_id, type_text, context, context_span)
        give back
    }
    if storage_kind == v4_ty_lend_storage_none or storage_kind == v4_ty_lend_storage_fixed {
        give back
    }
    pilot named_kind = v4_ty_lend_storage_class_seen(ty_id, type_text, "", 0, true, false)
    if v4_ty_lend_storage_class_is_incomplete(named_kind) {
        v4_ty_add_lend_storage_exhausted_diag(ty_id, type_text, context, context_span)
        give back
    }
    if v4_ty_lend_storage_class_confirms_lend(named_kind) {
        v4_ty_add_error_diag(ty_id, context_span, "Meiya cannot store a named lend in " + context + " yet", "use a direct lend, tuple, fixed array, shape, or route payload; dynamic containers, callbacks, aliases, and doctrines remain outside fixed aggregate provenance")
        give back
    }
    v4_ty_add_error_diag(ty_id, context_span, "Meiya cannot store a lend in " + context + " yet", "use a direct lend, tuple, fixed array, shape, or route payload; dynamic containers, callbacks, aliases, and doctrines remain outside fixed aggregate provenance")
}

task v4_ty_validate_nested_param_lend_contracts(ty_id: int, sig_id: int, param_id: int, param_type: word, param_span: word) -> void {
    pilot leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, param_type)
    if leaf_count < 0 {
        v4_ty_add_error_diag(ty_id, param_span, "Meiya cannot enumerate fixed-layout loan leaves in parameter " + word_from_int(param_id), "keep lend-bearing parameter layouts acyclic and at or below " + word_from_int(v4_ty_fixed_lend_leaf_limit) + " leaves")
        give back
    }
    pilot leaf_id = 0
    repeat until leaf_id >= leaf_count {
        pilot leaf_type = v4_ty_fixed_lend_leaf_type_at(ty_id, param_type, leaf_id)
        if v4_ty_lend_lifetime(leaf_type) == "'static" {
            pilot projection = v4_ty_fixed_lend_leaf_projection_at(ty_id, param_type, leaf_id)
            v4_ty_add_error_diag(ty_id, param_span, "Meiya cannot accept a static lend at parameter projection " + projection + " yet", "'static needs source-storage classification before callers may promise an immortal loan")
        }
        leaf_id += 1
    }
}

task v4_ty_validate_aggregate_return_lend_contracts(ty_id: int, sig_id: int, return_type: word, return_span: word) -> void {
    pilot leaf_count = v4_ty_signature_return_lend_leaf_count(ty_id, sig_id)
    if leaf_count < 0 {
        v4_ty_add_error_diag(ty_id, return_span, "Meiya cannot enumerate fixed-layout returned loan leaves", "keep lend-bearing return layouts acyclic and at or below " + word_from_int(v4_ty_fixed_lend_leaf_limit) + " leaves")
        give back
    }
    pilot leaf_id = 0
    repeat until leaf_id >= leaf_count {
        pilot leaf_type = v4_ty_signature_return_lend_leaf_type_at(ty_id, sig_id, leaf_id)
        pilot projection = v4_ty_signature_return_lend_leaf_projection_at(ty_id, sig_id, leaf_id)
        pilot guard = v4_ty_signature_return_lend_leaf_route_guard_at(ty_id, sig_id, leaf_id)
        pilot display_projection = projection
        if guard != "" { display_projection = guard + projection }
        pilot return_lifetime = v4_ty_lend_lifetime(leaf_type)
        if return_lifetime == "'static" {
            v4_ty_add_error_diag(ty_id, return_span, "Meiya cannot prove a static borrowed return at " + display_projection + " yet", "'static returned loans need global-storage provenance before this contract can be sound")
        } else {
            pilot source_count = v4_ty_signature_return_lend_source_count(ty_id, sig_id, leaf_id)
            if source_count < 0 {
                v4_ty_add_error_diag(ty_id, return_span, "Meiya cannot enumerate sources for returned aggregate loan at " + display_projection, "keep compatible source leaves at or below " + word_from_int(v4_ty_return_lend_source_limit) + " and use an acyclic fixed layout")
            } else if source_count == 0 {
                pilot message = "Meiya cannot find a source for returned aggregate loan at " + display_projection
                if return_lifetime != "" and return_lifetime != "'_" {
                    message = "Meiya cannot find a source for returned lifetime " + return_lifetime + " at " + display_projection
                }
                v4_ty_add_error_diag(ty_id, return_span, message, "add a compatible lend parameter leaf whose declared lifetime outlives this returned projection")
            }
        }
        leaf_id += 1
    }
}

task v4_ty_validate_task_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot ordinary_static = v4_ty_signature_is_ordinary_static_task(ty_id, sig_id)
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_is_variadic(ty_id, sig_id, param_id) == false {
            pilot param_type = v4_ty_signature_param_type(ty_id, sig_id, param_id)
            pilot param_context = "parameter " + word_from_int(param_id) + " of " + v4_ty_signature_name(ty_id, sig_id)
            pilot param_span = v4_ty_signature_param_type_span(ty_id, sig_id, param_id)
            pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, param_type, param_context, param_span)
            if ordinary_static and param_mode == v4_ty_param_mode_value {
                v4_ty_validate_fixed_lend_storage(ty_id, param_type, param_context, param_span)
                if v4_ty_type_supports_fixed_lend_storage(ty_id, param_type) {
                    v4_ty_validate_nested_param_lend_contracts(ty_id, sig_id, param_id, param_type, param_span)
                }
            } else {
                v4_ty_validate_no_lend_storage(ty_id, param_type, param_context, param_span)
            }
            pilot param_lifetime = v4_ty_signature_param_lifetime(ty_id, sig_id, param_id)
            if param_lifetime == "'static" {
                v4_ty_add_error_diag(ty_id, v4_ty_signature_param_lifetime_span(ty_id, sig_id, param_id), "Meiya cannot accept a static lend parameter yet", "'static needs source-storage classification before callers may promise an immortal loan")
            } else if param_lifetime != "" and not v4_ty_signature_accepts_lifetime(ty_id, sig_id, param_lifetime) {
                v4_ty_add_error_diag(ty_id, v4_ty_signature_param_lifetime_span(ty_id, sig_id, param_id), "Meiya lifetime debt: " + param_lifetime + " is used on borrowed parameter " + v4_ty_signature_param_name(ty_id, sig_id, param_id) + " but is not declared on " + v4_ty_signature_name(ty_id, sig_id), "declare " + param_lifetime + " in the task's generic lifetime list")
            }
        }
        param_id += 1
    }
    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, return_surface, "return type of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_signature_return_span(ty_id, sig_id))
    pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
    pilot return_contract = return_ty
    if return_contract == "" or return_contract == v4_ty_unknown {
        return_contract = return_surface
    }
    if v4_ty_is_lend_type(return_contract) {
        v4_ty_validate_no_lend_storage(ty_id, v4_ty_lend_target_type(return_contract), "target of returned lend on " + v4_ty_signature_name(ty_id, sig_id), v4_ty_signature_return_span(ty_id, sig_id))
    } else if ordinary_static {
        v4_ty_validate_fixed_lend_storage(ty_id, return_contract, "return type of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_signature_return_span(ty_id, sig_id))
        if v4_ty_type_supports_fixed_lend_storage(ty_id, return_contract) {
            v4_ty_validate_aggregate_return_lend_contracts(ty_id, sig_id, return_contract, v4_ty_signature_return_span(ty_id, sig_id))
        }
    } else {
        v4_ty_validate_no_lend_storage(ty_id, return_contract, "return type of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_signature_return_span(ty_id, sig_id))
    }
    if v4_ty_is_lend_type(return_ty) {
        pilot return_lifetime = v4_ty_lend_lifetime(return_ty)
        if return_lifetime == "'static" {
            v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "Meiya cannot prove a static borrowed return yet", "'static returned loans need global-storage provenance before this contract can be sound")
        } else if return_lifetime != "" and return_lifetime != "'_" and v4_ty_signature_accepts_lifetime(ty_id, sig_id, return_lifetime) {
            if ordinary_static {
                if v4_ty_signature_borrowed_return_source_param_count(ty_id, sig_id) <= 0 {
                    v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "Meiya cannot find a source for returned lifetime " + return_lifetime, "add a lend parameter whose declared lifetime outlives " + return_lifetime)
                }
            }
        }
    }
}

task v4_ty_validate_variadic_signature_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_task_sig {
        give back
    }
    pilot variadic_param = v4_ty_signature_variadic_param_id(ty_id, sig_id)
    if variadic_param < 0 {
        give back
    }

    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    pilot param_span = v4_ty_signature_param_type_span(ty_id, sig_id, variadic_param)
    pilot sig_name = v4_ty_signature_name(ty_id, sig_id)
    pilot call_abi = v4_ty_signature_call_abi(ty_id, sig_id)
    if sig_name == "" {
        sig_name = "this signature"
    }

    if call_abi == "" {
        v4_ty_add_error_diag(ty_id, param_span, "variadic parameter needs extern task", "use args: ... only as the final parameter of an extern task")
    }
    if variadic_param != param_count - 1 {
        v4_ty_add_error_diag(ty_id, param_span, "variadic parameter must be final", "move args: ... to the end of " + sig_name)
    }
    if call_abi != "" {
        if v4_ty_is_variadic_abi_compatible(call_abi) == false {
            v4_ty_add_error_diag(ty_id, param_span, "variadic extern needs C-compatible ABI", "use extern [C], [cdecl], [system], [sysv64], or [win64] for " + sig_name)
        }
    }
}

task v4_ty_validate_shape_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        pilot field_surface = v4_ty_shape_field_surface_type(ty_id, sig_id, field_id)
        pilot field_type = v4_ty_shape_field_type(ty_id, sig_id, field_id)
        pilot field_context = "field " + v4_ty_shape_field_name(ty_id, sig_id, field_id) + " of " + v4_ty_signature_name(ty_id, sig_id)
        pilot field_span = v4_ty_shape_field_type_span(ty_id, sig_id, field_id)
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, field_type, field_context, field_span)
        v4_ty_validate_fixed_lend_storage(ty_id, field_surface, field_context, field_span)
        field_id += 1
    }
}

task v4_ty_validate_route_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        pilot field_id = 0
        pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
        repeat until field_id >= field_count {
            pilot field_surface = v4_ty_route_case_field_surface_type(ty_id, route_name, case_name, field_id)
            pilot field_type = v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id)
            pilot field_context = "field " + v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) + " of " + route_name + "::" + case_name
            pilot field_span = v4_ty_route_case_field_type_span(ty_id, route_name, case_name, field_id)
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, field_type, field_context, field_span)
            v4_ty_validate_fixed_lend_storage(ty_id, field_surface, field_context, field_span)
            field_id += 1
        }
        case_id += 1
    }
}

task v4_ty_validate_doctrine_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot method_id = 0
    pilot method_count = v4_ty_doctrine_method_count(ty_id, sig_id)
    repeat until method_id >= method_count {
        pilot method_name = v4_ty_doctrine_method_name(ty_id, sig_id, method_id)
        pilot param_id = 0
        pilot param_count = v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id)
        repeat until param_id >= param_count {
            pilot param_type = v4_ty_doctrine_method_param_type(ty_id, sig_id, method_id, param_id)
            pilot param_context = "parameter " + word_from_int(param_id) + " of " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name
            pilot param_span = v4_ty_doctrine_method_param_type_span(ty_id, sig_id, method_id, param_id)
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, param_type, param_context, param_span)
            v4_ty_validate_no_lend_storage(ty_id, param_type, param_context, param_span)
            param_id += 1
        }
        pilot return_type = v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id)
        pilot return_context = "return type of " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name
        pilot return_span = v4_ty_doctrine_method_return_span(ty_id, sig_id, method_id)
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, return_type, return_context, return_span)
        if v4_ty_is_lend_type(return_type) {
            v4_ty_validate_no_lend_storage(ty_id, v4_ty_lend_target_type(return_type), "target of returned lend on " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name, return_span)
        } else {
            v4_ty_validate_no_lend_storage(ty_id, return_type, return_context, return_span)
        }
        method_id += 1
    }
}

task v4_ty_validate_alias_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot alias_type = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    pilot alias_context = "alias target of " + v4_ty_signature_name(ty_id, sig_id)
    pilot alias_span = v4_ty_alias_target_span(ty_id, sig_id)
    v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, alias_type, alias_context, alias_span)
    v4_ty_validate_no_lend_storage(ty_id, alias_type, alias_context, alias_span)
}

task v4_ty_validate_alias_signature_cycle(ty_id: int, sig_id: int) -> void {
    pilot alias_name = v4_ty_signature_name(ty_id, sig_id)
    pilot alias_target = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    if alias_name == "" or alias_target == "" or alias_target == v4_ty_unknown {
        give back
    }

    pilot cycle_path = v4_ty_alias_cycle_path_in_type(ty_id, alias_target, alias_name)
    if cycle_path != "" {
        v4_ty_add_error_diag(ty_id, v4_ty_alias_target_span(ty_id, sig_id), "Yuuko alias loop: alias " + alias_name + " expands forever via " + v4_ty_alias_cycle_chain_display(cycle_path), "")
        give back
    }
}

task v4_ty_validate_alias_cycles(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_alias_sig {
            v4_ty_validate_alias_signature_cycle(ty_id, sig_id)
        }
        sig_id += 1
    }
}

-- alias nominality: aliases are substitutions, not fresh doctrine impl targets.
task v4_ty_validate_alias_nominality(ty_id: int) -> void {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            pilot doctrine_name = v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item)
            if doctrine_name != "" {
                pilot target_type = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
                pilot alias_name = v4_ty_alias_name_from_surface_type(ty_id, target_type)
                if alias_name != "" {
                    pilot alias_lookup_type = v4_ty_alias_lookup_type_from_surface_type(ty_id, target_type)
                    pilot alias_target = v4_ty_alias_target_type(ty_id, alias_lookup_type)
                    pilot target_help = ""
                    if alias_target != "" and alias_target != v4_ty_unknown {
                        target_help = alias_name + " aliases " + alias_target + "; "
                    }
                    v4_ty_add_error_diag(ty_id, v4_ty_impl_target_span_from_hir(ty_id, hir_item), "Yuuko nominality breach: alias " + alias_name + " cannot receive doctrine " + doctrine_name, target_help + "use a one-field shape when " + alias_name + " needs its own doctrine impl")
                }
            }
        }
        hir_item += 1
    }
}

task v4_ty_type_recursion_is_indirect_carrier(ty_id: int, type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_raw_pointer_type(type_text) or v4_ty_is_lend_type(type_text) {
        give back true
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot expanded_base = v4_ty_type_recursion_expand_import_name(ty_id, base_name)
        if expanded_base != "" and expanded_base != base_name {
            give back false
        }
        if v4_ty_type_signature_id_for_name(ty_id, base_name) >= 0 {
            give back false
        }
        if base_name == "Shared" or base_name == "Weak" or base_name == "SharedMut" {
            give back true
        }
        if base_name == "List" or base_name == "Map" or base_name == "Set" or base_name == "Lineup" {
            give back true
        }
    }
    give back false
}

task v4_ty_type_recursion_expand_import_name(ty_id: int, surface_name: word) -> word {
    if surface_name == "" or surface_name == v4_ty_unknown {
        give back surface_name
    }
    if v4_ty_type_signature_id_for_name(ty_id, surface_name) >= 0 {
        give back surface_name
    }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot expanded = v4_resolve_expand_import_name(resolve_id, surface_name)
        if expanded != "" {
            give back expanded
        }
    }
    give back surface_name
}

task v4_ty_type_recursion_expand_import_type(ty_id: int, type_text: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot expanded_base = v4_ty_type_recursion_expand_import_name(ty_id, base_name)
        if expanded_base != "" and expanded_base != base_name {
            give back expanded_base + v4_slice(type_text, base_name.length(), type_text.length())
        }
        give back type_text
    }
    give back v4_ty_type_recursion_expand_import_name(ty_id, type_text)
}

task v4_ty_type_recursion_seen_has_nominal(seen_types: word, nominal_name: word) -> bool {
    if seen_types == "" or nominal_name == "" {
        give back false
    }
    if v4_ty_alias_cycle_seen_contains(seen_types, nominal_name) {
        give back true
    }
    give back ("|" + seen_types + "|").contains("|" + nominal_name + "<")
}

task v4_ty_type_recursion_nominal_sig(ty_id: int, type_text: word) -> int {
    if type_text == "" or type_text == v4_ty_unknown {
        give back 0 - 1
    }
    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, type_text)
    if shape_sig >= 0 {
        give back shape_sig
    }
    give back v4_ty_route_signature_id_for_name(ty_id, type_text)
}

task v4_ty_type_recursion_path_in_nominal(ty_id: int, owner_name: word, sig_id: int, instance_ty: word, seen_types: word) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }

    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind == v4_ty_shape_sig {
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
        repeat until field_id >= field_count {
            pilot field_ty = v4_ty_shape_field_surface_type(ty_id, sig_id, field_id)
            field_ty = v4_ty_apply_signature_generics(ty_id, sig_id, instance_ty, field_ty)
            pilot field_path = v4_ty_type_recursion_path_in_type(ty_id, owner_name, field_ty, seen_types)
            if field_path != "" {
                give back field_path
            }
            field_id += 1
        }
        give back ""
    }

    if sig_kind == v4_ty_route_sig {
        pilot case_id = 0
        pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
        repeat until case_id >= case_count {
            pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
            pilot field_id = 0
            pilot field_count = v4_ty_route_case_field_count(ty_id, instance_ty, case_name)
            repeat until field_id >= field_count {
                pilot field_ty = v4_ty_route_case_field_type(ty_id, instance_ty, case_name, field_id)
                pilot field_path = v4_ty_type_recursion_path_in_type(ty_id, owner_name, field_ty, seen_types)
                if field_path != "" {
                    give back field_path
                }
                field_id += 1
            }
            case_id += 1
        }
    }

    give back ""
}

task v4_ty_type_recursion_path_in_generic_args(ty_id: int, owner_name: word, type_text: word, seen_types: word) -> word {
    pilot arg_id = 0
    pilot arg_count = v4_ty_generic_arg_count(type_text)
    repeat until arg_id >= arg_count {
        pilot arg_path = v4_ty_type_recursion_path_in_type(ty_id, owner_name, v4_ty_generic_arg(type_text, arg_id), seen_types)
        if arg_path != "" {
            give back arg_path
        }
        arg_id += 1
    }
    give back ""
}

task v4_ty_type_recursion_path_in_type(ty_id: int, owner_name: word, type_text: word, seen_types: word) -> word {
    if owner_name == "" or type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    type_text = v4_ty_type_recursion_expand_import_type(ty_id, type_text)

    if type_text == owner_name {
        give back v4_ty_alias_cycle_seen_append(seen_types, owner_name)
    }

    pilot alias_lookup = v4_ty_alias_lookup_type_from_surface_type(ty_id, type_text)
    if alias_lookup != "" {
        if v4_ty_alias_cycle_seen_contains(seen_types, alias_lookup) {
            give back ""
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, alias_lookup)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_type_recursion_path_in_type(ty_id, owner_name, alias_target, v4_ty_alias_cycle_seen_append(seen_types, alias_lookup))
        }
    }

    pilot canonical_ty = v4_ty_canonical_type(ty_id, type_text)
    if canonical_ty == "" or canonical_ty == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_surface_ffi_alias_type(canonical_ty) or v4_ty_is_primitive_type(canonical_ty) or v4_ty_is_lifetime_name(canonical_ty) {
        give back ""
    }
    if v4_ty_is_dyn_type(canonical_ty) or v4_ty_type_recursion_is_indirect_carrier(ty_id, canonical_ty) {
        give back ""
    }

    if v4_ty_is_tuple_type(canonical_ty) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(canonical_ty)
        repeat until slot_id >= slot_count {
            pilot slot_path = v4_ty_type_recursion_path_in_type(ty_id, owner_name, v4_ty_tuple_slot_type(canonical_ty, slot_id), seen_types)
            if slot_path != "" {
                give back slot_path
            }
            slot_id += 1
        }
        give back ""
    }

    if v4_ty_is_fixed_array_type(canonical_ty) {
        give back v4_ty_type_recursion_path_in_type(ty_id, owner_name, v4_ty_fixed_array_element_type(canonical_ty), seen_types)
    }

    if v4_ty_is_generic_instance_type(canonical_ty) {
        pilot base_name = v4_ty_generic_base_name(canonical_ty)
        if base_name == owner_name {
            give back v4_ty_alias_cycle_seen_append(seen_types, owner_name)
        }

        pilot nominal_sig = v4_ty_type_recursion_nominal_sig(ty_id, canonical_ty)
        if nominal_sig >= 0 {
            pilot nominal_name = v4_ty_signature_name(ty_id, nominal_sig)
            if v4_ty_type_recursion_seen_has_nominal(seen_types, nominal_name) {
                give back v4_ty_type_recursion_path_in_generic_args(ty_id, owner_name, canonical_ty, v4_ty_alias_cycle_seen_append(seen_types, canonical_ty))
            }
            if v4_ty_alias_cycle_seen_contains(seen_types, canonical_ty) {
                give back ""
            }
            give back v4_ty_type_recursion_path_in_nominal(ty_id, owner_name, nominal_sig, canonical_ty, v4_ty_alias_cycle_seen_append(seen_types, canonical_ty))
        }

        give back v4_ty_type_recursion_path_in_generic_args(ty_id, owner_name, canonical_ty, seen_types)
    }

    if canonical_ty == owner_name {
        give back v4_ty_alias_cycle_seen_append(seen_types, owner_name)
    }

    pilot nominal_sig = v4_ty_type_recursion_nominal_sig(ty_id, canonical_ty)
    if nominal_sig >= 0 {
        pilot nominal_name = v4_ty_signature_name(ty_id, nominal_sig)
        pilot seen_key = nominal_name
        if v4_ty_is_generic_instance_type(canonical_ty) {
            seen_key = canonical_ty
        }
        if v4_ty_alias_cycle_seen_contains(seen_types, seen_key) {
            give back ""
        }
        give back v4_ty_type_recursion_path_in_nominal(ty_id, owner_name, nominal_sig, canonical_ty, v4_ty_alias_cycle_seen_append(seen_types, seen_key))
    }

    give back ""
}

task v4_ty_validate_shape_direct_recursion(ty_id: int, sig_id: int) -> void {
    pilot owner_name = v4_ty_signature_name(ty_id, sig_id)
    if owner_name == "" {
        give back
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, owner_name) {
        give back
    }

    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        pilot field_ty = v4_ty_shape_field_surface_type(ty_id, sig_id, field_id)
        pilot cycle_path = v4_ty_type_recursion_path_in_type(ty_id, owner_name, field_ty, owner_name)
        if cycle_path != "" {
            v4_ty_add_error_diag(ty_id, v4_ty_shape_field_type_span(ty_id, sig_id, field_id), "Yuuko infinite shape: " + owner_name + " contains itself by value via " + v4_ty_alias_cycle_chain_display(cycle_path), "break the cycle with Shared<T>, Weak<T>, List<T>, or a raw pointer inside a trust-me boundary")
            give back
        }
        field_id += 1
    }
}

task v4_ty_validate_route_direct_recursion(ty_id: int, sig_id: int) -> void {
    pilot owner_name = v4_ty_signature_name(ty_id, sig_id)
    if owner_name == "" {
        give back
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, owner_name) {
        give back
    }

    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        pilot field_id = 0
        pilot field_count = v4_ty_route_case_field_count(ty_id, owner_name, case_name)
        repeat until field_id >= field_count {
            pilot field_ty = v4_ty_route_case_field_type(ty_id, owner_name, case_name, field_id)
            pilot cycle_path = v4_ty_type_recursion_path_in_type(ty_id, owner_name, field_ty, owner_name)
            if cycle_path != "" {
                v4_ty_add_error_diag(ty_id, v4_ty_route_case_field_type_span(ty_id, owner_name, case_name, field_id), "Yuuko infinite variant: " + owner_name + " contains itself by value via " + v4_ty_alias_cycle_chain_display(cycle_path), "break the cycle with Shared<T>, Weak<T>, List<T>, or a raw pointer inside a trust-me boundary")
                give back
            }
            field_id += 1
        }
        case_id += 1
    }
}

task v4_ty_validate_direct_type_recursion(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
        if sig_kind == v4_ty_shape_sig {
            v4_ty_validate_shape_direct_recursion(ty_id, sig_id)
        } else if sig_kind == v4_ty_route_sig {
            v4_ty_validate_route_direct_recursion(ty_id, sig_id)
        }
        sig_id += 1
    }
}

task v4_ty_validate_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    v4_ty_validate_signature_generic_names(ty_id, sig_id)
    v4_ty_validate_variadic_signature_contract(ty_id, sig_id)
    v4_ty_validate_signature_generic_bounds(ty_id, sig_id)

    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind == v4_ty_task_sig or sig_kind == v4_ty_extern_sig {
        v4_ty_validate_task_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_shape_sig {
        v4_ty_validate_shape_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_route_sig {
        v4_ty_validate_route_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_doctrine_sig {
        v4_ty_validate_doctrine_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_alias_sig {
        v4_ty_validate_alias_signature_lifetimes(ty_id, sig_id)
    }
}

task v4_ty_validate_lifetime_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_signature_lifetimes(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_ffi_seen_contains(seen_types: word, type_name: word) -> bool {
    give back v4_ty_alias_cycle_seen_contains(seen_types, type_name)
}

task v4_ty_ffi_seen_append(seen_types: word, type_name: word) -> word {
    give back v4_ty_alias_cycle_seen_append(seen_types, type_name)
}

task v4_ty_surface_ffi_safe_repr_route_seen(ty_id: int, surface_type: word, seen_types: word) -> bool {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back false
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back false
    }

    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, surface_type)
    if sig_id < 0 {
        give back false
    }

    if v4_ty_signature_repr_kind(ty_id, sig_id) == "" {
        give back false
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            give back false
        }
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown {
                give back false
            }
        }
        case_id += 1
    }

    give back true
}

task v4_ty_ffi_route_boundary_help(ty_id: int, surface_type: word, context: word, pointer_context: bool) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, surface_type)
    if sig_id < 0 {
        give back ""
    }

    pilot prefix = context + " uses " + surface_type + "; "
    if pointer_context {
        prefix = context + " points at " + surface_type + "; "
    }

    pilot repr_kind = v4_ty_signature_repr_kind(ty_id, sig_id)
    if repr_kind == "" {
        give back prefix + "fieldless routes and variants cross FFI only with @repr(u8), @repr(u16), @repr(u32), @repr(u64), @repr(i8), @repr(i16), @repr(i32), or @repr(i64)."
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            give back prefix + route_name + "::" + case_name + " carries payload fields; payload routes are not FFI-safe even with @repr(...). Wrap them in an explicit @layout(C) tagged shape."
        }
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown {
                give back prefix + route_name + "::" + case_name + " needs a compile-time integer discriminant before the route can cross FFI."
            }
        }
        case_id += 1
    }

    give back prefix + "only fieldless @repr(...) routes and variants may cross FFI directly."
}

task v4_ty_ffi_boundary_help(ty_id: int, surface_type: word, context: word) -> word {
    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        if target_type == "word" {
            give back context + " points at word; raw pointers do not make FREAK strings C-safe. Use *const tiny or an explicit @layout(C) buffer."
        }
        if v4_ty_is_surface_task_function_type(target_type) {
            give back context + " points at " + target_type + "; function pointers crossing FFI must use extern[C]/[system] task(...) -> T."
        }
        if target_type == "int" or target_type == "uint" or target_type == "bool" or target_type == "num" or target_type == "float" or target_type == "float32" {
            give back context + " points at " + target_type + "; spell pointed-to boundary scalars with std::ffi aliases like *const std::ffi::c_int or *mut std::ffi::c_double."
        }
        if target_type == "void" {
            give back context + " may point at void only as *const void, *mut void, or *const std::ffi::c_void."
        }
        pilot route_help = v4_ty_ffi_route_boundary_help(ty_id, target_type, context, true)
        if route_help != "" {
            give back route_help
        }
        give back context + " points at " + target_type + "; raw pointers crossing FFI must target std::ffi aliases, tiny/char buffers, extern callbacks, fixed arrays, or @layout(C) / @layout(transparent) shapes."
    }
    if surface_type == "word" {
        give back context + " uses word; that is a FREAK string fat pointer, not a C char*. Use *const tiny or an explicit @layout(C) buffer."
    }
    if v4_ty_is_surface_task_function_type(surface_type) {
        give back context + " uses " + surface_type + "; FFI callbacks must be spelled as extern[C]/[system] task(...) -> T with FFI-safe parameter and return types."
    }
    if surface_type == "int" or surface_type == "uint" or surface_type == "bool" or surface_type == "num" or surface_type == "float" or surface_type == "float32" {
        give back context + " uses " + surface_type + "; spell boundary scalars with std::ffi aliases like c_int, c_uint, c_float, c_double, or c_bool."
    }
    if surface_type == "void" or surface_type == "c_void" or surface_type == "std::ffi::c_void" {
        give back context + " may use void only as an extern return or behind a raw pointer."
    }
    pilot route_help = v4_ty_ffi_route_boundary_help(ty_id, surface_type, context, false)
    if route_help != "" {
        give back route_help
    }
    give back context + " must use std::ffi aliases, raw pointers, fixed arrays, fieldless @repr(...) variants, or @layout(C) / @layout(transparent) shapes; got " + surface_type
}

task v4_ty_surface_ffi_safe_pointer_target_seen(ty_id: int, surface_type: word, seen_types: word) -> bool {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back false
    }

    if v4_ty_is_surface_ffi_alias_type(surface_type) {
        give back true
    }

    if surface_type == v4_ty_void or surface_type == v4_ty_tiny or surface_type == v4_ty_char {
        give back true
    }

    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        give back target_type != "" and target_type != v4_ty_unknown and v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, target_type, seen_types)
    }

    if v4_ty_is_surface_extern_function_pointer_type(surface_type) {
        give back v4_ty_surface_extern_function_pointer_ffi_safe(ty_id, surface_type, seen_types)
    }

    if v4_ty_is_surface_task_function_type(surface_type) {
        give back false
    }

    if v4_ty_is_fixed_array_type(surface_type) {
        give back v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, v4_ty_fixed_array_element_type(surface_type), seen_types)
    }

    if v4_ty_is_tuple_type(surface_type) {
        give back false
    }

    if v4_ty_surface_ffi_safe_repr_route_seen(ty_id, surface_type, seen_types) {
        give back true
    }

    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, surface_type)
    if shape_sig >= 0 {
        if v4_ty_signature_layout_kind(ty_id, shape_sig) == "" {
            give back false
        }
        pilot shape_name = v4_ty_signature_name(ty_id, shape_sig)
        if v4_ty_ffi_seen_contains(seen_types, shape_name) {
            give back true
        }
        pilot next_seen = v4_ty_ffi_seen_append(seen_types, shape_name)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            if v4_ty_surface_ffi_safe_type_seen(ty_id, v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id), false, next_seen) == false {
                give back false
            }
            field_id += 1
        }
        give back true
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back false
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, surface_type)
    if alias_target != "" and alias_target != v4_ty_unknown {
        give back v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, alias_target, v4_ty_ffi_seen_append(seen_types, surface_type))
    }

    give back false
}

task v4_ty_surface_ffi_safe_type_seen(ty_id: int, surface_type: word, allow_bare_void: bool, seen_types: word) -> bool {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back false
    }

    pilot normalized = v4_ty_normalize_ffi_alias_type(surface_type)
    if normalized != "" {
        if normalized == v4_ty_void {
            give back allow_bare_void
        }
        give back true
    }

    if surface_type == v4_ty_void {
        give back allow_bare_void
    }

    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        give back target_type != "" and target_type != v4_ty_unknown and v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, target_type, seen_types)
    }

    if v4_ty_is_surface_extern_function_pointer_type(surface_type) {
        give back v4_ty_surface_extern_function_pointer_ffi_safe(ty_id, surface_type, seen_types)
    }

    if v4_ty_is_surface_task_function_type(surface_type) {
        give back false
    }

    if v4_ty_is_fixed_array_type(surface_type) {
        give back v4_ty_surface_ffi_safe_type_seen(ty_id, v4_ty_fixed_array_element_type(surface_type), false, seen_types)
    }

    if v4_ty_is_tuple_type(surface_type) {
        give back false
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back false
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, surface_type)
    if alias_target != "" and alias_target != v4_ty_unknown {
        give back v4_ty_surface_ffi_safe_type_seen(ty_id, alias_target, allow_bare_void, v4_ty_ffi_seen_append(seen_types, surface_type))
    }

    if v4_ty_surface_ffi_safe_repr_route_seen(ty_id, surface_type, seen_types) {
        give back true
    }

    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, surface_type)
    if shape_sig >= 0 {
        if v4_ty_signature_layout_kind(ty_id, shape_sig) == "" {
            give back false
        }
        pilot shape_name = v4_ty_signature_name(ty_id, shape_sig)
        if v4_ty_ffi_seen_contains(seen_types, shape_name) {
            give back false
        }
        pilot next_seen = v4_ty_ffi_seen_append(seen_types, shape_name)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            if v4_ty_surface_ffi_safe_type_seen(ty_id, v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id), false, next_seen) == false {
                give back false
            }
            field_id += 1
        }
        give back true
    }

    give back false
}

task v4_ty_validate_shape_layout_contract(ty_id: int, sig_id: int) -> void {
    pilot layout_text = v4_ty_signature_layout(ty_id, sig_id)
    if layout_text == "" {
        give back
    }

    pilot layout_span = v4_ty_signature_attribute_span_for_name(ty_id, sig_id, "layout")
    pilot layout_kind = v4_ty_signature_layout_kind(ty_id, sig_id)
    if layout_kind == "" {
        v4_ty_add_error_diag(ty_id, layout_span, "unknown layout contract", "use @layout(C), @layout(C, packed=1), or @layout(transparent)")
        give back
    }

    pilot packed_seen = false
    pilot arg_idx = 1
    pilot arg_count = v4_ty_layout_arg_count(layout_text)
    repeat until arg_idx >= arg_count {
        pilot option_text = v4_ty_layout_arg(layout_text, arg_idx)
        pilot option_name = v4_ty_layout_option_name(option_text)
        if option_name == "packed" {
            if packed_seen {
                v4_ty_add_error_diag(ty_id, layout_span, "duplicate layout option", "packed appears more than once on " + v4_ty_signature_name(ty_id, sig_id))
            }
            packed_seen = true
            pilot packed_value = v4_ty_layout_option_value(option_text)
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, packed_value)
            if packed_value == "" or resolved == v4_ty_unknown {
                v4_ty_add_error_diag(ty_id, layout_span, "packed layout must use compile-time integer", "write packed=1 or another positive integer constant")
            } else if resolved == "0" or resolved.starts_with("-") {
                v4_ty_add_error_diag(ty_id, layout_span, "packed layout must be positive", "got " + resolved)
            }
        } else {
            v4_ty_add_error_diag(ty_id, layout_span, "unknown layout option", "only packed=N is supported after @layout(C)")
        }
        arg_idx += 1
    }

    if packed_seen and layout_kind != "C" {
        v4_ty_add_error_diag(ty_id, layout_span, "packed layout needs C", "write @layout(C, packed=1) instead of @layout(" + layout_text + ")")
    }

    if layout_kind == "transparent" {
        pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
        if field_count != 1 {
            v4_ty_add_error_diag(ty_id, layout_span, "transparent layout needs one field", v4_ty_signature_name(ty_id, sig_id) + " exposes " + word_from_int(field_count) + " fields")
        }
    }

    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        pilot field_surface = v4_ty_shape_field_surface_type(ty_id, sig_id, field_id)
        pilot field_name = v4_ty_shape_field_name(ty_id, sig_id, field_id)
        pilot field_context = v4_ty_signature_name(ty_id, sig_id) + "." + field_name
        if v4_ty_validate_callback_surface_contract(ty_id, field_surface, v4_ty_shape_field_type_span(ty_id, sig_id, field_id), field_context, v4_ty_signature_name(ty_id, sig_id)) == false and v4_ty_surface_ffi_safe_type_seen(ty_id, field_surface, false, v4_ty_signature_name(ty_id, sig_id)) == false {
            v4_ty_add_error_diag(ty_id, v4_ty_shape_field_type_span(ty_id, sig_id, field_id), "layout field type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, field_surface, field_context))
        }
        field_id += 1
    }
}

task v4_ty_validate_layout_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_shape_sig {
            v4_ty_validate_shape_layout_contract(ty_id, sig_id)
        }
        sig_id += 1
    }
}

task v4_ty_validate_signature_repr_contract(ty_id: int, sig_id: int) -> void {
    pilot repr_text = v4_ty_signature_repr(ty_id, sig_id)
    if repr_text == "" {
        give back
    }

    pilot repr_span = v4_ty_signature_attribute_span_for_name(ty_id, sig_id, "repr")
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        v4_ty_add_error_diag(ty_id, repr_span, "repr contract needs route", "@repr(...) currently applies only to fieldless routes and variants")
        give back
    }

    pilot repr_kind = v4_ty_signature_repr_kind(ty_id, sig_id)
    if repr_kind == "" {
        v4_ty_add_error_diag(ty_id, repr_span, "unknown repr contract", "use @repr(u8), @repr(u16), @repr(u32), @repr(u64), @repr(i8), @repr(i16), @repr(i32), or @repr(i64)")
        give back
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            v4_ty_add_error_diag(ty_id, v4_ty_route_case_segment_span(ty_id, sig_id, case_id), "repr variants must be fieldless", route_name + "::" + case_name + " carries payload fields")
        } else {
            pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
            if explicit_text != "" {
                pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
                if resolved == "" or resolved == v4_ty_unknown {
                    v4_ty_add_error_diag(ty_id, v4_ty_route_case_explicit_discriminant_span_by_sig(ty_id, sig_id, case_id), "repr discriminant must use compile-time integer", route_name + "::" + case_name + " writes " + explicit_text)
                }
            }
        }
        case_id += 1
    }
}

task v4_ty_validate_repr_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_signature_repr_contract(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_validate_extern_spec_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back
    }

    pilot spec_text = v4_ty_extern_spec_text(ty_id, sig_id)
    if spec_text == "" {
        give back
    }

    pilot spec_span = v4_hir_item_span(v4_ty_signature_hir_id(ty_id), v4_ty_signature_hir_item(ty_id, sig_id))
    pilot language_seen = false
    pilot cc_seen = false
    pilot link_seen = false
    pilot item_idx = 0
    pilot item_count = v4_ty_extern_spec_arg_count(spec_text)
    repeat until item_idx >= item_count {
        pilot item = v4_ty_extern_spec_arg(spec_text, item_idx)
        pilot normalized = v4_ty_normalize_call_abi(item)
        pilot option_name = v4_ty_extern_spec_option_name(item)
        if item == "" {
            item_idx += 1
        } else if option_name == "link" {
            if link_seen {
                v4_ty_add_error_diag(ty_id, spec_span, "duplicate extern link option", "link appears more than once on this extern block")
            }
            link_seen = true
            if v4_ty_extern_spec_item_value_is_string(ty_id, sig_id, item_idx) == false {
                v4_ty_add_error_diag(ty_id, spec_span, "extern link needs string literal", "write link=\"m\" or another quoted native library name")
            }
            item_idx += 1
        } else if item.starts_with("if") {
            item_idx += 1
        } else if v4_ty_is_language_abi(normalized) {
            if language_seen {
                v4_ty_add_error_diag(ty_id, spec_span, "duplicate extern language ABI", "C appears more than once in this extern block")
            }
            language_seen = true
            item_idx += 1
        } else if v4_ty_is_calling_convention_abi(normalized) {
            if cc_seen {
                v4_ty_add_error_diag(ty_id, spec_span, "duplicate extern calling convention", "choose one of cdecl, stdcall, fastcall, thiscall, vectorcall, win64, sysv64, or system")
            }
            cc_seen = true
            item_idx += 1
        } else {
            v4_ty_add_error_diag(ty_id, spec_span, "unknown extern ABI option", "unsupported extern option " + item)
            item_idx += 1
        }
    }
}

task v4_ty_validate_extern_member_link_name_contract(ty_id: int, sig_id: int) -> void {
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if member_id < 0 or extern_sig < 0 {
        give back
    }

    pilot seen_link = false
    pilot attr_idx = 0
    pilot attr_count = v4_ty_extern_member_attribute_count(ty_id, extern_sig, member_id)
    repeat until attr_idx >= attr_count {
        if v4_ty_extern_member_attribute_name(ty_id, extern_sig, member_id, attr_idx) == "link_name" {
            pilot attr_span = v4_ty_extern_member_attribute_span(ty_id, extern_sig, member_id, attr_idx)
            if seen_link {
                v4_ty_add_error_diag(ty_id, attr_span, "duplicate link_name attribute", "keep a single @link_name(\"symbol\") on " + v4_ty_signature_name(ty_id, sig_id))
            }
            seen_link = true
            if v4_ty_extern_member_attribute_arg_is_string(ty_id, extern_sig, member_id, attr_idx) == false {
                v4_ty_add_error_diag(ty_id, attr_span, "link_name needs string literal", "write @link_name(\"puts\") or another quoted native symbol")
            }
        }
        attr_idx += 1
    }
}

task v4_ty_validate_extern_member_ffi_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
        give back
    }

    pilot member_name = v4_ty_signature_name(ty_id, sig_id)
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_is_variadic(ty_id, sig_id, param_id) == false {
            pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
            pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
            pilot param_context = member_name + " argument " + word_from_int(param_id + 1)
            if param_name != "" {
                param_context = member_name + "." + param_name
            }
            if v4_ty_validate_callback_surface_contract(ty_id, param_surface, v4_ty_signature_param_type_span(ty_id, sig_id, param_id), param_context, "") == false and v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, "") == false {
                v4_ty_add_error_diag(ty_id, v4_ty_signature_param_type_span(ty_id, sig_id, param_id), "extern parameter type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, param_surface, param_context))
            }
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface != "" and return_surface != v4_ty_unknown {
        if v4_ty_validate_callback_surface_contract(ty_id, return_surface, v4_ty_signature_return_span(ty_id, sig_id), member_name, "") == false and v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, "") == false {
            v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "extern return type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, return_surface, member_name + " return"))
        }
    }
}

task v4_ty_is_known_unwinder_symbol(name: word) -> bool {
    -- C non-local-jump primitives. Calling these from FREAK can transfer
    -- control past FREAK destructors and the panic-boundary contract that
    -- @extern_callback trampolines enforce. The bible (section 16) promises
    -- panics never cross the FFI boundary; longjmp-style unwinds violate
    -- that promise from the foreign side.
    if name == "setjmp" or name == "_setjmp" or name == "sigsetjmp" or name == "__sigsetjmp" {
        give back true
    }
    if name == "longjmp" or name == "_longjmp" or name == "siglongjmp" {
        give back true
    }
    -- Itanium C++ ABI exception primitives.
    if name == "_Unwind_RaiseException" or name == "_Unwind_Resume" or name == "_Unwind_ForcedUnwind" {
        give back true
    }
    if name == "__cxa_throw" or name == "__cxa_rethrow" or name == "__cxa_begin_catch" or name == "__cxa_end_catch" {
        give back true
    }
    -- Windows Structured Exception Handling primitive.
    if name == "RaiseException" {
        give back true
    }
    give back false
}

task v4_ty_unwinder_help(name: word) -> word {
    pilot tail = " can transfer control past FREAK destructors and the @extern_callback panic-boundary contract; wrap it in a C shim that converts the non-local jump into an integer error code, or expose only a result<T, E>-returning safe wrapper."
    give back name + tail
}

task v4_ty_extern_member_has_allow_unwinder(ty_id: int, block_sig: int, member_id: int) -> bool {
    if block_sig < 0 or member_id < 0 {
        give back false
    }
    pilot attr_idx = 0
    pilot attr_count = v4_ty_extern_member_attribute_count(ty_id, block_sig, member_id)
    repeat until attr_idx >= attr_count {
        if v4_ty_extern_member_attribute_name(ty_id, block_sig, member_id, attr_idx) == "allow_unwinder" {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_ty_extern_block_has_allow_unwinder(ty_id: int, block_sig: int) -> bool {
    if block_sig < 0 {
        give back false
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, block_sig)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, hir_item)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, hir_item, attr_idx) == "allow_unwinder" {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_ty_signature_unwinder_effective_name(ty_id: int, sig_id: int) -> word {
    if v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
        give back ""
    }
    pilot block_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    pilot member_name = v4_ty_signature_name(ty_id, sig_id)
    pilot link_name = v4_ty_extern_member_link_name(ty_id, block_sig, member_id)
    pilot effective_name = link_name
    if effective_name == "" {
        effective_name = member_name
    }
    give back effective_name
}

task v4_ty_signature_is_warned_unwinder(ty_id: int, sig_id: int) -> bool {
    pilot effective_name = v4_ty_signature_unwinder_effective_name(ty_id, sig_id)
    if effective_name == "" {
        give back false
    }
    if v4_ty_is_known_unwinder_symbol(effective_name) == false {
        give back false
    }
    pilot block_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if v4_ty_extern_member_has_allow_unwinder(ty_id, block_sig, member_id) {
        give back false
    }
    if v4_ty_extern_block_has_allow_unwinder(ty_id, block_sig) {
        give back false
    }
    give back true
}

task v4_ty_validate_extern_member_unwinder_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_is_warned_unwinder(ty_id, sig_id) == false {
        give back
    }
    pilot effective_name = v4_ty_signature_unwinder_effective_name(ty_id, sig_id)
    pilot span = v4_hir_item_span(v4_ty_signature_hir_id(ty_id), v4_ty_signature_hir_item(ty_id, sig_id))
    v4_ty_add_warning_diag(ty_id, span, "extern import unwinds across the FFI boundary", v4_ty_unwinder_help(effective_name))
}

task v4_ty_validate_extern_ffi_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
            v4_ty_validate_extern_spec_contract(ty_id, sig_id)
        }
        v4_ty_validate_extern_member_link_name_contract(ty_id, sig_id)
        v4_ty_validate_extern_member_ffi_contract(ty_id, sig_id)
        v4_ty_validate_extern_member_unwinder_contract(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_validate_extern_callback_export_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back
    }

    pilot attr_span = v4_ty_signature_attribute_span_for_name(ty_id, sig_id, "extern_callback")
    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind != v4_ty_task_sig {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback applies only to tasks", "remove @extern_callback from " + v4_ty_signature_name(ty_id, sig_id) + " or move it to a task declaration")
        give back
    }

    pilot task_name = v4_ty_signature_name(ty_id, sig_id)
    pilot arg_count = v4_ty_signature_extern_callback_arg_count(ty_id, sig_id)
    if arg_count == 0 {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback needs an ABI", "write @extern_callback(\"C\") or @extern_callback(\"system\") on " + task_name)
        give back
    }
    if arg_count > 1 {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback takes one ABI", task_name + " uses extra arguments; @extern_callback accepts exactly one ABI string like \"C\" or \"system\"")
        give back
    }

    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback needs an ABI", "write @extern_callback(\"C\") or @extern_callback(\"system\") on " + task_name)
        give back
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback ABI is invalid", task_name + " uses @extern_callback(" + v4_ty_signature_extern_callback_abi_raw(ty_id, sig_id) + "); use \"C\", \"system\", or a supported calling convention like \"cdecl\"/\"stdcall\"/\"win64\"/\"sysv64\"")
        give back
    }

    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback tasks cannot be variadic", "remove args: ... from " + task_name + " before exposing it as an FFI callback")
        give back
    }

    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
        if v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, "") == false {
            pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
            pilot param_context = task_name + " argument " + word_from_int(param_id + 1)
            if param_name != "" {
                param_context = task_name + "." + param_name
            }
            v4_ty_add_error_diag(ty_id, v4_ty_signature_param_type_span(ty_id, sig_id, param_id), "@extern_callback parameter type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, param_surface, param_context))
            give back
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface == "" or return_surface == v4_ty_unknown {
        v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "@extern_callback return type is not FFI-safe", task_name + " must return an explicit FFI-safe type")
        give back
    }
    if v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, "") == false {
        v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "@extern_callback return type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, return_surface, task_name + " return"))
        give back
    }
}

task v4_ty_validate_extern_callback_export_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_extern_callback_export_contract(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_type_depth_after_char(depth: int, ch: word) -> int {
    pilot next_depth = depth
    if ch == "(" or ch == "[" or ch == "{" or ch == "<" {
        next_depth += 1
    } else if ch == ")" or ch == "]" or ch == "}" or ch == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_ty_find_top_level_type_char(type_text: word, wanted: word, start_pos: int, end_pos: int) -> int {
    pilot depth = 0
    pilot idx = start_pos
    repeat until idx >= end_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == wanted {
            give back idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_is_generic_instance_type(type_text: word) -> bool {
    if type_text.length() < 4 {
        give back false
    }
    if type_text.char_at(type_text.length() - 1) != ">" {
        give back false
    }
    give back v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1) > 0
}

task v4_ty_generic_base_name(type_text: word) -> word {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, 0, open_pos)
}

task v4_ty_generic_arg_count(type_text: word) -> int {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" {
        give back 0
    }
    if open_pos + 1 >= type_text.length() - 1 {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= type_text.length() - 1 {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_generic_arg(type_text: word, arg_id: int) -> word {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" or arg_id < 0 {
        give back v4_ty_unknown
    }
    if open_pos + 1 >= type_text.length() - 1 {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= type_text.length() - 1 {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == arg_id {
                give back v4_slice(type_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == arg_id and segment_start < type_text.length() - 1 {
        give back v4_slice(type_text, segment_start, type_text.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_generic_env_lookup(env: word, name: word) -> word {
    if env == "" or name == "" {
        give back ""
    }

    pilot segment_start = 0
    repeat until segment_start >= env.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(env, "|", segment_start, env.length())
        if segment_end < 0 {
            segment_end = env.length()
        }
        pilot eq_pos = v4_ty_find_top_level_type_char(env, "=", segment_start, segment_end)
        if eq_pos > segment_start {
            if v4_slice(env, segment_start, eq_pos) == name {
                give back v4_slice(env, eq_pos + 1, segment_end)
            }
        }
        segment_start = segment_end + 1
    }
    give back ""
}

task v4_ty_generic_env_bind(env: word, name: word, actual_ty: word) -> word {
    pilot existing = v4_ty_generic_env_lookup(env, name)
    if existing != "" {
        if existing == actual_ty {
            give back env
        }
        give back v4_ty_generic_env_fail
    }

    if env == "" {
        give back name + "=" + actual_ty
    }
    give back env + "|" + name + "=" + actual_ty
}

task v4_ty_match_signature_type_env_mode(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word, env: word, allow_dyn_coerce: bool) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back env
    }
    if sig_id >= 0 {
        if v4_ty_signature_declares_lifetime_name(ty_id, sig_id, expected_ty) {
            if not v4_ty_is_lifetime_name(actual_ty) {
                give back v4_ty_generic_env_fail
            }
            give back v4_ty_generic_env_bind(env, expected_ty, actual_ty)
        }
        if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, expected_ty) {
            give back v4_ty_generic_env_bind(env, expected_ty, actual_ty)
        }
    }
    if expected_ty == actual_ty {
        give back env
    }
    if v4_ty_is_lend_type(expected_ty) or v4_ty_is_lend_type(actual_ty) {
        if not v4_ty_is_lend_type(expected_ty) or not v4_ty_is_lend_type(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_lend_mode(expected_ty) != v4_ty_lend_mode(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot expected_lifetime = v4_ty_lend_lifetime(expected_ty)
        if expected_lifetime != "" {
            pilot actual_lifetime = v4_ty_lend_lifetime(actual_ty)
            if actual_lifetime != "" and actual_lifetime != "'_" {
                next_env = v4_ty_match_signature_type_env_mode(ty_id, sig_id, expected_lifetime, actual_lifetime, next_env, false)
                if next_env == v4_ty_generic_env_fail {
                    give back next_env
                }
            }
        }
        give back v4_ty_match_signature_type_env_mode(ty_id, sig_id, v4_ty_lend_target_type(expected_ty), v4_ty_lend_target_type(actual_ty), next_env, allow_dyn_coerce)
    }
    if v4_ty_is_dyn_type(expected_ty) {
        if allow_dyn_coerce or v4_ty_is_dyn_type(actual_ty) {
            give back v4_ty_match_type_can_coerce_to_dyn_env(ty_id, sig_id, expected_ty, actual_ty, env)
        }
        give back v4_ty_generic_env_fail
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_raw_pointer_type(expected_ty) and v4_ty_is_raw_pointer_type(actual_ty) {
        if v4_ty_raw_pointer_prefix(expected_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env_mode(ty_id, sig_id, v4_ty_raw_pointer_target_type(expected_ty), v4_ty_raw_pointer_target_type(actual_ty), env, false)
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        pilot base_name = v4_ty_generic_base_name(expected_ty)
        repeat until arg_idx >= arg_count {
            pilot expected_arg = v4_ty_generic_arg(expected_ty, arg_idx)
            pilot actual_arg = v4_ty_generic_arg(actual_ty, arg_idx)
            if v4_ty_is_dyn_type(expected_arg) and not v4_ty_is_dyn_type(actual_arg) {
                if allow_dyn_coerce and v4_ty_is_nominal_prelude_dyn_carrier(ty_id, expected_ty) {
                    next_env = v4_ty_match_signature_type_env_mode(ty_id, sig_id, expected_arg, actual_arg, next_env, true)
                } else {
                    give back v4_ty_generic_env_fail
                }
            } else {
                next_env = v4_ty_match_signature_type_env_mode(ty_id, sig_id, expected_arg, actual_arg, next_env, false)
            }
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(expected_ty) and v4_ty_is_tuple_type(actual_ty) {
        if v4_ty_tuple_slot_count(expected_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(expected_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_signature_type_env_mode(ty_id, sig_id, v4_ty_tuple_slot_type(expected_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env, false)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(expected_ty) and v4_ty_is_fixed_array_type(actual_ty) {
        if v4_ty_fixed_array_length_normalized_text(ty_id, expected_ty) != v4_ty_fixed_array_length_normalized_text(ty_id, actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env_mode(ty_id, sig_id, v4_ty_fixed_array_element_type(expected_ty), v4_ty_fixed_array_element_type(actual_ty), env, false)
    }
    if v4_ty_types_compatible(expected_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_match_signature_type_env(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    give back v4_ty_match_signature_type_env_mode(ty_id, sig_id, expected_ty, actual_ty, env, true)
}

task v4_ty_match_signature_type_env_no_dyn_coerce(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    give back v4_ty_match_signature_type_env_mode(ty_id, sig_id, expected_ty, actual_ty, env, false)
}

task v4_ty_signature_generic_identity_env(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back v4_ty_generic_env_fail
    }
    pilot env = ""
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
        if generic_name == "" {
            give back v4_ty_generic_env_fail
        }
        env = v4_ty_generic_env_bind(env, generic_name, generic_name)
        if env == v4_ty_generic_env_fail {
            give back env
        }
        generic_id += 1
    }
    give back env
}

task v4_ty_types_same_in_signature(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    pilot identity_env = v4_ty_signature_generic_identity_env(ty_id, sig_id)
    if identity_env == v4_ty_generic_env_fail { give back false }
    give back v4_ty_match_signature_type_env(ty_id, sig_id, expected_ty, actual_ty, identity_env) != v4_ty_generic_env_fail
}

task v4_ty_types_compatible_in_signature(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    give back v4_ty_match_signature_type_env(ty_id, sig_id, expected_ty, actual_ty, "") != v4_ty_generic_env_fail
}

task v4_ty_apply_generic_env(type_text: word, env: word) -> word {
    if env == "" or env == v4_ty_generic_env_fail or type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }

    pilot mapped = v4_ty_generic_env_lookup(env, type_text)
    if mapped != "" {
        give back mapped
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_dyn_type(v4_ty_apply_generic_env(v4_ty_dyn_doctrine_name(type_text), env))
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        pilot out = "task("
        if v4_ty_is_surface_extern_function_pointer_type(type_text) {
            out = "extern[" + v4_ty_function_type_abi_specs(type_text) + "]task("
        }
        pilot param_id = 0
        pilot param_count = v4_ty_function_type_param_count(type_text)
        repeat until param_id >= param_count {
            if param_id > 0 {
                out = out + ","
            }
            pilot param_name = v4_ty_function_type_param_name(type_text, param_id)
            pilot param_surface = v4_ty_function_type_param_surface(type_text, param_id)
            if param_name != "" {
                out = out + param_name + ":"
            }
            if param_surface == "..." {
                out = out + "..."
            } else {
                out = out + v4_ty_apply_generic_env(param_surface, env)
            }
            param_id += 1
        }
        out = out + ")->" + v4_ty_apply_generic_env(v4_ty_function_type_return_text(type_text), env)
        give back out
    }
    if v4_ty_is_lend_type(type_text) {
        pilot lifetime_name = v4_ty_lend_lifetime(type_text)
        if lifetime_name != "" {
            lifetime_name = v4_ty_apply_generic_env(lifetime_name, env)
        }
        give back v4_ty_lend_type_with_lifetime(v4_ty_apply_generic_env(v4_ty_lend_target_type(type_text), env), v4_ty_lend_mode(type_text), lifetime_name)
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_raw_pointer_with_target_type(type_text, v4_ty_apply_generic_env(v4_ty_raw_pointer_target_type(type_text), env))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot out = v4_ty_generic_base_name(type_text) + "<"
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if arg_idx > 0 {
                out = out + ","
            }
            out = out + v4_ty_apply_generic_env(v4_ty_generic_arg(type_text, arg_idx), env)
            arg_idx += 1
        }
        out = out + ">"
        give back out
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot out = "("
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if slot_idx > 0 {
                out = out + ","
            }
            out = out + v4_ty_apply_generic_env(v4_ty_tuple_slot_type(type_text, slot_idx), env)
            slot_idx += 1
        }
        out = out + ")"
        give back out
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back "[" + v4_ty_apply_generic_env(v4_ty_fixed_array_element_type(type_text), env) + ";" + v4_ty_strip_const_expr_wrappers(v4_ty_fixed_array_length_text(type_text)) + "]"
    }
    give back type_text
}

task v4_ty_type_mentions_signature_generics(ty_id: int, sig_id: int, type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text) or v4_ty_signature_declares_lifetime_name(ty_id, sig_id, type_text) {
        give back true
    }
    if v4_ty_is_lend_type(type_text) {
        pilot lifetime_name = v4_ty_lend_lifetime(type_text)
        if lifetime_name != "" and v4_ty_signature_declares_lifetime_name(ty_id, sig_id, lifetime_name) {
            give back true
        }
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        pilot param_id = 0
        pilot param_count = v4_ty_function_type_param_count(type_text)
        repeat until param_id >= param_count {
            pilot param_surface = v4_ty_function_type_param_surface(type_text, param_id)
            if param_surface != "..." and v4_ty_type_mentions_signature_generics(ty_id, sig_id, param_surface) {
                give back true
            }
            param_id += 1
        }
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_function_type_return_text(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_dyn_doctrine_name(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_generic_arg(type_text, arg_idx)) {
                give back true
            }
            arg_idx += 1
        }
        give back false
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_tuple_slot_type(type_text, slot_idx)) {
                give back true
            }
            slot_idx += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_fixed_array_element_type(type_text))
    }
    give back false
}

task v4_ty_signature_generic_env_for_instance(ty_id: int, sig_id: int, instance_ty: word) -> word {
    if not v4_ty_is_generic_instance_type(instance_ty) {
        give back ""
    }
    if v4_ty_signature_generic_count(ty_id, sig_id) != v4_ty_generic_arg_count(instance_ty) {
        give back v4_ty_generic_env_fail
    }

    pilot env = ""
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)
        pilot actual_ty = v4_ty_generic_arg(instance_ty, generic_idx)
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) {
            if not v4_ty_is_lifetime_name(actual_ty) {
                give back v4_ty_generic_env_fail
            }
        } else if v4_ty_is_lifetime_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        env = v4_ty_generic_env_bind(env, generic_name, actual_ty)
        if env == v4_ty_generic_env_fail {
            give back env
        }
        generic_idx += 1
    }
    give back env
}

task v4_ty_signature_generic_env_complete(ty_id: int, sig_id: int, env: word) -> bool {
    if env == v4_ty_generic_env_fail {
        give back false
    }
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        pilot actual_ty = v4_ty_generic_env_lookup(env, v4_ty_signature_generic_name(ty_id, sig_id, generic_idx))
        if actual_ty == "" {
            give back false
        }
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) {
            if not v4_ty_is_lifetime_name(actual_ty) {
                give back false
            }
        } else if v4_ty_is_lifetime_name(actual_ty) {
            give back false
        }
        generic_idx += 1
    }
    give back true
}

task v4_ty_signature_instance_type_for_env(ty_id: int, sig_id: int, env: word) -> word {
    pilot name = v4_ty_signature_name(ty_id, sig_id)
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    if generic_count <= 0 {
        give back name
    }

    pilot out = name + "<"
    pilot generic_idx = 0
    repeat until generic_idx >= generic_count {
        if generic_idx > 0 {
            out = out + ","
        }
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)
        pilot actual_ty = v4_ty_generic_env_lookup(env, generic_name)
        if actual_ty == "" {
            actual_ty = generic_name
        }
        out = out + actual_ty
        generic_idx += 1
    }
    give back out + ">"
}

task v4_ty_apply_signature_generics(ty_id: int, sig_id: int, instance_ty: word, member_ty: word) -> word {
    give back v4_ty_apply_generic_env(member_ty, v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_ty))
}

task v4_ty_signature_return_type_for_env(ty_id: int, sig_id: int, env: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_generic_env(v4_ty_signature_return_type(ty_id, sig_id), env))
}

task v4_ty_list_element_type(container_ty: word) -> word {
    if container_ty.length() >= 6 {
        if container_ty.char_at(0) == "L" and container_ty.char_at(1) == "i" and container_ty.char_at(2) == "s" and container_ty.char_at(3) == "t" and container_ty.char_at(4) == "<" and container_ty.char_at(container_ty.length() - 1) == ">" {
            give back v4_slice(container_ty, 5, container_ty.length() - 1)
        }
    }
    give back v4_ty_unknown
}

task v4_ty_is_maybe_type(container_ty: word) -> bool {
    if container_ty.length() < 8 {
        give back false
    }
    if container_ty.char_at(0) != "m" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "y" or container_ty.char_at(3) != "b" or container_ty.char_at(4) != "e" or container_ty.char_at(5) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back false
    }
    give back true
}

task v4_ty_maybe_value_type(container_ty: word) -> word {
    if v4_ty_is_maybe_type(container_ty) {
        give back v4_slice(container_ty, 6, container_ty.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_is_result_type(container_ty: word) -> bool {
    if container_ty.length() < 11 {
        give back false
    }
    if container_ty.char_at(0) != "r" or container_ty.char_at(1) != "e" or container_ty.char_at(2) != "s" or container_ty.char_at(3) != "u" or container_ty.char_at(4) != "l" or container_ty.char_at(5) != "t" or container_ty.char_at(6) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back false
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    give back comma > 7
}

task v4_ty_result_ok_type(container_ty: word) -> word {
    if not v4_ty_is_result_type(container_ty) {
        give back v4_ty_unknown
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    if comma <= 7 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, 7, comma)
}

task v4_ty_result_err_type(container_ty: word) -> word {
    if not v4_ty_is_result_type(container_ty) {
        give back v4_ty_unknown
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    if comma < 0 or comma + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, comma + 1, container_ty.length() - 1)
}

task v4_ty_maybe_type(inner_ty: word) -> word {
    give back "maybe<" + inner_ty + ">"
}

task v4_ty_result_type(ok_ty: word, err_ty: word) -> word {
    give back "result<" + ok_ty + "," + err_ty + ">"
}

task v4_ty_is_tuple_type(tuple_ty: word) -> bool {
    if tuple_ty.length() < 5 {
        give back false
    }
    if tuple_ty.char_at(0) != "(" or tuple_ty.char_at(tuple_ty.length() - 1) != ")" {
        give back false
    }
    give back v4_ty_find_top_level_type_char(tuple_ty, ",", 1, tuple_ty.length() - 1) > 1
}

task v4_ty_tuple_slot_count(tuple_ty: word) -> int {
    if not v4_ty_is_tuple_type(tuple_ty) {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= tuple_ty.length() - 1 {
        pilot ch = tuple_ty.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_tuple_slot_type(tuple_ty: word, slot_id: int) -> word {
    if not v4_ty_is_tuple_type(tuple_ty) or slot_id < 0 {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= tuple_ty.length() - 1 {
        pilot ch = tuple_ty.char_at(idx)
        if depth == 0 and ch == "," {
            if current == slot_id {
                give back v4_slice(tuple_ty, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == slot_id and segment_start < tuple_ty.length() - 1 {
        give back v4_slice(tuple_ty, segment_start, tuple_ty.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_array_separator(container_ty: word) -> int {
    if container_ty.length() < 4 {
        give back 0 - 1
    }
    if container_ty.char_at(0) != "[" or container_ty.char_at(container_ty.length() - 1) != "]" {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_type_char(container_ty, ";", 1, container_ty.length() - 1)
}

task v4_ty_is_fixed_array_type(container_ty: word) -> bool {
    give back v4_ty_fixed_array_separator(container_ty) > 1
}

task v4_ty_fixed_array_element_type(container_ty: word) -> word {
    pilot separator = v4_ty_fixed_array_separator(container_ty)
    if separator > 1 {
        give back v4_slice(container_ty, 1, separator)
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_array_length_text(container_ty: word) -> word {
    pilot separator = v4_ty_fixed_array_separator(container_ty)
    if separator < 0 or separator + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, separator + 1, container_ty.length() - 1)
}

task v4_ty_fixed_array_length_normalized_text(ty_id: int, container_ty: word) -> word {
    pilot raw = v4_ty_fixed_array_length_text(container_ty)
    if raw == "" or raw == v4_ty_unknown {
        give back v4_ty_unknown
    }
    pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, raw)
    if resolved != v4_ty_unknown {
        give back resolved
    }
    give back v4_ty_strip_const_expr_wrappers(raw)
}

task v4_ty_map_key_type(container_ty: word) -> word {
    if container_ty.length() < 7 {
        give back v4_ty_unknown
    }
    if container_ty.char_at(0) != "M" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "p" or container_ty.char_at(3) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back v4_ty_unknown
    }

    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 4, container_ty.length() - 1)
    if comma <= 4 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, 4, comma)
}

task v4_ty_map_value_type(container_ty: word) -> word {
    if container_ty.length() < 7 {
        give back v4_ty_unknown
    }
    if container_ty.char_at(0) != "M" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "p" or container_ty.char_at(3) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back v4_ty_unknown
    }

    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 4, container_ty.length() - 1)
    if comma < 0 or comma + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, comma + 1, container_ty.length() - 1)
}

task v4_ty_index_element_type(container_ty: word) -> word {
    pilot list_element_ty = v4_ty_list_element_type(container_ty)
    if v4_ty_is_known(list_element_ty) {
        give back list_element_ty
    }

    pilot map_value_ty = v4_ty_map_value_type(container_ty)
    if v4_ty_is_known(map_value_ty) {
        give back map_value_ty
    }

    pilot array_element_ty = v4_ty_fixed_array_element_type(container_ty)
    if v4_ty_is_known(array_element_ty) {
        give back array_element_ty
    }

    give back v4_ty_unknown
}

task v4_ty_add_signature(ty_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> int {
    pilot sig_id = v4_ty_signature_count(ty_id)
    if v4_ty_child_handle_ensure_slot(v4_ty_defs_handle(ty_id), sig_id, "") == false {
        give back 0 - 1
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_kinds_handle(ty_id), sig_id, "") == false {
        give back 0 - 1
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_names_handle(ty_id), sig_id, "") == false {
        give back 0 - 1
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_displays_handle(ty_id), sig_id, "") == false {
        give back 0 - 1
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_hir_items_handle(ty_id), sig_id, word_from_int(0 - 1)) == false {
        give back 0 - 1
    }
    array_set(v4_ty_defs_handle(ty_id), sig_id, def_id)
    array_set(v4_ty_kinds_handle(ty_id), sig_id, sig_kind)
    array_set(v4_ty_names_handle(ty_id), sig_id, sig_name)
    array_set(v4_ty_displays_handle(ty_id), sig_id, sig_display)
    array_set(v4_ty_hir_items_handle(ty_id), sig_id, word_from_int(hir_item))
    array_set(v4_ty_signature_active_counts, ty_id, word_from_int(sig_id + 1))
    give back sig_id
}

task v4_ty_lower_resolve(file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    pilot ty_id = v4_ty_file_new(file_id, resolve_id)
    v4_ty_copy_resolve_diags(ty_id, resolve_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)

    pilot symbol_idx = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    repeat until symbol_idx >= symbol_count {
        pilot symbol_kind = v4_resolve_symbol_kind(resolve_id, symbol_idx)
        pilot symbol_name = v4_resolve_symbol_name(resolve_id, symbol_idx)
        pilot symbol_def = v4_resolve_symbol_def(resolve_id, symbol_idx)
        pilot hir_item = v4_resolve_symbol_hir_item(resolve_id, symbol_idx)
        if symbol_def == "" or v4_ty_lookup_signature(ty_id, symbol_def) < 0 {
            pilot sig_kind = v4_ty_kind_for_symbol(symbol_kind)
            pilot sig_display = v4_ty_display_for_hir_item(symbol_kind, symbol_name, symbol_def, hir_id, hir_item)
            v4_ty_add_signature(ty_id, symbol_def, sig_kind, symbol_name, sig_display, hir_item)
        }
        symbol_idx += 1
    }

    v4_ty_validate_closure_params(ty_id)
    v4_ty_validate_lifetime_contracts(ty_id)
    v4_ty_validate_repr_contracts(ty_id)
    v4_ty_validate_layout_contracts(ty_id)
    v4_ty_validate_extern_ffi_contracts(ty_id)
    v4_ty_validate_extern_callback_export_contracts(ty_id)
    v4_ty_validate_alias_cycles(ty_id)
    v4_ty_validate_alias_nominality(ty_id)
    v4_ty_validate_direct_type_recursion(ty_id)
    v4_ty_validate_const_cycles(ty_id)
    v4_ty_validate_const_initializers(ty_id)
    give back ty_id
}

task v4_ty_lookup_signature(ty_id: int, def_id: word) -> int {
    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        if v4_ty_signature_def(ty_id, sig_idx) == def_id {
            give back sig_idx
        }
        sig_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_of(ty_id: int, def_id: word) -> word {
    pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
    if sig_id < 0 {
        give back ""
    }
    give back v4_ty_signature_display(ty_id, sig_id)
}

task v4_ty_summary(ty_id: int) -> word {
    pilot summary = "ty-ok ty=" + word_from_int(ty_id)
    summary = summary + " signatures=" + word_from_int(v4_ty_signature_count(ty_id))
    summary = summary + " diagnostics=" + word_from_int(v4_ty_diag_count(ty_id))
    give back summary
}

task v4_ty_snapshot_escape(value: word) -> word {
    give back v4_resolve_snapshot_escape(value)
}

task v4_ty_snapshot_unescape(value: word) -> word {
    give back v4_resolve_snapshot_unescape(value)
}

task v4_ty_snapshot_line_count(payload: word) -> int {
    give back v4_resolve_snapshot_line_count(payload)
}

task v4_ty_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_resolve_snapshot_line(payload, wanted)
}

task v4_ty_snapshot_field_count(line: word) -> int {
    give back v4_resolve_snapshot_field_count(line)
}

task v4_ty_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_resolve_snapshot_field_raw(line, wanted)
}

task v4_ty_snapshot_field(line: word, wanted: int) -> word {
    give back v4_resolve_snapshot_field(line, wanted)
}

task v4_ty_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_resolve_snapshot_key_value(line, wanted_key)
}

task v4_ty_snapshot_signature_total() -> int {
    v4_ty_init()
    pilot total = 0
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        total += v4_ty_signature_count(ty_id)
        ty_id += 1
    }
    give back total
}

task v4_ty_snapshot_diag_total() -> int {
    v4_ty_init()
    pilot total = 0
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        total += v4_ty_diag_count(ty_id)
        ty_id += 1
    }
    give back total
}

task v4_ty_snapshot_summary() -> word {
    pilot summary = "ty-snapshot"
    summary = summary + " format=" + v4_ty_snapshot_format
    summary = summary + " files=" + word_from_int(v4_ty_file_count())
    summary = summary + " signatures=" + word_from_int(v4_ty_snapshot_signature_total())
    summary = summary + " diagnostics=" + word_from_int(v4_ty_snapshot_diag_total())
    give back summary
}

task v4_ty_snapshot_header() -> word {
    pilot out = "ty-snapshot"
    out = out + "|format=" + v4_ty_snapshot_format
    out = out + "|files=" + word_from_int(v4_ty_file_count())
    out = out + "|signatures=" + word_from_int(v4_ty_snapshot_signature_total())
    out = out + "|diagnostics=" + word_from_int(v4_ty_snapshot_diag_total())
    give back out
}

task v4_ty_snapshot_file_line(ty_id: int) -> word {
    pilot out = "ty"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(v4_ty_file_id(ty_id))
    out = out + "|" + word_from_int(v4_ty_resolve_id(ty_id))
    out = out + "|" + word_from_int(v4_ty_signature_count(ty_id))
    out = out + "|" + word_from_int(v4_ty_diag_count(ty_id))
    give back out
}

task v4_ty_snapshot_signature_line(ty_id: int, sig_id: int) -> word {
    pilot out = "signature"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(sig_id)
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_def(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_kind(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_name(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_source_display(ty_id, sig_id))
    out = out + "|" + word_from_int(v4_ty_signature_hir_item(ty_id, sig_id))
    give back out
}

task v4_ty_snapshot_diag_line(ty_id: int, diag_id: int) -> word {
    pilot out = "ty-diag"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_diag(ty_id, diag_id))
    give back out
}

task v4_ty_snapshot() -> word {
    v4_ty_init()
    pilot parts = array_new()
    array_push(parts, v4_ty_snapshot_header())
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        array_push(parts, "\n")
        array_push(parts, v4_ty_snapshot_file_line(ty_id))

        pilot sig_id = 0
        pilot sig_count = v4_ty_signature_count(ty_id)
        repeat until sig_id >= sig_count {
            array_push(parts, "\n")
            array_push(parts, v4_ty_snapshot_signature_line(ty_id, sig_id))
            sig_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_ty_diag_count(ty_id)
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_ty_snapshot_diag_line(ty_id, diag_id))
            diag_id += 1
        }
        ty_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_ty_snapshot_format)
    give back word_join(parts)
}

task v4_ty_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "ty-snapshot" {
        give back 5
    }
    if kind == "ty" {
        give back 6
    }
    if kind == "signature" {
        give back 8
    }
    if kind == "ty-diag" {
        give back 4
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_ty_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_ty_snapshot_field_raw(line, 0)
    pilot expected = v4_ty_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_ty_snapshot_field_count(line) != expected {
        give back false
    }
    give back true
}

task v4_ty_snapshot_integer_is_canonical(value: word, allow_negative: bool) -> bool {
    if value == "" {
        give back false
    }
    pilot parsed = word_to_int(value)
    if word_from_int(parsed) != value {
        give back false
    }
    if allow_negative == false and parsed < 0 {
        give back false
    }
    give back true
}

task v4_ty_snapshot_field_has_key(line: word, field_id: int, wanted_key: word) -> bool {
    give back v4_ty_snapshot_field_raw(line, field_id).starts_with(wanted_key + "=")
}

task v4_ty_snapshot_signature_kind_is_supported(sig_kind: word) -> bool {
    if sig_kind == v4_ty_task_sig { give back true }
    if sig_kind == v4_ty_const_sig { give back true }
    if sig_kind == v4_ty_shape_sig { give back true }
    if sig_kind == v4_ty_route_sig { give back true }
    if sig_kind == v4_ty_alias_sig { give back true }
    if sig_kind == v4_ty_doctrine_sig { give back true }
    if sig_kind == v4_ty_extern_sig { give back true }
    if sig_kind == v4_ty_import_sig { give back true }
    if sig_kind == v4_ty_attribute_sig { give back true }
    if sig_kind == v4_ty_error_sig { give back true }
    give back false
}

task v4_ty_snapshot_parent_chain_matches(file_id: int, resolve_id: int) -> bool {
    if file_id < 0 or file_id >= v4_source_count() {
        give back false
    }
    if v4_resolve_exists(resolve_id) == false {
        give back false
    }
    if v4_resolve_file_id(resolve_id) != file_id {
        give back false
    }

    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) == false {
        give back false
    }
    if v4_hir_file_id(hir_id) != file_id {
        give back false
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back false
    }
    if v4_parse_file_id(tree_id) != file_id {
        give back false
    }

    pilot stream_id = v4_parse_stream_id(tree_id)
    if v4_lex_stream_exists(stream_id) == false {
        give back false
    }
    give back v4_lex_stream_file(stream_id) == file_id
}

task v4_ty_snapshot_resolve_symbol_is_signature_head(resolve_id: int, symbol_id: int) -> bool {
    if v4_resolve_exists(resolve_id) == false {
        give back false
    }
    if symbol_id < 0 or symbol_id >= v4_resolve_symbol_count(resolve_id) {
        give back false
    }
    pilot def_id = v4_resolve_symbol_def(resolve_id, symbol_id)
    if def_id == "" {
        give back true
    }
    pilot prior_id = 0
    repeat until prior_id >= symbol_id {
        if v4_resolve_symbol_def(resolve_id, prior_id) == def_id {
            give back false
        }
        prior_id += 1
    }
    give back true
}

task v4_ty_snapshot_expected_signature_count(resolve_id: int) -> int {
    if v4_resolve_exists(resolve_id) == false {
        give back 0
    }
    pilot count = 0
    pilot symbol_id = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    repeat until symbol_id >= symbol_count {
        if v4_ty_snapshot_resolve_symbol_is_signature_head(resolve_id, symbol_id) {
            count += 1
        }
        symbol_id += 1
    }
    give back count
}

task v4_ty_snapshot_signature_display_matches(sig_kind: word, expected_display: word, sig_display: word) -> bool {
    give back sig_display == expected_display
}

task v4_ty_snapshot_signature_matches_resolve(resolve_id: int, hir_id: int, sig_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> bool {
    if v4_ty_snapshot_signature_kind_is_supported(sig_kind) == false {
        give back false
    }
    if v4_resolve_exists(resolve_id) == false or v4_hir_file_exists(hir_id) == false {
        give back false
    }
    if v4_resolve_hir_id(resolve_id) != hir_id {
        give back false
    }
    if hir_item < 0 or hir_item >= v4_hir_item_count(hir_id) {
        give back false
    }

    pilot symbol_id = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    pilot canonical_sig_id = 0
    repeat until symbol_id >= symbol_count {
        if v4_ty_snapshot_resolve_symbol_is_signature_head(resolve_id, symbol_id) {
            if canonical_sig_id == sig_id {
                pilot symbol_kind = v4_resolve_symbol_kind(resolve_id, symbol_id)
                if v4_ty_kind_for_symbol(symbol_kind) == sig_kind {
                    if v4_resolve_symbol_def(resolve_id, symbol_id) == def_id {
                        if v4_resolve_symbol_name(resolve_id, symbol_id) == sig_name {
                            if v4_resolve_symbol_hir_item(resolve_id, symbol_id) == hir_item {
                                pilot hir_linked = false
                                hir_linked = v4_hir_item_def(hir_id, hir_item) == def_id
                                if v4_resolve_is_extern_member_def(def_id) {
                                    pilot extern_member_id = v4_resolve_extern_member_id_from_def(def_id)
                                    hir_linked = v4_hir_item_kind(hir_id, hir_item) == v4_hir_extern
                                    hir_linked = hir_linked and extern_member_id >= 0
                                    hir_linked = hir_linked and extern_member_id < v4_hir_extern_member_count(hir_id, hir_item)
                                }
                                if hir_linked {
                                    pilot expected_display = v4_ty_display_for_hir_item(symbol_kind, sig_name, def_id, hir_id, hir_item)
                                    give back v4_ty_snapshot_signature_display_matches(sig_kind, expected_display, sig_display)
                                }
                            }
                        }
                    }
                }
                give back false
            }
            canonical_sig_id += 1
        }
        symbol_id += 1
    }
    give back false
}

-- Validate the canonical parent-first record stream before restore mutates TY.
task v4_ty_snapshot_validate_mode(payload: word, require_live_context: bool) -> word {
    pilot lines = v4_ty_snapshot_line_count(payload)
    pilot files = 0
    pilot signatures = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot saw_nonempty = 0
    pilot format = ""
    pilot declared_files = 0 - 1
    pilot declared_signatures = 0 - 1
    pilot declared_diagnostics = 0 - 1
    pilot current_ty_id = 0 - 1
    pilot current_declared_signatures = 0
    pilot current_declared_diagnostics = 0
    pilot current_signature_count = 0
    pilot current_diag_count = 0
    pilot current_resolve_id = 0 - 1
    pilot current_hir_id = 0 - 1

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_ty_snapshot_field_raw(line, 0)
            if saw_end > 0 {
                malformed += 1
            }
            if v4_ty_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "ty-snapshot" {
                if saw_nonempty != 0 {
                    malformed += 1
                }
                saw_header += 1
                format = v4_ty_snapshot_key_value(line, "format")
                pilot declared_files_text = v4_ty_snapshot_key_value(line, "files")
                pilot declared_signatures_text = v4_ty_snapshot_key_value(line, "signatures")
                pilot declared_diagnostics_text = v4_ty_snapshot_key_value(line, "diagnostics")
                if v4_ty_snapshot_field_has_key(line, 1, "format") == false {
                    malformed += 1
                }
                if v4_ty_snapshot_field_has_key(line, 2, "files") == false {
                    malformed += 1
                }
                if v4_ty_snapshot_field_has_key(line, 3, "signatures") == false {
                    malformed += 1
                }
                if v4_ty_snapshot_field_has_key(line, 4, "diagnostics") == false {
                    malformed += 1
                }
                if format != v4_ty_snapshot_format {
                    malformed += 1
                }
                if v4_ty_snapshot_integer_is_canonical(declared_files_text, false) == false {
                    malformed += 1
                } else {
                    declared_files = word_to_int(declared_files_text)
                }
                if v4_ty_snapshot_integer_is_canonical(declared_signatures_text, false) == false {
                    malformed += 1
                } else {
                    declared_signatures = word_to_int(declared_signatures_text)
                }
                if v4_ty_snapshot_integer_is_canonical(declared_diagnostics_text, false) == false {
                    malformed += 1
                } else {
                    declared_diagnostics = word_to_int(declared_diagnostics_text)
                }
            } else if kind == "ty" {
                if saw_header != 1 {
                    malformed += 1
                }
                if current_ty_id >= 0 {
                    if current_signature_count != current_declared_signatures {
                        malformed += 1
                    }
                    if current_diag_count != current_declared_diagnostics {
                        malformed += 1
                    }
                }
                pilot ty_id_text = v4_ty_snapshot_field_raw(line, 1)
                pilot file_id_text = v4_ty_snapshot_field_raw(line, 2)
                pilot resolve_id_text = v4_ty_snapshot_field_raw(line, 3)
                pilot file_signatures_text = v4_ty_snapshot_field_raw(line, 4)
                pilot file_diagnostics_text = v4_ty_snapshot_field_raw(line, 5)
                pilot ty_record_ids_valid = true
                if v4_ty_snapshot_integer_is_canonical(ty_id_text, false) == false {
                    malformed += 1
                    ty_record_ids_valid = false
                }
                if v4_ty_snapshot_integer_is_canonical(file_id_text, false) == false {
                    malformed += 1
                    ty_record_ids_valid = false
                }
                if v4_ty_snapshot_integer_is_canonical(resolve_id_text, false) == false {
                    malformed += 1
                    ty_record_ids_valid = false
                }
                if v4_ty_snapshot_integer_is_canonical(file_signatures_text, false) == false {
                    malformed += 1
                    ty_record_ids_valid = false
                }
                if v4_ty_snapshot_integer_is_canonical(file_diagnostics_text, false) == false {
                    malformed += 1
                    ty_record_ids_valid = false
                }
                current_ty_id = 0 - 1
                current_resolve_id = 0 - 1
                current_hir_id = 0 - 1
                current_declared_signatures = 0
                current_declared_diagnostics = 0
                current_signature_count = 0
                current_diag_count = 0
                if ty_record_ids_valid {
                    current_ty_id = word_to_int(ty_id_text)
                    pilot current_file_id = word_to_int(file_id_text)
                    current_resolve_id = word_to_int(resolve_id_text)
                    current_declared_signatures = word_to_int(file_signatures_text)
                    current_declared_diagnostics = word_to_int(file_diagnostics_text)
                    if current_ty_id != files {
                        malformed += 1
                    }
                    if require_live_context {
                        if v4_ty_snapshot_parent_chain_matches(current_file_id, current_resolve_id) == false {
                            malformed += 1
                            current_resolve_id = 0 - 1
                        } else {
                            current_hir_id = v4_resolve_hir_id(current_resolve_id)
                            if current_declared_signatures != v4_ty_snapshot_expected_signature_count(current_resolve_id) {
                                malformed += 1
                            }
                        }
                    }
                }
                files += 1
            } else if kind == "signature" {
                if saw_header != 1 {
                    malformed += 1
                }
                pilot signature_ty_text = v4_ty_snapshot_field_raw(line, 1)
                pilot sig_id_text = v4_ty_snapshot_field_raw(line, 2)
                pilot hir_item_text = v4_ty_snapshot_field_raw(line, 7)
                pilot signature_ids_valid = true
                if v4_ty_snapshot_integer_is_canonical(signature_ty_text, false) == false {
                    malformed += 1
                    signature_ids_valid = false
                }
                if v4_ty_snapshot_integer_is_canonical(sig_id_text, false) == false {
                    malformed += 1
                    signature_ids_valid = false
                }
                if v4_ty_snapshot_integer_is_canonical(hir_item_text, false) == false {
                    malformed += 1
                    signature_ids_valid = false
                }
                if current_ty_id < 0 {
                    malformed += 1
                    signature_ids_valid = false
                }
                if require_live_context and (current_resolve_id < 0 or current_hir_id < 0) {
                    malformed += 1
                    signature_ids_valid = false
                }
                if signature_ids_valid {
                    pilot signature_ty_id = word_to_int(signature_ty_text)
                    pilot sig_id = word_to_int(sig_id_text)
                    pilot hir_item = word_to_int(hir_item_text)
                    if signature_ty_id != current_ty_id {
                        malformed += 1
                    }
                    if sig_id != current_signature_count {
                        malformed += 1
                    }
                    pilot def_id = v4_ty_snapshot_field(line, 3)
                    pilot sig_kind = v4_ty_snapshot_field(line, 4)
                    pilot sig_name = v4_ty_snapshot_field(line, 5)
                    pilot sig_display = v4_ty_snapshot_field(line, 6)
                    if require_live_context {
                        if v4_ty_snapshot_signature_matches_resolve(current_resolve_id, current_hir_id, sig_id, def_id, sig_kind, sig_name, sig_display, hir_item) == false {
                            malformed += 1
                        }
                    } else {
                        if v4_ty_snapshot_signature_kind_is_supported(sig_kind) == false {
                            malformed += 1
                        }
                    }
                }
                if current_diag_count > 0 {
                    malformed += 1
                }
                if current_signature_count >= current_declared_signatures {
                    malformed += 1
                }
                current_signature_count += 1
                signatures += 1
            } else if kind == "ty-diag" {
                if saw_header != 1 {
                    malformed += 1
                }
                pilot diag_ty_text = v4_ty_snapshot_field_raw(line, 1)
                pilot diag_id_text = v4_ty_snapshot_field_raw(line, 2)
                if v4_ty_snapshot_integer_is_canonical(diag_ty_text, false) == false {
                    malformed += 1
                }
                if v4_ty_snapshot_integer_is_canonical(diag_id_text, false) == false {
                    malformed += 1
                }
                if current_ty_id < 0 {
                    malformed += 1
                }
                if word_to_int(diag_ty_text) != current_ty_id {
                    malformed += 1
                }
                if current_signature_count != current_declared_signatures {
                    malformed += 1
                }
                if word_to_int(diag_id_text) != current_diag_count {
                    malformed += 1
                }
                if current_diag_count >= current_declared_diagnostics {
                    malformed += 1
                }
                current_diag_count += 1
                diagnostics += 1
            } else if kind == "end" {
                if saw_header != 1 {
                    malformed += 1
                }
                if current_ty_id >= 0 {
                    if current_signature_count != current_declared_signatures {
                        malformed += 1
                    }
                    if current_diag_count != current_declared_diagnostics {
                        malformed += 1
                    }
                }
                saw_end += 1
                if v4_ty_snapshot_field(line, 1) != v4_ty_snapshot_format {
                    malformed += 1
                }
            }
            saw_nonempty += 1
        }
        line_id += 1
    }

    if current_ty_id >= 0 {
        if current_signature_count != current_declared_signatures {
            malformed += 1
        }
        if current_diag_count != current_declared_diagnostics {
            malformed += 1
        }
    }
    if declared_files != files {
        malformed += 1
    }
    if declared_signatures != signatures {
        malformed += 1
    }
    if declared_diagnostics != diagnostics {
        malformed += 1
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }

    pilot out = "ty-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " signatures=" + word_from_int(signatures)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_ty_snapshot_validate(payload: word) -> word {
    give back v4_ty_snapshot_validate_mode(payload, true)
}

task v4_ty_snapshot_validate_detached(payload: word) -> word {
    give back v4_ty_snapshot_validate_mode(payload, false)
}

task v4_ty_restore_clear_child_handle(handle: int, empty_value: word) -> void {
    pilot child_id = 0
    repeat until child_id >= array_len(handle) {
        array_set(handle, child_id, empty_value)
        child_id += 1
    }
}

task v4_ty_restore_clear_file_children(ty_id: int) -> void {
    v4_ty_restore_clear_child_handle(v4_ty_defs_handle(ty_id), "")
    v4_ty_restore_clear_child_handle(v4_ty_kinds_handle(ty_id), "")
    v4_ty_restore_clear_child_handle(v4_ty_names_handle(ty_id), "")
    v4_ty_restore_clear_child_handle(v4_ty_displays_handle(ty_id), "")
    v4_ty_restore_clear_child_handle(v4_ty_hir_items_handle(ty_id), word_from_int(0 - 1))
    v4_ty_restore_clear_child_handle(v4_ty_diags_handle(ty_id), "")
    array_set(v4_ty_signature_active_counts, ty_id, "0")
    array_set(v4_ty_diag_active_counts, ty_id, "0")
}

task v4_ty_restore_file_slot(ty_id: int, file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    if ty_id < 0 {
        give back 0 - 1
    }
    v4_ty_copy_doctrine_cache_reset()
    v4_ty_borrowed_return_source_cache_invalidate_file(ty_id)
    repeat until array_len(v4_ty_files) > ty_id {
        v4_ty_file_new(0, 0)
    }

    array_set(v4_ty_files, ty_id, word_from_int(file_id))
    array_set(v4_ty_resolves, ty_id, word_from_int(resolve_id))
    v4_ty_restore_clear_file_children(ty_id)
    if v4_ty_file_active_count_value <= ty_id {
        v4_ty_file_active_count_value = ty_id + 1
    }
    give back ty_id
}

task v4_ty_restore_signature_slot(ty_id: int, sig_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    if sig_id < 0 {
        give back 0
    }
    v4_ty_copy_doctrine_cache_reset()
    v4_ty_borrowed_return_source_cache_invalidate_signature(ty_id, sig_id)
    if v4_ty_child_handle_ensure_slot(v4_ty_defs_handle(ty_id), sig_id, "") == false {
        give back 0
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_kinds_handle(ty_id), sig_id, "") == false {
        give back 0
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_names_handle(ty_id), sig_id, "") == false {
        give back 0
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_displays_handle(ty_id), sig_id, "") == false {
        give back 0
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_hir_items_handle(ty_id), sig_id, word_from_int(0 - 1)) == false {
        give back 0
    }
    array_set(v4_ty_defs_handle(ty_id), sig_id, def_id)
    array_set(v4_ty_kinds_handle(ty_id), sig_id, sig_kind)
    array_set(v4_ty_names_handle(ty_id), sig_id, sig_name)
    array_set(v4_ty_displays_handle(ty_id), sig_id, sig_display)
    array_set(v4_ty_hir_items_handle(ty_id), sig_id, word_from_int(hir_item))
    if v4_ty_signature_count(ty_id) <= sig_id {
        array_set(v4_ty_signature_active_counts, ty_id, word_from_int(sig_id + 1))
    }
    give back 1
}

task v4_ty_restore_diag_slot(ty_id: int, diag_id: int, diag: word) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    if diag_id < 0 {
        give back 0
    }
    if v4_ty_child_handle_ensure_slot(v4_ty_diags_handle(ty_id), diag_id, "") == false {
        give back 0
    }
    array_set(v4_ty_diags_handle(ty_id), diag_id, diag)
    if v4_ty_diag_count(ty_id) <= diag_id {
        array_set(v4_ty_diag_active_counts, ty_id, word_from_int(diag_id + 1))
    }
    give back 1
}

task v4_ty_snapshot_restore_file_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "ty" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot resolve_id = word_to_int(v4_ty_snapshot_field_raw(line, 3))
    if v4_ty_restore_file_slot(ty_id, file_id, resolve_id) != ty_id {
        give back 0
    }
    give back 1
}

task v4_ty_snapshot_restore_signature_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "signature" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot sig_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot def_id = v4_ty_snapshot_field(line, 3)
    pilot sig_kind = v4_ty_snapshot_field(line, 4)
    pilot sig_name = v4_ty_snapshot_field(line, 5)
    pilot sig_display = v4_ty_snapshot_field(line, 6)
    pilot hir_item = word_to_int(v4_ty_snapshot_field_raw(line, 7))
    give back v4_ty_restore_signature_slot(ty_id, sig_id, def_id, sig_kind, sig_name, sig_display, hir_item)
}

task v4_ty_snapshot_restore_diag_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "ty-diag" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot diag = v4_ty_snapshot_field(line, 3)
    give back v4_ty_restore_diag_slot(ty_id, diag_id, diag)
}

task v4_ty_snapshot_restore(payload: word) -> word {
    pilot validation = v4_ty_snapshot_validate(payload)
    if validation.starts_with("ty-snapshot-import ok=1") == false {
        give back "ty-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot previous_active_files = v4_ty_file_count()
    pilot restored_files = 0
    pilot restored_signatures = 0
    pilot restored_diagnostics = 0
    pilot expected_files = 0
    pilot expected_signatures = 0
    pilot expected_diagnostics = 0
    pilot restore_failures = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_ty_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_ty_snapshot_field_raw(line, 0)
            if kind == "ty" {
                expected_files += 1
                pilot restored_file = v4_ty_snapshot_restore_file_line(line)
                if restored_file == 1 {
                    restored_files += 1
                } else {
                    restore_failures += 1
                }
            } else if kind == "signature" {
                expected_signatures += 1
                pilot restored_signature = v4_ty_snapshot_restore_signature_line(line)
                if restored_signature == 1 {
                    restored_signatures += 1
                } else {
                    restore_failures += 1
                }
            } else if kind == "ty-diag" {
                expected_diagnostics += 1
                pilot restored_diag = v4_ty_snapshot_restore_diag_line(line)
                if restored_diag == 1 {
                    restored_diagnostics += 1
                } else {
                    restore_failures += 1
                }
            } else if kind != "ty-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot restore_ok = 1
    if restore_failures > 0 {
        restore_ok = 0
    }
    if restored_files != expected_files {
        restore_ok = 0
    }
    if restored_signatures != expected_signatures {
        restore_ok = 0
    }
    if restored_diagnostics != expected_diagnostics {
        restore_ok = 0
    }
    if skipped_other > 0 {
        restore_ok = 0
    }

    if restore_ok == 1 {
        pilot inactive_ty_id = restored_files
        repeat until inactive_ty_id >= v4_ty_file_capacity() {
            v4_ty_borrowed_return_source_cache_invalidate_file(inactive_ty_id)
            array_set(v4_ty_files, inactive_ty_id, word_from_int(0 - 1))
            array_set(v4_ty_resolves, inactive_ty_id, word_from_int(0 - 1))
            v4_ty_restore_clear_file_children(inactive_ty_id)
            inactive_ty_id += 1
        }
        v4_ty_file_active_count_value = restored_files
        v4_ty_copy_doctrine_cache_reset()
    } else {
        v4_ty_file_active_count_value = previous_active_files
    }

    pilot out = "ty-snapshot-restore ok=" + word_from_int(restore_ok)
    if restore_ok == 0 {
        out = out + " reason=child-restore-failed"
    }
    out = out + " files=" + word_from_int(restored_files)
    out = out + " signatures=" + word_from_int(restored_signatures)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-files=" + word_from_int(v4_ty_file_count())
    give back out
}
