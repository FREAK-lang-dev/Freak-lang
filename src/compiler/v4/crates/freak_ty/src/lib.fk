    pilot member_name = v4_ty_extern_member_name(ty_id, sig_id, member_id)
    if member_name == "" {
        give back ""
    }
    give back "task " + member_name + "(...) -> " + v4_ty_extern_member_return_type(ty_id, sig_id, member_id)
}

task v4_ty_extern_member_link_name_raw(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot attr_idx = 0
    pilot attr_count = v4_ty_extern_member_attribute_count(ty_id, sig_id, member_id)
    repeat until attr_idx >= attr_count {
        if v4_ty_extern_member_attribute_name(ty_id, sig_id, member_id, attr_idx) == "link_name" {
            give back v4_ty_extern_member_attribute_arg(ty_id, sig_id, member_id, attr_idx)
        }
        attr_idx += 1
    }
    give back ""
}

task v4_ty_extern_member_link_name(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot link_name = v4_ty_strip_string_quotes(v4_ty_extern_member_link_name_raw(ty_id, sig_id, member_id))
    if link_name != "" {
        give back link_name
    }
    give back v4_ty_extern_member_link_name_raw(ty_id, sig_id, member_id)
}

task v4_ty_signature_extern_member_id(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    give back v4_resolve_extern_member_id_from_def(v4_ty_signature_def(ty_id, sig_id))
}

task v4_ty_signature_extern_block_sig(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
        give back sig_id
    }
    if v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    pilot scan_idx = 0
    pilot scan_count = v4_ty_signature_count(ty_id)
    repeat until scan_idx >= scan_count {
        if v4_ty_signature_kind(ty_id, scan_idx) == v4_ty_extern_sig and v4_ty_signature_hir_item(ty_id, scan_idx) == hir_item {
            give back scan_idx
        }
        scan_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_link_library(ty_id: int, sig_id: int) -> word {
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if extern_sig < 0 {
        give back ""
    }
    give back v4_ty_extern_link_library(ty_id, extern_sig)
}

task v4_ty_signature_link_name(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id < 0 {
        give back ""
    }
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if extern_sig < 0 {
        give back ""
    }
    pilot link_name = v4_ty_extern_member_link_name(ty_id, extern_sig, member_id)
    if link_name != "" {
        give back link_name
    }
    give back v4_ty_signature_name(ty_id, sig_id)
}

task v4_ty_signature_symbol_name(ty_id: int, sig_id: int) -> word {
    pilot link_name = v4_ty_signature_link_name(ty_id, sig_id)
    if link_name != "" {
        give back link_name
    }
    give back v4_ty_signature_name(ty_id, sig_id)
}

task v4_ty_signature_call_abi(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
        give back v4_ty_extern_abi(ty_id, sig_id)
    }
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if extern_sig >= 0 {
        give back v4_ty_extern_abi(ty_id, extern_sig)
    }
    give back ""
}

task v4_ty_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot idx = 0
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count {
        pilot token_span = v4_lex_token_span(stream_id, idx)
        if v4_span_start(token_span) >= offset {
            give back idx
        }
        idx += 1
    }
    give back count
}

task v4_ty_skip_trivia(stream_id: int, token_id: int) -> int {
    pilot idx = token_id
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count or v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
        idx += 1
    }
    give back idx
}

task v4_ty_next_nontrivia(stream_id: int, token_id: int, end_token: int) -> int {
    pilot idx = token_id
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_prev_nontrivia(stream_id: int, token_id: int, start_token: int) -> int {
    pilot idx = token_id
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_ty_find_token_value(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if v4_lex_token_value(stream_id, idx) == wanted {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_type_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if out == "lend" and value == "mut" {
                out = "lend mut"
            } else if out == "lend" or out == "lend mut" or out == "dyn" {
                out = out + " " + value
            } else if out.length() >= 4 and v4_slice(out, out.length() - 4, out.length()) == " dyn" {
                out = out + " " + value
            } else {
                out = out + value
            }
        }
        idx += 1
    }
    give back out
}

task v4_ty_signature_hir_id(ty_id: int) -> int {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if v4_resolve_exists(resolve_id) == false {
        give back 0 - 1
    }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) == false {
        give back 0 - 1
    }
    give back hir_id
}

task v4_ty_signature_stream_id(ty_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    give back v4_parse_stream_id(tree_id)
}

task v4_ty_signature_item_start_token(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id >= 0 {
        give back v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
    }
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    give back v4_ty_first_token_at_or_after(stream_id, v4_span_start(item_span))
}

task v4_ty_signature_item_end_token(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id >= 0 {
        give back v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
    }
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    pilot end_token = v4_ty_first_token_at_or_after(stream_id, v4_span_end(item_span))
    if end_token <= v4_ty_signature_item_start_token(ty_id, sig_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_ty_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back V4_NO_SPAN
    }

    pilot last = end_token
    repeat until last <= first {
        last -= 1
        if v4_lex_token_type(stream_id, last) != v4_tok_trivia {
            pilot start_span = v4_lex_token_span(stream_id, first)
            pilot end_span = v4_lex_token_span(stream_id, last)
            give back v4_span_new(v4_span_file(start_span), v4_span_start(start_span), v4_span_end(end_span))
        }
    }

    pilot only_span = v4_lex_token_span(stream_id, first)
    give back v4_span_new(v4_span_file(only_span), v4_span_start(only_span), v4_span_end(only_span))
}

task v4_ty_hir_item_start_token(hir_id: int, item_id: int) -> int {
    if hir_id < 0 {
        give back 0 - 1
    }
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, item_id)
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    give back v4_ty_first_token_at_or_after(stream_id, v4_span_start(item_span))
}

task v4_ty_hir_item_end_token(hir_id: int, item_id: int) -> int {
    if hir_id < 0 {
        give back 0 - 1
    }
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, item_id)
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    pilot end_token = v4_ty_first_token_at_or_after(stream_id, v4_span_end(item_span))
    if end_token <= v4_ty_hir_item_start_token(hir_id, item_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_ty_find_matching_paren(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "(" {
                depth += 1
            } else if val == ")" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_square(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "[" {
                depth += 1
            } else if val == "]" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_brace(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" {
                depth += 1
            } else if val == "}" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_angle(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "<" {
                depth += 1
            } else if val == ">" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_param_open_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0 - 1
    }
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_signature_param_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_depth_after_token(depth: int, val: word) -> int {
    pilot next_depth = depth
    if val == "(" or val == "[" or val == "{" or val == "<" {
        next_depth += 1
    } else if val == ")" or val == "]" or val == "}" or val == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_ty_item_name_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back name_token
}

task v4_ty_item_header_end_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot idx = start_token + 1
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (val == "(" or val == "{" or val == "=>" or val == "->") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_item_generic_open_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    pilot name_token = v4_ty_item_name_token_from_tokens(stream_id, start_token, end_token)
    pilot header_end = v4_ty_item_header_end_token_from_tokens(stream_id, start_token, end_token)
    if name_token < 0 or header_end <= name_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, header_end, "<")
}

task v4_ty_item_generic_close_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    pilot open_token = v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_angle(stream_id, open_token, v4_ty_item_header_end_token_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_item_generic_text_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot open_token = v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
    pilot close_token = v4_ty_item_generic_close_token_from_tokens(stream_id, start_token, end_token)
    if open_token < 0 or close_token <= open_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, open_token, close_token + 1)
}

task v4_ty_hir_item_generic_text(hir_id: int, item_id: int) -> word {
    if hir_id < 0 or item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_item_generic_text_from_tokens(stream_id, v4_ty_hir_item_start_token(hir_id, item_id), v4_ty_hir_item_end_token(hir_id, item_id))
}

task v4_ty_signature_generic_open_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_close_token_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_text(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_text_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_generic_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
}

task v4_ty_signature_param_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
}

task v4_ty_is_variadic_param_surface(type_text: word) -> bool {
    give back v4_ty_trim_spaces(type_text) == "..."
}

task v4_ty_param_count_from_tokens(stream_id: int, open_token: int, close_token: int) -> int {
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot first = v4_ty_skip_trivia(stream_id, open_token + 1)
    if first >= close_token {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                count += 1
            } else {
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_signature_param_segment_start(ty_id: int, sig_id: int, param_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
}

task v4_ty_param_segment_start_from_tokens(stream_id: int, open_token: int, close_token: int, param_id: int) -> int {
    if stream_id < 0 or open_token < 0 or close_token <= open_token or param_id < 0 {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                if current == param_id {
                    give back segment_start
                }
                current += 1
                segment_start = v4_ty_skip_trivia(stream_id, idx + 1)
            } else {
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    if current == param_id and segment_start < close_token {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_signature_param_segment_end(ty_id: int, sig_id: int, param_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
}

task v4_ty_param_segment_end_from_tokens(stream_id: int, start_token: int, close_token: int) -> int {
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_find_top_level_token(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == wanted {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_generic_segment_start(ty_id: int, sig_id: int, generic_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_generic_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, generic_id)
}

task v4_ty_signature_generic_segment_end(ty_id: int, sig_id: int, generic_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
}

task v4_ty_signature_generic_segment_span(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_generic_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_type_text(stream_id, start_token, end_token)
    }
    give back v4_ty_type_text(stream_id, start_token, colon_token)
}

task v4_ty_generic_bounds_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back ""
    }
    pilot bound_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if bound_start >= end_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, bound_start, end_token)
}

task v4_ty_signature_generic_name(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_bounds(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_bounds_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_kind(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_generic_kind_type
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < end_token and v4_lex_token_type(stream_id, first) == v4_tok_lifetime {
        give back v4_ty_generic_kind_lifetime
    }
    give back v4_ty_generic_kind_type
}

task v4_ty_signature_generic_is_lifetime(ty_id: int, sig_id: int, generic_id: int) -> bool {
    give back v4_ty_signature_generic_kind(ty_id, sig_id, generic_id) == v4_ty_generic_kind_lifetime
}

task v4_ty_signature_lifetime_count(ty_id: int, sig_id: int) -> int {
    pilot total = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            total += 1
        }
        generic_id += 1
    }
    give back total
}

task v4_ty_signature_type_generic_count(ty_id: int, sig_id: int) -> int {
    pilot total = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            total += 1
        }
        generic_id += 1
    }
    give back total
}

task v4_ty_signature_lifetime_name(ty_id: int, sig_id: int, lifetime_id: int) -> word {
    pilot seen = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            if seen == lifetime_id {
                give back v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
            }
            seen += 1
        }
        generic_id += 1
    }
    give back ""
}

task v4_ty_signature_type_generic_name(ty_id: int, sig_id: int, type_generic_id: int) -> word {
    pilot seen = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            if seen == type_generic_id {
                give back v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
            }
            seen += 1
        }
        generic_id += 1
    }
    give back ""
}

task v4_ty_generic_bound_count(bounds_text: word) -> int {
    if bounds_text == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= bounds_text.length() {
        pilot ch = bounds_text.char_at(idx)
        if depth == 0 and ch == "+" {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_generic_bound_name(bounds_text: word, bound_id: int) -> word {
    if bounds_text == "" or bound_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 0
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= bounds_text.length() {
        pilot ch = bounds_text.char_at(idx)
        if depth == 0 and ch == "+" {
            if current == bound_id {
                give back v4_slice(bounds_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == bound_id and segment_start < bounds_text.length() {
        give back v4_slice(bounds_text, segment_start, bounds_text.length())
    }
    give back ""
}

task v4_ty_signature_generic_bound_count(ty_id: int, sig_id: int, generic_id: int) -> int {
    give back v4_ty_generic_bound_count(v4_ty_signature_generic_bounds(ty_id, sig_id, generic_id))
}

task v4_ty_signature_generic_bound_name(ty_id: int, sig_id: int, generic_id: int, bound_id: int) -> word {
    give back v4_ty_generic_bound_name(v4_ty_signature_generic_bounds(ty_id, sig_id, generic_id), bound_id)
}

task v4_ty_signature_generic_has_bound(ty_id: int, sig_id: int, generic_id: int, wanted_bound: word) -> bool {
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        if v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx) == wanted_bound {
            give back true
        }
        bound_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_generic_name(ty_id: int, sig_id: int, type_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
            give back true
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_lifetime_name(ty_id: int, sig_id: int, lifetime_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) {
            if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == lifetime_name {
                give back true
            }
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_type_generic_name(ty_id: int, sig_id: int, type_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
                give back true
            }
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_generic_id_for_name(ty_id: int, sig_id: int, type_name: word) -> int {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
            give back generic_idx
        }
        generic_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_param_name(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_param_index_for_name(ty_id: int, sig_id: int, wanted_name: word) -> int {
    pilot param_idx = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_idx >= param_count {
        if v4_ty_signature_param_name(ty_id, sig_id, param_idx) == wanted_name {
            give back param_idx
        }
        param_idx += 1
    }
    give back 0 - 1
}

task v4_ty_param_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    if v4_lex_token_value(stream_id, first) == "lend" {
        first = v4_ty_skip_trivia(stream_id, first + 1)
        if first < end_token and v4_lex_token_value(stream_id, first) == "mut" {
            first = v4_ty_skip_trivia(stream_id, first + 1)
        }
    }
    if first >= end_token {
        give back ""
    }
    pilot param_name = v4_lex_token_value(stream_id, first)
    if param_name == ":" or param_name == "," or param_name == ")" {
        give back ""
    }
    give back param_name
}

task v4_ty_param_mode_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_param_mode_value
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back v4_ty_param_mode_value
    }
    if v4_lex_token_value(stream_id, first) != "lend" {
        give back v4_ty_param_mode_value
    }
    pilot after_lend = v4_ty_skip_trivia(stream_id, first + 1)
    if after_lend < end_token and v4_lex_token_value(stream_id, after_lend) == "mut" {
        give back v4_ty_param_mode_lend_mut
    }
    give back v4_ty_param_mode_lend
}

task v4_ty_param_mode_prefix(mode: word) -> word {
    if mode == v4_ty_param_mode_lend {
        give back "lend "
    }
    if mode == v4_ty_param_mode_lend_mut {
        give back "lend mut "
    }
    give back ""
}

task v4_ty_signature_param_mode(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_mode_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_param_type_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_signature_param_type(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    if v4_ty_is_variadic_param_surface(v4_ty_param_type_from_tokens(stream_id, start_token, end_token)) {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_signature_param_surface_type(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_type_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_function_value_type(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot out = ""
    pilot call_abi = v4_ty_signature_call_abi(ty_id, sig_id)
    if call_abi != "" {
        out = "extern[" + call_abi + "]"
    }
    out = out + "task("

    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if param_id > 0 {
            out = out + ","
        }
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
        pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
        if param_surface == "" {
            param_surface = v4_ty_unknown
        }
        if param_surface == "..." {
            out = out + "..."
        } else {
            if param_name != "" {
                out = out + v4_ty_param_mode_prefix(v4_ty_signature_param_mode(ty_id, sig_id, param_id)) + param_name + ":"
            }
            out = out + param_surface
        }
        param_id += 1
    }

    out = out + ")->"
    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface == "" {
        return_surface = v4_ty_unknown
    }
    give back out + return_surface
}

task v4_ty_signature_param_type_span(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_type_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_param_is_variadic(ty_id: int, sig_id: int, param_id: int) -> bool {
    give back v4_ty_is_variadic_param_surface(v4_ty_signature_param_surface_type(ty_id, sig_id, param_id))
}

task v4_ty_signature_variadic_param_id(ty_id: int, sig_id: int) -> int {
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_is_variadic(ty_id, sig_id, param_id) {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_ty_signature_is_variadic(ty_id: int, sig_id: int) -> bool {
    give back v4_ty_signature_variadic_param_id(ty_id, sig_id) >= 0
}

task v4_ty_signature_fixed_param_count(ty_id: int, sig_id: int) -> int {
    pilot variadic_param = v4_ty_signature_variadic_param_id(ty_id, sig_id)
    if variadic_param >= 0 {
        give back variadic_param
    }
    give back v4_ty_signature_param_count(ty_id, sig_id)
}

task v4_ty_param_type_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot param_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if param_ty == "" {
        give back v4_ty_unknown
    }
    give back param_ty
}

task v4_ty_return_type_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (val == "{" or val == "=>") {
                give back idx
            }
            if val == "(" or val == "[" or val == "<" {
                depth += 1
            } else if val == ")" or val == "]" or val == ">" {
                if depth > 0 {
                    depth -= 1
                }
            }
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_infer_arrow_expr_return(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back v4_ty_void
    }

    pilot first_type = v4_lex_token_type(stream_id, first)
    pilot first_value = v4_lex_token_value(stream_id, first)
    if first_type == v4_tok_int {
        give back v4_ty_int
    }
    if first_type == v4_tok_float {
        give back v4_ty_num
    }
    if first_type == v4_tok_string {
        give back v4_ty_word
    }
    if first_type == v4_tok_bool {
        give back v4_ty_bool
    }
    if first_value == "nobody" {
        give back "maybe<unknown>"
    }
    give back v4_ty_unknown
}

task v4_ty_route_surface_keyword(hir_id: int, hir_item: int) -> word {
    if hir_item >= 0 and v4_hir_route_is_variant(hir_id, hir_item) {
        give back "variant"
    }
    give back "route"
}

task v4_ty_route_surface_keyword_for_signature(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back "route"
    }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back "route"
    }
    give back v4_ty_route_surface_keyword(hir_id, v4_ty_signature_hir_item(ty_id, sig_id))
}

task v4_ty_task_return_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot return_arrow = v4_ty_find_top_level_token(stream_id, start_token, end_token, "->")
    if return_arrow >= 0 {
        pilot return_start = v4_ty_skip_trivia(stream_id, return_arrow + 1)
        pilot return_end = v4_ty_return_type_end(stream_id, return_start, end_token)
        pilot return_ty = v4_ty_type_text(stream_id, return_start, return_end)
        if return_ty != "" {
            give back return_ty
        }
    }

    pilot fat_arrow = v4_ty_find_token_value(stream_id, start_token, end_token, "=>")
    if fat_arrow >= 0 {
        give back v4_ty_infer_arrow_expr_return(stream_id, fat_arrow + 1, end_token)
    }

    give back v4_ty_unknown
}

task v4_ty_task_return_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot return_arrow = v4_ty_find_top_level_token(stream_id, start_token, end_token, "->")
    if return_arrow >= 0 {
        pilot return_start = v4_ty_skip_trivia(stream_id, return_arrow + 1)
        pilot return_end = v4_ty_return_type_end(stream_id, return_start, end_token)
        if return_start < return_end {
            give back v4_ty_span_from_tokens(stream_id, return_start, return_end)
        }
    }
    give back V4_NO_SPAN
}

task v4_ty_signature_return_span(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_task_return_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_task_return_from_hir(hir_id: int, hir_item: int) -> word {
    if hir_item < 0 {
        give back v4_ty_unknown
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_const_signature_id_for_name(ty_id: int, const_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_const_sig and v4_ty_signature_name(ty_id, sig_id) == const_name {
            give back sig_id
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_task_signature_id_for_name(ty_id: int, task_name: word) -> int {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot def_id = v4_resolve_def_for_name(resolve_id, task_name)
        if def_id != "" {
            pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
            if sig_id >= 0 {
                pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
                if sig_kind == v4_ty_task_sig or sig_kind == v4_ty_extern_sig {
                    give back sig_id
                }
            }
        }
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_task_sig and v4_ty_signature_name(ty_id, sig_id) == task_name {
            give back sig_id
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_const_declared_type_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_const_type(hir_id, hir_item)
}

task v4_ty_const_init_text_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_const_init(hir_id, hir_item)
}

task v4_ty_const_name_span(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }
    pilot fixed_token = v4_ty_find_token_value(stream_id, start_token, end_token, "fixed")
    if fixed_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot pilot_token = v4_ty_next_nontrivia(stream_id, fixed_token + 1, end_token)
    if pilot_token >= end_token or v4_lex_token_value(stream_id, pilot_token) != "pilot" {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot name_token = v4_ty_next_nontrivia(stream_id, pilot_token + 1, end_token)
    if name_token >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_lex_token_span(stream_id, name_token)
}

task v4_ty_const_equals_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot fixed_token = v4_ty_find_token_value(stream_id, start_token, end_token, "fixed")
    if fixed_token < 0 {
        give back 0 - 1
    }
    pilot pilot_token = v4_ty_next_nontrivia(stream_id, fixed_token + 1, end_token)
    if pilot_token >= end_token or v4_lex_token_value(stream_id, pilot_token) != "pilot" {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, pilot_token + 1, end_token, "=")
}

task v4_ty_const_init_start_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot eq_token = v4_ty_const_equals_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or eq_token < 0 or end_token <= eq_token {
        give back 0 - 1
    }
    pilot start_token = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if start_token >= end_token {
        give back 0 - 1
    }
    give back start_token
}

task v4_ty_const_init_end_token(ty_id: int, sig_id: int) -> int {
    give back v4_ty_signature_item_end_token(ty_id, sig_id)
}

task v4_ty_const_merge_literal_type(current_ty: word, next_ty: word) -> word {
    if not v4_ty_is_known(current_ty) {
        give back next_ty
    }
    if not v4_ty_is_known(next_ty) {
        give back current_ty
    }
    if current_ty == next_ty {
        give back current_ty
    }
    if v4_ty_is_numeric(current_ty) and v4_ty_is_numeric(next_ty) {
        give back v4_ty_numeric_result(current_ty, next_ty)
    }
    give back current_ty
}

task v4_ty_const_path_scope_separator(path: word) -> int {
    pilot idx = 0
    pilot depth = 0
    pilot found = 0 - 1
    repeat until idx + 1 >= path.length() {
        pilot ch = path.char_at(idx)
        if depth == 0 and ch == ":" and path.char_at(idx + 1) == ":" {
            found = idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back found
}

task v4_ty_const_path_left(path: word) -> word {
    pilot sep = v4_ty_const_path_scope_separator(path)
    if sep < 0 {
        give back ""
    }
    give back v4_slice(path, 0, sep)
}

task v4_ty_const_path_right(path: word) -> word {
    pilot sep = v4_ty_const_path_scope_separator(path)
    if sep < 0 {
        give back ""
    }
    give back v4_slice(path, sep + 2, path.length())
}

task v4_ty_const_constructor_head_is_valid(stream_id: int, start_token: int, end_token: int) -> bool {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_token = false
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            saw_token = true
            if tok_type == v4_tok_ident or tok_type == v4_tok_keyword or tok_type == v4_tok_lifetime or tok_type == v4_tok_int or tok_type == v4_tok_float {
                -- allowed
            } else if val == "::" or val == "<" or val == ">" or val == "," or val == "(" or val == ")" or val == "[" or val == "]" or val == ";" {
                -- allowed
            } else {
                give back false
            }
            depth = v4_ty_depth_after_token(depth, val)
            if depth < 0 {
                give back false
            }
        }
        idx += 1
    }
    give back saw_token and depth == 0
}

task v4_ty_const_constructor_head_name(stream_id: int, start_token: int, end_token: int) -> word {
    if not v4_ty_const_constructor_head_is_valid(stream_id, start_token, end_token) {
        give back ""
    }
    give back v4_ty_type_text(stream_id, start_token, end_token)
}

task v4_ty_call_arg_label(stream_id: int, start_token: int, end_token: int) -> word {
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back ""
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token < 0 or name_token >= colon_token {
        give back ""
    }
    pilot next_token = v4_ty_skip_trivia(stream_id, name_token + 1)
    if next_token != colon_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, name_token)
}

task v4_ty_call_arg_value_start(stream_id: int, start_token: int, end_token: int) -> int {
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back start_token
    }
    give back v4_ty_skip_trivia(stream_id, colon_token + 1)
}

task v4_ty_call_arg_segment(start_token: int, end_token: int) -> word {
    give back word_from_int(start_token) + "|" + word_from_int(end_token)
}

task v4_ty_call_arg_segment_pipe(segment: word) -> int {
    pilot idx = 0
    repeat until idx >= segment.length() {
        if segment.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_call_arg_segment_start(segment: word) -> int {
    pilot pipe = v4_ty_call_arg_segment_pipe(segment)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(v4_slice(segment, 0, pipe))
}

task v4_ty_call_arg_segment_end(segment: word) -> int {
    pilot pipe = v4_ty_call_arg_segment_pipe(segment)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(v4_slice(segment, pipe + 1, segment.length()))
}

task v4_ty_call_arg_segment_payload_append(payload: word, start_token: int, end_token: int) -> word {
    pilot segment = v4_ty_call_arg_segment(start_token, end_token)
    if payload == "" {
        give back segment
    }
    give back payload + "\n" + segment
}

task v4_ty_call_arg_segment_payload_at(payload: word, wanted: int) -> word {
    if wanted < 0 {
        give back ""
    }
    pilot current = 0
    pilot start_idx = 0
    pilot idx = 0
    repeat until idx > payload.length() {
        if idx == payload.length() or payload.char_at(idx) == "\n" {
            if current == wanted {
                give back v4_slice(payload, start_idx, idx)
            }
            current += 1
            start_idx = idx + 1
        }
        idx += 1
    }
    give back ""
}

task v4_ty_call_arg_slot_payload_new(slot_count: int) -> word {
    pilot payload = ""
    pilot idx = 0
    repeat until idx >= slot_count {
        payload = v4_ty_call_arg_segment_payload_append(payload, 0 - 1, 0 - 1)
        idx += 1
    }
    give back payload
}

task v4_ty_call_arg_slot_assigned(payload: word, slot_id: int) -> bool {
    pilot segment = v4_ty_call_arg_segment_payload_at(payload, slot_id)
    give back v4_ty_call_arg_segment_start(segment) >= 0
}

task v4_ty_call_arg_slot_start(payload: word, slot_id: int) -> int {
    give back v4_ty_call_arg_segment_start(v4_ty_call_arg_segment_payload_at(payload, slot_id))
}

task v4_ty_call_arg_slot_end(payload: word, slot_id: int) -> int {
    give back v4_ty_call_arg_segment_end(v4_ty_call_arg_segment_payload_at(payload, slot_id))
}

task v4_ty_call_arg_slot_set(payload: word, slot_count: int, slot_id: int, start_token: int, end_token: int) -> word {
    pilot rewritten = ""
    pilot idx = 0
    repeat until idx >= slot_count {
        pilot segment = v4_ty_call_arg_segment_payload_at(payload, idx)
        if idx == slot_id {
            segment = v4_ty_call_arg_segment(start_token, end_token)
        }
        rewritten = v4_ty_call_arg_segment_payload_append(rewritten, v4_ty_call_arg_segment_start(segment), v4_ty_call_arg_segment_end(segment))
        idx += 1
    }
    give back rewritten
}

task v4_ty_const_task_call_env_seen(ty_id: int, owner_sig: int, stream_id: int, sig_id: int, callee_name: word, open_token: int, close_token: int, seed_env: word, seen_consts: word, emit_diags: bool, expr_span: word) -> word {
    pilot expected_count = v4_ty_signature_param_count(ty_id, sig_id)
    pilot actual_count = v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
    pilot planned_slots = v4_ty_call_arg_slot_payload_new(expected_count)
    pilot named_seen = false
    pilot next_positional = 0
    pilot env = seed_env
    pilot valid = true
    pilot arg_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    if arg_start < close_token {
        repeat until arg_start >= close_token {
            pilot arg_end = v4_ty_const_ctor_field_end(stream_id, arg_start, close_token)
            if arg_end <= arg_start {
                if emit_diags {
                    v4_ty_add_error_diag(ty_id, expr_span, "const task call arity drift", callee_name + " arguments are malformed")
                }
                give back v4_ty_generic_env_fail
            }

            pilot arg_span = v4_ty_span_from_tokens(stream_id, arg_start, arg_end)
            pilot arg_label = v4_ty_call_arg_label(stream_id, arg_start, arg_end)
            pilot value_start = v4_ty_call_arg_value_start(stream_id, arg_start, arg_end)
            if arg_label != "" {
                named_seen = true
                if value_start < arg_end {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, value_start, arg_end, seen_consts)
                }
                pilot param_idx = v4_ty_signature_param_index_for_name(ty_id, sig_id, arg_label)
                if param_idx < 0 {
                    if emit_diags {
                        v4_ty_add_error_diag(ty_id, arg_span, "unknown call argument", callee_name + " has no parameter " + arg_label)
                    }
                    valid = false
                } else if v4_ty_call_arg_slot_assigned(planned_slots, param_idx) {
                    if emit_diags {
                        v4_ty_add_error_diag(ty_id, arg_span, "duplicate call argument", arg_label + " already has an assignment in " + callee_name)
                    }
                    valid = false
                } else {
                    planned_slots = v4_ty_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
                }
            } else {
                if named_seen {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, arg_start, arg_end, seen_consts)
                    if emit_diags {
                        v4_ty_add_error_diag(ty_id, arg_span, "positional call argument after named", "place positional arguments before named ones in " + callee_name)
                    }
                    valid = false
                } else if next_positional < expected_count {
                    planned_slots = v4_ty_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                    next_positional += 1
                } else {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, arg_start, arg_end, seen_consts)
                    valid = false
                }
            }

            arg_start = v4_ty_skip_trivia(stream_id, arg_end + 1)
        }
    }

    pilot param_idx = 0
    repeat until param_idx >= expected_count {
        if named_seen and not v4_ty_call_arg_slot_assigned(planned_slots, param_idx) {
            if emit_diags {
                pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
                v4_ty_add_error_diag(ty_id, expr_span, "missing call argument", callee_name + " still needs parameter " + param_name)
            }
            valid = false
        }

        pilot planned_start = v4_ty_call_arg_slot_start(planned_slots, param_idx)
        pilot planned_end = v4_ty_call_arg_slot_end(planned_slots, param_idx)
        if planned_start >= 0 and planned_end > planned_start {
            v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, planned_start, planned_end, seen_consts)
            pilot raw_expected_ty = v4_ty_signature_param_type(ty_id, sig_id, param_idx)
            pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, planned_start, planned_end, seen_consts)
            pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
            if next_env == v4_ty_generic_env_fail {
                if emit_diags {
                    pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                    if expected_ty == "" {
                        expected_ty = raw_expected_ty
                    }
                    pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
                    if param_name == "" {
                        param_name = "parameter " + word_from_int(param_idx)
                    }
                    v4_ty_add_error_diag(ty_id, v4_ty_span_from_tokens(stream_id, planned_start, planned_end), "const task call argument mismatch", callee_name + "." + param_name + " expects " + expected_ty + " but got " + actual_ty)
                }
                valid = false
            } else {
                env = next_env
            }
        }
        param_idx += 1
    }

    if actual_count != expected_count {
        if emit_diags {
            v4_ty_add_error_diag(ty_id, expr_span, "const task call arity drift", callee_name + " takes " + word_from_int(expected_count) + " arguments but got " + word_from_int(actual_count))
        }
        valid = false
    }

    if not valid {
        give back v4_ty_generic_env_fail
    }
    give back env
}

task v4_ty_const_task_call_return_type_seen(ty_id: int, owner_sig: int, stream_id: int, callee_name: word, open_token: int, close_token: int, seen_consts: word) -> word {
    pilot lookup_name = callee_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, lookup_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    if not v4_ty_signature_has_attribute(ty_id, sig_id, "const") {
        give back v4_ty_unknown
    }

    pilot env = ""
    if v4_ty_is_generic_instance_type(callee_name) {
        pilot instance_name = v4_ty_canonical_type(ty_id, callee_name)
        if instance_name == "" or instance_name == v4_ty_unknown {
            instance_name = callee_name
        }
        env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
        if env == v4_ty_generic_env_fail {
            give back v4_ty_unknown
        }
    }

    env = v4_ty_const_task_call_env_seen(ty_id, owner_sig, stream_id, sig_id, callee_name, open_token, close_token, env, seen_consts, false, V4_NO_SPAN)
    if env == v4_ty_generic_env_fail {
        give back v4_ty_unknown
    }

    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if not v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            give back v4_ty_unknown
        }
        give back v4_ty_signature_return_type_for_env(ty_id, sig_id, env)
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_signature_return_type(ty_id, sig_id))
}

task v4_ty_const_shape_ctor_result_type_seen(ty_id: int, owner_sig: int, stream_id: int, ctor_name: word, open_token: int, close_token: int, seen_consts: word) -> word {
    pilot lookup_name = ctor_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, lookup_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot instance_name = v4_ty_canonical_type(ty_id, ctor_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = ctor_name
    }
    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
    if env == v4_ty_generic_env_fail {
        give back v4_ty_unknown
    }
    pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    if field_start < close_token {
        repeat until field_start >= close_token {
            pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, close_token)
            pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
            pilot field_name = ""
            if name_token < field_end {
                field_name = v4_lex_token_value(stream_id, name_token)
            }
            pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
            if colon_token >= 0 and field_name != "" {
                pilot field_id = v4_ty_shape_field_id_for_name(ty_id, lookup_name, field_name)
                if field_id >= 0 {
                    pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                    pilot raw_expected_ty = v4_ty_shape_field_type(ty_id, sig_id, field_id)
                    pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                    env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                    if env == v4_ty_generic_env_fail {
                        give back v4_ty_unknown
                    }
                }
            }
            field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
        }
    }

    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            give back v4_ty_signature_instance_type_for_env(ty_id, sig_id, env)
        }
        if v4_ty_is_generic_instance_type(instance_name) {
            give back instance_name
        }
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_signature_name(ty_id, sig_id))
}

task v4_ty_const_route_ctor_result_type_seen(ty_id: int, owner_sig: int, stream_id: int, route_name: word, case_name: word, open_token: int, close_token: int, seen_consts: word) -> word {
    pilot lookup_name = route_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, lookup_name)
    if sig_id < 0 or not v4_ty_route_has_case(ty_id, lookup_name, case_name) {
        give back v4_ty_unknown
    }

    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = route_name
    }
    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
    if env == v4_ty_generic_env_fail {
        give back v4_ty_unknown
    }
    pilot route_sig_name = v4_ty_signature_name(ty_id, sig_id)
    pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    if field_start < close_token {
        repeat until field_start >= close_token {
            pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, close_token)
            pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
            pilot field_name = ""
            if name_token < field_end {
                field_name = v4_lex_token_value(stream_id, name_token)
            }
            pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
            if colon_token >= 0 and field_name != "" {
                pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, lookup_name, case_name, field_name)
                if field_id >= 0 {
                    pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                    pilot raw_expected_ty = v4_ty_route_case_field_type(ty_id, route_sig_name, case_name, field_id)
                    pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                    env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                    if env == v4_ty_generic_env_fail {
                        give back v4_ty_unknown
                    }
                }
            }
            field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
        }
    }

    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            give back v4_ty_signature_instance_type_for_env(ty_id, sig_id, env)
        }
        if v4_ty_is_generic_instance_type(instance_name) {
            give back instance_name
        }
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_signature_name(ty_id, sig_id))
}

task v4_ty_const_expr_type_from_tokens_seen(ty_id: int, owner_sig: int, stream_id: int, start_token: int, end_token: int, seen_consts: word) -> word {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < 0 or first >= end_token {
        give back v4_ty_unknown
    }

    pilot last = end_token - 1
    repeat until last <= first or v4_lex_token_type(stream_id, last) != v4_tok_trivia {
        last -= 1
    }
    if last < first {
        give back v4_ty_unknown
    }

    pilot first_value = v4_lex_token_value(stream_id, first)
    if first_value == "(" and v4_ty_find_matching_paren(stream_id, first, end_token) == last {
        pilot tuple_comma = v4_ty_find_top_level_token(stream_id, first + 1, last, ",")
        if tuple_comma >= 0 {
            pilot tuple_ty = "("
            pilot slot_start = v4_ty_skip_trivia(stream_id, first + 1)
            pilot slot_idx = 0
            repeat until slot_start >= last {
                pilot slot_end = v4_ty_find_top_level_token(stream_id, slot_start, last, ",")
                if slot_end < 0 {
                    slot_end = last
                }
                if slot_end <= slot_start {
                    give back v4_ty_unknown
                }
                pilot slot_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, slot_start, slot_end, seen_consts)
                if slot_ty == v4_ty_unknown {
                    give back v4_ty_unknown
                }
                if slot_idx > 0 {
                    tuple_ty = tuple_ty + ","
                }
                tuple_ty = tuple_ty + slot_ty
                slot_idx += 1
                if slot_end >= last {
                    give back tuple_ty + ")"
                }
                slot_start = v4_ty_skip_trivia(stream_id, slot_end + 1)
            }
            give back v4_ty_unknown
        }
        give back v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, first + 1, last, seen_consts)
    }

    if first_value == "[" and v4_ty_find_matching_square(stream_id, first, end_token) == last {
        pilot repeat_token = v4_ty_find_top_level_token(stream_id, first + 1, last, ";")
        if repeat_token >= 0 {
            pilot value_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, first + 1, repeat_token, seen_consts)
            if value_ty == v4_ty_unknown {
                give back v4_ty_unknown
            }
            pilot count_start = v4_ty_skip_trivia(stream_id, repeat_token + 1)
            if count_start >= last {
                give back v4_ty_unknown
            }
            pilot count_text = v4_ty_type_text(stream_id, count_start, last)
            pilot resolved_length = v4_ty_const_integer_text_from_expr_seen(ty_id, count_text, seen_consts)
            if resolved_length == v4_ty_unknown {
                give back v4_ty_unknown
            }
            if resolved_length.starts_with("-") {
                give back v4_ty_unknown
            }
            give back "[" + value_ty + ";" + resolved_length + "]"
        }

        pilot element_start = v4_ty_skip_trivia(stream_id, first + 1)
        if element_start >= last {
            give back v4_ty_unknown
        }
        pilot element_ty = v4_ty_unknown
        repeat until element_start >= last {
            pilot element_end = v4_ty_find_top_level_token(stream_id, element_start, last, ",")
            if element_end < 0 {
                element_end = last
            }
            if element_end <= element_start {
                give back v4_ty_unknown
            }
            pilot next_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, element_start, element_end, seen_consts)
            if next_ty == v4_ty_unknown {
                give back v4_ty_unknown
            }
            element_ty = v4_ty_const_merge_literal_type(element_ty, next_ty)
            if element_end >= last {
                if element_ty == v4_ty_unknown {
                    give back v4_ty_unknown
                }
                give back "List<" + element_ty + ">"
            }
            element_start = v4_ty_skip_trivia(stream_id, element_end + 1)
        }
        give back v4_ty_unknown
    }

    pilot first_type = v4_lex_token_type(stream_id, first)
    if v4_lex_token_value(stream_id, last) == ")" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "(")
        if open_token > first and v4_ty_find_matching_paren(stream_id, open_token, end_token) == last {
            pilot callee_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if callee_name != "" {
                pilot call_ty = v4_ty_const_task_call_return_type_seen(ty_id, owner_sig, stream_id, callee_name, open_token, last, seen_consts)
                if call_ty != v4_ty_unknown {
                    give back call_ty
                }
            }
        }
    }
    if v4_lex_token_value(stream_id, last) == "}" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "{")
        if open_token > first and v4_ty_find_matching_brace(stream_id, open_token, end_token) == last {
            pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if ctor_name != "" {
                pilot scope_sep = v4_ty_const_path_scope_separator(ctor_name)
                if scope_sep >= 0 {
                    pilot route_name = v4_ty_const_path_left(ctor_name)
                    pilot case_name = v4_ty_const_path_right(ctor_name)
                    if v4_ty_route_signature_id_for_name(ty_id, route_name) >= 0 and case_name != "" {
                        give back v4_ty_const_route_ctor_result_type_seen(ty_id, owner_sig, stream_id, route_name, case_name, open_token, last, seen_consts)
                    }
                } else if v4_ty_shape_signature_id_for_name(ty_id, ctor_name) >= 0 {
                    give back v4_ty_const_shape_ctor_result_type_seen(ty_id, owner_sig, stream_id, ctor_name, open_token, last, seen_consts)
                }
            }
        }
    }

    pilot second = v4_ty_next_nontrivia(stream_id, first + 1, end_token)
    if second < end_token {
        pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, end_token)
        if ctor_name != "" {
            pilot scope_sep = v4_ty_const_path_scope_separator(ctor_name)
            if scope_sep >= 0 {
                pilot route_name = v4_ty_const_path_left(ctor_name)
                pilot case_name = v4_ty_const_path_right(ctor_name)
                pilot lookup_name = route_name
                if v4_ty_is_generic_instance_type(lookup_name) {
                    lookup_name = v4_ty_generic_base_name(lookup_name)
                }
                if v4_ty_route_signature_id_for_name(ty_id, lookup_name) >= 0 and case_name != "" and v4_ty_route_has_case(ty_id, lookup_name, case_name) and not v4_ty_route_case_has_payload(ty_id, lookup_name, case_name) {
                    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, lookup_name)
                    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
                    if instance_name == "" or instance_name == v4_ty_unknown {
                        instance_name = route_name
                    }
                    if v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name) == v4_ty_generic_env_fail {
                        give back v4_ty_unknown
                    }
                    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 and not v4_ty_is_generic_instance_type(instance_name) {
                        give back v4_ty_unknown
                    }
                    give back v4_ty_canonical_type(ty_id, instance_name)
                }
            }
        }
        pilot expr_text = v4_ty_type_text(stream_id, first, end_token)
        if v4_ty_const_integer_text_from_expr_seen(ty_id, expr_text, seen_consts) != v4_ty_unknown {
            give back v4_ty_int
        }
        give back v4_ty_unknown
    }

    if first_type == v4_tok_int {
        give back v4_ty_int_literal_type(first_value, v4_ty_unknown)
    }
    if first_type == v4_tok_float {
        give back v4_ty_float_literal_type(first_value, v4_ty_unknown)
    }
    if first_type == v4_tok_string {
        give back v4_ty_word
    }
    if first_type == v4_tok_bool {
        give back v4_ty_bool
    }
    if first_type == v4_tok_char {
        give back v4_ty_char
    }
    if first_type == v4_tok_ident or first_type == v4_tok_keyword {
        pilot dep_sig = v4_ty_const_signature_id_for_name(ty_id, first_value)
        if dep_sig >= 0 and dep_sig != owner_sig {
            give back v4_ty_const_value_type_for_sig_seen(ty_id, dep_sig, seen_consts)
        }
    }

    pilot expr_text = v4_ty_type_text(stream_id, first, end_token)
    if v4_ty_const_integer_text_from_expr_seen(ty_id, expr_text, seen_consts) != v4_ty_unknown {
        give back v4_ty_int
    }
    give back v4_ty_unknown
}

task v4_ty_const_name_list_contains(names: word, name: word) -> bool {
    if names == "" or name == "" {
        give back false
    }
    give back ("|" + names + "|").contains("|" + name + "|")
}

task v4_ty_const_name_list_add(names: word, name: word) -> word {
    if name == "" {
        give back names
    }
    if names == "" {
        give back name
    }
    give back names + "|" + name
}

task v4_ty_const_ctor_field_end(stream_id: int, start_token: int, close_token: int) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_validate_const_expr_seen(ty_id: int, owner_sig: int, stream_id: int, start_token: int, end_token: int, seen_consts: word) -> void {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < 0 or first >= end_token {
        give back
    }

    pilot last = end_token - 1
    repeat until last <= first or v4_lex_token_type(stream_id, last) != v4_tok_trivia {
        last -= 1
    }
    if last < first {
        give back
    }

    pilot first_value = v4_lex_token_value(stream_id, first)
    pilot expr_span = v4_ty_span_from_tokens(stream_id, first, last + 1)
    if first_value == "(" and v4_ty_find_matching_paren(stream_id, first, end_token) == last {
        pilot tuple_comma = v4_ty_find_top_level_token(stream_id, first + 1, last, ",")
        if tuple_comma >= 0 {
            pilot slot_start = v4_ty_skip_trivia(stream_id, first + 1)
            repeat until slot_start >= last {
                pilot slot_end = v4_ty_find_top_level_token(stream_id, slot_start, last, ",")
                if slot_end < 0 {
                    slot_end = last
                }
                if slot_end > slot_start {
                    v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, slot_start, slot_end, seen_consts)
                }
                if slot_end >= last {
                    give back
                }
                slot_start = v4_ty_skip_trivia(stream_id, slot_end + 1)
            }
            give back
        }
        v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, first + 1, last, seen_consts)
        give back
    }

    if first_value == "[" and v4_ty_find_matching_square(stream_id, first, end_token) == last {
        pilot repeat_token = v4_ty_find_top_level_token(stream_id, first + 1, last, ";")
        if repeat_token >= 0 {
            v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, first + 1, repeat_token, seen_consts)
            give back
        }

        pilot element_start = v4_ty_skip_trivia(stream_id, first + 1)
        repeat until element_start >= last {
            pilot element_end = v4_ty_find_top_level_token(stream_id, element_start, last, ",")
            if element_end < 0 {
                element_end = last
            }
            if element_end > element_start {
                v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, element_start, element_end, seen_consts)
            }
            if element_end >= last {
                give back
            }
            element_start = v4_ty_skip_trivia(stream_id, element_end + 1)
        }
        give back
    }

    if v4_lex_token_value(stream_id, last) == ")" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "(")
        if open_token > first and v4_ty_find_matching_paren(stream_id, open_token, end_token) == last {
            pilot callee_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if callee_name != "" {
                pilot lookup_name = callee_name
                if v4_ty_is_generic_instance_type(lookup_name) {
                    lookup_name = v4_ty_generic_base_name(lookup_name)
                }
                pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, lookup_name)
                if sig_id >= 0 {
                    v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, callee_name, "const task call " + callee_name, expr_span)

                    pilot env = ""
                    if v4_ty_is_generic_instance_type(callee_name) {
                        pilot instance_name = v4_ty_canonical_type(ty_id, callee_name)
                        if instance_name == "" or instance_name == v4_ty_unknown {
                            instance_name = callee_name
                        }
                        env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
                        if env == v4_ty_generic_env_fail {
                            give back
                        }
                    }

                    if not v4_ty_signature_has_attribute(ty_id, sig_id, "const") {
                        v4_ty_add_error_diag(ty_id, expr_span, "root constant task call needs @const", callee_name + " must be declared with @const before a fixed pilot can call it")
                        give back
                    }

                    pilot ignored_env = v4_ty_const_task_call_env_seen(ty_id, owner_sig, stream_id, sig_id, callee_name, open_token, last, env, seen_consts, true, expr_span)
                    give back
                }
            }
        }
    }

    if v4_lex_token_value(stream_id, last) == "}" {
        pilot open_token = v4_ty_find_top_level_token(stream_id, first, end_token, "{")
        if open_token > first and v4_ty_find_matching_brace(stream_id, open_token, end_token) == last {
            pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, open_token)
            if ctor_name != "" {
                pilot scope_sep = v4_ty_const_path_scope_separator(ctor_name)
                if scope_sep >= 0 {
                    pilot route_name = v4_ty_const_path_left(ctor_name)
                    pilot case_name = v4_ty_const_path_right(ctor_name)
                    pilot route_lookup_name = route_name
                    if v4_ty_is_generic_instance_type(route_lookup_name) {
                        route_lookup_name = v4_ty_generic_base_name(route_lookup_name)
                    }
                    v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, route_name, "route constructor " + route_name + "::" + case_name, expr_span)
                    if case_name == "" {
                        v4_ty_add_error_diag(ty_id, expr_span, "route constructor needs case name", "use " + route_name + "::CaseName")
                        give back
                    }
                    if not v4_ty_is_route_type(ty_id, route_lookup_name) {
                        v4_ty_add_error_diag(ty_id, expr_span, "unknown route constructor", route_name + " is not a known route")
                        give back
                    }
                    if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
                        v4_ty_add_error_diag(ty_id, expr_span, "unknown route case", route_name + " exposes no case " + case_name)
                        give back
                    }

                    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_lookup_name)
                    pilot route_sig_name = v4_ty_signature_name(ty_id, sig_id)
                    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
                    if instance_name == "" or instance_name == v4_ty_unknown {
                        instance_name = route_name
                    }
                    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
                    if env == v4_ty_generic_env_fail {
                        give back
                    }

                    pilot field_count = v4_ty_route_case_field_count(ty_id, route_lookup_name, case_name)
                    if field_count <= 0 {
                        v4_ty_add_error_diag(ty_id, expr_span, "route case has no payload", route_name + "::" + case_name + " carries no fields")
                        give back
                    }

                    pilot seen_fields = ""
                    pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
                    if field_start < last {
                        repeat until field_start >= last {
                            pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, last)
                            pilot field_span = v4_ty_span_from_tokens(stream_id, field_start, field_end)
                            pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
                            pilot field_name = ""
                            if name_token < field_end {
                                field_name = v4_lex_token_value(stream_id, name_token)
                            }
                            pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
                            if colon_token < 0 or field_name == "" {
                                v4_ty_add_error_diag(ty_id, field_span, "malformed route field", "expected field: value inside " + route_name + "::" + case_name)
                            } else {
                                if v4_ty_const_name_list_contains(seen_fields, field_name) {
                                    v4_ty_add_error_diag(ty_id, field_span, "duplicate route case field", field_name + " already set on " + route_name + "::" + case_name)
                                } else {
                                    seen_fields = v4_ty_const_name_list_add(seen_fields, field_name)
                                }

                                pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                                v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)

                                pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_lookup_name, case_name, field_name)
                                if field_id < 0 {
                                    v4_ty_add_error_diag(ty_id, field_span, "unknown route case field", route_name + "::" + case_name + " has no field " + field_name)
                                } else {
                                    pilot raw_expected_ty = v4_ty_route_case_field_type(ty_id, route_sig_name, case_name, field_id)
                                    pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                                    pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                                    pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                                    if next_env == v4_ty_generic_env_fail {
                                        if expected_ty == "" {
                                            expected_ty = raw_expected_ty
                                        }
                                        v4_ty_add_error_diag(ty_id, field_span, "route case field type mismatch", route_name + "::" + case_name + "." + field_name + " expects " + expected_ty + " but got " + actual_ty)
                                    } else {
                                        env = next_env
                                    }
                                }
                            }
                            field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
                        }
                    }

                    pilot required_field_id = 0
                    repeat until required_field_id >= field_count {
                        pilot required_name = v4_ty_route_case_field_name(ty_id, route_lookup_name, case_name, required_field_id)
                        if required_name != "" and not v4_ty_const_name_list_contains(seen_fields, required_name) {
                            v4_ty_add_error_diag(ty_id, expr_span, "missing route case field", route_name + "::" + case_name + " requires field " + required_name)
                        }
                        required_field_id += 1
                    }
                    give back
                }

                pilot shape_lookup_name = ctor_name
                if v4_ty_is_generic_instance_type(shape_lookup_name) {
                    shape_lookup_name = v4_ty_generic_base_name(shape_lookup_name)
                }
                v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, ctor_name, "shape constructor " + ctor_name, expr_span)
                pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_lookup_name)
                if sig_id < 0 {
                    v4_ty_add_error_diag(ty_id, expr_span, "unknown shape constructor", ctor_name + " is not a known shape")
                    give back
                }

                pilot instance_name = v4_ty_canonical_type(ty_id, ctor_name)
                if instance_name == "" or instance_name == v4_ty_unknown {
                    instance_name = ctor_name
                }
                pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name)
                if env == v4_ty_generic_env_fail {
                    give back
                }
                pilot seen_fields = ""
                pilot field_start = v4_ty_skip_trivia(stream_id, open_token + 1)
                if field_start < last {
                    repeat until field_start >= last {
                        pilot field_end = v4_ty_const_ctor_field_end(stream_id, field_start, last)
                        pilot field_span = v4_ty_span_from_tokens(stream_id, field_start, field_end)
                        pilot name_token = v4_ty_skip_trivia(stream_id, field_start)
                        pilot field_name = ""
                        if name_token < field_end {
                            field_name = v4_lex_token_value(stream_id, name_token)
                        }
                        pilot colon_token = v4_ty_find_top_level_token(stream_id, field_start, field_end, ":")
                        if colon_token < 0 or field_name == "" {
                            v4_ty_add_error_diag(ty_id, field_span, "malformed shape field", "expected field: value inside " + ctor_name)
                        } else {
                            if v4_ty_const_name_list_contains(seen_fields, field_name) {
                                v4_ty_add_error_diag(ty_id, field_span, "duplicate shape field", field_name + " already set on " + ctor_name)
                            } else {
                                seen_fields = v4_ty_const_name_list_add(seen_fields, field_name)
                            }

                            pilot value_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
                            v4_ty_validate_const_expr_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)

                            pilot shape_field_id = v4_ty_shape_field_id_for_name(ty_id, shape_lookup_name, field_name)
                            if shape_field_id < 0 {
                                v4_ty_add_error_diag(ty_id, field_span, "unknown shape field", ctor_name + " has no field " + field_name)
                            } else {
                                pilot raw_expected_ty = v4_ty_shape_field_type(ty_id, sig_id, shape_field_id)
                                pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                                pilot actual_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, owner_sig, stream_id, value_start, field_end, seen_consts)
                                pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                                if next_env == v4_ty_generic_env_fail {
                                    if expected_ty == "" {
                                        expected_ty = raw_expected_ty
                                    }
                                    v4_ty_add_error_diag(ty_id, field_span, "shape field type mismatch", ctor_name + "." + field_name + " expects " + expected_ty + " but got " + actual_ty)
                                } else {
                                    env = next_env
                                }
                            }
                        }
                        field_start = v4_ty_skip_trivia(stream_id, field_end + 1)
                    }
                }

                pilot required_field_id = 0
                pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
                repeat until required_field_id >= field_count {
                    pilot required_name = v4_ty_shape_field_name(ty_id, sig_id, required_field_id)
                    if required_name != "" and not v4_ty_const_name_list_contains(seen_fields, required_name) {
                        v4_ty_add_error_diag(ty_id, expr_span, "missing shape field", ctor_name + " requires field " + required_name)
                    }
                    required_field_id += 1
                }
                give back
            }
        }
    }

    pilot second = v4_ty_next_nontrivia(stream_id, first + 1, end_token)
    if second < end_token {
        pilot ctor_name = v4_ty_const_constructor_head_name(stream_id, first, end_token)
        if ctor_name != "" {
            pilot route_name = v4_ty_const_path_left(ctor_name)
            pilot case_name = v4_ty_const_path_right(ctor_name)
            pilot route_lookup_name = route_name
            if v4_ty_is_generic_instance_type(route_lookup_name) {
                route_lookup_name = v4_ty_generic_base_name(route_lookup_name)
            }
            v4_ty_validate_signature_type_lifetimes(ty_id, owner_sig, route_name, "route constructor " + route_name + "::" + case_name, expr_span)
            if route_name != "" {
                if case_name == "" {
                    v4_ty_add_error_diag(ty_id, expr_span, "route constructor needs case name", "use " + route_name + "::CaseName")
                    give back
                }
                if not v4_ty_is_route_type(ty_id, route_lookup_name) {
                    v4_ty_add_error_diag(ty_id, expr_span, "unknown route constructor", route_name + " is not a known route")
                    give back
                }
                if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
                    v4_ty_add_error_diag(ty_id, expr_span, "unknown route case", route_name + " exposes no case " + case_name)
                    give back
                }
                pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_lookup_name)
                pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
                if instance_name == "" or instance_name == v4_ty_unknown {
                    instance_name = route_name
                }
                if v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_name) == v4_ty_generic_env_fail {
                    give back
                }
                if v4_ty_route_case_has_payload(ty_id, route_lookup_name, case_name) {
                    v4_ty_add_error_diag(ty_id, expr_span, "route payload constructor needs fields", route_name + "::" + case_name + " expects named fields")
                }
            }
        }
    }
}

task v4_ty_const_value_type_for_sig_seen(ty_id: int, sig_id: int, seen_consts: word) -> word {
    pilot const_name = v4_ty_signature_name(ty_id, sig_id)
    if v4_ty_const_cycle_seen_contains(seen_consts, const_name) {
        give back v4_ty_unknown
    }
    pilot declared_ty = v4_ty_const_declared_type_for_sig(ty_id, sig_id)
    if declared_ty != "" {
        give back v4_ty_canonical_type(ty_id, declared_ty)
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot init_start = v4_ty_const_init_start_token(ty_id, sig_id)
    pilot init_end = v4_ty_const_init_end_token(ty_id, sig_id)
    if stream_id < 0 or init_start < 0 or init_end <= init_start {
        give back v4_ty_unknown
    }
    pilot next_seen = v4_ty_const_cycle_seen_append(seen_consts, const_name)
    give back v4_ty_const_expr_type_from_tokens_seen(ty_id, sig_id, stream_id, init_start, init_end, next_seen)
}

task v4_ty_const_value_type_for_sig(ty_id: int, sig_id: int) -> word {
    give back v4_ty_const_value_type_for_sig_seen(ty_id, sig_id, "")
}

task v4_ty_const_value_type_for_name(ty_id: int, const_name: word) -> word {
    pilot sig_id = v4_ty_const_signature_id_for_name(ty_id, const_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_const_value_type_for_sig(ty_id, sig_id)
}

task v4_ty_const_cycle_seen_contains(seen_consts: word, const_name: word) -> bool {
    if seen_consts == "" or const_name == "" {
        give back false
    }
    give back ("|" + seen_consts + "|").contains("|" + const_name + "|")
}

task v4_ty_const_cycle_seen_append(seen_consts: word, const_name: word) -> word {
    if const_name == "" {
        give back seen_consts
    }
    if seen_consts == "" {
        give back const_name
    }
    give back seen_consts + "|" + const_name
}

task v4_ty_compact_const_expr_text(expr: word) -> word {
    pilot out = ""
    pilot idx = 0
    repeat until idx >= expr.length() {
        pilot ch = expr.char_at(idx)
        if ch != " " and ch != "\t" and ch != "\n" and ch != "\r" {
            out = out + ch
        }
        idx += 1
    }
    give back out
}

task v4_ty_const_expr_is_wrapped(expr: word) -> bool {
    if expr.length() < 2 {
        give back false
    }
    if expr.char_at(0) != "(" or expr.char_at(expr.length() - 1) != ")" {
        give back false
    }

    pilot depth = 0
    pilot idx = 0
    repeat until idx >= expr.length() {
        pilot ch = expr.char_at(idx)
        if ch == "(" {
            depth += 1
        } else if ch == ")" {
            depth -= 1
            if depth == 0 and idx < expr.length() - 1 {
                give back false
            }
        }
        idx += 1
    }
    give back depth == 0
}

task v4_ty_strip_const_expr_wrappers(expr: word) -> word {
    pilot out = v4_ty_compact_const_expr_text(expr)
    repeat until out.length() < 2 or v4_ty_const_expr_is_wrapped(out) == false {
        out = out.substring(1, out.length() - 1)
    }
    give back out
}

task v4_ty_integer_literal_value_text(value: word) -> word {
    pilot compact = v4_ty_strip_const_expr_wrappers(value)
    if compact == "" {
        give back v4_ty_unknown
    }

    pilot negative = false
    if compact.char_at(0) == "-" {
        if compact.length() <= 1 {
            give back v4_ty_unknown
        }
        negative = true
        compact = compact.substring(1, compact.length())
    }

    pilot digits = v4_ty_numeric_literal_value(compact)
    if digits == "" {
        give back v4_ty_unknown
    }

    pilot idx = 0
    repeat until idx >= digits.length() {
        pilot ch = digits.char_at(idx)
        if not v4_lex_is_digit(ch) {
            give back v4_ty_unknown
        }
        idx += 1
    }

    if negative {
        give back "-" + digits
    }
    give back digits
}

task v4_ty_const_expr_is_prefix_operator(expr: word, idx: int) -> bool {
    if idx <= 0 {
        give back true
    }
    pilot prev = expr.char_at(idx - 1)
    give back prev == "+" or prev == "-" or prev == "*" or prev == "/" or prev == "%" or prev == "("
}

task v4_ty_const_expr_last_top_level_operator(expr: word, first: word, second: word) -> int {
    pilot depth = 0
    pilot idx = expr.length() - 1
    repeat until idx < 0 {
        pilot ch = expr.char_at(idx)
        if ch == ")" {
            depth += 1
        } else if ch == "(" {
            if depth > 0 {
                depth -= 1
            }
        } else if depth == 0 {
            if ch == first or (second != "" and ch == second) {
                if (ch == "+" or ch == "-") and v4_ty_const_expr_is_prefix_operator(expr, idx) {
                    -- unary prefix, not a binary split point
                } else {
                    give back idx
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_ty_const_expr_last_top_level_mul_operator(expr: word) -> int {
    pilot depth = 0
    pilot idx = expr.length() - 1
    repeat until idx < 0 {
        pilot ch = expr.char_at(idx)
        if ch == ")" {
            depth += 1
        } else if ch == "(" {
            if depth > 0 {
                depth -= 1
            }
        } else if depth == 0 {
            if ch == "*" or ch == "/" or ch == "%" {
                give back idx
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_ty_const_integer_apply_binary(op: word, left_text: word, right_text: word) -> word {
    if not v4_ty_is_integer_text_literal(left_text) or not v4_ty_is_integer_text_literal(right_text) {
        give back v4_ty_unknown
    }

    pilot left = word_to_int(left_text)
    pilot right = word_to_int(right_text)
    if op == "+" {
        give back word_from_int(left + right)
    }
    if op == "-" {
        give back word_from_int(left - right)
    }
    if op == "*" {
        give back word_from_int(left * right)
    }
    if op == "/" {
        if right == 0 {
            give back v4_ty_unknown
        }
        give back word_from_int(left / right)
    }
    if op == "%" {
        if right == 0 {
            give back v4_ty_unknown
        }
        give back word_from_int(left % right)
    }
    give back v4_ty_unknown
}

task v4_ty_const_integer_text_from_expr_seen(ty_id: int, expr_text: word, seen_consts: word) -> word {
    pilot expr = v4_ty_strip_const_expr_wrappers(expr_text)
    if expr == "" {
        give back v4_ty_unknown
    }

    pilot literal = v4_ty_integer_literal_value_text(expr)
    if literal != v4_ty_unknown {
        give back literal
    }

    pilot additive_split = v4_ty_const_expr_last_top_level_operator(expr, "+", "-")
    if additive_split >= 0 {
        pilot left = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(0, additive_split), seen_consts)
        pilot right = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(additive_split + 1, expr.length()), seen_consts)
        give back v4_ty_const_integer_apply_binary(expr.char_at(additive_split), left, right)
    }

    pilot multiplicative_split = v4_ty_const_expr_last_top_level_mul_operator(expr)
    if multiplicative_split >= 0 {
        pilot left = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(0, multiplicative_split), seen_consts)
        pilot right = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(multiplicative_split + 1, expr.length()), seen_consts)
        give back v4_ty_const_integer_apply_binary(expr.char_at(multiplicative_split), left, right)
    }

    if expr.char_at(0) == "+" and expr.length() > 1 {
        give back v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(1, expr.length()), seen_consts)
    }
    if expr.char_at(0) == "-" and expr.length() > 1 {
        pilot inner = v4_ty_const_integer_text_from_expr_seen(ty_id, expr.substring(1, expr.length()), seen_consts)
        if inner != v4_ty_unknown and inner.char_at(0) != "-" {
            give back "-" + inner
        }
    }

    pilot sig_id = v4_ty_const_signature_id_for_name(ty_id, expr)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_const_integer_text_for_sig_seen(ty_id, sig_id, seen_consts)
}

task v4_ty_const_integer_text_from_expr(ty_id: int, expr_text: word) -> word {
    give back v4_ty_const_integer_text_from_expr_seen(ty_id, expr_text, "")
}

task v4_ty_const_integer_text_for_sig_seen(ty_id: int, sig_id: int, seen_consts: word) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back v4_ty_unknown
    }

    pilot const_name = v4_ty_signature_name(ty_id, sig_id)
    if const_name == "" {
        give back v4_ty_unknown
    }
    if v4_ty_const_cycle_seen_contains(seen_consts, const_name) {
        give back v4_ty_unknown
    }
    pilot declared_ty = v4_ty_const_declared_type_for_sig(ty_id, sig_id)
    if declared_ty != "" {
        declared_ty = v4_ty_canonical_type(ty_id, declared_ty)
    }
    if declared_ty != "" and not v4_ty_is_integer(declared_ty) {
        give back v4_ty_unknown
    }
    give back v4_ty_const_integer_text_from_expr_seen(ty_id, v4_ty_const_init_text_for_sig(ty_id, sig_id), v4_ty_const_cycle_seen_append(seen_consts, const_name))
}

task v4_ty_const_integer_text_for_sig(ty_id: int, sig_id: int) -> word {
    give back v4_ty_const_integer_text_for_sig_seen(ty_id, sig_id, "")
}

task v4_ty_const_integer_text_for_name(ty_id: int, const_name: word) -> word {
    pilot sig_id = v4_ty_const_signature_id_for_name(ty_id, const_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_const_integer_text_for_sig(ty_id, sig_id)
}

task v4_ty_const_dep_name_at_token(ty_id: int, stream_id: int, token_id: int, start_token: int, end_token: int) -> word {
    pilot tok_type = v4_lex_token_type(stream_id, token_id)
    if tok_type != v4_tok_ident and tok_type != v4_tok_keyword {
        give back ""
    }

    pilot token_value = v4_lex_token_value(stream_id, token_id)
    if v4_ty_const_signature_id_for_name(ty_id, token_value) < 0 {
        give back ""
    }

    pilot prev_token = v4_ty_prev_nontrivia(stream_id, token_id - 1, start_token)
    if prev_token >= start_token {
        pilot prev_value = v4_lex_token_value(stream_id, prev_token)
        if prev_value == "." or prev_value == "::" {
            give back ""
        }
    }

    pilot next_token = v4_ty_next_nontrivia(stream_id, token_id + 1, end_token)
    if next_token < end_token {
        pilot next_value = v4_lex_token_value(stream_id, next_token)
        if next_value == ":" or next_value == "::" or next_value == "(" {
            give back ""
        }
    }

    give back token_value
}

task v4_ty_const_cycle_path_for_sig(ty_id: int, sig_id: int, seen_consts: word) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_const_sig {
        give back ""
    }

    pilot const_name = v4_ty_signature_name(ty_id, sig_id)
    pilot next_seen = v4_ty_const_cycle_seen_append(seen_consts, const_name)
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_const_init_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_const_init_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }

    pilot token_id = start_token
    repeat until token_id >= end_token {
        pilot dep_name = v4_ty_const_dep_name_at_token(ty_id, stream_id, token_id, start_token, end_token)
        if dep_name != "" {
            if v4_ty_const_cycle_seen_contains(next_seen, dep_name) {
                give back v4_ty_const_cycle_seen_append(next_seen, dep_name)
            }
            pilot dep_sig = v4_ty_const_signature_id_for_name(ty_id, dep_name)
            if dep_sig >= 0 {
                pilot dep_path = v4_ty_const_cycle_path_for_sig(ty_id, dep_sig, next_seen)
                if dep_path != "" {
                    give back dep_path
                }
            }
        }
        token_id += 1
    }
    give back ""
}

task v4_ty_validate_const_cycles(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_const_sig {
            pilot cycle_path = v4_ty_const_cycle_path_for_sig(ty_id, sig_id, "")
            if cycle_path != "" {
                pilot const_name = v4_ty_signature_name(ty_id, sig_id)
                pilot span = v4_ty_const_name_span(ty_id, sig_id)
                v4_ty_add_error_diag(ty_id, span, "Yuuko constant loop: fixed pilot " + const_name + " depends on itself via " + v4_ty_alias_cycle_chain_display(cycle_path), "break the constant cycle with a literal or a const task boundary")
            }
        }
        sig_id += 1
    }
}

task v4_ty_validate_const_initializers(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_const_sig {
            pilot const_name = v4_ty_signature_name(ty_id, sig_id)
            pilot declared_ty = v4_ty_const_declared_type_for_sig(ty_id, sig_id)
            pilot stream_id = v4_ty_signature_stream_id(ty_id)
            pilot init_start = v4_ty_const_init_start_token(ty_id, sig_id)
            pilot init_end = v4_ty_const_init_end_token(ty_id, sig_id)
            if stream_id >= 0 and init_start >= 0 and init_end > init_start {
                v4_ty_validate_const_expr_seen(ty_id, sig_id, stream_id, init_start, init_end, v4_ty_const_cycle_seen_append("", const_name))
            }
            if declared_ty != "" {
                declared_ty = v4_ty_canonical_type(ty_id, declared_ty)
                if stream_id >= 0 and init_start >= 0 and init_end > init_start {
                    pilot init_ty = v4_ty_const_expr_type_from_tokens_seen(ty_id, sig_id, stream_id, init_start, init_end, const_name)
                    if init_ty != v4_ty_unknown and not v4_ty_types_compatible_in_signature(ty_id, sig_id, declared_ty, init_ty) {
                        pilot span = v4_ty_span_from_tokens(stream_id, init_start, init_end)
                        v4_ty_add_error_diag(ty_id, span, "constant initializer type mismatch", "fixed pilot " + const_name + " expects " + declared_ty + " but got " + init_ty)
                    }
                }
            }
        }
        sig_id += 1
    }
}

task v4_ty_skip_item(stream_id: int, start_token: int, end_limit: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_body = false
    pilot count = end_limit
    if count > v4_lex_token_count(stream_id) {
        count = v4_lex_token_count(stream_id)
    }

    repeat until idx >= count {
        if v4_lex_token_type(stream_id, idx) == v4_tok_eof {
            give back idx
        }

        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia and val == "\n" and not saw_body and depth == 0 {
            give back idx + 1
        }

        if tok_type != v4_tok_trivia {
            if val == "{" {
                depth += 1
                saw_body = true
            } else if val == "}" {
                if depth > 0 {
                    depth -= 1
                }
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "done" {
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "=>" {
                saw_body = true
            }
        }
        idx += 1
    }
    give back idx
}

task v4_ty_impl_target_type_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back ""
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back ""
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token >= 0 {
        pilot type_start = v4_ty_skip_trivia(stream_id, for_token + 1)
        give back v4_ty_type_text(stream_id, type_start, open_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    give back v4_ty_type_text(stream_id, type_start, open_token)
}

task v4_ty_impl_doctrine_name_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back ""
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back ""
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token < 0 {
        give back ""
    }
    pilot doctrine_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    if doctrine_start >= for_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, doctrine_start, for_token)
}

task v4_ty_impl_target_span_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back V4_NO_SPAN
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back V4_NO_SPAN
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back V4_NO_SPAN
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token >= 0 {
        pilot type_start = v4_ty_skip_trivia(stream_id, for_token + 1)
        give back v4_ty_span_from_tokens(stream_id, type_start, open_token)
    }

    pilot type_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    give back v4_ty_span_from_tokens(stream_id, type_start, open_token)
}

task v4_ty_alias_lookup_name_from_surface_name(ty_id: int, surface_name: word) -> word {
    if surface_name == "" or surface_name == v4_ty_unknown {
        give back ""
    }
    if v4_ty_alias_signature_id_for_name(ty_id, surface_name) >= 0 {
        give back surface_name
    }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if resolve_id >= 0 {
        pilot direct_symbol = v4_resolve_lookup_any(resolve_id, surface_name)
        if direct_symbol >= 0 {
            if v4_resolve_symbol_kind(resolve_id, direct_symbol) == v4_hir_alias {
                pilot target_name = v4_resolve_symbol_target_name(resolve_id, direct_symbol)
                if target_name != "" and target_name != surface_name {
                    if v4_ty_alias_signature_id_for_name(ty_id, target_name) >= 0 {
                        give back target_name
                    }
                }
            }
        }
        pilot expanded = v4_resolve_expand_import_name(resolve_id, surface_name)
        if expanded != "" and expanded != surface_name {
            if v4_ty_alias_signature_id_for_name(ty_id, expanded) >= 0 {
                give back expanded
            }
        }
    }
    give back ""
}

task v4_ty_alias_lookup_type_from_surface_type(ty_id: int, type_text: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot lookup_base = v4_ty_alias_lookup_name_from_surface_name(ty_id, base_name)
        if lookup_base != "" {
            give back lookup_base + v4_slice(type_text, base_name.length(), type_text.length())
        }
        give back ""
    }
    give back v4_ty_alias_lookup_name_from_surface_name(ty_id, type_text)
}

task v4_ty_alias_name_from_surface_type(ty_id: int, type_text: word) -> word {
    pilot lookup_type = v4_ty_alias_lookup_type_from_surface_type(ty_id, type_text)
    if lookup_type == "" {
        give back ""
    }
    if v4_ty_is_generic_instance_type(lookup_type) {
        give back v4_ty_generic_base_name(lookup_type)
    }
    give back lookup_type
}

task v4_ty_impl_target_alias_name_from_hir(ty_id: int, hir_item: int) -> word {
    give back v4_ty_alias_name_from_surface_type(ty_id, v4_ty_impl_target_type_from_hir(ty_id, hir_item))
}

task v4_ty_impl_body_open_token_from_hir(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_impl_body_close_token_from_hir(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_hir_item_end_token(hir_id, hir_item))
}

task v4_ty_impl_method_count(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_impl_method_start_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 or method_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == method_id {
                give back idx
            }
            current += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_ty_impl_method_end_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_skip_item(stream_id, start_token, close_token)
}

task v4_ty_impl_method_name(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    if start_token < 0 {
        give back ""
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    if name_token < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, name_token)
}

task v4_ty_impl_method_param_open_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_impl_method_param_close_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
    if open_token < 0 or end_token <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, end_token)
}

task v4_ty_impl_method_param_count(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id), v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id))
}

task v4_ty_impl_method_param_name(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_impl_method_param_mode(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_param_mode_value
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_mode_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_impl_method_param_type(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    pilot param_name = v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
    if param_name == "self" {
        give back v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_impl_method_is_instance(ty_id: int, hir_item: int, method_id: int) -> bool {
    if v4_ty_impl_method_param_count(ty_id, hir_item, method_id) <= 0 {
        give back false
    }
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, 0) == "self"
}

task v4_ty_impl_method_explicit_param_count(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot count = v4_ty_impl_method_param_count(ty_id, hir_item, method_id)
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        if count > 0 {
            give back count - 1
        }
    }
    give back count
}

task v4_ty_impl_method_explicit_param_name(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_impl_method_explicit_param_type(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_impl_method_explicit_param_mode(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_mode(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_match_type_pattern_env(ty_id: int, pattern_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    pilot canonical_pattern = v4_ty_canonical_type(ty_id, pattern_ty)
    if canonical_pattern != "" and canonical_pattern != v4_ty_unknown {
        pattern_ty = canonical_pattern
    }
    pilot canonical_actual = v4_ty_canonical_type(ty_id, actual_ty)
    if canonical_actual != "" and canonical_actual != v4_ty_unknown {
        actual_ty = canonical_actual
    }
    if pattern_ty == "" or pattern_ty == v4_ty_unknown or not v4_ty_is_known(actual_ty) {
        give back v4_ty_generic_env_fail
    }
    if pattern_ty == actual_ty {
        give back env
    }
    if v4_ty_is_numeric(pattern_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_raw_pointer_type(pattern_ty) and v4_ty_is_raw_pointer_type(actual_ty) {
        if v4_ty_raw_pointer_prefix(pattern_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_type_pattern_env(ty_id, v4_ty_raw_pointer_target_type(pattern_ty), v4_ty_raw_pointer_target_type(actual_ty), env)
    }
    if v4_ty_is_generic_instance_type(pattern_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(pattern_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(pattern_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(pattern_ty)
        repeat until arg_idx >= arg_count {
            next_env = v4_ty_match_type_pattern_env(ty_id, v4_ty_generic_arg(pattern_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(pattern_ty) and v4_ty_is_tuple_type(actual_ty) {
        if v4_ty_tuple_slot_count(pattern_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(pattern_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_type_pattern_env(ty_id, v4_ty_tuple_slot_type(pattern_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(pattern_ty) and v4_ty_is_fixed_array_type(actual_ty) {
        if v4_ty_fixed_array_length_normalized_text(ty_id, pattern_ty) != v4_ty_fixed_array_length_normalized_text(ty_id, actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_type_pattern_env(ty_id, v4_ty_fixed_array_element_type(pattern_ty), v4_ty_fixed_array_element_type(actual_ty), env)
    }
    if not v4_ty_is_declared_simple_type_name(ty_id, pattern_ty) {
        give back v4_ty_generic_env_bind(env, pattern_ty, actual_ty)
    }
    if v4_ty_types_compatible(pattern_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_impl_generic_env_for_owner(ty_id: int, hir_item: int, owner_ty: word) -> word {
    give back v4_ty_match_type_pattern_env(ty_id, v4_ty_impl_target_type_from_hir(ty_id, hir_item), owner_ty, "")
}

task v4_ty_impl_matches_owner(ty_id: int, hir_item: int, owner_ty: word) -> bool {
    if v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item) != "" and v4_ty_impl_target_alias_name_from_hir(ty_id, hir_item) != "" {
        give back false
    }
    give back v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty) != v4_ty_generic_env_fail
}

task v4_ty_apply_impl_generics(ty_id: int, hir_item: int, owner_ty: word, member_ty: word) -> word {
    pilot env = v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty)
    if env == v4_ty_generic_env_fail {
        give back member_ty
    }
    give back v4_ty_apply_generic_env(member_ty, env)
}

task v4_ty_impl_method_param_type_for_owner(ty_id: int, hir_item: int, method_id: int, param_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id)))
}

task v4_ty_impl_method_explicit_param_type_for_owner(ty_id: int, hir_item: int, method_id: int, param_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_explicit_param_type(ty_id, hir_item, method_id, param_id)))
}

task v4_ty_impl_method_return_type(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, v4_ty_impl_method_start_token(ty_id, hir_item, method_id), v4_ty_impl_method_end_token(ty_id, hir_item, method_id)))
}

task v4_ty_impl_method_return_type_for_owner(ty_id: int, hir_item: int, method_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_return_type(ty_id, hir_item, method_id)))
}

task v4_ty_impl_method_def(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
    pilot file_id = v4_hir_file_id(hir_id)
    give back "file" + word_from_int(file_id) + "::Method::" + owner_ty + "." + method_name + "#" + word_from_int(hir_item) + ":" + word_from_int(method_id)
}

task v4_ty_impl_method_display(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
    pilot return_ty = v4_ty_impl_method_return_type(ty_id, hir_item, method_id)
    give back "task " + owner_ty + "::" + method_name + "(...) -> " + return_ty
}

task v4_ty_doctrine_signature_id_for_name(ty_id: int, doctrine_name: word) -> int {
    pilot lookup_name = doctrine_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_doctrine_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_doctrine_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_doctrine_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_doctrine_method_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_doctrine_method_start_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token or method_id < 0 {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == method_id {
                give back idx
            }
            current += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_ty_doctrine_method_end_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_skip_item(stream_id, start_token, close_token)
}

task v4_ty_doctrine_method_name(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, v4_ty_skip_trivia(stream_id, start_token + 1))
}

task v4_ty_doctrine_method_param_open_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_doctrine_method_param_close_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or end_token <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, end_token)
}

task v4_ty_doctrine_method_param_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0
    }
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id), v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id))
}

task v4_ty_doctrine_method_param_name(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back ""
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_param_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back v4_ty_unknown
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    if v4_ty_param_name_from_tokens(stream_id, start_token, end_token) == "self" {
        give back "Self"
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_doctrine_method_param_type_span(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back V4_NO_SPAN
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_type_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_is_instance(ty_id: int, sig_id: int, method_id: int) -> bool {
    if v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id) <= 0 {
        give back false
    }
    give back v4_ty_doctrine_method_param_name(ty_id, sig_id, method_id, 0) == "self"
}

task v4_ty_doctrine_method_explicit_param_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot count = v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id)
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) and count > 0 {
        give back count - 1
    }
    give back count
}

task v4_ty_doctrine_method_explicit_param_name(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        shift = 1
    }
    give back v4_ty_doctrine_method_param_name(ty_id, sig_id, method_id, param_id + shift)
}

task v4_ty_doctrine_method_explicit_param_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        shift = 1
    }
    give back v4_ty_doctrine_method_param_type(ty_id, sig_id, method_id, param_id + shift)
}

task v4_ty_doctrine_method_return_type(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_doctrine_method_return_span(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    give back v4_ty_task_return_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_apply_self_type(type_text: word, self_ty: word) -> word {
    pilot env = v4_ty_generic_env_bind("", "Self", self_ty)
    if env == v4_ty_generic_env_fail {
        give back type_text
    }
    give back v4_ty_apply_generic_env(type_text, env)
}

task v4_ty_doctrine_method_explicit_param_type_for_self(ty_id: int, sig_id: int, method_id: int, param_id: int, self_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_type(v4_ty_doctrine_method_explicit_param_type(ty_id, sig_id, method_id, param_id), self_ty))
}

task v4_ty_doctrine_method_return_type_for_self(ty_id: int, sig_id: int, method_id: int, self_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_type(v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id), self_ty))
}

task v4_ty_type_mentions_self(type_text: word) -> bool {
    if type_text == "Self" {
        give back true
    }
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_dyn_doctrine_name(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_type_mentions_self(v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back true
            }
            slot_id += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_mentions_self(v4_ty_fixed_array_element_type(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        if v4_ty_generic_base_name(type_text) == "Self" {
            give back true
        }
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_id >= arg_count {
            if v4_ty_type_mentions_self(v4_ty_generic_arg(type_text, arg_id)) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_ty_doctrine_method_object_safety_issue(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot method_name = v4_ty_doctrine_method_name(ty_id, sig_id, method_id)
    if not v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        give back "method " + method_name + " has no receiver"
    }

    pilot explicit_id = 0
    pilot explicit_count = v4_ty_doctrine_method_explicit_param_count(ty_id, sig_id, method_id)
    repeat until explicit_id >= explicit_count {
        pilot param_ty = v4_ty_doctrine_method_explicit_param_type(ty_id, sig_id, method_id, explicit_id)
        if v4_ty_type_mentions_self(param_ty) {
            pilot param_name = v4_ty_doctrine_method_explicit_param_name(ty_id, sig_id, method_id, explicit_id)
            if param_name == "" {
                param_name = word_from_int(explicit_id + 1)
            }
            give back "method " + method_name + " parameter " + param_name + " mentions Self"
        }
        explicit_id += 1
    }

    if v4_ty_type_mentions_self(v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id)) {
        give back "method " + method_name + " return mentions Self"
    }
    give back ""
}

task v4_ty_dyn_object_safety_issue(ty_id: int, dyn_ty: word) -> word {
    if not v4_ty_is_dyn_type(dyn_ty) {
        give back ""
    }
    pilot doctrine_name = v4_ty_dyn_doctrine_lookup_name(dyn_ty)
    if doctrine_name == "" {
        give back "dyn doctrine is malformed"
    }
    pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
    if doctrine_sig < 0 {
        give back "dyn " + doctrine_name + " needs a declared doctrine"
    }

    pilot method_id = 0
    pilot method_count = v4_ty_doctrine_method_count(ty_id, doctrine_sig)
    repeat until method_id >= method_count {
        pilot issue = v4_ty_doctrine_method_object_safety_issue(ty_id, doctrine_sig, method_id)
        if issue != "" {
            give back doctrine_name + "::" + issue
        }
        method_id += 1
    }
    give back ""
}

task v4_ty_dyn_type_is_object_safe(ty_id: int, dyn_ty: word) -> bool {
    give back v4_ty_dyn_object_safety_issue(ty_id, dyn_ty) == ""
}

task v4_ty_type_satisfies_doctrine(ty_id: int, actual_ty: word, doctrine_name: word) -> bool {
    if not v4_ty_is_known(actual_ty) or doctrine_name == "" {
        give back true
    }

    pilot wanted_doctrine = doctrine_name
    if v4_ty_is_generic_instance_type(wanted_doctrine) {
        wanted_doctrine = v4_ty_generic_base_name(wanted_doctrine)
    }
    if v4_ty_doctrine_signature_id_for_name(ty_id, wanted_doctrine) < 0 {
        give back false
    }

    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back false
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            pilot impl_doctrine = v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item)
            if v4_ty_is_generic_instance_type(impl_doctrine) {
                impl_doctrine = v4_ty_generic_base_name(impl_doctrine)
            }
            if impl_doctrine == wanted_doctrine {
                if v4_ty_impl_target_alias_name_from_hir(ty_id, hir_item) == "" {
                    if v4_ty_impl_matches_owner(ty_id, hir_item, actual_ty) {
                        give back true
                    }
                }
            }
        }
        hir_item += 1
    }
    give back false
}

task v4_ty_signature_type_satisfies_doctrine(ty_id: int, sig_id: int, actual_ty: word, doctrine_name: word) -> bool {
    if v4_ty_type_satisfies_doctrine(ty_id, actual_ty, doctrine_name) {
        give back true
    }
    if sig_id < 0 or actual_ty == "" or doctrine_name == "" {
        give back false
    }
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, sig_id, actual_ty)
    if generic_id < 0 {
        give back false
    }
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        pilot bound_name = v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx)
        if v4_ty_is_generic_instance_type(bound_name) {
            bound_name = v4_ty_generic_base_name(bound_name)
        }
        if bound_name == doctrine_name {
            give back true
        }
        bound_idx += 1
    }
    give back false
}

task v4_ty_type_can_coerce_to_dyn_in_signature(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    if not v4_ty_is_dyn_type(expected_ty) {
        give back false
    }
    if not v4_ty_dyn_type_is_object_safe(ty_id, expected_ty) {
        give back false
    }
    if v4_ty_is_dyn_type(actual_ty) {
        give back v4_ty_dyn_doctrine_lookup_name(expected_ty) == v4_ty_dyn_doctrine_lookup_name(actual_ty)
    }
    give back v4_ty_signature_type_satisfies_doctrine(ty_id, sig_id, actual_ty, v4_ty_dyn_doctrine_lookup_name(expected_ty))
}

task v4_ty_types_compatible_with_context(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    if v4_ty_types_compatible(expected_ty, actual_ty) {
        give back true
    }
    if v4_ty_type_can_coerce_to_dyn_in_signature(ty_id, sig_id, expected_ty, actual_ty) {
        give back true
    }
    give back false
}

task v4_ty_display_for_hir_item(symbol_kind: word, symbol_name: word, symbol_def: word, hir_id: int, hir_item: int) -> word {
    pilot generic_text = v4_ty_hir_item_generic_text(hir_id, hir_item)
    if symbol_kind == v4_hir_task {
        if v4_resolve_is_extern_member_def(symbol_def) {
            pilot tree_id = v4_hir_tree_id(hir_id)
            pilot stream_id = v4_parse_stream_id(tree_id)
            pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
            pilot member_id = v4_resolve_extern_member_id_from_def(symbol_def)
            pilot member_start = v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
            pilot member_end = v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
            give back "task " + symbol_name + "(...) -> " + v4_ty_task_return_from_tokens(stream_id, member_start, member_end)
        }
        give back "task " + symbol_name + generic_text + "(...) -> " + v4_ty_task_return_from_hir(hir_id, hir_item)
    }
    if symbol_kind == v4_hir_const {
        pilot const_ty = v4_hir_const_type(hir_id, hir_item)
        if const_ty != "" {
            give back "fixed pilot " + symbol_name + ": " + const_ty
        }
        give back "fixed pilot " + symbol_name
    }
    if symbol_kind == v4_hir_shape {
        give back "shape " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_route {
        give back v4_ty_route_surface_keyword(hir_id, hir_item) + " " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_alias {
        pilot alias_target = v4_hir_alias_target(hir_id, hir_item)
        if alias_target != "" {
            give back "alias " + symbol_name + " = " + alias_target
        }
        give back "alias " + symbol_name
    }
    if symbol_kind == v4_hir_doctrine {
        give back "doctrine " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_extern {
        pilot extern_spec = v4_ty_trim_spaces(v4_hir_extern_abi(hir_id, hir_item))
        if extern_spec != "" {
            give back "extern [" + extern_spec + "]"
        }
        give back "extern"
    }
    if symbol_kind == v4_hir_import {
        pilot import_path = v4_hir_import_path(hir_id, hir_item)
        pilot import_alias = v4_hir_import_alias(hir_id, hir_item)
        if import_path != "" {
            if import_alias != "" {
                give back "use " + import_path + " as " + import_alias
            }
            give back "use " + import_path
        }
    }
    if symbol_kind == v4_hir_attribute {
        pilot attr_arg = v4_hir_attribute_arg(hir_id, hir_item)
        if attr_arg != "" {
            give back "@" + symbol_name + "(" + attr_arg + ")"
        }
        give back "@" + symbol_name
    }
    give back v4_ty_display_for_symbol(symbol_kind, symbol_name)
}

task v4_ty_signature_return_type(ty_id: int, sig_id: int) -> word {
    pilot display = v4_ty_signature_display(ty_id, sig_id)
    pilot i = 0
    repeat until i + 2 >= display.length() {
        if display.char_at(i) == "-" and display.char_at(i + 1) == ">" {
            pilot start_pos = i + 2
            if start_pos < display.length() and display.char_at(start_pos) == " " {
                start_pos += 1
            }
            give back v4_ty_canonical_type(ty_id, v4_slice(display, start_pos, display.length()))
        }
        i += 1
    }
    give back v4_ty_unknown
}

task v4_ty_signature_return_surface_type(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_shape_signature_id_for_name(ty_id: int, shape_name: word) -> int {
    pilot lookup_name = shape_name
    pilot alias_lookup = v4_ty_alias_target_type(ty_id, lookup_name)
    if alias_lookup != "" and alias_lookup != v4_ty_unknown {
        lookup_name = v4_ty_canonical_type(ty_id, alias_lookup)
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_shape_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_signature_id_for_name(ty_id: int, route_name: word) -> int {
    pilot lookup_name = route_name
    pilot alias_lookup = v4_ty_alias_target_type(ty_id, lookup_name)
    if alias_lookup != "" and alias_lookup != v4_ty_unknown {
        lookup_name = v4_ty_canonical_type(ty_id, alias_lookup)
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_route_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_is_route_type(ty_id: int, route_name: word) -> bool {
    give back v4_ty_route_signature_id_for_name(ty_id, route_name) >= 0
}

task v4_ty_route_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_route_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_route_is_case_separator(val: word) -> bool {
    give back val == "," or val == ";" or val == "/"
}

task v4_ty_route_case_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_case = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_case = false
            }
        } else {
            if depth == 0 and v4_ty_route_is_case_separator(val) {
                in_case = false
            } else {
                if not in_case {
                    count += 1
                    in_case = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_route_case_segment_start(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == case_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and v4_ty_route_is_case_separator(val) {
                if segment_start >= 0 {
                    if current == case_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == case_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_route_case_segment_end(ty_id: int, sig_id: int, case_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and v4_ty_route_is_case_separator(val) {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_route_case_segment_span(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_route_case_name(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_route_case_discriminant_equals_token(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, end_token, "=")
}

task v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot eq_token = v4_ty_route_case_discriminant_equals_token(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or eq_token < 0 or end_token <= eq_token {
        give back ""
    }
    pilot value_token = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if value_token >= end_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, value_token, end_token)
}

task v4_ty_route_case_explicit_discriminant_span_by_sig(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot eq_token = v4_ty_route_case_discriminant_equals_token(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or eq_token < 0 or end_token <= eq_token {
        give back V4_NO_SPAN
    }
    pilot value_token = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if value_token >= end_token {
        give back v4_lex_token_span(stream_id, eq_token)
    }
    give back v4_ty_span_from_tokens(stream_id, value_token, end_token)
}

task v4_ty_route_case_id_for_name(ty_id: int, route_name: word, case_name: word) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        if v4_ty_route_case_name(ty_id, sig_id, case_id) == case_name {
            give back case_id
        }
        case_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_has_case(ty_id: int, route_name: word, case_name: word) -> bool {
    give back v4_ty_route_case_id_for_name(ty_id, route_name, case_name) >= 0
}

task v4_ty_route_case_explicit_discriminant_text(ty_id: int, route_name: word, case_name: word) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if sig_id < 0 or case_id < 0 {
        give back ""
    }
    give back v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
}

task v4_ty_route_case_discriminant_value_by_sig(ty_id: int, sig_id: int, case_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back ""
    }
    pilot current = 0
    pilot scan_id = 0
    repeat until scan_id > case_id {
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, scan_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown {
                give back ""
            }
            current = word_to_int(resolved)
        }
        if scan_id == case_id {
            give back word_from_int(current)
        }
        current += 1
        scan_id += 1
    }
    give back ""
}

task v4_ty_route_case_discriminant_value(ty_id: int, route_name: word, case_name: word) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if sig_id < 0 or case_id < 0 {
        give back ""
    }
    give back v4_ty_route_case_discriminant_value_by_sig(ty_id, sig_id, case_id)
}

task v4_ty_route_case_payload_open_token(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, end_token, "{")
}

task v4_ty_route_case_payload_close_token(ty_id: int, sig_id: int, case_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_route_case_segment_end(ty_id, sig_id, case_id))
}

task v4_ty_route_case_has_payload(ty_id: int, route_name: word, case_name: word) -> bool {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back false
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back false
    }
    give back v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id) >= 0
}

task v4_ty_route_case_field_count(ty_id: int, route_name: word, case_name: word) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_field = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_field = false
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                in_field = false
            } else {
                if not in_field {
                    count += 1
                    in_field = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_route_case_field_segment_start(ty_id: int, route_name: word, case_name: word, field_id: int) -> int {
    if field_id < 0 {
        give back 0 - 1
    }
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == field_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                if segment_start >= 0 {
                    if current == field_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == field_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_route_case_field_segment_end(ty_id: int, route_name: word, case_name: word, field_id: int) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and (val == "," or val == ";") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_route_case_field_name(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }

    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_route_case_field_type(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = route_name
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_signature_generics(ty_id, sig_id, instance_name, field_ty))
}

task v4_ty_route_case_field_type_span(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_route_case_field_id_for_name(ty_id: int, route_name: word, case_name: word, field_name: word) -> int {
    pilot field_id = 0
    pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
    repeat until field_id >= field_count {
        if v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) == field_name {
            give back field_id
        }
        field_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_case_field_type_for_name(ty_id: int, route_name: word, case_name: word, field_name: word) -> word {
    pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_name, case_name, field_name)
    if field_id >= 0 {
        give back v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id)
    }
    give back v4_ty_unknown
}

task v4_ty_shape_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_shape_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_shape_field_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_field = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_field = false
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                in_field = false
            } else {
                if not in_field {
                    count += 1
                    in_field = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_shape_field_segment_start(ty_id: int, sig_id: int, field_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig or field_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == field_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                if segment_start >= 0 {
                    if current == field_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == field_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_shape_field_segment_end(ty_id: int, sig_id: int, field_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and (val == "," or val == ";") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_shape_field_name(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_shape_field_type(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, field_ty)
}

task v4_ty_shape_field_surface_type(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    give back field_ty
}

task v4_ty_shape_field_type_span(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_shape_field_id_for_name(ty_id: int, shape_name: word, field_name: word) -> int {
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        if v4_ty_shape_field_name(ty_id, sig_id, field_id) == field_name {
            give back field_id
        }
        field_id += 1
    }
    give back 0 - 1
}

task v4_ty_shape_field_type_for_name(ty_id: int, shape_name: word, field_name: word) -> word {
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot field_id = v4_ty_shape_field_id_for_name(ty_id, shape_name, field_name)
    if field_id >= 0 {
        pilot instance_name = v4_ty_canonical_type(ty_id, shape_name)
        if instance_name == "" or instance_name == v4_ty_unknown {
            instance_name = shape_name
        }
        give back v4_ty_apply_signature_generics(ty_id, sig_id, instance_name, v4_ty_shape_field_type(ty_id, sig_id, field_id))
    }
    give back v4_ty_unknown
}

task v4_ty_lifetime_is_implicit(lifetime_name: word) -> bool {
    give back lifetime_name == "'static"
}

task v4_ty_signature_accepts_lifetime(ty_id: int, sig_id: int, lifetime_name: word) -> bool {
    if v4_ty_lifetime_is_implicit(lifetime_name) {
        give back true
    }
    give back v4_ty_signature_declares_lifetime_name(ty_id, sig_id, lifetime_name)
}

task v4_ty_alias_target_span(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot eq_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, "=")
    if eq_token < 0 {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, eq_token + 1)
    if type_start >= end_token {
        give back v4_ty_span_from_tokens(stream_id, start_token, end_token)
    }
    give back v4_ty_span_from_tokens(stream_id, type_start, end_token)
}

task v4_ty_validate_signature_generic_names(ty_id: int, sig_id: int) -> void {
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
        pilot generic_span = v4_ty_signature_generic_segment_span(ty_id, sig_id, generic_id)
        if generic_name == "" {
            v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: empty generic slot on " + v4_ty_signature_name(ty_id, sig_id), "")
        }

        pilot previous_id = 0
        repeat until previous_id >= generic_id {
            if v4_ty_signature_generic_name(ty_id, sig_id, previous_id) == generic_name {
                v4_ty_add_error_diag(ty_id, generic_span, "Meiya lifetime debt: duplicate generic " + generic_name + " on " + v4_ty_signature_name(ty_id, sig_id) + "; every route through Alternative IV needs one owner", "")
            }
            previous_id += 1
        }
        generic_id += 1
    }
}

task v4_ty_validate_signature_type_lifetimes(ty_id: int, sig_id: int, type_text: word, context: word, context_span: word) -> void {
    if type_text == "" or type_text == v4_ty_unknown {
        give back
    }

    if v4_ty_is_lifetime_name(type_text) {
        v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + type_text + " cannot be used as a value type in " + context, "")
    }

    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        pilot lifetime_name = v4_ty_type_lifetime_name(type_text, lifetime_id)
        if v4_ty_signature_accepts_lifetime(ty_id, sig_id, lifetime_name) == false {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + lifetime_name + " is used in " + context + " but is not declared on " + v4_ty_signature_name(ty_id, sig_id), "")
        }
        lifetime_id += 1
    }

    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, type_text, context, context_span)
}

task v4_ty_validate_signature_type_generic_contracts(ty_id: int, sig_id: int, type_text: word, context: word, context_span: word) -> void {
    if type_text == "" or type_text == v4_ty_unknown {
        give back
    }

    if v4_ty_is_raw_pointer_type(type_text) {
        pilot target_type = v4_ty_raw_pointer_target_type(type_text)
        if v4_ty_is_lifetime_name(target_type) {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + target_type + " cannot be used as a value type behind pointer in " + context, "")
        } else {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, target_type, "pointer target of " + context, context_span)
        }
        give back
    }

    if v4_ty_is_dyn_type(type_text) {
        pilot doctrine_type = v4_ty_dyn_doctrine_name(type_text)
        pilot doctrine_name = v4_ty_dyn_doctrine_lookup_name(type_text)
        if doctrine_name == "" or v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name) < 0 {
            v4_ty_add_error_diag(ty_id, context_span, "dyn doctrine is unknown", "dyn " + doctrine_name + " needs a declared doctrine before Yuuko can build a vtable")
        } else {
            pilot dyn_issue = v4_ty_dyn_object_safety_issue(ty_id, type_text)
            if dyn_issue != "" {
                v4_ty_add_error_diag(ty_id, context_span, "dyn doctrine is not object safe", dyn_issue)
            }
        }
        v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, doctrine_type, "dyn doctrine of " + context, context_span)
        give back
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot actual_count = v4_ty_generic_arg_count(type_text)
        pilot expected_count = v4_ty_expected_generic_arg_count(ty_id, base_name)
        if expected_count >= 0 and expected_count != actual_count {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + base_name + " expects " + word_from_int(expected_count) + " generic arguments in " + context + " but received " + word_from_int(actual_count), "")
        }

        pilot arg_id = 0
        repeat until arg_id >= actual_count {
            pilot arg_text = v4_ty_generic_arg(type_text, arg_id)
            if v4_ty_generic_slot_accepts_lifetime(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) == false {
                    v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context + " must be a lifetime like 'a", "")
                }
            } else if v4_ty_generic_slot_accepts_type(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) {
                    v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + arg_text + " cannot be used as a value type in generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context, "")
                } else {
                    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, arg_text, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context, context_span)
                }
            } else {
                if v4_ty_is_lifetime_name(arg_text) == false {
                    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, arg_text, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context, context_span)
                }
            }
            arg_id += 1
        }
        give back
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_text = v4_ty_tuple_slot_type(type_text, slot_id)
            if v4_ty_is_lifetime_name(slot_text) {
                v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + slot_text + " cannot be used as a value type in tuple slot " + word_from_int(slot_id) + " of " + context, "")
            } else {
                v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, slot_text, "tuple slot " + word_from_int(slot_id) + " of " + context, context_span)
            }
            slot_id += 1
        }
        give back
    }

    if v4_ty_is_fixed_array_type(type_text) {
        pilot element_type = v4_ty_fixed_array_element_type(type_text)
        if v4_ty_is_lifetime_name(element_type) {
            v4_ty_add_error_diag(ty_id, context_span, "Meiya lifetime debt: " + element_type + " cannot be used as a value type in array element of " + context, "")
        } else {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, element_type, "array element of " + context, context_span)
        }
        pilot length_text = v4_ty_fixed_array_length_text(type_text)
        pilot resolved_length = v4_ty_const_integer_text_from_expr(ty_id, length_text)
        if resolved_length == v4_ty_unknown {
            pilot const_ty = v4_ty_const_value_type_for_name(ty_id, v4_ty_strip_const_expr_wrappers(length_text))
            if const_ty != v4_ty_unknown and not v4_ty_is_integer(const_ty) {
                v4_ty_add_error_diag(ty_id, context_span, "array length of " + context + " must use int or uint constant, but " + v4_ty_strip_const_expr_wrappers(length_text) + " has type " + const_ty, "")
            } else {
                v4_ty_add_error_diag(ty_id, context_span, "array length of " + context + " must be compile-time constant", "use a literal length like 4 or a root fixed pilot int/uint constant")
            }
        } else if resolved_length.char_at(0) == "-" {
            v4_ty_add_error_diag(ty_id, context_span, "array length of " + context + " must be non-negative", "got " + resolved_length)
        }
    }
}

task v4_ty_validate_task_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_is_variadic(ty_id, sig_id, param_id) == false {
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_signature_param_type(ty_id, sig_id, param_id), "parameter " + word_from_int(param_id) + " of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_signature_param_type_span(ty_id, sig_id, param_id))
        }
        param_id += 1
    }
    v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_signature_return_type(ty_id, sig_id), "return type of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_signature_return_span(ty_id, sig_id))
}

task v4_ty_validate_variadic_signature_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_task_sig {
        give back
    }
    pilot variadic_param = v4_ty_signature_variadic_param_id(ty_id, sig_id)
    if variadic_param < 0 {
        give back
    }

    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    pilot param_span = v4_ty_signature_param_type_span(ty_id, sig_id, variadic_param)
    pilot sig_name = v4_ty_signature_name(ty_id, sig_id)
    pilot call_abi = v4_ty_signature_call_abi(ty_id, sig_id)
    if sig_name == "" {
        sig_name = "this signature"
    }

    if call_abi == "" {
        v4_ty_add_error_diag(ty_id, param_span, "variadic parameter needs extern task", "use args: ... only as the final parameter of an extern task")
    }
    if variadic_param != param_count - 1 {
        v4_ty_add_error_diag(ty_id, param_span, "variadic parameter must be final", "move args: ... to the end of " + sig_name)
    }
    if call_abi != "" {
        if v4_ty_is_variadic_abi_compatible(call_abi) == false {
            v4_ty_add_error_diag(ty_id, param_span, "variadic extern needs C-compatible ABI", "use extern [C], [cdecl], [system], [sysv64], or [win64] for " + sig_name)
        }
    }
}

task v4_ty_validate_shape_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_shape_field_type(ty_id, sig_id, field_id), "field " + v4_ty_shape_field_name(ty_id, sig_id, field_id) + " of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_shape_field_type_span(ty_id, sig_id, field_id))
        field_id += 1
    }
}

task v4_ty_validate_route_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        pilot field_id = 0
        pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
        repeat until field_id >= field_count {
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id), "field " + v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) + " of " + route_name + "::" + case_name, v4_ty_route_case_field_type_span(ty_id, route_name, case_name, field_id))
            field_id += 1
        }
        case_id += 1
    }
}

task v4_ty_validate_doctrine_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot method_id = 0
    pilot method_count = v4_ty_doctrine_method_count(ty_id, sig_id)
    repeat until method_id >= method_count {
        pilot method_name = v4_ty_doctrine_method_name(ty_id, sig_id, method_id)
        pilot param_id = 0
        pilot param_count = v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id)
        repeat until param_id >= param_count {
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_doctrine_method_param_type(ty_id, sig_id, method_id, param_id), "parameter " + word_from_int(param_id) + " of " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name, v4_ty_doctrine_method_param_type_span(ty_id, sig_id, method_id, param_id))
            param_id += 1
        }
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id), "return type of " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name, v4_ty_doctrine_method_return_span(ty_id, sig_id, method_id))
        method_id += 1
    }
}

task v4_ty_validate_alias_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_alias_target_type_for_sig(ty_id, sig_id), "alias target of " + v4_ty_signature_name(ty_id, sig_id), v4_ty_alias_target_span(ty_id, sig_id))
}

task v4_ty_validate_alias_signature_cycle(ty_id: int, sig_id: int) -> void {
    pilot alias_name = v4_ty_signature_name(ty_id, sig_id)
    pilot alias_target = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    if alias_name == "" or alias_target == "" or alias_target == v4_ty_unknown {
        give back
    }

    pilot cycle_path = v4_ty_alias_cycle_path_in_type(ty_id, alias_target, alias_name)
    if cycle_path != "" {
        v4_ty_add_error_diag(ty_id, v4_ty_alias_target_span(ty_id, sig_id), "Yuuko alias loop: alias " + alias_name + " expands forever via " + v4_ty_alias_cycle_chain_display(cycle_path), "")
    }
}

task v4_ty_validate_alias_cycles(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_alias_sig {
            v4_ty_validate_alias_signature_cycle(ty_id, sig_id)
        }
        sig_id += 1
    }
}

-- alias nominality: aliases are substitutions, not fresh doctrine impl targets.
task v4_ty_validate_alias_nominality(ty_id: int) -> void {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            pilot doctrine_name = v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item)
            if doctrine_name != "" {
                pilot target_type = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
                pilot alias_name = v4_ty_alias_name_from_surface_type(ty_id, target_type)
                if alias_name != "" {
                    pilot alias_lookup_type = v4_ty_alias_lookup_type_from_surface_type(ty_id, target_type)
                    pilot alias_target = v4_ty_alias_target_type(ty_id, alias_lookup_type)
                    pilot target_help = ""
                    if alias_target != "" and alias_target != v4_ty_unknown {
                        target_help = alias_name + " aliases " + alias_target + "; "
                    }
                    v4_ty_add_error_diag(ty_id, v4_ty_impl_target_span_from_hir(ty_id, hir_item), "Yuuko nominality breach: alias " + alias_name + " cannot receive doctrine " + doctrine_name, target_help + "use a one-field shape when " + alias_name + " needs its own doctrine impl")
                }
            }
        }
        hir_item += 1
    }
}

task v4_ty_validate_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    v4_ty_validate_signature_generic_names(ty_id, sig_id)
    v4_ty_validate_variadic_signature_contract(ty_id, sig_id)

    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind == v4_ty_task_sig or sig_kind == v4_ty_extern_sig {
        v4_ty_validate_task_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_shape_sig {
        v4_ty_validate_shape_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_route_sig {
        v4_ty_validate_route_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_doctrine_sig {
        v4_ty_validate_doctrine_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_alias_sig {
        v4_ty_validate_alias_signature_lifetimes(ty_id, sig_id)
    }
}

task v4_ty_validate_lifetime_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_signature_lifetimes(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_ffi_seen_contains(seen_types: word, type_name: word) -> bool {
    give back v4_ty_alias_cycle_seen_contains(seen_types, type_name)
}

task v4_ty_ffi_seen_append(seen_types: word, type_name: word) -> word {
    give back v4_ty_alias_cycle_seen_append(seen_types, type_name)
}

task v4_ty_surface_ffi_safe_repr_route_seen(ty_id: int, surface_type: word, seen_types: word) -> bool {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back false
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back false
    }

    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, surface_type)
    if sig_id < 0 {
        give back false
    }

    if v4_ty_signature_repr_kind(ty_id, sig_id) == "" {
        give back false
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            give back false
        }
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown {
                give back false
            }
        }
        case_id += 1
    }

    give back true
}

task v4_ty_ffi_route_boundary_help(ty_id: int, surface_type: word, context: word, pointer_context: bool) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, surface_type)
    if sig_id < 0 {
        give back ""
    }

    pilot prefix = context + " uses " + surface_type + "; "
    if pointer_context {
        prefix = context + " points at " + surface_type + "; "
    }

    pilot repr_kind = v4_ty_signature_repr_kind(ty_id, sig_id)
    if repr_kind == "" {
        give back prefix + "fieldless routes and variants cross FFI only with @repr(u8), @repr(u16), @repr(u32), @repr(u64), @repr(i8), @repr(i16), @repr(i32), or @repr(i64)."
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            give back prefix + route_name + "::" + case_name + " carries payload fields; payload routes are not FFI-safe even with @repr(...). Wrap them in an explicit @layout(C) tagged shape."
        }
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown {
                give back prefix + route_name + "::" + case_name + " needs a compile-time integer discriminant before the route can cross FFI."
            }
        }
        case_id += 1
    }

    give back prefix + "only fieldless @repr(...) routes and variants may cross FFI directly."
}

task v4_ty_ffi_boundary_help(ty_id: int, surface_type: word, context: word) -> word {
    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        if target_type == "word" {
            give back context + " points at word; raw pointers do not make FREAK strings C-safe. Use *const tiny or an explicit @layout(C) buffer."
        }
        if v4_ty_is_surface_task_function_type(target_type) {
            give back context + " points at " + target_type + "; function pointers crossing FFI must use extern[C]/[system] task(...) -> T."
        }
        if target_type == "int" or target_type == "uint" or target_type == "bool" or target_type == "num" or target_type == "float" or target_type == "float32" {
            give back context + " points at " + target_type + "; spell pointed-to boundary scalars with std::ffi aliases like *const std::ffi::c_int or *mut std::ffi::c_double."
        }
        if target_type == "void" {
            give back context + " may point at void only as *const void, *mut void, or *const std::ffi::c_void."
        }
        pilot route_help = v4_ty_ffi_route_boundary_help(ty_id, target_type, context, true)
        if route_help != "" {
            give back route_help
        }
        give back context + " points at " + target_type + "; raw pointers crossing FFI must target std::ffi aliases, tiny/char buffers, extern callbacks, fixed arrays, or @layout(C) / @layout(transparent) shapes."
    }
    if surface_type == "word" {
        give back context + " uses word; that is a FREAK string fat pointer, not a C char*. Use *const tiny or an explicit @layout(C) buffer."
    }
    if v4_ty_is_surface_task_function_type(surface_type) {
        give back context + " uses " + surface_type + "; FFI callbacks must be spelled as extern[C]/[system] task(...) -> T with FFI-safe parameter and return types."
    }
    if surface_type == "int" or surface_type == "uint" or surface_type == "bool" or surface_type == "num" or surface_type == "float" or surface_type == "float32" {
        give back context + " uses " + surface_type + "; spell boundary scalars with std::ffi aliases like c_int, c_uint, c_float, c_double, or c_bool."
    }
    if surface_type == "void" or surface_type == "c_void" or surface_type == "std::ffi::c_void" {
        give back context + " may use void only as an extern return or behind a raw pointer."
    }
    pilot route_help = v4_ty_ffi_route_boundary_help(ty_id, surface_type, context, false)
    if route_help != "" {
        give back route_help
    }
    give back context + " must use std::ffi aliases, raw pointers, fixed arrays, fieldless @repr(...) variants, or @layout(C) / @layout(transparent) shapes; got " + surface_type
}

task v4_ty_surface_ffi_safe_pointer_target_seen(ty_id: int, surface_type: word, seen_types: word) -> bool {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back false
    }

    if v4_ty_is_surface_ffi_alias_type(surface_type) {
        give back true
    }

    if surface_type == v4_ty_void or surface_type == v4_ty_tiny or surface_type == v4_ty_char {
        give back true
    }

    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        give back target_type != "" and target_type != v4_ty_unknown and v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, target_type, seen_types)
    }

    if v4_ty_is_surface_extern_function_pointer_type(surface_type) {
        give back v4_ty_surface_extern_function_pointer_ffi_safe(ty_id, surface_type, seen_types)
    }

    if v4_ty_is_surface_task_function_type(surface_type) {
        give back false
    }

    if v4_ty_is_fixed_array_type(surface_type) {
        give back v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, v4_ty_fixed_array_element_type(surface_type), seen_types)
    }

    if v4_ty_is_tuple_type(surface_type) {
        give back false
    }

    if v4_ty_surface_ffi_safe_repr_route_seen(ty_id, surface_type, seen_types) {
        give back true
    }

    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, surface_type)
    if shape_sig >= 0 {
        if v4_ty_signature_layout_kind(ty_id, shape_sig) == "" {
            give back false
        }
        pilot shape_name = v4_ty_signature_name(ty_id, shape_sig)
        if v4_ty_ffi_seen_contains(seen_types, shape_name) {
            give back true
        }
        pilot next_seen = v4_ty_ffi_seen_append(seen_types, shape_name)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            if v4_ty_surface_ffi_safe_type_seen(ty_id, v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id), false, next_seen) == false {
                give back false
            }
            field_id += 1
        }
        give back true
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back false
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, surface_type)
    if alias_target != "" and alias_target != v4_ty_unknown {
        give back v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, alias_target, v4_ty_ffi_seen_append(seen_types, surface_type))
    }

    give back false
}

task v4_ty_surface_ffi_safe_type_seen(ty_id: int, surface_type: word, allow_bare_void: bool, seen_types: word) -> bool {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back false
    }

    pilot normalized = v4_ty_normalize_ffi_alias_type(surface_type)
    if normalized != "" {
        if normalized == v4_ty_void {
            give back allow_bare_void
        }
        give back true
    }

    if surface_type == v4_ty_void {
        give back allow_bare_void
    }

    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        give back target_type != "" and target_type != v4_ty_unknown and v4_ty_surface_ffi_safe_pointer_target_seen(ty_id, target_type, seen_types)
    }

    if v4_ty_is_surface_extern_function_pointer_type(surface_type) {
        give back v4_ty_surface_extern_function_pointer_ffi_safe(ty_id, surface_type, seen_types)
    }

    if v4_ty_is_surface_task_function_type(surface_type) {
        give back false
    }

    if v4_ty_is_fixed_array_type(surface_type) {
        give back v4_ty_surface_ffi_safe_type_seen(ty_id, v4_ty_fixed_array_element_type(surface_type), false, seen_types)
    }

    if v4_ty_is_tuple_type(surface_type) {
        give back false
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back false
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, surface_type)
    if alias_target != "" and alias_target != v4_ty_unknown {
        give back v4_ty_surface_ffi_safe_type_seen(ty_id, alias_target, allow_bare_void, v4_ty_ffi_seen_append(seen_types, surface_type))
    }

    if v4_ty_surface_ffi_safe_repr_route_seen(ty_id, surface_type, seen_types) {
        give back true
    }

    pilot shape_sig = v4_ty_shape_signature_id_for_name(ty_id, surface_type)
    if shape_sig >= 0 {
        if v4_ty_signature_layout_kind(ty_id, shape_sig) == "" {
            give back false
        }
        pilot shape_name = v4_ty_signature_name(ty_id, shape_sig)
        if v4_ty_ffi_seen_contains(seen_types, shape_name) {
            give back false
        }
        pilot next_seen = v4_ty_ffi_seen_append(seen_types, shape_name)
        pilot field_id = 0
        pilot field_count = v4_ty_shape_field_count(ty_id, shape_sig)
        repeat until field_id >= field_count {
            if v4_ty_surface_ffi_safe_type_seen(ty_id, v4_ty_shape_field_surface_type(ty_id, shape_sig, field_id), false, next_seen) == false {
                give back false
            }
            field_id += 1
        }
        give back true
    }

    give back false
}

task v4_ty_validate_shape_layout_contract(ty_id: int, sig_id: int) -> void {
    pilot layout_text = v4_ty_signature_layout(ty_id, sig_id)
    if layout_text == "" {
        give back
    }

    pilot layout_span = v4_ty_signature_attribute_span_for_name(ty_id, sig_id, "layout")
    pilot layout_kind = v4_ty_signature_layout_kind(ty_id, sig_id)
    if layout_kind == "" {
        v4_ty_add_error_diag(ty_id, layout_span, "unknown layout contract", "use @layout(C), @layout(C, packed=1), or @layout(transparent)")
        give back
    }

    pilot packed_seen = false
    pilot arg_idx = 1
    pilot arg_count = v4_ty_layout_arg_count(layout_text)
    repeat until arg_idx >= arg_count {
        pilot option_text = v4_ty_layout_arg(layout_text, arg_idx)
        pilot option_name = v4_ty_layout_option_name(option_text)
        if option_name == "packed" {
            if packed_seen {
                v4_ty_add_error_diag(ty_id, layout_span, "duplicate layout option", "packed appears more than once on " + v4_ty_signature_name(ty_id, sig_id))
            }
            packed_seen = true
            pilot packed_value = v4_ty_layout_option_value(option_text)
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, packed_value)
            if packed_value == "" or resolved == v4_ty_unknown {
                v4_ty_add_error_diag(ty_id, layout_span, "packed layout must use compile-time integer", "write packed=1 or another positive integer constant")
            } else if resolved == "0" or resolved.starts_with("-") {
                v4_ty_add_error_diag(ty_id, layout_span, "packed layout must be positive", "got " + resolved)
            }
        } else {
            v4_ty_add_error_diag(ty_id, layout_span, "unknown layout option", "only packed=N is supported after @layout(C)")
        }
        arg_idx += 1
    }

    if packed_seen and layout_kind != "C" {
        v4_ty_add_error_diag(ty_id, layout_span, "packed layout needs C", "write @layout(C, packed=1) instead of @layout(" + layout_text + ")")
    }

    if layout_kind == "transparent" {
        pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
        if field_count != 1 {
            v4_ty_add_error_diag(ty_id, layout_span, "transparent layout needs one field", v4_ty_signature_name(ty_id, sig_id) + " exposes " + word_from_int(field_count) + " fields")
        }
    }

    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        pilot field_surface = v4_ty_shape_field_surface_type(ty_id, sig_id, field_id)
        pilot field_name = v4_ty_shape_field_name(ty_id, sig_id, field_id)
        pilot field_context = v4_ty_signature_name(ty_id, sig_id) + "." + field_name
        if v4_ty_validate_callback_surface_contract(ty_id, field_surface, v4_ty_shape_field_type_span(ty_id, sig_id, field_id), field_context, v4_ty_signature_name(ty_id, sig_id)) == false and v4_ty_surface_ffi_safe_type_seen(ty_id, field_surface, false, v4_ty_signature_name(ty_id, sig_id)) == false {
            v4_ty_add_error_diag(ty_id, v4_ty_shape_field_type_span(ty_id, sig_id, field_id), "layout field type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, field_surface, field_context))
        }
        field_id += 1
    }
}

task v4_ty_validate_layout_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_shape_sig {
            v4_ty_validate_shape_layout_contract(ty_id, sig_id)
        }
        sig_id += 1
    }
}

task v4_ty_validate_signature_repr_contract(ty_id: int, sig_id: int) -> void {
    pilot repr_text = v4_ty_signature_repr(ty_id, sig_id)
    if repr_text == "" {
        give back
    }

    pilot repr_span = v4_ty_signature_attribute_span_for_name(ty_id, sig_id, "repr")
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        v4_ty_add_error_diag(ty_id, repr_span, "repr contract needs route", "@repr(...) currently applies only to fieldless routes and variants")
        give back
    }

    pilot repr_kind = v4_ty_signature_repr_kind(ty_id, sig_id)
    if repr_kind == "" {
        v4_ty_add_error_diag(ty_id, repr_span, "unknown repr contract", "use @repr(u8), @repr(u16), @repr(u32), @repr(u64), @repr(i8), @repr(i16), @repr(i32), or @repr(i64)")
        give back
    }

    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            v4_ty_add_error_diag(ty_id, v4_ty_route_case_segment_span(ty_id, sig_id, case_id), "repr variants must be fieldless", route_name + "::" + case_name + " carries payload fields")
        } else {
            pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, sig_id, case_id)
            if explicit_text != "" {
                pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
                if resolved == "" or resolved == v4_ty_unknown {
                    v4_ty_add_error_diag(ty_id, v4_ty_route_case_explicit_discriminant_span_by_sig(ty_id, sig_id, case_id), "repr discriminant must use compile-time integer", route_name + "::" + case_name + " writes " + explicit_text)
                }
            }
        }
        case_id += 1
    }
}

task v4_ty_validate_repr_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_signature_repr_contract(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_validate_extern_spec_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back
    }

    pilot spec_text = v4_ty_extern_spec_text(ty_id, sig_id)
    if spec_text == "" {
        give back
    }

    pilot spec_span = v4_hir_item_span(v4_ty_signature_hir_id(ty_id), v4_ty_signature_hir_item(ty_id, sig_id))
    pilot language_seen = false
    pilot cc_seen = false
    pilot link_seen = false
    pilot item_idx = 0
    pilot item_count = v4_ty_extern_spec_arg_count(spec_text)
    repeat until item_idx >= item_count {
        pilot item = v4_ty_extern_spec_arg(spec_text, item_idx)
        pilot normalized = v4_ty_normalize_call_abi(item)
        pilot option_name = v4_ty_extern_spec_option_name(item)
        if item == "" {
            item_idx += 1
        } else if option_name == "link" {
            if link_seen {
                v4_ty_add_error_diag(ty_id, spec_span, "duplicate extern link option", "link appears more than once on this extern block")
            }
            link_seen = true
            if v4_ty_extern_spec_item_value_is_string(ty_id, sig_id, item_idx) == false {
                v4_ty_add_error_diag(ty_id, spec_span, "extern link needs string literal", "write link=\"m\" or another quoted native library name")
            }
            item_idx += 1
        } else if item.starts_with("if") {
            item_idx += 1
        } else if v4_ty_is_language_abi(normalized) {
            if language_seen {
                v4_ty_add_error_diag(ty_id, spec_span, "duplicate extern language ABI", "C appears more than once in this extern block")
            }
            language_seen = true
            item_idx += 1
        } else if v4_ty_is_calling_convention_abi(normalized) {
            if cc_seen {
                v4_ty_add_error_diag(ty_id, spec_span, "duplicate extern calling convention", "choose one of cdecl, stdcall, fastcall, thiscall, vectorcall, win64, sysv64, or system")
            }
            cc_seen = true
            item_idx += 1
        } else {
            v4_ty_add_error_diag(ty_id, spec_span, "unknown extern ABI option", "unsupported extern option " + item)
            item_idx += 1
        }
    }
}

task v4_ty_validate_extern_member_link_name_contract(ty_id: int, sig_id: int) -> void {
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    pilot extern_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    if member_id < 0 or extern_sig < 0 {
        give back
    }

    pilot seen_link = false
    pilot attr_idx = 0
    pilot attr_count = v4_ty_extern_member_attribute_count(ty_id, extern_sig, member_id)
    repeat until attr_idx >= attr_count {
        if v4_ty_extern_member_attribute_name(ty_id, extern_sig, member_id, attr_idx) == "link_name" {
            pilot attr_span = v4_ty_extern_member_attribute_span(ty_id, extern_sig, member_id, attr_idx)
            if seen_link {
                v4_ty_add_error_diag(ty_id, attr_span, "duplicate link_name attribute", "keep a single @link_name(\"symbol\") on " + v4_ty_signature_name(ty_id, sig_id))
            }
            seen_link = true
            if v4_ty_extern_member_attribute_arg_is_string(ty_id, extern_sig, member_id, attr_idx) == false {
                v4_ty_add_error_diag(ty_id, attr_span, "link_name needs string literal", "write @link_name(\"puts\") or another quoted native symbol")
            }
        }
        attr_idx += 1
    }
}

task v4_ty_validate_extern_member_ffi_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
        give back
    }

    pilot member_name = v4_ty_signature_name(ty_id, sig_id)
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_is_variadic(ty_id, sig_id, param_id) == false {
            pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
            pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
            pilot param_context = member_name + " argument " + word_from_int(param_id + 1)
            if param_name != "" {
                param_context = member_name + "." + param_name
            }
            if v4_ty_validate_callback_surface_contract(ty_id, param_surface, v4_ty_signature_param_type_span(ty_id, sig_id, param_id), param_context, "") == false and v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, "") == false {
                v4_ty_add_error_diag(ty_id, v4_ty_signature_param_type_span(ty_id, sig_id, param_id), "extern parameter type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, param_surface, param_context))
            }
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface != "" and return_surface != v4_ty_unknown {
        if v4_ty_validate_callback_surface_contract(ty_id, return_surface, v4_ty_signature_return_span(ty_id, sig_id), member_name, "") == false and v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, "") == false {
            v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "extern return type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, return_surface, member_name + " return"))
        }
    }
}

task v4_ty_is_known_unwinder_symbol(name: word) -> bool {
    -- C non-local-jump primitives. Calling these from FREAK can transfer
    -- control past FREAK destructors and the panic-boundary contract that
    -- @extern_callback trampolines enforce. The bible (section 16) promises
    -- panics never cross the FFI boundary; longjmp-style unwinds violate
    -- that promise from the foreign side.
    if name == "setjmp" or name == "_setjmp" or name == "sigsetjmp" or name == "__sigsetjmp" {
        give back true
    }
    if name == "longjmp" or name == "_longjmp" or name == "siglongjmp" {
        give back true
    }
    -- Itanium C++ ABI exception primitives.
    if name == "_Unwind_RaiseException" or name == "_Unwind_Resume" or name == "_Unwind_ForcedUnwind" {
        give back true
    }
    if name == "__cxa_throw" or name == "__cxa_rethrow" or name == "__cxa_begin_catch" or name == "__cxa_end_catch" {
        give back true
    }
    -- Windows Structured Exception Handling primitive.
    if name == "RaiseException" {
        give back true
    }
    give back false
}

task v4_ty_unwinder_help(name: word) -> word {
    pilot tail = " can transfer control past FREAK destructors and the @extern_callback panic-boundary contract; wrap it in a C shim that converts the non-local jump into an integer error code, or expose only a result<T, E>-returning safe wrapper."
    give back name + tail
}

task v4_ty_extern_member_has_allow_unwinder(ty_id: int, block_sig: int, member_id: int) -> bool {
    if block_sig < 0 or member_id < 0 {
        give back false
    }
    pilot attr_idx = 0
    pilot attr_count = v4_ty_extern_member_attribute_count(ty_id, block_sig, member_id)
    repeat until attr_idx >= attr_count {
        if v4_ty_extern_member_attribute_name(ty_id, block_sig, member_id, attr_idx) == "allow_unwinder" {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_ty_extern_block_has_allow_unwinder(ty_id: int, block_sig: int) -> bool {
    if block_sig < 0 {
        give back false
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, block_sig)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, hir_item)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, hir_item, attr_idx) == "allow_unwinder" {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_ty_signature_unwinder_effective_name(ty_id: int, sig_id: int) -> word {
    if v4_ty_signature_extern_member_id(ty_id, sig_id) < 0 {
        give back ""
    }
    pilot block_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    pilot member_name = v4_ty_signature_name(ty_id, sig_id)
    pilot link_name = v4_ty_extern_member_link_name(ty_id, block_sig, member_id)
    pilot effective_name = link_name
    if effective_name == "" {
        effective_name = member_name
    }
    give back effective_name
}

task v4_ty_signature_is_warned_unwinder(ty_id: int, sig_id: int) -> bool {
    pilot effective_name = v4_ty_signature_unwinder_effective_name(ty_id, sig_id)
    if effective_name == "" {
        give back false
    }
    if v4_ty_is_known_unwinder_symbol(effective_name) == false {
        give back false
    }
    pilot block_sig = v4_ty_signature_extern_block_sig(ty_id, sig_id)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if v4_ty_extern_member_has_allow_unwinder(ty_id, block_sig, member_id) {
        give back false
    }
    if v4_ty_extern_block_has_allow_unwinder(ty_id, block_sig) {
        give back false
    }
    give back true
}

task v4_ty_validate_extern_member_unwinder_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_is_warned_unwinder(ty_id, sig_id) == false {
        give back
    }
    pilot effective_name = v4_ty_signature_unwinder_effective_name(ty_id, sig_id)
    pilot span = v4_hir_item_span(v4_ty_signature_hir_id(ty_id), v4_ty_signature_hir_item(ty_id, sig_id))
    v4_ty_add_warning_diag(ty_id, span, "extern import unwinds across the FFI boundary", v4_ty_unwinder_help(effective_name))
}

task v4_ty_validate_extern_ffi_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
            v4_ty_validate_extern_spec_contract(ty_id, sig_id)
        }
        v4_ty_validate_extern_member_link_name_contract(ty_id, sig_id)
        v4_ty_validate_extern_member_ffi_contract(ty_id, sig_id)
        v4_ty_validate_extern_member_unwinder_contract(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_validate_extern_callback_export_contract(ty_id: int, sig_id: int) -> void {
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back
    }

    pilot attr_span = v4_ty_signature_attribute_span_for_name(ty_id, sig_id, "extern_callback")
    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind != v4_ty_task_sig {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback applies only to tasks", "remove @extern_callback from " + v4_ty_signature_name(ty_id, sig_id) + " or move it to a task declaration")
        give back
    }

    pilot task_name = v4_ty_signature_name(ty_id, sig_id)
    pilot arg_count = v4_ty_signature_extern_callback_arg_count(ty_id, sig_id)
    if arg_count == 0 {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback needs an ABI", "write @extern_callback(\"C\") or @extern_callback(\"system\") on " + task_name)
        give back
    }
    if arg_count > 1 {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback takes one ABI", task_name + " uses extra arguments; @extern_callback accepts exactly one ABI string like \"C\" or \"system\"")
        give back
    }

    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback needs an ABI", "write @extern_callback(\"C\") or @extern_callback(\"system\") on " + task_name)
        give back
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback ABI is invalid", task_name + " uses @extern_callback(" + v4_ty_signature_extern_callback_abi_raw(ty_id, sig_id) + "); use \"C\", \"system\", or a supported calling convention like \"cdecl\"/\"stdcall\"/\"win64\"/\"sysv64\"")
        give back
    }

    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        v4_ty_add_error_diag(ty_id, attr_span, "@extern_callback tasks cannot be variadic", "remove args: ... from " + task_name + " before exposing it as an FFI callback")
        give back
    }

    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
        if v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, "") == false {
            pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
            pilot param_context = task_name + " argument " + word_from_int(param_id + 1)
            if param_name != "" {
                param_context = task_name + "." + param_name
            }
            v4_ty_add_error_diag(ty_id, v4_ty_signature_param_type_span(ty_id, sig_id, param_id), "@extern_callback parameter type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, param_surface, param_context))
            give back
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface == "" or return_surface == v4_ty_unknown {
        v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "@extern_callback return type is not FFI-safe", task_name + " must return an explicit FFI-safe type")
        give back
    }
    if v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, "") == false {
        v4_ty_add_error_diag(ty_id, v4_ty_signature_return_span(ty_id, sig_id), "@extern_callback return type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, return_surface, task_name + " return"))
        give back
    }
}

task v4_ty_validate_extern_callback_export_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_extern_callback_export_contract(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_type_depth_after_char(depth: int, ch: word) -> int {
    pilot next_depth = depth
    if ch == "(" or ch == "[" or ch == "{" or ch == "<" {
        next_depth += 1
    } else if ch == ")" or ch == "]" or ch == "}" or ch == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_ty_find_top_level_type_char(type_text: word, wanted: word, start_pos: int, end_pos: int) -> int {
    pilot depth = 0
    pilot idx = start_pos
    repeat until idx >= end_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == wanted {
            give back idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_is_generic_instance_type(type_text: word) -> bool {
    if type_text.length() < 4 {
        give back false
    }
    if type_text.char_at(type_text.length() - 1) != ">" {
        give back false
    }
    give back v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1) > 0
}

task v4_ty_generic_base_name(type_text: word) -> word {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, 0, open_pos)
}

task v4_ty_generic_arg_count(type_text: word) -> int {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" {
        give back 0
    }
    if open_pos + 1 >= type_text.length() - 1 {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= type_text.length() - 1 {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_generic_arg(type_text: word, arg_id: int) -> word {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" or arg_id < 0 {
        give back v4_ty_unknown
    }
    if open_pos + 1 >= type_text.length() - 1 {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= type_text.length() - 1 {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == arg_id {
                give back v4_slice(type_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == arg_id and segment_start < type_text.length() - 1 {
        give back v4_slice(type_text, segment_start, type_text.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_generic_env_lookup(env: word, name: word) -> word {
    if env == "" or name == "" {
        give back ""
    }

    pilot segment_start = 0
    repeat until segment_start >= env.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(env, "|", segment_start, env.length())
        if segment_end < 0 {
            segment_end = env.length()
        }
        pilot eq_pos = v4_ty_find_top_level_type_char(env, "=", segment_start, segment_end)
        if eq_pos > segment_start {
            if v4_slice(env, segment_start, eq_pos) == name {
                give back v4_slice(env, eq_pos + 1, segment_end)
            }
        }
        segment_start = segment_end + 1
    }
    give back ""
}

task v4_ty_generic_env_bind(env: word, name: word, actual_ty: word) -> word {
    pilot existing = v4_ty_generic_env_lookup(env, name)
    if existing != "" {
        if existing == actual_ty {
            give back env
        }
        give back v4_ty_generic_env_fail
    }

    if env == "" {
        give back name + "=" + actual_ty
    }
    give back env + "|" + name + "=" + actual_ty
}

task v4_ty_match_signature_type_env(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back env
    }
    if expected_ty == actual_ty {
        give back env
    }
    if v4_ty_signature_declares_lifetime_name(ty_id, sig_id, expected_ty) {
        give back env
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, expected_ty) {
        give back v4_ty_generic_env_bind(env, expected_ty, actual_ty)
    }
    if v4_ty_is_dyn_type(expected_ty) {
        if v4_ty_type_can_coerce_to_dyn_in_signature(ty_id, sig_id, expected_ty, actual_ty) {
            give back env
        }
        give back v4_ty_generic_env_fail
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_raw_pointer_type(expected_ty) and v4_ty_is_raw_pointer_type(actual_ty) {
        if v4_ty_raw_pointer_prefix(expected_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_raw_pointer_target_type(expected_ty), v4_ty_raw_pointer_target_type(actual_ty), env)
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        repeat until arg_idx >= arg_count {
            next_env = v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_generic_arg(expected_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(expected_ty) and v4_ty_is_tuple_type(actual_ty) {
        if v4_ty_tuple_slot_count(expected_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(expected_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_tuple_slot_type(expected_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(expected_ty) and v4_ty_is_fixed_array_type(actual_ty) {
        if v4_ty_fixed_array_length_normalized_text(ty_id, expected_ty) != v4_ty_fixed_array_length_normalized_text(ty_id, actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_fixed_array_element_type(expected_ty), v4_ty_fixed_array_element_type(actual_ty), env)
    }
    if v4_ty_types_compatible(expected_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_types_compatible_in_signature(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    give back v4_ty_match_signature_type_env(ty_id, sig_id, expected_ty, actual_ty, "") != v4_ty_generic_env_fail
}

task v4_ty_apply_generic_env(type_text: word, env: word) -> word {
    if env == "" or env == v4_ty_generic_env_fail or type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }

    pilot mapped = v4_ty_generic_env_lookup(env, type_text)
    if mapped != "" {
        give back mapped
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_dyn_type(v4_ty_apply_generic_env(v4_ty_dyn_doctrine_name(type_text), env))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot out = v4_ty_generic_base_name(type_text) + "<"
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if arg_idx > 0 {
                out = out + ","
            }
            out = out + v4_ty_apply_generic_env(v4_ty_generic_arg(type_text, arg_idx), env)
            arg_idx += 1
        }
        out = out + ">"
        give back out
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot out = "("
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if slot_idx > 0 {
                out = out + ","
            }
            out = out + v4_ty_apply_generic_env(v4_ty_tuple_slot_type(type_text, slot_idx), env)
            slot_idx += 1
        }
        out = out + ")"
        give back out
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back "[" + v4_ty_apply_generic_env(v4_ty_fixed_array_element_type(type_text), env) + ";" + v4_ty_strip_const_expr_wrappers(v4_ty_fixed_array_length_text(type_text)) + "]"
    }
    give back type_text
}

task v4_ty_type_mentions_signature_generics(ty_id: int, sig_id: int, type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text) {
        give back true
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_dyn_doctrine_name(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_generic_arg(type_text, arg_idx)) {
                give back true
            }
            arg_idx += 1
        }
        give back false
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_tuple_slot_type(type_text, slot_idx)) {
                give back true
            }
            slot_idx += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_fixed_array_element_type(type_text))
    }
    give back false
}

task v4_ty_signature_generic_env_for_instance(ty_id: int, sig_id: int, instance_ty: word) -> word {
    if not v4_ty_is_generic_instance_type(instance_ty) {
        give back ""
    }
    if v4_ty_signature_generic_count(ty_id, sig_id) != v4_ty_generic_arg_count(instance_ty) {
        give back ""
    }

    pilot env = ""
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            env = v4_ty_generic_env_bind(env, v4_ty_signature_generic_name(ty_id, sig_id, generic_idx), v4_ty_generic_arg(instance_ty, generic_idx))
            if env == v4_ty_generic_env_fail {
                give back ""
            }
        }
        generic_idx += 1
    }
    give back env
}

task v4_ty_signature_generic_env_complete(ty_id: int, sig_id: int, env: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            if v4_ty_generic_env_lookup(env, v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)) == "" {
                give back false
            }
        }
        generic_idx += 1
    }
    give back true
}

task v4_ty_signature_instance_type_for_env(ty_id: int, sig_id: int, env: word) -> word {
    pilot name = v4_ty_signature_name(ty_id, sig_id)
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    if generic_count <= 0 {
        give back name
    }

    pilot out = name + "<"
    pilot generic_idx = 0
    repeat until generic_idx >= generic_count {
        if generic_idx > 0 {
            out = out + ","
        }
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)
        pilot actual_ty = v4_ty_generic_env_lookup(env, generic_name)
        if actual_ty == "" {
            actual_ty = generic_name
        }
        out = out + actual_ty
        generic_idx += 1
    }
    give back out + ">"
}

task v4_ty_apply_signature_generics(ty_id: int, sig_id: int, instance_ty: word, member_ty: word) -> word {
    give back v4_ty_apply_generic_env(member_ty, v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_ty))
}

task v4_ty_signature_return_type_for_env(ty_id: int, sig_id: int, env: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_generic_env(v4_ty_signature_return_type(ty_id, sig_id), env))
}

task v4_ty_list_element_type(container_ty: word) -> word {
    if container_ty.length() >= 6 {
        if container_ty.char_at(0) == "L" and container_ty.char_at(1) == "i" and container_ty.char_at(2) == "s" and container_ty.char_at(3) == "t" and container_ty.char_at(4) == "<" and container_ty.char_at(container_ty.length() - 1) == ">" {
            give back v4_slice(container_ty, 5, container_ty.length() - 1)
        }
    }
    give back v4_ty_unknown
}

task v4_ty_is_maybe_type(container_ty: word) -> bool {
    if container_ty.length() < 8 {
        give back false
    }
    if container_ty.char_at(0) != "m" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "y" or container_ty.char_at(3) != "b" or container_ty.char_at(4) != "e" or container_ty.char_at(5) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back false
    }
    give back true
}

task v4_ty_maybe_value_type(container_ty: word) -> word {
    if v4_ty_is_maybe_type(container_ty) {
        give back v4_slice(container_ty, 6, container_ty.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_is_result_type(container_ty: word) -> bool {
    if container_ty.length() < 11 {
        give back false
    }
    if container_ty.char_at(0) != "r" or container_ty.char_at(1) != "e" or container_ty.char_at(2) != "s" or container_ty.char_at(3) != "u" or container_ty.char_at(4) != "l" or container_ty.char_at(5) != "t" or container_ty.char_at(6) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back false
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    give back comma > 7
}

task v4_ty_result_ok_type(container_ty: word) -> word {
    if not v4_ty_is_result_type(container_ty) {
        give back v4_ty_unknown
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    if comma <= 7 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, 7, comma)
}

task v4_ty_result_err_type(container_ty: word) -> word {
    if not v4_ty_is_result_type(container_ty) {
        give back v4_ty_unknown
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    if comma < 0 or comma + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, comma + 1, container_ty.length() - 1)
}

task v4_ty_maybe_type(inner_ty: word) -> word {
    give back "maybe<" + inner_ty + ">"
}

task v4_ty_result_type(ok_ty: word, err_ty: word) -> word {
    give back "result<" + ok_ty + "," + err_ty + ">"
}

task v4_ty_is_tuple_type(tuple_ty: word) -> bool {
    if tuple_ty.length() < 5 {
        give back false
    }
    if tuple_ty.char_at(0) != "(" or tuple_ty.char_at(tuple_ty.length() - 1) != ")" {
        give back false
    }
    give back v4_ty_find_top_level_type_char(tuple_ty, ",", 1, tuple_ty.length() - 1) > 1
}

task v4_ty_tuple_slot_count(tuple_ty: word) -> int {
    if not v4_ty_is_tuple_type(tuple_ty) {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= tuple_ty.length() - 1 {
        pilot ch = tuple_ty.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_tuple_slot_type(tuple_ty: word, slot_id: int) -> word {
    if not v4_ty_is_tuple_type(tuple_ty) or slot_id < 0 {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= tuple_ty.length() - 1 {
        pilot ch = tuple_ty.char_at(idx)
        if depth == 0 and ch == "," {
            if current == slot_id {
                give back v4_slice(tuple_ty, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == slot_id and segment_start < tuple_ty.length() - 1 {
        give back v4_slice(tuple_ty, segment_start, tuple_ty.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_array_separator(container_ty: word) -> int {
    if container_ty.length() < 4 {
        give back 0 - 1
    }
    if container_ty.char_at(0) != "[" or container_ty.char_at(container_ty.length() - 1) != "]" {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_type_char(container_ty, ";", 1, container_ty.length() - 1)
}

task v4_ty_is_fixed_array_type(container_ty: word) -> bool {
    give back v4_ty_fixed_array_separator(container_ty) > 1
}

task v4_ty_fixed_array_element_type(container_ty: word) -> word {
    pilot separator = v4_ty_fixed_array_separator(container_ty)
    if separator > 1 {
        give back v4_slice(container_ty, 1, separator)
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_array_length_text(container_ty: word) -> word {
    pilot separator = v4_ty_fixed_array_separator(container_ty)
    if separator < 0 or separator + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, separator + 1, container_ty.length() - 1)
}

task v4_ty_fixed_array_length_normalized_text(ty_id: int, container_ty: word) -> word {
    pilot raw = v4_ty_fixed_array_length_text(container_ty)
    if raw == "" or raw == v4_ty_unknown {
        give back v4_ty_unknown
    }
    pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, raw)
    if resolved != v4_ty_unknown {
        give back resolved
    }
    give back v4_ty_strip_const_expr_wrappers(raw)
}

task v4_ty_map_key_type(container_ty: word) -> word {
    if container_ty.length() < 7 {
        give back v4_ty_unknown
    }
    if container_ty.char_at(0) != "M" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "p" or container_ty.char_at(3) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back v4_ty_unknown
    }

    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 4, container_ty.length() - 1)
    if comma <= 4 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, 4, comma)
}

task v4_ty_map_value_type(container_ty: word) -> word {
    if container_ty.length() < 7 {
        give back v4_ty_unknown
    }
    if container_ty.char_at(0) != "M" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "p" or container_ty.char_at(3) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back v4_ty_unknown
    }

    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 4, container_ty.length() - 1)
    if comma < 0 or comma + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, comma + 1, container_ty.length() - 1)
}

task v4_ty_index_element_type(container_ty: word) -> word {
    pilot list_element_ty = v4_ty_list_element_type(container_ty)
    if v4_ty_is_known(list_element_ty) {
        give back list_element_ty
    }

    pilot map_value_ty = v4_ty_map_value_type(container_ty)
    if v4_ty_is_known(map_value_ty) {
        give back map_value_ty
    }

    pilot array_element_ty = v4_ty_fixed_array_element_type(container_ty)
    if v4_ty_is_known(array_element_ty) {
        give back array_element_ty
    }

    give back v4_ty_unknown
}

task v4_ty_add_signature(ty_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> int {
    pilot sig_id = array_len(v4_ty_defs_handle(ty_id))
    array_push(v4_ty_defs_handle(ty_id), def_id)
    array_push(v4_ty_kinds_handle(ty_id), sig_kind)
    array_push(v4_ty_names_handle(ty_id), sig_name)
    array_push(v4_ty_displays_handle(ty_id), sig_display)
    array_push(v4_ty_hir_items_handle(ty_id), word_from_int(hir_item))
    give back sig_id
}

task v4_ty_lower_resolve(file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    pilot ty_id = v4_ty_file_new(file_id, resolve_id)
    v4_ty_copy_resolve_diags(ty_id, resolve_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)

    pilot symbol_idx = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    repeat until symbol_idx >= symbol_count {
        pilot symbol_kind = v4_resolve_symbol_kind(resolve_id, symbol_idx)
        pilot symbol_name = v4_resolve_symbol_name(resolve_id, symbol_idx)
        pilot symbol_def = v4_resolve_symbol_def(resolve_id, symbol_idx)
        pilot hir_item = v4_resolve_symbol_hir_item(resolve_id, symbol_idx)
        if symbol_def == "" or v4_ty_lookup_signature(ty_id, symbol_def) < 0 {
            pilot sig_kind = v4_ty_kind_for_symbol(symbol_kind)
            pilot sig_display = v4_ty_display_for_hir_item(symbol_kind, symbol_name, symbol_def, hir_id, hir_item)
            v4_ty_add_signature(ty_id, symbol_def, sig_kind, symbol_name, sig_display, hir_item)
        }
        symbol_idx += 1
    }

    v4_ty_validate_lifetime_contracts(ty_id)
    v4_ty_validate_repr_contracts(ty_id)
    v4_ty_validate_layout_contracts(ty_id)
    v4_ty_validate_extern_ffi_contracts(ty_id)
    v4_ty_validate_extern_callback_export_contracts(ty_id)
    v4_ty_validate_alias_cycles(ty_id)
    v4_ty_validate_alias_nominality(ty_id)
    v4_ty_validate_const_cycles(ty_id)
    v4_ty_validate_const_initializers(ty_id)
    give back ty_id
}

task v4_ty_lookup_signature(ty_id: int, def_id: word) -> int {
    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        if v4_ty_signature_def(ty_id, sig_idx) == def_id {
            give back sig_idx
        }
        sig_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_of(ty_id: int, def_id: word) -> word {
    pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
    if sig_id < 0 {
        give back ""
    }
    give back v4_ty_signature_display(ty_id, sig_id)
}

task v4_ty_summary(ty_id: int) -> word {
    pilot summary = "ty-ok ty=" + word_from_int(ty_id)
    summary = summary + " signatures=" + word_from_int(v4_ty_signature_count(ty_id))
    summary = summary + " diagnostics=" + word_from_int(v4_ty_diag_count(ty_id))
    give back summary
}

task v4_ty_snapshot_escape(value: word) -> word {
    give back v4_resolve_snapshot_escape(value)
}

task v4_ty_snapshot_unescape(value: word) -> word {
    give back v4_resolve_snapshot_unescape(value)
}

task v4_ty_snapshot_line_count(payload: word) -> int {
    give back v4_resolve_snapshot_line_count(payload)
}

task v4_ty_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_resolve_snapshot_line(payload, wanted)
}

task v4_ty_snapshot_field_count(line: word) -> int {
    give back v4_resolve_snapshot_field_count(line)
}

task v4_ty_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_resolve_snapshot_field_raw(line, wanted)
}

task v4_ty_snapshot_field(line: word, wanted: int) -> word {
    give back v4_resolve_snapshot_field(line, wanted)
}

task v4_ty_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_resolve_snapshot_key_value(line, wanted_key)
}

task v4_ty_snapshot_signature_total() -> int {
    v4_ty_init()
    pilot total = 0
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        total += v4_ty_signature_count(ty_id)
        ty_id += 1
    }
    give back total
}

task v4_ty_snapshot_diag_total() -> int {
    v4_ty_init()
    pilot total = 0
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        total += v4_ty_diag_count(ty_id)
        ty_id += 1
    }
    give back total
}

task v4_ty_snapshot_summary() -> word {
    pilot summary = "ty-snapshot"
    summary = summary + " format=" + v4_ty_snapshot_format
    summary = summary + " files=" + word_from_int(v4_ty_file_count())
    summary = summary + " signatures=" + word_from_int(v4_ty_snapshot_signature_total())
    summary = summary + " diagnostics=" + word_from_int(v4_ty_snapshot_diag_total())
    give back summary
}

task v4_ty_snapshot_header() -> word {
    pilot out = "ty-snapshot"
    out = out + "|format=" + v4_ty_snapshot_format
    out = out + "|files=" + word_from_int(v4_ty_file_count())
    out = out + "|signatures=" + word_from_int(v4_ty_snapshot_signature_total())
    out = out + "|diagnostics=" + word_from_int(v4_ty_snapshot_diag_total())
    give back out
}

task v4_ty_snapshot_file_line(ty_id: int) -> word {
    pilot out = "ty"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(v4_ty_file_id(ty_id))
    out = out + "|" + word_from_int(v4_ty_resolve_id(ty_id))
    out = out + "|" + word_from_int(v4_ty_signature_count(ty_id))
    out = out + "|" + word_from_int(v4_ty_diag_count(ty_id))
    give back out
}

task v4_ty_snapshot_signature_line(ty_id: int, sig_id: int) -> word {
    pilot out = "signature"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(sig_id)
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_def(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_kind(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_name(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_display(ty_id, sig_id))
    out = out + "|" + word_from_int(v4_ty_signature_hir_item(ty_id, sig_id))
    give back out
}

task v4_ty_snapshot_diag_line(ty_id: int, diag_id: int) -> word {
    pilot out = "ty-diag"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_diag(ty_id, diag_id))
    give back out
}

task v4_ty_snapshot() -> word {
    v4_ty_init()
    pilot out = v4_ty_snapshot_header()
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        out = out + "\n" + v4_ty_snapshot_file_line(ty_id)

        pilot sig_id = 0
        pilot sig_count = v4_ty_signature_count(ty_id)
        repeat until sig_id >= sig_count {
            out = out + "\n" + v4_ty_snapshot_signature_line(ty_id, sig_id)
            sig_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_ty_diag_count(ty_id)
        repeat until diag_id >= diag_count {
            out = out + "\n" + v4_ty_snapshot_diag_line(ty_id, diag_id)
            diag_id += 1
        }
        ty_id += 1
    }
    out = out + "\nend|" + v4_ty_snapshot_format
    give back out
}

task v4_ty_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "ty-snapshot" {
        give back 5
    }
    if kind == "ty" {
        give back 6
    }
    if kind == "signature" {
        give back 8
    }
    if kind == "ty-diag" {
        give back 4
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_ty_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_ty_snapshot_field_raw(line, 0)
    pilot expected = v4_ty_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_ty_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_ty_snapshot_validate(payload: word) -> word {
    pilot lines = v4_ty_snapshot_line_count(payload)
    pilot files = 0
    pilot signatures = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_ty_snapshot_field_raw(line, 0)
            if v4_ty_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "ty-snapshot" {
                saw_header += 1
                format = v4_ty_snapshot_key_value(line, "format")
                if format != v4_ty_snapshot_format {
                    malformed += 1
                }
            } else if kind == "ty" {
                files += 1
            } else if kind == "signature" {
                signatures += 1
            } else if kind == "ty-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_ty_snapshot_field(line, 1) != v4_ty_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }

    pilot out = "ty-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " signatures=" + word_from_int(signatures)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_ty_restore_file_slot(ty_id: int, file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    repeat until array_len(v4_ty_files) > ty_id {
        array_push(v4_ty_files, "0")
        array_push(v4_ty_resolves, "0")
        array_push(v4_ty_defs, word_from_int(array_new()))
        array_push(v4_ty_kinds, word_from_int(array_new()))
        array_push(v4_ty_names, word_from_int(array_new()))
        array_push(v4_ty_displays, word_from_int(array_new()))
        array_push(v4_ty_hir_items, word_from_int(array_new()))
        array_push(v4_ty_diags, word_from_int(array_new()))
    }

    array_set(v4_ty_files, ty_id, word_from_int(file_id))
    array_set(v4_ty_resolves, ty_id, word_from_int(resolve_id))
    array_set(v4_ty_defs, ty_id, word_from_int(array_new()))
    array_set(v4_ty_kinds, ty_id, word_from_int(array_new()))
    array_set(v4_ty_names, ty_id, word_from_int(array_new()))
    array_set(v4_ty_displays, ty_id, word_from_int(array_new()))
    array_set(v4_ty_hir_items, ty_id, word_from_int(array_new()))
    array_set(v4_ty_diags, ty_id, word_from_int(array_new()))
    give back ty_id
}

task v4_ty_restore_signature_slot(ty_id: int, sig_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    repeat until v4_ty_signature_count(ty_id) > sig_id {
        array_push(v4_ty_defs_handle(ty_id), "")
        array_push(v4_ty_kinds_handle(ty_id), "")
        array_push(v4_ty_names_handle(ty_id), "")
        array_push(v4_ty_displays_handle(ty_id), "")
        array_push(v4_ty_hir_items_handle(ty_id), word_from_int(0 - 1))
    }
    array_set(v4_ty_defs_handle(ty_id), sig_id, def_id)
    array_set(v4_ty_kinds_handle(ty_id), sig_id, sig_kind)
    array_set(v4_ty_names_handle(ty_id), sig_id, sig_name)
    array_set(v4_ty_displays_handle(ty_id), sig_id, sig_display)
    array_set(v4_ty_hir_items_handle(ty_id), sig_id, word_from_int(hir_item))
    give back 1
}

task v4_ty_restore_diag_slot(ty_id: int, diag_id: int, diag: word) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    repeat until array_len(v4_ty_diags_handle(ty_id)) > diag_id {
        array_push(v4_ty_diags_handle(ty_id), "")
    }
    array_set(v4_ty_diags_handle(ty_id), diag_id, diag)
    give back 1
}

task v4_ty_snapshot_restore_file_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "ty" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot resolve_id = word_to_int(v4_ty_snapshot_field_raw(line, 3))
    v4_ty_restore_file_slot(ty_id, file_id, resolve_id)
    give back 1
}

task v4_ty_snapshot_restore_signature_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "signature" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot sig_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot def_id = v4_ty_snapshot_field(line, 3)
    pilot sig_kind = v4_ty_snapshot_field(line, 4)
    pilot sig_name = v4_ty_snapshot_field(line, 5)
    pilot sig_display = v4_ty_snapshot_field(line, 6)
    pilot hir_item = word_to_int(v4_ty_snapshot_field_raw(line, 7))
    give back v4_ty_restore_signature_slot(ty_id, sig_id, def_id, sig_kind, sig_name, sig_display, hir_item)
}

task v4_ty_snapshot_restore_diag_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "ty-diag" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot diag = v4_ty_snapshot_field(line, 3)
    give back v4_ty_restore_diag_slot(ty_id, diag_id, diag)
}

task v4_ty_snapshot_restore(payload: word) -> word {
    pilot validation = v4_ty_snapshot_validate(payload)
    if validation.starts_with("ty-snapshot-import ok=1") == false {
        give back "ty-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_files = 0
    pilot restored_signatures = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_ty_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_ty_snapshot_field_raw(line, 0)
            if kind == "ty" {
                restored_files += v4_ty_snapshot_restore_file_line(line)
            } else if kind == "signature" {
                restored_signatures += v4_ty_snapshot_restore_signature_line(line)
            } else if kind == "ty-diag" {
                restored_diagnostics += v4_ty_snapshot_restore_diag_line(line)
            } else if kind != "ty-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "ty-snapshot-restore ok=1"
    out = out + " files=" + word_from_int(restored_files)
    out = out + " signatures=" + word_from_int(restored_signatures)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-files=" + word_from_int(v4_ty_file_count())
    give back out
}
