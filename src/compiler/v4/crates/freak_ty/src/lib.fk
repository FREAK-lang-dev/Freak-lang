-- ===================================================================
-- freak_ty - V4 type signature and primitive type helpers
-- ===================================================================
-- Depends on freak_span, freak_diag, freak_lex, freak_parse,
-- freak_hir, and freak_resolve.
-- This first type layer builds item-level signatures and owns the
-- primitive type vocabulary. MIR uses these helpers while lowering
-- rvalues so the pipeline can start carrying concrete type facts
-- without introducing a cyclic dependency.

pilot v4_ty_unknown = "unknown"
pilot v4_ty_int = "int"
pilot v4_ty_uint = "uint"
pilot v4_ty_tiny = "tiny"
pilot v4_ty_num = "num"
pilot v4_ty_float = "float"
pilot v4_ty_float32 = "float32"
pilot v4_ty_big = "big"
pilot v4_ty_word = "word"
pilot v4_ty_bool = "bool"
pilot v4_ty_char = "char"
pilot v4_ty_void = "void"
pilot v4_ty_never = "never"

pilot v4_ty_task_sig = "task-signature"
pilot v4_ty_const_sig = "const-signature"
pilot v4_ty_shape_sig = "shape-signature"
pilot v4_ty_route_sig = "route-signature"
pilot v4_ty_alias_sig = "alias-signature"
pilot v4_ty_doctrine_sig = "doctrine-signature"
pilot v4_ty_extern_sig = "extern-signature"
pilot v4_ty_import_sig = "import-signature"
pilot v4_ty_attribute_sig = "attribute-signature"
pilot v4_ty_error_sig = "error-signature"
pilot v4_ty_snapshot_format = "freak-ty-snapshot-v1"
pilot v4_ty_generic_env_fail = "#fail"
pilot v4_ty_generic_kind_type = "type"
pilot v4_ty_generic_kind_lifetime = "lifetime"
pilot v4_ty_param_mode_value = "value"
pilot v4_ty_param_mode_lend = "lend"
pilot v4_ty_param_mode_lend_mut = "lend mut"

pilot v4_ty_files = 0
pilot v4_ty_resolves = 0
pilot v4_ty_defs = 0
pilot v4_ty_kinds = 0
pilot v4_ty_names = 0
pilot v4_ty_displays = 0
pilot v4_ty_hir_items = 0
pilot v4_ty_diags = 0
pilot v4_ty_ready = 0

task v4_ty_init() -> void {
    if v4_ty_ready == 0 {
        v4_ty_files = array_new()
        v4_ty_resolves = array_new()
        v4_ty_defs = array_new()
        v4_ty_kinds = array_new()
        v4_ty_names = array_new()
        v4_ty_displays = array_new()
        v4_ty_hir_items = array_new()
        v4_ty_diags = array_new()
        v4_ty_ready = 1
    }
}

task v4_ty_file_new(file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    pilot ty_id = array_len(v4_ty_files)
    array_push(v4_ty_files, word_from_int(file_id))
    array_push(v4_ty_resolves, word_from_int(resolve_id))
    array_push(v4_ty_defs, word_from_int(array_new()))
    array_push(v4_ty_kinds, word_from_int(array_new()))
    array_push(v4_ty_names, word_from_int(array_new()))
    array_push(v4_ty_displays, word_from_int(array_new()))
    array_push(v4_ty_hir_items, word_from_int(array_new()))
    array_push(v4_ty_diags, word_from_int(array_new()))
    give back ty_id
}

task v4_ty_defs_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_defs, ty_id))
}

task v4_ty_kinds_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_kinds, ty_id))
}

task v4_ty_names_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_names, ty_id))
}

task v4_ty_displays_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_displays, ty_id))
}

task v4_ty_hir_items_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_hir_items, ty_id))
}

task v4_ty_diags_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_diags, ty_id))
}

task v4_ty_file_id(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_files, ty_id))
}

task v4_ty_resolve_id(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_resolves, ty_id))
}

task v4_ty_file_count() -> int {
    v4_ty_init()
    give back array_len(v4_ty_files)
}

task v4_ty_file_exists(ty_id: int) -> bool {
    v4_ty_init()
    if ty_id < 0 {
        give back false
    }
    if ty_id >= array_len(v4_ty_files) {
        give back false
    }
    give back true
}

task v4_ty_signature_count(ty_id: int) -> int {
    give back array_len(v4_ty_defs_handle(ty_id))
}

task v4_ty_diag_count(ty_id: int) -> int {
    give back array_len(v4_ty_diags_handle(ty_id))
}

task v4_ty_signature_def(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_defs_handle(ty_id), sig_id)
}

task v4_ty_signature_kind(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_kinds_handle(ty_id), sig_id)
}

task v4_ty_signature_name(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_names_handle(ty_id), sig_id)
}

task v4_ty_signature_display(ty_id: int, sig_id: int) -> word {
    pilot display: word = array_get(v4_ty_displays_handle(ty_id), sig_id)
    pilot sig_kind: word = array_get(v4_ty_kinds_handle(ty_id), sig_id)
    if sig_kind == v4_ty_const_sig {
        if not display.contains(":") {
            pilot inferred_ty: word = v4_ty_const_value_type_for_sig(ty_id, sig_id)
            if inferred_ty != v4_ty_unknown {
                pilot sig_name: word = array_get(v4_ty_names_handle(ty_id), sig_id)
                give back "fixed pilot " + sig_name + ": " + inferred_ty
            }
        }
    }
    give back display
}

task v4_ty_signature_hir_item(ty_id: int, sig_id: int) -> int {
    give back word_to_int(array_get(v4_ty_hir_items_handle(ty_id), sig_id))
}

task v4_ty_diag(ty_id: int, diag_id: int) -> word {
    give back array_get(v4_ty_diags_handle(ty_id), diag_id)
}

task v4_ty_add_diag(ty_id: int, diag: word) -> void {
    array_push(v4_ty_diags_handle(ty_id), diag)
}

task v4_ty_add_error_diag(ty_id: int, span: word, message: word, help: word) -> void {
    pilot diag_span = span
    if diag_span == "" {
        diag_span = V4_NO_SPAN
    }
    v4_ty_add_diag(ty_id, v4_diag_new(v4_diag_error, diag_span, message, help))
}

task v4_ty_add_warning_diag(ty_id: int, span: word, message: word, help: word) -> void {
    pilot diag_span = span
    if diag_span == "" {
        diag_span = V4_NO_SPAN
    }
    v4_ty_add_diag(ty_id, v4_diag_new(v4_diag_warning, diag_span, message, help))
}

task v4_ty_copy_resolve_diags(ty_id: int, resolve_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_resolve_diag_count(resolve_id)
    repeat until diag_idx >= diag_count {
        v4_ty_add_diag(ty_id, v4_resolve_diag(resolve_id, diag_idx))
        diag_idx += 1
    }
}

task v4_ty_alias_signature_id_for_name(ty_id: int, alias_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_alias_sig {
            if v4_ty_signature_name(ty_id, sig_id) == alias_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_alias_target_type_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_alias_sig {
        give back v4_ty_unknown
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back v4_ty_unknown
    }
    pilot target = v4_hir_alias_target(hir_id, hir_item)
    if target == "" {
        give back v4_ty_unknown
    }
    give back target
}

task v4_ty_alias_target_type(ty_id: int, alias_name: word) -> word {
    pilot sig_id = v4_ty_alias_signature_id_for_name(ty_id, alias_name)
    if sig_id >= 0 {
        give back v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    }
    if v4_ty_is_generic_instance_type(alias_name) {
        pilot base_name = v4_ty_generic_base_name(alias_name)
        if base_name != v4_ty_unknown {
            sig_id = v4_ty_alias_signature_id_for_name(ty_id, base_name)
            if sig_id >= 0 {
                if v4_ty_signature_generic_count(ty_id, sig_id) == v4_ty_generic_arg_count(alias_name) {
                    pilot target = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
                    if target != "" and target != v4_ty_unknown {
                        give back v4_ty_apply_signature_generics(ty_id, sig_id, alias_name, target)
                    }
                }
            }
        }
    }
    give back v4_ty_unknown
}

task v4_ty_surface_ffi_alias_name(type_text: word) -> word {
    if type_text.starts_with("std::ffi::") {
        give back v4_slice(type_text, 10, type_text.length())
    }
    give back type_text
}

task v4_ty_normalize_ffi_alias_type(type_text: word) -> word {
    pilot alias_name = v4_ty_surface_ffi_alias_name(type_text)
    if alias_name == "c_int" or alias_name == "c_long" or alias_name == "c_isize" or alias_name == "isize" {
        give back v4_ty_int
    }
    if alias_name == "c_uint" or alias_name == "c_ulong" or alias_name == "c_size" or alias_name == "usize" {
        give back v4_ty_uint
    }
    if alias_name == "c_float" {
        give back v4_ty_float32
    }
    if alias_name == "c_double" {
        give back v4_ty_float
    }
    if alias_name == "c_char" or alias_name == "c_uchar" {
        give back v4_ty_tiny
    }
    if alias_name == "c_bool" {
        give back v4_ty_bool
    }
    if alias_name == "c_void" {
        give back v4_ty_void
    }
    if alias_name == "wchar" {
        give back v4_ty_char
    }
    give back ""
}

task v4_ty_is_surface_ffi_alias_type(type_text: word) -> bool {
    give back v4_ty_normalize_ffi_alias_type(type_text) != ""
}

task v4_ty_raw_pointer_prefix(type_text: word) -> word {
    if type_text.starts_with("*const") and type_text.length() > 6 {
        give back "*const"
    }
    if type_text.starts_with("*mut") and type_text.length() > 4 {
        give back "*mut"
    }
    if type_text.starts_with("*") and type_text.length() > 1 {
        give back "*"
    }
    give back ""
}

task v4_ty_is_raw_pointer_type(type_text: word) -> bool {
    give back v4_ty_raw_pointer_prefix(type_text) != ""
}

task v4_ty_is_mutable_raw_pointer_type(type_text: word) -> bool {
    give back v4_ty_raw_pointer_prefix(type_text) == "*mut"
}

task v4_ty_raw_pointer_target_type(type_text: word) -> word {
    pilot prefix = v4_ty_raw_pointer_prefix(type_text)
    if prefix == "" {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, prefix.length(), type_text.length())
}

task v4_ty_raw_pointer_with_target_type(type_text: word, target_type: word) -> word {
    pilot prefix = v4_ty_raw_pointer_prefix(type_text)
    if prefix == "" or target_type == "" {
        give back v4_ty_unknown
    }
    give back prefix + target_type
}

task v4_ty_function_type_task_pos(type_text: word) -> int {
    if type_text.starts_with("task(") {
        give back 0
    }
    if type_text.starts_with("extern[") == false {
        give back 0 - 1
    }

    pilot abi_end = v4_ty_find_top_level_type_char(type_text, "]", 7, type_text.length())
    if abi_end < 0 or abi_end + 5 >= type_text.length() {
        give back 0 - 1
    }
    if v4_slice(type_text, abi_end + 1, abi_end + 5) != "task" {
        give back 0 - 1
    }
    if type_text.char_at(abi_end + 5) != "(" {
        give back 0 - 1
    }
    give back abi_end + 1
}

task v4_ty_is_surface_task_function_type(type_text: word) -> bool {
    pilot task_pos = v4_ty_function_type_task_pos(type_text)
    if task_pos < 0 {
        give back false
    }
    pilot open_pos = task_pos + 4
    if open_pos >= type_text.length() or type_text.char_at(open_pos) != "(" {
        give back false
    }
    pilot close_pos = v4_ty_find_top_level_type_char(type_text, ")", open_pos + 1, type_text.length())
    if close_pos < 0 or close_pos + 2 >= type_text.length() {
        give back false
    }
    give back type_text.char_at(close_pos + 1) == "-" and type_text.char_at(close_pos + 2) == ">"
}

task v4_ty_is_surface_extern_function_pointer_type(type_text: word) -> bool {
    give back type_text.starts_with("extern[") and v4_ty_is_surface_task_function_type(type_text)
}

task v4_ty_function_type_open_paren(type_text: word) -> int {
    pilot task_pos = v4_ty_function_type_task_pos(type_text)
    if task_pos < 0 {
        give back 0 - 1
    }
    give back task_pos + 4
}

task v4_ty_function_type_close_paren(type_text: word) -> int {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    if open_pos < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_type_char(type_text, ")", open_pos + 1, type_text.length())
}

task v4_ty_function_type_return_text(type_text: word) -> word {
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if close_pos < 0 or close_pos + 2 >= type_text.length() {
        give back v4_ty_unknown
    }
    if type_text.char_at(close_pos + 1) != "-" or type_text.char_at(close_pos + 2) != ">" {
        give back v4_ty_unknown
    }
    if close_pos + 3 >= type_text.length() {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, close_pos + 3, type_text.length())
}

task v4_ty_function_type_abi_specs(type_text: word) -> word {
    if type_text.starts_with("extern[") == false {
        give back ""
    }
    pilot abi_end = v4_ty_find_top_level_type_char(type_text, "]", 7, type_text.length())
    if abi_end < 0 {
        give back ""
    }
    give back v4_slice(type_text, 7, abi_end)
}

task v4_ty_function_type_param_surface(type_text: word, param_id: int) -> word {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if open_pos < 0 or close_pos < 0 or param_id < 0 or open_pos + 1 > close_pos {
        give back v4_ty_unknown
    }
    if open_pos + 1 == close_pos {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= close_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == param_id {
                pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, idx)
                if colon_pos >= 0 {
                    give back v4_slice(type_text, colon_pos + 1, idx)
                }
                give back v4_slice(type_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == param_id and segment_start < close_pos {
        pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, close_pos)
        if colon_pos >= 0 {
            give back v4_slice(type_text, colon_pos + 1, close_pos)
        }
        give back v4_slice(type_text, segment_start, close_pos)
    }
    give back v4_ty_unknown
}

task v4_ty_function_type_param_name(type_text: word, param_id: int) -> word {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if open_pos < 0 or close_pos < 0 or param_id < 0 or open_pos + 1 > close_pos {
        give back ""
    }
    if open_pos + 1 == close_pos {
        give back ""
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= close_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == param_id {
                pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, idx)
                if colon_pos >= 0 {
                    give back v4_slice(type_text, segment_start, colon_pos)
                }
                give back ""
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == param_id and segment_start < close_pos {
        pilot colon_pos = v4_ty_find_top_level_type_char(type_text, ":", segment_start, close_pos)
        if colon_pos >= 0 {
            give back v4_slice(type_text, segment_start, colon_pos)
        }
    }
    give back ""
}

task v4_ty_function_type_param_count(type_text: word) -> int {
    pilot open_pos = v4_ty_function_type_open_paren(type_text)
    pilot close_pos = v4_ty_function_type_close_paren(type_text)
    if open_pos < 0 or close_pos < 0 or open_pos + 1 > close_pos {
        give back 0
    }
    if open_pos + 1 == close_pos {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= close_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_function_type_fixed_param_count(type_text: word) -> int {
    pilot param_count = v4_ty_function_type_param_count(type_text)
    pilot variadic_param = v4_ty_function_type_variadic_param_id(type_text)
    if variadic_param >= 0 {
        give back variadic_param
    }
    give back param_count
}

task v4_ty_function_type_variadic_param_id(type_text: word) -> int {
    pilot param_id = 0
    pilot param_count = v4_ty_function_type_param_count(type_text)
    repeat until param_id >= param_count {
        if v4_ty_function_type_param_surface(type_text, param_id) == "..." {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_ty_function_type_call_abi(type_text: word) -> word {
    pilot abi_specs = v4_ty_function_type_abi_specs(type_text)
    if abi_specs == "" {
        give back ""
    }

    pilot item_start = 0
    repeat until item_start >= abi_specs.length() {
        pilot item_end = v4_ty_find_top_level_type_char(abi_specs, ",", item_start, abi_specs.length())
        if item_end < 0 {
            item_end = abi_specs.length()
        }
        pilot item = v4_slice(abi_specs, item_start, item_end)
        if item != "" {
            give back v4_ty_normalize_call_abi(item)
        }
        item_start = item_end + 1
    }
    give back ""
}

task v4_ty_function_type_abi_valid(abi_specs: word, allow_variadic: bool) -> bool {
    if abi_specs == "" {
        give back false
    }

    pilot seen_cc = ""
    pilot item_start = 0
    repeat until item_start >= abi_specs.length() {
        pilot item_end = v4_ty_find_top_level_type_char(abi_specs, ",", item_start, abi_specs.length())
        if item_end < 0 {
            item_end = abi_specs.length()
        }
        pilot item = v4_slice(abi_specs, item_start, item_end)
        if item == "" or item.starts_with("link=") or item.starts_with("if") {
            give back false
        }
        pilot abi = v4_ty_normalize_call_abi(item)
        if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
            give back false
        }
        if v4_ty_is_calling_convention_abi(abi) {
            if seen_cc != "" and seen_cc != abi {
                give back false
            }
            seen_cc = abi
        }
        item_start = item_end + 1
    }

    if allow_variadic == false {
        give back true
    }
    if seen_cc == "" {
        give back true
    }
    give back v4_ty_is_variadic_abi_compatible(seen_cc)
}

task v4_ty_surface_extern_function_pointer_ffi_safe(ty_id: int, type_text: word, seen_types: word) -> bool {
    if v4_ty_is_surface_extern_function_pointer_type(type_text) == false {
        give back false
    }

    pilot variadic_param = v4_ty_function_type_variadic_param_id(type_text)
    if v4_ty_function_type_abi_valid(v4_ty_function_type_abi_specs(type_text), variadic_param >= 0) == false {
        give back false
    }

    pilot param_id = 0
    pilot param_count = v4_ty_function_type_param_count(type_text)
    repeat until param_id >= param_count {
        pilot param_surface = v4_ty_function_type_param_surface(type_text, param_id)
        if param_surface == "..." {
            if param_id != param_count - 1 {
                give back false
            }
        } else if v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, seen_types) == false {
            give back false
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_function_type_return_text(type_text)
    if return_surface == "" or return_surface == v4_ty_unknown {
        give back false
    }
    give back v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, seen_types)
}

task v4_ty_validate_callback_surface_contract(ty_id: int, surface_type: word, span: word, context: word, seen_types: word) -> bool {
    if v4_ty_is_surface_extern_function_pointer_type(surface_type) == false {
        if v4_ty_is_surface_task_function_type(surface_type) {
            v4_ty_add_error_diag(ty_id, span, "callback type must use extern ABI", v4_ty_ffi_boundary_help(ty_id, surface_type, context))
            give back true
        }
        give back false
    }

    pilot variadic_param = v4_ty_function_type_variadic_param_id(surface_type)
    pilot abi_specs = v4_ty_function_type_abi_specs(surface_type)
    if v4_ty_function_type_abi_valid(abi_specs, variadic_param >= 0) == false {
        if variadic_param >= 0 {
            v4_ty_add_error_diag(ty_id, span, "callback ABI is invalid", context + " uses " + surface_type + "; variadic callbacks need extern[C], [cdecl], [system], [sysv64], or [win64], and args: ... must be the final parameter.")
        } else {
            v4_ty_add_error_diag(ty_id, span, "callback ABI is invalid", context + " uses " + surface_type + "; use extern[C], extern[system], or one supported calling convention without link=..., if..., or duplicate call-convention entries.")
        }
        give back true
    }

    pilot param_id = 0
    pilot param_count = v4_ty_function_type_param_count(surface_type)
    repeat until param_id >= param_count {
        pilot param_surface = v4_ty_function_type_param_surface(surface_type, param_id)
        if param_surface == "..." {
            if param_id != param_count - 1 {
                v4_ty_add_error_diag(ty_id, span, "callback variadic parameter must be final", "move args: ... to the end of " + context)
                give back true
            }
        } else if v4_ty_surface_ffi_safe_type_seen(ty_id, param_surface, false, seen_types) == false {
            pilot param_name = v4_ty_function_type_param_name(surface_type, param_id)
            pilot param_context = context + " argument " + word_from_int(param_id + 1)
            if param_name != "" {
                param_context = context + "." + param_name
            }
            v4_ty_add_error_diag(ty_id, span, "callback parameter type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, param_surface, param_context))
            give back true
        }
        param_id += 1
    }

    pilot return_surface = v4_ty_function_type_return_text(surface_type)
    if return_surface == "" or return_surface == v4_ty_unknown {
        v4_ty_add_error_diag(ty_id, span, "callback return type is not FFI-safe", context + " must return an explicit FFI-safe type")
        give back true
    }
    if v4_ty_surface_ffi_safe_type_seen(ty_id, return_surface, true, seen_types) == false {
        v4_ty_add_error_diag(ty_id, span, "callback return type is not FFI-safe", v4_ty_ffi_boundary_help(ty_id, return_surface, context + " return"))
        give back true
    }

    give back true
}

task v4_ty_variadic_arg_promoted_type_seen(ty_id: int, surface_type: word, seen_types: word) -> word {
    if surface_type == "" or surface_type == v4_ty_unknown {
        give back v4_ty_unknown
    }

    pilot normalized = v4_ty_normalize_ffi_alias_type(surface_type)
    if normalized != "" {
        surface_type = normalized
    }

    if v4_ty_is_raw_pointer_type(surface_type) {
        pilot target_type = v4_ty_raw_pointer_target_type(surface_type)
        if target_type == "" or target_type == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back surface_type
    }

    if surface_type == v4_ty_bool or surface_type == v4_ty_tiny or surface_type == v4_ty_char {
        give back v4_ty_int
    }
    if surface_type == v4_ty_float32 {
        give back v4_ty_float
    }
    if surface_type == v4_ty_int or surface_type == v4_ty_uint or surface_type == v4_ty_num or surface_type == v4_ty_float {
        give back surface_type
    }

    if v4_ty_ffi_seen_contains(seen_types, surface_type) {
        give back v4_ty_unknown
    }

    pilot alias_target = v4_ty_alias_target_type(ty_id, surface_type)
    if alias_target != "" and alias_target != v4_ty_unknown {
        give back v4_ty_variadic_arg_promoted_type_seen(ty_id, alias_target, v4_ty_ffi_seen_append(seen_types, surface_type))
    }

    give back v4_ty_unknown
}

task v4_ty_variadic_arg_promoted_type(ty_id: int, surface_type: word) -> word {
    give back v4_ty_variadic_arg_promoted_type_seen(ty_id, surface_type, "")
}

task v4_ty_variadic_arg_help(surface_type: word) -> word {
    if surface_type == v4_ty_word {
        give back "extern variadic calls need scalar std::ffi-style values or raw pointers; word should cross the boundary as *const tiny or another explicit buffer."
    }
    if v4_ty_is_tuple_type(surface_type) or v4_ty_is_fixed_array_type(surface_type) {
        give back "extern variadic calls currently accept only scalar std::ffi-style values or raw pointers; pass aggregates through an explicit fixed signature slot instead."
    }
    give back "extern variadic calls currently accept only scalar std::ffi-style values or raw pointers; got " + surface_type
}

task v4_ty_alias_cycle_seen_contains(seen_aliases: word, alias_name: word) -> bool {
    if seen_aliases == "" or alias_name == "" {
        give back false
    }
    give back ("|" + seen_aliases + "|").contains("|" + alias_name + "|")
}

task v4_ty_alias_cycle_seen_append(seen_aliases: word, alias_name: word) -> word {
    if alias_name == "" {
        give back seen_aliases
    }
    if seen_aliases == "" {
        give back alias_name
    }
    give back seen_aliases + "|" + alias_name
}

task v4_ty_alias_cycle_chain_display(chain: word) -> word {
    if chain == "" {
        give back ""
    }

    pilot out = ""
    pilot segment_start = 0
    repeat until segment_start >= chain.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(chain, "|", segment_start, chain.length())
        if segment_end < 0 {
            segment_end = chain.length()
        }
        pilot segment = v4_slice(chain, segment_start, segment_end)
        if segment != "" {
            if out != "" {
                out = out + " -> "
            }
            out = out + segment
        }
        segment_start = segment_end + 1
    }
    give back out
}

task v4_ty_alias_cycle_path_in_type(ty_id: int, type_text: word, seen_aliases: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_surface_ffi_alias_type(type_text) {
        give back ""
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_raw_pointer_target_type(type_text), seen_aliases)
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_dyn_doctrine_name(type_text), seen_aliases)
    }
    if v4_ty_is_primitive_type(type_text) or v4_ty_is_lifetime_name(type_text) {
        give back ""
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_path = v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_aliases)
            if slot_path != "" {
                give back slot_path
            }
            slot_id += 1
        }
        give back ""
    }

    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_fixed_array_element_type(type_text), seen_aliases)
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if base_name != v4_ty_unknown {
            if v4_ty_alias_signature_id_for_name(ty_id, base_name) >= 0 {
                if v4_ty_alias_cycle_seen_contains(seen_aliases, base_name) {
                    give back v4_ty_alias_cycle_seen_append(seen_aliases, base_name)
                }
                pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
                if alias_target != "" and alias_target != v4_ty_unknown {
                    pilot alias_path = v4_ty_alias_cycle_path_in_type(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, base_name))
                    if alias_path != "" {
                        give back alias_path
                    }
                }
            }
        }
        give back ""
    }

    if v4_ty_alias_signature_id_for_name(ty_id, type_text) >= 0 {
        if v4_ty_alias_cycle_seen_contains(seen_aliases, type_text) {
            give back v4_ty_alias_cycle_seen_append(seen_aliases, type_text)
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_alias_cycle_path_in_type(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, type_text))
        }
    }

    give back ""
}

task v4_ty_canonical_type_depth_seen(ty_id: int, type_text: word, seen_aliases: word, depth: int) -> word {
    if depth > 8 {
        give back type_text
    }
    if type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }

    pilot ffi_alias = v4_ty_normalize_ffi_alias_type(type_text)
    if ffi_alias != "" {
        give back ffi_alias
    }

    if v4_ty_is_lend_type(type_text) {
        pilot lend_target = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_lend_target_type(type_text), seen_aliases, depth + 1)
        if lend_target == "" or lend_target == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back v4_ty_lend_type(lend_target, v4_ty_lend_mode(type_text))
    }

    if v4_ty_is_dyn_type(type_text) {
        pilot dyn_doctrine = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_dyn_doctrine_name(type_text), seen_aliases, depth + 1)
        if dyn_doctrine == "" or dyn_doctrine == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back v4_ty_dyn_type(dyn_doctrine)
    }

    if v4_ty_is_raw_pointer_type(type_text) {
        pilot pointer_prefix = v4_ty_raw_pointer_prefix(type_text)
        pilot pointer_target = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_raw_pointer_target_type(type_text), seen_aliases, depth + 1)
        if pointer_target == "" or pointer_target == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back pointer_prefix + pointer_target
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_canonical_type_depth_seen(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_aliases, depth + 1) == v4_ty_unknown {
                give back v4_ty_unknown
            }
            slot_id += 1
        }
        give back type_text
    }

    if v4_ty_is_fixed_array_type(type_text) {
        pilot element_ty = v4_ty_canonical_type_depth_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_aliases, depth + 1)
        if element_ty == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back "[" + element_ty + ";" + v4_ty_fixed_array_length_normalized_text(ty_id, type_text) + "]"
    }

    pilot alias_name = ""
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if base_name != v4_ty_unknown and v4_ty_alias_signature_id_for_name(ty_id, base_name) >= 0 {
            alias_name = base_name
        }
    } else if v4_ty_alias_signature_id_for_name(ty_id, type_text) >= 0 {
        alias_name = type_text
    }

    if alias_name != "" {
        if v4_ty_alias_cycle_seen_contains(seen_aliases, alias_name) {
            give back v4_ty_unknown
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_canonical_type_depth_seen(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, alias_name), depth + 1)
        }
    }

    give back type_text
}

task v4_ty_canonical_type(ty_id: int, type_text: word) -> word {
    give back v4_ty_canonical_type_depth_seen(ty_id, type_text, "", 0)
}

task v4_ty_is_numeric(ty_name: word) -> bool {
    give back v4_ty_is_integer(ty_name) or v4_ty_is_float(ty_name)
}

task v4_ty_is_integer(ty_name: word) -> bool {
    give back ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_big
}

task v4_ty_is_float(ty_name: word) -> bool {
    give back ty_name == v4_ty_num or ty_name == v4_ty_float or ty_name == v4_ty_float32
}

task v4_ty_is_integer_text_literal(value: word) -> bool {
    give back v4_ty_integer_literal_value_text(value) != v4_ty_unknown
}

task v4_ty_is_copy_type(ty_name: word) -> bool {
    if v4_ty_is_lend_type(ty_name) {
        give back v4_ty_is_lend_mut_type(ty_name) == false
    }
    if ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_num {
        give back true
    }
    if ty_name == v4_ty_float or ty_name == v4_ty_float32 or ty_name == v4_ty_big or ty_name == v4_ty_bool or ty_name == v4_ty_char or ty_name == v4_ty_void {
        give back true
    }
    if v4_ty_is_raw_pointer_type(ty_name) {
        give back true
    }
    give back false
}

task v4_ty_is_primitive_type(ty_name: word) -> bool {
    if ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_num {
        give back true
    }
    if ty_name == v4_ty_float or ty_name == v4_ty_float32 or ty_name == v4_ty_big or ty_name == v4_ty_word {
        give back true
    }
    if ty_name == v4_ty_bool or ty_name == v4_ty_char or ty_name == v4_ty_void or ty_name == v4_ty_never {
        give back true
    }
    give back false
}

task v4_ty_numeric_rank(ty_name: word) -> int {
    if ty_name == v4_ty_tiny {
        give back 1
    }
    if ty_name == v4_ty_int or ty_name == v4_ty_uint {
        give back 2
    }
    if ty_name == v4_ty_big {
        give back 3
    }
    if ty_name == v4_ty_float32 {
        give back 4
    }
    if ty_name == v4_ty_num or ty_name == v4_ty_float {
        give back 5
    }
    give back 0
}

task v4_ty_contextual_numeric_literal_type(default_ty: word, expected_ty: word) -> word {
    if not v4_ty_is_known(expected_ty) {
        give back default_ty
    }
    if default_ty == v4_ty_int {
        if v4_ty_is_numeric(expected_ty) {
            give back expected_ty
        }
    }
    if default_ty == v4_ty_num {
        if v4_ty_is_float(expected_ty) {
            give back expected_ty
        }
    }
    give back default_ty
}

task v4_ty_numeric_literal_suffix(value: word) -> word {
    if value.length() <= 0 {
        give back ""
    }
    pilot suffix = value.char_at(value.length() - 1)
    if suffix == "u" or suffix == "t" or suffix == "b" or suffix == "f" {
        give back suffix
    }
    give back ""
}

task v4_ty_numeric_literal_value(value: word) -> word {
    pilot suffix = v4_ty_numeric_literal_suffix(value)
    if suffix == "" {
        give back value
    }
    give back value.substring(0, value.length() - 1)
}

task v4_ty_int_literal_type(value: word, expected_ty: word) -> word {
    pilot suffix = v4_ty_numeric_literal_suffix(value)
    if suffix == "u" {
        give back v4_ty_uint
    }
    if suffix == "t" {
        give back v4_ty_tiny
    }
    if suffix == "b" {
        give back v4_ty_big
    }
    give back v4_ty_contextual_numeric_literal_type(v4_ty_int, expected_ty)
}

task v4_ty_float_literal_type(value: word, expected_ty: word) -> word {
    if v4_ty_numeric_literal_suffix(value) == "f" {
        give back v4_ty_float
    }
    give back v4_ty_contextual_numeric_literal_type(v4_ty_num, expected_ty)
}

task v4_ty_is_known(ty_name: word) -> bool {
    give back ty_name != "" and ty_name != v4_ty_unknown
}

task v4_ty_lend_type(target_ty: word, mode: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    if mode == v4_ty_param_mode_lend_mut {
        give back "lend mut " + target_ty
    }
    give back "lend " + target_ty
}

task v4_ty_is_lend_mut_type(ty_name: word) -> bool {
    give back ty_name.starts_with("lend mut ") and ty_name.length() > 9
}

task v4_ty_is_lend_type(ty_name: word) -> bool {
    if v4_ty_is_lend_mut_type(ty_name) {
        give back true
    }
    give back ty_name.starts_with("lend ") and ty_name.length() > 5
}

task v4_ty_lend_mode(ty_name: word) -> word {
    if v4_ty_is_lend_mut_type(ty_name) {
        give back v4_ty_param_mode_lend_mut
    }
    if v4_ty_is_lend_type(ty_name) {
        give back v4_ty_param_mode_lend
    }
    give back v4_ty_param_mode_value
}

task v4_ty_lend_target_type(ty_name: word) -> word {
    if v4_ty_is_lend_mut_type(ty_name) {
        give back v4_slice(ty_name, 9, ty_name.length())
    }
    if v4_ty_is_lend_type(ty_name) {
        give back v4_slice(ty_name, 5, ty_name.length())
    }
    give back v4_ty_unknown
}

task v4_ty_dyn_type(doctrine_name: word) -> word {
    if doctrine_name == "" or doctrine_name == v4_ty_unknown {
        give back v4_ty_unknown
    }
    give back "dyn " + doctrine_name
}

task v4_ty_is_dyn_type(type_text: word) -> bool {
    give back type_text.starts_with("dyn ") and type_text.length() > 4
}

task v4_ty_dyn_doctrine_name(type_text: word) -> word {
    if not v4_ty_is_dyn_type(type_text) {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, 4, type_text.length())
}

task v4_ty_dyn_doctrine_lookup_name(type_text: word) -> word {
    pilot doctrine_name = v4_ty_dyn_doctrine_name(type_text)
    if doctrine_name == "" or doctrine_name == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_generic_instance_type(doctrine_name) {
        give back v4_ty_generic_base_name(doctrine_name)
    }
    give back doctrine_name
}

task v4_ty_shared_type(target_ty: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    give back "Shared<" + target_ty + ">"
}

task v4_ty_weak_type(target_ty: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    give back "Weak<" + target_ty + ">"
}

task v4_ty_shared_mut_type(target_ty: word) -> word {
    if not v4_ty_is_known(target_ty) {
        give back v4_ty_unknown
    }
    give back "SharedMut<" + target_ty + ">"
}

task v4_ty_generic_base_is(type_text: word, base_name: word) -> bool {
    if not v4_ty_is_generic_instance_type(type_text) {
        give back false
    }
    if v4_ty_generic_base_name(type_text) != base_name {
        give back false
    }
    give back v4_ty_generic_arg_count(type_text) == 1
}

task v4_ty_is_shared_type(type_text: word) -> bool {
    give back v4_ty_generic_base_is(type_text, "Shared")
}

task v4_ty_is_weak_type(type_text: word) -> bool {
    give back v4_ty_generic_base_is(type_text, "Weak")
}

task v4_ty_is_shared_mut_type(type_text: word) -> bool {
    give back v4_ty_generic_base_is(type_text, "SharedMut")
}

task v4_ty_shared_target_type(type_text: word) -> word {
    if v4_ty_is_shared_type(type_text) or v4_ty_is_weak_type(type_text) or v4_ty_is_shared_mut_type(type_text) {
        give back v4_ty_generic_arg(type_text, 0)
    }
    give back v4_ty_unknown
}

task v4_ty_type_contains_shared_mut(type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_shared_mut_type(type_text) {
        give back true
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_ty_type_contains_shared_mut(v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_ty_type_contains_shared_mut(v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_type_contains_shared_mut(v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back true
            }
            slot_id += 1
        }
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_contains_shared_mut(v4_ty_fixed_array_element_type(type_text))
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_id >= arg_count {
            if v4_ty_type_contains_shared_mut(v4_ty_generic_arg(type_text, arg_id)) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_ty_is_lifetime_name(ty_name: word) -> bool {
    give back ty_name.length() > 1 and ty_name.char_at(0) == "'"
}

task v4_ty_lifetime_name_end(type_text: word, start_pos: int) -> int {
    if start_pos < 0 or start_pos >= type_text.length() {
        give back start_pos
    }
    if type_text.char_at(start_pos) != "'" {
        give back start_pos
    }
    if start_pos + 1 >= type_text.length() {
        give back start_pos
    }
    if v4_lex_is_ident_start(type_text.char_at(start_pos + 1)) == false {
        give back start_pos
    }

    pilot idx = start_pos + 2
    repeat until idx >= type_text.length() or v4_lex_is_ident_continue(type_text.char_at(idx)) == false {
        idx += 1
    }
    give back idx
}

task v4_ty_type_lifetime_count(type_text: word) -> int {
    pilot count = 0
    pilot idx = 0
    repeat until idx >= type_text.length() {
        if type_text.char_at(idx) == "'" {
            pilot lifetime_end = v4_ty_lifetime_name_end(type_text, idx)
            if lifetime_end > idx {
                count += 1
                idx = lifetime_end
            } else {
                idx += 1
            }
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_type_lifetime_name(type_text: word, lifetime_id: int) -> word {
    if lifetime_id < 0 {
        give back ""
    }

    pilot seen = 0
    pilot idx = 0
    repeat until idx >= type_text.length() {
        if type_text.char_at(idx) == "'" {
            pilot lifetime_end = v4_ty_lifetime_name_end(type_text, idx)
            if lifetime_end > idx {
                if seen == lifetime_id {
                    give back v4_slice(type_text, idx, lifetime_end)
                }
                seen += 1
                idx = lifetime_end
            } else {
                idx += 1
            }
        } else {
            idx += 1
        }
    }
    give back ""
}

task v4_ty_type_mentions_lifetime(type_text: word, lifetime_name: word) -> bool {
    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        if v4_ty_type_lifetime_name(type_text, lifetime_id) == lifetime_name {
            give back true
        }
        lifetime_id += 1
    }
    give back false
}

task v4_ty_types_compatible(expected_ty: word, actual_ty: word) -> bool {
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back true
    }
    if actual_ty == v4_ty_never {
        give back true
    }
    if expected_ty == actual_ty {
        give back true
    }
    if v4_ty_is_lifetime_name(expected_ty) and v4_ty_is_lifetime_name(actual_ty) {
        give back true
    }
    if v4_ty_is_lend_type(expected_ty) or v4_ty_is_lend_type(actual_ty) {
        if not v4_ty_is_lend_type(expected_ty) or not v4_ty_is_lend_type(actual_ty) {
            give back false
        }
        if v4_ty_lend_mode(expected_ty) != v4_ty_lend_mode(actual_ty) {
            give back false
        }
        give back v4_ty_types_compatible(v4_ty_lend_target_type(expected_ty), v4_ty_lend_target_type(actual_ty))
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back true
    }
    if v4_ty_is_raw_pointer_type(expected_ty) and v4_ty_is_raw_pointer_type(actual_ty) {
        if v4_ty_raw_pointer_prefix(expected_ty) != v4_ty_raw_pointer_prefix(actual_ty) {
            give back false
        }
        give back v4_ty_types_compatible(v4_ty_raw_pointer_target_type(expected_ty), v4_ty_raw_pointer_target_type(actual_ty))
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back false
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back false
        }
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        repeat until arg_idx >= arg_count {
            if not v4_ty_types_compatible(v4_ty_generic_arg(expected_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx)) {
                give back false
            }
            arg_idx += 1
        }
        give back true
    }
    give back false
}

task v4_ty_is_declared_simple_type_name(ty_id: int, type_name: word) -> bool {
    if type_name == "" or type_name == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_primitive_type(type_name) {
        give back true
    }
    if type_name == "maybe" or type_name == "result" or type_name == "List" or type_name == "Map" or type_name == "Set" or type_name == "Lineup" {
        give back true
    }
    if type_name == "Shared" or type_name == "Weak" or type_name == "SharedMut" or type_name == "BorrowError" {
        give back true
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_name(ty_id, sig_id) == type_name {
            give back true
        }
        sig_id += 1
    }
    give back false
}

task v4_ty_builtin_generic_arg_count(type_name: word) -> int {
    if type_name == "maybe" or type_name == "List" or type_name == "Set" or type_name == "Lineup" {
        give back 1
    }
    if type_name == "Shared" or type_name == "Weak" or type_name == "SharedMut" {
        give back 1
    }
    if type_name == "result" or type_name == "Map" {
        give back 2
    }
    give back 0 - 1
}

task v4_ty_type_signature_id_for_name(ty_id: int, type_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
        if sig_kind == v4_ty_shape_sig or sig_kind == v4_ty_route_sig or sig_kind == v4_ty_alias_sig or sig_kind == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == type_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_expected_generic_arg_count(ty_id: int, type_name: word) -> int {
    pilot builtin_count = v4_ty_builtin_generic_arg_count(type_name)
    if builtin_count >= 0 {
        give back builtin_count
    }

    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id >= 0 {
        give back v4_ty_signature_generic_count(ty_id, sig_id)
    }
    give back 0 - 1
}

task v4_ty_generic_slot_accepts_lifetime(ty_id: int, type_name: word, arg_id: int) -> bool {
    if arg_id < 0 {
        give back false
    }
    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id < 0 {
        give back false
    }
    if arg_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        give back false
    }
    give back v4_ty_signature_generic_is_lifetime(ty_id, sig_id, arg_id)
}

task v4_ty_generic_slot_accepts_type(ty_id: int, type_name: word, arg_id: int) -> bool {
    if arg_id < 0 {
        give back false
    }

    pilot builtin_count = v4_ty_builtin_generic_arg_count(type_name)
    if builtin_count >= 0 {
        give back arg_id < builtin_count
    }

    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id < 0 {
        give back false
    }
    if arg_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        give back false
    }
    give back v4_ty_signature_generic_is_lifetime(ty_id, sig_id, arg_id) == false
}

task v4_ty_numeric_result(left_ty: word, right_ty: word) -> word {
    if left_ty == v4_ty_unknown or right_ty == v4_ty_unknown {
        give back v4_ty_unknown
    }
    if not v4_ty_is_numeric(left_ty) or not v4_ty_is_numeric(right_ty) {
        give back v4_ty_unknown
    }
    if left_ty == right_ty {
        give back left_ty
    }
    if left_ty == v4_ty_num or right_ty == v4_ty_num {
        give back v4_ty_num
    }
    if left_ty == v4_ty_float or right_ty == v4_ty_float {
        give back v4_ty_float
    }
    if left_ty == v4_ty_float32 or right_ty == v4_ty_float32 {
        give back v4_ty_float32
    }
    if left_ty == v4_ty_big or right_ty == v4_ty_big {
        give back v4_ty_big
    }
    if left_ty == v4_ty_int or right_ty == v4_ty_int {
        give back v4_ty_int
    }
    if left_ty == v4_ty_uint or right_ty == v4_ty_uint {
        give back v4_ty_uint
    }
    if left_ty == v4_ty_tiny or right_ty == v4_ty_tiny {
        give back v4_ty_tiny
    }
    give back v4_ty_unknown
}

task v4_ty_unary_valid(op: word, operand_ty: word) -> bool {
    if not v4_ty_is_known(operand_ty) {
        give back true
    }
    if op == "Neg" {
        give back v4_ty_is_numeric(operand_ty)
    }
    if op == "Not" {
        give back operand_ty == v4_ty_bool
    }
    if op == "Deref" {
        give back v4_ty_is_raw_pointer_type(operand_ty)
    }
    give back true
}

task v4_ty_unary_result(op: word, operand_ty: word) -> word {
    if not v4_ty_unary_valid(op, operand_ty) {
        give back v4_ty_unknown
    }
    if op == "Neg" {
        if v4_ty_is_numeric(operand_ty) {
            give back operand_ty
        }
    }
    if op == "Not" {
        if operand_ty == v4_ty_bool {
            give back v4_ty_bool
        }
    }
    if op == "Deref" {
        if v4_ty_is_raw_pointer_type(operand_ty) {
            give back v4_ty_raw_pointer_target_type(operand_ty)
        }
    }
    give back v4_ty_unknown
}

task v4_ty_binary_operator_doctrine(op: word) -> word {
    if op == "Add" { give back "Add" }
    if op == "Sub" { give back "Sub" }
    if op == "Mul" { give back "Mul" }
    if op == "Div" { give back "Div" }
    if op == "Mod" { give back "Rem" }
    if op == "Eq" or op == "Ne" { give back "Eq" }
    give back ""
}

task v4_ty_binary_operator_method(op: word) -> word {
    if op == "Add" { give back "add" }
    if op == "Sub" { give back "sub" }
    if op == "Mul" { give back "mul" }
    if op == "Div" { give back "div" }
    if op == "Mod" { give back "rem" }
    if op == "Eq" or op == "Ne" { give back "equals" }
    give back ""
}

task v4_ty_unary_operator_doctrine(op: word) -> word {
    if op == "Neg" { give back "Neg" }
    give back ""
}

task v4_ty_unary_operator_method(op: word) -> word {
    if op == "Neg" { give back "neg" }
    give back ""
}

task v4_ty_binary_valid(op: word, left_ty: word, right_ty: word) -> bool {
    if not v4_ty_is_known(left_ty) or not v4_ty_is_known(right_ty) {
        give back true
    }
    if op == "Eq" or op == "Ne" {
        give back v4_ty_types_compatible(left_ty, right_ty)
    }
    if op == "And" or op == "Or" {
        give back left_ty == v4_ty_bool and right_ty == v4_ty_bool
    }
    if op == "Gt" or op == "Lt" or op == "Ge" or op == "Le" {
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Add" {
        if left_ty == v4_ty_word and right_ty == v4_ty_word {
            give back true
        }
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Sub" or op == "Mul" or op == "Div" {
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Mod" {
        give back v4_ty_is_integer(left_ty) and v4_ty_is_integer(right_ty)
    }
    give back true
}

task v4_ty_binary_result(op: word, left_ty: word, right_ty: word) -> word {
    if not v4_ty_binary_valid(op, left_ty, right_ty) {
        give back v4_ty_unknown
    }
    if op == "Eq" or op == "Ne" or op == "Gt" or op == "Lt" or op == "Ge" or op == "Le" {
        give back v4_ty_bool
    }
    if op == "And" or op == "Or" {
        give back v4_ty_bool
    }
    if op == "Add" {
        if left_ty == v4_ty_word and right_ty == v4_ty_word {
            give back v4_ty_word
        }
        give back v4_ty_numeric_result(left_ty, right_ty)
    }
    if op == "Sub" or op == "Mul" or op == "Div" or op == "Mod" {
        give back v4_ty_numeric_result(left_ty, right_ty)
    }
    give back v4_ty_unknown
}

task v4_ty_kind_for_symbol(symbol_kind: word) -> word {
    if symbol_kind == v4_hir_task { give back v4_ty_task_sig }
    if symbol_kind == v4_hir_const { give back v4_ty_const_sig }
    if symbol_kind == v4_hir_shape { give back v4_ty_shape_sig }
    if symbol_kind == v4_hir_route { give back v4_ty_route_sig }
    if symbol_kind == v4_hir_alias { give back v4_ty_alias_sig }
    if symbol_kind == v4_hir_doctrine { give back v4_ty_doctrine_sig }
    if symbol_kind == v4_hir_extern { give back v4_ty_extern_sig }
    if symbol_kind == v4_hir_import { give back v4_ty_import_sig }
    if symbol_kind == v4_hir_attribute { give back v4_ty_attribute_sig }
    if symbol_kind == v4_hir_error { give back v4_ty_error_sig }
    give back v4_ty_unknown
}

task v4_ty_display_for_symbol(symbol_kind: word, symbol_name: word) -> word {
    if symbol_kind == v4_hir_task {
        give back "task " + symbol_name + "(...) -> unknown"
    }
    if symbol_kind == v4_hir_const {
        give back "fixed pilot " + symbol_name
    }
    if symbol_kind == v4_hir_shape {
        give back "shape " + symbol_name
    }
    if symbol_kind == v4_hir_route {
        give back "route " + symbol_name
    }
    if symbol_kind == v4_hir_alias {
        give back "alias " + symbol_name
    }
    if symbol_kind == v4_hir_doctrine {
        give back "doctrine " + symbol_name
    }
    if symbol_kind == v4_hir_extern {
        give back "extern " + symbol_name
    }
    if symbol_kind == v4_hir_import {
        give back "use " + symbol_name
    }
    if symbol_kind == v4_hir_attribute {
        give back "@" + symbol_name
    }
    if symbol_kind == v4_hir_error {
        give back "error " + symbol_name
    }
    give back "unknown " + symbol_name
}

task v4_ty_signature_attribute_count(ty_id: int, sig_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    give back v4_hir_item_attribute_count(hir_id, hir_item)
}

task v4_ty_signature_attribute_name(ty_id: int, sig_id: int, attr_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_name(hir_id, hir_item, attr_id)
}

task v4_ty_signature_attribute_arg(ty_id: int, sig_id: int, attr_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_arg(hir_id, hir_item, attr_id)
}

task v4_ty_signature_has_attribute(ty_id: int, sig_id: int, wanted_name: word) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    give back v4_hir_item_has_attribute(hir_id, hir_item, wanted_name)
}

task v4_ty_signature_attribute_arg_for_name(ty_id: int, sig_id: int, wanted_name: word) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_arg_for_name(hir_id, hir_item, wanted_name)
}

task v4_ty_signature_layout(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "layout")
}

task v4_ty_signature_repr(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "repr")
}

task v4_ty_is_space_char(ch: word) -> bool {
    give back ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
}

task v4_ty_trim_spaces(value: word) -> word {
    if value == "" {
        give back ""
    }

    pilot leading = 0
    repeat until leading >= value.length() or v4_ty_is_space_char(value.char_at(leading)) == false {
        leading += 1
    }
    if leading >= value.length() {
        give back ""
    }

    pilot end = value.length()
    repeat until end <= leading or v4_ty_is_space_char(value.char_at(end - 1)) == false {
        end -= 1
    }
    give back v4_slice(value, leading, end)
}

task v4_ty_layout_arg_count(layout_text: word) -> int {
    pilot text = v4_ty_trim_spaces(layout_text)
    if text == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot ch = text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_layout_arg(layout_text: word, arg_id: int) -> word {
    pilot text = v4_ty_trim_spaces(layout_text)
    if text == "" or arg_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 0
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot ch = text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == arg_id {
                give back v4_ty_trim_spaces(v4_slice(text, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == arg_id {
        give back v4_ty_trim_spaces(v4_slice(text, segment_start, text.length()))
    }
    give back ""
}

task v4_ty_layout_option_name(layout_text: word) -> word {
    pilot option_text = v4_ty_trim_spaces(layout_text)
    if option_text == "" {
        give back ""
    }
    pilot eq_pos = v4_ty_find_top_level_type_char(option_text, "=", 0, option_text.length())
    if eq_pos < 0 {
        give back option_text.to_lower()
    }
    give back v4_ty_trim_spaces(v4_slice(option_text, 0, eq_pos)).to_lower()
}

task v4_ty_layout_option_value(layout_text: word) -> word {
    pilot option_text = v4_ty_trim_spaces(layout_text)
    if option_text == "" {
        give back ""
    }
    pilot eq_pos = v4_ty_find_top_level_type_char(option_text, "=", 0, option_text.length())
    if eq_pos < 0 or eq_pos + 1 >= option_text.length() {
        give back ""
    }
    give back v4_ty_trim_spaces(v4_slice(option_text, eq_pos + 1, option_text.length()))
}

task v4_ty_strip_string_quotes(value: word) -> word {
    pilot text = v4_ty_trim_spaces(value)
    if text.length() >= 2 and text.char_at(0) == "\"" and text.char_at(text.length() - 1) == "\"" {
        give back text.substring(1, text.length() - 1)
    }
    give back ""
}

task v4_ty_extern_spec_arg_count(spec_text: word) -> int {
    give back v4_ty_layout_arg_count(spec_text)
}

task v4_ty_extern_spec_arg(spec_text: word, arg_id: int) -> word {
    give back v4_ty_layout_arg(spec_text, arg_id)
}

task v4_ty_extern_spec_option_name(spec_text: word) -> word {
    give back v4_ty_layout_option_name(spec_text)
}

task v4_ty_extern_spec_option_value(spec_text: word) -> word {
    give back v4_ty_layout_option_value(spec_text)
}

task v4_ty_extern_spec_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_abi_open_token(tree_id, parse_node)
}

task v4_ty_extern_spec_close_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_abi_close_token(tree_id, parse_node)
}

task v4_ty_extern_spec_item_start_token(ty_id: int, sig_id: int, item_id: int) -> int {
    if item_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_extern_spec_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_extern_spec_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot depth = 0
    pilot segment_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                if current == item_id {
                    give back segment_start
                }
                current += 1
                segment_start = v4_ty_skip_trivia(stream_id, idx + 1)
            } else {
                depth = v4_ty_type_depth_after_char(depth, val)
            }
        }
        idx += 1
    }
    if current == item_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_extern_spec_item_end_token(ty_id: int, sig_id: int, item_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_spec_item_start_token(ty_id, sig_id, item_id)
    pilot close_token = v4_ty_extern_spec_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_type_depth_after_char(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_extern_spec_item_value_token(ty_id: int, sig_id: int, item_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_spec_item_start_token(ty_id, sig_id, item_id)
    pilot end_token = v4_ty_extern_spec_item_end_token(ty_id, sig_id, item_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "=" {
                give back v4_ty_skip_trivia(stream_id, idx + 1)
            }
            depth = v4_ty_type_depth_after_char(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_extern_spec_item_value_is_string(ty_id: int, sig_id: int, item_id: int) -> bool {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot value_token = v4_ty_extern_spec_item_value_token(ty_id, sig_id, item_id)
    if stream_id < 0 or value_token < 0 {
        give back false
    }
    give back v4_lex_token_type(stream_id, value_token) == v4_tok_string
}

task v4_ty_extern_member_attribute_arg_is_string(ty_id: int, sig_id: int, member_id: int, attr_id: int) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if hir_id < 0 or hir_item < 0 or stream_id < 0 {
        give back false
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot start_token = v4_parse_extern_member_attribute_start_token(tree_id, parse_node, member_id, attr_id)
    pilot end_token = v4_parse_extern_member_attribute_end_token(tree_id, parse_node, member_id, attr_id)
    if start_token < 0 or end_token <= start_token {
        give back false
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    pilot open_token = v4_ty_skip_trivia(stream_id, name_token + 1)
    if open_token >= end_token or v4_lex_token_value(stream_id, open_token) != "(" {
        give back false
    }
    pilot value_token = v4_ty_skip_trivia(stream_id, open_token + 1)
    if value_token >= end_token {
        give back false
    }
    give back v4_lex_token_type(stream_id, value_token) == v4_tok_string
}

task v4_ty_signature_layout_kind(ty_id: int, sig_id: int) -> word {
    pilot layout_text = v4_ty_signature_layout(ty_id, sig_id)
    pilot head = v4_ty_layout_arg(layout_text, 0)
    if head == "" {
        give back ""
    }
    pilot lower = head.to_lower()
    if lower == "c" {
        give back "C"
    }
    if lower == "transparent" {
        give back "transparent"
    }
    give back ""
}

task v4_ty_signature_repr_kind(ty_id: int, sig_id: int) -> word {
    pilot repr_text = v4_ty_trim_spaces(v4_ty_signature_repr(ty_id, sig_id)).to_lower()
    if repr_text == "u8" or repr_text == "u16" or repr_text == "u32" or repr_text == "u64" or repr_text == "i8" or repr_text == "i16" or repr_text == "i32" or repr_text == "i64" {
        give back repr_text
    }
    give back ""
}

task v4_ty_signature_layout_packed(ty_id: int, sig_id: int) -> word {
    pilot layout_text = v4_ty_signature_layout(ty_id, sig_id)
    pilot arg_idx = 1
    pilot arg_count = v4_ty_layout_arg_count(layout_text)
    repeat until arg_idx >= arg_count {
        pilot option_name = v4_ty_layout_option_name(v4_ty_layout_arg(layout_text, arg_idx))
        if option_name == "packed" {
            give back v4_ty_layout_option_value(v4_ty_layout_arg(layout_text, arg_idx))
        }
        arg_idx += 1
    }
    give back ""
}

task v4_ty_signature_attribute_span_for_name(ty_id: int, sig_id: int, wanted_name: word) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back V4_NO_SPAN
    }

    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, hir_item)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, hir_item, attr_idx) == wanted_name {
            pilot attr_item = v4_hir_item_attribute_item(hir_id, hir_item, attr_idx)
            if attr_item >= 0 {
                give back v4_hir_item_span(hir_id, attr_item)
            }
        }
        attr_idx += 1
    }
    give back V4_NO_SPAN
}

task v4_ty_signature_extern_callback_abi_raw(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "extern_callback")
}

task v4_ty_signature_extern_callback_abi(ty_id: int, sig_id: int) -> word {
    pilot raw = v4_ty_signature_extern_callback_abi_raw(ty_id, sig_id)
    if raw == "" {
        give back ""
    }
    pilot first_arg = v4_ty_layout_arg(raw, 0)
    if first_arg == "" {
        give back ""
    }
    pilot unquoted = v4_ty_strip_string_quotes(first_arg)
    if unquoted == "" {
        unquoted = first_arg
    }
    give back v4_ty_normalize_call_abi(unquoted)
}

task v4_ty_signature_extern_callback_arg_count(ty_id: int, sig_id: int) -> int {
    pilot raw = v4_ty_signature_extern_callback_abi_raw(ty_id, sig_id)
    if raw == "" {
        give back 0
    }
    give back v4_ty_layout_arg_count(raw)
}

task v4_ty_signature_has_extern_callback(ty_id: int, sig_id: int) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, hir_item)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, hir_item, attr_idx) == "extern_callback" {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_ty_extern_callback_trampoline_name(task_name: word) -> word {
    give back "__freak_callback_" + task_name
}

task v4_ty_task_callback_value_type(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        give back v4_ty_unknown
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        give back v4_ty_unknown
    }
    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        give back v4_ty_unknown
    }

    pilot out = "extern[" + abi + "]task("
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if param_id > 0 {
            out = out + ","
        }
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_id)
        pilot param_surface = v4_ty_signature_param_surface_type(ty_id, sig_id, param_id)
        if param_name != "" {
            out = out + v4_ty_param_mode_prefix(v4_ty_signature_param_mode(ty_id, sig_id, param_id)) + param_name + ":"
        }
        out = out + param_surface
        param_id += 1
    }
    pilot return_surface = v4_ty_signature_return_surface_type(ty_id, sig_id)
    if return_surface == "" or return_surface == v4_ty_unknown {
        return_surface = v4_ty_void
    }
    out = out + ")->" + return_surface
    give back out
}

task v4_ty_task_callback_value_type_for_name(ty_id: int, task_name: word) -> word {
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, task_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back v4_ty_unknown
    }
    give back v4_ty_task_callback_value_type(ty_id, sig_id)
}

task v4_ty_extern_callback_export_symbol_name(ty_id: int, task_name: word) -> word {
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, task_name)
    if sig_id < 0 {
        give back ""
    }
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back ""
    }
    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        give back ""
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        give back ""
    }
    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        give back ""
    }
    give back v4_ty_extern_callback_trampoline_name(task_name)
}

task v4_ty_normalize_call_abi(abi: word) -> word {
    if abi == "" {
        give back ""
    }
    if abi == "C" or abi == "c" {
        give back "C"
    }
    if abi == "cdecl" or abi == "CDECL" {
        give back "cdecl"
    }
    if abi == "stdcall" or abi == "STDCALL" {
        give back "stdcall"
    }
    if abi == "fastcall" or abi == "FASTCALL" {
        give back "fastcall"
    }
    if abi == "thiscall" or abi == "THISCALL" {
        give back "thiscall"
    }
    if abi == "vectorcall" or abi == "VECTORCALL" {
        give back "vectorcall"
    }
    if abi == "win64" or abi == "WIN64" {
        give back "win64"
    }
    if abi == "sysv64" or abi == "SYSV64" {
        give back "sysv64"
    }
    if abi == "system" or abi == "SYSTEM" {
        give back "system"
    }
    give back abi
}

task v4_ty_is_language_abi(abi: word) -> bool {
    give back abi == "C"
}

task v4_ty_is_calling_convention_abi(abi: word) -> bool {
    if abi == "cdecl" or abi == "stdcall" or abi == "fastcall" { give back true }
    if abi == "thiscall" or abi == "vectorcall" { give back true }
    if abi == "win64" or abi == "sysv64" or abi == "system" { give back true }
    give back false
}

task v4_ty_is_variadic_abi_compatible(abi: word) -> bool {
    if abi == "C" or abi == "cdecl" or abi == "system" { give back true }
    give back abi == "sysv64" or abi == "win64"
}

task v4_ty_extern_spec_text(ty_id: int, sig_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_ty_trim_spaces(v4_hir_extern_abi(hir_id, hir_item))
}

task v4_ty_extern_abi(ty_id: int, sig_id: int) -> word {
    pilot spec_text = v4_ty_extern_spec_text(ty_id, sig_id)
    if spec_text == "" {
        give back ""
    }

    pilot item_idx = 0
    pilot item_count = v4_ty_extern_spec_arg_count(spec_text)
    pilot fallback = ""
    repeat until item_idx >= item_count {
        pilot item = v4_ty_extern_spec_arg(spec_text, item_idx)
        pilot normalized = v4_ty_normalize_call_abi(item)
        if v4_ty_is_calling_convention_abi(normalized) {
            give back normalized
        }
        if v4_ty_is_language_abi(normalized) {
            fallback = normalized
        }
        item_idx += 1
    }
    give back fallback
}

task v4_ty_extern_link_library(ty_id: int, sig_id: int) -> word {
    pilot spec_text = v4_ty_extern_spec_text(ty_id, sig_id)
    if spec_text == "" {
        give back ""
    }

    pilot item_idx = 0
    pilot item_count = v4_ty_extern_spec_arg_count(spec_text)
    repeat until item_idx >= item_count {
        pilot item = v4_ty_extern_spec_arg(spec_text, item_idx)
        if v4_ty_extern_spec_option_name(item) == "link" {
            pilot link_name = v4_ty_strip_string_quotes(v4_ty_extern_spec_option_value(item))
            if link_name != "" {
                give back link_name
            }
            give back v4_ty_extern_spec_option_value(item)
        }
        item_idx += 1
    }
    give back ""
}

task v4_ty_extern_member_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
