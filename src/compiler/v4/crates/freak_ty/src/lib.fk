-- ===================================================================
-- freak_ty - V4 type signature and primitive type helpers
-- ===================================================================
-- Depends on freak_span, freak_diag, freak_lex, freak_parse,
-- freak_hir, and freak_resolve.
-- This first type layer builds item-level signatures and owns the
-- primitive type vocabulary. MIR uses these helpers while lowering
-- rvalues so the pipeline can start carrying concrete type facts
-- without introducing a cyclic dependency.

pilot v4_ty_unknown = "unknown"
pilot v4_ty_int = "int"
pilot v4_ty_uint = "uint"
pilot v4_ty_tiny = "tiny"
pilot v4_ty_num = "num"
pilot v4_ty_float = "float"
pilot v4_ty_float32 = "float32"
pilot v4_ty_big = "big"
pilot v4_ty_word = "word"
pilot v4_ty_bool = "bool"
pilot v4_ty_char = "char"
pilot v4_ty_void = "void"
pilot v4_ty_never = "never"

pilot v4_ty_task_sig = "task-signature"
pilot v4_ty_shape_sig = "shape-signature"
pilot v4_ty_route_sig = "route-signature"
pilot v4_ty_alias_sig = "alias-signature"
pilot v4_ty_doctrine_sig = "doctrine-signature"
pilot v4_ty_extern_sig = "extern-signature"
pilot v4_ty_import_sig = "import-signature"
pilot v4_ty_attribute_sig = "attribute-signature"
pilot v4_ty_error_sig = "error-signature"
pilot v4_ty_snapshot_format = "freak-ty-snapshot-v1"
pilot v4_ty_generic_env_fail = "#fail"
pilot v4_ty_generic_kind_type = "type"
pilot v4_ty_generic_kind_lifetime = "lifetime"

pilot v4_ty_files = 0
pilot v4_ty_resolves = 0
pilot v4_ty_defs = 0
pilot v4_ty_kinds = 0
pilot v4_ty_names = 0
pilot v4_ty_displays = 0
pilot v4_ty_hir_items = 0
pilot v4_ty_diags = 0
pilot v4_ty_ready = 0

task v4_ty_init() -> void {
    if v4_ty_ready == 0 {
        v4_ty_files = array_new()
        v4_ty_resolves = array_new()
        v4_ty_defs = array_new()
        v4_ty_kinds = array_new()
        v4_ty_names = array_new()
        v4_ty_displays = array_new()
        v4_ty_hir_items = array_new()
        v4_ty_diags = array_new()
        v4_ty_ready = 1
    }
}

task v4_ty_file_new(file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    pilot ty_id = array_len(v4_ty_files)
    array_push(v4_ty_files, word_from_int(file_id))
    array_push(v4_ty_resolves, word_from_int(resolve_id))
    array_push(v4_ty_defs, word_from_int(array_new()))
    array_push(v4_ty_kinds, word_from_int(array_new()))
    array_push(v4_ty_names, word_from_int(array_new()))
    array_push(v4_ty_displays, word_from_int(array_new()))
    array_push(v4_ty_hir_items, word_from_int(array_new()))
    array_push(v4_ty_diags, word_from_int(array_new()))
    give back ty_id
}

task v4_ty_defs_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_defs, ty_id))
}

task v4_ty_kinds_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_kinds, ty_id))
}

task v4_ty_names_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_names, ty_id))
}

task v4_ty_displays_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_displays, ty_id))
}

task v4_ty_hir_items_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_hir_items, ty_id))
}

task v4_ty_diags_handle(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_diags, ty_id))
}

task v4_ty_file_id(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_files, ty_id))
}

task v4_ty_resolve_id(ty_id: int) -> int {
    give back word_to_int(array_get(v4_ty_resolves, ty_id))
}

task v4_ty_file_count() -> int {
    v4_ty_init()
    give back array_len(v4_ty_files)
}

task v4_ty_file_exists(ty_id: int) -> bool {
    v4_ty_init()
    if ty_id < 0 {
        give back false
    }
    if ty_id >= array_len(v4_ty_files) {
        give back false
    }
    give back true
}

task v4_ty_signature_count(ty_id: int) -> int {
    give back array_len(v4_ty_defs_handle(ty_id))
}

task v4_ty_diag_count(ty_id: int) -> int {
    give back array_len(v4_ty_diags_handle(ty_id))
}

task v4_ty_signature_def(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_defs_handle(ty_id), sig_id)
}

task v4_ty_signature_kind(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_kinds_handle(ty_id), sig_id)
}

task v4_ty_signature_name(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_names_handle(ty_id), sig_id)
}

task v4_ty_signature_display(ty_id: int, sig_id: int) -> word {
    give back array_get(v4_ty_displays_handle(ty_id), sig_id)
}

task v4_ty_signature_hir_item(ty_id: int, sig_id: int) -> int {
    give back word_to_int(array_get(v4_ty_hir_items_handle(ty_id), sig_id))
}

task v4_ty_diag(ty_id: int, diag_id: int) -> word {
    give back array_get(v4_ty_diags_handle(ty_id), diag_id)
}

task v4_ty_add_diag(ty_id: int, diag: word) -> void {
    array_push(v4_ty_diags_handle(ty_id), diag)
}

task v4_ty_copy_resolve_diags(ty_id: int, resolve_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_resolve_diag_count(resolve_id)
    repeat until diag_idx >= diag_count {
        v4_ty_add_diag(ty_id, v4_resolve_diag(resolve_id, diag_idx))
        diag_idx += 1
    }
}

task v4_ty_alias_signature_id_for_name(ty_id: int, alias_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_alias_sig {
            if v4_ty_signature_name(ty_id, sig_id) == alias_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_alias_target_type_for_sig(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back v4_ty_unknown
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_alias_sig {
        give back v4_ty_unknown
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back v4_ty_unknown
    }
    pilot target = v4_hir_alias_target(hir_id, hir_item)
    if target == "" {
        give back v4_ty_unknown
    }
    give back target
}

task v4_ty_alias_target_type(ty_id: int, alias_name: word) -> word {
    pilot sig_id = v4_ty_alias_signature_id_for_name(ty_id, alias_name)
    if sig_id >= 0 {
        give back v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    }
    if v4_ty_is_generic_instance_type(alias_name) {
        pilot base_name = v4_ty_generic_base_name(alias_name)
        if base_name != v4_ty_unknown {
            sig_id = v4_ty_alias_signature_id_for_name(ty_id, base_name)
            if sig_id >= 0 {
                if v4_ty_signature_generic_count(ty_id, sig_id) == v4_ty_generic_arg_count(alias_name) {
                    pilot target = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
                    if target != "" and target != v4_ty_unknown {
                        give back v4_ty_apply_signature_generics(ty_id, sig_id, alias_name, target)
                    }
                }
            }
        }
    }
    give back v4_ty_unknown
}

task v4_ty_alias_cycle_seen_contains(seen_aliases: word, alias_name: word) -> bool {
    if seen_aliases == "" or alias_name == "" {
        give back false
    }
    give back ("|" + seen_aliases + "|").contains("|" + alias_name + "|")
}

task v4_ty_alias_cycle_seen_append(seen_aliases: word, alias_name: word) -> word {
    if alias_name == "" {
        give back seen_aliases
    }
    if seen_aliases == "" {
        give back alias_name
    }
    give back seen_aliases + "|" + alias_name
}

task v4_ty_alias_cycle_chain_display(chain: word) -> word {
    if chain == "" {
        give back ""
    }

    pilot out = ""
    pilot segment_start = 0
    repeat until segment_start >= chain.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(chain, "|", segment_start, chain.length())
        if segment_end < 0 {
            segment_end = chain.length()
        }
        pilot segment = v4_slice(chain, segment_start, segment_end)
        if segment != "" {
            if out != "" {
                out = out + " -> "
            }
            out = out + segment
        }
        segment_start = segment_end + 1
    }
    give back out
}

task v4_ty_alias_cycle_path_in_type(ty_id: int, type_text: word, seen_aliases: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown {
        give back ""
    }
    if v4_ty_is_primitive_type(type_text) or v4_ty_is_lifetime_name(type_text) {
        give back ""
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_path = v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_aliases)
            if slot_path != "" {
                give back slot_path
            }
            slot_id += 1
        }
        give back ""
    }

    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_alias_cycle_path_in_type(ty_id, v4_ty_fixed_array_element_type(type_text), seen_aliases)
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if base_name != v4_ty_unknown {
            if v4_ty_alias_signature_id_for_name(ty_id, base_name) >= 0 {
                if v4_ty_alias_cycle_seen_contains(seen_aliases, base_name) {
                    give back v4_ty_alias_cycle_seen_append(seen_aliases, base_name)
                }
                pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
                if alias_target != "" and alias_target != v4_ty_unknown {
                    pilot alias_path = v4_ty_alias_cycle_path_in_type(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, base_name))
                    if alias_path != "" {
                        give back alias_path
                    }
                }
            }
        }
        give back ""
    }

    if v4_ty_alias_signature_id_for_name(ty_id, type_text) >= 0 {
        if v4_ty_alias_cycle_seen_contains(seen_aliases, type_text) {
            give back v4_ty_alias_cycle_seen_append(seen_aliases, type_text)
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_alias_cycle_path_in_type(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, type_text))
        }
    }

    give back ""
}

task v4_ty_canonical_type_depth_seen(ty_id: int, type_text: word, seen_aliases: word, depth: int) -> word {
    if depth > 8 {
        give back type_text
    }
    if type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if v4_ty_canonical_type_depth_seen(ty_id, v4_ty_tuple_slot_type(type_text, slot_id), seen_aliases, depth + 1) == v4_ty_unknown {
                give back v4_ty_unknown
            }
            slot_id += 1
        }
        give back type_text
    }

    if v4_ty_is_fixed_array_type(type_text) {
        if v4_ty_canonical_type_depth_seen(ty_id, v4_ty_fixed_array_element_type(type_text), seen_aliases, depth + 1) == v4_ty_unknown {
            give back v4_ty_unknown
        }
        give back type_text
    }

    pilot alias_name = ""
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if base_name != v4_ty_unknown and v4_ty_alias_signature_id_for_name(ty_id, base_name) >= 0 {
            alias_name = base_name
        }
    } else if v4_ty_alias_signature_id_for_name(ty_id, type_text) >= 0 {
        alias_name = type_text
    }

    if alias_name != "" {
        if v4_ty_alias_cycle_seen_contains(seen_aliases, alias_name) {
            give back v4_ty_unknown
        }
        pilot alias_target = v4_ty_alias_target_type(ty_id, type_text)
        if alias_target != "" and alias_target != v4_ty_unknown {
            give back v4_ty_canonical_type_depth_seen(ty_id, alias_target, v4_ty_alias_cycle_seen_append(seen_aliases, alias_name), depth + 1)
        }
    }

    give back type_text
}

task v4_ty_canonical_type(ty_id: int, type_text: word) -> word {
    give back v4_ty_canonical_type_depth_seen(ty_id, type_text, "", 0)
}

task v4_ty_is_numeric(ty_name: word) -> bool {
    give back v4_ty_is_integer(ty_name) or v4_ty_is_float(ty_name)
}

task v4_ty_is_integer(ty_name: word) -> bool {
    give back ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_big
}

task v4_ty_is_float(ty_name: word) -> bool {
    give back ty_name == v4_ty_num or ty_name == v4_ty_float or ty_name == v4_ty_float32
}

task v4_ty_is_copy_type(ty_name: word) -> bool {
    if ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_num {
        give back true
    }
    if ty_name == v4_ty_float or ty_name == v4_ty_float32 or ty_name == v4_ty_big or ty_name == v4_ty_bool or ty_name == v4_ty_char or ty_name == v4_ty_void {
        give back true
    }
    give back false
}

task v4_ty_is_primitive_type(ty_name: word) -> bool {
    if ty_name == v4_ty_int or ty_name == v4_ty_uint or ty_name == v4_ty_tiny or ty_name == v4_ty_num {
        give back true
    }
    if ty_name == v4_ty_float or ty_name == v4_ty_float32 or ty_name == v4_ty_big or ty_name == v4_ty_word {
        give back true
    }
    if ty_name == v4_ty_bool or ty_name == v4_ty_char or ty_name == v4_ty_void or ty_name == v4_ty_never {
        give back true
    }
    give back false
}

task v4_ty_numeric_rank(ty_name: word) -> int {
    if ty_name == v4_ty_tiny {
        give back 1
    }
    if ty_name == v4_ty_int or ty_name == v4_ty_uint {
        give back 2
    }
    if ty_name == v4_ty_big {
        give back 3
    }
    if ty_name == v4_ty_float32 {
        give back 4
    }
    if ty_name == v4_ty_num or ty_name == v4_ty_float {
        give back 5
    }
    give back 0
}

task v4_ty_contextual_numeric_literal_type(default_ty: word, expected_ty: word) -> word {
    if not v4_ty_is_known(expected_ty) {
        give back default_ty
    }
    if default_ty == v4_ty_int {
        if v4_ty_is_numeric(expected_ty) {
            give back expected_ty
        }
    }
    if default_ty == v4_ty_num {
        if v4_ty_is_float(expected_ty) {
            give back expected_ty
        }
    }
    give back default_ty
}

task v4_ty_numeric_literal_suffix(value: word) -> word {
    if value.length() <= 0 {
        give back ""
    }
    pilot suffix = value.char_at(value.length() - 1)
    if suffix == "u" or suffix == "t" or suffix == "b" or suffix == "f" {
        give back suffix
    }
    give back ""
}

task v4_ty_numeric_literal_value(value: word) -> word {
    pilot suffix = v4_ty_numeric_literal_suffix(value)
    if suffix == "" {
        give back value
    }
    give back value.substring(0, value.length() - 1)
}

task v4_ty_int_literal_type(value: word, expected_ty: word) -> word {
    pilot suffix = v4_ty_numeric_literal_suffix(value)
    if suffix == "u" {
        give back v4_ty_uint
    }
    if suffix == "t" {
        give back v4_ty_tiny
    }
    if suffix == "b" {
        give back v4_ty_big
    }
    give back v4_ty_contextual_numeric_literal_type(v4_ty_int, expected_ty)
}

task v4_ty_float_literal_type(value: word, expected_ty: word) -> word {
    if v4_ty_numeric_literal_suffix(value) == "f" {
        give back v4_ty_float
    }
    give back v4_ty_contextual_numeric_literal_type(v4_ty_num, expected_ty)
}

task v4_ty_is_known(ty_name: word) -> bool {
    give back ty_name != "" and ty_name != v4_ty_unknown
}

task v4_ty_is_lifetime_name(ty_name: word) -> bool {
    give back ty_name.length() > 1 and ty_name.char_at(0) == "'"
}

task v4_ty_lifetime_name_end(type_text: word, start_pos: int) -> int {
    if start_pos < 0 or start_pos >= type_text.length() {
        give back start_pos
    }
    if type_text.char_at(start_pos) != "'" {
        give back start_pos
    }
    if start_pos + 1 >= type_text.length() {
        give back start_pos
    }
    if v4_lex_is_ident_start(type_text.char_at(start_pos + 1)) == false {
        give back start_pos
    }

    pilot idx = start_pos + 2
    repeat until idx >= type_text.length() or v4_lex_is_ident_continue(type_text.char_at(idx)) == false {
        idx += 1
    }
    give back idx
}

task v4_ty_type_lifetime_count(type_text: word) -> int {
    pilot count = 0
    pilot idx = 0
    repeat until idx >= type_text.length() {
        if type_text.char_at(idx) == "'" {
            pilot lifetime_end = v4_ty_lifetime_name_end(type_text, idx)
            if lifetime_end > idx {
                count += 1
                idx = lifetime_end
            } else {
                idx += 1
            }
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_type_lifetime_name(type_text: word, lifetime_id: int) -> word {
    if lifetime_id < 0 {
        give back ""
    }

    pilot seen = 0
    pilot idx = 0
    repeat until idx >= type_text.length() {
        if type_text.char_at(idx) == "'" {
            pilot lifetime_end = v4_ty_lifetime_name_end(type_text, idx)
            if lifetime_end > idx {
                if seen == lifetime_id {
                    give back v4_slice(type_text, idx, lifetime_end)
                }
                seen += 1
                idx = lifetime_end
            } else {
                idx += 1
            }
        } else {
            idx += 1
        }
    }
    give back ""
}

task v4_ty_type_mentions_lifetime(type_text: word, lifetime_name: word) -> bool {
    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        if v4_ty_type_lifetime_name(type_text, lifetime_id) == lifetime_name {
            give back true
        }
        lifetime_id += 1
    }
    give back false
}

task v4_ty_types_compatible(expected_ty: word, actual_ty: word) -> bool {
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back true
    }
    if actual_ty == v4_ty_never {
        give back true
    }
    if expected_ty == actual_ty {
        give back true
    }
    if v4_ty_is_lifetime_name(expected_ty) and v4_ty_is_lifetime_name(actual_ty) {
        give back true
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back true
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back false
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back false
        }
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        repeat until arg_idx >= arg_count {
            if not v4_ty_types_compatible(v4_ty_generic_arg(expected_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx)) {
                give back false
            }
            arg_idx += 1
        }
        give back true
    }
    give back false
}

task v4_ty_is_declared_simple_type_name(ty_id: int, type_name: word) -> bool {
    if type_name == "" or type_name == v4_ty_unknown {
        give back false
    }
    if v4_ty_is_primitive_type(type_name) {
        give back true
    }
    if type_name == "maybe" or type_name == "result" or type_name == "List" or type_name == "Map" or type_name == "Set" or type_name == "Lineup" {
        give back true
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_name(ty_id, sig_id) == type_name {
            give back true
        }
        sig_id += 1
    }
    give back false
}

task v4_ty_builtin_generic_arg_count(type_name: word) -> int {
    if type_name == "maybe" or type_name == "List" or type_name == "Set" or type_name == "Lineup" {
        give back 1
    }
    if type_name == "result" or type_name == "Map" {
        give back 2
    }
    give back 0 - 1
}

task v4_ty_type_signature_id_for_name(ty_id: int, type_name: word) -> int {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
        if sig_kind == v4_ty_shape_sig or sig_kind == v4_ty_route_sig or sig_kind == v4_ty_alias_sig or sig_kind == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == type_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_expected_generic_arg_count(ty_id: int, type_name: word) -> int {
    pilot builtin_count = v4_ty_builtin_generic_arg_count(type_name)
    if builtin_count >= 0 {
        give back builtin_count
    }

    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id >= 0 {
        give back v4_ty_signature_generic_count(ty_id, sig_id)
    }
    give back 0 - 1
}

task v4_ty_generic_slot_accepts_lifetime(ty_id: int, type_name: word, arg_id: int) -> bool {
    if arg_id < 0 {
        give back false
    }
    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id < 0 {
        give back false
    }
    if arg_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        give back false
    }
    give back v4_ty_signature_generic_is_lifetime(ty_id, sig_id, arg_id)
}

task v4_ty_generic_slot_accepts_type(ty_id: int, type_name: word, arg_id: int) -> bool {
    if arg_id < 0 {
        give back false
    }

    pilot builtin_count = v4_ty_builtin_generic_arg_count(type_name)
    if builtin_count >= 0 {
        give back arg_id < builtin_count
    }

    pilot sig_id = v4_ty_type_signature_id_for_name(ty_id, type_name)
    if sig_id < 0 {
        give back false
    }
    if arg_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        give back false
    }
    give back v4_ty_signature_generic_is_lifetime(ty_id, sig_id, arg_id) == false
}

task v4_ty_numeric_result(left_ty: word, right_ty: word) -> word {
    if left_ty == v4_ty_unknown or right_ty == v4_ty_unknown {
        give back v4_ty_unknown
    }
    if not v4_ty_is_numeric(left_ty) or not v4_ty_is_numeric(right_ty) {
        give back v4_ty_unknown
    }
    if left_ty == right_ty {
        give back left_ty
    }
    if left_ty == v4_ty_num or right_ty == v4_ty_num {
        give back v4_ty_num
    }
    if left_ty == v4_ty_float or right_ty == v4_ty_float {
        give back v4_ty_float
    }
    if left_ty == v4_ty_float32 or right_ty == v4_ty_float32 {
        give back v4_ty_float32
    }
    if left_ty == v4_ty_big or right_ty == v4_ty_big {
        give back v4_ty_big
    }
    if left_ty == v4_ty_int or right_ty == v4_ty_int {
        give back v4_ty_int
    }
    if left_ty == v4_ty_uint or right_ty == v4_ty_uint {
        give back v4_ty_uint
    }
    if left_ty == v4_ty_tiny or right_ty == v4_ty_tiny {
        give back v4_ty_tiny
    }
    give back v4_ty_unknown
}

task v4_ty_unary_valid(op: word, operand_ty: word) -> bool {
    if not v4_ty_is_known(operand_ty) {
        give back true
    }
    if op == "Neg" {
        give back v4_ty_is_numeric(operand_ty)
    }
    if op == "Not" {
        give back operand_ty == v4_ty_bool
    }
    give back true
}

task v4_ty_unary_result(op: word, operand_ty: word) -> word {
    if not v4_ty_unary_valid(op, operand_ty) {
        give back v4_ty_unknown
    }
    if op == "Neg" {
        if v4_ty_is_numeric(operand_ty) {
            give back operand_ty
        }
    }
    if op == "Not" {
        if operand_ty == v4_ty_bool {
            give back v4_ty_bool
        }
    }
    give back v4_ty_unknown
}

task v4_ty_binary_operator_doctrine(op: word) -> word {
    if op == "Add" { give back "Add" }
    if op == "Sub" { give back "Sub" }
    if op == "Mul" { give back "Mul" }
    if op == "Div" { give back "Div" }
    if op == "Mod" { give back "Rem" }
    if op == "Eq" or op == "Ne" { give back "Eq" }
    give back ""
}

task v4_ty_binary_operator_method(op: word) -> word {
    if op == "Add" { give back "add" }
    if op == "Sub" { give back "sub" }
    if op == "Mul" { give back "mul" }
    if op == "Div" { give back "div" }
    if op == "Mod" { give back "rem" }
    if op == "Eq" or op == "Ne" { give back "equals" }
    give back ""
}

task v4_ty_unary_operator_doctrine(op: word) -> word {
    if op == "Neg" { give back "Neg" }
    give back ""
}

task v4_ty_unary_operator_method(op: word) -> word {
    if op == "Neg" { give back "neg" }
    give back ""
}

task v4_ty_binary_valid(op: word, left_ty: word, right_ty: word) -> bool {
    if not v4_ty_is_known(left_ty) or not v4_ty_is_known(right_ty) {
        give back true
    }
    if op == "Eq" or op == "Ne" {
        give back v4_ty_types_compatible(left_ty, right_ty)
    }
    if op == "And" or op == "Or" {
        give back left_ty == v4_ty_bool and right_ty == v4_ty_bool
    }
    if op == "Gt" or op == "Lt" or op == "Ge" or op == "Le" {
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Add" {
        if left_ty == v4_ty_word and right_ty == v4_ty_word {
            give back true
        }
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Sub" or op == "Mul" or op == "Div" {
        give back v4_ty_is_numeric(left_ty) and v4_ty_is_numeric(right_ty)
    }
    if op == "Mod" {
        give back v4_ty_is_integer(left_ty) and v4_ty_is_integer(right_ty)
    }
    give back true
}

task v4_ty_binary_result(op: word, left_ty: word, right_ty: word) -> word {
    if not v4_ty_binary_valid(op, left_ty, right_ty) {
        give back v4_ty_unknown
    }
    if op == "Eq" or op == "Ne" or op == "Gt" or op == "Lt" or op == "Ge" or op == "Le" {
        give back v4_ty_bool
    }
    if op == "And" or op == "Or" {
        give back v4_ty_bool
    }
    if op == "Add" {
        if left_ty == v4_ty_word and right_ty == v4_ty_word {
            give back v4_ty_word
        }
        give back v4_ty_numeric_result(left_ty, right_ty)
    }
    if op == "Sub" or op == "Mul" or op == "Div" or op == "Mod" {
        give back v4_ty_numeric_result(left_ty, right_ty)
    }
    give back v4_ty_unknown
}

task v4_ty_kind_for_symbol(symbol_kind: word) -> word {
    if symbol_kind == v4_hir_task { give back v4_ty_task_sig }
    if symbol_kind == v4_hir_shape { give back v4_ty_shape_sig }
    if symbol_kind == v4_hir_route { give back v4_ty_route_sig }
    if symbol_kind == v4_hir_alias { give back v4_ty_alias_sig }
    if symbol_kind == v4_hir_doctrine { give back v4_ty_doctrine_sig }
    if symbol_kind == v4_hir_extern { give back v4_ty_extern_sig }
    if symbol_kind == v4_hir_import { give back v4_ty_import_sig }
    if symbol_kind == v4_hir_attribute { give back v4_ty_attribute_sig }
    if symbol_kind == v4_hir_error { give back v4_ty_error_sig }
    give back v4_ty_unknown
}

task v4_ty_display_for_symbol(symbol_kind: word, symbol_name: word) -> word {
    if symbol_kind == v4_hir_task {
        give back "task " + symbol_name + "(...) -> unknown"
    }
    if symbol_kind == v4_hir_shape {
        give back "shape " + symbol_name
    }
    if symbol_kind == v4_hir_route {
        give back "route " + symbol_name
    }
    if symbol_kind == v4_hir_alias {
        give back "alias " + symbol_name
    }
    if symbol_kind == v4_hir_doctrine {
        give back "doctrine " + symbol_name
    }
    if symbol_kind == v4_hir_extern {
        give back "extern " + symbol_name
    }
    if symbol_kind == v4_hir_import {
        give back "use " + symbol_name
    }
    if symbol_kind == v4_hir_attribute {
        give back "@" + symbol_name
    }
    if symbol_kind == v4_hir_error {
        give back "error " + symbol_name
    }
    give back "unknown " + symbol_name
}

task v4_ty_signature_attribute_count(ty_id: int, sig_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    give back v4_hir_item_attribute_count(hir_id, hir_item)
}

task v4_ty_signature_attribute_name(ty_id: int, sig_id: int, attr_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_name(hir_id, hir_item, attr_id)
}

task v4_ty_signature_attribute_arg(ty_id: int, sig_id: int, attr_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_arg(hir_id, hir_item, attr_id)
}

task v4_ty_signature_has_attribute(ty_id: int, sig_id: int, wanted_name: word) -> bool {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back false
    }
    give back v4_hir_item_has_attribute(hir_id, hir_item, wanted_name)
}

task v4_ty_signature_attribute_arg_for_name(ty_id: int, sig_id: int, wanted_name: word) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_item_attribute_arg_for_name(hir_id, hir_item, wanted_name)
}

task v4_ty_signature_layout(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_attribute_arg_for_name(ty_id, sig_id, "layout")
}

task v4_ty_normalize_call_abi(abi: word) -> word {
    if abi == "" {
        give back ""
    }
    if abi == "C" or abi == "c" {
        give back "C"
    }
    if abi == "cdecl" or abi == "CDECL" {
        give back "cdecl"
    }
    if abi == "stdcall" or abi == "STDCALL" {
        give back "stdcall"
    }
    if abi == "fastcall" or abi == "FASTCALL" {
        give back "fastcall"
    }
    if abi == "thiscall" or abi == "THISCALL" {
        give back "thiscall"
    }
    if abi == "vectorcall" or abi == "VECTORCALL" {
        give back "vectorcall"
    }
    if abi == "win64" or abi == "WIN64" {
        give back "win64"
    }
    if abi == "sysv64" or abi == "SYSV64" {
        give back "sysv64"
    }
    if abi == "system" or abi == "SYSTEM" {
        give back "system"
    }
    give back abi
}

task v4_ty_extern_abi(ty_id: int, sig_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_ty_normalize_call_abi(v4_hir_extern_abi(hir_id, hir_item))
}

task v4_ty_extern_member_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    give back v4_hir_extern_member_count(hir_id, hir_item)
}

task v4_ty_extern_member_name(ty_id: int, sig_id: int, member_id: int) -> word {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    give back v4_hir_extern_member_name(hir_id, hir_item, member_id)
}

task v4_ty_extern_member_start_token(ty_id: int, sig_id: int, member_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
}

task v4_ty_extern_member_end_token(ty_id: int, sig_id: int, member_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_extern_sig {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    give back v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
}

task v4_ty_extern_member_return_type(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_extern_member_start_token(ty_id, sig_id, member_id)
    pilot end_token = v4_ty_extern_member_end_token(ty_id, sig_id, member_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_extern_member_display(ty_id: int, sig_id: int, member_id: int) -> word {
    pilot member_name = v4_ty_extern_member_name(ty_id, sig_id, member_id)
    if member_name == "" {
        give back ""
    }
    give back "task " + member_name + "(...) -> " + v4_ty_extern_member_return_type(ty_id, sig_id, member_id)
}

task v4_ty_signature_extern_member_id(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    give back v4_resolve_extern_member_id_from_def(v4_ty_signature_def(ty_id, sig_id))
}

task v4_ty_signature_call_abi(ty_id: int, sig_id: int) -> word {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig {
        give back v4_ty_normalize_call_abi(v4_hir_extern_abi(hir_id, hir_item))
    }
    if v4_ty_signature_extern_member_id(ty_id, sig_id) >= 0 {
        give back v4_ty_normalize_call_abi(v4_hir_extern_abi(hir_id, hir_item))
    }
    give back ""
}

task v4_ty_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot idx = 0
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count {
        pilot token_span = v4_lex_token_span(stream_id, idx)
        if v4_span_start(token_span) >= offset {
            give back idx
        }
        idx += 1
    }
    give back count
}

task v4_ty_skip_trivia(stream_id: int, token_id: int) -> int {
    pilot idx = token_id
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count or v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
        idx += 1
    }
    give back idx
}

task v4_ty_find_token_value(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if v4_lex_token_value(stream_id, idx) == wanted {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_type_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            out = out + v4_lex_token_value(stream_id, idx)
        }
        idx += 1
    }
    give back out
}

task v4_ty_signature_hir_id(ty_id: int) -> int {
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if v4_resolve_exists(resolve_id) == false {
        give back 0 - 1
    }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) == false {
        give back 0 - 1
    }
    give back hir_id
}

task v4_ty_signature_stream_id(ty_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    give back v4_parse_stream_id(tree_id)
}

task v4_ty_signature_item_start_token(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id >= 0 {
        give back v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
    }
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    give back v4_ty_first_token_at_or_after(stream_id, v4_span_start(item_span))
}

task v4_ty_signature_item_end_token(ty_id: int, sig_id: int) -> int {
    if sig_id < 0 or sig_id >= v4_ty_signature_count(ty_id) {
        give back 0 - 1
    }
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    if hir_item < 0 {
        give back 0 - 1
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
    pilot member_id = v4_ty_signature_extern_member_id(ty_id, sig_id)
    if member_id >= 0 {
        give back v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
    }
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    pilot end_token = v4_ty_first_token_at_or_after(stream_id, v4_span_end(item_span))
    if end_token <= v4_ty_signature_item_start_token(ty_id, sig_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_ty_hir_item_start_token(hir_id: int, item_id: int) -> int {
    if hir_id < 0 {
        give back 0 - 1
    }
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, item_id)
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    give back v4_ty_first_token_at_or_after(stream_id, v4_span_start(item_span))
}

task v4_ty_hir_item_end_token(hir_id: int, item_id: int) -> int {
    if hir_id < 0 {
        give back 0 - 1
    }
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot parse_node = v4_hir_item_parse_node(hir_id, item_id)
    pilot item_span = v4_parse_node_span(tree_id, parse_node)
    pilot end_token = v4_ty_first_token_at_or_after(stream_id, v4_span_end(item_span))
    if end_token <= v4_ty_hir_item_start_token(hir_id, item_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_ty_find_matching_paren(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "(" {
                depth += 1
            } else if val == ")" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_brace(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" {
                depth += 1
            } else if val == "}" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_find_matching_angle(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "<" {
                depth += 1
            } else if val == ">" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_param_open_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0 - 1
    }
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_signature_param_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_depth_after_token(depth: int, val: word) -> int {
    pilot next_depth = depth
    if val == "(" or val == "[" or val == "{" or val == "<" {
        next_depth += 1
    } else if val == ")" or val == "]" or val == "}" or val == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_ty_item_name_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back name_token
}

task v4_ty_item_header_end_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot idx = start_token + 1
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (val == "(" or val == "{" or val == "=>" or val == "->") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_item_generic_open_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    pilot name_token = v4_ty_item_name_token_from_tokens(stream_id, start_token, end_token)
    pilot header_end = v4_ty_item_header_end_token_from_tokens(stream_id, start_token, end_token)
    if name_token < 0 or header_end <= name_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, header_end, "<")
}

task v4_ty_item_generic_close_token_from_tokens(stream_id: int, start_token: int, end_token: int) -> int {
    pilot open_token = v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_angle(stream_id, open_token, v4_ty_item_header_end_token_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_item_generic_text_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot open_token = v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
    pilot close_token = v4_ty_item_generic_close_token_from_tokens(stream_id, start_token, end_token)
    if open_token < 0 or close_token <= open_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, open_token, close_token + 1)
}

task v4_ty_hir_item_generic_text(hir_id: int, item_id: int) -> word {
    if hir_id < 0 or item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_item_generic_text_from_tokens(stream_id, v4_ty_hir_item_start_token(hir_id, item_id), v4_ty_hir_item_end_token(hir_id, item_id))
}

task v4_ty_signature_generic_open_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_open_token_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_close_token_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_text(ty_id: int, sig_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    give back v4_ty_item_generic_text_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_generic_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
}

task v4_ty_signature_param_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_count_from_tokens(stream_id, open_token, close_token)
}

task v4_ty_param_count_from_tokens(stream_id: int, open_token: int, close_token: int) -> int {
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot first = v4_ty_skip_trivia(stream_id, open_token + 1)
    if first >= close_token {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                count += 1
            } else {
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_signature_param_segment_start(ty_id: int, sig_id: int, param_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_param_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
}

task v4_ty_param_segment_start_from_tokens(stream_id: int, open_token: int, close_token: int, param_id: int) -> int {
    if stream_id < 0 or open_token < 0 or close_token <= open_token or param_id < 0 {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = v4_ty_skip_trivia(stream_id, open_token + 1)
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                if current == param_id {
                    give back segment_start
                }
                current += 1
                segment_start = v4_ty_skip_trivia(stream_id, idx + 1)
            } else {
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    if current == param_id and segment_start < close_token {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_signature_param_segment_end(ty_id: int, sig_id: int, param_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot close_token = v4_ty_signature_param_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
}

task v4_ty_param_segment_end_from_tokens(stream_id: int, start_token: int, close_token: int) -> int {
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_find_top_level_token(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == wanted {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_generic_segment_start(ty_id: int, sig_id: int, generic_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_signature_generic_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, generic_id)
}

task v4_ty_signature_generic_segment_end(ty_id: int, sig_id: int, generic_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot close_token = v4_ty_signature_generic_close_token(ty_id, sig_id)
    give back v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
}

task v4_ty_generic_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_type_text(stream_id, start_token, end_token)
    }
    give back v4_ty_type_text(stream_id, start_token, colon_token)
}

task v4_ty_generic_bounds_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back ""
    }
    pilot bound_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    if bound_start >= end_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, bound_start, end_token)
}

task v4_ty_signature_generic_name(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_bounds(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    give back v4_ty_generic_bounds_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_signature_generic_kind(ty_id: int, sig_id: int, generic_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_generic_segment_start(ty_id, sig_id, generic_id)
    pilot end_token = v4_ty_signature_generic_segment_end(ty_id, sig_id, generic_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_generic_kind_type
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first < end_token and v4_lex_token_type(stream_id, first) == v4_tok_lifetime {
        give back v4_ty_generic_kind_lifetime
    }
    give back v4_ty_generic_kind_type
}

task v4_ty_signature_generic_is_lifetime(ty_id: int, sig_id: int, generic_id: int) -> bool {
    give back v4_ty_signature_generic_kind(ty_id, sig_id, generic_id) == v4_ty_generic_kind_lifetime
}

task v4_ty_signature_lifetime_count(ty_id: int, sig_id: int) -> int {
    pilot total = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            total += 1
        }
        generic_id += 1
    }
    give back total
}

task v4_ty_signature_type_generic_count(ty_id: int, sig_id: int) -> int {
    pilot total = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            total += 1
        }
        generic_id += 1
    }
    give back total
}

task v4_ty_signature_lifetime_name(ty_id: int, sig_id: int, lifetime_id: int) -> word {
    pilot seen = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            if seen == lifetime_id {
                give back v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
            }
            seen += 1
        }
        generic_id += 1
    }
    give back ""
}

task v4_ty_signature_type_generic_name(ty_id: int, sig_id: int, type_generic_id: int) -> word {
    pilot seen = 0
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) == false {
            if seen == type_generic_id {
                give back v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
            }
            seen += 1
        }
        generic_id += 1
    }
    give back ""
}

task v4_ty_generic_bound_count(bounds_text: word) -> int {
    if bounds_text == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= bounds_text.length() {
        pilot ch = bounds_text.char_at(idx)
        if depth == 0 and ch == "+" {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_generic_bound_name(bounds_text: word, bound_id: int) -> word {
    if bounds_text == "" or bound_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 0
    pilot depth = 0
    pilot idx = 0
    repeat until idx >= bounds_text.length() {
        pilot ch = bounds_text.char_at(idx)
        if depth == 0 and ch == "+" {
            if current == bound_id {
                give back v4_slice(bounds_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == bound_id and segment_start < bounds_text.length() {
        give back v4_slice(bounds_text, segment_start, bounds_text.length())
    }
    give back ""
}

task v4_ty_signature_generic_bound_count(ty_id: int, sig_id: int, generic_id: int) -> int {
    give back v4_ty_generic_bound_count(v4_ty_signature_generic_bounds(ty_id, sig_id, generic_id))
}

task v4_ty_signature_generic_bound_name(ty_id: int, sig_id: int, generic_id: int, bound_id: int) -> word {
    give back v4_ty_generic_bound_name(v4_ty_signature_generic_bounds(ty_id, sig_id, generic_id), bound_id)
}

task v4_ty_signature_generic_has_bound(ty_id: int, sig_id: int, generic_id: int, wanted_bound: word) -> bool {
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        if v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx) == wanted_bound {
            give back true
        }
        bound_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_generic_name(ty_id: int, sig_id: int, type_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
            give back true
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_lifetime_name(ty_id: int, sig_id: int, lifetime_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) {
            if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == lifetime_name {
                give back true
            }
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_declares_type_generic_name(ty_id: int, sig_id: int, type_name: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
                give back true
            }
        }
        generic_idx += 1
    }
    give back false
}

task v4_ty_signature_generic_id_for_name(ty_id: int, sig_id: int, type_name: word) -> int {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_name(ty_id, sig_id, generic_idx) == type_name {
            give back generic_idx
        }
        generic_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_param_name(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_param_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_signature_param_type(ty_id: int, sig_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_param_segment_start(ty_id, sig_id, param_id)
    pilot end_token = v4_ty_signature_param_segment_end(ty_id, sig_id, param_id)
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_param_type_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot param_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if param_ty == "" {
        give back v4_ty_unknown
    }
    give back param_ty
}

task v4_ty_return_type_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (val == "{" or val == "=>") {
                give back idx
            }
            if val == "(" or val == "[" or val == "<" {
                depth += 1
            } else if val == ")" or val == "]" or val == ">" {
                if depth > 0 {
                    depth -= 1
                }
            }
        }
        idx += 1
    }
    give back end_token
}

task v4_ty_infer_arrow_expr_return(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back v4_ty_void
    }

    pilot first_type = v4_lex_token_type(stream_id, first)
    pilot first_value = v4_lex_token_value(stream_id, first)
    if first_type == v4_tok_int {
        give back v4_ty_int
    }
    if first_type == v4_tok_float {
        give back v4_ty_num
    }
    if first_type == v4_tok_string {
        give back v4_ty_word
    }
    if first_type == v4_tok_bool {
        give back v4_ty_bool
    }
    if first_value == "nobody" {
        give back "maybe<unknown>"
    }
    give back v4_ty_unknown
}

task v4_ty_task_return_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot return_arrow = v4_ty_find_token_value(stream_id, start_token, end_token, "->")
    if return_arrow >= 0 {
        pilot return_start = v4_ty_skip_trivia(stream_id, return_arrow + 1)
        pilot return_end = v4_ty_return_type_end(stream_id, return_start, end_token)
        pilot return_ty = v4_ty_type_text(stream_id, return_start, return_end)
        if return_ty != "" {
            give back return_ty
        }
    }

    pilot fat_arrow = v4_ty_find_token_value(stream_id, start_token, end_token, "=>")
    if fat_arrow >= 0 {
        give back v4_ty_infer_arrow_expr_return(stream_id, fat_arrow + 1, end_token)
    }

    give back v4_ty_unknown
}

task v4_ty_task_return_from_hir(hir_id: int, hir_item: int) -> word {
    if hir_item < 0 {
        give back v4_ty_unknown
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    give back v4_ty_task_return_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_skip_item(stream_id: int, start_token: int, end_limit: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_body = false
    pilot count = end_limit
    if count > v4_lex_token_count(stream_id) {
        count = v4_lex_token_count(stream_id)
    }

    repeat until idx >= count {
        if v4_lex_token_type(stream_id, idx) == v4_tok_eof {
            give back idx
        }

        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia and val == "\n" and not saw_body and depth == 0 {
            give back idx + 1
        }

        if tok_type != v4_tok_trivia {
            if val == "{" {
                depth += 1
                saw_body = true
            } else if val == "}" {
                if depth > 0 {
                    depth -= 1
                }
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "done" {
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "=>" {
                saw_body = true
            }
        }
        idx += 1
    }
    give back idx
}

task v4_ty_impl_target_type_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back ""
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back ""
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token >= 0 {
        pilot type_start = v4_ty_skip_trivia(stream_id, for_token + 1)
        give back v4_ty_type_text(stream_id, type_start, open_token)
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    give back v4_ty_type_text(stream_id, type_start, open_token)
}

task v4_ty_impl_doctrine_name_from_hir(ty_id: int, hir_item: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back ""
    }
    if v4_hir_item_kind(hir_id, hir_item) != v4_hir_impl {
        give back ""
    }

    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    pilot open_token = v4_ty_find_token_value(stream_id, start_token, end_token, "{")
    if open_token < 0 {
        give back ""
    }

    pilot for_token = v4_ty_find_top_level_token(stream_id, start_token + 1, open_token, "for")
    if for_token < 0 {
        give back ""
    }
    pilot doctrine_start = v4_ty_skip_trivia(stream_id, start_token + 1)
    if doctrine_start >= for_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, doctrine_start, for_token)
}

task v4_ty_impl_body_open_token_from_hir(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_hir_item_start_token(hir_id, hir_item)
    pilot end_token = v4_ty_hir_item_end_token(hir_id, hir_item)
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_impl_body_close_token_from_hir(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_hir_item_end_token(hir_id, hir_item))
}

task v4_ty_impl_method_count(ty_id: int, hir_item: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_impl_method_start_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 or hir_item < 0 or method_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_body_open_token_from_hir(ty_id, hir_item)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == method_id {
                give back idx
            }
            current += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_ty_impl_method_end_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_body_close_token_from_hir(ty_id, hir_item)
    if start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_skip_item(stream_id, start_token, close_token)
}

task v4_ty_impl_method_name(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    if start_token < 0 {
        give back ""
    }
    pilot name_token = v4_ty_skip_trivia(stream_id, start_token + 1)
    if name_token < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, name_token)
}

task v4_ty_impl_method_param_open_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
    pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_impl_method_param_close_token(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot end_token = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
    if open_token < 0 or end_token <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, end_token)
}

task v4_ty_impl_method_param_count(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id), v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id))
}

task v4_ty_impl_method_param_name(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_impl_method_param_type(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_ty_impl_method_param_open_token(ty_id, hir_item, method_id)
    pilot close_token = v4_ty_impl_method_param_close_token(ty_id, hir_item, method_id)
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    pilot param_name = v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
    if param_name == "self" {
        give back v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_impl_method_is_instance(ty_id: int, hir_item: int, method_id: int) -> bool {
    if v4_ty_impl_method_param_count(ty_id, hir_item, method_id) <= 0 {
        give back false
    }
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, 0) == "self"
}

task v4_ty_impl_method_explicit_param_count(ty_id: int, hir_item: int, method_id: int) -> int {
    pilot count = v4_ty_impl_method_param_count(ty_id, hir_item, method_id)
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        if count > 0 {
            give back count - 1
        }
    }
    give back count
}

task v4_ty_impl_method_explicit_param_name(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_impl_method_explicit_param_type(ty_id: int, hir_item: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) {
        shift = 1
    }
    give back v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id + shift)
}

task v4_ty_match_type_pattern_env(ty_id: int, pattern_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    pilot canonical_pattern = v4_ty_canonical_type(ty_id, pattern_ty)
    if canonical_pattern != "" and canonical_pattern != v4_ty_unknown {
        pattern_ty = canonical_pattern
    }
    pilot canonical_actual = v4_ty_canonical_type(ty_id, actual_ty)
    if canonical_actual != "" and canonical_actual != v4_ty_unknown {
        actual_ty = canonical_actual
    }
    if pattern_ty == "" or pattern_ty == v4_ty_unknown or not v4_ty_is_known(actual_ty) {
        give back v4_ty_generic_env_fail
    }
    if pattern_ty == actual_ty {
        give back env
    }
    if v4_ty_is_numeric(pattern_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_generic_instance_type(pattern_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(pattern_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(pattern_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(pattern_ty)
        repeat until arg_idx >= arg_count {
            next_env = v4_ty_match_type_pattern_env(ty_id, v4_ty_generic_arg(pattern_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(pattern_ty) and v4_ty_is_tuple_type(actual_ty) {
        if v4_ty_tuple_slot_count(pattern_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(pattern_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_type_pattern_env(ty_id, v4_ty_tuple_slot_type(pattern_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(pattern_ty) and v4_ty_is_fixed_array_type(actual_ty) {
        if v4_ty_fixed_array_length_text(pattern_ty) != v4_ty_fixed_array_length_text(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_type_pattern_env(ty_id, v4_ty_fixed_array_element_type(pattern_ty), v4_ty_fixed_array_element_type(actual_ty), env)
    }
    if not v4_ty_is_declared_simple_type_name(ty_id, pattern_ty) {
        give back v4_ty_generic_env_bind(env, pattern_ty, actual_ty)
    }
    if v4_ty_types_compatible(pattern_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_impl_generic_env_for_owner(ty_id: int, hir_item: int, owner_ty: word) -> word {
    give back v4_ty_match_type_pattern_env(ty_id, v4_ty_impl_target_type_from_hir(ty_id, hir_item), owner_ty, "")
}

task v4_ty_impl_matches_owner(ty_id: int, hir_item: int, owner_ty: word) -> bool {
    give back v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty) != v4_ty_generic_env_fail
}

task v4_ty_apply_impl_generics(ty_id: int, hir_item: int, owner_ty: word, member_ty: word) -> word {
    pilot env = v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty)
    if env == v4_ty_generic_env_fail {
        give back member_ty
    }
    give back v4_ty_apply_generic_env(member_ty, env)
}

task v4_ty_impl_method_param_type_for_owner(ty_id: int, hir_item: int, method_id: int, param_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id)))
}

task v4_ty_impl_method_explicit_param_type_for_owner(ty_id: int, hir_item: int, method_id: int, param_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_explicit_param_type(ty_id, hir_item, method_id, param_id)))
}

task v4_ty_impl_method_return_type(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back v4_ty_unknown
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, v4_ty_impl_method_start_token(ty_id, hir_item, method_id), v4_ty_impl_method_end_token(ty_id, hir_item, method_id)))
}

task v4_ty_impl_method_return_type_for_owner(ty_id: int, hir_item: int, method_id: int, owner_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_impl_generics(ty_id, hir_item, owner_ty, v4_ty_impl_method_return_type(ty_id, hir_item, method_id)))
}

task v4_ty_impl_method_def(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    if hir_id < 0 {
        give back ""
    }
    pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
    pilot file_id = v4_hir_file_id(hir_id)
    give back "file" + word_from_int(file_id) + "::Method::" + owner_ty + "." + method_name + "#" + word_from_int(hir_item) + ":" + word_from_int(method_id)
}

task v4_ty_impl_method_display(ty_id: int, hir_item: int, method_id: int) -> word {
    pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
    pilot return_ty = v4_ty_impl_method_return_type(ty_id, hir_item, method_id)
    give back "task " + owner_ty + "::" + method_name + "(...) -> " + return_ty
}

task v4_ty_doctrine_signature_id_for_name(ty_id: int, doctrine_name: word) -> int {
    pilot lookup_name = doctrine_name
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }

    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_doctrine_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_doctrine_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_doctrine_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_doctrine_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_doctrine_method_count(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_ty_doctrine_method_start_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token or method_id < 0 {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_ty_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == method_id {
                give back idx
            }
            current += 1
            idx = v4_ty_skip_item(stream_id, idx, close_token)
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_ty_doctrine_method_end_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_skip_item(stream_id, start_token, close_token)
}

task v4_ty_doctrine_method_name(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 {
        give back ""
    }
    give back v4_lex_token_value(stream_id, v4_ty_skip_trivia(stream_id, start_token + 1))
}

task v4_ty_doctrine_method_param_open_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "(")
}

task v4_ty_doctrine_method_param_close_token(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or end_token <= open_token {
        give back 0 - 1
    }
    give back v4_ty_find_matching_paren(stream_id, open_token, end_token)
}

task v4_ty_doctrine_method_param_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    if stream_id < 0 {
        give back 0
    }
    give back v4_ty_param_count_from_tokens(stream_id, v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id), v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id))
}

task v4_ty_doctrine_method_param_name(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back ""
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    give back v4_ty_param_name_from_tokens(stream_id, start_token, end_token)
}

task v4_ty_doctrine_method_param_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_doctrine_method_param_open_token(ty_id, sig_id, method_id)
    pilot close_token = v4_ty_doctrine_method_param_close_token(ty_id, sig_id, method_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back v4_ty_unknown
    }
    pilot start_token = v4_ty_param_segment_start_from_tokens(stream_id, open_token, close_token, param_id)
    pilot end_token = v4_ty_param_segment_end_from_tokens(stream_id, start_token, close_token)
    if v4_ty_param_name_from_tokens(stream_id, start_token, end_token) == "self" {
        give back "Self"
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_param_type_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_doctrine_method_is_instance(ty_id: int, sig_id: int, method_id: int) -> bool {
    if v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id) <= 0 {
        give back false
    }
    give back v4_ty_doctrine_method_param_name(ty_id, sig_id, method_id, 0) == "self"
}

task v4_ty_doctrine_method_explicit_param_count(ty_id: int, sig_id: int, method_id: int) -> int {
    pilot count = v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id)
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) and count > 0 {
        give back count - 1
    }
    give back count
}

task v4_ty_doctrine_method_explicit_param_type(ty_id: int, sig_id: int, method_id: int, param_id: int) -> word {
    pilot shift = 0
    if v4_ty_doctrine_method_is_instance(ty_id, sig_id, method_id) {
        shift = 1
    }
    give back v4_ty_doctrine_method_param_type(ty_id, sig_id, method_id, param_id + shift)
}

task v4_ty_doctrine_method_return_type(ty_id: int, sig_id: int, method_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_doctrine_method_start_token(ty_id, sig_id, method_id)
    pilot end_token = v4_ty_doctrine_method_end_token(ty_id, sig_id, method_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_task_return_from_tokens(stream_id, start_token, end_token))
}

task v4_ty_apply_self_type(type_text: word, self_ty: word) -> word {
    pilot env = v4_ty_generic_env_bind("", "Self", self_ty)
    if env == v4_ty_generic_env_fail {
        give back type_text
    }
    give back v4_ty_apply_generic_env(type_text, env)
}

task v4_ty_doctrine_method_explicit_param_type_for_self(ty_id: int, sig_id: int, method_id: int, param_id: int, self_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_type(v4_ty_doctrine_method_explicit_param_type(ty_id, sig_id, method_id, param_id), self_ty))
}

task v4_ty_doctrine_method_return_type_for_self(ty_id: int, sig_id: int, method_id: int, self_ty: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_self_type(v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id), self_ty))
}

task v4_ty_type_satisfies_doctrine(ty_id: int, actual_ty: word, doctrine_name: word) -> bool {
    if not v4_ty_is_known(actual_ty) or doctrine_name == "" {
        give back true
    }

    pilot wanted_doctrine = doctrine_name
    if v4_ty_is_generic_instance_type(wanted_doctrine) {
        wanted_doctrine = v4_ty_generic_base_name(wanted_doctrine)
    }
    if v4_ty_doctrine_signature_id_for_name(ty_id, wanted_doctrine) < 0 {
        give back false
    }

    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back false
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            pilot impl_doctrine = v4_ty_impl_doctrine_name_from_hir(ty_id, hir_item)
            if v4_ty_is_generic_instance_type(impl_doctrine) {
                impl_doctrine = v4_ty_generic_base_name(impl_doctrine)
            }
            if impl_doctrine == wanted_doctrine {
                if v4_ty_impl_matches_owner(ty_id, hir_item, actual_ty) {
                    give back true
                }
            }
        }
        hir_item += 1
    }
    give back false
}

task v4_ty_display_for_hir_item(symbol_kind: word, symbol_name: word, symbol_def: word, hir_id: int, hir_item: int) -> word {
    pilot generic_text = v4_ty_hir_item_generic_text(hir_id, hir_item)
    if symbol_kind == v4_hir_task {
        if v4_resolve_is_extern_member_def(symbol_def) {
            pilot tree_id = v4_hir_tree_id(hir_id)
            pilot stream_id = v4_parse_stream_id(tree_id)
            pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
            pilot member_id = v4_resolve_extern_member_id_from_def(symbol_def)
            pilot member_start = v4_parse_extern_member_start_token(tree_id, parse_node, member_id)
            pilot member_end = v4_parse_extern_member_end_token(tree_id, parse_node, member_id)
            give back "task " + symbol_name + "(...) -> " + v4_ty_task_return_from_tokens(stream_id, member_start, member_end)
        }
        give back "task " + symbol_name + generic_text + "(...) -> " + v4_ty_task_return_from_hir(hir_id, hir_item)
    }
    if symbol_kind == v4_hir_shape {
        give back "shape " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_route {
        give back "route " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_alias {
        pilot alias_target = v4_hir_alias_target(hir_id, hir_item)
        if alias_target != "" {
            give back "alias " + symbol_name + " = " + alias_target
        }
        give back "alias " + symbol_name
    }
    if symbol_kind == v4_hir_doctrine {
        give back "doctrine " + symbol_name + generic_text
    }
    if symbol_kind == v4_hir_extern {
        pilot extern_abi = v4_ty_normalize_call_abi(v4_hir_extern_abi(hir_id, hir_item))
        if extern_abi != "" {
            give back "extern [" + extern_abi + "]"
        }
        give back "extern"
    }
    if symbol_kind == v4_hir_import {
        pilot import_path = v4_hir_import_path(hir_id, hir_item)
        pilot import_alias = v4_hir_import_alias(hir_id, hir_item)
        if import_path != "" {
            if import_alias != "" {
                give back "use " + import_path + " as " + import_alias
            }
            give back "use " + import_path
        }
    }
    if symbol_kind == v4_hir_attribute {
        pilot attr_arg = v4_hir_attribute_arg(hir_id, hir_item)
        if attr_arg != "" {
            give back "@" + symbol_name + "(" + attr_arg + ")"
        }
        give back "@" + symbol_name
    }
    give back v4_ty_display_for_symbol(symbol_kind, symbol_name)
}

task v4_ty_signature_return_type(ty_id: int, sig_id: int) -> word {
    pilot display = v4_ty_signature_display(ty_id, sig_id)
    pilot i = 0
    repeat until i + 2 >= display.length() {
        if display.char_at(i) == "-" and display.char_at(i + 1) == ">" {
            pilot start_pos = i + 2
            if start_pos < display.length() and display.char_at(start_pos) == " " {
                start_pos += 1
            }
            give back v4_ty_canonical_type(ty_id, v4_slice(display, start_pos, display.length()))
        }
        i += 1
    }
    give back v4_ty_unknown
}

task v4_ty_shape_signature_id_for_name(ty_id: int, shape_name: word) -> int {
    pilot lookup_name = shape_name
    pilot alias_lookup = v4_ty_alias_target_type(ty_id, lookup_name)
    if alias_lookup != "" and alias_lookup != v4_ty_unknown {
        lookup_name = v4_ty_canonical_type(ty_id, alias_lookup)
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_shape_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_signature_id_for_name(ty_id: int, route_name: word) -> int {
    pilot lookup_name = route_name
    pilot alias_lookup = v4_ty_alias_target_type(ty_id, lookup_name)
    if alias_lookup != "" and alias_lookup != v4_ty_unknown {
        lookup_name = v4_ty_canonical_type(ty_id, alias_lookup)
    }
    if v4_ty_is_generic_instance_type(lookup_name) {
        lookup_name = v4_ty_generic_base_name(lookup_name)
    }
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_route_sig {
            if v4_ty_signature_name(ty_id, sig_id) == lookup_name {
                give back sig_id
            }
        }
        sig_id += 1
    }
    give back 0 - 1
}

task v4_ty_is_route_type(ty_id: int, route_name: word) -> bool {
    give back v4_ty_route_signature_id_for_name(ty_id, route_name) >= 0
}

task v4_ty_route_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_route_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_route_is_case_separator(val: word) -> bool {
    give back val == "," or val == ";" or val == "/"
}

task v4_ty_route_case_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_case = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_case = false
            }
        } else {
            if depth == 0 and v4_ty_route_is_case_separator(val) {
                in_case = false
            } else {
                if not in_case {
                    count += 1
                    in_case = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_route_case_segment_start(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == case_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and v4_ty_route_is_case_separator(val) {
                if segment_start >= 0 {
                    if current == case_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == case_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_route_case_segment_end(ty_id: int, sig_id: int, case_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and v4_ty_route_is_case_separator(val) {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_route_case_name(ty_id: int, sig_id: int, case_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_route_case_id_for_name(ty_id: int, route_name: word, case_name: word) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        if v4_ty_route_case_name(ty_id, sig_id, case_id) == case_name {
            give back case_id
        }
        case_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_has_case(ty_id: int, route_name: word, case_name: word) -> bool {
    give back v4_ty_route_case_id_for_name(ty_id, route_name, case_name) >= 0
}

task v4_ty_route_case_payload_open_token(ty_id: int, sig_id: int, case_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_route_sig or case_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_segment_start(ty_id, sig_id, case_id)
    pilot end_token = v4_ty_route_case_segment_end(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot name_token = v4_ty_skip_trivia(stream_id, start_token)
    if name_token >= end_token {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_token(stream_id, name_token + 1, end_token, "{")
}

task v4_ty_route_case_payload_close_token(ty_id: int, sig_id: int, case_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_route_case_segment_end(ty_id, sig_id, case_id))
}

task v4_ty_route_case_has_payload(ty_id: int, route_name: word, case_name: word) -> bool {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back false
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back false
    }
    give back v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id) >= 0
}

task v4_ty_route_case_field_count(ty_id: int, route_name: word, case_name: word) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_field = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_field = false
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                in_field = false
            } else {
                if not in_field {
                    count += 1
                    in_field = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_route_case_field_segment_start(ty_id: int, route_name: word, case_name: word, field_id: int) -> int {
    if field_id < 0 {
        give back 0 - 1
    }
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_route_case_payload_open_token(ty_id, sig_id, case_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == field_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                if segment_start >= 0 {
                    if current == field_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == field_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_route_case_field_segment_end(ty_id: int, route_name: word, case_name: word, field_id: int) -> int {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot case_id = v4_ty_route_case_id_for_name(ty_id, route_name, case_name)
    if case_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot close_token = v4_ty_route_case_payload_close_token(ty_id, sig_id, case_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and (val == "," or val == ";") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_route_case_field_name(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }

    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_route_case_field_type(ty_id: int, route_name: word, case_name: word, field_id: int) -> word {
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_route_case_field_segment_start(ty_id, route_name, case_name, field_id)
    pilot end_token = v4_ty_route_case_field_segment_end(ty_id, route_name, case_name, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    pilot instance_name = v4_ty_canonical_type(ty_id, route_name)
    if instance_name == "" or instance_name == v4_ty_unknown {
        instance_name = route_name
    }
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_signature_generics(ty_id, sig_id, instance_name, field_ty))
}

task v4_ty_route_case_field_id_for_name(ty_id: int, route_name: word, case_name: word, field_name: word) -> int {
    pilot field_id = 0
    pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
    repeat until field_id >= field_count {
        if v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) == field_name {
            give back field_id
        }
        field_id += 1
    }
    give back 0 - 1
}

task v4_ty_route_case_field_type_for_name(ty_id: int, route_name: word, case_name: word, field_name: word) -> word {
    pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_name, case_name, field_name)
    if field_id >= 0 {
        give back v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id)
    }
    give back v4_ty_unknown
}

task v4_ty_shape_body_open_token(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig {
        give back 0 - 1
    }
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_signature_item_start_token(ty_id, sig_id)
    pilot end_token = v4_ty_signature_item_end_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_ty_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_ty_shape_body_close_token(ty_id: int, sig_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 {
        give back 0 - 1
    }
    give back v4_ty_find_matching_brace(stream_id, open_token, v4_ty_signature_item_end_token(ty_id, sig_id))
}

task v4_ty_shape_field_count(ty_id: int, sig_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig {
        give back 0
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot in_field = false
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                in_field = false
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                in_field = false
            } else {
                if not in_field {
                    count += 1
                    in_field = true
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_ty_shape_field_segment_start(ty_id: int, sig_id: int, field_id: int) -> int {
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_shape_sig or field_id < 0 {
        give back 0 - 1
    }

    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot open_token = v4_ty_shape_body_open_token(ty_id, sig_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot segment_start = 0 - 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 and segment_start >= 0 {
                if current == field_id {
                    give back segment_start
                }
                current += 1
                segment_start = 0 - 1
            }
        } else {
            if depth == 0 and (val == "," or val == ";") {
                if segment_start >= 0 {
                    if current == field_id {
                        give back segment_start
                    }
                    current += 1
                    segment_start = 0 - 1
                }
            } else {
                if segment_start < 0 {
                    segment_start = idx
                }
                depth = v4_ty_depth_after_token(depth, val)
            }
        }
        idx += 1
    }

    if segment_start >= 0 and current == field_id {
        give back segment_start
    }
    give back 0 - 1
}

task v4_ty_shape_field_segment_end(ty_id: int, sig_id: int, field_id: int) -> int {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot close_token = v4_ty_shape_body_close_token(ty_id, sig_id)
    if stream_id < 0 or start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }

    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and idx > start_token and (val == "," or val == ";") {
                give back idx
            }
            depth = v4_ty_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_ty_shape_field_name(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot first = v4_ty_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_ty_shape_field_type(ty_id: int, sig_id: int, field_id: int) -> word {
    pilot stream_id = v4_ty_signature_stream_id(ty_id)
    pilot start_token = v4_ty_shape_field_segment_start(ty_id, sig_id, field_id)
    pilot end_token = v4_ty_shape_field_segment_end(ty_id, sig_id, field_id)
    if stream_id < 0 or start_token < 0 or end_token <= start_token {
        give back v4_ty_unknown
    }

    pilot colon_token = v4_ty_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back v4_ty_unknown
    }
    pilot type_start = v4_ty_skip_trivia(stream_id, colon_token + 1)
    pilot field_ty = v4_ty_type_text(stream_id, type_start, end_token)
    if field_ty == "" {
        give back v4_ty_unknown
    }
    give back v4_ty_canonical_type(ty_id, field_ty)
}

task v4_ty_shape_field_id_for_name(ty_id: int, shape_name: word, field_name: word) -> int {
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        if v4_ty_shape_field_name(ty_id, sig_id, field_id) == field_name {
            give back field_id
        }
        field_id += 1
    }
    give back 0 - 1
}

task v4_ty_shape_field_type_for_name(ty_id: int, shape_name: word, field_name: word) -> word {
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    if sig_id < 0 {
        give back v4_ty_unknown
    }

    pilot field_id = v4_ty_shape_field_id_for_name(ty_id, shape_name, field_name)
    if field_id >= 0 {
        pilot instance_name = v4_ty_canonical_type(ty_id, shape_name)
        if instance_name == "" or instance_name == v4_ty_unknown {
            instance_name = shape_name
        }
        give back v4_ty_apply_signature_generics(ty_id, sig_id, instance_name, v4_ty_shape_field_type(ty_id, sig_id, field_id))
    }
    give back v4_ty_unknown
}

task v4_ty_lifetime_is_implicit(lifetime_name: word) -> bool {
    give back lifetime_name == "'static"
}

task v4_ty_signature_accepts_lifetime(ty_id: int, sig_id: int, lifetime_name: word) -> bool {
    if v4_ty_lifetime_is_implicit(lifetime_name) {
        give back true
    }
    give back v4_ty_signature_declares_lifetime_name(ty_id, sig_id, lifetime_name)
}

task v4_ty_validate_signature_generic_names(ty_id: int, sig_id: int) -> void {
    pilot generic_id = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_id >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_id)
        if generic_name == "" {
            v4_ty_add_diag(ty_id, "Meiya lifetime debt: empty generic slot on " + v4_ty_signature_name(ty_id, sig_id))
        }

        pilot previous_id = 0
        repeat until previous_id >= generic_id {
            if v4_ty_signature_generic_name(ty_id, sig_id, previous_id) == generic_name {
                v4_ty_add_diag(ty_id, "Meiya lifetime debt: duplicate generic " + generic_name + " on " + v4_ty_signature_name(ty_id, sig_id) + "; every route through Alternative IV needs one owner")
            }
            previous_id += 1
        }
        generic_id += 1
    }
}

task v4_ty_validate_signature_type_lifetimes(ty_id: int, sig_id: int, type_text: word, context: word) -> void {
    if type_text == "" or type_text == v4_ty_unknown {
        give back
    }

    if v4_ty_is_lifetime_name(type_text) {
        v4_ty_add_diag(ty_id, "Meiya lifetime debt: " + type_text + " cannot be used as a value type in " + context)
    }

    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        pilot lifetime_name = v4_ty_type_lifetime_name(type_text, lifetime_id)
        if v4_ty_signature_accepts_lifetime(ty_id, sig_id, lifetime_name) == false {
            v4_ty_add_diag(ty_id, "Meiya lifetime debt: " + lifetime_name + " is used in " + context + " but is not declared on " + v4_ty_signature_name(ty_id, sig_id))
        }
        lifetime_id += 1
    }

    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, type_text, context)
}

task v4_ty_validate_signature_type_generic_contracts(ty_id: int, sig_id: int, type_text: word, context: word) -> void {
    if type_text == "" or type_text == v4_ty_unknown {
        give back
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot actual_count = v4_ty_generic_arg_count(type_text)
        pilot expected_count = v4_ty_expected_generic_arg_count(ty_id, base_name)
        if expected_count >= 0 and expected_count != actual_count {
            v4_ty_add_diag(ty_id, "Meiya lifetime debt: " + base_name + " expects " + word_from_int(expected_count) + " generic arguments in " + context + " but received " + word_from_int(actual_count))
        }

        pilot arg_id = 0
        repeat until arg_id >= actual_count {
            pilot arg_text = v4_ty_generic_arg(type_text, arg_id)
            if v4_ty_generic_slot_accepts_lifetime(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) == false {
                    v4_ty_add_diag(ty_id, "Meiya lifetime debt: generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context + " must be a lifetime like 'a")
                }
            } else if v4_ty_generic_slot_accepts_type(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) {
                    v4_ty_add_diag(ty_id, "Meiya lifetime debt: " + arg_text + " cannot be used as a value type in generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context)
                } else {
                    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, arg_text, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context)
                }
            } else {
                if v4_ty_is_lifetime_name(arg_text) == false {
                    v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, arg_text, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context)
                }
            }
            arg_id += 1
        }
        give back
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            pilot slot_text = v4_ty_tuple_slot_type(type_text, slot_id)
            if v4_ty_is_lifetime_name(slot_text) {
                v4_ty_add_diag(ty_id, "Meiya lifetime debt: " + slot_text + " cannot be used as a value type in tuple slot " + word_from_int(slot_id) + " of " + context)
            } else {
                v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, slot_text, "tuple slot " + word_from_int(slot_id) + " of " + context)
            }
            slot_id += 1
        }
        give back
    }

    if v4_ty_is_fixed_array_type(type_text) {
        pilot element_type = v4_ty_fixed_array_element_type(type_text)
        if v4_ty_is_lifetime_name(element_type) {
            v4_ty_add_diag(ty_id, "Meiya lifetime debt: " + element_type + " cannot be used as a value type in array element of " + context)
        } else {
            v4_ty_validate_signature_type_generic_contracts(ty_id, sig_id, element_type, "array element of " + context)
        }
    }
}

task v4_ty_validate_task_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot param_id = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_signature_param_type(ty_id, sig_id, param_id), "parameter " + word_from_int(param_id) + " of " + v4_ty_signature_name(ty_id, sig_id))
        param_id += 1
    }
    v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_signature_return_type(ty_id, sig_id), "return type of " + v4_ty_signature_name(ty_id, sig_id))
}

task v4_ty_validate_shape_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot field_id = 0
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    repeat until field_id >= field_count {
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_shape_field_type(ty_id, sig_id, field_id), "field " + v4_ty_shape_field_name(ty_id, sig_id, field_id) + " of " + v4_ty_signature_name(ty_id, sig_id))
        field_id += 1
    }
}

task v4_ty_validate_route_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot route_name = v4_ty_signature_name(ty_id, sig_id)
    pilot case_id = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_id >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_id)
        pilot field_id = 0
        pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
        repeat until field_id >= field_count {
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_route_case_field_type(ty_id, route_name, case_name, field_id), "field " + v4_ty_route_case_field_name(ty_id, route_name, case_name, field_id) + " of " + route_name + "::" + case_name)
            field_id += 1
        }
        case_id += 1
    }
}

task v4_ty_validate_doctrine_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    pilot method_id = 0
    pilot method_count = v4_ty_doctrine_method_count(ty_id, sig_id)
    repeat until method_id >= method_count {
        pilot method_name = v4_ty_doctrine_method_name(ty_id, sig_id, method_id)
        pilot param_id = 0
        pilot param_count = v4_ty_doctrine_method_param_count(ty_id, sig_id, method_id)
        repeat until param_id >= param_count {
            v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_doctrine_method_param_type(ty_id, sig_id, method_id, param_id), "parameter " + word_from_int(param_id) + " of " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name)
            param_id += 1
        }
        v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_doctrine_method_return_type(ty_id, sig_id, method_id), "return type of " + v4_ty_signature_name(ty_id, sig_id) + "::" + method_name)
        method_id += 1
    }
}

task v4_ty_validate_alias_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    v4_ty_validate_signature_type_lifetimes(ty_id, sig_id, v4_ty_alias_target_type_for_sig(ty_id, sig_id), "alias target of " + v4_ty_signature_name(ty_id, sig_id))
}

task v4_ty_validate_alias_signature_cycle(ty_id: int, sig_id: int) -> void {
    pilot alias_name = v4_ty_signature_name(ty_id, sig_id)
    pilot alias_target = v4_ty_alias_target_type_for_sig(ty_id, sig_id)
    if alias_name == "" or alias_target == "" or alias_target == v4_ty_unknown {
        give back
    }

    pilot cycle_path = v4_ty_alias_cycle_path_in_type(ty_id, alias_target, alias_name)
    if cycle_path != "" {
        v4_ty_add_diag(ty_id, "Yuuko alias loop: alias " + alias_name + " expands forever via " + v4_ty_alias_cycle_chain_display(cycle_path))
    }
}

task v4_ty_validate_alias_cycles(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_alias_sig {
            v4_ty_validate_alias_signature_cycle(ty_id, sig_id)
        }
        sig_id += 1
    }
}

task v4_ty_validate_signature_lifetimes(ty_id: int, sig_id: int) -> void {
    v4_ty_validate_signature_generic_names(ty_id, sig_id)

    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind == v4_ty_task_sig or sig_kind == v4_ty_extern_sig {
        v4_ty_validate_task_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_shape_sig {
        v4_ty_validate_shape_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_route_sig {
        v4_ty_validate_route_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_doctrine_sig {
        v4_ty_validate_doctrine_signature_lifetimes(ty_id, sig_id)
    } else if sig_kind == v4_ty_alias_sig {
        v4_ty_validate_alias_signature_lifetimes(ty_id, sig_id)
    }
}

task v4_ty_validate_lifetime_contracts(ty_id: int) -> void {
    pilot sig_id = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_id >= sig_count {
        v4_ty_validate_signature_lifetimes(ty_id, sig_id)
        sig_id += 1
    }
}

task v4_ty_type_depth_after_char(depth: int, ch: word) -> int {
    pilot next_depth = depth
    if ch == "(" or ch == "[" or ch == "{" or ch == "<" {
        next_depth += 1
    } else if ch == ")" or ch == "]" or ch == "}" or ch == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_ty_find_top_level_type_char(type_text: word, wanted: word, start_pos: int, end_pos: int) -> int {
    pilot depth = 0
    pilot idx = start_pos
    repeat until idx >= end_pos {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == wanted {
            give back idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back 0 - 1
}

task v4_ty_is_generic_instance_type(type_text: word) -> bool {
    if type_text.length() < 4 {
        give back false
    }
    if type_text.char_at(type_text.length() - 1) != ">" {
        give back false
    }
    give back v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1) > 0
}

task v4_ty_generic_base_name(type_text: word) -> word {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" {
        give back v4_ty_unknown
    }
    give back v4_slice(type_text, 0, open_pos)
}

task v4_ty_generic_arg_count(type_text: word) -> int {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" {
        give back 0
    }
    if open_pos + 1 >= type_text.length() - 1 {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= type_text.length() - 1 {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_generic_arg(type_text: word, arg_id: int) -> word {
    pilot open_pos = v4_ty_find_top_level_type_char(type_text, "<", 0, type_text.length() - 1)
    if open_pos <= 0 or type_text.char_at(type_text.length() - 1) != ">" or arg_id < 0 {
        give back v4_ty_unknown
    }
    if open_pos + 1 >= type_text.length() - 1 {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= type_text.length() - 1 {
        pilot ch = type_text.char_at(idx)
        if depth == 0 and ch == "," {
            if current == arg_id {
                give back v4_slice(type_text, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == arg_id and segment_start < type_text.length() - 1 {
        give back v4_slice(type_text, segment_start, type_text.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_generic_env_lookup(env: word, name: word) -> word {
    if env == "" or name == "" {
        give back ""
    }

    pilot segment_start = 0
    repeat until segment_start >= env.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(env, "|", segment_start, env.length())
        if segment_end < 0 {
            segment_end = env.length()
        }
        pilot eq_pos = v4_ty_find_top_level_type_char(env, "=", segment_start, segment_end)
        if eq_pos > segment_start {
            if v4_slice(env, segment_start, eq_pos) == name {
                give back v4_slice(env, eq_pos + 1, segment_end)
            }
        }
        segment_start = segment_end + 1
    }
    give back ""
}

task v4_ty_generic_env_bind(env: word, name: word, actual_ty: word) -> word {
    pilot existing = v4_ty_generic_env_lookup(env, name)
    if existing != "" {
        if existing == actual_ty {
            give back env
        }
        give back v4_ty_generic_env_fail
    }

    if env == "" {
        give back name + "=" + actual_ty
    }
    give back env + "|" + name + "=" + actual_ty
}

task v4_ty_match_signature_type_env(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word, env: word) -> word {
    if env == v4_ty_generic_env_fail {
        give back env
    }
    if not v4_ty_is_known(expected_ty) or not v4_ty_is_known(actual_ty) {
        give back env
    }
    if expected_ty == actual_ty {
        give back env
    }
    if v4_ty_signature_declares_lifetime_name(ty_id, sig_id, expected_ty) {
        give back env
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, expected_ty) {
        give back v4_ty_generic_env_bind(env, expected_ty, actual_ty)
    }
    if v4_ty_is_numeric(expected_ty) and v4_ty_is_numeric(actual_ty) {
        give back env
    }
    if v4_ty_is_generic_instance_type(expected_ty) and v4_ty_is_generic_instance_type(actual_ty) {
        if v4_ty_generic_base_name(expected_ty) != v4_ty_generic_base_name(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        if v4_ty_generic_arg_count(expected_ty) != v4_ty_generic_arg_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(expected_ty)
        repeat until arg_idx >= arg_count {
            next_env = v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_generic_arg(expected_ty, arg_idx), v4_ty_generic_arg(actual_ty, arg_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            arg_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_tuple_type(expected_ty) and v4_ty_is_tuple_type(actual_ty) {
        if v4_ty_tuple_slot_count(expected_ty) != v4_ty_tuple_slot_count(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        pilot next_env = env
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(expected_ty)
        repeat until slot_idx >= slot_count {
            next_env = v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_tuple_slot_type(expected_ty, slot_idx), v4_ty_tuple_slot_type(actual_ty, slot_idx), next_env)
            if next_env == v4_ty_generic_env_fail {
                give back next_env
            }
            slot_idx += 1
        }
        give back next_env
    }
    if v4_ty_is_fixed_array_type(expected_ty) and v4_ty_is_fixed_array_type(actual_ty) {
        if v4_ty_fixed_array_length_text(expected_ty) != v4_ty_fixed_array_length_text(actual_ty) {
            give back v4_ty_generic_env_fail
        }
        give back v4_ty_match_signature_type_env(ty_id, sig_id, v4_ty_fixed_array_element_type(expected_ty), v4_ty_fixed_array_element_type(actual_ty), env)
    }
    if v4_ty_types_compatible(expected_ty, actual_ty) {
        give back env
    }
    give back v4_ty_generic_env_fail
}

task v4_ty_types_compatible_in_signature(ty_id: int, sig_id: int, expected_ty: word, actual_ty: word) -> bool {
    give back v4_ty_match_signature_type_env(ty_id, sig_id, expected_ty, actual_ty, "") != v4_ty_generic_env_fail
}

task v4_ty_apply_generic_env(type_text: word, env: word) -> word {
    if env == "" or env == v4_ty_generic_env_fail or type_text == "" or type_text == v4_ty_unknown {
        give back type_text
    }

    pilot mapped = v4_ty_generic_env_lookup(env, type_text)
    if mapped != "" {
        give back mapped
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot out = v4_ty_generic_base_name(type_text) + "<"
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if arg_idx > 0 {
                out = out + ","
            }
            out = out + v4_ty_apply_generic_env(v4_ty_generic_arg(type_text, arg_idx), env)
            arg_idx += 1
        }
        out = out + ">"
        give back out
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot out = "("
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if slot_idx > 0 {
                out = out + ","
            }
            out = out + v4_ty_apply_generic_env(v4_ty_tuple_slot_type(type_text, slot_idx), env)
            slot_idx += 1
        }
        out = out + ")"
        give back out
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back "[" + v4_ty_apply_generic_env(v4_ty_fixed_array_element_type(type_text), env) + ";" + v4_ty_fixed_array_length_text(type_text) + "]"
    }
    give back type_text
}

task v4_ty_type_mentions_signature_generics(ty_id: int, sig_id: int, type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }
    if v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text) {
        give back true
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg_idx = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_idx >= arg_count {
            if v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_generic_arg(type_text, arg_idx)) {
                give back true
            }
            arg_idx += 1
        }
        give back false
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_idx = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_idx >= slot_count {
            if v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_tuple_slot_type(type_text, slot_idx)) {
                give back true
            }
            slot_idx += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_type_mentions_signature_generics(ty_id, sig_id, v4_ty_fixed_array_element_type(type_text))
    }
    give back false
}

task v4_ty_signature_generic_env_for_instance(ty_id: int, sig_id: int, instance_ty: word) -> word {
    if not v4_ty_is_generic_instance_type(instance_ty) {
        give back ""
    }
    if v4_ty_signature_generic_count(ty_id, sig_id) != v4_ty_generic_arg_count(instance_ty) {
        give back ""
    }

    pilot env = ""
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            env = v4_ty_generic_env_bind(env, v4_ty_signature_generic_name(ty_id, sig_id, generic_idx), v4_ty_generic_arg(instance_ty, generic_idx))
            if env == v4_ty_generic_env_fail {
                give back ""
            }
        }
        generic_idx += 1
    }
    give back env
}

task v4_ty_signature_generic_env_complete(ty_id: int, sig_id: int, env: word) -> bool {
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            if v4_ty_generic_env_lookup(env, v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)) == "" {
                give back false
            }
        }
        generic_idx += 1
    }
    give back true
}

task v4_ty_signature_instance_type_for_env(ty_id: int, sig_id: int, env: word) -> word {
    pilot name = v4_ty_signature_name(ty_id, sig_id)
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    if generic_count <= 0 {
        give back name
    }

    pilot out = name + "<"
    pilot generic_idx = 0
    repeat until generic_idx >= generic_count {
        if generic_idx > 0 {
            out = out + ","
        }
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)
        pilot actual_ty = v4_ty_generic_env_lookup(env, generic_name)
        if actual_ty == "" {
            actual_ty = generic_name
        }
        out = out + actual_ty
        generic_idx += 1
    }
    give back out + ">"
}

task v4_ty_apply_signature_generics(ty_id: int, sig_id: int, instance_ty: word, member_ty: word) -> word {
    give back v4_ty_apply_generic_env(member_ty, v4_ty_signature_generic_env_for_instance(ty_id, sig_id, instance_ty))
}

task v4_ty_signature_return_type_for_env(ty_id: int, sig_id: int, env: word) -> word {
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_generic_env(v4_ty_signature_return_type(ty_id, sig_id), env))
}

task v4_ty_list_element_type(container_ty: word) -> word {
    if container_ty.length() >= 6 {
        if container_ty.char_at(0) == "L" and container_ty.char_at(1) == "i" and container_ty.char_at(2) == "s" and container_ty.char_at(3) == "t" and container_ty.char_at(4) == "<" and container_ty.char_at(container_ty.length() - 1) == ">" {
            give back v4_slice(container_ty, 5, container_ty.length() - 1)
        }
    }
    give back v4_ty_unknown
}

task v4_ty_is_maybe_type(container_ty: word) -> bool {
    if container_ty.length() < 8 {
        give back false
    }
    if container_ty.char_at(0) != "m" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "y" or container_ty.char_at(3) != "b" or container_ty.char_at(4) != "e" or container_ty.char_at(5) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back false
    }
    give back true
}

task v4_ty_maybe_value_type(container_ty: word) -> word {
    if v4_ty_is_maybe_type(container_ty) {
        give back v4_slice(container_ty, 6, container_ty.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_is_result_type(container_ty: word) -> bool {
    if container_ty.length() < 11 {
        give back false
    }
    if container_ty.char_at(0) != "r" or container_ty.char_at(1) != "e" or container_ty.char_at(2) != "s" or container_ty.char_at(3) != "u" or container_ty.char_at(4) != "l" or container_ty.char_at(5) != "t" or container_ty.char_at(6) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back false
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    give back comma > 7
}

task v4_ty_result_ok_type(container_ty: word) -> word {
    if not v4_ty_is_result_type(container_ty) {
        give back v4_ty_unknown
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    if comma <= 7 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, 7, comma)
}

task v4_ty_result_err_type(container_ty: word) -> word {
    if not v4_ty_is_result_type(container_ty) {
        give back v4_ty_unknown
    }
    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 7, container_ty.length() - 1)
    if comma < 0 or comma + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, comma + 1, container_ty.length() - 1)
}

task v4_ty_maybe_type(inner_ty: word) -> word {
    give back "maybe<" + inner_ty + ">"
}

task v4_ty_result_type(ok_ty: word, err_ty: word) -> word {
    give back "result<" + ok_ty + "," + err_ty + ">"
}

task v4_ty_is_tuple_type(tuple_ty: word) -> bool {
    if tuple_ty.length() < 5 {
        give back false
    }
    if tuple_ty.char_at(0) != "(" or tuple_ty.char_at(tuple_ty.length() - 1) != ")" {
        give back false
    }
    give back v4_ty_find_top_level_type_char(tuple_ty, ",", 1, tuple_ty.length() - 1) > 1
}

task v4_ty_tuple_slot_count(tuple_ty: word) -> int {
    if not v4_ty_is_tuple_type(tuple_ty) {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= tuple_ty.length() - 1 {
        pilot ch = tuple_ty.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_ty_tuple_slot_type(tuple_ty: word, slot_id: int) -> word {
    if not v4_ty_is_tuple_type(tuple_ty) or slot_id < 0 {
        give back v4_ty_unknown
    }

    pilot current = 0
    pilot segment_start = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= tuple_ty.length() - 1 {
        pilot ch = tuple_ty.char_at(idx)
        if depth == 0 and ch == "," {
            if current == slot_id {
                give back v4_slice(tuple_ty, segment_start, idx)
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == slot_id and segment_start < tuple_ty.length() - 1 {
        give back v4_slice(tuple_ty, segment_start, tuple_ty.length() - 1)
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_array_separator(container_ty: word) -> int {
    if container_ty.length() < 4 {
        give back 0 - 1
    }
    if container_ty.char_at(0) != "[" or container_ty.char_at(container_ty.length() - 1) != "]" {
        give back 0 - 1
    }
    give back v4_ty_find_top_level_type_char(container_ty, ";", 1, container_ty.length() - 1)
}

task v4_ty_is_fixed_array_type(container_ty: word) -> bool {
    give back v4_ty_fixed_array_separator(container_ty) > 1
}

task v4_ty_fixed_array_element_type(container_ty: word) -> word {
    pilot separator = v4_ty_fixed_array_separator(container_ty)
    if separator > 1 {
        give back v4_slice(container_ty, 1, separator)
    }
    give back v4_ty_unknown
}

task v4_ty_fixed_array_length_text(container_ty: word) -> word {
    pilot separator = v4_ty_fixed_array_separator(container_ty)
    if separator < 0 or separator + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, separator + 1, container_ty.length() - 1)
}

task v4_ty_map_key_type(container_ty: word) -> word {
    if container_ty.length() < 7 {
        give back v4_ty_unknown
    }
    if container_ty.char_at(0) != "M" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "p" or container_ty.char_at(3) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back v4_ty_unknown
    }

    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 4, container_ty.length() - 1)
    if comma <= 4 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, 4, comma)
}

task v4_ty_map_value_type(container_ty: word) -> word {
    if container_ty.length() < 7 {
        give back v4_ty_unknown
    }
    if container_ty.char_at(0) != "M" or container_ty.char_at(1) != "a" or container_ty.char_at(2) != "p" or container_ty.char_at(3) != "<" or container_ty.char_at(container_ty.length() - 1) != ">" {
        give back v4_ty_unknown
    }

    pilot comma = v4_ty_find_top_level_type_char(container_ty, ",", 4, container_ty.length() - 1)
    if comma < 0 or comma + 1 >= container_ty.length() - 1 {
        give back v4_ty_unknown
    }
    give back v4_slice(container_ty, comma + 1, container_ty.length() - 1)
}

task v4_ty_index_element_type(container_ty: word) -> word {
    pilot list_element_ty = v4_ty_list_element_type(container_ty)
    if v4_ty_is_known(list_element_ty) {
        give back list_element_ty
    }

    pilot map_value_ty = v4_ty_map_value_type(container_ty)
    if v4_ty_is_known(map_value_ty) {
        give back map_value_ty
    }

    pilot array_element_ty = v4_ty_fixed_array_element_type(container_ty)
    if v4_ty_is_known(array_element_ty) {
        give back array_element_ty
    }

    give back v4_ty_unknown
}

task v4_ty_add_signature(ty_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> int {
    pilot sig_id = array_len(v4_ty_defs_handle(ty_id))
    array_push(v4_ty_defs_handle(ty_id), def_id)
    array_push(v4_ty_kinds_handle(ty_id), sig_kind)
    array_push(v4_ty_names_handle(ty_id), sig_name)
    array_push(v4_ty_displays_handle(ty_id), sig_display)
    array_push(v4_ty_hir_items_handle(ty_id), word_from_int(hir_item))
    give back sig_id
}

task v4_ty_lower_resolve(file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    pilot ty_id = v4_ty_file_new(file_id, resolve_id)
    v4_ty_copy_resolve_diags(ty_id, resolve_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)

    pilot symbol_idx = 0
    pilot symbol_count = v4_resolve_symbol_count(resolve_id)
    repeat until symbol_idx >= symbol_count {
        pilot symbol_kind = v4_resolve_symbol_kind(resolve_id, symbol_idx)
        pilot symbol_name = v4_resolve_symbol_name(resolve_id, symbol_idx)
        pilot symbol_def = v4_resolve_symbol_def(resolve_id, symbol_idx)
        pilot hir_item = v4_resolve_symbol_hir_item(resolve_id, symbol_idx)
        pilot sig_kind = v4_ty_kind_for_symbol(symbol_kind)
        pilot sig_display = v4_ty_display_for_hir_item(symbol_kind, symbol_name, symbol_def, hir_id, hir_item)
        v4_ty_add_signature(ty_id, symbol_def, sig_kind, symbol_name, sig_display, hir_item)
        symbol_idx += 1
    }

    v4_ty_validate_lifetime_contracts(ty_id)
    v4_ty_validate_alias_cycles(ty_id)
    give back ty_id
}

task v4_ty_lookup_signature(ty_id: int, def_id: word) -> int {
    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        if v4_ty_signature_def(ty_id, sig_idx) == def_id {
            give back sig_idx
        }
        sig_idx += 1
    }
    give back 0 - 1
}

task v4_ty_signature_of(ty_id: int, def_id: word) -> word {
    pilot sig_id = v4_ty_lookup_signature(ty_id, def_id)
    if sig_id < 0 {
        give back ""
    }
    give back v4_ty_signature_display(ty_id, sig_id)
}

task v4_ty_summary(ty_id: int) -> word {
    pilot summary = "ty-ok ty=" + word_from_int(ty_id)
    summary = summary + " signatures=" + word_from_int(v4_ty_signature_count(ty_id))
    summary = summary + " diagnostics=" + word_from_int(v4_ty_diag_count(ty_id))
    give back summary
}

task v4_ty_snapshot_escape(value: word) -> word {
    give back v4_resolve_snapshot_escape(value)
}

task v4_ty_snapshot_unescape(value: word) -> word {
    give back v4_resolve_snapshot_unescape(value)
}

task v4_ty_snapshot_line_count(payload: word) -> int {
    give back v4_resolve_snapshot_line_count(payload)
}

task v4_ty_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_resolve_snapshot_line(payload, wanted)
}

task v4_ty_snapshot_field_count(line: word) -> int {
    give back v4_resolve_snapshot_field_count(line)
}

task v4_ty_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_resolve_snapshot_field_raw(line, wanted)
}

task v4_ty_snapshot_field(line: word, wanted: int) -> word {
    give back v4_resolve_snapshot_field(line, wanted)
}

task v4_ty_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_resolve_snapshot_key_value(line, wanted_key)
}

task v4_ty_snapshot_signature_total() -> int {
    v4_ty_init()
    pilot total = 0
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        total += v4_ty_signature_count(ty_id)
        ty_id += 1
    }
    give back total
}

task v4_ty_snapshot_diag_total() -> int {
    v4_ty_init()
    pilot total = 0
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        total += v4_ty_diag_count(ty_id)
        ty_id += 1
    }
    give back total
}

task v4_ty_snapshot_summary() -> word {
    pilot summary = "ty-snapshot"
    summary = summary + " format=" + v4_ty_snapshot_format
    summary = summary + " files=" + word_from_int(v4_ty_file_count())
    summary = summary + " signatures=" + word_from_int(v4_ty_snapshot_signature_total())
    summary = summary + " diagnostics=" + word_from_int(v4_ty_snapshot_diag_total())
    give back summary
}

task v4_ty_snapshot_header() -> word {
    pilot out = "ty-snapshot"
    out = out + "|format=" + v4_ty_snapshot_format
    out = out + "|files=" + word_from_int(v4_ty_file_count())
    out = out + "|signatures=" + word_from_int(v4_ty_snapshot_signature_total())
    out = out + "|diagnostics=" + word_from_int(v4_ty_snapshot_diag_total())
    give back out
}

task v4_ty_snapshot_file_line(ty_id: int) -> word {
    pilot out = "ty"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(v4_ty_file_id(ty_id))
    out = out + "|" + word_from_int(v4_ty_resolve_id(ty_id))
    out = out + "|" + word_from_int(v4_ty_signature_count(ty_id))
    out = out + "|" + word_from_int(v4_ty_diag_count(ty_id))
    give back out
}

task v4_ty_snapshot_signature_line(ty_id: int, sig_id: int) -> word {
    pilot out = "signature"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(sig_id)
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_def(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_kind(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_name(ty_id, sig_id))
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_signature_display(ty_id, sig_id))
    out = out + "|" + word_from_int(v4_ty_signature_hir_item(ty_id, sig_id))
    give back out
}

task v4_ty_snapshot_diag_line(ty_id: int, diag_id: int) -> word {
    pilot out = "ty-diag"
    out = out + "|" + word_from_int(ty_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_ty_snapshot_escape(v4_ty_diag(ty_id, diag_id))
    give back out
}

task v4_ty_snapshot() -> word {
    v4_ty_init()
    pilot out = v4_ty_snapshot_header()
    pilot ty_id = 0
    repeat until ty_id >= v4_ty_file_count() {
        out = out + "\n" + v4_ty_snapshot_file_line(ty_id)

        pilot sig_id = 0
        pilot sig_count = v4_ty_signature_count(ty_id)
        repeat until sig_id >= sig_count {
            out = out + "\n" + v4_ty_snapshot_signature_line(ty_id, sig_id)
            sig_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_ty_diag_count(ty_id)
        repeat until diag_id >= diag_count {
            out = out + "\n" + v4_ty_snapshot_diag_line(ty_id, diag_id)
            diag_id += 1
        }
        ty_id += 1
    }
    out = out + "\nend|" + v4_ty_snapshot_format
    give back out
}

task v4_ty_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "ty-snapshot" {
        give back 5
    }
    if kind == "ty" {
        give back 6
    }
    if kind == "signature" {
        give back 8
    }
    if kind == "ty-diag" {
        give back 4
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_ty_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_ty_snapshot_field_raw(line, 0)
    pilot expected = v4_ty_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_ty_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_ty_snapshot_validate(payload: word) -> word {
    pilot lines = v4_ty_snapshot_line_count(payload)
    pilot files = 0
    pilot signatures = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_ty_snapshot_field_raw(line, 0)
            if v4_ty_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "ty-snapshot" {
                saw_header += 1
                format = v4_ty_snapshot_key_value(line, "format")
                if format != v4_ty_snapshot_format {
                    malformed += 1
                }
            } else if kind == "ty" {
                files += 1
            } else if kind == "signature" {
                signatures += 1
            } else if kind == "ty-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_ty_snapshot_field(line, 1) != v4_ty_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }

    pilot out = "ty-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " signatures=" + word_from_int(signatures)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_ty_restore_file_slot(ty_id: int, file_id: int, resolve_id: int) -> int {
    v4_ty_init()
    repeat until array_len(v4_ty_files) > ty_id {
        array_push(v4_ty_files, "0")
        array_push(v4_ty_resolves, "0")
        array_push(v4_ty_defs, word_from_int(array_new()))
        array_push(v4_ty_kinds, word_from_int(array_new()))
        array_push(v4_ty_names, word_from_int(array_new()))
        array_push(v4_ty_displays, word_from_int(array_new()))
        array_push(v4_ty_hir_items, word_from_int(array_new()))
        array_push(v4_ty_diags, word_from_int(array_new()))
    }

    array_set(v4_ty_files, ty_id, word_from_int(file_id))
    array_set(v4_ty_resolves, ty_id, word_from_int(resolve_id))
    array_set(v4_ty_defs, ty_id, word_from_int(array_new()))
    array_set(v4_ty_kinds, ty_id, word_from_int(array_new()))
    array_set(v4_ty_names, ty_id, word_from_int(array_new()))
    array_set(v4_ty_displays, ty_id, word_from_int(array_new()))
    array_set(v4_ty_hir_items, ty_id, word_from_int(array_new()))
    array_set(v4_ty_diags, ty_id, word_from_int(array_new()))
    give back ty_id
}

task v4_ty_restore_signature_slot(ty_id: int, sig_id: int, def_id: word, sig_kind: word, sig_name: word, sig_display: word, hir_item: int) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    repeat until v4_ty_signature_count(ty_id) > sig_id {
        array_push(v4_ty_defs_handle(ty_id), "")
        array_push(v4_ty_kinds_handle(ty_id), "")
        array_push(v4_ty_names_handle(ty_id), "")
        array_push(v4_ty_displays_handle(ty_id), "")
        array_push(v4_ty_hir_items_handle(ty_id), word_from_int(0 - 1))
    }
    array_set(v4_ty_defs_handle(ty_id), sig_id, def_id)
    array_set(v4_ty_kinds_handle(ty_id), sig_id, sig_kind)
    array_set(v4_ty_names_handle(ty_id), sig_id, sig_name)
    array_set(v4_ty_displays_handle(ty_id), sig_id, sig_display)
    array_set(v4_ty_hir_items_handle(ty_id), sig_id, word_from_int(hir_item))
    give back 1
}

task v4_ty_restore_diag_slot(ty_id: int, diag_id: int, diag: word) -> int {
    if v4_ty_file_exists(ty_id) == false {
        give back 0
    }
    repeat until array_len(v4_ty_diags_handle(ty_id)) > diag_id {
        array_push(v4_ty_diags_handle(ty_id), "")
    }
    array_set(v4_ty_diags_handle(ty_id), diag_id, diag)
    give back 1
}

task v4_ty_snapshot_restore_file_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "ty" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot resolve_id = word_to_int(v4_ty_snapshot_field_raw(line, 3))
    v4_ty_restore_file_slot(ty_id, file_id, resolve_id)
    give back 1
}

task v4_ty_snapshot_restore_signature_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "signature" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot sig_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot def_id = v4_ty_snapshot_field(line, 3)
    pilot sig_kind = v4_ty_snapshot_field(line, 4)
    pilot sig_name = v4_ty_snapshot_field(line, 5)
    pilot sig_display = v4_ty_snapshot_field(line, 6)
    pilot hir_item = word_to_int(v4_ty_snapshot_field_raw(line, 7))
    give back v4_ty_restore_signature_slot(ty_id, sig_id, def_id, sig_kind, sig_name, sig_display, hir_item)
}

task v4_ty_snapshot_restore_diag_line(line: word) -> int {
    if v4_ty_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_ty_snapshot_field_raw(line, 0) != "ty-diag" {
        give back 0
    }
    pilot ty_id = word_to_int(v4_ty_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_ty_snapshot_field_raw(line, 2))
    pilot diag = v4_ty_snapshot_field(line, 3)
    give back v4_ty_restore_diag_slot(ty_id, diag_id, diag)
}

task v4_ty_snapshot_restore(payload: word) -> word {
    pilot validation = v4_ty_snapshot_validate(payload)
    if validation.starts_with("ty-snapshot-import ok=1") == false {
        give back "ty-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_files = 0
    pilot restored_signatures = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_ty_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_ty_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_ty_snapshot_field_raw(line, 0)
            if kind == "ty" {
                restored_files += v4_ty_snapshot_restore_file_line(line)
            } else if kind == "signature" {
                restored_signatures += v4_ty_snapshot_restore_signature_line(line)
            } else if kind == "ty-diag" {
                restored_diagnostics += v4_ty_snapshot_restore_diag_line(line)
            } else if kind != "ty-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "ty-snapshot-restore ok=1"
    out = out + " files=" + word_from_int(restored_files)
    out = out + " signatures=" + word_from_int(restored_signatures)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-files=" + word_from_int(v4_ty_file_count())
    give back out
}
