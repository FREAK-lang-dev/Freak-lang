-- ===================================================================
-- freak_resolve - V4 top-level semantic index prototype
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_hir.
-- This first resolver pass builds a file-local item index from HIR,
-- detects duplicate named definitions, and exposes name/def lookup for
-- future LSP hover and type inference queries.

pilot v4_resolve_snapshot_format = "freak-resolve-snapshot-v1"
pilot v4_resolve_extern_member_marker = "::extern-member#"

pilot v4_resolve_files = 0
pilot v4_resolve_hirs = 0
pilot v4_resolve_names = 0
pilot v4_resolve_kinds = 0
pilot v4_resolve_defs = 0
pilot v4_resolve_hir_items = 0
pilot v4_resolve_diags = 0
pilot v4_resolve_ready = 0

task v4_resolve_init() -> void {
    if v4_resolve_ready == 0 {
        v4_resolve_files = array_new()
        v4_resolve_hirs = array_new()
        v4_resolve_names = array_new()
        v4_resolve_kinds = array_new()
        v4_resolve_defs = array_new()
        v4_resolve_hir_items = array_new()
        v4_resolve_diags = array_new()
        v4_resolve_ready = 1
    }
}

task v4_resolve_new(file_id: int, hir_id: int) -> int {
    v4_resolve_init()
    pilot resolve_id = array_len(v4_resolve_files)
    array_push(v4_resolve_files, word_from_int(file_id))
    array_push(v4_resolve_hirs, word_from_int(hir_id))
    array_push(v4_resolve_names, word_from_int(array_new()))
    array_push(v4_resolve_kinds, word_from_int(array_new()))
    array_push(v4_resolve_defs, word_from_int(array_new()))
    array_push(v4_resolve_hir_items, word_from_int(array_new()))
    array_push(v4_resolve_diags, word_from_int(array_new()))
    give back resolve_id
}

task v4_resolve_names_handle(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_names, resolve_id))
}

task v4_resolve_kinds_handle(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_kinds, resolve_id))
}

task v4_resolve_defs_handle(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_defs, resolve_id))
}

task v4_resolve_hir_items_handle(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_hir_items, resolve_id))
}

task v4_resolve_diags_handle(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_diags, resolve_id))
}

task v4_resolve_file_id(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_files, resolve_id))
}

task v4_resolve_hir_id(resolve_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_hirs, resolve_id))
}

task v4_resolve_index_count() -> int {
    v4_resolve_init()
    give back array_len(v4_resolve_files)
}

task v4_resolve_exists(resolve_id: int) -> bool {
    v4_resolve_init()
    if resolve_id < 0 {
        give back false
    }
    if resolve_id >= array_len(v4_resolve_files) {
        give back false
    }
    give back true
}

task v4_resolve_symbol_count(resolve_id: int) -> int {
    give back array_len(v4_resolve_defs_handle(resolve_id))
}

task v4_resolve_diag_count(resolve_id: int) -> int {
    give back array_len(v4_resolve_diags_handle(resolve_id))
}

task v4_resolve_symbol_name(resolve_id: int, symbol_id: int) -> word {
    give back array_get(v4_resolve_names_handle(resolve_id), symbol_id)
}

task v4_resolve_symbol_kind(resolve_id: int, symbol_id: int) -> word {
    give back array_get(v4_resolve_kinds_handle(resolve_id), symbol_id)
}

task v4_resolve_symbol_def(resolve_id: int, symbol_id: int) -> word {
    give back array_get(v4_resolve_defs_handle(resolve_id), symbol_id)
}

task v4_resolve_symbol_hir_item(resolve_id: int, symbol_id: int) -> int {
    give back word_to_int(array_get(v4_resolve_hir_items_handle(resolve_id), symbol_id))
}

task v4_resolve_diag(resolve_id: int, diag_id: int) -> word {
    give back array_get(v4_resolve_diags_handle(resolve_id), diag_id)
}

task v4_resolve_add_diag(resolve_id: int, diag: word) -> void {
    array_push(v4_resolve_diags_handle(resolve_id), diag)
}

task v4_resolve_copy_hir_diags(resolve_id: int, hir_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_hir_diag_count(hir_id)
    repeat until diag_idx >= diag_count {
        v4_resolve_add_diag(resolve_id, v4_hir_diag(hir_id, diag_idx))
        diag_idx += 1
    }
}

task v4_resolve_is_definition_kind(item_kind: word) -> bool {
    if item_kind == v4_hir_task { give back true }
    if item_kind == v4_hir_const { give back true }
    if item_kind == v4_hir_shape { give back true }
    if item_kind == v4_hir_route { give back true }
    if item_kind == v4_hir_alias { give back true }
    if item_kind == v4_hir_doctrine { give back true }
    if item_kind == v4_hir_extern { give back true }
    give back false
}

task v4_resolve_is_indexable_kind(item_kind: word) -> bool {
    if item_kind == v4_hir_attribute { give back true }
    if item_kind == v4_hir_import { give back true }
    if item_kind == v4_hir_impl { give back true }
    give back v4_resolve_is_definition_kind(item_kind)
}

task v4_resolve_requires_unique_name(item_kind: word) -> bool {
    if item_kind == v4_hir_extern {
        give back false
    }
    give back v4_resolve_is_definition_kind(item_kind)
}

task v4_resolve_lookup_symbol(resolve_id: int, lookup_name: word, lookup_kind: word) -> int {
    pilot idx = 0
    pilot count = v4_resolve_symbol_count(resolve_id)
    repeat until idx >= count {
        pilot symbol_name: word = array_get(v4_resolve_names_handle(resolve_id), idx)
        pilot symbol_kind: word = array_get(v4_resolve_kinds_handle(resolve_id), idx)
        if symbol_name == lookup_name {
            if symbol_kind == lookup_kind {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_resolve_lookup_any(resolve_id: int, lookup_name: word) -> int {
    pilot idx = 0
    pilot count = v4_resolve_symbol_count(resolve_id)
    repeat until idx >= count {
        pilot symbol_name: word = array_get(v4_resolve_names_handle(resolve_id), idx)
        if symbol_name == lookup_name {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_resolve_path_scope_separator(path: word) -> int {
    pilot idx = 0
    repeat until idx + 1 >= path.length() {
        if path.char_at(idx) == ":" and path.char_at(idx + 1) == ":" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_resolve_path_left(path: word) -> word {
    pilot sep = v4_resolve_path_scope_separator(path)
    if sep < 0 {
        give back ""
    }
    give back v4_slice(path, 0, sep)
}

task v4_resolve_path_right(path: word) -> word {
    pilot sep = v4_resolve_path_scope_separator(path)
    if sep < 0 or sep + 2 > path.length() {
        give back ""
    }
    give back v4_slice(path, sep + 2, path.length())
}

task v4_resolve_path_starts_with(path: word, prefix: word) -> bool {
    if prefix == "" {
        give back false
    }
    if prefix.length() > path.length() {
        give back false
    }
    give back v4_slice(path, 0, prefix.length()) == prefix
}

task v4_resolve_glob_import_base(import_path: word) -> word {
    if import_path.length() < 3 {
        give back ""
    }
    if v4_slice(import_path, import_path.length() - 3, import_path.length()) != "::*" {
        give back ""
    }
    give back v4_slice(import_path, 0, import_path.length() - 3)
}

task v4_resolve_glob_import_leaf(base_path: word, candidate_name: word) -> word {
    if base_path == "" or candidate_name == "" {
        give back ""
    }
    pilot prefix = base_path + "::"
    if v4_resolve_path_starts_with(candidate_name, prefix) == false {
        give back ""
    }
    if prefix.length() >= candidate_name.length() {
        give back ""
    }
    pilot leaf = v4_slice(candidate_name, prefix.length(), candidate_name.length())
    if v4_resolve_path_scope_separator(leaf) >= 0 {
        give back ""
    }
    give back leaf
}

task v4_resolve_can_glob_import_kind(symbol_kind: word) -> bool {
    if symbol_kind == v4_hir_task { give back true }
    if symbol_kind == v4_hir_const { give back true }
    if symbol_kind == v4_hir_shape { give back true }
    if symbol_kind == v4_hir_route { give back true }
    if symbol_kind == v4_hir_alias { give back true }
    if symbol_kind == v4_hir_doctrine { give back true }
    if symbol_kind == v4_hir_extern { give back true }
    give back false
}

task v4_resolve_add_symbol(resolve_id: int, item_name: word, item_kind: word, def_id: word, hir_item: int) -> int {
    pilot symbol_id = array_len(v4_resolve_defs_handle(resolve_id))
    array_push(v4_resolve_names_handle(resolve_id), item_name)
    array_push(v4_resolve_kinds_handle(resolve_id), item_kind)
    array_push(v4_resolve_defs_handle(resolve_id), def_id)
    array_push(v4_resolve_hir_items_handle(resolve_id), word_from_int(hir_item))
    give back symbol_id
}

task v4_resolve_extern_member_def(extern_def: word, member_id: int) -> word {
    give back extern_def + v4_resolve_extern_member_marker + word_from_int(member_id)
}

task v4_resolve_extern_member_marker_index(def_id: word) -> int {
    pilot marker_len = v4_resolve_extern_member_marker.length()
    pilot def_len = def_id.length()
    pilot idx = 0
    repeat until idx + marker_len > def_len {
        pilot marker_idx = 0
        pilot matches = true
        repeat until marker_idx >= marker_len {
            if def_id.char_at(idx + marker_idx) != v4_resolve_extern_member_marker.char_at(marker_idx) {
                matches = false
                marker_idx = marker_len
            } else {
                marker_idx += 1
            }
        }
        if matches {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_resolve_is_extern_member_def(def_id: word) -> bool {
    give back v4_resolve_extern_member_marker_index(def_id) >= 0
}

task v4_resolve_extern_member_id_from_def(def_id: word) -> int {
    pilot marker = v4_resolve_extern_member_marker_index(def_id)
    if marker < 0 {
        give back 0 - 1
    }
    pilot start = marker + v4_resolve_extern_member_marker.length()
    if start >= def_id.length() {
        give back 0 - 1
    }
    give back word_to_int(def_id.substring(start, def_id.length()))
}

task v4_resolve_add_glob_import_symbols(resolve_id: int, hir_id: int) -> void {
    pilot item_idx = 0
    pilot item_count = v4_hir_item_count(hir_id)
    repeat until item_idx >= item_count {
        if v4_hir_item_kind(hir_id, item_idx) == v4_hir_import {
            pilot import_path = v4_hir_import_path(hir_id, item_idx)
            pilot base_path = v4_resolve_glob_import_base(import_path)
            if base_path != "" {
                pilot scan_count = v4_resolve_symbol_count(resolve_id)
                pilot scan_id = 0
                repeat until scan_id >= scan_count {
                    pilot symbol_name = v4_resolve_symbol_name(resolve_id, scan_id)
                    pilot symbol_kind = v4_resolve_symbol_kind(resolve_id, scan_id)
                    if v4_resolve_can_glob_import_kind(symbol_kind) {
                        pilot leaf = v4_resolve_glob_import_leaf(base_path, symbol_name)
                        if leaf != "" and v4_resolve_lookup_any(resolve_id, leaf) < 0 {
                            v4_resolve_add_symbol(resolve_id, leaf, symbol_kind, v4_resolve_symbol_def(resolve_id, scan_id), v4_resolve_symbol_hir_item(resolve_id, scan_id))
                        }
                    }
                    scan_id += 1
                }
            }
        }
        item_idx += 1
    }
}

task v4_resolve_lower_hir(file_id: int, hir_id: int) -> int {
    v4_resolve_init()
    pilot resolve_id = v4_resolve_new(file_id, hir_id)
    v4_resolve_copy_hir_diags(resolve_id, hir_id)

    pilot item_idx = 0
    pilot item_count = v4_hir_item_count(hir_id)
    repeat until item_idx >= item_count {
        pilot item_kind = v4_hir_item_kind(hir_id, item_idx)
        pilot item_name = v4_hir_item_name(hir_id, item_idx)
        pilot item_def = v4_hir_item_def(hir_id, item_idx)

        if v4_resolve_is_indexable_kind(item_kind) {
            if item_name != "" {
                if v4_resolve_requires_unique_name(item_kind) {
                    pilot existing = v4_resolve_lookup_symbol(resolve_id, item_name, item_kind)
                    if existing >= 0 {
                        pilot span = v4_hir_item_span(hir_id, item_idx)
                        v4_resolve_add_diag(resolve_id, v4_diag_new(v4_diag_error, span, "duplicate definition", item_name))
                    }
                }
                v4_resolve_add_symbol(resolve_id, item_name, item_kind, item_def, item_idx)
            }
        }

        if item_kind == v4_hir_extern {
            pilot member_idx = 0
            pilot member_count = v4_hir_extern_member_count(hir_id, item_idx)
            repeat until member_idx >= member_count {
                pilot member_name = v4_hir_extern_member_name(hir_id, item_idx, member_idx)
                if member_name != "" {
                    pilot existing_task = v4_resolve_lookup_symbol(resolve_id, member_name, v4_hir_task)
                    if existing_task >= 0 {
                        pilot span = v4_hir_item_span(hir_id, item_idx)
                        v4_resolve_add_diag(resolve_id, v4_diag_new(v4_diag_error, span, "duplicate definition", member_name))
                    }
                    v4_resolve_add_symbol(resolve_id, member_name, v4_hir_task, v4_resolve_extern_member_def(item_def, member_idx), item_idx)
                }
                member_idx += 1
            }
        }
        item_idx += 1
    }

    v4_resolve_add_glob_import_symbols(resolve_id, hir_id)

    give back resolve_id
}

task v4_resolve_def_for_name(resolve_id: int, lookup_name: word) -> word {
    pilot symbol_id = v4_resolve_lookup_any(resolve_id, lookup_name)
    if symbol_id < 0 {
        give back ""
    }
    give back v4_resolve_symbol_def(resolve_id, symbol_id)
}

task v4_resolve_import_path(resolve_id: int, symbol_id: int) -> word {
    if symbol_id < 0 or symbol_id >= v4_resolve_symbol_count(resolve_id) {
        give back ""
    }
    if v4_resolve_symbol_kind(resolve_id, symbol_id) != v4_hir_import {
        give back ""
    }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) == false {
        give back ""
    }
    give back v4_hir_import_path(hir_id, v4_resolve_symbol_hir_item(resolve_id, symbol_id))
}

task v4_resolve_import_alias(resolve_id: int, symbol_id: int) -> word {
    if symbol_id < 0 or symbol_id >= v4_resolve_symbol_count(resolve_id) {
        give back ""
    }
    if v4_resolve_symbol_kind(resolve_id, symbol_id) != v4_hir_import {
        give back ""
    }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) == false {
        give back ""
    }
    give back v4_hir_import_alias(hir_id, v4_resolve_symbol_hir_item(resolve_id, symbol_id))
}

task v4_resolve_symbol_target_name(resolve_id: int, symbol_id: int) -> word {
    if symbol_id < 0 or symbol_id >= v4_resolve_symbol_count(resolve_id) {
        give back ""
    }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if v4_hir_file_exists(hir_id) {
        pilot hir_item = v4_resolve_symbol_hir_item(resolve_id, symbol_id)
        if hir_item >= 0 and hir_item < v4_hir_item_count(hir_id) {
            pilot item_name = v4_hir_item_name(hir_id, hir_item)
            if item_name != "" {
                give back item_name
            }
        }
    }
    give back v4_resolve_symbol_name(resolve_id, symbol_id)
}

task v4_resolve_expand_import_name(resolve_id: int, lookup_name: word) -> word {
    if lookup_name == "" {
        give back ""
    }
    pilot direct_symbol = v4_resolve_lookup_any(resolve_id, lookup_name)
    if direct_symbol >= 0 {
        if v4_resolve_symbol_kind(resolve_id, direct_symbol) == v4_hir_task {
            pilot target_name = v4_resolve_symbol_target_name(resolve_id, direct_symbol)
            if target_name != "" {
                give back target_name
            }
        }
    }
    pilot import_symbol = v4_resolve_lookup_symbol(resolve_id, lookup_name, v4_hir_import)
    if import_symbol >= 0 {
        pilot import_path = v4_resolve_import_path(resolve_id, import_symbol)
        if import_path != "" {
            give back import_path
        }
    }

    pilot left = v4_resolve_path_left(lookup_name)
    pilot right = v4_resolve_path_right(lookup_name)
    if left != "" and right != "" {
        pilot prefix_symbol = v4_resolve_lookup_symbol(resolve_id, left, v4_hir_import)
        if prefix_symbol >= 0 {
            pilot prefix_path = v4_resolve_import_path(resolve_id, prefix_symbol)
            if prefix_path != "" {
                give back prefix_path + "::" + right
            }
        }
    }
    give back lookup_name
}

task v4_resolve_summary(resolve_id: int) -> word {
    pilot summary = "resolve-ok resolve=" + word_from_int(resolve_id)
    summary = summary + " symbols=" + word_from_int(v4_resolve_symbol_count(resolve_id))
    summary = summary + " diagnostics=" + word_from_int(v4_resolve_diag_count(resolve_id))
    give back summary
}

task v4_resolve_snapshot_escape(value: word) -> word {
    give back v4_hir_snapshot_escape(value)
}

task v4_resolve_snapshot_unescape(value: word) -> word {
    give back v4_hir_snapshot_unescape(value)
}

task v4_resolve_snapshot_line_count(payload: word) -> int {
    give back v4_hir_snapshot_line_count(payload)
}

task v4_resolve_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_hir_snapshot_line(payload, wanted)
}

task v4_resolve_snapshot_field_count(line: word) -> int {
    give back v4_hir_snapshot_field_count(line)
}

task v4_resolve_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_hir_snapshot_field_raw(line, wanted)
}

task v4_resolve_snapshot_field(line: word, wanted: int) -> word {
    give back v4_hir_snapshot_field(line, wanted)
}

task v4_resolve_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_hir_snapshot_key_value(line, wanted_key)
}

task v4_resolve_snapshot_symbol_total() -> int {
    v4_resolve_init()
    pilot total = 0
    pilot resolve_id = 0
    repeat until resolve_id >= v4_resolve_index_count() {
        total += v4_resolve_symbol_count(resolve_id)
        resolve_id += 1
    }
    give back total
}

task v4_resolve_snapshot_diag_total() -> int {
    v4_resolve_init()
    pilot total = 0
    pilot resolve_id = 0
    repeat until resolve_id >= v4_resolve_index_count() {
        total += v4_resolve_diag_count(resolve_id)
        resolve_id += 1
    }
    give back total
}

task v4_resolve_snapshot_summary() -> word {
    pilot summary = "resolve-snapshot"
    summary = summary + " format=" + v4_resolve_snapshot_format
    summary = summary + " indexes=" + word_from_int(v4_resolve_index_count())
    summary = summary + " symbols=" + word_from_int(v4_resolve_snapshot_symbol_total())
    summary = summary + " diagnostics=" + word_from_int(v4_resolve_snapshot_diag_total())
    give back summary
}

task v4_resolve_snapshot_header() -> word {
    pilot out = "resolve-snapshot"
    out = out + "|format=" + v4_resolve_snapshot_format
    out = out + "|indexes=" + word_from_int(v4_resolve_index_count())
    out = out + "|symbols=" + word_from_int(v4_resolve_snapshot_symbol_total())
    out = out + "|diagnostics=" + word_from_int(v4_resolve_snapshot_diag_total())
    give back out
}

task v4_resolve_snapshot_index_line(resolve_id: int) -> word {
    pilot out = "resolve"
    out = out + "|" + word_from_int(resolve_id)
    out = out + "|" + word_from_int(v4_resolve_file_id(resolve_id))
    out = out + "|" + word_from_int(v4_resolve_hir_id(resolve_id))
    out = out + "|" + word_from_int(v4_resolve_symbol_count(resolve_id))
    out = out + "|" + word_from_int(v4_resolve_diag_count(resolve_id))
    give back out
}

task v4_resolve_snapshot_symbol_line(resolve_id: int, symbol_id: int) -> word {
    pilot out = "symbol"
    out = out + "|" + word_from_int(resolve_id)
    out = out + "|" + word_from_int(symbol_id)
    out = out + "|" + v4_resolve_snapshot_escape(v4_resolve_symbol_name(resolve_id, symbol_id))
    out = out + "|" + v4_resolve_snapshot_escape(v4_resolve_symbol_kind(resolve_id, symbol_id))
    out = out + "|" + v4_resolve_snapshot_escape(v4_resolve_symbol_def(resolve_id, symbol_id))
    out = out + "|" + word_from_int(v4_resolve_symbol_hir_item(resolve_id, symbol_id))
    give back out
}

task v4_resolve_snapshot_diag_line(resolve_id: int, diag_id: int) -> word {
    pilot out = "resolve-diag"
    out = out + "|" + word_from_int(resolve_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_resolve_snapshot_escape(v4_resolve_diag(resolve_id, diag_id))
    give back out
}

task v4_resolve_snapshot() -> word {
    v4_resolve_init()
    pilot parts = array_new()
    array_push(parts, v4_resolve_snapshot_header())
    pilot resolve_id = 0
    repeat until resolve_id >= v4_resolve_index_count() {
        array_push(parts, "\n")
        array_push(parts, v4_resolve_snapshot_index_line(resolve_id))

        pilot symbol_id = 0
        pilot symbol_count = v4_resolve_symbol_count(resolve_id)
        repeat until symbol_id >= symbol_count {
            array_push(parts, "\n")
            array_push(parts, v4_resolve_snapshot_symbol_line(resolve_id, symbol_id))
            symbol_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_resolve_diag_count(resolve_id)
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_resolve_snapshot_diag_line(resolve_id, diag_id))
            diag_id += 1
        }
        resolve_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_resolve_snapshot_format)
    give back word_join(parts)
}

task v4_resolve_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "resolve-snapshot" {
        give back 5
    }
    if kind == "resolve" {
        give back 6
    }
    if kind == "symbol" {
        give back 7
    }
    if kind == "resolve-diag" {
        give back 4
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_resolve_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_resolve_snapshot_field_raw(line, 0)
    pilot expected = v4_resolve_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_resolve_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_resolve_snapshot_validate(payload: word) -> word {
    pilot lines = v4_resolve_snapshot_line_count(payload)
    pilot indexes = 0
    pilot symbols = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_resolve_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_resolve_snapshot_field_raw(line, 0)
            if v4_resolve_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "resolve-snapshot" {
                saw_header += 1
                format = v4_resolve_snapshot_key_value(line, "format")
                if format != v4_resolve_snapshot_format {
                    malformed += 1
                }
            } else if kind == "resolve" {
                indexes += 1
            } else if kind == "symbol" {
                symbols += 1
            } else if kind == "resolve-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_resolve_snapshot_field(line, 1) != v4_resolve_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }

    pilot out = "resolve-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " indexes=" + word_from_int(indexes)
    out = out + " symbols=" + word_from_int(symbols)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_resolve_restore_index_slot(resolve_id: int, file_id: int, hir_id: int) -> int {
    v4_resolve_init()
    repeat until array_len(v4_resolve_files) > resolve_id {
        array_push(v4_resolve_files, "0")
        array_push(v4_resolve_hirs, "0")
        array_push(v4_resolve_names, word_from_int(array_new()))
        array_push(v4_resolve_kinds, word_from_int(array_new()))
        array_push(v4_resolve_defs, word_from_int(array_new()))
        array_push(v4_resolve_hir_items, word_from_int(array_new()))
        array_push(v4_resolve_diags, word_from_int(array_new()))
    }

    array_set(v4_resolve_files, resolve_id, word_from_int(file_id))
    array_set(v4_resolve_hirs, resolve_id, word_from_int(hir_id))
    array_set(v4_resolve_names, resolve_id, word_from_int(array_new()))
    array_set(v4_resolve_kinds, resolve_id, word_from_int(array_new()))
    array_set(v4_resolve_defs, resolve_id, word_from_int(array_new()))
    array_set(v4_resolve_hir_items, resolve_id, word_from_int(array_new()))
    array_set(v4_resolve_diags, resolve_id, word_from_int(array_new()))
    give back resolve_id
}

task v4_resolve_restore_symbol_slot(resolve_id: int, symbol_id: int, symbol_name: word, symbol_kind: word, def_id: word, hir_item: int) -> int {
    if v4_resolve_exists(resolve_id) == false {
        give back 0
    }
    repeat until v4_resolve_symbol_count(resolve_id) > symbol_id {
        array_push(v4_resolve_names_handle(resolve_id), "")
        array_push(v4_resolve_kinds_handle(resolve_id), "")
        array_push(v4_resolve_defs_handle(resolve_id), "")
        array_push(v4_resolve_hir_items_handle(resolve_id), word_from_int(0 - 1))
    }
    array_set(v4_resolve_names_handle(resolve_id), symbol_id, symbol_name)
    array_set(v4_resolve_kinds_handle(resolve_id), symbol_id, symbol_kind)
    array_set(v4_resolve_defs_handle(resolve_id), symbol_id, def_id)
    array_set(v4_resolve_hir_items_handle(resolve_id), symbol_id, word_from_int(hir_item))
    give back 1
}

task v4_resolve_restore_diag_slot(resolve_id: int, diag_id: int, diag: word) -> int {
    if v4_resolve_exists(resolve_id) == false {
        give back 0
    }
    repeat until array_len(v4_resolve_diags_handle(resolve_id)) > diag_id {
        array_push(v4_resolve_diags_handle(resolve_id), "")
    }
    array_set(v4_resolve_diags_handle(resolve_id), diag_id, diag)
    give back 1
}

task v4_resolve_snapshot_restore_index_line(line: word) -> int {
    if v4_resolve_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_resolve_snapshot_field_raw(line, 0) != "resolve" {
        give back 0
    }
    pilot resolve_id = word_to_int(v4_resolve_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_resolve_snapshot_field_raw(line, 2))
    pilot hir_id = word_to_int(v4_resolve_snapshot_field_raw(line, 3))
    v4_resolve_restore_index_slot(resolve_id, file_id, hir_id)
    give back 1
}

task v4_resolve_snapshot_restore_symbol_line(line: word) -> int {
    if v4_resolve_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_resolve_snapshot_field_raw(line, 0) != "symbol" {
        give back 0
    }
    pilot resolve_id = word_to_int(v4_resolve_snapshot_field_raw(line, 1))
    pilot symbol_id = word_to_int(v4_resolve_snapshot_field_raw(line, 2))
    pilot symbol_name = v4_resolve_snapshot_field(line, 3)
    pilot symbol_kind = v4_resolve_snapshot_field(line, 4)
    pilot def_id = v4_resolve_snapshot_field(line, 5)
    pilot hir_item = word_to_int(v4_resolve_snapshot_field_raw(line, 6))
    give back v4_resolve_restore_symbol_slot(resolve_id, symbol_id, symbol_name, symbol_kind, def_id, hir_item)
}

task v4_resolve_snapshot_restore_diag_line(line: word) -> int {
    if v4_resolve_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_resolve_snapshot_field_raw(line, 0) != "resolve-diag" {
        give back 0
    }
    pilot resolve_id = word_to_int(v4_resolve_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_resolve_snapshot_field_raw(line, 2))
    pilot diag = v4_resolve_snapshot_field(line, 3)
    give back v4_resolve_restore_diag_slot(resolve_id, diag_id, diag)
}

task v4_resolve_snapshot_restore(payload: word) -> word {
    pilot validation = v4_resolve_snapshot_validate(payload)
    if validation.starts_with("resolve-snapshot-import ok=1") == false {
        give back "resolve-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_indexes = 0
    pilot restored_symbols = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_resolve_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_resolve_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_resolve_snapshot_field_raw(line, 0)
            if kind == "resolve" {
                restored_indexes += v4_resolve_snapshot_restore_index_line(line)
            } else if kind == "symbol" {
                restored_symbols += v4_resolve_snapshot_restore_symbol_line(line)
            } else if kind == "resolve-diag" {
                restored_diagnostics += v4_resolve_snapshot_restore_diag_line(line)
            } else if kind != "resolve-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "resolve-snapshot-restore ok=1"
    out = out + " indexes=" + word_from_int(restored_indexes)
    out = out + " symbols=" + word_from_int(restored_symbols)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-indexes=" + word_from_int(v4_resolve_index_count())
    give back out
}
