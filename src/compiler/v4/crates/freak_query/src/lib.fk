-- ===================================================================
-- freak_query - 00-Unit memoized query cache prototype
-- ===================================================================
-- This is the first executable version of the query model. It stores
-- key + input fingerprint -> output fingerprint/value records and a
-- small dependency edge table for future invalidation work.

pilot v4_query_valid = "valid"
pilot v4_query_dirty = "dirty"
pilot v4_query_snapshot_format = "freak-query-snapshot-v1"

pilot v4_query_keys = 0
pilot v4_query_inputs = 0
pilot v4_query_outputs = 0
pilot v4_query_states = 0
pilot v4_query_entry_generations = 0
pilot v4_query_entry_last_generations = 0
pilot v4_query_entry_last_events = 0
pilot v4_query_entry_len = 0
pilot v4_query_dep_from = 0
pilot v4_query_dep_to = 0
pilot v4_query_dep_len = 0
pilot v4_query_generation_reasons = 0
pilot v4_query_invalidated_keys = 0
pilot v4_query_invalidated_generations = 0
pilot v4_query_invalidated_reasons = 0
pilot v4_query_telemetry_keys = 0
pilot v4_query_telemetry_hits = 0
pilot v4_query_telemetry_misses = 0
pilot v4_query_telemetry_stores = 0
pilot v4_query_hit_total = 0
pilot v4_query_miss_total = 0
pilot v4_query_store_total = 0
pilot v4_query_ready = 0
pilot v4_query_revision = 1

task v4_query_init() -> void {
    if v4_query_ready == 0 {
        v4_query_keys = array_new()
        v4_query_inputs = array_new()
        v4_query_outputs = array_new()
        v4_query_states = array_new()
        v4_query_entry_generations = array_new()
        v4_query_entry_last_generations = array_new()
        v4_query_entry_last_events = array_new()
        v4_query_dep_from = array_new()
        v4_query_dep_to = array_new()
        v4_query_generation_reasons = array_new()
        v4_query_invalidated_keys = array_new()
        v4_query_invalidated_generations = array_new()
        v4_query_invalidated_reasons = array_new()
        v4_query_telemetry_keys = array_new()
        v4_query_telemetry_hits = array_new()
        v4_query_telemetry_misses = array_new()
        v4_query_telemetry_stores = array_new()
        array_push(v4_query_generation_reasons, "bootstrap")
        v4_query_ready = 1
    }
}

task v4_query_telemetry_index(key: word) -> int {
    v4_query_init()
    pilot idx = 0
    pilot count = array_len(v4_query_telemetry_keys)
    repeat until idx >= count {
        pilot telemetry_key: word = array_get(v4_query_telemetry_keys, idx)
        if telemetry_key == key {
            give back idx
        }
        idx += 1
    }

    pilot new_idx = array_len(v4_query_telemetry_keys)
    array_push(v4_query_telemetry_keys, key)
    array_push(v4_query_telemetry_hits, "0")
    array_push(v4_query_telemetry_misses, "0")
    array_push(v4_query_telemetry_stores, "0")
    give back new_idx
}

task v4_query_record_hit(key: word) -> void {
    v4_query_init()
    v4_query_hit_total += 1
    pilot idx = v4_query_telemetry_index(key)
    pilot hits = word_to_int(array_get(v4_query_telemetry_hits, idx)) + 1
    array_set(v4_query_telemetry_hits, idx, word_from_int(hits))
}

task v4_query_record_miss(key: word) -> void {
    v4_query_init()
    v4_query_miss_total += 1
    pilot idx = v4_query_telemetry_index(key)
    pilot misses = word_to_int(array_get(v4_query_telemetry_misses, idx)) + 1
    array_set(v4_query_telemetry_misses, idx, word_from_int(misses))
}

task v4_query_record_store(key: word) -> void {
    v4_query_init()
    v4_query_store_total += 1
    pilot idx = v4_query_telemetry_index(key)
    pilot stores = word_to_int(array_get(v4_query_telemetry_stores, idx)) + 1
    array_set(v4_query_telemetry_stores, idx, word_from_int(stores))
}

task v4_query_bump_revision() -> int {
    give back v4_query_bump_generation("revision")
}

task v4_query_generation() -> int {
    v4_query_init()
    give back v4_query_revision
}

task v4_query_generation_reason(generation: int) -> word {
    v4_query_init()
    if generation <= 0 {
        give back ""
    }
    pilot idx = generation - 1
    if idx >= array_len(v4_query_generation_reasons) {
        give back ""
    }
    give back array_get(v4_query_generation_reasons, idx)
}

task v4_query_generation_count() -> int {
    v4_query_init()
    give back array_len(v4_query_generation_reasons)
}

task v4_query_bump_generation(reason: word) -> int {
    v4_query_init()
    v4_query_revision += 1
    array_push(v4_query_generation_reasons, reason)
    give back v4_query_revision
}

task v4_query_record_invalidation(key: word, generation: int, reason: word) -> void {
    v4_query_init()
    array_push(v4_query_invalidated_keys, key)
    array_push(v4_query_invalidated_generations, word_from_int(generation))
    array_push(v4_query_invalidated_reasons, reason)
}

task v4_query_find(key: word, input_fingerprint: word) -> int {
    v4_query_init()
    pilot i = 0
    pilot count = v4_query_entry_len
    repeat until i >= count {
        pilot entry_key: word = array_get(v4_query_keys, i)
        pilot entry_input: word = array_get(v4_query_inputs, i)
        if entry_key == key {
            if entry_input == input_fingerprint {
                give back i
            }
        }
        i += 1
    }
    give back 0 - 1
}

task v4_query_get(key: word, input_fingerprint: word) -> word {
    pilot idx = v4_query_find(key, input_fingerprint)
    if idx < 0 {
        v4_query_record_miss(key)
        give back ""
    }
    pilot state: word = array_get(v4_query_states, idx)
    if state != v4_query_valid {
        array_set(v4_query_entry_last_generations, idx, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_events, idx, "miss:dirty")
        v4_query_record_miss(key)
        give back ""
    }
    array_set(v4_query_entry_last_generations, idx, word_from_int(v4_query_generation()))
    array_set(v4_query_entry_last_events, idx, "hit")
    v4_query_record_hit(key)
    give back array_get(v4_query_outputs, idx)
}

task v4_query_store(key: word, input_fingerprint: word, output: word) -> int {
    v4_query_init()
    pilot idx = v4_query_find(key, input_fingerprint)
    if idx >= 0 {
        array_set(v4_query_outputs, idx, output)
        array_set(v4_query_states, idx, v4_query_valid)
        array_set(v4_query_entry_generations, idx, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_generations, idx, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_events, idx, "store:update")
        v4_query_record_store(key)
        give back idx
    }

    pilot new_idx = v4_query_entry_len
    if new_idx < array_len(v4_query_keys) {
        array_set(v4_query_keys, new_idx, key)
        array_set(v4_query_inputs, new_idx, input_fingerprint)
        array_set(v4_query_outputs, new_idx, output)
        array_set(v4_query_states, new_idx, v4_query_valid)
        array_set(v4_query_entry_generations, new_idx, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_generations, new_idx, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_events, new_idx, "store:new")
    } else {
        array_push(v4_query_keys, key)
        array_push(v4_query_inputs, input_fingerprint)
        array_push(v4_query_outputs, output)
        array_push(v4_query_states, v4_query_valid)
        array_push(v4_query_entry_generations, word_from_int(v4_query_generation()))
        array_push(v4_query_entry_last_generations, word_from_int(v4_query_generation()))
        array_push(v4_query_entry_last_events, "store:new")
    }
    v4_query_entry_len += 1
    v4_query_record_store(key)
    give back new_idx
}

task v4_query_mark_dirty_key(key: word) -> void {
    v4_query_init()
    pilot i = 0
    pilot count = v4_query_entry_len
    repeat until i >= count {
        pilot entry_key: word = array_get(v4_query_keys, i)
        if entry_key == key {
            array_set(v4_query_states, i, v4_query_dirty)
            array_set(v4_query_entry_last_generations, i, word_from_int(v4_query_generation()))
            array_set(v4_query_entry_last_events, i, "dirty")
        }
        i += 1
    }
}

task v4_query_mark_dirty_key_at_generation(key: word, generation: int, reason: word) -> int {
    v4_query_init()
    pilot dirtied = 0
    pilot i = 0
    pilot count = v4_query_entry_len
    repeat until i >= count {
        pilot entry_key: word = array_get(v4_query_keys, i)
        pilot entry_state: word = array_get(v4_query_states, i)
        if entry_key == key {
            if entry_state != v4_query_dirty {
                array_set(v4_query_states, i, v4_query_dirty)
                array_set(v4_query_entry_last_generations, i, word_from_int(generation))
                array_set(v4_query_entry_last_events, i, "dirty:" + reason)
                v4_query_record_invalidation(key, generation, reason)
                dirtied += 1
            }
        }
        i += 1
    }
    give back dirtied
}

task v4_query_dirtyable_prefix_count(prefix: word) -> int {
    v4_query_init()
    pilot dirtied = 0
    pilot i = 0
    pilot count = v4_query_entry_len
    repeat until i >= count {
        pilot key: word = array_get(v4_query_keys, i)
        if key.starts_with(prefix) {
            pilot entry_state: word = array_get(v4_query_states, i)
            if entry_state != v4_query_dirty {
                dirtied += 1
            }
        }
        i += 1
    }
    give back dirtied
}

task v4_query_invalidate_prefix_at_generation(prefix: word, generation: int, reason: word) -> int {
    v4_query_init()
    pilot dirtied = 0
    pilot i = 0
    pilot count = v4_query_entry_len
    repeat until i >= count {
        pilot key: word = array_get(v4_query_keys, i)
        if key.starts_with(prefix) {
            pilot entry_state: word = array_get(v4_query_states, i)
            if entry_state != v4_query_dirty {
                dirtied += 1
            }
        }
        i += 1
    }
    if dirtied == 0 {
        give back 0
    }
    i = 0
    repeat until i >= count {
        pilot key2: word = array_get(v4_query_keys, i)
        if key2.starts_with(prefix) {
            pilot entry_state: word = array_get(v4_query_states, i)
            if entry_state != v4_query_dirty {
                array_set(v4_query_states, i, v4_query_dirty)
                array_set(v4_query_entry_last_generations, i, word_from_int(generation))
                array_set(v4_query_entry_last_events, i, "dirty:" + reason)
                v4_query_record_invalidation(key2, generation, reason)
            }
        }
        i += 1
    }
    give back dirtied
}

task v4_query_invalidate_prefix(prefix: word) -> int {
    v4_query_init()
    if v4_query_dirtyable_prefix_count(prefix) == 0 {
        give back 0
    }
    pilot generation = v4_query_bump_generation("invalidate:" + prefix)
    give back v4_query_invalidate_prefix_at_generation(prefix, generation, "prefix:" + prefix)
}

task v4_query_record_dep(from_key: word, to_key: word) -> void {
    v4_query_init()
    pilot i = 0
    pilot count = v4_query_dep_len
    repeat until i >= count {
        pilot dep_from: word = array_get(v4_query_dep_from, i)
        pilot dep_to: word = array_get(v4_query_dep_to, i)
        if dep_from == from_key {
            if dep_to == to_key {
                give back
            }
        }
        i += 1
    }
    if v4_query_dep_len < array_len(v4_query_dep_from) {
        array_set(v4_query_dep_from, v4_query_dep_len, from_key)
        array_set(v4_query_dep_to, v4_query_dep_len, to_key)
    } else {
        array_push(v4_query_dep_from, from_key)
        array_push(v4_query_dep_to, to_key)
    }
    v4_query_dep_len += 1
}

task v4_query_dep_count() -> int {
    v4_query_init()
    give back v4_query_dep_len
}

task v4_query_dep_from_key(dep_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_dep_from, dep_id)
}

task v4_query_dep_to_key(dep_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_dep_to, dep_id)
}

task v4_query_word_array_contains(words: int, key: word) -> bool {
    pilot i = 0
    pilot count = array_len(words)
    repeat until i >= count {
        pilot existing: word = array_get(words, i)
        if existing == key {
            give back true
        }
        i += 1
    }
    give back false
}

task v4_query_enqueue_unique(words: int, key: word) -> int {
    if v4_query_word_array_contains(words, key) {
        give back 0
    }
    array_push(words, key)
    give back 1
}

task v4_query_direct_dependency_count(key: word) -> int {
    v4_query_init()
    pilot found = 0
    pilot dep_id = 0
    pilot dep_count = v4_query_dep_len
    repeat until dep_id >= dep_count {
        pilot dep_from: word = array_get(v4_query_dep_from, dep_id)
        if dep_from == key {
            found += 1
        }
        dep_id += 1
    }
    give back found
}

task v4_query_direct_dependent_count(key: word) -> int {
    v4_query_init()
    pilot found = 0
    pilot dep_id = 0
    pilot dep_count = v4_query_dep_len
    repeat until dep_id >= dep_count {
        pilot dep_to: word = array_get(v4_query_dep_to, dep_id)
        if dep_to == key {
            found += 1
        }
        dep_id += 1
    }
    give back found
}

task v4_query_direct_dependency_at(key: word, wanted: int) -> word {
    v4_query_init()
    pilot found = 0
    pilot dep_id = 0
    pilot dep_count = v4_query_dep_len
    repeat until dep_id >= dep_count {
        pilot dep_from: word = array_get(v4_query_dep_from, dep_id)
        if dep_from == key {
            if found == wanted {
                give back array_get(v4_query_dep_to, dep_id)
            }
            found += 1
        }
        dep_id += 1
    }
    give back ""
}

task v4_query_direct_dependent_at(key: word, wanted: int) -> word {
    v4_query_init()
    pilot found = 0
    pilot dep_id = 0
    pilot dep_count = v4_query_dep_len
    repeat until dep_id >= dep_count {
        pilot dep_to: word = array_get(v4_query_dep_to, dep_id)
        if dep_to == key {
            if found == wanted {
                give back array_get(v4_query_dep_from, dep_id)
            }
            found += 1
        }
        dep_id += 1
    }
    give back ""
}

task v4_query_invalidate_dependents_at_generation(root_key: word, generation: int, reason: word) -> int {
    v4_query_init()
    pilot work = array_new()
    pilot seen = array_new()
    array_push(work, root_key)
    array_push(seen, root_key)

    pilot dirtied = 0
    pilot work_id = 0
    repeat until work_id >= array_len(work) {
        pilot target: word = array_get(work, work_id)
        pilot dep_id = 0
        pilot dep_count = v4_query_dep_len
        repeat until dep_id >= dep_count {
            pilot dep_to: word = array_get(v4_query_dep_to, dep_id)
            if dep_to == target {
                pilot dependent: word = array_get(v4_query_dep_from, dep_id)
                dirtied += v4_query_mark_dirty_key_at_generation(dependent, generation, reason)
                if v4_query_enqueue_unique(seen, dependent) == 1 {
                    array_push(work, dependent)
                }
            }
            dep_id += 1
        }
        work_id += 1
    }
    give back dirtied
}

task v4_query_invalidate_dependents(root_key: word) -> int {
    v4_query_init()
    if v4_query_direct_dependent_count(root_key) == 0 {
        give back 0
    }
    pilot generation = v4_query_bump_generation("invalidate-dependents:" + root_key)
    give back v4_query_invalidate_dependents_at_generation(root_key, generation, "dependency:" + root_key)
}

task v4_query_dependency_summary(key: word) -> word {
    pilot summary = "query-deps key=" + key
    summary = summary + " deps=" + word_from_int(v4_query_direct_dependency_count(key))
    summary = summary + " dependents=" + word_from_int(v4_query_direct_dependent_count(key))
    if v4_query_direct_dependency_count(key) > 0 {
        summary = summary + " first-dep=" + v4_query_direct_dependency_at(key, 0)
    }
    if v4_query_direct_dependent_count(key) > 0 {
        summary = summary + " first-dependent=" + v4_query_direct_dependent_at(key, 0)
    }
    give back summary
}

task v4_query_graph_summary() -> word {
    v4_query_init()
    pilot roots = 0
    pilot leaves = 0
    pilot key_id = 0
    pilot key_count = v4_query_entry_len
    repeat until key_id >= key_count {
        pilot key: word = array_get(v4_query_keys, key_id)
        if v4_query_direct_dependency_count(key) == 0 {
            roots += 1
        }
        if v4_query_direct_dependent_count(key) == 0 {
            leaves += 1
        }
        key_id += 1
    }

    pilot summary = "query-graph"
    summary = summary + " nodes=" + word_from_int(v4_query_cache_size())
    summary = summary + " edges=" + word_from_int(v4_query_dep_count())
    summary = summary + " roots=" + word_from_int(roots)
    summary = summary + " leaves=" + word_from_int(leaves)
    summary = summary + " generation=" + word_from_int(v4_query_generation())
    give back summary
}

task v4_query_entry_count_for_key(key: word) -> int {
    v4_query_init()
    pilot found = 0
    pilot entry_id = 0
    pilot entry_count = v4_query_entry_len
    repeat until entry_id >= entry_count {
        pilot entry_key: word = array_get(v4_query_keys, entry_id)
        if entry_key == key {
            found += 1
        }
        entry_id += 1
    }
    give back found
}

task v4_query_entry_at_key(key: word, wanted: int) -> int {
    v4_query_init()
    pilot found = 0
    pilot entry_id = 0
    pilot entry_count = v4_query_entry_len
    repeat until entry_id >= entry_count {
        pilot entry_key: word = array_get(v4_query_keys, entry_id)
        if entry_key == key {
            if found == wanted {
                give back entry_id
            }
            found += 1
        }
        entry_id += 1
    }
    give back 0 - 1
}

task v4_query_entry_key(entry_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_keys, entry_id)
}

task v4_query_entry_input(entry_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_inputs, entry_id)
}

task v4_query_entry_output(entry_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_outputs, entry_id)
}

task v4_query_entry_state(entry_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_states, entry_id)
}

task v4_query_entry_store_generation(entry_id: int) -> int {
    v4_query_init()
    give back word_to_int(array_get(v4_query_entry_generations, entry_id))
}

task v4_query_entry_last_generation(entry_id: int) -> int {
    v4_query_init()
    give back word_to_int(array_get(v4_query_entry_last_generations, entry_id))
}

task v4_query_entry_last_event(entry_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_entry_last_events, entry_id)
}

task v4_query_entry_is_restored_dirty(entry_id: int) -> bool {
    v4_query_init()
    if v4_query_entry_state(entry_id) != v4_query_dirty {
        give back false
    }
    give back v4_query_entry_last_event(entry_id).starts_with("restore:dirty:")
}

task v4_query_confirm_entry_input(entry_id: int, input_fingerprint: word, reason: word, allow_promote: int) -> int {
    v4_query_init()
    if entry_id < 0 {
        give back 0
    }
    if entry_id >= v4_query_cache_size() {
        give back 0
    }
    if v4_query_entry_input(entry_id) != input_fingerprint {
        give back 0
    }
    if v4_query_entry_state(entry_id) == v4_query_valid {
        array_set(v4_query_entry_last_generations, entry_id, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_events, entry_id, "confirm:already-valid:" + reason)
        give back 3
    }
    if v4_query_entry_is_restored_dirty(entry_id) == false {
        give back 4
    }
    if allow_promote == 0 {
        give back 2
    }

    array_set(v4_query_states, entry_id, v4_query_valid)
    array_set(v4_query_entry_last_generations, entry_id, word_from_int(v4_query_generation()))
    array_set(v4_query_entry_last_events, entry_id, "confirm:" + reason)
    give back 1
}

task v4_query_confirm_key_input(key: word, input_fingerprint: word, reason: word, allow_promote: int) -> word {
    v4_query_init()
    pilot entries = 0
    pilot matched = 0
    pilot promoted = 0
    pilot blocked = 0
    pilot already_valid = 0
    pilot dirty_nonrestored = 0
    pilot mismatched = 0

    pilot entry_id = 0
    pilot entry_count = v4_query_cache_size()
    repeat until entry_id >= entry_count {
        if v4_query_entry_key(entry_id) == key {
            entries += 1
            pilot code = v4_query_confirm_entry_input(entry_id, input_fingerprint, reason, allow_promote)
            if code == 1 {
                matched += 1
                promoted += 1
            } else if code == 2 {
                matched += 1
                blocked += 1
            } else if code == 3 {
                matched += 1
                already_valid += 1
            } else if code == 4 {
                matched += 1
                dirty_nonrestored += 1
            } else {
                mismatched += 1
            }
        }
        entry_id += 1
    }

    pilot out = "query-confirm-key"
    out = out + " key=" + key
    out = out + " entries=" + word_from_int(entries)
    out = out + " matched=" + word_from_int(matched)
    out = out + " promoted=" + word_from_int(promoted)
    out = out + " blocked=" + word_from_int(blocked)
    out = out + " already-valid=" + word_from_int(already_valid)
    out = out + " dirty-nonrestored=" + word_from_int(dirty_nonrestored)
    out = out + " mismatched=" + word_from_int(mismatched)
    out = out + " allow-promote=" + word_from_int(allow_promote)
    give back out
}

task v4_query_telemetry_find(key: word) -> int {
    v4_query_init()
    pilot telemetry_id = 0
    pilot telemetry_count = array_len(v4_query_telemetry_keys)
    repeat until telemetry_id >= telemetry_count {
        pilot telemetry_key: word = array_get(v4_query_telemetry_keys, telemetry_id)
        if telemetry_key == key {
            give back telemetry_id
        }
        telemetry_id += 1
    }
    give back 0 - 1
}

task v4_query_hits_for_key(key: word) -> int {
    pilot telemetry_id = v4_query_telemetry_find(key)
    if telemetry_id < 0 {
        give back 0
    }
    give back v4_query_telemetry_hits_for(telemetry_id)
}

task v4_query_misses_for_key(key: word) -> int {
    pilot telemetry_id = v4_query_telemetry_find(key)
    if telemetry_id < 0 {
        give back 0
    }
    give back v4_query_telemetry_misses_for(telemetry_id)
}

task v4_query_stores_for_key(key: word) -> int {
    pilot telemetry_id = v4_query_telemetry_find(key)
    if telemetry_id < 0 {
        give back 0
    }
    give back v4_query_telemetry_stores_for(telemetry_id)
}

task v4_query_invalidation_count_for_key(key: word) -> int {
    v4_query_init()
    pilot found = 0
    pilot invalidation_id = 0
    pilot invalidation_count = array_len(v4_query_invalidated_keys)
    repeat until invalidation_id >= invalidation_count {
        pilot invalidated_key: word = array_get(v4_query_invalidated_keys, invalidation_id)
        if invalidated_key == key {
            found += 1
        }
        invalidation_id += 1
    }
    give back found
}

task v4_query_latest_invalidation_generation(key: word) -> int {
    v4_query_init()
    pilot latest = 0
    pilot invalidation_id = 0
    pilot invalidation_count = array_len(v4_query_invalidated_keys)
    repeat until invalidation_id >= invalidation_count {
        pilot invalidated_key: word = array_get(v4_query_invalidated_keys, invalidation_id)
        if invalidated_key == key {
            latest = word_to_int(array_get(v4_query_invalidated_generations, invalidation_id))
        }
        invalidation_id += 1
    }
    give back latest
}

task v4_query_latest_invalidation_reason(key: word) -> word {
    v4_query_init()
    pilot latest = ""
    pilot invalidation_id = 0
    pilot invalidation_count = array_len(v4_query_invalidated_keys)
    repeat until invalidation_id >= invalidation_count {
        pilot invalidated_key: word = array_get(v4_query_invalidated_keys, invalidation_id)
        if invalidated_key == key {
            latest = array_get(v4_query_invalidated_reasons, invalidation_id)
        }
        invalidation_id += 1
    }
    give back latest
}

task v4_query_explain(key: word) -> word {
    v4_query_init()
    pilot out = "query-explain key=" + key
    out = out + " generation=" + word_from_int(v4_query_generation())
    out = out + " entries=" + word_from_int(v4_query_entry_count_for_key(key))
    out = out + " deps=" + word_from_int(v4_query_direct_dependency_count(key))
    out = out + " dependents=" + word_from_int(v4_query_direct_dependent_count(key))
    out = out + " hits=" + word_from_int(v4_query_hits_for_key(key))
    out = out + " misses=" + word_from_int(v4_query_misses_for_key(key))
    out = out + " stores=" + word_from_int(v4_query_stores_for_key(key))
    out = out + " invalidations=" + word_from_int(v4_query_invalidation_count_for_key(key))
    out = out + " latest-invalidation-generation=" + word_from_int(v4_query_latest_invalidation_generation(key))
    out = out + " latest-invalidation-reason=" + v4_query_latest_invalidation_reason(key)

    pilot entry_idx = 0
    pilot entry_count = v4_query_entry_count_for_key(key)
    repeat until entry_idx >= entry_count {
        pilot entry_id = v4_query_entry_at_key(key, entry_idx)
        out = out + "\n"
        out = out + "entry"
        out = out + "|" + word_from_int(entry_id)
        out = out + "|state=" + v4_query_entry_state(entry_id)
        out = out + "|stored-generation=" + word_from_int(v4_query_entry_store_generation(entry_id))
        out = out + "|last-generation=" + word_from_int(v4_query_entry_last_generation(entry_id))
        out = out + "|last-event=" + v4_query_entry_last_event(entry_id)
        out = out + "|input=" + v4_query_entry_input(entry_id)
        out = out + "|output-bytes=" + word_from_int(v4_query_entry_output(entry_id).length())
        entry_idx += 1
    }

    pilot dep_idx = 0
    pilot dep_count = v4_query_direct_dependency_count(key)
    repeat until dep_idx >= dep_count {
        out = out + "\n"
        out = out + "dep"
        out = out + "|" + key
        out = out + "|" + v4_query_direct_dependency_at(key, dep_idx)
        dep_idx += 1
    }

    pilot dependent_idx = 0
    pilot dependent_count = v4_query_direct_dependent_count(key)
    repeat until dependent_idx >= dependent_count {
        out = out + "\n"
        out = out + "dependent"
        out = out + "|" + key
        out = out + "|" + v4_query_direct_dependent_at(key, dependent_idx)
        dependent_idx += 1
    }

    pilot invalidation_idx = 0
    pilot invalidation_count = v4_query_invalidated_count()
    repeat until invalidation_idx >= invalidation_count {
        if v4_query_invalidated_key(invalidation_idx) == key {
            out = out + "\n"
            out = out + "invalidation"
            out = out + "|" + word_from_int(v4_query_invalidated_generation(invalidation_idx))
            out = out + "|" + v4_query_invalidated_reason(invalidation_idx)
        }
        invalidation_idx += 1
    }
    give back out
}

task v4_query_cache_size() -> int {
    v4_query_init()
    give back v4_query_entry_len
}

task v4_query_invalidated_count() -> int {
    v4_query_init()
    give back array_len(v4_query_invalidated_keys)
}

task v4_query_invalidated_key(invalidation_id: int) -> word {
    v4_query_init()
    give back array_get(v4_query_invalidated_keys, invalidation_id)
}

task v4_query_invalidated_generation(invalidation_id: int) -> int {
