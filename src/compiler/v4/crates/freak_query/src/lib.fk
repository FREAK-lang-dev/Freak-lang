}

task v4_query_telemetry_summary() -> word {
    pilot summary = "query-telemetry"
    summary = summary + " generation=" + word_from_int(v4_query_generation())
    summary = summary + " cache=" + word_from_int(v4_query_cache_size())
    summary = summary + " dirty=" + word_from_int(v4_query_dirty_count())
    summary = summary + " hits=" + word_from_int(v4_query_hit_count())
    summary = summary + " misses=" + word_from_int(v4_query_miss_count())
    summary = summary + " stores=" + word_from_int(v4_query_store_count())
    summary = summary + " keys=" + word_from_int(v4_query_telemetry_key_count())
    give back summary
}

task v4_query_snapshot_escape(value: word) -> word {
    pilot out = ""
    pilot i = 0
    repeat until i >= value.length() {
        pilot ch = value.char_at(i)
        if ch == "%" {
            out = out + "%25"
        } else if ch == "|" {
            out = out + "%7C"
        } else if ch == "\n" {
            out = out + "%0A"
        } else if ch == "\r" {
            out = out + "%0D"
        } else {
            out = out + ch
        }
        i += 1
    }
    give back out
}

task v4_query_snapshot_unescape(value: word) -> word {
    pilot out = ""
    pilot i = 0
    repeat until i >= value.length() {
        pilot ch = value.char_at(i)
        if ch == "%" and i + 2 < value.length() {
            pilot code = v4_slice(value, i, i + 3)
            if code == "%25" {
                out = out + "%"
                i += 3
            } else if code == "%7C" {
                out = out + "|"
                i += 3
            } else if code == "%0A" {
                out = out + "\n"
                i += 3
            } else if code == "%0D" {
                out = out + "\r"
                i += 3
            } else {
                out = out + ch
                i += 1
            }
        } else {
            out = out + ch
            i += 1
        }
    }
    give back out
}

task v4_query_snapshot_line_count(payload: word) -> int {
    if payload == "" {
        give back 0
    }
    pilot count = 1
    pilot i = 0
    repeat until i >= payload.length() {
        if payload.char_at(i) == "\n" {
            count += 1
        }
        i += 1
    }
    give back count
}

task v4_query_snapshot_line(payload: word, wanted: int) -> word {
    if wanted < 0 {
        give back ""
    }
    pilot line_id = 0
    pilot start_pos = 0
    pilot i = 0
    repeat until i >= payload.length() {
        if payload.char_at(i) == "\n" {
            if line_id == wanted {
                give back v4_slice(payload, start_pos, i)
            }
            line_id += 1
            start_pos = i + 1
        }
        i += 1
    }
    if line_id == wanted {
        give back v4_slice(payload, start_pos, payload.length())
    }
    give back ""
}

task v4_query_snapshot_field_count(line: word) -> int {
    if line == "" {
        give back 0
    }
    pilot count = 1
    pilot i = 0
    repeat until i >= line.length() {
        if line.char_at(i) == "|" {
            count += 1
        }
        i += 1
    }
    give back count
}

task v4_query_snapshot_field_raw(line: word, wanted: int) -> word {
    if wanted < 0 {
        give back ""
    }
    pilot field_id = 0
    pilot start_pos = 0
    pilot i = 0
    repeat until i >= line.length() {
        if line.char_at(i) == "|" {
            if field_id == wanted {
                give back v4_slice(line, start_pos, i)
            }
            field_id += 1
            start_pos = i + 1
        }
        i += 1
    }
    if field_id == wanted {
        give back v4_slice(line, start_pos, line.length())
    }
    give back ""
}

task v4_query_snapshot_field(line: word, wanted: int) -> word {
    give back v4_query_snapshot_unescape(v4_query_snapshot_field_raw(line, wanted))
}

task v4_query_snapshot_key_value(line: word, wanted_key: word) -> word {
    pilot field_id = 1
    pilot field_count = v4_query_snapshot_field_count(line)
    repeat until field_id >= field_count {
        pilot field = v4_query_snapshot_field_raw(line, field_id)
        pilot eq_pos = v4_index_of_from(field, "=", 0)
        if eq_pos > 0 {
            pilot key = v4_slice(field, 0, eq_pos)
            if key == wanted_key {
                give back v4_query_snapshot_unescape(v4_slice(field, eq_pos + 1, field.length()))
            }
        }
        field_id += 1
    }
    give back ""
}

task v4_query_snapshot_summary() -> word {
    pilot summary = "query-snapshot"
    summary = summary + " format=" + v4_query_snapshot_format
    summary = summary + " generation=" + word_from_int(v4_query_generation())
    summary = summary + " generations=" + word_from_int(v4_query_generation_count())
    summary = summary + " entries=" + word_from_int(v4_query_cache_size())
    summary = summary + " edges=" + word_from_int(v4_query_dep_count())
    summary = summary + " invalidations=" + word_from_int(v4_query_invalidated_count())
    summary = summary + " telemetry=" + word_from_int(v4_query_telemetry_key_count())
    give back summary
}

task v4_query_snapshot_header() -> word {
    pilot out = "snapshot"
    out = out + "|format=" + v4_query_snapshot_format
    out = out + "|generation=" + word_from_int(v4_query_generation())
    out = out + "|generations=" + word_from_int(v4_query_generation_count())
    out = out + "|entries=" + word_from_int(v4_query_cache_size())
    out = out + "|edges=" + word_from_int(v4_query_dep_count())
    out = out + "|invalidations=" + word_from_int(v4_query_invalidated_count())
    out = out + "|telemetry=" + word_from_int(v4_query_telemetry_key_count())
    give back out
}

task v4_query_snapshot_generation_line(generation_id: int) -> word {
    pilot generation = generation_id + 1
    pilot out = "generation"
    out = out + "|" + word_from_int(generation)
    out = out + "|" + v4_query_snapshot_escape(v4_query_generation_reason(generation))
    give back out
}

task v4_query_snapshot_entry_line(entry_id: int) -> word {
    pilot out = "entry"
    out = out + "|" + word_from_int(entry_id)
    out = out + "|" + v4_query_snapshot_escape(v4_query_entry_key(entry_id))
    out = out + "|" + v4_query_snapshot_escape(v4_query_entry_input(entry_id))
    out = out + "|" + v4_query_snapshot_escape(v4_query_entry_output(entry_id))
    out = out + "|" + v4_query_snapshot_escape(v4_query_entry_state(entry_id))
    out = out + "|" + word_from_int(v4_query_entry_store_generation(entry_id))
    out = out + "|" + word_from_int(v4_query_entry_last_generation(entry_id))
    out = out + "|" + v4_query_snapshot_escape(v4_query_entry_last_event(entry_id))
    give back out
}

task v4_query_snapshot_edge_line(dep_id: int) -> word {
    pilot out = "edge"
    out = out + "|" + word_from_int(dep_id)
    out = out + "|" + v4_query_snapshot_escape(v4_query_dep_from_key(dep_id))
    out = out + "|" + v4_query_snapshot_escape(v4_query_dep_to_key(dep_id))
    give back out
}

task v4_query_snapshot_invalidation_line(invalidation_id: int) -> word {
    pilot out = "invalidation"
    out = out + "|" + word_from_int(invalidation_id)
    out = out + "|" + v4_query_snapshot_escape(v4_query_invalidated_key(invalidation_id))
    out = out + "|" + word_from_int(v4_query_invalidated_generation(invalidation_id))
    out = out + "|" + v4_query_snapshot_escape(v4_query_invalidated_reason(invalidation_id))
    give back out
}

task v4_query_snapshot_telemetry_line(telemetry_id: int) -> word {
    pilot out = "telemetry"
    out = out + "|" + word_from_int(telemetry_id)
    out = out + "|" + v4_query_snapshot_escape(v4_query_telemetry_key(telemetry_id))
    out = out + "|" + word_from_int(v4_query_telemetry_hits_for(telemetry_id))
    out = out + "|" + word_from_int(v4_query_telemetry_misses_for(telemetry_id))
    out = out + "|" + word_from_int(v4_query_telemetry_stores_for(telemetry_id))
    give back out
}

task v4_query_snapshot() -> word {
    v4_query_init()
    pilot out = v4_query_snapshot_header()

    pilot generation_id = 0
    pilot generation_count = v4_query_generation_count()
    repeat until generation_id >= generation_count {
        out = out + "\n" + v4_query_snapshot_generation_line(generation_id)
        generation_id += 1
    }

    pilot entry_id = 0
    pilot entry_count = v4_query_cache_size()
    repeat until entry_id >= entry_count {
        out = out + "\n" + v4_query_snapshot_entry_line(entry_id)
        entry_id += 1
    }

    pilot dep_id = 0
    pilot dep_count = v4_query_dep_count()
    repeat until dep_id >= dep_count {
        out = out + "\n" + v4_query_snapshot_edge_line(dep_id)
        dep_id += 1
    }

    pilot invalidation_id = 0
    pilot invalidation_count = v4_query_invalidated_count()
    repeat until invalidation_id >= invalidation_count {
        out = out + "\n" + v4_query_snapshot_invalidation_line(invalidation_id)
        invalidation_id += 1
    }

    pilot telemetry_id = 0
    pilot telemetry_count = v4_query_telemetry_key_count()
    repeat until telemetry_id >= telemetry_count {
        out = out + "\n" + v4_query_snapshot_telemetry_line(telemetry_id)
        telemetry_id += 1
    }

    out = out + "\nend|" + v4_query_snapshot_format
    give back out
}

task v4_query_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "snapshot" {
        give back 8
    }
    if kind == "generation" {
        give back 3
    }
    if kind == "entry" {
        give back 9
    }
    if kind == "edge" {
        give back 4
    }
    if kind == "invalidation" {
        give back 5
    }
    if kind == "telemetry" {
        give back 6
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_query_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_query_snapshot_field_raw(line, 0)
    pilot expected = v4_query_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_query_snapshot_field_count(line) != expected {
        give back false
    }
    give back true
}

task v4_query_snapshot_canonical_nonnegative_int(raw: word) -> int {
    if raw == "" { give back 0 - 1 }
    pilot value = word_to_int(raw)
    if value < 0 { give back 0 - 1 }
    if word_from_int(value) != raw { give back 0 - 1 }
    give back value
}

task v4_query_snapshot_header_field_is(line: word, field_id: int, key: word) -> bool {
    pilot prefix = key + "="
    give back v4_query_snapshot_field_raw(line, field_id).starts_with(prefix)
}

task v4_query_snapshot_validate(payload: word) -> word {
    pilot lines = v4_query_snapshot_line_count(payload)
    pilot entries = 0
    pilot edges = 0
    pilot generations = 0
    pilot invalidations = 0
    pilot telemetry = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_generation = 0 - 1
    pilot declared_generations = 0 - 1
    pilot declared_entries = 0 - 1
    pilot declared_edges = 0 - 1
    pilot declared_invalidations = 0 - 1
    pilot declared_telemetry = 0 - 1
    pilot phase = 0

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_query_snapshot_line(payload, line_id)
        if line == "" {
            malformed += 1
        } else {
            pilot kind = v4_query_snapshot_field_raw(line, 0)
            if saw_end > 0 {
                malformed += 1
            } else if v4_query_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "snapshot" {
                saw_header += 1
                if line_id != 0 or saw_header != 1 or phase != 0 { malformed += 1 }
                if v4_query_snapshot_field_raw(line, 1) != "format=" + v4_query_snapshot_format { malformed += 1 }
                if not v4_query_snapshot_header_field_is(line, 2, "generation") { malformed += 1 }
                if not v4_query_snapshot_header_field_is(line, 3, "generations") { malformed += 1 }
                if not v4_query_snapshot_header_field_is(line, 4, "entries") { malformed += 1 }
                if not v4_query_snapshot_header_field_is(line, 5, "edges") { malformed += 1 }
                if not v4_query_snapshot_header_field_is(line, 6, "invalidations") { malformed += 1 }
                if not v4_query_snapshot_header_field_is(line, 7, "telemetry") { malformed += 1 }
                format = v4_query_snapshot_key_value(line, "format")
                if format != v4_query_snapshot_format {
                    malformed += 1
                }
                declared_generation = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_key_value(line, "generation"))
                declared_generations = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_key_value(line, "generations"))
                declared_entries = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_key_value(line, "entries"))
                declared_edges = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_key_value(line, "edges"))
                declared_invalidations = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_key_value(line, "invalidations"))
                declared_telemetry = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_key_value(line, "telemetry"))
                if declared_generation <= 0 { malformed += 1 }
                if declared_generations <= 0 or declared_generations > lines { malformed += 1 }
                if declared_entries < 0 or declared_entries > lines { malformed += 1 }
                if declared_edges < 0 or declared_edges > lines { malformed += 1 }
                if declared_invalidations < 0 or declared_invalidations > lines { malformed += 1 }
                if declared_telemetry < 0 or declared_telemetry > lines { malformed += 1 }
            } else if kind == "generation" {
                if saw_header != 1 or phase > 1 { malformed += 1 }
                phase = 1
                pilot generation_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
                if generation_id < 0 or generation_id != generations + 1 or generation_id > declared_generations {
                    malformed += 1
                }
                generations += 1
            } else if kind == "entry" {
                if saw_header != 1 or phase > 2 { malformed += 1 }
                phase = 2
                pilot entry_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
                pilot stored_generation = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 6))
                pilot last_generation = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 7))
                if entry_id < 0 or entry_id != entries or entry_id >= declared_entries { malformed += 1 }
                if stored_generation < 0 or stored_generation > declared_generation { malformed += 1 }
                if last_generation < 0 or last_generation > declared_generation { malformed += 1 }
                entries += 1
            } else if kind == "edge" {
                if saw_header != 1 or phase > 3 { malformed += 1 }
                phase = 3
                pilot dep_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
                if dep_id < 0 or dep_id != edges or dep_id >= declared_edges { malformed += 1 }
                edges += 1
            } else if kind == "invalidation" {
                if saw_header != 1 or phase > 4 { malformed += 1 }
                phase = 4
                pilot invalidation_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
                pilot invalidation_generation = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 3))
                if invalidation_id < 0 or invalidation_id != invalidations or invalidation_id >= declared_invalidations {
                    malformed += 1
                }
                if invalidation_generation < 0 or invalidation_generation > declared_generation { malformed += 1 }
                invalidations += 1
            } else if kind == "telemetry" {
                if saw_header != 1 or phase > 5 { malformed += 1 }
                phase = 5
                pilot telemetry_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
                pilot telemetry_hits = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 3))
                pilot telemetry_misses = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 4))
                pilot telemetry_stores = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 5))
                if telemetry_id < 0 or telemetry_id != telemetry or telemetry_id >= declared_telemetry { malformed += 1 }
                if telemetry_hits < 0 or telemetry_misses < 0 or telemetry_stores < 0 { malformed += 1 }
                telemetry += 1
            } else if kind == "end" {
                saw_end += 1
                phase = 6
                if saw_header != 1 or line_id != lines - 1 { malformed += 1 }
                if v4_query_snapshot_field(line, 1) != v4_query_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    if declared_generation != declared_generations { malformed += 1 }
    if generations != declared_generations { malformed += 1 }
    if entries != declared_entries { malformed += 1 }
    if edges != declared_edges { malformed += 1 }
    if invalidations != declared_invalidations { malformed += 1 }
    if telemetry != declared_telemetry { malformed += 1 }
    if declared_generations >= 0 and declared_generations <= lines and declared_entries >= 0 and declared_entries <= lines and declared_edges >= 0 and declared_edges <= lines and declared_invalidations >= 0 and declared_invalidations <= lines and declared_telemetry >= 0 and declared_telemetry <= lines {
        pilot declared_records = declared_generations + declared_entries + declared_edges + declared_invalidations + declared_telemetry
        if declared_records != lines - 2 { malformed += 1 }
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }

    pilot out = "query-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " generations=" + word_from_int(generations)
    out = out + " entries=" + word_from_int(entries)
    out = out + " edges=" + word_from_int(edges)
    out = out + " invalidations=" + word_from_int(invalidations)
    out = out + " telemetry=" + word_from_int(telemetry)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_query_snapshot_validate_is_ok(payload: word) -> bool {
    give back v4_query_snapshot_validate(payload).starts_with("query-snapshot-import ok=1")
}

task v4_query_begin_snapshot_restore() -> void {
    v4_query_init()

    pilot entry_id = 0
    pilot entry_capacity = array_len(v4_query_keys)
    repeat until entry_id >= entry_capacity {
        array_set(v4_query_keys, entry_id, "")
        array_set(v4_query_inputs, entry_id, "")
        array_set(v4_query_outputs, entry_id, "")
        array_set(v4_query_states, entry_id, v4_query_dirty)
        array_set(v4_query_entry_generations, entry_id, "0")
        array_set(v4_query_entry_last_generations, entry_id, word_from_int(v4_query_generation()))
        array_set(v4_query_entry_last_events, entry_id, "restore:absent")
        entry_id += 1
    }
    v4_query_entry_len = 0

    pilot dep_id = 0
    pilot dep_capacity = array_len(v4_query_dep_from)
    repeat until dep_id >= dep_capacity {
        array_set(v4_query_dep_from, dep_id, "")
        array_set(v4_query_dep_to, dep_id, "")
        dep_id += 1
    }
    v4_query_dep_len = 0
}

task v4_query_restore_entry_slot(entry_id: int, key: word, input_fingerprint: word, output: word, stored_generation: int, imported_event: word) -> int {
    v4_query_init()
    if entry_id < 0 or entry_id != v4_query_entry_len {
        give back 0 - 1
    }
    pilot generation = stored_generation
    if generation <= 0 {
        generation = v4_query_generation()
    }

    repeat until array_len(v4_query_keys) > entry_id {
        array_push(v4_query_keys, "")
        array_push(v4_query_inputs, "")
        array_push(v4_query_outputs, "")
        array_push(v4_query_states, v4_query_dirty)
        array_push(v4_query_entry_generations, "0")
        array_push(v4_query_entry_last_generations, "0")
        array_push(v4_query_entry_last_events, "restore:absent")
    }

    array_set(v4_query_keys, entry_id, key)
    array_set(v4_query_inputs, entry_id, input_fingerprint)
    array_set(v4_query_outputs, entry_id, output)
    array_set(v4_query_states, entry_id, v4_query_dirty)
    array_set(v4_query_entry_generations, entry_id, word_from_int(generation))
    array_set(v4_query_entry_last_generations, entry_id, word_from_int(v4_query_generation()))
    array_set(v4_query_entry_last_events, entry_id, "restore:dirty:" + imported_event)
    if v4_query_entry_len <= entry_id {
        v4_query_entry_len = entry_id + 1
    }
    give back entry_id
}

task v4_query_restore_dep_slot(dep_id: int, from_key: word, to_key: word) -> int {
    v4_query_init()
    if dep_id < 0 or dep_id != v4_query_dep_len {
        give back 0 - 1
    }
    repeat until array_len(v4_query_dep_from) > dep_id {
        array_push(v4_query_dep_from, "")
        array_push(v4_query_dep_to, "")
    }
    array_set(v4_query_dep_from, dep_id, from_key)
    array_set(v4_query_dep_to, dep_id, to_key)
    if v4_query_dep_len <= dep_id {
        v4_query_dep_len = dep_id + 1
    }
    give back dep_id
}

task v4_query_snapshot_restore_entry_line(line: word) -> int {
    if v4_query_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_query_snapshot_field_raw(line, 0) != "entry" {
        give back 0
    }

    pilot entry_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
    pilot key = v4_query_snapshot_field(line, 2)
    pilot input_fingerprint = v4_query_snapshot_field(line, 3)
    pilot output = v4_query_snapshot_field(line, 4)
    pilot stored_generation = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 6))
    pilot imported_event = v4_query_snapshot_field(line, 8)
    if entry_id < 0 or stored_generation < 0 { give back 0 }
    if v4_query_restore_entry_slot(entry_id, key, input_fingerprint, output, stored_generation, imported_event) < 0 {
        give back 0
    }
    give back 1
}

task v4_query_snapshot_restore_edge_line(line: word) -> int {
    if v4_query_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_query_snapshot_field_raw(line, 0) != "edge" {
        give back 0
    }

    pilot dep_id = v4_query_snapshot_canonical_nonnegative_int(v4_query_snapshot_field_raw(line, 1))
    pilot from_key = v4_query_snapshot_field(line, 2)
    pilot to_key = v4_query_snapshot_field(line, 3)
    if dep_id < 0 { give back 0 }
    if v4_query_restore_dep_slot(dep_id, from_key, to_key) < 0 { give back 0 }
    give back 1
}

task v4_query_snapshot_restore(payload: word) -> word {
    pilot validation = v4_query_snapshot_validate(payload)
    if validation.starts_with("query-snapshot-import ok=1") == false {
        give back "query-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restore_generation = v4_query_bump_generation("snapshot-restore")
    v4_query_begin_snapshot_restore()
    pilot restored_entries = 0
    pilot restored_edges = 0
    pilot skipped_generations = 0
    pilot skipped_invalidations = 0
    pilot skipped_telemetry = 0
    pilot skipped_other = 0

    pilot line_id = 0
    pilot line_count = v4_query_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_query_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_query_snapshot_field_raw(line, 0)
            if kind == "entry" {
                restored_entries += v4_query_snapshot_restore_entry_line(line)
            } else if kind == "edge" {
                restored_edges += v4_query_snapshot_restore_edge_line(line)
            } else if kind == "generation" {
                skipped_generations += 1
            } else if kind == "invalidation" {
                skipped_invalidations += 1
            } else if kind == "telemetry" {
                skipped_telemetry += 1
            } else if kind != "snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "query-snapshot-restore ok=1"
    out = out + " generation=" + word_from_int(restore_generation)
    out = out + " entries=" + word_from_int(restored_entries)
    out = out + " edges=" + word_from_int(restored_edges)
    out = out + " dirty=" + word_from_int(v4_query_dirty_count())
    out = out + " cache=" + word_from_int(v4_query_cache_size())
    out = out + " deps=" + word_from_int(v4_query_dep_count())
    out = out + " skipped-generations=" + word_from_int(skipped_generations)
    out = out + " skipped-invalidations=" + word_from_int(skipped_invalidations)
    out = out + " skipped-telemetry=" + word_from_int(skipped_telemetry)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    give back out
}
