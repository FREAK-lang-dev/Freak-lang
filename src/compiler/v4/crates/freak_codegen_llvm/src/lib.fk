-- ===================================================================
-- freak_codegen_llvm - early V4 LLVM declaration and call-plan lowering
-- ===================================================================
-- Depends on freak_ty, freak_mir, and freak_borrowck.
-- This slice gives V4 a real backend-facing boundary: MIR and TY own
-- semantic facts, while codegen translates those facts into LLVM-facing
-- declarations and call plans without teaching the rest of the compiler
-- target spellings.

pilot v4_codegen_llvm_files = 0
pilot v4_codegen_llvm_mirs = 0
pilot v4_codegen_llvm_decl_names = 0
pilot v4_codegen_llvm_decl_symbols = 0
pilot v4_codegen_llvm_decl_abis = 0
pilot v4_codegen_llvm_decl_ccs = 0
pilot v4_codegen_llvm_decl_returns = 0
pilot v4_codegen_llvm_decl_params = 0
pilot v4_codegen_llvm_decl_lines = 0
pilot v4_codegen_llvm_call_bodies = 0
pilot v4_codegen_llvm_call_names = 0
pilot v4_codegen_llvm_call_symbols = 0
pilot v4_codegen_llvm_call_abis = 0
pilot v4_codegen_llvm_call_ccs = 0
pilot v4_codegen_llvm_call_returns = 0
pilot v4_codegen_llvm_call_exprs = 0
pilot v4_codegen_llvm_call_lines = 0
pilot v4_codegen_llvm_diags = 0
pilot v4_codegen_llvm_ready = 0

task v4_codegen_llvm_init() -> void {
    if v4_codegen_llvm_ready == 0 {
        v4_codegen_llvm_files = array_new()
        v4_codegen_llvm_mirs = array_new()
        v4_codegen_llvm_decl_names = array_new()
        v4_codegen_llvm_decl_symbols = array_new()
        v4_codegen_llvm_decl_abis = array_new()
        v4_codegen_llvm_decl_ccs = array_new()
        v4_codegen_llvm_decl_returns = array_new()
        v4_codegen_llvm_decl_params = array_new()
        v4_codegen_llvm_decl_lines = array_new()
        v4_codegen_llvm_call_bodies = array_new()
        v4_codegen_llvm_call_names = array_new()
        v4_codegen_llvm_call_symbols = array_new()
        v4_codegen_llvm_call_abis = array_new()
        v4_codegen_llvm_call_ccs = array_new()
        v4_codegen_llvm_call_returns = array_new()
        v4_codegen_llvm_call_exprs = array_new()
        v4_codegen_llvm_call_lines = array_new()
        v4_codegen_llvm_diags = array_new()
        v4_codegen_llvm_ready = 1
    }
}

task v4_codegen_llvm_file_new(file_id: int, mir_id: int) -> int {
    v4_codegen_llvm_init()
    pilot codegen_id = array_len(v4_codegen_llvm_files)
    array_push(v4_codegen_llvm_files, word_from_int(file_id))
    array_push(v4_codegen_llvm_mirs, word_from_int(mir_id))
    array_push(v4_codegen_llvm_decl_names, word_from_int(array_new()))
    array_push(v4_codegen_llvm_decl_symbols, word_from_int(array_new()))
    array_push(v4_codegen_llvm_decl_abis, word_from_int(array_new()))
    array_push(v4_codegen_llvm_decl_ccs, word_from_int(array_new()))
    array_push(v4_codegen_llvm_decl_returns, word_from_int(array_new()))
    array_push(v4_codegen_llvm_decl_params, word_from_int(array_new()))
    array_push(v4_codegen_llvm_decl_lines, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_bodies, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_names, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_symbols, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_abis, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_ccs, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_returns, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_exprs, word_from_int(array_new()))
    array_push(v4_codegen_llvm_call_lines, word_from_int(array_new()))
    array_push(v4_codegen_llvm_diags, word_from_int(array_new()))
    give back codegen_id
}

task v4_codegen_llvm_decl_names_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_decl_names, codegen_id))
}

task v4_codegen_llvm_decl_symbols_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_decl_symbols, codegen_id))
}

task v4_codegen_llvm_decl_abis_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_decl_abis, codegen_id))
}

