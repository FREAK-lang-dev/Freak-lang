    give back word_to_int(array_get(v4_codegen_llvm_call_symbols, codegen_id))
}

task v4_codegen_llvm_call_abis_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_call_abis, codegen_id))
}

task v4_codegen_llvm_call_ccs_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_call_ccs, codegen_id))
}

task v4_codegen_llvm_call_returns_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_call_returns, codegen_id))
}

task v4_codegen_llvm_call_exprs_handle(codegen_id: int) -> int {
    give back word_to_int(array_get(v4_codegen_llvm_call_exprs, codegen_id))
