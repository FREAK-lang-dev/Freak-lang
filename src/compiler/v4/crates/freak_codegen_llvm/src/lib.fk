task v4_codegen_llvm_starts_with(text: word, prefix: word) -> bool {
    if prefix.length() > text.length() {
        give back false
    }
    pilot idx = 0
    repeat until idx >= prefix.length() {
        if text.char_at(idx) != prefix.char_at(idx) {
            give back false
        }
        idx += 1
    }
    give back true
}

-- Codegen reads no lexer helpers (architecture lane A1); symbol spelling
-- keeps its own ASCII digit test.
task v4_codegen_llvm_is_ascii_digit(ch: word) -> bool {
    give back ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"
}

task v4_codegen_llvm_is_symbol_char(ch: word) -> bool {
    if ch == "_" { give back true }
    if ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" { give back true }
    if ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9" { give back true }
    if ch == "a" or ch == "b" or ch == "c" or ch == "d" or ch == "e" { give back true }
    if ch == "f" or ch == "g" or ch == "h" or ch == "i" or ch == "j" { give back true }
    if ch == "k" or ch == "l" or ch == "m" or ch == "n" or ch == "o" { give back true }
    if ch == "p" or ch == "q" or ch == "r" or ch == "s" or ch == "t" { give back true }
    if ch == "u" or ch == "v" or ch == "w" or ch == "x" or ch == "y" or ch == "z" { give back true }
    if ch == "A" or ch == "B" or ch == "C" or ch == "D" or ch == "E" { give back true }
    if ch == "F" or ch == "G" or ch == "H" or ch == "I" or ch == "J" { give back true }
    if ch == "K" or ch == "L" or ch == "M" or ch == "N" or ch == "O" { give back true }
    if ch == "P" or ch == "Q" or ch == "R" or ch == "S" or ch == "T" { give back true }
    if ch == "U" or ch == "V" or ch == "W" or ch == "X" or ch == "Y" or ch == "Z" { give back true }
    give back false
}

task v4_codegen_llvm_mangle_name(name: word) -> word {
    if name == "" {
        give back "anon"
    }

    pilot parts = v4_codegen_llvm_fragment_new()
    pilot idx = 0
    pilot last_was_sep = false
    repeat until idx >= name.length() {
        pilot ch = name.char_at(idx)
        if v4_codegen_llvm_is_symbol_char(ch) {
            v4_codegen_llvm_fragment_push(parts, ch)
            last_was_sep = false
        } else {
            if array_len(parts) == 0 or last_was_sep == false {
                v4_codegen_llvm_fragment_push(parts, "_")
            }
            last_was_sep = true
        }
        idx += 1
    }

    pilot out = word_join(parts)
    if out == "" {
        give back "anon"
    }
    if out.length() > 1 and out.char_at(out.length() - 1) == "_" {
        give back v4_slice(out, 0, out.length() - 1)
    }
    give back out
}

-- LLVM global names retain their exact identity. Replacing punctuation with
-- underscores would merge A_b with A::b and could rewrite explicit ABI names.
-- Local/type display names continue to use the separate mangle_name helper.
task v4_codegen_llvm_symbol(name: word) -> word {
    pilot plain: bool = name != ""
    if v4_codegen_llvm_is_ascii_digit(name.char_at(0)) { plain = false }
    pilot idx = 0
    pilot ch = name.char_at(idx)
    -- char_at addresses bytes; walk to its sentinel so UTF-8 names stay whole
    -- regardless of character-count metadata in the bootstrap runtime.
    repeat until ch == "" {
        if not v4_codegen_llvm_is_symbol_char(ch) { plain = false }
        idx += 1
        ch = name.char_at(idx)
    }
    if plain { give back "@" + name }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot escaped = ""
    idx = 0
    ch = name.char_at(idx)
    repeat until ch == "" {
        pilot byte = ch
        if ch == "\"" {
            byte = "\\22"
        } else if ch == "\\" {
            byte = "\\5C"
        } else if ch == chr(0) {
            byte = "\\00"
        } else if ch == "\n" {
            byte = "\\0A"
        } else if ch == "\r" {
            byte = "\\0D"
        } else if ch == "\t" {
            byte = "\\09"
        }
        if parts < 0 { escaped = escaped + byte } else { v4_codegen_llvm_fragment_push(parts, byte) }
        idx += 1
        ch = name.char_at(idx)
    }
    if parts >= 0 { escaped = word_join(parts) }
    give back "@\"" + escaped + "\""
}

task v4_codegen_llvm_calling_convention(abi: word) -> word {
    if abi == "" or abi == "C" or abi == "cdecl" or abi == "system" {
        give back "ccc"
    }
    if abi == "stdcall" {
        give back "x86_stdcallcc"
    }
    if abi == "fastcall" {
        give back "x86_fastcallcc"
    }
    if abi == "thiscall" {
        give back "x86_thiscallcc"
    }
    if abi == "vectorcall" {
        give back "x86_vectorcallcc"
    }
    if abi == "win64" {
        give back "win64cc"
    }
    if abi == "sysv64" {
        give back "x86_64_sysvcc"
    }
    give back "ccc"
}

task v4_codegen_llvm_ffi_call_suffix(abi: word) -> word {
    if abi == "" {
        give back ""
    }
    give back " nounwind"
}

task v4_codegen_llvm_callback_trampoline_name(task_name: word) -> word {
    give back v4_ty_extern_callback_trampoline_name(task_name)
}

task v4_codegen_llvm_callback_trampoline_symbol(task_name: word) -> word {
    give back v4_codegen_llvm_symbol(v4_codegen_llvm_callback_trampoline_name(task_name))
}

task v4_codegen_llvm_callback_trampoline_call_args(ty_id: int, sig_id: int) -> word {
    pilot count = v4_ty_signature_param_count(ty_id, sig_id)
    if count <= 0 {
        give back ""
    }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot param_idx = 0
    repeat until param_idx >= count {
        if param_idx > 0 {
            v4_codegen_llvm_fragment_push(parts, ", ")
        }
        pilot param_ty = v4_codegen_llvm_type(v4_ty_signature_param_type(ty_id, sig_id, param_idx))
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
        v4_codegen_llvm_fragment_push(parts, param_ty + " %" + v4_codegen_llvm_mangle_name(param_name))
        param_idx += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_callback_trampoline_line(mir_id: int, ty_id: int, sig_id: int, abi: word) -> word {
    if v4_codegen_llvm_signature_has_c_width_key(ty_id, sig_id) { give back v4_codegen_llvm_c_width_trampoline_line(mir_id, ty_id, sig_id, abi) }
    pilot cc = v4_codegen_llvm_calling_convention(abi)
    pilot return_ty = v4_codegen_llvm_type(v4_ty_signature_return_type(ty_id, sig_id))
    pilot named_params = v4_codegen_llvm_signature_named_params(ty_id, sig_id)
    pilot task_name = v4_ty_signature_name(ty_id, sig_id)
    pilot tramp_symbol = v4_codegen_llvm_callback_trampoline_symbol(task_name)
    pilot target_symbol = v4_codegen_llvm_callable_symbol(mir_id, v4_codegen_llvm_signature_symbol_name(ty_id, sig_id))
    pilot call_args = v4_codegen_llvm_callback_trampoline_call_args(ty_id, sig_id)
    pilot freak_cc = v4_codegen_llvm_calling_convention(v4_ty_signature_call_abi(ty_id, sig_id))

    pilot header = "define " + cc + " " + return_ty + " " + tramp_symbol + "(" + named_params + ") nounwind {\n"
    pilot body = "entry:\n"
    if return_ty == "void" {
        body = body + "  tail call " + freak_cc + " void " + target_symbol + "(" + call_args + ")\n"
        body = body + "  ret void\n"
    } else {
        body = body + "  %r = tail call " + freak_cc + " " + return_ty + " " + target_symbol + "(" + call_args + ")\n"
        body = body + "  ret " + return_ty + " %r\n"
    }
    give back header + body + "}"
}

task v4_codegen_llvm_type(ty_name: word) -> word {
    if v4_codegen_llvm_active_owned_mir >= 0 {
        pilot carrier = v4_mir_scalar_sum_kind(v4_codegen_llvm_active_owned_mir, ty_name)
        if carrier == "MaybeInt" { give back "%freak_maybe_int" }
        if carrier == "ResultWordWord" { give back "%freak_result_word_word" }
        if carrier != "" { give back v4_codegen_llvm_sum_type_name(v4_codegen_llvm_active_owned_mir, ty_name) }
    }
    -- A dyn loan (mode or type form) is its data and vtable pointers.
    if v4_codegen_llvm_active_owned_mir >= 0 and v4_codegen_llvm_is_dyn_ref(ty_name) { give back v4_codegen_llvm_dyn_ref_type() }
    if v4_codegen_llvm_active_owned_mir >= 0 and v4_codegen_llvm_is_place_lend(v4_codegen_llvm_active_owned_mir, ty_name) { give back "ptr" }
    if v4_ty_is_lend_type(ty_name) and v4_ty_lend_target_type(ty_name) == v4_ty_word { give back "i64" }
    pilot ffi_alias = v4_ty_normalize_ffi_alias_type(ty_name)
    if ffi_alias != "" {
        ty_name = ffi_alias
    }
    if ty_name == "" or ty_name == v4_ty_unknown {
        give back "ptr"
    }
    if v4_ty_is_raw_pointer_type(ty_name) {
        give back "ptr"
    }
    if v4_ty_is_surface_task_function_type(ty_name) {
        give back "ptr"
    }
    -- A closure value is its code pointer and its environment pointer.
    if v4_ty_is_closure_type(ty_name) { give back v4_codegen_llvm_closure_value_type() }
    if ty_name == v4_ty_void or ty_name == v4_ty_never {
        give back "void"
    }
    if ty_name == v4_ty_bool {
        give back "i1"
    }
    if ty_name == v4_ty_int or ty_name == v4_ty_uint {
        give back "i64"
    }
    if ty_name == v4_ty_tiny {
        give back "i8"
    }
    if ty_name == v4_ty_num or ty_name == v4_ty_float {
        give back "double"
    }
    if ty_name == v4_ty_float32 {
        give back "float"
    }
    if ty_name == v4_ty_char {
        give back "i32"
    }
    if ty_name == v4_ty_word {
        give back "i64"
    }
    if ty_name == v4_ty_big {
        give back "%freak_bigint"
    }
    if ty_name == v4_ty_never {
        give back "void"
    }
    if v4_codegen_llvm_active_owned_mir >= 0 and v4_mir_shape_signature(v4_codegen_llvm_active_owned_mir, ty_name) >= 0 {
        give back v4_codegen_llvm_shape_type_name(v4_codegen_llvm_active_owned_mir, ty_name)
    }
    if v4_codegen_llvm_is_list(v4_codegen_llvm_active_owned_mir, ty_name) { give back v4_codegen_llvm_list_header_type() }
    if v4_codegen_llvm_active_owned_mir >= 0 {
        pilot route_sig = v4_codegen_llvm_route_signature(v4_codegen_llvm_active_owned_mir, ty_name)
        if route_sig >= 0 { give back v4_codegen_llvm_route_type_name(v4_codegen_llvm_active_owned_mir, route_sig) }
    }

    if v4_ty_is_generic_instance_type(ty_name) {
        pilot base = v4_ty_generic_base_name(ty_name)
        if base == "maybe" and v4_ty_generic_arg_count(ty_name) >= 1 {
            give back "%freak_maybe_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 0))
        }
        if base == "result" and v4_ty_generic_arg_count(ty_name) >= 2 {
            give back "%freak_result_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 0)) + "_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 1))
        }
        if base == "List" and v4_ty_generic_arg_count(ty_name) >= 1 {
            give back "%freak_list_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 0))
        }
        if base == "Map" and v4_ty_generic_arg_count(ty_name) >= 2 {
            give back "%freak_map_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 0)) + "_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 1))
        }
        if base == "Set" and v4_ty_generic_arg_count(ty_name) >= 1 {
            give back "%freak_set_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 0))
        }
        if base == "Lineup" and v4_ty_generic_arg_count(ty_name) >= 1 {
            give back "%freak_lineup_" + v4_codegen_llvm_mangle_name(v4_ty_generic_arg(ty_name, 0))
        }
        give back "%" + v4_codegen_llvm_mangle_name(ty_name)
    }

    if v4_codegen_llvm_active_owned_mir >= 0 and (v4_ty_is_tuple_type(ty_name) or v4_ty_is_fixed_array_type(ty_name)) {
        give back v4_codegen_llvm_literal_aggregate_type(v4_codegen_llvm_active_owned_mir, ty_name)
    }
    if ty_name.length() > 0 and ty_name.char_at(0) == "(" {
        give back "ptr"
    }
    if ty_name.length() > 0 and ty_name.char_at(0) == "[" {
        give back "ptr"
    }
    give back "%" + v4_codegen_llvm_mangle_name(ty_name)
}

task v4_codegen_llvm_signature_params(ty_id: int, sig_id: int) -> word {
    pilot count = v4_ty_signature_fixed_param_count(ty_id, sig_id)
    pilot variadic = v4_ty_signature_is_variadic(ty_id, sig_id)
    if count <= 0 and variadic == false {
        give back ""
    }

    pilot c_width: bool = v4_codegen_llvm_signature_has_c_width_markers(ty_id, sig_id)
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot param_idx = 0
    repeat until param_idx >= count {
        if param_idx > 0 {
            v4_codegen_llvm_fragment_push(parts, ", ")
        }
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_width_param_text(ty_id, sig_id, param_idx, c_width))
        param_idx += 1
    }
    if variadic {
        if count > 0 {
            v4_codegen_llvm_fragment_push(parts, ", ")
        }
        v4_codegen_llvm_fragment_push(parts, "...")
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- C scalar widths (tier 3, roadmap M6). TY carries the std::ffi C integer
-- aliases as FREAK int/uint/tiny/bool. A direct extern declaration keeps a
-- `$P.key$` / `$R.key$` marker in the target-neutral plan; module_text
-- replaces it with the target's C carrier and extension attribute and adds an
-- internal shim with the FREAK signature. FREAK call sites call the shim,
-- which checks every narrowing conversion, calls C, and widens the result.
task v4_codegen_llvm_c_width_key(surface: word) -> word {
    pilot name = v4_ty_surface_ffi_alias_name(surface)
    if name == "c_int" or name == "c_uint" or name == "c_long" or name == "c_ulong" or name == "c_short" or name == "c_ushort" { give back name }
    if name == "c_char" or name == "c_uchar" or name == "c_bool" { give back name }
    give back ""
}

-- A body-less C declaration (an extern block member or extern task).
task v4_codegen_llvm_signature_is_extern_decl(ty_id: int, sig_id: int) -> bool {
    if v4_ty_signature_call_abi(ty_id, sig_id) == "" or v4_ty_signature_has_extern_callback(ty_id, sig_id) { give back false }
    give back v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig or v4_ty_signature_extern_member_id(ty_id, sig_id) >= 0
}

task v4_codegen_llvm_signature_has_c_width_key(ty_id: int, sig_id: int) -> bool {
    if v4_codegen_llvm_c_width_key(v4_ty_signature_return_surface_type(ty_id, sig_id)) != "" { give back true }
    pilot param = 0
    repeat until param >= v4_ty_signature_fixed_param_count(ty_id, sig_id) {
        if v4_codegen_llvm_c_width_key(v4_ty_signature_param_surface_type(ty_id, sig_id, param)) != "" { give back true }
        param += 1
    }
    give back false
}

-- Non-variadic C-width declarations get a FREAK-signature shim; variadic
-- ones are called through the C call plan (no shim can forward `...`).
task v4_codegen_llvm_signature_is_c_width_decl(ty_id: int, sig_id: int) -> bool {
    if not v4_codegen_llvm_signature_is_extern_decl(ty_id, sig_id) or v4_ty_signature_is_variadic(ty_id, sig_id) { give back false }
    give back v4_codegen_llvm_signature_has_c_width_key(ty_id, sig_id)
}

-- The declaration line carries `$P.key$` / `$R.key$` markers.
task v4_codegen_llvm_signature_has_c_width_markers(ty_id: int, sig_id: int) -> bool {
    if not v4_codegen_llvm_signature_is_extern_decl(ty_id, sig_id) { give back false }
    give back v4_codegen_llvm_signature_has_c_width_key(ty_id, sig_id)
}

-- Signatures whose spelled C-width parameters and return are lowered at C
-- width: extern declarations and @extern_callback tasks with a trampoline.
task v4_codegen_llvm_signature_lowers_c_widths(ty_id: int, sig_id: int) -> bool {
    if v4_codegen_llvm_signature_is_extern_decl(ty_id, sig_id) { give back true }
    give back v4_codegen_llvm_should_emit_callback_trampoline(ty_id, sig_id)
}

task v4_codegen_llvm_c_width_param_text(ty_id: int, sig_id: int, param: int, c_width: bool) -> word {
    if c_width {
        pilot key = v4_codegen_llvm_c_width_key(v4_ty_signature_param_surface_type(ty_id, sig_id, param))
        if key != "" { give back "$P." + key + "$" }
    }
    give back v4_codegen_llvm_type(v4_ty_signature_param_type(ty_id, sig_id, param))
}

task v4_codegen_llvm_signature_return_text(ty_id: int, sig_id: int) -> word {
    if v4_codegen_llvm_signature_has_c_width_markers(ty_id, sig_id) {
        pilot key = v4_codegen_llvm_c_width_key(v4_ty_signature_return_surface_type(ty_id, sig_id))
        if key != "" { give back "$R." + key + "$" }
    }
    give back v4_codegen_llvm_type(v4_ty_signature_return_type(ty_id, sig_id))
}

task v4_codegen_llvm_c_width_shim_symbol(symbol: word) -> word {
    if symbol.starts_with("@\"") { give back "@\"freak.cabi." + v4_slice(symbol, 2, symbol.length()) }
    give back v4_codegen_llvm_symbol("freak.cabi." + v4_slice(symbol, 1, symbol.length()))
}

-- Direct calls to a C-width declaration go through its shim.
task v4_codegen_llvm_call_signature_symbol(mir_id: int, ty_id: int, sig_id: int) -> word {
    pilot symbol = v4_codegen_llvm_signature_symbol(mir_id, ty_id, sig_id)
    if v4_codegen_llvm_signature_is_c_width_decl(ty_id, sig_id) { give back v4_codegen_llvm_c_width_shim_symbol(symbol) }
    give back symbol
}

task v4_codegen_llvm_c_width_marker_key(part: word) -> word {
    if part.length() < 5 or v4_slice(part, part.length() - 1, part.length()) != "$" { give back "" }
    if not part.starts_with("$P.") and not part.starts_with("$R.") and not part.starts_with("$T.") { give back "" }
    give back v4_slice(part, 3, part.length() - 1)
}

-- The FREAK carrier TY gives each admitted key.
task v4_codegen_llvm_c_width_freak_carrier(key: word) -> word {
    if key == "c_bool" { give back "i1" }
    if key == "c_char" or key == "c_uchar" { give back "i8" }
    give back "i64"
}

-- The declared C type of one plan part, with its extension attribute where
-- LLVM wants it (before a return type, after a parameter type).
task v4_codegen_llvm_c_width_declared(part: word, target_spec: word) -> word {
    pilot key = v4_codegen_llvm_c_width_marker_key(part)
    if key == "" { give back part }
    pilot carrier = v4_target_c_scalar_carrier(target_spec, key)
    pilot ext = v4_target_c_scalar_extension(target_spec, key)
    if ext == "" { give back carrier }
    if part.starts_with("$R.") { give back ext + " " + carrier }
    give back carrier + " " + ext
}

task v4_codegen_llvm_c_width_check_symbol(carrier: word, is_signed: bool) -> word {
    if is_signed { give back "@freak_v4_cabi_check_int" + v4_slice(carrier, 1, carrier.length()) }
    give back "@freak_v4_cabi_check_uint" + v4_slice(carrier, 1, carrier.length())
}

task v4_codegen_llvm_c_width_runtime_declarations() -> word {
    pilot out = ""
    pilot width = 0
    repeat until width >= 2 {
        pilot carrier = "i32"
        if width == 1 { carrier = "i16" }
        out = out + "declare i64 " + v4_codegen_llvm_c_width_check_symbol(carrier, true) + "(i64)\n"
        out = out + "declare i64 " + v4_codegen_llvm_c_width_check_symbol(carrier, false) + "(i64)\n"
        width += 1
    }
    give back out
}

task v4_codegen_llvm_decl_has_c_width(codegen_id: int, decl_id: int) -> bool {
    give back v4_codegen_llvm_decl_return(codegen_id, decl_id).starts_with("$R.") or v4_codegen_llvm_decl_params(codegen_id, decl_id).contains("$P.")
}

-- Plan parameter lists are ", "-separated LLVM scalar types or markers.
task v4_codegen_llvm_c_width_part_end(text: word, start: int) -> int {
    pilot found = v4_index_of_from(text, ",", start)
    if found < 0 { give back text.length() }
    give back found
}

task v4_codegen_llvm_c_width_part_error(part: word, target_spec: word) -> word {
    pilot key = v4_codegen_llvm_c_width_marker_key(part)
    if key == "" { give back "" }
    if v4_target_c_scalar_carrier(target_spec, key) == "" or v4_target_c_scalar_signedness(target_spec, key) < 0 { give back "native C scalar width is not available for this target: " + key }
    give back ""
}

task v4_codegen_llvm_c_width_target_error(codegen_id: int, target_spec: word) -> word {
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
        if v4_codegen_llvm_decl_has_c_width(codegen_id, decl_id) {
            pilot error = v4_codegen_llvm_c_width_part_error(v4_codegen_llvm_decl_return(codegen_id, decl_id), target_spec)
            if error != "" { give back error }
            pilot params_text = v4_codegen_llvm_decl_params(codegen_id, decl_id)
            pilot start = 0
            repeat until start >= params_text.length() {
                pilot stop = v4_codegen_llvm_c_width_part_end(params_text, start)
                error = v4_codegen_llvm_c_width_part_error(v4_slice(params_text, start, stop), target_spec)
                if error != "" { give back error }
                start = stop + 2
            }
        }
        decl_id += 1
    }
    give back ""
}

-- One real declaration at the target's C widths plus the internal shim that
-- FREAK call sites use. Narrowing goes through the checked runtime helpers;
-- the C result widens by the C type's signedness.
task v4_codegen_llvm_c_width_module_lines(codegen_id: int, decl_id: int, target_spec: word) -> word {
    pilot cc = v4_codegen_llvm_decl_cc(codegen_id, decl_id)
    pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl_id)
    pilot ret = v4_codegen_llvm_decl_return(codegen_id, decl_id)
    pilot params_text = v4_codegen_llvm_decl_params(codegen_id, decl_id)
    pilot suffix = v4_codegen_llvm_ffi_call_suffix(v4_codegen_llvm_decl_abi(codegen_id, decl_id))
    pilot line = v4_codegen_llvm_decl_line(codegen_id, decl_id)
    pilot noreturn: bool = v4_slice(line, line.length() - 9, line.length()) == " noreturn"
    if noreturn { suffix = suffix + " noreturn" }
    pilot declared = ""
    pilot shim_params = ""
    pilot body = ""
    pilot args = ""
    pilot index = 0
    pilot start = 0
    repeat until start >= params_text.length() {
        pilot stop = v4_codegen_llvm_c_width_part_end(params_text, start)
        pilot part = v4_slice(params_text, start, stop)
        pilot sep = ""
        if index > 0 { sep = ", " }
        pilot slot = word_from_int(index)
        pilot arg = "%a" + slot
        pilot key = v4_codegen_llvm_c_width_marker_key(part)
        pilot shim_ty = part
        if key != "" {
            shim_ty = v4_codegen_llvm_c_width_freak_carrier(key)
            pilot carrier = v4_target_c_scalar_carrier(target_spec, key)
            if carrier != shim_ty {
                body = body + "  %k" + slot + " = call i64 " + v4_codegen_llvm_c_width_check_symbol(carrier, v4_target_c_scalar_signedness(target_spec, key) == 1) + "(i64 " + arg + ")\n"
                body = body + "  %c" + slot + " = trunc i64 %k" + slot + " to " + carrier + "\n"
                arg = "%c" + slot
            }
        }
        pilot c_part = v4_codegen_llvm_c_width_declared(part, target_spec)
        declared = declared + sep + c_part
        shim_params = shim_params + sep + shim_ty + " %a" + slot
        args = args + sep + c_part + " " + arg
        index += 1
        start = stop + 2
    }
    pilot ret_key = v4_codegen_llvm_c_width_marker_key(ret)
    pilot shim_ret = ret
    pilot ret_carrier = ret
    if ret_key != "" {
        shim_ret = v4_codegen_llvm_c_width_freak_carrier(ret_key)
        ret_carrier = v4_target_c_scalar_carrier(target_spec, ret_key)
    }
    pilot c_ret = v4_codegen_llvm_c_width_declared(ret, target_spec)
    pilot call = "call " + cc + " " + c_ret + " " + symbol + "(" + args + ")" + suffix
    if ret == "void" {
        body = body + "  " + call + "\n"
        if noreturn { body = body + "  unreachable\n" } else { body = body + "  ret void\n" }
    } else if ret_carrier != shim_ret {
        pilot widen = "zext"
        if v4_target_c_scalar_signedness(target_spec, ret_key) == 1 { widen = "sext" }
        body = body + "  %r = " + call + "\n  %w = " + widen + " " + ret_carrier + " %r to " + shim_ret + "\n  ret " + shim_ret + " %w\n"
    } else {
        body = body + "  %r = " + call + "\n  ret " + shim_ret + " %r\n"
    }
    pilot attrs = " alwaysinline nounwind"
    if noreturn { attrs = attrs + " noreturn" }
    pilot out = "declare " + cc + " " + c_ret + " " + symbol + "(" + declared + ")" + suffix + "\n"
    give back out + "define internal " + cc + " " + shim_ret + " " + v4_codegen_llvm_c_width_shim_symbol(symbol) + "(" + shim_params + ")" + attrs + " {\nentry:\n" + body + "}\n"
}

-- C call plan (tier 3 C ABI rows: default argument promotions, native C
-- variadic calls, callbacks over the widened scalar set). Two kinds of C
-- call are emitted at the call site instead of through a FREAK-signature
-- shim: a direct call to a variadic extern declaration (1) and a call
-- through an extern function pointer whose spelled parameters or return use
-- a C width (2). Fixed C-width arguments narrow through
-- `@freak.cabi.narrow.KEY` and a C-width result widens through
-- `@freak.cabi.widen.KEY`; module_text defines those helpers per target and
-- replaces each `$T.KEY$` (C carrier), `$P.KEY$` (carrier plus parameter
-- extension) and `$R.KEY$` (return extension plus carrier) marker, so the
-- plan stays target-neutral. A variadic call uses the `RET (FIXED, ...)`
-- call form, and each `...` argument is promoted to the C type TY names
-- (v4_ty_variadic_arg_c_type); LLVM then lowers the target's variadic
-- convention (Apple arm64 passes varargs on the stack, Win64 duplicates
-- floating varargs in integer registers).
task v4_codegen_llvm_c_call_plan(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call { give back 0 }
    pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id)
    if target_rvalue >= 0 {
        pilot fn_ty = v4_mir_rvalue_ty(mir_id, body_id, target_rvalue)
        if not v4_ty_is_surface_extern_function_pointer_type(fn_ty) { give back 0 }
        if v4_codegen_llvm_c_width_key(v4_ty_function_type_return_text(fn_ty)) != "" { give back 2 }
        pilot param = 0
        repeat until param >= v4_ty_function_type_fixed_param_count(fn_ty) {
            if v4_codegen_llvm_c_width_key(v4_ty_function_type_param_surface(fn_ty, param)) != "" { give back 2 }
            param += 1
        }
        give back 0
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig = v4_ty_task_signature_id_for_name(ty_id, v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
    if sig < 0 or not v4_ty_signature_is_variadic(ty_id, sig) or not v4_codegen_llvm_signature_is_extern_decl(ty_id, sig) { give back 0 }
    give back 1
}

task v4_codegen_llvm_c_call_fixed_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id)
    if target_rvalue >= 0 { give back v4_ty_function_type_fixed_param_count(v4_mir_rvalue_ty(mir_id, body_id, target_rvalue)) }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_signature_fixed_param_count(ty_id, v4_ty_task_signature_id_for_name(ty_id, v4_mir_rvalue_op(mir_id, body_id, rvalue_id)))
}

-- The spelled surface of fixed parameter `param` (or the return, param < 0).
task v4_codegen_llvm_c_call_surface(mir_id: int, body_id: int, rvalue_id: int, param: int) -> word {
    pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id)
    if target_rvalue >= 0 {
        pilot fn_ty = v4_mir_rvalue_ty(mir_id, body_id, target_rvalue)
        if param < 0 { give back v4_ty_function_type_return_text(fn_ty) }
        give back v4_ty_function_type_param_surface(fn_ty, param)
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig = v4_ty_task_signature_id_for_name(ty_id, v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
    if param < 0 { give back v4_ty_signature_return_surface_type(ty_id, sig) }
    give back v4_ty_signature_param_surface_type(ty_id, sig, param)
}

task v4_codegen_llvm_c_call_key(mir_id: int, body_id: int, rvalue_id: int, param: int) -> word {
    if v4_codegen_llvm_c_call_plan(mir_id, body_id, rvalue_id) == 0 { give back "" }
    if param >= v4_codegen_llvm_c_call_fixed_count(mir_id, body_id, rvalue_id) { give back "" }
    give back v4_codegen_llvm_c_width_key(v4_codegen_llvm_c_call_surface(mir_id, body_id, rvalue_id, param))
}

task v4_codegen_llvm_c_call_is_vararg(mir_id: int, body_id: int, rvalue_id: int, arg_id: int) -> bool {
    give back v4_codegen_llvm_c_call_plan(mir_id, body_id, rvalue_id) == 1 and arg_id >= v4_codegen_llvm_c_call_fixed_count(mir_id, body_id, rvalue_id)
}

-- LLVM carrier of a promoted vararg. C int and unsigned int are 32 bits on
-- every registered target; v4_codegen_llvm_c_call_target_error re-checks
-- that per target.
task v4_codegen_llvm_c_vararg_carrier(c_type: word) -> word {
    if c_type == "c_int" or c_type == "c_uint" { give back "i32" }
    if c_type == "c_longlong" or c_type == "c_ulonglong" { give back "i64" }
    if c_type == "c_double" { give back "double" }
    if c_type == "pointer" { give back "ptr" }
    give back ""
}

task v4_codegen_llvm_c_vararg_type(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    give back v4_codegen_llvm_c_vararg_carrier(v4_ty_variadic_arg_c_type(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)))
}

task v4_codegen_llvm_c_narrow_temp(body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    give back "%cn" + word_from_int(body_id) + "_" + word_from_int(call_rvalue_id) + "_" + word_from_int(arg_id)
}

-- Prelude of one argument of a planned C call: a vararg is promoted (zext of
-- bool/tiny to C int, fpext of float32 to double); a fixed argument takes the
-- ordinary checked FREAK conversion and then, for a C width, the narrowing.
task v4_codegen_llvm_c_call_arg_prelude(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    pilot value = v4_codegen_llvm_rvalue_value(mir_id, body_id, arg_rvalue)
    if v4_codegen_llvm_c_call_is_vararg(mir_id, body_id, call_rvalue_id, arg_id) {
        pilot actual = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue))
        pilot carrier = v4_codegen_llvm_c_vararg_type(mir_id, body_id, call_rvalue_id, arg_id)
        pilot temp = v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id)
        if actual == carrier { give back "" }
        if actual == "float" and carrier == "double" { give back "  " + temp + " = fpext float " + value + " to double\n" }
        give back "  " + temp + " = zext " + actual + " " + value + " to " + carrier + "\n"
    }
    pilot expected = v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id)
    pilot temp = v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id)
    pilot out = v4_codegen_llvm_expected_lines(mir_id, body_id, arg_rvalue, expected, temp)
    pilot key = v4_codegen_llvm_c_call_key(mir_id, body_id, call_rvalue_id, arg_id)
    if key == "" { give back out }
    pilot carried = v4_codegen_llvm_expected_value(mir_id, body_id, arg_rvalue, expected, temp)
    give back out + "  " + v4_codegen_llvm_c_narrow_temp(body_id, call_rvalue_id, arg_id) + " = call $T." + key + "$ @freak.cabi.narrow." + key + "(" + v4_codegen_llvm_c_width_freak_carrier(key) + " " + carried + ")\n"
}

task v4_codegen_llvm_c_call_arg_operand(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    if v4_codegen_llvm_c_call_is_vararg(mir_id, body_id, call_rvalue_id, arg_id) {
        pilot carrier = v4_codegen_llvm_c_vararg_type(mir_id, body_id, call_rvalue_id, arg_id)
        if v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)) == carrier { give back carrier + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, arg_rvalue) }
        give back carrier + " " + v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id)
    }
    pilot key = v4_codegen_llvm_c_call_key(mir_id, body_id, call_rvalue_id, arg_id)
    if key != "" { give back "$P." + key + "$ " + v4_codegen_llvm_c_narrow_temp(body_id, call_rvalue_id, arg_id) }
    pilot expected = v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id)
    give back v4_codegen_llvm_type(expected) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, arg_rvalue, expected, v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id))
}

-- `call CC RET [(FIXED, ...)] CALLEE(ARGS)`; a C-width result widens to its
-- FREAK carrier after the call. `$R.KEY$` puts the return extension before
-- the carrier, which is also where LLVM wants it before a call's function
-- type.
task v4_codegen_llvm_c_call_instruction(mir_id: int, body_id: int, rvalue_id: int, call_cc: word, call_symbol: word, call_abi: word, target: word) -> word {
    pilot ret_key = v4_codegen_llvm_c_width_key(v4_codegen_llvm_c_call_surface(mir_id, body_id, rvalue_id, 0 - 1))
    pilot call_return = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    pilot ret_text = call_return
    if ret_key != "" { ret_text = "$R." + ret_key + "$" }
    pilot fnty = ""
    if v4_codegen_llvm_c_call_plan(mir_id, body_id, rvalue_id) == 1 {
        pilot ty_id = v4_mir_ty_id(mir_id)
        pilot sig = v4_ty_task_signature_id_for_name(ty_id, v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
        fnty = " ("
        pilot param = 0
        repeat until param >= v4_ty_signature_fixed_param_count(ty_id, sig) {
            pilot key = v4_codegen_llvm_c_width_key(v4_ty_signature_param_surface_type(ty_id, sig, param))
            if key != "" { fnty = fnty + "$T." + key + "$, " } else { fnty = fnty + v4_codegen_llvm_type(v4_ty_signature_param_type(ty_id, sig, param)) + ", " }
            param += 1
        }
        fnty = fnty + "...)"
    }
    pilot call_text = "call " + call_cc + " " + ret_text + fnty + " " + call_symbol + "(" + v4_codegen_llvm_call_args(mir_id, body_id, rvalue_id) + ")" + v4_codegen_llvm_ffi_call_suffix(call_abi)
    if target == "" or call_return == "void" { give back call_text }
    if ret_key == "" { give back target + " = " + call_text }
    pilot raw = target + ".c"
    give back raw + " = " + call_text + "\n  " + target + " = call " + call_return + " @freak.cabi.widen." + ret_key + "($T." + ret_key + "$ " + raw + ")"
}

task v4_codegen_llvm_c_width_key_at(index: int) -> word {
    if index == 0 { give back "c_int" }
    if index == 1 { give back "c_uint" }
    if index == 2 { give back "c_long" }
    if index == 3 { give back "c_ulong" }
    if index == 4 { give back "c_short" }
    if index == 5 { give back "c_ushort" }
    if index == 6 { give back "c_char" }
    if index == 7 { give back "c_uchar" }
    if index == 8 { give back "c_bool" }
    give back ""
}

-- The per-target narrowing and widening helpers the C call plan and the
-- C-width trampolines call. Narrowing is checked exactly like the
-- declaration shims; widening follows the C type's signedness.
task v4_codegen_llvm_c_call_helper_lines(target_spec: word) -> word {
    pilot out = ""
    pilot index = 0
    repeat until v4_codegen_llvm_c_width_key_at(index) == "" {
        pilot key = v4_codegen_llvm_c_width_key_at(index)
        pilot carrier = v4_target_c_scalar_carrier(target_spec, key)
        pilot freak = v4_codegen_llvm_c_width_freak_carrier(key)
        pilot is_signed: bool = v4_target_c_scalar_signedness(target_spec, key) == 1
        out = out + "define internal " + carrier + " @freak.cabi.narrow." + key + "(" + freak + " %v) alwaysinline nounwind {\nentry:\n"
        if carrier == freak { out = out + "  ret " + freak + " %v\n}\n" } else {
            out = out + "  %k = call i64 " + v4_codegen_llvm_c_width_check_symbol(carrier, is_signed) + "(i64 %v)\n  %c = trunc i64 %k to " + carrier + "\n  ret " + carrier + " %c\n}\n"
        }
        out = out + "define internal " + freak + " @freak.cabi.widen." + key + "(" + carrier + " %v) alwaysinline nounwind {\nentry:\n"
        if carrier == freak { out = out + "  ret " + freak + " %v\n}\n" } else {
            pilot widen = "zext"
            if is_signed { widen = "sext" }
            out = out + "  %w = " + widen + " " + carrier + " %v to " + freak + "\n  ret " + freak + " %w\n}\n"
        }
        index += 1
    }
    give back out
}

task v4_codegen_llvm_c_width_text_has_markers(text: word) -> bool {
    give back text.contains("$T.") or text.contains("$P.") or text.contains("$R.")
}

-- Replace every `$T.KEY$`, `$P.KEY$` and `$R.KEY$` marker in one body or
-- declaration line with the target's answer.
task v4_codegen_llvm_c_width_resolve_text(text: word, target_spec: word) -> word {
    if not v4_codegen_llvm_c_width_text_has_markers(text) { give back text }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot emitted = 0
    pilot start = v4_index_of_from(text, "$", 0)
    repeat until start < 0 {
        pilot stop = v4_index_of_from(text, "$", start + 1)
        if stop < 0 { start = 0 - 1 } else {
            pilot part = v4_slice(text, start, stop + 1)
            pilot key = v4_codegen_llvm_c_width_marker_key(part)
            if key != "" and v4_codegen_llvm_c_width_key_known(key) and v4_target_c_scalar_carrier(target_spec, key) != "" {
                v4_codegen_llvm_fragment_push(parts, v4_slice(text, emitted, start))
                if part.starts_with("$T.") { v4_codegen_llvm_fragment_push(parts, v4_target_c_scalar_carrier(target_spec, key)) } else { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_width_declared(part, target_spec)) }
                emitted = stop + 1
                start = v4_index_of_from(text, "$", emitted)
            } else { start = stop }
        }
    }
    v4_codegen_llvm_fragment_push(parts, v4_slice(text, emitted, text.length()))
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_c_width_key_known(key: word) -> bool {
    pilot index = 0
    repeat until v4_codegen_llvm_c_width_key_at(index) == "" {
        if v4_codegen_llvm_c_width_key_at(index) == key { give back true }
        index += 1
    }
    give back false
}

-- Bodies with C call plan markers need every C width and a 32-bit C int
-- (the promoted vararg carrier) on the target.
task v4_codegen_llvm_c_call_target_error(codegen_id: int, target_spec: word) -> word {
    pilot body_id = 0
    repeat until body_id >= v4_codegen_llvm_body_count(codegen_id) {
        if v4_codegen_llvm_c_width_text_has_markers(v4_codegen_llvm_body_line(codegen_id, body_id)) or v4_codegen_llvm_body_line(codegen_id, body_id).contains(", ...)") {
            pilot index = 0
            repeat until v4_codegen_llvm_c_width_key_at(index) == "" {
                pilot key = v4_codegen_llvm_c_width_key_at(index)
                if v4_target_c_scalar_carrier(target_spec, key) == "" or v4_target_c_scalar_signedness(target_spec, key) < 0 { give back "native C scalar width is not available for this target: " + key }
                index += 1
            }
            if v4_target_c_scalar_carrier(target_spec, "c_int") != "i32" or v4_target_c_scalar_carrier(target_spec, "c_uint") != "i32" { give back "native C variadic promotion needs a 32-bit C int on this target" }
            give back ""
        }
        body_id += 1
    }
    give back ""
}

-- An @extern_callback trampoline whose spelled signature uses C widths:
-- C calls it at C width, it widens each such argument to the FREAK carrier,
-- calls the FREAK task, and narrows the result (checked).
task v4_codegen_llvm_c_width_trampoline_line(mir_id: int, ty_id: int, sig_id: int, abi: word) -> word {
    pilot cc = v4_codegen_llvm_calling_convention(abi)
    pilot task_name = v4_ty_signature_name(ty_id, sig_id)
    pilot target_symbol = v4_codegen_llvm_callable_symbol(mir_id, v4_codegen_llvm_signature_symbol_name(ty_id, sig_id))
    pilot freak_cc = v4_codegen_llvm_calling_convention(v4_ty_signature_call_abi(ty_id, sig_id))
    pilot params = ""
    pilot body = "entry:\n"
    pilot args = ""
    pilot param = 0
    repeat until param >= v4_ty_signature_param_count(ty_id, sig_id) {
        pilot sep = ""
        if param > 0 { sep = ", " }
        pilot name = "%" + v4_codegen_llvm_mangle_name(v4_ty_signature_param_name(ty_id, sig_id, param))
        pilot freak_ty = v4_codegen_llvm_type(v4_ty_signature_param_type(ty_id, sig_id, param))
        pilot key = v4_codegen_llvm_c_width_key(v4_ty_signature_param_surface_type(ty_id, sig_id, param))
        if key == "" {
            params = params + sep + freak_ty + " " + name
            args = args + sep + freak_ty + " " + name
        } else {
            params = params + sep + "$P." + key + "$ " + name
            body = body + "  " + name + ".w = call " + freak_ty + " @freak.cabi.widen." + key + "($T." + key + "$ " + name + ")\n"
            args = args + sep + freak_ty + " " + name + ".w"
        }
        param += 1
    }
    pilot freak_ret = v4_codegen_llvm_type(v4_ty_signature_return_type(ty_id, sig_id))
    pilot ret_key = v4_codegen_llvm_c_width_key(v4_ty_signature_return_surface_type(ty_id, sig_id))
    pilot c_ret = freak_ret
    if ret_key != "" { c_ret = "$R." + ret_key + "$" }
    pilot call = "call " + freak_cc + " " + freak_ret + " " + target_symbol + "(" + args + ")"
    if freak_ret == "void" { body = body + "  " + call + "\n  ret void\n" } else if ret_key == "" { body = body + "  %r = " + call + "\n  ret " + freak_ret + " %r\n" } else {
        body = body + "  %r = " + call + "\n  %n = call $T." + ret_key + "$ @freak.cabi.narrow." + ret_key + "(" + freak_ret + " %r)\n  ret $T." + ret_key + "$ %n\n"
    }
    give back "define " + cc + " " + c_ret + " " + v4_codegen_llvm_callback_trampoline_symbol(task_name) + "(" + params + ") nounwind {\n" + body + "}"
}

task v4_codegen_llvm_signature_named_params(ty_id: int, sig_id: int) -> word {
    pilot count = v4_ty_signature_param_count(ty_id, sig_id)
    if count <= 0 {
        give back ""
    }

    pilot parts = v4_codegen_llvm_fragment_new()
    pilot param_idx = 0
    repeat until param_idx >= count {
        if param_idx > 0 {
            v4_codegen_llvm_fragment_push(parts, ", ")
        }
        pilot param_ty = v4_codegen_llvm_type(v4_ty_signature_param_type(ty_id, sig_id, param_idx))
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
        v4_codegen_llvm_fragment_push(parts, param_ty + " %" + v4_codegen_llvm_mangle_name(param_name))
        param_idx += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- Generic instances (tier 3). A task with type parameters has no LLVM
-- definition of its own: MIR lowers one instance body per substitution, and
-- those bodies (not the template body, not its TY signature) are emitted.
task v4_codegen_llvm_next_emitted_body(mir_id: int, body_id: int) -> int {
    pilot body = body_id
    repeat until body >= v4_mir_body_count(mir_id) or not v4_mir_body_is_generic_template(mir_id, body) { body += 1 }
    give back body
}

task v4_codegen_llvm_signature_is_callable(ty_id: int, sig_id: int) -> bool {
    pilot sig_kind = v4_ty_signature_kind(ty_id, sig_id)
    if sig_kind == v4_ty_task_sig {
        give back v4_ty_signature_type_generic_count(ty_id, sig_id) == 0
    }
    if sig_kind == v4_ty_extern_sig {
        give back v4_codegen_llvm_starts_with(v4_ty_signature_display(ty_id, sig_id), "task ")
    }
    give back false
}

task v4_codegen_llvm_signature_symbol_name(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_symbol_name(ty_id, sig_id)
}

-- Explicit extern ABI names must bypass the private source-main rewrite.
task v4_codegen_llvm_signature_symbol(mir_id: int, ty_id: int, sig_id: int) -> word {
    pilot name = v4_codegen_llvm_signature_symbol_name(ty_id, sig_id)
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_extern_sig or v4_ty_signature_extern_member_id(ty_id, sig_id) >= 0 {
        give back v4_codegen_llvm_symbol(name)
    }
    give back v4_codegen_llvm_callable_symbol(mir_id, name)
}

task v4_codegen_llvm_signature_link_name(ty_id: int, sig_id: int) -> word {
    give back v4_ty_signature_link_library(ty_id, sig_id)
}

task v4_codegen_llvm_signature_line(mir_id: int, ty_id: int, sig_id: int) -> word {
    pilot line_kind = "declare"
    if v4_ty_signature_kind(ty_id, sig_id) == v4_ty_task_sig {
        pilot body_id = v4_mir_lookup_body(mir_id, v4_ty_signature_def(ty_id, sig_id))
        if body_id >= 0 {
            line_kind = "define"
        }
    }

    pilot abi = v4_ty_signature_call_abi(ty_id, sig_id)
    pilot cc = v4_codegen_llvm_calling_convention(abi)
    pilot return_ty = v4_codegen_llvm_signature_return_text(ty_id, sig_id)
    pilot params = v4_codegen_llvm_signature_params(ty_id, sig_id)
    pilot symbol = v4_codegen_llvm_signature_symbol(mir_id, ty_id, sig_id)
    pilot suffix = ""
    if line_kind == "declare" and abi != "" {
        suffix = v4_codegen_llvm_ffi_call_suffix(abi)
    }
    if v4_ty_signature_return_type(ty_id, sig_id) == v4_ty_never { suffix = suffix + " noreturn" }
    give back line_kind + " " + cc + " " + return_ty + " " + symbol + "(" + params + ")" + suffix
}

task v4_codegen_llvm_file_mir_id(codegen_id: int) -> int {
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_mirs) { give back 0 - 1 }
    give back word_to_int(array_get(v4_codegen_llvm_mirs, codegen_id))
}

-- Globals start zeroed; the module initializer stores their initial values.
task v4_codegen_llvm_global_definition_lines(mir_id: int) -> word {
    if mir_id < 0 { give back "" }
    pilot out = ""
    pilot idx = 0
    pilot count = v4_mir_global_count(mir_id)
    repeat until idx >= count {
        out = out + v4_codegen_llvm_global_symbol(v4_mir_global_name(mir_id, idx)) + " = internal global " + v4_codegen_llvm_type(v4_mir_global_ty(mir_id, idx)) + " zeroinitializer\n"
        idx += 1
    }
    if out != "" { out = out + "\n" }
    give back out
}

-- A root global shares the LLVM global namespace with every callable.
task v4_codegen_llvm_native_global_symbol_error(codegen_id: int, mir_id: int) -> word {
    pilot idx = 0
    pilot count = v4_mir_global_count(mir_id)
    repeat until idx >= count {
        pilot symbol = v4_codegen_llvm_global_symbol(v4_mir_global_name(mir_id, idx))
        if v4_codegen_llvm_body_symbol_linear_contains(codegen_id, symbol) { give back "native global symbol conflicts with " + symbol }
        pilot decl_id = 0
        repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
            if v4_codegen_llvm_decl_symbol(codegen_id, decl_id) == symbol { give back "native global symbol conflicts with explicit ABI declaration: " + symbol }
            decl_id += 1
        }
        idx += 1
    }
    give back ""
}

task v4_codegen_llvm_global_symbol(name: word) -> word {
    give back v4_codegen_llvm_symbol("freak.global." + name)
}

task v4_codegen_llvm_rvalue_is_global_read(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_use_symbol { give back false }
    give back v4_mir_symbol_is_global(mir_id, v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
}

task v4_codegen_llvm_temp_value(body_id: int, rvalue_id: int) -> word {
    give back "%rv." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

task v4_codegen_llvm_local_slot(local_id: int) -> word {
    give back "%local." + word_from_int(local_id) + ".addr"
}

-- The source entry remains a normal FREAK task. Only the generated C entry
-- knows argc/argv and the runtime setup ABI; calls to source main stay FREAK.
task v4_codegen_llvm_callable_symbol(mir_id: int, name: word) -> word {
    if name == "main" and v4_codegen_llvm_find_mir_body(mir_id, name) >= 0 {
        give back "@freak.user.main"
    }
    give back v4_codegen_llvm_symbol(name)
}

task v4_codegen_llvm_word_literal_symbol(body_id: int, rvalue_id: int) -> word {
    give back "@.str." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

-- Escape semantic bytes for LLVM, never decode source escapes here.
task v4_codegen_llvm_word_literal_escape(text: word) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot ch = text.char_at(idx)
        if ch == chr(0) { v4_codegen_llvm_fragment_push(parts, "\\00") } else if ch == "\n" { v4_codegen_llvm_fragment_push(parts, "\\0A") } else if ch == "\r" { v4_codegen_llvm_fragment_push(parts, "\\0D") } else if ch == "\t" { v4_codegen_llvm_fragment_push(parts, "\\09") } else if ch == "\"" { v4_codegen_llvm_fragment_push(parts, "\\22") } else if ch == "\\" { v4_codegen_llvm_fragment_push(parts, "\\5C") } else { v4_codegen_llvm_fragment_push(parts, ch) }
        idx += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_rvalue_local(mir_id: int, body_id: int, rvalue_id: int) -> int {
    give back v4_mir_rvalue_local_id(mir_id, body_id, rvalue_id)
}

task v4_codegen_llvm_char_literal_codepoint_in_chunk(text: word, chunk: word, base: int) -> word {
    if text.length() == 1 {
        pilot idx = v4_index_of_from(chunk, text, 0)
        if idx >= 0 {
            give back word_from_int(base + idx)
        }
    }
    give back ""
}

task v4_codegen_llvm_char_literal_codepoint(text: word) -> word {
    if text == "\\0" { give back "0" }
    if text == chr(0) { give back "0" }
    if text == "\\t" { give back "9" }
    if text == "\\n" { give back "10" }
    if text == "\\r" { give back "13" }
    if text == "\\\"" { give back "34" }
    if text == "\\'" { give back "39" }
    if text == "\\\\" { give back "92" }

    if text == "\"" { give back "34" }
    if text == "\\" { give back "92" }
    if text == "`" { give back "96" }
    if text == "{" { give back "123" }
    if text == "|" { give back "124" }
    if text == "}" { give back "125" }
    if text == "~" { give back "126" }

    pilot codepoint = v4_codegen_llvm_char_literal_codepoint_in_chunk(text, " !", 32)
    if codepoint != "" { give back codepoint }
    codepoint = v4_codegen_llvm_char_literal_codepoint_in_chunk(text, "#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[", 35)
    if codepoint != "" { give back codepoint }
    codepoint = v4_codegen_llvm_char_literal_codepoint_in_chunk(text, "]^_", 93)
    if codepoint != "" { give back codepoint }
    codepoint = v4_codegen_llvm_char_literal_codepoint_in_chunk(text, "abcdefghijklmnopqrstuvwxyz", 97)
    if codepoint != "" { give back codepoint }
    give back ""
}

task v4_codegen_llvm_rvalue_operand(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back ""
    }

    pilot operand_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_const_char {
        give back operand_ty + " " + v4_codegen_llvm_char_literal_codepoint(text)
    }
    if kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float or kind == v4_mir_rvalue_const_bool or kind == v4_mir_rvalue_const_word {
        give back operand_ty + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, rvalue_id)
    }
    if kind == v4_mir_rvalue_use_local {
        give back operand_ty + " " + v4_codegen_llvm_temp_value(body_id, rvalue_id)
    }
    if kind == v4_mir_rvalue_use_place or v4_codegen_llvm_is_literal_aggregate(kind) {
        give back operand_ty + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, rvalue_id)
    }
    if kind == v4_mir_rvalue_use_symbol and (v4_mir_symbol_is_global(mir_id, text) or v4_codegen_llvm_route_case_symbol(mir_id, body_id, rvalue_id) >= 0) {
        give back operand_ty + " " + v4_codegen_llvm_temp_value(body_id, rvalue_id)
    }
    if kind == v4_mir_rvalue_use_symbol {
        give back operand_ty + " " + v4_codegen_llvm_use_symbol_value(mir_id, text)
    }
    give back operand_ty + " " + v4_codegen_llvm_temp_value(body_id, rvalue_id)
}

task v4_codegen_llvm_use_symbol_value(mir_id: int, text: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot trampoline = v4_ty_extern_callback_export_symbol_name(ty_id, text)
    if trampoline != "" {
        give back v4_codegen_llvm_symbol(trampoline)
    }
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, text)
    if sig_id >= 0 { give back v4_codegen_llvm_signature_symbol(mir_id, ty_id, sig_id) }
    give back v4_codegen_llvm_callable_symbol(mir_id, text)
}

task v4_codegen_llvm_rvalue_value(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back "undef"
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_const_char {
        give back v4_codegen_llvm_char_literal_codepoint(text)
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and kind == v4_mir_rvalue_lend and not v4_codegen_llvm_is_place_lend(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) and not v4_codegen_llvm_is_dyn_ref(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back v4_codegen_llvm_rvalue_value(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    if (kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float) and v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) == "float" { give back v4_codegen_llvm_temp_value(body_id, rvalue_id) }
    if kind == v4_mir_rvalue_const_word {
        if v4_codegen_llvm_active_owned_mir == mir_id { give back v4_codegen_llvm_temp_value(body_id, rvalue_id) }
        give back "ptrtoint (ptr " + v4_codegen_llvm_word_literal_symbol(body_id, rvalue_id) + " to i64)"
    }
    if kind == v4_mir_rvalue_const_bool {
        give back v4_mir_bool_literal_value(text)
    }
    if kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float or kind == v4_mir_rvalue_const_bool or kind == v4_mir_rvalue_const_word {
        if kind == v4_mir_rvalue_const_float { give back v4_codegen_llvm_float_literal_value(text) }
        if kind == v4_mir_rvalue_const_int {
            pilot llvm_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
            if llvm_ty == "float" or llvm_ty == "double" { give back text + ".0" }
        }
        give back text
    }
    if kind == v4_mir_rvalue_use_local {
        give back v4_codegen_llvm_temp_value(body_id, rvalue_id)
    }
    if kind == v4_mir_rvalue_use_place {
        if v4_codegen_llvm_active_owned_mir == mir_id { give back v4_codegen_llvm_temp_value(body_id, rvalue_id) }
        give back "%" + v4_codegen_llvm_mangle_name(v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
    }
    if v4_codegen_llvm_is_literal_aggregate(kind) and v4_codegen_llvm_aggregate_literal_is_zero(mir_id, body_id, rvalue_id) { give back "zeroinitializer" }
    if v4_codegen_llvm_route_case_symbol(mir_id, body_id, rvalue_id) >= 0 { give back v4_codegen_llvm_temp_value(body_id, rvalue_id) }
    if kind == v4_mir_rvalue_use_symbol and v4_mir_symbol_is_global(mir_id, text) {
        give back v4_codegen_llvm_temp_value(body_id, rvalue_id)
    }
    if kind == v4_mir_rvalue_use_symbol {
        give back v4_codegen_llvm_use_symbol_value(mir_id, text)
    }
    give back v4_codegen_llvm_temp_value(body_id, rvalue_id)
}

task v4_codegen_llvm_call_target_rvalue(mir_id: int, body_id: int, call_rvalue_id: int) -> int {
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, call_rvalue_id)
    if lhs < 0 {
        give back 0 - 1
    }
    if v4_ty_is_surface_task_function_type(v4_mir_rvalue_ty(mir_id, body_id, lhs)) {
        give back lhs
    }
    give back v4_mir_rvalue_closure_callee(mir_id, body_id, call_rvalue_id)
}

task v4_codegen_llvm_variadic_arg_promoted_type(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    if arg_rvalue < 0 {
        give back v4_ty_unknown
    }

    pilot call_name = v4_mir_rvalue_op(mir_id, body_id, call_rvalue_id)
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_dyn_call_slot(mir_id, body_id, call_rvalue_id) >= 0 { give back v4_codegen_llvm_dyn_call_param_type(mir_id, body_id, call_rvalue_id, arg_id) }
    -- A closure call's parameters are its closure type's, whatever its name.
    pilot closure_callee = v4_mir_rvalue_closure_callee(mir_id, body_id, call_rvalue_id)
    if closure_callee >= 0 { give back v4_ty_canonical_type(ty_id, v4_ty_closure_param_type(v4_mir_rvalue_ty(mir_id, body_id, closure_callee), arg_id)) }
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, call_name)
    if sig_id < 0 {
        pilot callee_body = v4_codegen_llvm_find_mir_body(mir_id, v4_codegen_llvm_call_callee_name(mir_id, body_id, call_rvalue_id))
        if callee_body >= 0 {
            if v4_codegen_llvm_local_is_lent_param(mir_id, callee_body, arg_id) or v4_codegen_llvm_local_is_dyn_param(mir_id, callee_body, arg_id) { give back v4_ty_lend_type(v4_mir_body_callable_param_type(mir_id, callee_body, arg_id), v4_mir_body_callable_param_mode(mir_id, callee_body, arg_id)) }
            give back v4_mir_body_callable_param_type(mir_id, callee_body, arg_id)
        }
        pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, call_rvalue_id)
        if target_rvalue >= 0 {
            pilot callback_ty = v4_mir_rvalue_ty(mir_id, body_id, target_rvalue)
            if arg_id < v4_ty_function_type_fixed_param_count(callback_ty) {
                give back v4_ty_canonical_type(ty_id, v4_ty_function_type_param_surface(callback_ty, arg_id))
            }
            pilot promoted_callback_ty = v4_ty_variadic_arg_promoted_type(ty_id, v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue))
            if promoted_callback_ty == v4_ty_unknown {
                give back v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            }
            give back promoted_callback_ty
        }
        give back v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
    }

    -- A lend parameter of a FREAK task with a body takes the caller's place
    -- pointer, so the argument is the loan itself, not a copy.
    pilot lent_callee = v4_codegen_llvm_find_mir_body(mir_id, call_name)
    if lent_callee >= 0 and (v4_codegen_llvm_local_is_lent_param(mir_id, lent_callee, arg_id) or v4_codegen_llvm_local_is_dyn_param(mir_id, lent_callee, arg_id)) { give back v4_ty_lend_type(v4_ty_signature_param_type(ty_id, sig_id, arg_id), v4_ty_signature_param_mode(ty_id, sig_id, arg_id)) }
    if v4_ty_signature_is_variadic(ty_id, sig_id) == false {
        give back v4_ty_signature_param_type(ty_id, sig_id, arg_id)
    }

    if arg_id < v4_ty_signature_fixed_param_count(ty_id, sig_id) {
        give back v4_ty_signature_param_type(ty_id, sig_id, arg_id)
    }

    -- A `...` argument keeps its own FREAK type; the C call plan applies the
    -- C default argument promotions (v4_ty_variadic_arg_c_type).
    give back v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
}

task v4_codegen_llvm_variadic_arg_temp(body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    give back "%va" + word_from_int(body_id) + "_" + word_from_int(call_rvalue_id) + "_" + word_from_int(arg_id)
}

task v4_codegen_llvm_variadic_arg_cast_opcode(actual_llvm: word, target_llvm: word) -> word {
    if actual_llvm == target_llvm {
        give back ""
    }
    if target_llvm == "i64" {
        if actual_llvm == "i1" or actual_llvm == "i8" or actual_llvm == "i32" {
            give back "zext"
        }
    }
    if actual_llvm == "float" and target_llvm == "double" {
        give back "fpext"
    }
    give back ""
}

task v4_codegen_llvm_variadic_arg_needs_cast(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> bool {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    if arg_rvalue < 0 {
        give back false
    }
    pilot actual_llvm = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue))
    pilot target_llvm = v4_codegen_llvm_type(v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id))
    give back v4_codegen_llvm_numeric_cast_opcode(v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue), v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id)) != ""
}

task v4_codegen_llvm_variadic_arg_prelude_line(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    if arg_rvalue < 0 { give back "" }
    if v4_mir_rvalue_is_builtin_word(mir_id, body_id, call_rvalue_id) or v4_mir_rvalue_is_builtin_system(mir_id, body_id, call_rvalue_id) or v4_mir_rvalue_op(mir_id, body_id, call_rvalue_id) == v4_mir_call_raw_ptr_write { give back "" }
    if v4_codegen_llvm_c_call_plan(mir_id, body_id, call_rvalue_id) != 0 { give back v4_codegen_llvm_c_call_arg_prelude(mir_id, body_id, call_rvalue_id, arg_id) }
    -- Fixed direct and indirect task arguments use the same checked numerical
    -- conversion plan as stores/returns. The existing query also carries the
    -- ABI promotion target for variadic arguments.
    pilot expected = v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id)
    give back v4_codegen_llvm_expected_lines(mir_id, body_id, arg_rvalue, expected, v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id))
}

-- Tier 3 aggregate calling convention (FREAK ABI only; every C boundary
-- keeps its aggregate fence). A native shape, tuple, fixed array or route
-- parameter is a pointer to a copy the caller made in its own entry-block
-- slot; the callee uses that copy as its parameter storage and may read and
-- write it until it returns. An aggregate result comes back through a
-- leading `sret` pointer to a caller entry-block slot. Pointer attributes
-- (`align`, `dereferenceable`) are freak_target layout answers, resolved per
-- target by module_text; lend receivers keep their pointer to the caller's
-- own storage and are not copies.
task v4_codegen_llvm_is_abi_aggregate(mir_id: int, type_text: word) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or v4_ty_is_lend_type(type_text) { give back false }
    give back v4_codegen_llvm_aggregate_kind(mir_id, type_text) != "" or v4_codegen_llvm_route_signature(mir_id, type_text) >= 0 or v4_codegen_llvm_is_list(mir_id, type_text)
}

-- A FREAK-ABI task call (direct, impl method or through a FREAK task
-- value). Builtins, intrinsics and C calls never take the aggregate ABI.
task v4_codegen_llvm_call_is_freak_abi(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call { give back false }
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    if op == v4_mir_call_say_literal or op == v4_mir_call_raw_ptr_write or v4_mir_rvalue_abi(mir_id, body_id, rvalue_id) != "" { give back false }
    if v4_mir_rvalue_is_builtin_word(mir_id, body_id, rvalue_id) or v4_mir_rvalue_is_builtin_system(mir_id, body_id, rvalue_id) or v4_mir_rvalue_is_builtin_control(mir_id, body_id, rvalue_id) or v4_mir_rvalue_is_builtin_list(mir_id, body_id, rvalue_id) { give back false }
    give back v4_mir_word_intrinsic_kind(mir_id, body_id, rvalue_id) == ""
}

task v4_codegen_llvm_call_arg_is_aggregate(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> bool {
    if not v4_codegen_llvm_call_is_freak_abi(mir_id, body_id, call_rvalue_id) { give back false }
    give back v4_codegen_llvm_is_abi_aggregate(mir_id, v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id))
}

task v4_codegen_llvm_call_returns_aggregate(mir_id: int, body_id: int, call_rvalue_id: int) -> bool {
    if not v4_codegen_llvm_call_is_freak_abi(mir_id, body_id, call_rvalue_id) { give back false }
    give back v4_codegen_llvm_is_abi_aggregate(mir_id, v4_mir_rvalue_ty(mir_id, body_id, call_rvalue_id))
}

task v4_codegen_llvm_abi_arg_slot(body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    give back "%abi.arg." + word_from_int(body_id) + "." + word_from_int(call_rvalue_id) + "." + word_from_int(arg_id)
}

task v4_codegen_llvm_abi_ret_slot(body_id: int, call_rvalue_id: int) -> word {
    give back "%abi.ret." + word_from_int(body_id) + "." + word_from_int(call_rvalue_id)
}

-- Target-neutral marker for an aggregate pointer's layout attributes;
-- module_text replaces it with `align A dereferenceable(S)`.
task v4_codegen_llvm_abi_attrs_marker(llvm_ty: word) -> word {
    give back "$freak.abi.attrs " + llvm_ty + "$"
}

-- The body's own aggregate ABI: an sret result and pointer parameters.
task v4_codegen_llvm_body_uses_sret(mir_id: int, body_id: int) -> bool {
    if v4_mir_body_callable_abi(mir_id, body_id) != "" { give back false }
    give back v4_codegen_llvm_is_abi_aggregate(mir_id, v4_mir_body_callable_return_type(mir_id, body_id))
}

task v4_codegen_llvm_param_is_aggregate(mir_id: int, body_id: int, param_id: int) -> bool {
    if v4_mir_body_callable_abi(mir_id, body_id) != "" or param_id >= v4_mir_body_callable_param_count(mir_id, body_id) { give back false }
    if v4_codegen_llvm_local_is_lent_param(mir_id, body_id, param_id) { give back false }
    give back v4_codegen_llvm_is_abi_aggregate(mir_id, v4_mir_body_callable_param_type(mir_id, body_id, param_id))
}

-- The LLVM return type a body's `ret` uses: void behind an sret pointer.
task v4_codegen_llvm_body_return_llvm_type(mir_id: int, body_id: int) -> word {
    if v4_codegen_llvm_body_uses_sret(mir_id, body_id) { give back "void" }
    give back v4_codegen_llvm_type(v4_mir_body_callable_return_type(mir_id, body_id))
}

-- One entry-block slot per aggregate argument copy and aggregate result, so
-- loops and recursion reuse a frame-sized set instead of growing the stack.
task v4_codegen_llvm_aggregate_abi_slots(mir_id: int, body_id: int) -> word {
    pilot out = ""
    pilot value = 0
    repeat until value >= v4_mir_body_rvalue_count(mir_id, body_id) {
        if v4_codegen_llvm_call_is_freak_abi(mir_id, body_id, value) {
            pilot arg_id = 0
            repeat until arg_id >= v4_mir_rvalue_call_arg_count(mir_id, body_id, value) {
                if v4_codegen_llvm_call_arg_is_aggregate(mir_id, body_id, value, arg_id) {
                    out = out + "  " + v4_codegen_llvm_abi_arg_slot(body_id, value, arg_id) + " = alloca " + v4_codegen_llvm_type(v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, value, arg_id)) + "\n"
                }
                arg_id += 1
            }
            if v4_codegen_llvm_call_returns_aggregate(mir_id, body_id, value) {
                out = out + "  " + v4_codegen_llvm_abi_ret_slot(body_id, value) + " = alloca " + v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, value)) + "\n"
            }
        }
        if v4_codegen_llvm_projection_needs_check(mir_id, body_id, value) {
            out = out + "  " + v4_codegen_llvm_projection_slot(body_id, value) + " = alloca " + v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, value))) + "\n"
        }
        value += 1
    }
    give back out
}

-- Temporary projections (`f(x).y`, `f(x).0`, `f(x)[i]`). A Project reads
-- one declared slot of a shape or tuple value; its ConstInt child names a
-- slot in range and its type is that slot's declared type. A ProjectIndex
-- reads a fixed array element: a literal index in range is extractvalue,
-- any other index spills the temporary to an entry-block slot and takes the
-- same bounds check as an Index place.
task v4_codegen_llvm_native_projection_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if v4_codegen_llvm_active_owned_mir != mir_id { give back "native temporary projections need the owned aggregate path" }
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    if lhs < 0 or rhs < 0 or lhs >= rvalue_id or rhs >= rvalue_id { give back "invalid native projection operand" }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot base_ty = v4_mir_rvalue_ty(mir_id, body_id, lhs)
    pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, base_ty)
    if op == v4_mir_unary_project_index {
        if kind != "array" { give back "native temporary index projections support only fixed arrays: " + base_ty }
        pilot index_ty = v4_mir_rvalue_ty(mir_id, body_id, rhs)
        if index_ty != v4_ty_int and index_ty != v4_ty_uint { give back "native array index must be int or uint: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
        if v4_ty_canonical_type(ty_id, result_ty) != v4_ty_canonical_type(ty_id, v4_ty_fixed_array_element_type(base_ty)) { give back "invalid native projection type" }
        give back ""
    }
    if kind != "shape" and kind != "tuple" { give back "native temporary projections need a shape or tuple: " + base_ty }
    pilot slot = v4_codegen_llvm_const_index(mir_id, body_id, rhs)
    if slot < 0 or slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, base_ty) { give back "invalid native projection slot" }
    if v4_ty_canonical_type(ty_id, v4_codegen_llvm_aggregate_slot_type(mir_id, base_ty, slot)) != v4_ty_canonical_type(ty_id, result_ty) { give back "native projection type differs from the declared slot type: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
    give back ""
}

task v4_codegen_llvm_projection_slot(body_id: int, rvalue_id: int) -> word {
    give back "%project." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

-- A ProjectIndex whose index is not a literal inside the fixed length.
task v4_codegen_llvm_projection_needs_check(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_unary or v4_mir_rvalue_op(mir_id, body_id, rvalue_id) != v4_mir_unary_project_index { give back false }
    pilot length = v4_codegen_llvm_fixed_array_length(mir_id, v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)))
    pilot value = v4_codegen_llvm_const_index(mir_id, body_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    give back value < 0 or value >= length
}

task v4_codegen_llvm_projection_instruction(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    pilot operand = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot index = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    pilot base_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, operand))
    pilot base_value = v4_codegen_llvm_rvalue_value(mir_id, body_id, operand)
    if not v4_codegen_llvm_projection_needs_check(mir_id, body_id, rvalue_id) { give back target + " = extractvalue " + base_ty + " " + base_value + ", " + word_from_int(v4_codegen_llvm_const_index(mir_id, body_id, index)) }
    pilot slot = v4_codegen_llvm_projection_slot(body_id, rvalue_id)
    pilot index_value = v4_codegen_llvm_rvalue_value(mir_id, body_id, index)
    pilot length = word_from_int(v4_codegen_llvm_fixed_array_length(mir_id, v4_mir_rvalue_ty(mir_id, body_id, operand)))
    pilot label = "bounds.project." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
    pilot out = "store " + base_ty + " " + base_value + ", ptr " + slot + "\n"
    out = out + "  %" + label + ".in = icmp ult i64 " + index_value + ", " + length + "\n"
    out = out + "  br i1 %" + label + ".in, label %" + label + ".ok, label %" + label + ".fail\n" + label + ".fail:\n"
    out = out + v4_codegen_llvm_bounds_panic_lines("%" + label, index_value, length)
    out = out + "  unreachable\n" + label + ".ok:\n"
    out = out + "  %" + label + ".p = getelementptr inbounds " + base_ty + ", ptr " + slot + ", i64 0, i64 " + index_value + "\n"
    give back out + "  " + target + " = load " + v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) + ", ptr %" + label + ".p"
}

-- The caller's copies: each aggregate argument (already converted by its
-- prelude) is stored into its slot just before the call, in argument order.
task v4_codegen_llvm_abi_arg_stores(mir_id: int, body_id: int, call_rvalue_id: int) -> word {
    pilot out = ""
    pilot arg_id = 0
    repeat until arg_id >= v4_mir_rvalue_call_arg_count(mir_id, body_id, call_rvalue_id) {
        if v4_codegen_llvm_call_arg_is_aggregate(mir_id, body_id, call_rvalue_id, arg_id) {
            pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
            pilot expected = v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id)
            out = out + "store " + v4_codegen_llvm_type(expected) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, arg_rvalue, expected, v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id)) + ", ptr " + v4_codegen_llvm_abi_arg_slot(body_id, call_rvalue_id, arg_id) + "\n  "
        }
        arg_id += 1
    }
    give back out
}

-- `call cc RET sym(args)`; an aggregate result returns void and passes the
-- caller's result slot first.
task v4_codegen_llvm_call_text(mir_id: int, body_id: int, rvalue_id: int, call_cc: word, call_return: word, call_symbol: word, call_abi: word) -> word {
    pilot call_args = v4_codegen_llvm_call_args(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_call_returns_aggregate(mir_id, body_id, rvalue_id) {
        pilot sret = "ptr sret(" + call_return + ") " + v4_codegen_llvm_abi_ret_slot(body_id, rvalue_id)
        if call_args != "" { sret = sret + ", " }
        give back "call " + call_cc + " void " + call_symbol + "(" + sret + call_args + ")" + v4_codegen_llvm_ffi_call_suffix(call_abi)
    }
    give back "call " + call_cc + " " + call_return + " " + call_symbol + "(" + call_args + ")" + v4_codegen_llvm_ffi_call_suffix(call_abi)
}

task v4_codegen_llvm_call_arg_operand(mir_id: int, body_id: int, call_rvalue_id: int, arg_id: int) -> word {
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue_id, arg_id)
    if arg_rvalue < 0 {
        give back ""
    }

    -- A dyn call's receiver is the data half of its fat pointer.
    if arg_id == 0 and v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_dyn_call_slot(mir_id, body_id, call_rvalue_id) >= 0 { give back "ptr " + v4_codegen_llvm_dyn_call_temp(body_id, call_rvalue_id, "data") }
    if v4_codegen_llvm_call_arg_is_aggregate(mir_id, body_id, call_rvalue_id, arg_id) { give back "ptr " + v4_codegen_llvm_abi_arg_slot(body_id, call_rvalue_id, arg_id) }
    if v4_codegen_llvm_c_call_plan(mir_id, body_id, call_rvalue_id) != 0 { give back v4_codegen_llvm_c_call_arg_operand(mir_id, body_id, call_rvalue_id, arg_id) }
    -- Same plan as the prelude: a converted numeric or tuple/array argument
    -- passes the prelude temp, everything else passes its own value.
    pilot expected = v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, call_rvalue_id, arg_id)
    give back v4_codegen_llvm_type(expected) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, arg_rvalue, expected, v4_codegen_llvm_variadic_arg_temp(body_id, call_rvalue_id, arg_id))
}

task v4_codegen_llvm_rvalue_needs_instruction(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_scalar_sum_rvalue_is_supported(mir_id, body_id, rvalue_id) { give back true }
    -- `or else` always branches; a discarded one still runs its fallback on the empty edge.
    if v4_codegen_llvm_active_owned_mir == mir_id and kind == v4_mir_rvalue_or_else and v4_codegen_llvm_or_else_is_supported(mir_id, body_id, rvalue_id) { give back true }
    if v4_codegen_llvm_active_owned_mir == mir_id and (kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_use_place or kind == v4_mir_rvalue_list or kind == v4_mir_rvalue_loop_item) { give back true }
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_is_literal_aggregate(kind) { give back not v4_codegen_llvm_aggregate_literal_is_zero(mir_id, body_id, rvalue_id) }
    if v4_codegen_llvm_route_case_symbol(mir_id, body_id, rvalue_id) >= 0 { give back true }
    if (kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float) and v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) == "float" { give back true }
    if v4_codegen_llvm_rvalue_is_global_read(mir_id, body_id, rvalue_id) { give back true }
    give back kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_call or kind == v4_mir_rvalue_use_local
}

task v4_codegen_llvm_binary_opcode(op: word, llvm_ty: word) -> word {
    if llvm_ty == "double" or llvm_ty == "float" {
        if op == v4_mir_bin_gt { give back "fcmp ogt" }
        if op == v4_mir_bin_lt { give back "fcmp olt" }
        if op == v4_mir_bin_ge { give back "fcmp oge" }
        if op == v4_mir_bin_le { give back "fcmp ole" }
        if op == v4_mir_bin_eq { give back "fcmp oeq" }
        if op == v4_mir_bin_ne { give back "fcmp une" }
        if op == v4_mir_bin_mod { give back "frem" }
    }
    if op == v4_mir_bin_add {
        if llvm_ty == "double" or llvm_ty == "float" { give back "fadd" }
        give back "add"
    }
    if op == v4_mir_bin_sub {
        if llvm_ty == "double" or llvm_ty == "float" { give back "fsub" }
        give back "sub"
    }
    if op == v4_mir_bin_mul {
        if llvm_ty == "double" or llvm_ty == "float" { give back "fmul" }
        give back "mul"
    }
    if op == v4_mir_bin_div {
        if llvm_ty == "double" or llvm_ty == "float" { give back "fdiv" }
        give back "sdiv"
    }
    if op == v4_mir_bin_mod { give back "srem" }
    if op == v4_mir_bin_gt { give back "icmp sgt" }
    if op == v4_mir_bin_lt { give back "icmp slt" }
    if op == v4_mir_bin_ge { give back "icmp sge" }
    if op == v4_mir_bin_le { give back "icmp sle" }
    if op == v4_mir_bin_eq { give back "icmp eq" }
    if op == v4_mir_bin_ne { give back "icmp ne" }
    if op == v4_mir_bin_and { give back "and" }
    if op == v4_mir_bin_or { give back "or" }
    give back "add"
}

task v4_codegen_llvm_typed_binary_opcode(op: word, source_ty: word) -> word {
    pilot canonical = v4_ty_normalize_ffi_alias_type(source_ty)
    if canonical != "" { source_ty = canonical }
    if source_ty == v4_ty_uint or source_ty == v4_ty_tiny or source_ty == v4_ty_char {
        if op == v4_mir_bin_gt { give back "icmp ugt" }
        if op == v4_mir_bin_lt { give back "icmp ult" }
        if op == v4_mir_bin_ge { give back "icmp uge" }
        if op == v4_mir_bin_le { give back "icmp ule" }
        if op == v4_mir_bin_div { give back "udiv" }
        if op == v4_mir_bin_mod { give back "urem" }
    }
    give back v4_codegen_llvm_binary_opcode(op, v4_codegen_llvm_type(source_ty))
}

task v4_codegen_llvm_binary_operand_type(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot lhs_ty = v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    pilot rhs_ty = v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    pilot numeric_ty = v4_ty_numeric_result(lhs_ty, rhs_ty)
    if numeric_ty != v4_ty_unknown { give back numeric_ty }
    give back lhs_ty
}

task v4_codegen_llvm_binary_cast_temp(body_id: int, rvalue_id: int, side: int) -> word {
    give back "%cast." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + "." + word_from_int(side)
}

-- A semantic conversion can require a check even when both types have the
-- same LLVM carrier (int/uint). Private C helper boundaries carry tiny's
-- explicit zero-extension ABI on both declarations and calls.
task v4_codegen_llvm_numeric_kind(type_text: word) -> word {
    pilot canonical = v4_ty_normalize_ffi_alias_type(type_text)
    if canonical != "" { type_text = canonical }
    if type_text == v4_ty_int { give back "int" }
    if type_text == v4_ty_uint { give back "uint" }
    if type_text == v4_ty_tiny { give back "tiny" }
    if type_text == v4_ty_num or type_text == v4_ty_float or type_text == v4_ty_float32 { give back "num" }
    give back ""
}

task v4_codegen_llvm_numeric_helper_type(kind: word, return_position: bool) -> word {
    if kind == "tiny" {
        if return_position { give back "zeroext i8" }
        give back "i8 zeroext"
    }
    if kind == "num" { give back "double" }
    give back "i64"
}

task v4_codegen_llvm_numeric_cast_opcode(source_ty: word, target_ty: word) -> word {
    pilot source_kind = v4_codegen_llvm_numeric_kind(source_ty)
    pilot target_kind = v4_codegen_llvm_numeric_kind(target_ty)
    if source_kind != "" and target_kind != "" and source_kind != target_kind {
        give back "@freak_v4_" + target_kind + "_from_" + source_kind
    }
    pilot source = v4_codegen_llvm_type(source_ty)
    pilot target = v4_codegen_llvm_type(target_ty)
    if source == target { give back "" }
    if source == "float" and target == "double" { give back "fpext" }
    if source == "double" and target == "float" { give back "fptrunc" }
    -- ABI promotions of bool/char remain widening operations. Narrowing or
    -- floating-to-integer casts have no raw LLVM route in native admission.
    if (source == "i1" or source == "i8" or source == "i32") and target == "i64" { give back "zext" }
    if (source == "i1" or source == "i8") and target == "i32" { give back "zext" }
    give back ""
}

task v4_codegen_llvm_numeric_conversion_lines(source_ty: word, target_ty: word, value: word, temp: word) -> word {
    pilot op = v4_codegen_llvm_numeric_cast_opcode(source_ty, target_ty)
    if op == "" { give back "" }
    if not op.starts_with("@freak_v4_") {
        give back "  " + temp + " = " + op + " " + v4_codegen_llvm_type(source_ty) + " " + value + " to " + v4_codegen_llvm_type(target_ty) + "\n"
    }
    v4_codegen_llvm_numeric_runtime_used = true
    pilot source_kind = v4_codegen_llvm_numeric_kind(source_ty)
    pilot target_kind = v4_codegen_llvm_numeric_kind(target_ty)
    pilot out = ""
    if source_kind == "num" and v4_codegen_llvm_type(source_ty) == "float" {
        out = "  " + temp + ".wide = fpext float " + value + " to double\n"
        value = temp + ".wide"
    }
    pilot call_temp = temp
    if target_kind == "num" and v4_codegen_llvm_type(target_ty) == "float" { call_temp = temp + ".wide" }
    out = out + "  " + call_temp + " = call " + v4_codegen_llvm_numeric_helper_type(target_kind, true) + " " + op + "(" + v4_codegen_llvm_numeric_helper_type(source_kind, false) + " " + value + ")\n"
    if call_temp != temp { out = out + "  " + temp + " = fptrunc double " + call_temp + " to float\n" }
    give back out
}

task v4_codegen_llvm_expected_lines(mir_id: int, body_id: int, rvalue_id: int, expected_ty: word, temp: word) -> word {
    pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_aggregate_conversion_needed(mir_id, actual_ty, expected_ty) { give back v4_codegen_llvm_aggregate_conversion_lines(mir_id, actual_ty, expected_ty, v4_codegen_llvm_rvalue_value(mir_id, body_id, rvalue_id), temp, 0) }
    give back v4_codegen_llvm_numeric_conversion_lines(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id), expected_ty, v4_codegen_llvm_rvalue_value(mir_id, body_id, rvalue_id), temp)
}

task v4_codegen_llvm_expected_value(mir_id: int, body_id: int, rvalue_id: int, expected_ty: word, temp: word) -> word {
    if v4_codegen_llvm_aggregate_conversion_needed(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id), expected_ty) { give back temp }
    if v4_codegen_llvm_numeric_cast_opcode(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id), expected_ty) != "" { give back temp }
    give back v4_codegen_llvm_rvalue_value(mir_id, body_id, rvalue_id)
}

task v4_codegen_llvm_binary_arg_value(mir_id: int, body_id: int, rvalue_id: int, side: int) -> word {
    pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    if side == 1 { child = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id) }
    give back v4_codegen_llvm_expected_value(mir_id, body_id, child, v4_codegen_llvm_binary_operand_type(mir_id, body_id, rvalue_id), v4_codegen_llvm_binary_cast_temp(body_id, rvalue_id, side))
}

task v4_codegen_llvm_binary_cast_lines(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot out = ""
    pilot target_ty = v4_codegen_llvm_binary_operand_type(mir_id, body_id, rvalue_id)
    pilot side = 0
    repeat until side >= 2 {
        pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        if side == 1 { child = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id) }
        out = out + v4_codegen_llvm_expected_lines(mir_id, body_id, child, target_ty, v4_codegen_llvm_binary_cast_temp(body_id, rvalue_id, side))
        side += 1
    }
    give back out
}

task v4_codegen_llvm_checked_binary_suffix(op: word) -> word {
    if op == v4_mir_bin_add { give back "add" }
    if op == v4_mir_bin_sub { give back "sub" }
    if op == v4_mir_bin_mul { give back "mul" }
    if op == v4_mir_bin_div { give back "div" }
    if op == v4_mir_bin_mod { give back "mod" }
    give back ""
}

task v4_codegen_llvm_call_instruction(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    pilot call_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    if call_name == v4_mir_call_say_literal {
        pilot literal = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
        give back "call void @freak_llvm_say(i64 ptrtoint (ptr " + v4_codegen_llvm_word_literal_symbol(body_id, literal) + " to i64))"
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and (v4_mir_rvalue_is_builtin_system(mir_id, body_id, rvalue_id) or v4_mir_word_intrinsic_kind(mir_id, body_id, rvalue_id) == "to_int_maybe") {
        give back v4_codegen_llvm_scalar_sum_bridge_instruction(mir_id, body_id, rvalue_id, target)
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_rvalue_is_builtin_word(mir_id, body_id, rvalue_id) {
        give back v4_codegen_llvm_word_intrinsic_instruction(mir_id, body_id, rvalue_id, target)
    }
    if call_name == v4_mir_call_raw_ptr_write {
        pilot ptr_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
        pilot value_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 1)
        if ptr_rvalue < 0 or value_rvalue < 0 {
            give back ""
        }
        pilot expected_ty = v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, ptr_rvalue))
        pilot pointee_ty = v4_codegen_llvm_type(expected_ty)
        pilot write_temp = "%write." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
        pilot value_text = v4_codegen_llvm_expected_value(mir_id, body_id, value_rvalue, expected_ty, write_temp)
        pilot ptr_text = v4_codegen_llvm_rvalue_value(mir_id, body_id, ptr_rvalue)
        give back "store " + pointee_ty + " " + value_text + ", ptr " + ptr_text
    }
    pilot call_abi = v4_mir_rvalue_abi(mir_id, body_id, rvalue_id)
    pilot call_cc = v4_codegen_llvm_calling_convention(call_abi)
    pilot call_return = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot call_sig = v4_ty_task_signature_id_for_name(ty_id, call_name)
    pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id)
    pilot call_symbol_name = v4_codegen_llvm_call_callee_name(mir_id, body_id, rvalue_id)
    pilot call_symbol = ""
    if target_rvalue >= 0 {
        call_symbol = v4_codegen_llvm_rvalue_value(mir_id, body_id, target_rvalue)
    } else {
        if call_sig >= 0 {
            call_symbol = v4_codegen_llvm_call_signature_symbol(mir_id, ty_id, call_sig)
        } else { call_symbol = v4_codegen_llvm_callable_symbol(mir_id, call_symbol_name) }
    }
    if v4_codegen_llvm_c_call_plan(mir_id, body_id, rvalue_id) != 0 { give back v4_codegen_llvm_c_call_instruction(mir_id, body_id, rvalue_id, call_cc, call_symbol, call_abi, target) }
    pilot stores = v4_codegen_llvm_abi_arg_stores(mir_id, body_id, rvalue_id)
    if v4_mir_rvalue_closure_callee(mir_id, body_id, rvalue_id) >= 0 {
        stores = v4_codegen_llvm_closure_call_prelude(mir_id, body_id, rvalue_id) + stores
        call_symbol = v4_codegen_llvm_closure_call_code(body_id, rvalue_id)
    }
    -- A dyn call loads its slot's code pointer from the receiver's vtable.
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_dyn_call_slot(mir_id, body_id, rvalue_id) >= 0 {
        stores = v4_codegen_llvm_dyn_call_prelude(mir_id, body_id, rvalue_id) + stores
        call_symbol = v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "fn")
    }
    pilot call_text = v4_codegen_llvm_call_text(mir_id, body_id, rvalue_id, call_cc, call_return, call_symbol, call_abi)
    if v4_codegen_llvm_call_returns_aggregate(mir_id, body_id, rvalue_id) {
        if target == "" { give back stores + call_text }
        give back stores + call_text + "\n  " + target + " = load " + call_return + ", ptr " + v4_codegen_llvm_abi_ret_slot(body_id, rvalue_id)
    }
    if target == "" or call_return == "void" {
        give back stores + call_text
    }
    give back stores + target + " = " + call_text
}

task v4_codegen_llvm_rvalue_instruction(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    if rvalue_id < 0 {
        give back ""
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if (kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float) and v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) == "float" {
        -- LLVM's float decimal syntax requires exact binary32 representation.
        -- Parse the decimal as binary64, then perform the specified binary32
        -- rounding explicitly; values such as 0.1 remain valid LLVM input.
        pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if kind == v4_mir_rvalue_const_int { text = text + ".0" }
        give back target + " = fptrunc double " + v4_codegen_llvm_float_literal_value(text) + " to float"
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and kind == v4_mir_rvalue_const_word {
        pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        give back target + " = call i64 @freak_v4_word_from_bytes(i64 ptrtoint (ptr " + v4_codegen_llvm_word_literal_symbol(body_id, rvalue_id) + " to i64), i64 " + word_from_int(text.byte_length()) + ")"
    }
    if kind == v4_mir_rvalue_use_local {
        pilot local_id = v4_codegen_llvm_rvalue_local(mir_id, body_id, rvalue_id)
        pilot local_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        give back target + " = load " + local_ty + ", ptr " + v4_codegen_llvm_local_slot(local_id)
    }
    if v4_codegen_llvm_rvalue_is_global_read(mir_id, body_id, rvalue_id) {
        pilot global_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        pilot global_symbol = v4_codegen_llvm_global_symbol(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        -- A word global keeps its owner; each read yields a shared owned copy.
        if v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) == v4_ty_word {
            pilot held = "%global.held." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
            give back held + " = load i64, ptr " + global_symbol + "\n  " + target + " = call i64 @freak_v4_word_v1_share(i64 " + held + ")"
        }
        give back target + " = load " + global_ty + ", ptr " + global_symbol
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_scalar_sum_rvalue_is_supported(mir_id, body_id, rvalue_id) {
        give back v4_codegen_llvm_scalar_sum_instruction(mir_id, body_id, rvalue_id, target)
    }
    if kind == v4_mir_rvalue_call {
        if v4_mir_rvalue_is_builtin_control(mir_id, body_id, rvalue_id) { give back v4_codegen_llvm_panic_instruction(mir_id, body_id, rvalue_id) }
        give back v4_codegen_llvm_call_instruction(mir_id, body_id, rvalue_id, target)
    }
    if kind == v4_mir_rvalue_binary {
        pilot source_ty = v4_codegen_llvm_binary_operand_type(mir_id, body_id, rvalue_id)
        pilot suffix = v4_codegen_llvm_checked_binary_suffix(v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
        pilot numeric_kind = v4_codegen_llvm_numeric_kind(source_ty)
        if suffix != "" and numeric_kind != "" and numeric_kind != "num" {
            v4_codegen_llvm_numeric_runtime_used = true
            pilot operand = v4_codegen_llvm_numeric_helper_type(numeric_kind, false)
            pilot helper_suffix = suffix
            if numeric_kind == "int" and (suffix == "add" or suffix == "sub" or suffix == "mul") { helper_suffix = suffix + "_inline" }
            give back target + " = call " + v4_codegen_llvm_numeric_helper_type(numeric_kind, true) + " @freak_v4_" + numeric_kind + "_" + helper_suffix + "(" + operand + " " + v4_codegen_llvm_binary_arg_value(mir_id, body_id, rvalue_id, 0) + ", " + operand + " " + v4_codegen_llvm_binary_arg_value(mir_id, body_id, rvalue_id, 1) + ")"
        }
        pilot op = v4_codegen_llvm_typed_binary_opcode(v4_mir_rvalue_op(mir_id, body_id, rvalue_id), source_ty)
        give back target + " = " + op + " " + v4_codegen_llvm_type(source_ty) + " " + v4_codegen_llvm_binary_arg_value(mir_id, body_id, rvalue_id, 0) + ", " + v4_codegen_llvm_binary_arg_value(mir_id, body_id, rvalue_id, 1)
    }
    if kind == v4_mir_rvalue_unary {
        pilot operand = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        pilot operand_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, operand))
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_project or v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_project_index { give back v4_codegen_llvm_projection_instruction(mir_id, body_id, rvalue_id, target) }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_not {
            give back target + " = xor i1 " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand) + ", true"
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_ptr_is_null {
            give back target + " = icmp eq ptr " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand) + ", null"
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_deref {
            pilot pointee_ty = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
            give back target + " = load " + pointee_ty + ", ptr " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand)
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_ptr_offset {
            pilot offset_rvalue = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
            if offset_rvalue < 0 {
                give back ""
            }
            pilot pointee_ty = v4_codegen_llvm_type(v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, operand)))
            give back target + " = getelementptr " + pointee_ty + ", ptr " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand) + ", i64 " + v4_codegen_llvm_rvalue_value(mir_id, body_id, offset_rvalue)
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_ptr_cast {
            give back target + " = getelementptr i8, ptr " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand) + ", i64 0"
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_num_convert {
            -- The checked helper lines are indented and newline-terminated;
            -- the caller adds both back around this single instruction slot.
            pilot lines = v4_codegen_llvm_numeric_conversion_lines(v4_mir_rvalue_ty(mir_id, body_id, operand), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id), v4_codegen_llvm_rvalue_value(mir_id, body_id, operand), target)
            give back v4_slice(lines, 2, lines.length() - 1)
        }
        pilot numeric_kind = v4_codegen_llvm_numeric_kind(v4_mir_rvalue_ty(mir_id, body_id, operand))
        if numeric_kind != "" and numeric_kind != "num" {
            v4_codegen_llvm_numeric_runtime_used = true
            give back target + " = call " + v4_codegen_llvm_numeric_helper_type(numeric_kind, true) + " @freak_v4_" + numeric_kind + "_neg(" + v4_codegen_llvm_numeric_helper_type(numeric_kind, false) + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand) + ")"
        }
        if operand_ty == "double" or operand_ty == "float" {
            give back target + " = fneg " + operand_ty + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand)
        }
        give back target + " = sub " + operand_ty + " 0, " + v4_codegen_llvm_rvalue_value(mir_id, body_id, operand)
    }
    give back ""
}

-- The caller owns one fragment buffer for the whole expression tree. Returning
-- and concatenating a complete child word at every depth retains all prefixes.
task v4_codegen_llvm_collect_rvalue_tree_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if v4_codegen_llvm_active_owned_mir == mir_id {
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, rvalue_id, target, false)
        give back
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_call {
        pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id)
        if target_rvalue >= 0 and v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, target_rvalue) {
            v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, target_rvalue, v4_codegen_llvm_temp_value(body_id, target_rvalue))
        }
        pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
        if arg_count > 0 {
            pilot arg_idx = 0
            repeat until arg_idx >= arg_count {
                pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_idx)
                if arg_rvalue != target_rvalue and v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, arg_rvalue) {
                    v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, arg_rvalue, v4_codegen_llvm_temp_value(body_id, arg_rvalue))
                }
                arg_idx += 1
            }
            arg_idx = 0
            repeat until arg_idx >= arg_count {
                pilot line = v4_codegen_llvm_variadic_arg_prelude_line(mir_id, body_id, rvalue_id, arg_idx)
                if line != "" {
                    v4_codegen_llvm_fragment_push(parts, line)
                }
                arg_idx += 1
            }
        } else {
            pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
            pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
            if lhs != target_rvalue and v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, lhs) {
                v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, lhs, v4_codegen_llvm_temp_value(body_id, lhs))
            }
            if rhs != target_rvalue and v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, rhs) {
                v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, rhs, v4_codegen_llvm_temp_value(body_id, rhs))
            }
        }
    } else {
        pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
        if v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, lhs) {
            v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, lhs, v4_codegen_llvm_temp_value(body_id, lhs))
        }
        if v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, rhs) {
            v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, rhs, v4_codegen_llvm_temp_value(body_id, rhs))
        }
    }

    if v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, rvalue_id) {
        if kind == v4_mir_rvalue_call and v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_call_raw_ptr_write {
            pilot ptr_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
            pilot value_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 1)
            pilot expected_ty = v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, ptr_rvalue))
            pilot write_temp = "%write." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
            v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, value_rvalue, expected_ty, write_temp))
        }
        if kind == v4_mir_rvalue_binary { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_binary_cast_lines(mir_id, body_id, rvalue_id)) }
        pilot line = v4_codegen_llvm_rvalue_instruction(mir_id, body_id, rvalue_id, target)
        if line != "" {
            v4_codegen_llvm_fragment_push(parts, "  " + line + "\n")
        }
    }
}

task v4_codegen_llvm_rvalue_tree_lines(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    v4_codegen_llvm_collect_rvalue_tree_lines(parts, mir_id, body_id, rvalue_id, target)
    pilot out = word_join(parts)
    if v4_codegen_llvm_active_owned_mir == mir_id { array_release(parts) }
    give back out
}

task v4_codegen_llvm_call_args(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
    if v4_mir_rvalue_closure_callee(mir_id, body_id, rvalue_id) >= 0 {
        pilot env = "ptr " + v4_codegen_llvm_closure_call_env(body_id, rvalue_id)
        if arg_count <= 0 { give back env }
        pilot closure_parts = v4_codegen_llvm_fragment_new()
        v4_codegen_llvm_fragment_push(closure_parts, env)
        pilot closure_arg = 0
        repeat until closure_arg >= arg_count {
            v4_codegen_llvm_fragment_push(closure_parts, ", " + v4_codegen_llvm_call_arg_operand(mir_id, body_id, rvalue_id, closure_arg))
            closure_arg += 1
        }
        give back v4_codegen_llvm_fragment_finish(closure_parts)
    }
    if arg_count <= 0 {
        -- The lhs of an indirect call is its target, never a payload operand.
        -- Older direct-call MIR may still use lhs/rhs for positional operands.
        if v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id) >= 0 { give back "" }
        pilot fallback = ""
        pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
        if lhs >= 0 {
            fallback = v4_codegen_llvm_rvalue_operand(mir_id, body_id, lhs)
        }
        if rhs >= 0 {
            if fallback != "" {
                fallback = fallback + ", "
            }
            fallback = fallback + v4_codegen_llvm_rvalue_operand(mir_id, body_id, rhs)
        }
        give back fallback
    }

    pilot parts = v4_codegen_llvm_fragment_new()
    pilot arg_idx = 0
    repeat until arg_idx >= arg_count {
        if arg_idx > 0 {
            v4_codegen_llvm_fragment_push(parts, ", ")
        }
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_call_arg_operand(mir_id, body_id, rvalue_id, arg_idx))
        arg_idx += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_lower_signatures(codegen_id: int, mir_id: int, ty_id: int) -> void {
    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        if v4_codegen_llvm_signature_is_callable(ty_id, sig_idx) {
            pilot sig_name = v4_ty_signature_name(ty_id, sig_idx)
            pilot sig_abi = v4_ty_signature_call_abi(ty_id, sig_idx)
            pilot sig_cc = v4_codegen_llvm_calling_convention(sig_abi)
            pilot sig_return = v4_codegen_llvm_signature_return_text(ty_id, sig_idx)
            pilot sig_params = v4_codegen_llvm_signature_params(ty_id, sig_idx)
            pilot sig_symbol = v4_codegen_llvm_signature_symbol(mir_id, ty_id, sig_idx)
            pilot sig_link = v4_codegen_llvm_signature_link_name(ty_id, sig_idx)
            pilot sig_line = v4_codegen_llvm_signature_line(mir_id, ty_id, sig_idx)
            v4_codegen_llvm_add_decl(codegen_id, sig_name, sig_symbol, sig_link, sig_abi, sig_cc, sig_return, sig_params, sig_line)
        }
        sig_idx += 1
    }
}

task v4_codegen_llvm_lower_calls(codegen_id: int, mir_id: int) -> void {
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    body_idx = v4_codegen_llvm_next_emitted_body(mir_id, body_idx)
    repeat until body_idx >= body_count {
        pilot body_name = v4_mir_body_name(mir_id, body_idx)
        pilot rvalue_idx = 0
        pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_idx)
        repeat until rvalue_idx >= rvalue_count {
            if v4_mir_rvalue_kind(mir_id, body_idx, rvalue_idx) == v4_mir_rvalue_call {
                pilot call_name = v4_mir_rvalue_op(mir_id, body_idx, rvalue_idx)
                if call_name != v4_mir_call_raw_ptr_write {
                    pilot call_abi = v4_mir_rvalue_abi(mir_id, body_idx, rvalue_idx)
                    pilot call_cc = v4_codegen_llvm_calling_convention(call_abi)
                    pilot call_return = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_idx, rvalue_idx))
                    pilot call_sig = v4_ty_task_signature_id_for_name(v4_mir_ty_id(mir_id), call_name)
                    pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_idx, rvalue_idx)
                    pilot call_symbol_name = v4_codegen_llvm_call_callee_name(mir_id, body_idx, rvalue_idx)
                    pilot call_link = ""
                    pilot call_symbol = ""
                    if v4_mir_rvalue_closure_callee(mir_id, body_idx, rvalue_idx) >= 0 {
                        call_symbol = v4_codegen_llvm_closure_call_code(body_idx, rvalue_idx)
                    } else if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_dyn_call_slot(mir_id, body_idx, rvalue_idx) >= 0 {
                        -- The slot's code pointer, loaded from the sealed slot.
                        call_symbol = v4_codegen_llvm_dyn_call_temp(body_idx, rvalue_idx, "fn")
                    } else if target_rvalue >= 0 {
                        call_symbol = v4_codegen_llvm_rvalue_value(mir_id, body_idx, target_rvalue)
                    } else {
                        if call_sig >= 0 {
                            call_link = v4_codegen_llvm_signature_link_name(v4_mir_ty_id(mir_id), call_sig)
                            call_symbol = v4_codegen_llvm_call_signature_symbol(mir_id, v4_mir_ty_id(mir_id), call_sig)
                        } else { call_symbol = v4_codegen_llvm_callable_symbol(mir_id, call_symbol_name) }
                        if call_name == v4_mir_call_say_literal { call_symbol = "@freak_llvm_say" }
                    }
                    pilot call_expr = v4_mir_rvalue_text(mir_id, body_idx, rvalue_idx)
                    pilot call_line = v4_codegen_llvm_call_text(mir_id, body_idx, rvalue_idx, call_cc, call_return, call_symbol, call_abi)
                    if v4_codegen_llvm_c_call_plan(mir_id, body_idx, rvalue_idx) != 0 { call_line = v4_codegen_llvm_c_call_instruction(mir_id, body_idx, rvalue_idx, call_cc, call_symbol, call_abi, "") }
                    if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_rvalue_is_builtin_word(mir_id, body_idx, rvalue_idx) {
                        call_symbol = v4_codegen_llvm_word_intrinsic_symbol_for(mir_id, v4_mir_word_intrinsic_kind(mir_id, body_idx, rvalue_idx))
                        call_line = v4_codegen_llvm_word_intrinsic_instruction(mir_id, body_idx, rvalue_idx, v4_codegen_llvm_temp_value(body_idx, rvalue_idx))
                    }
                    if v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_scalar_sum_bridge_kind(mir_id, body_idx, rvalue_idx) != "" {
                        call_symbol = v4_codegen_llvm_scalar_sum_bridge_symbol(v4_codegen_llvm_scalar_sum_bridge_kind(mir_id, body_idx, rvalue_idx))
                        call_line = v4_codegen_llvm_scalar_sum_bridge_instruction(mir_id, body_idx, rvalue_idx, v4_codegen_llvm_temp_value(body_idx, rvalue_idx))
                    }
                    if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_rvalue_is_builtin_list(mir_id, body_idx, rvalue_idx) {
                        call_symbol = "@freak.list." + v4_mir_list_intrinsic_kind(mir_id, body_idx, rvalue_idx)
                        call_line = ""
                    }
                    if v4_mir_rvalue_is_builtin_control(mir_id, body_idx, rvalue_idx) {
                        call_symbol = v4_codegen_llvm_panic_symbol()
                        call_line = v4_codegen_llvm_panic_instruction(mir_id, body_idx, rvalue_idx)
                    }
                    v4_codegen_llvm_add_call(codegen_id, body_name, call_name, call_symbol, call_link, call_abi, call_cc, call_return, call_expr, call_line)
                }
            }
            rvalue_idx += 1
        }
        body_idx = v4_codegen_llvm_next_emitted_body(mir_id, body_idx + 1)
    }
}

task v4_codegen_llvm_body_header(mir_id: int, body_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot abi = v4_mir_body_callable_abi(mir_id, body_id)
    pilot cc = v4_codegen_llvm_calling_convention(abi)
    pilot return_ty = v4_codegen_llvm_body_return_llvm_type(mir_id, body_id)
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot param_id = 0
    pilot closure: bool = v4_mir_body_is_closure(mir_id, body_id)
    if v4_codegen_llvm_body_uses_sret(mir_id, body_id) {
        pilot result_ty = v4_codegen_llvm_type(v4_mir_body_callable_return_type(mir_id, body_id))
        v4_codegen_llvm_fragment_push(parts, "ptr noalias sret(" + result_ty + ") " + v4_codegen_llvm_abi_attrs_marker(result_ty) + " %ret")
        if v4_mir_body_callable_param_count(mir_id, body_id) > 0 or closure { v4_codegen_llvm_fragment_push(parts, ", ") }
    }
    -- A closure body takes its environment first.
    if closure {
        v4_codegen_llvm_fragment_push(parts, "ptr %env")
        if v4_mir_body_callable_param_count(mir_id, body_id) > 0 { v4_codegen_llvm_fragment_push(parts, ", ") }
    }
    repeat until param_id >= v4_mir_body_callable_param_count(mir_id, body_id) {
        if param_id > 0 { v4_codegen_llvm_fragment_push(parts, ", ") }
        pilot param_ty = v4_codegen_llvm_type(v4_mir_body_callable_param_type(mir_id, body_id, param_id))
        if v4_codegen_llvm_param_is_aggregate(mir_id, body_id, param_id) { param_ty = "ptr noalias " + v4_codegen_llvm_abi_attrs_marker(param_ty) }
        -- A lend parameter points at the caller's storage: never null, aligned
        -- and dereferenceable for its type, and only `lend mut` is exclusive.
        if v4_codegen_llvm_local_is_lent_param(mir_id, body_id, param_id) {
            pilot exclusive = ""
            if v4_mir_body_callable_param_mode(mir_id, body_id, param_id) == v4_ty_param_mode_lend_mut { exclusive = "noalias " }
            param_ty = "ptr " + exclusive + "nonnull " + v4_codegen_llvm_abi_attrs_marker(param_ty)
        }
        v4_codegen_llvm_fragment_push(parts, param_ty + " %arg." + word_from_int(param_id))
        param_id += 1
    }
    pilot attribute = ""
    if v4_mir_body_callable_return_type(mir_id, body_id) == v4_ty_never { attribute = " noreturn" }
    give back "define " + cc + " " + return_ty + " " + v4_codegen_llvm_callable_symbol(mir_id, body_name) + "(" + word_join(parts) + ")" + attribute
}

task v4_codegen_llvm_find_mir_body(mir_id: int, name: word) -> int {
    give back v4_mir_lookup_body_name(mir_id, name)
}

task v4_codegen_llvm_default_return_line(return_ty: word) -> word {
    if return_ty == "void" {
        give back "  ret void\n"
    }
    if return_ty == "i1" {
        give back "  ret i1 false\n"
    }
    if return_ty == "i8" or return_ty == "i32" or return_ty == "i64" {
        give back "  ret " + return_ty + " 0\n"
    }
    if return_ty == "double" or return_ty == "float" {
        give back "  ret " + return_ty + " 0.0\n"
    }
    give back "  ret " + return_ty + " zeroinitializer\n"
}

task v4_codegen_llvm_stmt_lines(mir_id: int, body_id: int, stmt_id: int) -> word {
    pilot kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    pilot expected_temp = "%expected." + word_from_int(body_id) + "." + word_from_int(stmt_id)
    if kind == v4_mir_stmt_return {
        pilot out = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, rvalue_id, v4_codegen_llvm_temp_value(body_id, rvalue_id))
        pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
        pilot ret_ty = v4_codegen_llvm_type(v4_mir_body_callable_return_type(mir_id, body_id))
        if v4_codegen_llvm_active_owned_mir == mir_id { out = out + v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_return, stmt_id, "return." + word_from_int(stmt_id)) }
        if ret_ty == "void" { give back out + "  ret void\n" }
        pilot expected_ty = v4_mir_body_callable_return_type(mir_id, body_id)
        out = out + v4_codegen_llvm_expected_lines(mir_id, body_id, rvalue_id, expected_ty, expected_temp)
        -- An aggregate result is written through the caller's sret slot.
        if v4_codegen_llvm_body_uses_sret(mir_id, body_id) { give back out + "  store " + ret_ty + " " + v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, expected_ty, expected_temp) + ", ptr %ret\n  ret void\n" }
        out = out + "  ret " + ret_ty + " " + v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, expected_ty, expected_temp) + "\n"
        give back out
    }
    if kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign {
        pilot target_name = v4_mir_stmt_lhs(mir_id, body_id, stmt_id)
        pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
        if kind == v4_mir_stmt_assign {
            if place_id >= 0 and v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_deref {
                pilot ptr_rvalue = v4_mir_place_index(mir_id, body_id, place_id)
                pilot pointee_ty = v4_codegen_llvm_type(v4_mir_place_ty(mir_id, body_id, place_id))
                pilot value_lines = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, rvalue_id, v4_codegen_llvm_temp_value(body_id, rvalue_id))
                pilot ptr_lines = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, ptr_rvalue, v4_codegen_llvm_temp_value(body_id, ptr_rvalue))
                pilot value_text = v4_codegen_llvm_rvalue_value(mir_id, body_id, rvalue_id)
                pilot ptr_text = v4_codegen_llvm_rvalue_value(mir_id, body_id, ptr_rvalue)
                pilot expected_ty = v4_mir_place_ty(mir_id, body_id, place_id)
                value_lines = value_lines + v4_codegen_llvm_expected_lines(mir_id, body_id, rvalue_id, expected_ty, expected_temp)
                value_text = v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, expected_ty, expected_temp)
                give back value_lines + ptr_lines + "  store " + pointee_ty + " " + value_text + ", ptr " + ptr_text + "\n"
            }
            if place_id >= 0 and v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_global {
                pilot global_ty = v4_mir_place_ty(mir_id, body_id, place_id)
                pilot value_lines = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, rvalue_id, v4_codegen_llvm_temp_value(body_id, rvalue_id))
                value_lines = value_lines + v4_codegen_llvm_expected_lines(mir_id, body_id, rvalue_id, global_ty, expected_temp)
                if global_ty == v4_ty_word {
                    -- Replacing a word global drops its previous owner (zero at first store).
                    pilot old = "%global.old." + word_from_int(body_id) + "." + word_from_int(stmt_id)
                    value_lines = value_lines + "  " + old + " = load i64, ptr " + v4_codegen_llvm_global_symbol(v4_mir_place_text(mir_id, body_id, place_id)) + "\n  call void @freak_v4_word_drop(i64 " + old + ")\n"
                }
                give back value_lines + "  store " + v4_codegen_llvm_type(global_ty) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, global_ty, expected_temp) + ", ptr " + v4_codegen_llvm_global_symbol(v4_mir_place_text(mir_id, body_id, place_id)) + "\n"
            }
        }
        if kind == v4_mir_stmt_assign and place_id >= 0 and (v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_field or v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_index) {
            pilot field_ty = v4_mir_place_ty(mir_id, body_id, place_id)
            pilot parts = v4_codegen_llvm_fragment_new()
            pilot address = ""
            pilot read = v4_codegen_llvm_stmt_compound_read(mir_id, body_id, stmt_id)
            -- The read already evaluated the index operands; reuse its address.
            -- Otherwise the target (index operands and bounds checks) is
            -- evaluated before the value, in MIR's source order.
            if read >= 0 { address = v4_codegen_llvm_compound_place_address(mir_id, body_id, place_id, v4_codegen_llvm_compound_read_site(mir_id, body_id, stmt_id, read)) } else { address = v4_codegen_llvm_place_address(parts, mir_id, body_id, place_id, "s" + word_from_int(stmt_id)) }
            pilot target_lines = word_join(parts)
            array_release(parts)
            pilot value_lines = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, rvalue_id, v4_codegen_llvm_temp_value(body_id, rvalue_id))
            value_lines = value_lines + v4_codegen_llvm_expected_lines(mir_id, body_id, rvalue_id, field_ty, expected_temp)
            pilot out = ""
            if read >= 0 { out = value_lines + target_lines } else { out = target_lines + value_lines }
            out = out + v4_codegen_llvm_slot_replace_lines(mir_id, body_id, stmt_id, field_ty, address)
            give back out + "  store " + v4_codegen_llvm_type(field_ty) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, field_ty, expected_temp) + ", ptr " + address + "\n"
        }
        pilot local_id = 0 - 1
        if place_id >= 0 and v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_local { local_id = v4_mir_place_base(mir_id, body_id, place_id) }
        if local_id < 0 { local_id = v4_mir_find_local_visible_at(mir_id, body_id, target_name, v4_span_start(v4_mir_stmt_span(mir_id, body_id, stmt_id))) }
        pilot local_ty = v4_codegen_llvm_type(v4_mir_local_ty(mir_id, body_id, local_id))
        pilot value_lines = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, rvalue_id, v4_codegen_llvm_temp_value(body_id, rvalue_id))
        pilot expected_ty = v4_mir_local_ty(mir_id, body_id, local_id)
        value_lines = value_lines + v4_codegen_llvm_expected_lines(mir_id, body_id, rvalue_id, expected_ty, expected_temp)
        -- Replacing a `lend mut` word releases the caller's old word; the
        -- caller still owns the slot and its drop flag stays set.
        if v4_codegen_llvm_local_is_lent_param(mir_id, body_id, local_id) and v4_mir_local_ty(mir_id, body_id, local_id) == v4_ty_word {
            pilot old = "%lent.old." + word_from_int(body_id) + "." + word_from_int(stmt_id)
            value_lines = value_lines + "  " + old + " = load i64, ptr " + v4_codegen_llvm_local_slot(local_id) + "\n  call void @freak_v4_word_drop(i64 " + old + ")\n"
        }
        if v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_word_local_is_owned(mir_id, body_id, local_id) {
            value_lines = value_lines + v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_replace, stmt_id, "replace." + word_from_int(stmt_id))
            value_lines = value_lines + "  store " + local_ty + " " + v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, expected_ty, expected_temp) + ", ptr " + v4_codegen_llvm_local_slot(local_id) + "\n"
            give back value_lines + v4_codegen_llvm_flag_store_line(mir_id, body_id, local_id, "true")
        }
        if v4_codegen_llvm_local_is_lent_param(mir_id, body_id, local_id) and v4_mir_local_ty(mir_id, body_id, local_id) != v4_ty_word {
            -- A lent parameter's slot is the caller's place: a whole
            -- replacement releases the old value there first (a DropSlot row).
            value_lines = value_lines + v4_codegen_llvm_slot_replace_lines(mir_id, body_id, stmt_id, expected_ty, v4_codegen_llvm_local_slot(local_id))
        }
        give back value_lines + "  store " + local_ty + " " + v4_codegen_llvm_expected_value(mir_id, body_id, rvalue_id, expected_ty, expected_temp) + ", ptr " + v4_codegen_llvm_local_slot(local_id) + "\n"
    }
    if kind == v4_mir_stmt_expr or kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop {
        if v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, rvalue_id) {
            pilot out = v4_codegen_llvm_rvalue_tree_lines(mir_id, body_id, rvalue_id, v4_codegen_llvm_temp_value(body_id, rvalue_id))
            if v4_codegen_llvm_active_owned_mir == mir_id and kind == v4_mir_stmt_expr and v4_codegen_llvm_word_rvalue_is_owned(mir_id, body_id, rvalue_id) {
                out = out + v4_codegen_llvm_owned_temporary_drop(mir_id, body_id, rvalue_id, "discard." + word_from_int(stmt_id))
            }
            if v4_codegen_llvm_active_owned_mir == mir_id and kind == v4_mir_stmt_expr and v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_lend {
                pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
                if v4_codegen_llvm_lend_word_temporary_is_fresh(mir_id, body_id, child) { out = out + "  call void @freak_v4_word_drop(i64 " + v4_codegen_llvm_rvalue_value(mir_id, body_id, child) + ")\n" }
            }
            give back out
        }
    }
    give back ""
}

task v4_codegen_llvm_block_terminator_line(mir_id: int, body_id: int, block_id: int) -> word {
    if v4_mir_block_has_return_stmt(mir_id, body_id, block_id) {
        give back ""
    }

    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    pilot term = v4_mir_block_terminator(block_record)
    if term == v4_mir_term_goto {
        pilot cleanup = ""
        if v4_codegen_llvm_active_owned_mir == mir_id { cleanup = v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_edge_true, block_id, "edge." + word_from_int(block_id) + ".0") }
        give back cleanup + "  br label %bb" + word_from_int(v4_mir_block_target(block_record)) + "\n"
    }
    if term == v4_mir_term_if {
        pilot stmt_id = v4_mir_block_first_stmt(mir_id, body_id, block_id)
        repeat until stmt_id < 0 {
            pilot kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
            if kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop {
                pilot condition = v4_codegen_llvm_rvalue_value(mir_id, body_id, v4_mir_stmt_rvalue(mir_id, body_id, stmt_id))
                pilot true_target = v4_mir_block_target(block_record)
                pilot false_target = v4_mir_block_else_target(block_record)
                pilot true_name = "bb" + word_from_int(true_target)
                pilot false_name = "bb" + word_from_int(false_target)
                pilot edges = ""
                if v4_codegen_llvm_active_owned_mir == mir_id {
                    pilot true_drop = v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_edge_true, block_id, "edge." + word_from_int(block_id) + ".0")
                    pilot false_drop = v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_edge_false, block_id, "edge." + word_from_int(block_id) + ".1")
                    if true_drop != "" {
                        true_name = "word.edge." + word_from_int(block_id) + ".0"
                        edges = edges + true_name + ":\n" + true_drop + "  br label %bb" + word_from_int(true_target) + "\n"
                    }
                    if false_drop != "" {
                        false_name = "word.edge." + word_from_int(block_id) + ".1"
                        edges = edges + false_name + ":\n" + false_drop + "  br label %bb" + word_from_int(false_target) + "\n"
                    }
                }
                give back "  br i1 " + condition + ", label %" + true_name + ", label %" + false_name + "\n" + edges
            }
            stmt_id = v4_mir_block_next_stmt(mir_id, body_id, block_id, stmt_id)
        }
        give back "  unreachable\n"
    }
    if term == v4_mir_term_unreachable {
        give back "  unreachable\n"
    }
    if term == v4_mir_term_return {
        if v4_mir_body_callable_return_type(mir_id, body_id) == v4_ty_never { give back "  unreachable\n" }
        -- The shared Sum return proof permits an empty Return only in a
        -- detached join. Never invent a tagged value for that dead block.
        if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_scalar_sum_kind(mir_id, v4_mir_body_callable_return_type(mir_id, body_id)) != "" { give back "  unreachable\n" }
        pilot return_ty = v4_codegen_llvm_body_return_llvm_type(mir_id, body_id)
        if v4_codegen_llvm_active_owned_mir == mir_id {
            pilot out = v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_default, block_id, "default." + word_from_int(block_id))
            if v4_mir_body_callable_return_type(mir_id, body_id) == v4_ty_word {
                pilot temp = "%word.default." + word_from_int(block_id)
                give back out + "  " + temp + " = call i64 @freak_v4_word_from_bytes(i64 0, i64 0)\n  ret i64 " + temp + "\n"
            }
            give back out + v4_codegen_llvm_default_return_line(return_ty)
        }
        give back v4_codegen_llvm_default_return_line(return_ty)
    }
    give back ""
}

task v4_codegen_llvm_body_line_from_mir(mir_id: int, body_id: int) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_body_header(mir_id, body_id) + " {\nentry:\n")
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if v4_codegen_llvm_active_owned_mir == mir_id {
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_scalar_sum_bridge_slots(mir_id, body_id))
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_route_slots(mir_id, body_id))
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_aggregate_abi_slots(mir_id, body_id))
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_closure_env_slots(mir_id, body_id))
    }
    pilot local_id = 0
    repeat until local_id >= v4_mir_body_local_count(mir_id, body_id) {
        pilot local_ty = v4_codegen_llvm_type(v4_mir_local_ty(mir_id, body_id, local_id))
        -- An aggregate parameter's storage is the caller's copy itself, and a
        -- lend parameter's storage is the caller's own place, so reads and
        -- writes of the local (through `lend mut`) reach that place directly.
        pilot aggregate_param: bool = v4_codegen_llvm_param_is_aggregate(mir_id, body_id, local_id) or v4_codegen_llvm_local_is_lent_param(mir_id, body_id, local_id)
        if v4_mir_body_local_is_closure_capture(mir_id, body_id, local_id) { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_closure_capture_slot_lines(mir_id, body_id, local_id)) } else if aggregate_param { v4_codegen_llvm_fragment_push(parts, "  " + v4_codegen_llvm_local_slot(local_id) + " = getelementptr inbounds i8, ptr %arg." + word_from_int(local_id) + ", i64 0\n") } else { v4_codegen_llvm_fragment_push(parts, "  " + v4_codegen_llvm_local_slot(local_id) + " = alloca " + local_ty + "\n") }
        if v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_word_local_is_owned(mir_id, body_id, local_id) {
            pilot initial_value = "0"
            if v4_mir_scalar_sum_kind(mir_id, v4_mir_local_ty(mir_id, body_id, local_id)) != "" or local_ty != "i64" { initial_value = "zeroinitializer" }
            -- An aggregate parameter's storage already holds the caller's copy.
            if not aggregate_param { v4_codegen_llvm_fragment_push(parts, "  store " + local_ty + " " + initial_value + ", ptr " + v4_codegen_llvm_local_slot(local_id) + "\n") }
            -- Meiya's plan gives a runtime drop flag only to a local that some
            -- drop site finds initialized on some paths and moved on others.
            if v4_mir_drop_local_flag(mir_id, body_id, local_id) {
                v4_codegen_llvm_fragment_push(parts, "  " + v4_codegen_llvm_word_flag_slot(local_id) + " = alloca i1\n")
                pilot initialized = "false"
                if local_id < v4_mir_body_callable_param_count(mir_id, body_id) { initialized = "true" }
                v4_codegen_llvm_fragment_push(parts, "  store i1 " + initialized + ", ptr " + v4_codegen_llvm_word_flag_slot(local_id) + "\n")
            }
        }
        if local_id < v4_mir_body_callable_param_count(mir_id, body_id) and not aggregate_param {
            v4_codegen_llvm_fragment_push(parts, "  store " + local_ty + " %arg." + word_from_int(local_id) + ", ptr " + v4_codegen_llvm_local_slot(local_id) + "\n")
        }
        local_id += 1
    }
    v4_codegen_llvm_fragment_push(parts, "  br label %bb0\n")
    pilot block_id = 0
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    repeat until block_id >= block_count {
        v4_codegen_llvm_fragment_push(parts, "bb" + word_from_int(block_id) + ":\n")
        pilot stmt_id = v4_mir_block_first_stmt(mir_id, body_id, block_id)
        pilot terminal = false
        pilot previous_stmt = 0 - 1
        repeat until stmt_id < 0 or terminal {
            if v4_codegen_llvm_active_owned_mir == mir_id and previous_stmt >= 0 { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_drop_site_lines(mir_id, body_id, v4_mir_drop_site_before, stmt_id, "stmt." + word_from_int(stmt_id))) }
            v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_stmt_lines(mir_id, body_id, stmt_id))
            if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_return { terminal = true }
            previous_stmt = stmt_id
            stmt_id = v4_mir_block_next_stmt(mir_id, body_id, block_id, stmt_id)
        }
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_block_terminator_line(mir_id, body_id, block_id))
        block_id += 1
    }
    v4_codegen_llvm_fragment_push(parts, "}")
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_lower_bodies(codegen_id: int, mir_id: int) -> void {
    pilot body_id = 0
    pilot body_count = v4_mir_body_count(mir_id)
    body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id)
    repeat until body_id >= body_count {
        pilot body_name = v4_mir_body_name(mir_id, body_id)
        pilot body_symbol = v4_codegen_llvm_callable_symbol(mir_id, body_name)
        pilot body_line = v4_codegen_llvm_body_line_from_mir(mir_id, body_id)
        v4_codegen_llvm_add_body(codegen_id, body_name, body_symbol, body_line)
        body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id + 1)
    }
}

task v4_codegen_llvm_should_emit_callback_trampoline(ty_id: int, sig_id: int) -> bool {
    if v4_ty_signature_has_extern_callback(ty_id, sig_id) == false {
        give back false
    }
    if v4_ty_signature_kind(ty_id, sig_id) != v4_ty_task_sig {
        give back false
    }
    pilot abi = v4_ty_signature_extern_callback_abi(ty_id, sig_id)
    if abi == "" {
        give back false
    }
    if v4_ty_is_language_abi(abi) == false and v4_ty_is_calling_convention_abi(abi) == false {
        give back false
    }
    if v4_ty_signature_is_variadic(ty_id, sig_id) {
        give back false
    }
    give back true
}

task v4_codegen_llvm_lower_callback_trampolines(codegen_id: int, mir_id: int, ty_id: int) -> void {
    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        if v4_codegen_llvm_should_emit_callback_trampoline(ty_id, sig_idx) {
            pilot task_name = v4_ty_signature_name(ty_id, sig_idx)
            pilot tramp_name = v4_codegen_llvm_callback_trampoline_name(task_name)
            pilot tramp_symbol = v4_codegen_llvm_callback_trampoline_symbol(task_name)
            pilot tramp_abi = v4_ty_signature_extern_callback_abi(ty_id, sig_idx)
            pilot tramp_line = v4_codegen_llvm_callback_trampoline_line(mir_id, ty_id, sig_idx, tramp_abi)
            v4_codegen_llvm_add_body(codegen_id, tramp_name, tramp_symbol, tramp_line)
        }
        sig_idx += 1
    }
}

-- Native support is a sealed backend contract over authoritative MIR facts.
-- Broader declaration/call plans remain available to editor and ABI consumers.
-- These readers allocate no derived state and never change the MIR wire format.
task v4_codegen_llvm_task_pointer_contains_word(type_text: word, depth: int) -> bool {
    if depth > 32 { give back true }
    if v4_codegen_llvm_type_is_word_handle(type_text) { give back true }
    if v4_ty_is_raw_pointer_type(type_text) { give back v4_codegen_llvm_task_pointer_contains_word(v4_ty_raw_pointer_target_type(type_text), depth + 1) }
    if not v4_ty_is_surface_task_function_type(type_text) { give back false }
    if v4_codegen_llvm_task_pointer_contains_word(v4_ty_function_type_return_text(type_text), depth + 1) { give back true }
    pilot param = 0
    repeat until param >= v4_ty_function_type_fixed_param_count(type_text) {
        if v4_codegen_llvm_task_pointer_contains_word(v4_ty_function_type_param_surface(type_text, param), depth + 1) { give back true }
        param += 1
    }
    give back false
}

task v4_codegen_llvm_native_type_error_depth(type_text: word, allow_void: bool, depth: int) -> word {
    if depth > 32 { give back "native function pointer type nesting exceeds supported depth" }
    pilot alias_text = v4_ty_normalize_ffi_alias_type(type_text)
    if alias_text != "" { type_text = alias_text }
    if v4_codegen_llvm_active_owned_mir >= 0 {
        pilot sum_kind = v4_mir_scalar_sum_kind(v4_codegen_llvm_active_owned_mir, type_text)
        if sum_kind != "" {
            if depth != 0 { give back "native scalar sum callback contracts are not yet supported" }
            if sum_kind == "Maybe" or sum_kind == "Result" { give back v4_codegen_llvm_native_sum_error(v4_codegen_llvm_active_owned_mir, type_text, depth) }
            give back ""
        }
        if v4_ty_is_raw_pointer_type(type_text) and v4_mir_scalar_sum_kind(v4_codegen_llvm_active_owned_mir, v4_ty_raw_pointer_target_type(type_text)) != "" { give back "native scalar sum raw storage contracts are not yet supported" }
    }
    if v4_codegen_llvm_active_owned_mir >= 0 and v4_ty_is_lend_type(type_text) and v4_ty_lend_mode(type_text) == v4_ty_param_mode_lend and v4_ty_lend_target_type(type_text) == v4_ty_word { give back "" }
    -- Where a dyn loan may appear is checked by native_dyn_error.
    if v4_codegen_llvm_active_owned_mir >= 0 and v4_codegen_llvm_is_dyn_ref(type_text) {
        if depth == 0 { give back "" }
        give back "native dyn values inside other types are not yet supported: " + type_text
    }
    -- An aggregate or scalar loan is a pointer to its storage; callback and
    -- slot surfaces stay fenced by depth.
    if v4_codegen_llvm_active_owned_mir >= 0 and depth == 0 and v4_codegen_llvm_is_aggregate_lend(v4_codegen_llvm_active_owned_mir, type_text) { give back v4_codegen_llvm_native_shape_error(v4_codegen_llvm_active_owned_mir, v4_ty_lend_target_type(type_text), 0) }
    if v4_codegen_llvm_active_owned_mir >= 0 and depth == 0 and v4_codegen_llvm_is_place_lend(v4_codegen_llvm_active_owned_mir, type_text) { give back "" }
    if v4_codegen_llvm_is_list(v4_codegen_llvm_active_owned_mir, type_text) { give back v4_codegen_llvm_native_list_type_error(v4_codegen_llvm_active_owned_mir, type_text, depth) }
    if type_text == v4_ty_int or type_text == v4_ty_uint or type_text == v4_ty_tiny or type_text == v4_ty_num or type_text == v4_ty_float or type_text == v4_ty_float32 or type_text == v4_ty_bool or type_text == v4_ty_char or type_text == v4_ty_word { give back "" }
    if allow_void and (type_text == v4_ty_void or type_text == v4_ty_never) { give back "" }
    -- Opaque raw pointer values do not require an aggregate layout. Operations
    -- that dereference/offset them separately validate the pointee type.
    if v4_ty_is_raw_pointer_type(type_text) { give back "" }
    if v4_ty_is_closure_type(type_text) {
        if depth != 0 { give back "native closures inside other types are not yet supported: " + type_text }
        give back v4_codegen_llvm_native_closure_type_error(type_text)
    }
    if v4_ty_is_surface_task_function_type(type_text) {
        -- Function-type parameter readers currently erase named lend modes.
        -- Keep these callbacks fenced until their ownership modes are proven.
        if v4_codegen_llvm_task_pointer_contains_word(type_text, 0) { give back "native word task pointer contracts are not yet supported" }
        pilot error = v4_codegen_llvm_native_type_error_depth(v4_ty_function_type_return_text(type_text), true, depth + 1)
        if error != "" { give back error }
        pilot param_id = 0
        repeat until param_id >= v4_ty_function_type_fixed_param_count(type_text) {
            -- The surface reader drops a lend mode, so an indirect call would
            -- pass the value where the callee takes the caller's pointer.
            if v4_ty_function_type_param_name(type_text, param_id).starts_with("lend ") { give back "native task values with lend parameters are not yet supported: " + type_text }
            error = v4_codegen_llvm_native_type_error_depth(v4_ty_function_type_param_surface(type_text, param_id), false, depth + 1)
            if error != "" { give back error }
            param_id += 1
        }
        give back ""
    }
    if v4_codegen_llvm_active_owned_mir >= 0 {
        pilot shape_error = v4_codegen_llvm_native_shape_error(v4_codegen_llvm_active_owned_mir, type_text, depth)
        if shape_error != "-" { give back shape_error }
        pilot sum_error = v4_codegen_llvm_unadmitted_sum_error(v4_codegen_llvm_active_owned_mir, type_text)
        if sum_error != "" { give back sum_error }
    }
    give back "native type not yet supported: " + type_text
}

-- Aggregates (tier 3). A concrete shape lowers to a named LLVM struct whose
-- fields follow declaration order, a tuple to a literal struct, and a fixed
-- array [T; N] to [N x T]; freak_target answers every layout. Slots must be
-- scalars, raw or task pointers, or nested aggregates: slots that own words
-- need aggregate drops (a later row) and are named here.
task v4_codegen_llvm_shape_type_name(mir_id: int, type_text: word) -> word {
    pilot symbol = v4_codegen_llvm_symbol("freak.shape." + v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text))
    give back "%" + v4_slice(symbol, 1, symbol.length())
}

-- A fixed array length as a decimal count, or -1 when it is not a known
-- non-negative integer constant.
task v4_codegen_llvm_fixed_array_length(mir_id: int, type_text: word) -> int {
    pilot text = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), type_text)
    if text == "" or text == v4_ty_unknown or text.length() > 9 { give back 0 - 1 }
    pilot value = 0
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot digit = v4_index_of_from("0123456789", text.char_at(idx), 0)
        if digit < 0 { give back 0 - 1 }
        value = value * 10 + digit
        idx += 1
    }
    give back value
}

-- "shape", "tuple", "array" or "" (not an admitted native aggregate).
task v4_codegen_llvm_aggregate_kind(mir_id: int, type_text: word) -> word {
    if type_text == "" or type_text == v4_ty_unknown { give back "" }
    if v4_ty_is_tuple_type(type_text) { give back "tuple" }
    if v4_ty_is_fixed_array_type(type_text) { give back "array" }
    if v4_mir_shape_signature(mir_id, type_text) >= 0 { give back "shape" }
    give back ""
}

task v4_codegen_llvm_aggregate_slot_count(mir_id: int, type_text: word) -> int {
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "tuple" { give back v4_ty_tuple_slot_count(type_text) }
    if kind == "array" { give back v4_codegen_llvm_fixed_array_length(mir_id, type_text) }
    if kind == "shape" { give back v4_mir_shape_field_count(mir_id, type_text) }
    give back 0 - 1
}

task v4_codegen_llvm_aggregate_slot_type(mir_id: int, type_text: word, slot: int) -> word {
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "tuple" { give back v4_ty_tuple_slot_type(type_text, slot) }
    if kind == "array" { give back v4_ty_fixed_array_element_type(type_text) }
    if kind == "shape" { give back v4_mir_shape_field_type(mir_id, type_text, slot) }
    give back v4_ty_unknown
}

-- LLVM text for a tuple or fixed array (shapes use their named type).
task v4_codegen_llvm_literal_aggregate_type(mir_id: int, type_text: word) -> word {
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "array" {
        pilot length = v4_codegen_llvm_fixed_array_length(mir_id, type_text)
        if length < 0 { give back "ptr" }
        give back "[" + word_from_int(length) + " x " + v4_codegen_llvm_type(v4_ty_fixed_array_element_type(type_text)) + "]"
    }
    pilot out = "{ "
    pilot slot = 0
    repeat until slot >= v4_ty_tuple_slot_count(type_text) {
        if slot > 0 { out = out + ", " }
        out = out + v4_codegen_llvm_type(v4_ty_tuple_slot_type(type_text, slot))
        slot += 1
    }
    give back out + " }"
}

-- True when a native shape, tuple, fixed array or route holds an owned word
-- at any depth.
task v4_codegen_llvm_type_owns_words(mir_id: int, type_text: word) -> bool {
    give back v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0) > 0
}

-- Owned word leaves of an aggregate type, or -1 past 32 nesting levels.
task v4_codegen_llvm_word_leaf_count(mir_id: int, type_text: word, depth: int) -> int {
    if depth > 32 { give back 0 - 1 }
    if v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text) == v4_ty_word { give back 1 }
    if v4_ty_is_lend_type(type_text) { give back 0 }
    -- A list is one owned handle: its drop glue frees the buffer and its
    -- elements' words (v4_codegen_llvm_list_drop_lines).
    if v4_codegen_llvm_is_list(mir_id, type_text) { give back 1 }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "" { give back v4_codegen_llvm_route_word_leaf_count(mir_id, type_text, depth) }
    if kind == "array" {
        pilot length = v4_codegen_llvm_fixed_array_length(mir_id, type_text)
        pilot element = v4_codegen_llvm_word_leaf_count(mir_id, v4_ty_fixed_array_element_type(type_text), depth + 1)
        if element <= 0 or length <= 0 { give back element }
        -- Saturate: the leaf budget check only needs to know it is too many.
        if length > 65536 or element > 65536 { give back 65537 }
        give back element * length
    }
    pilot total = 0
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot leaves = v4_codegen_llvm_word_leaf_count(mir_id, v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot), depth + 1)
        if leaves < 0 { give back leaves }
        total += leaves
        if total > 65536 { give back 65537 }
        slot += 1
    }
    give back total
}

-- A route's word leaves across all its cases (each case reads its own).
task v4_codegen_llvm_route_word_leaf_count(mir_id: int, type_text: word, depth: int) -> int {
    pilot sig = v4_codegen_llvm_route_signature(mir_id, type_text)
    if sig < 0 { give back 0 }
    pilot total = 0
    pilot case_id = 0
    repeat until case_id >= v4_ty_route_case_count(v4_mir_ty_id(mir_id), v4_codegen_llvm_route_sig(mir_id, sig)) {
        pilot field = 0
        repeat until field >= v4_codegen_llvm_route_field_count(mir_id, sig, case_id) {
            pilot leaves = v4_codegen_llvm_word_leaf_count(mir_id, v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field), depth + 1)
            if leaves < 0 { give back leaves }
            total += leaves
            if total > 65536 { give back 65537 }
            field += 1
        }
        case_id += 1
    }
    give back total
}

-- Whether a type's drop glue must read memory: a route's payload holds
-- words of whichever case its tag names.
task v4_codegen_llvm_type_has_route_words(mir_id: int, type_text: word, depth: int) -> bool {
    if depth > 32 or v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0) <= 0 { give back false }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "" { give back v4_codegen_llvm_route_signature(mir_id, type_text) >= 0 }
    if kind == "array" { give back v4_codegen_llvm_type_has_route_words(mir_id, v4_ty_fixed_array_element_type(type_text), depth + 1) }
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        if v4_codegen_llvm_type_has_route_words(mir_id, v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot), depth + 1) { give back true }
        slot += 1
    }
    give back false
}

-- Drop glue in place: release every word leaf of the value at `address`.
-- A route releases the leaves of the case its tag names. With `cond` (an
-- i1 value, or "") each leaf is released only when cond holds.
task v4_codegen_llvm_drop_glue_at(mir_id: int, type_text: word, address: word, cond: word, temp: word, depth: int) -> word {
    if depth > 32 { give back "" }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_canonical_type(ty_id, type_text) == v4_ty_word {
        pilot out = "  " + temp + ".h = load i64, ptr " + address + "\n"
        pilot handle = temp + ".h"
        if cond != "" {
            handle = temp + ".o"
            out = out + "  " + handle + " = select i1 " + cond + ", i64 " + temp + ".h, i64 0\n"
        }
        give back out + "  call void @freak_v4_word_drop(i64 " + handle + ")\n"
    }
    if v4_codegen_llvm_is_list(mir_id, type_text) { give back v4_codegen_llvm_list_drop_lines(mir_id, type_text, address, "", cond, temp) }
    if v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0) <= 0 { give back "" }
    pilot llvm_ty = v4_codegen_llvm_type(type_text)
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    pilot out = ""
    if kind == "" {
        pilot sig = v4_codegen_llvm_route_signature(mir_id, type_text)
        if sig < 0 { give back "" }
        pilot tag_ty = v4_codegen_llvm_route_tag_type(mir_id, sig)
        out = "  " + temp + ".tag = load " + tag_ty + ", ptr " + address + "\n"
        out = out + "  " + temp + ".payload = getelementptr inbounds " + llvm_ty + ", ptr " + address + ", i32 0, i32 1\n"
        pilot case_id = 0
        repeat until case_id >= v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) {
            pilot case_struct = v4_codegen_llvm_route_case_struct(mir_id, sig, case_id)
            pilot case_temp = temp + ".c" + word_from_int(case_id)
            pilot field = 0
            pilot fields = v4_codegen_llvm_route_field_count(mir_id, sig, case_id)
            pilot opened = false
            pilot live_case = case_temp + ".is"
            if cond != "" { live_case = case_temp + ".when" }
            repeat until field >= fields {
                pilot field_ty = v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field)
                if v4_codegen_llvm_word_leaf_count(mir_id, field_ty, 0) > 0 {
                    if not opened {
                        out = out + "  " + case_temp + ".is = icmp eq " + tag_ty + " " + temp + ".tag, " + v4_codegen_llvm_route_tag_value(mir_id, sig, case_id) + "\n"
                        if cond != "" { out = out + "  " + live_case + " = and i1 " + cond + ", " + case_temp + ".is\n" }
                        opened = true
                    }
                    pilot field_temp = case_temp + ".f" + word_from_int(field)
                    out = out + "  " + field_temp + " = getelementptr inbounds " + case_struct + ", ptr " + temp + ".payload, i32 0, i32 " + word_from_int(field) + "\n"
                    out = out + v4_codegen_llvm_drop_glue_at(mir_id, field_ty, field_temp, live_case, field_temp, depth + 1)
                }
                field += 1
            }
            case_id += 1
        }
        give back out
    }
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot slot_ty = v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot)
        if v4_codegen_llvm_word_leaf_count(mir_id, slot_ty, 0) > 0 {
            pilot slot_temp = temp + ".s" + word_from_int(slot)
            out = out + "  " + slot_temp + " = getelementptr inbounds " + llvm_ty + ", ptr " + address + ", i32 0, i32 " + word_from_int(slot) + "\n"
            out = out + v4_codegen_llvm_drop_glue_at(mir_id, slot_ty, slot_temp, cond, slot_temp, depth + 1)
        }
        slot += 1
    }
    give back out
}

-- Null every word leaf of the value at `address` after a move took it; a
-- route moved whole is zeroed (its tag then names no live payload).
task v4_codegen_llvm_null_words_at(mir_id: int, type_text: word, address: word, temp: word, depth: int) -> word {
    if depth > 32 { give back "" }
    if v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text) == v4_ty_word { give back "  store i64 0, ptr " + address + "\n" }
    if v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0) <= 0 { give back "" }
    pilot llvm_ty = v4_codegen_llvm_type(type_text)
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "" { give back "  store " + llvm_ty + " zeroinitializer, ptr " + address + "\n" }
    pilot out = ""
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot slot_ty = v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot)
        if v4_codegen_llvm_word_leaf_count(mir_id, slot_ty, 0) > 0 {
            pilot slot_temp = temp + ".s" + word_from_int(slot)
            out = out + "  " + slot_temp + " = getelementptr inbounds " + llvm_ty + ", ptr " + address + ", i32 0, i32 " + word_from_int(slot) + "\n"
            out = out + v4_codegen_llvm_null_words_at(mir_id, slot_ty, slot_temp, slot_temp, depth + 1)
        }
        slot += 1
    }
    give back out
}

-- The extractvalue index path of every word leaf, ";"-separated in slot
-- order ("0;1, 0" for (word, (word, int))). Callers bound the leaf count.
task v4_codegen_llvm_word_leaf_paths(mir_id: int, type_text: word, prefix: word) -> word {
    pilot child_prefix = prefix
    if prefix != "" { child_prefix = prefix + ", " }
    if v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text) == v4_ty_word { give back prefix }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "" or v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0) <= 0 { give back "" }
    pilot out = ""
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot paths = v4_codegen_llvm_word_leaf_paths(mir_id, v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot), child_prefix + word_from_int(slot))
        if paths != "" {
            if out != "" { out = out + ";" }
            out = out + paths
        }
        slot += 1
    }
    give back out
}

-- Release every word leaf of an aggregate value (handles may be 0, which
-- the runtime drop ignores).
task v4_codegen_llvm_aggregate_word_drop_lines(mir_id: int, type_text: word, value: word, temp: word) -> word {
    pilot llvm_ty = v4_codegen_llvm_type(type_text)
    pilot paths = v4_codegen_llvm_word_leaf_paths(mir_id, type_text, "")
    pilot out = ""
    pilot leaf = 0
    pilot start = 0
    repeat until start > paths.length() or paths == "" {
        pilot stop = v4_index_of_from(paths, ";", start)
        if stop < 0 { stop = paths.length() }
        pilot handle = temp + ".leaf." + word_from_int(leaf)
        out = out + "  " + handle + " = extractvalue " + llvm_ty + " " + value + ", " + v4_slice(paths, start, stop) + "\n"
        out = out + "  call void @freak_v4_word_drop(i64 " + handle + ")\n"
        leaf += 1
        start = stop + 1
    }
    -- List leaves release through their element's drop helper.
    paths = v4_codegen_llvm_list_leaf_paths(mir_id, type_text, "")
    start = 0
    repeat until start > paths.length() or paths == "" {
        pilot stop = v4_index_of_from(paths, "\n", start)
        if stop < 0 { stop = paths.length() }
        pilot path = v4_slice(paths, start, stop)
        pilot list_ty = v4_slice(path, v4_index_of_from(path, "=", 0) + 1, path.length())
        pilot header = temp + ".list." + word_from_int(leaf)
        out = out + "  " + header + " = extractvalue " + llvm_ty + " " + value + ", " + v4_slice(path, 0, v4_index_of_from(path, "=", 0)) + "\n"
        out = out + v4_codegen_llvm_list_drop_lines(mir_id, list_ty, "", header, "", header)
        leaf += 1
        start = stop + 1
    }
    give back out
}

-- The extractvalue index path of every list leaf of a shape, tuple or
-- array, each followed by "=" and the list type, newline-separated (type
-- text may hold ";"). Words inside a list belong to the list's drop helper.
task v4_codegen_llvm_list_leaf_paths(mir_id: int, type_text: word, prefix: word) -> word {
    if v4_codegen_llvm_is_list(mir_id, type_text) { give back prefix + "=" + v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text) }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "" or not v4_codegen_llvm_type_holds_list(mir_id, type_text, 0) { give back "" }
    pilot child_prefix = prefix
    if prefix != "" { child_prefix = prefix + ", " }
    pilot out = ""
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot paths = v4_codegen_llvm_list_leaf_paths(mir_id, v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot), child_prefix + word_from_int(slot))
        if paths != "" {
            if out != "" { out = out + "\n" }
            out = out + paths
        }
        slot += 1
    }
    give back out
}

-- One aggregate slot: scalars, owned words, pointers and nested aggregates.
-- A word slot is owned by its aggregate: the aggregate moves as one value
-- and its drop releases every word leaf (v4_codegen_llvm_word_leaf_paths).
task v4_codegen_llvm_native_slot_error(mir_id: int, slot_ty: word, context: word, depth: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if slot_ty == "" or slot_ty == v4_ty_unknown { give back "native aggregate slot type is unresolved: " + context }
    if v4_ty_is_lend_type(slot_ty) { give back "native aggregate lend slots are not yet supported: " + context }
    if v4_ty_is_native_scalar_sum(ty_id, slot_ty) { give back "native aggregate maybe/result slots are not yet supported: " + context }
    if v4_ty_canonical_type(ty_id, slot_ty) == v4_ty_word { give back "" }
    -- A list slot is one owned header; the aggregate's drop glue frees it.
    if v4_codegen_llvm_is_list(mir_id, slot_ty) { give back v4_codegen_llvm_native_list_slot_error(mir_id, slot_ty, depth + 1) }
    if v4_ty_is_native_owned_value(ty_id, slot_ty) {
        if v4_mir_shape_signature(mir_id, v4_slice(context, 0, v4_index_of_from(context, ".", 0))) >= 0 { give back "native shape fields that own words are not yet supported: " + context }
        give back "native aggregate slots that own words are not yet supported: " + context
    }
    give back v4_codegen_llvm_native_type_error_depth(slot_ty, false, depth + 1)
}

-- "-" when type_text is not an aggregate at all; "" when it is supported.
task v4_codegen_llvm_native_shape_error(mir_id: int, type_text: word, depth: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if type_text == "" or type_text == v4_ty_unknown { give back "-" }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "" and v4_codegen_llvm_route_signature(mir_id, type_text) >= 0 { kind = "route" }
    if kind == "" {
        if v4_ty_shape_signature_id_for_name(ty_id, v4_ty_canonical_type(ty_id, type_text)) >= 0 { give back "native generic shapes need monomorphization: " + type_text }
        if v4_ty_route_signature_id_for_name(ty_id, v4_ty_canonical_type(ty_id, type_text)) >= 0 { give back "native generic routes need monomorphization: " + type_text }
        give back "-"
    }
    if depth > 32 { give back "native aggregate nesting exceeds supported depth: " + type_text }
    if v4_codegen_llvm_shape_ok_mir != mir_id {
        v4_codegen_llvm_shape_ok_mir = mir_id
        v4_codegen_llvm_shape_ok = ","
        v4_codegen_llvm_shape_visiting = ","
    }
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    pilot ok_key = "," + canonical + "@" + word_from_int(depth) + ","
    if v4_codegen_llvm_shape_ok.contains(ok_key) { give back "" }
    if v4_codegen_llvm_shape_visiting.contains("," + canonical + ",") { give back "native shape contains itself by value: " + type_text }
    pilot saved_visiting = v4_codegen_llvm_shape_visiting
    v4_codegen_llvm_shape_visiting = saved_visiting + canonical + ","
    pilot error = v4_codegen_llvm_native_aggregate_slots_error(mir_id, ty_id, kind, type_text, depth)
    v4_codegen_llvm_shape_visiting = saved_visiting
    if error == "" { v4_codegen_llvm_shape_ok = v4_codegen_llvm_shape_ok + canonical + "@" + word_from_int(depth) + "," }
    give back error
}

task v4_codegen_llvm_native_aggregate_slots_error(mir_id: int, ty_id: int, kind: word, type_text: word, depth: int) -> word {
    if kind == "array" {
        pilot length = v4_codegen_llvm_fixed_array_length(mir_id, type_text)
        if length < 0 { give back "native fixed array length is not a known constant: " + type_text }
        if length > 1048576 { give back "native fixed arrays longer than 1048576 elements are not yet supported: " + type_text }
        give back v4_codegen_llvm_native_slot_error(mir_id, v4_ty_fixed_array_element_type(type_text), type_text + "[]", depth)
    }
    if kind == "route" { give back v4_codegen_llvm_native_route_error(mir_id, v4_codegen_llvm_route_signature(mir_id, type_text), depth) }
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot context = type_text + "." + word_from_int(slot)
        if kind == "shape" { context = type_text + "." + v4_ty_shape_field_name(ty_id, v4_mir_shape_signature(mir_id, type_text), slot) }
        pilot error = v4_codegen_llvm_native_slot_error(mir_id, v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot), context, depth)
        if error != "" { give back error }
        slot += 1
    }
    give back ""
}

-- Routes (tier 3). A concrete route lowers to a named struct { tag, payload }.
-- The tag is the @repr width (i32 without @repr, i64 when a discriminant
-- needs it) and holds the TY discriminant of the case. Each payload case is a
-- literal struct of its fields in declaration order; the payload member is
-- storage sized and aligned by freak_target's C union rules over all cases.
-- Fieldless routes have no payload member.
-- A route id: the TY signature of a concrete route, or for a concrete
-- generic route instance (Opt<int>) the signature count plus its index in
-- this lowering's instance list. Route helpers read the TY signature through
-- v4_codegen_llvm_route_sig and the name TY applies the arguments by through
-- v4_codegen_llvm_route_name, so payload field types are substituted.
pilot v4_codegen_llvm_route_instances: word = "\n"

task v4_codegen_llvm_route_signature(mir_id: int, type_text: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if type_text == "" or type_text == v4_ty_unknown { give back 0 - 1 }
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, canonical)
    if sig_id < 0 { give back 0 - 1 }
    if v4_ty_signature_generic_count(ty_id, sig_id) == 0 {
        if v4_ty_is_generic_instance_type(canonical) { give back 0 - 1 }
        give back sig_id
    }
    if not v4_mir_generic_aggregate_instance_is_native(ty_id, sig_id, canonical) { give back 0 - 1 }
    pilot index = 0
    pilot cursor = 1
    repeat until cursor >= v4_codegen_llvm_route_instances.length() {
        pilot stop = v4_index_of_from(v4_codegen_llvm_route_instances, "\n", cursor)
        if v4_slice(v4_codegen_llvm_route_instances, cursor, stop) == canonical { give back v4_ty_signature_count(ty_id) + index }
        cursor = stop + 1
        index += 1
    }
    v4_codegen_llvm_route_instances = v4_codegen_llvm_route_instances + canonical + "\n"
    give back v4_ty_signature_count(ty_id) + index
}

task v4_codegen_llvm_route_instance_text(mir_id: int, route_id: int) -> word {
    pilot index = route_id - v4_ty_signature_count(v4_mir_ty_id(mir_id))
    if index < 0 { give back "" }
    pilot cursor = 1
    repeat until index <= 0 {
        cursor = v4_index_of_from(v4_codegen_llvm_route_instances, "\n", cursor) + 1
        if cursor <= 0 { give back "" }
        index -= 1
    }
    pilot stop = v4_index_of_from(v4_codegen_llvm_route_instances, "\n", cursor)
    if stop < 0 { give back "" }
    give back v4_slice(v4_codegen_llvm_route_instances, cursor, stop)
}

task v4_codegen_llvm_route_sig(mir_id: int, route_id: int) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if route_id < v4_ty_signature_count(ty_id) { give back route_id }
    give back v4_ty_route_signature_id_for_name(ty_id, v4_codegen_llvm_route_instance_text(mir_id, route_id))
}

task v4_codegen_llvm_route_name(mir_id: int, route_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if route_id < v4_ty_signature_count(ty_id) { give back v4_ty_signature_name(ty_id, route_id) }
    give back v4_codegen_llvm_route_instance_text(mir_id, route_id)
}

task v4_codegen_llvm_route_type_name(mir_id: int, sig: int) -> word {
    pilot symbol = v4_codegen_llvm_symbol("freak.route." + v4_codegen_llvm_route_name(mir_id, sig))
    give back "%" + v4_slice(symbol, 1, symbol.length())
}

task v4_codegen_llvm_route_tag_type(mir_id: int, sig: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot repr = v4_ty_signature_repr_kind(ty_id, v4_codegen_llvm_route_sig(mir_id, sig))
    if repr != "" { give back "i" + v4_slice(repr, 1, repr.length()) }
    pilot case_id = 0
    repeat until case_id >= v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) {
        pilot text = v4_ty_route_case_discriminant_value_by_sig(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)
        if text != "" {
            pilot value = word_to_int(text)
            if value < 0 - 2147483648 or value > 2147483647 { give back "i64" }
        }
        case_id += 1
    }
    give back "i32"
}

-- The tag constant for a case, as signed LLVM text in the tag width.
task v4_codegen_llvm_route_tag_value(mir_id: int, sig: int, case_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot text = v4_ty_route_case_discriminant_value_by_sig(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)
    pilot repr = v4_ty_signature_repr_kind(ty_id, v4_codegen_llvm_route_sig(mir_id, sig))
    if text == "" or not repr.starts_with("u") or repr == "u64" { give back text }
    pilot value = word_to_int(text)
    pilot span = 256
    if repr == "u16" { span = 65536 }
    if repr == "u32" { span = 4294967296 }
    if value >= span / 2 { give back word_from_int(value - span) }
    give back text
}

task v4_codegen_llvm_route_case_id(mir_id: int, sig: int, case_name: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_route_case_id_for_name(ty_id, v4_codegen_llvm_route_name(mir_id, sig), case_name)
}

task v4_codegen_llvm_route_case_name(mir_id: int, sig: int, case_id: int) -> word {
    give back v4_ty_route_case_name(v4_mir_ty_id(mir_id), v4_codegen_llvm_route_sig(mir_id, sig), case_id)
}

-- Fields of a case; 0 for a fieldless case.
task v4_codegen_llvm_route_field_count(mir_id: int, sig: int, case_id: int) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_name = v4_codegen_llvm_route_name(mir_id, sig)
    pilot case_name = v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)
    if not v4_ty_route_case_has_payload(ty_id, route_name, case_name) { give back 0 }
    give back v4_ty_route_case_field_count(ty_id, route_name, case_name)
}

task v4_codegen_llvm_route_field_type(mir_id: int, sig: int, case_id: int, field: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_route_case_field_type(ty_id, v4_codegen_llvm_route_name(mir_id, sig), v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id), field)
}

-- The literal struct one payload case stores: "{ A, B }", or "{}" with no fields.
task v4_codegen_llvm_route_case_struct(mir_id: int, sig: int, case_id: int) -> word {
    pilot count = v4_codegen_llvm_route_field_count(mir_id, sig, case_id)
    if count <= 0 { give back "{" + "}" }
    pilot out = "{ "
    pilot field = 0
    repeat until field >= count {
        if field > 0 { out = out + ", " }
        out = out + v4_codegen_llvm_type(v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field))
        field += 1
    }
    give back out + " }"
}

task v4_codegen_llvm_route_has_payload(mir_id: int, sig: int) -> bool {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot case_id = 0
    repeat until case_id >= v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) {
        if v4_ty_route_case_has_payload(ty_id, v4_codegen_llvm_route_name(mir_id, sig), v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)) { give back true }
        case_id += 1
    }
    give back false
}

-- Discriminants must be distinct compile-time integers that fit the tag;
-- payload fields must be native slots that own no words.
task v4_codegen_llvm_native_route_error(mir_id: int, sig: int, depth: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_name = v4_codegen_llvm_route_name(mir_id, sig)
    pilot repr = v4_ty_signature_repr_kind(ty_id, v4_codegen_llvm_route_sig(mir_id, sig))
    if v4_ty_signature_repr(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) != "" and repr == "" { give back "native route @repr is not a known integer width: " + route_name }
    pilot low = 0 - 9223372036854775807 - 1
    pilot high = 9223372036854775807
    if repr == "i8" or repr == "i16" or repr == "i32" {
        pilot bits = word_to_int(v4_slice(repr, 1, repr.length()))
        high = 1
        repeat until bits <= 1 {
            high = high * 2
            bits -= 1
        }
        low = 0 - high
        high = high - 1
    }
    if repr == "u8" or repr == "u16" or repr == "u32" {
        pilot bits = word_to_int(v4_slice(repr, 1, repr.length()))
        high = 1
        repeat until bits <= 0 {
            high = high * 2
            bits -= 1
        }
        low = 0
        high = high - 1
    }
    if repr == "u64" {
        low = 0
    }
    pilot count = v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig))
    pilot case_id = 0
    repeat until case_id >= count {
        pilot case_name = v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)
        pilot context = route_name + "::" + case_name
        pilot explicit_text = v4_ty_route_case_explicit_discriminant_text_by_sig(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)
        if explicit_text != "" {
            pilot resolved = v4_ty_const_integer_text_from_expr(ty_id, explicit_text)
            if resolved == "" or resolved == v4_ty_unknown or v4_codegen_llvm_integer_literal_error(v4_ty_int, resolved) != "" { give back "native route discriminant is not a 64-bit compile-time integer: " + context }
        }
        pilot text = v4_ty_route_case_discriminant_value_by_sig(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id)
        if text == "" { give back "native route discriminant is not a 64-bit compile-time integer: " + context }
        pilot value = word_to_int(text)
        if value < low or value > high {
            if repr == "" { give back "native route discriminant overflows int: " + context }
            give back "native route discriminant does not fit @repr(" + repr + "): " + context + " = " + text
        }
        pilot other = 0
        repeat until other >= case_id {
            if v4_ty_route_case_discriminant_value_by_sig(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), other) == text { give back "native route discriminants must be distinct: " + route_name + "::" + v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), other) + " and " + context + " are both " + text }
            other += 1
        }
        pilot field = 0
        pilot fields = v4_codegen_llvm_route_field_count(mir_id, sig, case_id)
        repeat until field >= fields {
            pilot field_ty = v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field)
            pilot field_context = context + "." + v4_ty_route_case_field_name(ty_id, route_name, case_name, field)
            -- Words and word-owning aggregates are native payloads (dropped
            -- by tag); the maybe/result carriers are not yet.
            if field_ty != "" and field_ty != v4_ty_unknown and v4_ty_is_native_owned_value(ty_id, field_ty) and v4_ty_canonical_type(ty_id, field_ty) != v4_ty_word { give back "native route payload fields that own words are not yet supported: " + field_context }
            pilot error = v4_codegen_llvm_native_slot_error(mir_id, field_ty, field_context, depth)
            if error != "" { give back error }
            field += 1
        }
        case_id += 1
    }
    give back ""
}

-- A route-typed UseSymbol naming one of its cases: a unit value, or the tag
-- operand MIR builds for a payload pattern test.
task v4_codegen_llvm_route_case_symbol(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or v4_codegen_llvm_active_owned_mir != mir_id or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_use_symbol { give back 0 - 1 }
    pilot sig = v4_codegen_llvm_route_signature(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    if sig < 0 { give back 0 - 1 }
    pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    pilot next_case = v4_mir_path_right(case_name)
    -- A bare name is a binding (a constant or global that happens to share a
    -- case's spelling), never a case: cases are always path-qualified.
    if next_case == "" { give back 0 - 1 }
    repeat until next_case == "" {
        case_name = next_case
        next_case = v4_mir_path_right(case_name)
    }
    give back v4_codegen_llvm_route_case_id(mir_id, sig, case_name)
}

-- The case a Construct of a route builds, or -1.
task v4_codegen_llvm_route_construct_case(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_construct { give back 0 - 1 }
    pilot sig = v4_codegen_llvm_route_signature(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    if sig < 0 { give back 0 - 1 }
    pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    pilot next_case = v4_mir_path_right(case_name)
    repeat until next_case == "" {
        case_name = next_case
        next_case = v4_mir_path_right(case_name)
    }
    give back v4_codegen_llvm_route_case_id(mir_id, sig, case_name)
}

task v4_codegen_llvm_route_construct_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot sig = v4_codegen_llvm_route_signature(mir_id, type_text)
    pilot case_id = v4_codegen_llvm_route_construct_case(mir_id, body_id, rvalue_id)
    if case_id < 0 { give back "invalid native route construct: " + v4_mir_rvalue_op(mir_id, body_id, rvalue_id) }
    pilot fields = v4_codegen_llvm_route_field_count(mir_id, sig, case_id)
    if fields != v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) { give back "invalid native route construct: " + v4_mir_rvalue_op(mir_id, body_id, rvalue_id) }
    pilot field = 0
    repeat until field >= fields {
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, field)
        pilot error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, child), v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field))
        if error != "" { give back error }
        field += 1
    }
    give back ""
}

-- The slot of a payload Field place: case * 65536 + field. A place built
-- by a case pattern carries its case as a sealed MIR fact
-- (v4_mir_place_route_payload_case), so it resolves exactly in that case.
task v4_codegen_llvm_route_place_slot(mir_id: int, body_id: int, place_id: int, sig: int) -> int {
    pilot case_name = v4_mir_place_route_payload_case(mir_id, body_id, place_id)
    pilot field_name = v4_mir_place_route_payload_field(mir_id, body_id, place_id)
    if case_name == "" { give back v4_codegen_llvm_route_field_slot(mir_id, sig, field_name) }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot case_id = v4_codegen_llvm_route_case_id(mir_id, sig, case_name)
    if case_id < 0 or v4_codegen_llvm_route_field_count(mir_id, sig, case_id) <= 0 { give back 0 - 1 }
    pilot field = v4_ty_route_case_field_id_for_name(ty_id, v4_codegen_llvm_route_name(mir_id, sig), case_name, field_name)
    if field < 0 { give back 0 - 1 }
    give back case_id * 65536 + field
}

-- A payload Field place without a case fact names a field only. It
-- resolves when one case declares the name, or when every case declaring it
-- puts it at the same position after identically typed fields (so at the
-- same offset). Gives back case * 65536 + field, -1 when no case has it,
-- -2 if ambiguous.
task v4_codegen_llvm_route_field_slot(mir_id: int, sig: int, field_name: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_name = v4_codegen_llvm_route_name(mir_id, sig)
    pilot found = 0 - 1
    pilot found_case = 0 - 1
    pilot case_id = 0
    repeat until case_id >= v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) {
        pilot field = 0 - 1
        if v4_codegen_llvm_route_field_count(mir_id, sig, case_id) > 0 { field = v4_ty_route_case_field_id_for_name(ty_id, route_name, v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, sig), case_id), field_name) }
        if field >= 0 {
            if found_case < 0 {
                found_case = case_id
                found = field
            } else {
                if field != found { give back 0 - 2 }
                pilot prior = 0
                repeat until prior > field {
                    if v4_codegen_llvm_route_field_type(mir_id, sig, case_id, prior) != v4_codegen_llvm_route_field_type(mir_id, sig, found_case, prior) { give back 0 - 2 }
                    prior += 1
                }
            }
        }
        case_id += 1
    }
    if found_case < 0 { give back 0 - 1 }
    give back found_case * 65536 + found
}

task v4_codegen_llvm_route_field_place_error(mir_id: int, body_id: int, place_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot base = v4_mir_place_base(mir_id, body_id, place_id)
    pilot sig = v4_codegen_llvm_route_signature(mir_id, v4_codegen_llvm_place_referent_ty(mir_id, body_id, base))
    pilot slot = v4_codegen_llvm_route_place_slot(mir_id, body_id, place_id, sig)
    pilot text = v4_mir_place_text(mir_id, body_id, place_id)
    if slot == 0 - 2 { give back "native route payload fields shared by cases at different offsets are not yet supported: " + text }
    if slot < 0 { give back "native route payload place names no field: " + text }
    pilot declared = v4_codegen_llvm_route_field_type(mir_id, sig, slot / 65536, slot % 65536)
    if v4_ty_canonical_type(ty_id, declared) != v4_ty_canonical_type(ty_id, v4_mir_place_ty(mir_id, body_id, place_id)) { give back "native field place type differs from the declared field type: " + text }
    give back ""
}

-- Payload storage is member 1; the case struct is read in place there.
task v4_codegen_llvm_route_field_address(parts: int, mir_id: int, body_id: int, place_id: int, base_pointer: word, temp: word) -> word {
    pilot base = v4_mir_place_base(mir_id, body_id, place_id)
    pilot sig = v4_codegen_llvm_route_signature(mir_id, v4_codegen_llvm_place_referent_ty(mir_id, body_id, base))
    pilot slot = v4_codegen_llvm_route_place_slot(mir_id, body_id, place_id, sig)
    v4_codegen_llvm_fragment_push(parts, "  " + temp + ".payload = getelementptr inbounds " + v4_codegen_llvm_route_type_name(mir_id, sig) + ", ptr " + base_pointer + ", i32 0, i32 1\n")
    v4_codegen_llvm_fragment_push(parts, "  " + temp + " = getelementptr inbounds " + v4_codegen_llvm_route_case_struct(mir_id, sig, slot / 65536) + ", ptr " + temp + ".payload, i32 0, i32 " + word_from_int(slot % 65536) + "\n")
    give back temp
}

task v4_codegen_llvm_route_slot(body_id: int, rvalue_id: int) -> word {
    give back "%route.tmp." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

-- One entry-block slot per payload construct, reused when a loop repeats it.
task v4_codegen_llvm_route_slots(mir_id: int, body_id: int) -> word {
    pilot out = ""
    pilot value = 0
    repeat until value >= v4_mir_body_rvalue_count(mir_id, body_id) {
        if v4_codegen_llvm_route_construct_case(mir_id, body_id, value) >= 0 {
            out = out + "  " + v4_codegen_llvm_route_slot(body_id, value) + " = alloca " + v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, value)) + "\n"
        }
        value += 1
    }
    give back out
}

-- Fields (already evaluated in source order) assemble into the case struct;
-- the zeroed slot then takes the tag and the payload and is read back whole.
task v4_codegen_llvm_route_construct_lines(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot sig = v4_codegen_llvm_route_signature(mir_id, type_text)
    pilot case_id = v4_codegen_llvm_route_construct_case(mir_id, body_id, rvalue_id)
    pilot llvm_ty = v4_codegen_llvm_type(type_text)
    pilot case_struct = v4_codegen_llvm_route_case_struct(mir_id, sig, case_id)
    pilot prefix = "%route." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
    pilot out = ""
    pilot previous = "undef"
    pilot fields = v4_codegen_llvm_route_field_count(mir_id, sig, case_id)
    pilot field = 0
    repeat until field >= fields {
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, field)
        pilot field_ty = v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field)
        pilot cast = prefix + "." + word_from_int(field) + ".cast"
        out = out + v4_codegen_llvm_expected_lines(mir_id, body_id, child, field_ty, cast)
        pilot name = prefix + "." + word_from_int(field)
        out = out + "  " + name + " = insertvalue " + case_struct + " " + previous + ", " + v4_codegen_llvm_type(field_ty) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, child, field_ty, cast) + ", " + word_from_int(field) + "\n"
        previous = name
        field += 1
    }
    pilot slot = v4_codegen_llvm_route_slot(body_id, rvalue_id)
    out = out + "  store " + llvm_ty + " zeroinitializer, ptr " + slot + "\n"
    out = out + "  store " + v4_codegen_llvm_route_tag_type(mir_id, sig) + " " + v4_codegen_llvm_route_tag_value(mir_id, sig, case_id) + ", ptr " + slot + "\n"
    if fields > 0 {
        out = out + "  " + prefix + ".payload = getelementptr inbounds " + llvm_ty + ", ptr " + slot + ", i32 0, i32 1\n"
        out = out + "  store " + case_struct + " " + previous + ", ptr " + prefix + ".payload\n"
    }
    give back out + "  " + target + " = load " + llvm_ty + ", ptr " + slot + "\n"
}

-- Route == and != compare tags. That is the whole equality for fieldless
-- routes and exactly a case test when one side names a case (MIR's pattern
-- tests); other payload equality needs doctrine lowering.
task v4_codegen_llvm_route_binary_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot lhs_ty = v4_mir_rvalue_ty(mir_id, body_id, lhs)
    pilot rhs_ty = v4_mir_rvalue_ty(mir_id, body_id, rhs)
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    if op != v4_mir_bin_eq and op != v4_mir_bin_ne { give back "native route operators need doctrine lowering" }
    pilot sig = v4_codegen_llvm_route_signature(mir_id, lhs_ty)
    if sig < 0 or sig != v4_codegen_llvm_route_signature(mir_id, rhs_ty) or v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) != v4_ty_bool { give back "invalid native route comparison" }
    if v4_codegen_llvm_route_has_payload(mir_id, sig) and v4_codegen_llvm_route_case_symbol(mir_id, body_id, lhs) < 0 and v4_codegen_llvm_route_case_symbol(mir_id, body_id, rhs) < 0 { give back "native route equality with payloads needs doctrine lowering" }
    give back ""
}

task v4_codegen_llvm_route_is_binary(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_binary { give back false }
    give back v4_codegen_llvm_route_signature(mir_id, v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))) >= 0
}

-- Unit case values and tag comparisons. Called once from the special-kind
-- helper so the recursive collector's frame stays as it is.
task v4_codegen_llvm_collect_route_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word, kind: word) -> bool {
    if kind == v4_mir_rvalue_use_symbol {
        pilot case_id = v4_codegen_llvm_route_case_symbol(mir_id, body_id, rvalue_id)
        if case_id < 0 { give back false }
        pilot sig = v4_codegen_llvm_route_signature(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = insertvalue " + v4_codegen_llvm_route_type_name(mir_id, sig) + " zeroinitializer, " + v4_codegen_llvm_route_tag_type(mir_id, sig) + " " + v4_codegen_llvm_route_tag_value(mir_id, sig, case_id) + ", 0\n")
        give back true
    }
    if not v4_codegen_llvm_route_is_binary(mir_id, body_id, rvalue_id) { give back false }
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, lhs, v4_codegen_llvm_temp_value(body_id, lhs), false)
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, rhs, v4_codegen_llvm_temp_value(body_id, rhs), false)
    pilot sig = v4_codegen_llvm_route_signature(mir_id, v4_mir_rvalue_ty(mir_id, body_id, lhs))
    pilot llvm_ty = v4_codegen_llvm_route_type_name(mir_id, sig)
    pilot tag_ty = v4_codegen_llvm_route_tag_type(mir_id, sig)
    pilot predicate = "eq"
    if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_bin_ne { predicate = "ne" }
    pilot out = "  " + target + ".ltag = extractvalue " + llvm_ty + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, lhs) + ", 0\n"
    out = out + "  " + target + ".rtag = extractvalue " + llvm_ty + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, rhs) + ", 0\n"
    v4_codegen_llvm_fragment_push(parts, out + "  " + target + " = icmp " + predicate + " " + tag_ty + " " + target + ".ltag, " + target + ".rtag\n")
    give back true
}

-- Generic aggregate instances (tier 3, monomorphization). TY declares Box<T>
-- once; each concrete instance an emitted body names (in a local, place,
-- rvalue or return type, or inside the slots of those types) gets its own
-- named type and layout record, keyed by its canonical text. The fields of
-- every emitted nongeneric shape and route seed the walk too, because
-- shape_records writes those records whether or not a body names them.
pilot v4_codegen_llvm_generic_seen: word = ""
pilot v4_codegen_llvm_generic_parts: int = 0 - 1

task v4_codegen_llvm_generic_aggregate_records(mir_id: int) -> word {
    v4_codegen_llvm_generic_seen = "\n"
    v4_codegen_llvm_generic_parts = v4_codegen_llvm_fragment_new()
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig = 0
    repeat until sig >= v4_ty_signature_count(ty_id) {
        pilot kind = v4_ty_signature_kind(ty_id, sig)
        if (kind == v4_ty_shape_sig or kind == v4_ty_route_sig) and v4_ty_signature_generic_count(ty_id, sig) == 0 {
            v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_ty_signature_name(ty_id, sig), 0)
        }
        sig += 1
    }
    pilot body = v4_codegen_llvm_next_emitted_body(mir_id, 0)
    repeat until body >= v4_mir_body_count(mir_id) {
        v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_mir_body_callable_return_type(mir_id, body), 0)
        pilot row = 0
        repeat until row >= v4_mir_body_local_count(mir_id, body) {
            v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_mir_local_ty(mir_id, body, row), 0)
            row += 1
        }
        row = 0
        repeat until row >= v4_mir_body_place_count(mir_id, body) {
            v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_mir_place_ty(mir_id, body, row), 0)
            row += 1
        }
        row = 0
        repeat until row >= v4_mir_body_rvalue_count(mir_id, body) {
            v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_mir_rvalue_ty(mir_id, body, row), 0)
            row += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    pilot out = word_join(v4_codegen_llvm_generic_parts)
    array_release(v4_codegen_llvm_generic_parts)
    v4_codegen_llvm_generic_parts = 0 - 1
    v4_codegen_llvm_generic_seen = ""
    give back out
}

task v4_codegen_llvm_visit_generic_aggregates(mir_id: int, surface: word, depth: int) -> void {
    if depth > 32 or surface == "" or surface == v4_ty_unknown { give back }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot type_text = v4_ty_canonical_type(ty_id, surface)
    if v4_codegen_llvm_generic_seen.contains("\n" + type_text + "\n") { give back }
    v4_codegen_llvm_generic_seen = v4_codegen_llvm_generic_seen + type_text + "\n"
    if v4_ty_is_raw_pointer_type(type_text) {
        v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_ty_raw_pointer_target_type(type_text), depth + 1)
        give back
    }
    if v4_ty_is_lend_type(type_text) {
        v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_ty_lend_target_type(type_text), depth + 1)
        give back
    }
    if v4_ty_is_fixed_array_type(type_text) {
        v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_ty_fixed_array_element_type(type_text), depth + 1)
        give back
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot = 0
        repeat until slot >= v4_ty_tuple_slot_count(type_text) {
            v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_ty_tuple_slot_type(type_text, slot), depth + 1)
            slot += 1
        }
        give back
    }
    pilot sig = v4_mir_shape_signature(mir_id, type_text)
    if sig >= 0 {
        pilot record = v4_codegen_llvm_shape_type_name(mir_id, type_text)
        pilot field = 0
        repeat until field >= v4_mir_shape_field_count(mir_id, type_text) {
            pilot field_ty = v4_mir_shape_field_type(mir_id, type_text, field)
            v4_codegen_llvm_visit_generic_aggregates(mir_id, field_ty, depth + 1)
            record = record + "\t" + v4_codegen_llvm_type(field_ty)
            field += 1
        }
        if v4_ty_signature_generic_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) > 0 and v4_codegen_llvm_native_shape_error(mir_id, type_text, 0) == "" { v4_codegen_llvm_fragment_push(v4_codegen_llvm_generic_parts, record + "\n") }
        give back
    }
    pilot route_id = v4_codegen_llvm_route_signature(mir_id, type_text)
    if route_id >= 0 {
        pilot record = v4_codegen_llvm_route_type_name(mir_id, route_id) + "\t" + v4_codegen_llvm_route_tag_type(mir_id, route_id)
        pilot case_id = 0
        repeat until case_id >= v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, route_id)) {
            pilot field = 0
            repeat until field >= v4_codegen_llvm_route_field_count(mir_id, route_id, case_id) {
                v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_codegen_llvm_route_field_type(mir_id, route_id, case_id, field), depth + 1)
                field += 1
            }
            if v4_ty_route_case_has_payload(ty_id, v4_codegen_llvm_route_name(mir_id, route_id), v4_ty_route_case_name(ty_id, v4_codegen_llvm_route_sig(mir_id, route_id), case_id)) { record = record + "\t|" + v4_codegen_llvm_route_case_struct(mir_id, route_id, case_id) }
            case_id += 1
        }
        if route_id >= v4_ty_signature_count(ty_id) and v4_codegen_llvm_native_shape_error(mir_id, type_text, 0) == "" { v4_codegen_llvm_fragment_push(v4_codegen_llvm_generic_parts, record + "\n") }
        give back
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot arg = 0
        repeat until arg >= v4_ty_generic_arg_count(type_text) {
            v4_codegen_llvm_visit_generic_aggregates(mir_id, v4_ty_generic_arg(type_text, arg), depth + 1)
            arg += 1
        }
    }
}

-- One record per supported concrete shape: "<llvm name>\t<member>\t..."
-- where a member is the LLVM type of a field. Records are joined by
-- newlines; module_text turns them into type definitions and freak_target
-- layout notes.
task v4_codegen_llvm_shape_records(mir_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot sig = 0
    repeat until sig >= v4_ty_signature_count(ty_id) {
        if v4_ty_signature_kind(ty_id, sig) == v4_ty_shape_sig and v4_ty_signature_generic_count(ty_id, sig) == 0 {
            pilot name = v4_ty_signature_name(ty_id, sig)
            if v4_mir_shape_signature(mir_id, name) == sig and v4_codegen_llvm_native_shape_error(mir_id, name, 0) == "" {
                pilot record = v4_codegen_llvm_shape_type_name(mir_id, name)
                pilot field = 0
                repeat until field >= v4_ty_shape_field_count(ty_id, sig) {
                    record = record + "\t" + v4_codegen_llvm_type(v4_ty_shape_field_type(ty_id, sig, field))
                    field += 1
                }
                v4_codegen_llvm_fragment_push(parts, record + "\n")
            }
        }
        -- A route record is its tag, then one "|"-marked union member per
        -- payload case; module_text sizes the payload storage per target.
        if v4_ty_signature_kind(ty_id, sig) == v4_ty_route_sig and v4_ty_signature_generic_count(ty_id, sig) == 0 {
            pilot name = v4_ty_signature_name(ty_id, sig)
            if v4_codegen_llvm_route_signature(mir_id, name) == sig and v4_codegen_llvm_native_shape_error(mir_id, name, 0) == "" {
                pilot record = v4_codegen_llvm_route_type_name(mir_id, sig) + "\t" + v4_codegen_llvm_route_tag_type(mir_id, sig)
                pilot case_id = 0
                repeat until case_id >= v4_ty_route_case_count(ty_id, sig) {
                    if v4_ty_route_case_has_payload(ty_id, name, v4_ty_route_case_name(ty_id, sig, case_id)) { record = record + "\t|" + v4_codegen_llvm_route_case_struct(mir_id, sig, case_id) }
                    case_id += 1
                }
                v4_codegen_llvm_fragment_push(parts, record + "\n")
            }
        }
        sig += 1
    }
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_generic_aggregate_records(mir_id))
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_closure_records(mir_id))
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_dyn_records(mir_id))
    if v4_codegen_llvm_list_used { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_list_header_type() + "\tptr\ti64\ti64\n") }
    pilot out = word_join(parts)
    array_release(parts)
    give back out + v4_codegen_llvm_sum_records(mir_id)
}

task v4_codegen_llvm_record_line(records: word, wanted: int) -> word {
    pilot line = 0
    pilot start = 0
    repeat until line >= wanted {
        pilot stop = v4_index_of_from(records, "\n", start)
        if stop < 0 { give back "" }
        start = stop + 1
        line += 1
    }
    pilot stop = v4_index_of_from(records, "\n", start)
    if stop < 0 { give back "" }
    give back v4_slice(records, start, stop)
}

task v4_codegen_llvm_record_count(records: word) -> int {
    pilot count = 0
    pilot start = 0
    repeat until start >= records.length() {
        pilot stop = v4_index_of_from(records, "\n", start)
        if stop < 0 { give back count }
        count += 1
        start = stop + 1
    }
    give back count
}

-- The records' terminated lines, read once per record table.
task v4_codegen_llvm_record_index(records: word) -> int {
    if v4_codegen_llvm_record_index_ready and records == v4_codegen_llvm_record_index_text { give back v4_codegen_llvm_record_index_lines }
    if v4_codegen_llvm_record_index_ready {
        array_release(v4_codegen_llvm_record_index_lines)
        array_release(v4_codegen_llvm_record_index_names)
    }
    v4_codegen_llvm_record_index_lines = array_new()
    v4_codegen_llvm_record_index_names = array_new()
    pilot start = 0
    repeat until start >= records.length() {
        pilot stop = v4_index_of_from(records, "\n", start)
        if stop < 0 { start = records.length() } else {
            pilot line = v4_slice(records, start, stop)
            array_push(v4_codegen_llvm_record_index_lines, line)
            array_push(v4_codegen_llvm_record_index_names, v4_codegen_llvm_record_part(line, 0))
            start = stop + 1
        }
    }
    v4_codegen_llvm_record_index_text = records
    v4_codegen_llvm_record_index_ready = true
    give back v4_codegen_llvm_record_index_lines
}

-- The record named name, or "".
task v4_codegen_llvm_record_named(records: word, name: word) -> word {
    pilot lines = v4_codegen_llvm_record_index(records)
    pilot line_id = 0
    repeat until line_id >= array_len(lines) {
        pilot candidate: word = array_get(v4_codegen_llvm_record_index_names, line_id)
        if candidate == name { give back array_get(lines, line_id) }
        line_id += 1
    }
    give back ""
}

-- Tab-separated part of a record: 0 is the name, then one per member.
task v4_codegen_llvm_record_part(line: word, wanted: int) -> word {
    pilot part = 0
    pilot start = 0
    repeat until part >= wanted {
        pilot tab = v4_index_of_from(line, "\t", start)
        if tab < 0 { give back "" }
        start = tab + 1
        part += 1
    }
    pilot stop = v4_index_of_from(line, "\t", start)
    if stop < 0 { stop = line.length() }
    give back v4_slice(line, start, stop)
}

task v4_codegen_llvm_record_part_count(line: word) -> int {
    pilot count = 1
    pilot start = 0
    repeat until start >= line.length() {
        pilot tab = v4_index_of_from(line, "\t", start)
        if tab < 0 { give back count }
        count += 1
        start = tab + 1
    }
    give back count
}

task v4_codegen_llvm_layout_entry(layout: word) -> word {
    pilot size = v4_target_layout_size(layout)
    pilot align = v4_target_layout_align(layout)
    if size < 0 or align <= 0 { give back "" }
    give back word_from_int(size) + ":" + word_from_int(align)
}

-- The payload union of a route record: "" without "|" members, "-" when a
-- case has no layout or the union alignment has no integer carrier.
task v4_codegen_llvm_record_union_layout(records: word, line: word, target_spec: word, depth: int) -> word {
    pilot entries = ""
    pilot member = 1
    repeat until member >= v4_codegen_llvm_record_part_count(line) {
        pilot part = v4_codegen_llvm_record_part(line, member)
        if part.starts_with("|") {
            pilot entry = v4_codegen_llvm_layout_entry(v4_codegen_llvm_llvm_type_layout(records, v4_slice(part, 1, part.length()), target_spec, depth + 1))
            if entry == "" { give back "-" }
            if entries != "" { entries = entries + "," }
            entries = entries + entry
        }
        member += 1
    }
    if entries == "" { give back "" }
    pilot layout = v4_target_union_layout(target_spec, entries)
    if v4_codegen_llvm_union_storage_type(layout, target_spec) == "" { give back "-" }
    give back layout
}

-- "[n x iA]": an array of the integer carrier whose freak_target size and
-- alignment are the union alignment has exactly the union's layout.
task v4_codegen_llvm_union_storage_type(layout: word, target_spec: word) -> word {
    pilot size = v4_target_layout_size(layout)
    pilot align = v4_target_layout_align(layout)
    if size < 0 or (align != 1 and align != 2 and align != 4 and align != 8) { give back "" }
    pilot carrier = "i" + word_from_int(align * 8)
    if v4_target_carrier_size(target_spec, carrier) != align or v4_target_carrier_align(target_spec, carrier) != align { give back "" }
    give back "[" + word_from_int(size / align) + " x " + carrier + "]"
}

-- freak_target layout of an LLVM type as codegen emits it: a carrier, a
-- named shape (looked up in the records), "{ a, b }" or "[N x T]". Named
-- shapes are memoized per target and record set: nested shapes repeat.
task v4_codegen_llvm_llvm_type_layout(records: word, text: word, target_spec: word, depth: int) -> word {
    if depth > 64 { give back "" }
    if not text.starts_with("%") { give back v4_codegen_llvm_llvm_type_layout_uncached(records, text, target_spec, depth) }
    if not v4_codegen_llvm_layout_memo_ready or target_spec != v4_codegen_llvm_layout_memo_target or records != v4_codegen_llvm_layout_memo_records {
        if v4_codegen_llvm_layout_memo_ready {
            array_release(v4_codegen_llvm_layout_memo_names)
            array_release(v4_codegen_llvm_layout_memo_layouts)
        }
        v4_codegen_llvm_layout_memo_names = array_new()
        v4_codegen_llvm_layout_memo_layouts = array_new()
        v4_codegen_llvm_layout_memo_target = target_spec
        v4_codegen_llvm_layout_memo_records = records
        v4_codegen_llvm_layout_memo_ready = true
    }
    pilot memo_id = 0
    repeat until memo_id >= array_len(v4_codegen_llvm_layout_memo_names) {
        pilot memo_name: word = array_get(v4_codegen_llvm_layout_memo_names, memo_id)
        if memo_name == text { give back array_get(v4_codegen_llvm_layout_memo_layouts, memo_id) }
        memo_id += 1
    }
    pilot layout = v4_codegen_llvm_llvm_type_layout_uncached(records, text, target_spec, depth)
    if layout != "" {
        array_push(v4_codegen_llvm_layout_memo_names, text)
        array_push(v4_codegen_llvm_layout_memo_layouts, layout)
    }
    give back layout
}

task v4_codegen_llvm_llvm_type_layout_uncached(records: word, text: word, target_spec: word, depth: int) -> word {
    if text.starts_with("%") {
        pilot line = v4_codegen_llvm_record_named(records, text)
        if line != "" {
            pilot entries = ""
            pilot member = 1
            repeat until member >= v4_codegen_llvm_record_part_count(line) {
                pilot part = v4_codegen_llvm_record_part(line, member)
                if part.starts_with("|") { member = v4_codegen_llvm_record_part_count(line) } else {
                    pilot entry = v4_codegen_llvm_layout_entry(v4_codegen_llvm_llvm_type_layout(records, part, target_spec, depth + 1))
                    if entry == "" { give back "" }
                    if member > 1 { entries = entries + "," }
                    entries = entries + entry
                    member += 1
                }
            }
            pilot payload = v4_codegen_llvm_record_union_layout(records, line, target_spec, depth)
            if payload == "-" { give back "" }
            if payload != "" { entries = entries + "," + v4_codegen_llvm_layout_entry(payload) }
            give back v4_target_struct_layout(target_spec, entries)
        }
        give back ""
    }
    if text.starts_with("{") {
        if text == "{" + "  }" or text == "{" + "}" { give back v4_target_struct_layout(target_spec, "") }
        pilot entries = ""
        pilot nesting = 0
        pilot quoted = false
        pilot start = 2
        pilot idx = 2
        pilot stop = text.length() - 2
        repeat until idx > stop {
            pilot ch = ""
            if idx < stop { ch = text.char_at(idx) }
            -- A quoted record name such as "freak.shape.Pair<int, bool>" holds commas.
            if ch == "\"" { quoted = not quoted; ch = "" }
            if quoted { ch = "" }
            if ch == "{" or ch == "[" { nesting += 1 }
            if ch == "}" or ch == "]" { nesting -= 1 }
            if idx == stop or (ch == "," and nesting == 0) {
                pilot entry = v4_codegen_llvm_layout_entry(v4_codegen_llvm_llvm_type_layout(records, v4_slice(text, start, idx), target_spec, depth + 1))
                if entry == "" { give back "" }
                if entries != "" { entries = entries + "," }
                entries = entries + entry
                start = idx + 2
            }
            idx += 1
        }
        give back v4_target_struct_layout(target_spec, entries)
    }
    if text.starts_with("[") {
        -- "[N x T]": the length ends at the first space.
        pilot cross = v4_index_of_from(text, " ", 1)
        if cross < 2 or v4_slice(text, cross, cross + 3) != " x " { give back "" }
        pilot length = 0
        pilot idx = 1
        repeat until idx >= cross {
            pilot digit = v4_index_of_from("0123456789", text.char_at(idx), 0)
            if digit < 0 { give back "" }
            length = length * 10 + digit
            -- freak_target's supported object range; keeps size * length
            -- below int overflow for any element that fits it too.
            if length > 1099511627776 { give back "" }
            idx += 1
        }
        pilot element = v4_codegen_llvm_llvm_type_layout(records, v4_slice(text, cross + 3, text.length() - 1), target_spec, depth + 1)
        pilot size = v4_target_layout_size(element)
        pilot align = v4_target_layout_align(element)
        if size < 0 or align <= 0 { give back "" }
        if size > 0 and length > 1099511627776 / size { give back "" }
        give back word_from_int(size * length) + "|" + word_from_int(align) + "|0"
    }
    pilot size = v4_target_carrier_size(target_spec, text)
    pilot align = v4_target_carrier_align(target_spec, text)
    if size < 0 or align <= 0 { give back "" }
    give back word_from_int(size) + "|" + word_from_int(align) + "|0"
}

-- Type definitions plus one "; freak.layout" note per shape. The note is the
-- freak_target answer; check_v4 compares it with Clang's DataLayout.
task v4_codegen_llvm_shape_module_lines(records: word, target_spec: word) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot line_id = 0
    pilot lines = v4_codegen_llvm_record_index(records)
    repeat until line_id >= array_len(lines) {
        pilot line: word = array_get(lines, line_id)
        pilot out = ""
        pilot name = v4_codegen_llvm_record_part(line, 0)
        pilot spaced = ""
        pilot cases = ""
        pilot member = 1
        repeat until member >= v4_codegen_llvm_record_part_count(line) {
            pilot part = v4_codegen_llvm_record_part(line, member)
            if part.starts_with("|") {
                if cases != "" { cases = cases + " | " }
                cases = cases + v4_slice(part, 1, part.length())
            } else {
                if member > 1 { spaced = spaced + ", " }
                spaced = spaced + part
            }
            member += 1
        }
        pilot payload = ""
        if cases != "" {
            payload = v4_codegen_llvm_record_union_layout(records, line, target_spec, 0)
            spaced = spaced + ", " + v4_codegen_llvm_union_storage_type(payload, target_spec)
        }
        pilot layout = v4_codegen_llvm_llvm_type_layout(records, name, target_spec, 0)
        out = out + name + " = type { " + spaced + " }\n"
        out = out + "; freak.layout " + name + " size=" + word_from_int(v4_target_layout_size(layout)) + " align=" + word_from_int(v4_target_layout_align(layout)) + " offsets=" + v4_target_layout_offsets(layout) + "\n"
        -- Each case struct of a route, for the oracle's C union check.
        if cases != "" { out = out + "; freak.payload " + name + " size=" + word_from_int(v4_target_layout_size(payload)) + " align=" + word_from_int(v4_target_layout_align(payload)) + " cases=" + cases + "\n" }
        v4_codegen_llvm_fragment_push(parts, out)
        line_id += 1
    }
    if line_id > 0 { v4_codegen_llvm_fragment_push(parts, "\n") }
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- module_text: each aggregate ABI marker in a body becomes the freak_target
-- layout of its type, `align A dereferenceable(S)` (a zero-sized aggregate
-- is only aligned), and the body is preceded by one `; freak.abi` note per
-- aggregate pointer, which check_v4 compares with Clang's DataLayout.
task v4_codegen_llvm_abi_resolve(text: word, records: word, target_spec: word) -> word {
    pilot marker = "$freak.abi.attrs "
    if not text.contains(marker) { give back text }
    -- Markers only appear in the define header, the body's first line.
    pilot header_end = v4_index_of_from(text, "\n", 0)
    if header_end < 0 { header_end = text.length() }
    pilot symbol_start = v4_index_of_from(text, "@", 0)
    pilot symbol_stop = v4_index_of_from(text, "(", symbol_start)
    pilot symbol = ""
    if symbol_start >= 0 and symbol_stop > symbol_start and symbol_stop < header_end { symbol = v4_slice(text, symbol_start, symbol_stop) }
    pilot notes = ""
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot emitted = 0
    pilot start = v4_index_of_from(text, "$", 0)
    repeat until start < 0 or start >= header_end {
        pilot stop = v4_index_of_from(text, "$", start + marker.length())
        if v4_slice(text, start, start + marker.length()) != marker or stop < 0 or stop >= header_end { start = 0 - 1 } else {
            v4_codegen_llvm_fragment_push(parts, v4_slice(text, emitted, start))
            pilot llvm_ty = v4_slice(text, start + marker.length(), stop)
            pilot layout = v4_codegen_llvm_llvm_type_layout(records, llvm_ty, target_spec, 0)
            pilot size = v4_target_layout_size(layout)
            pilot align = v4_target_layout_align(layout)
            if size >= 0 and align > 0 {
                pilot attrs = "align " + word_from_int(align)
                if size > 0 { attrs = attrs + " dereferenceable(" + word_from_int(size) + ")" }
                v4_codegen_llvm_fragment_push(parts, attrs)
                pilot name_stop = stop + 2
                repeat until name_stop >= header_end or text.char_at(name_stop) == "," or text.char_at(name_stop) == ")" { name_stop += 1 }
                -- A lend parameter (`nonnull`, plus `noalias` for lend mut) says so.
                pilot pass = ""
                if start >= 8 and v4_slice(text, start - 8, start) == "nonnull " {
                    pass = " pass=lend"
                    if start >= 16 and v4_slice(text, start - 16, start - 8) == "noalias " { pass = " pass=lend_mut" }
                }
                notes = notes + "; freak.abi " + symbol + " " + v4_slice(text, stop + 2, name_stop) + " size=" + word_from_int(size) + " align=" + word_from_int(align) + " type=" + llvm_ty + pass + "\n"
            }
            emitted = stop + 1
            start = v4_index_of_from(text, "$", emitted)
        }
    }
    v4_codegen_llvm_fragment_push(parts, v4_slice(text, emitted, text.length()))
    give back notes + v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_shape_layout_error(records: word, target_spec: word) -> word {
    pilot line_id = 0
    v4_codegen_llvm_record_index(records)
    repeat until line_id >= array_len(v4_codegen_llvm_record_index_names) {
        pilot name: word = array_get(v4_codegen_llvm_record_index_names, line_id)
        if v4_codegen_llvm_llvm_type_layout(records, name, target_spec, 0) == "" { give back "native shape layout is not available for this target: " + name }
        line_id += 1
    }
    give back ""
}

task v4_codegen_llvm_native_type_error(type_text: word, allow_void: bool) -> word {
    give back v4_codegen_llvm_native_type_error_depth(type_text, allow_void, 0)
}

-- Canonical MIR types erase the declared C widths. Inspect raw TY surfaces
-- only while sealing, after bodies/callbacks have retained their plan oracles.
-- Direct extern declarations lower the C integer widths themselves (see
-- v4_codegen_llvm_signature_is_c_width_decl) and skip this fence for those
-- positions; everywhere else (FREAK signatures, locals, pointees, callbacks,
-- function types, aliases) C widths and wchar remain fenced by name.
task v4_codegen_llvm_native_c_surface_error_depth(ty_id: int, surface: word, c_boundary: bool, direct: bool, depth: int) -> word {
    if depth > 32 { give back "native C ABI surface nesting exceeds supported depth" }
    pilot alias_name = v4_ty_surface_ffi_alias_name(surface)
    -- Inside an extern function pointer type, a C width spelled directly
    -- (not through an alias or a pointee) is lowered by the C call plan and
    -- the callback trampolines; see v4_codegen_llvm_c_call_plan.
    if c_boundary and direct and depth > 0 and v4_codegen_llvm_c_width_key(surface) != "" { give back "" }
    if alias_name == "c_int" or alias_name == "c_uint" or alias_name == "c_long" or alias_name == "c_ulong" or alias_name == "c_short" or alias_name == "c_ushort" or alias_name == "wchar" or alias_name == "c_char" or alias_name == "c_uchar" or alias_name == "c_bool" { give back "native C scalar ABI not yet supported: " + surface }
    if c_boundary and v4_codegen_llvm_active_owned_mir >= 0 and surface == v4_ty_word { give back "native owned word C ABI is not yet supported" }
    if c_boundary and v4_ty_is_native_scalar_sum(ty_id, surface) { give back "native scalar sum C ABI is not yet supported" }
    -- Aggregates cross C boundaries only after the C ABI row classifies them
    -- (sret/byval/register splits); a raw LLVM aggregate is not the C ABI.
    if c_boundary and v4_ty_shape_signature_id_for_name(ty_id, v4_ty_canonical_type(ty_id, surface)) >= 0 { give back "native shape C ABI by value is not yet supported: " + surface }
    if c_boundary and (v4_ty_is_tuple_type(surface) or v4_ty_is_fixed_array_type(surface)) { give back "native tuple and array C ABI by value is not yet supported: " + surface }
    -- A native route is a { tag, payload } struct, not a C enum integer.
    if c_boundary and v4_ty_route_signature_id_for_name(ty_id, v4_ty_canonical_type(ty_id, surface)) >= 0 { give back "native route C ABI is not yet supported: " + surface }
    if c_boundary and (surface == v4_ty_bool or surface == v4_ty_tiny or surface == v4_ty_char) { give back "native C scalar ABI not yet supported: " + surface }
    if v4_ty_is_surface_ffi_alias_type(surface) { give back "" }
    if v4_ty_is_raw_pointer_type(surface) { give back v4_codegen_llvm_native_c_surface_error_depth(ty_id, v4_ty_raw_pointer_target_type(surface), false, false, depth + 1) }
    if v4_ty_is_surface_task_function_type(surface) {
        pilot nested_boundary: bool = v4_ty_is_surface_extern_function_pointer_type(surface)
        if nested_boundary and v4_ty_function_type_variadic_param_id(surface) >= 0 { give back "native C variadic function pointers are not yet supported" }
        pilot error = v4_codegen_llvm_native_c_surface_error_depth(ty_id, v4_ty_function_type_return_text(surface), nested_boundary, direct, depth + 1)
        if error != "" { give back error }
        pilot param = 0
        repeat until param >= v4_ty_function_type_fixed_param_count(surface) {
            error = v4_codegen_llvm_native_c_surface_error_depth(ty_id, v4_ty_function_type_param_surface(surface, param), nested_boundary, direct, depth + 1)
            if error != "" { give back error }
            param += 1
        }
        give back ""
    }
    if v4_ty_is_fixed_array_type(surface) { give back v4_codegen_llvm_native_c_surface_error_depth(ty_id, v4_ty_fixed_array_element_type(surface), c_boundary, direct, depth + 1) }
    if v4_ty_is_tuple_type(surface) {
        pilot slot = 0
        repeat until slot >= v4_ty_tuple_slot_count(surface) {
            pilot slot_error = v4_codegen_llvm_native_c_surface_error_depth(ty_id, v4_ty_tuple_slot_type(surface, slot), false, direct, depth + 1)
            if slot_error != "" { give back slot_error }
            slot += 1
        }
        give back ""
    }
    pilot alias_lookup = v4_ty_alias_lookup_type_from_surface_type(ty_id, surface)
    if alias_lookup != "" {
        pilot target = v4_ty_alias_target_type(ty_id, alias_lookup)
        if target == "" or target == v4_ty_unknown { give back "native C ABI alias target is unresolved: " + surface }
        -- Codegen reads C widths from the spelled surface, never through an alias.
        give back v4_codegen_llvm_native_c_surface_error_depth(ty_id, target, c_boundary, false, depth + 1)
    }
    give back ""
}

task v4_codegen_llvm_native_c_surface_error(ty_id: int, surface: word, c_boundary: bool) -> word {
    give back v4_codegen_llvm_native_c_surface_error_depth(ty_id, surface, c_boundary, true, 0)
}

-- An instance keeps its generic signature's spelled surfaces; generic tasks
-- never sit on a C boundary.
task v4_codegen_llvm_generic_instance_c_surface_error(mir_id: int, ty_id: int, body: int) -> word {
    pilot sig = v4_mir_body_generic_signature_id(mir_id, body)
    if sig < 0 { give back "native C ABI callable surface is unresolved" }
    if v4_ty_signature_call_abi(ty_id, sig) != "" or v4_ty_signature_has_extern_callback(ty_id, sig) { give back "native generic tasks cannot cross the C ABI: " + v4_ty_signature_name(ty_id, sig) }
    pilot error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_signature_return_surface_type(ty_id, sig), false)
    pilot param = 0
    repeat until param >= v4_ty_signature_fixed_param_count(ty_id, sig) or error != "" {
        error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_signature_param_surface_type(ty_id, sig, param), false)
        param += 1
    }
    pilot annotation = 0
    repeat until annotation >= v4_ty_signature_local_annotation_count(ty_id, sig) or error != "" {
        error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_signature_local_annotation_surface_type(ty_id, sig, annotation), false)
        annotation += 1
    }
    give back error
}

task v4_codegen_llvm_native_c_width_error(mir_id: int, ty_id: int) -> word {
    pilot sig = 0
    repeat until sig >= v4_ty_signature_count(ty_id) {
        -- A generic template never gets a body of its own, so a C boundary on it
        -- (call ABI or @extern_callback trampoline) is fenced by name here,
        -- whether or not any instance was requested.
        if v4_ty_signature_kind(ty_id, sig) == v4_ty_task_sig and v4_ty_signature_type_generic_count(ty_id, sig) > 0 and (v4_ty_signature_call_abi(ty_id, sig) != "" or v4_ty_signature_has_extern_callback(ty_id, sig)) { give back "native generic tasks cannot cross the C ABI: " + v4_ty_signature_name(ty_id, sig) }
        if v4_codegen_llvm_signature_is_callable(ty_id, sig) {
            pilot boundary: bool = v4_ty_signature_call_abi(ty_id, sig) != "" or v4_ty_signature_has_extern_callback(ty_id, sig)
            if boundary and v4_ty_signature_is_variadic(ty_id, sig) {
                if v4_ty_signature_has_extern_callback(ty_id, sig) { give back "native C variadic callbacks are not yet supported: " + v4_ty_signature_name(ty_id, sig) }
                if not v4_codegen_llvm_signature_is_extern_decl(ty_id, sig) { give back "native C variadic ABI not yet supported" }
            }
            -- Extern declarations and @extern_callback trampolines lower C
            -- widths themselves; every other position keeps the named fence.
            pilot c_width: bool = v4_codegen_llvm_signature_lowers_c_widths(ty_id, sig)
            pilot error = ""
            if not c_width or v4_codegen_llvm_c_width_key(v4_ty_signature_return_surface_type(ty_id, sig)) == "" { error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_signature_return_surface_type(ty_id, sig), boundary) }
            if error != "" { give back error }
            pilot param = 0
            repeat until param >= v4_ty_signature_fixed_param_count(ty_id, sig) {
                if not c_width or v4_codegen_llvm_c_width_key(v4_ty_signature_param_surface_type(ty_id, sig, param)) == "" { error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_signature_param_surface_type(ty_id, sig, param), boundary) }
                if error != "" { give back error }
                param += 1
            }
            pilot annotation = 0
            repeat until annotation >= v4_ty_signature_local_annotation_count(ty_id, sig) {
                error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_signature_local_annotation_surface_type(ty_id, sig, annotation), false)
                if error != "" { give back error }
                annotation += 1
            }
        }
        sig += 1
    }
    pilot last_annotation_owner = 0 - 1
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot rvalue = 0
        repeat until rvalue >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_mir_rvalue_kind(mir_id, body, rvalue) == v4_mir_rvalue_use_symbol {
                pilot named = v4_ty_task_signature_id_for_name(ty_id, v4_mir_rvalue_text(mir_id, body, rvalue))
                -- A C-width extern used as a value is the real C symbol; calls through
                -- it take the C call plan. A variadic one would need the
                -- `(FIXED, ...)` call form on every indirect call: fenced.
                if named >= 0 and v4_ty_signature_is_variadic(ty_id, named) { give back "native C variadic function pointers are not yet supported: " + v4_mir_rvalue_text(mir_id, body, rvalue) }
            }
            if v4_mir_rvalue_kind(mir_id, body, rvalue) == v4_mir_rvalue_unary and v4_mir_rvalue_op(mir_id, body, rvalue) == v4_mir_unary_ptr_cast {
                pilot target_surface = v4_ty_raw_pointer_cast_target_surface(v4_mir_rvalue_text(mir_id, body, rvalue))
                if target_surface == v4_ty_unknown { give back "native C ABI pointer cast surface is unresolved" }
                pilot error = v4_codegen_llvm_native_c_surface_error(ty_id, target_surface, false)
                if error != "" { give back error }
            }
            rvalue += 1
        }
        -- A closure body's parameters are checked where MIR Build lowers it,
        -- and its locals share the creating task's annotation table.
        if v4_mir_body_generic_signature_id(mir_id, body) >= 0 {
            pilot error = v4_codegen_llvm_generic_instance_c_surface_error(mir_id, ty_id, body)
            if error != "" { give back error }
        } else if v4_mir_body_signature_id(mir_id, body) < 0 and not v4_mir_body_is_module_init(mir_id, body) and not v4_mir_body_is_closure(mir_id, body) {
            pilot item = v4_mir_body_impl_method_index(mir_id, body, 0)
            pilot method = v4_mir_body_impl_method_index(mir_id, body, 1)
            if item < 0 or method < 0 { give back "native C ABI callable surface is unresolved" }
            pilot error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_impl_method_return_surface_type(ty_id, item, method), false)
            if error != "" { give back error }
            pilot param = 0
            repeat until param >= v4_ty_impl_method_param_count(ty_id, item, method) {
                error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_impl_method_param_surface_type(ty_id, item, method, param), false)
                if error != "" { give back error }
                param += 1
            }
            -- Methods share the owner's annotation table. Reuse only a
            -- completed scan; returning to an earlier owner rechecks it.
            if item != last_annotation_owner {
                pilot annotation = 0
                repeat until annotation >= v4_ty_impl_method_local_annotation_count(ty_id, item) {
                    error = v4_codegen_llvm_native_c_surface_error(ty_id, v4_ty_impl_method_local_annotation_surface_type(ty_id, item, annotation), false)
                    if error != "" { give back error }
                    annotation += 1
                }
                last_annotation_owner = item
            }
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back ""
}

task v4_codegen_llvm_native_binary_op_supported(op: word) -> bool {
    give back op == v4_mir_bin_add or op == v4_mir_bin_sub or op == v4_mir_bin_mul or op == v4_mir_bin_div or op == v4_mir_bin_mod or op == v4_mir_bin_gt or op == v4_mir_bin_lt or op == v4_mir_bin_ge or op == v4_mir_bin_le or op == v4_mir_bin_eq or op == v4_mir_bin_ne or op == v4_mir_bin_and or op == v4_mir_bin_or
}

-- Validate decimal syntax and bounds without parsing the whole literal into
-- a host integer. Leading zeroes never change the magnitude comparison.
task v4_codegen_llvm_float_literal_value(text: word) -> word {
    if text.starts_with(".") { give back "0" + text }
    if text.starts_with("-.") { give back "-0" + text.substring(1, text.length() - 1) }
    give back text
}

task v4_codegen_llvm_float_literal_error(type_text: word, text: word) -> word {
    pilot size = text.length()
    if size <= 0 { give back "invalid native floating literal text" }
    pilot index = 0
    if text.substring(0, 1) == "-" { index = 1 }
    pilot dotted = false
    pilot fractional = 0
    pilot nonzero = false
    repeat until index >= size {
        pilot digit = text.substring(index, 1)
        if "0123456789".contains(digit) {
            if dotted { fractional += 1 }
            if digit != "0" { nonzero = true }
        } else if digit == "." and not dotted { dotted = true } else { give back "invalid native floating literal text" }
        index += 1
    }
    -- Ordinary tokens are digits+'.'+digits+. Pattern MIR may use .5/-.5;
    -- normalize these spellings before emission. No LLVM syntax is permitted.
    if not dotted or fractional <= 0 { give back "invalid native floating literal text" }
    pilot parsed: num = word_to_num(v4_codegen_llvm_float_literal_value(text))
    if parsed - parsed != 0.0 or (parsed == 0.0 and nonzero) { give back "native floating literal out of range: " + type_text }
    if v4_codegen_llvm_type(type_text) == "float" and (parsed > 340282346638528859811704183484516925440.0 or parsed < -340282346638528859811704183484516925440.0) { give back "native floating literal out of range: " + type_text }
    give back ""
}

task v4_codegen_llvm_integer_literal_error(type_text: word, text: word) -> word {
    pilot size = text.length()
    if size <= 0 { give back "invalid native integer literal text" }
    pilot offset = 0
    pilot negative = false
    if text.substring(0, 1) == "-" { negative = true; offset = 1 }
    if offset >= size { give back "invalid native integer literal text" }
    pilot first_nonzero = size
    pilot index = offset
    repeat until index >= size {
        pilot digit = text.substring(index, 1)
        if not "0123456789".contains(digit) { give back "invalid native integer literal text" }
        if first_nonzero == size and digit != "0" { first_nonzero = index }
        index += 1
    }
    pilot kind = v4_codegen_llvm_numeric_kind(type_text)
    if kind == "num" { give back v4_codegen_llvm_float_literal_error(type_text, text + ".0") }
    if kind != "int" and kind != "uint" and kind != "tiny" { give back "invalid native integer literal type: " + type_text }
    if negative and kind != "int" { give back "native integer literal out of range: " + type_text }
    pilot bound = "9223372036854775807"
    if negative { bound = "9223372036854775808" }
    if kind == "uint" { bound = "18446744073709551615" }
    if kind == "tiny" { bound = "255" }
    pilot digits = size - first_nonzero
    if digits > bound.length() { give back "native integer literal out of range: " + type_text }
    if digits < bound.length() { give back "" }
    index = 0
    repeat until index >= digits {
        pilot actual = word_to_int(text.substring(first_nonzero + index, 1))
        pilot maximum = word_to_int(bound.substring(index, 1))
        if actual > maximum { give back "native integer literal out of range: " + type_text }
        if actual < maximum { give back "" }
        index += 1
    }
    give back ""
}

-- Every conversion site must have one representable carrier plan. Reject
-- malformed low-level MIR instead of letting unrelated pointer/word/char
-- carriers become integer or floating values through an accidental cast.
task v4_codegen_llvm_native_conversion_error(actual: word, expected: word) -> word {
    if actual == expected { give back "" }
    -- A list converts only to its own canonical type (one element layout).
    if v4_codegen_llvm_is_list(v4_codegen_llvm_active_owned_mir, actual) or v4_codegen_llvm_is_list(v4_codegen_llvm_active_owned_mir, expected) {
        pilot ty_id = v4_mir_ty_id(v4_codegen_llvm_active_owned_mir)
        if v4_codegen_llvm_is_list(v4_codegen_llvm_active_owned_mir, actual) and v4_codegen_llvm_is_list(v4_codegen_llvm_active_owned_mir, expected) and v4_ty_canonical_type(ty_id, actual) == v4_ty_canonical_type(ty_id, expected) { give back "" }
        give back "unsupported native conversion: " + actual + " to " + expected
    }
    pilot actual_kind = v4_codegen_llvm_numeric_kind(actual)
    pilot expected_kind = v4_codegen_llvm_numeric_kind(expected)
    if actual_kind != "" and expected_kind != "" { give back "" }
    if v4_ty_is_lend_type(actual) and v4_ty_lend_target_type(actual) == expected and v4_codegen_llvm_active_owned_mir >= 0 and not v4_codegen_llvm_is_place_lend(v4_codegen_llvm_active_owned_mir, actual) { give back "" }
    -- Aggregates are planned before the compatibility shortcut so the leaf
    -- budget also covers conversions whose LLVM carriers already match.
    if v4_codegen_llvm_active_owned_mir >= 0 {
        pilot aggregate = v4_codegen_llvm_aggregate_kind(v4_codegen_llvm_active_owned_mir, actual)
        if aggregate == "tuple" or aggregate == "array" {
            if v4_codegen_llvm_aggregate_conversion_ok(v4_codegen_llvm_active_owned_mir, actual, expected) { give back "" }
            if v4_codegen_llvm_aggregate_conversion_leaves(v4_codegen_llvm_active_owned_mir, actual, expected, 0) == 0 - 2 { give back "native aggregate conversion exceeds the supported slot budget: " + actual + " to " + expected }
        }
    }
    if v4_ty_types_compatible(expected, actual) and v4_codegen_llvm_type(actual) == v4_codegen_llvm_type(expected) { give back "" }
    give back "unsupported native conversion: " + actual + " to " + expected
}

-- Tuple and fixed array values convert slot by slot when every slot pair is
-- equal, numeric (the checker already narrowed literals such as (1, 0.5)),
-- or itself a convertible aggregate. The answer is the number of leaf slots
-- the conversion emits, -1 when there is no plan, or -2 past the slot budget. Nested arrays multiply,
-- so the total is capped to keep one conversion from exploding the IR.
task v4_codegen_llvm_aggregate_conversion_leaves(mir_id: int, actual: word, expected: word, depth: int) -> int {
    if depth > 32 { give back 0 - 2 }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, actual)
    if (kind != "tuple" and kind != "array") or v4_codegen_llvm_aggregate_kind(mir_id, expected) != kind { give back -1 }
    pilot slots = v4_codegen_llvm_aggregate_slot_count(mir_id, actual)
    if slots < 0 or slots != v4_codegen_llvm_aggregate_slot_count(mir_id, expected) { give back -1 }
    pilot budget = 4096
    pilot total = 0
    pilot slot = 0
    repeat until slot >= slots {
        pilot from = v4_codegen_llvm_aggregate_slot_type(mir_id, actual, slot)
        pilot to = v4_codegen_llvm_aggregate_slot_type(mir_id, expected, slot)
        pilot leaves = 1
        -- Nested aggregates are counted even when their LLVM carriers match:
        -- [[int; 64]; 64] to [[uint; 64]; 64] still converts every leaf.
        pilot nested = v4_codegen_llvm_aggregate_kind(mir_id, from)
        pilot same: bool = from == to or (nested != "tuple" and nested != "array" and v4_codegen_llvm_type(from) == v4_codegen_llvm_type(to) and v4_ty_types_compatible(to, from))
        pilot numeric: bool = v4_codegen_llvm_numeric_kind(from) != "" and v4_codegen_llvm_numeric_kind(to) != ""
        if not same and not numeric { leaves = v4_codegen_llvm_aggregate_conversion_leaves(mir_id, from, to, depth + 1) }
        if leaves < 0 { give back leaves }
        if leaves < 1 { leaves = 1 }
        if kind == "array" {
            if slots > budget / leaves { give back 0 - 2 }
            give back slots * leaves
        }
        total = total + leaves
        if total > budget { give back 0 - 2 }
        slot += 1
    }
    give back total
}

task v4_codegen_llvm_aggregate_conversion_ok(mir_id: int, actual: word, expected: word) -> bool {
    give back v4_codegen_llvm_aggregate_conversion_leaves(mir_id, actual, expected, 0) >= 0
}

-- Decided from slot types, not LLVM types: (int, bool) to (uint, bool) is
-- the same struct but still needs the checked int-to-uint conversion.
task v4_codegen_llvm_aggregate_slots_need_conversion(mir_id: int, actual: word, expected: word, depth: int) -> bool {
    if depth > 32 or v4_codegen_llvm_type(actual) != v4_codegen_llvm_type(expected) { give back true }
    pilot slots = v4_codegen_llvm_aggregate_slot_count(mir_id, actual)
    pilot slot = 0
    repeat until slot >= slots {
        pilot from = v4_codegen_llvm_aggregate_slot_type(mir_id, actual, slot)
        pilot to = v4_codegen_llvm_aggregate_slot_type(mir_id, expected, slot)
        if v4_codegen_llvm_numeric_cast_opcode(from, to) != "" { give back true }
        pilot nested = v4_codegen_llvm_aggregate_kind(mir_id, from)
        if from != to and (nested == "tuple" or nested == "array") and v4_codegen_llvm_aggregate_slots_need_conversion(mir_id, from, to, depth + 1) { give back true }
        if v4_codegen_llvm_aggregate_kind(mir_id, actual) == "array" { slot = slots } else { slot += 1 }
    }
    give back false
}

task v4_codegen_llvm_aggregate_conversion_needed(mir_id: int, actual: word, expected: word) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or actual == expected { give back false }
    if not v4_codegen_llvm_aggregate_conversion_ok(mir_id, actual, expected) { give back false }
    give back v4_codegen_llvm_aggregate_slots_need_conversion(mir_id, actual, expected, 0)
}

task v4_codegen_llvm_aggregate_conversion_lines(mir_id: int, actual: word, expected: word, value: word, temp: word, depth: int) -> word {
    pilot slots = v4_codegen_llvm_aggregate_slot_count(mir_id, actual)
    -- An empty array has no slot to insert, so define the temp directly.
    if slots <= 0 { give back "  " + temp + " = freeze " + v4_codegen_llvm_type(expected) + " zeroinitializer\n" }
    pilot out = ""
    pilot previous = "undef"
    pilot slot = 0
    repeat until slot >= slots {
        pilot from = v4_codegen_llvm_aggregate_slot_type(mir_id, actual, slot)
        pilot to = v4_codegen_llvm_aggregate_slot_type(mir_id, expected, slot)
        pilot part = temp + ".x" + word_from_int(slot)
        out = out + "  " + part + " = extractvalue " + v4_codegen_llvm_type(actual) + " " + value + ", " + word_from_int(slot) + "\n"
        pilot converted = part
        pilot cast = temp + ".c" + word_from_int(slot)
        if v4_codegen_llvm_aggregate_conversion_needed(mir_id, from, to) {
            out = out + v4_codegen_llvm_aggregate_conversion_lines(mir_id, from, to, part, cast, depth + 1)
            converted = cast
        } else if v4_codegen_llvm_numeric_cast_opcode(from, to) != "" {
            out = out + v4_codegen_llvm_numeric_conversion_lines(from, to, part, cast)
            converted = cast
        }
        pilot name = temp + ".i" + word_from_int(slot)
        if slot == slots - 1 { name = temp }
        out = out + "  " + name + " = insertvalue " + v4_codegen_llvm_type(expected) + " " + previous + ", " + v4_codegen_llvm_type(to) + " " + converted + ", " + word_from_int(slot) + "\n"
        previous = name
        slot += 1
    }
    give back out
}

-- This gate applies to every native body, including a scalar helper in an
-- owned-word module. Iterative prior-row dynamic programming bounds recursive
-- emission/Meiya before either walks a forged deep chain or exponential DAG.
-- This bounds individual expressions while preserving large flat bodies and
-- the existing 3200-task scale case.
task v4_codegen_llvm_native_graph_error(mir_id: int) -> word {
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot depths = v4_codegen_llvm_fragment_new()
        pilot costs = v4_codegen_llvm_fragment_new()
        pilot value = 0
        pilot error = ""
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) or error != "" or v4_codegen_llvm_fragment_error != "" {
            pilot kind = v4_mir_rvalue_kind(mir_id, body, value)
            pilot lhs = v4_mir_rvalue_lhs(mir_id, body, value)
            pilot rhs = v4_mir_rvalue_rhs(mir_id, body, value)
            pilot args = v4_mir_rvalue_args_payload(mir_id, body, value)
            if not v4_mir_snapshot_rvalue_refs_are_valid(kind, word_from_int(lhs), word_from_int(rhs), args, value, v4_mir_body_place_count(mir_id, body)) { error = "invalid native expression graph" }
            pilot depth = 1
            pilot cost = 1
            if error == "" {
                if kind != v4_mir_rvalue_use_place and lhs >= 0 {
                    depth = word_to_int(array_get(depths, lhs)) + 1
                    cost += word_to_int(array_get(costs, lhs))
                }
                if rhs >= 0 {
                    pilot child_depth = word_to_int(array_get(depths, rhs)) + 1
                    if child_depth > depth { depth = child_depth }
                    cost += word_to_int(array_get(costs, rhs))
                }
                if kind == v4_mir_rvalue_use_place and lhs >= 0 {
                    -- Index and pointer operands of the place are children too,
                    -- so a[a[...]] chains count against the same budgets.
                    pilot operands = v4_mir_place_operand_payload(mir_id, body, lhs, value)
                    if operands == "?" {
                        error = "invalid native expression graph"
                        operands = ""
                    }
                    if args == "" { args = operands } else if operands != "" { args = args + "," + operands }
                }
                pilot arg = 0
                repeat until arg >= v4_mir_call_args_payload_count(args) {
                    pilot child = word_to_int(v4_mir_snapshot_comma_part(args, arg))
                    pilot child_depth = word_to_int(array_get(depths, child)) + 1
                    if child_depth > depth { depth = child_depth }
                    cost += word_to_int(array_get(costs, child))
                    if cost > 65536 { cost = 65537 }
                    arg += 1
                }
                if depth > 256 { error = "native expression nesting exceeds supported depth" }
                if cost > 65536 { error = "native expression traversal exceeds supported budget" }
                v4_codegen_llvm_fragment_push(depths, word_from_int(depth))
                v4_codegen_llvm_fragment_push(costs, word_from_int(cost))
            }
            value += 1
        }
        array_release(costs)
        array_release(depths)
        if v4_codegen_llvm_fragment_error != "" { give back v4_codegen_llvm_fragment_error }
        if error != "" { give back error }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back ""
}

task v4_codegen_llvm_native_symbol_value_error(mir_id: int, text: word, type_text: word) -> word {
    pilot symbol = v4_codegen_llvm_use_symbol_value(mir_id, text)
    if symbol.starts_with("@freak_v4_word_") { give back "native word runtime symbol conflict: " + symbol }
    pilot error = v4_codegen_llvm_numeric_reserved_symbol_error(symbol)
    if error != "" { give back error }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, text)
    if sig_id < 0 or not v4_codegen_llvm_signature_is_callable(ty_id, sig_id) { give back "native task pointer target is unresolved: " + text }
    -- The MIR builder retains this exact surface contract, including ABI,
    -- modes and lifetimes. Carrier equality alone would disguise ownership.
    pilot expected = v4_ty_task_callback_value_type(ty_id, sig_id)
    if expected == v4_ty_unknown { expected = v4_ty_signature_function_value_type(ty_id, sig_id) }
    if type_text != expected { give back "native task pointer target contract mismatch: " + text }
    give back ""
}

task v4_codegen_llvm_native_rvalue_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_symbol {
        -- A task value needs one symbol; a generic task has one per instance.
        pilot named = v4_ty_task_signature_id_for_name(v4_mir_ty_id(mir_id), v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        if named >= 0 and v4_ty_signature_type_generic_count(v4_mir_ty_id(mir_id), named) > 0 { give back "native generic task values are not yet supported: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and (kind == v4_mir_rvalue_closure or kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut or kind == v4_mir_rvalue_capture_copy or kind == v4_mir_rvalue_capture_move) { give back v4_codegen_llvm_native_closure_rvalue_error(mir_id, body_id, rvalue_id) }
    if (kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut) and v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_is_place_lend(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) { give back v4_codegen_llvm_native_aggregate_lend_error(mir_id, body_id, rvalue_id) }
    -- native_dyn_error already checked every dyn loan of this MIR.
    if (kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut) and v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_is_dyn_ref(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) { give back "" }
    if v4_codegen_llvm_active_owned_mir == mir_id and (kind == v4_mir_rvalue_list or (kind == v4_mir_rvalue_loop_item and v4_mir_rvalue_is_list_loop_item(mir_id, body_id, rvalue_id)) or (kind == v4_mir_rvalue_call and v4_mir_rvalue_is_builtin_list(mir_id, body_id, rvalue_id))) { give back v4_codegen_llvm_native_list_rvalue_error(mir_id, body_id, rvalue_id) }
    if kind == v4_mir_rvalue_call and (v4_mir_rvalue_op(mir_id, body_id, rvalue_id).starts_with("builtin::list::") or v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id).starts_with("builtin::list::")) { give back "invalid native list intrinsic identity" }
    if kind != v4_mir_rvalue_const_int and kind != v4_mir_rvalue_const_float and kind != v4_mir_rvalue_const_word and kind != v4_mir_rvalue_const_bool and kind != v4_mir_rvalue_const_char and kind != v4_mir_rvalue_use_local and kind != v4_mir_rvalue_use_symbol and kind != v4_mir_rvalue_binary and kind != v4_mir_rvalue_unary and kind != v4_mir_rvalue_call and not (v4_codegen_llvm_active_owned_mir == mir_id and (kind == v4_mir_rvalue_lend or v4_codegen_llvm_is_literal_aggregate(kind) or kind == v4_mir_rvalue_use_place or v4_codegen_llvm_scalar_sum_rvalue_is_supported(mir_id, body_id, rvalue_id) or (kind == v4_mir_rvalue_or_else and v4_codegen_llvm_or_else_is_supported(mir_id, body_id, rvalue_id)))) {
        -- A Sum operation over a carrier freak_ty does not admit names the payload.
        if v4_codegen_llvm_active_owned_mir == mir_id and (kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_or_else) {
            pilot sum_error = v4_codegen_llvm_unadmitted_sum_error(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
            if sum_error == "" and v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id) >= 0 { sum_error = v4_codegen_llvm_unadmitted_sum_error(mir_id, v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))) }
            if sum_error != "" { give back sum_error }
        }
        give back "native rvalue not yet supported: " + kind
    }
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    pilot args = v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id)
    if not v4_mir_snapshot_rvalue_refs_are_valid(kind, word_from_int(lhs), word_from_int(rhs), args, rvalue_id, v4_mir_body_place_count(mir_id, body_id)) {
        give back "invalid native rvalue references: " + kind
    }
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot error = ""
    if kind == v4_mir_rvalue_use_place {
        error = v4_codegen_llvm_native_place_error(mir_id, body_id, lhs, 0)
        if error != "" { give back error }
    }
    error = v4_codegen_llvm_native_type_error(type_text, kind == v4_mir_rvalue_call)
    if error != "" { give back error }
    pilot llvm_type = v4_codegen_llvm_type(type_text)
    if v4_codegen_llvm_is_literal_aggregate(kind) {
        error = v4_codegen_llvm_aggregate_literal_error(mir_id, body_id, rvalue_id)
        if error != "" { give back error }
    }
    if kind == v4_mir_rvalue_use_place {
        if v4_mir_place_kind(mir_id, body_id, lhs) != v4_mir_place_field and v4_mir_place_kind(mir_id, body_id, lhs) != v4_mir_place_index { give back "native place reads support only aggregate fields and elements" }
        if v4_mir_place_ty(mir_id, body_id, lhs) != type_text { give back "invalid native place operand" }
    }
    if kind == v4_mir_rvalue_const_int {
        if llvm_type != "i8" and llvm_type != "i32" and llvm_type != "i64" and llvm_type != "float" and llvm_type != "double" { give back "invalid native integer literal type: " + type_text }
        error = v4_codegen_llvm_integer_literal_error(type_text, v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        if error != "" { give back error }
    }
    if kind == v4_mir_rvalue_const_float {
        if llvm_type != "float" and llvm_type != "double" { give back "invalid native float literal type: " + type_text }
        error = v4_codegen_llvm_float_literal_error(type_text, v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        if error != "" { give back error }
    }
    if kind == v4_mir_rvalue_const_char {
        if llvm_type != "i8" and llvm_type != "i32" and llvm_type != "i64" { give back "invalid native char literal type: " + type_text }
        if v4_codegen_llvm_char_literal_codepoint(v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) == "" { give back "native character literal not yet supported: non-ASCII or unknown escape" }
    }
    if kind == v4_mir_rvalue_const_word and type_text != v4_ty_word { give back "invalid native word literal type: " + type_text }
    if kind == v4_mir_rvalue_const_bool {
        if type_text != v4_ty_bool or v4_mir_bool_literal_value(v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) == "" { give back "invalid native boolean literal" }
    }
    if kind == v4_mir_rvalue_use_local {
        pilot local_id = v4_codegen_llvm_rvalue_local(mir_id, body_id, rvalue_id)
        if local_id < 0 or local_id >= v4_mir_body_local_count(mir_id, body_id) or v4_mir_local_ty(mir_id, body_id, local_id) != type_text { give back "invalid native local operand" }
    }
    if kind == v4_mir_rvalue_use_symbol and v4_codegen_llvm_route_signature(mir_id, type_text) >= 0 and not v4_mir_symbol_is_global(mir_id, v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) {
        if v4_codegen_llvm_route_case_symbol(mir_id, body_id, rvalue_id) < 0 {
            if v4_ty_const_signature_id_for_name(v4_mir_ty_id(mir_id), v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) >= 0 { give back "native route constants are not yet supported: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
            give back "invalid native route case: " + v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
        }
        give back ""
    }
    if kind == v4_mir_rvalue_use_symbol and v4_mir_symbol_is_global(mir_id, v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) {
        if type_text == v4_ty_word and v4_codegen_llvm_active_owned_mir != mir_id { give back "native word globals need the owned word path" }
    } else if kind == v4_mir_rvalue_use_symbol {
        if not v4_ty_is_surface_task_function_type(type_text) { give back "native symbol values currently support only task pointers" }
        error = v4_codegen_llvm_native_symbol_value_error(mir_id, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), type_text)
        if error != "" { give back error }
    }
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_binary and not v4_codegen_llvm_native_binary_op_supported(op) { give back "unsupported native binary operator: " + op }
    if kind == v4_mir_rvalue_binary {
        pilot lhs_ty = v4_mir_rvalue_ty(mir_id, body_id, lhs)
        pilot rhs_ty = v4_mir_rvalue_ty(mir_id, body_id, rhs)
        if v4_codegen_llvm_route_signature(mir_id, lhs_ty) >= 0 or v4_codegen_llvm_route_signature(mir_id, rhs_ty) >= 0 { give back v4_codegen_llvm_route_binary_error(mir_id, body_id, rvalue_id) }
        if v4_mir_shape_signature(mir_id, lhs_ty) >= 0 or v4_mir_shape_signature(mir_id, rhs_ty) >= 0 { give back "native shape operators need doctrine lowering" }
        if v4_codegen_llvm_type_names_list(mir_id, lhs_ty) or v4_codegen_llvm_type_names_list(mir_id, rhs_ty) { give back "native list operators are not yet supported" }
        if v4_codegen_llvm_aggregate_kind(mir_id, lhs_ty) != "" or v4_codegen_llvm_aggregate_kind(mir_id, rhs_ty) != "" { give back "native tuple and array operators need doctrine lowering" }
        -- The bounded Sum checkpoint exposes tag checks and proven takes,
        -- not aggregate equality. LLVM icmp has no tagged-struct operand.
        if (op == v4_mir_bin_eq or op == v4_mir_bin_ne) and (v4_mir_scalar_sum_kind(mir_id, lhs_ty) != "" or v4_mir_scalar_sum_kind(mir_id, rhs_ty) != "") { give back "native scalar sum equality is not yet supported" }
        if (op == v4_mir_bin_lt or op == v4_mir_bin_le or op == v4_mir_bin_gt or op == v4_mir_bin_ge) and (v4_mir_scalar_sum_kind(mir_id, lhs_ty) != "" or v4_mir_scalar_sum_kind(mir_id, rhs_ty) != "") { give back "native scalar sum ordering is not yet supported" }
        pilot operand_ty = v4_codegen_llvm_binary_operand_type(mir_id, body_id, rvalue_id)
        error = v4_codegen_llvm_native_conversion_error(lhs_ty, operand_ty)
        if error == "" { error = v4_codegen_llvm_native_conversion_error(rhs_ty, operand_ty) }
        if error != "" { give back error }
        pilot arithmetic: bool = v4_codegen_llvm_checked_binary_suffix(op) != ""
        if arithmetic {
            if v4_codegen_llvm_numeric_kind(operand_ty) == "" { give back "native arithmetic requires numeric operands" }
            if v4_codegen_llvm_numeric_kind(type_text) != v4_codegen_llvm_numeric_kind(operand_ty) or llvm_type != v4_codegen_llvm_type(operand_ty) { give back "invalid native arithmetic result type" }
        } else {
            if type_text != v4_ty_bool { give back "invalid native comparison result type" }
            if (op == v4_mir_bin_and or op == v4_mir_bin_or) and (lhs_ty != v4_ty_bool or rhs_ty != v4_ty_bool) { give back "native logical operators require bool operands" }
        }
    }
    if kind == v4_mir_rvalue_unary {
        if op == v4_mir_unary_project or op == v4_mir_unary_project_index { give back v4_codegen_llvm_native_projection_error(mir_id, body_id, rvalue_id) }
        if op != v4_mir_unary_neg and op != v4_mir_unary_not and op != v4_mir_unary_ptr_is_null and op != v4_mir_unary_deref and op != v4_mir_unary_ptr_offset and op != v4_mir_unary_ptr_cast and op != v4_mir_unary_num_convert { give back "unsupported native unary operator: " + op }
        if op == v4_mir_unary_num_convert and (not v4_ty_is_float(v4_mir_rvalue_ty(mir_id, body_id, lhs)) or v4_codegen_llvm_numeric_kind(type_text) == "" or v4_codegen_llvm_numeric_kind(type_text) == "num") { give back "invalid native numeric conversion operand" }
        if op == v4_mir_unary_neg {
            pilot operand_ty = v4_mir_rvalue_ty(mir_id, body_id, lhs)
            if v4_codegen_llvm_numeric_kind(operand_ty) == "" or type_text != operand_ty { give back "invalid native numeric negation operand" }
        }
        if op == v4_mir_unary_not and (v4_mir_rvalue_ty(mir_id, body_id, lhs) != v4_ty_bool or type_text != v4_ty_bool) { give back "invalid native logical negation operand" }
        if op == v4_mir_unary_ptr_offset {
            if rhs < 0 { give back "invalid native pointer offset operand" }
            pilot offset_ty = v4_mir_rvalue_ty(mir_id, body_id, rhs)
            if offset_ty != v4_ty_int and offset_ty != v4_ty_uint { give back "native pointer offset must be int or uint" }
            error = v4_codegen_llvm_native_type_error(v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, lhs)), false)
            if error != "" { give back error }
        }
    }
    if v4_codegen_llvm_active_owned_mir == mir_id and kind == v4_mir_rvalue_lend {
        if type_text != v4_ty_word and (not v4_ty_is_lend_type(type_text) or v4_ty_lend_target_type(type_text) != v4_ty_word or v4_ty_lend_mode(type_text) != v4_ty_param_mode_lend) { give back "native borrowing currently supports only immutable words" }
        if lhs < 0 or v4_mir_rvalue_ty(mir_id, body_id, lhs) != v4_ty_word { give back "invalid native word borrow operand" }
    }
    if kind == v4_mir_rvalue_call {
        if v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_rvalue_is_builtin_control(mir_id, body_id, rvalue_id) { give back "" }
        if op.starts_with("builtin::control::") or v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id).starts_with("builtin::control::") { give back "invalid native control intrinsic identity" }
        if type_text == v4_ty_never and not v4_mir_rvalue_is_static_never(mir_id, body_id, rvalue_id) { give back "unsupported native never call contract" }
        if v4_codegen_llvm_active_owned_mir == mir_id and (v4_mir_rvalue_is_builtin_word(mir_id, body_id, rvalue_id) or v4_mir_rvalue_is_builtin_system(mir_id, body_id, rvalue_id)) { give back "" }
        if op.starts_with("builtin::word::") { give back "invalid native word intrinsic identity" }
        if op.starts_with("builtin::system::") { give back "invalid native system intrinsic identity" }
        if op == v4_mir_call_raw_ptr_write {
            if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) != 2 { give back "invalid native pointer write arguments" }
            pilot pointer = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
            error = v4_codegen_llvm_native_type_error(v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, pointer)), false)
            if error != "" { give back error }
            pilot value = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 1)
            error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, value), v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, pointer)))
            if error != "" { give back error }
        } else if op != v4_mir_call_say_literal {
            if v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id) < 0 and v4_ty_task_signature_id_for_name(v4_mir_ty_id(mir_id), op) < 0 and v4_codegen_llvm_find_mir_body(mir_id, v4_codegen_llvm_call_callee_name(mir_id, body_id, rvalue_id)) < 0 and not (v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_dyn_call_slot(mir_id, body_id, rvalue_id) >= 0) { give back "unsupported native call target: " + op }
            pilot arg = 0
            repeat until arg >= v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) {
                pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg)
                error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, child), v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, rvalue_id, arg))
                if error != "" { give back error }
                if v4_codegen_llvm_c_call_is_vararg(mir_id, body_id, rvalue_id, arg) and v4_codegen_llvm_c_vararg_type(mir_id, body_id, rvalue_id, arg) == "" { give back "native C vararg promotion is not available for " + v4_mir_rvalue_ty(mir_id, body_id, child) }
                arg += 1
            }
        }
    }
    give back ""
}

-- The struct slot a Field place selects: a shape field's declaration index
-- or a tuple position. -1 when the base is not a native shape or tuple.
task v4_codegen_llvm_place_slot(mir_id: int, body_id: int, place_id: int) -> int {
    if v4_mir_place_kind(mir_id, body_id, place_id) != v4_mir_place_field { give back 0 - 1 }
    pilot base = v4_mir_place_base(mir_id, body_id, place_id)
    if base < 0 or base >= place_id { give back 0 - 1 }
    pilot base_ty = v4_codegen_llvm_place_referent_ty(mir_id, body_id, base)
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, base_ty)
    if kind == "shape" { give back v4_mir_place_shape_field_slot(mir_id, body_id, place_id) }
    if kind != "tuple" { give back 0 - 1 }
    pilot name = v4_mir_place_field(mir_id, body_id, place_id)
    if name == "" or name.length() > 6 { give back 0 - 1 }
    pilot value = 0
    pilot idx = 0
    repeat until idx >= name.length() {
        pilot digit = v4_index_of_from("0123456789", name.char_at(idx), 0)
        if digit < 0 { give back 0 - 1 }
        value = value * 10 + digit
        idx += 1
    }
    if value >= v4_ty_tuple_slot_count(base_ty) { give back 0 - 1 }
    give back value
}

-- The constant value of an index operand, or -1 when it is not a plain
-- non-negative integer literal.
task v4_codegen_llvm_const_index(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_const_int { give back 0 - 1 }
    pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
    if text == "" or text.length() > 9 { give back 0 - 1 }
    pilot value = 0
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot digit = v4_index_of_from("0123456789", text.char_at(idx), 0)
        if digit < 0 { give back 0 - 1 }
        value = value * 10 + digit
        idx += 1
    }
    give back value
}

-- An Index place needs a runtime bounds check unless its index is a
-- literal already inside the fixed length.
task v4_codegen_llvm_index_needs_check(mir_id: int, body_id: int, place_id: int) -> bool {
    pilot length = v4_codegen_llvm_fixed_array_length(mir_id, v4_codegen_llvm_place_referent_ty(mir_id, body_id, v4_mir_place_base(mir_id, body_id, place_id)))
    pilot value = v4_codegen_llvm_const_index(mir_id, body_id, v4_mir_place_index(mir_id, body_id, place_id))
    give back value < 0 or value >= length
}

task v4_codegen_llvm_mir_has_index_checks(mir_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id { give back false }
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot place = 0
        repeat until place >= v4_mir_body_place_count(mir_id, body) {
            if v4_mir_place_kind(mir_id, body, place) == v4_mir_place_index and v4_codegen_llvm_index_needs_check(mir_id, body, place) { give back true }
            place += 1
        }
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_codegen_llvm_projection_needs_check(mir_id, body, value) { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back false
}

-- Field and index chains end at a local, a global or a dereferenced
-- pointer. Index places address fixed arrays and lists.
task v4_codegen_llvm_native_place_error(mir_id: int, body_id: int, place_id: int, depth: int) -> word {
    if depth > 64 { give back "native place nesting exceeds supported depth" }
    if place_id < 0 or place_id >= v4_mir_body_place_count(mir_id, body_id) { give back "invalid native place reference" }
    pilot kind = v4_mir_place_kind(mir_id, body_id, place_id)
    if kind == v4_mir_place_local or kind == v4_mir_place_global or kind == v4_mir_place_deref { give back "" }
    if kind == v4_mir_place_field or kind == v4_mir_place_index {
        if v4_codegen_llvm_active_owned_mir != mir_id { give back "native place not yet supported: " + kind }
        pilot base = v4_mir_place_base(mir_id, body_id, place_id)
        if base < 0 or base >= place_id { give back "invalid native place reference" }
        pilot base_error = v4_codegen_llvm_native_place_error(mir_id, body_id, base, depth + 1)
        if base_error != "" { give back base_error }
        pilot base_ty = v4_codegen_llvm_place_referent_ty(mir_id, body_id, base)
        if kind == v4_mir_place_field and v4_codegen_llvm_route_signature(mir_id, base_ty) >= 0 { give back v4_codegen_llvm_route_field_place_error(mir_id, body_id, place_id) }
        if kind == v4_mir_place_field {
            pilot slot = v4_codegen_llvm_place_slot(mir_id, body_id, place_id)
            if slot < 0 { give back "native field place needs a concrete shape or tuple base: " + v4_mir_place_text(mir_id, body_id, place_id) }
            -- Loads and stores use the place's recorded type, so it must be the
            -- declared slot type or the access width would not match the slot.
            pilot ty_id = v4_mir_ty_id(mir_id)
            pilot declared = v4_codegen_llvm_aggregate_slot_type(mir_id, base_ty, slot)
            if v4_ty_canonical_type(ty_id, declared) != v4_ty_canonical_type(ty_id, v4_mir_place_ty(mir_id, body_id, place_id)) { give back "native field place type differs from the declared field type: " + v4_mir_place_text(mir_id, body_id, place_id) }
            give back ""
        }
        pilot is_list: bool = v4_codegen_llvm_is_list(mir_id, base_ty)
        if v4_codegen_llvm_aggregate_kind(mir_id, base_ty) != "array" and not is_list { give back "native index places support only fixed arrays and lists: " + v4_mir_place_text(mir_id, body_id, place_id) }
        pilot index = v4_mir_place_index(mir_id, body_id, place_id)
        if index < 0 or index >= v4_mir_body_rvalue_count(mir_id, body_id) { give back "invalid native place reference" }
        pilot index_ty = v4_mir_rvalue_ty(mir_id, body_id, index)
        if index_ty != v4_ty_int and index_ty != v4_ty_uint { give back "native array index must be int or uint: " + v4_mir_place_text(mir_id, body_id, place_id) }
        if is_list {
            pilot ty_id = v4_mir_ty_id(mir_id)
            if v4_ty_canonical_type(ty_id, v4_mir_place_ty(mir_id, body_id, place_id)) != v4_ty_canonical_type(ty_id, v4_codegen_llvm_list_element(mir_id, base_ty)) { give back "invalid native index place type" }
            give back ""
        }
        if v4_mir_place_ty(mir_id, body_id, place_id) != v4_ty_fixed_array_element_type(base_ty) { give back "invalid native index place type" }
        give back ""
    }
    give back "native place not yet supported: " + kind
}

task v4_codegen_llvm_native_mir_error(mir_id: int) -> word {
    pilot dyn_error = v4_codegen_llvm_native_dyn_error(mir_id)
    if dyn_error != "" { give back dyn_error }
    pilot body_id = 0
    body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id)
    repeat until body_id >= v4_mir_body_count(mir_id) {
        pilot rvalue_id = 0
        repeat until rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
            pilot error = v4_codegen_llvm_native_rvalue_error(mir_id, body_id, rvalue_id)
            if error != "" { give back error }
            rvalue_id += 1
        }
        pilot place_id = 0
        repeat until place_id >= v4_mir_body_place_count(mir_id, body_id) {
            pilot kind = v4_mir_place_kind(mir_id, body_id, place_id)
            if kind == v4_mir_place_field or kind == v4_mir_place_index {
                pilot place_error = v4_codegen_llvm_native_place_error(mir_id, body_id, place_id, 0)
                if place_error != "" { give back place_error }
            } else if kind != v4_mir_place_local and kind != v4_mir_place_deref and kind != v4_mir_place_return and kind != v4_mir_place_global { give back "native place not yet supported: " + kind }
            if kind == v4_mir_place_global and v4_mir_place_ty(mir_id, body_id, place_id) == v4_ty_word and v4_codegen_llvm_active_owned_mir != mir_id { give back "native word globals need the owned word path" }
            if not v4_mir_snapshot_place_refs_are_valid(kind, word_from_int(v4_mir_place_base(mir_id, body_id, place_id)), word_from_int(v4_mir_place_index(mir_id, body_id, place_id)), place_id, v4_mir_body_local_count(mir_id, body_id), v4_mir_body_rvalue_count(mir_id, body_id)) { give back "invalid native place references: " + kind }
            pilot error = v4_codegen_llvm_native_type_error(v4_mir_place_ty(mir_id, body_id, place_id), kind == v4_mir_place_return)
            if error != "" { give back error }
            place_id += 1
        }
        pilot error = v4_codegen_llvm_native_type_error(v4_mir_body_callable_return_type(mir_id, body_id), true)
        if error != "" { give back error }
        pilot local_id = 0
        repeat until local_id >= v4_mir_body_local_count(mir_id, body_id) {
            error = v4_codegen_llvm_native_type_error(v4_mir_local_ty(mir_id, body_id, local_id), false)
            if error != "" { give back error }
            pilot local_mode = v4_mir_local_mode(mir_id, body_id, local_id)
            if local_mode != v4_ty_param_mode_value and not v4_codegen_llvm_local_is_lent_param(mir_id, body_id, local_id) and not v4_codegen_llvm_local_is_dyn_param(mir_id, body_id, local_id) and not (v4_codegen_llvm_active_owned_mir == mir_id and v4_mir_body_local_is_closure_capture(mir_id, body_id, local_id)) {
                if local_id >= v4_mir_body_callable_param_count(mir_id, body_id) { give back "native lend locals are not yet supported" }
                error = v4_codegen_llvm_lend_param_error(mir_id, local_mode, v4_mir_local_ty(mir_id, body_id, local_id), v4_mir_body_callable_abi(mir_id, body_id) != "")
                if error == "" and v4_mir_local_ty(mir_id, body_id, local_id) != v4_ty_word { error = "native lend parameter mode does not match its callable contract" }
                if error != "" { give back error }
            }
            local_id += 1
        }
        error = v4_codegen_llvm_native_closure_use_error(mir_id, body_id)
        if error != "" { give back error }
        pilot block_id = 0
        pilot block_count = v4_mir_body_block_count(mir_id, body_id)
        if block_count <= 0 { give back "invalid native body without blocks" }
        repeat until block_id >= block_count {
            if not v4_mir_snapshot_block_record_is_valid(v4_mir_body_block(mir_id, body_id, block_id), block_id, block_count) { give back "invalid native block terminator" }
            block_id += 1
        }
        pilot stmt_id = 0
        repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
            pilot kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
            if not v4_mir_snapshot_stmt_kind_is_known(kind) { give back "unsupported native statement: " + kind }
            pilot block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
            if block < 0 or block >= block_count { give back "invalid native statement block" }
            pilot value = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
            if value < 0 - 1 or value >= v4_mir_body_rvalue_count(mir_id, body_id) { give back "invalid native statement operand" }
            if kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign or kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop {
                if value < 0 { give back "missing native statement operand" }
            }
            if kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop {
                if v4_mir_rvalue_ty(mir_id, body_id, value) != v4_ty_bool { give back "native branch condition must be bool" }
            }
            if kind == v4_mir_stmt_return and value >= 0 {
                error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, value), v4_mir_body_callable_return_type(mir_id, body_id))
                if error != "" { give back error }
            }
            if kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign {
                pilot place = v4_mir_stmt_place(mir_id, body_id, stmt_id)
                if place < 0 or place >= v4_mir_body_place_count(mir_id, body_id) { give back "invalid native store destination" }
                error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, value), v4_mir_place_ty(mir_id, body_id, place))
                if error != "" { give back error }
            }
            stmt_id += 1
        }
        body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id + 1)
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = 0
    repeat until sig_id >= v4_ty_signature_count(ty_id) {
        if v4_codegen_llvm_signature_is_callable(ty_id, sig_id) {
            if v4_ty_signature_return_type(ty_id, sig_id) == v4_ty_never and v4_ty_signature_has_extern_callback(ty_id, sig_id) { give back "native never callback contracts are not yet supported" }
            pilot error = v4_codegen_llvm_native_type_error(v4_ty_signature_return_type(ty_id, sig_id), true)
            if error != "" { give back error }
            pilot param_id = 0
            repeat until param_id >= v4_ty_signature_fixed_param_count(ty_id, sig_id) {
                error = v4_codegen_llvm_native_type_error(v4_ty_signature_param_type(ty_id, sig_id, param_id), false)
                if error != "" { give back error }
                -- Extern declarations and @extern_callback tasks are C boundaries.
                pilot c_boundary: bool = v4_ty_signature_kind(ty_id, sig_id) != v4_ty_task_sig or v4_ty_signature_call_abi(ty_id, sig_id) != "" or v4_ty_signature_has_extern_callback(ty_id, sig_id)
                error = v4_codegen_llvm_lend_param_error(mir_id, v4_ty_signature_param_mode(ty_id, sig_id, param_id), v4_ty_signature_param_type(ty_id, sig_id, param_id), c_boundary)
                if error != "" { give back error }
                param_id += 1
            }
        }
        sig_id += 1
    }
    give back ""
}

task v4_codegen_llvm_lower_mir(file_id: int, mir_id: int) -> int {
    give back v4_codegen_llvm_lower_mir_mode(file_id, mir_id, false)
}

task v4_codegen_llvm_lower_owned_mir(file_id: int, mir_id: int) -> int {
    give back v4_codegen_llvm_lower_mir_mode(file_id, mir_id, true)
}

task v4_codegen_llvm_lower_owned_mir_with_panic(file_id: int, mir_id: int, policy: word) -> int {
    give back v4_codegen_llvm_lower_mir_policy(file_id, mir_id, true, policy)
}

-- The build tool has just run Meiya on this MIR. Reuse those facts instead of
-- a second identical check_mir; a result that is not the latest check, or
-- whose MIR shape changed since, gets a fresh check.
task v4_codegen_llvm_lower_owned_mir_with_borrow(file_id: int, mir_id: int, policy: word, borrow_id: int) -> int {
    v4_codegen_llvm_supplied_borrow = borrow_id
    pilot codegen_id = v4_codegen_llvm_lower_mir_policy(file_id, mir_id, true, policy)
    v4_codegen_llvm_supplied_borrow = 0 - 1
    give back codegen_id
}

task v4_codegen_llvm_panic_policy(codegen_id: int) -> word {
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "" }
    give back array_get(v4_codegen_llvm_panic_policies, codegen_id)
}

task v4_codegen_llvm_lower_mir_mode(file_id: int, mir_id: int, owned_words: bool) -> int {
    give back v4_codegen_llvm_lower_mir_policy(file_id, mir_id, owned_words, "unwind")
}

task v4_codegen_llvm_lower_mir_policy(file_id: int, mir_id: int, owned_words: bool, policy: word) -> int {
    v4_codegen_llvm_init()
    v4_codegen_llvm_numeric_runtime_used = false
    v4_codegen_llvm_list_drop_types = "\n"
    v4_codegen_llvm_list_clone_types = "\n"
    v4_codegen_llvm_list_used = false
    v4_codegen_llvm_fragment_error = ""
    pilot sealed_policy = policy
    if policy != "unwind" and policy != "abort" { sealed_policy = "" }
    pilot codegen_id = v4_codegen_llvm_file_new_with_panic(file_id, mir_id, sealed_policy)
    if codegen_id < 0 { give back codegen_id }
    if sealed_policy == "" {
        array_set(v4_codegen_llvm_native_errors, codegen_id, "invalid native panic policy: " + policy)
        give back codegen_id
    }
    v4_codegen_llvm_active_owned_mir = 0 - 1
    v4_codegen_llvm_active_word_borrow = 0 - 1
    -- MIR IDs can be reused on restore, so shape memos start fresh per request.
    v4_codegen_llvm_shape_ok_mir = 0 - 1
    v4_codegen_llvm_route_instances = "\n"
    if v4_mir_file_exists(mir_id) == false {
        v4_codegen_llvm_add_diag(codegen_id, "missing mir for llvm lowering")
        give back codegen_id
    }

    pilot graph_error = v4_codegen_llvm_native_graph_error(mir_id)
    if graph_error != "" {
        array_set(v4_codegen_llvm_native_errors, codegen_id, graph_error)
        give back codegen_id
    }
    pilot control_error = v4_mir_control_plan_preflight(mir_id)
    v4_codegen_llvm_active_panic_policy = sealed_policy
    if control_error != "" {
        array_set(v4_codegen_llvm_native_errors, codegen_id, control_error)
        give back codegen_id
    }
    if owned_words {
        -- Structural preflight precedes recursive ownership queries. Restored
        -- operands cannot smuggle cycles or invalid local IDs into Meiya.
        v4_codegen_llvm_active_owned_mir = mir_id
        pilot error = v4_mir_word_plan_preflight(mir_id)
        if error == "" { error = v4_codegen_llvm_native_mir_error(mir_id) }
        if error == "" { error = v4_codegen_llvm_owned_word_error(mir_id) }
        if error == "" { error = v4_codegen_llvm_native_c_width_error(mir_id, v4_mir_ty_id(mir_id)) }
        if error != "" {
            array_set(v4_codegen_llvm_native_errors, codegen_id, error)
            v4_codegen_llvm_active_owned_mir = 0 - 1
            give back codegen_id
        }
        pilot borrow_id = v4_codegen_llvm_supplied_borrow
        v4_codegen_llvm_supplied_borrow = 0 - 1
        if not v4_borrowck_result_is_current(borrow_id, mir_id) { borrow_id = v4_borrowck_check_mir(file_id, mir_id) }
        error = v4_codegen_llvm_word_borrow_plan_error(borrow_id, mir_id)
        -- Meiya publishes and seals the Runtime drop plan this module emits.
        if error == "" { error = v4_borrowck_publish_drop_plan(borrow_id, mir_id) }
        if error == "" { error = v4_codegen_llvm_drop_plan_error(mir_id) }
        if error != "" {
            v4_mir_drop_plan_release()
            array_set(v4_codegen_llvm_native_errors, codegen_id, error)
            v4_codegen_llvm_active_owned_mir = 0 - 1
            give back codegen_id
        }
        v4_codegen_llvm_active_word_borrow = borrow_id
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    v4_codegen_llvm_lower_signatures(codegen_id, mir_id, ty_id)
    v4_codegen_llvm_lower_calls(codegen_id, mir_id)
    -- Seal every module fact together. MIR IDs may be reused on restore;
    -- emitted bodies must never mix with globals from a different MIR epoch.
    pilot native_error = ""
    if not owned_words { native_error = v4_codegen_llvm_native_word_error(mir_id) }
    if native_error == "" { native_error = v4_codegen_llvm_native_mir_error(mir_id) }
    if owned_words and native_error == "" { native_error = v4_codegen_llvm_owned_word_error(mir_id) }
    if native_error == "" { native_error = v4_codegen_llvm_native_entry_error(mir_id) }
    if native_error == "" { native_error = v4_codegen_llvm_native_declaration_symbol_error(codegen_id) }
    -- A script initializer generates @main too, so it gets the same check.
    if native_error == "" and (v4_codegen_llvm_find_mir_body(mir_id, "main") >= 0 or v4_mir_module_init_body(mir_id) >= 0) { native_error = v4_codegen_llvm_native_entry_symbol_error(codegen_id) }
    array_set(v4_codegen_llvm_native_errors, codegen_id, native_error)
    if native_error == "" {
        v4_codegen_llvm_lower_bodies(codegen_id, mir_id)
        v4_codegen_llvm_lower_callback_trampolines(codegen_id, mir_id, ty_id)
        -- The drop plan lives exactly as long as the bodies that emit it.
        v4_mir_drop_plan_release()
        -- Ordinary impls and qualified tasks can share linkage names even
        -- without callbacks. Check every actual sealed definition together.
        native_error = v4_codegen_llvm_native_body_symbol_error(codegen_id)
        if native_error == "" { native_error = v4_codegen_llvm_native_duplicate_body_error(codegen_id) }
        if native_error == "" { native_error = v4_codegen_llvm_native_literal_symbol_error(codegen_id, mir_id) }
        if native_error == "" { native_error = v4_codegen_llvm_native_global_symbol_error(codegen_id, mir_id) }
        if native_error == "" { native_error = v4_codegen_llvm_native_c_width_error(mir_id, ty_id) }
        pilot runtime = ""
        v4_codegen_llvm_list_used = owned_words and v4_codegen_llvm_mir_uses_lists(mir_id)
        if native_error == "" and v4_codegen_llvm_list_used { native_error = v4_codegen_llvm_list_symbol_error(codegen_id) }
        pilot index_checks: bool = owned_words and (v4_codegen_llvm_mir_has_index_checks(mir_id) or v4_codegen_llvm_list_used)
        if owned_words and (v4_codegen_llvm_mir_has_owned_words(mir_id) or index_checks) {
            runtime = v4_codegen_llvm_word_runtime_declarations()
        }
        -- Private word helpers are reserved even for scalar-only modules: a
        -- scalar facade must not mint an untracked owned handle through FFI.
        if native_error == "" { native_error = v4_codegen_llvm_word_runtime_symbol_error(codegen_id) }
        if owned_words { runtime = runtime + v4_codegen_llvm_scalar_sum_runtime_lines(mir_id) }
        runtime = runtime + v4_codegen_llvm_bootstrap_runtime_declarations(mir_id)
        if v4_codegen_llvm_mir_has_panic(mir_id) or index_checks { runtime = runtime + "declare void " + v4_codegen_llvm_panic_symbol() + "(i64) noreturn\n" }
        if v4_codegen_llvm_numeric_runtime_used { runtime = runtime + v4_codegen_llvm_numeric_runtime_declarations() }
        -- Global definitions are sealed with the bodies that read them.
        pilot global_lines = v4_codegen_llvm_global_definition_lines(mir_id)
        -- Dyn vtable constants and their drop entries, one per sealed vtable.
        -- They come before the list helpers: a vtable drop entry may be the
        -- only drop of a list-holding type.
        pilot dyn_lines = ""
        if owned_words { dyn_lines = v4_codegen_llvm_dyn_module_lines(mir_id, runtime + global_lines) }
        if v4_codegen_llvm_list_used { runtime = runtime + v4_codegen_llvm_list_runtime_lines(mir_id) }
        if native_error == "" { native_error = v4_codegen_llvm_numeric_runtime_symbol_error(codegen_id) }
        runtime = runtime + global_lines + dyn_lines
        array_set(v4_codegen_llvm_word_runtime_lines, codegen_id, runtime)
        if owned_words { array_set(v4_codegen_llvm_shape_lines, codegen_id, v4_codegen_llvm_shape_records(mir_id)) }
        pilot globals = v4_codegen_llvm_word_globals(mir_id)
        if index_checks { globals = globals + v4_codegen_llvm_bounds_globals() }
        if v4_codegen_llvm_list_used { globals = globals + v4_codegen_llvm_list_globals() }
        pilot entry = v4_codegen_llvm_native_entry(mir_id)
        if native_error == "" and entry != "" { native_error = v4_codegen_llvm_runtime_symbol_error(codegen_id, "@freak_llvm_setup_args", "i64, i64") }
        if native_error == "" and globals != "" { native_error = v4_codegen_llvm_runtime_symbol_error(codegen_id, "@freak_llvm_say", "i64") }
        array_set(v4_codegen_llvm_word_global_lines, codegen_id, globals)
        array_set(v4_codegen_llvm_native_entry_lines, codegen_id, entry)
        if native_error == "" and v4_codegen_llvm_fragment_error != "" { native_error = v4_codegen_llvm_fragment_error }
        array_set(v4_codegen_llvm_native_errors, codegen_id, native_error)
    }
    v4_codegen_llvm_active_owned_mir = 0 - 1
    v4_codegen_llvm_active_word_borrow = 0 - 1
    give back codegen_id
}

-- Owned word values have one runtime allocation owner. Lend wrappers retain
-- an i64 handle while ownership stays with the underlying local or temporary.
-- The two admitted Sum carriers share a physical shape, but keep distinct
-- named LLVM types and exact MIR contracts. Their payload field is never a
-- tag: Some(0) and Ok("") remain present values.
task v4_codegen_llvm_scalar_sum_rvalue_is_supported(mir_id: int, body_id: int, value: int) -> bool {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, value)
    pilot carrier = v4_mir_scalar_sum_kind(mir_id, v4_mir_rvalue_ty(mir_id, body_id, value))
    if carrier != "" { give back kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err }
    if kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try {
        give back v4_mir_scalar_sum_kind(mir_id, v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, value))) != ""
    }
    give back false
}

-- General Sum carriers (tier 3). maybe<T> lowers to a named struct
-- { i1, T } and result<T, E> to { i1, T, E }; when T and E are the same
-- type they share one payload field, as the closed result<word,word> slice
-- does, and the tag tells them apart. An inactive payload field is zero.
-- freak_target answers every layout through the shape records.
task v4_codegen_llvm_sum_type_name(mir_id: int, type_text: word) -> word {
    pilot symbol = v4_codegen_llvm_symbol("freak.sum." + v4_codegen_llvm_compact_type(v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text)))
    give back "%" + v4_slice(symbol, 1, symbol.length())
}

task v4_codegen_llvm_compact_type(text: word) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot idx = 0
    repeat until idx >= text.length() {
        pilot ch = text.char_at(idx)
        if ch != " " { v4_codegen_llvm_fragment_push(parts, ch) }
        idx += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- The struct field an op reads or writes: 1 for Some/Ok, and for Err 1 when
-- the error payload has exactly the ok payload's type, else 2. Sharing only
-- on equal types keeps a word field from ever holding a non-word value.
task v4_codegen_llvm_sum_field(mir_id: int, type_text: word, op: word) -> word {
    if op != "Err" and op != "TakeErr" { give back "1" }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_native_sum_case_type(ty_id, type_text, "Err") == v4_ty_native_sum_case_type(ty_id, type_text, "Ok") { give back "1" }
    give back "2"
}

-- The one field of a general carrier that can own a word ("" when none):
-- word payloads of a result share field 1 when both cases are words.
task v4_codegen_llvm_sum_word_field(mir_id: int, type_text: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_native_sum_family(v4_mir_scalar_sum_kind(mir_id, type_text)) == "maybe" {
        if v4_ty_native_sum_case_type(ty_id, type_text, "Some") == v4_ty_word { give back "1" }
        give back ""
    }
    if v4_ty_native_sum_case_type(ty_id, type_text, "Ok") == v4_ty_word { give back "1" }
    if v4_ty_native_sum_case_type(ty_id, type_text, "Err") == v4_ty_word { give back v4_codegen_llvm_sum_field(mir_id, type_text, "Err") }
    give back ""
}

-- Every payload LLVM type of a carrier, in field order, tab separated.
task v4_codegen_llvm_sum_payload_fields(mir_id: int, type_text: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_native_sum_family(v4_mir_scalar_sum_kind(mir_id, type_text)) == "maybe" { give back v4_codegen_llvm_type(v4_ty_native_sum_case_type(ty_id, type_text, "Some")) }
    pilot ok_field = v4_codegen_llvm_type(v4_ty_native_sum_case_type(ty_id, type_text, "Ok"))
    if v4_codegen_llvm_sum_field(mir_id, type_text, "Err") == "1" { give back ok_field }
    give back ok_field + "\t" + v4_codegen_llvm_type(v4_ty_native_sum_case_type(ty_id, type_text, "Err"))
}

-- A builtin maybe/result spelling whose payloads freak_ty does not admit as
-- a native carrier: name the payload instead of the constructor. "" for any
-- other type, including an admitted carrier.
task v4_codegen_llvm_unadmitted_sum_error(mir_id: int, type_text: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    if canonical == "" or not v4_ty_is_generic_instance_type(canonical) or v4_mir_scalar_sum_kind(mir_id, canonical) != "" { give back "" }
    pilot base = v4_ty_generic_base_name(canonical)
    if (base != "maybe" and base != "result") or v4_ty_type_signature_id_for_name(ty_id, base) >= 0 { give back "" }
    pilot arg = 0
    repeat until arg >= v4_ty_generic_arg_count(canonical) {
        pilot payload = v4_ty_canonical_type(ty_id, v4_ty_generic_arg(canonical, arg))
        if not v4_ty_native_sum_payload_admitted(ty_id, payload) {
            if v4_ty_is_generic_instance_type(payload) {
                pilot payload_base = v4_ty_generic_base_name(payload)
                if payload_base == "maybe" or payload_base == "result" { give back "native nested maybe/result payloads are not yet supported: " + canonical }
            }
            pilot shape_error = v4_codegen_llvm_native_shape_error(mir_id, payload, 0)
            if shape_error != "-" and shape_error != "" { give back shape_error }
            -- Aggregates drop word leaves by flag, but a carrier payload has
            -- no leaf drop yet, so it stays fenced rather than leaking.
            if v4_ty_native_sum_payload_holds_word(ty_id, payload, 0) { give back "native maybe/result aggregate payloads that own words are not yet supported: " + payload }
            give back "native maybe/result payload is not yet supported: " + payload
        }
        arg += 1
    }
    give back ""
}

-- "" when every payload lowers natively; otherwise the payload's own error.
task v4_codegen_llvm_native_sum_error(mir_id: int, type_text: word, depth: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot family = v4_ty_native_sum_family(v4_mir_scalar_sum_kind(mir_id, type_text))
    pilot first = "Some"
    if family == "result" { first = "Ok" }
    pilot error = v4_codegen_llvm_native_sum_payload_error(mir_id, v4_ty_native_sum_case_type(ty_id, type_text, first), type_text, depth)
    if error != "" or family != "result" { give back error }
    give back v4_codegen_llvm_native_sum_payload_error(mir_id, v4_ty_native_sum_case_type(ty_id, type_text, "Err"), type_text, depth)
}

-- A word payload is owned by its carrier; any other payload follows the
-- aggregate slot rules (so slots that own words are still named).
task v4_codegen_llvm_native_sum_payload_error(mir_id: int, payload: word, type_text: word, depth: int) -> word {
    if payload == v4_ty_word { give back "" }
    give back v4_codegen_llvm_native_slot_error(mir_id, payload, type_text, depth)
}

-- One shape record per general carrier a body uses, for the type
-- definitions and "; freak.layout" notes (the closed kinds keep their own).
task v4_codegen_llvm_sum_records(mir_id: int) -> word {
    pilot seen = ""
    pilot out = ""
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot candidates = v4_codegen_llvm_fragment_new()
        v4_codegen_llvm_fragment_push(candidates, v4_mir_body_callable_return_type(mir_id, body))
        pilot row = 0
        repeat until row >= v4_mir_body_local_count(mir_id, body) {
            v4_codegen_llvm_fragment_push(candidates, v4_mir_local_ty(mir_id, body, row))
            row += 1
        }
        row = 0
        repeat until row >= v4_mir_body_rvalue_count(mir_id, body) {
            v4_codegen_llvm_fragment_push(candidates, v4_mir_rvalue_ty(mir_id, body, row))
            row += 1
        }
        row = 0
        repeat until row >= array_len(candidates) {
            pilot type_text: word = array_get(candidates, row)
            pilot kind = v4_mir_scalar_sum_kind(mir_id, type_text)
            if kind == "Maybe" or kind == "Result" {
                pilot name = v4_codegen_llvm_sum_type_name(mir_id, type_text)
                if not seen.contains("\n" + name + "\n") {
                    seen = seen + "\n" + name + "\n"
                    out = out + name + "\ti1\t" + v4_codegen_llvm_sum_payload_fields(mir_id, type_text) + "\n"
                }
            }
            row += 1
        }
        array_release(candidates)
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back out
}

task v4_codegen_llvm_scalar_sum_instruction(mir_id: int, body_id: int, value: int, target: word) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, value)
    pilot child = v4_mir_rvalue_lhs(mir_id, body_id, value)
    if kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try {
        pilot field = "0"
        if kind != v4_mir_rvalue_check { field = v4_codegen_llvm_sum_field(mir_id, v4_mir_rvalue_ty(mir_id, body_id, child), v4_mir_rvalue_op(mir_id, body_id, value)) }
        give back target + " = extractvalue " + v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, child)) + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, child) + ", " + field
    }
    pilot sum_ty = v4_mir_rvalue_ty(mir_id, body_id, value)
    pilot carrier = v4_codegen_llvm_type(sum_ty)
    if kind == v4_mir_rvalue_nobody { give back target + " = insertvalue " + carrier + " zeroinitializer, i1 false, 0" }
    pilot tag = "false"
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok { tag = "true" }
    pilot op = "Some"
    if kind == v4_mir_rvalue_ok { op = "Ok" }
    if kind == v4_mir_rvalue_err { op = "Err" }
    pilot payload = v4_codegen_llvm_type(v4_ty_native_sum_case_type(v4_mir_ty_id(mir_id), sum_ty, op))
    give back target + ".tag = insertvalue " + carrier + " zeroinitializer, i1 " + tag + ", 0\n  " + target + " = insertvalue " + carrier + " " + target + ".tag, " + payload + " " + v4_codegen_llvm_rvalue_value(mir_id, body_id, child) + ", " + v4_codegen_llvm_sum_field(mir_id, sum_ty, op)
}

-- `source or else fallback` on a native carrier. The fallback is evaluated
-- only on the empty edge; there an error payload the carrier still owns is
-- released. The source itself is moved in, per Meiya's transfer fact.
task v4_codegen_llvm_or_else_is_supported(mir_id: int, body_id: int, value: int) -> bool {
    if v4_mir_rvalue_kind(mir_id, body_id, value) != v4_mir_rvalue_or_else { give back false }
    pilot source = v4_mir_rvalue_lhs(mir_id, body_id, value)
    give back source >= 0 and v4_mir_rvalue_rhs(mir_id, body_id, value) >= 0 and v4_mir_scalar_sum_kind(mir_id, v4_mir_rvalue_ty(mir_id, body_id, source)) != ""
}

task v4_codegen_llvm_collect_or_else_lines(parts: int, mir_id: int, body_id: int, value: int, target: word) -> void {
    pilot source = v4_mir_rvalue_lhs(mir_id, body_id, value)
    pilot fallback = v4_mir_rvalue_rhs(mir_id, body_id, value)
    pilot sum_ty = v4_mir_rvalue_ty(mir_id, body_id, source)
    pilot carrier = v4_codegen_llvm_type(sum_ty)
    pilot family = v4_ty_native_sum_family(v4_mir_scalar_sum_kind(mir_id, sum_ty))
    pilot present = "Some"
    if family == "result" { present = "Ok" }
    pilot payload_ty = v4_ty_native_sum_case_type(v4_mir_ty_id(mir_id), sum_ty, present)
    pilot payload = v4_codegen_llvm_type(payload_ty)
    pilot label = "orelse." + word_from_int(body_id) + "." + word_from_int(value)
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, source, v4_codegen_llvm_temp_value(body_id, source), false)
    pilot held = v4_codegen_llvm_rvalue_value(mir_id, body_id, source)
    v4_codegen_llvm_fragment_push(parts, "  %" + label + ".tag = extractvalue " + carrier + " " + held + ", 0\n  br i1 %" + label + ".tag, label %" + label + ".some, label %" + label + ".none\n" + label + ".none:\n")
    if family == "result" and v4_ty_native_sum_case_type(v4_mir_ty_id(mir_id), sum_ty, "Err") == v4_ty_word {
        v4_codegen_llvm_fragment_push(parts, "  %" + label + ".err = extractvalue " + carrier + " " + held + ", " + v4_codegen_llvm_sum_field(mir_id, sum_ty, "Err") + "\n  call void @freak_v4_word_drop(i64 %" + label + ".err)\n")
    }
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, fallback, v4_codegen_llvm_temp_value(body_id, fallback), false)
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, fallback, payload_ty, "%" + label + ".fallback"))
    v4_codegen_llvm_fragment_push(parts, "  br label %" + label + ".none.end\n" + label + ".none.end:\n  br label %" + label + ".join\n" + label + ".some:\n")
    v4_codegen_llvm_fragment_push(parts, "  %" + label + ".payload = extractvalue " + carrier + " " + held + ", 1\n  br label %" + label + ".join\n" + label + ".join:\n")
    v4_codegen_llvm_fragment_push(parts, "  " + target + " = phi " + payload + " [ %" + label + ".payload, %" + label + ".some ], [ " + v4_codegen_llvm_expected_value(mir_id, body_id, fallback, payload_ty, "%" + label + ".fallback") + ", %" + label + ".none.end ]\n")
}

task v4_codegen_llvm_scalar_sum_bridge_kind(mir_id: int, body_id: int, value: int) -> word {
    pilot kind = v4_mir_system_intrinsic_kind(mir_id, body_id, value)
    if kind != "" { give back kind }
    if v4_mir_word_intrinsic_kind(mir_id, body_id, value) == "to_int_maybe" { give back "to_int_maybe" }
    give back ""
}

task v4_codegen_llvm_scalar_sum_bridge_symbol(kind: word) -> word {
    if kind == "to_int_maybe" { give back "@freak_v4_word_parse_int_checked" }
    if kind == "process_arg" { give back "@freak_v4_process_arg_checked" }
    if kind == "args_count" { give back "@freak_v4_process_args_count" }
    if kind == "fs_read" { give back "@freak_v4_fs_read" }
    give back ""
}

task v4_codegen_llvm_scalar_sum_out_slot(body: int, value: int, field: word) -> word {
    give back "%sum.out." + word_from_int(body) + "." + word_from_int(value) + "." + field
}

-- Allocate two distinct slots per call site in the function entry. Repeated
-- execution of a call in a loop reuses its slots, rather than growing stack.
-- Zeroing happens at each invocation before the reviewed void/outslot bridge.
task v4_codegen_llvm_scalar_sum_bridge_slots(mir: int, body: int) -> word {
    pilot out = ""
    pilot value = 0
    repeat until value >= v4_mir_body_rvalue_count(mir, body) {
        pilot kind = v4_codegen_llvm_scalar_sum_bridge_kind(mir, body, value)
        if kind != "" and kind != "args_count" {
            out = out + "  " + v4_codegen_llvm_scalar_sum_out_slot(body, value, "tag") + " = alloca i64\n"
            out = out + "  " + v4_codegen_llvm_scalar_sum_out_slot(body, value, "payload") + " = alloca i64\n"
        }
        value += 1
    }
    give back out
}

task v4_codegen_llvm_scalar_sum_bridge_instruction(mir: int, body: int, value: int, target: word) -> word {
    pilot kind = v4_codegen_llvm_scalar_sum_bridge_kind(mir, body, value)
    pilot symbol = v4_codegen_llvm_scalar_sum_bridge_symbol(kind)
    if kind == "args_count" { give back target + " = call i64 " + symbol + "()" }
    pilot tag_slot = v4_codegen_llvm_scalar_sum_out_slot(body, value, "tag")
    pilot payload_slot = v4_codegen_llvm_scalar_sum_out_slot(body, value, "payload")
    pilot child = v4_mir_rvalue_call_arg(mir, body, value, 0)
    pilot carrier = v4_codegen_llvm_type(v4_mir_rvalue_ty(mir, body, value))
    pilot out = "store i64 0, ptr " + tag_slot + "\n  store i64 0, ptr " + payload_slot + "\n"
    out = out + "  call void " + symbol + "(i64 " + v4_codegen_llvm_rvalue_value(mir, body, child) + ", ptr " + tag_slot + ", ptr " + payload_slot + ")\n"
    out = out + "  " + target + ".raw.tag = load i64, ptr " + tag_slot + "\n  " + target + ".payload = load i64, ptr " + payload_slot + "\n"
    out = out + "  " + target + ".tag = icmp ne i64 " + target + ".raw.tag, 0\n"
    out = out + "  " + target + ".tagged = insertvalue " + carrier + " zeroinitializer, i1 " + target + ".tag, 0\n"
    give back out + "  " + target + " = insertvalue " + carrier + " " + target + ".tagged, i64 " + target + ".payload, 1"
}

task v4_codegen_llvm_owned_temporary_drop(mir: int, body: int, value: int, site: word) -> word {
    pilot value_ty = v4_mir_rvalue_ty(mir, body, value)
    if v4_codegen_llvm_is_list(mir, value_ty) { give back v4_codegen_llvm_list_drop_lines(mir, value_ty, "", v4_codegen_llvm_rvalue_value(mir, body, value), "", "%list.discard." + site) }
    if v4_ty_canonical_type(v4_mir_ty_id(mir), value_ty) != v4_ty_word and v4_codegen_llvm_type_owns_words(mir, value_ty) {
        -- A route's payload is read in memory: the call's result slot.
        if v4_codegen_llvm_type_has_route_words(mir, value_ty, 0) { give back v4_codegen_llvm_drop_glue_at(mir, value_ty, v4_codegen_llvm_abi_ret_slot(body, value), "", "%agg.discard." + site, 0) }
        give back v4_codegen_llvm_aggregate_word_drop_lines(mir, value_ty, v4_codegen_llvm_rvalue_value(mir, body, value), "%agg.discard." + site)
    }
    pilot carrier = v4_mir_scalar_sum_kind(mir, v4_mir_rvalue_ty(mir, body, value))
    if carrier == "MaybeInt" { give back "" }
    if carrier == "ResultWordWord" {
        pilot temp = "%sum.discard." + site
        give back "  " + temp + " = extractvalue %freak_result_word_word " + v4_codegen_llvm_rvalue_value(mir, body, value) + ", 1\n  call void @freak_v4_word_drop(i64 " + temp + ")\n"
    }
    if carrier != "" {
        pilot sum_ty = v4_mir_rvalue_ty(mir, body, value)
        pilot field = v4_codegen_llvm_sum_word_field(mir, sum_ty)
        if field == "" { give back "" }
        pilot temp = "%sum.discard." + site
        give back "  " + temp + " = extractvalue " + v4_codegen_llvm_type(sum_ty) + " " + v4_codegen_llvm_rvalue_value(mir, body, value) + ", " + field + "\n  call void @freak_v4_word_drop(i64 " + temp + ")\n"
    }
    give back "  call void @freak_v4_word_drop(i64 " + v4_codegen_llvm_rvalue_value(mir, body, value) + ")\n"
}

task v4_codegen_llvm_mir_uses_typed_process(mir: int) -> bool {
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir, body)
    repeat until body >= v4_mir_body_count(mir) {
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir, body) {
            pilot kind = v4_mir_system_intrinsic_kind(mir, body, value)
            if kind == "process_arg" or kind == "args_count" { give back true }
            -- process::arg in bootstrap mode reads the same argv snapshot.
            if v4_mir_word_intrinsic_kind(mir, body, value) == "process_arg_word" { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir, body + 1)
    }
    give back false
}

task v4_codegen_llvm_scalar_sum_runtime_lines(mir: int) -> word {
    pilot maybe_used = false
    pilot result_used = false
    pilot parser_used = false
    pilot arg_used = false
    pilot count_used = false
    pilot arg_word_used = false
    pilot fs_used = false
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir, body)
    repeat until body >= v4_mir_body_count(mir) {
        pilot carrier = v4_mir_scalar_sum_kind(mir, v4_mir_body_callable_return_type(mir, body))
        if carrier == "MaybeInt" { maybe_used = true }
        if carrier == "ResultWordWord" { result_used = true }
        pilot local = 0
        repeat until local >= v4_mir_body_local_count(mir, body) {
            carrier = v4_mir_scalar_sum_kind(mir, v4_mir_local_ty(mir, body, local))
            if carrier == "MaybeInt" { maybe_used = true }
            if carrier == "ResultWordWord" { result_used = true }
            local += 1
        }
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir, body) {
            carrier = v4_mir_scalar_sum_kind(mir, v4_mir_rvalue_ty(mir, body, value))
            if carrier == "MaybeInt" { maybe_used = true }
            if carrier == "ResultWordWord" { result_used = true }
            pilot kind = v4_codegen_llvm_scalar_sum_bridge_kind(mir, body, value)
            if kind == "to_int_maybe" { parser_used = true }
            if kind == "process_arg" { arg_used = true }
            if kind == "args_count" { count_used = true }
            if kind == "fs_read" { fs_used = true }
            if v4_mir_word_intrinsic_kind(mir, body, value) == "process_arg_word" { arg_word_used = true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir, body + 1)
    }
    pilot out = ""
    if maybe_used { out = out + "%freak_maybe_int = type {" + " i1, i64 " + "}\n" }
    if result_used { out = out + "%freak_result_word_word = type {" + " i1, i64 " + "}\n" }
    if parser_used { out = out + "declare void @freak_v4_word_parse_int_checked(i64, ptr, ptr)\n" }
    if arg_used { out = out + "declare void @freak_v4_process_arg_checked(i64, ptr, ptr)\n" }
    if count_used { out = out + "declare i64 @freak_v4_process_args_count()\n" }
    if arg_used or count_used or arg_word_used { out = out + "declare void @freak_v4_process_setup_args(i64, i64)\n" }
    if fs_used { out = out + "declare void @freak_v4_fs_read(i64, ptr, ptr)\n" }
    give back out
}

-- Owned storage: words, the two Sum carriers, and native aggregates that
-- hold words (one drop flag per local; the aggregate moves as one value).
task v4_codegen_llvm_word_local_is_owned(mir_id: int, body_id: int, local_id: int) -> bool {
    if local_id < 0 or local_id >= v4_mir_body_local_count(mir_id, body_id) or v4_mir_local_mode(mir_id, body_id, local_id) != v4_ty_param_mode_value { give back false }
    pilot local_ty = v4_mir_local_ty(mir_id, body_id, local_id)
    give back v4_ty_is_native_owned_value(v4_mir_ty_id(mir_id), local_ty) or (v4_codegen_llvm_active_owned_mir == mir_id and v4_codegen_llvm_type_owns_words(mir_id, local_ty))
}

task v4_codegen_llvm_word_rvalue_is_owned(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    pilot value_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_active_owned_mir == mir_id and v4_ty_canonical_type(v4_mir_ty_id(mir_id), value_ty) != v4_ty_word and v4_codegen_llvm_type_owns_words(mir_id, value_ty) {
        pilot aggregate_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
        if aggregate_kind == v4_mir_rvalue_use_local { give back v4_codegen_llvm_word_local_is_owned(mir_id, body_id, v4_mir_rvalue_local_id(mir_id, body_id, rvalue_id)) }
        give back aggregate_kind == v4_mir_rvalue_call or v4_codegen_llvm_is_literal_aggregate(aggregate_kind) or aggregate_kind == v4_mir_rvalue_list
    }
    if not v4_ty_is_native_owned_value(v4_mir_ty_id(mir_id), value_ty) { give back false }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_local { give back v4_codegen_llvm_word_local_is_owned(mir_id, body_id, v4_mir_rvalue_local_id(mir_id, body_id, rvalue_id)) }
    if v4_codegen_llvm_rvalue_is_global_read(mir_id, body_id, rvalue_id) { give back true }
    give back kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_call or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_or_else or kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err
}

-- A word a loan observes that no local owns: the full expression releases
-- it after the observer. Sum extractions and `or else` yield fresh owners.
task v4_codegen_llvm_lend_word_temporary_is_fresh(mir_id: int, body_id: int, child: int) -> bool {
    pilot child_kind = v4_mir_rvalue_kind(mir_id, body_id, child)
    if child_kind == v4_mir_rvalue_const_word or child_kind == v4_mir_rvalue_call or child_kind == v4_mir_rvalue_sum_take or child_kind == v4_mir_rvalue_try or child_kind == v4_mir_rvalue_or_else { give back true }
    give back v4_codegen_llvm_rvalue_is_global_read(mir_id, body_id, child)
}

task v4_codegen_llvm_word_flag_slot(local_id: int) -> word {
    give back "%word." + word_from_int(local_id) + ".live"
}

task v4_codegen_llvm_word_bool_intrinsic(kind: word) -> bool {
    give back kind == "equal" or kind == "not_equal" or kind == "starts_with" or kind == "ends_with" or kind == "contains"
}

-- Bootstrap files keep V1's lenient char_at and substring (see the runtime).
task v4_codegen_llvm_word_intrinsic_symbol_for(mir_id: int, kind: word) -> word {
    if v4_ty_file_is_bootstrap(v4_mir_ty_id(mir_id)) and (kind == "char_at" or kind == "substring") { give back "@freak_v4_word_v1_" + kind }
    -- Bootstrap word copies share the immutable allocation, as V1 did.
    if v4_ty_file_is_bootstrap(v4_mir_ty_id(mir_id)) and kind == "clone" { give back "@freak_v4_word_v1_share" }
    give back v4_codegen_llvm_word_intrinsic_symbol(kind)
}

task v4_codegen_llvm_word_intrinsic_symbol(kind: word) -> word {
    if kind == "not_equal" { kind = "equal" }
    if kind.starts_with("array_") { give back "@freak_v4_compiler_" + kind }
    if kind == "word_join" { give back "@freak_v4_compiler_array_join" }
    if kind == "snapshot_lines" { give back "@freak_v4_compiler_array_snapshot_lines" }
    if kind == "process_arg_word" { give back "@freak_v4_process_arg_or_empty" }
    if kind == "fs_read_word" { give back "@freak_v4_fs_read_or_empty" }
    give back "@freak_v4_word_" + kind
}

-- Bootstrap builtins link the private compiler-array runtime and the
-- snapshot word helpers. Declarations appear only when a module uses them.
task v4_codegen_llvm_mir_uses_bootstrap_intrinsics(mir_id: int) -> bool {
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_ty_bootstrap_intrinsic_known(v4_mir_word_intrinsic_kind(mir_id, body, value)) { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back false
}

task v4_codegen_llvm_bootstrap_runtime_declarations(mir_id: int) -> word {
    pilot v1_words = ""
    if v4_ty_file_is_bootstrap(v4_mir_ty_id(mir_id)) { v1_words = "declare void @freak_v4_word_v1_mode()\ndeclare i64 @freak_v4_word_v1_char_at(i64, i64)\ndeclare i64 @freak_v4_word_v1_substring(i64, i64, i64)\ndeclare i64 @freak_v4_word_v1_share(i64)\n" }
    if not v4_codegen_llvm_mir_uses_bootstrap_intrinsics(mir_id) { give back v1_words }
    pilot out = v1_words + "declare i64 @freak_v4_compiler_array_new()\ndeclare i64 @freak_v4_compiler_array_len(i64)\n"
    out = out + "declare void @freak_v4_compiler_array_push(i64, i64)\ndeclare i64 @freak_v4_compiler_array_get(i64, i64)\n"
    out = out + "declare void @freak_v4_compiler_array_set(i64, i64, i64)\ndeclare void @freak_v4_compiler_array_release(i64)\n"
    out = out + "declare i64 @freak_v4_compiler_array_join(i64)\ndeclare i64 @freak_v4_compiler_array_snapshot_lines(i64)\n"
    out = out + "declare void @freak_v4_compiler_array_shutdown()\n"
    out = out + "declare i64 @freak_v4_word_snapshot_escape(i64)\ndeclare i64 @freak_v4_word_snapshot_unescape(i64)\n"
    out = out + "declare i64 @freak_v4_word_snapshot_line_count(i64)\ndeclare i64 @freak_v4_word_snapshot_line(i64, i64)\n"
    out = out + "declare i64 @freak_v4_word_checksum(i64)\ndeclare i64 @freak_v4_word_byte_length(i64)\ndeclare i64 @freak_v4_word_chr(i64)\ndeclare double @freak_v4_word_to_num(i64)\ndeclare i64 @freak_v4_process_arg_or_empty(i64)\ndeclare i64 @freak_v4_fs_read_or_empty(i64)\n"
    give back out + "declare i64 @freak_v4_word_snapshot_field_count(i64)\ndeclare i64 @freak_v4_word_snapshot_field_raw(i64, i64)\n"
}

task v4_codegen_llvm_word_arg_temp(body_id: int, rvalue_id: int, arg_id: int) -> word {
    give back "%word.arg." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + "." + word_from_int(arg_id)
}

task v4_codegen_llvm_word_intrinsic_args(mir_id: int, body_id: int, rvalue_id: int, kind: word) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot arg_id = 0
    repeat until arg_id >= v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) {
        if arg_id > 0 { v4_codegen_llvm_fragment_push(parts, ", ") }
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
        pilot expected = v4_ty_word_intrinsic_param_type(kind, arg_id)
        pilot value = v4_codegen_llvm_expected_value(mir_id, body_id, child, expected, v4_codegen_llvm_word_arg_temp(body_id, rvalue_id, arg_id))
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_type(expected) + " " + value)
        arg_id += 1
    }
    pilot out = word_join(parts)
    array_release(parts)
    give back out
}

task v4_codegen_llvm_word_intrinsic_instruction(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    pilot kind = v4_mir_word_intrinsic_kind(mir_id, body_id, rvalue_id)
    pilot args = v4_codegen_llvm_word_intrinsic_args(mir_id, body_id, rvalue_id, kind)
    if kind == "from_bool" {
        args = "i64 %word.bool." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
    }
    pilot symbol = v4_codegen_llvm_word_intrinsic_symbol_for(mir_id, kind)
    if v4_ty_word_intrinsic_result_type(kind) == v4_ty_void { give back "call void " + symbol + "(" + args + ")" }
    if v4_ty_word_intrinsic_result_type(kind) == v4_ty_num { give back target + " = call double " + symbol + "(" + args + ")" }
    if v4_codegen_llvm_word_bool_intrinsic(kind) {
        pilot raw = target + ".word.bool"
        pilot comparison = "ne"
        if kind == "not_equal" { comparison = "eq" }
        give back raw + " = call i64 " + symbol + "(" + args + ")\n  " + target + " = icmp " + comparison + " i64 " + raw + ", 0"
    }
    give back target + " = call i64 " + symbol + "(" + args + ")"
}

-- Emit transfer at the load, before another operand can run a task. A direct
-- borrowed local is loaded without clearing its flag; a borrowed temporary
-- still evaluates all consuming operands in the task that creates it.
-- Keep Sum-only Word construction out of the ordinary recursive collector's
-- frame: scalar expression depth must retain the existing stack contract.
task v4_codegen_llvm_collect_owned_sum_rvalue_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word, kind: word) -> bool {
    if (kind != v4_mir_rvalue_check and kind != v4_mir_rvalue_sum_take and kind != v4_mir_rvalue_try) or v4_mir_scalar_sum_kind(mir_id, v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))) == "" { give back false }
    pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, child, v4_codegen_llvm_temp_value(body_id, child), true)
    v4_codegen_llvm_fragment_push(parts, "  " + v4_codegen_llvm_scalar_sum_instruction(mir_id, body_id, rvalue_id, target) + "\n")
    if kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try {
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_flag_store_line(mir_id, body_id, v4_mir_rvalue_local_id(mir_id, body_id, child), "false"))
    }
    give back true
}

-- The address v4_codegen_llvm_place_address named for this place at site:
-- a list element is the bounds-checked `%listidx...at`, any other step the
-- `%place...` getelementptr. A compound store reuses the read's address.
task v4_codegen_llvm_compound_place_address(mir_id: int, body_id: int, place_id: int, site: word) -> word {
    pilot stem = word_from_int(body_id) + "." + word_from_int(place_id) + "." + site
    if v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_index and v4_codegen_llvm_is_list(mir_id, v4_codegen_llvm_place_referent_ty(mir_id, body_id, v4_mir_place_base(mir_id, body_id, place_id))) { give back "%listidx." + stem + ".at" }
    give back "%place." + stem
}

-- The address of a place, as LLVM pointer text. Field chains become one
-- getelementptr per step over the freak_target-described struct; a
-- dereferenced root evaluates its pointer operand first.
task v4_codegen_llvm_place_address(parts: int, mir_id: int, body_id: int, place_id: int, site: word) -> word {
    pilot kind = v4_mir_place_kind(mir_id, body_id, place_id)
    if kind == v4_mir_place_local { give back v4_codegen_llvm_local_slot(v4_mir_place_base(mir_id, body_id, place_id)) }
    if kind == v4_mir_place_global { give back v4_codegen_llvm_global_symbol(v4_mir_place_text(mir_id, body_id, place_id)) }
    if kind == v4_mir_place_deref {
        pilot pointer = v4_mir_place_index(mir_id, body_id, place_id)
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, pointer, v4_codegen_llvm_temp_value(body_id, pointer), false)
        give back v4_codegen_llvm_rvalue_value(mir_id, body_id, pointer)
    }
    pilot base = v4_mir_place_base(mir_id, body_id, place_id)
    pilot base_pointer = v4_codegen_llvm_place_address(parts, mir_id, body_id, base, site)
    pilot temp = "%place." + word_from_int(body_id) + "." + word_from_int(place_id) + "." + site
    -- A projection of a borrowed local (`lend T`) reads through the address
    -- that local holds.
    if v4_codegen_llvm_is_place_lend(mir_id, v4_mir_place_ty(mir_id, body_id, base)) {
        v4_codegen_llvm_fragment_push(parts, "  " + temp + ".ref = load ptr, ptr " + base_pointer + "\n")
        base_pointer = temp + ".ref"
    }
    pilot base_ty = v4_codegen_llvm_place_referent_ty(mir_id, body_id, base)
    pilot base_llvm = v4_codegen_llvm_type(base_ty)
    if kind == v4_mir_place_index {
        pilot index = v4_mir_place_index(mir_id, body_id, place_id)
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, index, v4_codegen_llvm_temp_value(body_id, index), false)
        pilot index_value = v4_codegen_llvm_rvalue_value(mir_id, body_id, index)
        if v4_codegen_llvm_is_list(mir_id, base_ty) { give back v4_codegen_llvm_list_element_lines(parts, "listidx." + word_from_int(body_id) + "." + word_from_int(place_id) + "." + site, base_pointer, v4_codegen_llvm_type(v4_codegen_llvm_list_element(mir_id, base_ty)), index_value) }
        if v4_codegen_llvm_index_needs_check(mir_id, body_id, place_id) {
            pilot length = word_from_int(v4_codegen_llvm_fixed_array_length(mir_id, base_ty))
            pilot label = "bounds." + word_from_int(body_id) + "." + word_from_int(place_id) + "." + site
            v4_codegen_llvm_fragment_push(parts, "  %" + label + ".in = icmp ult i64 " + index_value + ", " + length + "\n")
            v4_codegen_llvm_fragment_push(parts, "  br i1 %" + label + ".in, label %" + label + ".ok, label %" + label + ".fail\n" + label + ".fail:\n")
            v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_bounds_panic_lines("%" + label, index_value, length))
            v4_codegen_llvm_fragment_push(parts, "  unreachable\n" + label + ".ok:\n")
        }
        v4_codegen_llvm_fragment_push(parts, "  " + temp + " = getelementptr inbounds " + base_llvm + ", ptr " + base_pointer + ", i64 0, i64 " + index_value + "\n")
        give back temp
    }
    if v4_codegen_llvm_route_signature(mir_id, base_ty) >= 0 { give back v4_codegen_llvm_route_field_address(parts, mir_id, body_id, place_id, base_pointer, temp) }
    v4_codegen_llvm_fragment_push(parts, "  " + temp + " = getelementptr inbounds " + base_llvm + ", ptr " + base_pointer + ", i32 0, i32 " + word_from_int(v4_codegen_llvm_place_slot(mir_id, body_id, place_id)) + "\n")
    give back temp
}

-- "index <i> out of bounds (len <n>)", the V3 runtime wording, built from
-- two private byte constants and handed to the panic helper.
task v4_codegen_llvm_bounds_panic_lines(prefix: word, index_value: word, length: word) -> word {
    pilot out = "  " + prefix + ".m0 = call i64 @freak_v4_word_from_bytes(i64 ptrtoint (ptr @freak.bounds.head to i64), i64 6)\n"
    out = out + "  " + prefix + ".m1 = call i64 @freak_v4_word_from_int(i64 " + index_value + ")\n"
    out = out + "  " + prefix + ".m2 = call i64 @freak_v4_word_concat(i64 " + prefix + ".m0, i64 " + prefix + ".m1)\n"
    out = out + "  " + prefix + ".m3 = call i64 @freak_v4_word_from_bytes(i64 ptrtoint (ptr @freak.bounds.tail to i64), i64 20)\n"
    out = out + "  " + prefix + ".m4 = call i64 @freak_v4_word_concat(i64 " + prefix + ".m2, i64 " + prefix + ".m3)\n"
    out = out + "  " + prefix + ".m5 = call i64 @freak_v4_word_from_int(i64 " + length + ")\n"
    out = out + "  " + prefix + ".m6 = call i64 @freak_v4_word_concat(i64 " + prefix + ".m4, i64 " + prefix + ".m5)\n"
    out = out + "  " + prefix + ".m7 = call i64 @freak_v4_word_from_bytes(i64 ptrtoint (ptr @freak.bounds.close to i64), i64 1)\n"
    out = out + "  " + prefix + ".m8 = call i64 @freak_v4_word_concat(i64 " + prefix + ".m6, i64 " + prefix + ".m7)\n"
    give back out + "  call void " + v4_codegen_llvm_panic_symbol() + "(i64 " + prefix + ".m8) noreturn\n"
}

task v4_codegen_llvm_bounds_globals() -> word {
    pilot out = "@freak.bounds.head = private unnamed_addr constant [7 x i8] c\"index \\00\", align 1\n"
    out = out + "@freak.bounds.tail = private unnamed_addr constant [21 x i8] c\" out of bounds (len \\00\", align 1\n"
    give back out + "@freak.bounds.close = private unnamed_addr constant [2 x i8] c\")\\00\", align 1\n"
}

-- Children evaluate in source order (ascending rvalue IDs); the struct is
-- then assembled in declaration order, which is how MIR stores them.
task v4_codegen_llvm_collect_construct_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word) -> void {
    pilot count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
    pilot emitted = 0
    pilot last = 0 - 1
    repeat until emitted >= count {
        pilot next = 0 - 1
        pilot arg = 0
        repeat until arg >= count {
            pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg)
            if child > last and (next < 0 or child < next) { next = child }
            arg += 1
        }
        if next < 0 { emitted = count } else {
            v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, next, v4_codegen_llvm_temp_value(body_id, next), false)
            last = next
            emitted += 1
        }
    }
    pilot aggregate_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_route_construct_case(mir_id, body_id, rvalue_id) >= 0 {
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_route_construct_lines(mir_id, body_id, rvalue_id, target))
        give back
    }
    pilot llvm_ty = v4_codegen_llvm_type(aggregate_ty)
    pilot slots = v4_codegen_llvm_aggregate_slot_count(mir_id, aggregate_ty)
    if slots == 0 {
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = freeze " + llvm_ty + " zeroinitializer\n")
        give back
    }
    pilot previous = "undef"
    pilot slot = 0
    repeat until slot >= slots {
        -- A repeat fill [v; N] has one child and reuses its value.
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
        if count == slots { child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, slot) }
        pilot slot_ty = v4_codegen_llvm_aggregate_slot_type(mir_id, aggregate_ty, slot)
        pilot cast = "%agg." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + "." + word_from_int(slot) + ".cast"
        if count == slots or slot == 0 {
            v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, child, slot_ty, cast))
        } else {
            cast = "%agg." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + ".0.cast"
        }
        pilot name = "%agg." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + "." + word_from_int(slot)
        if slot == slots - 1 { name = target }
        v4_codegen_llvm_fragment_push(parts, "  " + name + " = insertvalue " + llvm_ty + " " + previous + ", " + v4_codegen_llvm_type(slot_ty) + " " + v4_codegen_llvm_expected_value(mir_id, body_id, child, slot_ty, cast) + ", " + word_from_int(slot) + "\n")
        previous = name
        slot += 1
    }
}

task v4_codegen_llvm_is_literal_aggregate(kind: word) -> bool {
    give back kind == v4_mir_rvalue_construct or kind == v4_mir_rvalue_tuple or kind == v4_mir_rvalue_array
}

-- Empty shapes, unit tuples and zero-length arrays without children have no
-- slots to fill. An array whose every element is a zero literal ([0; N],
-- [false; N], [0, 0, 0]) is all zero bytes. A fill such as [f(); 0] still
-- runs its child once, so it is not a zero literal.
task v4_codegen_llvm_aggregate_literal_is_zero(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot slots = v4_codegen_llvm_aggregate_slot_count(mir_id, type_text)
    pilot count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
    if slots == 0 { give back count == 0 }
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_array or slots < 2 { give back false }
    if count != 1 and count != slots { give back false }
    pilot element = v4_ty_fixed_array_element_type(type_text)
    pilot arg = 0
    repeat until arg >= count {
        if not v4_codegen_llvm_zero_literal_child(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg), element) { give back false }
        arg += 1
    }
    give back true
}

task v4_codegen_llvm_zero_literal_child(mir_id: int, body_id: int, child: int, element: word) -> bool {
    if v4_mir_rvalue_ty(mir_id, body_id, child) != element { give back false }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, child)
    if kind == v4_mir_rvalue_const_int { give back v4_codegen_llvm_const_index(mir_id, body_id, child) == 0 }
    if kind == v4_mir_rvalue_const_bool { give back v4_mir_bool_literal_value(v4_mir_rvalue_text(mir_id, body_id, child)) == "false" }
    give back false
}

-- Construct, tuple and array literals: one child per slot, or one child
-- repeated across a fixed array (bounded, since each copy is an insertvalue).
task v4_codegen_llvm_aggregate_literal_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot aggregate = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == v4_mir_rvalue_construct and v4_codegen_llvm_route_signature(mir_id, type_text) >= 0 { give back v4_codegen_llvm_route_construct_error(mir_id, body_id, rvalue_id) }
    if kind == v4_mir_rvalue_construct and aggregate != "shape" { give back "native construct needs a concrete shape: " + type_text }
    if kind == v4_mir_rvalue_tuple and aggregate != "tuple" { give back "invalid native tuple literal type: " + type_text }
    if kind == v4_mir_rvalue_array and aggregate != "array" { give back "native array literals need a fixed array type: " + type_text }
    pilot slots = v4_codegen_llvm_aggregate_slot_count(mir_id, type_text)
    pilot count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
    -- [v; 0] is a fill too: v runs once and the value is empty.
    pilot fill: bool = kind == v4_mir_rvalue_array and count == 1 and (slots > 1 or slots == 0)
    if count != slots and not fill {
        if kind == v4_mir_rvalue_construct { give back "invalid native shape construct: " + type_text }
        give back "invalid native aggregate literal: " + type_text
    }
    if kind == v4_mir_rvalue_array and slots > 256 and not v4_codegen_llvm_aggregate_literal_is_zero(mir_id, body_id, rvalue_id) { give back "native array literals with more than 256 slots are not yet supported (except zero fills): " + type_text }
    pilot slot = 0
    repeat until slot >= count {
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, slot)
        pilot error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, child), v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot))
        if error != "" { give back error }
        slot += 1
    }
    give back ""
}

-- Impl methods (tier 3). A concrete instance call `p.m(...)` names its
-- callee `T.m` in MIR; the method body is `T::m`. Every other call keeps its
-- MIR name, so dyn, doctrine-bound and generic receivers stay unresolved
-- and are named as unsupported call targets.
task v4_codegen_llvm_call_callee_name(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_active_owned_mir != mir_id or v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) <= 0 { give back op }
    pilot receiver = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
    if receiver < 0 or v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id) != receiver { give back op }
    pilot owner = v4_mir_rvalue_ty(mir_id, body_id, receiver)
    if v4_ty_is_lend_type(owner) { owner = v4_ty_lend_target_type(owner) }
    if owner == "" or not op.starts_with(owner + ".") { give back op }
    pilot name = owner + "::" + v4_slice(op, owner.length() + 1, op.length())
    pilot callee = v4_codegen_llvm_find_mir_body(mir_id, name)
    if callee < 0 or v4_mir_body_impl_method_index(mir_id, callee, 0) < 0 or v4_mir_body_callable_param_name(mir_id, callee, 0) != "self" { give back op }
    give back name
}

-- A loan of a native shape, tuple, fixed array or concrete route is a
-- pointer to the loaned storage. Word loans keep their i64 handle.
task v4_codegen_llvm_is_aggregate_lend(mir_id: int, type_text: word) -> bool {
    if not v4_ty_is_lend_type(type_text) { give back false }
    pilot target = v4_ty_lend_target_type(type_text)
    give back v4_codegen_llvm_aggregate_kind(mir_id, target) != "" or v4_codegen_llvm_route_signature(mir_id, target) >= 0
}

-- Storage a native loan points at: a shape, tuple, fixed array, concrete
-- route, or a scalar (bool, char and the integer and float carriers).
task v4_codegen_llvm_is_lendable_storage(mir_id: int, type_text: word) -> bool {
    if v4_codegen_llvm_aggregate_kind(mir_id, type_text) != "" or v4_codegen_llvm_route_signature(mir_id, type_text) >= 0 or v4_codegen_llvm_is_list(mir_id, type_text) { give back true }
    give back type_text == v4_ty_int or type_text == v4_ty_uint or type_text == v4_ty_tiny or type_text == v4_ty_num or type_text == v4_ty_float or type_text == v4_ty_float32 or type_text == v4_ty_bool or type_text == v4_ty_char
}

-- `lend T` / `lend mut T` over lendable storage is the address of that
-- storage (`ptr`), and so is `lend mut word` (the caller's word slot, which
-- the callee may replace). A shared word loan keeps its i64 handle.
task v4_codegen_llvm_is_place_lend(mir_id: int, type_text: word) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or not v4_ty_is_lend_type(type_text) { give back false }
    pilot target = v4_ty_lend_target_type(type_text)
    give back v4_codegen_llvm_is_lendable_storage(mir_id, target) or (target == v4_ty_word and v4_ty_lend_mode(type_text) == v4_ty_param_mode_lend_mut)
}

-- The type a projection of this place addresses: a borrowed (`lend T`)
-- place is read through, so its projections address T.
task v4_codegen_llvm_place_referent_ty(mir_id: int, body_id: int, place_id: int) -> word {
    pilot type_text = v4_mir_place_ty(mir_id, body_id, place_id)
    if v4_codegen_llvm_is_place_lend(mir_id, type_text) { give back v4_ty_lend_target_type(type_text) }
    give back type_text
}

-- A `lend` / `lend mut` parameter (`self` included) of a FREAK task over
-- lendable storage. The caller passes the address of its own place and the
-- parameter's local is that place, so writes through `lend mut` reach the
-- caller. Word `lend` parameters keep their handle; `lend mut` words and C
-- boundaries stay fenced (v4_codegen_llvm_lend_param_error).
task v4_codegen_llvm_local_is_lent_param(mir_id: int, body_id: int, local_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or local_id < 0 or local_id >= v4_mir_body_callable_param_count(mir_id, body_id) { give back false }
    if v4_mir_body_callable_abi(mir_id, body_id) != "" { give back false }
    pilot mode = v4_mir_body_callable_param_mode(mir_id, body_id, local_id)
    if mode != v4_ty_param_mode_lend and mode != v4_ty_param_mode_lend_mut { give back false }
    if v4_mir_local_mode(mir_id, body_id, local_id) != mode { give back false }
    pilot local_ty = v4_mir_local_ty(mir_id, body_id, local_id)
    give back v4_codegen_llvm_is_lendable_storage(mir_id, local_ty) or (local_ty == v4_ty_word and mode == v4_ty_param_mode_lend_mut)
}

-- Why a lend parameter mode cannot lower natively, or "" when it can.
task v4_codegen_llvm_lend_param_error(mir_id: int, mode: word, type_text: word, c_boundary: bool) -> word {
    if mode != v4_ty_param_mode_lend and mode != v4_ty_param_mode_lend_mut { give back "" }
    -- An immutable word loan is its handle, on either side of a boundary.
    if v4_codegen_llvm_active_owned_mir == mir_id and type_text == v4_ty_word and mode == v4_ty_param_mode_lend { give back "" }
    if v4_codegen_llvm_active_owned_mir != mir_id { give back "native lend parameters currently support only immutable word parameters" }
    if c_boundary { give back "native lend parameters across the C ABI are not yet supported: " + type_text }
    if type_text == v4_ty_word or v4_codegen_llvm_is_lendable_storage(mir_id, type_text) or v4_ty_is_dyn_type(type_text) { give back "" }
    give back "native lend parameters are not yet supported for " + type_text
}

-- `lend p` / `lend mut p` over a lendable place: the address of that
-- place. The loaned value is never read, so only index operands evaluate.
task v4_codegen_llvm_collect_aggregate_lend_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word) -> bool {
    -- A dyn loan (erasure or reborrow) takes the same place address.
    pilot dyn_ref: bool = v4_codegen_llvm_is_dyn_ref(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    if not dyn_ref and not v4_codegen_llvm_is_place_lend(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) { give back false }
    pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot address = ""
    if v4_mir_rvalue_kind(mir_id, body_id, child) == v4_mir_rvalue_use_local {
        address = v4_codegen_llvm_local_slot(v4_mir_rvalue_local_id(mir_id, body_id, child))
    } else {
        address = v4_codegen_llvm_place_address(parts, mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, child), "l" + word_from_int(rvalue_id))
    }
    if dyn_ref { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_dyn_lend_value_lines(mir_id, body_id, rvalue_id, target, address)) } else { v4_codegen_llvm_fragment_push(parts, "  " + target + " = getelementptr inbounds i8, ptr " + address + ", i64 0\n") }
    give back true
}

-- Native lists (tier 3). `List<T>` is an owned heap value: one header
-- `freak.list.header` (data pointer, length, capacity) whose elements sit by
-- value in a buffer typed per element type (no boxing, no type-erased
-- pool). The header is a named record, so freak_target answers its layout
-- like any aggregate. The buffer comes from libc realloc/free, the
-- allocator the native runtime itself uses, through private module helpers.
-- A list moves as one value (its header); its drop glue releases every
-- element's words, then the buffer. Meiya owns every move and drop site.
task v4_codegen_llvm_is_list(mir_id: int, type_text: word) -> bool {
    if mir_id < 0 or v4_codegen_llvm_active_owned_mir != mir_id or type_text == "" or type_text == v4_ty_unknown or v4_ty_is_lend_type(type_text) { give back false }
    give back v4_ty_list_element_type(v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text)) != v4_ty_unknown
}

task v4_codegen_llvm_list_element(mir_id: int, type_text: word) -> word {
    give back v4_ty_list_element_type(v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text))
}

task v4_codegen_llvm_list_header_type() -> word {
    give back "%\"freak.list.header\""
}

-- An element's size as an i64 operand LLVM folds per target.
task v4_codegen_llvm_list_element_size(element_llvm: word) -> word {
    give back "i64 ptrtoint (ptr getelementptr (" + element_llvm + ", ptr null, i32 1) to i64)"
}

task v4_codegen_llvm_type_names_list(mir_id: int, type_text: word) -> bool {
    if v4_ty_is_lend_type(type_text) { give back v4_codegen_llvm_type_holds_list(mir_id, v4_ty_lend_target_type(type_text), 0) }
    give back v4_codegen_llvm_type_holds_list(mir_id, type_text, 0)
}

-- A list, or a shape, tuple, fixed array or route holding one at any depth.
task v4_codegen_llvm_type_holds_list(mir_id: int, type_text: word, depth: int) -> bool {
    if depth > 32 or type_text == "" or type_text == v4_ty_unknown or v4_ty_is_lend_type(type_text) { give back false }
    if v4_codegen_llvm_is_list(mir_id, type_text) { give back true }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    if kind == "array" { give back v4_codegen_llvm_type_holds_list(mir_id, v4_ty_fixed_array_element_type(type_text), depth + 1) }
    if kind != "" {
        pilot slot = 0
        repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
            if v4_codegen_llvm_type_holds_list(mir_id, v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot), depth + 1) { give back true }
            slot += 1
        }
        give back false
    }
    pilot sig = v4_codegen_llvm_route_signature(mir_id, type_text)
    if sig < 0 { give back false }
    pilot case_id = 0
    repeat until case_id >= v4_ty_route_case_count(v4_mir_ty_id(mir_id), v4_codegen_llvm_route_sig(mir_id, sig)) {
        pilot field = 0
        repeat until field >= v4_codegen_llvm_route_field_count(mir_id, sig, case_id) {
            if v4_codegen_llvm_type_holds_list(mir_id, v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field), depth + 1) { give back true }
            field += 1
        }
        case_id += 1
    }
    give back false
}

task v4_codegen_llvm_mir_uses_lists(mir_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id { give back false }
    -- Only emitted bodies: an uncalled generic template naming List<T> needs
    -- no list runtime; each instance is scanned with its concrete types.
    pilot body = v4_codegen_llvm_next_emitted_body(mir_id, 0)
    repeat until body >= v4_mir_body_count(mir_id) {
        if v4_codegen_llvm_type_names_list(mir_id, v4_mir_body_callable_return_type(mir_id, body)) { give back true }
        pilot local = 0
        repeat until local >= v4_mir_body_local_count(mir_id, body) {
            if v4_codegen_llvm_type_names_list(mir_id, v4_mir_local_ty(mir_id, body, local)) { give back true }
            local += 1
        }
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_codegen_llvm_type_names_list(mir_id, v4_mir_rvalue_ty(mir_id, body, value)) { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back false
}

-- `List<T>` type surfaces: a list of scalars, words, task or raw pointers,
-- lists, or native shapes, tuples, fixed arrays and routes. A list is a
-- top-level value or an aggregate slot (v4_codegen_llvm_native_list_slot_error);
-- only task value surfaces reach here nested, and they stay fenced.
task v4_codegen_llvm_native_list_type_error(mir_id: int, type_text: word, depth: int) -> word {
    if depth > 0 { give back "native task values with list parameters or results are not yet supported: " + type_text }
    give back v4_codegen_llvm_native_list_slot_error(mir_id, type_text, 0)
}

-- A list as a value or as a shape field, tuple or array slot or list
-- element: its header is one owned slot (tier 3 nested lists row).
task v4_codegen_llvm_native_list_slot_error(mir_id: int, type_text: word, depth: int) -> word {
    if depth > 32 { give back "native list nesting exceeds supported depth: " + type_text }
    pilot element = v4_codegen_llvm_list_element(mir_id, type_text)
    if element == "" or element == v4_ty_unknown { give back "native list element type is unresolved: " + type_text }
    if v4_ty_is_lend_type(element) { give back "native lists of loans are not yet supported: " + type_text }
    if element == v4_ty_void or element == v4_ty_never { give back "native lists of void are not supported: " + type_text }
    if v4_ty_is_native_scalar_sum(v4_mir_ty_id(mir_id), element) or v4_mir_scalar_sum_kind(mir_id, element) != "" or v4_ty_is_maybe_type(element) { give back "native lists of maybe/result values are not yet supported: " + type_text }
    if v4_codegen_llvm_is_list(mir_id, element) { give back v4_codegen_llvm_native_list_slot_error(mir_id, element, depth + 1) }
    if v4_ty_is_closure_type(element) { give back "native lists of closures are not yet supported: " + type_text }
    give back v4_codegen_llvm_native_type_error_depth(element, false, depth + 1)
}

-- List literals, list builtin calls (`push`, `length`) and list loop items.
-- MIR states every operand; codegen adds no operation of its own.
task v4_codegen_llvm_native_list_rvalue_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    if not v4_mir_snapshot_rvalue_refs_are_valid(kind, word_from_int(lhs), word_from_int(rhs), v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), rvalue_id, v4_mir_body_place_count(mir_id, body_id)) { give back "invalid native rvalue references: " + kind }
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot error = v4_codegen_llvm_native_type_error(type_text, kind == v4_mir_rvalue_call)
    if error != "" { give back error }
    if kind == v4_mir_rvalue_list {
        if not v4_codegen_llvm_is_list(mir_id, type_text) { give back "native list literals need a concrete List type: " + type_text }
        pilot element = v4_codegen_llvm_list_element(mir_id, type_text)
        pilot arg = 0
        repeat until arg >= v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) {
            error = v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg)), element)
            if error != "" { give back error }
            arg += 1
        }
        give back ""
    }
    -- The item is a fresh copy: word leaves are cloned by path, and lists
    -- and route payloads (read by their tag) by a clone helper.
    if kind == v4_mir_rvalue_loop_item { give back "" }
    if v4_mir_list_intrinsic_kind(mir_id, body_id, rvalue_id) == "push" {
        pilot list_ty = v4_ty_lend_target_type(v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)))
        give back v4_codegen_llvm_native_conversion_error(v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 1)), v4_codegen_llvm_list_element(mir_id, list_ty))
    }
    give back ""
}

-- The checked address of element `index` of the list whose header is at
-- `header`. Past the length it panics with V3's wording.
task v4_codegen_llvm_list_element_lines(parts: int, label: word, header: word, element_llvm: word, index_value: word) -> word {
    pilot header_ty = v4_codegen_llvm_list_header_type()
    pilot value = "%" + label
    v4_codegen_llvm_fragment_push(parts, "  " + value + ".lenp = getelementptr inbounds " + header_ty + ", ptr " + header + ", i32 0, i32 1\n")
    v4_codegen_llvm_fragment_push(parts, "  " + value + ".len = load i64, ptr " + value + ".lenp\n")
    v4_codegen_llvm_fragment_push(parts, "  " + value + ".in = icmp ult i64 " + index_value + ", " + value + ".len\n")
    v4_codegen_llvm_fragment_push(parts, "  br i1 " + value + ".in, label " + value + ".ok, label " + value + ".fail\n" + label + ".fail:\n")
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_bounds_panic_lines(value, index_value, value + ".len"))
    v4_codegen_llvm_fragment_push(parts, "  unreachable\n" + label + ".ok:\n")
    v4_codegen_llvm_fragment_push(parts, "  " + value + ".data = load ptr, ptr " + header + "\n")
    v4_codegen_llvm_fragment_push(parts, "  " + value + ".at = getelementptr inbounds " + element_llvm + ", ptr " + value + ".data, i64 " + index_value + "\n")
    give back value + ".at"
}

-- One call site in v4_codegen_llvm_collect_owned_special_lines (the stack
-- rule). This dispatcher sits in the recursive collector's chain, so it only
-- evaluates operands; the IR text comes from non-recursive emitters.
task v4_codegen_llvm_collect_list_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word, kind: word) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id { give back false }
    pilot list_kind = ""
    if kind == v4_mir_rvalue_call { list_kind = v4_mir_list_intrinsic_kind(mir_id, body_id, rvalue_id) }
    if kind == v4_mir_rvalue_loop_item and v4_mir_rvalue_is_list_loop_item(mir_id, body_id, rvalue_id) { list_kind = "item" }
    if kind == v4_mir_rvalue_list { list_kind = "literal" }
    if list_kind == "" { give back false }
    -- Operands in source order: literal elements, or the loan then the
    -- pushed item or the item index.
    pilot first = 0 - 1
    pilot second = 0 - 1
    pilot count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
    if list_kind == "item" {
        first = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        second = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
        count = 0
    }
    pilot arg = 0
    repeat until arg >= count {
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg)
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, child, v4_codegen_llvm_temp_value(body_id, child), false)
        arg += 1
    }
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, first, v4_codegen_llvm_temp_value(body_id, first), false)
    v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, second, v4_codegen_llvm_temp_value(body_id, second), false)
    if list_kind == "literal" {
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_list_literal_lines(mir_id, body_id, rvalue_id, target))
    } else {
        v4_codegen_llvm_list_operation_lines(parts, mir_id, body_id, rvalue_id, target, list_kind)
    }
    give back true
}

-- `length`, `push` and loop items over operands already evaluated.
task v4_codegen_llvm_list_operation_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word, list_kind: word) -> void {
    pilot header_ty = v4_codegen_llvm_list_header_type()
    pilot prefix = "%list." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
    pilot loan = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    if list_kind != "item" { loan = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0) }
    pilot header = v4_codegen_llvm_rvalue_value(mir_id, body_id, loan)
    pilot element = v4_codegen_llvm_list_element(mir_id, v4_ty_lend_target_type(v4_mir_rvalue_ty(mir_id, body_id, loan)))
    pilot element_llvm = v4_codegen_llvm_type(element)
    if list_kind == "length" {
        v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".lenp = getelementptr inbounds " + header_ty + ", ptr " + header + ", i32 0, i32 1\n")
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = load i64, ptr " + prefix + ".lenp\n")
        give back
    }
    if list_kind == "push" {
        -- The item moves into the slot push_slot opens at the end.
        pilot item = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 1)
        pilot cast = prefix + ".item"
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, item, element, cast))
        v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".slot = call ptr @freak.list.push_slot(ptr " + header + ", " + v4_codegen_llvm_list_element_size(element_llvm) + ")\n")
        v4_codegen_llvm_fragment_push(parts, "  store " + element_llvm + " " + v4_codegen_llvm_expected_value(mir_id, body_id, item, element, cast) + ", ptr " + prefix + ".slot\n")
        give back
    }
    -- A loop item: a fresh owned copy of the element (each word cloned).
    pilot index = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    pilot at = v4_codegen_llvm_list_element_lines(parts, v4_slice(prefix, 1, prefix.length()), header, element_llvm, v4_codegen_llvm_rvalue_value(mir_id, body_id, index))
    pilot clone = v4_codegen_llvm_word_intrinsic_symbol_for(mir_id, "clone")
    if v4_ty_canonical_type(v4_mir_ty_id(mir_id), element) == v4_ty_word {
        v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".v = load i64, ptr " + at + "\n")
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = call i64 " + clone + "(i64 " + prefix + ".v)\n")
        give back
    }
    -- Lists and route payloads have no extractvalue word paths: a private
    -- helper copies the element and clones its leaves in memory.
    if v4_codegen_llvm_needs_clone_helper(mir_id, element) {
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = call " + element_llvm + " " + v4_codegen_llvm_clone_helper_symbol(mir_id, element) + "(ptr " + at + ")\n")
        give back
    }
    pilot paths = v4_codegen_llvm_word_leaf_paths(mir_id, element, "")
    if paths == "" {
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = load " + element_llvm + ", ptr " + at + "\n")
        give back
    }
    v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".v = load " + element_llvm + ", ptr " + at + "\n")
    pilot previous = prefix + ".v"
    pilot leaf = 0
    pilot start = 0
    repeat until start > paths.length() {
        pilot stop = v4_index_of_from(paths, ";", start)
        if stop < 0 { stop = paths.length() }
        pilot path = v4_slice(paths, start, stop)
        pilot handle = prefix + ".leaf." + word_from_int(leaf)
        v4_codegen_llvm_fragment_push(parts, "  " + handle + " = extractvalue " + element_llvm + " " + previous + ", " + path + "\n")
        v4_codegen_llvm_fragment_push(parts, "  " + handle + ".copy = call i64 " + clone + "(i64 " + handle + ")\n")
        pilot name = prefix + ".with." + word_from_int(leaf)
        if stop >= paths.length() { name = target }
        v4_codegen_llvm_fragment_push(parts, "  " + name + " = insertvalue " + element_llvm + " " + previous + ", i64 " + handle + ".copy, " + path + "\n")
        previous = name
        leaf += 1
        start = stop + 1
    }
}

-- A literal allocates exactly its length; `[]` is the empty header (no
-- buffer until the first push). Elements move in, in source order.
task v4_codegen_llvm_list_literal_lines(mir_id: int, body_id: int, rvalue_id: int, target: word) -> word {
    pilot header_ty = v4_codegen_llvm_list_header_type()
    pilot element = v4_codegen_llvm_list_element(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    pilot element_llvm = v4_codegen_llvm_type(element)
    pilot prefix = "%list." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
    pilot count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
    if count <= 0 { give back "  " + target + " = freeze " + header_ty + " zeroinitializer\n" }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot length = word_from_int(count)
    v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".data = call ptr @freak.list.alloc(i64 " + length + ", " + v4_codegen_llvm_list_element_size(element_llvm) + ")\n")
    pilot arg = 0
    repeat until arg >= count {
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg)
        pilot slot = prefix + ".e" + word_from_int(arg)
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, child, element, slot + ".cast"))
        v4_codegen_llvm_fragment_push(parts, "  " + slot + " = getelementptr inbounds " + element_llvm + ", ptr " + prefix + ".data, i64 " + word_from_int(arg) + "\n")
        v4_codegen_llvm_fragment_push(parts, "  store " + element_llvm + " " + v4_codegen_llvm_expected_value(mir_id, body_id, child, element, slot + ".cast") + ", ptr " + slot + "\n")
        arg += 1
    }
    v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".h0 = insertvalue " + header_ty + " undef, ptr " + prefix + ".data, 0\n")
    v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".h1 = insertvalue " + header_ty + " " + prefix + ".h0, i64 " + length + ", 1\n")
    v4_codegen_llvm_fragment_push(parts, "  " + target + " = insertvalue " + header_ty + " " + prefix + ".h1, i64 " + length + ", 2\n")
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- Drop glue of a list (at `address`, or a header `value` when address is
-- ""): the element type's private drop helper over (data, len). Under
-- `cond` the helper sees an empty list, so nothing is released.
task v4_codegen_llvm_list_drop_lines(mir_id: int, type_text: word, address: word, value: word, cond: word, temp: word) -> word {
    pilot header_ty = v4_codegen_llvm_list_header_type()
    pilot element = v4_codegen_llvm_list_element(mir_id, type_text)
    if not v4_codegen_llvm_list_drop_types.contains("\n" + element + "\n") { v4_codegen_llvm_list_drop_types = v4_codegen_llvm_list_drop_types + element + "\n" }
    pilot out = ""
    if address != "" {
        out = "  " + temp + ".data = load ptr, ptr " + address + "\n"
        out = out + "  " + temp + ".lenp = getelementptr inbounds " + header_ty + ", ptr " + address + ", i32 0, i32 1\n"
        out = out + "  " + temp + ".len = load i64, ptr " + temp + ".lenp\n"
    } else {
        out = "  " + temp + ".data = extractvalue " + header_ty + " " + value + ", 0\n"
        out = out + "  " + temp + ".len = extractvalue " + header_ty + " " + value + ", 1\n"
    }
    pilot data = temp + ".data"
    pilot length = temp + ".len"
    if cond != "" {
        data = temp + ".data.live"
        length = temp + ".len.live"
        out = out + "  " + data + " = select i1 " + cond + ", ptr " + temp + ".data, ptr null\n"
        out = out + "  " + length + " = select i1 " + cond + ", i64 " + temp + ".len, i64 0\n"
    }
    give back out + "  call void " + v4_codegen_llvm_symbol("freak.list.drop." + element) + "(ptr " + data + ", i64 " + length + ")\n"
}

-- The private helpers a module with lists links: allocation with overflow
-- checks (amortized doubling from 4), and one drop helper per element type.
-- An allocation failure panics through the module's panic policy.
task v4_codegen_llvm_list_runtime_lines(mir_id: int) -> word {
    pilot header_ty = v4_codegen_llvm_list_header_type()
    pilot pair = "{" + " i64, i1 " + "}"
    pilot fail = "fail:\n  %msg = call i64 @freak_v4_word_from_bytes(i64 ptrtoint (ptr @freak.list.oom to i64), i64 22)\n  call void " + v4_codegen_llvm_panic_symbol() + "(i64 %msg) noreturn\n  unreachable\n"
    pilot out = "declare ptr @realloc(ptr, i64)\ndeclare void @free(ptr)\ndeclare " + pair + " @llvm.umul.with.overflow.i64(i64, i64)\n"
    out = out + "define internal ptr @freak.list.alloc(i64 %count, i64 %size) " + "{" + "\nentry:\n"
    out = out + "  %bytes.o = call " + pair + " @llvm.umul.with.overflow.i64(i64 %count, i64 %size)\n"
    out = out + "  %bytes = extractvalue " + pair + " %bytes.o, 0\n  %over = extractvalue " + pair + " %bytes.o, 1\n"
    out = out + "  %none = icmp eq i64 %bytes, 0\n  %ask = select i1 %none, i64 1, i64 %bytes\n"
    out = out + "  br i1 %over, label %fail, label %grow\ngrow:\n"
    out = out + "  %data = call ptr @realloc(ptr null, i64 %ask)\n  %lost = icmp eq ptr %data, null\n"
    out = out + "  br i1 %lost, label %fail, label %ok\nok:\n  ret ptr %data\n" + fail + "}\n"
    out = out + "define internal ptr @freak.list.push_slot(ptr %h, i64 %size) " + "{" + "\nentry:\n"
    out = out + "  %lenp = getelementptr inbounds " + header_ty + ", ptr %h, i32 0, i32 1\n"
    out = out + "  %capp = getelementptr inbounds " + header_ty + ", ptr %h, i32 0, i32 2\n"
    out = out + "  %len = load i64, ptr %lenp\n  %cap = load i64, ptr %capp\n  %old = load ptr, ptr %h\n"
    out = out + "  %full = icmp uge i64 %len, %cap\n  br i1 %full, label %grow, label %store\ngrow:\n"
    out = out + "  %small = icmp ult i64 %cap, 4\n  %twice = shl i64 %cap, 1\n  %next = select i1 %small, i64 4, i64 %twice\n"
    out = out + "  %wrapped = icmp ult i64 %next, %cap\n"
    out = out + "  %bytes.o = call " + pair + " @llvm.umul.with.overflow.i64(i64 %next, i64 %size)\n"
    out = out + "  %bytes = extractvalue " + pair + " %bytes.o, 0\n  %over.mul = extractvalue " + pair + " %bytes.o, 1\n"
    out = out + "  %over = or i1 %over.mul, %wrapped\n"
    out = out + "  %none = icmp eq i64 %bytes, 0\n  %ask = select i1 %none, i64 1, i64 %bytes\n"
    out = out + "  br i1 %over, label %fail, label %resize\nresize:\n"
    out = out + "  %grown = call ptr @realloc(ptr %old, i64 %ask)\n  %lost = icmp eq ptr %grown, null\n"
    out = out + "  br i1 %lost, label %fail, label %grown.ok\ngrown.ok:\n"
    out = out + "  store ptr %grown, ptr %h\n  store i64 %next, ptr %capp\n  br label %store\nstore:\n"
    out = out + "  %data = phi ptr [ %old, %entry ], [ %grown, %grown.ok ]\n"
    out = out + "  %count = add i64 %len, 1\n  store i64 %count, ptr %lenp\n"
    out = out + "  %offset = mul i64 %len, %size\n  %slot = getelementptr inbounds i8, ptr %data, i64 %offset\n  ret ptr %slot\n" + fail + "}\n"
    -- Clone helpers first: they only add clone helpers (drop helpers only
    -- add drop helpers), so each list grows to its own fixpoint.
    pilot clone_start = 1
    repeat until clone_start >= v4_codegen_llvm_list_clone_types.length() {
        pilot clone_stop = v4_index_of_from(v4_codegen_llvm_list_clone_types, "\n", clone_start)
        if clone_stop < 0 { clone_stop = v4_codegen_llvm_list_clone_types.length() }
        out = out + v4_codegen_llvm_clone_helper_lines(mir_id, v4_slice(v4_codegen_llvm_list_clone_types, clone_start, clone_stop))
        clone_start = clone_stop + 1
    }
    pilot start = 1
    repeat until start >= v4_codegen_llvm_list_drop_types.length() {
        pilot stop = v4_index_of_from(v4_codegen_llvm_list_drop_types, "\n", start)
        if stop < 0 { stop = v4_codegen_llvm_list_drop_types.length() }
        pilot element = v4_slice(v4_codegen_llvm_list_drop_types, start, stop)
        pilot element_llvm = v4_codegen_llvm_type(element)
        out = out + "define internal void " + v4_codegen_llvm_symbol("freak.list.drop." + element) + "(ptr %data, i64 %len) " + "{" + "\nentry:\n"
        if v4_codegen_llvm_word_leaf_count(mir_id, element, 0) > 0 {
            out = out + "  %empty = icmp eq i64 %len, 0\n  br i1 %empty, label %done, label %each\neach:\n"
            out = out + "  %i = phi i64 [ 0, %entry ], [ %next, %each ]\n"
            out = out + "  %at = getelementptr inbounds " + element_llvm + ", ptr %data, i64 %i\n"
            out = out + v4_codegen_llvm_drop_glue_at(mir_id, element, "%at", "", "%e", 0)
            out = out + "  %next = add i64 %i, 1\n  %more = icmp ult i64 %next, %len\n"
            out = out + "  br i1 %more, label %each, label %done\ndone:\n"
        }
        out = out + "  call void @free(ptr %data)\n  ret void\n}\n"
        start = stop + 1
    }
    give back out
}

-- Deep copies (tier 3 nested lists row). A for-each item is the walker's
-- own copy of its element: words are cloned, a list gets a fresh buffer of
-- copied elements, and a route clones the leaves of the case its tag names.
-- Types without such leaves copy with extractvalue word paths instead.
task v4_codegen_llvm_needs_clone_helper(mir_id: int, type_text: word) -> bool {
    give back v4_codegen_llvm_type_holds_list(mir_id, type_text, 0) or v4_codegen_llvm_type_has_route_words(mir_id, type_text, 0)
}

-- The helper `T @"freak.list.clone.T"(ptr src)`, registered for emission.
task v4_codegen_llvm_clone_helper_symbol(mir_id: int, type_text: word) -> word {
    pilot canonical = v4_ty_canonical_type(v4_mir_ty_id(mir_id), type_text)
    if not v4_codegen_llvm_list_clone_types.contains("\n" + canonical + "\n") { v4_codegen_llvm_list_clone_types = v4_codegen_llvm_list_clone_types + canonical + "\n" }
    give back v4_codegen_llvm_symbol("freak.list.clone." + canonical)
}

-- Clone the owned leaves of the value at `src` into the bitwise copy at
-- `dst`. Labels derive from `temp`, unique within one helper.
task v4_codegen_llvm_clone_glue_at(mir_id: int, type_text: word, dst: word, src: word, temp: word, depth: int) -> word {
    if depth > 32 or v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0) <= 0 { give back "" }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_canonical_type(ty_id, type_text) == v4_ty_word {
        pilot out = "  " + temp + ".h = load i64, ptr " + src + "\n"
        out = out + "  " + temp + ".c = call i64 " + v4_codegen_llvm_word_intrinsic_symbol_for(mir_id, "clone") + "(i64 " + temp + ".h)\n"
        give back out + "  store i64 " + temp + ".c, ptr " + dst + "\n"
    }
    pilot llvm_ty = v4_codegen_llvm_type(type_text)
    if v4_codegen_llvm_is_list(mir_id, type_text) {
        pilot out = "  " + temp + ".l = call " + llvm_ty + " " + v4_codegen_llvm_clone_helper_symbol(mir_id, type_text) + "(ptr " + src + ")\n"
        give back out + "  store " + llvm_ty + " " + temp + ".l, ptr " + dst + "\n"
    }
    pilot kind = v4_codegen_llvm_aggregate_kind(mir_id, type_text)
    pilot out = ""
    if kind == "" {
        pilot sig = v4_codegen_llvm_route_signature(mir_id, type_text)
        if sig < 0 { give back "" }
        pilot tag_ty = v4_codegen_llvm_route_tag_type(mir_id, sig)
        pilot label = v4_slice(temp, 1, temp.length())
        out = "  " + temp + ".tag = load " + tag_ty + ", ptr " + src + "\n"
        out = out + "  " + temp + ".from = getelementptr inbounds " + llvm_ty + ", ptr " + src + ", i32 0, i32 1\n"
        out = out + "  " + temp + ".to = getelementptr inbounds " + llvm_ty + ", ptr " + dst + ", i32 0, i32 1\n"
        pilot case_id = 0
        repeat until case_id >= v4_ty_route_case_count(ty_id, v4_codegen_llvm_route_sig(mir_id, sig)) {
            pilot case_struct = v4_codegen_llvm_route_case_struct(mir_id, sig, case_id)
            pilot case_temp = temp + ".c" + word_from_int(case_id)
            pilot case_label = label + ".c" + word_from_int(case_id)
            pilot fields = v4_codegen_llvm_route_field_count(mir_id, sig, case_id)
            pilot opened = false
            pilot field = 0
            repeat until field >= fields {
                pilot field_ty = v4_codegen_llvm_route_field_type(mir_id, sig, case_id, field)
                if v4_codegen_llvm_word_leaf_count(mir_id, field_ty, 0) > 0 {
                    if not opened {
                        out = out + "  " + case_temp + ".is = icmp eq " + tag_ty + " " + temp + ".tag, " + v4_codegen_llvm_route_tag_value(mir_id, sig, case_id) + "\n"
                        out = out + "  br i1 " + case_temp + ".is, label %" + case_label + ".then, label %" + case_label + ".end\n" + case_label + ".then:\n"
                        opened = true
                    }
                    pilot field_temp = case_temp + ".f" + word_from_int(field)
                    out = out + "  " + field_temp + ".src = getelementptr inbounds " + case_struct + ", ptr " + temp + ".from, i32 0, i32 " + word_from_int(field) + "\n"
                    out = out + "  " + field_temp + ".dst = getelementptr inbounds " + case_struct + ", ptr " + temp + ".to, i32 0, i32 " + word_from_int(field) + "\n"
                    out = out + v4_codegen_llvm_clone_glue_at(mir_id, field_ty, field_temp + ".dst", field_temp + ".src", field_temp, depth + 1)
                }
                field += 1
            }
            if opened { out = out + "  br label %" + case_label + ".end\n" + case_label + ".end:\n" }
            case_id += 1
        }
        give back out
    }
    pilot slot = 0
    repeat until slot >= v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) {
        pilot slot_ty = v4_codegen_llvm_aggregate_slot_type(mir_id, type_text, slot)
        if v4_codegen_llvm_word_leaf_count(mir_id, slot_ty, 0) > 0 {
            pilot slot_temp = temp + ".s" + word_from_int(slot)
            out = out + "  " + slot_temp + ".src = getelementptr inbounds " + llvm_ty + ", ptr " + src + ", i32 0, i32 " + word_from_int(slot) + "\n"
            out = out + "  " + slot_temp + ".dst = getelementptr inbounds " + llvm_ty + ", ptr " + dst + ", i32 0, i32 " + word_from_int(slot) + "\n"
            out = out + v4_codegen_llvm_clone_glue_at(mir_id, slot_ty, slot_temp + ".dst", slot_temp + ".src", slot_temp, depth + 1)
        }
        slot += 1
    }
    give back out
}

-- One clone helper. A list copies its length into a fresh buffer of
-- exactly that many elements (an empty list stays the empty header); any
-- other type copies bitwise and clones its leaves in place.
task v4_codegen_llvm_clone_helper_lines(mir_id: int, type_text: word) -> word {
    pilot llvm_ty = v4_codegen_llvm_type(type_text)
    pilot out = "define internal " + llvm_ty + " " + v4_codegen_llvm_symbol("freak.list.clone." + type_text) + "(ptr %src) " + "{" + "\nentry:\n"
    if v4_codegen_llvm_is_list(mir_id, type_text) {
        pilot header_ty = v4_codegen_llvm_list_header_type()
        pilot element = v4_codegen_llvm_list_element(mir_id, type_text)
        pilot element_llvm = v4_codegen_llvm_type(element)
        out = out + "  %data = load ptr, ptr %src\n"
        out = out + "  %lenp = getelementptr inbounds " + header_ty + ", ptr %src, i32 0, i32 1\n"
        out = out + "  %len = load i64, ptr %lenp\n  %empty = icmp eq i64 %len, 0\n"
        out = out + "  br i1 %empty, label %none, label %copy\nnone:\n  ret " + header_ty + " zeroinitializer\ncopy:\n"
        out = out + "  %buf = call ptr @freak.list.alloc(i64 %len, " + v4_codegen_llvm_list_element_size(element_llvm) + ")\n  br label %each\neach:\n"
        out = out + "  %i = phi i64 [ 0, %copy ], [ %next, %each ]\n"
        out = out + "  %from = getelementptr inbounds " + element_llvm + ", ptr %data, i64 %i\n"
        out = out + "  %to = getelementptr inbounds " + element_llvm + ", ptr %buf, i64 %i\n"
        if v4_ty_canonical_type(v4_mir_ty_id(mir_id), element) == v4_ty_word {
            out = out + "  %h = load i64, ptr %from\n  %v = call i64 " + v4_codegen_llvm_word_intrinsic_symbol_for(mir_id, "clone") + "(i64 %h)\n"
        } else if v4_codegen_llvm_word_leaf_count(mir_id, element, 0) > 0 {
            out = out + "  %v = call " + element_llvm + " " + v4_codegen_llvm_clone_helper_symbol(mir_id, element) + "(ptr %from)\n"
        } else {
            out = out + "  %v = load " + element_llvm + ", ptr %from\n"
        }
        out = out + "  store " + element_llvm + " %v, ptr %to\n"
        out = out + "  %next = add i64 %i, 1\n  %more = icmp ult i64 %next, %len\n  br i1 %more, label %each, label %done\ndone:\n"
        out = out + "  %h0 = insertvalue " + header_ty + " undef, ptr %buf, 0\n"
        out = out + "  %h1 = insertvalue " + header_ty + " %h0, i64 %len, 1\n"
        out = out + "  %h2 = insertvalue " + header_ty + " %h1, i64 %len, 2\n  ret " + header_ty + " %h2\n}\n"
        give back out
    }
    out = out + "  %dst = alloca " + llvm_ty + "\n  %bits = load " + llvm_ty + ", ptr %src\n  store " + llvm_ty + " %bits, ptr %dst\n"
    out = out + v4_codegen_llvm_clone_glue_at(mir_id, type_text, "%dst", "%src", "%k", 0)
    give back out + "  %out = load " + llvm_ty + ", ptr %dst\n  ret " + llvm_ty + " %out\n}\n"
}

task v4_codegen_llvm_list_globals() -> word {
    give back "@freak.list.oom = private unnamed_addr constant [23 x i8] c\"list allocation failed\\00\", align 1\n"
}

-- The helpers link libc's allocator under its C names, so a module with
-- lists may not declare or define those symbols itself.
task v4_codegen_llvm_list_symbol_error(codegen_id: int) -> word {
    pilot reserved = ",@realloc,@free,@llvm.umul.with.overflow.i64,@\"llvm.umul.with.overflow.i64\","
    pilot body = 0
    repeat until body >= v4_codegen_llvm_body_count(codegen_id) {
        pilot symbol = v4_codegen_llvm_body_symbol(codegen_id, body)
        if reserved.contains("," + symbol + ",") or symbol.starts_with("@freak.list.") or symbol.starts_with("@\"freak.list.") { give back "native list runtime symbol conflict: " + symbol }
        body += 1
    }
    pilot decl = 0
    repeat until decl >= v4_codegen_llvm_decl_count(codegen_id) {
        pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl)
        if reserved.contains("," + symbol + ",") or symbol.starts_with("@freak.list.") or symbol.starts_with("@\"freak.list.") { give back "native list runtime symbol conflict: " + symbol }
        decl += 1
    }
    give back ""
}

-- Aggregate loans borrow a named local or a field/element place, with the
-- mode their type states; natively they reach only lent receivers.
task v4_codegen_llvm_native_aggregate_lend_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    if not v4_mir_snapshot_rvalue_refs_are_valid(kind, word_from_int(lhs), word_from_int(rhs), v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), rvalue_id, v4_mir_body_place_count(mir_id, body_id)) { give back "invalid native rvalue references: " + kind }
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot error = v4_codegen_llvm_native_type_error(type_text, false)
    if error != "" { give back error }
    pilot mutable_kind: bool = kind == v4_mir_rvalue_lend_mut
    pilot mutable_type: bool = v4_ty_lend_mode(type_text) == v4_ty_param_mode_lend_mut
    if lhs < 0 or lhs >= rvalue_id or rhs >= 0 or mutable_kind != mutable_type { give back "invalid native aggregate borrow operand" }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_canonical_type(ty_id, v4_mir_rvalue_ty(mir_id, body_id, lhs)) != v4_ty_canonical_type(ty_id, v4_ty_lend_target_type(type_text)) { give back "invalid native aggregate borrow operand" }
    pilot child_kind = v4_mir_rvalue_kind(mir_id, body_id, lhs)
    if child_kind == v4_mir_rvalue_use_local {
        pilot local = v4_mir_rvalue_local_id(mir_id, body_id, lhs)
        if local < 0 or local >= v4_mir_body_local_count(mir_id, body_id) { give back "invalid native local operand" }
        give back ""
    }
    if child_kind != v4_mir_rvalue_use_place { give back "native aggregate borrows need a local, field or element place" }
    pilot place = v4_mir_rvalue_lhs(mir_id, body_id, lhs)
    error = v4_codegen_llvm_native_place_error(mir_id, body_id, place, 0)
    if error != "" { give back error }
    -- A lend mut parameter is noalias, but a callee may also reach a module
    -- global by name, so exclusive loans of globals stay fenced.
    pilot root = place
    pilot steps = 0
    repeat until steps > 64 or root < 0 or (v4_mir_place_kind(mir_id, body_id, root) != v4_mir_place_field and v4_mir_place_kind(mir_id, body_id, root) != v4_mir_place_index) {
        root = v4_mir_place_base(mir_id, body_id, root)
        steps += 1
    }
    if mutable_kind and root >= 0 and v4_mir_place_kind(mir_id, body_id, root) == v4_mir_place_global { give back "native lend mut of a module global is not yet supported: " + v4_mir_place_text(mir_id, body_id, place) }
    give back ""
}

-- Closures (tier 3). A closure expression in an ordinary task has its own
-- MIR body (v4_mir_closure_rvalue_body): an LLVM function whose first
-- parameter is a pointer to its environment, `%"freak.closure.env.<id>"`, a
-- struct with one slot per capture in capture order. A copy or move capture
-- slot holds the captured value; a default (borrow) or mut capture slot holds
-- a pointer to the captured storage. Capture modes are MIR facts: the
-- capture rvalue kinds in the creating body and the capture local modes in
-- the closure body. A closure value is `{ code, env }`. The environment is
-- an entry-block slot of the creating body, so a closure value lives no
-- longer than that frame: it may initialize a local and be called, and every
-- other use (returning, passing, storing, reassigning) is refused by name.
task v4_codegen_llvm_closure_value_type() -> word {
    give back "{" + " ptr, ptr " + "}"
}

task v4_codegen_llvm_closure_env_type(mir_id: int, closure_body: int) -> word {
    pilot name = v4_mir_body_name(mir_id, closure_body)
    pilot prefix = "freak.closure."
    if name.starts_with(prefix) { name = v4_slice(name, prefix.length(), name.length()) }
    pilot symbol = v4_codegen_llvm_symbol("freak.closure.env." + name)
    give back "%" + v4_slice(symbol, 1, symbol.length())
}

task v4_codegen_llvm_closure_env_slot(body_id: int, rvalue_id: int) -> word {
    give back "%closure.env." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

-- The capture mode a closure body local carries for a capture kind.
task v4_codegen_llvm_capture_local_mode(kind: word) -> word {
    if kind == v4_mir_rvalue_capture_borrow { give back v4_ty_param_mode_lend }
    if kind == v4_mir_rvalue_capture_borrow_mut { give back v4_ty_param_mode_lend_mut }
    give back v4_ty_param_mode_value
}

-- Environment records for shape_records: the env type, then each slot.
task v4_codegen_llvm_closure_records(mir_id: int) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot count = v4_mir_body_closure_capture_count(mir_id, body)
        if count >= 0 {
            v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_closure_env_type(mir_id, body))
            pilot capture = 0
            repeat until capture >= count {
                pilot local = v4_mir_body_closure_capture_local(mir_id, body, capture)
                pilot slot_ty = "ptr"
                if v4_mir_local_mode(mir_id, body, local) == v4_ty_param_mode_value { slot_ty = v4_codegen_llvm_type(v4_mir_local_ty(mir_id, body, local)) }
                v4_codegen_llvm_fragment_push(parts, "\t" + slot_ty)
                capture += 1
            }
            v4_codegen_llvm_fragment_push(parts, "\n")
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    pilot out = word_join(parts)
    array_release(parts)
    give back out
}

-- One environment slot per closure expression in the creating body.
task v4_codegen_llvm_closure_env_slots(mir_id: int, body_id: int) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot value = 0
    repeat until value >= v4_mir_body_rvalue_count(mir_id, body_id) {
        pilot closure_body = v4_mir_closure_rvalue_body(mir_id, body_id, value)
        if closure_body >= 0 { v4_codegen_llvm_fragment_push(parts, "  " + v4_codegen_llvm_closure_env_slot(body_id, value) + " = alloca " + v4_codegen_llvm_closure_env_type(mir_id, closure_body) + "\n") }
        value += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- In a closure body, a capture local's storage is its environment slot (a
-- copy or move capture) or the captured storage the slot points to.
task v4_codegen_llvm_closure_capture_slot_lines(mir_id: int, body_id: int, local_id: int) -> word {
    pilot slot = v4_codegen_llvm_local_slot(local_id)
    pilot index = word_from_int(local_id - v4_mir_body_callable_param_count(mir_id, body_id))
    pilot address = "getelementptr inbounds " + v4_codegen_llvm_closure_env_type(mir_id, body_id) + ", ptr %env, i32 0, i32 " + index
    if v4_mir_local_mode(mir_id, body_id, local_id) == v4_ty_param_mode_value { give back "  " + slot + " = " + address + "\n" }
    give back "  " + slot + ".env = " + address + "\n  " + slot + " = load ptr, ptr " + slot + ".env\n"
}

-- Build a closure value: fill its environment from the captured locals in
-- capture order, then pair the code pointer with the environment pointer.
task v4_codegen_llvm_collect_closure_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word) -> bool {
    pilot closure_body = v4_mir_closure_rvalue_body(mir_id, body_id, rvalue_id)
    if closure_body < 0 { give back false }
    pilot env = v4_codegen_llvm_closure_env_slot(body_id, rvalue_id)
    pilot env_ty = v4_codegen_llvm_closure_env_type(mir_id, closure_body)
    pilot prefix = "%closure." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
    pilot capture_id = 0
    repeat until capture_id >= v4_mir_closure_capture_count(mir_id, body_id, rvalue_id) {
        pilot index = word_from_int(capture_id)
        pilot local = v4_mir_closure_capture_local(mir_id, body_id, rvalue_id, capture_id)
        pilot slot = prefix + ".slot." + index
        v4_codegen_llvm_fragment_push(parts, "  " + slot + " = getelementptr inbounds " + env_ty + ", ptr " + env + ", i32 0, i32 " + index + "\n")
        -- A lent parameter's slot is already the caller's place.
        pilot address = v4_codegen_llvm_local_slot(local)
        pilot kind = v4_mir_rvalue_kind(mir_id, body_id, v4_mir_closure_capture(mir_id, body_id, rvalue_id, capture_id))
        if kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut {
            v4_codegen_llvm_fragment_push(parts, "  store ptr " + address + ", ptr " + slot + "\n")
        } else {
            pilot value_ty = v4_codegen_llvm_type(v4_mir_local_ty(mir_id, body_id, local))
            v4_codegen_llvm_fragment_push(parts, "  " + prefix + ".value." + index + " = load " + value_ty + ", ptr " + address + "\n")
            v4_codegen_llvm_fragment_push(parts, "  store " + value_ty + " " + prefix + ".value." + index + ", ptr " + slot + "\n")
        }
        capture_id += 1
    }
    pilot pair = v4_codegen_llvm_closure_value_type()
    pilot symbol = v4_codegen_llvm_callable_symbol(mir_id, v4_mir_body_name(mir_id, closure_body))
    v4_codegen_llvm_fragment_push(parts, "  " + target + ".code = insertvalue " + pair + " undef, ptr " + symbol + ", 0\n")
    v4_codegen_llvm_fragment_push(parts, "  " + target + " = insertvalue " + pair + " " + target + ".code, ptr " + env + ", 1\n")
    give back true
}

-- A call through a closure value takes its code and environment pointers
-- apart; the environment is the first argument.
task v4_codegen_llvm_closure_call_code(body_id: int, rvalue_id: int) -> word {
    give back "%closure.fn." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

task v4_codegen_llvm_closure_call_env(body_id: int, rvalue_id: int) -> word {
    give back "%closure.envp." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
}

task v4_codegen_llvm_closure_call_prelude(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot callee = v4_mir_rvalue_closure_callee(mir_id, body_id, rvalue_id)
    if callee < 0 { give back "" }
    pilot pair = v4_codegen_llvm_closure_value_type()
    pilot value = v4_codegen_llvm_rvalue_value(mir_id, body_id, callee)
    give back v4_codegen_llvm_closure_call_code(body_id, rvalue_id) + " = extractvalue " + pair + " " + value + ", 0\n  " + v4_codegen_llvm_closure_call_env(body_id, rvalue_id) + " = extractvalue " + pair + " " + value + ", 1\n  "
}

-- Closure types: declared parameter types, an inferred return type, and no
-- words in the contract yet (a word parameter or result needs a closure
-- ownership contract for the value that crosses).
task v4_codegen_llvm_native_closure_type_error(type_text: word) -> word {
    if v4_codegen_llvm_active_owned_mir < 0 { give back "native closures need the owned value path" }
    pilot mir_id = v4_codegen_llvm_active_owned_mir
    pilot return_ty = v4_ty_closure_return_type(type_text)
    pilot param = 0
    repeat until param >= v4_ty_closure_param_count(type_text) {
        if v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_closure_param_type(type_text, param)) == v4_ty_unknown { give back "native closure parameters need declared types: " + type_text }
        param += 1
    }
    if return_ty == v4_ty_unknown { give back "native closure return type is not inferred: " + type_text }
    param = 0
    repeat until param < 0 or param > v4_ty_closure_param_count(type_text) {
        pilot part = return_ty
        pilot allow_void: bool = true
        if param < v4_ty_closure_param_count(type_text) {
            part = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_closure_param_type(type_text, param))
            allow_void = false
            if part == v4_ty_unknown { give back "native closure parameters need declared types: " + type_text }
        }
        -- A plain word parameter or result crosses like a task's: the callee
        -- owns a word parameter and its drop plan releases it, and the caller
        -- owns a word result. Word-bearing aggregates are not lifted yet.
        if part != v4_ty_word and (v4_codegen_llvm_task_pointer_contains_word(part, 0) or v4_codegen_llvm_type_owns_words(mir_id, part)) { give back "native closures with word-bearing aggregate parameters or results are not yet supported: " + type_text }
        if v4_ty_is_closure_type(part) { give back "native closures inside other types are not yet supported: " + type_text }
        pilot error = v4_codegen_llvm_native_type_error_depth(part, allow_void, 1)
        if error != "" { give back error }
        param += 1
    }
    give back ""
}

-- A Closure rvalue and its capture children. Codegen checks the sealed facts
-- agree (the closure body's capture locals match the capture kinds) and
-- names what is out of scope.
task v4_codegen_llvm_native_closure_rvalue_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
    if kind != v4_mir_rvalue_closure {
        -- A capture is evaluated only by the closure that lists it.
        pilot owner = rvalue_id + 1
        repeat until owner >= v4_mir_body_rvalue_count(mir_id, body_id) {
            if v4_mir_rvalue_kind(mir_id, body_id, owner) == v4_mir_rvalue_closure {
                pilot child = 0
                repeat until child >= v4_mir_closure_capture_count(mir_id, body_id, owner) {
                    if v4_mir_closure_capture(mir_id, body_id, owner, child) == rvalue_id { give back "" }
                    child += 1
                }
            }
            owner += 1
        }
        give back "invalid native closure capture: " + text
    }
    -- A closure in a generic task needs that task's monomorphized body (the
    -- generics row): its parameter and result types may name the task's
    -- type parameters.
    pilot context = v4_mir_body_context_signature_id(mir_id, body_id)
    if context >= 0 and v4_ty_signature_type_generic_count(v4_mir_ty_id(mir_id), context) > 0 { give back "native generic closures need a monomorphized task body: " + text }
    -- A closure inside a closure body is checked as that body's own rvalue.
    pilot closure_body = v4_mir_closure_rvalue_body(mir_id, body_id, rvalue_id)
    if closure_body < 0 { give back "native closures are lowered only in ordinary tasks, with FREAK parameter types: " + text }
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if type_text != v4_mir_body_signature(mir_id, closure_body) { give back "invalid native closure type: " + text }
    pilot error = v4_codegen_llvm_native_type_error(type_text, false)
    if error != "" { give back error }
    pilot count = v4_mir_closure_capture_count(mir_id, body_id, rvalue_id)
    if count != v4_mir_body_closure_capture_count(mir_id, closure_body) { give back "invalid native closure environment: " + text }
    pilot capture_id = 0
    repeat until capture_id >= count {
        pilot capture = v4_mir_closure_capture(mir_id, body_id, rvalue_id, capture_id)
        pilot name = v4_mir_rvalue_text(mir_id, body_id, capture)
        pilot capture_kind = v4_mir_rvalue_kind(mir_id, body_id, capture)
        pilot capture_ty = v4_mir_rvalue_ty(mir_id, body_id, capture)
        pilot outer = v4_mir_closure_capture_local(mir_id, body_id, rvalue_id, capture_id)
        pilot inner = v4_mir_body_closure_capture_local(mir_id, closure_body, capture_id)
        if outer < 0 or inner < 0 or capture < 0 or capture >= rvalue_id { give back "invalid native closure capture: " + name }
        if v4_mir_local_name(mir_id, closure_body, inner) != name or v4_mir_local_ty(mir_id, closure_body, inner) != capture_ty or v4_mir_local_mode(mir_id, closure_body, inner) != v4_codegen_llvm_capture_local_mode(capture_kind) { give back "invalid native closure environment: " + text }
        pilot owns: bool = v4_codegen_llvm_type_is_word_handle(capture_ty) or v4_codegen_llvm_type_owns_words(mir_id, capture_ty)
        if owns and (capture_kind == v4_mir_rvalue_capture_copy or capture_kind == v4_mir_rvalue_capture_move) { give back "native closure captures that move words are not yet supported: " + name }
        if owns and capture_kind == v4_mir_rvalue_capture_borrow_mut { give back "native mutable closure captures of words are not yet supported: " + name }
        -- A value capture lives in the environment, which has no drop flag:
        -- body entry would reset an owned local's slot. Refuse every owned
        -- carrier (scalar sums included) until environments own values.
        if v4_codegen_llvm_word_local_is_owned(mir_id, closure_body, inner) { give back "native closure captures that move or copy owned values are not yet supported: " + name }
        error = v4_codegen_llvm_native_type_error(capture_ty, false)
        if error != "" { give back error }
        capture_id += 1
    }
    give back ""
}

-- Where a closure value may go while its environment lives in the creating
-- frame: it initializes a local (a Closure or a closure local), and a closure
-- local is called. Returning, passing, storing and reassigning are named.
task v4_codegen_llvm_native_closure_use_error(mir_id: int, body_id: int) -> word {
    pilot count = v4_mir_body_rvalue_count(mir_id, body_id)
    pilot any = false
    pilot value = 0
    repeat until value >= count or any {
        if v4_ty_is_closure_type(v4_mir_rvalue_ty(mir_id, body_id, value)) { any = true }
        value += 1
    }
    if not any { give back "" }
    pilot allowed = v4_codegen_llvm_fragment_new()
    value = 0
    repeat until value >= count {
        v4_codegen_llvm_fragment_push(allowed, "0")
        value += 1
    }
    pilot error = ""
    pilot stmt = 0
    repeat until stmt >= v4_mir_body_stmt_count(mir_id, body_id) or error != "" {
        pilot kind = v4_mir_stmt_kind(mir_id, body_id, stmt)
        pilot place = v4_mir_stmt_place(mir_id, body_id, stmt)
        pilot rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt)
        if place >= 0 and rvalue >= 0 and rvalue < count {
            if kind == v4_mir_stmt_local and v4_mir_place_kind(mir_id, body_id, place) == v4_mir_place_local {
                -- One closure expression has one environment slot and one body.
                pilot seen_mark: word = array_get(allowed, rvalue)
                if seen_mark == "1" and v4_mir_rvalue_kind(mir_id, body_id, rvalue) == v4_mir_rvalue_closure { error = "native closure values cannot be shared between initializers: " + v4_mir_rvalue_text(mir_id, body_id, rvalue) }
                array_set(allowed, rvalue, "1")
            }
            if kind == v4_mir_stmt_assign and v4_ty_is_closure_type(v4_mir_place_ty(mir_id, body_id, place)) { error = "native closure values cannot be reassigned yet: " + v4_mir_place_text(mir_id, body_id, place) }
        }
        stmt += 1
    }
    value = 0
    repeat until value >= count {
        pilot callee = v4_mir_rvalue_closure_callee(mir_id, body_id, value)
        if callee >= 0 and v4_mir_rvalue_kind(mir_id, body_id, callee) == v4_mir_rvalue_use_local { array_set(allowed, callee, "1") }
        if callee >= 0 and v4_mir_rvalue_kind(mir_id, body_id, callee) == v4_mir_rvalue_closure and error == "" { error = "native immediately called closures are not yet supported: " + v4_mir_rvalue_text(mir_id, body_id, callee) }
        value += 1
    }
    value = 0
    repeat until value >= count or error != "" {
        pilot kind = v4_mir_rvalue_kind(mir_id, body_id, value)
        if v4_ty_is_closure_type(v4_mir_rvalue_ty(mir_id, body_id, value)) and kind != v4_mir_rvalue_capture_borrow and kind != v4_mir_rvalue_capture_borrow_mut and kind != v4_mir_rvalue_capture_copy and kind != v4_mir_rvalue_capture_move {
            pilot mark: word = array_get(allowed, value)
            if mark != "1" or (kind != v4_mir_rvalue_closure and kind != v4_mir_rvalue_use_local) { error = "native closure values that leave their creating frame are not yet supported: " + v4_mir_rvalue_text(mir_id, body_id, value) }
        }
        value += 1
    }
    array_release(allowed)
    give back error
}

-- Dyn doctrines (tier 3). A loan of an erased value, `lend dyn D` or
-- `lend mut dyn D`, is a fat pointer `{ ptr data, ptr vtable }`: the address
-- of the concrete place and a constant vtable for its (type, doctrine) pair.
-- The native slice is the lend slice: parameters written `lend w: dyn D` /
-- `lend mut w: dyn D` (their local holds the caller's fat pointer), erasure
-- of a concrete place at a call argument (`lend s`, `lend mut r.inner`),
-- reborrows of such a parameter (`lend w`), and dyn method calls. MIR Build
-- seals each erasure's vtable and each call's slot (v4_mir_dyn_*); codegen
-- never looks up an impl. A vtable is
-- `%"freak.dyn.vtable.D" = { i64 type_id, i64 size, i64 align, ptr drop,
-- ptr clone, ptr slot... }` (bible 1.6): size and align of the concrete type
-- come from freak_target at module assembly, drop runs its drop glue in
-- place, clone is null (nobody), and slot k is the impl body of the
-- doctrine's k-th method in declaration order. A dyn call loads slot k and
-- calls it with the data pointer as the receiver, which is exactly what a
-- `lend self` / `lend mut self` impl body takes (the lend ABI). Owned dyn
-- values (locals, by-value parameters, results, `List<dyn D>`, `Shared<dyn
-- D>`), lend-typed dyn values (`w: lend dyn D`), generic doctrines, by-value
-- self methods and C boundaries are refused by name.
pilot v4_codegen_llvm_dyn_header_slots = 5

task v4_codegen_llvm_dyn_ref_type() -> word {
    give back "{" + " ptr, ptr " + "}"
}

-- `dyn D`, `lend dyn D` or `lend mut dyn D`: all lower to the fat pointer.
task v4_codegen_llvm_is_dyn_ref(type_text: word) -> bool {
    if v4_ty_is_dyn_type(type_text) { give back true }
    give back v4_ty_is_lend_type(type_text) and v4_ty_is_dyn_type(v4_ty_lend_target_type(type_text))
}

task v4_codegen_llvm_dyn_vtable_type(doctrine_name: word) -> word {
    pilot symbol = v4_codegen_llvm_symbol("freak.dyn.vtable." + doctrine_name)
    give back "%" + v4_slice(symbol, 1, symbol.length())
}

task v4_codegen_llvm_dyn_vtable_symbol(mir_id: int, vtable_id: int) -> word {
    give back v4_codegen_llvm_symbol("freak.vtable." + v4_mir_dyn_vtable_concrete(mir_id, vtable_id) + "." + v4_mir_dyn_vtable_doctrine(mir_id, vtable_id))
}

task v4_codegen_llvm_dyn_drop_symbol(concrete: word) -> word {
    give back v4_codegen_llvm_symbol("freak.dyn.drop." + concrete)
}

-- A `lend w: dyn D` / `lend mut w: dyn D` parameter of a FREAK task.
task v4_codegen_llvm_local_is_dyn_param(mir_id: int, body_id: int, local_id: int) -> bool {
    if v4_codegen_llvm_active_owned_mir != mir_id or local_id < 0 or local_id >= v4_mir_body_callable_param_count(mir_id, body_id) { give back false }
    if v4_mir_body_callable_abi(mir_id, body_id) != "" or not v4_ty_is_dyn_type(v4_mir_local_ty(mir_id, body_id, local_id)) { give back false }
    pilot mode = v4_mir_body_callable_param_mode(mir_id, body_id, local_id)
    give back (mode == v4_ty_param_mode_lend or mode == v4_ty_param_mode_lend_mut) and v4_mir_local_mode(mir_id, body_id, local_id) == mode
}

-- The type a FREAK-ABI argument passes as for a parameter of this type and
-- mode: a loan of lendable storage, a lend mut word or a dyn value is the
-- loan itself; everything else is the value.
task v4_codegen_llvm_param_pass_type(mir_id: int, type_text: word, mode: word) -> word {
    if mode != v4_ty_param_mode_lend and mode != v4_ty_param_mode_lend_mut { give back type_text }
    if v4_codegen_llvm_is_lendable_storage(mir_id, type_text) or v4_ty_is_dyn_type(type_text) or (type_text == v4_ty_word and mode == v4_ty_param_mode_lend_mut) { give back v4_ty_lend_type(type_text, mode) }
    give back type_text
}

-- The doctrine signature and method a dyn call dispatches to.
task v4_codegen_llvm_dyn_call_doctrine_sig(mir_id: int, body_id: int, rvalue_id: int) -> int {
    pilot receiver = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
    pilot dyn_ty = v4_mir_rvalue_ty(mir_id, body_id, receiver)
    if v4_ty_is_lend_type(dyn_ty) { dyn_ty = v4_ty_lend_target_type(dyn_ty) }
    give back v4_ty_doctrine_signature_id_for_name(v4_mir_ty_id(mir_id), v4_ty_dyn_doctrine_base_name(dyn_ty))
}

-- Argument types of a dyn call: the receiver loan, then the doctrine
-- method's declared parameters, passed as a direct call would pass them.
task v4_codegen_llvm_dyn_call_param_type(mir_id: int, body_id: int, rvalue_id: int, arg_id: int) -> word {
    if arg_id == 0 { give back v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)) }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig = v4_codegen_llvm_dyn_call_doctrine_sig(mir_id, body_id, rvalue_id)
    pilot method_id = v4_mir_dyn_call_slot(mir_id, body_id, rvalue_id)
    if sig < 0 or arg_id > v4_ty_doctrine_method_explicit_param_count(ty_id, sig, method_id) { give back v4_ty_unknown }
    pilot type_text = v4_ty_canonical_type(ty_id, v4_ty_doctrine_method_explicit_param_type(ty_id, sig, method_id, arg_id - 1))
    give back v4_codegen_llvm_param_pass_type(mir_id, type_text, v4_ty_doctrine_method_param_mode(ty_id, sig, method_id, arg_id))
}

task v4_codegen_llvm_dyn_call_temp(body_id: int, rvalue_id: int, part: word) -> word {
    give back "%dyn." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + "." + part
}

-- Split the receiver's fat pointer and load the slot's code pointer.
task v4_codegen_llvm_dyn_call_prelude(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot slot = v4_mir_dyn_call_slot(mir_id, body_id, rvalue_id)
    pilot pair = v4_codegen_llvm_dyn_ref_type()
    pilot value = v4_codegen_llvm_rvalue_value(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0))
    pilot receiver_ty = v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0))
    pilot vtable_ty = v4_codegen_llvm_dyn_vtable_type(v4_ty_dyn_doctrine_base_name(v4_ty_lend_target_type(receiver_ty)))
    pilot out = v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "data") + " = extractvalue " + pair + " " + value + ", 0\n  "
    out = out + v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "vt") + " = extractvalue " + pair + " " + value + ", 1\n  "
    out = out + v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "slot") + " = getelementptr inbounds " + vtable_ty + ", ptr " + v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "vt") + ", i32 0, i32 " + word_from_int(v4_codegen_llvm_dyn_header_slots + slot) + "\n  "
    give back out + v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "fn") + " = load ptr, ptr " + v4_codegen_llvm_dyn_call_temp(body_id, rvalue_id, "slot") + "\n  "
}

-- The lines of a dyn loan: an erasure pairs the concrete place's address
-- with its sealed vtable; a reborrow (no vtable) is the fat pointer the dyn
-- parameter's slot holds. A leaf, so the place walk stays in the caller.
task v4_codegen_llvm_dyn_lend_value_lines(mir_id: int, body_id: int, rvalue_id: int, target: word, address: word) -> word {
    pilot pair = v4_codegen_llvm_dyn_ref_type()
    pilot vtable = v4_mir_dyn_erase_vtable(mir_id, body_id, rvalue_id)
    if vtable < 0 {
        pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        give back "  " + target + " = load " + pair + ", ptr " + v4_codegen_llvm_local_slot(v4_mir_rvalue_local_id(mir_id, body_id, child)) + "\n"
    }
    pilot out = "  " + target + ".data = insertvalue " + pair + " undef, ptr " + address + ", 0\n"
    give back out + "  " + target + " = insertvalue " + pair + " " + target + ".data, ptr " + v4_codegen_llvm_dyn_vtable_symbol(mir_id, vtable) + ", 1\n"
}

-- Why a dyn doctrine type cannot lower natively, or "".
task v4_codegen_llvm_dyn_doctrine_error(mir_id: int, dyn_ty: word) -> word {
    pilot doctrine_name = v4_ty_dyn_doctrine_base_name(dyn_ty)
    if doctrine_name == "" or v4_ty_doctrine_signature_id_for_name(v4_mir_ty_id(mir_id), doctrine_name) < 0 { give back "native dyn needs a declared doctrine: " + dyn_ty }
    if v4_ty_dyn_doctrine_name(dyn_ty) != doctrine_name { give back "native dyn values of generic doctrines are not yet supported: " + dyn_ty }
    pilot issue = v4_ty_dyn_object_safety_issue(v4_mir_ty_id(mir_id), dyn_ty)
    if issue != "" { give back "native dyn doctrine is not object safe: " + issue }
    give back ""
}

-- A vtable's concrete type and slots: lendable storage that holds no loans,
-- and one lend self / lend mut self impl body per doctrine method whose
-- parameters and result are the doctrine's.
task v4_codegen_llvm_dyn_vtable_error(mir_id: int, vtable_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot concrete = v4_mir_dyn_vtable_concrete(mir_id, vtable_id)
    pilot doctrine_name = v4_mir_dyn_vtable_doctrine(mir_id, vtable_id)
    pilot sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
    if sig < 0 or v4_mir_dyn_vtable_type_id(mir_id, vtable_id) < 0 { give back "invalid native dyn vtable: " + concrete + " as dyn " + doctrine_name }
    if not v4_codegen_llvm_is_lendable_storage(mir_id, concrete) { give back "native dyn erasure supports shapes, routes, tuples, fixed arrays and scalars: " + concrete }
    -- A generic shape or route instance has a native layout, but its vtable
    -- slots would name the generic impl's template, which has no body; the
    -- slots need impl instances first.
    if v4_ty_is_generic_instance_type(concrete) and (v4_mir_shape_signature(mir_id, concrete) >= 0 or v4_codegen_llvm_route_signature(mir_id, concrete) >= 0) { give back "native dyn erasure of generic shape and route instances is not yet supported: " + concrete }
    if v4_ty_type_may_store_lend(ty_id, concrete) { give back "native dyn erasure of values that hold loans is not yet supported: " + concrete }
    pilot error = v4_codegen_llvm_native_type_error(concrete, false)
    if error != "" { give back error }
    pilot count = v4_ty_doctrine_method_count(ty_id, sig)
    if v4_mir_dyn_vtable_slot_count(mir_id, vtable_id) != count { give back "invalid native dyn vtable: " + concrete + " as dyn " + doctrine_name }
    pilot slot = 0
    repeat until slot >= count {
        pilot label = concrete + "::" + v4_ty_doctrine_method_name(ty_id, sig, slot)
        pilot body = v4_mir_dyn_vtable_slot_body(mir_id, vtable_id, slot)
        if body < 0 or body >= v4_mir_body_count(mir_id) { give back "native dyn vtable has no impl body for " + label }
        pilot mode = v4_ty_doctrine_method_param_mode(ty_id, sig, slot, 0)
        if mode != v4_ty_param_mode_lend and mode != v4_ty_param_mode_lend_mut { give back "native dyn vtables cannot hold by-value self methods yet: " + label }
        pilot explicit = v4_ty_doctrine_method_explicit_param_count(ty_id, sig, slot)
        pilot same: bool = v4_mir_body_callable_param_count(mir_id, body) == explicit + 1 and v4_mir_body_callable_param_mode(mir_id, body, 0) == mode and v4_codegen_llvm_local_is_lent_param(mir_id, body, 0)
        same = same and v4_ty_canonical_type(ty_id, v4_mir_body_callable_return_type(mir_id, body)) == v4_ty_canonical_type(ty_id, v4_ty_doctrine_method_return_type(ty_id, sig, slot))
        pilot param = 1
        repeat until param > explicit or not same {
            same = v4_mir_body_callable_param_mode(mir_id, body, param) == v4_ty_doctrine_method_param_mode(ty_id, sig, slot, param) and v4_ty_canonical_type(ty_id, v4_mir_body_callable_param_type(mir_id, body, param)) == v4_ty_canonical_type(ty_id, v4_ty_doctrine_method_explicit_param_type(ty_id, sig, slot, param - 1))
            param += 1
        }
        if not same { give back "native dyn vtable slot does not match its doctrine method: " + label }
        slot += 1
    }
    give back ""
}

-- A Lend/LendMut of dyn type: an erasure with a sealed vtable over a
-- concrete local, field or element place, or a reborrow of a dyn parameter.
-- A local holds a shared loan when it is a lend parameter or when its
-- type is a shared lend, as in pilot q = lend s.
task v4_codegen_llvm_dyn_local_is_shared(mir_id: int, body_id: int, local: int) -> bool {
    if v4_mir_local_mode(mir_id, body_id, local) == v4_ty_param_mode_lend { give back true }
    pilot ty = v4_mir_local_ty(mir_id, body_id, local)
    give back v4_ty_is_lend_type(ty) and v4_ty_lend_mode(ty) == v4_ty_param_mode_lend
}

task v4_codegen_llvm_native_dyn_lend_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot type_text = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot mutable_kind: bool = kind == v4_mir_rvalue_lend_mut
    pilot mutable_type: bool = v4_ty_lend_mode(type_text) == v4_ty_param_mode_lend_mut
    if child < 0 or child >= rvalue_id or v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id) >= 0 or (mutable_kind and not mutable_type) or (mutable_type and not mutable_kind) { give back "invalid native dyn borrow operand" }
    pilot dyn_ty = v4_ty_lend_target_type(type_text)
    pilot error = v4_codegen_llvm_dyn_doctrine_error(mir_id, dyn_ty)
    if error != "" { give back error }
    pilot child_kind = v4_mir_rvalue_kind(mir_id, body_id, child)
    pilot source_ty = v4_mir_rvalue_ty(mir_id, body_id, child)
    pilot vtable = v4_mir_dyn_erase_vtable(mir_id, body_id, rvalue_id)
    if vtable < 0 {
        if child_kind == v4_mir_rvalue_use_local and v4_codegen_llvm_local_is_dyn_param(mir_id, body_id, v4_mir_rvalue_local_id(mir_id, body_id, child)) {
            pilot local = v4_mir_rvalue_local_id(mir_id, body_id, child)
            if v4_mir_local_ty(mir_id, body_id, local) != dyn_ty { give back "native dyn reborrows keep their doctrine: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
            if mutable_kind and v4_mir_local_mode(mir_id, body_id, local) != v4_ty_param_mode_lend_mut { give back "invalid native dyn reborrow: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
            give back ""
        }
        if v4_codegen_llvm_is_dyn_ref(source_ty) { give back "native dyn loans are passed as parameters written lend w: dyn D; other dyn values are not yet supported: " + source_ty }
        give back "native dyn erasure has no sealed vtable: " + source_ty + " to " + type_text
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_mir_dyn_vtable_doctrine(mir_id, vtable) != v4_ty_dyn_doctrine_base_name(dyn_ty) or v4_ty_canonical_type(ty_id, source_ty) != v4_mir_dyn_vtable_concrete(mir_id, vtable) { give back "invalid native dyn vtable: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
    error = v4_codegen_llvm_dyn_vtable_error(mir_id, vtable)
    if error != "" { give back error }
    if child_kind == v4_mir_rvalue_use_local {
        pilot local = v4_mir_rvalue_local_id(mir_id, body_id, child)
        if local < 0 or local >= v4_mir_body_local_count(mir_id, body_id) or v4_mir_local_ty(mir_id, body_id, local) != source_ty { give back "invalid native local operand" }
        if v4_mir_local_mode(mir_id, body_id, local) != v4_ty_param_mode_value and not v4_codegen_llvm_local_is_lent_param(mir_id, body_id, local) { give back "native dyn erasure needs a local, field or element place: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
        -- A lend mut erasure must not write through a shared loan.
        if mutable_kind and v4_codegen_llvm_dyn_local_is_shared(mir_id, body_id, local) { give back "native dyn erasure cannot lend mut through a shared lend: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
        give back ""
    }
    if child_kind != v4_mir_rvalue_use_place { give back "native dyn erasure needs a local, field or element place: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
    pilot place = v4_mir_rvalue_lhs(mir_id, body_id, child)
    error = v4_codegen_llvm_native_place_error(mir_id, body_id, place, 0)
    if error != "" { give back error }
    pilot root = place
    pilot steps = 0
    repeat until steps > 64 or root < 0 or (v4_mir_place_kind(mir_id, body_id, root) != v4_mir_place_field and v4_mir_place_kind(mir_id, body_id, root) != v4_mir_place_index) {
        root = v4_mir_place_base(mir_id, body_id, root)
        steps += 1
    }
    if root >= 0 and v4_mir_place_kind(mir_id, body_id, root) == v4_mir_place_global { give back "native dyn erasure of a module global is not yet supported: " + v4_mir_place_text(mir_id, body_id, place) }
    if root < 0 or v4_mir_place_kind(mir_id, body_id, root) != v4_mir_place_local { give back "native dyn erasure needs a local, field or element place: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
    pilot root_local = v4_mir_place_base(mir_id, body_id, root)
    if mutable_kind and root_local >= 0 and root_local < v4_mir_body_local_count(mir_id, body_id) and v4_codegen_llvm_dyn_local_is_shared(mir_id, body_id, root_local) { give back "native dyn erasure cannot lend mut through a shared lend: " + v4_mir_rvalue_text(mir_id, body_id, rvalue_id) }
    give back ""
}

-- A dyn method call: a lend or lend mut receiver of the doctrine's dyn type
-- in the mode the doctrine method declares, and a slot the doctrine has.
task v4_codegen_llvm_native_dyn_call_error(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
    pilot receiver = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
    if receiver < 0 or receiver != v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id) or v4_mir_rvalue_abi(mir_id, body_id, rvalue_id) != "" { give back "invalid native dyn call: " + text }
    pilot receiver_ty = v4_mir_rvalue_ty(mir_id, body_id, receiver)
    pilot receiver_kind = v4_mir_rvalue_kind(mir_id, body_id, receiver)
    if receiver_kind != v4_mir_rvalue_lend and receiver_kind != v4_mir_rvalue_lend_mut { give back "native dyn calls need a lend w: dyn D or lend mut w: dyn D receiver: " + text }
    if not v4_ty_is_lend_type(receiver_ty) or not v4_ty_is_dyn_type(v4_ty_lend_target_type(receiver_ty)) { give back "invalid native dyn call: " + text }
    pilot error = v4_codegen_llvm_dyn_doctrine_error(mir_id, v4_ty_lend_target_type(receiver_ty))
    if error != "" { give back error }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig = v4_codegen_llvm_dyn_call_doctrine_sig(mir_id, body_id, rvalue_id)
    pilot slot = v4_mir_dyn_call_slot(mir_id, body_id, rvalue_id)
    if sig < 0 or slot >= v4_ty_doctrine_method_count(ty_id, sig) { give back "invalid native dyn call: " + text }
    pilot mode = v4_ty_doctrine_method_param_mode(ty_id, sig, slot, 0)
    if mode != v4_ty_param_mode_lend and mode != v4_ty_param_mode_lend_mut { give back "native dyn vtables cannot hold by-value self methods yet: " + text }
    if v4_ty_lend_mode(receiver_ty) != mode { give back "invalid native dyn call receiver: " + text }
    if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) != v4_ty_doctrine_method_explicit_param_count(ty_id, sig, slot) + 1 { give back "invalid native dyn call arity: " + text }
    if v4_ty_canonical_type(ty_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) != v4_ty_canonical_type(ty_id, v4_ty_doctrine_method_return_type(ty_id, sig, slot)) { give back "invalid native dyn call result: " + text }
    give back ""
}

-- Where dyn may appear natively. Runs before the general checks, which then
-- accept the fat pointer type at the positions admitted here.
task v4_codegen_llvm_native_dyn_error(mir_id: int) -> word {
    if v4_codegen_llvm_active_owned_mir != mir_id { give back "" }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = 0
    repeat until sig_id >= v4_ty_signature_count(ty_id) {
        if v4_codegen_llvm_signature_is_callable(ty_id, sig_id) {
            pilot c_boundary: bool = v4_ty_signature_kind(ty_id, sig_id) != v4_ty_task_sig or v4_ty_signature_call_abi(ty_id, sig_id) != "" or v4_ty_signature_has_extern_callback(ty_id, sig_id)
            pilot return_ty = v4_ty_signature_return_type(ty_id, sig_id)
            if return_ty.contains("dyn ") { give back "native dyn results are not yet supported: " + return_ty }
            pilot param_id = 0
            repeat until param_id >= v4_ty_signature_fixed_param_count(ty_id, sig_id) {
                pilot param_ty = v4_ty_signature_param_type(ty_id, sig_id, param_id)
                if c_boundary and param_ty.contains("dyn ") { give back "native dyn values across the C ABI are not yet supported: " + param_ty }
                param_id += 1
            }
        }
        sig_id += 1
    }
    -- Only emitted bodies: a generic template lends its type parameter, which
    -- has no vtable; each instance is checked with its concrete type.
    pilot body_id = v4_codegen_llvm_next_emitted_body(mir_id, 0)
    repeat until body_id >= v4_mir_body_count(mir_id) {
        pilot return_ty = v4_mir_body_callable_return_type(mir_id, body_id)
        if return_ty.contains("dyn ") { give back "native dyn results are not yet supported: " + return_ty }
        pilot local_id = 0
        repeat until local_id >= v4_mir_body_local_count(mir_id, body_id) {
            pilot local_ty = v4_mir_local_ty(mir_id, body_id, local_id)
            if local_ty.contains("dyn ") {
                if v4_codegen_llvm_local_is_dyn_param(mir_id, body_id, local_id) {
                    pilot error = v4_codegen_llvm_dyn_doctrine_error(mir_id, local_ty)
                    if error != "" { give back error }
                } else if v4_ty_is_lend_type(local_ty) and v4_ty_is_dyn_type(v4_ty_lend_target_type(local_ty)) {
                    give back "native dyn loans are passed as parameters written lend w: dyn D; lend-typed dyn locals and parameters are not yet supported: " + v4_mir_local_name(mir_id, body_id, local_id)
                } else {
                    give back "native owned dyn values are not yet supported: " + local_ty
                }
            }
            local_id += 1
        }
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body_id) {
            pilot kind = v4_mir_rvalue_kind(mir_id, body_id, value)
            pilot value_ty = v4_mir_rvalue_ty(mir_id, body_id, value)
            if kind == v4_mir_rvalue_call and v4_mir_dyn_call_slot(mir_id, body_id, value) >= 0 {
                pilot error = v4_codegen_llvm_native_dyn_call_error(mir_id, body_id, value)
                if error != "" { give back error }
            }
            if value_ty.contains("dyn ") {
                if (kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut) and v4_ty_is_lend_type(value_ty) and v4_ty_is_dyn_type(v4_ty_lend_target_type(value_ty)) {
                    pilot error = v4_codegen_llvm_native_dyn_lend_error(mir_id, body_id, value)
                    if error != "" { give back error }
                } else if kind == v4_mir_rvalue_use_local and v4_codegen_llvm_local_is_dyn_param(mir_id, body_id, v4_mir_rvalue_local_id(mir_id, body_id, value)) {
                    -- A dyn parameter is only ever reborrowed; it never moves.
                    pilot owner = value + 1
                    pilot lent: bool = false
                    repeat until owner >= v4_mir_body_rvalue_count(mir_id, body_id) or lent {
                        pilot owner_kind = v4_mir_rvalue_kind(mir_id, body_id, owner)
                        if (owner_kind == v4_mir_rvalue_lend or owner_kind == v4_mir_rvalue_lend_mut) and v4_mir_rvalue_lhs(mir_id, body_id, owner) == value { lent = true }
                        owner += 1
                    }
                    if not lent { give back "native dyn parameters can only be lent onward, not moved: " + v4_mir_rvalue_text(mir_id, body_id, value) }
                } else if kind == v4_mir_rvalue_call {
                    give back "native dyn results are not yet supported: " + value_ty
                } else {
                    give back "native owned dyn values are not yet supported: " + value_ty
                }
            }
            value += 1
        }
        pilot stmt_id = 0
        repeat until stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) {
            pilot place = v4_mir_stmt_place(mir_id, body_id, stmt_id)
            pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
            if place >= 0 and (stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign) and v4_mir_place_ty(mir_id, body_id, place).contains("dyn ") { give back "native dyn values cannot be stored yet: " + v4_mir_place_text(mir_id, body_id, place) }
            stmt_id += 1
        }
        body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id + 1)
    }
    give back ""
}

-- Vtable struct records for shape_records: one per doctrine that a sealed
-- vtable or a sealed dyn call uses, so a module that only dispatches (its
-- callers erase elsewhere) still defines the type its slot loads index.
task v4_codegen_llvm_dyn_records(mir_id: int) -> word {
    pilot count = v4_mir_dyn_doctrine_count(mir_id)
    if count <= 0 { give back "" }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot index = 0
    repeat until index >= count {
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_dyn_vtable_type(v4_mir_dyn_doctrine_name(mir_id, index)) + "\ti64\ti64\ti64\tptr\tptr")
        pilot slot = 0
        repeat until slot >= v4_mir_dyn_doctrine_slot_count(mir_id, index) {
            v4_codegen_llvm_fragment_push(parts, "\tptr")
            slot += 1
        }
        v4_codegen_llvm_fragment_push(parts, "\n")
        index += 1
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- Vtable constants and drop functions, target neutral: `$freak.dyn.layout
-- T$` and `$freak.dyn.note T$` become the freak_target size and alignment
-- of T at module assembly (v4_codegen_llvm_dyn_resolve).
-- Whether an emitted body erases through this vtable. MIR seals vtables in
-- every body, generic templates included; a vtable only a template erases
-- through may name template slots, which are never emitted.
task v4_codegen_llvm_dyn_vtable_is_used(mir_id: int, vtable: int) -> bool {
    pilot body = v4_codegen_llvm_next_emitted_body(mir_id, 0)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_mir_dyn_erase_vtable(mir_id, body, value) == vtable { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back false
}

task v4_codegen_llvm_dyn_module_lines(mir_id: int, runtime: word) -> word {
    pilot count = v4_mir_dyn_vtable_count(mir_id)
    if count <= 0 { give back "" }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot needs_word_drop: bool = false
    pilot used = ""
    pilot vtable = 0
    repeat until vtable >= count {
        if v4_codegen_llvm_dyn_vtable_is_used(mir_id, vtable) { used = used + "1" } else { used = used + "0" }
        vtable += 1
    }
    vtable = 0
    repeat until vtable >= count {
        if used.char_at(vtable) == "1" {
            pilot concrete = v4_mir_dyn_vtable_concrete(mir_id, vtable)
            pilot llvm_ty = v4_codegen_llvm_type(concrete)
            pilot drop_symbol = v4_codegen_llvm_dyn_drop_symbol(concrete)
            -- One drop entry per concrete type: its first emitted vtable defines it.
            pilot first = 0
            repeat until first >= vtable or (used.char_at(first) == "1" and v4_mir_dyn_vtable_concrete(mir_id, first) == concrete) { first += 1 }
            if first == vtable {
                pilot glue = v4_codegen_llvm_drop_glue_at(mir_id, concrete, "%self", "", "%drop", 0)
                if glue != "" { needs_word_drop = true }
                v4_codegen_llvm_fragment_push(parts, "define internal void " + drop_symbol + "(ptr %self) " + "{" + "\nentry:\n" + glue + "  ret void\n" + "}" + "\n")
            }
            pilot symbol = v4_codegen_llvm_dyn_vtable_symbol(mir_id, vtable)
            v4_codegen_llvm_fragment_push(parts, "; freak.vtable " + symbol + " type=" + llvm_ty + " $freak.dyn.note " + llvm_ty + "$ type_id=" + word_from_int(v4_mir_dyn_vtable_type_id(mir_id, vtable)) + "\n")
            v4_codegen_llvm_fragment_push(parts, symbol + " = internal constant " + v4_codegen_llvm_dyn_vtable_type(v4_mir_dyn_vtable_doctrine(mir_id, vtable)) + " {" + " i64 " + word_from_int(v4_mir_dyn_vtable_type_id(mir_id, vtable)) + ", $freak.dyn.layout " + llvm_ty + "$, ptr " + drop_symbol + ", ptr null")
            pilot slot = 0
            repeat until slot >= v4_mir_dyn_vtable_slot_count(mir_id, vtable) {
                v4_codegen_llvm_fragment_push(parts, ", ptr " + v4_codegen_llvm_callable_symbol(mir_id, v4_mir_body_name(mir_id, v4_mir_dyn_vtable_slot_body(mir_id, vtable, slot))))
                slot += 1
            }
            v4_codegen_llvm_fragment_push(parts, " " + "}" + "\n")
        }
        vtable += 1
    }
    pilot out = v4_codegen_llvm_fragment_finish(parts)
    if needs_word_drop and not runtime.contains("@freak_v4_word_drop(") { give back "declare void @freak_v4_word_drop(i64)\n" + out }
    give back out
}

-- module_text: resolve the dyn layout markers against freak_target.
task v4_codegen_llvm_dyn_resolve(text: word, records: word, target_spec: word) -> word {
    pilot marker = "$freak.dyn."
    if not text.contains(marker) { give back text }
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot emitted = 0
    pilot start = v4_index_of_from(text, "$", 0)
    repeat until start < 0 {
        pilot space = v4_index_of_from(text, " ", start)
        pilot stop = v4_index_of_from(text, "$", start + 1)
        if v4_slice(text, start, start + marker.length()) == marker and space >= 0 and stop > space {
            v4_codegen_llvm_fragment_push(parts, v4_slice(text, emitted, start))
            pilot kind = v4_slice(text, start + marker.length(), space)
            pilot layout = v4_codegen_llvm_llvm_type_layout(records, v4_slice(text, space + 1, stop), target_spec, 0)
            pilot size = word_from_int(v4_target_layout_size(layout))
            pilot align = word_from_int(v4_target_layout_align(layout))
            if kind == "layout" { v4_codegen_llvm_fragment_push(parts, "i64 " + size + ", i64 " + align) } else { v4_codegen_llvm_fragment_push(parts, "size=" + size + " align=" + align) }
            emitted = stop + 1
            start = v4_index_of_from(text, "$", emitted)
        } else {
            start = v4_index_of_from(text, "$", start + 1)
        }
    }
    v4_codegen_llvm_fragment_push(parts, v4_slice(text, emitted, text.length()))
    give back v4_codegen_llvm_fragment_finish(parts)
}

-- Place reads, aggregate literals and Sum checks/takes. One call site keeps
-- these out of the recursive collector's frame: every extra call there costs
-- stack per expression level (Windows' 1 MB stack runs the depth contract).
task v4_codegen_llvm_collect_owned_special_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word, kind: word) -> bool {
    if kind == v4_mir_rvalue_use_place {
        pilot place = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        pilot address = v4_codegen_llvm_place_address(parts, mir_id, body_id, place, "r" + word_from_int(rvalue_id))
        v4_codegen_llvm_fragment_push(parts, "  " + target + " = load " + v4_codegen_llvm_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) + ", ptr " + address + "\n")
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_place_move_lines(mir_id, body_id, rvalue_id, address))
        give back true
    }
    if (kind == v4_mir_rvalue_use_symbol or kind == v4_mir_rvalue_binary) and v4_codegen_llvm_collect_route_lines(parts, mir_id, body_id, rvalue_id, target, kind) { give back true }
    if v4_codegen_llvm_is_literal_aggregate(kind) {
        if not v4_codegen_llvm_aggregate_literal_is_zero(mir_id, body_id, rvalue_id) { v4_codegen_llvm_collect_construct_lines(parts, mir_id, body_id, rvalue_id, target) }
        give back true
    }
    if kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try { give back v4_codegen_llvm_collect_owned_sum_rvalue_lines(parts, mir_id, body_id, rvalue_id, target, kind) }
    if kind == v4_mir_rvalue_or_else and v4_codegen_llvm_or_else_is_supported(mir_id, body_id, rvalue_id) {
        v4_codegen_llvm_collect_or_else_lines(parts, mir_id, body_id, rvalue_id, target)
        give back true
    }
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut { give back v4_codegen_llvm_collect_aggregate_lend_lines(parts, mir_id, body_id, rvalue_id, target) }
    if kind == v4_mir_rvalue_closure { give back v4_codegen_llvm_collect_closure_lines(parts, mir_id, body_id, rvalue_id, target) }
    give back v4_codegen_llvm_collect_list_lines(parts, mir_id, body_id, rvalue_id, target, kind)
}

task v4_codegen_llvm_collect_owned_rvalue_lines(parts: int, mir_id: int, body_id: int, rvalue_id: int, target: word, borrowed: bool) -> void {
    if rvalue_id < 0 { give back }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if v4_codegen_llvm_collect_owned_special_lines(parts, mir_id, body_id, rvalue_id, target, kind) { give back }
    if kind == v4_mir_rvalue_lend {
        pilot child = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, child, v4_codegen_llvm_temp_value(body_id, child), true)
        give back
    }
    if kind == v4_mir_rvalue_call and v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_call_say_literal {
        v4_codegen_llvm_fragment_push(parts, "  " + v4_codegen_llvm_call_instruction(mir_id, body_id, rvalue_id, target) + "\n")
        give back
    }
    if kind == v4_mir_rvalue_call {
        pilot target_rvalue = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, rvalue_id)
        if target_rvalue >= 0 { v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, target_rvalue, v4_codegen_llvm_temp_value(body_id, target_rvalue), false) }
        pilot arg_id = 0
        pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
        repeat until arg_id >= arg_count {
            pilot arg = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
            if arg != target_rvalue { v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, arg, v4_codegen_llvm_temp_value(body_id, arg), false) }
            arg_id += 1
        }
        if arg_count == 0 and target_rvalue < 0 {
            pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
            pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
            v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, lhs, v4_codegen_llvm_temp_value(body_id, lhs), false)
            v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, rhs, v4_codegen_llvm_temp_value(body_id, rhs), false)
        }
        arg_id = 0
        repeat until arg_id >= arg_count {
            pilot line = v4_codegen_llvm_variadic_arg_prelude_line(mir_id, body_id, rvalue_id, arg_id)
            if line != "" { v4_codegen_llvm_fragment_push(parts, line) }
            arg_id += 1
        }
        pilot word_kind = v4_mir_word_intrinsic_kind(mir_id, body_id, rvalue_id)
        if word_kind != "" {
            arg_id = 0
            repeat until arg_id >= arg_count {
                pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
                pilot expected = v4_ty_word_intrinsic_param_type(word_kind, arg_id)
                v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, child, expected, v4_codegen_llvm_word_arg_temp(body_id, rvalue_id, arg_id)))
                arg_id += 1
            }
        }
        if word_kind == "from_bool" {
            pilot arg = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
            v4_codegen_llvm_fragment_push(parts, "  %word.bool." + word_from_int(body_id) + "." + word_from_int(rvalue_id) + " = zext i1 " + v4_codegen_llvm_rvalue_value(mir_id, body_id, arg) + " to i64\n")
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_call_raw_ptr_write {
            pilot pointer = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
            pilot value = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 1)
            pilot expected = v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, pointer))
            v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_expected_lines(mir_id, body_id, value, expected, "%write." + word_from_int(body_id) + "." + word_from_int(rvalue_id)))
        }
    } else {
        pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, lhs, v4_codegen_llvm_temp_value(body_id, lhs), false)
        v4_codegen_llvm_collect_owned_rvalue_lines(parts, mir_id, body_id, rhs, v4_codegen_llvm_temp_value(body_id, rhs), false)
    }
    if kind == v4_mir_rvalue_binary { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_binary_cast_lines(mir_id, body_id, rvalue_id)) }
    if v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, rvalue_id) {
        pilot line = v4_codegen_llvm_rvalue_instruction(mir_id, body_id, rvalue_id, target)
        if line != "" { v4_codegen_llvm_fragment_push(parts, "  " + line + "\n") }
    }
    if kind == v4_mir_rvalue_use_local { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_move_clear_line(mir_id, body_id, rvalue_id)) }
    if kind == v4_mir_rvalue_call and v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) != v4_ty_never {
        -- A borrowed result temporary belongs to this full expression, not to
        -- the observer. Release it immediately after its last observer call.
        pilot arg_id = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) - 1
        repeat until arg_id < 0 {
            pilot arg = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
            if v4_mir_rvalue_kind(mir_id, body_id, arg) == v4_mir_rvalue_lend {
                pilot child = v4_mir_rvalue_lhs(mir_id, body_id, arg)
                if v4_mir_rvalue_ty(mir_id, body_id, child) == v4_ty_word and v4_codegen_llvm_lend_word_temporary_is_fresh(mir_id, body_id, child) {
                    v4_codegen_llvm_fragment_push(parts, "  call void @freak_v4_word_drop(i64 " + v4_codegen_llvm_rvalue_value(mir_id, body_id, child) + ")\n")
                }
            }
            arg_id -= 1
        }
    }
}

-- Native drops follow Meiya's sealed Runtime drop plan (v4_mir_drop_*):
-- codegen emits each site's rows in order and owns only the drop glue of a
-- type (which word leaves a value holds), never where or whether to drop.
task v4_codegen_llvm_flag_store_line(mir_id: int, body_id: int, local: int, state: word) -> word {
    if not v4_mir_drop_local_flag(mir_id, body_id, local) { give back "" }
    give back "  store i1 " + state + ", ptr " + v4_codegen_llvm_word_flag_slot(local) + "\n"
}

-- A whole move out of a flagged local clears its flag.
task v4_codegen_llvm_move_clear_line(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if v4_codegen_llvm_active_owned_mir != mir_id or v4_mir_drop_rvalue_is_partial(mir_id, body_id, rvalue_id) { give back "" }
    pilot local = v4_mir_drop_rvalue_moved_local(mir_id, body_id, rvalue_id)
    if local < 0 { give back "" }
    give back v4_codegen_llvm_flag_store_line(mir_id, body_id, local, "false")
}

-- After a place read: a whole move clears the flag; a partial move nulls
-- each word leaf it took, so the aggregate's own drop skips them.
task v4_codegen_llvm_place_move_lines(mir_id: int, body_id: int, rvalue_id: int, address: word) -> word {
    if v4_codegen_llvm_active_owned_mir != mir_id { give back "" }
    if not v4_mir_drop_rvalue_is_partial(mir_id, body_id, rvalue_id) { give back v4_codegen_llvm_move_clear_line(mir_id, body_id, rvalue_id) }
    give back v4_codegen_llvm_null_words_at(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id), address, address + ".moved", 0)
}

-- A DropSlot row at a store: release the target's old value in place. A
-- leaf a partial move took is null there, so each leaf is released once.
task v4_codegen_llvm_slot_replace_lines(mir_id: int, body_id: int, stmt_id: int, type_text: word, address: word) -> word {
    if v4_codegen_llvm_active_owned_mir != mir_id or not v4_mir_drop_site_has_mode(mir_id, body_id, v4_mir_drop_site_replace, stmt_id, v4_mir_drop_mode_slot) { give back "" }
    give back v4_codegen_llvm_drop_glue_at(mir_id, type_text, address, "", "%slot.old." + word_from_int(body_id) + "." + word_from_int(stmt_id), 0)
}

-- One Drop or DropIf row: release the local's value (under its flag for
-- DropIf), then mark it dead when it carries a flag.
task v4_codegen_llvm_word_drop_local_lines(mir_id: int, body_id: int, local: int, site: word, mode: word) -> word {
    if not v4_codegen_llvm_word_local_is_owned(mir_id, body_id, local) { give back "" }
    pilot clear = v4_codegen_llvm_flag_store_line(mir_id, body_id, local, "false")
    pilot carrier = v4_mir_scalar_sum_kind(mir_id, v4_mir_local_ty(mir_id, body_id, local))
    pilot field = "1"
    if carrier != "" and carrier != "ResultWordWord" { field = v4_codegen_llvm_sum_word_field(mir_id, v4_mir_local_ty(mir_id, body_id, local)) }
    if carrier == "MaybeInt" or field == "" { give back clear }
    pilot conditional: bool = mode == v4_mir_drop_mode_drop_if
    pilot temp = "%word.drop." + site + "." + word_from_int(local)
    pilot out = ""
    if conditional { out = "  " + temp + ".live = load i1, ptr " + v4_codegen_llvm_word_flag_slot(local) + "\n" }
    pilot local_ty = v4_mir_local_ty(mir_id, body_id, local)
    if carrier == "" and v4_codegen_llvm_type_owns_words(mir_id, local_ty) and v4_ty_canonical_type(v4_mir_ty_id(mir_id), local_ty) != v4_ty_word {
        -- In place: each word leaf (null where a partial move took it), under
        -- the flag for DropIf; a route releases its tagged case's leaves.
        pilot cond = ""
        if conditional { cond = temp + ".live" }
        give back out + v4_codegen_llvm_drop_glue_at(mir_id, local_ty, v4_codegen_llvm_local_slot(local), cond, temp, 0) + clear
    }
    -- A carrier owns at most one word field (the closed result shares field 1).
    if carrier != "" {
        pilot carrier_ty = v4_codegen_llvm_type(local_ty)
        out = out + "  " + temp + ".carrier = load " + carrier_ty + ", ptr " + v4_codegen_llvm_local_slot(local) + "\n"
        out = out + "  " + temp + ".value = extractvalue " + carrier_ty + " " + temp + ".carrier, " + field + "\n"
    } else { out = out + "  " + temp + ".value = load i64, ptr " + v4_codegen_llvm_local_slot(local) + "\n" }
    pilot owned = temp + ".value"
    if conditional {
        owned = temp + ".owned"
        out = out + "  " + owned + " = select i1 " + temp + ".live, i64 " + temp + ".value, i64 0\n"
    }
    out = out + "  call void @freak_v4_word_drop(i64 " + owned + ")\n"
    give back out + clear
}

-- Every Drop and DropIf row of one plan site, in the plan's order (reverse
-- declaration order). DropSlot rows belong to the store that owns the site.
task v4_codegen_llvm_drop_site_lines(mir_id: int, body_id: int, site: int, index: int, label: word) -> word {
    pilot parts = v4_codegen_llvm_cleanup_fragment_new()
    if parts < 0 { give back "" }
    pilot row = v4_mir_drop_site_first(mir_id, body_id, site, index)
    repeat until row < 0 {
        pilot mode = v4_mir_drop_row_mode(row)
        if mode != v4_mir_drop_mode_slot { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_word_drop_local_lines(mir_id, body_id, v4_mir_drop_row_local(row), label, mode)) }
        row = v4_mir_drop_row_next(row)
    }
    pilot out = word_join(parts)
    array_release(parts)
    give back out
}

-- The plan must cover exactly the locals whose type has drop glue, every
-- move out of a word-owning aggregate place, and every store into a
-- word-owning slot; anything else stays refused by name.
task v4_codegen_llvm_drop_plan_error(mir_id: int) -> word {
    if not v4_mir_drop_plan_ready(mir_id) { give back "native drop plan is not sealed for this MIR" }
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot local = 0
        repeat until local >= v4_mir_body_local_count(mir_id, body) {
            if v4_codegen_llvm_word_local_is_owned(mir_id, body, local) != v4_mir_drop_local_owned(mir_id, body, local) { give back "native drop plan does not cover owned local: " + v4_mir_local_name(mir_id, body, local) }
            local += 1
        }
        pilot count = v4_mir_body_rvalue_count(mir_id, body)
        pilot lent = v4_codegen_llvm_fragment_new()
        pilot value = 0
        repeat until value >= count { v4_codegen_llvm_fragment_push(lent, "0"); value += 1 }
        value = 0
        repeat until value >= count {
            pilot kind = v4_mir_rvalue_kind(mir_id, body, value)
            pilot lhs = v4_mir_rvalue_lhs(mir_id, body, value)
            if (kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut or kind == v4_mir_rvalue_binary) and lhs >= 0 and lhs < count { array_set(lent, lhs, "1") }
            -- Binary operands are reads for Meiya (route tag tests among them).
            pilot rhs = v4_mir_rvalue_rhs(mir_id, body, value)
            if kind == v4_mir_rvalue_binary and rhs >= 0 and rhs < count { array_set(lent, rhs, "1") }
            value += 1
        }
        pilot error = ""
        value = 0
        repeat until value >= count or error != "" {
            if v4_mir_rvalue_kind(mir_id, body, value) == v4_mir_rvalue_use_place and v4_codegen_llvm_word_leaf_count(mir_id, v4_mir_rvalue_ty(mir_id, body, value), 0) > 0 {
                pilot place_kind = v4_mir_place_kind(mir_id, body, v4_mir_rvalue_lhs(mir_id, body, value))
                pilot borrowed: word = array_get(lent, value)
                if (place_kind == v4_mir_place_field or place_kind == v4_mir_place_index) and borrowed != "1" and not v4_mir_drop_rvalue_is_partial(mir_id, body, value) { error = "native partial moves out of aggregates that own words are not yet supported: " + v4_mir_rvalue_text(mir_id, body, value) }
            }
            value += 1
        }
        array_release(lent)
        if error != "" { give back error }
        pilot stmt = 0
        repeat until stmt >= v4_mir_body_stmt_count(mir_id, body) {
            pilot kind = v4_mir_stmt_kind(mir_id, body, stmt)
            pilot place = v4_mir_stmt_place(mir_id, body, stmt)
            pilot root = v4_mir_stmt_rvalue(mir_id, body, stmt)
            -- A discarded route that owns words is released from its call's result slot.
            if kind == v4_mir_stmt_expr and root >= 0 and v4_codegen_llvm_word_rvalue_is_owned(mir_id, body, root) and v4_codegen_llvm_type_has_route_words(mir_id, v4_mir_rvalue_ty(mir_id, body, root), 0) and not (v4_codegen_llvm_call_is_freak_abi(mir_id, body, root) and v4_codegen_llvm_call_returns_aggregate(mir_id, body, root)) { give back "native discarded route values that own words are not yet supported: " + v4_mir_rvalue_text(mir_id, body, root) }
            if (kind == v4_mir_stmt_assign or kind == v4_mir_stmt_local) and place >= 0 and v4_codegen_llvm_type_owns_words(mir_id, v4_mir_place_ty(mir_id, body, place)) {
                pilot place_kind = v4_mir_place_kind(mir_id, body, place)
                -- A lent word parameter itself is replaced with a drop of the old word.
                pilot through_receiver: bool = place_kind == v4_mir_place_local and v4_codegen_llvm_local_is_lent_param(mir_id, body, v4_mir_place_base(mir_id, body, place)) and v4_mir_place_ty(mir_id, body, place) != v4_ty_word
                if (place_kind == v4_mir_place_field or place_kind == v4_mir_place_index or through_receiver) and not v4_mir_drop_site_has_mode(mir_id, body, v4_mir_drop_site_replace, stmt, v4_mir_drop_mode_slot) { give back "native stores into aggregate slots that own words are not yet supported: " + v4_mir_place_text(mir_id, body, place) }
            }
            stmt += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back ""
}

task v4_codegen_llvm_word_borrow_plan_error(borrow_id: int, mir_id: int) -> word {
    if v4_borrowck_mir_id(borrow_id) != mir_id { give back "native word ownership plan does not match MIR" }
    pilot diag = 0
    repeat until diag >= v4_borrowck_diag_count(borrow_id) {
        if v4_diag_severity(v4_borrowck_diag(borrow_id, diag)) >= v4_diag_error { give back "Meiya errors prevent native word ownership lowering" }
        diag += 1
    }
    pilot results = v4_borrowck_result_def_index_new(borrow_id)
    pilot error = ""
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) or error != "" {
        pilot borrow_result = v4_borrowck_result_def_index_find(results, borrow_id, v4_mir_body_def(mir_id, body))
        if borrow_result < 0 or v4_borrowck_result_status(borrow_id, borrow_result) != "clean" { error = "missing clean Meiya result for native word ownership lowering" } else {
            v4_borrowck_mention_begin(mir_id, body)
            pilot local = 0
            repeat until local >= v4_mir_body_local_count(mir_id, body) or error != "" {
                pilot drop_kind = v4_borrowck_word_local_drop_kind(borrow_id, borrow_result, mir_id, body, local)
                if drop_kind != "" and drop_kind != v4_borrowck_path_drop and drop_kind != v4_borrowck_path_drop_if { error = "invalid native word local drop fact" }
                local += 1
            }
            v4_borrowck_mention_end()
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    if results >= 0 { array_release(results) }
    give back error
}

-- A word, or a native carrier with a word payload field.
task v4_codegen_llvm_type_holds_word(mir_id: int, type_text: word) -> bool {
    if type_text == v4_ty_word { give back true }
    -- Drop glue of a word-owning aggregate calls the word runtime even when
    -- no word value appears (a route whose word case is never built).
    if v4_codegen_llvm_type_owns_words(mir_id, type_text) { give back true }
    pilot carrier = v4_mir_scalar_sum_kind(mir_id, type_text)
    if carrier == "ResultWordWord" { give back true }
    give back (carrier == "Maybe" or carrier == "Result") and v4_codegen_llvm_sum_word_field(mir_id, type_text) != ""
}

task v4_codegen_llvm_mir_has_owned_words(mir_id: int) -> bool {
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        if v4_codegen_llvm_type_holds_word(mir_id, v4_mir_body_callable_return_type(mir_id, body)) { give back true }
        pilot local = 0
        repeat until local >= v4_mir_body_local_count(mir_id, body) {
            if v4_codegen_llvm_type_holds_word(mir_id, v4_mir_local_ty(mir_id, body, local)) { give back true }
            local += 1
        }
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_codegen_llvm_type_holds_word(mir_id, v4_mir_rvalue_ty(mir_id, body, value)) or v4_mir_rvalue_is_builtin_word(mir_id, body, value) { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back false
}

-- Executable word temporaries have one evaluation site. Reject restored DAGs
-- that reuse an instruction-producing node: duplicating it would duplicate an
-- LLVM SSA definition and could release the same temporary twice.
task v4_codegen_llvm_word_tree_mark_is_valid(mir_id: int, body_id: int, rvalue_id: int, seen: int) -> bool {
    if rvalue_id < 0 { give back true }
    pilot pending = v4_codegen_llvm_fragment_new()
    v4_codegen_llvm_fragment_push(pending, word_from_int(rvalue_id))
    pilot cursor = 0
    pilot valid = true
    repeat until cursor >= array_len(pending) or not valid or v4_codegen_llvm_fragment_error != "" {
        pilot value = word_to_int(array_get(pending, cursor))
        cursor += 1
        if value < 0 or value >= array_len(seen) { valid = false } else {
            pilot kind = v4_mir_rvalue_kind(mir_id, body_id, value)
            if v4_codegen_llvm_rvalue_needs_instruction(mir_id, body_id, value) and kind != v4_mir_rvalue_lend {
                pilot seen_value: word = array_get(seen, value)
                if seen_value == "1" { valid = false } else { array_set(seen, value, "1") }
            }
            if valid and not (kind == v4_mir_rvalue_call and v4_mir_rvalue_op(mir_id, body_id, value) == v4_mir_call_say_literal) {
                pilot indirect = 0 - 1
                pilot count = 0
                if kind == v4_mir_rvalue_call {
                    indirect = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, value)
                    if indirect >= 0 { v4_codegen_llvm_fragment_push(pending, word_from_int(indirect)) }
                    count = v4_mir_rvalue_call_arg_count(mir_id, body_id, value)
                    pilot arg = 0
                    repeat until arg >= count {
                        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, value, arg)
                        if child != indirect { v4_codegen_llvm_fragment_push(pending, word_from_int(child)) }
                        arg += 1
                    }
                }
                if kind == v4_mir_rvalue_use_place {
                    v4_codegen_llvm_push_place_operands(pending, mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, value))
                } else if v4_codegen_llvm_is_literal_aggregate(kind) or kind == v4_mir_rvalue_list {
                    pilot arg = 0
                    repeat until arg >= v4_mir_rvalue_call_arg_count(mir_id, body_id, value) {
                        v4_codegen_llvm_fragment_push(pending, word_from_int(v4_mir_rvalue_call_arg(mir_id, body_id, value, arg)))
                        arg += 1
                    }
                } else if kind != v4_mir_rvalue_call or (count == 0 and indirect < 0) {
                    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, value)
                    pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, value)
                    if lhs >= value or rhs >= value { valid = false } else {
                        if lhs >= 0 { v4_codegen_llvm_fragment_push(pending, word_from_int(lhs)) }
                        if rhs >= 0 { v4_codegen_llvm_fragment_push(pending, word_from_int(rhs)) }
                    }
                }
            }
        }
    }
    array_release(pending)
    give back valid and v4_codegen_llvm_fragment_error == ""
}

-- Rvalues a place chain evaluates: index operands and the pointer a
-- dereferenced root reads, outermost step first.
task v4_codegen_llvm_push_place_operands(pending: int, mir_id: int, body_id: int, place_id: int) -> void {
    pilot place = place_id
    pilot steps = 0
    repeat until place < 0 or steps > 64 {
        pilot kind = v4_mir_place_kind(mir_id, body_id, place)
        if kind == v4_mir_place_deref or kind == v4_mir_place_index {
            pilot operand = v4_mir_place_index(mir_id, body_id, place)
            if operand >= 0 { v4_codegen_llvm_fragment_push(pending, word_from_int(operand)) }
        }
        if kind != v4_mir_place_field and kind != v4_mir_place_index { give back }
        place = v4_mir_place_base(mir_id, body_id, place)
        steps += 1
    }
}

-- `a[i] += v` reads and stores one field or element place. The read
-- evaluates its index and pointer operands once and the store reuses that
-- address, so a[f()] += 1 calls f once. The read is the left operand of a
-- Binary, or the receiver of the operator call MIR builds for an overloaded
-- `+=` (MIR passes the store's own place there, by value or as a loan).
-- Answers the read rvalue, or -1.
task v4_codegen_llvm_stmt_compound_read(mir_id: int, body_id: int, stmt_id: int) -> int {
    pilot rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    pilot place = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    if rvalue < 0 or place < 0 or v4_mir_stmt_kind(mir_id, body_id, stmt_id) != v4_mir_stmt_assign { give back 0 - 1 }
    pilot place_kind = v4_mir_place_kind(mir_id, body_id, place)
    if place_kind != v4_mir_place_field and place_kind != v4_mir_place_index { give back 0 - 1 }
    pilot read = v4_codegen_llvm_compound_operator_read(mir_id, body_id, rvalue)
    if read < 0 {
        if v4_mir_rvalue_kind(mir_id, body_id, rvalue) != v4_mir_rvalue_binary { give back 0 - 1 }
        pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue)
        if op == v4_mir_bin_and or op == v4_mir_bin_or { give back 0 - 1 }
        read = v4_mir_rvalue_lhs(mir_id, body_id, rvalue)
    }
    if read < 0 or v4_mir_rvalue_kind(mir_id, body_id, read) != v4_mir_rvalue_use_place or v4_mir_rvalue_lhs(mir_id, body_id, read) != place { give back 0 - 1 }
    give back read
}

-- The receiver read of a two-operand operator call: its first argument, or
-- the place read a Lend / LendMut first argument borrows. -1 otherwise.
task v4_codegen_llvm_compound_operator_read(mir_id: int, body_id: int, rvalue: int) -> int {
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue) != v4_mir_rvalue_call or v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue) != 2 { give back 0 - 1 }
    pilot receiver = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue, 0)
    if receiver < 0 or v4_mir_rvalue_lhs(mir_id, body_id, rvalue) != receiver { give back 0 - 1 }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, receiver)
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut { give back v4_mir_rvalue_lhs(mir_id, body_id, receiver) }
    give back receiver
}

-- The place-address site the compound read evaluated: `r<read>` for a
-- value read, `l<loan>` when the operator borrows the place instead.
task v4_codegen_llvm_compound_read_site(mir_id: int, body_id: int, stmt_id: int, read: int) -> word {
    pilot rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue) == v4_mir_rvalue_call {
        pilot receiver = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue, 0)
        if receiver != read { give back "l" + word_from_int(receiver) }
    }
    give back "r" + word_from_int(read)
}

task v4_codegen_llvm_word_body_trees_are_valid(mir_id: int, body_id: int) -> bool {
    pilot seen = v4_codegen_llvm_fragment_new()
    pilot value = 0
    repeat until value >= v4_mir_body_rvalue_count(mir_id, body_id) { v4_codegen_llvm_fragment_push(seen, "0"); value += 1 }
    pilot valid: bool = v4_codegen_llvm_fragment_error == ""
    pilot stmt = 0
    repeat until stmt >= v4_mir_body_stmt_count(mir_id, body_id) or not valid {
        valid = v4_codegen_llvm_word_tree_mark_is_valid(mir_id, body_id, v4_mir_stmt_rvalue(mir_id, body_id, stmt), seen)
        if valid and v4_mir_stmt_kind(mir_id, body_id, stmt) == v4_mir_stmt_assign {
            pilot place = v4_mir_stmt_place(mir_id, body_id, stmt)
            if place >= 0 and v4_codegen_llvm_stmt_compound_read(mir_id, body_id, stmt) < 0 {
                pilot operands = v4_codegen_llvm_fragment_new()
                v4_codegen_llvm_push_place_operands(operands, mir_id, body_id, place)
                pilot operand = 0
                repeat until operand >= array_len(operands) or not valid {
                    valid = v4_codegen_llvm_word_tree_mark_is_valid(mir_id, body_id, word_to_int(array_get(operands, operand)), seen)
                    operand += 1
                }
                array_release(operands)
            }
        }
        stmt += 1
    }
    array_release(seen)
    give back valid
}

-- `lend word` (any lifetime): a borrowed handle, never dropped by its holder.
task v4_codegen_llvm_is_shared_word_lend(type_text: word) -> bool {
    give back v4_ty_is_lend_type(type_text) and v4_ty_lend_mode(type_text) == v4_ty_param_mode_lend and v4_ty_lend_target_type(type_text) == v4_ty_word
}

-- Two word carriers with the same ownership: equal types, or two shared
-- loans whose lifetimes differ only in name (a call site erases them).
task v4_codegen_llvm_word_handles_match(left: word, right: word) -> bool {
    give back left == right or (v4_codegen_llvm_is_shared_word_lend(left) and v4_codegen_llvm_is_shared_word_lend(right))
}

task v4_codegen_llvm_type_is_word_handle(type_text: word) -> bool {
    give back type_text == v4_ty_word or (v4_ty_is_lend_type(type_text) and v4_ty_lend_target_type(type_text) == v4_ty_word)
}

task v4_codegen_llvm_word_call_param_mode(mir_id: int, body_id: int, value: int, arg: int) -> word {
    -- Closure parameters are values: the closure body owns a word argument.
    if v4_mir_rvalue_closure_callee(mir_id, body_id, value) >= 0 { give back v4_ty_param_mode_value }
    pilot name = v4_mir_rvalue_op(mir_id, body_id, value)
    pilot ty = v4_mir_ty_id(mir_id)
    pilot sig = v4_ty_task_signature_id_for_name(ty, name)
    if sig >= 0 { give back v4_ty_signature_param_mode(ty, sig, arg) }
    pilot slot = v4_mir_dyn_call_slot(mir_id, body_id, value)
    if slot >= 0 { give back v4_ty_doctrine_method_param_mode(ty, v4_codegen_llvm_dyn_call_doctrine_sig(mir_id, body_id, value), slot, arg) }
    pilot callee = v4_codegen_llvm_find_mir_body(mir_id, v4_codegen_llvm_call_callee_name(mir_id, body_id, value))
    if callee >= 0 { give back v4_mir_body_callable_param_mode(mir_id, callee, arg) }
    pilot pointer = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, value)
    if pointer >= 0 {
        pilot param = v4_ty_function_type_param_surface(v4_mir_rvalue_ty(mir_id, body_id, pointer), arg)
        if v4_ty_is_lend_type(param) { give back v4_ty_lend_mode(param) }
    }
    give back v4_ty_param_mode_value
}

task v4_codegen_llvm_word_call_return_type(mir_id: int, body_id: int, value: int) -> word {
    -- A closure call returns its sealed closure result.
    pilot closure_callee = v4_mir_rvalue_closure_callee(mir_id, body_id, value)
    if closure_callee >= 0 { give back v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_closure_return_type(v4_mir_rvalue_ty(mir_id, body_id, closure_callee))) }
    pilot pointer = v4_codegen_llvm_call_target_rvalue(mir_id, body_id, value)
    if pointer >= 0 { give back v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_function_type_return_text(v4_mir_rvalue_ty(mir_id, body_id, pointer))) }
    pilot name = v4_mir_rvalue_op(mir_id, body_id, value)
    pilot sig = v4_ty_task_signature_id_for_name(v4_mir_ty_id(mir_id), name)
    if sig >= 0 { give back v4_ty_signature_return_type(v4_mir_ty_id(mir_id), sig) }
    pilot slot = v4_mir_dyn_call_slot(mir_id, body_id, value)
    if slot >= 0 { give back v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_doctrine_method_return_type(v4_mir_ty_id(mir_id), v4_codegen_llvm_dyn_call_doctrine_sig(mir_id, body_id, value), slot)) }
    pilot callee = v4_codegen_llvm_find_mir_body(mir_id, v4_codegen_llvm_call_callee_name(mir_id, body_id, value))
    if callee >= 0 { give back v4_mir_body_callable_return_type(mir_id, callee) }
    give back v4_ty_unknown
}

task v4_codegen_llvm_word_boundary_types_error(mir_id: int, body_id: int) -> word {
    pilot stmt = 0
    repeat until stmt >= v4_mir_body_stmt_count(mir_id, body_id) {
        pilot kind = v4_mir_stmt_kind(mir_id, body_id, stmt)
        pilot value = v4_mir_stmt_rvalue(mir_id, body_id, stmt)
        pilot actual = v4_ty_void
        if value >= 0 { actual = v4_mir_rvalue_ty(mir_id, body_id, value) }
        pilot expected = actual
        if kind == v4_mir_stmt_return { expected = v4_mir_body_callable_return_type(mir_id, body_id) }
        if kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign {
            pilot place = v4_mir_stmt_place(mir_id, body_id, stmt)
            if place >= 0 { expected = v4_mir_place_ty(mir_id, body_id, place) }
            pilot local = 0 - 1
            if place >= 0 and v4_mir_place_kind(mir_id, body_id, place) == v4_mir_place_local { local = v4_mir_place_base(mir_id, body_id, place) }
            if place < 0 { local = v4_mir_find_local_visible_at(mir_id, body_id, v4_mir_stmt_lhs(mir_id, body_id, stmt), v4_span_start(v4_mir_stmt_span(mir_id, body_id, stmt))) }
            if local >= 0 {
                pilot local_ty = v4_mir_local_ty(mir_id, body_id, local)
                if v4_codegen_llvm_type_is_word_handle(actual) or v4_codegen_llvm_type_is_word_handle(expected) or v4_codegen_llvm_type_is_word_handle(local_ty) {
                    if place < 0 or expected != local_ty { give back "native word assignment requires an exact local ownership place" }
                    expected = local_ty
                }
            }
        }
        if (v4_codegen_llvm_type_is_word_handle(actual) or v4_codegen_llvm_type_is_word_handle(expected)) and not v4_codegen_llvm_word_handles_match(actual, expected) { give back "native word ownership boundary has incompatible types" }
        stmt += 1
    }
    pilot value = 0
    repeat until value >= v4_mir_body_rvalue_count(mir_id, body_id) {
        pilot kind = v4_mir_rvalue_kind(mir_id, body_id, value)
        pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, value)
        pilot rhs = v4_mir_rvalue_rhs(mir_id, body_id, value)
        if kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_binary {
            if lhs >= 0 and v4_codegen_llvm_type_is_word_handle(v4_mir_rvalue_ty(mir_id, body_id, lhs)) { give back "native word operators require compiler-owned intrinsic identities" }
            if rhs >= 0 and v4_codegen_llvm_type_is_word_handle(v4_mir_rvalue_ty(mir_id, body_id, rhs)) { give back "native word operators require compiler-owned intrinsic identities" }
        }
        if kind == v4_mir_rvalue_call and not v4_mir_rvalue_is_builtin_word(mir_id, body_id, value) and not v4_mir_rvalue_is_builtin_control(mir_id, body_id, value) and not v4_mir_rvalue_is_builtin_system(mir_id, body_id, value) and not v4_mir_rvalue_is_builtin_list(mir_id, body_id, value) and v4_mir_rvalue_op(mir_id, body_id, value) != v4_mir_call_say_literal {
            pilot call_name = v4_mir_rvalue_op(mir_id, body_id, value)
            if call_name != v4_mir_call_raw_ptr_write {
                pilot expected_return = v4_codegen_llvm_word_call_return_type(mir_id, body_id, value)
                pilot actual_return = v4_mir_rvalue_ty(mir_id, body_id, value)
                if (v4_codegen_llvm_type_is_word_handle(expected_return) or v4_codegen_llvm_type_is_word_handle(actual_return)) and not v4_codegen_llvm_word_handles_match(expected_return, actual_return) { give back "native word call return does not match its callable ownership contract" }
            }
            pilot arg = 0
            repeat until arg >= v4_mir_rvalue_call_arg_count(mir_id, body_id, value) {
                pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, value, arg)
                pilot actual = v4_mir_rvalue_ty(mir_id, body_id, child)
                pilot expected = v4_codegen_llvm_variadic_arg_promoted_type(mir_id, body_id, value, arg)
                if call_name == v4_mir_call_raw_ptr_write and arg == 1 { expected = v4_ty_raw_pointer_target_type(v4_mir_rvalue_ty(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, value, 0))) }
                if v4_codegen_llvm_type_is_word_handle(actual) or v4_codegen_llvm_type_is_word_handle(expected) {
                    if not v4_codegen_llvm_type_is_word_handle(actual) or not v4_codegen_llvm_type_is_word_handle(expected) { give back "native word call argument does not match its callable ownership contract" }
                    pilot mode = v4_codegen_llvm_word_call_param_mode(mir_id, body_id, value, arg)
                    if mode == v4_ty_param_mode_value and actual != v4_ty_word { give back "native owned word argument cannot be a borrowed handle" }
                    if mode == v4_ty_param_mode_lend and not v4_codegen_llvm_is_shared_word_lend(actual) { give back "native borrowed word argument requires an immutable loan" }
                }
                arg += 1
            }
        }
        value += 1
    }
    give back ""
}

-- Aggregates that own words move and drop as one value; partial moves and
-- slot stores follow Meiya's drop plan (v4_codegen_llvm_drop_plan_error).
-- Still refused by name: a projection of a word-owning temporary (its other
-- words would leak) and a repeat fill (one word in many slots).
task v4_codegen_llvm_aggregate_word_ownership_error(mir_id: int, body: int) -> word {
    pilot count = v4_mir_body_rvalue_count(mir_id, body)
    pilot error = ""
    pilot value = 0
    repeat until value >= count or error != "" {
        pilot kind = v4_mir_rvalue_kind(mir_id, body, value)
        pilot type_text = v4_mir_rvalue_ty(mir_id, body, value)
        pilot leaves = v4_codegen_llvm_word_leaf_count(mir_id, type_text, 0)
        if leaves > 256 or leaves < 0 { error = "native aggregates owning more than 256 words are not yet supported: " + type_text }
        if error == "" and kind == v4_mir_rvalue_unary and (v4_mir_rvalue_op(mir_id, body, value) == v4_mir_unary_project or v4_mir_rvalue_op(mir_id, body, value) == v4_mir_unary_project_index) {
            if v4_codegen_llvm_type_owns_words(mir_id, v4_mir_rvalue_ty(mir_id, body, v4_mir_rvalue_lhs(mir_id, body, value))) { error = "native projections of temporaries that own words are not yet supported: " + v4_mir_rvalue_text(mir_id, body, value) }
        }
        if error == "" and kind == v4_mir_rvalue_array and leaves > 0 {
            pilot children = v4_mir_rvalue_call_arg_count(mir_id, body, value)
            if children != v4_codegen_llvm_aggregate_slot_count(mir_id, type_text) { error = "native repeat fills of values that own words are not yet supported: " + v4_mir_rvalue_text(mir_id, body, value) }
        }
        value += 1
    }
    if error != "" { give back error }
    pilot local = 0
    repeat until local >= v4_mir_body_local_count(mir_id, body) {
        pilot leaves = v4_codegen_llvm_word_leaf_count(mir_id, v4_mir_local_ty(mir_id, body, local), 0)
        if leaves > 256 or leaves < 0 { give back "native aggregates owning more than 256 words are not yet supported: " + v4_mir_local_ty(mir_id, body, local) }
        local += 1
    }
    give back ""
}

task v4_codegen_llvm_owned_word_error(mir_id: int) -> word {
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir_id, body)
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot boundary_error = v4_codegen_llvm_word_boundary_types_error(mir_id, body)
        if boundary_error != "" { give back boundary_error }
        pilot aggregate_error = v4_codegen_llvm_aggregate_word_ownership_error(mir_id, body)
        if aggregate_error != "" { give back aggregate_error }
        if not v4_codegen_llvm_word_body_trees_are_valid(mir_id, body) { give back "native ownership rvalue must have one evaluation site" }
        -- A borrowed return is the address of a place (or an immutable word's
        -- handle) the callee received through a loan; it transfers nothing.
        pilot return_ty = v4_mir_body_callable_return_type(mir_id, body)
        if v4_ty_is_lend_type(return_ty) and not v4_codegen_llvm_is_place_lend(mir_id, return_ty) and not v4_codegen_llvm_is_shared_word_lend(return_ty) { give back "native borrowed word returns are not yet supported" }
        pilot local = 0
        repeat until local >= v4_mir_body_local_count(mir_id, body) {
            -- A borrowed local holds the loan it was given and never drops it.
            -- Lend-typed parameters (`p: lend T`) are not lend modes and stay fenced.
            pilot local_ty = v4_mir_local_ty(mir_id, body, local)
            pilot param: bool = local < v4_mir_body_callable_param_count(mir_id, body)
            if v4_codegen_llvm_is_place_lend(mir_id, local_ty) and param { give back "native lend-typed parameters are not yet supported; declare the mode instead (lend p: T)" }
            if v4_ty_is_lend_type(local_ty) and not v4_codegen_llvm_is_place_lend(mir_id, local_ty) and (param or not v4_codegen_llvm_is_shared_word_lend(local_ty)) { give back "native borrowed word local storage is not yet supported" }
            local += 1
        }
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_mir_rvalue_ty(mir_id, body, value) == v4_ty_word {
                pilot kind = v4_mir_rvalue_kind(mir_id, body, value)
                -- A UsePlace word is a borrowed read of an aggregate slot
                -- (v4_codegen_llvm_aggregate_word_ownership_error). A closure
                -- capture is named by v4_codegen_llvm_native_closure_rvalue_error.
                pilot capture: bool = kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut or kind == v4_mir_rvalue_capture_copy or kind == v4_mir_rvalue_capture_move
                if not capture and kind != v4_mir_rvalue_const_word and kind != v4_mir_rvalue_use_local and kind != v4_mir_rvalue_call and kind != v4_mir_rvalue_sum_take and kind != v4_mir_rvalue_try and kind != v4_mir_rvalue_or_else and kind != v4_mir_rvalue_use_place and not v4_codegen_llvm_rvalue_is_global_read(mir_id, body, value) and not v4_mir_rvalue_is_list_loop_item(mir_id, body, value) { give back "native owned word rvalue not yet supported: " + kind }
            }
            value += 1
        }
        pilot place = 0
        repeat until place >= v4_mir_body_place_count(mir_id, body) {
            if v4_mir_place_kind(mir_id, body, place) == v4_mir_place_deref and v4_mir_place_ty(mir_id, body, place) == v4_ty_word { give back "native raw word storage ownership is not yet supported" }
            place += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir_id, body + 1)
    }
    give back ""
}

-- LLVM owns the checked fast path; the existing runtime owns its diagnostic.
-- Keeping the branch inside an alwaysinline wrapper avoids introducing new
-- expression labels or changing MIR/Meiya control and cleanup facts. On the
-- overflow edge, the identical operands must fail in the legacy helper, so
-- unreachable preserves its exit(1) contract without a new runtime ABI.
task v4_codegen_llvm_int_inline_runtime_lines() -> word {
    pilot out = ""
    pilot pair_ty = "{" + " i64, i1 " + "}"
    pilot operation = 0
    repeat until operation >= 3 {
        pilot suffix = "add"
        if operation == 1 { suffix = "sub" }
        if operation == 2 { suffix = "mul" }
        pilot intrinsic = "@llvm.s" + suffix + ".with.overflow.i64"
        out = out + "declare " + pair_ty + " " + intrinsic + "(i64, i64)\n"
        out = out + "define internal i64 @freak_v4_int_" + suffix + "_inline(i64 %lhs, i64 %rhs) alwaysinline {\nentry:\n"
        out = out + "  %checked = call " + pair_ty + " " + intrinsic + "(i64 %lhs, i64 %rhs)\n"
        out = out + "  %overflow = extractvalue " + pair_ty + " %checked, 1\n"
        out = out + "  br i1 %overflow, label %failure, label %success\nfailure:\n"
        out = out + "  %unused = call i64 @freak_v4_int_" + suffix + "(i64 %lhs, i64 %rhs)\n  unreachable\nsuccess:\n"
        out = out + "  %result = extractvalue " + pair_ty + " %checked, 0\n  ret i64 %result\n}\n"
        operation += 1
    }
    give back out
}

task v4_codegen_llvm_numeric_runtime_declarations() -> word {
    pilot out = ""
    pilot type_id = 0
    repeat until type_id >= 3 {
        pilot kind = "int"
        if type_id == 1 { kind = "uint" }
        if type_id == 2 { kind = "tiny" }
        pilot return_carrier = v4_codegen_llvm_numeric_helper_type(kind, true)
        pilot argument = v4_codegen_llvm_numeric_helper_type(kind, false)
        pilot operation = 0
        repeat until operation >= 6 {
            pilot suffix = "add"
            if operation == 1 { suffix = "sub" }
            if operation == 2 { suffix = "mul" }
            if operation == 3 { suffix = "neg" }
            if operation == 4 { suffix = "div" }
            if operation == 5 { suffix = "mod" }
            out = out + "declare " + return_carrier + " @freak_v4_" + kind + "_" + suffix + "(" + argument
            if operation != 3 { out = out + ", " + argument }
            out = out + ")\n"
            operation += 1
        }
        pilot source_id = 0
        repeat until source_id >= 4 {
            pilot source_kind = "int"
            if source_id == 1 { source_kind = "uint" }
            if source_id == 2 { source_kind = "tiny" }
            if source_id == 3 { source_kind = "num" }
            if source_kind != kind { out = out + "declare " + return_carrier + " @freak_v4_" + kind + "_from_" + source_kind + "(" + v4_codegen_llvm_numeric_helper_type(source_kind, false) + ")\n" }
            source_id += 1
        }
        out = out + "declare double @freak_v4_num_from_" + kind + "(" + argument + ")\n"
        type_id += 1
    }
    give back out + v4_codegen_llvm_int_inline_runtime_lines()
}

task v4_codegen_llvm_numeric_reserved_symbol_error(symbol: word) -> word {
    if symbol.starts_with("@freak_v4_int_") or symbol.starts_with("@freak_v4_uint_") or symbol.starts_with("@freak_v4_tiny_") or symbol.starts_with("@freak_v4_num_") { give back "native numeric runtime symbol conflict: " + symbol }
    -- Authored dotted ABI names use quoted canonical symbols; LLVM intrinsic
    -- declarations use unquoted spellings of the same exact identities.
    if symbol == "@llvm.sadd.with.overflow.i64" or symbol == "@\"llvm.sadd.with.overflow.i64\"" { give back "native numeric runtime symbol conflict: " + symbol }
    if symbol == "@llvm.ssub.with.overflow.i64" or symbol == "@\"llvm.ssub.with.overflow.i64\"" { give back "native numeric runtime symbol conflict: " + symbol }
    if symbol == "@llvm.smul.with.overflow.i64" or symbol == "@\"llvm.smul.with.overflow.i64\"" { give back "native numeric runtime symbol conflict: " + symbol }
    if symbol == "@freak_llvm_word_owned_size" or symbol.starts_with("@freak_v4_process_") or symbol.starts_with("@freak_v4_fs_") or symbol.starts_with("@freak_v4_panic_") { give back "native private runtime symbol conflict: " + symbol }
    -- Bounds-check message globals; LLVM accepts both spellings as one name.
    if symbol.starts_with("@freak.bounds.") or symbol.starts_with("@\"freak.bounds.") { give back "native private runtime symbol conflict: " + symbol }
    -- C-width shims and their checked narrowing helpers.
    if symbol.starts_with("@freak_v4_cabi_") or symbol.starts_with("@freak.cabi.") or symbol.starts_with("@\"freak.cabi.") { give back "native private runtime symbol conflict: " + symbol }
    -- Dyn vtable constants and their drop entries.
    if symbol.starts_with("@freak.dyn.") or symbol.starts_with("@\"freak.dyn.") or symbol.starts_with("@freak.vtable.") or symbol.starts_with("@\"freak.vtable.") { give back "native private runtime symbol conflict: " + symbol }
    give back ""
}

task v4_codegen_llvm_numeric_runtime_symbol_error(codegen_id: int) -> word {
    pilot body = 0
    repeat until body >= v4_codegen_llvm_body_count(codegen_id) {
        pilot error = v4_codegen_llvm_numeric_reserved_symbol_error(v4_codegen_llvm_body_symbol(codegen_id, body))
        if error != "" { give back error }
        body += 1
    }
    pilot declaration = 0
    repeat until declaration >= v4_codegen_llvm_decl_count(codegen_id) {
        pilot error = v4_codegen_llvm_numeric_reserved_symbol_error(v4_codegen_llvm_decl_symbol(codegen_id, declaration))
        if error != "" { give back error }
        declaration += 1
    }
    give back ""
}

task v4_codegen_llvm_word_runtime_declarations() -> word {
    pilot out = "declare i64 @freak_v4_word_from_bytes(i64, i64)\n"
    out = out + "declare i64 @freak_v4_word_clone(i64)\ndeclare i64 @freak_v4_word_concat(i64, i64)\n"
    out = out + "declare i64 @freak_v4_word_to_lower(i64)\n"
    out = out + "declare i64 @freak_v4_word_from_int(i64)\ndeclare i64 @freak_v4_word_from_bool(i64)\ndeclare i64 @freak_v4_word_from_num(double)\n"
    out = out + "declare i64 @freak_v4_word_to_int(i64)\ndeclare i64 @freak_v4_word_equal(i64, i64)\n"
    out = out + "declare i64 @freak_v4_word_length(i64)\ndeclare i64 @freak_v4_word_bytes(i64)\n"
    out = out + "declare i64 @freak_v4_word_char_at(i64, i64)\ndeclare i64 @freak_v4_word_slice(i64, i64, i64)\ndeclare i64 @freak_v4_word_substring(i64, i64, i64)\n"
    out = out + "declare i64 @freak_v4_word_starts_with(i64, i64)\ndeclare i64 @freak_v4_word_ends_with(i64, i64)\ndeclare i64 @freak_v4_word_contains(i64, i64)\n"
    give back out + "declare void @freak_v4_word_say(i64)\ndeclare void @freak_v4_word_say_err(i64)\ndeclare void @freak_v4_word_drop(i64)\n"
}

-- Runtime handles have a distinct ownership ABI. User declarations may not
-- impersonate these compiler-supplied operations, even with scalar signatures.
task v4_codegen_llvm_word_runtime_symbol_error(codegen_id: int) -> word {
    pilot body = 0
    repeat until body >= v4_codegen_llvm_body_count(codegen_id) {
        pilot symbol = v4_codegen_llvm_body_symbol(codegen_id, body)
        if symbol.starts_with("@freak_v4_word_") or symbol.starts_with("@freak_v4_compiler_array_") { give back "native owned word runtime symbol conflict: " + symbol }
        body += 1
    }
    pilot decl = 0
    repeat until decl >= v4_codegen_llvm_decl_count(codegen_id) {
        pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl)
        if symbol.starts_with("@freak_v4_word_") or symbol.starts_with("@freak_v4_compiler_array_") { give back "native owned word runtime symbol conflict: " + symbol }
        decl += 1
    }
    give back ""
}

-- Plan-only codegen still describes broader word types. Executable modules
-- admit only static say operands until transfers and drops are implemented.
task v4_codegen_llvm_native_word_error(mir_id: int) -> word {
    pilot error = ""
    pilot nul = chr(0)
    pilot body_id = 0
    body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id)
    repeat until body_id >= v4_mir_body_count(mir_id) {
        if v4_mir_body_callable_return_type(mir_id, body_id) == v4_ty_word {
            error = "native word returns are not yet supported"
        }
        pilot local_id = 0
        repeat until local_id >= v4_mir_body_local_count(mir_id, body_id) {
            if v4_mir_local_ty(mir_id, body_id, local_id) == v4_ty_word {
                error = "native word locals and parameters are not yet supported"
            }
            local_id += 1
        }
        pilot literals = array_new()
        pilot rvalue_id = 0
        repeat until rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
            array_push(literals, "0")
            rvalue_id += 1
        }
        rvalue_id = 0
        repeat until rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
            if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_call and v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_call_say_literal {
                pilot literal = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
                if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) != 1 or literal < 0 or literal >= array_len(literals) {
                    error = "invalid literal say intrinsic argument"
                } else if v4_mir_rvalue_kind(mir_id, body_id, literal) != v4_mir_rvalue_const_word or v4_mir_rvalue_ty(mir_id, body_id, literal) != v4_ty_word or v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) != v4_ty_void or v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id) >= 0 or v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id) >= 0 {
                    error = "invalid literal say intrinsic contract"
                } else {
                    array_set(literals, literal, "1")
                    pilot text = v4_mir_rvalue_text(mir_id, body_id, literal)
                    pilot byte_id = 0
                    repeat until byte_id >= text.length() {
                        if text.char_at(byte_id) == nul { error = "say literal contains embedded NUL" }
                        byte_id += 1
                    }
                }
            }
            rvalue_id += 1
        }
        rvalue_id = 0
        repeat until rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
            if v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) == v4_ty_word {
                if word_to_int(array_get(literals, rvalue_id)) != 1 {
                    error = "native words currently support only literal say operands"
                }
            }
            rvalue_id += 1
        }
        array_release(literals)
        body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id + 1)
    }
    give back error
}

task v4_codegen_llvm_word_globals(mir_id: int) -> word {
    pilot parts = v4_codegen_llvm_fragment_new()
    pilot body_id = 0
    body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id)
    repeat until body_id >= v4_mir_body_count(mir_id) {
        pilot rvalue_id = 0
        repeat until rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
            if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_const_word {
                pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
                v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_word_literal_symbol(body_id, rvalue_id) + " = private unnamed_addr constant [" + word_from_int(text.byte_length() + 1) + " x i8] c\"" + v4_codegen_llvm_word_literal_escape(text) + "\\00\", align 1\n")
            }
            rvalue_id += 1
        }
        body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id + 1)
    }
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_native_entry_error(mir_id: int) -> word {
    pilot main_id = v4_codegen_llvm_find_mir_body(mir_id, "main")
    if main_id < 0 {
        -- A script initializer gets a generated entry that sets up args.
        if v4_codegen_llvm_mir_uses_typed_process(mir_id) and v4_mir_module_init_body(mir_id) < 0 { give back "native typed process operations require a generated zero-argument entry" }
        give back ""
    }
    -- A generic main is a template: it gets no body, so the entry cannot call it.
    if v4_mir_body_is_generic_template(mir_id, main_id) { give back "native main must not be generic" }
    if v4_mir_body_callable_param_count(mir_id, main_id) != 0 {
        give back "native main parameters are not yet supported"
    }
    pilot return_ty = v4_mir_body_callable_return_type(mir_id, main_id)
    if return_ty != v4_ty_int and return_ty != v4_ty_void and return_ty != v4_ty_never {
        give back "native main must return int, void, or never"
    }
    give back ""
}

-- The user-facing form of the entry contract above: a named, spanned error
-- on the main task itself, reported before codegen. Like V3, main takes no
-- parameters; programs read their arguments through typed process calls.
task v4_codegen_llvm_native_entry_diag(mir_id: int) -> word {
    pilot main_id = v4_codegen_llvm_find_mir_body(mir_id, "main")
    if main_id < 0 { give back "" }
    pilot span = v4_mir_word_source_body_span(v4_mir_ty_id(mir_id), v4_mir_body_def(mir_id, main_id))
    if v4_mir_body_is_generic_template(mir_id, main_id) {
        give back v4_diag_new(v4_diag_error, span, "main must not be generic", "drop the type parameters from main; call a generic task from it instead")
    }
    if v4_mir_body_callable_param_count(mir_id, main_id) != 0 {
        give back v4_diag_new(v4_diag_error, span, "main must not declare parameters", "read command-line arguments inside main with process::args_count() and process::arg(i)")
    }
    pilot return_ty = v4_mir_body_callable_return_type(mir_id, main_id)
    if return_ty != v4_ty_int and return_ty != v4_ty_void and return_ty != v4_ty_never {
        give back v4_diag_new(v4_diag_error, span, "main must return int or void, got " + return_ty, "give back an int exit status, or leave the return type off for void")
    }
    give back ""
}

-- The generated entry owns both the C ABI name and the private source-task
-- name. A library without an entry may still declare an external main.
task v4_codegen_llvm_native_entry_symbol_error(codegen_id: int) -> word {
    pilot private_symbol = v4_codegen_llvm_symbol("freak.user.main")
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
        if v4_codegen_llvm_starts_with(v4_codegen_llvm_decl_line(codegen_id, decl_id), "declare ") {
            pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl_id)
            if symbol == "@main" or symbol == "@freak.user.main" or symbol == private_symbol {
                give back "native entry symbol conflicts with explicit ABI declaration: " + symbol
            }
        }
        decl_id += 1
    }
    give back ""
}

task v4_codegen_llvm_native_module_error(codegen_id: int) -> word {
    if codegen_id == -2 { give back "native codegen plan arena allocation failed" }
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "invalid codegen ID" }
    give back array_get(v4_codegen_llvm_native_errors, codegen_id)
}

-- Scratch indexes borrow complete sealed symbols, so hash equality is never
-- identity. They are private to one sealing query and retain no owner handle.
task v4_codegen_llvm_body_symbol_index_insert(codegen_id: int, index: int, body_id: int) -> bool {
    pilot capacity = array_len(index)
    if capacity <= 0 { give back false }
    give back v4_codegen_llvm_symbol_index_insert(index, v4_codegen_llvm_body_symbol(codegen_id, body_id))
}

task v4_codegen_llvm_symbol_index_insert(index: int, symbol: word) -> bool {
    pilot capacity = array_len(index)
    if capacity <= 0 or symbol == "" { give back false }
    pilot bucket = symbol.checksum() % capacity
    pilot visited = 0
    repeat until visited >= capacity {
        pilot previous: word = array_get(index, bucket)
        if previous == "" {
            array_set(index, bucket, symbol)
            pilot stored: word = array_get(index, bucket)
            give back stored == symbol
        }
        if previous == symbol { give back true }
        bucket = (bucket + 1) % capacity
        visited += 1
    }
    give back false
}

task v4_codegen_llvm_body_symbol_index_empty_new(count: int) -> int {
    -- Larger capacities cannot be useful under the existing array budgets;
    -- retain exact linear semantics rather than overflow capacity arithmetic.
    if count <= 0 or count > 268435456 { give back 0 - 1 }
    pilot capacity = 16
    repeat until capacity >= count * 2 { capacity *= 2 }
    pilot index = array_new()
    if index < 0 { give back 0 - 1 }
    pilot bucket = 0
    repeat until bucket >= capacity {
        array_push(index, "")
        if array_len(index) != bucket + 1 { array_release(index); give back 0 - 1 }
        bucket += 1
    }
    give back index
}

task v4_codegen_llvm_body_symbol_index_new(codegen_id: int) -> int {
    pilot count = v4_codegen_llvm_body_count(codegen_id)
    pilot index = v4_codegen_llvm_body_symbol_index_empty_new(count)
    if index < 0 { give back 0 - 1 }
    pilot body_id = 0
    repeat until body_id >= count {
        if not v4_codegen_llvm_body_symbol_index_insert(codegen_id, index, body_id) {
            array_release(index)
            give back 0 - 1
        }
        body_id += 1
    }
    give back index
}

task v4_codegen_llvm_body_symbol_index_contains(codegen_id: int, index: int, symbol: word) -> bool {
    pilot capacity = array_len(index)
    if capacity <= 0 { give back false }
    pilot bucket = symbol.checksum() % capacity
    pilot visited = 0
    repeat until visited >= capacity {
        pilot previous: word = array_get(index, bucket)
        if previous == "" { give back false }
        if previous == symbol { give back true }
        bucket = (bucket + 1) % capacity
        visited += 1
    }
    give back false
}

task v4_codegen_llvm_body_symbol_linear_contains(codegen_id: int, symbol: word) -> bool {
    pilot body_id = 0
    repeat until body_id >= v4_codegen_llvm_body_count(codegen_id) {
        if v4_codegen_llvm_body_symbol(codegen_id, body_id) == symbol { give back true }
        body_id += 1
    }
    give back false
}

task v4_codegen_llvm_duplicate_body_linear_error(codegen_id: int) -> word {
    pilot body_id = 1
    repeat until body_id >= v4_codegen_llvm_body_count(codegen_id) {
        pilot symbol = v4_codegen_llvm_body_symbol(codegen_id, body_id)
        pilot previous = 0
        repeat until previous >= body_id {
            if v4_codegen_llvm_body_symbol(codegen_id, previous) == symbol { give back "native body symbol has multiple definitions: " + symbol }
            previous += 1
        }
        body_id += 1
    }
    give back ""
}

-- Ordinary and generated callback names share one definition namespace.
-- Report the earliest repeated body in sealed order, even without scratch.
task v4_codegen_llvm_native_duplicate_body_error(codegen_id: int) -> word {
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "invalid codegen ID" }
    pilot count = v4_codegen_llvm_body_count(codegen_id)
    if count <= 1 { give back "" }
    pilot index = v4_codegen_llvm_body_symbol_index_empty_new(count)
    if index < 0 { give back v4_codegen_llvm_duplicate_body_linear_error(codegen_id) }
    pilot body_id = 0
    repeat until body_id >= count {
        pilot symbol = v4_codegen_llvm_body_symbol(codegen_id, body_id)
        if v4_codegen_llvm_body_symbol_index_contains(codegen_id, index, symbol) {
            array_release(index)
            give back "native body symbol has multiple definitions: " + symbol
        }
        if not v4_codegen_llvm_body_symbol_index_insert(codegen_id, index, body_id) {
            array_release(index)
            give back v4_codegen_llvm_duplicate_body_linear_error(codegen_id)
        }
        body_id += 1
    }
    array_release(index)
    give back ""
}

-- Check actual definitions after ordinary bodies and callback trampolines are
-- sealed. Source-level names and mutable MIR/TY facts cannot decide linkage.
task v4_codegen_llvm_native_body_symbol_error(codegen_id: int) -> word {
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "invalid codegen ID" }
    if v4_codegen_llvm_body_count(codegen_id) == 0 { give back "" }
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) or v4_codegen_llvm_decl_line(codegen_id, decl_id).starts_with("declare ") { decl_id += 1 }
    if decl_id >= v4_codegen_llvm_decl_count(codegen_id) { give back "" }
    pilot index = v4_codegen_llvm_body_symbol_index_new(codegen_id)
    pilot error = ""
    -- Declaration order controls the first diagnostic, independent of buckets.
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) or error != "" {
        if v4_codegen_llvm_decl_line(codegen_id, decl_id).starts_with("declare ") {
            pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl_id)
            pilot collision: bool = false
            if index >= 0 { collision = v4_codegen_llvm_body_symbol_index_contains(codegen_id, index, symbol) } else { collision = v4_codegen_llvm_body_symbol_linear_contains(codegen_id, symbol) }
            if collision { error = "native body symbol conflicts with explicit ABI declaration: " + symbol }
        }
        decl_id += 1
    }
    if index >= 0 { array_release(index) }
    give back error
}

-- A declaration index stores the first row for each exact symbol. Keep every
-- alias row in the plan; publication alone suppresses compatible repeats.
task v4_codegen_llvm_decl_symbol_previous(codegen_id: int, decl_id: int) -> int {
    pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl_id)
    pilot previous = 0
    repeat until previous >= decl_id {
        if v4_codegen_llvm_decl_line(codegen_id, previous).starts_with("declare ") and v4_codegen_llvm_decl_symbol(codegen_id, previous) == symbol { give back previous }
        previous += 1
    }
    give back 0 - 1
}

task v4_codegen_llvm_decl_symbol_index_lookup(codegen_id: int, index: int, symbol: word) -> int {
    pilot capacity = array_len(index)
    if capacity <= 0 { give back 0 - 1 }
    pilot bucket = symbol.checksum() % capacity
    pilot visited = 0
    repeat until visited >= capacity {
        pilot stored: word = array_get(index, bucket)
        if stored == "" { give back 0 - 1 }
        pilot row = word_to_int(stored) - 1
        if v4_codegen_llvm_decl_symbol(codegen_id, row) == symbol { give back row }
        bucket = (bucket + 1) % capacity
        visited += 1
    }
    give back 0 - 1
}

task v4_codegen_llvm_decl_symbol_index_insert(codegen_id: int, index: int, decl_id: int) -> bool {
    pilot capacity = array_len(index)
    pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl_id)
    if capacity <= 0 or symbol == "" { give back false }
    pilot bucket = symbol.checksum() % capacity
    pilot visited = 0
    repeat until visited >= capacity {
        pilot previous: word = array_get(index, bucket)
        if previous == "" {
            pilot value = word_from_int(decl_id + 1)
            array_set(index, bucket, value)
            pilot stored: word = array_get(index, bucket)
            give back stored == value
        }
        if v4_codegen_llvm_decl_symbol(codegen_id, word_to_int(previous) - 1) == symbol { give back true }
        bucket = (bucket + 1) % capacity
        visited += 1
    }
    give back false
}

task v4_codegen_llvm_decl_symbol_index_new(codegen_id: int) -> int {
    pilot index = v4_codegen_llvm_body_symbol_index_empty_new(v4_codegen_llvm_decl_count(codegen_id))
    if index < 0 { give back 0 - 1 }
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
        if v4_codegen_llvm_decl_line(codegen_id, decl_id).starts_with("declare ") {
            if not v4_codegen_llvm_decl_symbol_index_insert(codegen_id, index, decl_id) { array_release(index); give back 0 - 1 }
        }
        decl_id += 1
    }
    give back index
}

task v4_codegen_llvm_decl_signature_matches(codegen_id: int, first: int, second: int) -> bool {
    give back v4_codegen_llvm_decl_cc(codegen_id, first) == v4_codegen_llvm_decl_cc(codegen_id, second) and v4_codegen_llvm_decl_return(codegen_id, first) == v4_codegen_llvm_decl_return(codegen_id, second) and v4_codegen_llvm_decl_params(codegen_id, first) == v4_codegen_llvm_decl_params(codegen_id, second) and v4_codegen_llvm_ffi_call_suffix(v4_codegen_llvm_decl_abi(codegen_id, first)) == v4_codegen_llvm_ffi_call_suffix(v4_codegen_llvm_decl_abi(codegen_id, second))
}

task v4_codegen_llvm_native_declaration_symbol_error(codegen_id: int) -> word {
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "invalid codegen ID" }
    pilot index = v4_codegen_llvm_decl_symbol_index_new(codegen_id)
    pilot error = ""
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) or error != "" {
        if v4_codegen_llvm_decl_line(codegen_id, decl_id).starts_with("declare ") {
            pilot previous = 0 - 1
            if index >= 0 { previous = v4_codegen_llvm_decl_symbol_index_lookup(codegen_id, index, v4_codegen_llvm_decl_symbol(codegen_id, decl_id)) } else { previous = v4_codegen_llvm_decl_symbol_previous(codegen_id, decl_id) }
            if previous >= 0 and previous < decl_id and not v4_codegen_llvm_decl_signature_matches(codegen_id, previous, decl_id) { error = "native declaration symbol has incompatible signatures: " + v4_codegen_llvm_decl_symbol(codegen_id, decl_id) }
        }
        decl_id += 1
    }
    if index >= 0 { array_release(index) }
    give back error
}

-- Build one exact namespace over sealed declarations and actual definitions.
-- Generated literal spellings remain unchanged in IR; comparison uses the
-- canonical symbol of the raw generated name, including LLVM quote identity.
task v4_codegen_llvm_native_namespace_index_new(codegen_id: int) -> int {
    pilot index = v4_codegen_llvm_body_symbol_index_empty_new(v4_codegen_llvm_decl_count(codegen_id) + v4_codegen_llvm_body_count(codegen_id))
    if index < 0 { give back 0 - 1 }
    pilot row = 0
    repeat until row >= v4_codegen_llvm_decl_count(codegen_id) {
        if not v4_codegen_llvm_symbol_index_insert(index, v4_codegen_llvm_decl_symbol(codegen_id, row)) { array_release(index); give back 0 - 1 }
        row += 1
    }
    row = 0
    repeat until row >= v4_codegen_llvm_body_count(codegen_id) {
        if not v4_codegen_llvm_body_symbol_index_insert(codegen_id, index, row) { array_release(index); give back 0 - 1 }
        row += 1
    }
    give back index
}

task v4_codegen_llvm_native_namespace_linear_contains(codegen_id: int, symbol: word) -> bool {
    pilot row = 0
    repeat until row >= v4_codegen_llvm_decl_count(codegen_id) {
        if v4_codegen_llvm_decl_symbol(codegen_id, row) == symbol { give back true }
        row += 1
    }
    give back v4_codegen_llvm_body_symbol_linear_contains(codegen_id, symbol)
}

task v4_codegen_llvm_native_literal_symbol_error(codegen_id: int, mir_id: int) -> word {
    pilot index = v4_codegen_llvm_native_namespace_index_new(codegen_id)
    pilot error = ""
    pilot body_id = 0
    body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id)
    repeat until body_id >= v4_mir_body_count(mir_id) or error != "" {
        pilot rvalue_id = 0
        repeat until rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) or error != "" {
            if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_const_word {
                pilot raw_name = ".str." + word_from_int(body_id) + "." + word_from_int(rvalue_id)
                pilot symbol = ""
                -- This fixed alphabet needs no escape buffer on failure.
                if index >= 0 { symbol = v4_codegen_llvm_symbol(raw_name) } else { symbol = "@\"" + raw_name + "\"" }
                pilot collision: bool = false
                if index >= 0 { collision = v4_codegen_llvm_body_symbol_index_contains(codegen_id, index, symbol) } else { collision = v4_codegen_llvm_native_namespace_linear_contains(codegen_id, symbol) }
                if collision { error = "native literal global symbol conflicts with callable symbol: " + symbol }
            }
            rvalue_id += 1
        }
        body_id = v4_codegen_llvm_next_emitted_body(mir_id, body_id + 1)
    }
    if index >= 0 { array_release(index) }
    give back error
}

-- Target checks read only sealed codegen facts. MIR/TY identities may already
-- have been reused, so neither authority is consulted during module queries.
-- Read the canonical target convention inventory once per query, avoiding a
-- fresh target-record construction for every declaration, call and body.
task v4_codegen_llvm_native_target_abi_error(abi: word, llvm_cc: word, supported: word, triple: word) -> word {
    pilot canonical = abi
    if canonical == "" { canonical = "C" }
    pilot known: bool = canonical == "C" or canonical == "cdecl" or canonical == "system" or canonical == "stdcall" or canonical == "fastcall" or canonical == "thiscall" or canonical == "vectorcall" or canonical == "win64" or canonical == "sysv64"
    if not known or not supported.contains("," + canonical + ",") {
        give back "native target calling convention not supported: " + canonical + " for " + triple
    }
    if llvm_cc != v4_codegen_llvm_calling_convention(abi) { give back "invalid sealed native calling convention metadata" }
    give back ""
}

task v4_codegen_llvm_sealed_body_calling_convention(line: word) -> word {
    if not line.starts_with("define ") { give back "" }
    pilot end_pos = 7
    repeat until end_pos >= line.length() or line.char_at(end_pos) == " " or line.char_at(end_pos) == "\n" or line.char_at(end_pos) == "\r" or line.char_at(end_pos) == "\t" {
        end_pos += 1
    }
    if end_pos <= 7 or end_pos >= line.length() or line.char_at(end_pos) != " " { give back "" }
    pilot cc = v4_slice(line, 7, end_pos)
    if cc == "ccc" or cc == "x86_stdcallcc" or cc == "x86_fastcallcc" or cc == "x86_thiscallcc" or cc == "x86_vectorcallcc" or cc == "win64cc" or cc == "x86_64_sysvcc" { give back cc }
    give back ""
}

task v4_codegen_llvm_abi_for_llvm_calling_convention(cc: word) -> word {
    if cc == "ccc" { give back "C" }
    if cc == "x86_stdcallcc" { give back "stdcall" }
    if cc == "x86_fastcallcc" { give back "fastcall" }
    if cc == "x86_thiscallcc" { give back "thiscall" }
    if cc == "x86_vectorcallcc" { give back "vectorcall" }
    if cc == "win64cc" { give back "win64" }
    if cc == "x86_64_sysvcc" { give back "sysv64" }
    give back ""
}

task v4_codegen_llvm_native_target_error(codegen_id: int, target_spec: word) -> word {
    if not v4_target_spec_valid(target_spec) { give back "invalid native target specification" }
    if v4_codegen_llvm_ready == 0 or codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "invalid codegen ID" }
    pilot native_error = v4_codegen_llvm_native_module_error(codegen_id)
    if native_error != "" { give back native_error }
    if v4_codegen_llvm_diag_count(codegen_id) != 0 { give back "codegen diagnostics prevent native module" }
    pilot supported = "," + v4_target_spec_calling_conventions(target_spec) + ","
    pilot triple = v4_target_spec_triple(target_spec)
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
        native_error = v4_codegen_llvm_native_target_abi_error(v4_codegen_llvm_decl_abi(codegen_id, decl_id), v4_codegen_llvm_decl_cc(codegen_id, decl_id), supported, triple)
        if native_error != "" { give back native_error }
        decl_id += 1
    }
    pilot call_id = 0
    repeat until call_id >= v4_codegen_llvm_call_count(codegen_id) {
        native_error = v4_codegen_llvm_native_target_abi_error(v4_codegen_llvm_call_abi(codegen_id, call_id), v4_codegen_llvm_call_cc(codegen_id, call_id), supported, triple)
        if native_error != "" { give back native_error }
        call_id += 1
    }
    pilot body_id = 0
    repeat until body_id >= v4_codegen_llvm_body_count(codegen_id) {
        pilot cc = v4_codegen_llvm_sealed_body_calling_convention(v4_codegen_llvm_body_line(codegen_id, body_id))
        if cc == "" { give back "invalid sealed native body calling convention" }
        native_error = v4_codegen_llvm_native_target_abi_error(v4_codegen_llvm_abi_for_llvm_calling_convention(cc), cc, supported, triple)
        if native_error != "" { give back native_error }
        body_id += 1
    }
    native_error = v4_codegen_llvm_c_width_target_error(codegen_id, target_spec)
    if native_error != "" { give back native_error }
    native_error = v4_codegen_llvm_c_call_target_error(codegen_id, target_spec)
    if native_error != "" { give back native_error }
    give back v4_codegen_llvm_shape_layout_error(array_get(v4_codegen_llvm_shape_lines, codegen_id), target_spec)
}

task v4_codegen_llvm_runtime_symbol_error(codegen_id: int, symbol: word, params: word) -> word {
    if v4_codegen_llvm_body_symbol_linear_contains(codegen_id, symbol) { give back "native runtime declaration conflicts with " + symbol }
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
        if v4_codegen_llvm_decl_symbol(codegen_id, decl_id) == symbol {
            if not v4_codegen_llvm_starts_with(v4_codegen_llvm_decl_line(codegen_id, decl_id), "declare ") or v4_codegen_llvm_decl_return(codegen_id, decl_id) != "void" or v4_codegen_llvm_decl_cc(codegen_id, decl_id) != "ccc" or v4_codegen_llvm_decl_params(codegen_id, decl_id) != params or (not v4_ty_is_language_abi(v4_codegen_llvm_decl_abi(codegen_id, decl_id)) and not v4_ty_is_calling_convention_abi(v4_codegen_llvm_decl_abi(codegen_id, decl_id))) {
                give back "native runtime declaration conflicts with " + symbol
            }
        }
        decl_id += 1
    }
    give back ""
}

-- A bootstrap program trusts the runtime's cached scalar counts, which V1
-- words effectively had; strict programs revalidate UTF-8 on every read.
task v4_codegen_llvm_bootstrap_entry_line(mir_id: int) -> word {
    if v4_ty_file_is_bootstrap(v4_mir_ty_id(mir_id)) { give back "  call void @freak_v4_word_v1_mode()\n" }
    give back ""
}

task v4_codegen_llvm_native_entry(mir_id: int) -> word {
    pilot main_id = v4_codegen_llvm_find_mir_body(mir_id, "main")
    -- A bootstrap-mode script without main runs its root statements only.
    if main_id < 0 and v4_mir_module_init_body(mir_id) >= 0 {
        pilot script = "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n"
        script = script + "  %argc.ext = sext i32 %argc to i64\n  %argv.int = ptrtoint ptr %argv to i64\n"
        script = script + "  call void @freak_llvm_setup_args(i64 %argc.ext, i64 %argv.int)\n"
        script = script + v4_codegen_llvm_bootstrap_entry_line(mir_id)
        if v4_codegen_llvm_mir_uses_typed_process(mir_id) { script = script + "  call void @freak_v4_process_setup_args(i64 %argc.ext, i64 %argv.int)\n" }
        script = script + "  call void " + v4_codegen_llvm_callable_symbol(mir_id, v4_mir_module_init_name) + "()\n"
        give back script + v4_codegen_llvm_global_release_lines(mir_id) + "  ret i32 0\n}\n"
    }
    if main_id < 0 { give back "" }
    pilot out = "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n"
    out = out + "  %argc.ext = sext i32 %argc to i64\n  %argv.int = ptrtoint ptr %argv to i64\n"
    out = out + "  call void @freak_llvm_setup_args(i64 %argc.ext, i64 %argv.int)\n"
    out = out + v4_codegen_llvm_bootstrap_entry_line(mir_id)
    if v4_codegen_llvm_mir_uses_typed_process(mir_id) { out = out + "  call void @freak_v4_process_setup_args(i64 %argc.ext, i64 %argv.int)\n" }
    -- Bootstrap mode: globals and root statements run once, before main.
    if v4_mir_module_init_body(mir_id) >= 0 { out = out + "  call void " + v4_codegen_llvm_callable_symbol(mir_id, v4_mir_module_init_name) + "()\n" }
    pilot cc = v4_codegen_llvm_calling_convention(v4_mir_body_callable_abi(mir_id, main_id))
    pilot fini = v4_codegen_llvm_global_release_lines(mir_id)
    if v4_mir_body_callable_return_type(mir_id, main_id) == v4_ty_never {
        out = out + "  call " + cc + " void @freak.user.main() noreturn\n  unreachable\n"
    } else if v4_mir_body_callable_return_type(mir_id, main_id) == v4_ty_void {
        out = out + "  call " + cc + " void @freak.user.main()\n" + fini + "  ret i32 0\n"
    } else {
        out = out + "  %rc = call " + cc + " i64 @freak.user.main()\n" + fini + "  %rc32 = trunc i64 %rc to i32\n  ret i32 %rc32\n"
    }
    give back out + "}\n"
}

-- After a normal return from main, word globals release their owners.
task v4_codegen_llvm_global_release_lines(mir_id: int) -> word {
    pilot out = ""
    pilot idx = 0
    repeat until idx >= v4_mir_global_count(mir_id) {
        if v4_mir_global_ty(mir_id, idx) == v4_ty_word {
            pilot symbol = v4_codegen_llvm_global_symbol(v4_mir_global_name(mir_id, idx))
            pilot held = "%global.fini." + word_from_int(idx)
            out = out + "  " + held + " = load i64, ptr " + symbol + "\n  call void @freak_v4_word_drop(i64 " + held + ")\n  store i64 0, ptr " + symbol + "\n"
        }
        idx += 1
    }
    -- Arrays still alive at exit drop their cells, so the ownership audit sees
    -- only words the program itself leaked.
    if v4_codegen_llvm_mir_uses_bootstrap_intrinsics(mir_id) { out = out + "  call void @freak_v4_compiler_array_shutdown()\n" }
    give back out
}

-- Target selection stays explicit. Definition headers in the declaration plan
-- are metadata; only external declarations and complete bodies enter a module.
task v4_codegen_llvm_module_text(codegen_id: int, target_spec: word) -> word {
    if not v4_target_spec_valid(target_spec) { give back "" }
    if codegen_id < 0 or codegen_id >= array_len(v4_codegen_llvm_files) { give back "" }
    if v4_codegen_llvm_diag_count(codegen_id) != 0 { give back "" }
    if v4_codegen_llvm_native_target_error(codegen_id, target_spec) != "" { give back "" }
    pilot parts = v4_codegen_llvm_fragment_new()
    v4_codegen_llvm_fragment_push(parts, "target triple = \"" + v4_target_spec_triple(target_spec) + "\"\n\n")
    pilot entry: word = array_get(v4_codegen_llvm_native_entry_lines, codegen_id)
    if entry != "" { v4_codegen_llvm_fragment_push(parts, "declare void @freak_llvm_setup_args(i64, i64)\n") }
    pilot globals: word = array_get(v4_codegen_llvm_word_global_lines, codegen_id)
    if globals != "" {
        v4_codegen_llvm_fragment_push(parts, "declare void @freak_llvm_say(i64)\n")
        v4_codegen_llvm_fragment_push(parts, globals)
    }
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_shape_module_lines(array_get(v4_codegen_llvm_shape_lines, codegen_id), target_spec))
    v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_dyn_resolve(array_get(v4_codegen_llvm_word_runtime_lines, codegen_id), array_get(v4_codegen_llvm_shape_lines, codegen_id), target_spec))
    pilot declaration_index = v4_codegen_llvm_decl_symbol_index_new(codegen_id)
    pilot c_width_used: bool = false
    pilot decl_id = 0
    repeat until decl_id >= v4_codegen_llvm_decl_count(codegen_id) {
        pilot line = v4_codegen_llvm_decl_line(codegen_id, decl_id)
        pilot symbol = v4_codegen_llvm_decl_symbol(codegen_id, decl_id)
        pilot supplied: bool = (entry != "" and symbol == "@freak_llvm_setup_args") or (globals != "" and symbol == "@freak_llvm_say")
        pilot first = decl_id
        if line.starts_with("declare ") {
            if declaration_index >= 0 { first = v4_codegen_llvm_decl_symbol_index_lookup(codegen_id, declaration_index, symbol) } else {
                pilot previous = v4_codegen_llvm_decl_symbol_previous(codegen_id, decl_id)
                if previous >= 0 { first = previous }
            }
        }
        if v4_codegen_llvm_starts_with(line, "declare ") and not supplied and first == decl_id {
            if v4_codegen_llvm_decl_has_c_width(codegen_id, decl_id) and v4_codegen_llvm_decl_params(codegen_id, decl_id).contains("...") {
                -- Variadic: no shim; call sites use the C call plan.
                v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_width_resolve_text(line, target_spec))
                v4_codegen_llvm_fragment_push(parts, "\n")
            } else if v4_codegen_llvm_decl_has_c_width(codegen_id, decl_id) {
                if not c_width_used { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_width_runtime_declarations()) }
                c_width_used = true
                v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_width_module_lines(codegen_id, decl_id, target_spec))
            } else {
                v4_codegen_llvm_fragment_push(parts, line)
                v4_codegen_llvm_fragment_push(parts, "\n")
            }
        }
        decl_id += 1
    }
    if declaration_index >= 0 { array_release(declaration_index) }
    pilot helpers_used: bool = false
    pilot body_id = 0
    repeat until body_id >= v4_codegen_llvm_body_count(codegen_id) {
        pilot body_text = v4_codegen_llvm_body_line(codegen_id, body_id)
        if body_text.contains("@freak.cabi.narrow.") or body_text.contains("@freak.cabi.widen.") { helpers_used = true }
        v4_codegen_llvm_fragment_push(parts, "\n")
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_abi_resolve(v4_codegen_llvm_c_width_resolve_text(body_text, target_spec), array_get(v4_codegen_llvm_shape_lines, codegen_id), target_spec))
        v4_codegen_llvm_fragment_push(parts, "\n")
        body_id += 1
    }
    if helpers_used {
        v4_codegen_llvm_fragment_push(parts, "\n")
        if not c_width_used { v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_width_runtime_declarations()) }
        v4_codegen_llvm_fragment_push(parts, v4_codegen_llvm_c_call_helper_lines(target_spec))
    }
    v4_codegen_llvm_fragment_push(parts, "\n")
    v4_codegen_llvm_fragment_push(parts, entry)
    give back v4_codegen_llvm_fragment_finish(parts)
}

task v4_codegen_llvm_find_decl(codegen_id: int, name: word) -> int {
    pilot decl_idx = 0
    pilot decl_count = v4_codegen_llvm_decl_count(codegen_id)
    repeat until decl_idx >= decl_count {
        if v4_codegen_llvm_decl_name(codegen_id, decl_idx) == name {
            give back decl_idx
        }
        decl_idx += 1
    }
    give back 0 - 1
}

task v4_codegen_llvm_find_call(codegen_id: int, body_name: word, callee_name: word) -> int {
    pilot call_idx = 0
    pilot call_count = v4_codegen_llvm_call_count(codegen_id)
    repeat until call_idx >= call_count {
        if v4_codegen_llvm_call_body(codegen_id, call_idx) == body_name and v4_codegen_llvm_call_name(codegen_id, call_idx) == callee_name {
            give back call_idx
        }
        call_idx += 1
    }
    give back 0 - 1
}

task v4_codegen_llvm_find_body(codegen_id: int, body_name: word) -> int {
    pilot body_idx = 0
    pilot body_count = v4_codegen_llvm_body_count(codegen_id)
    repeat until body_idx >= body_count {
        if v4_codegen_llvm_body_name(codegen_id, body_idx) == body_name {
            give back body_idx
        }
        body_idx += 1
    }
    give back 0 - 1
}

task v4_codegen_llvm_summary(codegen_id: int) -> word {
    pilot out = "codegen-llvm"
    out = out + " declarations=" + word_from_int(v4_codegen_llvm_decl_count(codegen_id))
    out = out + " calls=" + word_from_int(v4_codegen_llvm_call_count(codegen_id))
    out = out + " bodies=" + word_from_int(v4_codegen_llvm_body_count(codegen_id))
    out = out + " diagnostics=" + word_from_int(v4_codegen_llvm_diag_count(codegen_id))
    give back out
}


task v4_codegen_llvm_mir_has_panic(mir: int) -> bool {
    pilot body = 0
    body = v4_codegen_llvm_next_emitted_body(mir, body)
    repeat until body >= v4_mir_body_count(mir) {
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir, body) {
            if v4_mir_rvalue_is_builtin_control(mir, body, value) { give back true }
            value += 1
        }
        body = v4_codegen_llvm_next_emitted_body(mir, body + 1)
    }
    give back false
}

-- Default unwind ends the main sortie as panicked. Tier 1 programs have no
-- catch, eventually, sorties or user destructors, so nothing can observe the
-- cleanup an unwind would run; the helper flushes output and exits with 101.
-- Landing pads arrive with those features (and the A4 Runtime MIR transform).
-- --panic=abort keeps the reviewed abort helper.
task v4_codegen_llvm_panic_symbol() -> word {
    if v4_codegen_llvm_active_panic_policy == "unwind" { give back "@freak_v4_panic_unwind" }
    give back "@freak_v4_panic_abort"
}

task v4_codegen_llvm_panic_instruction(mir: int, body: int, value: int) -> word {
    pilot message = v4_mir_rvalue_call_arg(mir, body, value, 0)
    give back "call void " + v4_codegen_llvm_panic_symbol() + "(i64 " + v4_codegen_llvm_rvalue_value(mir, body, message) + ") noreturn"
}
