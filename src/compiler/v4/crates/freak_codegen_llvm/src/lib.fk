-- ===================================================================
-- freak_codegen_llvm - early V4 LLVM declaration and call-plan lowering
-- ===================================================================
-- Depends on freak_ty, freak_mir, and freak_borrowck.
-- This slice gives V4 a real backend-facing boundary: MIR and TY own
-- semantic facts, while codegen translates those facts into LLVM-facing
-- declarations and call plans without teaching the rest of the compiler
-- target spellings.

pilot v4_codegen_llvm_files = 0
pilot v4_codegen_llvm_mirs = 0
pilot v4_codegen_llvm_panic_policies = 0
pilot v4_codegen_llvm_decl_names = 0
pilot v4_codegen_llvm_decl_symbols = 0
pilot v4_codegen_llvm_decl_links = 0
pilot v4_codegen_llvm_decl_abis = 0
pilot v4_codegen_llvm_decl_ccs = 0
pilot v4_codegen_llvm_decl_returns = 0
pilot v4_codegen_llvm_decl_params = 0
pilot v4_codegen_llvm_decl_lines = 0
pilot v4_codegen_llvm_call_bodies = 0
pilot v4_codegen_llvm_call_names = 0
pilot v4_codegen_llvm_call_symbols = 0
pilot v4_codegen_llvm_call_links = 0
pilot v4_codegen_llvm_call_abis = 0
pilot v4_codegen_llvm_call_ccs = 0
pilot v4_codegen_llvm_call_returns = 0
pilot v4_codegen_llvm_call_exprs = 0
pilot v4_codegen_llvm_call_lines = 0
pilot v4_codegen_llvm_body_names = 0
pilot v4_codegen_llvm_body_symbols = 0
pilot v4_codegen_llvm_body_lines = 0
pilot v4_codegen_llvm_word_global_lines = 0
pilot v4_codegen_llvm_native_entry_lines = 0
pilot v4_codegen_llvm_word_runtime_lines = 0
pilot v4_codegen_llvm_numeric_runtime_used = false
pilot v4_codegen_llvm_fragment_error = ""
-- This transient mode is used only while sealing a fresh checked MIR plan.
-- Module readers consume sealed text and never revisit this mutable context.
pilot v4_codegen_llvm_active_owned_mir = 0 - 1
pilot v4_codegen_llvm_active_word_borrow = 0 - 1
pilot v4_codegen_llvm_native_errors = 0
pilot v4_codegen_llvm_diags = 0
pilot v4_codegen_llvm_ready = 0

-- Fragment scratch failure is an admission failure, never an empty cleanup
-- plan. A valid outer body buffer can outlive a failed nested allocation.
task v4_codegen_llvm_fragment_new() -> int {
    pilot parts = array_new()
    if parts < 0 and v4_codegen_llvm_fragment_error == "" { v4_codegen_llvm_fragment_error = "native LLVM fragment scratch allocation failed" }
    give back parts
}

task v4_codegen_llvm_cleanup_fragment_new() -> int {
    pilot parts = array_new()
    if parts < 0 and v4_codegen_llvm_fragment_error == "" { v4_codegen_llvm_fragment_error = "native owned word cleanup scratch allocation failed" }
    give back parts
}

task v4_codegen_llvm_fragment_push(parts: int, text: word) -> void {
    if parts < 0 {
        if v4_codegen_llvm_fragment_error == "" { v4_codegen_llvm_fragment_error = "native LLVM fragment scratch allocation failed" }
        give back
    }
    pilot before = array_len(parts)
    array_push(parts, text)
    if array_len(parts) != before + 1 and v4_codegen_llvm_fragment_error == "" { v4_codegen_llvm_fragment_error = "native LLVM fragment scratch append failed" }
}

task v4_codegen_llvm_fragment_finish(parts: int) -> word {
    -- word_join consumes the temporary collector and borrows its elements.
    give back word_join(parts)
}

task v4_codegen_llvm_init() -> void {
    if v4_codegen_llvm_ready != 0 { give back }
    v4_codegen_llvm_files = array_new()
    v4_codegen_llvm_mirs = array_new()
    v4_codegen_llvm_panic_policies = array_new()
    v4_codegen_llvm_decl_names = array_new()
    v4_codegen_llvm_decl_symbols = array_new()
    v4_codegen_llvm_decl_links = array_new()
    v4_codegen_llvm_decl_abis = array_new()
    v4_codegen_llvm_decl_ccs = array_new()
    v4_codegen_llvm_decl_returns = array_new()
    v4_codegen_llvm_decl_params = array_new()
    v4_codegen_llvm_decl_lines = array_new()
    v4_codegen_llvm_call_bodies = array_new()
    v4_codegen_llvm_call_names = array_new()
    v4_codegen_llvm_call_symbols = array_new()
    v4_codegen_llvm_call_links = array_new()
    v4_codegen_llvm_call_abis = array_new()
    v4_codegen_llvm_call_ccs = array_new()
    v4_codegen_llvm_call_returns = array_new()
    v4_codegen_llvm_call_exprs = array_new()
    v4_codegen_llvm_call_lines = array_new()
    v4_codegen_llvm_body_names = array_new()
    v4_codegen_llvm_body_symbols = array_new()
    v4_codegen_llvm_body_lines = array_new()
    v4_codegen_llvm_word_global_lines = array_new()
    v4_codegen_llvm_native_entry_lines = array_new()
    v4_codegen_llvm_word_runtime_lines = array_new()
    v4_codegen_llvm_native_errors = array_new()
    v4_codegen_llvm_diags = array_new()
    if v4_codegen_llvm_files < 0 or v4_codegen_llvm_mirs < 0 or v4_codegen_llvm_panic_policies < 0 or v4_codegen_llvm_decl_names < 0 or v4_codegen_llvm_decl_symbols < 0 or v4_codegen_llvm_decl_links < 0 or v4_codegen_llvm_decl_abis < 0 or v4_codegen_llvm_decl_ccs < 0 or v4_codegen_llvm_decl_returns < 0 or v4_codegen_llvm_decl_params < 0 or v4_codegen_llvm_decl_lines < 0 or v4_codegen_llvm_call_bodies < 0 or v4_codegen_llvm_call_names < 0 or v4_codegen_llvm_call_symbols < 0 or v4_codegen_llvm_call_links < 0 or v4_codegen_llvm_call_abis < 0 or v4_codegen_llvm_call_ccs < 0 or v4_codegen_llvm_call_returns < 0 or v4_codegen_llvm_call_exprs < 0 or v4_codegen_llvm_call_lines < 0 or v4_codegen_llvm_body_names < 0 or v4_codegen_llvm_body_symbols < 0 or v4_codegen_llvm_body_lines < 0 or v4_codegen_llvm_word_global_lines < 0 or v4_codegen_llvm_native_entry_lines < 0 or v4_codegen_llvm_word_runtime_lines < 0 or v4_codegen_llvm_native_errors < 0 or v4_codegen_llvm_diags < 0 {
        array_release(v4_codegen_llvm_files)
        v4_codegen_llvm_files = -1
        array_release(v4_codegen_llvm_mirs)
        v4_codegen_llvm_mirs = -1
        array_release(v4_codegen_llvm_panic_policies)
        v4_codegen_llvm_panic_policies = -1
        array_release(v4_codegen_llvm_decl_names)
        v4_codegen_llvm_decl_names = -1
        array_release(v4_codegen_llvm_decl_symbols)
        v4_codegen_llvm_decl_symbols = -1
        array_release(v4_codegen_llvm_decl_links)
        v4_codegen_llvm_decl_links = -1
        array_release(v4_codegen_llvm_decl_abis)
        v4_codegen_llvm_decl_abis = -1
        array_release(v4_codegen_llvm_decl_ccs)
        v4_codegen_llvm_decl_ccs = -1
        array_release(v4_codegen_llvm_decl_returns)
        v4_codegen_llvm_decl_returns = -1
        array_release(v4_codegen_llvm_decl_params)
        v4_codegen_llvm_decl_params = -1
        array_release(v4_codegen_llvm_decl_lines)
        v4_codegen_llvm_decl_lines = -1
        array_release(v4_codegen_llvm_call_bodies)
        v4_codegen_llvm_call_bodies = -1
        array_release(v4_codegen_llvm_call_names)
        v4_codegen_llvm_call_names = -1
        array_release(v4_codegen_llvm_call_symbols)
        v4_codegen_llvm_call_symbols = -1
        array_release(v4_codegen_llvm_call_links)
        v4_codegen_llvm_call_links = -1
        array_release(v4_codegen_llvm_call_abis)
        v4_codegen_llvm_call_abis = -1
        array_release(v4_codegen_llvm_call_ccs)
        v4_codegen_llvm_call_ccs = -1
        array_release(v4_codegen_llvm_call_returns)
        v4_codegen_llvm_call_returns = -1
        array_release(v4_codegen_llvm_call_exprs)
        v4_codegen_llvm_call_exprs = -1
        array_release(v4_codegen_llvm_call_lines)
        v4_codegen_llvm_call_lines = -1
        array_release(v4_codegen_llvm_body_names)
        v4_codegen_llvm_body_names = -1
        array_release(v4_codegen_llvm_body_symbols)
        v4_codegen_llvm_body_symbols = -1
        array_release(v4_codegen_llvm_body_lines)
        v4_codegen_llvm_body_lines = -1
        array_release(v4_codegen_llvm_word_global_lines)
        v4_codegen_llvm_word_global_lines = -1
        array_release(v4_codegen_llvm_native_entry_lines)
        v4_codegen_llvm_native_entry_lines = -1
        array_release(v4_codegen_llvm_word_runtime_lines)
        v4_codegen_llvm_word_runtime_lines = -1
        array_release(v4_codegen_llvm_native_errors)
        v4_codegen_llvm_native_errors = -1
        array_release(v4_codegen_llvm_diags)
        v4_codegen_llvm_diags = -1
        give back
    }
    v4_codegen_llvm_ready = 1
}

-- Every new result publishes all columns together. Failed child/outer
-- allocation leaves previous sealed results and their policies untouched.
task v4_codegen_llvm_stage_column(column: int, value: word) -> int {
    pilot staged = array_new()
    if staged < 0 { give back -1 }
    pilot row = 0
    repeat until row >= array_len(column) {
        pilot before = array_len(staged)
        array_push(staged, array_get(column, row))
        if array_len(staged) != before + 1 { array_release(staged); give back -1 }
        row += 1
    }
    pilot before = array_len(staged)
    array_push(staged, value)
    if array_len(staged) != before + 1 { array_release(staged); give back -1 }
    give back staged
}

task v4_codegen_llvm_file_new(file_id: int, mir_id: int) -> int {
    give back v4_codegen_llvm_file_new_with_panic(file_id, mir_id, "unwind")
}

task v4_codegen_llvm_file_new_with_panic(file_id: int, mir_id: int, policy: word) -> int {
    v4_codegen_llvm_init()
    if v4_codegen_llvm_ready == 0 { give back -2 }
    pilot codegen_id = array_len(v4_codegen_llvm_files)
    pilot child_decl_names = array_new()
    pilot child_decl_symbols = array_new()
    pilot child_decl_links = array_new()
    pilot child_decl_abis = array_new()
    pilot child_decl_ccs = array_new()
    pilot child_decl_returns = array_new()
    pilot child_decl_params = array_new()
    pilot child_decl_lines = array_new()
    pilot child_call_bodies = array_new()
    pilot child_call_names = array_new()
    pilot child_call_symbols = array_new()
    pilot child_call_links = array_new()
    pilot child_call_abis = array_new()
    pilot child_call_ccs = array_new()
    pilot child_call_returns = array_new()
    pilot child_call_exprs = array_new()
    pilot child_call_lines = array_new()
    pilot child_body_names = array_new()
    pilot child_body_symbols = array_new()
    pilot child_body_lines = array_new()
    pilot child_diags = array_new()
    if child_decl_names < 0 or child_decl_symbols < 0 or child_decl_links < 0 or child_decl_abis < 0 or child_decl_ccs < 0 or child_decl_returns < 0 or child_decl_params < 0 or child_decl_lines < 0 or child_call_bodies < 0 or child_call_names < 0 or child_call_symbols < 0 or child_call_links < 0 or child_call_abis < 0 or child_call_ccs < 0 or child_call_returns < 0 or child_call_exprs < 0 or child_call_lines < 0 or child_body_names < 0 or child_body_symbols < 0 or child_body_lines < 0 or child_diags < 0 {
        array_release(child_decl_names)
        array_release(child_decl_symbols)
        array_release(child_decl_links)
        array_release(child_decl_abis)
        array_release(child_decl_ccs)
        array_release(child_decl_returns)
        array_release(child_decl_params)
        array_release(child_decl_lines)
        array_release(child_call_bodies)
        array_release(child_call_names)
        array_release(child_call_symbols)
        array_release(child_call_links)
        array_release(child_call_abis)
        array_release(child_call_ccs)
        array_release(child_call_returns)
        array_release(child_call_exprs)
        array_release(child_call_lines)
        array_release(child_body_names)
        array_release(child_body_symbols)
        array_release(child_body_lines)
        array_release(child_diags)
        give back -2
    }
    pilot staged_files = v4_codegen_llvm_stage_column(v4_codegen_llvm_files, word_from_int(file_id))
    pilot staged_mirs = v4_codegen_llvm_stage_column(v4_codegen_llvm_mirs, word_from_int(mir_id))
    pilot staged_panic_policies = v4_codegen_llvm_stage_column(v4_codegen_llvm_panic_policies, policy)
    pilot staged_decl_names = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_names, word_from_int(child_decl_names))
    pilot staged_decl_symbols = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_symbols, word_from_int(child_decl_symbols))
    pilot staged_decl_links = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_links, word_from_int(child_decl_links))
    pilot staged_decl_abis = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_abis, word_from_int(child_decl_abis))
    pilot staged_decl_ccs = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_ccs, word_from_int(child_decl_ccs))
    pilot staged_decl_returns = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_returns, word_from_int(child_decl_returns))
    pilot staged_decl_params = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_params, word_from_int(child_decl_params))
    pilot staged_decl_lines = v4_codegen_llvm_stage_column(v4_codegen_llvm_decl_lines, word_from_int(child_decl_lines))
    pilot staged_call_bodies = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_bodies, word_from_int(child_call_bodies))
    pilot staged_call_names = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_names, word_from_int(child_call_names))
    pilot staged_call_symbols = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_symbols, word_from_int(child_call_symbols))
    pilot staged_call_links = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_links, word_from_int(child_call_links))
    pilot staged_call_abis = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_abis, word_from_int(child_call_abis))
    pilot staged_call_ccs = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_ccs, word_from_int(child_call_ccs))
    pilot staged_call_returns = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_returns, word_from_int(child_call_returns))
    pilot staged_call_exprs = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_exprs, word_from_int(child_call_exprs))
    pilot staged_call_lines = v4_codegen_llvm_stage_column(v4_codegen_llvm_call_lines, word_from_int(child_call_lines))
    pilot staged_body_names = v4_codegen_llvm_stage_column(v4_codegen_llvm_body_names, word_from_int(child_body_names))
    pilot staged_body_symbols = v4_codegen_llvm_stage_column(v4_codegen_llvm_body_symbols, word_from_int(child_body_symbols))
    pilot staged_body_lines = v4_codegen_llvm_stage_column(v4_codegen_llvm_body_lines, word_from_int(child_body_lines))
    pilot staged_word_global_lines = v4_codegen_llvm_stage_column(v4_codegen_llvm_word_global_lines, "")
    pilot staged_native_entry_lines = v4_codegen_llvm_stage_column(v4_codegen_llvm_native_entry_lines, "")
    pilot staged_word_runtime_lines = v4_codegen_llvm_stage_column(v4_codegen_llvm_word_runtime_lines, "")
    pilot staged_native_errors = v4_codegen_llvm_stage_column(v4_codegen_llvm_native_errors, "")
    pilot staged_diags = v4_codegen_llvm_stage_column(v4_codegen_llvm_diags, word_from_int(child_diags))
    if staged_files < 0 or staged_mirs < 0 or staged_panic_policies < 0 or staged_decl_names < 0 or staged_decl_symbols < 0 or staged_decl_links < 0 or staged_decl_abis < 0 or staged_decl_ccs < 0 or staged_decl_returns < 0 or staged_decl_params < 0 or staged_decl_lines < 0 or staged_call_bodies < 0 or staged_call_names < 0 or staged_call_symbols < 0 or staged_call_links < 0 or staged_call_abis < 0 or staged_call_ccs < 0 or staged_call_returns < 0 or staged_call_exprs < 0 or staged_call_lines < 0 or staged_body_names < 0 or staged_body_symbols < 0 or staged_body_lines < 0 or staged_word_global_lines < 0 or staged_native_entry_lines < 0 or staged_word_runtime_lines < 0 or staged_native_errors < 0 or staged_diags < 0 {
        array_release(staged_files)
        array_release(staged_mirs)
        array_release(staged_panic_policies)
        array_release(staged_decl_names)
        array_release(staged_decl_symbols)
        array_release(staged_decl_links)
        array_release(staged_decl_abis)
        array_release(staged_decl_ccs)
        array_release(staged_decl_returns)
        array_release(staged_decl_params)
        array_release(staged_decl_lines)
        array_release(staged_call_bodies)
        array_release(staged_call_names)
        array_release(staged_call_symbols)
        array_release(staged_call_links)
        array_release(staged_call_abis)
        array_release(staged_call_ccs)
        array_release(staged_call_returns)
        array_release(staged_call_exprs)
        array_release(staged_call_lines)
        array_release(staged_body_names)
        array_release(staged_body_symbols)
        array_release(staged_body_lines)
        array_release(staged_word_global_lines)
        array_release(staged_native_entry_lines)
        array_release(staged_word_runtime_lines)
        array_release(staged_native_errors)
        array_release(staged_diags)
        array_release(child_decl_names)
        array_release(child_decl_symbols)
        array_release(child_decl_links)
        array_release(child_decl_abis)
        array_release(child_decl_ccs)
        array_release(child_decl_returns)
        array_release(child_decl_params)
        array_release(child_decl_lines)
        array_release(child_call_bodies)
        array_release(child_call_names)
        array_release(child_call_symbols)
        array_release(child_call_links)
        array_release(child_call_abis)
        array_release(child_call_ccs)
        array_release(child_call_returns)
        array_release(child_call_exprs)
        array_release(child_call_lines)
        array_release(child_body_names)
        array_release(child_body_symbols)
        array_release(child_body_lines)
        array_release(child_diags)
        give back -2
    }
    pilot old_files = v4_codegen_llvm_files
    v4_codegen_llvm_files = staged_files
    pilot old_mirs = v4_codegen_llvm_mirs
    v4_codegen_llvm_mirs = staged_mirs
    pilot old_panic_policies = v4_codegen_llvm_panic_policies
    v4_codegen_llvm_panic_policies = staged_panic_policies
    pilot old_decl_names = v4_codegen_llvm_decl_names
    v4_codegen_llvm_decl_names = staged_decl_names
    pilot old_decl_symbols = v4_codegen_llvm_decl_symbols
    v4_codegen_llvm_decl_symbols = staged_decl_symbols
    pilot old_decl_links = v4_codegen_llvm_decl_links
    v4_codegen_llvm_decl_links = staged_decl_links
    pilot old_decl_abis = v4_codegen_llvm_decl_abis
    v4_codegen_llvm_decl_abis = staged_decl_abis
    pilot old_decl_ccs = v4_codegen_llvm_decl_ccs
    v4_codegen_llvm_decl_ccs = staged_decl_ccs
    pilot old_decl_returns = v4_codegen_llvm_decl_returns
    v4_codegen_llvm_decl_returns = staged_decl_returns
    pilot old_decl_params = v4_codegen_llvm_decl_params
    v4_codegen_llvm_decl_params = staged_decl_params
    pilot old_decl_lines = v4_codegen_llvm_decl_lines
    v4_codegen_llvm_decl_lines = staged_decl_lines
    pilot old_call_bodies = v4_codegen_llvm_call_bodies
    v4_codegen_llvm_call_bodies = staged_call_bodies
    pilot old_call_names = v4_codegen_llvm_call_names
    v4_codegen_llvm_call_names = staged_call_names
    pilot old_call_symbols = v4_codegen_llvm_call_symbols
    v4_codegen_llvm_call_symbols = staged_call_symbols
    pilot old_call_links = v4_codegen_llvm_call_links
    v4_codegen_llvm_call_links = staged_call_links
    pilot old_call_abis = v4_codegen_llvm_call_abis
    v4_codegen_llvm_call_abis = staged_call_abis
    pilot old_call_ccs = v4_codegen_llvm_call_ccs
    v4_codegen_llvm_call_ccs = staged_call_ccs
    pilot old_call_returns = v4_codegen_llvm_call_returns
    v4_codegen_llvm_call_returns = staged_call_returns
    pilot old_call_exprs = v4_codegen_llvm_call_exprs
    v4_codegen_llvm_call_exprs = staged_call_exprs
    pilot old_call_lines = v4_codegen_llvm_call_lines
    v4_codegen_llvm_call_lines = staged_call_lines
    pilot old_body_names = v4_codegen_llvm_body_names
    v4_codegen_llvm_body_names = staged_body_names
    pilot old_body_symbols = v4_codegen_llvm_body_symbols
    v4_codegen_llvm_body_symbols = staged_body_symbols
    pilot old_body_lines = v4_codegen_llvm_body_lines
    v4_codegen_llvm_body_lines = staged_body_lines
    pilot old_word_global_lines = v4_codegen_llvm_word_global_lines
    v4_codegen_llvm_word_global_lines = staged_word_global_lines
    pilot old_native_entry_lines = v4_codegen_llvm_native_entry_lines
    v4_codegen_llvm_native_entry_lines = staged_native_entry_lines
    pilot old_word_runtime_lines = v4_codegen_llvm_word_runtime_lines
    v4_codegen_llvm_word_runtime_lines = staged_word_runtime_lines
    pilot old_native_errors = v4_codegen_llvm_native_errors
    v4_codegen_llvm_native_errors = staged_native_errors
    pilot old_diags = v4_codegen_llvm_diags
    v4_codegen_llvm_diags = staged_diags
    array_release(old_files)
    array_release(old_mirs)
    array_release(old_panic_policies)
    array_release(old_decl_names)
    array_release(old_decl_symbols)
    array_release(old_decl_links)
    array_release(old_decl_abis)
    array_release(old_decl_ccs)
    array_release(old_decl_returns)
    array_release(old_decl_params)
    array_release(old_decl_lines)
    array_release(old_call_bodies)
    array_release(old_call_names)
    array_release(old_call_symbols)
    array_release(old_call_links)
    array_release(old_call_abis)
    array_release(old_call_ccs)
    array_release(old_call_returns)
    array_release(old_call_exprs)
    array_release(old_call_lines)
    array_release(old_body_names)
    array_release(old_body_symbols)
    array_release(old_body_lines)
    array_release(old_word_global_lines)
    array_release(old_native_entry_lines)
    array_release(old_word_runtime_lines)
    array_release(old_native_errors)
    array_release(old_diags)
    give back codegen_id
}

