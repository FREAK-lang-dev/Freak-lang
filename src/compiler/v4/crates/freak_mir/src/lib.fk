task v4_mir_snapshot_summary() -> word {
    pilot summary = "mir-snapshot"
    summary = summary + " format=" + v4_mir_snapshot_format
    summary = summary + " files=" + word_from_int(v4_mir_file_count())
    summary = summary + " bodies=" + word_from_int(v4_mir_snapshot_body_total())
    summary = summary + " blocks=" + word_from_int(v4_mir_snapshot_block_total())
    summary = summary + " locals=" + word_from_int(v4_mir_snapshot_local_total())
    summary = summary + " statements=" + word_from_int(v4_mir_snapshot_stmt_total())
    summary = summary + " places=" + word_from_int(v4_mir_snapshot_place_total())
    summary = summary + " rvalues=" + word_from_int(v4_mir_snapshot_rvalue_total())
    summary = summary + " diagnostics=" + word_from_int(v4_mir_snapshot_diag_total())
    give back summary
}

task v4_mir_snapshot_header() -> word {
    pilot out = "mir-snapshot"
    out = out + "|format=" + v4_mir_snapshot_format
    out = out + "|files=" + word_from_int(v4_mir_file_count())
    out = out + "|bodies=" + word_from_int(v4_mir_snapshot_body_total())
    out = out + "|blocks=" + word_from_int(v4_mir_snapshot_block_total())
    out = out + "|locals=" + word_from_int(v4_mir_snapshot_local_total())
    out = out + "|statements=" + word_from_int(v4_mir_snapshot_stmt_total())
    out = out + "|places=" + word_from_int(v4_mir_snapshot_place_total())
    out = out + "|rvalues=" + word_from_int(v4_mir_snapshot_rvalue_total())
    out = out + "|diagnostics=" + word_from_int(v4_mir_snapshot_diag_total())
    give back out
}

