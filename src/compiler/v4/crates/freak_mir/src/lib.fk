    array_release(word_to_int(array_get(v4_mir_rvalue_args_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_args_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_builtin_methods_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_builtin_methods_index_handle(mir_id), body_id, "-1")
