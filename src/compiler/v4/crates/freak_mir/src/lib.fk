pilot v4_mir_place_deref = "Deref"
-- A bootstrap-mode root `pilot` global: text is its name, no base or index.
pilot v4_mir_place_global = "Global"
pilot v4_mir_place_return = "Return"
pilot v4_mir_place_unknown = "Unknown"
pilot v4_mir_snapshot_format = "freak-mir-snapshot-v10"
pilot v4_mir_sum_visit_budget = 0

pilot v4_mir_files = 0
