task v4_mir_init() -> void {
    if v4_mir_ready == 0 {
        v4_mir_files = array_new()
        v4_mir_tys = array_new()
        v4_mir_body_defs = array_new()
        v4_mir_body_names = array_new()
        v4_mir_body_sigs = array_new()
        v4_mir_body_blocks = array_new()
        v4_mir_body_local_names = array_new()
        v4_mir_body_local_tys = array_new()
        v4_mir_body_local_modes = array_new()
        v4_mir_body_local_spans = array_new()
        v4_mir_body_local_scope_spans = array_new()
        v4_mir_body_stmt_kinds = array_new()
        v4_mir_body_stmt_lhs = array_new()
        v4_mir_body_stmt_rhs = array_new()
        v4_mir_body_stmt_spans = array_new()
        v4_mir_body_stmt_scope_spans = array_new()
        v4_mir_body_stmt_blocks = array_new()
        v4_mir_body_stmt_places = array_new()
        v4_mir_body_stmt_rvalues = array_new()
        v4_mir_body_place_kinds = array_new()
        v4_mir_body_place_texts = array_new()
        v4_mir_body_place_bases = array_new()
        v4_mir_body_place_fields = array_new()
        v4_mir_body_place_indices = array_new()
        v4_mir_body_place_spans = array_new()
        v4_mir_body_place_tys = array_new()
        v4_mir_body_rvalue_kinds = array_new()
        v4_mir_body_rvalue_texts = array_new()
        v4_mir_body_rvalue_ops = array_new()
        v4_mir_body_rvalue_lhs = array_new()
        v4_mir_body_rvalue_rhs = array_new()
        v4_mir_body_rvalue_spans = array_new()
        v4_mir_body_rvalue_tys = array_new()
        v4_mir_body_rvalue_abis = array_new()
        v4_mir_body_rvalue_args = array_new()
        v4_mir_body_rvalue_builtin_methods = array_new()
        v4_mir_diags = array_new()
        if v4_mir_files < 0 or v4_mir_tys < 0 or v4_mir_body_defs < 0 or v4_mir_body_names < 0 or v4_mir_body_sigs < 0 or v4_mir_body_blocks < 0 or v4_mir_body_local_names < 0 or v4_mir_body_local_tys < 0 or v4_mir_body_local_modes < 0 or v4_mir_body_local_spans < 0 or v4_mir_body_local_scope_spans < 0 or v4_mir_body_stmt_kinds < 0 or v4_mir_body_stmt_lhs < 0 or v4_mir_body_stmt_rhs < 0 or v4_mir_body_stmt_spans < 0 or v4_mir_body_stmt_scope_spans < 0 or v4_mir_body_stmt_blocks < 0 or v4_mir_body_stmt_places < 0 or v4_mir_body_stmt_rvalues < 0 or v4_mir_body_place_kinds < 0 or v4_mir_body_place_texts < 0 or v4_mir_body_place_bases < 0 or v4_mir_body_place_fields < 0 or v4_mir_body_place_indices < 0 or v4_mir_body_place_spans < 0 or v4_mir_body_place_tys < 0 or v4_mir_body_rvalue_kinds < 0 or v4_mir_body_rvalue_texts < 0 or v4_mir_body_rvalue_ops < 0 or v4_mir_body_rvalue_lhs < 0 or v4_mir_body_rvalue_rhs < 0 or v4_mir_body_rvalue_spans < 0 or v4_mir_body_rvalue_tys < 0 or v4_mir_body_rvalue_abis < 0 or v4_mir_body_rvalue_args < 0 or v4_mir_body_rvalue_builtin_methods < 0 or v4_mir_diags < 0 {
            array_release(v4_mir_files)
            v4_mir_files = -1
            array_release(v4_mir_tys)
            v4_mir_tys = -1
            array_release(v4_mir_body_defs)
            v4_mir_body_defs = -1
            array_release(v4_mir_body_names)
            v4_mir_body_names = -1
            array_release(v4_mir_body_sigs)
            v4_mir_body_sigs = -1
            array_release(v4_mir_body_blocks)
            v4_mir_body_blocks = -1
            array_release(v4_mir_body_local_names)
            v4_mir_body_local_names = -1
            array_release(v4_mir_body_local_tys)
            v4_mir_body_local_tys = -1
            array_release(v4_mir_body_local_modes)
            v4_mir_body_local_modes = -1
            array_release(v4_mir_body_local_spans)
            v4_mir_body_local_spans = -1
            array_release(v4_mir_body_local_scope_spans)
            v4_mir_body_local_scope_spans = -1
            array_release(v4_mir_body_stmt_kinds)
            v4_mir_body_stmt_kinds = -1
            array_release(v4_mir_body_stmt_lhs)
            v4_mir_body_stmt_lhs = -1
            array_release(v4_mir_body_stmt_rhs)
            v4_mir_body_stmt_rhs = -1
            array_release(v4_mir_body_stmt_spans)
            v4_mir_body_stmt_spans = -1
            array_release(v4_mir_body_stmt_scope_spans)
            v4_mir_body_stmt_scope_spans = -1
            array_release(v4_mir_body_stmt_blocks)
            v4_mir_body_stmt_blocks = -1
            array_release(v4_mir_body_stmt_places)
            v4_mir_body_stmt_places = -1
            array_release(v4_mir_body_stmt_rvalues)
            v4_mir_body_stmt_rvalues = -1
            array_release(v4_mir_body_place_kinds)
            v4_mir_body_place_kinds = -1
            array_release(v4_mir_body_place_texts)
            v4_mir_body_place_texts = -1
            array_release(v4_mir_body_place_bases)
            v4_mir_body_place_bases = -1
            array_release(v4_mir_body_place_fields)
            v4_mir_body_place_fields = -1
            array_release(v4_mir_body_place_indices)
            v4_mir_body_place_indices = -1
            array_release(v4_mir_body_place_spans)
            v4_mir_body_place_spans = -1
            array_release(v4_mir_body_place_tys)
            v4_mir_body_place_tys = -1
            array_release(v4_mir_body_rvalue_kinds)
            v4_mir_body_rvalue_kinds = -1
            array_release(v4_mir_body_rvalue_texts)
            v4_mir_body_rvalue_texts = -1
            array_release(v4_mir_body_rvalue_ops)
            v4_mir_body_rvalue_ops = -1
            array_release(v4_mir_body_rvalue_lhs)
            v4_mir_body_rvalue_lhs = -1
            array_release(v4_mir_body_rvalue_rhs)
            v4_mir_body_rvalue_rhs = -1
            array_release(v4_mir_body_rvalue_spans)
            v4_mir_body_rvalue_spans = -1
            array_release(v4_mir_body_rvalue_tys)
            v4_mir_body_rvalue_tys = -1
            array_release(v4_mir_body_rvalue_abis)
            v4_mir_body_rvalue_abis = -1
            array_release(v4_mir_body_rvalue_args)
            v4_mir_body_rvalue_args = -1
            array_release(v4_mir_body_rvalue_builtin_methods)
            v4_mir_body_rvalue_builtin_methods = -1
            array_release(v4_mir_diags)
            v4_mir_diags = -1
            give back
        }
        v4_mir_ready = 1
        v4_mir_lookup_outer_ensure()
    }
}

task v4_mir_file_new(file_id: int, ty_id: int) -> int {
    v4_mir_init()
    if v4_mir_ready == 0 { give back -1 }
    pilot mir_id = array_len(v4_mir_files)
    pilot new_v4_mir_body_defs = array_new()
    pilot new_v4_mir_body_names = array_new()
    pilot new_v4_mir_body_sigs = array_new()
    pilot new_v4_mir_body_blocks = array_new()
    pilot new_v4_mir_body_local_names = array_new()
    pilot new_v4_mir_body_local_tys = array_new()
    pilot new_v4_mir_body_local_modes = array_new()
    pilot new_v4_mir_body_local_spans = array_new()
    pilot new_v4_mir_body_local_scope_spans = array_new()
    pilot new_v4_mir_body_stmt_kinds = array_new()
    pilot new_v4_mir_body_stmt_lhs = array_new()
    pilot new_v4_mir_body_stmt_rhs = array_new()
    pilot new_v4_mir_body_stmt_spans = array_new()
    pilot new_v4_mir_body_stmt_scope_spans = array_new()
    pilot new_v4_mir_body_stmt_blocks = array_new()
    pilot new_v4_mir_body_stmt_places = array_new()
    pilot new_v4_mir_body_stmt_rvalues = array_new()
    pilot new_v4_mir_body_place_kinds = array_new()
    pilot new_v4_mir_body_place_texts = array_new()
    pilot new_v4_mir_body_place_bases = array_new()
    pilot new_v4_mir_body_place_fields = array_new()
    pilot new_v4_mir_body_place_indices = array_new()
    pilot new_v4_mir_body_place_spans = array_new()
    pilot new_v4_mir_body_place_tys = array_new()
    pilot new_v4_mir_body_rvalue_kinds = array_new()
    pilot new_v4_mir_body_rvalue_texts = array_new()
    pilot new_v4_mir_body_rvalue_ops = array_new()
    pilot new_v4_mir_body_rvalue_lhs = array_new()
    pilot new_v4_mir_body_rvalue_rhs = array_new()
    pilot new_v4_mir_body_rvalue_spans = array_new()
    pilot new_v4_mir_body_rvalue_tys = array_new()
    pilot new_v4_mir_body_rvalue_abis = array_new()
    pilot new_v4_mir_body_rvalue_args = array_new()
    pilot new_v4_mir_body_rvalue_builtin_methods = array_new()
    pilot new_v4_mir_diags = array_new()
    if new_v4_mir_body_defs < 0 or new_v4_mir_body_names < 0 or new_v4_mir_body_sigs < 0 or new_v4_mir_body_blocks < 0 or new_v4_mir_body_local_names < 0 or new_v4_mir_body_local_tys < 0 or new_v4_mir_body_local_modes < 0 or new_v4_mir_body_local_spans < 0 or new_v4_mir_body_local_scope_spans < 0 or new_v4_mir_body_stmt_kinds < 0 or new_v4_mir_body_stmt_lhs < 0 or new_v4_mir_body_stmt_rhs < 0 or new_v4_mir_body_stmt_spans < 0 or new_v4_mir_body_stmt_scope_spans < 0 or new_v4_mir_body_stmt_blocks < 0 or new_v4_mir_body_stmt_places < 0 or new_v4_mir_body_stmt_rvalues < 0 or new_v4_mir_body_place_kinds < 0 or new_v4_mir_body_place_texts < 0 or new_v4_mir_body_place_bases < 0 or new_v4_mir_body_place_fields < 0 or new_v4_mir_body_place_indices < 0 or new_v4_mir_body_place_spans < 0 or new_v4_mir_body_place_tys < 0 or new_v4_mir_body_rvalue_kinds < 0 or new_v4_mir_body_rvalue_texts < 0 or new_v4_mir_body_rvalue_ops < 0 or new_v4_mir_body_rvalue_lhs < 0 or new_v4_mir_body_rvalue_rhs < 0 or new_v4_mir_body_rvalue_spans < 0 or new_v4_mir_body_rvalue_tys < 0 or new_v4_mir_body_rvalue_abis < 0 or new_v4_mir_body_rvalue_args < 0 or new_v4_mir_body_rvalue_builtin_methods < 0 or new_v4_mir_diags < 0 {
        array_release(new_v4_mir_body_defs)
        array_release(new_v4_mir_body_names)
        array_release(new_v4_mir_body_sigs)
        array_release(new_v4_mir_body_blocks)
        array_release(new_v4_mir_body_local_names)
        array_release(new_v4_mir_body_local_tys)
        array_release(new_v4_mir_body_local_modes)
        array_release(new_v4_mir_body_local_spans)
        array_release(new_v4_mir_body_local_scope_spans)
        array_release(new_v4_mir_body_stmt_kinds)
        array_release(new_v4_mir_body_stmt_lhs)
        array_release(new_v4_mir_body_stmt_rhs)
        array_release(new_v4_mir_body_stmt_spans)
        array_release(new_v4_mir_body_stmt_scope_spans)
        array_release(new_v4_mir_body_stmt_blocks)
        array_release(new_v4_mir_body_stmt_places)
        array_release(new_v4_mir_body_stmt_rvalues)
        array_release(new_v4_mir_body_place_kinds)
        array_release(new_v4_mir_body_place_texts)
        array_release(new_v4_mir_body_place_bases)
        array_release(new_v4_mir_body_place_fields)
        array_release(new_v4_mir_body_place_indices)
        array_release(new_v4_mir_body_place_spans)
        array_release(new_v4_mir_body_place_tys)
        array_release(new_v4_mir_body_rvalue_kinds)
        array_release(new_v4_mir_body_rvalue_texts)
        array_release(new_v4_mir_body_rvalue_ops)
        array_release(new_v4_mir_body_rvalue_lhs)
        array_release(new_v4_mir_body_rvalue_rhs)
        array_release(new_v4_mir_body_rvalue_spans)
        array_release(new_v4_mir_body_rvalue_tys)
        array_release(new_v4_mir_body_rvalue_abis)
        array_release(new_v4_mir_body_rvalue_args)
        array_release(new_v4_mir_body_rvalue_builtin_methods)
        array_release(new_v4_mir_diags)
        give back -1
    }
    array_push(v4_mir_files, word_from_int(file_id))
    array_push(v4_mir_tys, word_from_int(ty_id))
    array_push(v4_mir_body_defs, word_from_int(new_v4_mir_body_defs))
    array_push(v4_mir_body_names, word_from_int(new_v4_mir_body_names))
    array_push(v4_mir_body_sigs, word_from_int(new_v4_mir_body_sigs))
    array_push(v4_mir_body_blocks, word_from_int(new_v4_mir_body_blocks))
    array_push(v4_mir_body_local_names, word_from_int(new_v4_mir_body_local_names))
    array_push(v4_mir_body_local_tys, word_from_int(new_v4_mir_body_local_tys))
    array_push(v4_mir_body_local_modes, word_from_int(new_v4_mir_body_local_modes))
    array_push(v4_mir_body_local_spans, word_from_int(new_v4_mir_body_local_spans))
    array_push(v4_mir_body_local_scope_spans, word_from_int(new_v4_mir_body_local_scope_spans))
    array_push(v4_mir_body_stmt_kinds, word_from_int(new_v4_mir_body_stmt_kinds))
    array_push(v4_mir_body_stmt_lhs, word_from_int(new_v4_mir_body_stmt_lhs))
    array_push(v4_mir_body_stmt_rhs, word_from_int(new_v4_mir_body_stmt_rhs))
    array_push(v4_mir_body_stmt_spans, word_from_int(new_v4_mir_body_stmt_spans))
    array_push(v4_mir_body_stmt_scope_spans, word_from_int(new_v4_mir_body_stmt_scope_spans))
    array_push(v4_mir_body_stmt_blocks, word_from_int(new_v4_mir_body_stmt_blocks))
    array_push(v4_mir_body_stmt_places, word_from_int(new_v4_mir_body_stmt_places))
    array_push(v4_mir_body_stmt_rvalues, word_from_int(new_v4_mir_body_stmt_rvalues))
    array_push(v4_mir_body_place_kinds, word_from_int(new_v4_mir_body_place_kinds))
    array_push(v4_mir_body_place_texts, word_from_int(new_v4_mir_body_place_texts))
    array_push(v4_mir_body_place_bases, word_from_int(new_v4_mir_body_place_bases))
    array_push(v4_mir_body_place_fields, word_from_int(new_v4_mir_body_place_fields))
    array_push(v4_mir_body_place_indices, word_from_int(new_v4_mir_body_place_indices))
    array_push(v4_mir_body_place_spans, word_from_int(new_v4_mir_body_place_spans))
    array_push(v4_mir_body_place_tys, word_from_int(new_v4_mir_body_place_tys))
    array_push(v4_mir_body_rvalue_kinds, word_from_int(new_v4_mir_body_rvalue_kinds))
    array_push(v4_mir_body_rvalue_texts, word_from_int(new_v4_mir_body_rvalue_texts))
    array_push(v4_mir_body_rvalue_ops, word_from_int(new_v4_mir_body_rvalue_ops))
    array_push(v4_mir_body_rvalue_lhs, word_from_int(new_v4_mir_body_rvalue_lhs))
    array_push(v4_mir_body_rvalue_rhs, word_from_int(new_v4_mir_body_rvalue_rhs))
    array_push(v4_mir_body_rvalue_spans, word_from_int(new_v4_mir_body_rvalue_spans))
    array_push(v4_mir_body_rvalue_tys, word_from_int(new_v4_mir_body_rvalue_tys))
    array_push(v4_mir_body_rvalue_abis, word_from_int(new_v4_mir_body_rvalue_abis))
    array_push(v4_mir_body_rvalue_args, word_from_int(new_v4_mir_body_rvalue_args))
    array_push(v4_mir_body_rvalue_builtin_methods, word_from_int(new_v4_mir_body_rvalue_builtin_methods))
    array_push(v4_mir_diags, word_from_int(new_v4_mir_diags))
    if not v4_mir_restore_building {
        v4_mir_lookup_file_ensure(mir_id)
        v4_mir_finalize_body_lookup_index(mir_id)
    }
    give back mir_id
}

task v4_mir_lookup_outer_ensure() -> bool {
    if v4_mir_ready == 0 { give back false }
    if v4_mir_body_lookup_indexes >= 0 { give back true }
    pilot bodies = array_new()
    pilot blocks = array_new()
    pilot links = array_new()
    if bodies < 0 or blocks < 0 or links < 0 {
        array_release(bodies)
        array_release(blocks)
        array_release(links)
        give back false
    }
    v4_mir_body_lookup_indexes = bodies
    v4_mir_block_stmt_indexes = blocks
    v4_mir_stmt_next_indexes = links
    give back true
}

task v4_mir_lookup_ensure_slot(handle: int, slot: int, empty: word) -> bool {
    if handle < 0 or slot < 0 { give back false }
    repeat until array_len(handle) > slot {
        pilot before = array_len(handle)
        array_push(handle, empty)
        if array_len(handle) <= before { give back false }
    }
    give back true
}

task v4_mir_lookup_file_ensure(mir_id: int) -> bool {
    if not v4_mir_lookup_owner_exists(mir_id) or not v4_mir_lookup_outer_ensure() { give back false }
    repeat until array_len(v4_mir_body_lookup_indexes) > mir_id {
        array_push(v4_mir_body_lookup_indexes, "-1")
        array_push(v4_mir_block_stmt_indexes, "-1")
        array_push(v4_mir_stmt_next_indexes, "-1")
    }
    if word_to_int(array_get(v4_mir_body_lookup_indexes, mir_id)) < 0 {
        pilot packed = array_new()
        if packed >= 0 {
            array_push(packed, "0")
            array_push(packed, "0")
            array_push(packed, "0")
            array_set(v4_mir_body_lookup_indexes, mir_id, word_from_int(packed))
        }
    }
    if word_to_int(array_get(v4_mir_block_stmt_indexes, mir_id)) < 0 {
        pilot blocks = array_new()
        pilot links = array_new()
        if blocks < 0 or links < 0 {
            array_release(blocks)
            array_release(links)
            give back false
        }
        array_set(v4_mir_block_stmt_indexes, mir_id, word_from_int(blocks))
        array_set(v4_mir_stmt_next_indexes, mir_id, word_from_int(links))
    }
    give back true
}

task v4_mir_lookup_file_child(outer: int, mir_id: int) -> int {
    if v4_mir_ready == 0 or outer < 0 or mir_id < 0 or mir_id >= array_len(outer) { give back 0 - 1 }
    pilot stored: word = array_get(outer, mir_id)
    if stored == "" { give back 0 - 1 }
    give back word_to_int(stored)
}

task v4_mir_body_lookup_index_handle(mir_id: int) -> int {
    if not v4_mir_lookup_owner_exists(mir_id) { give back 0 - 1 }
    give back v4_mir_lookup_file_child(v4_mir_body_lookup_indexes, mir_id)
}

task v4_mir_block_stmt_index_handle(mir_id: int, body_id: int) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 - 1 }
    give back v4_mir_lookup_file_child(v4_mir_lookup_file_child(v4_mir_block_stmt_indexes, mir_id), body_id)
}

task v4_mir_stmt_next_index_handle(mir_id: int, body_id: int) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 - 1 }
    give back v4_mir_lookup_file_child(v4_mir_lookup_file_child(v4_mir_stmt_next_indexes, mir_id), body_id)
}

-- Noninitializing logical bounds must precede authoritative handle reads:
-- stale storage references must not stand in for an initialized MIR owner.
task v4_mir_lookup_owner_exists(mir_id: int) -> bool {
    if v4_mir_ready == 0 or mir_id < 0 { give back false }
    give back mir_id < array_len(v4_mir_files)
}

task v4_mir_lookup_body_exists(mir_id: int, body_id: int) -> bool {
    if not v4_mir_lookup_owner_exists(mir_id) or body_id < 0 { give back false }
    give back body_id < v4_mir_body_count(mir_id)
}

task v4_mir_invalidate_body_lookup_index(mir_id: int) -> void {
    pilot packed = v4_mir_body_lookup_index_handle(mir_id)
    if array_len(packed) >= 3 { array_set(packed, 0, "0") }
}

task v4_mir_invalidate_block_stmt_index(mir_id: int, body_id: int) -> void {
    pilot packed = v4_mir_block_stmt_index_handle(mir_id, body_id)
    if array_len(packed) >= 3 { array_set(packed, 0, "0") }
}

task v4_mir_body_lookup_index_is_ready(mir_id: int) -> bool {
    if not v4_mir_lookup_owner_exists(mir_id) { give back false }
    pilot packed = v4_mir_body_lookup_index_handle(mir_id)
    pilot ready: word = array_get(packed, 0)
    pilot capacity = word_to_int(array_get(packed, 1))
    give back array_len(packed) >= 3 and ready == "1" and capacity > 0 and capacity <= 536870912 and array_len(packed) >= 3 + 2 * capacity and word_to_int(array_get(packed, 2)) == v4_mir_body_count(mir_id)
}

task v4_mir_body_lookup_insert(mir_id: int, body_id: int) -> bool {
    -- A duplicate in either table must not suppress the other identity.
    if not v4_mir_body_lookup_insert_key(mir_id, body_id, false) { give back false }
    give back v4_mir_body_lookup_insert_key(mir_id, body_id, true)
}

task v4_mir_body_lookup_key(mir_id: int, body_id: int, by_name: bool) -> word {
    if by_name { give back v4_mir_body_name(mir_id, body_id) }
    give back v4_mir_body_def(mir_id, body_id)
}

task v4_mir_body_lookup_insert_key(mir_id: int, body_id: int, by_name: bool) -> bool {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back false }
    pilot packed = v4_mir_body_lookup_index_handle(mir_id)
    pilot capacity = word_to_int(array_get(packed, 1))
    if capacity <= 0 or capacity > 536870912 or array_len(packed) < 3 + 2 * capacity { give back false }
    pilot base = 3
    if by_name { base += capacity }
    pilot key = v4_mir_body_lookup_key(mir_id, body_id, by_name)
    pilot bucket: int = key.checksum() % capacity
    pilot visited = 0
    repeat until visited >= capacity {
        v4_mir_body_lookup_probes += 1
        pilot previous = word_to_int(array_get(packed, base + bucket)) - 1
        if previous < 0 {
            array_set(packed, base + bucket, word_from_int(body_id + 1))
            give back true
        }
        -- Physical insertion order retains the first exact duplicate.
        if v4_mir_body_lookup_key(mir_id, previous, by_name) == key { give back true }
        bucket = (bucket + 1) % capacity
        visited += 1
    }
    give back false
}

task v4_mir_finalize_body_lookup_index(mir_id: int) -> bool {
    if not v4_mir_lookup_file_ensure(mir_id) { give back false }
    pilot packed = v4_mir_body_lookup_index_handle(mir_id)
    if array_len(packed) < 3 { give back false }
    if v4_mir_body_lookup_index_is_ready(mir_id) { give back true }
    array_set(packed, 0, "0")
    pilot count = v4_mir_body_count(mir_id)
    if count > 268435455 { give back false }
    pilot capacity = word_to_int(array_get(packed, 1))
    if capacity < 16 { capacity = 16 }
    if capacity > 536870912 { give back false }
    repeat until capacity >= 2 * count { capacity *= 2 }
    if not v4_mir_lookup_ensure_slot(packed, 2 + 2 * capacity, "0") { give back false }
    array_set(packed, 1, word_from_int(capacity))
    pilot slot = 3
    repeat until slot >= 3 + 2 * capacity {
        array_set(packed, slot, "0")
        slot += 1
    }
    pilot body_id = 0
    repeat until body_id >= count {
        if not v4_mir_body_lookup_insert(mir_id, body_id) { give back false }
        v4_mir_body_lookup_build_records += 1
        body_id += 1
    }
    array_set(packed, 2, word_from_int(count))
    array_set(packed, 0, "1")
    give back true
}

task v4_mir_body_lookup_added(mir_id: int, body_id: int) -> void {
    pilot packed = v4_mir_body_lookup_index_handle(mir_id)
    pilot ready: word = array_get(packed, 0)
    if array_len(packed) < 3 or ready != "1" { give back }
    if word_to_int(array_get(packed, 2)) != body_id {
        v4_mir_invalidate_body_lookup_index(mir_id)
        give back
    }
    if word_to_int(array_get(packed, 1)) >= 2 * (body_id + 1) {
        if v4_mir_body_lookup_insert(mir_id, body_id) {
            array_set(packed, 2, word_from_int(body_id + 1))
            give back
        }
    }
    v4_mir_invalidate_body_lookup_index(mir_id)
    v4_mir_finalize_body_lookup_index(mir_id)
}

-- Block rows: first, last, total, then Return/Branch/Loop/Break/Continue/
-- LocalInit/Assign/Expr counts. Header: ready, active blocks, active statements.
task v4_mir_block_stmt_kind_slot(kind: word) -> int {
    if kind == v4_mir_stmt_return { give back 3 }
    if kind == v4_mir_stmt_branch { give back 4 }
    if kind == v4_mir_stmt_loop { give back 5 }
    if kind == v4_mir_stmt_break { give back 6 }
    if kind == v4_mir_stmt_continue { give back 7 }
    if kind == v4_mir_stmt_local { give back 8 }
    if kind == v4_mir_stmt_assign { give back 9 }
    if kind == v4_mir_stmt_expr { give back 10 }
    give back 0 - 1
}

task v4_mir_block_stmt_storage_ensure(mir_id: int, body_id: int) -> bool {
    if not v4_mir_lookup_body_exists(mir_id, body_id) or not v4_mir_lookup_file_ensure(mir_id) { give back false }
    pilot owners = v4_mir_lookup_file_child(v4_mir_block_stmt_indexes, mir_id)
    pilot link_owners = v4_mir_lookup_file_child(v4_mir_stmt_next_indexes, mir_id)
    repeat until array_len(owners) > body_id {
        array_push(owners, "-1")
        array_push(link_owners, "-1")
    }
    if v4_mir_block_stmt_index_handle(mir_id, body_id) >= 0 { give back true }
    pilot packed = array_new()
    pilot links = array_new()
    if packed < 0 or links < 0 {
        array_release(packed)
        array_release(links)
        give back false
    }
    array_push(packed, "0")
    array_push(packed, "0")
    array_push(packed, "0")
    array_set(owners, body_id, word_from_int(packed))
    array_set(link_owners, body_id, word_from_int(links))
    give back true
}

task v4_mir_block_stmt_index_is_ready(mir_id: int, body_id: int) -> bool {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back false }
    pilot packed = v4_mir_block_stmt_index_handle(mir_id, body_id)
    pilot ready: word = array_get(packed, 0)
    give back array_len(packed) >= 3 and ready == "1" and word_to_int(array_get(packed, 1)) == v4_mir_body_block_count(mir_id, body_id) and word_to_int(array_get(packed, 2)) == v4_mir_body_stmt_count(mir_id, body_id)
}

task v4_mir_block_stmt_append_link(mir_id: int, body_id: int, block_id: int, stmt_id: int) -> void {
    pilot packed = v4_mir_block_stmt_index_handle(mir_id, body_id)
    pilot links = v4_mir_stmt_next_index_handle(mir_id, body_id)
    pilot base = 3 + 11 * block_id
    pilot previous = word_to_int(array_get(packed, base + 1))
    if previous < 0 { array_set(packed, base, word_from_int(stmt_id)) } else { array_set(links, previous, word_from_int(stmt_id)) }
    array_set(packed, base + 1, word_from_int(stmt_id))
    array_set(packed, base + 2, word_from_int(word_to_int(array_get(packed, base + 2)) + 1))
    pilot kind_slot = v4_mir_block_stmt_kind_slot(v4_mir_stmt_kind(mir_id, body_id, stmt_id))
    if kind_slot >= 0 {
        array_set(packed, base + kind_slot, word_from_int(word_to_int(array_get(packed, base + kind_slot)) + 1))
    }
}

task v4_mir_finalize_block_stmt_index(mir_id: int, body_id: int) -> bool {
    if not v4_mir_block_stmt_storage_ensure(mir_id, body_id) { give back false }
    if v4_mir_block_stmt_index_is_ready(mir_id, body_id) { give back true }
    pilot packed = v4_mir_block_stmt_index_handle(mir_id, body_id)
    pilot links = v4_mir_stmt_next_index_handle(mir_id, body_id)
    array_set(packed, 0, "0")
    pilot blocks = v4_mir_body_block_count(mir_id, body_id)
    pilot statements = v4_mir_body_stmt_count(mir_id, body_id)
    if blocks > 97612892 { give back false }
    if not v4_mir_lookup_ensure_slot(packed, 2 + 11 * blocks, "0") { give back false }
    if statements > 0 and not v4_mir_lookup_ensure_slot(links, statements - 1, "-1") { give back false }
    pilot block_id = 0
    repeat until block_id >= blocks {
        pilot field = 0
        repeat until field >= 11 {
            pilot empty = "0"
            if field < 2 { empty = "-1" }
            array_set(packed, 3 + 11 * block_id + field, empty)
            field += 1
        }
        block_id += 1
    }
    pilot stmt_id = 0
    repeat until stmt_id >= statements {
        array_set(links, stmt_id, "-1")
        stmt_id += 1
    }
    stmt_id = 0
    repeat until stmt_id >= statements {
        block_id = v4_mir_stmt_block(mir_id, body_id, stmt_id)
        if block_id < 0 or block_id >= blocks { give back false }
        v4_mir_block_stmt_append_link(mir_id, body_id, block_id, stmt_id)
        v4_mir_block_stmt_build_records += 1
        stmt_id += 1
    }
    array_set(packed, 1, word_from_int(blocks))
    array_set(packed, 2, word_from_int(statements))
    array_set(packed, 0, "1")
    give back true
}

task v4_mir_block_stmt_added(mir_id: int, body_id: int, block_id: int, stmt_id: int) -> void {
    pilot packed = v4_mir_block_stmt_index_handle(mir_id, body_id)
    pilot ready: word = array_get(packed, 0)
    pilot links = v4_mir_stmt_next_index_handle(mir_id, body_id)
    if array_len(packed) < 3 or ready != "1" { give back }
    if block_id < 0 or block_id >= word_to_int(array_get(packed, 1)) or word_to_int(array_get(packed, 2)) != stmt_id or word_to_int(array_get(packed, 1)) != v4_mir_body_block_count(mir_id, body_id) {
        v4_mir_invalidate_block_stmt_index(mir_id, body_id)
        give back
    }
    if not v4_mir_lookup_ensure_slot(links, stmt_id, "-1") {
        v4_mir_invalidate_block_stmt_index(mir_id, body_id)
        give back
    }
    array_set(links, stmt_id, "-1")
    v4_mir_block_stmt_append_link(mir_id, body_id, block_id, stmt_id)
    array_set(packed, 2, word_from_int(stmt_id + 1))
}

task v4_mir_block_index_added(mir_id: int, body_id: int, block_id: int) -> void {
    pilot packed = v4_mir_block_stmt_index_handle(mir_id, body_id)
    pilot ready: word = array_get(packed, 0)
    if array_len(packed) < 3 or ready != "1" { give back }
    if word_to_int(array_get(packed, 1)) != block_id or word_to_int(array_get(packed, 2)) != v4_mir_body_stmt_count(mir_id, body_id) {
        v4_mir_invalidate_block_stmt_index(mir_id, body_id)
        give back
    }
    if not v4_mir_lookup_ensure_slot(packed, 3 + 11 * block_id + 10, "0") {
        v4_mir_invalidate_block_stmt_index(mir_id, body_id)
        give back
    }
    pilot field = 0
    repeat until field >= 11 {
        pilot empty = "0"
        if field < 2 { empty = "-1" }
        array_set(packed, 3 + 11 * block_id + field, empty)
        field += 1
    }
    array_set(packed, 1, word_from_int(block_id + 1))
}

task v4_mir_block_first_stmt(mir_id: int, body_id: int, block_id: int) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 - 1 }
    if block_id >= 0 and block_id < v4_mir_body_block_count(mir_id, body_id) and v4_mir_block_stmt_index_is_ready(mir_id, body_id) {
        v4_mir_block_stmt_lookup_steps += 1
        give back word_to_int(array_get(v4_mir_block_stmt_index_handle(mir_id, body_id), 3 + 11 * block_id))
    }
    give back v4_mir_block_next_stmt_linear(mir_id, body_id, block_id, 0 - 1)
}

task v4_mir_block_next_stmt_linear(mir_id: int, body_id: int, block_id: int, stmt_id: int) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 - 1 }
    pilot next = stmt_id + 1
    if next < 0 { next = 0 }
    pilot count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until next >= count {
        v4_mir_block_stmt_linear_steps += 1
        if v4_mir_stmt_block(mir_id, body_id, next) == block_id { give back next }
        next += 1
    }
    give back 0 - 1
}

task v4_mir_block_next_stmt(mir_id: int, body_id: int, block_id: int, stmt_id: int) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 - 1 }
    if stmt_id < 0 { give back v4_mir_block_first_stmt(mir_id, body_id, block_id) }
    if stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) { give back 0 - 1 }
    if block_id >= 0 and block_id < v4_mir_body_block_count(mir_id, body_id) and v4_mir_block_stmt_index_is_ready(mir_id, body_id) and v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id {
        v4_mir_block_stmt_lookup_steps += 1
        give back word_to_int(array_get(v4_mir_stmt_next_index_handle(mir_id, body_id), stmt_id))
    }
    give back v4_mir_block_next_stmt_linear(mir_id, body_id, block_id, stmt_id)
}

task v4_mir_finalize_lookup_indexes(mir_id: int) -> bool {
    if not v4_mir_lookup_owner_exists(mir_id) { give back false }
    pilot ready = v4_mir_finalize_body_lookup_index(mir_id)
    pilot body_id = 0
    repeat until body_id >= v4_mir_body_count(mir_id) {
        if not v4_mir_finalize_block_stmt_index(mir_id, body_id) { ready = false }
        body_id += 1
    }
    give back ready
}

-- Release only this file's optional lookup owners. Snapshot replacement
-- separately retires its raw children after handle admission; Word elements
-- and omitted files retain their existing lifetime policy.
task v4_mir_release_lookup_indexes(mir_id: int) -> void {
    if not v4_mir_lookup_owner_exists(mir_id) { give back }
    array_release(v4_mir_body_lookup_index_handle(mir_id))
    pilot blocks = v4_mir_lookup_file_child(v4_mir_block_stmt_indexes, mir_id)
    pilot links = v4_mir_lookup_file_child(v4_mir_stmt_next_indexes, mir_id)
    pilot body_id = 0
    repeat until body_id >= array_len(blocks) {
        array_release(v4_mir_lookup_file_child(blocks, body_id))
        array_release(v4_mir_lookup_file_child(links, body_id))
        body_id += 1
    }
    array_release(blocks)
    array_release(links)
    if mir_id >= 0 and mir_id < array_len(v4_mir_body_lookup_indexes) {
        array_set(v4_mir_body_lookup_indexes, mir_id, "-1")
        array_set(v4_mir_block_stmt_indexes, mir_id, "-1")
        array_set(v4_mir_stmt_next_indexes, mir_id, "-1")
    }
}

task v4_mir_defs_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_defs, mir_id))
}

task v4_mir_names_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_names, mir_id))
}

task v4_mir_sigs_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_sigs, mir_id))
}

task v4_mir_blocks_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_blocks, mir_id))
}

task v4_mir_local_names_index_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_local_names, mir_id))
}

task v4_mir_local_tys_index_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_local_tys, mir_id))
}

task v4_mir_local_modes_index_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_local_modes, mir_id))
}


task v4_mir_local_spans_index_handle(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_local_spans, mir_id))
}

task v4_mir_local_scope_spans_index_handle(mir_id: int) -> int {
