    array_release(word_to_int(array_get(v4_mir_diags, mir_id)))
    array_set(v4_mir_diags, mir_id, "-1")
}

task v4_mir_restore_raw_handle_count(mir_id: int) -> int {
    if not v4_mir_file_exists(mir_id) { give back 0 }
    pilot total = 0
    if word_to_int(array_get(v4_mir_body_defs, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_names, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_sigs, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_blocks, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_local_names, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_local_tys, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_local_modes, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_local_spans, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_local_scope_spans, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_kinds, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_lhs, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_rhs, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_spans, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_scope_spans, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_blocks, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_places, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_stmt_rvalues, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_kinds, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_texts, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_bases, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_fields, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_indices, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_spans, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_place_tys, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_kinds, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_texts, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_ops, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_lhs, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_rhs, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_spans, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_tys, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_abis, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_args, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_body_rvalue_builtin_methods, mir_id)) >= 0 { total += 1 }
    if word_to_int(array_get(v4_mir_diags, mir_id)) >= 0 { total += 1 }
    pilot body = 0
    repeat until body >= v4_mir_body_count(mir_id) {
        if word_to_int(array_get(v4_mir_blocks_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_local_names_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_local_tys_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_local_modes_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_local_spans_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_local_scope_spans_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_kinds_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_lhs_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_rhs_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_spans_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_scope_spans_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_blocks_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_places_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_stmt_rvalues_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_kinds_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_texts_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_bases_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_fields_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_indices_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_spans_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_place_tys_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_kinds_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_texts_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_ops_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_lhs_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_rhs_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_spans_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_tys_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_abis_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_args_index_handle(mir_id), body)) >= 0 { total += 1 }
        if word_to_int(array_get(v4_mir_rvalue_builtin_methods_index_handle(mir_id), body)) >= 0 { total += 1 }
        body += 1
    }
    give back total
}

-- array_new's live-handle guard is the recoverable failure class. Heap growth
-- is fatal in the runtime, so this contract does not promise heap-OOM recovery.
task v4_mir_restore_handles_available(records: int) -> bool {
    pilot required = 0
    pilot reclaimable = 0
    pilot index = 0
    repeat until index >= array_len(records) {
        pilot line: word = array_get(records, index)
        pilot kind = v4_mir_snapshot_field_raw(line, 0)
        if kind == "mir" {
            required += 35
            reclaimable += v4_mir_restore_raw_handle_count(word_to_int(v4_mir_snapshot_field_raw(line, 1)))
        } else if kind == "mir-body" { required += 31 }
        index += 1
    }
    give back v4_mir_restore_reserve_needed(required - reclaimable)
}


task v4_mir_restore_reserve_needed(needed: int) -> bool {
    if needed < 0 { needed = 0 }
    pilot reservations = array_new()
    if reservations < 0 { give back false }
    pilot held = 0
    pilot available = true
    repeat until held >= needed or not available {
        pilot handle = array_new()
        if handle < 0 { available = false } else {
            array_push(reservations, word_from_int(handle))
            if array_len(reservations) != held + 1 { array_release(handle) available = false } else { held += 1 }
        }
    }
    pilot index = 0
    repeat until index >= held { array_release(word_to_int(array_get(reservations, index))) index += 1 }
    array_release(reservations)
    give back available
}

-- Build policy never enters MIR. Closed control identities carry only semantic
-- observation and termination facts; source construction normalizes them.
task v4_mir_control_intrinsic_identity(kind: word) -> word {
    if v4_ty_control_intrinsic_known(kind) { give back "builtin::control::" + kind }
    give back ""
}
task v4_mir_builtin_control_identity_kind(identity: word) -> word {
    if identity == "builtin::control::panic" { give back "panic" }
    give back ""
}
task v4_mir_control_intrinsic_argument_is_borrowed(kind: word, argument: int) -> bool {
    give back v4_ty_control_intrinsic_param_mode(kind, argument) == v4_ty_param_mode_lend
}
task v4_mir_rvalue_is_builtin_control(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) { give back false }
    pilot identity = v4_mir_rvalue_builtin_method(mir, body, value)
    if v4_mir_builtin_control_identity_kind(identity) != "panic" { give back false }
    if v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_call or v4_mir_rvalue_ty(mir, body, value) != v4_ty_never { give back false }
    if v4_mir_rvalue_op(mir, body, value) != identity or v4_mir_rvalue_abi(mir, body, value) != "" { give back false }
    if v4_mir_rvalue_lhs(mir, body, value) != -1 or v4_mir_rvalue_rhs(mir, body, value) != -1 or v4_mir_rvalue_call_arg_count(mir, body, value) != 1 { give back false }
    pilot argument = v4_mir_rvalue_call_arg(mir, body, value, 0)
    if argument < 0 or argument >= value { give back false }
    if v4_mir_rvalue_kind(mir, body, argument) != v4_mir_rvalue_lend or v4_mir_rvalue_ty(mir, body, argument) != "lend word" or v4_mir_rvalue_rhs(mir, body, argument) != -1 { give back false }
    pilot owner = v4_mir_rvalue_lhs(mir, body, argument)
    if owner < 0 or owner >= argument or v4_mir_rvalue_ty(mir, body, owner) != v4_ty_word { give back false }
    if v4_mir_rvalue_kind(mir, body, owner) == v4_mir_rvalue_use_local {
        if not v4_mir_rvalue_op(mir, body, owner).starts_with("local#") or v4_mir_rvalue_local_id(mir, body, owner) < 0 { give back false }
    }
    give back true
}
task v4_mir_control_intrinsic_kind(mir: int, body: int, value: int) -> word {
    if v4_mir_rvalue_is_builtin_control(mir, body, value) { give back "panic" }
    give back ""
}
task v4_mir_control_checked_push(handle: int, value: word) -> bool {
    if handle < 0 { give back false }
    pilot before = array_len(handle)
    array_push(handle, value)
    give back array_len(handle) == before + 1
}
task v4_mir_control_row_type(values: int, value: int) -> word {
    if value < 0 or value >= array_len(values) { give back v4_ty_unknown }
    give back v4_mir_snapshot_field(array_get(values, value), 10)
}
task v4_mir_control_panic_row_is_valid(line: word, values: int) -> bool {
    if v4_mir_snapshot_field(line, 13) != "builtin::control::panic" or v4_mir_snapshot_field(line, 6) != "builtin::control::panic" { give back false }
    if v4_mir_snapshot_field(line, 4) != v4_mir_rvalue_call or v4_mir_snapshot_field(line, 10) != v4_ty_never or v4_mir_snapshot_field(line, 11) != "" { give back false }
    if v4_mir_snapshot_field_raw(line, 7) != "-1" or v4_mir_snapshot_field_raw(line, 8) != "-1" { give back false }
    pilot args = v4_mir_snapshot_field(line, 12)
    pilot value = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    if v4_mir_call_args_payload_count(args) != 1 or not v4_mir_snapshot_prior_rvalue_ref_is_valid(args, value, false) { give back false }
    pilot argument = word_to_int(args)
    if argument >= array_len(values) { give back false }
    pilot loan: word = array_get(values, argument)
    if v4_mir_snapshot_field(loan, 4) != v4_mir_rvalue_lend or v4_mir_snapshot_field(loan, 10) != "lend word" or v4_mir_snapshot_field_raw(loan, 8) != "-1" { give back false }
    pilot raw = v4_mir_snapshot_field_raw(loan, 7)
    if not v4_mir_snapshot_prior_rvalue_ref_is_valid(raw, argument, false) { give back false }
    give back v4_mir_control_row_type(values, word_to_int(raw)) == v4_ty_word
}
task v4_mir_control_static_never_row_is_valid(ty: int, line: word, values: int) -> bool {
    if v4_mir_snapshot_field(line, 4) != v4_mir_rvalue_call or v4_mir_snapshot_field(line, 10) != v4_ty_never or v4_mir_snapshot_field(line, 13) != "" { give back false }
    if v4_mir_snapshot_field_raw(line, 7) != "-1" or v4_mir_snapshot_field_raw(line, 8) != "-1" { give back false }
    pilot signature = v4_ty_task_signature_id_for_name(ty, v4_mir_snapshot_field(line, 6))
    if signature < 0 or not v4_ty_signature_is_ordinary_static_task(ty, signature) or v4_ty_signature_generic_count(ty, signature) != 0 { give back false }
    if v4_ty_signature_return_type(ty, signature) != v4_ty_never or v4_mir_snapshot_field(line, 11) != v4_ty_signature_call_abi(ty, signature) { give back false }
    pilot args = v4_mir_snapshot_field(line, 12)
    pilot count = v4_ty_signature_fixed_param_count(ty, signature)
    if v4_ty_signature_is_variadic(ty, signature) or v4_mir_call_args_payload_count(args) != count { give back false }
    pilot value = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot argument = 0
    repeat until argument >= count {
        pilot raw = v4_mir_snapshot_comma_part(args, argument)
        if not v4_mir_snapshot_prior_rvalue_ref_is_valid(raw, value, false) { give back false }
        pilot child = word_to_int(raw)
        if child >= array_len(values) { give back false }
        pilot actual = v4_mir_control_row_type(values, child)
        if actual == v4_ty_never or not v4_ty_is_known(actual) { give back false }
        pilot expected = v4_ty_signature_param_type(ty, signature, argument)
        if not v4_ty_is_known(expected) { give back false }
        pilot mode = v4_ty_signature_param_mode(ty, signature, argument)
        if mode == v4_ty_param_mode_lend or mode == v4_ty_param_mode_lend_mut {
            if not v4_ty_is_lend_type(actual) { give back false }
            if mode == v4_ty_param_mode_lend_mut and not v4_ty_is_lend_mut_type(actual) { give back false }
            pilot child_row: word = array_get(values, child)
            pilot child_kind = v4_mir_snapshot_field(child_row, 4)
            if child_kind != v4_mir_rvalue_lend and child_kind != v4_mir_rvalue_lend_mut { give back false }
            if mode == v4_ty_param_mode_lend_mut and child_kind != v4_mir_rvalue_lend_mut { give back false }
            if v4_mir_snapshot_field_raw(child_row, 8) != "-1" or v4_mir_snapshot_field(child_row, 12) != "" { give back false }
            pilot raw_owner = v4_mir_snapshot_field_raw(child_row, 7)
            if not v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_owner, child, false) { give back false }
            actual = v4_ty_lend_target_type(actual)
            if not v4_ty_is_known(actual) or actual != v4_mir_control_row_type(values, word_to_int(raw_owner)) { give back false }
        } else if mode != v4_ty_param_mode_value { give back false }
        if not v4_ty_types_compatible_in_signature(ty, signature, expected, actual) { give back false }
        argument += 1
    }
    give back true
}

-- One shared row contract serves staged snapshots and live admission. All
-- controls must already be terminal roots: hostile MIR is never normalized.
task v4_mir_control_is_conditional_statement(kind: word) -> bool {
    give back kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop
}
task v4_mir_control_conditional_statement_error(kind: word, term: word, operand: bool) -> word {
    if not v4_mir_control_is_conditional_statement(kind) { give back "" }
    if term != v4_mir_term_if { give back "native conditional statement requires an if terminator" }
    if not operand { give back "native conditional statement requires an operand" }
    -- Generic for-each Loop owns an iterable and binding place rather than a
    -- Bool. Preserve that frontend wire protocol; native admission separately
    -- checks that its supported branch operands are Bool.
    give back ""
}
-- Closed cycles diverge; a reachable Unreachable endpoint needs an actual
-- checked terminal call regardless of the task's declared return type.
task v4_mir_control_reachable_terminal_error(blocks: int, lasts: int, statements: int, values: int, mir: int, body: int, live: bool, never_body: bool) -> word {
    pilot needed: bool = never_body
    pilot index = 0
    repeat until index >= array_len(blocks) {
        if v4_mir_block_terminator(array_get(blocks, index)) == v4_mir_term_unreachable { needed = true }
        index += 1
    }
    if not needed { give back "" }
    pilot seen = array_new()
    pilot queue = array_new()
    pilot error = ""
    if seen < 0 or queue < 0 { error = "native control plan scratch exhausted" }
    index = 0
    repeat until index >= array_len(blocks) or error != "" {
        if not v4_mir_control_checked_push(seen, "0") { error = "native control plan scratch exhausted" }
        index += 1
    }
    if array_len(blocks) == 0 { error = "native never task has no body" }
    if error == "" {
        if not v4_mir_control_checked_push(queue, "0") { error = "native control plan scratch exhausted" }
        array_set(seen, 0, "1")
    }
    index = 0
    repeat until index >= array_len(queue) or error != "" {
        pilot block = word_to_int(array_get(queue, index))
        pilot record: word = array_get(blocks, block)
        pilot term = v4_mir_block_terminator(record)
        if never_body and term == v4_mir_term_return { error = "native never task has a returning path" }
        if term == v4_mir_term_unreachable {
            pilot terminal = word_to_int(array_get(lasts, block))
            pilot terminal_type = v4_ty_unknown
            if terminal >= 0 {
                if live {
                    pilot operand = v4_mir_stmt_rvalue(mir, body, terminal)
                    if operand >= 0 and operand < v4_mir_body_rvalue_count(mir, body) { terminal_type = v4_mir_rvalue_ty(mir, body, operand) }
                } else {
                    pilot statement: word = array_get(statements, terminal)
                    terminal_type = v4_mir_control_row_type(values, word_to_int(v4_mir_snapshot_field_raw(statement, 10)))
                }
            }
            if terminal_type != v4_ty_never { error = "native reachable unreachable block has no checked terminal call" }
        }
        pilot edge = 0
        pilot edges = 0
        if term == v4_mir_term_goto { edges = 1 }
        if term == v4_mir_term_if { edges = 2 }
        repeat until edge >= edges or error != "" {
            pilot target = v4_mir_block_target(record)
            if edge == 1 { target = v4_mir_block_else_target(record) }
            if target < 0 or target >= array_len(blocks) { error = "invalid native control edge" } else {
                pilot state: word = array_get(seen, target)
                if state == "0" {
                    if not v4_mir_control_checked_push(queue, word_from_int(target)) { error = "native control plan scratch exhausted" }
                    array_set(seen, target, "1")
                }
            }
            edge += 1
        }
        index += 1
    }
    array_release(queue)
    array_release(seen)
    give back error
}
task v4_mir_control_live_cfg_error(mir: int, body: int) -> word {
    pilot count = v4_mir_body_block_count(mir, body)
    pilot never_body: bool = v4_mir_body_callable_return_type(mir, body) == v4_ty_never
    pilot needed: bool = never_body
    pilot row = 0
    repeat until row >= count {
        pilot term = v4_mir_block_terminator(v4_mir_body_block(mir, body, row))
        if term == v4_mir_term_if or term == v4_mir_term_unreachable { needed = true }
        row += 1
    }
    row = 0
    repeat until row >= v4_mir_body_stmt_count(mir, body) {
        if v4_mir_control_is_conditional_statement(v4_mir_stmt_kind(mir, body, row)) { needed = true }
        row += 1
    }
    if not needed { give back "" }
    pilot lasts = array_new()
    pilot error = ""
    if lasts < 0 { error = "native control plan scratch exhausted" }
    row = 0
    repeat until row >= count or error != "" {
        if not v4_mir_control_checked_push(lasts, "-1") { error = "native control plan scratch exhausted" }
        row += 1
    }
    row = 0
    repeat until row >= v4_mir_body_stmt_count(mir, body) or error != "" {
        pilot block = v4_mir_stmt_block(mir, body, row)
        if block < 0 or block >= count { error = "invalid native control statement block" } else {
            pilot prior = word_to_int(array_get(lasts, block))
            if prior >= 0 and v4_mir_control_is_conditional_statement(v4_mir_stmt_kind(mir, body, prior)) { error = "native statement follows a conditional control" }
            pilot operand = v4_mir_stmt_rvalue(mir, body, row)
            pilot conditional_error = v4_mir_control_conditional_statement_error(v4_mir_stmt_kind(mir, body, row), v4_mir_block_terminator(v4_mir_body_block(mir, body, block)), operand >= 0 and operand < v4_mir_body_rvalue_count(mir, body))
            if error == "" { error = conditional_error }
            array_set(lasts, block, word_from_int(row))
        }
        row += 1
    }
    row = 0
    repeat until row >= count or error != "" {
        if v4_mir_block_terminator(v4_mir_body_block(mir, body, row)) == v4_mir_term_if {
            pilot last = word_to_int(array_get(lasts, row))
            if last < 0 { error = "native if block has no controlling statement" } else {
                if not v4_mir_control_is_conditional_statement(v4_mir_stmt_kind(mir, body, last)) { error = "native if block has no controlling statement" }
            }
        }
        row += 1
    }
    if error == "" { error = v4_mir_control_reachable_terminal_error(v4_mir_body_blocks_handle(mir, body), lasts, -1, -1, mir, body, true, never_body) }
    array_release(lasts)
    give back error
}
task v4_mir_control_body_rows_error(ty: int, definition: word, blocks: int, statements: int, places: int, values: int) -> word {
    pilot owners = array_new()
    pilot lasts = array_new()
    pilot error = ""
    if owners < 0 or lasts < 0 { error = "native control plan scratch exhausted" }
    pilot index = 0
    repeat until index >= array_len(values) or error != "" {
        if not v4_mir_control_checked_push(owners, "-1") { error = "native control plan scratch exhausted" }
        index += 1
    }
    index = 0
    repeat until index >= array_len(blocks) or error != "" {
        if not v4_mir_snapshot_block_record_is_valid(array_get(blocks, index), index, array_len(blocks)) { error = "invalid native control block record" }
        if not v4_mir_control_checked_push(lasts, "-1") { error = "native control plan scratch exhausted" }
        index += 1
    }
    index = 0
    repeat until index >= array_len(statements) or error != "" {
        pilot line: word = array_get(statements, index)
        pilot block = word_to_int(v4_mir_snapshot_field_raw(line, 8))
        pilot value = word_to_int(v4_mir_snapshot_field_raw(line, 10))
        if block < 0 or block >= array_len(blocks) { error = "invalid native control statement block" } else {
            pilot prior = word_to_int(array_get(lasts, block))
            if prior >= 0 {
                pilot previous: word = array_get(statements, prior)
                if v4_mir_control_row_type(values, word_to_int(v4_mir_snapshot_field_raw(previous, 10))) == v4_ty_never { error = "native statement follows a terminal control call" }
                if v4_mir_control_is_conditional_statement(v4_mir_snapshot_field(previous, 4)) { error = "native statement follows a conditional control" }
            }
            pilot conditional_error = v4_mir_control_conditional_statement_error(v4_mir_snapshot_field(line, 4), v4_mir_block_terminator(array_get(blocks, block)), value >= 0 and value < array_len(values))
            if error == "" { error = conditional_error }
            array_set(lasts, block, word_from_int(index))
        }
        if v4_mir_control_row_type(values, value) == v4_ty_never {
            if v4_mir_snapshot_field(line, 4) != v4_mir_stmt_expr or v4_mir_snapshot_field_raw(line, 9) != "-1" { error = "native never value must be a terminal expression" }
            if word_to_int(array_get(owners, value)) >= 0 { error = "native control call has repeated terminal ownership" }
            array_set(owners, value, word_from_int(index))
        }
        index += 1
    }
    index = 0
    repeat until index >= array_len(blocks) or error != "" {
        if v4_mir_block_terminator(array_get(blocks, index)) == v4_mir_term_if {
            pilot last = word_to_int(array_get(lasts, index))
            if last < 0 { error = "native if block has no controlling statement" } else {
                if not v4_mir_control_is_conditional_statement(v4_mir_snapshot_field(array_get(statements, last), 4)) { error = "native if block has no controlling statement" }
            }
        }
        index += 1
    }
    index = 0
    repeat until index >= array_len(values) or error != "" {
        pilot line: word = array_get(values, index)
        pilot identity = v4_mir_snapshot_field(line, 13)
        pilot op = v4_mir_snapshot_field(line, 6)
        pilot kind = v4_mir_snapshot_field(line, 4)
        pilot value_ty = v4_mir_snapshot_field(line, 10)
        if identity.starts_with("builtin::control::") or op.starts_with("builtin::control::") {
            if not v4_mir_control_panic_row_is_valid(line, values) { error = "invalid native control intrinsic identity" }
        }
        if value_ty == v4_ty_never {
            if not v4_mir_control_panic_row_is_valid(line, values) and not v4_mir_control_static_never_row_is_valid(ty, line, values) { error = "unsupported native never call contract" }
            pilot owner = word_to_int(array_get(owners, index))
            if owner < 0 { error = "native control call is not a terminal expression" } else {
                pilot statement: word = array_get(statements, owner)
                pilot block = word_to_int(v4_mir_snapshot_field_raw(statement, 8))
                if block < 0 or block >= array_len(blocks) { error = "invalid native control statement block" } else {
                    pilot record: word = array_get(blocks, block)
                    if word_to_int(array_get(lasts, block)) != owner or v4_mir_block_terminator(record) != v4_mir_term_unreachable or v4_mir_block_part(record, 4) != "" { error = "native control call requires an unreachable terminator" }
                }
            }
        }
        pilot lhs = word_to_int(v4_mir_snapshot_field_raw(line, 7))
        pilot rhs = word_to_int(v4_mir_snapshot_field_raw(line, 8))
        if kind != v4_mir_rvalue_use_place and v4_mir_control_row_type(values, lhs) == v4_ty_never { error = "native never value has an enclosing rvalue" }
        if v4_mir_control_row_type(values, rhs) == v4_ty_never { error = "native never value has an enclosing rvalue" }
        pilot args = v4_mir_snapshot_field(line, 12)
        pilot argument = 0
        repeat until argument >= v4_mir_call_args_payload_count(args) {
            if v4_mir_control_row_type(values, v4_mir_call_args_payload_at(args, argument)) == v4_ty_never { error = "native never value has an enclosing argument" }
            argument += 1
        }
        index += 1
    }
    index = 0
    repeat until index >= array_len(places) or error != "" {
        pilot line: word = array_get(places, index)
        if v4_mir_snapshot_field(line, 10) == v4_ty_never { error = "native never value cannot be stored in a place" }
        if v4_mir_control_row_type(values, word_to_int(v4_mir_snapshot_field_raw(line, 8))) == v4_ty_never { error = "native never value has an enclosing place" }
        index += 1
    }
    array_release(owners)
    if error != "" { array_release(lasts); give back error }
    pilot signature = v4_ty_lookup_signature(ty, definition)
    pilot never_body: bool = signature >= 0 and v4_ty_signature_is_ordinary_static_task(ty, signature) and v4_ty_signature_return_type(ty, signature) == v4_ty_never
    error = v4_mir_control_reachable_terminal_error(blocks, lasts, statements, values, -1, -1, false, never_body)
    array_release(lasts)
    give back error
}

task v4_mir_control_plan_preflight(mir: int) -> word {
    if not v4_mir_file_exists(mir) { give back "missing mir for native control plan" }
    pilot body = 0
    pilot error = ""
    repeat until body >= v4_mir_body_count(mir) or error != "" {
        pilot local = 0
        repeat until local >= v4_mir_body_local_count(mir, body) or error != "" {
            if v4_mir_local_mode(mir, body, local) == "$control-diagnostic" { error = "unpublished source control binding" }
            local += 1
        }
        if error == "" { error = v4_mir_control_live_cfg_error(mir, body) }
        pilot control: bool = v4_mir_body_callable_return_type(mir, body) == v4_ty_never
        pilot value = 0
        repeat until value >= v4_mir_body_rvalue_count(mir, body) {
            if v4_mir_rvalue_ty(mir, body, value) == v4_ty_never or v4_mir_rvalue_builtin_method(mir, body, value).starts_with("builtin::control::") or v4_mir_rvalue_op(mir, body, value).starts_with("builtin::control::") { control = true }
            value += 1
        }
        if control and error == "" {
            pilot blocks = array_new()
            pilot statements = array_new()
            pilot places = array_new()
            pilot values = array_new()
            if blocks < 0 or statements < 0 or places < 0 or values < 0 { error = "native control plan scratch exhausted" }
            pilot row = 0
            repeat until row >= v4_mir_body_block_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(blocks, v4_mir_body_block(mir, body, row)) { error = "native control plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_stmt_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(statements, v4_mir_snapshot_stmt_line(mir, body, row)) { error = "native control plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_place_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(places, v4_mir_snapshot_place_line(mir, body, row)) { error = "native control plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_rvalue_count(mir, body) or error != "" {
                if not v4_mir_snapshot_word_local_use_is_valid(v4_mir_snapshot_rvalue_line(mir, body, row), v4_mir_body_local_names_handle(mir, body), v4_mir_body_local_tys_handle(mir, body)) { error = "invalid native control word local identity" }
                if not v4_mir_control_checked_push(values, v4_mir_snapshot_rvalue_line(mir, body, row)) { error = "native control plan scratch exhausted" }
                row += 1
            }
            if error == "" { error = v4_mir_control_body_rows_error(v4_mir_ty_id(mir), v4_mir_body_def(mir, body), blocks, statements, places, values) }
            -- A native static Never target must have its actual non-returning
            -- body in this module. A void facade or omitted body is no proof.
            row = 0
            repeat until row >= v4_mir_body_rvalue_count(mir, body) or error != "" {
                if v4_mir_rvalue_ty(mir, body, row) == v4_ty_never and not v4_mir_rvalue_is_builtin_control(mir, body, row) {
                    pilot target = v4_mir_lookup_body_name(mir, v4_mir_rvalue_op(mir, body, row))
                    pilot signature = v4_ty_task_signature_id_for_name(v4_mir_ty_id(mir), v4_mir_rvalue_op(mir, body, row))
                    if signature < 0 or target < 0 or v4_mir_body_callable_return_type(mir, target) != v4_ty_never or v4_mir_body_def(mir, target) != v4_ty_signature_def(v4_mir_ty_id(mir), signature) or v4_mir_body_name(mir, target) != v4_ty_signature_name(v4_mir_ty_id(mir), signature) { error = "native never call target body is missing or mismatched" }
                }
                row += 1
            }
            array_release(values)
            array_release(places)
            array_release(statements)
            array_release(blocks)
        }
        body += 1
    }
    give back error
}

-- The staging validator consumes decoded rows without accessing replaced MIR
-- slots. Failed allocation/append or termination cross-facts reject atomically.
task v4_mir_snapshot_control_payload_is_valid(payload: word) -> bool {
    pilot locals = array_new()
    pilot header = ""
    pilot file = -1
    pilot blocks = array_new()
    pilot statements = array_new()
    pilot places = array_new()
    pilot values = array_new()
    pilot target_bodies = array_new()
    pilot required_targets = array_new()
    pilot valid: bool = locals >= 0 and blocks >= 0 and statements >= 0 and places >= 0 and values >= 0 and target_bodies >= 0 and required_targets >= 0
    pilot ty = -1
    pilot definition = ""
    pilot file_identity = ""
    pilot body: bool = false
    pilot lines = v4_mir_snapshot_line_count(payload)
    pilot row = 0
    repeat until row >= lines or not valid {
        pilot line = v4_mir_snapshot_line(payload, row)
        pilot kind = v4_mir_snapshot_field_raw(line, 0)
        if kind == "mir" or kind == "mir-body" or kind == "mir-diag" or kind == "mir-end" {
            if body {
                valid = v4_mir_control_body_rows_error(ty, definition, blocks, statements, places, values) == ""
                if valid { valid = v4_mir_scalar_sum_body_rows_error(ty, file, header, blocks, locals, statements, places, values) == "" }
                body = false
            }
            if kind == "mir" { ty = word_to_int(v4_mir_snapshot_field_raw(line, 3)); file = word_to_int(v4_mir_snapshot_field_raw(line, 2)); file_identity = v4_mir_snapshot_field_raw(line, 1) }
            if kind == "mir-body" {
                if not v4_mir_control_checked_push(target_bodies, line) { valid = false }
                array_release(locals)
                locals = array_new()
                array_release(values)
                array_release(places)
                array_release(statements)
                array_release(blocks)
                blocks = array_new()
                statements = array_new()
                places = array_new()
                values = array_new()
                if locals < 0 or blocks < 0 or statements < 0 or places < 0 or values < 0 { valid = false }
                header = line
                definition = v4_mir_snapshot_field(line, 3)
                body = true
            }
        } else if kind == "mir-block" {
            if not v4_mir_control_checked_push(blocks, v4_mir_snapshot_field(line, 4)) { valid = false }
        } else if kind == "mir-local" {
            if not v4_mir_control_checked_push(locals, line) { valid = false }
        } else if kind == "mir-stmt" {
            if not v4_mir_control_checked_push(statements, line) { valid = false }
        } else if kind == "mir-place" {
            if not v4_mir_control_checked_push(places, line) { valid = false }
        } else if kind == "mir-rvalue" {
            if (v4_mir_snapshot_field(line, 10) == v4_ty_never and v4_mir_snapshot_field(line, 13) == "") or v4_mir_sum_row_call_requires_body(ty, values, line) {
                pilot signature = v4_ty_task_signature_id_for_name(ty, v4_mir_snapshot_field(line, 6))
                if signature < 0 { valid = false } else {
                    pilot target = file_identity + "|" + v4_mir_snapshot_escape(v4_ty_signature_def(ty, signature)) + "|" + v4_mir_snapshot_escape(v4_ty_signature_name(ty, signature)) + "|" + v4_mir_snapshot_escape(v4_ty_signature_of(ty, v4_ty_signature_def(ty, signature)))
                    if not v4_mir_control_checked_push(required_targets, target) { valid = false }
                }
            }
            if not v4_mir_control_checked_push(values, line) { valid = false }
        }
        row += 1
    }
    if valid and body {
        valid = v4_mir_control_body_rows_error(ty, definition, blocks, statements, places, values) == ""
        if valid { valid = v4_mir_scalar_sum_body_rows_error(ty, file, header, blocks, locals, statements, places, values) == "" }
    }
    row = 0
    repeat until row >= array_len(required_targets) or not valid {
        pilot target: word = array_get(required_targets, row)
        pilot found: bool = false
        pilot candidate = 0
        repeat until candidate >= array_len(target_bodies) or found {
            pilot header: word = array_get(target_bodies, candidate)
            found = v4_mir_snapshot_field_raw(header, 1) == v4_mir_snapshot_field_raw(target, 0) and v4_mir_snapshot_field(header, 3) == v4_mir_snapshot_field(target, 1) and v4_mir_snapshot_field(header, 4) == v4_mir_snapshot_field(target, 2) and v4_mir_snapshot_field(header, 5) == v4_mir_snapshot_field(target, 3)
            candidate += 1
        }
        if not found { valid = false }
        row += 1
    }
    array_release(locals)
    array_release(required_targets)
    array_release(target_bodies)
    array_release(values)
    array_release(places)
    array_release(statements)
    array_release(blocks)
    give back valid
}

-- Checked root compaction is a construction primitive. Source MIR-build calls
-- it after terminal normalization; native/restored admission never calls it.
task v4_mir_compact_mark(marks: int, queue: int, node: int) -> bool {
    if node < 0 { give back true }
    if node >= array_len(marks) { give back false }
    pilot state: word = array_get(marks, node)
    if state == "1" { give back true }
    if not v4_mir_control_checked_push(queue, word_from_int(node)) { give back false }
    array_set(marks, node, "1")
    give back true
}
task v4_mir_compact_ref(map: int, index: int) -> int {
    if index < 0 { give back -1 }
    if index >= array_len(map) { give back -1 }
    give back word_to_int(array_get(map, index))
}
task v4_mir_compact_display_target(token: word, map: int) -> word {
    pilot prefix = ""
    if token.starts_with("then#") { prefix = "then#" }
    if token.starts_with("else#") { prefix = "else#" }
    if token.starts_with("eval#") { prefix = "eval#" }
    if token.starts_with("short#") { prefix = "short#" }
    if token.starts_with("continue#") { prefix = "continue#" }
    if token.starts_with("propagate#") { prefix = "propagate#" }
    if token.starts_with("body#") { prefix = "body#" }
    if token.starts_with("exit#") { prefix = "exit#" }
    if token.starts_with("got#") { prefix = "got#" }
    if token.starts_with("nobody#") { prefix = "nobody#" }
    if token.starts_with("arm#") { prefix = "arm#" }
    if token.starts_with("next#") { prefix = "next#" }
    if token.starts_with("after#") { prefix = "after#" }
    if token.starts_with("loop#") { prefix = "loop#" }
    if prefix == "" { give back token }
    pilot raw = v4_slice(token, prefix.length(), token.length())
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw) { give back token }
    pilot mapped = v4_mir_compact_ref(map, word_to_int(raw))
    if mapped < 0 { give back "" }
    give back prefix + word_from_int(mapped)
}
task v4_mir_compact_stmt_rhs(rhs: word, map: int) -> word {
    pilot offset = 0
    pilot rewritten = ""
    repeat until offset >= rhs.length() {
        pilot stop = offset
        repeat until stop >= rhs.length() or rhs.char_at(stop) == " " { stop += 1 }
        pilot token = v4_slice(rhs, offset, stop)
        pilot mapped = v4_mir_compact_display_target(token, map)
        if token != "" and mapped == "" { give back "" }
        rewritten = rewritten + mapped
        if stop < rhs.length() { rewritten = rewritten + " " }
        offset = stop + 1
    }
    give back rewritten
}
task v4_mir_compact_body_rvalue_roots(mir: int, body: int) -> word {
    pilot marks = array_new()
    pilot queue = array_new()
    pilot value_map = array_new()
    pilot place_map = array_new()
    pilot block_marks = array_new()
    pilot block_queue = array_new()
    pilot block_map = array_new()
    pilot local_map = array_new()
    pilot error = ""
    pilot value_count = v4_mir_body_rvalue_count(mir, body)
    pilot place_count = v4_mir_body_place_count(mir, body)
    pilot stmt_count = v4_mir_body_stmt_count(mir, body)
    pilot block_count = v4_mir_body_block_count(mir, body)
    pilot local_count = v4_mir_body_local_count(mir, body)
    pilot kept_locals = 0
    pilot kept_stmts = 0
    pilot kept_blocks = 0
    if marks < 0 or queue < 0 or value_map < 0 or place_map < 0 or block_marks < 0 or block_queue < 0 or block_map < 0 or local_map < 0 { error = "source control compaction scratch exhausted" }
    pilot index = 0
    repeat until index >= local_count or error != "" {
        pilot mapped = -1
        if v4_mir_local_mode(mir, body, index) != "$control-diagnostic" { mapped = kept_locals; kept_locals += 1 }
        if not v4_mir_control_checked_push(local_map, word_from_int(mapped)) { error = "source control compaction scratch exhausted" }
        index += 1
    }
    index = 0
    repeat until index >= block_count or error != "" {
        if not v4_mir_control_checked_push(block_marks, "0") { error = "source control compaction scratch exhausted" }
        index += 1
    }
    if block_count == 0 { error = "source control compaction has no entry block" }
    if error == "" and not v4_mir_compact_mark(block_marks, block_queue, 0) { error = "source control compaction scratch exhausted" }
    index = 0
    repeat until index >= array_len(block_queue) or error != "" {
        pilot block = word_to_int(array_get(block_queue, index))
        pilot record = v4_mir_body_block(mir, body, block)
        if not v4_mir_snapshot_block_record_is_valid(record, block, block_count) { error = "invalid source control compaction block" }
        pilot term = v4_mir_block_terminator(record)
        if term == v4_mir_term_goto or term == v4_mir_term_if {
            if not v4_mir_compact_mark(block_marks, block_queue, v4_mir_block_target(record)) { error = "invalid source control compaction edge" }
            if term == v4_mir_term_if and not v4_mir_compact_mark(block_marks, block_queue, v4_mir_block_else_target(record)) { error = "invalid source control compaction edge" }
        }
        index += 1
    }
    index = 0
    repeat until index >= block_count or error != "" {
        pilot mapped = -1
        pilot state: word = array_get(block_marks, index)
        if state == "1" { mapped = kept_blocks; kept_blocks += 1 }
        if not v4_mir_control_checked_push(block_map, word_from_int(mapped)) { error = "source control compaction scratch exhausted" }
        index += 1
    }
    array_release(block_queue)
    array_release(block_marks)
    index = 0
    repeat until index >= value_count + place_count or error != "" {
        if not v4_mir_control_checked_push(marks, "0") { error = "source control compaction scratch exhausted" }
        index += 1
    }
    index = 0
    repeat until index >= stmt_count or error != "" {
        pilot block = v4_mir_stmt_block(mir, body, index)
        if block < 0 or block >= block_count { error = "invalid source control compaction statement block" }
        if v4_mir_compact_ref(block_map, block) >= 0 {
            kept_stmts += 1
            pilot value = v4_mir_stmt_rvalue(mir, body, index)
            pilot place = v4_mir_stmt_place(mir, body, index)
            if value >= 0 and (value >= value_count or not v4_mir_compact_mark(marks, queue, value)) { error = "invalid source control compaction root" }
            if place >= 0 and (place >= place_count or not v4_mir_compact_mark(marks, queue, value_count + place)) { error = "invalid source control compaction root" }
        }
        index += 1
    }
    index = 0
    repeat until index >= array_len(queue) or error != "" {
        pilot node = word_to_int(array_get(queue, index))
        if node < value_count {
            pilot kind = v4_mir_rvalue_kind(mir, body, node)
            pilot left = v4_mir_rvalue_lhs(mir, body, node)
            pilot right = v4_mir_rvalue_rhs(mir, body, node)
            pilot args = v4_mir_rvalue_args_payload(mir, body, node)
            if not v4_mir_snapshot_rvalue_refs_are_valid(kind, word_from_int(left), word_from_int(right), args, node, place_count) { error = "invalid source control compaction graph" }
            if left >= 0 {
                if kind == v4_mir_rvalue_use_place { left += value_count }
                if not v4_mir_compact_mark(marks, queue, left) { error = "source control compaction scratch exhausted" }
            }
            if right >= 0 and not v4_mir_compact_mark(marks, queue, right) { error = "source control compaction scratch exhausted" }
            pilot argument = 0
            repeat until argument >= v4_mir_call_args_payload_count(args) or error != "" {
                if not v4_mir_compact_mark(marks, queue, v4_mir_call_args_payload_at(args, argument)) { error = "source control compaction scratch exhausted" }
                argument += 1
            }
        } else {
            pilot place = node - value_count
            pilot kind = v4_mir_place_kind(mir, body, place)
            pilot base = v4_mir_place_base(mir, body, place)
            pilot operand = v4_mir_place_index(mir, body, place)
            if not v4_mir_snapshot_place_refs_are_valid(kind, word_from_int(base), word_from_int(operand), place, v4_mir_body_local_count(mir, body), value_count) { error = "invalid source control compaction place" }
            if (kind == v4_mir_place_field or kind == v4_mir_place_index) and base >= 0 and not v4_mir_compact_mark(marks, queue, value_count + base) { error = "source control compaction scratch exhausted" }
            if operand >= 0 and not v4_mir_compact_mark(marks, queue, operand) { error = "source control compaction scratch exhausted" }
        }
        index += 1
    }
    pilot kept_values = 0
    pilot kept_places = 0
    index = 0
    repeat until index >= value_count or error != "" {
        pilot mapped = -1
        pilot state: word = array_get(marks, index)
        if state == "1" { mapped = kept_values; kept_values += 1 }
        if not v4_mir_control_checked_push(value_map, word_from_int(mapped)) { error = "source control compaction scratch exhausted" }
        index += 1
    }
    index = 0
    repeat until index >= place_count or error != "" {
        pilot mapped = -1
        pilot state: word = array_get(marks, value_count + index)
        if state == "1" { mapped = kept_places; kept_places += 1 }
        if not v4_mir_control_checked_push(place_map, word_from_int(mapped)) { error = "source control compaction scratch exhausted" }
        index += 1
    }
    array_release(queue)
    array_release(marks)
    if error != "" { array_release(local_map); array_release(block_map); array_release(place_map); array_release(value_map); give back error }
    pilot staged_rvalue_kinds = array_new()
    pilot staged_rvalue_texts = array_new()
    pilot staged_rvalue_ops = array_new()
    pilot staged_rvalue_lhs = array_new()
    pilot staged_rvalue_rhs = array_new()
    pilot staged_rvalue_spans = array_new()
    pilot staged_rvalue_tys = array_new()
    pilot staged_rvalue_abis = array_new()
    pilot staged_rvalue_args = array_new()
    pilot staged_rvalue_builtin_methods = array_new()
    pilot staged_place_kinds = array_new()
    pilot staged_place_texts = array_new()
    pilot staged_place_bases = array_new()
    pilot staged_place_fields = array_new()
    pilot staged_place_indices = array_new()
    pilot staged_place_spans = array_new()
    pilot staged_place_tys = array_new()
    pilot staged_stmt_places = array_new()
    pilot staged_stmt_rvalues = array_new()
    pilot staged_stmt_kinds = array_new()
    pilot staged_stmt_lhs = array_new()
    pilot staged_stmt_rhs = array_new()
    pilot staged_stmt_spans = array_new()
    pilot staged_stmt_scope_spans = array_new()
    pilot staged_stmt_blocks = array_new()
    pilot staged_blocks = array_new()
    pilot staged_local_names = array_new()
    pilot staged_local_tys = array_new()
    pilot staged_local_modes = array_new()
    pilot staged_local_spans = array_new()
    pilot staged_local_scope_spans = array_new()
    if staged_rvalue_kinds < 0 or staged_rvalue_texts < 0 or staged_rvalue_ops < 0 or staged_rvalue_lhs < 0 or staged_rvalue_rhs < 0 or staged_rvalue_spans < 0 or staged_rvalue_tys < 0 or staged_rvalue_abis < 0 or staged_rvalue_args < 0 or staged_rvalue_builtin_methods < 0 or staged_place_kinds < 0 or staged_place_texts < 0 or staged_place_bases < 0 or staged_place_fields < 0 or staged_place_indices < 0 or staged_place_spans < 0 or staged_place_tys < 0 or staged_stmt_places < 0 or staged_stmt_rvalues < 0 or staged_stmt_kinds < 0 or staged_stmt_lhs < 0 or staged_stmt_rhs < 0 or staged_stmt_spans < 0 or staged_stmt_scope_spans < 0 or staged_stmt_blocks < 0 or staged_blocks < 0 or staged_local_names < 0 or staged_local_tys < 0 or staged_local_modes < 0 or staged_local_spans < 0 or staged_local_scope_spans < 0 { error = "source control compaction scratch exhausted" }
    index = 0
    repeat until index >= value_count or error != "" {
        if v4_mir_compact_ref(value_map, index) >= 0 {
            pilot kind = v4_mir_rvalue_kind(mir, body, index)
            pilot left = v4_mir_rvalue_lhs(mir, body, index)
            if kind == v4_mir_rvalue_use_place { left = v4_mir_compact_ref(place_map, left) } else { left = v4_mir_compact_ref(value_map, left) }
            pilot right = v4_mir_compact_ref(value_map, v4_mir_rvalue_rhs(mir, body, index))
            pilot old_args = v4_mir_rvalue_args_payload(mir, body, index)
            pilot args = ""
            pilot argument = 0
            repeat until argument >= v4_mir_call_args_payload_count(old_args) {
                pilot child = v4_mir_compact_ref(value_map, v4_mir_call_args_payload_at(old_args, argument))
                if child < 0 { error = "invalid source control compaction argument" }
                if argument > 0 { args = args + "," }
                args = args + word_from_int(child)
                argument += 1
            }
            if not v4_mir_control_checked_push(staged_rvalue_kinds, array_get(v4_mir_body_rvalue_kinds_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_texts, array_get(v4_mir_body_rvalue_texts_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            pilot op = v4_mir_rvalue_op(mir, body, index)
            if kind == v4_mir_rvalue_use_local {
                pilot local = v4_mir_compact_ref(local_map, v4_mir_rvalue_local_id(mir, body, index))
                if local < 0 { error = "unpublished source control binding used by reachable rvalue" }
                op = "local#" + word_from_int(local)
            }
            if not v4_mir_control_checked_push(staged_rvalue_ops, op) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_lhs, word_from_int(left)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_rhs, word_from_int(right)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_spans, array_get(v4_mir_body_rvalue_spans_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_tys, array_get(v4_mir_body_rvalue_tys_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_abis, array_get(v4_mir_body_rvalue_abis_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_args, args) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_rvalue_builtin_methods, array_get(v4_mir_body_rvalue_builtin_methods_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
        }
        index += 1
    }
    index = 0
    repeat until index >= place_count or error != "" {
        if v4_mir_compact_ref(place_map, index) >= 0 {
            pilot kind = v4_mir_place_kind(mir, body, index)
            pilot base = v4_mir_place_base(mir, body, index)
            if kind == v4_mir_place_field or kind == v4_mir_place_index { base = v4_mir_compact_ref(place_map, base) }
            if kind == v4_mir_place_local and base >= 0 {
                base = v4_mir_compact_ref(local_map, base)
                if base < 0 { error = "unpublished source control binding used by reachable place" }
            }
            pilot operand = v4_mir_compact_ref(value_map, v4_mir_place_index(mir, body, index))
            if not v4_mir_control_checked_push(staged_place_kinds, array_get(v4_mir_body_place_kinds_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_place_texts, array_get(v4_mir_body_place_texts_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_place_bases, word_from_int(base)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_place_fields, array_get(v4_mir_body_place_fields_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_place_indices, word_from_int(operand)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_place_spans, array_get(v4_mir_body_place_spans_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_place_tys, array_get(v4_mir_body_place_tys_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
        }
        index += 1
    }
    index = 0
    repeat until index >= stmt_count or error != "" {
        pilot block = v4_mir_compact_ref(block_map, v4_mir_stmt_block(mir, body, index))
        if block >= 0 {
            pilot kind = v4_mir_stmt_kind(mir, body, index)
            pilot rhs = v4_mir_stmt_rhs(mir, body, index)
            if kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop or kind == v4_mir_stmt_break or kind == v4_mir_stmt_continue {
                rhs = v4_mir_compact_stmt_rhs(rhs, block_map)
                if rhs == "" and v4_mir_stmt_rhs(mir, body, index) != "" { error = "invalid source control compaction display target" }
            }
            if not v4_mir_control_checked_push(staged_stmt_places, word_from_int(v4_mir_compact_ref(place_map, v4_mir_stmt_place(mir, body, index)))) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_rvalues, word_from_int(v4_mir_compact_ref(value_map, v4_mir_stmt_rvalue(mir, body, index)))) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_kinds, kind) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_lhs, v4_mir_stmt_lhs(mir, body, index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_rhs, rhs) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_spans, v4_mir_stmt_span(mir, body, index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_scope_spans, v4_mir_stmt_scope_span(mir, body, index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_stmt_blocks, word_from_int(block)) { error = "source control compaction scratch exhausted" }
        }
        index += 1
    }
    index = 0
    repeat until index >= block_count or error != "" {
        pilot block = v4_mir_compact_ref(block_map, index)
        if block >= 0 {
            pilot record = v4_mir_body_block(mir, body, index)
            pilot target = v4_mir_compact_ref(block_map, v4_mir_block_target(record))
            pilot alternate = v4_mir_compact_ref(block_map, v4_mir_block_else_target(record))
            pilot rewritten = word_from_int(block) + "|" + v4_mir_block_terminator(record) + "|" + word_from_int(target) + "|" + word_from_int(alternate) + "|" + v4_mir_block_part(record, 4) + "|" + v4_mir_block_part(record, 5)
            if not v4_mir_snapshot_block_record_is_valid(rewritten, block, kept_blocks) { error = "invalid source control compaction edge" }
            if not v4_mir_control_checked_push(staged_blocks, rewritten) { error = "source control compaction scratch exhausted" }
        }
        index += 1
    }
    index = 0
    repeat until index >= local_count or error != "" {
        if v4_mir_compact_ref(local_map, index) >= 0 {
            if not v4_mir_control_checked_push(staged_local_names, array_get(v4_mir_body_local_names_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_local_tys, array_get(v4_mir_body_local_tys_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_local_modes, array_get(v4_mir_body_local_modes_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_local_spans, array_get(v4_mir_body_local_spans_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
            if not v4_mir_control_checked_push(staged_local_scope_spans, array_get(v4_mir_body_local_scope_spans_handle(mir, body), index)) { error = "source control compaction scratch exhausted" }
        }
        index += 1
    }
    array_release(local_map)
    array_release(block_map)
    array_release(place_map)
    array_release(value_map)
    if array_len(staged_rvalue_kinds) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_texts) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_ops) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_lhs) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_rhs) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_spans) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_tys) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_abis) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_args) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_rvalue_builtin_methods) != kept_values { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_kinds) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_texts) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_bases) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_fields) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_indices) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_spans) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_place_tys) != kept_places { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_places) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_rvalues) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_kinds) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_lhs) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_rhs) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_spans) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_scope_spans) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_stmt_blocks) != kept_stmts { error = "source control compaction scratch exhausted" }
    if array_len(staged_blocks) != kept_blocks { error = "source control compaction scratch exhausted" }
    if array_len(staged_local_names) != kept_locals { error = "source control compaction scratch exhausted" }
    if array_len(staged_local_tys) != kept_locals { error = "source control compaction scratch exhausted" }
    if array_len(staged_local_modes) != kept_locals { error = "source control compaction scratch exhausted" }
    if array_len(staged_local_spans) != kept_locals { error = "source control compaction scratch exhausted" }
    if array_len(staged_local_scope_spans) != kept_locals { error = "source control compaction scratch exhausted" }
    if error != "" {
        array_release(staged_rvalue_kinds)
        array_release(staged_rvalue_texts)
        array_release(staged_rvalue_ops)
        array_release(staged_rvalue_lhs)
        array_release(staged_rvalue_rhs)
        array_release(staged_rvalue_spans)
        array_release(staged_rvalue_tys)
        array_release(staged_rvalue_abis)
        array_release(staged_rvalue_args)
        array_release(staged_rvalue_builtin_methods)
        array_release(staged_place_kinds)
        array_release(staged_place_texts)
        array_release(staged_place_bases)
        array_release(staged_place_fields)
        array_release(staged_place_indices)
        array_release(staged_place_spans)
        array_release(staged_place_tys)
        array_release(staged_stmt_places)
        array_release(staged_stmt_rvalues)
        array_release(staged_stmt_kinds)
        array_release(staged_stmt_lhs)
        array_release(staged_stmt_rhs)
        array_release(staged_stmt_spans)
        array_release(staged_stmt_scope_spans)
        array_release(staged_stmt_blocks)
        array_release(staged_blocks)
        array_release(staged_local_names)
        array_release(staged_local_tys)
        array_release(staged_local_modes)
        array_release(staged_local_spans)
        array_release(staged_local_scope_spans)
        give back error
    }
    -- No allocating operation remains: atomically publish checked body columns.
    pilot old_rvalue_kinds = v4_mir_body_rvalue_kinds_handle(mir, body)
    pilot old_rvalue_texts = v4_mir_body_rvalue_texts_handle(mir, body)
    pilot old_rvalue_ops = v4_mir_body_rvalue_ops_handle(mir, body)
    pilot old_rvalue_lhs = v4_mir_body_rvalue_lhs_handle(mir, body)
    pilot old_rvalue_rhs = v4_mir_body_rvalue_rhs_handle(mir, body)
    pilot old_rvalue_spans = v4_mir_body_rvalue_spans_handle(mir, body)
    pilot old_rvalue_tys = v4_mir_body_rvalue_tys_handle(mir, body)
    pilot old_rvalue_abis = v4_mir_body_rvalue_abis_handle(mir, body)
    pilot old_rvalue_args = v4_mir_body_rvalue_args_handle(mir, body)
    pilot old_rvalue_builtin_methods = v4_mir_body_rvalue_builtin_methods_handle(mir, body)
    pilot old_place_kinds = v4_mir_body_place_kinds_handle(mir, body)
    pilot old_place_texts = v4_mir_body_place_texts_handle(mir, body)
    pilot old_place_bases = v4_mir_body_place_bases_handle(mir, body)
    pilot old_place_fields = v4_mir_body_place_fields_handle(mir, body)
    pilot old_place_indices = v4_mir_body_place_indices_handle(mir, body)
    pilot old_place_spans = v4_mir_body_place_spans_handle(mir, body)
    pilot old_place_tys = v4_mir_body_place_tys_handle(mir, body)
    pilot old_stmt_places = v4_mir_body_stmt_places_handle(mir, body)
    pilot old_stmt_rvalues = v4_mir_body_stmt_rvalues_handle(mir, body)
    pilot old_stmt_kinds = v4_mir_body_stmt_kinds_handle(mir, body)
    pilot old_stmt_lhs = v4_mir_body_stmt_lhs_handle(mir, body)
    pilot old_stmt_rhs = v4_mir_body_stmt_rhs_handle(mir, body)
    pilot old_stmt_spans = v4_mir_body_stmt_spans_handle(mir, body)
    pilot old_stmt_scope_spans = v4_mir_body_stmt_scope_spans_handle(mir, body)
    pilot old_stmt_blocks = v4_mir_body_stmt_blocks_handle(mir, body)
    pilot old_blocks = v4_mir_body_blocks_handle(mir, body)
    pilot old_local_names = v4_mir_body_local_names_handle(mir, body)
    pilot old_local_tys = v4_mir_body_local_tys_handle(mir, body)
    pilot old_local_modes = v4_mir_body_local_modes_handle(mir, body)
    pilot old_local_spans = v4_mir_body_local_spans_handle(mir, body)
    pilot old_local_scope_spans = v4_mir_body_local_scope_spans_handle(mir, body)
    array_set(v4_mir_rvalue_kinds_index_handle(mir), body, word_from_int(staged_rvalue_kinds))
    array_set(v4_mir_rvalue_texts_index_handle(mir), body, word_from_int(staged_rvalue_texts))
    array_set(v4_mir_rvalue_ops_index_handle(mir), body, word_from_int(staged_rvalue_ops))
    array_set(v4_mir_rvalue_lhs_index_handle(mir), body, word_from_int(staged_rvalue_lhs))
    array_set(v4_mir_rvalue_rhs_index_handle(mir), body, word_from_int(staged_rvalue_rhs))
    array_set(v4_mir_rvalue_spans_index_handle(mir), body, word_from_int(staged_rvalue_spans))
    array_set(v4_mir_rvalue_tys_index_handle(mir), body, word_from_int(staged_rvalue_tys))
    array_set(v4_mir_rvalue_abis_index_handle(mir), body, word_from_int(staged_rvalue_abis))
    array_set(v4_mir_rvalue_args_index_handle(mir), body, word_from_int(staged_rvalue_args))
    array_set(v4_mir_rvalue_builtin_methods_index_handle(mir), body, word_from_int(staged_rvalue_builtin_methods))
    array_set(v4_mir_place_kinds_index_handle(mir), body, word_from_int(staged_place_kinds))
    array_set(v4_mir_place_texts_index_handle(mir), body, word_from_int(staged_place_texts))
    array_set(v4_mir_place_bases_index_handle(mir), body, word_from_int(staged_place_bases))
    array_set(v4_mir_place_fields_index_handle(mir), body, word_from_int(staged_place_fields))
    array_set(v4_mir_place_indices_index_handle(mir), body, word_from_int(staged_place_indices))
    array_set(v4_mir_place_spans_index_handle(mir), body, word_from_int(staged_place_spans))
    array_set(v4_mir_place_tys_index_handle(mir), body, word_from_int(staged_place_tys))
    array_set(v4_mir_stmt_places_index_handle(mir), body, word_from_int(staged_stmt_places))
    array_set(v4_mir_stmt_rvalues_index_handle(mir), body, word_from_int(staged_stmt_rvalues))
    array_set(v4_mir_stmt_kinds_index_handle(mir), body, word_from_int(staged_stmt_kinds))
    array_set(v4_mir_stmt_lhs_index_handle(mir), body, word_from_int(staged_stmt_lhs))
    array_set(v4_mir_stmt_rhs_index_handle(mir), body, word_from_int(staged_stmt_rhs))
    array_set(v4_mir_stmt_spans_index_handle(mir), body, word_from_int(staged_stmt_spans))
    array_set(v4_mir_stmt_scope_spans_index_handle(mir), body, word_from_int(staged_stmt_scope_spans))
    array_set(v4_mir_stmt_blocks_index_handle(mir), body, word_from_int(staged_stmt_blocks))
    array_set(v4_mir_blocks_handle(mir), body, word_from_int(staged_blocks))
    array_set(v4_mir_local_names_index_handle(mir), body, word_from_int(staged_local_names))
    array_set(v4_mir_local_tys_index_handle(mir), body, word_from_int(staged_local_tys))
    array_set(v4_mir_local_modes_index_handle(mir), body, word_from_int(staged_local_modes))
    array_set(v4_mir_local_spans_index_handle(mir), body, word_from_int(staged_local_spans))
    array_set(v4_mir_local_scope_spans_index_handle(mir), body, word_from_int(staged_local_scope_spans))
    array_release(old_rvalue_kinds)
    array_release(old_rvalue_texts)
    array_release(old_rvalue_ops)
    array_release(old_rvalue_lhs)
    array_release(old_rvalue_rhs)
    array_release(old_rvalue_spans)
    array_release(old_rvalue_tys)
    array_release(old_rvalue_abis)
    array_release(old_rvalue_args)
    array_release(old_rvalue_builtin_methods)
    array_release(old_place_kinds)
    array_release(old_place_texts)
    array_release(old_place_bases)
    array_release(old_place_fields)
    array_release(old_place_indices)
    array_release(old_place_spans)
    array_release(old_place_tys)
    array_release(old_stmt_places)
    array_release(old_stmt_rvalues)
    array_release(old_stmt_kinds)
    array_release(old_stmt_lhs)
    array_release(old_stmt_rhs)
    array_release(old_stmt_spans)
    array_release(old_stmt_scope_spans)
    array_release(old_stmt_blocks)
    array_release(old_blocks)
    array_release(old_local_names)
    array_release(old_local_tys)
    array_release(old_local_modes)
    array_release(old_local_spans)
    array_release(old_local_scope_spans)
    v4_mir_invalidate_block_stmt_index(mir, body)
    give back ""
}


task v4_mir_rvalue_is_static_never(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) or v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_call or v4_mir_rvalue_ty(mir, body, value) != v4_ty_never or v4_mir_rvalue_builtin_method(mir, body, value) != "" { give back false }
    if v4_mir_rvalue_lhs(mir, body, value) != -1 or v4_mir_rvalue_rhs(mir, body, value) != -1 { give back false }
    pilot ty = v4_mir_ty_id(mir)
    pilot signature = v4_ty_task_signature_id_for_name(ty, v4_mir_rvalue_op(mir, body, value))
    if signature < 0 or not v4_ty_signature_is_ordinary_static_task(ty, signature) or v4_ty_signature_generic_count(ty, signature) != 0 or v4_ty_signature_is_variadic(ty, signature) { give back false }
    if v4_ty_signature_return_type(ty, signature) != v4_ty_never or v4_mir_rvalue_abi(mir, body, value) != v4_ty_signature_call_abi(ty, signature) { give back false }
    pilot target = v4_mir_lookup_body_name(mir, v4_mir_rvalue_op(mir, body, value))
    if target < 0 or v4_mir_body_callable_return_type(mir, target) != v4_ty_never or v4_mir_body_def(mir, target) != v4_ty_signature_def(ty, signature) or v4_mir_body_name(mir, target) != v4_ty_signature_name(ty, signature) { give back false }
    pilot count = v4_ty_signature_fixed_param_count(ty, signature)
    if v4_mir_rvalue_call_arg_count(mir, body, value) != count { give back false }
    pilot arg = 0
    repeat until arg >= count {
        pilot child = v4_mir_rvalue_call_arg(mir, body, value, arg)
        if child < 0 or child >= value { give back false }
        pilot actual = v4_mir_rvalue_ty(mir, body, child)
        if actual == v4_ty_never or not v4_ty_is_known(actual) { give back false }
        pilot expected = v4_ty_signature_param_type(ty, signature, arg)
        if not v4_ty_is_known(expected) { give back false }
        pilot mode = v4_ty_signature_param_mode(ty, signature, arg)
        if mode == v4_ty_param_mode_lend or mode == v4_ty_param_mode_lend_mut {
            if not v4_ty_is_lend_type(actual) { give back false }
            if mode == v4_ty_param_mode_lend_mut and not v4_ty_is_lend_mut_type(actual) { give back false }
            pilot child_kind = v4_mir_rvalue_kind(mir, body, child)
            if child_kind != v4_mir_rvalue_lend and child_kind != v4_mir_rvalue_lend_mut { give back false }
            if mode == v4_ty_param_mode_lend_mut and child_kind != v4_mir_rvalue_lend_mut { give back false }
            if v4_mir_rvalue_rhs(mir, body, child) != -1 or v4_mir_rvalue_args_payload(mir, body, child) != "" { give back false }
            pilot owner = v4_mir_rvalue_lhs(mir, body, child)
            actual = v4_ty_lend_target_type(actual)
            if owner < 0 or owner >= child or not v4_ty_is_known(actual) or actual != v4_mir_rvalue_ty(mir, body, owner) { give back false }
        } else if mode != v4_ty_param_mode_value { give back false }
        if not v4_ty_types_compatible_in_signature(ty, signature, expected, actual) { give back false }
        arg += 1
    }
    give back true
}

-- Scalar Sum admission shares these row readers between live and staged MIR.
-- No construction flags or proof state are persisted in the wire protocol.
task v4_mir_sum_row_local(values: int, locals: int, value: int) -> int {
    if value < 0 or value >= array_len(values) { give back -1 }
    pilot row: word = array_get(values, value)
    if v4_mir_snapshot_field(row, 4) != v4_mir_rvalue_use_local { give back -1 }
    pilot op = v4_mir_snapshot_field(row, 6)
    if not op.starts_with("local#") { give back -1 }
    pilot raw = v4_slice(op, 6, op.length())
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw) { give back -1 }
    pilot local = word_to_int(raw)
    if local < 0 or local >= array_len(locals) or word_from_int(local) != raw { give back -1 }
    pilot binding: word = array_get(locals, local)
    if v4_mir_snapshot_field(row, 5) != v4_mir_snapshot_field(binding, 4) or v4_mir_snapshot_field(row, 10) != v4_mir_snapshot_field(binding, 5) { give back -1 }
    if v4_mir_snapshot_field_raw(row, 7) != "-1" or v4_mir_snapshot_field_raw(row, 8) != "-1" or v4_mir_snapshot_field(row, 11) != "" or v4_mir_snapshot_field(row, 12) != "" or v4_mir_snapshot_field(row, 13) != "" { give back -1 }
    give back local
}

task v4_mir_sum_row_word_loan_is_valid(values: int, locals: int, loan: int, parent: int) -> bool {
    if loan < 0 or loan >= parent or loan >= array_len(values) { give back false }
    pilot row: word = array_get(values, loan)
    if v4_mir_snapshot_field(row, 4) != v4_mir_rvalue_lend or v4_mir_snapshot_field(row, 10) != "lend word" or v4_mir_snapshot_field_raw(row, 8) != "-1" or v4_mir_snapshot_field(row, 11) != "" or v4_mir_snapshot_field(row, 12) != "" or v4_mir_snapshot_field(row, 13) != "" { give back false }
    pilot owner = word_to_int(v4_mir_snapshot_field_raw(row, 7))
    if owner < 0 or owner >= loan or v4_mir_control_row_type(values, owner) != v4_ty_word { give back false }
    pilot owning: word = array_get(values, owner)
    pilot kind = v4_mir_snapshot_field(owning, 4)
    if kind == v4_mir_rvalue_use_local { give back v4_mir_sum_row_local(values, locals, owner) >= 0 }
    give back kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_call or kind == v4_mir_rvalue_sum_take
}

task v4_mir_sum_row_intrinsic_error(ty: int, values: int, locals: int, value: int) -> word {
    pilot row: word = array_get(values, value)
    pilot identity = v4_mir_snapshot_field(row, 13)
    pilot op = v4_mir_snapshot_field(row, 6)
    pilot system: bool = identity.starts_with("builtin::system::") or op.starts_with("builtin::system::")
    pilot parser: bool = identity == "builtin::word::to_int_maybe" or op == "builtin::word::to_int_maybe"
    if not system and not parser { give back "" }
    pilot kind = v4_mir_builtin_system_identity_kind(identity)
    if parser { kind = "to_int_maybe" }
    if kind == "" or identity != op or v4_mir_snapshot_field(row, 4) != v4_mir_rvalue_call or v4_mir_snapshot_field_raw(row, 7) != "-1" or v4_mir_snapshot_field_raw(row, 8) != "-1" or v4_mir_snapshot_field(row, 11) != "" { give back "invalid scalar sum intrinsic identity" }
    if system {
        pilot span = v4_mir_snapshot_field(row, 9)
        if not v4_mir_system_intrinsic_origin_is_available(ty, kind, span) { give back "scalar sum system intrinsic has a shadowed or invalid binding origin" }
        pilot local = 0
        repeat until local >= array_len(locals) {
            pilot binding: word = array_get(locals, local)
            if v4_mir_system_intrinsic_shadow_is_visible(kind, span, v4_mir_snapshot_field(binding, 4), v4_mir_snapshot_field(binding, 7), v4_mir_snapshot_field(binding, 8)) { give back "scalar sum system intrinsic has a shadowed or invalid binding origin" }
            local += 1
        }
    }
    pilot expected = v4_ty_system_intrinsic_result_type(kind)
    pilot count = v4_ty_system_intrinsic_param_count(kind)
    if parser { expected = v4_ty_word_intrinsic_result_type(kind); count = 1 }
    pilot actual = v4_mir_snapshot_field(row, 10)
    if actual != expected { give back "invalid scalar sum intrinsic result type" }
    if kind != "args_count" and not v4_ty_is_native_scalar_sum(ty, actual) { give back "scalar sum intrinsic has no prelude carrier origin" }
    pilot args = v4_mir_snapshot_field(row, 12)
    if v4_mir_call_args_payload_count(args) != count { give back "invalid scalar sum intrinsic argument count" }
    if count == 0 { give back "" }
    pilot child = v4_mir_call_args_payload_at(args, 0)
    if child < 0 or child >= value { give back "invalid scalar sum intrinsic argument reference" }
    if kind == "process_arg" {
        if v4_mir_control_row_type(values, child) != v4_ty_int { give back "process argument index must be int" }
        pilot child_row: word = array_get(values, child)
        if v4_mir_snapshot_field(child_row, 4) == v4_mir_rvalue_use_local and v4_mir_sum_row_local(values, locals, child) < 0 { give back "invalid scalar sum intrinsic local identity" }
    } else if not v4_mir_sum_row_word_loan_is_valid(values, locals, child, value) { give back "scalar sum intrinsic requires an immutable word loan" }
    give back ""
}

task v4_mir_sum_row_value_error(ty: int, values: int, locals: int, value: int) -> word {
    pilot row: word = array_get(values, value)
    pilot kind = v4_mir_snapshot_field(row, 4)
    pilot op = v4_mir_snapshot_field(row, 6)
    pilot carrier = v4_ty_native_scalar_sum_kind(ty, v4_mir_snapshot_field(row, 10))
    pilot error = v4_mir_sum_row_intrinsic_error(ty, values, locals, value)
    if error != "" { give back error }
    if carrier != "" and kind == v4_mir_rvalue_use_local and v4_mir_sum_row_local(values, locals, value) < 0 { give back "invalid scalar sum local identity" }
    pilot lhs = word_to_int(v4_mir_snapshot_field_raw(row, 7))
    if carrier != "" and (kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err) {
        if v4_mir_snapshot_field_raw(row, 8) != "-1" or v4_mir_snapshot_field(row, 11) != "" or v4_mir_snapshot_field(row, 12) != "" or v4_mir_snapshot_field(row, 13) != "" { give back "invalid scalar sum constructor shape" }
        if kind == v4_mir_rvalue_nobody {
            if carrier != "MaybeInt" or op != "Nobody" or lhs != -1 { give back "invalid scalar sum Nobody constructor" }
        } else {
            if lhs < 0 or lhs >= value { give back "invalid scalar sum constructor operand" }
            if kind == v4_mir_rvalue_some {
                if carrier != "MaybeInt" or op != "Some" or v4_mir_control_row_type(values, lhs) != v4_ty_int { give back "scalar Some requires an exact int payload" }
            } else {
                if carrier != "ResultWordWord" or v4_mir_control_row_type(values, lhs) != v4_ty_word { give back "scalar Result requires an owned word payload" }
                if (kind == v4_mir_rvalue_ok and op != "Ok") or (kind == v4_mir_rvalue_err and op != "Err") { give back "invalid scalar Result constructor tag" }
                pilot payload: word = array_get(values, lhs)
                pilot payload_kind = v4_mir_snapshot_field(payload, 4)
                if payload_kind != v4_mir_rvalue_use_local and payload_kind != v4_mir_rvalue_const_word and payload_kind != v4_mir_rvalue_call and payload_kind != v4_mir_rvalue_sum_take { give back "scalar Result requires an owned word expression" }
                if payload_kind == v4_mir_rvalue_use_local {
                    pilot binding = v4_mir_sum_row_local(values, locals, lhs)
                    if binding < 0 { give back "invalid scalar Result payload identity" }
                    pilot local_row: word = array_get(locals, binding)
                    if v4_mir_snapshot_field(local_row, 6) != v4_ty_param_mode_value { give back "scalar Result cannot consume a borrowed word" }
                }
            }
        }
    }
    pilot source_carrier = v4_ty_native_scalar_sum_kind(ty, v4_mir_control_row_type(values, lhs))
    if kind == v4_mir_rvalue_sum_take or (kind == v4_mir_rvalue_check and source_carrier != "") {
        if lhs < 0 or lhs >= value or v4_mir_sum_row_local(values, locals, lhs) < 0 or v4_mir_snapshot_field_raw(row, 8) != "-1" or v4_mir_snapshot_field(row, 11) != "" or v4_mir_snapshot_field(row, 12) != "" or v4_mir_snapshot_field(row, 13) != "" { give back "invalid scalar sum observer or extraction shape" }
        if kind == v4_mir_rvalue_check {
            if v4_mir_snapshot_field(row, 10) != v4_ty_bool or (source_carrier == "MaybeInt" and op != "HasSome") or (source_carrier == "ResultWordWord" and op != "IsOk") { give back "invalid scalar sum tag observer" }
        } else {
            if source_carrier == "MaybeInt" {
                if op != "TakeSome" or v4_mir_snapshot_field(row, 10) != v4_ty_int { give back "invalid scalar maybe extraction" }
            } else if source_carrier == "ResultWordWord" {
                if (op != "TakeOk" and op != "TakeErr") or v4_mir_snapshot_field(row, 10) != v4_ty_word { give back "invalid scalar Result extraction" }
            } else { give back "unsupported scalar sum extraction carrier" }
            pilot source_local = v4_mir_sum_row_local(values, locals, lhs)
            pilot local_row: word = array_get(locals, source_local)
            if v4_mir_snapshot_field(local_row, 6) != v4_ty_param_mode_value { give back "scalar sum extraction cannot consume borrowed storage" }
        }
    }
    give back ""
}

-- Four derived states: absent/moved, live with unknown tag, live true, live
-- false. Each reachable incoming state is checked independently; joins never
-- invent a tag proof and loop backedges cannot reuse an earlier extraction.
task v4_mir_sum_state_error(state: int) -> word {
    if state == -1 { give back "scalar sum ownership proof exhausted or malformed" }
    if state == -2 { give back "scalar sum use requires a live owner" }
    if state == -3 { give back "scalar sum extraction requires the matching branch tag" }
    give back ""
}

task v4_mir_sum_place_state(values: int, locals: int, places: int, place: int, local: int, state: int, depth: int) -> int {
    if state < 0 or place < 0 { give back state }
    if place >= array_len(places) or depth > 256 or v4_mir_sum_visit_budget <= 0 { give back -1 }
    v4_mir_sum_visit_budget -= 1
    pilot row: word = array_get(places, place)
    pilot kind = v4_mir_snapshot_field(row, 4)
    if kind == v4_mir_place_local {
        if word_to_int(v4_mir_snapshot_field_raw(row, 6)) == local and state == 0 { give back -2 }
        give back state
    }
    if kind == v4_mir_place_field or kind == v4_mir_place_index {
        state = v4_mir_sum_place_state(values, locals, places, word_to_int(v4_mir_snapshot_field_raw(row, 6)), local, state, depth + 1)
    }
    if kind == v4_mir_place_index or kind == v4_mir_place_deref {
        state = v4_mir_sum_value_state(values, locals, places, word_to_int(v4_mir_snapshot_field_raw(row, 8)), local, state, false, depth + 1)
    }
    give back state
}

task v4_mir_sum_place_address_state(values: int, locals: int, places: int, place: int, local: int, state: int, depth: int) -> int {
    if state < 0 or place < 0 { give back state }
    if place >= array_len(places) or depth > 256 or v4_mir_sum_visit_budget <= 0 { give back -1 }
    v4_mir_sum_visit_budget -= 1
    pilot row: word = array_get(places, place)
    pilot kind = v4_mir_snapshot_field(row, 4)
    -- Rebinding a LocalPlace neither observes nor moves its previous owner.
    if kind == v4_mir_place_local or kind == v4_mir_place_return { give back state }
    if kind == v4_mir_place_field or kind == v4_mir_place_index {
        state = v4_mir_sum_place_address_state(values, locals, places, word_to_int(v4_mir_snapshot_field_raw(row, 6)), local, state, depth + 1)
    }
    if kind == v4_mir_place_index or kind == v4_mir_place_deref {
        state = v4_mir_sum_value_state(values, locals, places, word_to_int(v4_mir_snapshot_field_raw(row, 8)), local, state, false, depth + 1)
    }
    give back state
}

task v4_mir_sum_value_state(values: int, locals: int, places: int, value: int, local: int, state: int, borrowed: bool, depth: int) -> int {
    if state < 0 or value < 0 { give back state }
    if value >= array_len(values) or depth > 256 or v4_mir_sum_visit_budget <= 0 { give back -1 }
    v4_mir_sum_visit_budget -= 1
    pilot row: word = array_get(values, value)
    pilot kind = v4_mir_snapshot_field(row, 4)
    pilot lhs = word_to_int(v4_mir_snapshot_field_raw(row, 7))
    pilot rhs = word_to_int(v4_mir_snapshot_field_raw(row, 8))
    if kind == v4_mir_rvalue_use_local {
        if v4_mir_sum_row_local(values, locals, value) == local {
            if state == 0 { give back -2 }
            if not borrowed { give back 0 }
        }
        give back state
    }
    if kind == v4_mir_rvalue_use_place { give back v4_mir_sum_place_state(values, locals, places, lhs, local, state, depth + 1) }
    if kind == v4_mir_rvalue_sum_take {
        if v4_mir_sum_row_local(values, locals, lhs) == local {
            pilot expected = 2
            if v4_mir_snapshot_field(row, 6) == "TakeErr" { expected = 3 }
            if state == 0 { give back -2 }
            if state != expected { give back -3 }
            give back 0
        }
        give back state
    }
    if kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_mir_sum_value_state(values, locals, places, lhs, local, state, true, depth + 1)
    }
    pilot args = v4_mir_snapshot_field(row, 12)
    pilot count = v4_mir_call_args_payload_count(args)
    pilot callable = -1
    if kind == v4_mir_rvalue_call {
        pilot target_type = v4_mir_control_row_type(values, lhs)
        if v4_ty_is_surface_task_function_type(target_type) or v4_ty_is_closure_type(target_type) { callable = lhs }
        if callable >= 0 { state = v4_mir_sum_value_state(values, locals, places, callable, local, state, false, depth + 1) }
        if count == 0 and callable < 0 {
            state = v4_mir_sum_value_state(values, locals, places, lhs, local, state, false, depth + 1)
            state = v4_mir_sum_value_state(values, locals, places, rhs, local, state, false, depth + 1)
        }
    } else {
        state = v4_mir_sum_value_state(values, locals, places, lhs, local, state, false, depth + 1)
        state = v4_mir_sum_value_state(values, locals, places, rhs, local, state, false, depth + 1)
    }
    pilot argument = 0
    repeat until argument >= count or state < 0 {
        pilot child = v4_mir_call_args_payload_at(args, argument)
        if child != callable { state = v4_mir_sum_value_state(values, locals, places, child, local, state, false, depth + 1) }
        argument += 1
    }
    give back state
}

task v4_mir_sum_block_scope(blocks: int, statements: int, block: int, start: bool) -> word {
    pilot scope = v4_mir_block_part(array_get(blocks, block), 5)
    pilot row = 0
    repeat until row >= array_len(statements) {
        pilot statement: word = array_get(statements, row)
        if word_to_int(v4_mir_snapshot_field_raw(statement, 8)) == block {
            scope = v4_mir_snapshot_field(statement, 11)
            if start { give back scope }
        }
        row += 1
    }
    give back scope
}

task v4_mir_sum_queue_state(queue: int, seen: int, block: int, state: int) -> bool {
    if block < 0 or state < 0 or state > 3 or block * 4 + state >= array_len(seen) { give back false }
    pilot slot = block * 4 + state
    pilot prior: word = array_get(seen, slot)
    if prior == "1" { give back true }
    if not v4_mir_control_checked_push(queue, word_from_int(slot)) { give back false }
    array_set(seen, slot, "1")
    pilot stored: word = array_get(seen, slot)
    give back stored == "1"
}

task v4_mir_sum_local_rows_error(ty: int, definition: word, blocks: int, locals: int, statements: int, places: int, values: int, local: int) -> word {
    pilot queue = array_new()
    pilot seen = array_new()
    pilot error = ""
    if queue < 0 or seen < 0 { error = "scalar sum ownership proof scratch exhausted" }
    pilot count = array_len(blocks)
    if count <= 0 or count > 134217727 { error = "scalar sum ownership proof requires bounded CFG blocks" }
    pilot row = 0
    repeat until row >= count * 4 or error != "" {
        if not v4_mir_control_checked_push(seen, "0") { error = "scalar sum ownership proof scratch exhausted" }
        row += 1
    }
    pilot binding: word = array_get(locals, local)
    pilot local_scope = v4_mir_snapshot_field(binding, 8)
    pilot initial = 0
    if local < v4_ty_callable_param_count_for_def(ty, definition) { initial = 1 }
    if error == "" and not v4_mir_sum_queue_state(queue, seen, 0, initial) { error = "scalar sum ownership proof scratch exhausted" }
    pilot next = 0
    repeat until next >= array_len(queue) or error != "" {
        pilot queued = word_to_int(array_get(queue, next))
        pilot block = queued / 4
        pilot state = queued % 4
        pilot previous_scope = v4_mir_sum_block_scope(blocks, statements, block, true)
        pilot condition = -1
        row = 0
        repeat until row >= array_len(statements) or error != "" {
            pilot statement: word = array_get(statements, row)
            if word_to_int(v4_mir_snapshot_field_raw(statement, 8)) == block {
                pilot scope = v4_mir_snapshot_field(statement, 11)
                if v4_mir_scope_contains(local_scope, previous_scope) and not v4_mir_scope_contains(local_scope, scope) { state = 0 }
                previous_scope = scope
                v4_mir_sum_visit_budget = 8192
                pilot value = word_to_int(v4_mir_snapshot_field_raw(statement, 10))
                state = v4_mir_sum_value_state(values, locals, places, value, local, state, false, 0)
                -- Native assignment evaluates RHS before destination address.
                pilot place = word_to_int(v4_mir_snapshot_field_raw(statement, 9))
                state = v4_mir_sum_place_address_state(values, locals, places, place, local, state, 0)
                error = v4_mir_sum_state_error(state)
                pilot kind = v4_mir_snapshot_field(statement, 4)
                if error == "" and (kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign) and place >= 0 and place < array_len(places) {
                    pilot destination: word = array_get(places, place)
                    if v4_mir_snapshot_field(destination, 4) == v4_mir_place_local and word_to_int(v4_mir_snapshot_field_raw(destination, 6)) == local { state = 1 }
                }
                if v4_mir_control_is_conditional_statement(kind) { condition = value }
            }
            row += 1
        }
        pilot record: word = array_get(blocks, block)
        pilot edges = 0
        pilot term = v4_mir_block_terminator(record)
        if term == v4_mir_term_goto { edges = 1 }
        if term == v4_mir_term_if { edges = 2 }
        pilot edge = 0
        repeat until edge >= edges or error != "" {
            pilot target = v4_mir_block_target(record)
            if edge == 1 { target = v4_mir_block_else_target(record) }
            pilot outgoing = state
            pilot selected: bool = true
            if condition >= 0 and condition < array_len(values) {
                pilot observer: word = array_get(values, condition)
                if v4_mir_snapshot_field(observer, 4) == v4_mir_rvalue_check and v4_mir_sum_row_local(values, locals, word_to_int(v4_mir_snapshot_field_raw(observer, 7))) == local {
                    pilot proven = 2
                    if edge == 1 { proven = 3 }
                    if state == 0 { error = "scalar sum tag branch requires a live owner" }
                    if state == 2 or state == 3 { selected = state == proven }
                    outgoing = proven
                }
            }
            if target < 0 or target >= count { error = "invalid scalar sum CFG edge" } else {
                pilot scope = v4_mir_sum_block_scope(blocks, statements, target, true)
                if v4_mir_scope_contains(local_scope, previous_scope) and not v4_mir_scope_contains(local_scope, scope) { outgoing = 0 }
                if selected and error == "" and not v4_mir_sum_queue_state(queue, seen, target, outgoing) { error = "scalar sum ownership proof scratch exhausted" }
            }
            edge += 1
        }
        next += 1
    }
    array_release(seen)
    array_release(queue)
    give back error
}

task v4_mir_sum_rows_are_sensitive(ty: int, definition: word, locals: int, values: int) -> bool {
    if v4_ty_is_native_scalar_sum(ty, v4_ty_callable_return_type_for_def(ty, definition)) { give back true }
    pilot signature = v4_ty_lookup_signature(ty, definition)
    pilot parameter = 0
    if signature >= 0 {
        repeat until parameter >= v4_ty_signature_fixed_param_count(ty, signature) {
            if v4_ty_is_native_scalar_sum(ty, v4_ty_signature_param_type(ty, signature, parameter)) { give back true }
            parameter += 1
        }
    }
    pilot row = 0
    repeat until row >= array_len(locals) {
        if v4_ty_is_native_scalar_sum(ty, v4_mir_snapshot_field(array_get(locals, row), 5)) { give back true }
        row += 1
    }
    row = 0
    repeat until row >= array_len(values) {
        pilot value: word = array_get(values, row)
        if v4_ty_is_native_scalar_sum(ty, v4_mir_snapshot_field(value, 10)) or v4_mir_snapshot_field(value, 4) == v4_mir_rvalue_sum_take { give back true }
        if v4_mir_snapshot_field(value, 13).starts_with("builtin::system::") or v4_mir_snapshot_field(value, 6).starts_with("builtin::system::") or v4_mir_snapshot_field(value, 13) == "builtin::word::to_int_maybe" or v4_mir_snapshot_field(value, 6) == "builtin::word::to_int_maybe" { give back true }
        row += 1
    }
    give back false
}

task v4_mir_sum_row_call_error(ty: int, values: int, locals: int, value: int) -> word {
    pilot row: word = array_get(values, value)
    if v4_mir_snapshot_field(row, 4) != v4_mir_rvalue_call { give back "" }
    pilot returned_type = v4_mir_snapshot_field(row, 10)
    pilot required: bool = v4_ty_is_native_scalar_sum(ty, returned_type)
    pilot args = v4_mir_snapshot_field(row, 12)
    pilot count = v4_mir_call_args_payload_count(args)
    pilot arg = 0
    repeat until arg >= count {
        if v4_ty_is_native_scalar_sum(ty, v4_mir_control_row_type(values, v4_mir_call_args_payload_at(args, arg))) { required = true }
        arg += 1
    }
    if not required { give back "" }
    pilot identity = v4_mir_snapshot_field(row, 13)
    if v4_mir_builtin_system_identity_kind(identity) != "" or identity == "builtin::word::to_int_maybe" { give back v4_mir_sum_row_intrinsic_error(ty, values, locals, value) }
    if identity != "" or v4_mir_snapshot_field_raw(row, 7) != "-1" or v4_mir_snapshot_field_raw(row, 8) != "-1" { give back "scalar sum calls require a resolved ordinary static task" }
    pilot signature = v4_ty_task_signature_id_for_name(ty, v4_mir_snapshot_field(row, 6))
    if signature < 0 or not v4_ty_signature_is_ordinary_static_task(ty, signature) or v4_ty_signature_generic_count(ty, signature) != 0 or v4_ty_signature_is_variadic(ty, signature) { give back "scalar sum calls require a resolved ordinary static task" }
    if returned_type != v4_ty_signature_return_type(ty, signature) or v4_mir_snapshot_field(row, 11) != v4_ty_signature_call_abi(ty, signature) or count != v4_ty_signature_fixed_param_count(ty, signature) { give back "invalid scalar sum task call contract" }
    arg = 0
    repeat until arg >= count {
        pilot child = v4_mir_call_args_payload_at(args, arg)
        if child < 0 or child >= value { give back "invalid scalar sum task argument reference" }
        pilot actual = v4_mir_control_row_type(values, child)
        pilot expected = v4_ty_signature_param_type(ty, signature, arg)
        pilot mode = v4_ty_signature_param_mode(ty, signature, arg)
        pilot child_row: word = array_get(values, child)
        if v4_ty_is_native_scalar_sum(ty, actual) or v4_ty_is_native_scalar_sum(ty, expected) {
            if actual != expected or mode != v4_ty_param_mode_value { give back "scalar sum arguments require exact owning value parameters" }
        } else if mode == v4_ty_param_mode_lend {
            if expected != v4_ty_word or not v4_mir_sum_row_word_loan_is_valid(values, locals, child, value) { give back "invalid scalar sum task word loan argument" }
            actual = v4_ty_word
        } else if mode != v4_ty_param_mode_value { give back "unsupported scalar sum task parameter mode" }
        if not v4_ty_types_compatible_in_signature(ty, signature, expected, actual) { give back "invalid scalar sum task argument type" }
        if v4_mir_snapshot_field(child_row, 4) == v4_mir_rvalue_use_local and v4_mir_sum_row_local(values, locals, child) < 0 { give back "invalid scalar sum task argument local identity" }
        arg += 1
    }
    give back ""
}

task v4_mir_sum_return_rows_error(ty: int, definition: word, blocks: int, statements: int, values: int) -> word {
    pilot returned_type = v4_ty_callable_return_type_for_def(ty, definition)
    if not v4_ty_is_native_scalar_sum(ty, returned_type) { give back "" }
    pilot queue = array_new()
    pilot seen = array_new()
    pilot error = ""
    if queue < 0 or seen < 0 { error = "scalar sum return proof scratch exhausted" }
    pilot count = array_len(blocks)
    if count <= 0 { error = "scalar sum task has no body" }
    pilot row = 0
    repeat until row >= count or error != "" {
        if not v4_mir_control_checked_push(seen, "0") { error = "scalar sum return proof scratch exhausted" }
        row += 1
    }
    if error == "" {
        if not v4_mir_control_checked_push(queue, "0") { error = "scalar sum return proof scratch exhausted" }
        array_set(seen, 0, "1")
    }
    row = 0
    repeat until row >= array_len(queue) or error != "" {
        pilot block = word_to_int(array_get(queue, row))
        pilot record: word = array_get(blocks, block)
        pilot term = v4_mir_block_terminator(record)
        if term == v4_mir_term_return {
            pilot last = -1
            pilot statement = 0
            repeat until statement >= array_len(statements) {
                pilot candidate: word = array_get(statements, statement)
                if word_to_int(v4_mir_snapshot_field_raw(candidate, 8)) == block { last = statement }
                statement += 1
            }
            if last < 0 { error = "scalar sum return requires an explicit owned value" } else {
                pilot candidate: word = array_get(statements, last)
                if v4_mir_snapshot_field(candidate, 4) != v4_mir_stmt_return or v4_mir_control_row_type(values, word_to_int(v4_mir_snapshot_field_raw(candidate, 10))) != returned_type { error = "scalar sum return requires an explicit owned value" }
            }
        }
        pilot edges = 0
        if term == v4_mir_term_goto { edges = 1 }
        if term == v4_mir_term_if { edges = 2 }
        pilot edge = 0
        repeat until edge >= edges or error != "" {
            pilot target = v4_mir_block_target(record)
            if edge == 1 { target = v4_mir_block_else_target(record) }
            if target < 0 or target >= count { error = "invalid scalar sum return CFG edge" } else {
                pilot state: word = array_get(seen, target)
                if state == "0" {
                    if not v4_mir_control_checked_push(queue, word_from_int(target)) { error = "scalar sum return proof scratch exhausted" }
                    array_set(seen, target, "1")
                }
            }
            edge += 1
        }
        row += 1
    }
    array_release(seen)
    array_release(queue)
    give back error
}

task v4_mir_scalar_sum_body_rows_error(ty: int, file: int, header: word, blocks: int, locals: int, statements: int, places: int, values: int) -> word {
    pilot definition = v4_mir_snapshot_field(header, 3)
    if not v4_mir_sum_rows_are_sensitive(ty, definition, locals, values) { give back "" }
    pilot signature = v4_ty_lookup_signature(ty, definition)
    if signature < 0 or not v4_ty_signature_is_ordinary_static_task(ty, signature) or v4_ty_signature_generic_count(ty, signature) != 0 or v4_ty_signature_is_variadic(ty, signature) { give back "scalar sum body requires an ordinary nongeneric task" }
    if v4_mir_snapshot_field(header, 4) != v4_ty_signature_name(ty, signature) or v4_mir_snapshot_field(header, 5) != v4_ty_signature_of(ty, definition) { give back "invalid scalar sum task body identity" }
    pilot parameters = v4_ty_signature_fixed_param_count(ty, signature)
    if parameters > array_len(locals) { give back "invalid scalar sum task parameter locals" }
    pilot body_span = v4_mir_word_source_body_span(ty, definition)
    if body_span == (V4_NO_SPAN) { give back "scalar sum task requires authoritative source scope" }
    if v4_span_file(body_span) != word_from_int(file) { give back "scalar sum task source file mismatch" }
    pilot row = 0
    repeat until row >= array_len(locals) {
        pilot binding: word = array_get(locals, row)
        pilot type_text = v4_mir_snapshot_field(binding, 5)
        pilot scalar: bool = v4_ty_is_native_scalar_sum(ty, type_text)
        if not v4_mir_word_scope_fact_is_valid(v4_mir_snapshot_field(binding, 8), file, body_span, v4_mir_snapshot_field(binding, 7), scalar) { give back "invalid scalar sum local scope" }
        if scalar and v4_mir_snapshot_field(binding, 6) != v4_ty_param_mode_value { give back "borrowed scalar sum storage is not yet supported" }
        if row < parameters {
            if v4_mir_snapshot_field(binding, 4) != v4_ty_signature_param_name(ty, signature, row) or type_text != v4_ty_signature_param_type(ty, signature, row) or v4_mir_snapshot_field(binding, 6) != v4_ty_signature_param_mode(ty, signature, row) { give back "invalid scalar sum task parameter identity" }
        }
        row += 1
    }
    row = 0
    repeat until row >= array_len(blocks) {
        pilot scope = v4_mir_block_part(array_get(blocks, row), 5)
        if scope == (V4_NO_SPAN) or not v4_mir_word_scope_fact_is_valid(scope, file, body_span, V4_NO_SPAN, false) { give back "invalid scalar sum block scope" }
        row += 1
    }
    row = 0
    repeat until row >= array_len(statements) {
        pilot statement: word = array_get(statements, row)
        if not v4_mir_word_scope_fact_is_valid(v4_mir_snapshot_field(statement, 11), file, body_span, v4_mir_snapshot_field(statement, 7), true) { give back "invalid scalar sum statement scope" }
        pilot place = word_to_int(v4_mir_snapshot_field_raw(statement, 9))
        pilot value = word_to_int(v4_mir_snapshot_field_raw(statement, 10))
        if place >= 0 and place < array_len(places) and value >= 0 and value < array_len(values) {
            pilot destination: word = array_get(places, place)
            pilot expected = v4_mir_snapshot_field(destination, 10)
            pilot actual = v4_mir_control_row_type(values, value)
            if (v4_ty_is_native_scalar_sum(ty, expected) or v4_ty_is_native_scalar_sum(ty, actual)) and expected != actual { give back "scalar sum assignment requires an exact carrier" }
        }
        row += 1
    }
    row = 0
    repeat until row >= array_len(places) {
        pilot place: word = array_get(places, row)
        if v4_ty_is_native_scalar_sum(ty, v4_mir_snapshot_field(place, 10)) {
            if v4_mir_snapshot_field(place, 4) != v4_mir_place_local and v4_mir_snapshot_field(place, 4) != v4_mir_place_return { give back "scalar sum projection places are not yet supported" }
            if v4_mir_snapshot_field(place, 4) == v4_mir_place_local {
                pilot local = word_to_int(v4_mir_snapshot_field_raw(place, 6))
                if local < 0 or local >= array_len(locals) { give back "invalid scalar sum place local identity" }
                pilot binding: word = array_get(locals, local)
                if v4_mir_snapshot_field(place, 5) != v4_mir_snapshot_field(binding, 4) or v4_mir_snapshot_field(place, 10) != v4_mir_snapshot_field(binding, 5) { give back "invalid scalar sum place local identity" }
            }
        }
        row += 1
    }
    row = 0
    repeat until row >= array_len(values) {
        pilot error = v4_mir_sum_row_value_error(ty, values, locals, row)
        if error == "" { error = v4_mir_sum_row_call_error(ty, values, locals, row) }
        if error != "" { give back error }
        pilot value: word = array_get(values, row)
        if v4_ty_is_native_scalar_sum(ty, v4_mir_snapshot_field(value, 10)) {
            pilot kind = v4_mir_snapshot_field(value, 4)
            if kind != v4_mir_rvalue_use_local and kind != v4_mir_rvalue_call and kind != v4_mir_rvalue_some and kind != v4_mir_rvalue_nobody and kind != v4_mir_rvalue_ok and kind != v4_mir_rvalue_err { give back "unsupported scalar sum rvalue" }
        }
        row += 1
    }
    pilot error = v4_mir_sum_return_rows_error(ty, definition, blocks, statements, values)
    if error != "" { give back error }
    row = 0
    repeat until row >= array_len(locals) {
        pilot binding: word = array_get(locals, row)
        if v4_ty_is_native_scalar_sum(ty, v4_mir_snapshot_field(binding, 5)) {
            error = v4_mir_sum_local_rows_error(ty, definition, blocks, locals, statements, places, values, row)
            if error != "" { give back error }
        }
        row += 1
    }
    give back ""
}

task v4_mir_sum_row_call_requires_body(ty: int, values: int, row: word) -> bool {
    if v4_mir_snapshot_field(row, 4) != v4_mir_rvalue_call or v4_mir_snapshot_field(row, 13) != "" { give back false }
    if v4_ty_is_native_scalar_sum(ty, v4_mir_snapshot_field(row, 10)) { give back true }
    pilot args = v4_mir_snapshot_field(row, 12)
    pilot arg = 0
    repeat until arg >= v4_mir_call_args_payload_count(args) {
        if v4_ty_is_native_scalar_sum(ty, v4_mir_control_row_type(values, v4_mir_call_args_payload_at(args, arg))) { give back true }
        arg += 1
    }
    give back false
}

task v4_mir_body_has_scalar_sum(mir: int, body: int) -> bool {
    pilot ty = v4_mir_ty_id(mir)
    if v4_ty_is_native_scalar_sum(ty, v4_mir_body_callable_return_type(mir, body)) { give back true }
    pilot row = 0
    repeat until row >= v4_mir_body_callable_param_count(mir, body) {
        if v4_ty_is_native_scalar_sum(ty, v4_mir_body_callable_param_type(mir, body, row)) { give back true }
        row += 1
    }
    row = 0
    repeat until row >= v4_mir_body_local_count(mir, body) {
        if v4_ty_is_native_scalar_sum(ty, v4_mir_local_ty(mir, body, row)) { give back true }
        row += 1
    }
    row = 0
    repeat until row >= v4_mir_body_rvalue_count(mir, body) {
        if v4_ty_is_native_scalar_sum(ty, v4_mir_rvalue_ty(mir, body, row)) or v4_mir_rvalue_kind(mir, body, row) == v4_mir_rvalue_sum_take { give back true }
        if v4_mir_rvalue_builtin_method(mir, body, row).starts_with("builtin::system::") or v4_mir_rvalue_op(mir, body, row).starts_with("builtin::system::") or v4_mir_rvalue_builtin_method(mir, body, row) == "builtin::word::to_int_maybe" or v4_mir_rvalue_op(mir, body, row) == "builtin::word::to_int_maybe" { give back true }
        row += 1
    }
    give back false
}

task v4_mir_scalar_sum_plan_preflight(mir: int) -> word {
    if not v4_mir_file_exists(mir) { give back "missing mir for scalar sum plan" }
    pilot body = 0
    pilot error = ""
    repeat until body >= v4_mir_body_count(mir) or error != "" {
        if v4_mir_body_has_scalar_sum(mir, body) {
            error = v4_mir_control_live_cfg_error(mir, body)
            pilot blocks = array_new()
            pilot locals = array_new()
            pilot statements = array_new()
            pilot places = array_new()
            pilot values = array_new()
            if blocks < 0 or locals < 0 or statements < 0 or places < 0 or values < 0 { error = "scalar sum plan scratch exhausted" }
            pilot row = 0
            repeat until row >= v4_mir_body_block_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(blocks, v4_mir_body_block(mir, body, row)) { error = "scalar sum plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_local_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(locals, v4_mir_snapshot_local_line(mir, body, row)) { error = "scalar sum plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_stmt_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(statements, v4_mir_snapshot_stmt_line(mir, body, row)) { error = "scalar sum plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_place_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(places, v4_mir_snapshot_place_line(mir, body, row)) { error = "scalar sum plan scratch exhausted" }
                row += 1
            }
            row = 0
            repeat until row >= v4_mir_body_rvalue_count(mir, body) or error != "" {
                if not v4_mir_control_checked_push(values, v4_mir_snapshot_rvalue_line(mir, body, row)) { error = "scalar sum plan scratch exhausted" }
                row += 1
            }
            if error == "" { error = v4_mir_scalar_sum_body_rows_error(v4_mir_ty_id(mir), v4_mir_file_id(mir), v4_mir_snapshot_body_line(mir, body), blocks, locals, statements, places, values) }
            row = 0
            repeat until row >= array_len(values) or error != "" {
                pilot value: word = array_get(values, row)
                if v4_mir_sum_row_call_requires_body(v4_mir_ty_id(mir), values, value) {
                    pilot signature = v4_ty_task_signature_id_for_name(v4_mir_ty_id(mir), v4_mir_snapshot_field(value, 6))
                    pilot target = v4_mir_lookup_body_name(mir, v4_mir_snapshot_field(value, 6))
                    if signature < 0 or target < 0 { error = "scalar sum task target body is missing" } else {
                        if v4_mir_body_def(mir, target) != v4_ty_signature_def(v4_mir_ty_id(mir), signature) or v4_mir_body_name(mir, target) != v4_ty_signature_name(v4_mir_ty_id(mir), signature) or v4_mir_body_signature(mir, target) != v4_ty_signature_of(v4_mir_ty_id(mir), v4_ty_signature_def(v4_mir_ty_id(mir), signature)) { error = "scalar sum task target body identity mismatch" }
                    }
                }
                row += 1
            }
            array_release(values)
            array_release(places)
            array_release(statements)
            array_release(locals)
            array_release(blocks)
        }
        body += 1
    }
    give back error
}
