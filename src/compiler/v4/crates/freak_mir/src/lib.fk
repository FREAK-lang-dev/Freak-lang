task v4_mir_file_count() -> int {
    v4_mir_init()
    give back array_len(v4_mir_files)
}

task v4_mir_file_exists(mir_id: int) -> bool {
    v4_mir_init()
    if mir_id < 0 {
        give back false
    }
    if mir_id >= array_len(v4_mir_files) {
        give back false
    }
    give back true
}

task v4_mir_file_id(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_files, mir_id))
}

task v4_mir_ty_id(mir_id: int) -> int {
    give back word_to_int(array_get(v4_mir_tys, mir_id))
}

task v4_mir_body_count(mir_id: int) -> int {
    give back array_len(v4_mir_defs_handle(mir_id))
}

task v4_mir_diag_count(mir_id: int) -> int {
    give back array_len(v4_mir_diags_handle(mir_id))
}

