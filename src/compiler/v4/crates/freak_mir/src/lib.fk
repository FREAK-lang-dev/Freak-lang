    v4_mir_init()
    give back array_len(v4_mir_files)
}

task v4_mir_file_exists(mir_id: int) -> bool {
    v4_mir_init()
    if mir_id < 0 {
        give back false
    }
    if mir_id >= array_len(v4_mir_files) {
        give back false
    }
    give back true
}

