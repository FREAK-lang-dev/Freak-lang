task v4_mir_restore_release_file_raw(mir_id: int) -> void {
    pilot body_id = 0
    pilot count = v4_mir_body_count(mir_id)
    repeat until body_id >= count {
        v4_mir_restore_release_body_raw(mir_id, body_id)
        body_id += 1
