task v4_mir_snapshot() -> word {
    v4_mir_init()
    pilot parts = array_new()
    array_push(parts, v4_mir_snapshot_header())
    pilot mir_id = 0
    repeat until mir_id >= v4_mir_file_count() {
        array_push(parts, "\n")
        array_push(parts, v4_mir_snapshot_file_line(mir_id))

        pilot body_id = 0
        pilot body_count = v4_mir_body_count(mir_id)
        if not v4_mir_snapshot_publishes(mir_id) { body_count = 0 }
        repeat until body_id >= body_count {
            array_push(parts, "\n")
            array_push(parts, v4_mir_snapshot_body_line(mir_id, body_id))

            pilot block_id = 0
            pilot block_count = v4_mir_body_block_count(mir_id, body_id)
            repeat until block_id >= block_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_block_line(mir_id, body_id, block_id))
                block_id += 1
            }

            pilot local_id = 0
            pilot local_count = v4_mir_body_local_count(mir_id, body_id)
            repeat until local_id >= local_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_local_line(mir_id, body_id, local_id))
                local_id += 1
            }

            pilot stmt_id = 0
            pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
            repeat until stmt_id >= stmt_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_stmt_line(mir_id, body_id, stmt_id))
                stmt_id += 1
            }

            pilot place_id = 0
            pilot place_count = v4_mir_body_place_count(mir_id, body_id)
            repeat until place_id >= place_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_place_line(mir_id, body_id, place_id))
                place_id += 1
            }

            pilot rvalue_id = 0
            pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
            repeat until rvalue_id >= rvalue_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_rvalue_line(mir_id, body_id, rvalue_id))
                rvalue_id += 1
            }
            body_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_mir_diag_count(mir_id)
        if not v4_mir_snapshot_publishes(mir_id) { diag_count = 0 }
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_mir_snapshot_diag_line(mir_id, diag_id))
            diag_id += 1
        }
        mir_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_mir_snapshot_format)
    give back word_join(parts)
}

task v4_mir_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "mir-snapshot" { give back 10 }
    if kind == "mir" { give back 6 }
    if kind == "mir-body" { give back 11 }
    if kind == "mir-block" { give back 5 }
    if kind == "mir-local" { give back 10 }
    if kind == "mir-stmt" { give back 12 }
    if kind == "mir-place" { give back 11 }
    if kind == "mir-rvalue" { give back 14 }
    if kind == "mir-diag" { give back 4 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_mir_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_mir_snapshot_field_raw(line, 0)
    pilot expected = v4_mir_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_mir_snapshot_field_count(line) != expected {
        give back false
    }
    if kind == "mir-local" and not v4_mir_binding_prefix_is_valid(v4_mir_snapshot_field(line, 9)) { give back false }
    give back true
}

task v4_mir_snapshot_nonnegative_int_is_valid(raw: word) -> bool {
    if raw == "" { give back false }
    pilot value = word_to_int(raw)
    if value < 0 { give back false }
    give back word_from_int(value) == raw
}

task v4_mir_snapshot_signed_int_is_valid(raw: word) -> bool {
    if raw == "" { give back false }
    pilot value = word_to_int(raw)
    give back word_from_int(value) == raw
}

task v4_mir_snapshot_ref_is_valid(raw: word, upper_bound: int, allow_missing: bool) -> bool {
    if not v4_mir_snapshot_signed_int_is_valid(raw) { give back false }
    pilot value = word_to_int(raw)
    if value == 0 - 1 { give back allow_missing }
    if value < 0 or value >= upper_bound { give back false }
    give back true
}

task v4_mir_snapshot_prior_rvalue_ref_is_valid(raw: word, parent_id: int, allow_missing: bool) -> bool {
    give back v4_mir_snapshot_ref_is_valid(raw, parent_id, allow_missing)
}

task v4_mir_snapshot_comma_part(payload: word, wanted: int) -> word {
    if payload == "" or wanted < 0 { give back "" }
    pilot part = 0
    pilot start_pos = 0
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            if part == wanted {
                give back v4_slice(payload, start_pos, idx)
            }
            part += 1
            start_pos = idx + 1
        }
        idx += 1
    }
    if part == wanted {
        give back v4_slice(payload, start_pos, payload.length())
    }
    give back ""
}

task v4_mir_snapshot_rvalue_payload_is_valid(payload: word, parent_id: int) -> bool {
    if payload == "" { give back true }
    pilot child_count = v4_mir_call_args_payload_count(payload)
    pilot child_id = 0
    repeat until child_id >= child_count {
        pilot raw_child = v4_mir_snapshot_comma_part(payload, child_id)
        if not v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_child, parent_id, false) {
            give back false
        }
        child_id += 1
    }
    give back true
}

task v4_mir_snapshot_terminator_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_term_return or kind == v4_mir_term_unreachable or kind == v4_mir_term_goto or kind == v4_mir_term_if
}

task v4_mir_snapshot_stmt_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign or kind == v4_mir_stmt_return or kind == v4_mir_stmt_expr or kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop or kind == v4_mir_stmt_break or kind == v4_mir_stmt_continue
}

task v4_mir_snapshot_place_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_place_local or kind == v4_mir_place_field or kind == v4_mir_place_index or kind == v4_mir_place_deref or kind == v4_mir_place_return or kind == v4_mir_place_global or kind == v4_mir_place_unknown
}

task v4_mir_snapshot_rvalue_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float or kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_const_bool or kind == v4_mir_rvalue_const_char or kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place or kind == v4_mir_rvalue_use_symbol or kind == v4_mir_rvalue_construct or kind == v4_mir_rvalue_array or kind == v4_mir_rvalue_list or kind == v4_mir_rvalue_tuple or kind == v4_mir_rvalue_map or kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_call or kind == v4_mir_rvalue_loop_item or kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_or_else or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut or kind == v4_mir_rvalue_closure or kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut or kind == v4_mir_rvalue_capture_copy or kind == v4_mir_rvalue_capture_move or kind == v4_mir_rvalue_unknown
}

task v4_mir_snapshot_block_record_is_valid(block_record: word, block_id: int, block_count: int) -> bool {
    if not v4_mir_scope_span_is_valid(v4_mir_block_part(block_record, 5)) { give back false }
    if v4_mir_block_part(block_record, 6) != "" { give back false }
    pilot raw_id = v4_mir_block_part(block_record, 0)
    pilot terminator = v4_mir_block_part(block_record, 1)
    pilot raw_target = v4_mir_block_part(block_record, 2)
    pilot raw_else_target = v4_mir_block_part(block_record, 3)
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw_id) or word_to_int(raw_id) != block_id {
        give back false
    }
    if not v4_mir_snapshot_terminator_kind_is_known(terminator) { give back false }
    if terminator == v4_mir_term_goto {
        give back v4_mir_snapshot_ref_is_valid(raw_target, block_count, false) and raw_else_target == "-1"
    }
    if terminator == v4_mir_term_if {
        give back v4_mir_snapshot_ref_is_valid(raw_target, block_count, false) and v4_mir_snapshot_ref_is_valid(raw_else_target, block_count, false)
    }
    give back raw_target == "-1" and raw_else_target == "-1"
}

task v4_mir_snapshot_place_refs_are_valid(kind: word, raw_base: word, raw_index: word, place_id: int, local_count: int, rvalue_count: int) -> bool {
    if not v4_mir_snapshot_place_kind_is_known(kind) { give back false }
    if kind == v4_mir_place_local {
        give back v4_mir_snapshot_ref_is_valid(raw_base, local_count, true) and raw_index == "-1"
    }
    if kind == v4_mir_place_field {
        give back v4_mir_snapshot_ref_is_valid(raw_base, place_id, false) and raw_index == "-1"
    }
    if kind == v4_mir_place_index {
        give back v4_mir_snapshot_ref_is_valid(raw_base, place_id, false) and v4_mir_snapshot_ref_is_valid(raw_index, rvalue_count, false)
    }
    if kind == v4_mir_place_deref {
        give back raw_base == "-1" and v4_mir_snapshot_ref_is_valid(raw_index, rvalue_count, false)
    }
    give back raw_base == "-1" and raw_index == "-1"
}

task v4_mir_snapshot_rvalue_refs_are_valid(kind: word, raw_lhs: word, raw_rhs: word, args_payload: word, rvalue_id: int, place_count: int) -> bool {
    if not v4_mir_snapshot_rvalue_kind_is_known(kind) { give back false }

    if kind == v4_mir_rvalue_use_place {
        give back v4_mir_snapshot_ref_is_valid(raw_lhs, place_count, false) and raw_rhs == "-1" and args_payload == ""
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {

        give back raw_lhs == "-1" and raw_rhs == "-1" and v4_mir_snapshot_rvalue_payload_is_valid(args_payload, rvalue_id)
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, false) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, false) and args_payload == ""
    }
    if kind == v4_mir_rvalue_unary {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, false) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, true) and args_payload == ""
    }
    if kind == v4_mir_rvalue_call {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, true) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, true) and v4_mir_snapshot_rvalue_payload_is_valid(args_payload, rvalue_id)
    }
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, false) and raw_rhs == "-1" and args_payload == ""
    }
    -- A native list loop item reads its list loan and index (both optional).
    if kind == v4_mir_rvalue_loop_item {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, true) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, true) and args_payload == ""
    }
    give back raw_lhs == "-1" and raw_rhs == "-1" and args_payload == ""
}

task v4_mir_snapshot_say_literal_is_valid(line: word, prior_kinds: int, prior_types: int) -> bool {
    if v4_mir_snapshot_field(line, 4) != v4_mir_rvalue_call { give back false }
    if v4_mir_snapshot_field_raw(line, 7) != "-1" or v4_mir_snapshot_field_raw(line, 8) != "-1" { give back false }
    if v4_mir_snapshot_field(line, 10) != v4_ty_void { give back false }
    if v4_mir_snapshot_field(line, 11) != "" or v4_mir_snapshot_field(line, 13) != "" { give back false }
    pilot args = v4_mir_snapshot_field(line, 12)
    if v4_mir_call_args_payload_count(args) != 1 { give back false }
    if not v4_mir_snapshot_ref_is_valid(args, array_len(prior_kinds), false) { give back false }
    pilot arg = word_to_int(args)
    pilot arg_kind: word = array_get(prior_kinds, arg)
    pilot arg_ty: word = array_get(prior_types, arg)
    give back arg_kind == v4_mir_rvalue_const_word and arg_ty == v4_ty_word
}

task v4_mir_snapshot_graph_ref_is_done(states: int, offset: int, raw_ref: word, allow_negative: bool) -> bool {
    if raw_ref == "-1" { give back allow_negative }
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw_ref) { give back false }
    pilot node_id = offset + word_to_int(raw_ref)
    if node_id < 0 or node_id >= array_len(states) { give back false }
    pilot state: word = array_get(states, node_id)
    give back state == "1"
}

task v4_mir_snapshot_graph_payload_is_done(states: int, offset: int, payload: word) -> bool {
    if payload == "" { give back true }
    pilot child_id = 0
    pilot child_count = v4_mir_call_args_payload_count(payload)
    repeat until child_id >= child_count {
        if not v4_mir_snapshot_graph_ref_is_done(states, offset, v4_mir_snapshot_comma_part(payload, child_id), false) {
            give back false
        }
        child_id += 1
    }
    give back true
}

task v4_mir_snapshot_graph_place_is_ready(place_id: int, place_count: int, states: int, kinds: int, bases: int, indexes: int) -> bool {
    pilot kind: word = array_get(kinds, place_id)
    pilot raw_base: word = array_get(bases, place_id)
    pilot raw_index: word = array_get(indexes, place_id)
    if kind == v4_mir_place_field {
        give back v4_mir_snapshot_graph_ref_is_done(states, 0, raw_base, false)
    }
    if kind == v4_mir_place_index {
        give back v4_mir_snapshot_graph_ref_is_done(states, 0, raw_base, false) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_index, false)
    }
    if kind == v4_mir_place_deref {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_index, false)
    }
    give back true
}

task v4_mir_snapshot_graph_rvalue_is_ready(rvalue_id: int, place_count: int, states: int, kinds: int, lhs_refs: int, rhs_refs: int, args_payloads: int) -> bool {
    pilot kind: word = array_get(kinds, rvalue_id)
    pilot raw_lhs: word = array_get(lhs_refs, rvalue_id)
    pilot raw_rhs: word = array_get(rhs_refs, rvalue_id)
    pilot args_payload: word = array_get(args_payloads, rvalue_id)
    if kind == v4_mir_rvalue_use_place {
        give back v4_mir_snapshot_graph_ref_is_done(states, 0, raw_lhs, false)
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        give back v4_mir_snapshot_graph_payload_is_done(states, place_count, args_payload)
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, false) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, false)
    }
    if kind == v4_mir_rvalue_unary {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, false) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, true)
    }
    if kind == v4_mir_rvalue_call {
        if not v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, true) { give back false }
        if not v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, true) { give back false }
        give back v4_mir_snapshot_graph_payload_is_done(states, place_count, args_payload)
    }
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_sum_take or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, false)
    }
    -- A list loop item depends on its loan and index; an operand-free item
    -- is the front end's opaque item and stays ready.
    if kind == v4_mir_rvalue_loop_item {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, true) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, true)
    }
    give back true
}

task v4_mir_snapshot_body_graph_is_acyclic(place_kinds: int, place_bases: int, place_indexes: int, rvalue_kinds: int, rvalue_lhs: int, rvalue_rhs: int, rvalue_args: int) -> bool {
    pilot place_count = array_len(place_kinds)
    pilot rvalue_count = array_len(rvalue_kinds)
    if array_len(place_bases) != place_count or array_len(place_indexes) != place_count { give back false }
    if array_len(rvalue_lhs) != rvalue_count or array_len(rvalue_rhs) != rvalue_count or array_len(rvalue_args) != rvalue_count { give back false }

    pilot states = array_new()
    pilot total = place_count + rvalue_count
    pilot node_id = 0
    repeat until node_id >= total {
        array_push(states, "0")
        node_id += 1
    }

    pilot processed = 0
    repeat until processed >= total {
        pilot progress = 0
        pilot place_id = 0
        repeat until place_id >= place_count {
            pilot place_state: word = array_get(states, place_id)
            if place_state == "0" {
                if v4_mir_snapshot_graph_place_is_ready(place_id, place_count, states, place_kinds, place_bases, place_indexes) {
                    array_set(states, place_id, "1")
                    processed += 1
                    progress += 1
                }
            }
            place_id += 1
        }

        pilot rvalue_id = 0
        repeat until rvalue_id >= rvalue_count {
            pilot rvalue_node = place_count + rvalue_id
            pilot rvalue_state: word = array_get(states, rvalue_node)
            if rvalue_state == "0" {
                if v4_mir_snapshot_graph_rvalue_is_ready(rvalue_id, place_count, states, rvalue_kinds, rvalue_lhs, rvalue_rhs, rvalue_args) {
                    array_set(states, rvalue_node, "1")
                    processed += 1
                    progress += 1
                }
            }
            rvalue_id += 1
        }
        if progress == 0 {
            array_release(states)
            give back false
        }
    }
    array_release(states)
    give back true
}

task v4_mir_snapshot_release_body_graph_arrays(place_kinds: int, place_bases: int, place_indexes: int, rvalue_kinds: int, rvalue_lhs: int, rvalue_rhs: int, rvalue_args: int) -> void {
    array_release(rvalue_args)
    array_release(rvalue_rhs)
    array_release(rvalue_lhs)
    array_release(rvalue_kinds)
    array_release(place_indexes)
    array_release(place_bases)
    array_release(place_kinds)
}

task v4_mir_word_source_body_span(ty_id: int, def_id: word) -> word {
    give back v4_mir_callable_source_span_for_def(ty_id, def_id)
}

task v4_mir_word_scope_fact_is_valid(scope: word, file_id: int, body_span: word, inner: word, required: bool) -> bool {
    if scope == (V4_NO_SPAN) { give back not required and inner == V4_NO_SPAN }
    if not v4_mir_scope_span_is_valid(scope) or v4_span_file(scope) != word_from_int(file_id) { give back false }
    if body_span != V4_NO_SPAN and not v4_mir_scope_contains(body_span, scope) { give back false }
    if inner != (V4_NO_SPAN) {
        if not v4_mir_span_fact_is_valid(inner) or not v4_mir_scope_contains(scope, inner) { give back false }
    }
    if required and inner == (V4_NO_SPAN) { give back false }
    give back true
}

task v4_mir_snapshot_word_intrinsic_is_valid(line: word, kinds: int, types: int, lhs: int, rhs: int) -> bool {
    pilot identity = v4_mir_snapshot_field(line, 13)
    pilot kind = v4_mir_builtin_word_identity_kind(identity)
    if kind == "" { give back false }
    if v4_mir_snapshot_field(line, 4) != v4_mir_rvalue_call or v4_mir_snapshot_field(line, 6) != identity or v4_mir_snapshot_field(line, 11) != "" { give back false }
    if v4_mir_snapshot_field_raw(line, 7) != "-1" or v4_mir_snapshot_field_raw(line, 8) != "-1" { give back false }
    if v4_mir_snapshot_field(line, 10) != v4_ty_word_intrinsic_result_type(kind) { give back false }
    pilot args = v4_mir_snapshot_field(line, 12)
    if v4_mir_call_args_payload_count(args) != v4_ty_word_intrinsic_param_count(kind) { give back false }
    pilot arg = 0
    repeat until arg >= v4_mir_call_args_payload_count(args) {
        pilot child = word_to_int(v4_mir_snapshot_comma_part(args, arg))
        if child < 0 or child >= array_len(kinds) { give back false }
        pilot child_kind: word = array_get(kinds, child)
        pilot child_ty: word = array_get(types, child)
        pilot expected = v4_ty_word_intrinsic_param_type(kind, arg)
        if expected == v4_ty_word {
            pilot child_rhs: word = array_get(rhs, child)
            if child_kind != v4_mir_rvalue_lend or child_ty != "lend word" or child_rhs != "-1" { give back false }
            pilot inner_raw: word = array_get(lhs, child)
            pilot inner = word_to_int(inner_raw)
            if inner < 0 or inner >= child { give back false }
            pilot inner_ty: word = array_get(types, inner)
            if inner_ty != v4_ty_word { give back false }
        } else if not v4_ty_types_compatible(expected, child_ty) { give back false }
        arg += 1
    }
    give back true
}

task v4_mir_snapshot_word_local_use_is_valid(line: word, names: int, types: int) -> bool {
    if v4_mir_snapshot_field(line, 4) != v4_mir_rvalue_use_local or v4_mir_snapshot_field(line, 10) != v4_ty_word { give back true }
    pilot op = v4_mir_snapshot_field(line, 6)
    if not op.starts_with("local#") { give back false }
    pilot raw = op.substring(6, op.length() - 6)
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw) { give back false }
    pilot local_id = word_to_int(raw)
    if local_id >= array_len(names) or local_id >= array_len(types) { give back false }
    pilot name: word = array_get(names, local_id)
    pilot local_ty: word = array_get(types, local_id)
    give back name == v4_mir_snapshot_field(line, 5) and local_ty == v4_ty_word
}

task v4_mir_snapshot_validate(payload: word) -> word {
    pilot lines = v4_mir_snapshot_line_count(payload)
    pilot files = 0
    pilot bodies = 0
    pilot blocks = 0
    pilot locals = 0
    pilot statements = 0
    pilot places = 0
    pilot rvalues = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_files = 0 - 1
    pilot declared_bodies = 0 - 1
    pilot declared_blocks = 0 - 1
    pilot declared_locals = 0 - 1
    pilot declared_statements = 0 - 1
    pilot declared_places = 0 - 1
    pilot declared_rvalues = 0 - 1
    pilot declared_diagnostics = 0 - 1

    pilot current_mir = 0 - 1
    pilot current_body = 0 - 1
    pilot current_file_id = 0 - 1
    pilot current_ty_id = 0 - 1
    pilot body_source_span = V4_NO_SPAN
    pilot body_has_word: bool = false
    pilot body_scope_missing: bool = false
    pilot file_declared_bodies = 0
    pilot file_declared_diagnostics = 0
    pilot file_bodies = 0
    pilot file_diagnostics = 0
    pilot file_phase = 0
    pilot body_declared_blocks = 0
    pilot body_declared_locals = 0
    pilot body_declared_statements = 0
    pilot body_declared_places = 0
    pilot body_declared_rvalues = 0
    pilot body_blocks = 0
    pilot body_locals = 0
    pilot body_statements = 0
    pilot body_places = 0
    pilot body_rvalues = 0
    pilot body_phase = 0
    pilot body_graph_place_kinds = array_new()
    pilot body_graph_place_bases = array_new()
    pilot body_graph_place_indexes = array_new()
    pilot body_graph_rvalue_kinds = array_new()
    pilot body_graph_rvalue_lhs = array_new()
    pilot body_graph_rvalue_rhs = array_new()
    pilot body_graph_rvalue_args = array_new()
    pilot body_say_literal_types = array_new()
    pilot body_word_local_names = array_new()
    pilot body_word_local_types = array_new()
    if body_word_local_names < 0 or body_word_local_types < 0 { malformed += 1 }

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_mir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_mir_snapshot_field_raw(line, 0)
            if saw_end > 0 {
                malformed += 1
            } else if v4_mir_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "mir-snapshot" {
                saw_header += 1
                format = v4_mir_snapshot_key_value(line, "format")
                if line_id != 0 { malformed += 1 }
                if format != v4_mir_snapshot_format { malformed += 1 }

                pilot raw_files = v4_mir_snapshot_key_value(line, "files")
                pilot raw_bodies = v4_mir_snapshot_key_value(line, "bodies")
                pilot raw_blocks = v4_mir_snapshot_key_value(line, "blocks")
                pilot raw_locals = v4_mir_snapshot_key_value(line, "locals")
                pilot raw_statements = v4_mir_snapshot_key_value(line, "statements")
                pilot raw_places = v4_mir_snapshot_key_value(line, "places")
                pilot raw_rvalues = v4_mir_snapshot_key_value(line, "rvalues")
                pilot raw_diagnostics = v4_mir_snapshot_key_value(line, "diagnostics")
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_files) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_bodies) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_blocks) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_locals) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_statements) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_places) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_rvalues) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_diagnostics) { malformed += 1 }
                declared_files = word_to_int(raw_files)
                declared_bodies = word_to_int(raw_bodies)
                declared_blocks = word_to_int(raw_blocks)
                declared_locals = word_to_int(raw_locals)
                declared_statements = word_to_int(raw_statements)
                declared_places = word_to_int(raw_places)
                declared_rvalues = word_to_int(raw_rvalues)
                declared_diagnostics = word_to_int(raw_diagnostics)
            } else if kind == "mir" {
                if saw_header != 1 { malformed += 1 }
                if current_body >= 0 {
                    if body_has_word and body_scope_missing { malformed += 1 }
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                    current_body = 0 - 1
                }
                if current_mir >= 0 {
                    if file_bodies != file_declared_bodies { malformed += 1 }
                    if file_diagnostics != file_declared_diagnostics { malformed += 1 }
                }

                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_file_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_ty_id = v4_mir_snapshot_field_raw(line, 3)
                pilot raw_body_count = v4_mir_snapshot_field_raw(line, 4)
                pilot raw_diag_count = v4_mir_snapshot_field_raw(line, 5)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_file_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_ty_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_diag_count) { malformed += 1 }
                if word_to_int(raw_mir_id) != files { malformed += 1 }

                current_mir = word_to_int(raw_mir_id)
                current_file_id = word_to_int(raw_file_id)
                current_ty_id = word_to_int(raw_ty_id)
                file_declared_bodies = word_to_int(raw_body_count)
                file_declared_diagnostics = word_to_int(raw_diag_count)
                file_bodies = 0
                file_diagnostics = 0
                file_phase = 0
                files += 1
            } else if kind == "mir-body" {
                if current_body >= 0 {
                    if body_has_word and body_scope_missing { malformed += 1 }
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                }

                v4_mir_snapshot_release_body_graph_arrays(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args)
                array_release(body_say_literal_types)
                array_release(body_word_local_names)
                array_release(body_word_local_types)

                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_block_count = v4_mir_snapshot_field_raw(line, 6)
                pilot raw_local_count = v4_mir_snapshot_field_raw(line, 7)
                pilot raw_stmt_count = v4_mir_snapshot_field_raw(line, 8)
                pilot raw_place_count = v4_mir_snapshot_field_raw(line, 9)
                pilot raw_rvalue_count = v4_mir_snapshot_field_raw(line, 10)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_block_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_local_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_stmt_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_place_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_rvalue_count) { malformed += 1 }
                if current_mir < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != file_bodies { malformed += 1 }
                if file_phase != 0 { malformed += 1 }

                current_body = word_to_int(raw_body_id)
                body_source_span = v4_mir_word_source_body_span(current_ty_id, v4_mir_snapshot_field(line, 3))
                body_has_word = false
                body_scope_missing = false
                body_declared_blocks = word_to_int(raw_block_count)
                body_declared_locals = word_to_int(raw_local_count)
                body_declared_statements = word_to_int(raw_stmt_count)
                body_declared_places = word_to_int(raw_place_count)
                body_declared_rvalues = word_to_int(raw_rvalue_count)
                body_blocks = 0
                body_locals = 0
                body_statements = 0
                body_places = 0
                body_rvalues = 0
                body_phase = 0
                body_graph_place_kinds = array_new()
                body_graph_place_bases = array_new()
                body_graph_place_indexes = array_new()
                body_graph_rvalue_kinds = array_new()
                body_graph_rvalue_lhs = array_new()
                body_graph_rvalue_rhs = array_new()
                body_graph_rvalue_args = array_new()
                body_say_literal_types = array_new()
                body_word_local_names = array_new()
                body_word_local_types = array_new()
                if body_word_local_names < 0 or body_word_local_types < 0 { malformed += 1 }
                file_bodies += 1
                bodies += 1
            } else if kind == "mir-block" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_blocks { malformed += 1 }
                if body_phase > 1 { malformed += 1 }
                pilot block_record = v4_mir_snapshot_field(line, 4)
                if not v4_mir_snapshot_block_record_is_valid(block_record, word_to_int(raw_child_id), body_declared_blocks) { malformed += 1 }
                pilot block_scope = v4_mir_block_part(block_record, 5)
                if block_scope == (V4_NO_SPAN) { body_scope_missing = true }
                if not v4_mir_word_scope_fact_is_valid(block_scope, current_file_id, body_source_span, V4_NO_SPAN, false) { malformed += 1 }
                body_phase = 1
                body_blocks += 1
                blocks += 1
            } else if kind == "mir-local" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_locals { malformed += 1 }
                if body_phase > 2 { malformed += 1 }
                pilot local_scope = v4_mir_snapshot_field(line, 8)
                if not v4_mir_binding_prefix_is_valid(v4_mir_snapshot_field(line, 9)) { malformed += 1 }
                pilot local_span = v4_mir_snapshot_field(line, 7)
                pilot local_ty = v4_mir_snapshot_field(line, 5)
                if v4_mir_snapshot_field(line, 6) == "$control-diagnostic" { malformed += 1 }
                if local_scope == (V4_NO_SPAN) { body_scope_missing = true }
                if local_ty == v4_ty_word { body_has_word = true }
                if not v4_mir_word_scope_fact_is_valid(local_scope, current_file_id, body_source_span, local_span, local_ty == v4_ty_word) { malformed += 1 }
                array_push(body_word_local_names, v4_mir_snapshot_field(line, 4))
                array_push(body_word_local_types, local_ty)
                if array_len(body_word_local_names) != body_locals + 1 or array_len(body_word_local_types) != body_locals + 1 { malformed += 1 }
                body_phase = 2
                body_locals += 1
                locals += 1
            } else if kind == "mir-stmt" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_statements { malformed += 1 }
                if body_phase > 3 { malformed += 1 }
                pilot stmt_kind = v4_mir_snapshot_field(line, 4)
                pilot statement_scope = v4_mir_snapshot_field(line, 11)
                if statement_scope == (V4_NO_SPAN) { body_scope_missing = true }
                if not v4_mir_word_scope_fact_is_valid(statement_scope, current_file_id, body_source_span, v4_mir_snapshot_field(line, 7), false) { malformed += 1 }
                pilot raw_stmt_block = v4_mir_snapshot_field_raw(line, 8)
                pilot raw_stmt_place = v4_mir_snapshot_field_raw(line, 9)
                pilot raw_stmt_rvalue = v4_mir_snapshot_field_raw(line, 10)
                if not v4_mir_snapshot_stmt_kind_is_known(stmt_kind) { malformed += 1 }
                if not v4_mir_snapshot_ref_is_valid(raw_stmt_block, body_declared_blocks, false) { malformed += 1 }
                if not v4_mir_snapshot_ref_is_valid(raw_stmt_place, body_declared_places, true) { malformed += 1 }
                if not v4_mir_snapshot_ref_is_valid(raw_stmt_rvalue, body_declared_rvalues, true) { malformed += 1 }
                body_phase = 3
                body_statements += 1
                statements += 1
            } else if kind == "mir-place" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_places { malformed += 1 }
                if body_phase > 4 { malformed += 1 }
                pilot place_kind = v4_mir_snapshot_field(line, 4)
                pilot raw_place_base = v4_mir_snapshot_field_raw(line, 6)
                pilot raw_place_index = v4_mir_snapshot_field_raw(line, 8)
                if not v4_mir_snapshot_place_refs_are_valid(place_kind, raw_place_base, raw_place_index, word_to_int(raw_child_id), body_declared_locals, body_declared_rvalues) { malformed += 1 }
                array_push(body_graph_place_kinds, place_kind)
                array_push(body_graph_place_bases, raw_place_base)
                array_push(body_graph_place_indexes, raw_place_index)
                body_phase = 4
                body_places += 1
                places += 1
            } else if kind == "mir-rvalue" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)

                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_rvalues { malformed += 1 }
                pilot rvalue_kind = v4_mir_snapshot_field(line, 4)
                pilot raw_lhs = v4_mir_snapshot_field_raw(line, 7)
                pilot raw_rhs = v4_mir_snapshot_field_raw(line, 8)
                pilot args_payload = v4_mir_snapshot_field(line, 12)
                if not v4_mir_snapshot_rvalue_refs_are_valid(rvalue_kind, raw_lhs, raw_rhs, args_payload, word_to_int(raw_child_id), body_declared_places) { malformed += 1 }
                if v4_mir_snapshot_field(line, 6) == v4_mir_call_say_literal {
                    if not v4_mir_snapshot_say_literal_is_valid(line, body_graph_rvalue_kinds, body_say_literal_types) { malformed += 1 }
                }
                if v4_mir_snapshot_field(line, 10) == v4_ty_word or v4_mir_snapshot_field(line, 10) == "lend word" { body_has_word = true }
                if not v4_mir_snapshot_word_local_use_is_valid(line, body_word_local_names, body_word_local_types) { malformed += 1 }
                if v4_mir_builtin_word_identity_kind(v4_mir_snapshot_field(line, 13)) != "" {
                    if not v4_mir_snapshot_word_intrinsic_is_valid(line, body_graph_rvalue_kinds, body_say_literal_types, body_graph_rvalue_lhs, body_graph_rvalue_rhs) { malformed += 1 }
                }
                array_push(body_graph_rvalue_kinds, rvalue_kind)
                array_push(body_say_literal_types, v4_mir_snapshot_field(line, 10))
                array_push(body_graph_rvalue_lhs, raw_lhs)
                array_push(body_graph_rvalue_rhs, raw_rhs)
                array_push(body_graph_rvalue_args, args_payload)
                pilot builtin_method = v4_mir_snapshot_field(line, 13)
                if builtin_method != "" and not v4_mir_builtin_method_identity_is_known(builtin_method) {
                    malformed += 1
                }
                if builtin_method != "" and rvalue_kind != v4_mir_rvalue_call { malformed += 1 }
                body_phase = 5
                body_rvalues += 1
                rvalues += 1
            } else if kind == "mir-diag" {
                if current_body >= 0 {
                    if body_has_word and body_scope_missing { malformed += 1 }
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                    current_body = 0 - 1
                }
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_diag_id = v4_mir_snapshot_field_raw(line, 2)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_diag_id) { malformed += 1 }
                if current_mir < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_diag_id) != file_diagnostics { malformed += 1 }
                file_phase = 1
                file_diagnostics += 1
                diagnostics += 1
            } else if kind == "end" {
                if current_body >= 0 {
                    if body_has_word and body_scope_missing { malformed += 1 }
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                    current_body = 0 - 1
                }
                if current_mir >= 0 {
                    if file_bodies != file_declared_bodies { malformed += 1 }
                    if file_diagnostics != file_declared_diagnostics { malformed += 1 }
                    current_mir = 0 - 1
                }
                saw_end += 1
                if v4_mir_snapshot_field(line, 1) != v4_mir_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    v4_mir_snapshot_release_body_graph_arrays(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args)
    array_release(body_say_literal_types)
    array_release(body_word_local_names)
    array_release(body_word_local_types)

    if files != declared_files { malformed += 1 }
    if bodies != declared_bodies { malformed += 1 }
    if blocks != declared_blocks { malformed += 1 }
    if locals != declared_locals { malformed += 1 }
    if statements != declared_statements { malformed += 1 }
    if places != declared_places { malformed += 1 }
    if rvalues != declared_rvalues { malformed += 1 }
    if diagnostics != declared_diagnostics { malformed += 1 }

    if malformed == 0 and not v4_mir_snapshot_control_payload_is_valid(payload) { malformed += 1 }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "mir-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " bodies=" + word_from_int(bodies)
    out = out + " blocks=" + word_from_int(blocks)
    out = out + " locals=" + word_from_int(locals)
    out = out + " statements=" + word_from_int(statements)
    out = out + " places=" + word_from_int(places)
    out = out + " rvalues=" + word_from_int(rvalues)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_mir_restore_file_slot(mir_id: int, file_id: int, ty_id: int) -> int {
    if mir_id < 0 or file_id < 0 or ty_id < 0 { give back 0 }
    -- Restored MIR carries no sealed dyn facts; codegen fails closed on dyn.
    -- Count the drop so the restore can dirty the MIR queries and the next
    -- check lowers and seals again.
    if v4_mir_dyn_facts_present(mir_id) { v4_mir_dyn_restore_drops += 1 }
    v4_mir_dyn_facts_clear(mir_id)
    v4_mir_init()
    if v4_mir_ready == 0 { give back 0 }
    pilot fresh = mir_id >= array_len(v4_mir_files)
    if not v4_mir_restore_building {
        pilot needed = 36 - v4_mir_restore_raw_handle_count(mir_id)
        if fresh {
            pilot missing_before_last = mir_id - array_len(v4_mir_files)
            -- floor(INT64_MAX / 36), checked before addition and multiply.
            if missing_before_last >= 256204778801521550 { give back 0 }
            needed = 36 * (missing_before_last + 1)
        }
        if not v4_mir_restore_reserve_needed(needed) { give back 0 }
    }
    pilot previous_mode = v4_mir_restore_building
    v4_mir_restore_building = true
    repeat until array_len(v4_mir_files) > mir_id {
        pilot previous = array_len(v4_mir_files)
        v4_mir_file_new(0, 0)
        if array_len(v4_mir_files) <= previous {
            v4_mir_restore_building = previous_mode
            give back 0
        }
    }
    v4_mir_restore_building = previous_mode

    v4_mir_release_lookup_indexes(mir_id)
    array_set(v4_mir_files, mir_id, word_from_int(file_id))
    array_set(v4_mir_tys, mir_id, word_from_int(ty_id))
    if not fresh {
        if not v4_mir_restore_building { v4_mir_restore_release_file_raw(mir_id) }
        array_set(v4_mir_body_defs, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_names, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_sigs, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_blocks, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_local_names, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_local_tys, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_local_modes, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_local_binding_prefixes, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_local_spans, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_local_scope_spans, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_kinds, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_lhs, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_rhs, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_spans, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_scope_spans, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_blocks, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_places, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_stmt_rvalues, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_kinds, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_texts, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_bases, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_fields, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_indices, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_spans, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_place_tys, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_kinds, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_texts, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_ops, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_lhs, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_rhs, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_spans, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_tys, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_abis, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_args, mir_id, word_from_int(array_new()))
        array_set(v4_mir_body_rvalue_builtin_methods, mir_id, word_from_int(array_new()))
        array_set(v4_mir_diags, mir_id, word_from_int(array_new()))
    }
    if not v4_mir_restore_building { v4_mir_lookup_file_ensure(mir_id) }
    if word_to_int(array_get(v4_mir_body_defs, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_names, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_sigs, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_blocks, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_local_names, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_local_tys, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_local_modes, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_local_binding_prefixes, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_local_spans, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_local_scope_spans, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_kinds, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_lhs, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_rhs, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_spans, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_scope_spans, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_blocks, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_places, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_stmt_rvalues, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_kinds, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_texts, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_bases, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_fields, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_indices, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_spans, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_place_tys, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_kinds, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_texts, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_ops, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_lhs, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_rhs, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_spans, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_tys, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_abis, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_args, mir_id)) < 0 or word_to_int(array_get(v4_mir_body_rvalue_builtin_methods, mir_id)) < 0 or word_to_int(array_get(v4_mir_diags, mir_id)) < 0 { give back 0 }
    give back 1
}

task v4_mir_restore_body_slot(mir_id: int, body_id: int, def_id: word, body_name: word, signature: word) -> int {
    if mir_id < 0 or body_id < 0 { give back 0 }
    if v4_mir_file_exists(mir_id) == false {
        give back 0
    }
    pilot fresh = body_id >= v4_mir_body_count(mir_id)
    if not v4_mir_restore_building {
        pilot needed = 0
        if fresh {
            pilot missing_before_last = body_id - v4_mir_body_count(mir_id)
            -- floor(INT64_MAX / 32), checked before addition and multiply.
            if missing_before_last >= 288230376151711743 { give back 0 }
            needed = 32 * (missing_before_last + 1)
        }
        if not v4_mir_restore_reserve_needed(needed) { give back 0 }
    }
    pilot previous_mode = v4_mir_restore_building
    v4_mir_restore_building = true
    repeat until v4_mir_body_count(mir_id) > body_id {
        pilot previous = v4_mir_body_count(mir_id)
        pilot added = v4_mir_add_body(mir_id, "", "", "")
        if added < 0 or v4_mir_body_count(mir_id) <= previous {
            v4_mir_restore_building = previous_mode
            give back 0
        }
    }
    v4_mir_restore_building = previous_mode

    v4_mir_invalidate_body_lookup_index(mir_id)
    v4_mir_invalidate_block_stmt_index(mir_id, body_id)
    v4_mir_invalidate_body_never_summary(mir_id, body_id)
    array_set(v4_mir_defs_handle(mir_id), body_id, def_id)
    array_set(v4_mir_names_handle(mir_id), body_id, body_name)
    array_set(v4_mir_sigs_handle(mir_id), body_id, signature)
    if not fresh {
        v4_mir_restore_release_body_raw(mir_id, body_id)
        array_set(v4_mir_blocks_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_local_names_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_local_tys_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_local_modes_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_local_binding_prefixes_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_local_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_local_scope_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_kinds_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_lhs_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_rhs_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_scope_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_blocks_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_places_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_stmt_rvalues_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_kinds_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_texts_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_bases_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_fields_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_indices_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_place_tys_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_kinds_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_texts_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_ops_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_lhs_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_rhs_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_tys_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_abis_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_args_index_handle(mir_id), body_id, word_from_int(array_new()))
        array_set(v4_mir_rvalue_builtin_methods_index_handle(mir_id), body_id, word_from_int(array_new()))
    }
    if word_to_int(array_get(v4_mir_blocks_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_local_names_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_local_tys_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_local_modes_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_local_binding_prefixes_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_local_spans_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_local_scope_spans_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_kinds_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_lhs_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_rhs_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_spans_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_scope_spans_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_blocks_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_places_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_stmt_rvalues_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_kinds_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_texts_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_bases_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_fields_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_indices_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_spans_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_place_tys_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_kinds_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_texts_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_ops_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_lhs_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_rhs_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_spans_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_tys_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_abis_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_args_index_handle(mir_id), body_id)) < 0 or word_to_int(array_get(v4_mir_rvalue_builtin_methods_index_handle(mir_id), body_id)) < 0 { give back 0 }
    give back 1
}

task v4_mir_body_slot_exists(mir_id: int, body_id: int) -> bool {
    if v4_mir_file_exists(mir_id) == false { give back false }
    if body_id < 0 { give back false }
    if body_id >= v4_mir_body_count(mir_id) { give back false }
    give back true
}

task v4_mir_restore_block_slot(mir_id: int, body_id: int, block_id: int, block_record: word) -> int {
    if block_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    v4_mir_invalidate_block_stmt_index(mir_id, body_id)
    if v4_mir_body_blocks_handle(mir_id, body_id) < 0 { give back 0 }
    repeat until v4_mir_body_block_count(mir_id, body_id) > block_id {
        pilot previous = v4_mir_body_block_count(mir_id, body_id)
        pilot next_block = v4_mir_body_block_count(mir_id, body_id)
        array_push(v4_mir_body_blocks_handle(mir_id, body_id), v4_mir_block_new(next_block, v4_mir_term_unreachable, 0 - 1))
        if v4_mir_body_block_count(mir_id, body_id) <= previous { give back 0 }
        if array_len(v4_mir_body_blocks_handle(mir_id, body_id)) != previous + 1 { give back 0 }
    }
    array_set(v4_mir_body_blocks_handle(mir_id, body_id), block_id, block_record)
    give back 1
}

task v4_mir_restore_local_slot(mir_id: int, body_id: int, local_id: int, local_name: word, local_ty: word, local_mode: word, span: word, scope_span: word) -> int {
    if local_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    if local_mode == "" {
        local_mode = v4_ty_param_mode_value
    }
    if v4_mir_body_local_spans_handle(mir_id, body_id) < 0 or v4_mir_body_local_scope_spans_handle(mir_id, body_id) < 0 or v4_mir_body_local_names_handle(mir_id, body_id) < 0 or v4_mir_body_local_modes_handle(mir_id, body_id) < 0 or v4_mir_body_local_binding_prefixes_handle(mir_id, body_id) < 0 or v4_mir_body_local_tys_handle(mir_id, body_id) < 0 { give back 0 }
    repeat until v4_mir_body_local_count(mir_id, body_id) > local_id {
        pilot previous = v4_mir_body_local_count(mir_id, body_id)
        array_push(v4_mir_body_local_names_handle(mir_id, body_id), "")
        array_push(v4_mir_body_local_tys_handle(mir_id, body_id), v4_ty_unknown)
        array_push(v4_mir_body_local_modes_handle(mir_id, body_id), v4_ty_param_mode_value)
        array_push(v4_mir_body_local_binding_prefixes_handle(mir_id, body_id), "")
        array_push(v4_mir_body_local_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_local_scope_spans_handle(mir_id, body_id), V4_NO_SPAN)
        if v4_mir_body_local_count(mir_id, body_id) <= previous { give back 0 }
        if array_len(v4_mir_body_local_names_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_local_tys_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_local_modes_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_local_binding_prefixes_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_local_spans_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_local_scope_spans_handle(mir_id, body_id)) != previous + 1 { give back 0 }
    }
    array_set(v4_mir_body_local_names_handle(mir_id, body_id), local_id, local_name)
    array_set(v4_mir_body_local_tys_handle(mir_id, body_id), local_id, local_ty)
    array_set(v4_mir_body_local_modes_handle(mir_id, body_id), local_id, local_mode)
    array_set(v4_mir_body_local_binding_prefixes_handle(mir_id, body_id), local_id, "")
    array_set(v4_mir_body_local_spans_handle(mir_id, body_id), local_id, span)
    array_set(v4_mir_body_local_scope_spans_handle(mir_id, body_id), local_id, scope_span)
    give back 1
}

task v4_mir_restore_stmt_slot(mir_id: int, body_id: int, stmt_id: int, stmt_kind: word, lhs: word, rhs: word, span: word, block_id: int, place_id: int, rvalue_id: int) -> int {
    if stmt_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    v4_mir_invalidate_block_stmt_index(mir_id, body_id)
    if v4_mir_body_stmt_kinds_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_rhs_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_places_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_rvalues_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_blocks_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_lhs_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_spans_handle(mir_id, body_id) < 0 or v4_mir_body_stmt_scope_spans_handle(mir_id, body_id) < 0 { give back 0 }
    repeat until v4_mir_body_stmt_count(mir_id, body_id) > stmt_id {
        pilot previous = v4_mir_body_stmt_count(mir_id, body_id)
        array_push(v4_mir_body_stmt_kinds_handle(mir_id, body_id), "")
        array_push(v4_mir_body_stmt_lhs_handle(mir_id, body_id), "")
        array_push(v4_mir_body_stmt_rhs_handle(mir_id, body_id), "")
        array_push(v4_mir_body_stmt_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_stmt_scope_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_stmt_blocks_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_stmt_places_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), word_from_int(0 - 1))
        if v4_mir_body_stmt_count(mir_id, body_id) <= previous { give back 0 }
        if array_len(v4_mir_body_stmt_kinds_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_lhs_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_rhs_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_spans_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_scope_spans_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_blocks_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_places_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_stmt_rvalues_handle(mir_id, body_id)) != previous + 1 { give back 0 }
    }
    array_set(v4_mir_body_stmt_kinds_handle(mir_id, body_id), stmt_id, stmt_kind)
    array_set(v4_mir_body_stmt_lhs_handle(mir_id, body_id), stmt_id, lhs)
    array_set(v4_mir_body_stmt_rhs_handle(mir_id, body_id), stmt_id, rhs)
    array_set(v4_mir_body_stmt_spans_handle(mir_id, body_id), stmt_id, span)
    array_set(v4_mir_body_stmt_blocks_handle(mir_id, body_id), stmt_id, word_from_int(block_id))
    array_set(v4_mir_body_stmt_places_handle(mir_id, body_id), stmt_id, word_from_int(place_id))
    array_set(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), stmt_id, word_from_int(rvalue_id))
    give back 1
}

task v4_mir_restore_place_slot(mir_id: int, body_id: int, place_id: int, place_kind: word, text: word, base: int, field: word, index_id: int, span: word, place_ty: word) -> int {
    if place_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    if v4_mir_body_place_tys_handle(mir_id, body_id) < 0 or v4_mir_body_place_kinds_handle(mir_id, body_id) < 0 or v4_mir_body_place_fields_handle(mir_id, body_id) < 0 or v4_mir_body_place_texts_handle(mir_id, body_id) < 0 or v4_mir_body_place_bases_handle(mir_id, body_id) < 0 or v4_mir_body_place_indices_handle(mir_id, body_id) < 0 or v4_mir_body_place_spans_handle(mir_id, body_id) < 0 { give back 0 }
    repeat until v4_mir_body_place_count(mir_id, body_id) > place_id {
        pilot previous = v4_mir_body_place_count(mir_id, body_id)
        array_push(v4_mir_body_place_kinds_handle(mir_id, body_id), v4_mir_place_unknown)
        array_push(v4_mir_body_place_texts_handle(mir_id, body_id), "")
        array_push(v4_mir_body_place_bases_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_place_fields_handle(mir_id, body_id), "")
        array_push(v4_mir_body_place_indices_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_place_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_place_tys_handle(mir_id, body_id), v4_ty_unknown)
        if v4_mir_body_place_count(mir_id, body_id) <= previous { give back 0 }
        if array_len(v4_mir_body_place_kinds_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_place_texts_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_place_bases_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_place_fields_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_place_indices_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_place_spans_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_place_tys_handle(mir_id, body_id)) != previous + 1 { give back 0 }
    }
    array_set(v4_mir_body_place_kinds_handle(mir_id, body_id), place_id, place_kind)
    array_set(v4_mir_body_place_texts_handle(mir_id, body_id), place_id, text)
    array_set(v4_mir_body_place_bases_handle(mir_id, body_id), place_id, word_from_int(base))
    array_set(v4_mir_body_place_fields_handle(mir_id, body_id), place_id, field)
    array_set(v4_mir_body_place_indices_handle(mir_id, body_id), place_id, word_from_int(index_id))
    array_set(v4_mir_body_place_spans_handle(mir_id, body_id), place_id, span)
    array_set(v4_mir_body_place_tys_handle(mir_id, body_id), place_id, place_ty)
    give back 1
}

task v4_mir_restore_rvalue_slot(mir_id: int, body_id: int, rvalue_id: int, rvalue_kind: word, text: word, op: word, lhs: int, rhs: int, span: word, rvalue_ty: word, rvalue_abi: word, rvalue_args: word, builtin_method: word) -> int {
    if rvalue_id < 0 { give back 0 }
    pilot builtin_method_code = v4_mir_builtin_method_identity_code(builtin_method)
    if builtin_method != "" and builtin_method_code == 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    if v4_mir_body_rvalue_lhs_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_abis_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_spans_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_kinds_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_args_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_texts_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_ops_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_rhs_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id) < 0 or v4_mir_body_rvalue_tys_handle(mir_id, body_id) < 0 { give back 0 }
    pilot never_count = v4_mir_body_never_summary_begin_write(mir_id, body_id)
    if never_count >= 0 and rvalue_id < v4_mir_body_rvalue_count(mir_id, body_id) {
        if v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) == v4_ty_never { never_count -= 1 }
    }
    repeat until v4_mir_body_rvalue_count(mir_id, body_id) > rvalue_id {
        pilot previous = v4_mir_body_rvalue_count(mir_id, body_id)
        array_push(v4_mir_body_rvalue_kinds_handle(mir_id, body_id), v4_mir_rvalue_unknown)
        array_push(v4_mir_body_rvalue_texts_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_ops_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_rvalue_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_rvalue_tys_handle(mir_id, body_id), v4_ty_unknown)
        array_push(v4_mir_body_rvalue_abis_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_args_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), "")
        if v4_mir_body_rvalue_count(mir_id, body_id) <= previous { give back 0 }
        if array_len(v4_mir_body_rvalue_kinds_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_texts_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_ops_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_lhs_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_rhs_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_spans_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_tys_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_abis_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_args_handle(mir_id, body_id)) != previous + 1 { give back 0 }
        if array_len(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id)) != previous + 1 { give back 0 }
    }
    pilot builtin_methods_handle = v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id)
    if builtin_method_code == 1 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_new)
    } else if builtin_method_code == 2 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_clone)
    } else if builtin_method_code == 3 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_downgrade)
    } else if builtin_method_code == 4 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_borrow)
    } else if builtin_method_code == 5 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_borrow_mut)
    } else if builtin_method_code == 6 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_get_mut)
    } else if builtin_method_code == 7 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_weak_upgrade)
    } else if builtin_method_code >= 101 {
        array_set(builtin_methods_handle, rvalue_id, builtin_method)
    } else {
        array_set(builtin_methods_handle, rvalue_id, "")
    }
    array_set(v4_mir_body_rvalue_kinds_handle(mir_id, body_id), rvalue_id, rvalue_kind)
    array_set(v4_mir_body_rvalue_texts_handle(mir_id, body_id), rvalue_id, text)
    array_set(v4_mir_body_rvalue_ops_handle(mir_id, body_id), rvalue_id, op)
    array_set(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), rvalue_id, word_from_int(lhs))
    array_set(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), rvalue_id, word_from_int(rhs))
    array_set(v4_mir_body_rvalue_spans_handle(mir_id, body_id), rvalue_id, span)
    array_set(v4_mir_body_rvalue_tys_handle(mir_id, body_id), rvalue_id, rvalue_ty)
    array_set(v4_mir_body_rvalue_abis_handle(mir_id, body_id), rvalue_id, rvalue_abi)
    array_set(v4_mir_body_rvalue_args_handle(mir_id, body_id), rvalue_id, rvalue_args)
    if never_count >= 0 {
        if rvalue_ty == v4_ty_never { never_count += 1 }
        v4_mir_publish_body_never_summary(mir_id, body_id, v4_mir_body_rvalue_count(mir_id, body_id), never_count)
    }
    give back 1
}

task v4_mir_restore_diag_slot(mir_id: int, diag_id: int, diag: word) -> int {
    if mir_id < 0 or diag_id < 0 { give back 0 }
    if v4_mir_file_exists(mir_id) == false {
        give back 0
    }
    if v4_mir_diags_handle(mir_id) < 0 { give back 0 }
    repeat until v4_mir_diag_count(mir_id) > diag_id {
        pilot previous = v4_mir_diag_count(mir_id)
        array_push(v4_mir_diags_handle(mir_id), "")
        if v4_mir_diag_count(mir_id) <= previous { give back 0 }
    }
    array_set(v4_mir_diags_handle(mir_id), diag_id, diag)
    give back 1
}

task v4_mir_snapshot_restore_file_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot ty_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    give back v4_mir_restore_file_slot(mir_id, file_id, ty_id)
}

task v4_mir_snapshot_restore_body_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-body" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot def_id = v4_mir_snapshot_field(line, 3)
    pilot body_name = v4_mir_snapshot_field(line, 4)
    pilot signature = v4_mir_snapshot_field(line, 5)
    give back v4_mir_restore_body_slot(mir_id, body_id, def_id, body_name, signature)
}

task v4_mir_snapshot_restore_block_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-block" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot block_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot block_record = v4_mir_snapshot_field(line, 4)
    give back v4_mir_restore_block_slot(mir_id, body_id, block_id, block_record)
}

task v4_mir_snapshot_restore_local_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-local" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot local_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot restored = v4_mir_restore_local_slot(mir_id, body_id, local_id, v4_mir_snapshot_field(line, 4), v4_mir_snapshot_field(line, 5), v4_mir_snapshot_field(line, 6), v4_mir_snapshot_field(line, 7), v4_mir_snapshot_field(line, 8))
    if restored == 1 { v4_mir_set_local_binding_prefix(mir_id, body_id, local_id, v4_mir_snapshot_field(line, 9)) }
    give back restored
}

task v4_mir_snapshot_restore_stmt_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-stmt" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot stmt_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot stmt_kind = v4_mir_snapshot_field(line, 4)
    pilot lhs = v4_mir_snapshot_field(line, 5)
    pilot rhs = v4_mir_snapshot_field(line, 6)
    pilot span = v4_mir_snapshot_field(line, 7)
    pilot block_id = word_to_int(v4_mir_snapshot_field_raw(line, 8))
    pilot place_id = word_to_int(v4_mir_snapshot_field_raw(line, 9))
    pilot rvalue_id = word_to_int(v4_mir_snapshot_field_raw(line, 10))
    pilot restored = v4_mir_restore_stmt_slot(mir_id, body_id, stmt_id, stmt_kind, lhs, rhs, span, block_id, place_id, rvalue_id)
    if restored == 1 { v4_mir_set_stmt_scope_span(mir_id, body_id, stmt_id, v4_mir_snapshot_field(line, 11)) }
    give back restored
}


task v4_mir_snapshot_restore_place_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-place" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot place_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot place_kind = v4_mir_snapshot_field(line, 4)
    pilot text = v4_mir_snapshot_field(line, 5)
    pilot base = word_to_int(v4_mir_snapshot_field_raw(line, 6))
    pilot field = v4_mir_snapshot_field(line, 7)
    pilot index_id = word_to_int(v4_mir_snapshot_field_raw(line, 8))
    pilot span = v4_mir_snapshot_field(line, 9)
    pilot place_ty = v4_mir_snapshot_field(line, 10)
    give back v4_mir_restore_place_slot(mir_id, body_id, place_id, place_kind, text, base, field, index_id, span, place_ty)
}

task v4_mir_snapshot_restore_rvalue_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-rvalue" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot rvalue_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot rvalue_kind = v4_mir_snapshot_field(line, 4)
    pilot text = v4_mir_snapshot_field(line, 5)
    pilot op = v4_mir_snapshot_field(line, 6)
    pilot lhs = word_to_int(v4_mir_snapshot_field_raw(line, 7))
    pilot rhs = word_to_int(v4_mir_snapshot_field_raw(line, 8))
    pilot span = v4_mir_snapshot_field(line, 9)
    pilot rvalue_ty = v4_mir_snapshot_field(line, 10)
    pilot rvalue_abi = v4_mir_snapshot_field(line, 11)
    pilot rvalue_args = v4_mir_snapshot_field(line, 12)
    pilot builtin_method = v4_mir_snapshot_field(line, 13)
    give back v4_mir_restore_rvalue_slot(mir_id, body_id, rvalue_id, rvalue_kind, text, op, lhs, rhs, span, rvalue_ty, rvalue_abi, rvalue_args, builtin_method)
}

task v4_mir_snapshot_restore_diag_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-diag" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot diag = v4_mir_snapshot_field(line, 3)
    give back v4_mir_restore_diag_slot(mir_id, diag_id, diag)
}

task v4_mir_snapshot_restore_component(payload: word) -> word {
    v4_mir_init()
    if v4_mir_ready == 0 { give back "mir-snapshot-restore ok=0 reason=mir-initialization-resource-exhausted" }
    pilot validation = v4_mir_snapshot_validate(payload)
    if validation.starts_with("mir-snapshot-import ok=1") == false {
        give back "mir-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot records = payload.snapshot_lines()
    if records < 0 { give back "mir-snapshot-restore ok=0 reason=line-index-resource-exhausted" }
    if not v4_mir_restore_handles_available(records) {
        array_release(records)
        give back "mir-snapshot-restore ok=0 reason=arena-handle-resource-exhausted"
    }
    pilot retire = 0
    repeat until retire >= array_len(records) {
        pilot line: word = array_get(records, retire)
        if v4_mir_snapshot_field_raw(line, 0) == "mir" {
            pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
            if v4_mir_file_exists(mir_id) {
                v4_mir_release_lookup_indexes(mir_id)
                v4_mir_restore_release_file_raw(mir_id)
            }
        }
        retire += 1
    }
    v4_mir_restore_building = true
    pilot restored_files = 0
    pilot restored_bodies = 0
    pilot restored_blocks = 0
    pilot restored_locals = 0
    pilot restored_statements = 0
    pilot restored_places = 0
    pilot restored_rvalues = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot restore_failures = 0
    pilot line_id = 0
    pilot line_count = array_len(records)
    repeat until line_id >= line_count {
        pilot line: word = array_get(records, line_id)
        if line != "" {
            pilot kind = v4_mir_snapshot_field_raw(line, 0)
            if kind == "mir" {
                pilot file_applied = v4_mir_snapshot_restore_file_line(line)
                restored_files += file_applied
                if file_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-body" {
                pilot body_applied = v4_mir_snapshot_restore_body_line(line)
                restored_bodies += body_applied
                if body_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-block" {
                pilot block_applied = v4_mir_snapshot_restore_block_line(line)
                restored_blocks += block_applied
                if block_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-local" {
                pilot local_applied = v4_mir_snapshot_restore_local_line(line)
                restored_locals += local_applied
                if local_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-stmt" {
                pilot stmt_applied = v4_mir_snapshot_restore_stmt_line(line)
                restored_statements += stmt_applied
                if stmt_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-place" {
                pilot place_applied = v4_mir_snapshot_restore_place_line(line)
                restored_places += place_applied
                if place_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-rvalue" {
                pilot rvalue_applied = v4_mir_snapshot_restore_rvalue_line(line)
                restored_rvalues += rvalue_applied
                if rvalue_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-diag" {
                pilot diag_applied = v4_mir_snapshot_restore_diag_line(line)
                restored_diagnostics += diag_applied
                if diag_applied != 1 { restore_failures += 1 }
            } else if kind != "mir-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    v4_mir_restore_building = false
    if restore_failures != 0 { panic("admitted MIR snapshot rebuild invariant failed") }

    -- Optional indexes may remain cold under handle pressure; restored facts
    -- stay authoritative. Publish only after the complete component is applied.
    if restore_failures == 0 {
        pilot finalized = 0
        repeat until finalized >= array_len(records) {
            pilot line: word = array_get(records, finalized)
            if v4_mir_snapshot_field_raw(line, 0) == "mir" {
                v4_mir_finalize_lookup_indexes(word_to_int(v4_mir_snapshot_field_raw(line, 1)))
            }
            finalized += 1
        }
    }
    array_release(records)
    pilot restore_ok = 1
    if restore_failures > 0 { restore_ok = 0 }
    pilot out = "mir-snapshot-restore ok=" + word_from_int(restore_ok)
    out = out + " files=" + word_from_int(restored_files)
    out = out + " bodies=" + word_from_int(restored_bodies)
    out = out + " blocks=" + word_from_int(restored_blocks)
    out = out + " locals=" + word_from_int(restored_locals)
    out = out + " statements=" + word_from_int(restored_statements)
    out = out + " places=" + word_from_int(restored_places)
    out = out + " rvalues=" + word_from_int(restored_rvalues)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " failures=" + word_from_int(restore_failures)
    out = out + " live-files=" + word_from_int(v4_mir_file_count())
    give back out
}


-- Lexical scope ownership is a semantic MIR fact, including empty CFG joins.
task v4_mir_scope_span_is_valid(span: word) -> bool {
    if span == (V4_NO_SPAN) { give back true }
    pilot file = v4_span_file(span)
    if not v4_mir_snapshot_nonnegative_int_is_valid(file) { give back false }
    pilot start = v4_span_start(span)
    pilot end = v4_span_end(span)
    give back start >= 0 and end > start and v4_span_new(file, start, end) == span
}

task v4_mir_scope_contains(outer: word, inner: word) -> bool {
    if outer == V4_NO_SPAN or inner == (V4_NO_SPAN) { give back false }
    give back v4_span_file(outer) == v4_span_file(inner) and v4_span_start(outer) <= v4_span_start(inner) and v4_span_end(outer) >= v4_span_end(inner)
}

task v4_mir_block_with_scope(record: word, scope: word) -> word {
    give back v4_mir_block_part(record, 0) + "|" + v4_mir_block_part(record, 1) + "|" + v4_mir_block_part(record, 2) + "|" + v4_mir_block_part(record, 3) + "|" + v4_mir_block_part(record, 4) + "|" + scope
}

task v4_mir_block_scope_span(mir_id: int, body_id: int, block_id: int) -> word {
    if block_id < 0 or block_id >= v4_mir_body_block_count(mir_id, body_id) { give back V4_NO_SPAN }
    give back v4_mir_block_part(v4_mir_body_block(mir_id, body_id, block_id), 5)
}

task v4_mir_set_block_scope_span(mir_id: int, body_id: int, block_id: int, scope: word) -> void {
    array_set(v4_mir_body_blocks_handle(mir_id, body_id), block_id, v4_mir_block_with_scope(v4_mir_body_block(mir_id, body_id, block_id), scope))
}

task v4_mir_stmt_scope_span(mir_id: int, body_id: int, stmt_id: int) -> word {
    if stmt_id < 0 or stmt_id >= v4_mir_body_stmt_count(mir_id, body_id) { give back V4_NO_SPAN }
    give back array_get(v4_mir_body_stmt_scope_spans_handle(mir_id, body_id), stmt_id)
}

task v4_mir_set_stmt_scope_span(mir_id: int, body_id: int, stmt_id: int, scope: word) -> void {
    array_set(v4_mir_body_stmt_scope_spans_handle(mir_id, body_id), stmt_id, scope)
}

task v4_mir_word_local_scope_exits_before_stmt(mir_id: int, body_id: int, local_id: int, previous_stmt: int, next_stmt: int) -> bool {
    pilot local_scope = v4_mir_local_scope_span(mir_id, body_id, local_id)
    give back v4_mir_scope_contains(local_scope, v4_mir_stmt_scope_span(mir_id, body_id, previous_stmt)) and not v4_mir_scope_contains(local_scope, v4_mir_stmt_scope_span(mir_id, body_id, next_stmt))
}

-- An edge leaves the scope of its source block's last statement (or the
-- block's own scope when empty) and enters its target's first statement.
task v4_mir_edge_source_scope(mir_id: int, body_id: int, source_block: int) -> word {
    pilot stmt_id = v4_mir_block_last_stmt(mir_id, body_id, source_block)
    if stmt_id >= 0 { give back v4_mir_stmt_scope_span(mir_id, body_id, stmt_id) }
    give back v4_mir_block_scope_span(mir_id, body_id, source_block)
}

task v4_mir_edge_target_scope(mir_id: int, body_id: int, target_block: int) -> word {
    pilot stmt_id = v4_mir_block_first_stmt(mir_id, body_id, target_block)
    if stmt_id >= 0 { give back v4_mir_stmt_scope_span(mir_id, body_id, stmt_id) }
    give back v4_mir_block_scope_span(mir_id, body_id, target_block)
}

task v4_mir_word_local_scope_exits_between(mir_id: int, body_id: int, local_id: int, source_scope: word, target_scope: word) -> bool {
    pilot local_scope = v4_mir_local_scope_span(mir_id, body_id, local_id)
    give back v4_mir_scope_contains(local_scope, source_scope) and not v4_mir_scope_contains(local_scope, target_scope)
}

task v4_mir_word_local_scope_exits_on_edge(mir_id: int, body_id: int, local_id: int, source_block: int, target_block: int) -> bool {
    give back v4_mir_word_local_scope_exits_between(mir_id, body_id, local_id, v4_mir_edge_source_scope(mir_id, body_id, source_block), v4_mir_edge_target_scope(mir_id, body_id, target_block))
}


task v4_mir_word_intrinsic_identity(kind: word) -> word {
    if not v4_ty_word_intrinsic_known(kind) { give back "" }
    give back "builtin::word::" + kind
}

task v4_mir_builtin_word_identity_kind(identity: word) -> word {
    if not identity.starts_with("builtin::word::") { give back "" }
    pilot kind = v4_slice(identity, 15, identity.length())
    if not v4_ty_word_intrinsic_known(kind) { give back "" }
    give back kind
}

task v4_mir_system_intrinsic_identity(kind: word) -> word {
    if not v4_ty_system_intrinsic_known(kind) { give back "" }
    give back "builtin::system::" + kind
}

task v4_mir_builtin_system_identity_kind(identity: word) -> word {
    if not identity.starts_with("builtin::system::") { give back "" }
    pilot kind = v4_slice(identity, 17, identity.length())
    if not v4_ty_system_intrinsic_known(kind) { give back "" }
    give back kind
}

task v4_mir_scalar_sum_kind(mir: int, type_text: word) -> word {
    give back v4_ty_native_scalar_sum_kind(v4_mir_ty_id(mir), type_text)
}

task v4_mir_local_reference_is_exact(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) or v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_use_local { give back false }
    pilot local = v4_mir_rvalue_local_id(mir, body, value)
    if local < 0 or local >= v4_mir_body_local_count(mir, body) { give back false }
    give back v4_mir_rvalue_op(mir, body, value) == "local#" + word_from_int(local) and v4_mir_rvalue_text(mir, body, value) == v4_mir_local_name(mir, body, local) and v4_mir_rvalue_ty(mir, body, value) == v4_mir_local_ty(mir, body, local) and v4_mir_rvalue_lhs(mir, body, value) == -1 and v4_mir_rvalue_rhs(mir, body, value) == -1 and v4_mir_rvalue_abi(mir, body, value) == "" and v4_mir_rvalue_builtin_method(mir, body, value) == "" and v4_mir_rvalue_call_arg_count(mir, body, value) == 0
}

-- Source binding eligibility survives persistence as TY and lexical MIR facts.
-- A closed identity does not authorize bypassing an ordinary namespace shadow.
task v4_mir_system_intrinsic_origin_is_available(ty: int, kind: word, span: word) -> bool {
    pilot name = v4_ty_system_intrinsic_public_name(kind)
    if name == "" or span == (V4_NO_SPAN) or not v4_mir_span_fact_is_valid(span) or v4_span_file(span) != word_from_int(v4_ty_file_id(ty)) { give back false }
    give back v4_ty_system_intrinsic_named_kind(ty, name) == kind
}

task v4_mir_system_intrinsic_name_is_shadow(kind: word, binding_name: word) -> bool {
    pilot name = v4_ty_system_intrinsic_public_name(kind)
    if name == "" { give back false }
    pilot root = "process"
    if kind == "fs_read" { root = "fs" }
    give back binding_name == root or binding_name == name
}

task v4_mir_system_intrinsic_shadow_is_visible(kind: word, call_span: word, local_name: word, definition_span: word, scope_span: word) -> bool {
    if not v4_mir_system_intrinsic_name_is_shadow(kind, local_name) { give back false }
    -- Missing/malformed binding anchors cannot prove an unshadowed call.
    if definition_span == (V4_NO_SPAN) or scope_span == (V4_NO_SPAN) or not v4_mir_span_fact_is_valid(definition_span) or not v4_mir_scope_span_is_valid(scope_span) or v4_span_file(definition_span) != v4_span_file(call_span) or v4_span_file(scope_span) != v4_span_file(call_span) { give back true }
    pilot first = v4_span_start(definition_span)
    pilot last = v4_span_end(scope_span)
    if last <= first { last = v4_span_end(definition_span) }
    pilot position = v4_span_start(call_span)
    give back position >= first and position < last
}

task v4_mir_rvalue_is_builtin_system(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) { give back false }
    pilot identity = v4_mir_rvalue_builtin_method(mir, body, value)
    pilot kind = v4_mir_builtin_system_identity_kind(identity)
    if kind == "" or v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_call { give back false }
    pilot span = v4_mir_rvalue_span(mir, body, value)
    if not v4_mir_system_intrinsic_origin_is_available(v4_mir_ty_id(mir), kind, span) { give back false }
    -- Authoritative formals are visible throughout the body, independently
    -- of persisted local definition anchors used only by lexical locals.
    pilot parameter = 0
    repeat until parameter >= v4_mir_body_callable_param_count(mir, body) {
        if v4_mir_system_intrinsic_name_is_shadow(kind, v4_mir_body_callable_param_name(mir, body, parameter)) { give back false }
        parameter += 1
    }
    pilot local = 0
    repeat until local >= v4_mir_body_local_count(mir, body) {
        if v4_mir_system_intrinsic_shadow_is_visible(kind, span, v4_mir_local_name(mir, body, local), v4_mir_local_span(mir, body, local), v4_mir_local_scope_span(mir, body, local)) { give back false }
        local += 1
    }
    if v4_mir_rvalue_op(mir, body, value) != identity or v4_mir_rvalue_abi(mir, body, value) != "" or v4_mir_rvalue_lhs(mir, body, value) != -1 or v4_mir_rvalue_rhs(mir, body, value) != -1 { give back false }
    if v4_mir_rvalue_ty(mir, body, value) != v4_ty_system_intrinsic_result_type(kind) or v4_mir_rvalue_call_arg_count(mir, body, value) != v4_ty_system_intrinsic_param_count(kind) { give back false }
    if kind == "args_count" { give back true }
    if v4_mir_scalar_sum_kind(mir, v4_mir_rvalue_ty(mir, body, value)) != "ResultWordWord" { give back false }
    pilot child = v4_mir_rvalue_call_arg(mir, body, value, 0)
    if child < 0 or child >= value { give back false }
    if kind == "process_arg" {
        if v4_mir_rvalue_ty(mir, body, child) != v4_ty_int { give back false }
        if v4_mir_rvalue_kind(mir, body, child) == v4_mir_rvalue_use_local { give back v4_mir_local_reference_is_exact(mir, body, child) }
        give back true
    }
    if v4_mir_rvalue_kind(mir, body, child) != v4_mir_rvalue_lend or v4_mir_rvalue_ty(mir, body, child) != "lend word" or v4_mir_rvalue_rhs(mir, body, child) != -1 or v4_mir_rvalue_abi(mir, body, child) != "" or v4_mir_rvalue_builtin_method(mir, body, child) != "" or v4_mir_rvalue_call_arg_count(mir, body, child) != 0 { give back false }
    pilot owner = v4_mir_rvalue_lhs(mir, body, child)
    if owner < 0 or owner >= child or v4_mir_rvalue_ty(mir, body, owner) != v4_ty_word { give back false }
    if v4_mir_rvalue_kind(mir, body, owner) == v4_mir_rvalue_use_local { give back v4_mir_local_reference_is_exact(mir, body, owner) }
    pilot owner_kind = v4_mir_rvalue_kind(mir, body, owner)
    give back owner_kind == v4_mir_rvalue_const_word or owner_kind == v4_mir_rvalue_call or owner_kind == v4_mir_rvalue_sum_take
}

task v4_mir_system_intrinsic_kind(mir: int, body: int, value: int) -> word {
    if not v4_mir_rvalue_is_builtin_system(mir, body, value) { give back "" }
    give back v4_mir_builtin_system_identity_kind(v4_mir_rvalue_builtin_method(mir, body, value))
}

task v4_mir_builtin_method_identity_is_known(identity: word) -> bool {
    give back v4_mir_builtin_shared_method_identity_is_known(identity) or v4_mir_builtin_word_identity_kind(identity) != "" or v4_mir_builtin_control_identity_kind(identity) != "" or v4_mir_builtin_system_identity_kind(identity) != "" or v4_mir_builtin_list_identity_kind(identity) != "" or v4_mir_builtin_map_identity_kind(identity) != ""
}

task v4_mir_builtin_method_identity_code(identity: word) -> int {
    if identity == "builtin::control::panic" { give back 201 }
    if identity == "builtin::system::process_arg" { give back 202 }
    if identity == "builtin::system::args_count" { give back 203 }
    if identity == "builtin::system::fs_read" { give back 204 }
    if identity == "builtin::list::push" { give back 401 }
    if identity == "builtin::list::length" { give back 402 }
    pilot map_code = v4_mir_builtin_map_identity_code(identity)
    if map_code > 0 { give back map_code }
    pilot shared = v4_mir_builtin_shared_method_identity_code(identity)
    if shared > 0 { give back shared }
    pilot kind = v4_mir_builtin_word_identity_kind(identity)
    if kind == "concat" { give back 101 }
    if kind == "equal" { give back 102 }
    if kind == "not_equal" { give back 103 }
    if kind == "say" { give back 104 }
    if kind == "say_err" { give back 105 }
    if kind == "from_int" { give back 106 }
    if kind == "from_bool" { give back 107 }
    if kind == "from_num" { give back 108 }
    if kind == "to_int" { give back 109 }
    if kind == "length" { give back 110 }
    if kind == "bytes" { give back 111 }
    if kind == "char_at" { give back 112 }
    if kind == "slice" { give back 113 }
    if kind == "substring" { give back 114 }
    if kind == "starts_with" { give back 115 }
    if kind == "ends_with" { give back 116 }
    if kind == "contains" { give back 117 }
    if kind == "clone" { give back 118 }
    if kind == "to_lower" { give back 119 }
    if kind == "to_int_maybe" { give back 120 }
    -- Bootstrap-mode intrinsics (tier 2) round-trip through snapshots too.
    if v4_ty_bootstrap_intrinsic_known(kind) { give back 300 }
    give back 0
}

task v4_mir_word_intrinsic_argument_is_borrowed(kind: word, arg_id: int) -> bool {
    give back v4_ty_word_intrinsic_param_type(kind, arg_id) == v4_ty_word
}

-- Intrinsic identity is never inferred from ordinary user-visible call text.
task v4_mir_rvalue_is_builtin_word(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    pilot identity = v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id)
    pilot kind = v4_mir_builtin_word_identity_kind(identity)
    if kind == "" or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call { give back false }
    if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) != identity or v4_mir_rvalue_abi(mir_id, body_id, rvalue_id) != "" { give back false }
    if v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id) >= 0 or v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id) >= 0 { give back false }
    if v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) != v4_ty_word_intrinsic_result_type(kind) { give back false }
    if kind == "to_int_maybe" and v4_mir_scalar_sum_kind(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) != "MaybeInt" { give back false }
    if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) != v4_ty_word_intrinsic_param_count(kind) { give back false }
    pilot arg_id = 0
    repeat until arg_id >= v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) {
        pilot child = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
        pilot expected = v4_ty_word_intrinsic_param_type(kind, arg_id)
        if child < 0 or child >= rvalue_id { give back false }
        if expected == v4_ty_word {
            if v4_mir_rvalue_kind(mir_id, body_id, child) != v4_mir_rvalue_lend or v4_mir_rvalue_ty(mir_id, body_id, child) != "lend word" or v4_mir_rvalue_rhs(mir_id, body_id, child) >= 0 { give back false }
            pilot value = v4_mir_rvalue_lhs(mir_id, body_id, child)
            if value < 0 or value >= child or v4_mir_rvalue_ty(mir_id, body_id, value) != v4_ty_word { give back false }
        } else if not v4_ty_types_compatible(expected, v4_mir_rvalue_ty(mir_id, body_id, child)) { give back false }
        arg_id += 1
    }
    give back true
}

task v4_mir_word_intrinsic_kind(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if not v4_mir_rvalue_is_builtin_word(mir_id, body_id, rvalue_id) { give back "" }
    give back v4_mir_builtin_word_identity_kind(v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id))
}


-- Native lists (tier 3). `List<T>` operations are closed builtin calls that
-- take the list as a loan first: `length` a shared loan, `push` a `lend mut`
-- loan whose second argument moves into the list. A loan is a Lend/LendMut
-- of a place read of the list, or a read of a local that holds such a loan.
task v4_mir_list_intrinsic_identity(kind: word) -> word {
    if kind != "push" and kind != "length" { give back "" }
    give back "builtin::list::" + kind
}

task v4_mir_builtin_list_identity_kind(identity: word) -> word {
    if identity == "builtin::list::push" { give back "push" }
    if identity == "builtin::list::length" { give back "length" }
    give back ""
}

-- The list type a loan argument lends, or "" when it is not a list loan of
-- the wanted mode (a `lend mut` loan also serves a shared use).
task v4_mir_list_loan_type(mir: int, body: int, value: int, mutable: bool) -> word {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) { give back "" }
    pilot loan_ty = v4_mir_rvalue_ty(mir, body, value)
    if not v4_ty_is_lend_type(loan_ty) { give back "" }
    if mutable and v4_ty_lend_mode(loan_ty) != v4_ty_param_mode_lend_mut { give back "" }
    pilot list_ty = v4_ty_canonical_type(v4_mir_ty_id(mir), v4_ty_lend_target_type(loan_ty))
    if v4_ty_list_element_type(list_ty) == v4_ty_unknown { give back "" }
    pilot kind = v4_mir_rvalue_kind(mir, body, value)
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        pilot mutable_kind: bool = kind == v4_mir_rvalue_lend_mut
        pilot mutable_type: bool = v4_ty_lend_mode(loan_ty) == v4_ty_param_mode_lend_mut
        if mutable_kind != mutable_type { give back "" }
        pilot owner = v4_mir_rvalue_lhs(mir, body, value)
        if owner < 0 or owner >= value or v4_mir_rvalue_rhs(mir, body, value) >= 0 { give back "" }
        pilot owner_kind = v4_mir_rvalue_kind(mir, body, owner)
        if owner_kind != v4_mir_rvalue_use_local and owner_kind != v4_mir_rvalue_use_place { give back "" }
        if owner_kind == v4_mir_rvalue_use_local and not v4_mir_local_reference_is_exact(mir, body, owner) { give back "" }
        if v4_ty_canonical_type(v4_mir_ty_id(mir), v4_mir_rvalue_ty(mir, body, owner)) != list_ty { give back "" }
        give back list_ty
    }
    if kind == v4_mir_rvalue_use_local and v4_mir_local_reference_is_exact(mir, body, value) { give back list_ty }
    give back ""
}

-- Intrinsic identity is never inferred from ordinary user-visible call text.
task v4_mir_rvalue_is_builtin_list(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) { give back false }
    pilot identity = v4_mir_rvalue_builtin_method(mir, body, value)
    pilot kind = v4_mir_builtin_list_identity_kind(identity)
    if kind == "" or v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_call { give back false }
    if v4_mir_rvalue_op(mir, body, value) != identity or v4_mir_rvalue_abi(mir, body, value) != "" or v4_mir_rvalue_lhs(mir, body, value) != -1 or v4_mir_rvalue_rhs(mir, body, value) != -1 { give back false }
    pilot count = v4_mir_rvalue_call_arg_count(mir, body, value)
    pilot loan = v4_mir_rvalue_call_arg(mir, body, value, 0)
    if count < 1 or loan < 0 or loan >= value { give back false }
    pilot list_ty = v4_mir_list_loan_type(mir, body, loan, kind == "push")
    if list_ty == "" { give back false }
    if kind == "length" { give back count == 1 and v4_mir_rvalue_ty(mir, body, value) == v4_ty_int }
    if count != 2 or v4_mir_rvalue_ty(mir, body, value) != v4_ty_void { give back false }
    pilot item = v4_mir_rvalue_call_arg(mir, body, value, 1)
    if item < 0 or item >= value { give back false }
    give back v4_ty_types_compatible(v4_ty_list_element_type(list_ty), v4_mir_rvalue_ty(mir, body, item))
}

task v4_mir_list_intrinsic_kind(mir: int, body: int, value: int) -> word {
    if not v4_mir_rvalue_is_builtin_list(mir, body, value) { give back "" }
    give back v4_mir_builtin_list_identity_kind(v4_mir_rvalue_builtin_method(mir, body, value))
}

-- A native list loop item: LoopItem over a list loan (lhs) and an int index
-- (rhs) is a fresh owned copy of that element (words are cloned). A LoopItem
-- without operands is the front end's opaque item of other iterables.
task v4_mir_rvalue_is_list_loop_item(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) or v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_loop_item { give back false }
    pilot loan = v4_mir_rvalue_lhs(mir, body, value)
    pilot index = v4_mir_rvalue_rhs(mir, body, value)
    if loan < 0 or index < 0 or loan >= value or index >= value { give back false }
    pilot list_ty = v4_mir_list_loan_type(mir, body, loan, false)
    if list_ty == "" or v4_mir_rvalue_ty(mir, body, index) != v4_ty_int { give back false }
    give back v4_ty_canonical_type(v4_mir_ty_id(mir), v4_mir_rvalue_ty(mir, body, value)) == v4_ty_canonical_type(v4_mir_ty_id(mir), v4_ty_list_element_type(list_ty))
}

-- Native maps and sets (tier 3). `Map<K, V>` and `Set<T>` are owned hash
-- collections. Their operations are closed builtin calls that take the
-- collection as a loan first, like the list intrinsics: `get`, `length`
-- and `contains` a shared loan, `set`, `add` and `remove` a `lend mut`
-- loan. A key a call only looks up is lent (`lend word` for word keys);
-- a key `set` or `add` stores moves in, as does the stored value. `new`
-- is the empty collection of its sealed result type. `m[k]` is the
-- checked Index place over the map, not a call.
task v4_mir_hash_collection_kind(mir: int, type_text: word) -> word {
    if mir < 0 or type_text == "" or type_text == v4_ty_unknown or v4_ty_is_lend_type(type_text) { give back "" }
    pilot canonical = v4_ty_canonical_type(v4_mir_ty_id(mir), type_text)
    if not v4_ty_is_generic_instance_type(canonical) { give back "" }
    pilot base = v4_ty_generic_base_name(canonical)
    if base == "Map" and v4_ty_generic_arg_count(canonical) == 2 { give back "Map" }
    if base == "Set" and v4_ty_generic_arg_count(canonical) == 1 { give back "Set" }
    give back ""
}

task v4_mir_hash_collection_key_type(mir: int, type_text: word) -> word {
    if v4_mir_hash_collection_kind(mir, type_text) == "" { give back v4_ty_unknown }
    pilot canonical = v4_ty_canonical_type(v4_mir_ty_id(mir), type_text)
    give back v4_ty_canonical_type(v4_mir_ty_id(mir), v4_ty_generic_arg(canonical, 0))
}

-- The value type of a map, or unknown for a set (whose entries are keys).
task v4_mir_hash_collection_value_type(mir: int, type_text: word) -> word {
    if v4_mir_hash_collection_kind(mir, type_text) != "Map" { give back v4_ty_unknown }
    pilot canonical = v4_ty_canonical_type(v4_mir_ty_id(mir), type_text)
    give back v4_ty_canonical_type(v4_mir_ty_id(mir), v4_ty_generic_arg(canonical, 1))
}

task v4_mir_map_intrinsic_identity(family: word, kind: word) -> word {
    if family == "map" and (kind == "new" or kind == "set" or kind == "get" or kind == "length" or kind == "remove") { give back "builtin::map::" + kind }
    if family == "set" and (kind == "new" or kind == "add" or kind == "contains" or kind == "length" or kind == "remove") { give back "builtin::set::" + kind }
    give back ""
}

-- `map_set`, `set_add`, ...: the family and the operation of a map or set
-- builtin identity, or "".
task v4_mir_builtin_map_identity_kind(identity: word) -> word {
    if identity == "builtin::map::new" { give back "map_new" }
    if identity == "builtin::map::set" { give back "map_set" }
    if identity == "builtin::map::get" { give back "map_get" }
    if identity == "builtin::map::length" { give back "map_length" }
    if identity == "builtin::map::remove" { give back "map_remove" }
    if identity == "builtin::set::new" { give back "set_new" }
    if identity == "builtin::set::add" { give back "set_add" }
    if identity == "builtin::set::contains" { give back "set_contains" }
    if identity == "builtin::set::length" { give back "set_length" }
    if identity == "builtin::set::remove" { give back "set_remove" }
    give back ""
}

task v4_mir_builtin_map_identity_code(identity: word) -> int {
    pilot kind = v4_mir_builtin_map_identity_kind(identity)
    if kind == "map_new" { give back 403 }
    if kind == "map_set" { give back 404 }
    if kind == "map_get" { give back 405 }
    if kind == "map_length" { give back 406 }
    if kind == "map_remove" { give back 407 }
    if kind == "set_new" { give back 408 }
    if kind == "set_add" { give back 409 }
    if kind == "set_contains" { give back 410 }
    if kind == "set_length" { give back 411 }
    if kind == "set_remove" { give back 412 }
    give back 0
}

-- The map or set type a loan argument lends, or "" when it is not such a
-- loan of the wanted mode (a `lend mut` loan also serves a shared use).
task v4_mir_map_loan_type(mir: int, body: int, value: int, mutable: bool) -> word {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) { give back "" }
    pilot loan_ty = v4_mir_rvalue_ty(mir, body, value)
    if not v4_ty_is_lend_type(loan_ty) { give back "" }
    if mutable and v4_ty_lend_mode(loan_ty) != v4_ty_param_mode_lend_mut { give back "" }
    pilot target_ty = v4_ty_lend_target_type(loan_ty)
    if v4_mir_hash_collection_kind(mir, target_ty) == "" { give back "" }
    pilot collection_ty = v4_ty_canonical_type(v4_mir_ty_id(mir), target_ty)
    pilot kind = v4_mir_rvalue_kind(mir, body, value)
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        pilot mutable_kind: bool = kind == v4_mir_rvalue_lend_mut
        pilot mutable_type: bool = v4_ty_lend_mode(loan_ty) == v4_ty_param_mode_lend_mut
        if mutable_kind != mutable_type { give back "" }
        pilot owner = v4_mir_rvalue_lhs(mir, body, value)
        if owner < 0 or owner >= value or v4_mir_rvalue_rhs(mir, body, value) >= 0 { give back "" }
        pilot owner_kind = v4_mir_rvalue_kind(mir, body, owner)
        if owner_kind != v4_mir_rvalue_use_local and owner_kind != v4_mir_rvalue_use_place { give back "" }
        if owner_kind == v4_mir_rvalue_use_local and not v4_mir_local_reference_is_exact(mir, body, owner) { give back "" }
        if v4_ty_canonical_type(v4_mir_ty_id(mir), v4_mir_rvalue_ty(mir, body, owner)) != collection_ty { give back "" }
        give back collection_ty
    }
    if kind == v4_mir_rvalue_use_local and v4_mir_local_reference_is_exact(mir, body, value) { give back collection_ty }
    give back ""
}

-- A key the operation only looks up: a shared `lend word` loan of a word
-- for word keys, the key value itself for scalar keys.
task v4_mir_map_lookup_key_is_valid(mir: int, body: int, value: int, key: int, key_ty: word) -> bool {
    if key < 0 or key >= value { give back false }
    if key_ty == v4_ty_word {
        if v4_mir_rvalue_kind(mir, body, key) != v4_mir_rvalue_lend or v4_mir_rvalue_ty(mir, body, key) != "lend word" or v4_mir_rvalue_rhs(mir, body, key) >= 0 { give back false }
        pilot owner = v4_mir_rvalue_lhs(mir, body, key)
        give back owner >= 0 and owner < key and v4_mir_rvalue_ty(mir, body, owner) == v4_ty_word
    }
    give back v4_ty_types_compatible(key_ty, v4_mir_rvalue_ty(mir, body, key))
}

-- Intrinsic identity is never inferred from ordinary user-visible call text.
task v4_mir_rvalue_is_builtin_map(mir: int, body: int, value: int) -> bool {
    if value < 0 or value >= v4_mir_body_rvalue_count(mir, body) { give back false }
    pilot identity = v4_mir_rvalue_builtin_method(mir, body, value)
    pilot kind = v4_mir_builtin_map_identity_kind(identity)
    if kind == "" or v4_mir_rvalue_kind(mir, body, value) != v4_mir_rvalue_call { give back false }
    if v4_mir_rvalue_op(mir, body, value) != identity or v4_mir_rvalue_abi(mir, body, value) != "" or v4_mir_rvalue_lhs(mir, body, value) != -1 or v4_mir_rvalue_rhs(mir, body, value) != -1 { give back false }
    pilot count = v4_mir_rvalue_call_arg_count(mir, body, value)
    pilot result_ty = v4_mir_rvalue_ty(mir, body, value)
    pilot family = "Map"
    if kind.starts_with("set_") { family = "Set" }
    if kind == "map_new" or kind == "set_new" { give back count == 0 and v4_mir_hash_collection_kind(mir, result_ty) == family }
    pilot loan = v4_mir_rvalue_call_arg(mir, body, value, 0)
    if count < 1 or loan < 0 or loan >= value { give back false }
    pilot mutable: bool = kind == "map_set" or kind == "map_remove" or kind == "set_add" or kind == "set_remove"
    pilot collection_ty = v4_mir_map_loan_type(mir, body, loan, mutable)
    if collection_ty == "" or v4_mir_hash_collection_kind(mir, collection_ty) != family { give back false }
    if kind == "map_length" or kind == "set_length" { give back count == 1 and result_ty == v4_ty_int }
    pilot key_ty = v4_mir_hash_collection_key_type(mir, collection_ty)
    pilot key = v4_mir_rvalue_call_arg(mir, body, value, 1)
    if kind == "map_set" {
        if count != 3 or result_ty != v4_ty_void or key < 0 or key >= value { give back false }
        pilot item = v4_mir_rvalue_call_arg(mir, body, value, 2)
        if item < 0 or item >= value { give back false }
        give back v4_ty_types_compatible(key_ty, v4_mir_rvalue_ty(mir, body, key)) and v4_ty_types_compatible(v4_mir_hash_collection_value_type(mir, collection_ty), v4_mir_rvalue_ty(mir, body, item))
    }
    if count != 2 { give back false }
    if kind == "set_add" { give back result_ty == v4_ty_void and key >= 0 and key < value and v4_ty_types_compatible(key_ty, v4_mir_rvalue_ty(mir, body, key)) }
    if not v4_mir_map_lookup_key_is_valid(mir, body, value, key, key_ty) { give back false }
    if kind == "map_get" { give back v4_ty_canonical_type(v4_mir_ty_id(mir), result_ty) == v4_ty_canonical_type(v4_mir_ty_id(mir), "maybe<" + v4_mir_hash_collection_value_type(mir, collection_ty) + ">") }
    give back result_ty == v4_ty_bool
}

task v4_mir_map_intrinsic_kind(mir: int, body: int, value: int) -> word {
    if not v4_mir_rvalue_is_builtin_map(mir, body, value) { give back "" }
    give back v4_mir_builtin_map_identity_kind(v4_mir_rvalue_builtin_method(mir, body, value))
}

-- Check graph order before Meiya follows live low-level MIR mutations.
task v4_mir_word_plan_preflight(mir_id: int) -> word {
    pilot body = 0
    repeat until body >= v4_mir_body_count(mir_id) {
        pilot word_body: bool = false
        pilot inspect = 0
        repeat until inspect >= v4_mir_body_local_count(mir_id, body) {
            if v4_ty_is_native_owned_value(v4_mir_ty_id(mir_id), v4_mir_local_ty(mir_id, body, inspect)) { word_body = true }
            inspect += 1
        }
        inspect = 0
        repeat until inspect >= v4_mir_body_rvalue_count(mir_id, body) {
            if v4_ty_is_native_owned_value(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body, inspect)) or v4_mir_rvalue_ty(mir_id, body, inspect) == "lend word" { word_body = true }
            inspect += 1
        }
        if word_body {
            pilot body_span = v4_mir_word_source_body_span(v4_mir_ty_id(mir_id), v4_mir_body_def(mir_id, body))
            pilot file_id = v4_mir_file_id(mir_id)
            inspect = 0
            repeat until inspect >= v4_mir_body_block_count(mir_id, body) {
                pilot scope = v4_mir_block_scope_span(mir_id, body, inspect)
                if scope == (V4_NO_SPAN) or not v4_mir_word_scope_fact_is_valid(scope, file_id, body_span, V4_NO_SPAN, false) { give back "invalid native word ownership block scope" }
                inspect += 1
            }
            inspect = 0
            repeat until inspect >= v4_mir_body_local_count(mir_id, body) {
                if not v4_mir_word_scope_fact_is_valid(v4_mir_local_scope_span(mir_id, body, inspect), file_id, body_span, v4_mir_local_span(mir_id, body, inspect), true) { give back "invalid native word ownership local scope" }
                inspect += 1
            }
            inspect = 0
            repeat until inspect >= v4_mir_body_stmt_count(mir_id, body) {
                if not v4_mir_word_scope_fact_is_valid(v4_mir_stmt_scope_span(mir_id, body, inspect), file_id, body_span, v4_mir_stmt_span(mir_id, body, inspect), true) { give back "invalid native word ownership statement scope" }
                inspect += 1
            }
        }
        pilot depth_words = array_new()
        pilot cost_words = array_new()
        if depth_words < 0 or cost_words < 0 {
            array_release(cost_words)
            array_release(depth_words)
            give back "native word ownership plan scratch exhausted"
        }
        pilot value = 0
        pilot error = ""
        repeat until value >= v4_mir_body_rvalue_count(mir_id, body) or error != "" {
            pilot kind = v4_mir_rvalue_kind(mir_id, body, value)
            pilot lhs = v4_mir_rvalue_lhs(mir_id, body, value)
            pilot rhs = v4_mir_rvalue_rhs(mir_id, body, value)
            pilot args = v4_mir_rvalue_args_payload(mir_id, body, value)
            if not v4_mir_snapshot_rvalue_refs_are_valid(kind, word_from_int(lhs), word_from_int(rhs), args, value, v4_mir_body_place_count(mir_id, body)) {
                error = "invalid native word ownership rvalue graph"
            }
            pilot weight = 1
            pilot depth = weight
            pilot cost = 1
            if error == "" {
                if kind != v4_mir_rvalue_use_place and lhs >= 0 {
                    depth = word_to_int(array_get(depth_words, lhs)) + weight
                    cost += word_to_int(array_get(cost_words, lhs))
                }
                if rhs >= 0 {
                    pilot right_depth = word_to_int(array_get(depth_words, rhs)) + weight
                    if right_depth > depth { depth = right_depth }
                    cost += word_to_int(array_get(cost_words, rhs))
                }
                if kind == v4_mir_rvalue_use_place and lhs >= 0 {
                    -- Index and pointer operands of the place are children too.
                    pilot operands = v4_mir_place_operand_payload(mir_id, body, lhs, value)
                    if operands == "?" {
                        if word_body { error = "invalid native word ownership rvalue graph" }
                        operands = ""
                    }
                    if args == "" { args = operands } else if operands != "" { args = args + "," + operands }
                }
                pilot arg = 0
                repeat until arg >= v4_mir_call_args_payload_count(args) {
                    pilot child = word_to_int(v4_mir_snapshot_comma_part(args, arg))
                    pilot child_depth = word_to_int(array_get(depth_words, child)) + weight
                    if child_depth > depth { depth = child_depth }
                    cost += word_to_int(array_get(cost_words, child))
                    if cost > 8192 { cost = 8193 }
                    arg += 1
                }
                if cost > 8192 { cost = 8193 }
                if word_body and depth > 256 { error = "native word ownership expression nesting exceeds supported depth" }
                if word_body and cost > 8192 { error = "native word ownership expression traversal exceeds supported budget" }
                array_push(depth_words, word_from_int(depth))
                array_push(cost_words, word_from_int(cost))
                if array_len(depth_words) != value + 1 or array_len(cost_words) != value + 1 { error = "native word ownership plan scratch exhausted" }
            }
            value += 1
        }
        array_release(cost_words)
        array_release(depth_words)
        if error != "" { give back error }
        body += 1
    }
    give back v4_mir_scalar_sum_plan_preflight(mir_id)
}

-- The rvalues a place read evaluates: array indexes and dereferenced
-- pointers along its field/index chain, as a comma payload. Graph budgets
-- count them as children so a[a[...]] chains stay bounded. "?" marks a
-- malformed chain (an operand that is not an earlier rvalue).
task v4_mir_place_operand_payload(mir_id: int, body_id: int, place_id: int, before: int) -> word {
    pilot out = ""
    pilot place = place_id
    pilot steps = 0
    repeat until place < 0 {
        if place >= v4_mir_body_place_count(mir_id, body_id) or steps > 64 { give back "?" }
        pilot kind = v4_mir_place_kind(mir_id, body_id, place)
        if kind == v4_mir_place_index or kind == v4_mir_place_deref {
            pilot operand = v4_mir_place_index(mir_id, body_id, place)
            if operand >= before { give back "?" }
            if operand >= 0 {
                if out != "" { out = out + "," }
                out = out + word_from_int(operand)
            }
        }
        if kind == v4_mir_place_field or kind == v4_mir_place_index { place = v4_mir_place_base(mir_id, body_id, place) } else { place = 0 - 1 }
        steps += 1
    }
    give back out
}

-- Ordinary facts may use a canonical zero-width anchor; scopes must be nonempty.
task v4_mir_span_fact_is_valid(span: word) -> bool {
    if span == (V4_NO_SPAN) { give back true }
    pilot file = v4_span_file(span)
    if not v4_mir_snapshot_nonnegative_int_is_valid(file) { give back false }
    pilot start = v4_span_start(span)
    pilot end = v4_span_end(span)
    give back start >= 0 and end >= start and v4_span_new(file, start, end) == span
}


-- Snapshot commit retires replaced private arrays. Generation-tagged old
-- handles become stale; immutable Word values and omitted MIR owners survive.
task v4_mir_restore_release_body_raw(mir_id: int, body_id: int) -> void {
    array_release(word_to_int(array_get(v4_mir_blocks_handle(mir_id), body_id)))
    array_set(v4_mir_blocks_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_local_names_index_handle(mir_id), body_id)))
    array_set(v4_mir_local_names_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_local_tys_index_handle(mir_id), body_id)))
    array_set(v4_mir_local_tys_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_local_modes_index_handle(mir_id), body_id)))
    array_release(word_to_int(array_get(v4_mir_local_binding_prefixes_index_handle(mir_id), body_id)))
    array_set(v4_mir_local_modes_index_handle(mir_id), body_id, "-1")
    array_set(v4_mir_local_binding_prefixes_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_local_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_local_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_local_scope_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_local_scope_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_kinds_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_kinds_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_lhs_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_lhs_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_rhs_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_rhs_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_scope_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_scope_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_blocks_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_blocks_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_places_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_places_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_rvalues_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_rvalues_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_kinds_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_kinds_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_texts_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_texts_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_bases_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_bases_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_fields_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_fields_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_indices_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_indices_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_tys_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_tys_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_kinds_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_kinds_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_texts_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_texts_index_handle(mir_id), body_id, "-1")
