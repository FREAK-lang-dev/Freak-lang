}

task v4_mir_rvalue_builtin_method(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if mir_id < 0 or mir_id >= v4_mir_file_count() {
        give back ""
    }
    if body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back ""
    }
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back ""
    }
    give back array_get(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_diag(mir_id: int, diag_id: int) -> word {
    give back array_get(v4_mir_diags_handle(mir_id), diag_id)
}

task v4_mir_add_diag(mir_id: int, diag: word) -> void {
    array_push(v4_mir_diags_handle(mir_id), diag)
}

task v4_mir_add_type_error(mir_id: int, span: word, message: word, help: word) -> void {
    v4_mir_add_diag(mir_id, v4_diag_new(v4_diag_error, span, message, help))
}

task v4_mir_add_type_warning(mir_id: int, span: word, message: word, help: word) -> void {
    v4_mir_add_diag(mir_id, v4_diag_new(v4_diag_warning, span, message, help))
}

task v4_mir_warn_unwinder_call_site(mir_id: int, expr_span: word, sig_id: int) -> void {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_ty_signature_is_warned_unwinder(ty_id, sig_id) == false {
        give back
    }
    pilot effective_name = v4_ty_signature_unwinder_effective_name(ty_id, sig_id)
    pilot help_text = "this call invokes " + effective_name + " which can transfer control past FREAK destructors and the @extern_callback panic-boundary contract; replace it with a C shim that returns a result<T, E> error code, or annotate the extern import with @allow_unwinder if you are intentionally bridging a low-level unwinder."
    v4_mir_add_type_warning(mir_id, expr_span, "call invokes stack-unwinder extern", help_text)
}

task v4_mir_is_callback_boundary_mismatch(mir_id: int, expected_ty: word, actual_ty: word) -> bool {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot expected_surface = v4_ty_canonical_type(ty_id, expected_ty)
    pilot actual_surface = v4_ty_canonical_type(ty_id, actual_ty)
    give back v4_ty_is_surface_extern_function_pointer_type(expected_surface) and v4_ty_is_surface_task_function_type(actual_surface)
}

task v4_mir_add_type_mismatch_error(mir_id: int, span: word, message: word, help: word, context: word, expected_ty: word, actual_ty: word) -> void {
    if v4_mir_is_callback_boundary_mismatch(mir_id, expected_ty, actual_ty) {
        pilot ty_id = v4_mir_ty_id(mir_id)
        pilot expected_surface = v4_ty_canonical_type(ty_id, expected_ty)
        pilot actual_surface = v4_ty_canonical_type(ty_id, actual_ty)
        v4_mir_add_type_error(mir_id, span, "callback value must use extern ABI", context + " expects " + expected_surface + "; " + v4_ty_ffi_boundary_help(v4_mir_ty_id(mir_id), actual_surface, context))
        give back
    }
    v4_mir_add_type_error(mir_id, span, message, help)
}

task v4_mir_normalize_ty_diag(diag: word) -> word {
    if v4_diag_part(diag, 1) != "" or v4_diag_part(diag, 2) != "" or v4_diag_part(diag, 3) != "" {
        give back diag
    }
    give back v4_diag_new(v4_diag_error, V4_NO_SPAN, diag, "00-Unit carried this from freak_ty without a source span")
}

task v4_mir_copy_ty_diags(mir_id: int, ty_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_ty_diag_count(ty_id)
    repeat until diag_idx >= diag_count {
        v4_mir_add_diag(mir_id, v4_mir_normalize_ty_diag(v4_ty_diag(ty_id, diag_idx)))
        diag_idx += 1
    }
}

task v4_mir_block_new_full(block_id: int, terminator: word, target: int, else_target: int, condition: word) -> word {
    give back word_from_int(block_id) + "|" + terminator + "|" + word_from_int(target) + "|" + word_from_int(else_target) + "|" + condition
}

task v4_mir_block_new(block_id: int, terminator: word, target: int) -> word {
    give back v4_mir_block_new_full(block_id, terminator, target, 0 - 1, "")
}

task v4_mir_block_part(block_record: word, wanted: int) -> word {
    pilot part = 0
    pilot start_pos = 0
    pilot i = 0
    repeat until i >= block_record.length() {
        if block_record.char_at(i) == "|" {
            if part == wanted {
                give back v4_slice(block_record, start_pos, i)
            }
            part += 1
            start_pos = i + 1
        }
        i += 1
    }
    if part == wanted {
        give back v4_slice(block_record, start_pos, block_record.length())
    }
    give back ""
}

task v4_mir_block_id(block_record: word) -> int {
    pilot raw = v4_mir_block_part(block_record, 0)
    if raw == "" {
        give back 0
    }
    give back word_to_int(raw)
}

task v4_mir_block_terminator(block_record: word) -> word {
    give back v4_mir_block_part(block_record, 1)
}

task v4_mir_block_target(block_record: word) -> int {
    pilot raw = v4_mir_block_part(block_record, 2)
    if raw == "" {
        give back 0 - 1
    }
    give back word_to_int(raw)
}

task v4_mir_block_else_target(block_record: word) -> int {
    pilot raw = v4_mir_block_part(block_record, 3)
    if raw == "" {
        give back 0 - 1
    }
    give back word_to_int(raw)
}

task v4_mir_block_condition(block_record: word) -> word {
    give back v4_mir_block_part(block_record, 4)
}

task v4_mir_body_block(mir_id: int, body_id: int, block_id: int) -> word {
    give back array_get(v4_mir_body_blocks_handle(mir_id, body_id), block_id)
}

task v4_mir_set_body_block(mir_id: int, body_id: int, block_id: int, block_record: word) -> void {
    array_set(v4_mir_body_blocks_handle(mir_id, body_id), block_id, block_record)
}

task v4_mir_add_block(mir_id: int, body_id: int, terminator: word, target: int, else_target: int, condition: word) -> int {
    pilot block_id = v4_mir_body_block_count(mir_id, body_id)
    array_push(v4_mir_body_blocks_handle(mir_id, body_id), v4_mir_block_new_full(block_id, terminator, target, else_target, condition))
    give back block_id
}

task v4_mir_block_has_return_stmt(mir_id: int, body_id: int, block_id: int) -> bool {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id {
            if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_return {
                give back true
            }
        }
        stmt_id += 1
    }
    give back false
}

task v4_mir_block_has_terminal_stmt(mir_id: int, body_id: int, block_id: int) -> bool {
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id {
            pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
            if stmt_kind == v4_mir_stmt_return or stmt_kind == v4_mir_stmt_break or stmt_kind == v4_mir_stmt_continue {
                give back true
            }
        }
        stmt_id += 1
    }
    give back false
}

task v4_mir_seal_block_goto_if_live(mir_id: int, body_id: int, block_id: int, target: int) -> void {
    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    if v4_mir_block_terminator(block_record) != v4_mir_term_return {
        give back
    }
    if v4_mir_block_has_return_stmt(mir_id, body_id, block_id) {
        v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_return, 0 - 1, 0 - 1, ""))
        give back
    }
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_goto, target, 0 - 1, ""))
}

task v4_mir_block_can_fallthrough_without_return_seen(mir_id: int, body_id: int, block_id: int, seen: int) -> bool {
    if block_id < 0 {
        give back false
    }
    if block_id >= v4_mir_body_block_count(mir_id, body_id) {
        give back false
    }

    repeat until array_len(seen) > block_id {
        array_push(seen, "false")
    }
    pilot visited: word = array_get(seen, block_id)
    if visited == "true" {
        give back false
    }
    array_set(seen, block_id, "true")

    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    pilot terminator = v4_mir_block_terminator(block_record)
    if terminator == v4_mir_term_return {
        give back not v4_mir_block_has_return_stmt(mir_id, body_id, block_id)
    }
    if terminator == v4_mir_term_unreachable {
        give back false
    }
    if terminator == v4_mir_term_goto {
        give back v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, v4_mir_block_target(block_record), seen)
    }
    if terminator == v4_mir_term_if {
        if v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, v4_mir_block_target(block_record), seen) {
            give back true
        }
        give back v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, v4_mir_block_else_target(block_record), seen)
    }
    give back false
}

task v4_mir_body_can_fallthrough_without_return(mir_id: int, body_id: int) -> bool {
    pilot seen = array_new()
    pilot can_fallthrough = v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, 0, seen)
    array_release(seen)
    give back can_fallthrough
}

task v4_mir_validate_body_return_coverage(mir_id: int, body_id: int, item_span: word) -> void {
    pilot expected_ty = v4_mir_expected_return_type(mir_id, body_id)
    if expected_ty == v4_ty_unknown or expected_ty == v4_ty_void {
        give back
    }
    if v4_mir_body_can_fallthrough_without_return(mir_id, body_id) {
        v4_mir_add_type_error(mir_id, item_span, "missing return", v4_mir_body_name(mir_id, body_id) + " must give back " + expected_ty + " on every route")
    }
}

task v4_mir_body_stmt_count_for_block(mir_id: int, body_id: int, block_id: int) -> int {
    pilot total = 0
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id {
            total += 1
        }
        stmt_id += 1
    }
    give back total
}

task v4_mir_body_stmt_kind_count_for_block(mir_id: int, body_id: int, block_id: int, wanted_kind: word) -> int {
    pilot total = 0
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id and v4_mir_stmt_kind(mir_id, body_id, stmt_id) == wanted_kind {
            total += 1
        }
        stmt_id += 1
    }
    give back total
}

task v4_mir_body_block_has_stmt_after_return(mir_id: int, body_id: int, block_id: int) -> bool {
    pilot saw_return = false
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id {
            if saw_return {
                give back true
            }
            if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_return {
                saw_return = true
            }
        }
        stmt_id += 1
    }
    give back false
}

task v4_mir_body_block_predecessor_count(mir_id: int, body_id: int, wanted_block: int) -> int {
    pilot total = 0
    pilot block_id = 0
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    repeat until block_id >= block_count {
        pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
        pilot terminator = v4_mir_block_terminator(block_record)
        if terminator == v4_mir_term_goto {
            if v4_mir_block_target(block_record) == wanted_block {
                total += 1
            }
        } else if terminator == v4_mir_term_if {
            if v4_mir_block_target(block_record) == wanted_block {
                total += 1
            }
            if v4_mir_block_else_target(block_record) == wanted_block {
                total += 1
            }
        }
        block_id += 1
    }
    give back total
}

task v4_mir_block_target_is_valid(mir_id: int, body_id: int, target: int) -> bool {
    give back target >= 0 and target < v4_mir_body_block_count(mir_id, body_id)
}

task v4_mir_validate_body_cfg(mir_id: int, body_id: int, item_span: word) -> void {
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    pilot place_count = v4_mir_body_place_count(mir_id, body_id)
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)

    pilot stmt_id = 0
    repeat until stmt_id >= stmt_count {
        pilot stmt_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
        if stmt_block < 0 or stmt_block >= block_count {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg stmt block out of range", body_name + " statement " + word_from_int(stmt_id) + " points at missing block " + word_from_int(stmt_block))
        }

        pilot stmt_place = v4_mir_stmt_place(mir_id, body_id, stmt_id)
        if stmt_place >= place_count {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg stmt place out of range", body_name + " statement " + word_from_int(stmt_id) + " points at missing place " + word_from_int(stmt_place))
        }

        pilot stmt_rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
        if stmt_rvalue >= rvalue_count {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg stmt rvalue out of range", body_name + " statement " + word_from_int(stmt_id) + " points at missing rvalue " + word_from_int(stmt_rvalue))
        }
        stmt_id += 1
    }

    pilot block_id = 0
    repeat until block_id >= block_count {
        pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
        pilot record_id = v4_mir_block_id(block_record)
        pilot terminator = v4_mir_block_terminator(block_record)
        pilot stmt_in_block = v4_mir_body_stmt_count_for_block(mir_id, body_id, block_id)
        pilot return_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_return)
        pilot branch_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_branch)
        pilot loop_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_loop)
        pilot break_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_break)
        pilot continue_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_continue)

        if record_id != block_id {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg block id drift", body_name + " stores block " + word_from_int(record_id) + " in slot " + word_from_int(block_id))
        }

        if terminator == v4_mir_term_goto {
            if not v4_mir_block_target_is_valid(mir_id, body_id, v4_mir_block_target(block_record)) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg invalid goto target", body_name + " block " + word_from_int(block_id) + " jumps to missing block " + word_from_int(v4_mir_block_target(block_record)))
            }
        } else if terminator == v4_mir_term_if {
            if not v4_mir_block_target_is_valid(mir_id, body_id, v4_mir_block_target(block_record)) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg invalid if target", body_name + " block " + word_from_int(block_id) + " branches to missing block " + word_from_int(v4_mir_block_target(block_record)))
            }
            if not v4_mir_block_target_is_valid(mir_id, body_id, v4_mir_block_else_target(block_record)) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg invalid else target", body_name + " block " + word_from_int(block_id) + " falls through to missing block " + word_from_int(v4_mir_block_else_target(block_record)))
            }
            if branch_count + loop_count == 0 {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg if terminator missing control stmt", body_name + " block " + word_from_int(block_id) + " ends with If but records no branch or loop statement")
            }
        } else if terminator != v4_mir_term_return and terminator != v4_mir_term_unreachable {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg unknown terminator", body_name + " block " + word_from_int(block_id) + " uses unsupported terminator " + terminator)
        }

        if return_count > 0 and terminator != v4_mir_term_return {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg return terminator mismatch", body_name + " block " + word_from_int(block_id) + " contains return value statements but ends with " + terminator)
        }
        if branch_count + loop_count > 0 and terminator != v4_mir_term_if {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg branch terminator mismatch", body_name + " block " + word_from_int(block_id) + " contains branch or loop statements but ends with " + terminator)
        }
        if break_count + continue_count > 0 and terminator != v4_mir_term_goto {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg jump terminator mismatch", body_name + " block " + word_from_int(block_id) + " contains break or continue statements but ends with " + terminator)
        }
        if v4_mir_body_block_has_stmt_after_return(mir_id, body_id, block_id) {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg statement after return", body_name + " block " + word_from_int(block_id) + " keeps lowering statements after a return")
        }

        if block_id != 0 {
            pilot preds = v4_mir_body_block_predecessor_count(mir_id, body_id, block_id)
            if preds == 0 and (stmt_in_block > 0 or terminator == v4_mir_term_goto or terminator == v4_mir_term_if) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg unreachable live block", body_name + " block " + word_from_int(block_id) + " has no predecessors but still carries live statements or control flow")
            }
        }
        block_id += 1
    }
}

task v4_mir_rvalue_can_contain_child_tries(kind: word) -> bool {
    give back kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_call or kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_or_else or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut
}

task v4_mir_rvalue_find_try_except(mir_id: int, body_id: int, rvalue_id: int, wired_tries: word) -> int {
    if rvalue_id < 0 {
        give back 0 - 1
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if not v4_mir_rvalue_can_contain_child_tries(kind) {
        give back 0 - 1
    }

    pilot left = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    pilot right = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
    pilot found = v4_mir_rvalue_find_try_except(mir_id, body_id, left, wired_tries)
    if found >= 0 {
        give back found
    }

    found = v4_mir_rvalue_find_try_except(mir_id, body_id, right, wired_tries)
    if found >= 0 {
        give back found
    }

    if kind == v4_mir_rvalue_try and not v4_mir_name_list_contains(wired_tries, word_from_int(rvalue_id)) {
        give back rvalue_id
    }
    give back 0 - 1
}

task v4_mir_rvalue_find_try(mir_id: int, body_id: int, rvalue_id: int) -> int {
    give back v4_mir_rvalue_find_try_except(mir_id, body_id, rvalue_id, "")
}

task v4_mir_try_condition_op(try_op: word) -> word {
    if try_op == "TryMaybe" {
        give back "HasSome"
    }
    if try_op == "TryResult" {
        give back "IsOk"
    }
    give back ""
}

task v4_mir_add_try_propagation_return(mir_id: int, body_id: int, block_id: int, stmt_span: word, try_rvalue: int) -> void {
    pilot try_op = v4_mir_rvalue_op(mir_id, body_id, try_rvalue)
    pilot source_id = v4_mir_rvalue_lhs(mir_id, body_id, try_rvalue)
    pilot source_text = v4_mir_rvalue_text(mir_id, body_id, source_id)
    pilot return_ty = v4_mir_expected_return_type(mir_id, body_id)
    pilot return_text = "nobody"
    pilot return_rvalue = 0 - 1
    if try_op == "TryMaybe" {
        return_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_nobody, return_text, "Nobody", 0 - 1, 0 - 1, stmt_span, return_ty)
    } else if try_op == "TryResult" {
        return_text = "err(" + source_text + ".err)"
        return_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_err, return_text, "Err", source_id, 0 - 1, stmt_span, return_ty)
    } else {
        give back
    }

    pilot return_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_return, "_return", 0 - 1, "_return", 0 - 1, stmt_span, return_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_return, "_return", return_text, stmt_span, return_place, return_rvalue)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_return, 0 - 1, 0 - 1, ""))
}

task v4_mir_short_circuit_const_text(op: word) -> word {
    if op == v4_mir_bin_and {
        give back "false"
    }
    if op == v4_mir_bin_or {
        give back "true"
    }
    give back ""
}

task v4_mir_wire_single_try_propagation(mir_id: int, body_id: int, block_id: int, stmt_span: word, try_rvalue: int) -> int {
    pilot try_op = v4_mir_rvalue_op(mir_id, body_id, try_rvalue)
    pilot condition_op = v4_mir_try_condition_op(try_op)
    if condition_op == "" {
        give back block_id
    }

    pilot source_id = v4_mir_rvalue_lhs(mir_id, body_id, try_rvalue)
    pilot source_text = v4_mir_rvalue_text(mir_id, body_id, source_id)
    pilot continue_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot propagate_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot cond_text = "try " + source_text + " " + condition_op
    pilot cond_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_check, cond_text, condition_op, source_id, 0 - 1, stmt_span, v4_ty_bool)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_if, continue_block, propagate_block, cond_text))
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_branch, cond_text, "continue#" + word_from_int(continue_block) + " propagate#" + word_from_int(propagate_block), stmt_span, 0 - 1, cond_rvalue)
    v4_mir_add_try_propagation_return(mir_id, body_id, propagate_block, stmt_span, try_rvalue)
    give back continue_block
}

task v4_mir_wire_control_flow_rvalue(mir_id: int, body_id: int, block_id: int, stmt_span: word, rvalue_id: int) -> int {
    if rvalue_id < 0 {
        give back block_id
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_binary {
        pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
        if op == v4_mir_bin_and or op == v4_mir_bin_or {
            pilot left_id = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
            pilot right_id = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
            pilot current_block = v4_mir_wire_control_flow_rvalue(mir_id, body_id, block_id, stmt_span, left_id)
            pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
            pilot temp_name = v4_mir_unique_local_name(mir_id, body_id, "_bool_sc")
            pilot temp_local = v4_mir_add_local(mir_id, body_id, temp_name, result_ty, stmt_span)
            pilot temp_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, temp_name, temp_local, temp_name, 0 - 1, stmt_span, result_ty)
            pilot right_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
            pilot short_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
            pilot join_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
            pilot left_text = v4_mir_rvalue_text(mir_id, body_id, left_id)
            pilot branch_rhs = "eval#" + word_from_int(right_block) + " short#" + word_from_int(short_block)
            pilot true_target = right_block
            pilot false_target = short_block
            if op == v4_mir_bin_or {
                branch_rhs = "short#" + word_from_int(short_block) + " eval#" + word_from_int(right_block)
                true_target = short_block
                false_target = right_block
            }

            v4_mir_set_body_block(mir_id, body_id, current_block, v4_mir_block_new_full(current_block, v4_mir_term_if, true_target, false_target, left_text))
            v4_mir_add_stmt(mir_id, body_id, current_block, v4_mir_stmt_branch, left_text, branch_rhs, stmt_span, 0 - 1, left_id)

            pilot short_text = v4_mir_short_circuit_const_text(op)
            pilot short_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_bool, short_text, "", 0 - 1, 0 - 1, stmt_span, v4_ty_bool)
            v4_mir_add_stmt(mir_id, body_id, short_block, v4_mir_stmt_assign, temp_name, short_text, stmt_span, temp_place, short_rvalue)
            v4_mir_set_body_block(mir_id, body_id, short_block, v4_mir_block_new_full(short_block, v4_mir_term_goto, join_block, 0 - 1, ""))

            pilot right_tail = v4_mir_wire_control_flow_rvalue(mir_id, body_id, right_block, stmt_span, right_id)
            pilot right_text = v4_mir_rvalue_text(mir_id, body_id, right_id)
            v4_mir_add_stmt(mir_id, body_id, right_tail, v4_mir_stmt_assign, temp_name, right_text, stmt_span, temp_place, right_id)
            v4_mir_set_body_block(mir_id, body_id, right_tail, v4_mir_block_new_full(right_tail, v4_mir_term_goto, join_block, 0 - 1, ""))

            v4_mir_restore_rvalue_slot(mir_id, body_id, rvalue_id, v4_mir_rvalue_use_local, temp_name, temp_name, 0 - 1, 0 - 1, v4_mir_rvalue_span(mir_id, body_id, rvalue_id), result_ty, v4_mir_rvalue_abi(mir_id, body_id, rvalue_id), v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), "")
            give back join_block
        }
    }

    pilot current_block = block_id
    if v4_mir_rvalue_can_contain_child_tries(kind) {
        pilot left = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
        pilot right = v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id)
        current_block = v4_mir_wire_control_flow_rvalue(mir_id, body_id, current_block, stmt_span, left)
        current_block = v4_mir_wire_control_flow_rvalue(mir_id, body_id, current_block, stmt_span, right)
    }
    if kind == v4_mir_rvalue_try {
        current_block = v4_mir_wire_single_try_propagation(mir_id, body_id, current_block, stmt_span, rvalue_id)
    }
    give back current_block
}

task v4_mir_wire_try_propagation(mir_id: int, body_id: int, block_id: int, stmt_span: word, rvalue_id: int) -> int {
    give back v4_mir_wire_control_flow_rvalue(mir_id, body_id, block_id, stmt_span, rvalue_id)
}

task v4_mir_find_local(mir_id: int, body_id: int, local_name: word) -> int {
    pilot local_idx = 0
    pilot local_count = v4_mir_body_local_count(mir_id, body_id)
    repeat until local_idx >= local_count {
        if v4_mir_local_name(mir_id, body_id, local_idx) == local_name {
            give back local_idx
        }
        local_idx += 1
    }
    give back 0 - 1
}

task v4_mir_find_local_visible_at(mir_id: int, body_id: int, local_name: word, offset: int) -> int {
    pilot local_idx = v4_mir_body_local_count(mir_id, body_id)
    repeat until local_idx <= 0 {
        local_idx -= 1
        if v4_mir_local_name(mir_id, body_id, local_idx) == local_name and v4_mir_local_visible_at(mir_id, body_id, local_idx, offset) {
            give back local_idx
        }
    }
    give back 0 - 1
}

task v4_mir_set_local_ty(mir_id: int, body_id: int, local_id: int, local_ty: word) -> void {
    if local_id < 0 {
        give back
    }
    array_set(v4_mir_body_local_tys_handle(mir_id, body_id), local_id, local_ty)
}

task v4_mir_set_local_mode(mir_id: int, body_id: int, local_id: int, local_mode: word) -> void {
    if local_id < 0 {
        give back
    }
    if local_mode == "" {
        local_mode = v4_ty_param_mode_value
    }
    array_set(v4_mir_body_local_modes_handle(mir_id, body_id), local_id, local_mode)
}

task v4_mir_local_ty_for_name(mir_id: int, body_id: int, local_name: word) -> word {
    pilot local_id = v4_mir_find_local(mir_id, body_id, local_name)
    if local_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_mir_local_ty(mir_id, body_id, local_id)
}

task v4_mir_local_mode_for_name(mir_id: int, body_id: int, local_name: word) -> word {
    pilot local_id = v4_mir_find_local(mir_id, body_id, local_name)
    if local_id < 0 {
        give back v4_ty_param_mode_value
    }
    give back v4_mir_local_mode(mir_id, body_id, local_id)
}

task v4_mir_local_type_display(mir_id: int, body_id: int, local_id: int) -> word {
    pilot local_ty = v4_mir_local_ty(mir_id, body_id, local_id)
    pilot local_mode = v4_mir_local_mode(mir_id, body_id, local_id)
    if local_mode == v4_ty_param_mode_lend or local_mode == v4_ty_param_mode_lend_mut {
        pilot lifetime_name = ""
        pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
        if sig_id >= 0 {
            pilot ty_id = v4_mir_ty_id(mir_id)
            pilot param_id = v4_ty_signature_param_index_for_name(ty_id, sig_id, v4_mir_local_name(mir_id, body_id, local_id))
            if param_id >= 0 {
                lifetime_name = v4_ty_signature_param_lifetime(ty_id, sig_id, param_id)
            }
        }
        give back v4_ty_lend_type_with_lifetime(local_ty, local_mode, lifetime_name)
    }
    give back local_ty
}

task v4_mir_add_place(mir_id: int, body_id: int, place_kind: word, text: word, base: int, field: word, index: int, span: word, place_ty: word) -> int {
    pilot place_id = array_len(v4_mir_body_place_kinds_handle(mir_id, body_id))
    array_push(v4_mir_body_place_kinds_handle(mir_id, body_id), place_kind)
    array_push(v4_mir_body_place_texts_handle(mir_id, body_id), text)
    array_push(v4_mir_body_place_bases_handle(mir_id, body_id), word_from_int(base))
    array_push(v4_mir_body_place_fields_handle(mir_id, body_id), field)
    array_push(v4_mir_body_place_indices_handle(mir_id, body_id), word_from_int(index))
    array_push(v4_mir_body_place_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_place_tys_handle(mir_id, body_id), place_ty)
    give back place_id
}

task v4_mir_add_rvalue(mir_id: int, body_id: int, rvalue_kind: word, text: word, op: word, lhs: int, rhs: int, span: word, rvalue_ty: word) -> int {
    pilot rvalue_id = array_len(v4_mir_body_rvalue_kinds_handle(mir_id, body_id))
    array_push(v4_mir_body_rvalue_kinds_handle(mir_id, body_id), rvalue_kind)
    array_push(v4_mir_body_rvalue_texts_handle(mir_id, body_id), text)
    array_push(v4_mir_body_rvalue_ops_handle(mir_id, body_id), op)
    array_push(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), word_from_int(lhs))
    array_push(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), word_from_int(rhs))
    array_push(v4_mir_body_rvalue_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_rvalue_tys_handle(mir_id, body_id), rvalue_ty)
    array_push(v4_mir_body_rvalue_abis_handle(mir_id, body_id), "")
    array_push(v4_mir_body_rvalue_args_handle(mir_id, body_id), "")
    array_push(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), "")
    give back rvalue_id
}

task v4_mir_set_rvalue_abi(mir_id: int, body_id: int, rvalue_id: int, abi: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    array_set(v4_mir_body_rvalue_abis_handle(mir_id, body_id), rvalue_id, abi)
}

task v4_mir_set_rvalue_args_payload(mir_id: int, body_id: int, rvalue_id: int, args_payload: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    array_set(v4_mir_body_rvalue_args_handle(mir_id, body_id), rvalue_id, args_payload)
}

task v4_mir_set_rvalue_builtin_method(mir_id: int, body_id: int, rvalue_id: int, builtin_method: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    array_set(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), rvalue_id, builtin_method)
}

task v4_mir_signature_call_abi(mir_id: int, sig_id: int) -> word {
    if sig_id < 0 {
        give back ""
    }
    give back v4_ty_signature_call_abi(v4_mir_ty_id(mir_id), sig_id)
}

task v4_mir_add_local(mir_id: int, body_id: int, local_name: word, local_ty: word, span: word) -> int {
    pilot existing = v4_mir_find_local_visible_at(mir_id, body_id, local_name, v4_span_start(span))
    if existing >= 0 {
        if v4_mir_local_ty(mir_id, body_id, existing) == v4_ty_unknown and local_ty != v4_ty_unknown {
            v4_mir_set_local_ty(mir_id, body_id, existing, local_ty)
        }
        give back existing
    }

    pilot local_id = array_len(v4_mir_body_local_names_handle(mir_id, body_id))
    array_push(v4_mir_body_local_names_handle(mir_id, body_id), local_name)
    array_push(v4_mir_body_local_tys_handle(mir_id, body_id), local_ty)
    array_push(v4_mir_body_local_modes_handle(mir_id, body_id), v4_ty_param_mode_value)
    array_push(v4_mir_body_local_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_local_scope_spans_handle(mir_id, body_id), v4_mir_current_scope_span(span))
    give back local_id
}

task v4_mir_add_stmt(mir_id: int, body_id: int, block_id: int, stmt_kind: word, lhs: word, rhs: word, span: word, place_id: int, rvalue_id: int) -> int {
    pilot stmt_id = array_len(v4_mir_body_stmt_kinds_handle(mir_id, body_id))
    array_push(v4_mir_body_stmt_kinds_handle(mir_id, body_id), stmt_kind)
    array_push(v4_mir_body_stmt_lhs_handle(mir_id, body_id), lhs)
    array_push(v4_mir_body_stmt_rhs_handle(mir_id, body_id), rhs)
    array_push(v4_mir_body_stmt_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_stmt_blocks_handle(mir_id, body_id), word_from_int(block_id))
    array_push(v4_mir_body_stmt_places_handle(mir_id, body_id), word_from_int(place_id))
    array_push(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), word_from_int(rvalue_id))
    give back stmt_id
}

task v4_mir_add_body(mir_id: int, def_id: word, body_name: word, signature: word) -> int {
    pilot body_id = array_len(v4_mir_defs_handle(mir_id))
    pilot blocks_handle = array_new()
    pilot local_names_handle = array_new()
    pilot local_tys_handle = array_new()
    pilot local_modes_handle = array_new()
    pilot local_spans_handle = array_new()
    pilot local_scope_spans_handle = array_new()
    pilot stmt_kinds_handle = array_new()
    pilot stmt_lhs_handle = array_new()
    pilot stmt_rhs_handle = array_new()
    pilot stmt_spans_handle = array_new()
    pilot stmt_blocks_handle = array_new()
    pilot stmt_places_handle = array_new()
    pilot stmt_rvalues_handle = array_new()
    pilot place_kinds_handle = array_new()
    pilot place_texts_handle = array_new()
    pilot place_bases_handle = array_new()
    pilot place_fields_handle = array_new()
    pilot place_indices_handle = array_new()
    pilot place_spans_handle = array_new()
    pilot place_tys_handle = array_new()
    pilot rvalue_kinds_handle = array_new()
    pilot rvalue_texts_handle = array_new()
    pilot rvalue_ops_handle = array_new()
    pilot rvalue_lhs_handle = array_new()
    pilot rvalue_rhs_handle = array_new()
    pilot rvalue_spans_handle = array_new()
    pilot rvalue_tys_handle = array_new()
    pilot rvalue_abis_handle = array_new()
    pilot rvalue_args_handle = array_new()
    pilot rvalue_builtin_methods_handle = array_new()
    array_push(blocks_handle, v4_mir_block_new(0, v4_mir_term_return, 0 - 1))
    array_push(v4_mir_defs_handle(mir_id), def_id)
    array_push(v4_mir_names_handle(mir_id), body_name)
    array_push(v4_mir_sigs_handle(mir_id), signature)
    array_push(v4_mir_blocks_handle(mir_id), word_from_int(blocks_handle))
    array_push(v4_mir_local_names_index_handle(mir_id), word_from_int(local_names_handle))
    array_push(v4_mir_local_tys_index_handle(mir_id), word_from_int(local_tys_handle))
    array_push(v4_mir_local_modes_index_handle(mir_id), word_from_int(local_modes_handle))
    array_push(v4_mir_local_spans_index_handle(mir_id), word_from_int(local_spans_handle))
    array_push(v4_mir_local_scope_spans_index_handle(mir_id), word_from_int(local_scope_spans_handle))
    array_push(v4_mir_stmt_kinds_index_handle(mir_id), word_from_int(stmt_kinds_handle))
    array_push(v4_mir_stmt_lhs_index_handle(mir_id), word_from_int(stmt_lhs_handle))
    array_push(v4_mir_stmt_rhs_index_handle(mir_id), word_from_int(stmt_rhs_handle))
    array_push(v4_mir_stmt_spans_index_handle(mir_id), word_from_int(stmt_spans_handle))
    array_push(v4_mir_stmt_blocks_index_handle(mir_id), word_from_int(stmt_blocks_handle))
    array_push(v4_mir_stmt_places_index_handle(mir_id), word_from_int(stmt_places_handle))
    array_push(v4_mir_stmt_rvalues_index_handle(mir_id), word_from_int(stmt_rvalues_handle))
    array_push(v4_mir_place_kinds_index_handle(mir_id), word_from_int(place_kinds_handle))
    array_push(v4_mir_place_texts_index_handle(mir_id), word_from_int(place_texts_handle))
    array_push(v4_mir_place_bases_index_handle(mir_id), word_from_int(place_bases_handle))
    array_push(v4_mir_place_fields_index_handle(mir_id), word_from_int(place_fields_handle))
    array_push(v4_mir_place_indices_index_handle(mir_id), word_from_int(place_indices_handle))
    array_push(v4_mir_place_spans_index_handle(mir_id), word_from_int(place_spans_handle))
    array_push(v4_mir_place_tys_index_handle(mir_id), word_from_int(place_tys_handle))
    array_push(v4_mir_rvalue_kinds_index_handle(mir_id), word_from_int(rvalue_kinds_handle))
    array_push(v4_mir_rvalue_texts_index_handle(mir_id), word_from_int(rvalue_texts_handle))
    array_push(v4_mir_rvalue_ops_index_handle(mir_id), word_from_int(rvalue_ops_handle))
    array_push(v4_mir_rvalue_lhs_index_handle(mir_id), word_from_int(rvalue_lhs_handle))
    array_push(v4_mir_rvalue_rhs_index_handle(mir_id), word_from_int(rvalue_rhs_handle))
    array_push(v4_mir_rvalue_spans_index_handle(mir_id), word_from_int(rvalue_spans_handle))
    array_push(v4_mir_rvalue_tys_index_handle(mir_id), word_from_int(rvalue_tys_handle))
    array_push(v4_mir_rvalue_abis_index_handle(mir_id), word_from_int(rvalue_abis_handle))
    array_push(v4_mir_rvalue_args_index_handle(mir_id), word_from_int(rvalue_args_handle))
    array_push(v4_mir_rvalue_builtin_methods_index_handle(mir_id), word_from_int(rvalue_builtin_methods_handle))
    give back body_id
}

task v4_mir_skip_trivia(stream_id: int, token_id: int) -> int {
    pilot idx = token_id
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count or v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
        idx += 1
    }
    give back idx
}

task v4_mir_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot idx = 0
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count {
        pilot token_span = v4_lex_token_span(stream_id, idx)
        if v4_span_start(token_span) >= offset {
            give back idx
        }
        idx += 1
    }
    give back count
}

task v4_mir_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot count = v4_lex_token_count(stream_id)
    if count == 0 {
        give back V4_NO_SPAN
    }

    pilot first = start_token
    if first < 0 { first = 0 }
    if first >= count { first = count - 1 }

    pilot last = end_token - 1
    if last < first { last = first }
    if last >= count { last = count - 1 }

    pilot first_span = v4_lex_token_span(stream_id, first)
    pilot last_span = v4_lex_token_span(stream_id, last)
    give back v4_span_new(v4_span_file(first_span), v4_span_start(first_span), v4_span_end(last_span))
}

task v4_mir_find_token_value(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if v4_lex_token_value(stream_id, idx) == wanted {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_find_body_token(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" or val == "=>" {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_find_matching_brace(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" {
                depth += 1
            } else if val == "}" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back end_token
}

task v4_mir_find_matching_paren(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "(" {
                depth += 1
            } else if val == ")" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_find_open_paren_token(stream_id: int, start_token: int, close_token: int) -> int {
    pilot idx = close_token
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == ")" {
                depth += 1
            } else if val == "(" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_find_open_brace_token(stream_id: int, start_token: int, close_token: int) -> int {
    pilot idx = close_token
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "}" {
                depth += 1
            } else if val == "{" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_name_list_range_equals(names: word, start_idx: int, end_idx: int, wanted: word) -> bool {
    if end_idx - start_idx != wanted.length() {
        give back false
    }

    pilot offset = 0
    repeat until start_idx + offset >= end_idx {
        if names.char_at(start_idx + offset) != wanted.char_at(offset) {
            give back false
        }
        offset += 1
    }
    give back true
}

task v4_mir_name_list_contains(names: word, wanted: word) -> bool {
    if names == "" or wanted == "" {
        give back false
    }

    pilot segment_start = 0
    pilot idx = 0
    repeat until idx >= names.length() {
        if names.char_at(idx) == "|" {
            if v4_mir_name_list_range_equals(names, segment_start, idx, wanted) {
                give back true
            }
            segment_start = idx + 1
        }
        idx += 1
    }
    give back v4_mir_name_list_range_equals(names, segment_start, names.length(), wanted)
}

task v4_mir_name_list_add(names: word, wanted: word) -> word {
    if wanted == "" {
        give back names
    }
    if v4_mir_name_list_contains(names, wanted) {
        give back names
    }
    if names == "" {
        give back wanted
    }
    give back names + "|" + wanted
}

task v4_mir_statement_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)

        if tok_type != v4_tok_trivia {
            if val == "(" or val == "[" or val == "{" {
                depth += 1
            } else if val == ")" or val == "]" {
                if depth > 0 { depth -= 1 }
            } else if val == "}" {
                if depth == 0 {
                    give back idx
                }
                depth -= 1
            } else if val == ";" {
                if depth == 0 {
                    give back idx
                }
            }
        } else if val == "\n" {
            if depth == 0 {
                give back idx
            }
        }
        idx += 1
    }
    give back end_token
}

task v4_mir_expr_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if out != "" {
                out = out + " "
            }
            out = out + v4_lex_token_value(stream_id, idx)
        }
        idx += 1
    }
    give back out
}

task v4_mir_last_nontrivia_before(stream_id: int, end_token: int) -> int {
    pilot idx = end_token - 1
    repeat until idx < 0 {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_next_nontrivia(stream_id: int, token_id: int, end_token: int) -> int {
    pilot idx = token_id
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx += 1
    }
    give back end_token
}

task v4_mir_prev_nontrivia(stream_id: int, token_id: int, start_token: int) -> int {
    pilot idx = token_id
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back start_token - 1
}

task v4_mir_token_can_end_expr(stream_id: int, token_id: int) -> bool {
    pilot tok_type = v4_lex_token_type(stream_id, token_id)
    pilot val = v4_lex_token_value(stream_id, token_id)
    if tok_type == v4_tok_ident or tok_type == v4_tok_int or tok_type == v4_tok_float or tok_type == v4_tok_string or tok_type == v4_tok_bool or tok_type == v4_tok_char {
        give back true
    }
    if val == "?" or val == "nobody" {
        give back true
    }
    give back val == ")" or val == "]"
}

task v4_mir_binary_candidate_has_left_operand(stream_id: int, start_token: int, op_token: int) -> bool {
    pilot prev = v4_mir_prev_nontrivia(stream_id, op_token - 1, start_token)
    if prev < start_token {
        give back false
    }
    give back v4_mir_token_can_end_expr(stream_id, prev)
}

task v4_mir_generic_method_type_arg_open_for_close(stream_id: int, start_token: int, close_token: int, end_token: int) -> int {
    pilot idx = close_token
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == ">" {
                depth += 1
            } else if val == "<" {
                depth -= 1
                if depth == 0 {
                    pilot method_token = v4_mir_prev_nontrivia(stream_id, idx - 1, start_token)
                    pilot separator_token = v4_mir_prev_nontrivia(stream_id, method_token - 1, start_token)
                    if method_token >= start_token and separator_token >= start_token {
                        pilot separator = v4_lex_token_value(stream_id, separator_token)
                        pilot method_tok_type = v4_lex_token_type(stream_id, method_token)
                        if (separator == "." or separator == "::") and (method_tok_type == v4_tok_ident or method_tok_type == v4_tok_keyword) {
                            give back idx
                        }
                    }
                    give back 0 - 1
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_binary_tier_matches(op: word, tier: int) -> bool {
    if tier == 1 {
        give back op == "or"
    }
    if tier == 2 {
        give back op == "and"
    }
    if tier == 3 {
        give back op == "==" or op == "!=" or op == ">" or op == "<" or op == ">=" or op == "<="
    }
    if tier == 4 {
        give back op == "+" or op == "-"
    }
    if tier == 5 {
        give back op == "*" or op == "/" or op == "%"
    }
    give back false
}

task v4_mir_find_binary_op(stream_id: int, start_token: int, end_token: int, tier: int) -> int {
    pilot idx = end_token - 1
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == ")" or val == "]" or val == "}" {
                depth += 1
            } else if val == "(" or val == "[" or val == "{" {
                if depth > 0 {
                    depth -= 1
                }
            } else if depth == 0 and val == ">" {
                pilot type_open = v4_mir_generic_method_type_arg_open_for_close(stream_id, start_token, idx, end_token)
                if type_open >= start_token {
                    idx = type_open
                } else if v4_mir_binary_tier_matches(val, tier) and v4_mir_binary_candidate_has_left_operand(stream_id, start_token, idx) {
                    give back idx
                }
            } else if depth == 0 and v4_mir_binary_tier_matches(val, tier) and v4_mir_binary_candidate_has_left_operand(stream_id, start_token, idx) {
                give back idx
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_has_top_level_binary_op(stream_id: int, start_token: int, end_token: int) -> bool {
    pilot tier = 1
    repeat until tier > 5 {
        if v4_mir_find_binary_op(stream_id, start_token, end_token, tier) >= start_token {
            give back true
        }
        tier += 1
    }
    give back false
}

task v4_mir_is_generic_instance_method_call_shape(stream_id: int, first: int, last: int) -> bool {
    if v4_lex_token_value(stream_id, last) != ")" {
        give back false
    }
    pilot open_token = v4_mir_find_open_paren_token(stream_id, first, last)
    if open_token <= first or open_token > last {
        give back false
    }
    pilot dot_token = v4_mir_find_top_level_token(stream_id, first, open_token, ".")
    if dot_token <= first {
        give back false
    }
    if v4_mir_has_top_level_binary_op(stream_id, first, dot_token) {
        give back false
    }
    pilot method_token = v4_mir_skip_trivia(stream_id, dot_token + 1)
    if method_token >= open_token {
        give back false
    }
    pilot type_open = v4_mir_skip_trivia(stream_id, method_token + 1)
    give back type_open < open_token and v4_lex_token_value(stream_id, type_open) == "<"
}

task v4_mir_find_or_else_op(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = end_token - 1
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == ")" or val == "]" or val == "}" {
                depth += 1
            } else if val == "(" or val == "[" or val == "{" {
                if depth > 0 {
                    depth -= 1
                }
            } else if depth == 0 and val == "else" {
                pilot maybe_or = v4_mir_prev_nontrivia(stream_id, idx - 1, start_token)
                if maybe_or >= start_token and v4_lex_token_value(stream_id, maybe_or) == "or" and v4_mir_binary_candidate_has_left_operand(stream_id, start_token, maybe_or) {
                    give back maybe_or
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_operator_kind(op: word) -> word {
    if op == "+" { give back v4_mir_bin_add }
    if op == "-" { give back v4_mir_bin_sub }
    if op == "*" { give back v4_mir_bin_mul }
    if op == "/" { give back v4_mir_bin_div }
    if op == "%" { give back v4_mir_bin_mod }
    if op == ">" { give back v4_mir_bin_gt }
    if op == "<" { give back v4_mir_bin_lt }
    if op == ">=" { give back v4_mir_bin_ge }
    if op == "<=" { give back v4_mir_bin_le }
    if op == "==" { give back v4_mir_bin_eq }
    if op == "!=" { give back v4_mir_bin_ne }
    if op == "and" { give back v4_mir_bin_and }
    if op == "or" { give back v4_mir_bin_or }
    give back op
}

task v4_mir_unary_op_kind(op: word) -> word {
    if op == "-" { give back v4_mir_unary_neg }
    if op == "not" or op == "!" { give back v4_mir_unary_not }
    if op == "*" { give back v4_mir_unary_deref }
    give back ""
}

task v4_mir_check_binary_types(mir_id: int, expr_span: word, op_kind: word, left_ty: word, right_ty: word) -> void {
    if v4_ty_binary_valid(op_kind, left_ty, right_ty) {
        give back
    }
    if not v4_ty_is_known(left_ty) or not v4_ty_is_known(right_ty) {
        give back
    }

    pilot method_ref = v4_mir_binary_operator_overload_ref(mir_id, left_ty, op_kind)
    if method_ref != "" {
        pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
        pilot method_id = v4_mir_method_ref_method_id(method_ref)
        if v4_ty_impl_method_explicit_param_count(v4_mir_ty_id(mir_id), hir_item, method_id) == 1 {
            pilot expected_ty = v4_ty_impl_method_explicit_param_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, 0, left_ty)
            if not v4_ty_types_compatible(expected_ty, right_ty) {
                pilot method_name = v4_ty_impl_method_name(v4_mir_ty_id(mir_id), hir_item, method_id)
                v4_mir_add_type_error(mir_id, expr_span, "operator overload argument drift", left_ty + "." + method_name + " expects " + expected_ty + " but got " + right_ty)
                give back
            }
            give back
        }
    }
    v4_mir_add_type_error(mir_id, expr_span, "invalid binary operation", v4_mir_operator_display(op_kind) + " between " + left_ty + " and " + right_ty)
}

task v4_mir_check_unary_type(mir_id: int, expr_span: word, op_kind: word, operand_ty: word) -> void {
    if op_kind == v4_mir_unary_deref {
        if v4_ty_is_known(operand_ty) and v4_ty_is_raw_pointer_type(operand_ty) == false {
            v4_mir_add_type_error(mir_id, expr_span, "raw-pointer deref needs *T or *mut T", "got " + operand_ty + "; only raw pointers can be dereferenced with *")
            give back
        }
        if v4_mir_inside_trust_me() == false {
            v4_mir_add_type_error(mir_id, expr_span, "raw-pointer deref needs trust me block", "wrap the deref in a trust me block; bible section 16.4 forbids dereferencing raw pointers outside trust me")
        } else {
            v4_mir_check_trust_honor(mir_id, expr_span, "raw-pointer deref", "cadet")
        }
        give back
    }
    if v4_ty_unary_valid(op_kind, operand_ty) {
        give back
    }
    if not v4_ty_is_known(operand_ty) {
        give back
    }
    if v4_mir_unary_operator_overload_ref(mir_id, operand_ty, op_kind) != "" {
        give back
    }
    v4_mir_add_type_error(mir_id, expr_span, "invalid unary operation", v4_mir_operator_display(op_kind) + " on " + operand_ty)
}

task v4_mir_check_condition_type(mir_id: int, expr_span: word, context: word, condition_ty: word) -> void {
    if v4_ty_is_known(condition_ty) and condition_ty != v4_ty_bool {
        v4_mir_add_type_error(mir_id, expr_span, context + " condition must be bool", "got " + condition_ty)
    }
}

task v4_mir_assignment_target_context(mir_id: int, body_id: int, place_id: int) -> word {
    if place_id < 0 {
        give back ""
    }

    pilot place_kind = v4_mir_place_kind(mir_id, body_id, place_id)
    if place_kind == v4_mir_place_field {
        pilot field_name = v4_mir_place_field(mir_id, body_id, place_id)
        pilot base_place = v4_mir_place_base(mir_id, body_id, place_id)
        pilot base_ty = ""
        if base_place >= 0 {
            base_ty = v4_mir_place_ty(mir_id, body_id, base_place)
        }
        if base_ty != "" {
            give back field_name + " on " + base_ty
        }
        give back field_name
    }

    if place_kind == v4_mir_place_index {
        pilot base_place = v4_mir_place_base(mir_id, body_id, place_id)
        if base_place >= 0 {
            pilot base_ty = v4_mir_place_ty(mir_id, body_id, base_place)
            if base_ty != "" {
                give back "element of " + base_ty
            }
        }
        give back "indexed element"
    }

    give back v4_mir_place_text(mir_id, body_id, place_id)
}

task v4_mir_types_compatible(mir_id: int, body_id: int, expected_ty: word, actual_ty: word) -> bool {
    give back v4_ty_types_compatible_with_context(v4_mir_ty_id(mir_id), v4_mir_body_signature_id(mir_id, body_id), expected_ty, actual_ty)
}

task v4_mir_check_assignment_types(mir_id: int, body_id: int, stmt_span: word, place_id: int, place_ty: word, value_ty: word) -> void {
    if not v4_mir_types_compatible(mir_id, body_id, place_ty, value_ty) {
        pilot place_kind = v4_mir_place_unknown
        if place_id >= 0 {
            place_kind = v4_mir_place_kind(mir_id, body_id, place_id)
        }
        pilot target = v4_mir_assignment_target_context(mir_id, body_id, place_id)
        if place_kind == v4_mir_place_field {
            v4_mir_add_type_mismatch_error(mir_id, stmt_span, "field write type mismatch", target + " expects " + place_ty + " but got " + value_ty, target, place_ty, value_ty)
        } else if place_kind == v4_mir_place_index {
            v4_mir_add_type_mismatch_error(mir_id, stmt_span, "indexed write type mismatch", target + " expects " + place_ty + " but got " + value_ty, target, place_ty, value_ty)
        } else {
            v4_mir_add_type_mismatch_error(mir_id, stmt_span, "assignment type mismatch", "cannot assign " + value_ty + " into " + place_ty, target, place_ty, value_ty)
        }
    }
}

task v4_mir_compound_assignment_op_kind(op: word) -> word {
    if op == "+=" { give back v4_mir_bin_add }
    if op == "-=" { give back v4_mir_bin_sub }
    if op == "*=" { give back v4_mir_bin_mul }
    if op == "/=" { give back v4_mir_bin_div }
    if op == "%=" { give back v4_mir_bin_mod }
    give back ""
}

task v4_mir_compound_assignment_expr_op(op: word) -> word {
    if op == "+=" { give back "+" }
    if op == "-=" { give back "-" }
    if op == "*=" { give back "*" }
    if op == "/=" { give back "/" }
    if op == "%=" { give back "%" }
    give back op
}

task v4_mir_compound_assignment_result_ty(mir_id: int, stmt_span: word, op: word, place_ty: word, value_ty: word) -> word {
    pilot op_kind = v4_mir_compound_assignment_op_kind(op)
    if op_kind == "" {
        give back value_ty
    }

    if not v4_ty_is_known(place_ty) or not v4_ty_is_known(value_ty) {
        give back v4_ty_unknown
    }

    v4_mir_check_binary_types(mir_id, stmt_span, op_kind, place_ty, value_ty)
    give back v4_mir_binary_result_type(mir_id, op_kind, place_ty, value_ty)
}

task v4_mir_place_read_rvalue(mir_id: int, body_id: int, place_id: int, span: word) -> int {
    if place_id < 0 {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, "", "", 0 - 1, 0 - 1, span, v4_ty_unknown)
    }

    pilot place_kind = v4_mir_place_kind(mir_id, body_id, place_id)
    pilot place_text = v4_mir_place_text(mir_id, body_id, place_id)
    pilot place_ty = v4_mir_place_ty(mir_id, body_id, place_id)
    if place_kind == v4_mir_place_local {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_local, place_text, place_text, 0 - 1, 0 - 1, span, place_ty)
    }
    if place_kind == v4_mir_place_field or place_kind == v4_mir_place_index {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_place, place_text, place_text, place_id, 0 - 1, span, place_ty)
    }
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, place_text, "", 0 - 1, 0 - 1, span, v4_ty_unknown)
}

task v4_mir_check_local_decl_type(mir_id: int, body_id: int, stmt_span: word, local_name: word, declared_ty: word, inferred_ty: word) -> void {
    if not v4_mir_types_compatible(mir_id, body_id, declared_ty, inferred_ty) {
        v4_mir_add_type_mismatch_error(mir_id, stmt_span, "local declaration type mismatch", local_name + " expects " + declared_ty + " but got " + inferred_ty, local_name, declared_ty, inferred_ty)
    }
}

task v4_mir_type_contract_accepts_lifetime(mir_id: int, sig_id: int, lifetime_name: word) -> bool {
    if v4_ty_lifetime_is_implicit(lifetime_name) {
        give back true
    }
    if sig_id < 0 {
        give back false
    }
    give back v4_ty_signature_accepts_lifetime(v4_mir_ty_id(mir_id), sig_id, lifetime_name)
}

task v4_mir_validate_type_contract(mir_id: int, sig_id: int, stmt_span: word, type_text: word, message: word, context: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back true
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot valid = true
    if v4_ty_is_lifetime_name(type_text) {
        v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: " + type_text + " cannot be used as a value type in " + context)
        valid = false
    }

    pilot lifetime_id = 0
    pilot lifetime_count = v4_ty_type_lifetime_count(type_text)
    repeat until lifetime_id >= lifetime_count {
        pilot lifetime_name = v4_ty_type_lifetime_name(type_text, lifetime_id)
        if not v4_mir_type_contract_accepts_lifetime(mir_id, sig_id, lifetime_name) {
            pilot scope_name = "this scope"
            if sig_id >= 0 {
                scope_name = v4_ty_signature_name(ty_id, sig_id)
            }
            v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: " + lifetime_name + " is used in " + context + " but is not declared on " + scope_name)
            valid = false
        }
        lifetime_id += 1
    }

    if v4_ty_is_dyn_type(type_text) {
        pilot doctrine_type = v4_ty_dyn_doctrine_name(type_text)
        pilot doctrine_name = v4_ty_dyn_doctrine_base_name(type_text)
        if doctrine_name == "" or v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name) < 0 {
            v4_mir_add_type_error(mir_id, stmt_span, message, "dyn " + doctrine_name + " needs a declared doctrine before Yuuko can build a vtable in " + context)
            valid = false
        } else {
            pilot dyn_issue = v4_ty_dyn_object_safety_issue(ty_id, type_text)
            if dyn_issue != "" {
                v4_mir_add_type_error(mir_id, stmt_span, message, "dyn doctrine is not object safe: " + dyn_issue)
                valid = false
            }
            pilot expected_count = v4_ty_expected_generic_arg_count(ty_id, doctrine_name)
            pilot actual_count = 0
            if v4_ty_is_generic_instance_type(doctrine_type) {
                actual_count = v4_ty_generic_arg_count(doctrine_type)
            }
            if expected_count >= 0 and expected_count != actual_count {
                v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: " + doctrine_name + " expects " + word_from_int(expected_count) + " generic arguments in dyn doctrine of " + context + " but received " + word_from_int(actual_count))
                valid = false
            }
        }
        if not v4_mir_validate_type_contract(mir_id, sig_id, stmt_span, doctrine_type, message, "dyn doctrine of " + context) {
            valid = false
        }
        give back valid
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        pilot actual_count = v4_ty_generic_arg_count(type_text)
        pilot expected_count = v4_ty_expected_generic_arg_count(ty_id, base_name)
        if expected_count >= 0 and expected_count != actual_count {
            v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: " + base_name + " expects " + word_from_int(expected_count) + " generic arguments in " + context + " but received " + word_from_int(actual_count))
            valid = false
        }

        pilot arg_id = 0
        repeat until arg_id >= actual_count {
            pilot arg_text = v4_ty_generic_arg(type_text, arg_id)
            if v4_ty_generic_slot_accepts_lifetime(ty_id, base_name, arg_id) {
                if not v4_ty_is_lifetime_name(arg_text) {
                    v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context + " must be a lifetime like 'a")
                    valid = false
                }
            } else if v4_ty_generic_slot_accepts_type(ty_id, base_name, arg_id) {
                if v4_ty_is_lifetime_name(arg_text) {
                    v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: " + arg_text + " cannot be used as a value type in generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context)
                    valid = false
                } else {
                    if not v4_mir_validate_type_contract(mir_id, sig_id, stmt_span, arg_text, message, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context) {
                        valid = false
                    }
                }
            } else {
                if not v4_mir_validate_type_contract(mir_id, sig_id, stmt_span, arg_text, message, "generic argument " + word_from_int(arg_id) + " of " + base_name + " in " + context) {
                    valid = false
                }
            }
            arg_id += 1
        }
        give back valid
    }

    pilot bare_is_scope_generic = false
    if sig_id >= 0 {
        bare_is_scope_generic = v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text)
    }
    if not bare_is_scope_generic {
        pilot bare_expected_count = v4_ty_expected_generic_arg_count(ty_id, type_text)
        if bare_expected_count > 0 {
            v4_mir_add_type_error(mir_id, stmt_span, message, "Meiya lifetime debt: " + type_text + " expects " + word_from_int(bare_expected_count) + " generic arguments in " + context + " but received 0")
            valid = false
        }
    }

    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if not v4_mir_validate_type_contract(mir_id, sig_id, stmt_span, v4_ty_tuple_slot_type(type_text, slot_id), message, "tuple slot " + word_from_int(slot_id) + " of " + context) {
                valid = false
            }
            slot_id += 1
        }
        give back valid
    }

    if v4_ty_is_fixed_array_type(type_text) {
        if not v4_mir_validate_type_contract(mir_id, sig_id, stmt_span, v4_ty_fixed_array_element_type(type_text), message, "array element of " + context) {
            valid = false
        }
        pilot length_text = v4_ty_fixed_array_length_text(type_text)
        pilot resolved_length = v4_ty_const_integer_text_from_expr(v4_mir_ty_id(mir_id), length_text)
        if resolved_length == v4_ty_unknown {
            pilot const_ty = v4_ty_const_value_type_for_name(v4_mir_ty_id(mir_id), v4_ty_strip_const_expr_wrappers(length_text))
            if const_ty != v4_ty_unknown and not v4_ty_is_integer(const_ty) {
                v4_mir_add_type_error(mir_id, stmt_span, message, "array length of " + context + " must use int or uint constant, but " + v4_ty_strip_const_expr_wrappers(length_text) + " has type " + const_ty)
            } else {
                v4_mir_add_type_error(mir_id, stmt_span, message, "array length of " + context + " must be compile-time constant")
            }
            valid = false
        } else if resolved_length.char_at(0) == "-" {
            v4_mir_add_type_error(mir_id, stmt_span, message, "array length of " + context + " must be non-negative")
            valid = false
        }
    }
    give back valid
}

task v4_mir_signature_id_for_exact_name(mir_id: int, callee_name: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        if v4_ty_signature_name(ty_id, sig_idx) == callee_name {
            pilot sig_kind = v4_ty_signature_kind(ty_id, sig_idx)
            if sig_kind == v4_ty_task_sig or sig_kind == v4_ty_extern_sig {
                give back sig_idx
            }
        }
        sig_idx += 1
    }
    give back 0 - 1
}

task v4_mir_resolved_callee_name(mir_id: int, callee_name: word) -> word {
    if v4_mir_signature_id_for_exact_name(mir_id, callee_name) >= 0 {
        give back callee_name
    }
    pilot resolve_id = v4_ty_resolve_id(v4_mir_ty_id(mir_id))
    if v4_resolve_exists(resolve_id) == false {
        give back callee_name
    }
    pilot expanded = v4_resolve_expand_import_name(resolve_id, callee_name)
    if expanded != "" {
        give back expanded
    }
    give back callee_name
}

task v4_mir_signature_id_for_name(mir_id: int, callee_name: word) -> int {
    pilot sig_id = v4_mir_signature_id_for_exact_name(mir_id, callee_name)
    if sig_id >= 0 {
        give back sig_id
    }
    give back v4_mir_signature_id_for_exact_name(mir_id, v4_mir_resolved_callee_name(mir_id, callee_name))
}

task v4_mir_signature_return_type_for_id(mir_id: int, sig_id: int) -> word {
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_signature_return_type(v4_mir_ty_id(mir_id), sig_id)
}

task v4_mir_signature_return_type_for_name(mir_id: int, callee_name: word) -> word {
    pilot sig_id = v4_mir_signature_id_for_name(mir_id, callee_name)
    if sig_id >= 0 {
        give back v4_mir_signature_return_type_for_id(mir_id, sig_id)
    }
    give back v4_ty_unknown
}

task v4_mir_call_result_type(return_ty: word) -> word {
    if v4_ty_is_lend_type(return_ty) and v4_ty_lend_lifetime(return_ty) != "" {
        give back v4_ty_lend_type(v4_ty_lend_target_type(return_ty), v4_ty_lend_mode(return_ty))
    }
    give back return_ty
}

task v4_mir_symbol_value_type(mir_id: int, symbol_name: word) -> word {
    if symbol_name == "" {
        give back v4_ty_unknown
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    if v4_resolve_exists(resolve_id) == false {
        give back v4_ty_unknown
    }
    pilot symbol_id = v4_resolve_lookup_any(resolve_id, symbol_name)
    if symbol_id < 0 {
        give back v4_ty_unknown
    }
    pilot symbol_kind = v4_resolve_symbol_kind(resolve_id, symbol_id)
    if symbol_kind != v4_hir_const and symbol_kind != v4_hir_task {
        give back v4_ty_unknown
    }
    pilot sig_id = v4_ty_lookup_signature(ty_id, v4_resolve_symbol_def(resolve_id, symbol_id))
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    if symbol_kind == v4_hir_task {
        pilot callback_ty = v4_ty_task_callback_value_type(ty_id, sig_id)
        if callback_ty != v4_ty_unknown {
            give back callback_ty
        }
        give back v4_ty_signature_function_value_type(ty_id, sig_id)
    }
    give back v4_ty_const_value_type_for_sig(ty_id, sig_id)
}

task v4_mir_expected_return_type(mir_id: int, body_id: int) -> word {
    pilot sig_id = v4_ty_lookup_signature(v4_mir_ty_id(mir_id), v4_mir_body_def(mir_id, body_id))
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_signature_return_type(v4_mir_ty_id(mir_id), sig_id)
}

task v4_mir_body_signature_id(mir_id: int, body_id: int) -> int {
    give back v4_ty_lookup_signature(v4_mir_ty_id(mir_id), v4_mir_body_def(mir_id, body_id))
}

task v4_mir_check_return_type(mir_id: int, body_id: int, stmt_span: word, actual_ty: word) -> void {
    pilot expected_ty = v4_mir_expected_return_type(mir_id, body_id)
    if not v4_mir_types_compatible(mir_id, body_id, expected_ty, actual_ty) {
        pilot context = v4_mir_body_name(mir_id, body_id) + " return"
        v4_mir_add_type_mismatch_error(mir_id, stmt_span, "return type mismatch", v4_mir_body_name(mir_id, body_id) + " expects " + expected_ty + " but got " + actual_ty, context, expected_ty, actual_ty)
    }
}

task v4_mir_coerced_value_type(mir_id: int, body_id: int, expected_ty: word, actual_ty: word) -> word {
    if v4_ty_type_contains_dyn(expected_ty) and v4_mir_types_compatible(mir_id, body_id, expected_ty, actual_ty) {
        give back expected_ty
    }
    give back actual_ty
}

task v4_mir_depth_after_token(depth: int, val: word) -> int {
    pilot next_depth = depth
    if val == "(" or val == "[" or val == "{" or val == "<" {
        next_depth += 1
    } else if val == ")" or val == "]" or val == "}" or val == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_mir_call_arg_count(stream_id: int, open_token: int, close_token: int) -> int {
    if open_token < 0 or close_token <= open_token {
        give back 0
    }
    pilot first = v4_mir_skip_trivia(stream_id, open_token + 1)
    if first >= close_token {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                count += 1
            } else {
                depth = v4_mir_depth_after_token(depth, val)
            }
        }
        idx += 1
    }
    give back count
}

task v4_mir_call_arg_end(stream_id: int, start_token: int, close_token: int) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_mir_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_mir_call_arg_named_colon(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = v4_mir_skip_trivia(stream_id, start_token)
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == ":" {
                give back idx
            }
            depth = v4_mir_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_call_arg_label(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_mir_skip_trivia(stream_id, start_token)
    pilot colon = v4_mir_call_arg_named_colon(stream_id, start_token, end_token)
    if first >= end_token or colon <= first or colon >= end_token {
        give back ""
    }

    pilot tok_type = v4_lex_token_type(stream_id, first)
    if tok_type != v4_tok_ident and tok_type != v4_tok_keyword {
        give back ""
    }

    pilot idx = first + 1
    repeat until idx >= colon {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back ""
        }
        idx += 1
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_mir_call_arg_value_start(stream_id: int, start_token: int, end_token: int) -> int {
    pilot colon = v4_mir_call_arg_named_colon(stream_id, start_token, end_token)
    if colon < 0 {
        give back v4_mir_skip_trivia(stream_id, start_token)
    }
    give back v4_mir_skip_trivia(stream_id, colon + 1)
}

task v4_mir_call_arg_segment(start_token: int, end_token: int) -> word {
    give back word_from_int(start_token) + "|" + word_from_int(end_token)
}

task v4_mir_call_arg_segment_pipe(segment: word) -> int {
    pilot idx = 0
    repeat until idx >= segment.length() {
        if segment.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_call_arg_segment_start(segment: word) -> int {
    pilot pipe = v4_mir_call_arg_segment_pipe(segment)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(segment.substring(0, pipe))
}

task v4_mir_call_arg_segment_end(segment: word) -> int {
    pilot pipe = v4_mir_call_arg_segment_pipe(segment)
    if pipe < 0 or pipe + 1 >= segment.length() {
        give back 0 - 1
    }
    give back word_to_int(segment.substring(pipe + 1, segment.length()))
}

task v4_mir_call_arg_segment_payload_append(payload: word, start_token: int, end_token: int) -> word {
    pilot segment = v4_mir_call_arg_segment(start_token, end_token)
    if payload == "" {
        give back segment
    }
    give back payload + "\n" + segment
}

task v4_mir_call_arg_segment_payload_count(payload: word) -> int {
    if payload == "" {
        give back 0
    }
    pilot count = 1
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "\n" {
            count += 1
        }
        idx += 1
    }
    give back count
}

task v4_mir_call_arg_segment_payload_at(payload: word, wanted: int) -> word {
    if payload == "" or wanted < 0 {
        give back ""
    }
    pilot idx = 0
    pilot start_pos = 0
    pilot current = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "\n" {
            if current == wanted {
                give back v4_slice(payload, start_pos, idx)
            }
            current += 1
            start_pos = idx + 1
        }
        idx += 1
    }
    if current == wanted and start_pos < payload.length() {
        give back v4_slice(payload, start_pos, payload.length())
    }
    give back ""
}

task v4_mir_call_arg_slot_payload_new(slot_count: int) -> word {
    pilot payload = ""
    pilot idx = 0
    repeat until idx >= slot_count {
        payload = v4_mir_call_arg_segment_payload_append(payload, 0 - 1, 0 - 1)
        idx += 1
    }
    give back payload
}

task v4_mir_call_arg_slot_assigned(payload: word, slot_id: int) -> bool {
    pilot segment = v4_mir_call_arg_segment_payload_at(payload, slot_id)
    give back v4_mir_call_arg_segment_start(segment) >= 0
}

task v4_mir_call_arg_slots_all_assigned(payload: word, slot_count: int) -> bool {
    pilot slot_id = 0
    repeat until slot_id >= slot_count {
        if v4_mir_call_arg_slot_assigned(payload, slot_id) == false {
            give back false
        }
        slot_id += 1
    }
    give back true
}

task v4_mir_call_arg_slot_start(payload: word, slot_id: int) -> int {
    give back v4_mir_call_arg_segment_start(v4_mir_call_arg_segment_payload_at(payload, slot_id))
}

task v4_mir_call_arg_slot_end(payload: word, slot_id: int) -> int {
    give back v4_mir_call_arg_segment_end(v4_mir_call_arg_segment_payload_at(payload, slot_id))
}

task v4_mir_call_arg_slot_set(payload: word, slot_count: int, slot_id: int, start_token: int, end_token: int) -> word {
    pilot rebuilt = ""
    pilot idx = 0
    repeat until idx >= slot_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(payload, idx)
        if idx == slot_id {
            segment = v4_mir_call_arg_segment(start_token, end_token)
        }
        if rebuilt == "" {
            rebuilt = segment
        } else {
            rebuilt = rebuilt + "\n" + segment
        }
        idx += 1
    }
    give back rebuilt
}

task v4_mir_signature_param_index_for_name(mir_id: int, sig_id: int, wanted_name: word) -> int {
    if sig_id < 0 or wanted_name == "" {
        give back 0 - 1
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_id = 0
    pilot param_count = v4_ty_signature_fixed_param_count(ty_id, sig_id)
    repeat until param_id >= param_count {
        if v4_ty_signature_param_name(ty_id, sig_id, param_id) == wanted_name {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_mir_function_type_param_index_for_name(callback_ty: word, wanted_name: word) -> int {
    if callback_ty == "" or wanted_name == "" {
        give back 0 - 1
    }
    pilot param_id = 0
    pilot param_count = v4_ty_function_type_fixed_param_count(callback_ty)
    repeat until param_id >= param_count {
        if v4_ty_function_type_param_name(callback_ty, param_id) == wanted_name {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_mir_method_param_index_for_name(mir_id: int, hir_item: int, method_id: int, wanted_name: word) -> int {
    if hir_item < 0 or method_id < 0 or wanted_name == "" {
        give back 0 - 1
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_id = 0
    pilot param_count = v4_ty_impl_method_explicit_param_count(ty_id, hir_item, method_id)
    repeat until param_id >= param_count {
        if v4_ty_impl_method_explicit_param_name(ty_id, hir_item, method_id, param_id) == wanted_name {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_mir_bound_method_param_index_for_name(mir_id: int, doctrine_sig: int, method_id: int, wanted_name: word) -> int {
    if doctrine_sig < 0 or method_id < 0 or wanted_name == "" {
        give back 0 - 1
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_id = 0
    pilot param_count = v4_ty_doctrine_method_explicit_param_count(ty_id, doctrine_sig, method_id)
    repeat until param_id >= param_count {
        if v4_ty_doctrine_method_explicit_param_name(ty_id, doctrine_sig, method_id, param_id) == wanted_name {
            give back param_id
        }
        param_id += 1
    }
    give back 0 - 1
}

task v4_mir_call_args_payload_append(payload: word, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back payload
    }
    if payload == "" {
        give back word_from_int(rvalue_id)
    }
    give back payload + "," + word_from_int(rvalue_id)
}

task v4_mir_rvalue_is_aggregate_kind(kind: word) -> bool {
    give back kind == v4_mir_rvalue_construct or kind == v4_mir_rvalue_array or kind == v4_mir_rvalue_list or kind == v4_mir_rvalue_tuple or kind == v4_mir_rvalue_map or kind == v4_mir_rvalue_closure
}

task v4_mir_aggregate_children_payload(children_handle: int) -> word {
    pilot payload = ""
    pilot child_id = 0
    repeat until child_id >= array_len(children_handle) {
        payload = v4_mir_call_args_payload_append(payload, word_to_int(array_get(children_handle, child_id)))
        child_id += 1
    }
    give back payload
}

task v4_mir_add_aggregate_rvalue(mir_id: int, body_id: int, rvalue_kind: word, text: word, op: word, span: word, rvalue_ty: word, children_handle: int) -> int {
    pilot rvalue_id = v4_mir_add_rvalue(mir_id, body_id, rvalue_kind, text, op, 0 - 1, 0 - 1, span, rvalue_ty)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, rvalue_id, v4_mir_aggregate_children_payload(children_handle))
    give back rvalue_id
}

task v4_mir_call_args_payload_concat(left: word, right: word) -> word {
    if left == "" {
        give back right
    }
    if right == "" {
        give back left
    }
    give back left + "," + right
}

task v4_mir_call_args_payload_count(payload: word) -> int {
    if payload == "" {
        give back 0
    }
    pilot count = 1
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            count += 1
        }
        idx += 1
    }
    give back count
}

task v4_mir_call_args_payload_at(payload: word, wanted: int) -> int {
    if payload == "" or wanted < 0 {
        give back 0 - 1
    }
    pilot idx = 0
    pilot start_pos = 0
    pilot current = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            if current == wanted {
                give back word_to_int(v4_slice(payload, start_pos, idx))
            }
            current += 1
            start_pos = idx + 1
        }
        idx += 1
    }
    if current == wanted and start_pos < payload.length() {
        give back word_to_int(v4_slice(payload, start_pos, payload.length()))
    }
    give back 0 - 1
}

task v4_mir_rvalue_call_arg_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    give back v4_mir_call_args_payload_count(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id))
}

task v4_mir_rvalue_call_arg(mir_id: int, body_id: int, rvalue_id: int, arg_id: int) -> int {
    give back v4_mir_call_args_payload_at(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), arg_id)
}

task v4_mir_rvalue_aggregate_child_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or not v4_mir_rvalue_is_aggregate_kind(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)) {
        give back 0
    }
    give back v4_mir_call_args_payload_count(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id))
}

task v4_mir_rvalue_aggregate_child(mir_id: int, body_id: int, rvalue_id: int, child_id: int) -> int {
    if rvalue_id < 0 or not v4_mir_rvalue_is_aggregate_kind(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)) {
        give back 0 - 1
    }
    give back v4_mir_call_args_payload_at(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), child_id)
}

task v4_mir_closure_capture_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_closure {
        give back 0
    }
    give back v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
}

task v4_mir_closure_capture(mir_id: int, body_id: int, rvalue_id: int, capture_id: int) -> int {
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_closure {
        give back 0 - 1
    }
    give back v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, capture_id)
}

task v4_mir_capture_mode_for_kind(kind: word) -> word {
    if kind == v4_mir_rvalue_capture_borrow { give back v4_ty_closure_mode_borrow }
    if kind == v4_mir_rvalue_capture_borrow_mut { give back v4_ty_closure_mode_mut }
    if kind == v4_mir_rvalue_capture_copy { give back v4_ty_closure_mode_copy }
    if kind == v4_mir_rvalue_capture_move { give back v4_ty_closure_mode_move }
    give back ""
}

task v4_mir_closure_capture_mode_at(mir_id: int, body_id: int, local_name: word, offset: int) -> word {
    pilot rvalue_id = 0
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
    repeat until rvalue_id >= rvalue_count {
        if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_closure {
            pilot closure_span = v4_mir_rvalue_span(mir_id, body_id, rvalue_id)
            if offset >= v4_span_start(closure_span) and offset < v4_span_end(closure_span) {
                pilot capture_id = 0
                pilot capture_count = v4_mir_closure_capture_count(mir_id, body_id, rvalue_id)
                repeat until capture_id >= capture_count {
                    pilot capture_rvalue = v4_mir_closure_capture(mir_id, body_id, rvalue_id, capture_id)
                    if v4_mir_rvalue_text(mir_id, body_id, capture_rvalue) == local_name {
                        give back v4_mir_capture_mode_for_kind(v4_mir_rvalue_kind(mir_id, body_id, capture_rvalue))
                    }
                    capture_id += 1
                }
            }
        }
        rvalue_id += 1
    }
    give back ""
}

task v4_mir_rvalue_call_borrowed_source_signature_id(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back 0 - 1
    }
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back 0 - 1
    }
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call {
        give back 0 - 1
    }
    if v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id) >= 0 or v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id) >= 0 {
        give back 0 - 1
    }

    pilot sig_id = v4_mir_signature_id_for_name(mir_id, v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if not v4_ty_signature_is_ordinary_static_task(ty_id, sig_id) {
        give back 0 - 1
    }

    pilot call_return_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot signature_return_ty = v4_ty_signature_return_type(ty_id, sig_id)
    if not v4_ty_types_compatible_in_signature(ty_id, sig_id, signature_return_ty, call_return_ty) {
        give back 0 - 1
    }
    if v4_ty_is_lend_type(signature_return_ty) {
        if not v4_ty_is_lend_type(call_return_ty) or v4_ty_lend_mode(signature_return_ty) != v4_ty_lend_mode(call_return_ty) {
            give back 0 - 1
        }
        give back sig_id
    }
    pilot signature_leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, signature_return_ty)
    pilot signature_has_lend_schema: bool = v4_ty_type_stores_lend(ty_id, signature_return_ty)
    if signature_leaf_count == 0 and v4_ty_type_contains_lend(signature_return_ty) {
        signature_has_lend_schema = true
    }
    if not v4_ty_type_supports_fixed_lend_storage(ty_id, signature_return_ty) or not signature_has_lend_schema {
        give back 0 - 1
    }
    pilot call_leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, call_return_ty)
    pilot call_has_lend_schema: bool = v4_ty_type_may_store_lend(ty_id, call_return_ty)
    if call_leaf_count == 0 and v4_ty_type_contains_lend(call_return_ty) {
        call_has_lend_schema = true
    }
    if not v4_ty_type_supports_fixed_lend_storage(ty_id, call_return_ty) or not call_has_lend_schema {
        give back 0 - 1
    }
    give back sig_id
}

task v4_mir_rvalue_call_return_lend_leaf_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    pilot sig_id = v4_mir_rvalue_call_borrowed_source_signature_id(mir_id, body_id, rvalue_id)
    if sig_id < 0 { give back 0 - 1 }
    give back v4_ty_signature_return_lend_leaf_count(v4_mir_ty_id(mir_id), sig_id)
}

task v4_mir_rvalue_call_return_lend_leaf_projection_at(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int) -> word {
    pilot sig_id = v4_mir_rvalue_call_borrowed_source_signature_id(mir_id, body_id, rvalue_id)
    if sig_id < 0 { give back "" }
    give back v4_ty_signature_return_lend_leaf_projection_at(v4_mir_ty_id(mir_id), sig_id, return_leaf_id)
}

task v4_mir_rvalue_call_return_lend_leaf_route_guard_at(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int) -> word {
    pilot sig_id = v4_mir_rvalue_call_borrowed_source_signature_id(mir_id, body_id, rvalue_id)
    if sig_id < 0 { give back "" }
    give back v4_ty_signature_return_lend_leaf_route_guard_at(v4_mir_ty_id(mir_id), sig_id, return_leaf_id)
}

task v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int) -> word {
    pilot sig_id = v4_mir_rvalue_call_borrowed_source_signature_id(mir_id, body_id, rvalue_id)
    if sig_id < 0 or return_leaf_id < 0 { give back v4_ty_return_lend_source_opaque }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot source_payload = v4_ty_signature_return_lend_source_payload(ty_id, sig_id, return_leaf_id)
    pilot source_count = v4_ty_return_lend_source_payload_count(source_payload)
    if source_count < 0 { give back v4_ty_return_lend_source_opaque }

    pilot fixed_param_count = v4_ty_signature_fixed_param_count(ty_id, sig_id)
    if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) < fixed_param_count {
        give back v4_ty_return_lend_source_opaque
    }
    pilot mapped = ""
    pilot source_id = 0
    repeat until source_id >= source_count {
        pilot edge = v4_ty_return_lend_source_payload_at(source_payload, source_id)
        if edge == "" { give back v4_ty_return_lend_source_opaque }
        pilot param_id = word_to_int(v4_resolve_snapshot_field_raw(edge, 0))
        if param_id < 0 or param_id >= fixed_param_count {
            give back v4_ty_return_lend_source_opaque
        }
        pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, param_id)
        if arg_rvalue < 0 or arg_rvalue >= v4_mir_body_rvalue_count(mir_id, body_id) {
            give back v4_ty_return_lend_source_opaque
        }

        pilot arg_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
        pilot param_type = v4_ty_signature_param_type(ty_id, sig_id, param_id)
        pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
        if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
            if not v4_ty_is_lend_type(arg_ty) {
                give back v4_ty_return_lend_source_opaque
            }
            if param_mode == v4_ty_param_mode_lend_mut and not v4_ty_is_lend_mut_type(arg_ty) {
                give back v4_ty_return_lend_source_opaque
            }
            if not v4_ty_types_compatible_in_signature(ty_id, sig_id, param_type, v4_ty_lend_target_type(arg_ty)) {
                give back v4_ty_return_lend_source_opaque
            }
        } else {
            if not v4_ty_type_supports_fixed_lend_storage(ty_id, arg_ty) or not v4_ty_type_may_store_lend(ty_id, arg_ty) {
                give back v4_ty_return_lend_source_opaque
            }
            if not v4_ty_types_compatible_in_signature(ty_id, sig_id, param_type, arg_ty) {
                give back v4_ty_return_lend_source_opaque
            }
        }
        pilot projection = v4_resolve_snapshot_field_raw(edge, 1)
        pilot guard = v4_resolve_snapshot_field_raw(edge, 2)
        mapped = v4_ty_return_lend_source_payload_append(mapped, word_from_int(arg_rvalue) + "|" + projection + "|" + guard)
        source_id += 1
    }
    give back mapped
}

task v4_mir_rvalue_call_borrowed_source_edge_at_for_leaf(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int, source_id: int) -> word {
    give back v4_ty_return_lend_source_payload_at(v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id, body_id, rvalue_id, return_leaf_id), source_id)
}

task v4_mir_rvalue_call_borrowed_source_arg_for_leaf(mir_id: int, body_id: int, rvalue_id: int, sig_id: int, return_leaf_id: int, source_id: int) -> int {
    pilot edge = v4_mir_rvalue_call_borrowed_source_edge_at_for_leaf(mir_id, body_id, rvalue_id, return_leaf_id, source_id)
    if edge == "" { give back 0 - 1 }
    give back word_to_int(v4_resolve_snapshot_field_raw(edge, 0))
}

task v4_mir_rvalue_call_borrowed_source_arg_count_for_leaf(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int) -> int {
    give back v4_ty_return_lend_source_payload_count(v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id, body_id, rvalue_id, return_leaf_id))
}

task v4_mir_rvalue_call_borrowed_source_arg_at_for_leaf(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int, source_id: int) -> int {
    pilot edge = v4_mir_rvalue_call_borrowed_source_edge_at_for_leaf(mir_id, body_id, rvalue_id, return_leaf_id, source_id)
    if edge == "" { give back 0 - 1 }
    give back word_to_int(v4_resolve_snapshot_field_raw(edge, 0))
}

task v4_mir_rvalue_call_borrowed_source_projection_at_for_leaf(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int, source_id: int) -> word {
    pilot edge = v4_mir_rvalue_call_borrowed_source_edge_at_for_leaf(mir_id, body_id, rvalue_id, return_leaf_id, source_id)
    if edge == "" { give back "" }
    give back v4_resolve_snapshot_field_raw(edge, 1)
}

task v4_mir_rvalue_call_borrowed_source_route_guard_at_for_leaf(mir_id: int, body_id: int, rvalue_id: int, return_leaf_id: int, source_id: int) -> word {
    pilot edge = v4_mir_rvalue_call_borrowed_source_edge_at_for_leaf(mir_id, body_id, rvalue_id, return_leaf_id, source_id)
    if edge == "" { give back "" }
    give back v4_resolve_snapshot_field_raw(edge, 2)
}

task v4_mir_rvalue_call_borrowed_source_arg_for_signature(mir_id: int, body_id: int, rvalue_id: int, sig_id: int, source_id: int) -> int {
    if not v4_ty_is_lend_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back 0 - 1
    }
    give back v4_mir_rvalue_call_borrowed_source_arg_for_leaf(mir_id, body_id, rvalue_id, sig_id, 0, source_id)
}

-- -1 is opaque/unproven, 0 is a proven empty TY source set, and positive counts are fully mapped.
task v4_mir_rvalue_call_borrowed_source_arg_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if not v4_ty_is_lend_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back 0 - 1
    }
    give back v4_mir_rvalue_call_borrowed_source_arg_count_for_leaf(mir_id, body_id, rvalue_id, 0)
}

task v4_mir_rvalue_call_borrowed_source_arg_at(mir_id: int, body_id: int, rvalue_id: int, source_id: int) -> int {
    if source_id < 0 or not v4_ty_is_lend_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back 0 - 1
    }
    give back v4_mir_rvalue_call_borrowed_source_arg_at_for_leaf(mir_id, body_id, rvalue_id, 0, source_id)
}

-- Compatibility-only singular view; core logic must use the authoritative count/at source-set APIs.
task v4_mir_rvalue_call_borrowed_source_arg(mir_id: int, body_id: int, rvalue_id: int) -> int {
    pilot source_count = v4_mir_rvalue_call_borrowed_source_arg_count(mir_id, body_id, rvalue_id)
    if source_count <= 0 { give back 0 - 1 }
    if source_count > 1 { give back 0 - 2 }
    give back v4_mir_rvalue_call_borrowed_source_arg_at(mir_id, body_id, rvalue_id, 0)
}

task v4_mir_call_check_result(generic_env: word, args_payload: word) -> word {
    give back generic_env + "\n" + args_payload
}

task v4_mir_call_check_result_env(check_result: word) -> word {
    pilot idx = 0
    repeat until idx >= check_result.length() {
        if check_result.char_at(idx) == "\n" {
            give back v4_slice(check_result, 0, idx)
        }
        idx += 1
    }
    give back check_result
}

task v4_mir_call_check_result_args(check_result: word) -> word {
    pilot idx = 0
    repeat until idx >= check_result.length() {
        if check_result.char_at(idx) == "\n" {
            if idx + 1 >= check_result.length() {
                give back ""
            }
            give back check_result.substring(idx + 1, check_result.length())
        }
        idx += 1
    }
    give back ""
}

task v4_mir_validate_variadic_call_arg(mir_id: int, body_id: int, stream_id: int, callee_name: word, start_token: int, end_token: int, arg_rvalue: int) -> void {
    if arg_rvalue < 0 or end_token <= start_token {
        give back
    }

    pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
    pilot promoted_ty = v4_ty_variadic_arg_promoted_type(v4_mir_ty_id(mir_id), actual_ty)
    if promoted_ty != v4_ty_unknown {
        give back
    }

    pilot arg_span = v4_mir_span_from_tokens(stream_id, start_token, end_token)
    v4_mir_add_type_error(mir_id, arg_span, "variadic call argument is not C vararg safe", callee_name + " cannot carry " + actual_ty + " through ...; " + v4_ty_variadic_arg_help(actual_ty))
}

task v4_mir_lower_ignored_call_args(mir_id: int, body_id: int, stream_id: int, open_token: int, close_token: int) -> void {
    pilot arg_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    pilot arg_idx = 0
    pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    repeat until arg_idx >= arg_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
        if value_start >= 0 and arg_end > value_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, value_start, arg_end)
        }
        arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }
}

task v4_mir_check_call_generic_bounds(mir_id: int, expr_span: word, callee_name: word, sig_id: int, generic_env: word) -> void {
    if sig_id < 0 or generic_env == "" or generic_env == v4_ty_generic_env_fail {
        give back
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)
        pilot actual_ty = v4_ty_generic_env_lookup(generic_env, generic_name)
        if actual_ty != "" {
            pilot bound_idx = 0
            pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_idx)
            repeat until bound_idx >= bound_count {
                pilot bound_name = v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_idx, bound_idx)
                if not v4_ty_signature_type_satisfies_doctrine_env(ty_id, sig_id, actual_ty, bound_name, generic_env) {
                    v4_mir_add_type_error(mir_id, expr_span, "generic bound mismatch", callee_name + " requires " + generic_name + ": " + bound_name + " but got " + actual_ty)
                }
                bound_idx += 1
            }
        }
        generic_idx += 1
    }
}

task v4_mir_add_lend_bearing_generic_call_error(mir_id: int, expr_span: word, callee_name: word, relation: word, generic_name: word, actual_ty: word) -> void {
    pilot message = "Meiya cannot substitute a lend-bearing type for a generic call yet"
    pilot help = callee_name + " " + relation + " " + generic_name + " as " + actual_ty
    help = help + "; keep lends on explicit lend parameters and outer borrowed returns until generic provenance exists"
    v4_mir_add_type_error(mir_id, expr_span, message, help)
}
task v4_mir_add_lend_storage_analysis_exhausted_error(mir_id: int, expr_span: word, callee_name: word, actual_ty: word) -> void {
    pilot message = "Meiya's lend-storage analysis exhausted its depth budget"
    pilot help = callee_name + " reaches type " + actual_ty
    help = help + "; split deeply nested aggregate types or introduce a nominal shape before this ownership boundary"
    v4_mir_add_type_error(mir_id, expr_span, message, help)
}

task v4_mir_reject_lend_storage_type(mir_id: int, expr_span: word, callee_name: word, relation: word, generic_name: word, actual_ty: word) -> bool {
    pilot storage_kind = v4_ty_type_lend_storage_class(v4_mir_ty_id(mir_id), actual_ty)
    if v4_ty_lend_storage_class_is_incomplete(storage_kind) {
        v4_mir_add_lend_storage_analysis_exhausted_error(mir_id, expr_span, callee_name, actual_ty)
        give back true
    }
    if v4_ty_lend_storage_class_confirms_lend(storage_kind) {
        v4_mir_add_lend_bearing_generic_call_error(mir_id, expr_span, callee_name, relation, generic_name, actual_ty)
        give back true
    }
    give back false
}


task v4_mir_reject_lend_bearing_generic_env(mir_id: int, expr_span: word, callee_name: word, relation: word, generic_env: word) -> bool {
    if generic_env == "" or generic_env == v4_ty_generic_env_fail {
        give back false
    }

    pilot rejected = false
    pilot segment_start = 0
    repeat until segment_start >= generic_env.length() {
        pilot segment_end = v4_ty_find_top_level_type_char(generic_env, "|", segment_start, generic_env.length())
        if segment_end < 0 {
            segment_end = generic_env.length()
        }
        pilot eq_pos = v4_ty_find_top_level_type_char(generic_env, "=", segment_start, segment_end)
        if eq_pos > segment_start and eq_pos + 1 < segment_end {
            pilot generic_name = v4_slice(generic_env, segment_start, eq_pos)
            pilot actual_ty = v4_slice(generic_env, eq_pos + 1, segment_end)
            if v4_mir_reject_lend_storage_type(mir_id, expr_span, callee_name, relation, generic_name, actual_ty) {
                rejected = true
            }
        }
        segment_start = segment_end + 1
    }
    give back rejected
}

task v4_mir_reject_lend_bearing_impl_owner_generics(mir_id: int, expr_span: word, callee_name: word, owner_ty: word, method_ref: word) -> bool {
    if method_ref == "" {
        give back false
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
    pilot generic_env = v4_ty_impl_generic_env_for_owner(ty_id, hir_item, owner_ty)
    if v4_mir_reject_lend_bearing_generic_env(mir_id, expr_span, callee_name, "derives owner generic", generic_env) {
        give back true
    }
    pilot owner_kind = v4_ty_type_lend_storage_class(ty_id, owner_ty)
    if v4_ty_lend_storage_class_is_incomplete(owner_kind) {
        v4_mir_add_lend_storage_analysis_exhausted_error(mir_id, expr_span, callee_name, owner_ty)
        give back true
    }
    if v4_ty_lend_storage_class_confirms_lend(owner_kind) {
        pilot message = "Meiya cannot carry a lend-bearing aggregate across a method call yet"
        pilot help = callee_name + " uses receiver type " + owner_ty
        help = help + "; keep fixed-layout lends local until aggregate method-call provenance lands"
        v4_mir_add_type_error(mir_id, expr_span, message, help)
        give back true
    }
    give back false
}

task v4_mir_reject_lend_bearing_call_generics(mir_id: int, expr_span: word, callee_name: word, sig_id: int, generic_env: word) -> bool {
    if sig_id < 0 or generic_env == "" or generic_env == v4_ty_generic_env_fail {
        give back false
    }

    pilot rejected = false
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot generic_idx = 0
    pilot generic_count = v4_ty_signature_generic_count(ty_id, sig_id)
    repeat until generic_idx >= generic_count {
        if v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_idx) == false {
            pilot generic_name = v4_ty_signature_generic_name(ty_id, sig_id, generic_idx)
            pilot actual_ty = v4_ty_generic_env_lookup(generic_env, generic_name)
            if actual_ty != "" and v4_mir_reject_lend_storage_type(mir_id, expr_span, callee_name, "infers", generic_name, actual_ty) {
                rejected = true
            }
        }
        generic_idx += 1
    }
    give back rejected
}

task v4_mir_expected_call_arg_type(expected_ty: word, param_mode: word) -> word {
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        give back v4_ty_lend_type(expected_ty, param_mode)
    }
    give back expected_ty
}

task v4_mir_check_lend_call_arg(mir_id: int, expr_span: word, callee_name: word, param_name: word, param_mode: word, actual_ty: word) -> word {
    if param_mode != v4_ty_param_mode_lend and param_mode != v4_ty_param_mode_lend_mut {
        give back actual_ty
    }

    if not v4_ty_is_lend_type(actual_ty) {
        if not v4_ty_is_known(actual_ty) {
            give back actual_ty
        }
        v4_mir_add_type_error(mir_id, expr_span, "borrowed call argument needs lend", callee_name + "." + param_name + " expects " + param_mode + "; pass lend " + param_name + " or lend mut " + param_name + " explicitly")
        give back actual_ty
    }

    if param_mode == v4_ty_param_mode_lend_mut and not v4_ty_is_lend_mut_type(actual_ty) {
        v4_mir_add_type_error(mir_id, expr_span, "mutable borrowed call argument needs lend mut", callee_name + "." + param_name + " expects lend mut but got " + actual_ty)
    }
    if param_mode == v4_ty_param_mode_lend and v4_ty_is_lend_mut_type(actual_ty) {
        -- A mutable lend may satisfy an immutable lend call, but the explicit
        -- rvalue remains visible so Meiya can enforce the loan range.
    }

    give back v4_ty_lend_target_type(actual_ty)
}

task v4_mir_check_call_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, callee_name: word, sig_id: int, open_token: int, close_token: int) -> word {
    if sig_id < 0 or open_token < 0 or close_token <= open_token {
        give back v4_mir_call_check_result("", "")
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot caller_sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot expected_count = v4_ty_signature_fixed_param_count(ty_id, sig_id)
    pilot variadic = v4_ty_signature_is_variadic(ty_id, sig_id)
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    if variadic {
        if actual_count < expected_count {
            v4_mir_add_type_error(mir_id, expr_span, "call arity mismatch", callee_name + " expects at least " + word_from_int(expected_count) + " arguments but got " + word_from_int(actual_count))
        }
    } else if expected_count != actual_count {
        v4_mir_add_type_error(mir_id, expr_span, "call arity mismatch", callee_name + " expects " + word_from_int(expected_count) + " arguments but got " + word_from_int(actual_count))
    }

    pilot planned_slots = v4_mir_call_arg_slot_payload_new(expected_count)
    pilot variadic_payload = ""
    pilot extra_payload = ""
    pilot named_seen = false
    pilot next_positional = 0
    pilot plan_arg_idx = 0
    pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    repeat until plan_arg_idx >= actual_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot arg_label = v4_mir_call_arg_label(stream_id, arg_start, arg_end)
        pilot value_start = arg_start
        if arg_label != "" {
            named_seen = true
            value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            pilot param_idx = v4_mir_signature_param_index_for_name(mir_id, sig_id, arg_label)
            if param_idx < 0 {
                v4_mir_add_type_error(mir_id, expr_span, "unknown call argument", callee_name + " has no parameter " + arg_label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else if v4_mir_call_arg_slot_assigned(planned_slots, param_idx) {
                v4_mir_add_type_error(mir_id, expr_span, "duplicate call argument", arg_label + " already has an assignment in " + callee_name)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
            }
        } else {
            if named_seen {
                if variadic and v4_mir_call_arg_slots_all_assigned(planned_slots, expected_count) {
                    variadic_payload = v4_mir_call_arg_segment_payload_append(variadic_payload, arg_start, arg_end)
                } else {
                    v4_mir_add_type_error(mir_id, expr_span, "positional call argument after named", "place positional arguments before named ones in " + callee_name)
                    extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
                }
            } else if next_positional < expected_count {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                next_positional += 1
            } else if variadic {
                variadic_payload = v4_mir_call_arg_segment_payload_append(variadic_payload, arg_start, arg_end)
            } else {
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            }
        }
        plan_arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }

    pilot generic_env = ""
    pilot args_payload = ""
    pilot lower_arg_idx = 0
    repeat until lower_arg_idx >= expected_count {
        if named_seen and not v4_mir_call_arg_slot_assigned(planned_slots, lower_arg_idx) {
            pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, lower_arg_idx)
            v4_mir_add_type_error(mir_id, expr_span, "missing call argument", callee_name + " still needs parameter " + param_name)
        }
        pilot planned_start = v4_mir_call_arg_slot_start(planned_slots, lower_arg_idx)
        pilot planned_end = v4_mir_call_arg_slot_end(planned_slots, lower_arg_idx)
        if planned_start >= 0 and planned_end > planned_start {
            pilot expected_ty = v4_ty_signature_param_type(ty_id, sig_id, lower_arg_idx)
            pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, lower_arg_idx)
            pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, lower_arg_idx)
            pilot expected_arg_ty = v4_mir_expected_call_arg_type(expected_ty, param_mode)
            pilot arg_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, planned_start, planned_end, expected_arg_ty)
            pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            pilot actual_match_ty = v4_mir_check_lend_call_arg(mir_id, expr_span, callee_name, param_name, param_mode, actual_ty)
            pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, expected_ty, actual_match_ty, generic_env)
            if next_env == v4_ty_generic_env_fail {
                pilot fallback_env = v4_ty_match_type_can_coerce_to_dyn_between_signatures_env(ty_id, sig_id, caller_sig_id, expected_ty, actual_match_ty, generic_env)
                if fallback_env != v4_ty_generic_env_fail {
                    next_env = fallback_env
                }
            }
            if next_env == v4_ty_generic_env_fail {
                pilot context = callee_name + " argument " + word_from_int(lower_arg_idx + 1)
                v4_mir_add_type_mismatch_error(mir_id, expr_span, "call argument type mismatch", context + " expects " + expected_ty + " but got " + actual_match_ty, context, expected_ty, actual_match_ty)
            } else {
                generic_env = next_env
                pilot coerced_expected_ty = v4_ty_apply_generic_env(expected_ty, generic_env)
                pilot coerced_arg_ty = v4_mir_expected_call_arg_type(coerced_expected_ty, param_mode)
                if v4_ty_type_contains_dyn(coerced_arg_ty) {
                    v4_mir_set_rvalue_ty(mir_id, body_id, arg_rvalue, coerced_arg_ty)
                }
            }
            args_payload = v4_mir_call_args_payload_append(args_payload, arg_rvalue)
        }
        lower_arg_idx += 1
    }

    pilot variadic_idx = 0
    pilot variadic_count = v4_mir_call_arg_segment_payload_count(variadic_payload)
    repeat until variadic_idx >= variadic_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(variadic_payload, variadic_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot arg_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
            v4_mir_validate_variadic_call_arg(mir_id, body_id, stream_id, callee_name, extra_start, extra_end, arg_rvalue)
            args_payload = v4_mir_call_args_payload_append(args_payload, arg_rvalue)
        }
        variadic_idx += 1
    }

    pilot extra_idx = 0
    pilot extra_count = v4_mir_call_arg_segment_payload_count(extra_payload)
    repeat until extra_idx >= extra_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(extra_payload, extra_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
        }
        extra_idx += 1
    }
    if v4_mir_reject_lend_bearing_call_generics(mir_id, expr_span, callee_name, sig_id, generic_env) {
        generic_env = ""
    } else {
        v4_mir_check_call_generic_bounds(mir_id, expr_span, callee_name, sig_id, generic_env)
    }
    give back v4_mir_call_check_result(generic_env, args_payload)
}

task v4_mir_callback_type_contains_lend(mir_id: int, callback_ty: word) -> bool {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_id = 0
    pilot param_count = v4_ty_function_type_fixed_param_count(callback_ty)
    repeat until param_id >= param_count {
        pilot param_ty = v4_ty_canonical_type(ty_id, v4_ty_function_type_param_surface(callback_ty, param_id))
        if v4_ty_type_may_store_lend(ty_id, param_ty) {
            give back true
        }
        param_id += 1
    }
    pilot return_ty = v4_ty_canonical_type(ty_id, v4_ty_function_type_return_text(callback_ty))
    give back v4_ty_type_may_store_lend(ty_id, return_ty)
}

task v4_mir_check_callback_call_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, callee_text: word, callback_ty: word, open_token: int, close_token: int) -> word {
    if callback_ty == "" or open_token < 0 or close_token <= open_token {
        give back ""
    }

    if v4_mir_callback_type_contains_lend(mir_id, callback_ty) {
        pilot message = "Meiya cannot forward borrowed values through an FFI callback yet"
        pilot help = callee_text + " has callback type " + callback_ty
        help = help + "; keep lend contracts on ordinary static tasks until FFI provenance lowering exists"
        v4_mir_add_type_error(mir_id, expr_span, message, help)
    }

    pilot expected_count = v4_ty_function_type_fixed_param_count(callback_ty)
    pilot variadic = v4_ty_function_type_variadic_param_id(callback_ty) >= 0
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    if variadic {
        if actual_count < expected_count {
            v4_mir_add_type_error(mir_id, expr_span, "callback call arity mismatch", callee_text + " expects at least " + word_from_int(expected_count) + " arguments but got " + word_from_int(actual_count))
        }
    } else if expected_count != actual_count {
        v4_mir_add_type_error(mir_id, expr_span, "callback call arity mismatch", callee_text + " expects " + word_from_int(expected_count) + " arguments but got " + word_from_int(actual_count))
    }

    pilot planned_slots = v4_mir_call_arg_slot_payload_new(expected_count)
    pilot variadic_payload = ""
    pilot extra_payload = ""
    pilot named_seen = false
    pilot next_positional = 0
    pilot plan_arg_idx = 0
    pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    repeat until plan_arg_idx >= actual_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot arg_label = v4_mir_call_arg_label(stream_id, arg_start, arg_end)
        pilot value_start = arg_start
        if arg_label != "" {
            named_seen = true
            value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            pilot param_idx = v4_mir_function_type_param_index_for_name(callback_ty, arg_label)
            if param_idx < 0 {
                v4_mir_add_type_error(mir_id, expr_span, "unknown call argument", callee_text + " has no parameter " + arg_label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else if v4_mir_call_arg_slot_assigned(planned_slots, param_idx) {
                v4_mir_add_type_error(mir_id, expr_span, "duplicate call argument", arg_label + " already has an assignment in " + callee_text)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
            }
        } else {
            if named_seen {
                if variadic and v4_mir_call_arg_slots_all_assigned(planned_slots, expected_count) {
                    variadic_payload = v4_mir_call_arg_segment_payload_append(variadic_payload, arg_start, arg_end)
                } else {
                    v4_mir_add_type_error(mir_id, expr_span, "positional call argument after named", "place positional arguments before named ones in " + callee_text)
                    extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
                }
            } else if next_positional < expected_count {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                next_positional += 1
            } else if variadic {
                variadic_payload = v4_mir_call_arg_segment_payload_append(variadic_payload, arg_start, arg_end)
            } else {
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            }
        }
        plan_arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }

    pilot args_payload = ""
    pilot lower_arg_idx = 0
    repeat until lower_arg_idx >= expected_count {
        if named_seen and not v4_mir_call_arg_slot_assigned(planned_slots, lower_arg_idx) {
            pilot param_name = v4_ty_function_type_param_name(callback_ty, lower_arg_idx)
            if param_name == "" {
                param_name = word_from_int(lower_arg_idx + 1)
            }
            v4_mir_add_type_error(mir_id, expr_span, "missing call argument", callee_text + " still needs parameter " + param_name)
        }
        pilot planned_start = v4_mir_call_arg_slot_start(planned_slots, lower_arg_idx)
        pilot planned_end = v4_mir_call_arg_slot_end(planned_slots, lower_arg_idx)
        if planned_start >= 0 and planned_end > planned_start {
            pilot expected_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_function_type_param_surface(callback_ty, lower_arg_idx))
            pilot arg_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, planned_start, planned_end, expected_ty)
            args_payload = v4_mir_call_args_payload_append(args_payload, arg_rvalue)
            pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            if not v4_mir_types_compatible(mir_id, body_id, expected_ty, actual_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "call argument type mismatch", callee_text + " argument " + word_from_int(lower_arg_idx + 1) + " expects " + expected_ty + " but got " + actual_ty)
            } else {
                pilot coerced_ty = v4_mir_coerced_value_type(mir_id, body_id, expected_ty, actual_ty)
                if coerced_ty != actual_ty {
                    v4_mir_set_rvalue_ty(mir_id, body_id, arg_rvalue, coerced_ty)
                }
            }
        }
        lower_arg_idx += 1
    }

    pilot variadic_idx = 0
    pilot variadic_count = v4_mir_call_arg_segment_payload_count(variadic_payload)
    repeat until variadic_idx >= variadic_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(variadic_payload, variadic_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot arg_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
            v4_mir_validate_variadic_call_arg(mir_id, body_id, stream_id, callee_text, extra_start, extra_end, arg_rvalue)
            args_payload = v4_mir_call_args_payload_append(args_payload, arg_rvalue)
        }
        variadic_idx += 1
    }

    pilot extra_idx = 0
    pilot extra_count = v4_mir_call_arg_segment_payload_count(extra_payload)
    repeat until extra_idx >= extra_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(extra_payload, extra_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
        }
        extra_idx += 1
    }
    give back args_payload
}

task v4_mir_method_ref(hir_item: int, method_id: int) -> word {
    give back word_from_int(hir_item) + "|" + word_from_int(method_id)
}

task v4_mir_method_ref_pipe(method_ref: word) -> int {
    pilot idx = 0
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_method_ref_hir_item(method_ref: word) -> int {
    pilot pipe = v4_mir_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(method_ref.substring(0, pipe))
}

task v4_mir_method_ref_method_id(method_ref: word) -> int {
    pilot pipe = v4_mir_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(method_ref.substring(pipe + 1, method_ref.length()))
}

task v4_mir_bound_method_ref(sig_id: int, method_id: int) -> word {
    give back word_from_int(sig_id) + "|" + word_from_int(method_id)
}

task v4_mir_bound_method_ref_with_doctrine(sig_id: int, method_id: int, doctrine_instance: word) -> word {
    pilot method_ref = v4_mir_bound_method_ref(sig_id, method_id)
    if doctrine_instance == "" or doctrine_instance == v4_ty_unknown {
        give back method_ref
    }
    give back method_ref + "|" + doctrine_instance
}

task v4_mir_bound_method_ref_pipe(method_ref: word) -> int {
    pilot idx = 0
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_bound_method_ref_sig_id(method_ref: word) -> int {
    pilot pipe = v4_mir_bound_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(method_ref.substring(0, pipe))
}

task v4_mir_bound_method_ref_method_id(method_ref: word) -> int {
    pilot pipe = v4_mir_bound_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    pilot end = method_ref.length()
    pilot idx = pipe + 1
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            end = idx
            idx = method_ref.length()
        }
        idx += 1
    }
    give back word_to_int(method_ref.substring(pipe + 1, end))
}

task v4_mir_bound_method_ref_doctrine_instance(method_ref: word) -> word {
    pilot first_pipe = v4_mir_bound_method_ref_pipe(method_ref)
    if first_pipe < 0 {
        give back ""
    }
    pilot idx = first_pipe + 1
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            give back method_ref.substring(idx + 1, method_ref.length())
        }
        idx += 1
    }
    give back ""
}

task v4_mir_find_method_ref(mir_id: int, owner_ty: word, method_name: word, want_instance: bool) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back ""
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            if v4_ty_impl_matches_owner(ty_id, hir_item, owner_ty) {
                pilot method_id = 0
                pilot method_count = v4_ty_impl_method_count(ty_id, hir_item)
                repeat until method_id >= method_count {
                    if v4_ty_impl_method_name(ty_id, hir_item, method_id) == method_name {
                        if v4_ty_impl_method_is_instance(ty_id, hir_item, method_id) == want_instance {
                            give back v4_mir_method_ref(hir_item, method_id)
                        }
                    }
                    method_id += 1
                }
            }
        }
        hir_item += 1
    }
    give back ""
}

task v4_mir_bound_method_candidate_count(mir_id: int, body_id: int, owner_ty: word, method_name: word, want_instance: bool) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 {
        give back 0
    }
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, sig_id, owner_ty)
    if generic_id < 0 {
        give back 0
    }

    pilot candidate_count = 0
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        pilot doctrine_name = v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx)
        pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
        if doctrine_sig >= 0 {
            pilot method_id = 0
            pilot method_count = v4_ty_doctrine_method_count(ty_id, doctrine_sig)
            repeat until method_id >= method_count {
                if v4_ty_doctrine_method_name(ty_id, doctrine_sig, method_id) == method_name {
                    if v4_ty_doctrine_method_is_instance(ty_id, doctrine_sig, method_id) == want_instance {
                        candidate_count += 1
                    }
                }
                method_id += 1
            }
        }
        bound_idx += 1
    }
    give back candidate_count
}

task v4_mir_bound_method_candidate_doctrines(mir_id: int, body_id: int, owner_ty: word, method_name: word, want_instance: bool) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 {
        give back ""
    }
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, sig_id, owner_ty)
    if generic_id < 0 {
        give back ""
    }

    pilot candidates = ""
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        pilot doctrine_name = v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx)
        pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
        if doctrine_sig >= 0 {
            pilot method_id = 0
            pilot method_count = v4_ty_doctrine_method_count(ty_id, doctrine_sig)
            repeat until method_id >= method_count {
                if v4_ty_doctrine_method_name(ty_id, doctrine_sig, method_id) == method_name and v4_ty_doctrine_method_is_instance(ty_id, doctrine_sig, method_id) == want_instance {
                    if candidates == "" {
                        candidates = doctrine_name
                    } else {
                        candidates = candidates + " and " + doctrine_name
                    }
                }
                method_id += 1
            }
        }
        bound_idx += 1
    }
    give back candidates
}

task v4_mir_add_bound_method_ambiguity(mir_id: int, body_id: int, expr_span: word, owner_ty: word, method_name: word, want_instance: bool, call_glyph: word) -> void {
    pilot candidates = v4_mir_bound_method_candidate_doctrines(mir_id, body_id, owner_ty, method_name, want_instance)
    v4_mir_add_type_error(mir_id, expr_span, "ambiguous doctrine-bound method", owner_ty + call_glyph + method_name + " matches " + candidates + "; Yuuko cannot choose a doctrine timeline by declaration order")
}

task v4_mir_find_bound_method_ref(mir_id: int, body_id: int, owner_ty: word, method_name: word, want_instance: bool) -> word {
    if v4_mir_bound_method_candidate_count(mir_id, body_id, owner_ty, method_name, want_instance) != 1 {
        give back ""
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot generic_id = v4_ty_signature_generic_id_for_name(ty_id, sig_id, owner_ty)
    pilot bound_idx = 0
    pilot bound_count = v4_ty_signature_generic_bound_count(ty_id, sig_id, generic_id)
    repeat until bound_idx >= bound_count {
        pilot doctrine_name = v4_ty_signature_generic_bound_name(ty_id, sig_id, generic_id, bound_idx)
        pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(ty_id, doctrine_name)
        if doctrine_sig >= 0 {
            pilot method_id = 0
            pilot method_count = v4_ty_doctrine_method_count(ty_id, doctrine_sig)
            repeat until method_id >= method_count {
                if v4_ty_doctrine_method_name(ty_id, doctrine_sig, method_id) == method_name and v4_ty_doctrine_method_is_instance(ty_id, doctrine_sig, method_id) == want_instance {
                    give back v4_mir_bound_method_ref_with_doctrine(doctrine_sig, method_id, doctrine_name)
                }
                method_id += 1
            }
        }
        bound_idx += 1
    }
    give back ""
}

task v4_mir_find_dyn_method_ref(mir_id: int, owner_ty: word, method_name: word, want_instance: bool) -> word {
    pilot lookup_owner_ty = owner_ty
    if v4_ty_is_lend_type(lookup_owner_ty) {
        lookup_owner_ty = v4_ty_lend_target_type(lookup_owner_ty)
    }
    if not v4_ty_is_dyn_type(lookup_owner_ty) {
        give back ""
    }
    pilot doctrine_name = v4_ty_dyn_doctrine_base_name(lookup_owner_ty)
    pilot doctrine_sig = v4_ty_doctrine_signature_id_for_name(v4_mir_ty_id(mir_id), doctrine_name)
    if doctrine_sig < 0 {
        give back ""
    }

    pilot method_id = 0
    pilot method_count = v4_ty_doctrine_method_count(v4_mir_ty_id(mir_id), doctrine_sig)
    repeat until method_id >= method_count {
        if v4_ty_doctrine_method_name(v4_mir_ty_id(mir_id), doctrine_sig, method_id) == method_name {
            if v4_ty_doctrine_method_is_instance(v4_mir_ty_id(mir_id), doctrine_sig, method_id) == want_instance {
                give back v4_mir_bound_method_ref_with_doctrine(doctrine_sig, method_id, v4_ty_dyn_doctrine_name(lookup_owner_ty))
            }
        }
        method_id += 1
    }
    give back ""
}

task v4_mir_find_any_method_ref(mir_id: int, owner_ty: word, method_name: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back ""
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            if v4_ty_impl_matches_owner(ty_id, hir_item, owner_ty) {
                pilot method_id = 0
                pilot method_count = v4_ty_impl_method_count(ty_id, hir_item)
                repeat until method_id >= method_count {
                    if v4_ty_impl_method_name(ty_id, hir_item, method_id) == method_name {
                        give back v4_mir_method_ref(hir_item, method_id)
                    }
                    method_id += 1
                }
            }
        }
        hir_item += 1
    }
    give back ""
}

task v4_mir_find_doctrine_impl_method_ref(mir_id: int, owner_ty: word, doctrine_name: word, method_name: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    if hir_id < 0 {
        give back ""
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            pilot impl_doctrine = v4_ty_impl_doctrine_name_from_hir(v4_mir_ty_id(mir_id), hir_item)
            if v4_ty_doctrine_refs_match(doctrine_name, impl_doctrine) and v4_ty_impl_matches_owner(v4_mir_ty_id(mir_id), hir_item, owner_ty) {
                pilot method_id = 0
                pilot method_count = v4_ty_impl_method_count(v4_mir_ty_id(mir_id), hir_item)
                repeat until method_id >= method_count {
                    if v4_ty_impl_method_name(v4_mir_ty_id(mir_id), hir_item, method_id) == method_name {
                        if v4_ty_impl_method_is_instance(v4_mir_ty_id(mir_id), hir_item, method_id) {
                            give back v4_mir_method_ref(hir_item, method_id)
                        }
                    }
                    method_id += 1
                }
            }
        }
        hir_item += 1
    }
    give back ""
}

task v4_mir_method_return_type(mir_id: int, owner_ty: word, method_ref: word) -> word {
    if method_ref == "" {
        give back v4_ty_unknown
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_impl_method_return_type_for_owner(ty_id, v4_mir_method_ref_hir_item(method_ref), v4_mir_method_ref_method_id(method_ref), owner_ty)
}

task v4_mir_bound_method_return_type(mir_id: int, owner_ty: word, method_ref: word) -> word {
    if method_ref == "" {
        give back v4_ty_unknown
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_doctrine_method_return_type_for_bound(ty_id, v4_mir_bound_method_ref_sig_id(method_ref), v4_mir_bound_method_ref_method_id(method_ref), owner_ty, v4_mir_bound_method_ref_doctrine_instance(method_ref))
}

task v4_mir_operator_display(op_kind: word) -> word {
    if op_kind == v4_mir_bin_add { give back "+" }
    if op_kind == v4_mir_bin_sub { give back "-" }
    if op_kind == v4_mir_bin_mul { give back "*" }
    if op_kind == v4_mir_bin_div { give back "/" }
    if op_kind == v4_mir_bin_mod { give back "%" }
    if op_kind == v4_mir_bin_eq { give back "==" }
    if op_kind == v4_mir_bin_ne { give back "!=" }
    if op_kind == v4_mir_unary_neg { give back "-" }
    if op_kind == v4_mir_unary_not { give back "not" }
    if op_kind == v4_mir_unary_deref { give back "*" }
    give back op_kind
}

task v4_mir_binary_operator_overload_ref(mir_id: int, left_ty: word, op_kind: word) -> word {
    pilot doctrine_name = v4_ty_binary_operator_doctrine(op_kind)
    pilot method_name = v4_ty_binary_operator_method(op_kind)
    if doctrine_name == "" or method_name == "" {
        give back ""
    }
    give back v4_mir_find_doctrine_impl_method_ref(mir_id, left_ty, doctrine_name, method_name)
}

task v4_mir_unary_operator_overload_ref(mir_id: int, operand_ty: word, op_kind: word) -> word {
    pilot doctrine_name = v4_ty_unary_operator_doctrine(op_kind)
    pilot method_name = v4_ty_unary_operator_method(op_kind)
    if doctrine_name == "" or method_name == "" {
        give back ""
    }
    give back v4_mir_find_doctrine_impl_method_ref(mir_id, operand_ty, doctrine_name, method_name)
}

task v4_mir_binary_result_type(mir_id: int, op_kind: word, left_ty: word, right_ty: word) -> word {
    if v4_ty_is_known(left_ty) and v4_ty_is_known(right_ty) {
        pilot method_ref = v4_mir_binary_operator_overload_ref(mir_id, left_ty, op_kind)
        if method_ref != "" {
            pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
            pilot method_id = v4_mir_method_ref_method_id(method_ref)
            if v4_ty_impl_method_explicit_param_count(v4_mir_ty_id(mir_id), hir_item, method_id) == 1 {
                pilot expected_ty = v4_ty_impl_method_explicit_param_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, 0, left_ty)
                if v4_ty_types_compatible(expected_ty, right_ty) {
                    give back v4_ty_impl_method_return_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, left_ty)
                }
            }
        }
    }
    give back v4_ty_binary_result(op_kind, left_ty, right_ty)
}

task v4_mir_unary_result_type(mir_id: int, op_kind: word, operand_ty: word) -> word {
    if v4_ty_is_known(operand_ty) {
        pilot method_ref = v4_mir_unary_operator_overload_ref(mir_id, operand_ty, op_kind)
        if method_ref != "" {
            pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
            pilot method_id = v4_mir_method_ref_method_id(method_ref)
            if v4_ty_impl_method_explicit_param_count(v4_mir_ty_id(mir_id), hir_item, method_id) == 0 {
                give back v4_ty_impl_method_return_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, operand_ty)
            }
        }
    }
    give back v4_ty_unary_result(op_kind, operand_ty)
}

task v4_mir_try_lower_binary_operator_overload(mir_id: int, body_id: int, left_id: int, right_id: int, expr_text: word, expr_span: word, op_kind: word, left_ty: word, right_ty: word) -> int {
    if not v4_ty_is_known(left_ty) or not v4_ty_is_known(right_ty) {
        give back 0 - 1
    }

    pilot method_ref = v4_mir_binary_operator_overload_ref(mir_id, left_ty, op_kind)
    if method_ref == "" {
        give back 0 - 1
    }

    pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
    pilot method_id = v4_mir_method_ref_method_id(method_ref)
    if v4_ty_impl_method_explicit_param_count(v4_mir_ty_id(mir_id), hir_item, method_id) != 1 {
        give back 0 - 1
    }

    pilot expected_ty = v4_ty_impl_method_explicit_param_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, 0, left_ty)
    if not v4_ty_types_compatible(expected_ty, right_ty) {
        give back 0 - 1
    }

    pilot method_name = v4_ty_impl_method_name(v4_mir_ty_id(mir_id), hir_item, method_id)
    pilot owner_rejected = v4_mir_reject_lend_bearing_impl_owner_generics(mir_id, expr_span, left_ty + "." + method_name, left_ty, method_ref)
    pilot result_ty = v4_ty_impl_method_return_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, left_ty)
    if owner_rejected {
        result_ty = v4_ty_unknown
    }
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, left_ty + "." + method_name, left_id, right_id, expr_span, result_ty)
    pilot args_payload = v4_mir_call_args_payload_append("", left_id)
    args_payload = v4_mir_call_args_payload_append(args_payload, right_id)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
    if op_kind == v4_mir_bin_ne {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_not, call_rvalue, 0 - 1, expr_span, v4_ty_bool)
    }
    give back call_rvalue
}

task v4_mir_try_lower_unary_operator_overload(mir_id: int, body_id: int, operand_id: int, expr_text: word, expr_span: word, op_kind: word, operand_ty: word) -> int {
    if not v4_ty_is_known(operand_ty) {
        give back 0 - 1
    }

    pilot method_ref = v4_mir_unary_operator_overload_ref(mir_id, operand_ty, op_kind)
    if method_ref == "" {
        give back 0 - 1
    }

    pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
    pilot method_id = v4_mir_method_ref_method_id(method_ref)
    if v4_ty_impl_method_explicit_param_count(v4_mir_ty_id(mir_id), hir_item, method_id) != 0 {
        give back 0 - 1
    }

    pilot method_name = v4_ty_impl_method_name(v4_mir_ty_id(mir_id), hir_item, method_id)
    pilot owner_rejected = v4_mir_reject_lend_bearing_impl_owner_generics(mir_id, expr_span, operand_ty + "." + method_name, operand_ty, method_ref)
    pilot result_ty = v4_ty_impl_method_return_type_for_owner(v4_mir_ty_id(mir_id), hir_item, method_id, operand_ty)
    if owner_rejected {
        result_ty = v4_ty_unknown
    }
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, operand_ty + "." + method_name, operand_id, 0 - 1, expr_span, result_ty)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, v4_mir_call_args_payload_append("", operand_id))
    give back call_rvalue
}

task v4_mir_check_method_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, owner_ty: word, method_name: word, method_ref: word, open_token: int, close_token: int, call_glyph: word) -> word {
    if method_ref == "" or open_token < 0 or close_token <= open_token {
        give back ""
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
    pilot method_id = v4_mir_method_ref_method_id(method_ref)
    pilot expected_count = v4_ty_impl_method_explicit_param_count(ty_id, hir_item, method_id)
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    pilot label = owner_ty + call_glyph + method_name
    if expected_count != actual_count {
        v4_mir_add_type_error(mir_id, expr_span, "method call arity drift", label + " takes " + word_from_int(expected_count) + " explicit arguments but got " + word_from_int(actual_count))
    }

    pilot planned_slots = v4_mir_call_arg_slot_payload_new(expected_count)
    pilot extra_payload = ""
    pilot named_seen = false
    pilot next_positional = 0
    pilot plan_arg_idx = 0
    pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    repeat until plan_arg_idx >= actual_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot arg_label = v4_mir_call_arg_label(stream_id, arg_start, arg_end)
        pilot value_start = arg_start
        if arg_label != "" {
            named_seen = true
            value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            pilot param_idx = v4_mir_method_param_index_for_name(mir_id, hir_item, method_id, arg_label)
            if param_idx < 0 {
                v4_mir_add_type_error(mir_id, expr_span, "unknown method argument", label + " has no parameter " + arg_label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else if v4_mir_call_arg_slot_assigned(planned_slots, param_idx) {
                v4_mir_add_type_error(mir_id, expr_span, "duplicate method argument", arg_label + " already has an assignment in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
            }
        } else {
            if named_seen {
                v4_mir_add_type_error(mir_id, expr_span, "positional method argument after named", "place positional arguments before named ones in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            } else if next_positional < expected_count {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                next_positional += 1
            } else {
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            }
        }
        plan_arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }

    pilot args_payload = ""
    pilot lower_arg_idx = 0
    repeat until lower_arg_idx >= expected_count {
        if named_seen and not v4_mir_call_arg_slot_assigned(planned_slots, lower_arg_idx) {
            pilot param_name = v4_ty_impl_method_explicit_param_name(ty_id, hir_item, method_id, lower_arg_idx)
            v4_mir_add_type_error(mir_id, expr_span, "missing method argument", label + " still needs parameter " + param_name)
        }
        pilot planned_start = v4_mir_call_arg_slot_start(planned_slots, lower_arg_idx)
        pilot planned_end = v4_mir_call_arg_slot_end(planned_slots, lower_arg_idx)
        if planned_start >= 0 and planned_end > planned_start {
            pilot expected_ty = v4_ty_impl_method_explicit_param_type_for_owner(ty_id, hir_item, method_id, lower_arg_idx, owner_ty)
            pilot arg_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, planned_start, planned_end, expected_ty)
            pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            pilot types_ok = v4_mir_types_compatible(mir_id, body_id, expected_ty, actual_ty)
            if not types_ok {
                pilot context = label + " argument " + word_from_int(lower_arg_idx + 1)
                v4_mir_add_type_mismatch_error(mir_id, expr_span, "method argument drift", label + " argument " + word_from_int(lower_arg_idx + 1) + " wants " + expected_ty + ", but " + actual_ty + " arrived", context, expected_ty, actual_ty)
            } else if v4_ty_type_contains_dyn(expected_ty) {
                v4_mir_set_rvalue_ty(mir_id, body_id, arg_rvalue, expected_ty)
            }
            args_payload = v4_mir_call_args_payload_append(args_payload, arg_rvalue)
        }
        lower_arg_idx += 1
    }

    pilot extra_idx = 0
    pilot extra_count = v4_mir_call_arg_segment_payload_count(extra_payload)
    repeat until extra_idx >= extra_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(extra_payload, extra_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
        }
        extra_idx += 1
    }
    give back args_payload
}

task v4_mir_check_ufcs_method_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, owner_ty: word, receiver_ty: word, method_name: word, method_ref: word, open_token: int, close_token: int) -> word {
    if method_ref == "" or open_token < 0 or close_token <= open_token {
        give back ""
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
    pilot method_id = v4_mir_method_ref_method_id(method_ref)
    pilot expected_count = v4_ty_impl_method_explicit_param_count(ty_id, hir_item, method_id)
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    pilot label = owner_ty + "::" + method_name
    if actual_count != expected_count + 1 {
        v4_mir_add_type_error(mir_id, expr_span, "UFCS method call arity drift", label + " takes receiver plus " + word_from_int(expected_count) + " explicit arguments but got " + word_from_int(actual_count))
    }

    pilot call_args = ""
    pilot first_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    pilot first_end = first_start
    if first_start < close_token {
        first_end = v4_mir_call_arg_end(stream_id, first_start, close_token)
        pilot receiver_label = v4_mir_call_arg_label(stream_id, first_start, first_end)
        pilot receiver_start = first_start
        if receiver_label != "" {
            receiver_start = v4_mir_call_arg_value_start(stream_id, first_start, first_end)
            if receiver_label != "self" {
                v4_mir_add_type_error(mir_id, expr_span, "UFCS receiver must be first", label + " expects the receiver first; " + receiver_label + " names a method argument before self")
            }
        }
        pilot receiver_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, receiver_start, first_end, receiver_ty)
        call_args = v4_mir_call_args_payload_append(call_args, receiver_rvalue)
        pilot actual_receiver_ty = v4_mir_rvalue_ty(mir_id, body_id, receiver_rvalue)
        if not v4_ty_types_compatible(receiver_ty, actual_receiver_ty) {
            v4_mir_add_type_mismatch_error(mir_id, expr_span, "UFCS receiver type mismatch", label + " receiver expects " + receiver_ty + " but got " + actual_receiver_ty, label + " receiver", receiver_ty, actual_receiver_ty)
        }
    }

    pilot planned_slots = v4_mir_call_arg_slot_payload_new(expected_count)
    pilot extra_payload = ""
    pilot named_seen = false
    pilot next_positional = 0
    pilot plan_arg_idx = 1
    pilot arg_start = v4_mir_skip_trivia(stream_id, first_end + 1)
    repeat until plan_arg_idx >= actual_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot arg_label = v4_mir_call_arg_label(stream_id, arg_start, arg_end)
        pilot value_start = arg_start
        if arg_label != "" {
            named_seen = true
            value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            pilot param_idx = v4_mir_method_param_index_for_name(mir_id, hir_item, method_id, arg_label)
            if param_idx < 0 {
                v4_mir_add_type_error(mir_id, expr_span, "unknown method argument", label + " has no parameter " + arg_label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else if v4_mir_call_arg_slot_assigned(planned_slots, param_idx) {
                v4_mir_add_type_error(mir_id, expr_span, "duplicate method argument", arg_label + " already has an assignment in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
            }
        } else {
            if named_seen {
                v4_mir_add_type_error(mir_id, expr_span, "positional method argument after named", "place positional arguments before named ones in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            } else if next_positional < expected_count {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                next_positional += 1
            } else {
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            }
        }
        plan_arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }

    pilot lower_arg_idx = 0
    repeat until lower_arg_idx >= expected_count {
        if named_seen and not v4_mir_call_arg_slot_assigned(planned_slots, lower_arg_idx) {
            pilot param_name = v4_ty_impl_method_explicit_param_name(ty_id, hir_item, method_id, lower_arg_idx)
            v4_mir_add_type_error(mir_id, expr_span, "missing method argument", label + " still needs parameter " + param_name)
        }
        pilot planned_start = v4_mir_call_arg_slot_start(planned_slots, lower_arg_idx)
        pilot planned_end = v4_mir_call_arg_slot_end(planned_slots, lower_arg_idx)
        if planned_start >= 0 and planned_end > planned_start {
            pilot expected_ty = v4_ty_impl_method_explicit_param_type_for_owner(ty_id, hir_item, method_id, lower_arg_idx, receiver_ty)
            pilot arg_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, planned_start, planned_end, expected_ty)
            pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            pilot types_ok = v4_mir_types_compatible(mir_id, body_id, expected_ty, actual_ty)
            if not types_ok {
                pilot context = label + " argument " + word_from_int(lower_arg_idx + 1)
                v4_mir_add_type_mismatch_error(mir_id, expr_span, "method argument drift", label + " argument " + word_from_int(lower_arg_idx + 1) + " wants " + expected_ty + ", but " + actual_ty + " arrived", context, expected_ty, actual_ty)
            } else if v4_ty_type_contains_dyn(expected_ty) {
                v4_mir_set_rvalue_ty(mir_id, body_id, arg_rvalue, expected_ty)
            }
            call_args = v4_mir_call_args_payload_append(call_args, arg_rvalue)
        }
        lower_arg_idx += 1
    }

    pilot extra_idx = 0
    pilot extra_count = v4_mir_call_arg_segment_payload_count(extra_payload)
    repeat until extra_idx >= extra_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(extra_payload, extra_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
        }
        extra_idx += 1
    }
    give back call_args
}

task v4_mir_check_bound_ufcs_method_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, owner_ty: word, receiver_ty: word, method_name: word, method_ref: word, open_token: int, close_token: int) -> word {
    if method_ref == "" or open_token < 0 or close_token <= open_token {
        give back ""
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot body_sig = v4_mir_body_signature_id(mir_id, body_id)
    pilot doctrine_sig = v4_mir_bound_method_ref_sig_id(method_ref)
    pilot method_id = v4_mir_bound_method_ref_method_id(method_ref)
    pilot doctrine_instance = v4_mir_bound_method_ref_doctrine_instance(method_ref)
    pilot expected_count = v4_ty_doctrine_method_explicit_param_count(ty_id, doctrine_sig, method_id)
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    pilot label = owner_ty + "::" + method_name
    if actual_count != expected_count + 1 {
        v4_mir_add_type_error(mir_id, expr_span, "UFCS method call arity drift", label + " takes receiver plus " + word_from_int(expected_count) + " explicit arguments but got " + word_from_int(actual_count))
    }

    pilot call_args = ""
    pilot first_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    pilot first_end = first_start
    if first_start < close_token {
        first_end = v4_mir_call_arg_end(stream_id, first_start, close_token)
        pilot receiver_label = v4_mir_call_arg_label(stream_id, first_start, first_end)
        pilot receiver_start = first_start
        if receiver_label != "" {
            receiver_start = v4_mir_call_arg_value_start(stream_id, first_start, first_end)
            if receiver_label != "self" {
                v4_mir_add_type_error(mir_id, expr_span, "UFCS receiver must be first", label + " expects the receiver first; " + receiver_label + " names a method argument before self")
            }
        }
        pilot receiver_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, receiver_start, first_end, receiver_ty)
        call_args = v4_mir_call_args_payload_append(call_args, receiver_rvalue)
        pilot actual_receiver_ty = v4_mir_rvalue_ty(mir_id, body_id, receiver_rvalue)
        pilot receiver_ok = v4_ty_types_compatible(receiver_ty, actual_receiver_ty)
        if not receiver_ok {
            v4_mir_add_type_mismatch_error(mir_id, expr_span, "UFCS receiver type mismatch", label + " receiver expects " + receiver_ty + " but got " + actual_receiver_ty, label + " receiver", receiver_ty, actual_receiver_ty)
        }
    }

    pilot planned_slots = v4_mir_call_arg_slot_payload_new(expected_count)
    pilot extra_payload = ""
    pilot named_seen = false
    pilot next_positional = 0
    pilot plan_arg_idx = 1
    pilot arg_start = v4_mir_skip_trivia(stream_id, first_end + 1)
    repeat until plan_arg_idx >= actual_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot arg_label = v4_mir_call_arg_label(stream_id, arg_start, arg_end)
        pilot value_start = arg_start
        if arg_label != "" {
            named_seen = true
            value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            pilot param_idx = v4_mir_bound_method_param_index_for_name(mir_id, doctrine_sig, method_id, arg_label)
            if param_idx < 0 {
                v4_mir_add_type_error(mir_id, expr_span, "unknown method argument", label + " has no parameter " + arg_label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else if v4_mir_call_arg_slot_assigned(planned_slots, param_idx) {
                v4_mir_add_type_error(mir_id, expr_span, "duplicate method argument", arg_label + " already has an assignment in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
            }
        } else {
            if named_seen {
                v4_mir_add_type_error(mir_id, expr_span, "positional method argument after named", "place positional arguments before named ones in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            } else if next_positional < expected_count {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                next_positional += 1
            } else {
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            }
        }
        plan_arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }

    pilot lower_arg_idx = 0
    repeat until lower_arg_idx >= expected_count {
        if named_seen and not v4_mir_call_arg_slot_assigned(planned_slots, lower_arg_idx) {
            pilot param_name = v4_ty_doctrine_method_explicit_param_name(ty_id, doctrine_sig, method_id, lower_arg_idx)
            v4_mir_add_type_error(mir_id, expr_span, "missing method argument", label + " still needs parameter " + param_name)
        }
        pilot planned_start = v4_mir_call_arg_slot_start(planned_slots, lower_arg_idx)
        pilot planned_end = v4_mir_call_arg_slot_end(planned_slots, lower_arg_idx)
        if planned_start >= 0 and planned_end > planned_start {
            pilot expected_ty = v4_ty_doctrine_method_explicit_param_type_for_bound(ty_id, doctrine_sig, method_id, lower_arg_idx, receiver_ty, doctrine_instance)
            pilot arg_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, planned_start, planned_end, expected_ty)
            pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            pilot types_ok = false
            if body_sig >= 0 {
                types_ok = v4_ty_types_compatible_in_signature(ty_id, body_sig, expected_ty, actual_ty)
            } else {
                types_ok = v4_ty_types_compatible(expected_ty, actual_ty)
            }
            if not types_ok {
                pilot context = label + " argument " + word_from_int(lower_arg_idx + 1)
                v4_mir_add_type_mismatch_error(mir_id, expr_span, "method argument drift", label + " argument " + word_from_int(lower_arg_idx + 1) + " wants " + expected_ty + ", but " + actual_ty + " arrived", context, expected_ty, actual_ty)
            } else if v4_ty_type_contains_dyn(expected_ty) {
                v4_mir_set_rvalue_ty(mir_id, body_id, arg_rvalue, expected_ty)
            }
            call_args = v4_mir_call_args_payload_append(call_args, arg_rvalue)
        }
        lower_arg_idx += 1
    }

    pilot extra_idx = 0
    pilot extra_count = v4_mir_call_arg_segment_payload_count(extra_payload)
    repeat until extra_idx >= extra_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(extra_payload, extra_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
        }
        extra_idx += 1
    }
    give back call_args
}

task v4_mir_check_bound_method_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, owner_ty: word, method_name: word, method_ref: word, open_token: int, close_token: int, call_glyph: word) -> word {
    if method_ref == "" or open_token < 0 or close_token <= open_token {
        give back ""
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot doctrine_sig = v4_mir_bound_method_ref_sig_id(method_ref)
    pilot method_id = v4_mir_bound_method_ref_method_id(method_ref)
    pilot expected_count = v4_ty_doctrine_method_explicit_param_count(ty_id, doctrine_sig, method_id)
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    pilot label = owner_ty + call_glyph + method_name
    if expected_count != actual_count {
        v4_mir_add_type_error(mir_id, expr_span, "method call arity drift", label + " takes " + word_from_int(expected_count) + " explicit arguments but got " + word_from_int(actual_count))
    }

    pilot body_sig = v4_mir_body_signature_id(mir_id, body_id)
    pilot planned_slots = v4_mir_call_arg_slot_payload_new(expected_count)
    pilot extra_payload = ""
    pilot named_seen = false
    pilot next_positional = 0
    pilot plan_arg_idx = 0
    pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    repeat until plan_arg_idx >= actual_count {
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot arg_label = v4_mir_call_arg_label(stream_id, arg_start, arg_end)
        pilot value_start = arg_start
        if arg_label != "" {
            named_seen = true
            value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            pilot param_idx = v4_mir_bound_method_param_index_for_name(mir_id, doctrine_sig, method_id, arg_label)
            if param_idx < 0 {
                v4_mir_add_type_error(mir_id, expr_span, "unknown method argument", label + " has no parameter " + arg_label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else if v4_mir_call_arg_slot_assigned(planned_slots, param_idx) {
                v4_mir_add_type_error(mir_id, expr_span, "duplicate method argument", arg_label + " already has an assignment in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, value_start, arg_end)
            } else {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, param_idx, value_start, arg_end)
            }
        } else {
            if named_seen {
                v4_mir_add_type_error(mir_id, expr_span, "positional method argument after named", "place positional arguments before named ones in " + label)
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            } else if next_positional < expected_count {
                planned_slots = v4_mir_call_arg_slot_set(planned_slots, expected_count, next_positional, arg_start, arg_end)
                next_positional += 1
            } else {
                extra_payload = v4_mir_call_arg_segment_payload_append(extra_payload, arg_start, arg_end)
            }
        }
        plan_arg_idx += 1
        arg_start = v4_mir_skip_trivia(stream_id, arg_end + 1)
    }

    pilot args_payload = ""
    pilot lower_arg_idx = 0
    repeat until lower_arg_idx >= expected_count {
        if named_seen and not v4_mir_call_arg_slot_assigned(planned_slots, lower_arg_idx) {
            pilot param_name = v4_ty_doctrine_method_explicit_param_name(ty_id, doctrine_sig, method_id, lower_arg_idx)
            v4_mir_add_type_error(mir_id, expr_span, "missing method argument", label + " still needs parameter " + param_name)
        }
        pilot planned_start = v4_mir_call_arg_slot_start(planned_slots, lower_arg_idx)
        pilot planned_end = v4_mir_call_arg_slot_end(planned_slots, lower_arg_idx)
        if planned_start >= 0 and planned_end > planned_start {
            pilot expected_ty = v4_ty_doctrine_method_explicit_param_type_for_bound(ty_id, doctrine_sig, method_id, lower_arg_idx, owner_ty, v4_mir_bound_method_ref_doctrine_instance(method_ref))
            pilot arg_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, planned_start, planned_end, expected_ty)
            pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
            pilot types_ok = false
            if body_sig >= 0 {
                types_ok = v4_ty_types_compatible_in_signature(ty_id, body_sig, expected_ty, actual_ty)
            } else {
                types_ok = v4_ty_types_compatible(expected_ty, actual_ty)
            }
            if not types_ok {
                pilot context = label + " argument " + word_from_int(lower_arg_idx + 1)
                v4_mir_add_type_mismatch_error(mir_id, expr_span, "method argument drift", label + " argument " + word_from_int(lower_arg_idx + 1) + " wants " + expected_ty + ", but " + actual_ty + " arrived", context, expected_ty, actual_ty)
            } else if v4_ty_type_contains_dyn(expected_ty) {
                v4_mir_set_rvalue_ty(mir_id, body_id, arg_rvalue, expected_ty)
            }
            args_payload = v4_mir_call_args_payload_append(args_payload, arg_rvalue)
        }
        lower_arg_idx += 1
    }

    pilot extra_idx = 0
    pilot extra_count = v4_mir_call_arg_segment_payload_count(extra_payload)
    repeat until extra_idx >= extra_count {
        pilot segment = v4_mir_call_arg_segment_payload_at(extra_payload, extra_idx)
        pilot extra_start = v4_mir_call_arg_segment_start(segment)
        pilot extra_end = v4_mir_call_arg_segment_end(segment)
        if extra_start >= 0 and extra_end > extra_start {
            pilot ignored = v4_mir_lower_expr(mir_id, body_id, stream_id, extra_start, extra_end)
        }
        extra_idx += 1
    }
    give back args_payload
}

task v4_mir_check_builtin_no_args(mir_id: int, body_id: int, stream_id: int, expr_span: word, method_label: word, open_token: int, close_token: int) -> bool {
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    if actual_count == 0 {
        give back true
    }
    v4_mir_add_type_error(mir_id, expr_span, "shared ownership method arity mismatch", method_label + " takes no arguments but got " + word_from_int(actual_count))
    v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
    give back false
}

task v4_mir_builtin_shared_method_identity_is_known(builtin_method: word) -> bool {
    give back builtin_method == v4_mir_builtin_shared_new or builtin_method == v4_mir_builtin_shared_clone or builtin_method == v4_mir_builtin_shared_downgrade or builtin_method == v4_mir_builtin_shared_borrow or builtin_method == v4_mir_builtin_shared_borrow_mut or builtin_method == v4_mir_builtin_shared_get_mut or builtin_method == v4_mir_builtin_weak_upgrade
}

task v4_mir_builtin_shared_method_identity_code(builtin_method: word) -> int {
    if builtin_method == v4_mir_builtin_shared_new { give back 1 }
    if builtin_method == v4_mir_builtin_shared_clone { give back 2 }
    if builtin_method == v4_mir_builtin_shared_downgrade { give back 3 }
    if builtin_method == v4_mir_builtin_shared_borrow { give back 4 }
    if builtin_method == v4_mir_builtin_shared_borrow_mut { give back 5 }
    if builtin_method == v4_mir_builtin_shared_get_mut { give back 6 }
    if builtin_method == v4_mir_builtin_weak_upgrade { give back 7 }
    give back 0
}

task v4_mir_builtin_shared_method_receiver_mode(builtin_method: word) -> word {
    if builtin_method == v4_mir_builtin_shared_borrow_mut or builtin_method == v4_mir_builtin_shared_get_mut {
        give back v4_ty_param_mode_lend_mut
    }
    if builtin_method == v4_mir_builtin_shared_clone or builtin_method == v4_mir_builtin_shared_downgrade or builtin_method == v4_mir_builtin_shared_borrow or builtin_method == v4_mir_builtin_weak_upgrade {
        give back v4_ty_param_mode_lend
    }
    give back ""
}

task v4_mir_nominal_builtin_shared_base(mir_id: int, type_text: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    if canonical != "" and canonical != v4_ty_unknown {
        type_text = canonical
    }
    if not v4_ty_is_generic_instance_type(type_text) {
        give back ""
    }
    pilot base_name = v4_ty_generic_base_name(type_text)
    if base_name != "Shared" and base_name != "Weak" and base_name != "SharedMut" {
        give back ""
    }
    -- Declared value types are nominal and shadow the prelude ownership carriers.
    if v4_ty_type_signature_id_for_name(ty_id, base_name) >= 0 {
        give back ""
    }
    give back base_name
}

task v4_mir_builtin_shared_method_surface_name(builtin_method: word) -> word {
    if builtin_method == v4_mir_builtin_shared_new { give back "new" }
    if builtin_method == v4_mir_builtin_shared_clone { give back "clone" }
    if builtin_method == v4_mir_builtin_shared_downgrade { give back "downgrade" }
    if builtin_method == v4_mir_builtin_shared_borrow { give back "borrow" }
    if builtin_method == v4_mir_builtin_shared_borrow_mut { give back "borrow_mut" }
    if builtin_method == v4_mir_builtin_shared_get_mut { give back "get_mut" }
    if builtin_method == v4_mir_builtin_weak_upgrade { give back "upgrade" }
    give back ""
}

task v4_mir_builtin_shared_method_result_type(builtin_method: word, owner_ty: word) -> word {
    pilot target_ty = v4_ty_shared_target_type(owner_ty)
    if builtin_method == v4_mir_builtin_shared_new or builtin_method == v4_mir_builtin_shared_clone {
        give back owner_ty
    }
    if builtin_method == v4_mir_builtin_shared_downgrade {
        give back v4_ty_weak_type(target_ty)
    }
    if builtin_method == v4_mir_builtin_shared_borrow {
        give back v4_ty_lend_type(target_ty, v4_ty_param_mode_lend)
    }
    if builtin_method == v4_mir_builtin_shared_borrow_mut {
        give back "result<" + v4_ty_shared_mut_type(target_ty) + ",BorrowError>"
    }
    if builtin_method == v4_mir_builtin_shared_get_mut {
        give back "maybe<" + v4_ty_lend_type(target_ty, v4_ty_param_mode_lend_mut) + ">"
    }
    if builtin_method == v4_mir_builtin_weak_upgrade {
        give back "maybe<" + v4_ty_shared_type(target_ty) + ">"
    }
    give back v4_ty_unknown
}

-- Exact identity plus structural checks keep restored or text-forged calls from
-- impersonating prelude Shared/Weak intrinsics in downstream ownership passes.
task v4_mir_rvalue_is_builtin_shared_method(mir_id: int, body_id: int, rvalue_id: int, builtin_method: word) -> bool {
    if not v4_mir_builtin_shared_method_identity_is_known(builtin_method) {
        give back false
    }
    if v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id) != builtin_method {
        give back false
    }
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call {
        give back false
    }
    if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) != 1 {
        give back false
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
    if arg_rvalue < 0 {
        give back false
    }

    if builtin_method == v4_mir_builtin_shared_new {
        if v4_mir_nominal_builtin_shared_base(mir_id, result_ty) != "Shared" {
            give back false
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) != result_ty + "::new" {
            give back false
        }
        pilot target_ty = v4_ty_shared_target_type(result_ty)
        pilot arg_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
        give back v4_ty_types_compatible(target_ty, arg_ty)
    }

    pilot receiver_mode = v4_mir_builtin_shared_method_receiver_mode(builtin_method)
    pilot receiver_kind = v4_mir_rvalue_lend
    if receiver_mode == v4_ty_param_mode_lend_mut {
        receiver_kind = v4_mir_rvalue_lend_mut
    }
    if v4_mir_rvalue_kind(mir_id, body_id, arg_rvalue) != receiver_kind {
        give back false
    }
    pilot receiver_loan_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
    if not v4_ty_is_lend_type(receiver_loan_ty) or v4_ty_lend_mode(receiver_loan_ty) != receiver_mode {
        give back false
    }
    pilot owner_ty = v4_ty_canonical_type(ty_id, v4_ty_lend_target_type(receiver_loan_ty))
    pilot expected_base = "Shared"
    if builtin_method == v4_mir_builtin_weak_upgrade {
        expected_base = "Weak"
    }
    if v4_mir_nominal_builtin_shared_base(mir_id, owner_ty) != expected_base {
        give back false
    }
    pilot receiver_rvalue = v4_mir_rvalue_lhs(mir_id, body_id, arg_rvalue)
    if receiver_rvalue < 0 {
        give back false
    }
    pilot receiver_ty = v4_ty_canonical_type(ty_id, v4_mir_rvalue_ty(mir_id, body_id, receiver_rvalue))
    if receiver_ty != owner_ty {
        give back false
    }
    pilot surface_name = v4_mir_builtin_shared_method_surface_name(builtin_method)
    if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) != owner_ty + "." + surface_name {
        give back false
    }
    give back result_ty == v4_mir_builtin_shared_method_result_type(builtin_method, owner_ty)
}

task v4_mir_lower_builtin_shared_new_arg(mir_id: int, body_id: int, stream_id: int, expr_span: word, owner_ty: word, target_ty: word, open_token: int, close_token: int) -> word {
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    if actual_count != 1 {
        v4_mir_add_type_error(mir_id, expr_span, "shared ownership method arity mismatch", owner_ty + "::new takes one value argument but got " + word_from_int(actual_count))
        v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
        give back ""
    }

    pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
    pilot value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
    pilot value_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, value_start, arg_end, target_ty)
    give back v4_mir_call_args_payload_append("", value_rvalue)
}

task v4_mir_builtin_shared_receiver_loan_payload(mir_id: int, body_id: int, receiver_rvalue: int, receiver_ty: word, mode: word, expr_span: word) -> word {
    if receiver_rvalue < 0 {
        give back ""
    }
    pilot loan_kind = v4_mir_rvalue_lend
    if mode == v4_ty_param_mode_lend_mut {
        loan_kind = v4_mir_rvalue_lend_mut
    }
    pilot receiver_text = v4_mir_rvalue_text(mir_id, body_id, receiver_rvalue)
    pilot loan_ty = v4_ty_lend_type(receiver_ty, mode)
    pilot loan_rvalue = v4_mir_add_rvalue(mir_id, body_id, loan_kind, receiver_text, receiver_text, receiver_rvalue, 0 - 1, expr_span, loan_ty)
    give back v4_mir_call_args_payload_append("", loan_rvalue)
}

task v4_mir_try_lower_builtin_shared_instance_method(mir_id: int, body_id: int, stream_id: int, receiver_rvalue: int, receiver_ty: word, method_name: word, open_token: int, close_token: int, expr_span: word, expr_text: word) -> int {
    if v4_mir_nominal_builtin_shared_base(mir_id, receiver_ty) == "" {
        give back 0 - 1
    }
    pilot target_ty = v4_ty_shared_target_type(receiver_ty)
    pilot result_ty = v4_ty_unknown
    pilot method_label = receiver_ty + "." + method_name
    pilot args_payload = ""
    pilot recognized = false
    pilot builtin_method = ""

    if v4_ty_is_shared_type(receiver_ty) {
        if method_name == "clone" {
            result_ty = receiver_ty
            args_payload = v4_mir_builtin_shared_receiver_loan_payload(mir_id, body_id, receiver_rvalue, receiver_ty, v4_ty_param_mode_lend, expr_span)
            recognized = true
            builtin_method = v4_mir_builtin_shared_clone
        } else if method_name == "downgrade" {
            result_ty = v4_ty_weak_type(target_ty)
            args_payload = v4_mir_builtin_shared_receiver_loan_payload(mir_id, body_id, receiver_rvalue, receiver_ty, v4_ty_param_mode_lend, expr_span)
            recognized = true
            builtin_method = v4_mir_builtin_shared_downgrade
        } else if method_name == "borrow" {
            result_ty = v4_ty_lend_type(target_ty, v4_ty_param_mode_lend)
            args_payload = v4_mir_builtin_shared_receiver_loan_payload(mir_id, body_id, receiver_rvalue, receiver_ty, v4_ty_param_mode_lend, expr_span)
            recognized = true
            builtin_method = v4_mir_builtin_shared_borrow
        } else if method_name == "borrow_mut" {
            result_ty = "result<" + v4_ty_shared_mut_type(target_ty) + ",BorrowError>"
            args_payload = v4_mir_builtin_shared_receiver_loan_payload(mir_id, body_id, receiver_rvalue, receiver_ty, v4_ty_param_mode_lend_mut, expr_span)
            recognized = true
            builtin_method = v4_mir_builtin_shared_borrow_mut
        } else if method_name == "get_mut" {
            result_ty = "maybe<" + v4_ty_lend_type(target_ty, v4_ty_param_mode_lend_mut) + ">"
            args_payload = v4_mir_builtin_shared_receiver_loan_payload(mir_id, body_id, receiver_rvalue, receiver_ty, v4_ty_param_mode_lend_mut, expr_span)
            recognized = true
            builtin_method = v4_mir_builtin_shared_get_mut
        }
    } else if v4_ty_is_weak_type(receiver_ty) {
        if method_name == "upgrade" {
            result_ty = "maybe<" + v4_ty_shared_type(target_ty) + ">"
            args_payload = v4_mir_builtin_shared_receiver_loan_payload(mir_id, body_id, receiver_rvalue, receiver_ty, v4_ty_param_mode_lend, expr_span)
            recognized = true
            builtin_method = v4_mir_builtin_weak_upgrade
        } else if method_name == "borrow" or method_name == "borrow_mut" or method_name == "get_mut" {
            v4_mir_add_type_error(mir_id, expr_span, "Weak must upgrade before borrow", receiver_ty + "." + method_name + " cannot produce a live view; call upgrade() and check the maybe<Shared<T>> first")
            result_ty = v4_ty_unknown
            recognized = true
        }
    }

    if recognized == false {
        give back 0 - 1
    }

    pilot args_valid = v4_mir_check_builtin_no_args(mir_id, body_id, stream_id, expr_span, method_label, open_token, close_token)
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, method_label, 0 - 1, 0 - 1, expr_span, result_ty)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
    if args_valid and builtin_method != "" {
        v4_mir_set_rvalue_builtin_method(mir_id, body_id, call_rvalue, builtin_method)
    }
    give back call_rvalue
}

task v4_mir_try_lower_builtin_shared_associated_method(mir_id: int, body_id: int, stream_id: int, owner_ty: word, method_name: word, open_token: int, close_token: int, expr_span: word, expr_text: word) -> int {
    if v4_mir_nominal_builtin_shared_base(mir_id, owner_ty) != "Shared" {
        give back 0 - 1
    }
    if method_name != "new" {
        give back 0 - 1
    }

    pilot target_ty = v4_ty_shared_target_type(owner_ty)
    pilot owner_generic_rejected = v4_mir_reject_lend_storage_type(mir_id, expr_span, owner_ty + "::new", "derives owner generic", "T", target_ty)
    pilot args_payload = v4_mir_lower_builtin_shared_new_arg(mir_id, body_id, stream_id, expr_span, owner_ty, target_ty, open_token, close_token)
    pilot result_ty = owner_ty
    if owner_generic_rejected {
        result_ty = v4_ty_unknown
    }
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, owner_ty + "::new", 0 - 1, 0 - 1, expr_span, result_ty)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
    if not owner_generic_rejected and v4_mir_call_arg_count(stream_id, open_token, close_token) == 1 {
        v4_mir_set_rvalue_builtin_method(mir_id, body_id, call_rvalue, v4_mir_builtin_shared_new)
    }
    give back call_rvalue
}

task v4_mir_raw_pointer_method_arg_count_error(mir_id: int, body_id: int, stream_id: int, expr_span: word, receiver_ty: word, method_name: word, open_token: int, close_token: int, expected_count: int) -> void {
    pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
    if actual_count == expected_count {
        give back
    }
    pilot label = receiver_ty + "." + method_name + "()"
    if method_name == "is_null" and expected_count == 0 {
        v4_mir_add_type_error(mir_id, expr_span, "is_null takes no arguments", receiver_ty + ".is_null() must be called without arguments")
        v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
        give back
    }
    if expected_count == 0 {
        v4_mir_add_type_error(mir_id, expr_span, "raw-pointer method arity mismatch", label + " takes no arguments but got " + word_from_int(actual_count))
    } else {
        v4_mir_add_type_error(mir_id, expr_span, "raw-pointer method arity mismatch", label + " takes " + word_from_int(expected_count) + " argument but got " + word_from_int(actual_count))
    }
    v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
}

task v4_mir_method_type_arg_open(stream_id: int, method_token: int, open_token: int) -> int {
    pilot next_token = v4_mir_skip_trivia(stream_id, method_token + 1)
    if next_token < open_token and v4_lex_token_value(stream_id, next_token) == "<" {
        give back next_token
    }
    give back 0 - 1
}

task v4_mir_raw_pointer_method_type_arg_open(stream_id: int, method_token: int, open_token: int) -> int {
    give back v4_mir_method_type_arg_open(stream_id, method_token, open_token)
}

task v4_mir_raw_pointer_method_type_arg_close(stream_id: int, type_open: int, open_token: int) -> int {
    pilot idx = type_open
    pilot depth = 0
    repeat until idx >= open_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "<" {
                depth += 1
            } else if value == ">" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_reject_method_type_args(mir_id: int, stream_id: int, expr_span: word, owner_ty: word, method_name: word, call_glyph: word, method_token: int, open_token: int) -> bool {
    pilot type_open = v4_mir_method_type_arg_open(stream_id, method_token, open_token)
    if type_open < 0 {
        give back false
    }

    pilot type_text = "..."
    pilot type_close = v4_mir_raw_pointer_method_type_arg_close(stream_id, type_open, open_token)
    if type_close > type_open {
        type_text = v4_mir_compact_type_text(v4_ty_type_text(stream_id, type_open + 1, type_close))
    }
    v4_mir_add_type_error(mir_id, expr_span, "method takes no type arguments", owner_ty + call_glyph + method_name + " is not a generic method; remove <" + type_text + "> before the call parentheses")
    give back true
}

task v4_mir_cast_target_starts_like_type(stream_id: int, target_start: int, type_close: int) -> bool {
    if target_start < 0 or target_start >= type_close {
        give back false
    }
    pilot token_type = v4_lex_token_type(stream_id, target_start)
    if token_type == v4_tok_ident or token_type == v4_tok_keyword or token_type == v4_tok_lifetime {
        give back true
    }
    pilot token_value = v4_lex_token_value(stream_id, target_start)
    give back token_value == "*" or token_value == "(" or token_value == "["
}

task v4_mir_body_impl_hir_item(mir_id: int, body_id: int) -> int {
    if body_id < 0 {
        give back 0 - 1
    }
    pilot body_def = v4_mir_body_def(mir_id, body_id)
    if not body_def.contains("::Method::") {
        give back 0 - 1
    }
    pilot hash_pos = 0 - 1
    pilot idx = 0
    repeat until idx >= body_def.length() {
        if body_def.char_at(idx) == "#" {
            hash_pos = idx
        }
        idx += 1
    }
    if hash_pos < 0 or hash_pos + 1 >= body_def.length() {
        give back 0 - 1
    }
    pilot end_pos = hash_pos + 1
    repeat until end_pos >= body_def.length() or body_def.char_at(end_pos) == ":" {
        end_pos += 1
    }
    if end_pos <= hash_pos + 1 {
        give back 0 - 1
    }
    give back word_to_int(v4_slice(body_def, hash_pos + 1, end_pos))
}

task v4_mir_type_pattern_declares_type_generic_name(pattern_ty: word, type_name: word) -> bool {
    if pattern_ty == "" or type_name == "" or v4_ty_is_lifetime_name(pattern_ty) {
        give back false
    }
    if pattern_ty == type_name {
        give back true
    }
    if v4_ty_is_lend_type(pattern_ty) {
        give back v4_mir_type_pattern_declares_type_generic_name(v4_ty_lend_target_type(pattern_ty), type_name)
    }
    if v4_ty_is_raw_pointer_type(pattern_ty) {
        give back v4_mir_type_pattern_declares_type_generic_name(v4_ty_raw_pointer_target_type(pattern_ty), type_name)
    }
    if v4_ty_is_tuple_type(pattern_ty) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(pattern_ty)
        repeat until slot_id >= slot_count {
            if v4_mir_type_pattern_declares_type_generic_name(v4_ty_tuple_slot_type(pattern_ty, slot_id), type_name) {
                give back true
            }
            slot_id += 1
        }
        give back false
    }
    if v4_ty_is_fixed_array_type(pattern_ty) {
        give back v4_mir_type_pattern_declares_type_generic_name(v4_ty_fixed_array_element_type(pattern_ty), type_name)
    }
    if v4_ty_is_generic_instance_type(pattern_ty) {
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(pattern_ty)
        repeat until arg_id >= arg_count {
            if v4_mir_type_pattern_declares_type_generic_name(v4_ty_generic_arg(pattern_ty, arg_id), type_name) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_mir_body_impl_declares_type_generic_name(mir_id: int, body_id: int, type_name: word) -> bool {
    pilot hir_item = v4_mir_body_impl_hir_item(mir_id, body_id)
    if hir_item < 0 {
        give back false
    }
    give back v4_mir_type_pattern_declares_type_generic_name(v4_ty_impl_target_type_from_hir(v4_mir_ty_id(mir_id), hir_item), type_name)
}

task v4_mir_body_declares_type_generic_name(mir_id: int, body_id: int, type_name: word) -> bool {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id >= 0 and v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_name) {
        give back true
    }
    give back v4_mir_body_impl_declares_type_generic_name(mir_id, body_id, type_name)
}

task v4_mir_type_reference_is_declared_for_body(mir_id: int, body_id: int, sig_id: int, type_text: word) -> bool {
    if type_text == "" or type_text == v4_ty_unknown {
        give back false
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    if sig_id >= 0 and v4_ty_signature_declares_type_generic_name(ty_id, sig_id, type_text) {
        give back true
    }
    if v4_mir_body_impl_declares_type_generic_name(mir_id, body_id, type_text) {
        give back true
    }
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    if canonical != "" and canonical != v4_ty_unknown {
        type_text = canonical
    }

    if v4_ty_is_lifetime_name(type_text) {
        give back false
    }
    if v4_ty_is_lend_type(type_text) {
        give back v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, v4_ty_lend_target_type(type_text))
    }
    if v4_ty_is_raw_pointer_type(type_text) {
        give back v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, v4_ty_raw_pointer_target_type(type_text))
    }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot_id = 0
        pilot slot_count = v4_ty_tuple_slot_count(type_text)
        repeat until slot_id >= slot_count {
            if not v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, v4_ty_tuple_slot_type(type_text, slot_id)) {
                give back false
            }
            slot_id += 1
        }
        give back true
    }
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, v4_ty_fixed_array_element_type(type_text))
    }
    if v4_ty_is_dyn_type(type_text) {
        give back v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, v4_ty_dyn_doctrine_name(type_text))
    }

    if v4_ty_is_generic_instance_type(type_text) {
        pilot base_name = v4_ty_generic_base_name(type_text)
        if not v4_mir_is_type_like_owner(ty_id, base_name) {
            give back false
        }
        pilot arg_id = 0
        pilot arg_count = v4_ty_generic_arg_count(type_text)
        repeat until arg_id >= arg_count {
            pilot arg_text = v4_ty_generic_arg(type_text, arg_id)
            if v4_ty_is_lifetime_name(arg_text) {
                if not v4_ty_generic_slot_accepts_lifetime(ty_id, base_name, arg_id) {
                    give back false
                }
            } else if not v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, arg_text) {
                give back false
            }
            arg_id += 1
        }
        give back true
    }
    give back v4_mir_is_type_like_owner(ty_id, type_text)
}

task v4_mir_type_reference_is_declared(mir_id: int, sig_id: int, type_text: word) -> bool {
    give back v4_mir_type_reference_is_declared_for_body(mir_id, 0 - 1, sig_id, type_text)
}

task v4_mir_validate_raw_pointer_cast_target(mir_id: int, body_id: int, stream_id: int, target_start: int, type_close: int, target_pointee: word, expr_span: word) -> bool {
    if not v4_mir_cast_target_starts_like_type(stream_id, target_start, type_close) {
        v4_mir_add_type_error(mir_id, expr_span, "cast target type is invalid", ".cast<T>() needs a type name, raw pointer, tuple, fixed array, or generic instance between the angle brackets")
        give back false
    }

    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot valid = true
    if not v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, target_pointee) {
        v4_mir_add_type_error(mir_id, expr_span, "cast target type is invalid", target_pointee + " is not a declared value type Yuuko can track through a raw-pointer cast")
        valid = false
    }
    if not v4_mir_validate_type_contract(mir_id, sig_id, expr_span, target_pointee, "cast target type is invalid", "raw-pointer cast target " + target_pointee) {
        valid = false
    }
    give back valid
}

task v4_mir_try_lower_builtin_raw_pointer_instance_method(mir_id: int, body_id: int, stream_id: int, receiver_rvalue: int, receiver_ty: word, method_name: word, method_token: int, open_token: int, close_token: int, expr_span: word, expr_text: word) -> int {
    if v4_ty_is_raw_pointer_type(receiver_ty) == false {
        give back 0 - 1
    }

    if method_name == "is_null" {
        v4_mir_reject_method_type_args(mir_id, stream_id, expr_span, receiver_ty, method_name, ".", method_token, open_token)
        v4_mir_raw_pointer_method_arg_count_error(mir_id, body_id, stream_id, expr_span, receiver_ty, method_name, open_token, close_token, 0)
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_is_null, receiver_rvalue, 0 - 1, expr_span, v4_ty_bool)
    }

    if method_name == "read" {
        v4_mir_reject_method_type_args(mir_id, stream_id, expr_span, receiver_ty, method_name, ".", method_token, open_token)
        v4_mir_raw_pointer_method_arg_count_error(mir_id, body_id, stream_id, expr_span, receiver_ty, method_name, open_token, close_token, 0)
        v4_mir_check_unary_type(mir_id, expr_span, v4_mir_unary_deref, receiver_ty)
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_deref, receiver_rvalue, 0 - 1, expr_span, v4_ty_raw_pointer_target_type(receiver_ty))
    }

    if method_name == "write" {
        v4_mir_reject_method_type_args(mir_id, stream_id, expr_span, receiver_ty, method_name, ".", method_token, open_token)
        pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
        if actual_count != 1 {
            v4_mir_raw_pointer_method_arg_count_error(mir_id, body_id, stream_id, expr_span, receiver_ty, method_name, open_token, close_token, 1)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, v4_mir_call_raw_ptr_write, receiver_rvalue, 0 - 1, expr_span, v4_ty_void)
        }

        pilot pointee_ty = v4_ty_raw_pointer_target_type(receiver_ty)
        if v4_ty_is_mutable_raw_pointer_type(receiver_ty) == false {
            v4_mir_add_type_error(mir_id, expr_span, "raw-pointer write needs *mut T", "got " + receiver_ty + "; only *mut T pointers can be written through, *const T and *T are read-only")
        }
        if v4_mir_inside_trust_me() == false {
            v4_mir_add_type_error(mir_id, expr_span, "raw-pointer deref needs trust me block", "wrap the write in a trust me block; bible section 16.4 forbids writing through raw pointers outside trust me")
        } else {
            v4_mir_check_trust_honor(mir_id, expr_span, "raw-pointer write", "pilot")
        }

        pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
        pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
        pilot value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
        pilot value_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, value_start, arg_end, pointee_ty)
        pilot value_ty = v4_mir_rvalue_ty(mir_id, body_id, value_rvalue)
        if not v4_ty_types_compatible(pointee_ty, value_ty) {
            v4_mir_add_type_mismatch_error(mir_id, expr_span, "raw-pointer write type mismatch", receiver_ty + ".write expects " + pointee_ty + " but got " + value_ty, receiver_ty + ".write argument", pointee_ty, value_ty)
        }

        pilot args_payload = v4_mir_call_args_payload_append("", receiver_rvalue)
        args_payload = v4_mir_call_args_payload_append(args_payload, value_rvalue)
        pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, v4_mir_call_raw_ptr_write, receiver_rvalue, 0 - 1, expr_span, v4_ty_void)
        v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
        give back call_rvalue
    }

    if method_name == "offset" {
        pilot type_open = v4_mir_raw_pointer_method_type_arg_open(stream_id, method_token, open_token)
        if type_open >= 0 {
            v4_mir_add_type_error(mir_id, expr_span, "offset takes no type arguments", receiver_ty + ".offset(n) moves by element count; pass the offset as the only value argument")
        }
        pilot offset_target_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_raw_pointer_target_type(receiver_ty))
        if offset_target_ty == v4_ty_void {
            v4_mir_add_type_error(mir_id, expr_span, "offset target type must not be void", receiver_ty + ".offset(n) needs a sized pointee; cast to *const tiny or *mut tiny first for byte-wise FFI pointer arithmetic")
        } else if offset_target_ty == v4_ty_never {
            v4_mir_add_type_error(mir_id, expr_span, "offset target type must not be never", receiver_ty + ".offset(n) needs an inhabited pointee layout; never has no runtime element Yuuko can advance across")
        } else {
            pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
            if sig_id >= 0 and v4_ty_signature_declares_type_generic_name(v4_mir_ty_id(mir_id), sig_id, offset_target_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "offset target type must be concrete", receiver_ty + ".offset(n) needs a concrete pointee layout before LLVM GEP lowering; generic pointee " + offset_target_ty + " is not sized in V4 yet")
            } else if v4_mir_body_impl_declares_type_generic_name(mir_id, body_id, offset_target_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "offset target type must be concrete", receiver_ty + ".offset(n) needs a concrete pointee layout before LLVM GEP lowering; impl generic pointee " + offset_target_ty + " is not sized in V4 yet")
            } else if not v4_mir_type_reference_is_declared_for_body(mir_id, body_id, sig_id, offset_target_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "offset target type must be declared", offset_target_ty + " is not a declared value type Yuuko can lower into an LLVM GEP element")
            } else if offset_target_ty == v4_ty_word or offset_target_ty == v4_ty_big or v4_ty_is_generic_instance_type(offset_target_ty) or v4_ty_is_tuple_type(offset_target_ty) or v4_ty_is_fixed_array_type(offset_target_ty) or v4_ty_shape_signature_id_for_name(v4_mir_ty_id(mir_id), offset_target_ty) >= 0 or v4_ty_is_route_type(v4_mir_ty_id(mir_id), offset_target_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "offset target type must be scalar", receiver_ty + ".offset(n) currently supports scalar pointees only; cast to *const tiny or wait for aggregate layout-aware GEP lowering")
            }
        }

        pilot actual_count = v4_mir_call_arg_count(stream_id, open_token, close_token)
        pilot offset_rvalue = 0 - 1
        if actual_count != 1 {
            v4_mir_add_type_error(mir_id, expr_span, "offset takes one argument", receiver_ty + ".offset(n) needs exactly one integer offset argument")
            v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
        } else {
            pilot arg_start = v4_mir_skip_trivia(stream_id, open_token + 1)
            pilot arg_end = v4_mir_call_arg_end(stream_id, arg_start, close_token)
            pilot value_start = v4_mir_call_arg_value_start(stream_id, arg_start, arg_end)
            offset_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, value_start, arg_end, v4_ty_int)
            pilot offset_ty = v4_mir_rvalue_ty(mir_id, body_id, offset_rvalue)
            if v4_ty_is_known(offset_ty) and offset_ty != v4_ty_int and offset_ty != v4_ty_uint {
                v4_mir_add_type_error(mir_id, expr_span, "offset argument must be int or uint", receiver_ty + ".offset(n) lowers to an LLVM GEP index, so V4 currently accepts only int or uint offsets; got " + offset_ty)
            }
        }

        if v4_mir_inside_trust_me() == false {
            v4_mir_add_type_error(mir_id, expr_span, "raw-pointer offset needs trust me block", "wrap the .offset call in a trust me block; bible section 16.4 forbids pointer arithmetic outside trust me")
        } else {
            v4_mir_check_trust_honor(mir_id, expr_span, "raw-pointer offset", "ace")
        }

        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_offset, receiver_rvalue, offset_rvalue, expr_span, receiver_ty)
    }

    if method_name == "cast" {
        pilot type_open = v4_mir_raw_pointer_method_type_arg_open(stream_id, method_token, open_token)
        if type_open < 0 {
            v4_mir_add_type_error(mir_id, expr_span, "cast needs a target type parameter", "write " + receiver_ty + ".cast<T>() with the pointee type between angle brackets")
            v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_cast, receiver_rvalue, 0 - 1, expr_span, v4_ty_unknown)
        }

        pilot type_close = v4_mir_raw_pointer_method_type_arg_close(stream_id, type_open, open_token)
        if type_close < 0 {
            v4_mir_add_type_error(mir_id, expr_span, "cast needs a target type parameter", "close the cast target with '>' before the call parentheses")
            v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_cast, receiver_rvalue, 0 - 1, expr_span, v4_ty_unknown)
        }
        pilot after_type_close = v4_mir_skip_trivia(stream_id, type_close + 1)
        if after_type_close != open_token {
            v4_mir_add_type_error(mir_id, expr_span, "cast target syntax is invalid", "call .cast<T>() directly after the target type; remove tokens between '>' and '('")
            v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_cast, receiver_rvalue, 0 - 1, expr_span, v4_ty_unknown)
        }

        pilot target_start = v4_mir_skip_trivia(stream_id, type_open + 1)
        if target_start >= type_close {
            v4_mir_add_type_error(mir_id, expr_span, "cast needs a target type parameter", "supply a non-empty pointee type, e.g. " + receiver_ty + ".cast<tiny>()")
            v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, close_token)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_cast, receiver_rvalue, 0 - 1, expr_span, v4_ty_unknown)
        }

        pilot target_pointee = v4_mir_compact_type_text(v4_ty_type_text(stream_id, target_start, type_close))
        target_pointee = v4_ty_canonical_type(v4_mir_ty_id(mir_id), target_pointee)
        pilot result_ty = v4_ty_raw_pointer_with_target_type(receiver_ty, target_pointee)
        pilot valid_cast_target = v4_mir_validate_raw_pointer_cast_target(mir_id, body_id, stream_id, target_start, type_close, target_pointee, expr_span)
        if not valid_cast_target {
            result_ty = v4_ty_unknown
        }
        v4_mir_raw_pointer_method_arg_count_error(mir_id, body_id, stream_id, expr_span, receiver_ty, method_name, open_token, close_token, 0)

        if v4_mir_inside_trust_me() == false {
            v4_mir_add_type_error(mir_id, expr_span, "raw-pointer cast needs trust me block", "wrap the .cast call in a trust me block; bible section 16.4 forbids retyping raw pointers outside trust me")
        } else {
            v4_mir_check_trust_honor(mir_id, expr_span, "raw-pointer cast", "ace")
        }

        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, v4_mir_unary_ptr_cast, receiver_rvalue, 0 - 1, expr_span, result_ty)
    }

    give back 0 - 1
}

task v4_mir_try_lower_instance_method_call(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, last) != ")" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_open_paren_token(stream_id, first, last)
    if open_token <= first or open_token > last {
        give back 0 - 1
    }

    pilot dot_token = v4_mir_find_top_level_token(stream_id, first, open_token, ".")
    if dot_token <= first {
        give back 0 - 1
    }

    pilot method_token = v4_mir_skip_trivia(stream_id, dot_token + 1)
    if method_token >= open_token {
        give back 0 - 1
    }

    pilot receiver_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, first, dot_token)
    pilot receiver_ty = v4_mir_rvalue_ty(mir_id, body_id, receiver_rvalue)
    pilot method_name = v4_lex_token_value(stream_id, method_token)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    pilot raw_pointer_builtin = v4_mir_try_lower_builtin_raw_pointer_instance_method(mir_id, body_id, stream_id, receiver_rvalue, receiver_ty, method_name, method_token, open_token, last, expr_span, expr_text)
    if raw_pointer_builtin >= 0 {
        give back raw_pointer_builtin
    }
    v4_mir_reject_method_type_args(mir_id, stream_id, expr_span, receiver_ty, method_name, ".", method_token, open_token)
    pilot shared_builtin = v4_mir_try_lower_builtin_shared_instance_method(mir_id, body_id, stream_id, receiver_rvalue, receiver_ty, method_name, open_token, last, expr_span, expr_text)
    if shared_builtin >= 0 {
        give back shared_builtin
    }
    pilot field_callback_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_shape_field_type_for_name(v4_mir_ty_id(mir_id), receiver_ty, method_name))
    if v4_ty_is_surface_extern_function_pointer_type(field_callback_ty) {
        pilot field_place = v4_mir_lower_place(mir_id, body_id, stream_id, first, open_token)
        pilot field_text = v4_mir_place_text(mir_id, body_id, field_place)
        pilot field_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_place, field_text, field_text, field_place, 0 - 1, expr_span, field_callback_ty)
        pilot args_payload = v4_mir_check_callback_call_args(mir_id, body_id, stream_id, expr_span, field_text, field_callback_ty, open_token, last)
        pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
        pilot result_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_function_type_return_text(field_callback_ty))
        pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, field_text, field_rvalue, 0 - 1, expr_span, result_ty)
        v4_mir_set_rvalue_abi(mir_id, body_id, call_rvalue, v4_ty_function_type_call_abi(field_callback_ty))
        v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
        give back call_rvalue
    }
    pilot method_ref = v4_mir_find_method_ref(mir_id, receiver_ty, method_name, true)
    pilot bound_method_ref = ""
    pilot bound_method_ambiguous = false
    pilot any_ref = ""
    pilot explicit_args_payload = ""
    pilot owner_generics_rejected = false
    if method_ref == "" {
        bound_method_ref = v4_mir_find_dyn_method_ref(mir_id, receiver_ty, method_name, true)
        if bound_method_ref == "" {
            pilot bound_candidates = v4_mir_bound_method_candidate_count(mir_id, body_id, receiver_ty, method_name, true)
            if bound_candidates > 1 {
                v4_mir_add_bound_method_ambiguity(mir_id, body_id, expr_span, receiver_ty, method_name, true, ".")
                v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, last)
                bound_method_ambiguous = true
            } else {
                bound_method_ref = v4_mir_find_bound_method_ref(mir_id, body_id, receiver_ty, method_name, true)
            }
        }
        if bound_method_ref != "" {
            explicit_args_payload = v4_mir_check_bound_method_args(mir_id, body_id, stream_id, expr_span, receiver_ty, method_name, bound_method_ref, open_token, last, ".")
        } else if not bound_method_ambiguous {
            any_ref = v4_mir_find_any_method_ref(mir_id, receiver_ty, method_name)
            if any_ref != "" {
                v4_mir_add_type_error(mir_id, expr_span, "method wants associated syntax", receiver_ty + "::" + method_name + " is static; call it with :: instead of a receiver")
            } else {
                v4_mir_add_type_error(mir_id, expr_span, "receiver has no matching method", receiver_ty + " offers no method " + method_name)
            }
        }
    } else {
        owner_generics_rejected = v4_mir_reject_lend_bearing_impl_owner_generics(mir_id, expr_span, receiver_ty + "." + method_name, receiver_ty, method_ref)
        explicit_args_payload = v4_mir_check_method_args(mir_id, body_id, stream_id, expr_span, receiver_ty, method_name, method_ref, open_token, last, ".")
    }

    pilot result_ty = v4_mir_method_return_type(mir_id, receiver_ty, method_ref)
    if method_ref == "" and bound_method_ref != "" {
        result_ty = v4_mir_bound_method_return_type(mir_id, receiver_ty, bound_method_ref)
    }
    if method_ref == "" and any_ref != "" {
        result_ty = v4_mir_method_return_type(mir_id, receiver_ty, any_ref)
    }
    if owner_generics_rejected {
        result_ty = v4_ty_unknown
    }
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, receiver_ty + "." + method_name, receiver_rvalue, 0 - 1, expr_span, result_ty)
    pilot call_args = v4_mir_call_args_payload_append("", receiver_rvalue)
    call_args = v4_mir_call_args_payload_concat(call_args, explicit_args_payload)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, call_args)
    give back call_rvalue
}

task v4_mir_try_lower_associated_method_call(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, last) != ")" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_open_paren_token(stream_id, first, last)
    if open_token <= first or open_token > last {
        give back 0 - 1
    }

    pilot scope_token = v4_mir_find_top_level_token(stream_id, first, open_token, "::")
    if scope_token <= first {
        give back 0 - 1
    }

    pilot owner_ty = v4_ty_type_text(stream_id, first, scope_token)
    pilot lookup_owner_ty = owner_ty
    pilot body_sig = v4_mir_body_signature_id(mir_id, body_id)
    if not v4_mir_body_declares_type_generic_name(mir_id, body_id, owner_ty) {
        pilot canonical_owner_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), owner_ty)
        if canonical_owner_ty != "" and canonical_owner_ty != v4_ty_unknown {
            lookup_owner_ty = canonical_owner_ty
        }
    }
    if not v4_mir_type_reference_is_declared_for_body(mir_id, body_id, body_sig, owner_ty) {
        give back 0 - 1
    }
    pilot method_token = v4_mir_skip_trivia(stream_id, scope_token + 1)
    if method_token >= open_token {
        give back 0 - 1
    }
    pilot method_name = v4_lex_token_value(stream_id, method_token)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    v4_mir_reject_method_type_args(mir_id, stream_id, expr_span, owner_ty, method_name, "::", method_token, open_token)
    pilot shared_builtin = v4_mir_try_lower_builtin_shared_associated_method(mir_id, body_id, stream_id, lookup_owner_ty, method_name, open_token, last, expr_span, expr_text)
    if shared_builtin >= 0 {
        give back shared_builtin
    }
    pilot method_ref = v4_mir_find_method_ref(mir_id, lookup_owner_ty, method_name, false)
    pilot bound_method_ref = ""
    pilot bound_method_ambiguous = false
    pilot ufcs_ref = ""
    pilot bound_ufcs_ref = ""
    pilot bound_ufcs_ambiguous = false
    pilot explicit_args_payload = ""
    pilot receiver_rvalue = 0 - 1
    pilot owner_generics_rejected = false
    if method_ref == "" {
        bound_method_ref = v4_mir_find_dyn_method_ref(mir_id, lookup_owner_ty, method_name, false)
        if bound_method_ref == "" {
            pilot bound_candidates = v4_mir_bound_method_candidate_count(mir_id, body_id, lookup_owner_ty, method_name, false)
            if bound_candidates > 1 {
                v4_mir_add_bound_method_ambiguity(mir_id, body_id, expr_span, lookup_owner_ty, method_name, false, "::")
                v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, last)
                bound_method_ambiguous = true
            } else {
                bound_method_ref = v4_mir_find_bound_method_ref(mir_id, body_id, lookup_owner_ty, method_name, false)
            }
        }
        if bound_method_ref != "" {
            explicit_args_payload = v4_mir_check_bound_method_args(mir_id, body_id, stream_id, expr_span, lookup_owner_ty, method_name, bound_method_ref, open_token, last, "::")
        } else if not bound_method_ambiguous {
            ufcs_ref = v4_mir_find_method_ref(mir_id, lookup_owner_ty, method_name, true)
            if ufcs_ref != "" {
                owner_generics_rejected = v4_mir_reject_lend_bearing_impl_owner_generics(mir_id, expr_span, owner_ty + "::" + method_name, lookup_owner_ty, ufcs_ref)
                explicit_args_payload = v4_mir_check_ufcs_method_args(mir_id, body_id, stream_id, expr_span, owner_ty, lookup_owner_ty, method_name, ufcs_ref, open_token, last)
            } else {
                bound_ufcs_ref = v4_mir_find_dyn_method_ref(mir_id, lookup_owner_ty, method_name, true)
                if bound_ufcs_ref == "" {
                    pilot bound_ufcs_candidates = v4_mir_bound_method_candidate_count(mir_id, body_id, lookup_owner_ty, method_name, true)
                    if bound_ufcs_candidates > 1 {
                        v4_mir_add_bound_method_ambiguity(mir_id, body_id, expr_span, lookup_owner_ty, method_name, true, "::")
                        v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, open_token, last)
                        bound_ufcs_ambiguous = true
                    } else {
                        bound_ufcs_ref = v4_mir_find_bound_method_ref(mir_id, body_id, lookup_owner_ty, method_name, true)
                    }
                }
                if bound_ufcs_ref != "" {
                    explicit_args_payload = v4_mir_check_bound_ufcs_method_args(mir_id, body_id, stream_id, expr_span, owner_ty, lookup_owner_ty, method_name, bound_ufcs_ref, open_token, last)
                } else if not bound_ufcs_ambiguous {
                    v4_mir_add_type_error(mir_id, expr_span, "associated method lookup failed", owner_ty + " exposes no static method " + method_name)
                }
            }
            if v4_mir_call_args_payload_count(explicit_args_payload) > 0 {
                receiver_rvalue = v4_mir_call_args_payload_at(explicit_args_payload, 0)
            }
        }
    } else {
        owner_generics_rejected = v4_mir_reject_lend_bearing_impl_owner_generics(mir_id, expr_span, owner_ty + "::" + method_name, lookup_owner_ty, method_ref)
        explicit_args_payload = v4_mir_check_method_args(mir_id, body_id, stream_id, expr_span, owner_ty, method_name, method_ref, open_token, last, "::")
    }

    pilot result_ty = v4_mir_method_return_type(mir_id, lookup_owner_ty, method_ref)
    if method_ref == "" and bound_method_ref != "" {
        result_ty = v4_mir_bound_method_return_type(mir_id, lookup_owner_ty, bound_method_ref)
    }
    if method_ref == "" and ufcs_ref != "" {
        result_ty = v4_mir_method_return_type(mir_id, lookup_owner_ty, ufcs_ref)
    }
    if method_ref == "" and bound_ufcs_ref != "" {
        result_ty = v4_mir_bound_method_return_type(mir_id, lookup_owner_ty, bound_ufcs_ref)
    }
    if owner_generics_rejected {
        result_ty = v4_ty_unknown
    }
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, owner_ty + "::" + method_name, receiver_rvalue, 0 - 1, expr_span, result_ty)
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, explicit_args_payload)
    give back call_rvalue
}

task v4_mir_shape_ctor_name_end(stream_id: int, start_token: int, open_token: int) -> int {
    pilot idx = start_token
    pilot last_name = 0 - 1
    repeat until idx >= open_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if tok_type == v4_tok_ident or tok_type == v4_tok_keyword {
                last_name = idx
            } else if val == "::" {
                -- continue
            } else {
                give back 0 - 1
            }
        }
        idx += 1
    }
    give back last_name
}

task v4_mir_shape_ctor_name(stream_id: int, start_token: int, open_token: int) -> word {
    pilot end_name = v4_mir_shape_ctor_name_end(stream_id, start_token, open_token)
    if end_name < start_token {
        give back ""
    }
    give back v4_ty_type_text(stream_id, start_token, end_name + 1)
}

task v4_mir_is_type_like_owner(ty_id: int, owner_ty: word) -> bool {
    owner_ty = v4_mir_compact_type_text(owner_ty)
    if owner_ty == "" or owner_ty == v4_ty_unknown {
        give back false
    }

    pilot canonical_owner = v4_ty_canonical_type(ty_id, owner_ty)
    if canonical_owner != "" and canonical_owner != v4_ty_unknown {
        owner_ty = canonical_owner
    }

    if v4_ty_is_tuple_type(owner_ty) or v4_ty_is_fixed_array_type(owner_ty) {
        give back true
    }
    if v4_ty_is_generic_instance_type(owner_ty) {
        pilot base_name = v4_ty_generic_base_name(owner_ty)
        if base_name == v4_ty_unknown {
            give back false
        }
        if v4_ty_is_primitive_type(base_name) or v4_ty_builtin_generic_arg_count(base_name) >= 0 {
            give back true
        }
        give back v4_ty_type_signature_id_for_name(ty_id, base_name) >= 0
    }
    if v4_ty_is_primitive_type(owner_ty) or v4_ty_builtin_generic_arg_count(owner_ty) >= 0 {
        give back true
    }
    give back v4_ty_type_signature_id_for_name(ty_id, owner_ty) >= 0
}

task v4_mir_constructor_head_is_valid(stream_id: int, start_token: int, end_token: int) -> bool {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_token = false
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            saw_token = true
            if tok_type == v4_tok_ident or tok_type == v4_tok_keyword or tok_type == v4_tok_lifetime or tok_type == v4_tok_int or tok_type == v4_tok_float {
                -- allowed
            } else if val == "::" or val == "<" or val == ">" or val == "," or val == "(" or val == ")" or val == "[" or val == "]" or val == ";" {
                -- allowed
            } else {
                give back false
            }
            depth = v4_mir_depth_after_token(depth, val)
            if depth < 0 {
                give back false
            }
        }
        idx += 1
    }
    give back saw_token and depth == 0
}

task v4_mir_constructor_head_name(stream_id: int, start_token: int, end_token: int) -> word {
    if not v4_mir_constructor_head_is_valid(stream_id, start_token, end_token) {
        give back ""
    }
    give back v4_ty_type_text(stream_id, start_token, end_token)
}

task v4_mir_try_lower_named_call(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, last) != ")" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_open_paren_token(stream_id, first, last)
    if open_token <= first or open_token > last {
        give back 0 - 1
    }

    pilot callee_name = v4_mir_shape_ctor_name(stream_id, first, open_token)
    if callee_name == "" {
        give back 0 - 1
    }

    pilot sig_id = v4_mir_signature_id_for_name(mir_id, callee_name)
    if sig_id < 0 {
        give back 0 - 1
    }

    pilot target_name = v4_mir_resolved_callee_name(mir_id, callee_name)
    v4_mir_warn_unwinder_call_site(mir_id, expr_span, sig_id)
    pilot call_check = v4_mir_check_call_args(mir_id, body_id, stream_id, expr_span, callee_name, sig_id, open_token, last)
    pilot generic_env = v4_mir_call_check_result_env(call_check)
    pilot args_payload = v4_mir_call_check_result_args(call_check)
    pilot return_ty = v4_mir_signature_return_type_for_id(mir_id, sig_id)
    if sig_id >= 0 {
        return_ty = v4_ty_signature_return_type_for_env(v4_mir_ty_id(mir_id), sig_id, generic_env)
    }
    return_ty = v4_mir_call_result_type(return_ty)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, target_name, 0 - 1, 0 - 1, expr_span, return_ty)
    v4_mir_set_rvalue_abi(mir_id, body_id, call_rvalue, v4_mir_signature_call_abi(mir_id, sig_id))
    v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
    give back call_rvalue
}

task v4_mir_shape_ctor_field_end(stream_id: int, start_token: int, close_token: int) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_mir_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_mir_signature_seed_instance_type(ty_id: int, sig_id: int, ctor_ty: word, expected_ty: word) -> word {
    if sig_id < 0 {
        give back ctor_ty
    }
    if v4_ty_is_generic_instance_type(ctor_ty) {
        give back ctor_ty
    }
    if v4_ty_is_generic_instance_type(expected_ty) {
        if v4_ty_generic_base_name(expected_ty) == v4_ty_signature_name(ty_id, sig_id) {
            give back expected_ty
        }
    }
    give back ctor_ty
}

task v4_mir_generic_ctor_context_help(base_name: word, ctor_suffix: word) -> word {
    give back base_name + " has type parameters; write " + base_name + "<int>" + ctor_suffix + " or use an expected " + base_name + "<int>"
}

task v4_mir_prepare_declaration_order_children(children_handle: int, child_count: int) -> void {
    pilot child_id = 0
    repeat until child_id >= child_count {
        array_push(children_handle, "-1")
        child_id += 1
    }
}

task v4_mir_complete_declaration_order_children(mir_id: int, body_id: int, children_handle: int, span: word, context: word) -> void {
    pilot child_id = 0
    repeat until child_id >= array_len(children_handle) {
        if word_to_int(array_get(children_handle, child_id)) < 0 {
            pilot missing = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, context + " missing child " + word_from_int(child_id), "", 0 - 1, 0 - 1, span, v4_ty_unknown)
            array_set(children_handle, child_id, word_from_int(missing))
        }
        child_id += 1
    }
}

-- Dynamic containers stay conservative until their elements gain stable projection identity.
task v4_mir_reject_aggregate_lend_child(mir_id: int, body_id: int, aggregate_context: word, child_context: word, child_rvalue: int) -> bool {
    if child_rvalue < 0 or child_rvalue >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back false
    }

    pilot child_ty = v4_mir_rvalue_ty(mir_id, body_id, child_rvalue)
    pilot storage_kind = v4_ty_type_lend_storage_class(v4_mir_ty_id(mir_id), child_ty)
    if storage_kind == v4_ty_lend_storage_none {
        give back false
    }
    if v4_ty_lend_storage_class_is_incomplete(storage_kind) {
        v4_mir_add_lend_storage_analysis_exhausted_error(mir_id, v4_mir_rvalue_span(mir_id, body_id, child_rvalue), aggregate_context, child_ty)
        give back true
    }

    pilot message = "Meiya cannot store a lend inside " + aggregate_context + " yet"
    pilot help = v4_mir_body_name(mir_id, body_id) + " constructs " + child_context + " with type " + child_ty
    help = help + "; keep this borrowed value in a scalar local holder until MIR can preserve aggregate child provenance"
    v4_mir_add_type_error(mir_id, v4_mir_rvalue_span(mir_id, body_id, child_rvalue), message, help)
    give back true
}

task v4_mir_check_shape_ctor_fields(mir_id: int, body_id: int, stream_id: int, expr_span: word, shape_name: word, sig_id: int, open_token: int, close_token: int, seed_env: word, children_handle: int) -> word {
    if sig_id < 0 {
        v4_mir_add_type_error(mir_id, expr_span, "unknown shape constructor", shape_name + " is not a known shape")
        give back seed_env
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot field_count = v4_ty_shape_field_count(ty_id, sig_id)
    v4_mir_prepare_declaration_order_children(children_handle, field_count)
    pilot env = seed_env
    pilot seen_fields = ""
    pilot field_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    if field_start < close_token {
        repeat until field_start >= close_token {
            pilot field_end = v4_mir_shape_ctor_field_end(stream_id, field_start, close_token)
            pilot name_token = v4_mir_skip_trivia(stream_id, field_start)
            pilot field_name = ""
            if name_token < field_end {
                field_name = v4_lex_token_value(stream_id, name_token)
            }
            pilot colon_token = v4_mir_find_top_level_token(stream_id, field_start, field_end, ":")
            if colon_token < 0 or field_name == "" {
                v4_mir_add_type_error(mir_id, expr_span, "malformed shape field", "expected field: value inside " + shape_name)
            } else {
                if v4_mir_name_list_contains(seen_fields, field_name) {
                    v4_mir_add_type_error(mir_id, expr_span, "duplicate shape field", field_name + " already set on " + shape_name)
                } else {
                    seen_fields = v4_mir_name_list_add(seen_fields, field_name)
                }

                pilot field_id = v4_ty_shape_field_id_for_name(ty_id, shape_name, field_name)
                if field_id < 0 {
                    v4_mir_add_type_error(mir_id, expr_span, "unknown shape field", shape_name + " has no field " + field_name)
                } else {
                    pilot raw_expected_ty = v4_ty_shape_field_type(ty_id, sig_id, field_id)
                    pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                    pilot lower_expected_ty = expected_ty
                    if v4_ty_type_mentions_signature_generics(ty_id, sig_id, lower_expected_ty) {
                        lower_expected_ty = v4_ty_unknown
                    }
                    pilot value_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, colon_token + 1, field_end, lower_expected_ty)
                    pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, value_rvalue)
                    array_set(children_handle, field_id, word_from_int(value_rvalue))
                    pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                    if next_env == v4_ty_generic_env_fail {
                        if expected_ty == "" {
                            expected_ty = raw_expected_ty
                        }
                        pilot context = shape_name + "." + field_name
                        v4_mir_add_type_mismatch_error(mir_id, expr_span, "shape field type mismatch", context + " expects " + expected_ty + " but got " + actual_ty, context, expected_ty, actual_ty)
                    } else {
                        env = next_env
                    }
                }
            }
            field_start = v4_mir_skip_trivia(stream_id, field_end + 1)
        }
    }

    pilot field_idx = 0
    repeat until field_idx >= field_count {
        pilot required_name = v4_ty_shape_field_name(ty_id, sig_id, field_idx)
        if required_name != "" and not v4_mir_name_list_contains(seen_fields, required_name) {
            v4_mir_add_type_error(mir_id, expr_span, "missing shape field", shape_name + " requires field " + required_name)
        }
        field_idx += 1
    }
    v4_mir_complete_declaration_order_children(mir_id, body_id, children_handle, expr_span, "shape " + shape_name)
    give back env
}

task v4_mir_fixed_array_type(element_ty: word, length_text: word) -> word {
    if not v4_ty_is_known(element_ty) or not v4_ty_is_known(length_text) {
        give back v4_ty_unknown
    }
    give back "[" + element_ty + ";" + length_text + "]"
}

task v4_mir_fixed_array_length_matches(expected_length: word, actual_length: int) -> bool {
    if not v4_ty_is_known(expected_length) {
        give back true
    }
    give back expected_length == word_from_int(actual_length)
}

task v4_mir_fixed_array_slot_count(mir_id: int, array_ty: word) -> int {
    pilot length_text = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), array_ty)
    if length_text == "" or length_text == v4_ty_unknown {
        give back 0 - 1
    }
    if not v4_ty_is_integer_text_literal(length_text) {
        give back 0 - 1
    }
    if length_text.char_at(0) == "-" {
        give back 0 - 1
    }
    give back word_to_int(length_text)
}

task v4_mir_const_integer_text_from_rvalue(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back v4_ty_unknown
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_const_int {
        give back v4_ty_integer_literal_value_text(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_use_symbol {
        give back v4_ty_const_integer_text_for_name(v4_mir_ty_id(mir_id), v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_unary {
        pilot operand_text = v4_mir_const_integer_text_from_rvalue(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        if operand_text == v4_ty_unknown or not v4_ty_is_integer_text_literal(operand_text) {
            give back v4_ty_unknown
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) == v4_mir_unary_neg {
            give back word_from_int(0 - word_to_int(operand_text))
        }
        give back operand_text
    }
    if kind == v4_mir_rvalue_binary {
        pilot left = v4_mir_const_integer_text_from_rvalue(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        pilot right = v4_mir_const_integer_text_from_rvalue(mir_id, body_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
        pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
        if op == v4_mir_bin_add {
            give back v4_ty_const_integer_apply_binary("+", left, right)
        }
        if op == v4_mir_bin_sub {
            give back v4_ty_const_integer_apply_binary("-", left, right)
        }
        if op == v4_mir_bin_mul {
            give back v4_ty_const_integer_apply_binary("*", left, right)
        }
        if op == v4_mir_bin_div {
            give back v4_ty_const_integer_apply_binary("/", left, right)
        }
        if op == v4_mir_bin_mod {
            give back v4_ty_const_integer_apply_binary("%", left, right)
        }
    }
    give back v4_ty_unknown
}

task v4_mir_rvalue_contains_mut_lend(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_lend_mut or v4_ty_type_may_store_mut_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back true
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_mir_rvalue_contains_mut_lend(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)) {
                give back true
            }
            child_id += 1
        }
    }
    give back false
}

task v4_mir_fixed_array_count_from_rvalue(mir_id: int, body_id: int, count_rvalue: int, expr_span: word) -> word {
    pilot count_kind = v4_mir_rvalue_kind(mir_id, body_id, count_rvalue)
    pilot count_ty = v4_mir_rvalue_ty(mir_id, body_id, count_rvalue)
    pilot const_text = v4_mir_const_integer_text_from_rvalue(mir_id, body_id, count_rvalue)
    if const_text != v4_ty_unknown {
        if const_text.char_at(0) == "-" {
            v4_mir_add_type_error(mir_id, expr_span, "array repeat count must be non-negative", "got " + const_text)
            give back v4_ty_unknown
        }
        give back const_text
    }
    if v4_ty_is_known(count_ty) and count_ty != v4_ty_int {
        v4_mir_add_type_error(mir_id, expr_span, "array repeat count must be int", "got " + count_ty)
        give back v4_ty_unknown
    }
    v4_mir_add_type_error(mir_id, expr_span, "array repeat count must be constant", "use a literal length like 4 or a root fixed pilot int/uint constant")
    give back v4_ty_unknown
}

task v4_mir_check_fixed_array_repeated_literal(mir_id: int, body_id: int, stream_id: int, expr_span: word, open_token: int, repeat_token: int, close_token: int, expected_ty: word, children_handle: int) -> word {
    pilot expected_element_ty = v4_ty_fixed_array_element_type(expected_ty)
    pilot expected_length = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), expected_ty)
    pilot value_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, open_token + 1, repeat_token, expected_element_ty)
    pilot value_ty = v4_mir_rvalue_ty(mir_id, body_id, value_rvalue)
    array_push(children_handle, word_from_int(value_rvalue))
    if v4_ty_is_known(expected_element_ty) and not v4_ty_types_compatible(expected_element_ty, value_ty) {
        v4_mir_add_type_error(mir_id, expr_span, "array repeat value drift", "repeat value wants " + expected_element_ty + " but got " + value_ty)
    }

    pilot count_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, repeat_token + 1, close_token)
    pilot count_text = v4_mir_fixed_array_count_from_rvalue(mir_id, body_id, count_rvalue, expr_span)
    if v4_ty_is_known(count_text) {
        if word_to_int(count_text) > 1 and v4_mir_rvalue_contains_mut_lend(mir_id, body_id, value_rvalue) {
            v4_mir_add_type_error(mir_id, expr_span, "fixed-array repeat cannot duplicate lend mut", "write each element explicitly so every slot receives a distinct exclusive loan")
        } else if not v4_ty_type_is_array_repeatable(v4_mir_ty_id(mir_id), v4_mir_body_signature_id(mir_id, body_id), value_ty) {
            v4_mir_add_type_error(mir_id, expr_span, "fixed-array repeat value must be Copy or Cloneable", "implement Copy or Cloneable for " + value_ty + ", or write each element explicitly")
        }
    }
    if v4_ty_is_known(expected_length) and v4_ty_is_known(count_text) and expected_length != count_text {
        v4_mir_add_type_error(mir_id, expr_span, "array length mismatch", expected_ty + " expects " + expected_length + " elements but got " + count_text)
    }

    if v4_ty_is_fixed_array_type(expected_ty) {
        give back expected_ty
    }
    give back v4_mir_fixed_array_type(value_ty, count_text)
}

task v4_mir_check_fixed_array_literal(mir_id: int, body_id: int, stream_id: int, expr_span: word, open_token: int, close_token: int, expected_ty: word, children_handle: int) -> word {
    pilot repeat_token = v4_mir_find_top_level_token(stream_id, open_token + 1, close_token, ";")
    if repeat_token >= 0 {
        give back v4_mir_check_fixed_array_repeated_literal(mir_id, body_id, stream_id, expr_span, open_token, repeat_token, close_token, expected_ty, children_handle)
    }

    pilot expected_element_ty = v4_ty_fixed_array_element_type(expected_ty)
    pilot expected_length = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), expected_ty)
    pilot element_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    if element_start >= close_token {
        if v4_mir_fixed_array_length_matches(expected_length, 0) {
            if v4_ty_is_fixed_array_type(expected_ty) {
                give back expected_ty
            }
            give back v4_mir_fixed_array_type(v4_ty_unknown, "0")
        }
        if v4_ty_is_known(expected_length) {
            v4_mir_add_type_error(mir_id, expr_span, "array length mismatch", expected_ty + " expects " + expected_length + " elements but got 0")
            give back expected_ty
        }
        v4_mir_add_type_error(mir_id, expr_span, "empty array literal needs type context", "write a typed destination like pilot board: [int;4] = []")
        give back v4_ty_unknown
    }

    pilot element_ty = expected_element_ty
    pilot element_idx = 0
    repeat until element_start >= close_token {
        pilot element_end = v4_mir_list_element_end(stream_id, element_start, close_token)
        pilot element_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, element_start, element_end, expected_element_ty)
        pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, element_rvalue)
        array_push(children_handle, word_from_int(element_rvalue))
        element_idx += 1
        if v4_ty_is_known(expected_element_ty) {
            if not v4_ty_types_compatible(expected_element_ty, actual_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "array element drift", "element " + word_from_int(element_idx) + " wants " + expected_element_ty + " but got " + actual_ty)
            }
        } else if element_idx == 1 {
            element_ty = actual_ty
        } else if v4_ty_is_known(element_ty) and v4_ty_is_known(actual_ty) {
            if element_ty == actual_ty {
                -- keep inferred type
            } else if v4_ty_is_numeric(element_ty) and v4_ty_is_numeric(actual_ty) {
                element_ty = v4_ty_numeric_result(element_ty, actual_ty)
            } else {
                v4_mir_add_type_error(mir_id, expr_span, "array element drift", "element " + word_from_int(element_idx) + " wants " + element_ty + " but got " + actual_ty)
            }
        } else {
            element_ty = v4_mir_merge_literal_type(element_ty, actual_ty)
        }
        element_start = v4_mir_skip_trivia(stream_id, element_end + 1)
    }

    if v4_ty_is_known(expected_length) and expected_length != word_from_int(element_idx) {
        v4_mir_add_type_error(mir_id, expr_span, "array length mismatch", expected_ty + " expects " + expected_length + " elements but got " + word_from_int(element_idx))
    }

    if v4_ty_is_fixed_array_type(expected_ty) {
        give back expected_ty
    }
    give back v4_mir_fixed_array_type(element_ty, word_from_int(element_idx))
}

task v4_mir_try_lower_array_literal(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    if v4_lex_token_value(stream_id, first) != "[" or v4_lex_token_value(stream_id, last) != "]" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_open_index_token(stream_id, first, last)
    if open_token != first {
        give back 0 - 1
    }

    pilot repeat_token = v4_mir_find_top_level_token(stream_id, open_token + 1, last, ";")
    if repeat_token < 0 and not v4_ty_is_fixed_array_type(expected_ty) {
        give back 0 - 1
    }

    pilot children_handle = array_new()
    pilot result_ty = v4_mir_check_fixed_array_literal(mir_id, body_id, stream_id, expr_span, open_token, last, expected_ty, children_handle)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_array, expr_text, "Array", expr_span, result_ty, children_handle)
}

task v4_mir_list_type(element_ty: word) -> word {
    if not v4_ty_is_known(element_ty) {
        give back v4_ty_unknown
    }
    give back "List<" + element_ty + ">"
}

task v4_mir_list_element_end(stream_id: int, start_token: int, close_token: int) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= close_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if depth == 0 and val == "," {
                give back idx
            }
            depth = v4_mir_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back close_token
}

task v4_mir_merge_literal_type(current_ty: word, next_ty: word) -> word {
    if not v4_ty_is_known(current_ty) {
        give back next_ty
    }
    if not v4_ty_is_known(next_ty) {
        give back current_ty
    }
    if current_ty == next_ty {
        give back current_ty
    }
    if v4_ty_is_numeric(current_ty) and v4_ty_is_numeric(next_ty) {
        give back v4_ty_numeric_result(current_ty, next_ty)
    }
    give back current_ty
}

task v4_mir_list_merge_element_type(current_ty: word, next_ty: word) -> word {
    give back v4_mir_merge_literal_type(current_ty, next_ty)
}

task v4_mir_check_list_literal(mir_id: int, body_id: int, stream_id: int, expr_span: word, open_token: int, close_token: int, children_handle: int) -> word {
    pilot element_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    if element_start >= close_token {
        v4_mir_add_type_error(mir_id, expr_span, "empty list literal needs type context", "write a typed destination like pilot squad: List<int> = []")
        give back v4_ty_unknown
    }

    pilot element_ty = v4_ty_unknown
    pilot element_idx = 0
    pilot aggregate_lend_reported = false
    repeat until element_start >= close_token {
        pilot element_end = v4_mir_list_element_end(stream_id, element_start, close_token)
        pilot element_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, element_start, element_end)
        pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, element_rvalue)
        array_push(children_handle, word_from_int(element_rvalue))
        element_idx += 1
        if not aggregate_lend_reported {
            aggregate_lend_reported = v4_mir_reject_aggregate_lend_child(mir_id, body_id, "a list", "list element " + word_from_int(element_idx), element_rvalue)
        }
        if element_idx == 1 {
            element_ty = actual_ty
        } else if v4_ty_is_known(element_ty) and v4_ty_is_known(actual_ty) {
            if element_ty == actual_ty {
                -- keep inferred type
            } else if v4_ty_is_numeric(element_ty) and v4_ty_is_numeric(actual_ty) {
                element_ty = v4_ty_numeric_result(element_ty, actual_ty)
            } else {
                v4_mir_add_type_error(mir_id, expr_span, "list element drift", "element " + word_from_int(element_idx) + " wants " + element_ty + " but got " + actual_ty)
            }
        } else {
            element_ty = v4_mir_list_merge_element_type(element_ty, actual_ty)
        }
        element_start = v4_mir_skip_trivia(stream_id, element_end + 1)
    }

    give back v4_mir_list_type(element_ty)
}

task v4_mir_try_lower_list_literal(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, first) != "[" or v4_lex_token_value(stream_id, last) != "]" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_open_index_token(stream_id, first, last)
    if open_token != first {
        give back 0 - 1
    }

    pilot children_handle = array_new()
    pilot result_ty = v4_mir_check_list_literal(mir_id, body_id, stream_id, expr_span, open_token, last, children_handle)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_list, expr_text, "List", expr_span, result_ty, children_handle)
}

task v4_mir_tuple_type_add(tuple_ty: word, element_ty: word) -> word {
    if tuple_ty == "" {
        give back "(" + element_ty
    }
    give back tuple_ty + "," + element_ty
}

task v4_mir_try_lower_tuple_literal(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, first) != "(" or v4_lex_token_value(stream_id, last) != ")" {
        give back 0 - 1
    }

    pilot close_token = v4_mir_find_matching_paren(stream_id, first, last + 1)
    if close_token != last {
        give back 0 - 1
    }

    pilot comma_token = v4_mir_find_top_level_token(stream_id, first + 1, last, ",")
    if comma_token < 0 {
        give back 0 - 1
    }

    pilot element_start = v4_mir_skip_trivia(stream_id, first + 1)
    pilot tuple_ty = ""
    pilot element_count = 0
    pilot children_handle = array_new()
    pilot has_unknown = false
    repeat until element_start >= last {
        pilot element_end = v4_mir_list_element_end(stream_id, element_start, last)
        if element_start >= element_end {
            v4_mir_add_type_error(mir_id, expr_span, "tuple slot missing", "expected another element after ','")
            has_unknown = true
        } else {
            pilot element_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, element_start, element_end)
            pilot element_ty = v4_mir_rvalue_ty(mir_id, body_id, element_rvalue)
            array_push(children_handle, word_from_int(element_rvalue))
            element_count += 1
            if not v4_ty_is_known(element_ty) {
                has_unknown = true
            } else {
                tuple_ty = v4_mir_tuple_type_add(tuple_ty, element_ty)
            }
        }
        element_start = v4_mir_skip_trivia(stream_id, element_end + 1)
    }

    pilot tail_token = v4_mir_prev_nontrivia(stream_id, last - 1, first + 1)
    if tail_token > first and v4_lex_token_value(stream_id, tail_token) == "," {
        v4_mir_add_type_error(mir_id, expr_span, "tuple slot missing", "expected another element after ','")
        has_unknown = true
    }

    pilot result_ty = v4_ty_unknown
    if has_unknown == false and element_count >= 2 {
        result_ty = tuple_ty + ")"
    }
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_tuple, expr_text, "Tuple", expr_span, result_ty, children_handle)
}

task v4_mir_map_type(key_ty: word, value_ty: word) -> word {
    if not v4_ty_is_known(key_ty) or not v4_ty_is_known(value_ty) {
        give back v4_ty_unknown
    }
    give back "Map<" + key_ty + "," + value_ty + ">"
}

task v4_mir_check_map_literal(mir_id: int, body_id: int, stream_id: int, expr_span: word, open_token: int, close_token: int, children_handle: int) -> word {
    pilot pair_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    if pair_start >= close_token {
        v4_mir_add_type_error(mir_id, expr_span, "empty map literal needs type context", "annotate the destination, for example pilot lookup: Map<word,int>")
        give back v4_ty_unknown
    }

    pilot key_ty = v4_ty_unknown
    pilot value_ty = v4_ty_unknown
    pilot pair_idx = 0
    pilot has_unknown = false
    pilot aggregate_lend_reported = false
    repeat until pair_start >= close_token {
        pilot pair_end = v4_mir_list_element_end(stream_id, pair_start, close_token)
        pilot colon_token = v4_mir_find_top_level_token(stream_id, pair_start, pair_end, ":")
        pair_idx += 1
        if colon_token < 0 {
            v4_mir_add_type_error(mir_id, expr_span, "malformed map entry", "expected key: value inside map literal")
            has_unknown = true
        } else {
            pilot key_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, pair_start, colon_token)
            pilot value_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, colon_token + 1, pair_end)
            pilot actual_key_ty = v4_mir_rvalue_ty(mir_id, body_id, key_rvalue)
            pilot actual_value_ty = v4_mir_rvalue_ty(mir_id, body_id, value_rvalue)
            array_push(children_handle, word_from_int(key_rvalue))
            array_push(children_handle, word_from_int(value_rvalue))
            if not aggregate_lend_reported {
                aggregate_lend_reported = v4_mir_reject_aggregate_lend_child(mir_id, body_id, "a map", "map entry " + word_from_int(pair_idx) + " key", key_rvalue)
            }
            if not aggregate_lend_reported {
                aggregate_lend_reported = v4_mir_reject_aggregate_lend_child(mir_id, body_id, "a map", "map entry " + word_from_int(pair_idx) + " value", value_rvalue)
            }

            if pair_idx == 1 {
                key_ty = actual_key_ty
                value_ty = actual_value_ty
            } else {
                if v4_ty_is_known(key_ty) and v4_ty_is_known(actual_key_ty) {
                    if key_ty == actual_key_ty {
                        -- keep inferred key type
                    } else if v4_ty_is_numeric(key_ty) and v4_ty_is_numeric(actual_key_ty) {
                        key_ty = v4_ty_numeric_result(key_ty, actual_key_ty)
                    } else {
                        v4_mir_add_type_error(mir_id, expr_span, "map key drift", "entry " + word_from_int(pair_idx) + " wants key " + key_ty + " but got " + actual_key_ty)
                    }
                } else {
                    key_ty = v4_mir_merge_literal_type(key_ty, actual_key_ty)
                }

                if v4_ty_is_known(value_ty) and v4_ty_is_known(actual_value_ty) {
                    if value_ty == actual_value_ty {
                        -- keep inferred value type
                    } else if v4_ty_is_numeric(value_ty) and v4_ty_is_numeric(actual_value_ty) {
                        value_ty = v4_ty_numeric_result(value_ty, actual_value_ty)
                    } else {
                        v4_mir_add_type_error(mir_id, expr_span, "map value drift", "entry " + word_from_int(pair_idx) + " wants value " + value_ty + " but got " + actual_value_ty)
                    }
                } else {
                    value_ty = v4_mir_merge_literal_type(value_ty, actual_value_ty)
                }
            }

            if not v4_ty_is_known(actual_key_ty) or not v4_ty_is_known(actual_value_ty) {
                has_unknown = true
            }
        }
        pair_start = v4_mir_skip_trivia(stream_id, pair_end + 1)
    }

    if has_unknown {
        give back v4_ty_unknown
    }
    give back v4_mir_map_type(key_ty, value_ty)
}

task v4_mir_try_lower_map_literal(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, first) != "{" or v4_lex_token_value(stream_id, last) != "}" {
        give back 0 - 1
    }

    pilot close_token = v4_mir_find_matching_brace(stream_id, first, last + 1)
    if close_token != last {
        give back 0 - 1
    }

    pilot children_handle = array_new()
    pilot result_ty = v4_mir_check_map_literal(mir_id, body_id, stream_id, expr_span, first, last, children_handle)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_map, expr_text, "Map", expr_span, result_ty, children_handle)
}

task v4_mir_try_lower_shape_ctor(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    if v4_lex_token_value(stream_id, last) != "}" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_token_value(stream_id, first, last + 1, "{")
    if open_token <= first or open_token > last {
        give back 0 - 1
    }

    pilot close_token = v4_mir_find_matching_brace(stream_id, open_token, last + 1)
    if close_token != last {
        give back 0 - 1
    }

    pilot shape_name = v4_mir_constructor_head_name(stream_id, first, open_token)
    if shape_name == "" {
        give back 0 - 1
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, shape_name)
    pilot explicit_shape_instance_valid = true
    if v4_ty_is_generic_instance_type(shape_name) {
        explicit_shape_instance_valid = v4_mir_validate_type_contract(mir_id, v4_mir_body_signature_id(mir_id, body_id), expr_span, shape_name, "invalid generic shape instance", "shape constructor " + shape_name)
    }
    pilot seed_instance_ty = v4_mir_signature_seed_instance_type(ty_id, sig_id, shape_name, expected_ty)
    pilot children_handle = array_new()
    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, seed_instance_ty)
    if explicit_shape_instance_valid {
        env = v4_mir_check_shape_ctor_fields(mir_id, body_id, stream_id, expr_span, shape_name, sig_id, open_token, close_token, env, children_handle)
    }
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    pilot result_ty = shape_name
    if sig_id < 0 {
        result_ty = v4_ty_unknown
    } else if not explicit_shape_instance_valid {
        result_ty = v4_ty_unknown
    } else if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            result_ty = v4_ty_signature_instance_type_for_env(ty_id, sig_id, env)
        } else if v4_ty_is_generic_instance_type(seed_instance_ty) {
            result_ty = seed_instance_ty
        } else {
            v4_mir_add_type_error(mir_id, expr_span, "generic shape constructor needs type context", v4_mir_generic_ctor_context_help(v4_ty_signature_name(ty_id, sig_id), " " + "{" + " ... " + "}"))
            result_ty = v4_ty_unknown
        }
    }
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_construct, expr_text, shape_name, expr_span, result_ty, children_handle)
}

task v4_mir_path_scope_separator(path: word) -> int {
    pilot idx = 0
    pilot depth = 0
    repeat until idx + 1 >= path.length() {
        pilot ch = path.char_at(idx)
        if depth == 0 and ch == ":" and path.char_at(idx + 1) == ":" {
            give back idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_path_left(path: word) -> word {
    pilot sep = v4_mir_path_scope_separator(path)
    if sep < 0 {
        give back ""
    }
    give back v4_mir_pattern_trim(v4_slice(path, 0, sep))
}

task v4_mir_path_right(path: word) -> word {
    pilot sep = v4_mir_path_scope_separator(path)
    if sep < 0 or sep + 2 > path.length() {
        give back ""
    }
    give back v4_mir_pattern_trim(v4_slice(path, sep + 2, path.length()))
}

task v4_mir_route_case_text(route_name: word, case_name: word) -> word {
    if route_name == "" or case_name == "" {
        give back ""
    }
    give back route_name + "::" + case_name
}

task v4_mir_fixed_array_projection_index(projection: word) -> int {
    if projection.length() < 3 or projection.char_at(0) != "[" or projection.char_at(projection.length() - 1) != "]" {
        give back 0 - 1
    }
    pilot index_text = v4_slice(projection, 1, projection.length() - 1)
    if not v4_ty_is_integer_text_literal(index_text) or index_text.char_at(0) == "-" {
        give back 0 - 1
    }
    give back word_to_int(index_text)
}

task v4_mir_rvalue_aggregate_child_projection(mir_id: int, body_id: int, rvalue_id: int, child_id: int) -> word {
    if v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id) < 0 {
        give back ""
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_tuple {
        give back "." + word_from_int(child_id)
    }
    if kind == v4_mir_rvalue_array {
        pilot slot_count = v4_mir_fixed_array_slot_count(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        if slot_count < 0 {
            give back ""
        }
        if v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id) == 1 and slot_count > 1 {
            give back "[*]"
        }
        if child_id >= slot_count {
            give back ""
        }
        give back "[" + word_from_int(child_id) + "]"
    }
    if kind != v4_mir_rvalue_construct {
        give back ""
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot aggregate_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot field_name = ""
    if v4_ty_is_route_type(ty_id, aggregate_ty) {
        pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
        pilot next_case = v4_mir_path_right(case_name)
        repeat until next_case == "" {
            case_name = next_case
            next_case = v4_mir_path_right(case_name)
        }
        field_name = v4_ty_route_case_field_name(ty_id, aggregate_ty, case_name, child_id)
    } else {
        pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, aggregate_ty)
        if sig_id >= 0 {
            field_name = v4_ty_shape_field_name(ty_id, sig_id, child_id)
        }
    }
    if field_name == "" {
        give back ""
    }
    give back "." + field_name
}

task v4_mir_rvalue_aggregate_child_for_projection(mir_id: int, body_id: int, rvalue_id: int, projection: word) -> int {
    pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
    if child_count <= 0 or projection == "" {
        give back 0 - 1
    }

    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_array and v4_mir_rvalue_aggregate_child_projection(mir_id, body_id, rvalue_id, 0) == "[*]" {
        pilot slot_count = v4_mir_fixed_array_slot_count(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        pilot projection_index = v4_mir_fixed_array_projection_index(projection)
        if projection == "[*]" or (projection_index >= 0 and projection_index < slot_count) {
            give back v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, 0)
        }
        give back 0 - 1
    }

    pilot child_id = 0
    repeat until child_id >= child_count {
        if v4_mir_rvalue_aggregate_child_projection(mir_id, body_id, rvalue_id, child_id) == projection {
            give back v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
        }
        child_id += 1
    }
    give back 0 - 1
}

task v4_mir_type_char_is_space(ch: word) -> bool {
    give back ch == " " or ch == "\n" or ch == "\t" or ch == "\r"
}

task v4_mir_type_char_can_precede_dyn_keyword(ch: word) -> bool {
    give back ch == " " or ch == "\n" or ch == "\t" or ch == "\r" or ch == "<" or ch == "," or ch == "(" or ch == "[" or ch == ":"
}

task v4_mir_type_has_dyn_keyword_at(type_text: word, idx: int) -> bool {
    if idx < 0 or idx + 3 > type_text.length() {
        give back false
    }
    if v4_slice(type_text, idx, idx + 3) != "dyn" {
        give back false
    }
    if idx > 0 and not v4_mir_type_char_can_precede_dyn_keyword(type_text.char_at(idx - 1)) {
        give back false
    }
    if idx + 3 >= type_text.length() {
        give back false
    }
    give back v4_mir_type_char_is_space(type_text.char_at(idx + 3))
}

task v4_mir_compact_type_text(type_text: word) -> word {
    pilot out = ""
    pilot idx = 0
    repeat until idx >= type_text.length() {
        pilot ch = type_text.char_at(idx)
        if v4_mir_type_has_dyn_keyword_at(type_text, idx) {
            out = out + "dyn "
            idx += 3
            repeat until idx >= type_text.length() or not v4_mir_type_char_is_space(type_text.char_at(idx)) {
                idx += 1
            }
        } else if not v4_mir_type_char_is_space(ch) {
            out = out + ch
            idx += 1
        } else {
            idx += 1
        }
    }
    give back out
}

task v4_mir_route_alias_name(ty_id: int, route_name: word) -> word {
    route_name = v4_mir_compact_type_text(route_name)
    if route_name == "" {
        give back ""
    }
    pilot canonical = v4_ty_canonical_type(ty_id, route_name)
    if canonical != "" and canonical != v4_ty_unknown {
        give back canonical
    }
    give back route_name
}

task v4_mir_route_base_name(ty_id: int, route_name: word) -> word {
    pilot canonical = v4_mir_route_alias_name(ty_id, route_name)
    if canonical == "" or canonical == v4_ty_unknown {
        give back canonical
    }
    if v4_ty_is_generic_instance_type(canonical) {
        pilot base = v4_ty_generic_base_name(canonical)
        if base != v4_ty_unknown {
            give back base
        }
    }
    give back canonical
}

task v4_mir_route_names_match(ty_id: int, left: word, right: word) -> bool {
    if left == "" or right == "" {
        give back false
    }
    pilot left_name = v4_mir_route_alias_name(ty_id, left)
    pilot right_name = v4_mir_route_alias_name(ty_id, right)
    if left_name == right_name {
        give back true
    }
    pilot left_base = v4_mir_route_base_name(ty_id, left_name)
    pilot right_base = v4_mir_route_base_name(ty_id, right_name)
    if left_base == "" or right_base == "" or left_base != right_base {
        give back false
    }
    if v4_ty_is_generic_instance_type(left_name) and v4_ty_is_generic_instance_type(right_name) {
        pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, left_base)
        if sig_id >= 0 {
            if v4_ty_match_signature_type_env(ty_id, sig_id, left_name, right_name, "") != v4_ty_generic_env_fail {
                give back true
            }
            if v4_ty_match_signature_type_env(ty_id, sig_id, right_name, left_name, "") != v4_ty_generic_env_fail {
                give back true
            }
        }
        give back false
    }
    give back true
}

task v4_mir_route_effective_name(ty_id: int, route_name: word, source_ty: word) -> word {
    pilot explicit_name = v4_mir_route_alias_name(ty_id, route_name)
    if explicit_name == "" or explicit_name == v4_ty_unknown {
        explicit_name = route_name
    }
    pilot source_name = v4_mir_route_alias_name(ty_id, source_ty)
    if source_name == "" or source_name == v4_ty_unknown {
        source_name = source_ty
    }
    if explicit_name == "" {
        give back source_name
    }
    if source_name != "" and v4_ty_is_generic_instance_type(source_name) and v4_mir_route_names_match(ty_id, explicit_name, source_name) {
        if not v4_ty_is_generic_instance_type(explicit_name) or not v4_ty_types_compatible(explicit_name, source_name) {
            give back source_name
        }
    }
    if v4_ty_is_generic_instance_type(explicit_name) {
        give back explicit_name
    }
    if source_name != "" and v4_ty_is_generic_instance_type(source_name) and v4_mir_route_names_match(ty_id, explicit_name, source_name) {
        give back source_name
    }
    give back explicit_name
}

task v4_mir_route_case_rvalue(mir_id: int, body_id: int, display_text: word, route_name: word, case_name: word, expr_span: word) -> int {
    pilot case_text = v4_mir_route_case_text(route_name, case_name)
    if display_text == "" {
        display_text = case_text
    }
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_symbol, display_text, case_text, 0 - 1, 0 - 1, expr_span, route_name)
}

task v4_mir_check_route_ctor_fields(mir_id: int, body_id: int, stream_id: int, expr_span: word, route_name: word, case_name: word, open_token: int, close_token: int, seed_env: word, children_handle: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if not v4_ty_is_route_type(ty_id, route_name) {
        v4_mir_add_type_error(mir_id, expr_span, "unknown route constructor", route_name + " is not a known route")
        give back seed_env
    }
    if not v4_ty_route_has_case(ty_id, route_name, case_name) {
        v4_mir_add_type_error(mir_id, expr_span, "unknown route case", route_name + " exposes no case " + case_name)
        give back seed_env
    }

    pilot field_count = v4_ty_route_case_field_count(ty_id, route_name, case_name)
    if field_count <= 0 {
        v4_mir_add_type_error(mir_id, expr_span, "route case has no payload", route_name + "::" + case_name + " carries no fields")
        give back seed_env
    }

    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot route_sig_name = v4_ty_signature_name(ty_id, sig_id)
    v4_mir_prepare_declaration_order_children(children_handle, field_count)
    pilot env = seed_env
    pilot seen_fields = ""
    pilot field_start = v4_mir_skip_trivia(stream_id, open_token + 1)
    if field_start < close_token {
        repeat until field_start >= close_token {
            pilot field_end = v4_mir_shape_ctor_field_end(stream_id, field_start, close_token)
            pilot name_token = v4_mir_skip_trivia(stream_id, field_start)
            pilot field_name = ""
            if name_token < field_end {
                field_name = v4_lex_token_value(stream_id, name_token)
            }
            pilot colon_token = v4_mir_find_top_level_token(stream_id, field_start, field_end, ":")
            if colon_token < 0 or field_name == "" {
                v4_mir_add_type_error(mir_id, expr_span, "malformed route field", "expected field: value inside " + route_name + "::" + case_name)
            } else {
                if v4_mir_name_list_contains(seen_fields, field_name) {
                    v4_mir_add_type_error(mir_id, expr_span, "duplicate route case field", field_name + " already set on " + route_name + "::" + case_name)
                } else {
                    seen_fields = v4_mir_name_list_add(seen_fields, field_name)
                }

                pilot field_id = v4_ty_route_case_field_id_for_name(ty_id, route_name, case_name, field_name)
                if field_id < 0 {
                    v4_mir_add_type_error(mir_id, expr_span, "unknown route case field", route_name + "::" + case_name + " has no field " + field_name)
                } else {
                    pilot raw_expected_ty = v4_ty_route_case_field_type(ty_id, route_sig_name, case_name, field_id)
                    pilot expected_ty = v4_ty_apply_generic_env(raw_expected_ty, env)
                    pilot lower_expected_ty = expected_ty
                    if v4_ty_type_mentions_signature_generics(ty_id, sig_id, lower_expected_ty) {
                        lower_expected_ty = v4_ty_unknown
                    }
                    pilot value_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, colon_token + 1, field_end, lower_expected_ty)
                    pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, value_rvalue)
                    array_set(children_handle, field_id, word_from_int(value_rvalue))
                    pilot next_env = v4_ty_match_signature_type_env(ty_id, sig_id, raw_expected_ty, actual_ty, env)
                    if next_env == v4_ty_generic_env_fail {
                        if expected_ty == "" {
                            expected_ty = raw_expected_ty
                        }
                        pilot context = route_name + "::" + case_name + "." + field_name
                        v4_mir_add_type_mismatch_error(mir_id, expr_span, "route case field type mismatch", context + " expects " + expected_ty + " but got " + actual_ty, context, expected_ty, actual_ty)
                    } else {
                        env = next_env
                    }
                }
            }
            field_start = v4_mir_skip_trivia(stream_id, field_end + 1)
        }
    }

    pilot field_idx = 0
    repeat until field_idx >= field_count {
        pilot required_name = v4_ty_route_case_field_name(ty_id, route_name, case_name, field_idx)
        if required_name != "" and not v4_mir_name_list_contains(seen_fields, required_name) {
            v4_mir_add_type_error(mir_id, expr_span, "missing route case field", route_name + "::" + case_name + " requires field " + required_name)
        }
        field_idx += 1
    }
    v4_mir_complete_declaration_order_children(mir_id, body_id, children_handle, expr_span, "route case " + v4_mir_route_case_text(route_name, case_name))
    give back env
}

task v4_mir_try_lower_route_payload_ctor(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    if v4_lex_token_value(stream_id, last) != "}" {
        give back 0 - 1
    }

    pilot open_token = v4_mir_find_token_value(stream_id, first, last + 1, "{")
    if open_token <= first or open_token > last {
        give back 0 - 1
    }

    pilot close_token = v4_mir_find_matching_brace(stream_id, open_token, last + 1)
    if close_token != last {
        give back 0 - 1
    }

    pilot ctor_name = v4_mir_constructor_head_name(stream_id, first, open_token)
    if ctor_name == "" {
        give back 0 - 1
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_name = v4_mir_path_left(ctor_name)
    pilot case_name = v4_mir_path_right(ctor_name)
    if route_name == "" {
        if v4_ty_is_route_type(ty_id, expected_ty) {
            route_name = expected_ty
            case_name = ctor_name
        } else {
            give back 0 - 1
        }
    } else if case_name == "" {
        v4_mir_add_type_error(mir_id, expr_span, "route constructor needs case name", "use " + route_name + "::CaseName")
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, v4_mir_expr_text(stream_id, first, last + 1), "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
    }

    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    pilot explicit_route_instance_valid = true
    if v4_ty_is_generic_instance_type(route_name) {
        explicit_route_instance_valid = v4_mir_validate_type_contract(mir_id, v4_mir_body_signature_id(mir_id, body_id), expr_span, route_name, "invalid generic route instance", "route constructor " + route_name + "::" + case_name)
    }
    pilot seed_instance_ty = v4_mir_signature_seed_instance_type(ty_id, sig_id, route_name, expected_ty)
    pilot children_handle = array_new()
    pilot env = v4_ty_signature_generic_env_for_instance(ty_id, sig_id, seed_instance_ty)
    if explicit_route_instance_valid {
        env = v4_mir_check_route_ctor_fields(mir_id, body_id, stream_id, expr_span, route_name, case_name, open_token, close_token, env, children_handle)
    }
    pilot result_ty = route_name
    if not v4_ty_is_route_type(ty_id, route_name) or not v4_ty_route_has_case(ty_id, route_name, case_name) {
        result_ty = v4_ty_unknown
    } else if not explicit_route_instance_valid {
        result_ty = v4_ty_unknown
    } else if sig_id >= 0 and v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if v4_ty_signature_generic_env_complete(ty_id, sig_id, env) {
            result_ty = v4_ty_signature_instance_type_for_env(ty_id, sig_id, env)
        } else if v4_ty_is_generic_instance_type(seed_instance_ty) {
            result_ty = seed_instance_ty
        } else {
            v4_mir_add_type_error(mir_id, expr_span, "generic route constructor needs type context", v4_mir_generic_ctor_context_help(v4_ty_signature_name(ty_id, sig_id), "::" + case_name + " " + "{" + " ... " + "}"))
            result_ty = v4_ty_unknown
        }
    }
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_construct, expr_text, v4_mir_route_case_text(route_name, case_name), expr_span, result_ty, children_handle)
}

task v4_mir_try_lower_route_case_expr(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    pilot last_type = v4_lex_token_type(stream_id, last)
    if last_type != v4_tok_ident and last_type != v4_tok_keyword {
        give back 0 - 1
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot expr_text = v4_ty_type_text(stream_id, first, last + 1)
    if expr_text == "" {
        expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    }
    pilot route_name = v4_mir_path_left(expr_text)
    pilot case_name = v4_mir_path_right(expr_text)
    if route_name != "" {
        if case_name == "" {
            v4_mir_add_type_error(mir_id, expr_span, "route constructor needs case name", "use " + route_name + "::CaseName")
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
        }
        if not v4_ty_is_route_type(ty_id, route_name) {
            v4_mir_add_type_error(mir_id, expr_span, "unknown route constructor", route_name + " is not a known route")
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
        }
        if not v4_ty_route_has_case(ty_id, route_name, case_name) {
            v4_mir_add_type_error(mir_id, expr_span, "unknown route case", route_name + " exposes no case " + case_name)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
        }
        if v4_ty_route_case_has_payload(ty_id, route_name, case_name) {
            v4_mir_add_type_error(mir_id, expr_span, "route payload constructor needs fields", route_name + "::" + case_name + " expects named fields")
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
        }
        pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
        if v4_ty_is_generic_instance_type(route_name) {
            if not v4_mir_validate_type_contract(mir_id, v4_mir_body_signature_id(mir_id, body_id), expr_span, route_name, "invalid generic route instance", "route constructor " + route_name + "::" + case_name) {
                give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
            }
        }
        if sig_id >= 0 and v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
            pilot seed_instance_ty = v4_mir_signature_seed_instance_type(ty_id, sig_id, route_name, expected_ty)
            if v4_ty_is_generic_instance_type(seed_instance_ty) {
                route_name = seed_instance_ty
            } else {
                v4_mir_add_type_error(mir_id, expr_span, "generic route case needs type context", v4_mir_generic_ctor_context_help(v4_ty_signature_name(ty_id, sig_id), "::" + case_name))
                give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
            }
        }
        give back v4_mir_route_case_rvalue(mir_id, body_id, v4_mir_route_case_text(route_name, case_name), route_name, case_name, expr_span)
    }

    if first == last and v4_ty_is_route_type(ty_id, expected_ty) {
        pilot first_value = v4_lex_token_value(stream_id, first)
        if v4_mir_find_local_visible_at(mir_id, body_id, first_value, v4_span_start(expr_span)) >= 0 {
            give back 0 - 1
        }
        if v4_ty_route_has_case(ty_id, expected_ty, first_value) {
            if v4_ty_route_case_has_payload(ty_id, expected_ty, first_value) {
                v4_mir_add_type_error(mir_id, expr_span, "route payload constructor needs fields", expected_ty + "::" + first_value + " expects named fields")
                give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
            }
            give back v4_mir_route_case_rvalue(mir_id, body_id, v4_mir_route_case_text(expected_ty, first_value), expected_ty, first_value, expr_span)
        }
    }
    give back 0 - 1
}

task v4_mir_try_lower_maybe_result_ctor(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    pilot first_value = v4_lex_token_value(stream_id, first)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)

    if first == last and first_value == "nobody" {
        pilot result_ty = v4_ty_maybe_type(v4_ty_unknown)
        if v4_ty_is_maybe_type(expected_ty) {
            result_ty = expected_ty
        }
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_nobody, expr_text, "Nobody", 0 - 1, 0 - 1, expr_span, result_ty)
    }

    pilot next_token = v4_mir_next_nontrivia(stream_id, first + 1, last + 1)
    if next_token > last or v4_lex_token_value(stream_id, next_token) != "(" or (first_value != "some" and first_value != "ok" and first_value != "err") {
        give back 0 - 1
    }

    pilot close_token = v4_mir_find_matching_paren(stream_id, next_token, last + 1)
    if close_token != last {
        give back 0 - 1
    }

    if first_value == "some" {
        pilot payload_expected = v4_ty_unknown
        pilot result_ty = v4_ty_unknown
        if v4_ty_is_maybe_type(expected_ty) {
            payload_expected = v4_ty_maybe_value_type(expected_ty)
            result_ty = expected_ty
        }
        pilot payload_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, next_token + 1, close_token, payload_expected)
        pilot payload_ty = v4_mir_rvalue_ty(mir_id, body_id, payload_id)
        v4_mir_reject_aggregate_lend_child(mir_id, body_id, "a maybe some()", "the some() payload", payload_id)
        if v4_ty_is_known(payload_expected) and not v4_ty_types_compatible(payload_expected, payload_ty) {
            v4_mir_add_type_error(mir_id, expr_span, "some payload type mismatch", "some expects " + payload_expected + " but got " + payload_ty)
        }
        if not v4_ty_is_known(result_ty) {
            result_ty = v4_ty_maybe_type(payload_ty)
        }
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_some, expr_text, "Some", payload_id, 0 - 1, expr_span, result_ty)
    }

    if first_value == "ok" {
        pilot ok_expected = v4_ty_unknown
        pilot result_ty = v4_ty_unknown
        if v4_ty_is_result_type(expected_ty) {
            ok_expected = v4_ty_result_ok_type(expected_ty)
            result_ty = expected_ty
        }
        pilot payload_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, next_token + 1, close_token, ok_expected)
        pilot payload_ty = v4_mir_rvalue_ty(mir_id, body_id, payload_id)
        v4_mir_reject_aggregate_lend_child(mir_id, body_id, "a result ok()", "the ok() payload", payload_id)
        if v4_ty_is_known(ok_expected) and not v4_ty_types_compatible(ok_expected, payload_ty) {
            v4_mir_add_type_error(mir_id, expr_span, "ok payload type mismatch", "ok expects " + ok_expected + " but got " + payload_ty)
        }
        if not v4_ty_is_known(result_ty) {
            result_ty = v4_ty_result_type(payload_ty, v4_ty_unknown)
        }
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_ok, expr_text, "Ok", payload_id, 0 - 1, expr_span, result_ty)
    }

    pilot err_expected = v4_ty_unknown
    pilot result_ty = v4_ty_unknown
    if v4_ty_is_result_type(expected_ty) {
        err_expected = v4_ty_result_err_type(expected_ty)
        result_ty = expected_ty
    }
    pilot payload_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, next_token + 1, close_token, err_expected)
    pilot payload_ty = v4_mir_rvalue_ty(mir_id, body_id, payload_id)
    v4_mir_reject_aggregate_lend_child(mir_id, body_id, "a result err()", "the err() payload", payload_id)
    if v4_ty_is_known(err_expected) and not v4_ty_types_compatible(err_expected, payload_ty) {
        v4_mir_add_type_error(mir_id, expr_span, "err payload type mismatch", "err expects " + err_expected + " but got " + payload_ty)
    }
    if not v4_ty_is_known(result_ty) {
        result_ty = v4_ty_result_type(v4_ty_unknown, payload_ty)
    }
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_err, expr_text, "Err", payload_id, 0 - 1, expr_span, result_ty)
}

task v4_mir_try_lower_try_expr(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    if v4_lex_token_value(stream_id, last) != "?" {
        give back 0 - 1
    }
    if first >= last {
        give back 0 - 1
    }

    pilot source_id = v4_mir_lower_expr(mir_id, body_id, stream_id, first, last)
    pilot source_ty = v4_mir_rvalue_ty(mir_id, body_id, source_id)
    pilot result_ty = v4_ty_unknown
    pilot return_ty = v4_mir_expected_return_type(mir_id, body_id)
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    pilot op_text = "Try"

    if v4_ty_is_maybe_type(source_ty) {
        result_ty = v4_ty_maybe_value_type(source_ty)
        op_text = "TryMaybe"
        if v4_ty_is_known(return_ty) and not v4_ty_is_maybe_type(return_ty) {
            v4_mir_add_type_error(mir_id, expr_span, "? maybe propagation needs maybe return", "task returns " + return_ty)
        }
    } else if v4_ty_is_result_type(source_ty) {
        result_ty = v4_ty_result_ok_type(source_ty)
        op_text = "TryResult"
        if v4_ty_is_known(return_ty) and not v4_ty_is_result_type(return_ty) {
            v4_mir_add_type_error(mir_id, expr_span, "? result propagation needs result return", "task returns " + return_ty)
        } else if v4_ty_is_result_type(return_ty) {
            pilot source_err_ty = v4_ty_result_err_type(source_ty)
            pilot return_err_ty = v4_ty_result_err_type(return_ty)
            if not v4_ty_types_compatible(return_err_ty, source_err_ty) {
                v4_mir_add_type_error(mir_id, expr_span, "? result error type mismatch", "source error " + source_err_ty + " cannot propagate into " + return_err_ty)
            }
        }
    } else if v4_ty_is_known(source_ty) {
        v4_mir_add_type_error(mir_id, expr_span, "? needs maybe or result source", "got " + source_ty)
    }

    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_try, expr_text, op_text, source_id, 0 - 1, expr_span, result_ty)
}

task v4_mir_try_lower_or_else_expr(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    pilot or_token = v4_mir_find_or_else_op(stream_id, first, last + 1)
    if or_token <= first or or_token >= last {
        give back 0 - 1
    }
    pilot else_token = v4_mir_next_nontrivia(stream_id, or_token + 1, last + 1)
    if else_token > last or v4_lex_token_value(stream_id, else_token) != "else" {
        give back 0 - 1
    }

    pilot source_id = v4_mir_lower_expr(mir_id, body_id, stream_id, first, or_token)
    pilot source_ty = v4_mir_rvalue_ty(mir_id, body_id, source_id)
    pilot payload_ty = v4_ty_unknown
    if v4_ty_is_maybe_type(source_ty) {
        payload_ty = v4_ty_maybe_value_type(source_ty)
    } else if v4_ty_is_result_type(source_ty) {
        payload_ty = v4_ty_result_ok_type(source_ty)
    } else if v4_ty_is_known(source_ty) {
        v4_mir_add_type_error(mir_id, expr_span, "or else needs maybe or result source", "got " + source_ty)
    }

    pilot fallback_expected = payload_ty
    if not v4_ty_is_known(fallback_expected) {
        fallback_expected = expected_ty
    }
    pilot fallback_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, else_token + 1, last + 1, fallback_expected)
    pilot fallback_ty = v4_mir_rvalue_ty(mir_id, body_id, fallback_id)
    pilot result_ty = payload_ty
    if not v4_ty_is_known(result_ty) {
        result_ty = fallback_ty
    }
    if v4_ty_is_known(payload_ty) and not v4_ty_types_compatible(payload_ty, fallback_ty) {
        v4_mir_add_type_error(mir_id, expr_span, "or else fallback type mismatch", "fallback expects " + payload_ty + " but got " + fallback_ty)
    }

    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_or_else, expr_text, "OrElse", source_id, fallback_id, expr_span, result_ty)
}

task v4_mir_lend_operand_expected_ty(expected_ty: word) -> word {
    if v4_ty_is_lend_type(expected_ty) {
        give back v4_ty_lend_target_type(expected_ty)
    }
    give back v4_ty_unknown
}

task v4_mir_closure_capture_kind(mode: word) -> word {
    if mode == v4_ty_closure_mode_copy { give back v4_mir_rvalue_capture_copy }
    if mode == v4_ty_closure_mode_move { give back v4_mir_rvalue_capture_move }
    if mode == v4_ty_closure_mode_mut { give back v4_mir_rvalue_capture_borrow_mut }
    give back v4_mir_rvalue_capture_borrow
}

task v4_mir_closure_param_names(mir_id: int, body_id: int, closure_offset: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 {
        give back ""
    }
    pilot hir_id = v4_ty_signature_hir_id(ty_id)
    pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_id)
    pilot closure_id = v4_hir_closure_at_offset(hir_id, hir_item, closure_offset)
    if closure_id < 0 {
        give back ""
    }
    pilot names = ""
    pilot param_id = 0
    pilot param_count = v4_hir_closure_param_count(hir_id, hir_item, closure_id)
    repeat until param_id >= param_count {
        names = v4_mir_name_list_add(names, v4_hir_closure_param_name(hir_id, hir_item, closure_id, param_id))
        param_id += 1
    }
    give back names
}

task v4_mir_closure_type_for_body_offset(mir_id: int, body_id: int, closure_offset: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_ty_closure_type_for_offset(ty_id, v4_ty_signature_hir_item(ty_id, sig_id), closure_offset)
}

task v4_mir_closure_receiver_call_is_mutating(mir_id: int, body_id: int, stream_id: int, occurrence_token: int, body_end: int, capture_ty: word) -> bool {
    pilot dot_token = v4_mir_next_nontrivia(stream_id, occurrence_token + 1, body_end)
    if dot_token >= body_end or v4_lex_token_value(stream_id, dot_token) != "." {
        give back false
    }
    pilot method_token = v4_mir_next_nontrivia(stream_id, dot_token + 1, body_end)
    if method_token >= body_end {
        give back false
    }
    pilot open_token = v4_mir_next_nontrivia(stream_id, method_token + 1, body_end)
    if open_token >= body_end or v4_lex_token_value(stream_id, open_token) != "(" {
        give back false
    }

    pilot method_name = v4_lex_token_value(stream_id, method_token)
    pilot shared_base = v4_mir_nominal_builtin_shared_base(mir_id, capture_ty)
    if shared_base != "" and (method_name == "borrow_mut" or method_name == "get_mut") {
        give back true
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot method_ref = v4_mir_find_method_ref(mir_id, capture_ty, method_name, true)
    if method_ref != "" {
        pilot hir_item = v4_mir_method_ref_hir_item(method_ref)
        pilot method_id = v4_mir_method_ref_method_id(method_ref)
        give back v4_ty_impl_method_param_mode(ty_id, hir_item, method_id, 0) == v4_ty_param_mode_lend_mut
    }

    pilot bound_ref = v4_mir_find_dyn_method_ref(mir_id, capture_ty, method_name, true)
    if bound_ref == "" {
        bound_ref = v4_mir_find_bound_method_ref(mir_id, body_id, capture_ty, method_name, true)
    }
    if bound_ref != "" {
        give back v4_ty_doctrine_method_param_mode(ty_id, v4_mir_bound_method_ref_sig_id(bound_ref), v4_mir_bound_method_ref_method_id(bound_ref), 0) == v4_ty_param_mode_lend_mut
    }
    give back false
}

task v4_mir_closure_occurrence_is_mutated(mir_id: int, body_id: int, stream_id: int, occurrence_token: int, body_end: int, capture_ty: word) -> bool {
    if v4_mir_closure_receiver_call_is_mutating(mir_id, body_id, stream_id, occurrence_token, body_end, capture_ty) {
        give back true
    }
    pilot idx = occurrence_token + 1
    pilot depth = 0
    repeat until idx >= body_end {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot value = v4_lex_token_value(stream_id, idx)
        if token_type != v4_tok_trivia {
            if value == "(" or value == "[" {
                depth += 1
            } else if value == ")" or value == "]" {
                if depth > 0 { depth -= 1 }
            } else if depth == 0 and v4_mir_assignment_operator(value) {
                give back true
            } else if depth == 0 and (value == ";" or value == "}" or value == "{") {
                give back false
            }
        } else if value == "\n" and depth == 0 {
            give back false
        }
        idx += 1
    }
    give back false
}

task v4_mir_closure_local_decl_name_token(stream_id: int, token_id: int, body_end: int) -> int {
    if token_id < 0 or token_id >= body_end or v4_lex_token_value(stream_id, token_id) != "pilot" {
        give back 0 - 1
    }
    pilot name_token = v4_mir_next_nontrivia(stream_id, token_id + 1, body_end)
    if name_token >= body_end {
        give back 0 - 1
    }
    pilot token_type = v4_lex_token_type(stream_id, name_token)
    if token_type != v4_tok_ident and token_type != v4_tok_keyword {
        give back 0 - 1
    }
    give back name_token
}

task v4_mir_closure_identifier_is_member_name(stream_id: int, token_id: int, body_start: int) -> bool {
    pilot previous = v4_mir_prev_nontrivia(stream_id, token_id - 1, body_start)
    if previous < body_start {
        give back false
    }
    pilot previous_value = v4_lex_token_value(stream_id, previous)
    give back previous_value == "." or previous_value == "::"
}

task v4_mir_closure_scope_store(names_handle: int, depths_handle: int, active: int, name: word, depth: int) -> void {
    if active < array_len(names_handle) {
        array_set(names_handle, active, name)
        array_set(depths_handle, active, word_from_int(depth))
    } else {
        array_push(names_handle, name)
        array_push(depths_handle, word_from_int(depth))
    }
}

task v4_mir_closure_scope_pop(depths_handle: int, active: int, depth: int) -> int {
    repeat until active <= 0 {
        pilot local_depth = word_to_int(array_get(depths_handle, active - 1))
        if local_depth < depth {
            give back active
        }
        active -= 1
    }
    give back active
}

task v4_mir_closure_scope_contains(names_handle: int, active: int, wanted: word) -> bool {
    pilot local_id = active - 1
    repeat until local_id < 0 {
        pilot local_name: word = array_get(names_handle, local_id)
        if local_name == wanted {
            give back true
        }
        local_id -= 1
    }
    give back false
}

task v4_mir_closure_capture_is_mutated(mir_id: int, body_id: int, stream_id: int, capture_name: word, capture_ty: word, body_start: int, body_end: int, param_names: word) -> bool {
    pilot local_names_handle = array_new()
    pilot local_depths_handle = array_new()
    pilot local_active = 0
    pilot scope_depth = 0
    pilot idx = body_start
    repeat until idx >= body_end {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot token_value = v4_lex_token_value(stream_id, idx)
        if token_value == "{" {
            scope_depth += 1
            idx += 1
        } else if token_value == "}" {
            local_active = v4_mir_closure_scope_pop(local_depths_handle, local_active, scope_depth)
            if scope_depth > 0 { scope_depth -= 1 }
            idx += 1
        } else {
            pilot decl_name_token = v4_mir_closure_local_decl_name_token(stream_id, idx, body_end)
            if decl_name_token >= 0 {
                v4_mir_closure_scope_store(local_names_handle, local_depths_handle, local_active, v4_lex_token_value(stream_id, decl_name_token), scope_depth)
                local_active += 1
                idx = decl_name_token + 1
            } else {
                if (token_type == v4_tok_ident or token_type == v4_tok_keyword) and token_value == capture_name {
                    if not v4_mir_name_list_contains(param_names, capture_name) and not v4_mir_closure_scope_contains(local_names_handle, local_active, capture_name) and not v4_mir_closure_identifier_is_member_name(stream_id, idx, body_start) {
                        if v4_mir_closure_occurrence_is_mutated(mir_id, body_id, stream_id, idx, body_end, capture_ty) {
                            array_release(local_names_handle)
                            array_release(local_depths_handle)
                            give back true
                        }
                    }
                }
                idx += 1
            }
        }
    }
    array_release(local_names_handle)
    array_release(local_depths_handle)
    give back false
}

task v4_mir_closure_capture_diag(mir_id: int, mode: word, capture_name: word, capture_ty: word, capture_span: word, mutated: bool) -> void {
    if mode == v4_ty_closure_mode_copy and not v4_ty_is_copy_type(capture_ty) {
        v4_mir_add_type_error(mir_id, capture_span, "Yuuko cannot copy this closure capture", capture_name + " has type " + capture_ty + "; use a move closure to transfer ownership or a default closure to borrow it")
    }
    if mutated and mode != v4_ty_closure_mode_mut {
        pilot message = "Meiya keeps this closure capture immutable"
        if mode == v4_ty_closure_mode_move {
            message = "Meiya will not mutate an owned capture without a mut contract"
        } else if mode == v4_ty_closure_mode_copy {
            message = "A copied closure capture remains immutable"
        }
        v4_mir_add_type_error(mir_id, capture_span, message, "use a mut closure when " + capture_name + " must be changed through the closure environment")
    }
}

task v4_mir_try_lower_closure_expr(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word) -> int {
    pilot mode = v4_ty_closure_mode_borrow
    pilot open_token = first
    pilot first_value = v4_lex_token_value(stream_id, first)
    if first_value == v4_ty_closure_mode_copy or first_value == v4_ty_closure_mode_move or first_value == v4_ty_closure_mode_mut {
        mode = first_value
        open_token = v4_mir_next_nontrivia(stream_id, first + 1, last + 1)
    }
    if open_token > last or v4_lex_token_value(stream_id, open_token) != "|" {
        give back 0 - 1
    }

    pilot close_token = v4_parse_closure_close_pipe(stream_id, open_token, last + 1)
    if close_token < 0 {
        give back 0 - 1
    }
    pilot body_marker = v4_mir_next_nontrivia(stream_id, close_token + 1, last + 1)
    if body_marker > last {
        give back 0 - 1
    }
    pilot marker_value = v4_lex_token_value(stream_id, body_marker)
    if marker_value != "=>" and marker_value != "{" {
        give back 0 - 1
    }

    pilot body_start = v4_mir_next_nontrivia(stream_id, body_marker + 1, last + 1)
    pilot body_end = last + 1
    if marker_value == "{" and v4_lex_token_value(stream_id, last) == "}" {
        body_end = last
    }
    pilot closure_offset = v4_span_start(v4_lex_token_span(stream_id, first))
    pilot param_names = v4_mir_closure_param_names(mir_id, body_id, closure_offset)
    pilot local_names_handle = array_new()
    pilot local_depths_handle = array_new()
    pilot local_active = 0
    pilot scope_depth = 0
    pilot captured_names = ""
    pilot children_handle = array_new()
    pilot idx = body_start
    repeat until idx >= body_end {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot token_value = v4_lex_token_value(stream_id, idx)
        if token_value == "{" {
            scope_depth += 1
            idx += 1
        } else if token_value == "}" {
            local_active = v4_mir_closure_scope_pop(local_depths_handle, local_active, scope_depth)
            if scope_depth > 0 { scope_depth -= 1 }
            idx += 1
        } else {
            pilot decl_name_token = v4_mir_closure_local_decl_name_token(stream_id, idx, body_end)
            if decl_name_token >= 0 {
                v4_mir_closure_scope_store(local_names_handle, local_depths_handle, local_active, v4_lex_token_value(stream_id, decl_name_token), scope_depth)
                local_active += 1
                idx = decl_name_token + 1
            } else {
                if token_type == v4_tok_ident or token_type == v4_tok_keyword {
                    pilot capture_name = token_value
                    if not v4_mir_name_list_contains(param_names, capture_name) and not v4_mir_closure_scope_contains(local_names_handle, local_active, capture_name) and not v4_mir_name_list_contains(captured_names, capture_name) and not v4_mir_closure_identifier_is_member_name(stream_id, idx, body_start) {
                        pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, capture_name, v4_span_start(expr_span))
                        if local_id >= 0 {
                            captured_names = v4_mir_name_list_add(captured_names, capture_name)
                            pilot capture_ty = v4_mir_local_ty(mir_id, body_id, local_id)
                            pilot capture_span = v4_lex_token_span(stream_id, idx)
                            pilot mutated = v4_mir_closure_capture_is_mutated(mir_id, body_id, stream_id, capture_name, capture_ty, body_start, body_end, param_names)
                            v4_mir_closure_capture_diag(mir_id, mode, capture_name, capture_ty, capture_span, mutated)
                            pilot capture_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_closure_capture_kind(mode), capture_name, mode, 0 - 1, 0 - 1, capture_span, capture_ty)
                            array_push(children_handle, word_from_int(capture_rvalue))
                        }
                    }
                }
                idx += 1
            }
        }
    }
    array_release(local_names_handle)
    array_release(local_depths_handle)

    pilot closure_ty = v4_mir_closure_type_for_body_offset(mir_id, body_id, closure_offset)
    if not v4_ty_is_closure_type(closure_ty) {
        closure_ty = v4_ty_closure_type_prefix(mode) + "()->" + v4_ty_unknown
    }
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_aggregate_rvalue(mir_id, body_id, v4_mir_rvalue_closure, expr_text, mode, expr_span, closure_ty, children_handle)
}

task v4_mir_lend_source_is_place(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    give back kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place
}

task v4_mir_try_lower_lend_expr(mir_id: int, body_id: int, stream_id: int, first: int, last: int, expr_span: word, expected_ty: word) -> int {
    if v4_lex_token_value(stream_id, first) != "lend" {
        give back 0 - 1
    }

    pilot mode = v4_ty_param_mode_lend
    pilot rvalue_kind = v4_mir_rvalue_lend
    pilot operand_start = v4_mir_next_nontrivia(stream_id, first + 1, last + 1)
    if operand_start <= last and v4_lex_token_value(stream_id, operand_start) == "mut" {
        mode = v4_ty_param_mode_lend_mut
        rvalue_kind = v4_mir_rvalue_lend_mut
        operand_start = v4_mir_next_nontrivia(stream_id, operand_start + 1, last + 1)
    }

    if operand_start > last {
        v4_mir_add_type_error(mir_id, expr_span, "lend expression needs a source", "write lend value or lend mut value so Meiya knows which place is on loan")
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, v4_mir_expr_text(stream_id, first, last + 1), "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
    }

    pilot operand_expected_ty = v4_mir_lend_operand_expected_ty(expected_ty)
    pilot operand_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, operand_start, last + 1, operand_expected_ty)
    pilot operand_ty = v4_mir_rvalue_ty(mir_id, body_id, operand_id)
    if not v4_mir_lend_source_is_place(mir_id, body_id, operand_id) {
        v4_mir_add_type_error(mir_id, expr_span, "lend source must be a place", "Meiya can only loan a named local, field, index, or deref place; store the value first")
    }

    pilot result_ty = v4_ty_lend_type(operand_ty, mode)
    if v4_ty_is_lend_type(expected_ty) and v4_ty_lend_mode(expected_ty) == mode and v4_ty_types_compatible(v4_ty_lend_target_type(expected_ty), operand_ty) {
        pilot expected_lifetime = v4_ty_lend_lifetime(expected_ty)
        if expected_lifetime != "" {
            result_ty = v4_ty_lend_type_with_lifetime(operand_ty, mode, expected_lifetime)
        }
    }
    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    give back v4_mir_add_rvalue(mir_id, body_id, rvalue_kind, expr_text, mode, operand_id, 0 - 1, expr_span, result_ty)
}

task v4_mir_lower_expr_expected(mir_id: int, body_id: int, stream_id: int, start_token: int, end_token: int, expected_ty: word) -> int {
    pilot first = v4_mir_skip_trivia(stream_id, start_token)
    pilot last = v4_mir_last_nontrivia_before(stream_id, end_token)
    pilot expr_span = v4_mir_span_from_tokens(stream_id, start_token, end_token)
    if first >= end_token or last < first {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, "", "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
    }

    pilot try_rvalue = v4_mir_try_lower_try_expr(mir_id, body_id, stream_id, first, last, expr_span)
    if try_rvalue >= 0 {
        give back try_rvalue
    }

    pilot tuple_rvalue = v4_mir_try_lower_tuple_literal(mir_id, body_id, stream_id, first, last, expr_span)
    if tuple_rvalue >= 0 {
        give back tuple_rvalue
    }

    if v4_lex_token_value(stream_id, first) == "(" and v4_lex_token_value(stream_id, last) == ")" {
        pilot close_group = v4_mir_find_matching_paren(stream_id, first, last + 1)
        if close_group == last {
            give back v4_mir_lower_expr_expected(mir_id, body_id, stream_id, first + 1, last, expected_ty)
        }
    }

    pilot closure_rvalue = v4_mir_try_lower_closure_expr(mir_id, body_id, stream_id, first, last, expr_span)
    if closure_rvalue >= 0 {
        give back closure_rvalue
    }

    pilot or_else_rvalue = v4_mir_try_lower_or_else_expr(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if or_else_rvalue >= 0 {
        give back or_else_rvalue
    }

    pilot lend_rvalue = v4_mir_try_lower_lend_expr(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if lend_rvalue >= 0 {
        give back lend_rvalue
    }

    pilot route_ctor_rvalue = v4_mir_try_lower_route_payload_ctor(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if route_ctor_rvalue >= 0 {
        give back route_ctor_rvalue
    }

    pilot ctor_rvalue = v4_mir_try_lower_shape_ctor(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if ctor_rvalue >= 0 {
        give back ctor_rvalue
    }

    pilot route_case_rvalue = v4_mir_try_lower_route_case_expr(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if route_case_rvalue >= 0 {
        give back route_case_rvalue
    }

    pilot associated_method_rvalue = v4_mir_try_lower_associated_method_call(mir_id, body_id, stream_id, first, last, expr_span)
    if associated_method_rvalue >= 0 {
        give back associated_method_rvalue
    }

    pilot tier = 1
    repeat until tier > 5 {
        pilot op_token = v4_mir_find_binary_op(stream_id, first, last + 1, tier)
        if op_token > first and op_token < last {
            pilot left_id = v4_mir_lower_expr(mir_id, body_id, stream_id, first, op_token)
            pilot right_id = v4_mir_lower_expr(mir_id, body_id, stream_id, op_token + 1, last + 1)
            pilot op_text = v4_lex_token_value(stream_id, op_token)
            pilot op_kind = v4_mir_operator_kind(op_text)
            pilot left_ty = v4_mir_rvalue_ty(mir_id, body_id, left_id)
            pilot right_ty = v4_mir_rvalue_ty(mir_id, body_id, right_id)
            pilot result_ty = v4_mir_binary_result_type(mir_id, op_kind, left_ty, right_ty)
            v4_mir_check_binary_types(mir_id, expr_span, op_kind, left_ty, right_ty)
            pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
            pilot overload_rvalue = v4_mir_try_lower_binary_operator_overload(mir_id, body_id, left_id, right_id, expr_text, expr_span, op_kind, left_ty, right_ty)
            if overload_rvalue >= 0 {
                give back overload_rvalue
            }
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, expr_text, op_kind, left_id, right_id, expr_span, result_ty)
        }
        tier += 1
    }

    pilot first_type = v4_lex_token_type(stream_id, first)
    pilot first_value = v4_lex_token_value(stream_id, first)
    pilot next_token = v4_mir_next_nontrivia(stream_id, first + 1, last + 1)
    pilot unary_kind = v4_mir_unary_op_kind(first_value)
    if unary_kind == "" and v4_mir_is_generic_instance_method_call_shape(stream_id, first, last) {
        pilot generic_instance_method_rvalue = v4_mir_try_lower_instance_method_call(mir_id, body_id, stream_id, first, last, expr_span)
        if generic_instance_method_rvalue >= 0 {
            give back generic_instance_method_rvalue
        }
    }

    if unary_kind != "" and first < last {
        pilot operand_id = v4_mir_lower_expr(mir_id, body_id, stream_id, first + 1, last + 1)
        pilot operand_ty = v4_mir_rvalue_ty(mir_id, body_id, operand_id)
        pilot result_ty = v4_mir_unary_result_type(mir_id, unary_kind, operand_ty)
        v4_mir_check_unary_type(mir_id, expr_span, unary_kind, operand_ty)
        pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
        pilot overload_rvalue = v4_mir_try_lower_unary_operator_overload(mir_id, body_id, operand_id, expr_text, expr_span, unary_kind, operand_ty)
        if overload_rvalue >= 0 {
            give back overload_rvalue
        }
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unary, expr_text, unary_kind, operand_id, 0 - 1, expr_span, result_ty)
    }

    if first_type == v4_tok_int {
        pilot literal_ty = v4_ty_int_literal_type(first_value, expected_ty)
        pilot literal_value = v4_ty_numeric_literal_value(first_value)
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, literal_value, "", 0 - 1, 0 - 1, expr_span, literal_ty)
    }
    if first_type == v4_tok_float {
        pilot literal_ty = v4_ty_float_literal_type(first_value, expected_ty)
        pilot literal_value = v4_ty_numeric_literal_value(first_value)
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_float, literal_value, "", 0 - 1, 0 - 1, expr_span, literal_ty)
    }
    if first_type == v4_tok_string {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_word, first_value, "", 0 - 1, 0 - 1, expr_span, v4_ty_word)
    }
    if first_type == v4_tok_bool {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_bool, first_value, "", 0 - 1, 0 - 1, expr_span, v4_ty_bool)
    }
    if first_type == v4_tok_char {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_char, first_value, "", 0 - 1, 0 - 1, expr_span, v4_ty_char)
    }

    pilot array_rvalue = v4_mir_try_lower_array_literal(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if array_rvalue >= 0 {
        give back array_rvalue
    }

    pilot list_rvalue = v4_mir_try_lower_list_literal(mir_id, body_id, stream_id, first, last, expr_span)
    if list_rvalue >= 0 {
        give back list_rvalue
    }

    pilot map_rvalue = v4_mir_try_lower_map_literal(mir_id, body_id, stream_id, first, last, expr_span)
    if map_rvalue >= 0 {
        give back map_rvalue
    }

    pilot maybe_result_rvalue = v4_mir_try_lower_maybe_result_ctor(mir_id, body_id, stream_id, first, last, expr_span, expected_ty)
    if maybe_result_rvalue >= 0 {
        give back maybe_result_rvalue
    }

    pilot named_call_rvalue = v4_mir_try_lower_named_call(mir_id, body_id, stream_id, first, last, expr_span)
    if named_call_rvalue >= 0 {
        give back named_call_rvalue
    }

    pilot instance_method_rvalue = v4_mir_try_lower_instance_method_call(mir_id, body_id, stream_id, first, last, expr_span)
    if instance_method_rvalue >= 0 {
        give back instance_method_rvalue
    }

    pilot expr_text = v4_mir_expr_text(stream_id, first, last + 1)
    if next_token <= last and v4_lex_token_value(stream_id, next_token) == "(" {
        pilot close_token = v4_mir_find_matching_paren(stream_id, next_token, last + 1)
        pilot sig_id = v4_mir_signature_id_for_name(mir_id, first_value)
        if sig_id >= 0 {
            pilot target_name = v4_mir_resolved_callee_name(mir_id, first_value)
            v4_mir_warn_unwinder_call_site(mir_id, expr_span, sig_id)
            pilot call_check = v4_mir_check_call_args(mir_id, body_id, stream_id, expr_span, first_value, sig_id, next_token, close_token)
            pilot generic_env = v4_mir_call_check_result_env(call_check)
            pilot args_payload = v4_mir_call_check_result_args(call_check)
            pilot return_ty = v4_mir_signature_return_type_for_id(mir_id, sig_id)
            return_ty = v4_ty_signature_return_type_for_env(v4_mir_ty_id(mir_id), sig_id, generic_env)
            return_ty = v4_mir_call_result_type(return_ty)
            pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, target_name, 0 - 1, 0 - 1, expr_span, return_ty)
            v4_mir_set_rvalue_abi(mir_id, body_id, call_rvalue, v4_mir_signature_call_abi(mir_id, sig_id))
            v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
            give back call_rvalue
        }

        pilot callee_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, first, next_token)
        pilot callee_ty = v4_mir_rvalue_ty(mir_id, body_id, callee_rvalue)
        if v4_ty_is_surface_extern_function_pointer_type(callee_ty) {
            pilot args_payload = v4_mir_check_callback_call_args(mir_id, body_id, stream_id, expr_span, v4_mir_expr_text(stream_id, first, next_token), callee_ty, next_token, close_token)
            pilot return_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_function_type_return_text(callee_ty))
            pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, v4_mir_rvalue_text(mir_id, body_id, callee_rvalue), callee_rvalue, 0 - 1, expr_span, return_ty)
            v4_mir_set_rvalue_abi(mir_id, body_id, call_rvalue, v4_ty_function_type_call_abi(callee_ty))
            v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
            give back call_rvalue
        }

        if v4_ty_is_closure_type(callee_ty) {
            pilot callable_ty = v4_ty_closure_as_task_type(callee_ty)
            pilot args_payload = v4_mir_check_callback_call_args(mir_id, body_id, stream_id, expr_span, v4_mir_expr_text(stream_id, first, next_token), callable_ty, next_token, close_token)
            pilot return_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_closure_return_type(callee_ty))
            pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, v4_mir_rvalue_text(mir_id, body_id, callee_rvalue), callee_rvalue, 0 - 1, expr_span, return_ty)
            v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
            give back call_rvalue
        }

        if v4_ty_is_known(callee_ty) {
            v4_mir_add_type_error(mir_id, expr_span, "call target is not callable", v4_mir_expr_text(stream_id, first, next_token) + " has type " + callee_ty + "; only tasks and extern callback values can be called")
            v4_mir_lower_ignored_call_args(mir_id, body_id, stream_id, next_token, close_token)
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
        }

        pilot call_check = v4_mir_check_call_args(mir_id, body_id, stream_id, expr_span, first_value, sig_id, next_token, close_token)
        pilot args_payload = v4_mir_call_check_result_args(call_check)
        pilot call_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_call, expr_text, first_value, 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
        v4_mir_set_rvalue_args_payload(mir_id, body_id, call_rvalue, args_payload)
        give back call_rvalue
    }
    if first == last {
        pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, first_value, v4_span_start(expr_span))
        if local_id >= 0 {
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_local, first_value, first_value, 0 - 1, 0 - 1, expr_span, v4_mir_local_ty(mir_id, body_id, local_id))
        }
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_symbol, first_value, first_value, 0 - 1, 0 - 1, expr_span, v4_mir_symbol_value_type(mir_id, first_value))
    }

    pilot place_id = v4_mir_lower_place(mir_id, body_id, stream_id, first, last + 1)
    if v4_mir_place_kind(mir_id, body_id, place_id) != v4_mir_place_unknown {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_place, expr_text, v4_mir_place_text(mir_id, body_id, place_id), place_id, 0 - 1, expr_span, v4_mir_place_ty(mir_id, body_id, place_id))
    }

    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, expr_text, "", 0 - 1, 0 - 1, expr_span, v4_ty_unknown)
}

task v4_mir_lower_expr(mir_id: int, body_id: int, stream_id: int, start_token: int, end_token: int) -> int {
    give back v4_mir_lower_expr_expected(mir_id, body_id, stream_id, start_token, end_token, v4_ty_unknown)
}

task v4_mir_find_top_level_token(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot idx = end_token - 1
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == ")" or val == "]" or val == "}" {
                depth += 1
            } else if val == "(" or val == "[" or val == "{" {
                if depth > 0 {
                    depth -= 1
                }
            } else if depth == 0 and val == wanted {
                give back idx
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_find_open_index_token(stream_id: int, start_token: int, close_token: int) -> int {
    pilot idx = close_token
    pilot depth = 0
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "]" {
                depth += 1
            } else if val == "[" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_mir_tuple_slot_segment_end(slot_text: word, start_pos: int) -> int {
    pilot pos = start_pos
    repeat until pos >= slot_text.length() {
        if slot_text.char_at(pos) == "." {
            give back pos
        }
        pos += 1
    }
    give back slot_text.length()
}

task v4_mir_is_tuple_slot_chain(slot_text: word) -> bool {
    if slot_text == "" {
        give back false
    }

    pilot segment_start = 0
    repeat until segment_start >= slot_text.length() {
        pilot segment_end = v4_mir_tuple_slot_segment_end(slot_text, segment_start)
        if segment_end <= segment_start {
            give back false
        }

        pilot idx = segment_start
        repeat until idx >= segment_end {
            pilot ch = slot_text.char_at(idx)
            if not v4_lex_is_digit(ch) {
                give back false
            }
            idx += 1
        }

        if segment_end >= slot_text.length() {
            give back true
        }
        segment_start = segment_end + 1
    }
    give back true
}

task v4_mir_lower_place(mir_id: int, body_id: int, stream_id: int, start_token: int, end_token: int) -> int {
    pilot first = v4_mir_skip_trivia(stream_id, start_token)
    pilot last = v4_mir_last_nontrivia_before(stream_id, end_token)
    pilot place_span = v4_mir_span_from_tokens(stream_id, start_token, end_token)
    if first >= end_token or last < first {
        give back v4_mir_add_place(mir_id, body_id, v4_mir_place_unknown, "", 0 - 1, "", 0 - 1, place_span, v4_ty_unknown)
    }

    if v4_lex_token_value(stream_id, first) == "*" and first < last {
        pilot ptr_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, first + 1, last + 1)
        pilot ptr_ty = v4_mir_rvalue_ty(mir_id, body_id, ptr_rvalue)
        pilot deref_text = v4_mir_expr_text(stream_id, first, last + 1)
        pilot pointee_ty = v4_ty_unknown
        if v4_ty_is_known(ptr_ty) and v4_ty_is_raw_pointer_type(ptr_ty) == false {
            v4_mir_add_type_error(mir_id, place_span, "raw-pointer deref needs *T or *mut T", "got " + ptr_ty + "; only raw pointers can be dereferenced with *")
        } else if v4_ty_is_known(ptr_ty) {
            pointee_ty = v4_ty_raw_pointer_target_type(ptr_ty)
            if v4_ty_is_mutable_raw_pointer_type(ptr_ty) == false {
                v4_mir_add_type_error(mir_id, place_span, "raw-pointer write needs *mut T", "got " + ptr_ty + "; only *mut T pointers can be written through, *const T and *T are read-only")
            }
        }
        if v4_mir_inside_trust_me() == false {
            v4_mir_add_type_error(mir_id, place_span, "raw-pointer deref needs trust me block", "wrap the deref in a trust me block; bible section 16.4 forbids dereferencing raw pointers outside trust me")
        } else {
            v4_mir_check_trust_honor(mir_id, place_span, "raw-pointer write", "pilot")
        }
        give back v4_mir_add_place(mir_id, body_id, v4_mir_place_deref, deref_text, 0 - 1, "", ptr_rvalue, place_span, pointee_ty)
    }

    pilot place_text = v4_mir_expr_text(stream_id, first, last + 1)
    if v4_lex_token_value(stream_id, last) == "]" {
        pilot open_index = v4_mir_find_open_index_token(stream_id, first, last)
        if open_index > first {
            pilot base_place = v4_mir_lower_place(mir_id, body_id, stream_id, first, open_index)
            pilot index_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, open_index + 1, last)
            pilot base_ty = v4_mir_place_ty(mir_id, body_id, base_place)
            pilot indexed_ty = base_ty
            if v4_ty_is_lend_type(indexed_ty) {
                indexed_ty = v4_ty_lend_target_type(indexed_ty)
            }
            pilot index_ty = v4_mir_rvalue_ty(mir_id, body_id, index_rvalue)
            pilot element_ty = v4_ty_index_element_type(indexed_ty)
            pilot map_key_ty = v4_ty_map_key_type(indexed_ty)
            if v4_ty_is_known(indexed_ty) and not v4_ty_is_known(element_ty) {
                v4_mir_add_type_error(mir_id, place_span, "index target not indexable", indexed_ty + " is not indexable")
            }
            if v4_ty_is_known(index_ty) {
                if v4_ty_is_known(map_key_ty) {
                    if not v4_ty_types_compatible(map_key_ty, index_ty) {
                        v4_mir_add_type_error(mir_id, place_span, "map key type mismatch", indexed_ty + " wants key " + map_key_ty + " but got " + index_ty)
                    }
                } else if not v4_ty_is_numeric(index_ty) {
                    v4_mir_add_type_error(mir_id, place_span, "index expression must be numeric", "got " + index_ty)
                }
            }
            give back v4_mir_add_place(mir_id, body_id, v4_mir_place_index, place_text, base_place, "", index_rvalue, place_span, element_ty)
        }
    }

    pilot dot_token = v4_mir_find_top_level_token(stream_id, first, last + 1, ".")
    if dot_token > first and dot_token < last {
        pilot base_place = v4_mir_lower_place(mir_id, body_id, stream_id, first, dot_token)
        pilot field_token = v4_mir_next_nontrivia(stream_id, dot_token + 1, last + 1)
        pilot field_name = ""
        if field_token <= last {
            field_name = v4_lex_token_value(stream_id, field_token)
        }
        pilot base_ty = v4_mir_place_ty(mir_id, body_id, base_place)
        pilot projected_ty = base_ty
        if v4_ty_is_lend_type(projected_ty) {
            projected_ty = v4_ty_lend_target_type(projected_ty)
        }
        pilot field_ty = v4_ty_unknown
        if v4_ty_is_tuple_type(projected_ty) {
            if v4_mir_is_tuple_slot_chain(field_name) {
                pilot current_place = base_place
                pilot current_ty = projected_ty
                pilot current_text = v4_mir_place_text(mir_id, body_id, base_place)
                pilot segment_start = 0
                repeat until segment_start >= field_name.length() {
                    pilot segment_end = v4_mir_tuple_slot_segment_end(field_name, segment_start)
                    pilot slot_name = v4_slice(field_name, segment_start, segment_end)
                    current_text = current_text + "." + slot_name

                    pilot slot_ty = v4_ty_unknown
                    if v4_ty_is_tuple_type(current_ty) {
                        slot_ty = v4_ty_tuple_slot_type(current_ty, word_to_int(slot_name))
                        if not v4_ty_is_known(slot_ty) {
                            v4_mir_add_type_error(mir_id, place_span, "tuple slot out of range", current_ty + " has no slot " + slot_name)
                        }
                    } else if v4_ty_is_known(current_ty) {
                        v4_mir_add_type_error(mir_id, place_span, "tuple slot access on non-tuple type", current_ty + " has no tuple slots")
                    }

                    current_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, current_text, current_place, slot_name, 0 - 1, place_span, slot_ty)
                    current_ty = slot_ty
                    field_ty = slot_ty
                    segment_start = segment_end + 1
                }
                give back current_place
            } else {
                v4_mir_add_type_error(mir_id, place_span, "tuple slot must be int literal", "use .0, .1, ... on " + projected_ty)
            }
        } else {
            field_ty = v4_ty_shape_field_type_for_name(v4_mir_ty_id(mir_id), projected_ty, field_name)
            if v4_ty_is_known(projected_ty) and not v4_ty_is_known(field_ty) {
                if v4_mir_is_tuple_slot_chain(field_name) {
                    v4_mir_add_type_error(mir_id, place_span, "tuple slot access on non-tuple type", projected_ty + " has no tuple slots")
                } else if v4_ty_shape_signature_id_for_name(v4_mir_ty_id(mir_id), projected_ty) >= 0 {
                    v4_mir_add_type_error(mir_id, place_span, "unknown field access", projected_ty + " has no field " + field_name)
                } else {
                    v4_mir_add_type_error(mir_id, place_span, "field access on non-shape type", projected_ty + " has no fields")
                }
            }
        }
        give back v4_mir_add_place(mir_id, body_id, v4_mir_place_field, place_text, base_place, field_name, 0 - 1, place_span, field_ty)
    }

    if first == last {
        pilot local_name = v4_lex_token_value(stream_id, first)
        pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, local_name, v4_span_start(place_span))
        if local_id >= 0 {
            give back v4_mir_add_place(mir_id, body_id, v4_mir_place_local, local_name, 0 - 1, local_name, 0 - 1, place_span, v4_mir_local_ty(mir_id, body_id, local_id))
        }
    }

    give back v4_mir_add_place(mir_id, body_id, v4_mir_place_unknown, place_text, 0 - 1, "", 0 - 1, place_span, v4_ty_unknown)
}

task v4_mir_find_else_token(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" {
                depth += 1
            } else if val == "}" {
                if depth > 0 {
                    depth -= 1
                }
            } else if val == "else" {
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_lower_if_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, if_token: int, stmt_end: int) -> int {
    pilot open_token = v4_mir_find_token_value(stream_id, if_token, stmt_end, "{")
    if open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, if_token, stmt_end)
    }

    pilot then_close = v4_mir_find_matching_brace(stream_id, open_token, stmt_end)
    pilot else_token = v4_mir_find_else_token(stream_id, then_close + 1, stmt_end)
    pilot condition = v4_mir_expr_text(stream_id, if_token + 1, open_token)
    pilot then_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot else_block = after_block
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, if_token, stmt_end)
    pilot condition_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, if_token + 1, open_token)
    v4_mir_check_condition_type(mir_id, stmt_span, "if", v4_mir_rvalue_ty(mir_id, body_id, condition_rvalue))

    if else_token >= 0 {
        pilot else_head = v4_mir_skip_trivia(stream_id, else_token + 1)
        if else_head < stmt_end and v4_lex_token_value(stream_id, else_head) == "if" {
            else_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
            pilot nested_after = v4_mir_lower_if_stmt(mir_id, body_id, else_block, stream_id, else_head, stmt_end)
            v4_mir_seal_block_goto_if_live(mir_id, body_id, nested_after, after_block)
        } else {
            pilot else_open = v4_mir_find_token_value(stream_id, else_token, stmt_end, "{")
            if else_open >= 0 {
                else_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
                pilot else_tail = v4_mir_lower_block_body(mir_id, body_id, else_block, stream_id, else_open, stmt_end)
                v4_mir_seal_block_goto_if_live(mir_id, body_id, else_tail, after_block)
            }
        }
    }

    pilot condition_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, condition_rvalue)
    v4_mir_set_body_block(mir_id, body_id, condition_block, v4_mir_block_new_full(condition_block, v4_mir_term_if, then_block, else_block, condition))
    v4_mir_add_stmt(mir_id, body_id, condition_block, v4_mir_stmt_branch, condition, "then#" + word_from_int(then_block) + " else#" + word_from_int(else_block), stmt_span, 0 - 1, condition_rvalue)
    pilot then_tail = v4_mir_lower_block_body(mir_id, body_id, then_block, stream_id, open_token, then_close + 1)
    v4_mir_seal_block_goto_if_live(mir_id, body_id, then_tail, after_block)

    give back after_block
}

task v4_mir_lower_repeat_until_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, repeat_token: int, stmt_end: int) -> int {
    pilot open_token = v4_mir_find_token_value(stream_id, repeat_token, stmt_end, "{")
    if open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, repeat_token, stmt_end)
    }

    pilot stmt_span = v4_mir_span_from_tokens(stream_id, repeat_token, stmt_end)
    pilot next_kw = v4_mir_skip_trivia(stream_id, repeat_token + 1)
    pilot times_token = v4_mir_find_token_value(stream_id, repeat_token + 1, open_token, "times")

    if times_token >= 0 {
        -- repeat N times { body }
        pilot count_text = v4_mir_expr_text(stream_id, repeat_token + 1, times_token)
        pilot count_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, repeat_token + 1, times_token)
        pilot count_ty = v4_mir_rvalue_ty(mir_id, body_id, count_rvalue)
        if v4_ty_is_known(count_ty) and count_ty != v4_ty_int {
            v4_mir_add_type_error(mir_id, stmt_span, "repeat N times count must be int", "got " + count_ty)
        }

        -- Synthetic counter local: _repeat_i (pick unique name based on block count)
        pilot counter_name = "_repeat_i"
        if v4_mir_find_local(mir_id, body_id, counter_name) >= 0 {
            counter_name = "_repeat_i2"
        }
        pilot counter_local = v4_mir_add_local(mir_id, body_id, counter_name, v4_ty_int, stmt_span)
        pilot counter_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, counter_name, counter_local, counter_name, 0 - 1, stmt_span, v4_ty_int)
        pilot count_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, count_rvalue)
        v4_mir_add_stmt(mir_id, body_id, count_block, v4_mir_stmt_local, counter_name, count_text, stmt_span, counter_place, count_rvalue)

        -- Loop check: _repeat_i > 0
        pilot zero_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, "0", "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
        pilot counter_use = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_local, counter_name, counter_name, 0 - 1, 0 - 1, stmt_span, v4_ty_int)
        pilot check_cond_text = counter_name + " > 0"
        pilot check_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, check_cond_text, "Gt", counter_use, zero_rvalue, stmt_span, v4_ty_bool)
        pilot loop_lhs = "repeat " + count_text + " times"
        pilot body_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
        pilot continue_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
        pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
        pilot condition_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")

        v4_mir_seal_block_goto_if_live(mir_id, body_id, count_block, condition_block)
        v4_mir_set_body_block(mir_id, body_id, condition_block, v4_mir_block_new_full(condition_block, v4_mir_term_if, body_block, after_block, check_cond_text))
        v4_mir_add_stmt(mir_id, body_id, condition_block, v4_mir_stmt_loop, loop_lhs, "body#" + word_from_int(body_block) + " exit#" + word_from_int(after_block), stmt_span, 0 - 1, check_rvalue)

        -- Lower body
        v4_mir_push_loop_context(after_block, continue_block)
        pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, body_block, stream_id, open_token, stmt_end)
        v4_mir_pop_loop_context()

        -- Decrement counter in body block: _repeat_i = _repeat_i - 1
        if v4_mir_block_terminator(v4_mir_body_block(mir_id, body_id, body_tail)) == v4_mir_term_return and not v4_mir_block_has_return_stmt(mir_id, body_id, body_tail) {
            pilot dec_counter_use = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_local, counter_name, counter_name, 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot one_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, "1", "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot dec_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, counter_name + " - 1", "Sub", dec_counter_use, one_rvalue, stmt_span, v4_ty_int)
            pilot dec_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, counter_name, counter_local, counter_name, 0 - 1, stmt_span, v4_ty_int)
            v4_mir_add_stmt(mir_id, body_id, body_tail, v4_mir_stmt_assign, counter_name, counter_name + " - 1", stmt_span, dec_place, dec_rvalue)
        }
        v4_mir_seal_block_goto_if_live(mir_id, body_id, body_tail, condition_block)
        if v4_mir_body_block_predecessor_count(mir_id, body_id, continue_block) > 0 and not v4_mir_block_has_return_stmt(mir_id, body_id, continue_block) {
            pilot continue_counter_use = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_use_local, counter_name, counter_name, 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot continue_one = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, "1", "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot continue_dec = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, counter_name + " - 1", "Sub", continue_counter_use, continue_one, stmt_span, v4_ty_int)
            pilot continue_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, counter_name, counter_local, counter_name, 0 - 1, stmt_span, v4_ty_int)
            v4_mir_add_stmt(mir_id, body_id, continue_block, v4_mir_stmt_assign, counter_name, counter_name + " - 1", stmt_span, continue_place, continue_dec)
            v4_mir_set_body_block(mir_id, body_id, continue_block, v4_mir_block_new_full(continue_block, v4_mir_term_goto, condition_block, 0 - 1, ""))
        }

        give back after_block
    }

    pilot condition_start = repeat_token + 1
    if next_kw < open_token {
        if v4_lex_token_value(stream_id, next_kw) == "until" {
            condition_start = next_kw + 1
        }
    }

    pilot condition = v4_mir_expr_text(stream_id, condition_start, open_token)
    pilot body_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot loop_entry_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    v4_mir_seal_block_goto_if_live(mir_id, body_id, block_id, loop_entry_block)
    pilot condition_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, condition_start, open_token)
    v4_mir_check_condition_type(mir_id, stmt_span, "repeat-until", v4_mir_rvalue_ty(mir_id, body_id, condition_rvalue))

    pilot condition_block = v4_mir_wire_try_propagation(mir_id, body_id, loop_entry_block, stmt_span, condition_rvalue)
    v4_mir_set_body_block(mir_id, body_id, condition_block, v4_mir_block_new_full(condition_block, v4_mir_term_if, after_block, body_block, "until " + condition))
    v4_mir_add_stmt(mir_id, body_id, condition_block, v4_mir_stmt_loop, condition, "body#" + word_from_int(body_block) + " exit#" + word_from_int(after_block), stmt_span, 0 - 1, condition_rvalue)
    v4_mir_push_loop_context(after_block, loop_entry_block)
    pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, body_block, stream_id, open_token, stmt_end)
    v4_mir_pop_loop_context()
    v4_mir_seal_block_goto_if_live(mir_id, body_id, body_tail, loop_entry_block)

    give back after_block
}

task v4_mir_pattern_is_simple_local(pattern: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" {
        give back false
    }
    if v4_lex_is_bool_word(pattern) {
        give back false
    }
    if not v4_lex_is_ident_start(pattern.char_at(0)) {
        give back false
    }
    pilot idx = 1
    repeat until idx >= pattern.length() {
        if not v4_lex_is_ident_continue(pattern.char_at(idx)) {
            give back false
        }
        idx += 1
    }
    give back true
}

task v4_mir_pattern_is_space(ch: word) -> bool {
    give back ch == " " or ch == "\n" or ch == "\t" or ch == "\r"
}

task v4_mir_pattern_trim(pattern: word) -> word {
    pilot start_pos = 0
    pilot found_start = false
    repeat until start_pos >= pattern.length() {
        if not v4_mir_pattern_is_space(pattern.char_at(start_pos)) {
            found_start = true
            start_pos = pattern.length()
        } else {
            start_pos += 1
        }
    }

    if found_start == false {
        give back ""
    }

    pilot trim_start = 0
    repeat until trim_start >= pattern.length() {
        if not v4_mir_pattern_is_space(pattern.char_at(trim_start)) {
            start_pos = trim_start
            trim_start = pattern.length()
        } else {
            trim_start += 1
        }
    }

    pilot end_pos = pattern.length()
    repeat until end_pos <= start_pos {
        if not v4_mir_pattern_is_space(pattern.char_at(end_pos - 1)) {
            give back v4_slice(pattern, start_pos, end_pos)
        }
        end_pos -= 1
    }
    give back ""
}

task v4_mir_pattern_find_top_level_char(pattern: word, wanted: word, start_pos: int, end_pos: int) -> int {
    pilot depth = 0
    pilot idx = start_pos
    repeat until idx >= end_pos {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == wanted {
            give back idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_is_tuple_pattern(pattern: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern.length() < 5 {
        give back false
    }
    if pattern.char_at(0) != "(" or pattern.char_at(pattern.length() - 1) != ")" {
        give back false
    }
    give back v4_mir_pattern_find_top_level_char(pattern, ",", 1, pattern.length() - 1) > 1
}

task v4_mir_is_bracket_pattern(pattern: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern.length() < 3 {
        give back false
    }
    if pattern.char_at(0) != "[" or pattern.char_at(pattern.length() - 1) != "]" {
        give back false
    }
    give back v4_mir_pattern_trim(v4_slice(pattern, 1, pattern.length() - 1)) != ""
}

task v4_mir_tuple_pattern_slot_count(pattern: word) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if not v4_mir_is_tuple_pattern(pattern) {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= pattern.length() - 1 {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_mir_tuple_pattern_slot(pattern: word, slot_id: int) -> word {
    pattern = v4_mir_pattern_trim(pattern)
    if not v4_mir_is_tuple_pattern(pattern) or slot_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= pattern.length() - 1 {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == "," {
            if current == slot_id {
                give back v4_mir_pattern_trim(v4_slice(pattern, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == slot_id and segment_start < pattern.length() - 1 {
        give back v4_mir_pattern_trim(v4_slice(pattern, segment_start, pattern.length() - 1))
    }
    give back ""
}

task v4_mir_bracket_pattern_slot_count(pattern: word) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if not v4_mir_is_bracket_pattern(pattern) {
        give back 0
    }

    pilot inner = v4_mir_pattern_trim(v4_slice(pattern, 1, pattern.length() - 1))
    if inner == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= pattern.length() - 1 {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_mir_bracket_pattern_slot(pattern: word, slot_id: int) -> word {
    pattern = v4_mir_pattern_trim(pattern)
    if not v4_mir_is_bracket_pattern(pattern) or slot_id < 0 {
        give back ""
    }

    pilot current = 0
    pilot segment_start = 1
    pilot depth = 0
    pilot idx = 1
    repeat until idx >= pattern.length() - 1 {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == "," {
            if current == slot_id {
                give back v4_mir_pattern_trim(v4_slice(pattern, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == slot_id and segment_start < pattern.length() - 1 {
        give back v4_mir_pattern_trim(v4_slice(pattern, segment_start, pattern.length() - 1))
    }
    give back ""
}

task v4_mir_named_brace_pattern_open(pattern: word) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern.length() < 4 {
        give back 0 - 1
    }
    if pattern.char_at(pattern.length() - 1) != "}" {
        give back 0 - 1
    }
    give back v4_mir_pattern_find_top_level_char(pattern, "{", 0, pattern.length() - 1)
}

task v4_mir_is_named_brace_pattern(pattern: word) -> bool {
    give back v4_mir_named_brace_pattern_open(pattern) > 0
}

task v4_mir_named_brace_pattern_head(pattern: word) -> word {
    pattern = v4_mir_pattern_trim(pattern)
    pilot open_pos = v4_mir_named_brace_pattern_open(pattern)
    if open_pos <= 0 {
        give back ""
    }
    give back v4_mir_pattern_trim(v4_slice(pattern, 0, open_pos))
}

task v4_mir_named_brace_pattern_field_count(pattern: word) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if not v4_mir_is_named_brace_pattern(pattern) {
        give back 0
    }

    pilot open_pos = v4_mir_named_brace_pattern_open(pattern)
    pilot inner = v4_mir_pattern_trim(v4_slice(pattern, open_pos + 1, pattern.length() - 1))
    if inner == "" {
        give back 0
    }

    pilot count = 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= pattern.length() - 1 {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == "," {
            count += 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }
    give back count
}

task v4_mir_named_brace_pattern_field(pattern: word, field_id: int) -> word {
    pattern = v4_mir_pattern_trim(pattern)
    if not v4_mir_is_named_brace_pattern(pattern) or field_id < 0 {
        give back ""
    }

    pilot open_pos = v4_mir_named_brace_pattern_open(pattern)
    pilot current = 0
    pilot segment_start = open_pos + 1
    pilot depth = 0
    pilot idx = open_pos + 1
    repeat until idx >= pattern.length() - 1 {
        pilot ch = pattern.char_at(idx)
        if depth == 0 and ch == "," {
            if current == field_id {
                give back v4_mir_pattern_trim(v4_slice(pattern, segment_start, idx))
            }
            current += 1
            segment_start = idx + 1
        } else {
            depth = v4_ty_type_depth_after_char(depth, ch)
        }
        idx += 1
    }

    if current == field_id and segment_start < pattern.length() - 1 {
        give back v4_mir_pattern_trim(v4_slice(pattern, segment_start, pattern.length() - 1))
    }
    give back ""
}

task v4_mir_named_brace_field_name(field_pattern: word) -> word {
    field_pattern = v4_mir_pattern_trim(field_pattern)
    if field_pattern == "" {
        give back ""
    }
    pilot colon = v4_mir_pattern_find_top_level_char(field_pattern, ":", 0, field_pattern.length())
    if colon < 0 {
        give back field_pattern
    }
    give back v4_mir_pattern_trim(v4_slice(field_pattern, 0, colon))
}

task v4_mir_named_brace_field_pattern(field_pattern: word) -> word {
    field_pattern = v4_mir_pattern_trim(field_pattern)
    if field_pattern == "" {
        give back ""
    }
    pilot colon = v4_mir_pattern_find_top_level_char(field_pattern, ":", 0, field_pattern.length())
    if colon < 0 {
        give back v4_mir_named_brace_field_name(field_pattern)
    }
    give back v4_mir_pattern_trim(v4_slice(field_pattern, colon + 1, field_pattern.length()))
}

task v4_mir_is_route_destructure_pattern(pattern: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" {
        give back false
    }
    if v4_mir_named_brace_pattern_head(pattern) != "" {
        give back true
    }
    give back v4_mir_path_scope_separator(pattern) >= 0
}

task v4_mir_destructure_pattern_kind(pattern: word) -> word {
    if v4_mir_is_tuple_pattern(pattern) {
        give back "tuple"
    }
    if v4_mir_is_bracket_pattern(pattern) {
        give back "sequence"
    }
    if v4_mir_is_route_destructure_pattern(pattern) {
        give back "route"
    }
    give back ""
}

task v4_mir_destructure_child_kind(pattern: word, fallback_kind: word) -> word {
    pilot kind = v4_mir_destructure_pattern_kind(pattern)
    if kind != "" {
        give back kind
    }
    give back fallback_kind
}

task v4_mir_unique_local_name(mir_id: int, body_id: int, prefix: word) -> word {
    pilot candidate = prefix
    pilot suffix = 2
    repeat until v4_mir_find_local(mir_id, body_id, candidate) < 0 {
        candidate = prefix + word_from_int(suffix)
        suffix += 1
    }
    give back candidate
}

task v4_mir_lower_destructure_pattern(mir_id: int, body_id: int, block_id: int, stmt_span: word, pattern_kind: word, pattern: word, source_place: int, source_ty: word) -> void {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back
    }

    if v4_mir_pattern_is_simple_local(pattern) {
        if v4_mir_find_local_visible_at(mir_id, body_id, pattern, v4_span_start(stmt_span)) >= 0 {
            pilot duplicate_message = "tuple destructure duplicate binding"
            if pattern_kind == "sequence" {
                duplicate_message = "sequence destructure duplicate binding"
            }
            v4_mir_add_type_error(mir_id, stmt_span, duplicate_message, pattern + " already exists in this scope")
            give back
        }

        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
        pilot local_id = v4_mir_add_local(mir_id, body_id, pattern, source_ty, stmt_span)
        pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, pattern, local_id, pattern, 0 - 1, stmt_span, source_ty)
        v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, pattern, v4_mir_place_text(mir_id, body_id, source_place), stmt_span, place_id, source_rvalue)
        give back
    }

    if pattern_kind == "route" {
        v4_mir_add_type_error(mir_id, stmt_span, "refutable local pattern", "route patterns can fail at runtime; use when to handle every case")
        give back
    }

    pilot canonical_source_ty = source_ty
    if v4_ty_is_known(canonical_source_ty) {
        canonical_source_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), canonical_source_ty)
    }

    if pattern_kind == "tuple" {
        if not v4_mir_is_tuple_pattern(pattern) {
            v4_mir_add_type_error(mir_id, stmt_span, "unsupported local pattern", "use a single name, (a, b, ...), or [a, b, ...]")
            give back
        }

        if v4_ty_is_known(canonical_source_ty) and not v4_ty_is_tuple_type(canonical_source_ty) {
            v4_mir_add_type_error(mir_id, stmt_span, "tuple destructure needs tuple source", "got " + source_ty)
            give back
        }

        pilot pattern_slots = v4_mir_tuple_pattern_slot_count(pattern)
        if v4_ty_is_tuple_type(canonical_source_ty) {
            pilot source_slots = v4_ty_tuple_slot_count(canonical_source_ty)
            if source_slots != pattern_slots {
                v4_mir_add_type_error(mir_id, stmt_span, "tuple destructure arity mismatch", "pattern wants " + word_from_int(pattern_slots) + " slots but source has " + word_from_int(source_slots))
            }
        }

        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_name = word_from_int(slot_idx)
            pilot slot_ty = v4_ty_unknown
            if v4_ty_is_tuple_type(canonical_source_ty) {
                slot_ty = v4_ty_tuple_slot_type(canonical_source_ty, slot_idx)
            }
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, source_place) + "." + slot_name, source_place, slot_name, 0 - 1, stmt_span, slot_ty)
            pilot child_pattern = v4_mir_tuple_pattern_slot(pattern, slot_idx)
            pilot child_kind = v4_mir_destructure_child_kind(child_pattern, "tuple")
            v4_mir_lower_destructure_pattern(mir_id, body_id, block_id, stmt_span, child_kind, child_pattern, slot_place, slot_ty)
            slot_idx += 1
        }
        give back
    }

    if pattern_kind == "sequence" {
        if not v4_mir_is_bracket_pattern(pattern) {
            v4_mir_add_type_error(mir_id, stmt_span, "unsupported local pattern", "use a single name, (a, b, ...), or [a, b, ...]")
            give back
        }

        pilot source_is_sequence = false
        if v4_ty_is_known(canonical_source_ty) == false or v4_ty_list_element_type(canonical_source_ty) != v4_ty_unknown or v4_ty_is_fixed_array_type(canonical_source_ty) {
            source_is_sequence = true
        }
        if v4_ty_is_known(canonical_source_ty) and not source_is_sequence {
            v4_mir_add_type_error(mir_id, stmt_span, "sequence destructure needs list or array source", "got " + source_ty)
            give back
        }

        pilot pattern_slots = v4_mir_bracket_pattern_slot_count(pattern)
        if v4_ty_is_fixed_array_type(canonical_source_ty) {
            pilot source_slots = v4_mir_fixed_array_slot_count(mir_id, canonical_source_ty)
            if source_slots >= 0 and source_slots != pattern_slots {
                v4_mir_add_type_error(mir_id, stmt_span, "sequence destructure arity mismatch", "pattern wants " + word_from_int(pattern_slots) + " slots but source has " + word_from_int(source_slots))
            }
        }

        pilot element_ty = v4_ty_unknown
        if v4_ty_list_element_type(canonical_source_ty) != v4_ty_unknown {
            element_ty = v4_ty_list_element_type(canonical_source_ty)
        } else if v4_ty_is_fixed_array_type(canonical_source_ty) {
            element_ty = v4_ty_fixed_array_element_type(canonical_source_ty)
        }

        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_text = word_from_int(slot_idx)
            pilot index_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, slot_text, "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_index, v4_mir_place_text(mir_id, body_id, source_place) + "[" + slot_text + "]", source_place, "", index_rvalue, stmt_span, element_ty)
            pilot child_pattern = v4_mir_bracket_pattern_slot(pattern, slot_idx)
            pilot child_kind = v4_mir_destructure_child_kind(child_pattern, "sequence")
            v4_mir_lower_destructure_pattern(mir_id, body_id, block_id, stmt_span, child_kind, child_pattern, slot_place, element_ty)
            slot_idx += 1
        }
        give back
    }

    v4_mir_add_type_error(mir_id, stmt_span, "unsupported local pattern", "use a single name, (a, b, ...), or [a, b, ...]")
}

task v4_mir_lower_destructure_assignment_pattern(mir_id: int, body_id: int, block_id: int, stmt_span: word, pattern_kind: word, pattern: word, source_place: int, source_ty: word) -> void {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back
    }

    if v4_mir_pattern_is_simple_local(pattern) {
        pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, pattern, v4_span_start(stmt_span))
        if local_id < 0 {
            v4_mir_add_type_error(mir_id, stmt_span, "destructure assignment target missing", pattern + " is not in scope")
            give back
        }

        pilot target_ty = v4_mir_local_ty(mir_id, body_id, local_id)
        if target_ty == v4_ty_unknown and source_ty != v4_ty_unknown {
            v4_mir_set_local_ty(mir_id, body_id, local_id, source_ty)
            target_ty = source_ty
        }
        pilot target_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, pattern, local_id, pattern, 0 - 1, stmt_span, target_ty)
        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
        v4_mir_check_assignment_types(mir_id, body_id, stmt_span, target_place, target_ty, source_ty)
        v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_assign, pattern, v4_mir_place_text(mir_id, body_id, source_place), stmt_span, target_place, source_rvalue)
        give back
    }

    if pattern_kind == "route" {
        v4_mir_add_type_error(mir_id, stmt_span, "refutable destructure assignment pattern", "route patterns can fail at runtime; use when to handle every case")
        give back
    }

    pilot canonical_source_ty = source_ty
    if v4_ty_is_known(canonical_source_ty) {
        canonical_source_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), canonical_source_ty)
    }

    if pattern_kind == "tuple" {
        if not v4_mir_is_tuple_pattern(pattern) {
            v4_mir_add_type_error(mir_id, stmt_span, "destructure assignment target must be local", "use existing locals inside (a, b, ...) or [a, b, ...]")
            give back
        }

        if v4_ty_is_known(canonical_source_ty) and not v4_ty_is_tuple_type(canonical_source_ty) {
            v4_mir_add_type_error(mir_id, stmt_span, "tuple destructure assignment needs tuple source", "got " + source_ty)
            give back
        }

        pilot pattern_slots = v4_mir_tuple_pattern_slot_count(pattern)
        if v4_ty_is_tuple_type(canonical_source_ty) {
            pilot source_slots = v4_ty_tuple_slot_count(canonical_source_ty)
            if source_slots != pattern_slots {
                v4_mir_add_type_error(mir_id, stmt_span, "tuple destructure assignment arity mismatch", "pattern wants " + word_from_int(pattern_slots) + " slots but source has " + word_from_int(source_slots))
            }
        }

        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_name = word_from_int(slot_idx)
            pilot slot_ty = v4_ty_unknown
            if v4_ty_is_tuple_type(canonical_source_ty) {
                slot_ty = v4_ty_tuple_slot_type(canonical_source_ty, slot_idx)
            }
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, source_place) + "." + slot_name, source_place, slot_name, 0 - 1, stmt_span, slot_ty)
            pilot child_pattern = v4_mir_tuple_pattern_slot(pattern, slot_idx)
            pilot child_kind = v4_mir_destructure_child_kind(child_pattern, "tuple")
            v4_mir_lower_destructure_assignment_pattern(mir_id, body_id, block_id, stmt_span, child_kind, child_pattern, slot_place, slot_ty)
            slot_idx += 1
        }
        give back
    }

    if pattern_kind == "sequence" {
        if not v4_mir_is_bracket_pattern(pattern) {
            v4_mir_add_type_error(mir_id, stmt_span, "destructure assignment target must be local", "use existing locals inside (a, b, ...) or [a, b, ...]")
            give back
        }

        pilot source_is_sequence = false
        if v4_ty_is_known(canonical_source_ty) == false or v4_ty_list_element_type(canonical_source_ty) != v4_ty_unknown or v4_ty_is_fixed_array_type(canonical_source_ty) {
            source_is_sequence = true
        }
        if v4_ty_is_known(canonical_source_ty) and not source_is_sequence {
            v4_mir_add_type_error(mir_id, stmt_span, "sequence destructure assignment needs list or array source", "got " + source_ty)
            give back
        }

        pilot pattern_slots = v4_mir_bracket_pattern_slot_count(pattern)
        if v4_ty_is_fixed_array_type(canonical_source_ty) {
            pilot source_slots = v4_mir_fixed_array_slot_count(mir_id, canonical_source_ty)
            if source_slots >= 0 and source_slots != pattern_slots {
                v4_mir_add_type_error(mir_id, stmt_span, "sequence destructure assignment arity mismatch", "pattern wants " + word_from_int(pattern_slots) + " slots but source has " + word_from_int(source_slots))
            }
        }

        pilot element_ty = v4_ty_unknown
        if v4_ty_list_element_type(canonical_source_ty) != v4_ty_unknown {
            element_ty = v4_ty_list_element_type(canonical_source_ty)
        } else if v4_ty_is_fixed_array_type(canonical_source_ty) {
            element_ty = v4_ty_fixed_array_element_type(canonical_source_ty)
        }

        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_text = word_from_int(slot_idx)
            pilot index_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, slot_text, "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_index, v4_mir_place_text(mir_id, body_id, source_place) + "[" + slot_text + "]", source_place, "", index_rvalue, stmt_span, element_ty)
            pilot child_pattern = v4_mir_bracket_pattern_slot(pattern, slot_idx)
            pilot child_kind = v4_mir_destructure_child_kind(child_pattern, "sequence")
            v4_mir_lower_destructure_assignment_pattern(mir_id, body_id, block_id, stmt_span, child_kind, child_pattern, slot_place, element_ty)
            slot_idx += 1
        }
        give back
    }

    v4_mir_add_type_error(mir_id, stmt_span, "destructure assignment target must be local", "use existing locals inside (a, b, ...) or [a, b, ...]")
}

task v4_mir_loop_pattern_kind(pattern: word) -> word {
    if v4_mir_is_tuple_pattern(pattern) {
        give back "tuple"
    }
    if v4_mir_is_bracket_pattern(pattern) {
        give back "sequence"
    }
    give back ""
}

task v4_mir_lower_for_each_binding(mir_id: int, body_id: int, block_id: int, stmt_span: word, loop_pattern: word, iterable_text: word, iterable_ty: word) -> int {
    loop_pattern = v4_mir_pattern_trim(loop_pattern)
    if loop_pattern == "" {
        v4_mir_add_type_error(mir_id, stmt_span, "unsupported local pattern", "use a single name, (a, b, ...), or [a, b, ...]")
        give back 0 - 1
    }

    pilot canonical_iterable_ty = iterable_ty
    if v4_ty_is_known(canonical_iterable_ty) {
        canonical_iterable_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), canonical_iterable_ty)
    }
    pilot element_ty = v4_ty_index_element_type(canonical_iterable_ty)
    if v4_ty_is_known(iterable_ty) and not v4_ty_is_known(element_ty) {
        v4_mir_add_type_error(mir_id, stmt_span, "for each needs iterable source", "got " + iterable_ty)
    }

    pilot temp_name = v4_mir_unique_local_name(mir_id, body_id, "_for_each_item")
    pilot temp_id = v4_mir_add_local(mir_id, body_id, temp_name, element_ty, stmt_span)
    pilot temp_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, temp_name, temp_id, temp_name, 0 - 1, stmt_span, element_ty)
    pilot item_text = "item of " + iterable_text
    pilot item_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_loop_item, item_text, "LoopItem", 0 - 1, 0 - 1, stmt_span, element_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, temp_name, item_text, stmt_span, temp_place, item_rvalue)

    if v4_mir_pattern_is_simple_local(loop_pattern) {
        if v4_mir_find_local_visible_at(mir_id, body_id, loop_pattern, v4_span_start(stmt_span)) >= 0 {
            v4_mir_add_type_error(mir_id, stmt_span, "for each binding duplicate local", loop_pattern + " already exists in this scope")
            give back temp_place
        }
        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, temp_place, stmt_span)
        pilot local_id = v4_mir_add_local(mir_id, body_id, loop_pattern, element_ty, stmt_span)
        pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, loop_pattern, local_id, loop_pattern, 0 - 1, stmt_span, element_ty)
        v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, loop_pattern, item_text, stmt_span, place_id, source_rvalue)
        give back place_id
    }

    pilot pattern_kind = v4_mir_loop_pattern_kind(loop_pattern)
    if pattern_kind != "" {
        v4_mir_lower_destructure_pattern(mir_id, body_id, block_id, stmt_span, pattern_kind, loop_pattern, temp_place, element_ty)
        give back temp_place
    }

    v4_mir_add_type_error(mir_id, stmt_span, "unsupported local pattern", "use a single name, (a, b, ...), or [a, b, ...]")
    give back temp_place
}

task v4_mir_lower_for_each_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, for_token: int, stmt_end: int) -> int {
    pilot open_token = v4_mir_find_token_value(stream_id, for_token, stmt_end, "{")
    if open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, for_token, stmt_end)
    }

    pilot each_token = v4_mir_skip_trivia(stream_id, for_token + 1)
    if each_token >= open_token or v4_lex_token_value(stream_id, each_token) != "each" {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, for_token, stmt_end)
    }

    pilot in_token = v4_mir_find_token_value(stream_id, each_token + 1, open_token, "in")
    if in_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, for_token, stmt_end)
    }

    pilot loop_pattern = v4_mir_expr_text(stream_id, each_token + 1, in_token)
    pilot iterable_text = v4_mir_expr_text(stream_id, in_token + 1, open_token)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, for_token, stmt_end)
    pilot loop_scope_span = v4_mir_span_from_tokens(stream_id, open_token, stmt_end)
    pilot iterable_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, in_token + 1, open_token)
    pilot iterable_ty = v4_mir_rvalue_ty(mir_id, body_id, iterable_rvalue)

    -- Evaluate the iterable before entering the cycle. The loop header may run
    -- many times, but calls and ownership transfers in the source run once.
    pilot iterable_name = v4_mir_unique_local_name(mir_id, body_id, "_for_each_source")
    pilot iterable_local = v4_mir_add_local(mir_id, body_id, iterable_name, iterable_ty, stmt_span)
    pilot iterable_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, iterable_name, iterable_local, iterable_name, 0 - 1, stmt_span, iterable_ty)
    pilot iterable_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, iterable_rvalue)
    v4_mir_add_stmt(mir_id, body_id, iterable_block, v4_mir_stmt_local, iterable_name, iterable_text, stmt_span, iterable_place, iterable_rvalue)
    pilot iterable_read = v4_mir_place_read_rvalue(mir_id, body_id, iterable_place, stmt_span)

    pilot body_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot loop_header = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot loop_condition = "for each " + loop_pattern + " in " + iterable_text
    v4_mir_push_scope_span(loop_scope_span)
    pilot loop_place = v4_mir_lower_for_each_binding(mir_id, body_id, body_block, stmt_span, loop_pattern, iterable_text, iterable_ty)

    v4_mir_seal_block_goto_if_live(mir_id, body_id, iterable_block, loop_header)
    v4_mir_set_body_block(mir_id, body_id, loop_header, v4_mir_block_new_full(loop_header, v4_mir_term_if, body_block, after_block, loop_condition))
    v4_mir_add_stmt(mir_id, body_id, loop_header, v4_mir_stmt_loop, loop_pattern, iterable_text, stmt_span, loop_place, iterable_read)
    v4_mir_push_loop_context(after_block, loop_header)
    pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, body_block, stream_id, open_token, stmt_end)
    v4_mir_pop_loop_context()
    v4_mir_pop_scope_span()
    v4_mir_seal_block_goto_if_live(mir_id, body_id, body_tail, loop_header)

    give back after_block
}

task v4_mir_assignment_operator(value: word) -> bool {
    give back value == "=" or value == "+=" or value == "-=" or value == "*=" or value == "/=" or value == "%="
}

task v4_mir_find_assignment_operator_token(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and v4_mir_assignment_operator(val) {
                give back idx
            }
            depth = v4_mir_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_growth_condition_boundary(value: word) -> bool {
    give back value == "==" or value == "!=" or value == "<" or value == "<=" or value == ">" or value == ">=" or value == "and" or value == "or" or value == "&&" or value == "||"
}

task v4_mir_find_matching_bracket(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "[" {
                depth += 1
            } else if val == "]" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_condition_place_prefix_end(stream_id: int, first_token: int, condition_end: int) -> int {
    pilot first_type = v4_lex_token_type(stream_id, first_token)
    if first_type != v4_tok_ident and first_type != v4_tok_keyword {
        give back first_token + 1
    }

    pilot idx = first_token + 1
    pilot keep_going = true
    repeat until keep_going == false {
        pilot next_token = v4_mir_skip_trivia(stream_id, idx)
        if next_token >= condition_end {
            give back condition_end
        }
        pilot next_val = v4_lex_token_value(stream_id, next_token)
        if next_val == "." or next_val == "::" {
            pilot member_token = v4_mir_skip_trivia(stream_id, next_token + 1)
            if member_token >= condition_end {
                give back idx
            }
            pilot member_type = v4_lex_token_type(stream_id, member_token)
            if member_type != v4_tok_ident and member_type != v4_tok_keyword {
                give back idx
            }
            idx = member_token + 1
        } else if next_val == "[" {
            pilot close_token = v4_mir_find_matching_bracket(stream_id, next_token, condition_end)
            if close_token < 0 {
                give back idx
            }
            idx = close_token + 1
        } else {
            keep_going = false
        }
    }
    give back idx
}

task v4_mir_condition_subject_place(stream_id: int, condition_start: int, condition_end: int) -> word {
    pilot first = v4_mir_skip_trivia(stream_id, condition_start)
    if first >= condition_end {
        give back ""
    }
    if v4_lex_token_value(stream_id, first) == "(" {
        pilot close_paren = v4_mir_find_matching_paren(stream_id, first, condition_end)
        if close_paren > first {
            give back v4_mir_condition_subject_place(stream_id, first + 1, close_paren)
        }
    }
    pilot place_end = v4_mir_condition_place_prefix_end(stream_id, first, condition_end)
    if place_end > first {
        give back v4_mir_compact_type_text(v4_mir_expr_text(stream_id, first, place_end))
    }
    pilot idx = first
    pilot depth = 0
    repeat until idx >= condition_end {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and v4_mir_growth_condition_boundary(val) {
                give back v4_mir_compact_type_text(v4_mir_expr_text(stream_id, first, idx))
            }
            depth = v4_mir_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back v4_mir_compact_type_text(v4_mir_expr_text(stream_id, first, condition_end))
}

task v4_mir_growth_place_base(place_text: word) -> word {
    place_text = v4_mir_compact_type_text(place_text)
    pilot idx = 0
    repeat until idx >= place_text.length() {
        pilot ch = place_text.char_at(idx)
        if ch == "." or ch == "[" {
            give back v4_slice(place_text, 0, idx)
        }
        idx += 1
    }
    give back place_text
}

task v4_mir_growth_place_prefix_matches(lhs_text: word, wanted_text: word) -> bool {
    lhs_text = v4_mir_compact_type_text(lhs_text)
    wanted_text = v4_mir_compact_type_text(wanted_text)
    if lhs_text == "" or wanted_text == "" {
        give back false
    }
    if lhs_text == wanted_text {
        give back true
    }
    if lhs_text.length() >= wanted_text.length() {
        give back false
    }
    if wanted_text.starts_with(lhs_text) == false {
        give back false
    }

    pilot next = wanted_text.char_at(lhs_text.length())
    give back next == "." or next == "["
}

task v4_mir_assignment_lhs_start(stream_id: int, lower_bound: int, op_token: int) -> int {
    pilot idx = op_token - 1
    repeat until idx < lower_bound {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type == v4_tok_trivia {
            if val == "\n" {
                give back idx + 1
            }
        } else if val == ";" or val == "{" or val == "}" or val == "=>" or val == "->" {
            give back idx + 1
        }
        idx -= 1
    }
    give back lower_bound
}

task v4_mir_body_mutates_place(stream_id: int, open_token: int, close_token: int, place_text: word) -> bool {
    pilot wanted = v4_mir_compact_type_text(place_text)
    if wanted == "" {
        give back false
    }

    pilot idx = open_token + 1
    repeat until idx >= close_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia and v4_mir_assignment_operator(v4_lex_token_value(stream_id, idx)) {
            pilot lhs_start = v4_mir_assignment_lhs_start(stream_id, open_token + 1, idx)
            pilot lhs_text = v4_mir_compact_type_text(v4_mir_expr_text(stream_id, lhs_start, idx))
            if v4_mir_growth_place_prefix_matches(lhs_text, wanted) {
                give back true
            }
        }
        idx += 1
    }
    give back false
}

task v4_mir_lower_training_arc_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, training_token: int, stmt_end: int) -> int {
    pilot open_token = v4_mir_find_token_value(stream_id, training_token, stmt_end, "{")
    if open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, training_token, stmt_end)
    }

    pilot arc_token = v4_mir_skip_trivia(stream_id, training_token + 1)
    if arc_token >= open_token or v4_lex_token_value(stream_id, arc_token) != "arc" {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, training_token, stmt_end)
    }

    pilot until_token = v4_mir_find_token_value(stream_id, arc_token + 1, open_token, "until")
    pilot max_token = v4_mir_find_token_value(stream_id, arc_token + 1, open_token, "max")
    pilot sessions_token = v4_mir_find_token_value(stream_id, arc_token + 1, open_token, "sessions")
    if until_token < 0 or max_token < 0 or sessions_token < 0 or max_token <= until_token or sessions_token <= max_token {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, training_token, stmt_end)
    }

    pilot condition_start = until_token + 1
    pilot condition_text = v4_mir_expr_text(stream_id, condition_start, max_token)
    pilot max_text = v4_mir_expr_text(stream_id, max_token + 1, sessions_token)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, training_token, stmt_end)
    pilot condition_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, condition_start, max_token)
    pilot max_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, max_token + 1, sessions_token)
    pilot max_ty = v4_mir_rvalue_ty(mir_id, body_id, max_rvalue)
    if v4_ty_is_known(max_ty) and not v4_ty_is_numeric(max_ty) {
        v4_mir_add_type_error(mir_id, stmt_span, "training arc max sessions must be numeric", "got " + max_ty)
    }
    v4_mir_check_condition_type(mir_id, stmt_span, "training-arc", v4_mir_rvalue_ty(mir_id, body_id, condition_rvalue))

    pilot close_token = v4_mir_find_matching_brace(stream_id, open_token, stmt_end)
    pilot with_token = v4_mir_find_token_value(stream_id, sessions_token + 1, open_token, "with")
    pilot has_growth = false
    if with_token >= 0 {
        pilot growth_token = v4_mir_skip_trivia(stream_id, with_token + 1)
        if growth_token < open_token and v4_lex_token_value(stream_id, growth_token) == "growth" {
            has_growth = true
        }
    }
    if has_growth {
        pilot growth_subject = v4_mir_condition_subject_place(stream_id, condition_start, max_token)
        if v4_mir_body_mutates_place(stream_id, open_token, close_token, growth_subject) == false {
            v4_mir_add_type_error(mir_id, stmt_span, "training arc with growth must mutate condition subject", "Yuuko found no progress for " + growth_subject)
        }
    }

    pilot body_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot loop_entry_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    v4_mir_seal_block_goto_if_live(mir_id, body_id, block_id, loop_entry_block)
    pilot loop_condition = "training arc until " + condition_text + " max " + max_text
    if has_growth {
        loop_condition = loop_condition + " with growth"
    }

    pilot condition_block = v4_mir_wire_try_propagation(mir_id, body_id, loop_entry_block, stmt_span, condition_rvalue)
    v4_mir_set_body_block(mir_id, body_id, condition_block, v4_mir_block_new_full(condition_block, v4_mir_term_if, after_block, body_block, loop_condition))
    v4_mir_add_stmt(mir_id, body_id, condition_block, v4_mir_stmt_loop, condition_text, "max " + max_text, stmt_span, 0 - 1, condition_rvalue)
    v4_mir_push_loop_context(after_block, loop_entry_block)
    pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, body_block, stream_id, open_token, stmt_end)
    v4_mir_pop_loop_context()
    v4_mir_seal_block_goto_if_live(mir_id, body_id, body_tail, loop_entry_block)

    give back after_block
}

task v4_mir_lower_pilot_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, pilot_token: int, stmt_end: int) -> int {
    pilot pattern_start = v4_mir_skip_trivia(stream_id, pilot_token + 1)
    if pattern_start >= stmt_end {
        give back block_id
    }

    pilot eq_token = v4_mir_find_assignment_operator_token(stream_id, pattern_start, stmt_end)
    pilot decl_end = stmt_end
    if eq_token >= 0 {
        decl_end = eq_token
    }

    pilot declared_ty = v4_ty_unknown
    pilot colon_token = v4_mir_find_top_level_token(stream_id, pattern_start, decl_end, ":")
    pilot pattern_end = decl_end
    if colon_token >= 0 {
        pattern_end = colon_token
        pilot type_start = v4_mir_skip_trivia(stream_id, colon_token + 1)
        if type_start < decl_end {
            declared_ty = v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_type_text(stream_id, type_start, decl_end))
            if declared_ty == "" {
                declared_ty = v4_ty_unknown
            }
        }
    }

    pilot pattern = v4_mir_pattern_trim(v4_mir_expr_text(stream_id, pattern_start, pattern_end))
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, pilot_token, stmt_end)
    if v4_ty_is_known(declared_ty) {
        if not v4_mir_validate_type_contract(mir_id, v4_mir_body_signature_id(mir_id, body_id), stmt_span, declared_ty, "invalid local annotation type", "local declaration " + pattern) {
            declared_ty = v4_ty_unknown
        }
    }

    pilot rhs_start = decl_end
    if eq_token >= 0 {
        rhs_start = eq_token + 1
    }

    pilot rhs = v4_mir_expr_text(stream_id, rhs_start, stmt_end)
    pilot rvalue_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, rhs_start, stmt_end, declared_ty)
    pilot inferred_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if v4_mir_pattern_is_simple_local(pattern) {
        if v4_mir_find_local_visible_at(mir_id, body_id, pattern, v4_span_start(stmt_span)) >= 0 {
            v4_mir_add_type_error(mir_id, stmt_span, "duplicate local declaration", pattern + " already exists in this scope")
            give back block_id
        }
        pilot local_ty = inferred_ty
        if v4_ty_is_known(declared_ty) {
            v4_mir_check_local_decl_type(mir_id, body_id, stmt_span, pattern, declared_ty, inferred_ty)
            local_ty = declared_ty
            pilot coerced_ty = v4_mir_coerced_value_type(mir_id, body_id, declared_ty, inferred_ty)
            if coerced_ty != inferred_ty {
                v4_mir_set_rvalue_ty(mir_id, body_id, rvalue_id, coerced_ty)
                inferred_ty = coerced_ty
            }
        }
        pilot local_id = v4_mir_add_local(mir_id, body_id, pattern, local_ty, stmt_span)
        pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, pattern, local_id, pattern, 0 - 1, stmt_span, local_ty)
        pilot value_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, rvalue_id)
        v4_mir_add_stmt(mir_id, body_id, value_block, v4_mir_stmt_local, pattern, rhs, stmt_span, place_id, rvalue_id)
        give back value_block
    }

    pilot destructure_kind = v4_mir_destructure_pattern_kind(pattern)

    if destructure_kind != "" {
        pilot source_ty = inferred_ty
        if destructure_kind != "route" and v4_ty_is_known(declared_ty) {
            if not v4_ty_types_compatible(declared_ty, inferred_ty) {
                pilot mismatch_message = "tuple destructure type mismatch"
                if destructure_kind == "sequence" {
                    mismatch_message = "sequence destructure type mismatch"
                }
                v4_mir_add_type_error(mir_id, stmt_span, mismatch_message, "pattern expects " + declared_ty + " but got " + inferred_ty)
            }
            source_ty = declared_ty
        }

        if destructure_kind == "route" {
            v4_mir_add_type_error(mir_id, stmt_span, "refutable local pattern", "route patterns can fail at runtime; use when to handle every case")
            give back block_id
        }

        pilot temp_prefix = "_tuple_unpack"
        if destructure_kind == "sequence" {
            temp_prefix = "_seq_unpack"
        }
        pilot temp_name = v4_mir_unique_local_name(mir_id, body_id, temp_prefix)
        pilot temp_id = v4_mir_add_local(mir_id, body_id, temp_name, source_ty, stmt_span)
        pilot temp_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, temp_name, temp_id, temp_name, 0 - 1, stmt_span, source_ty)
        pilot value_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, rvalue_id)
        v4_mir_add_stmt(mir_id, body_id, value_block, v4_mir_stmt_local, temp_name, rhs, stmt_span, temp_place, rvalue_id)
        v4_mir_lower_destructure_pattern(mir_id, body_id, value_block, stmt_span, destructure_kind, pattern, temp_place, source_ty)
        give back value_block
    }

    v4_mir_add_type_error(mir_id, stmt_span, "unsupported local pattern", "use a single name, (a, b, ...), or [a, b, ...]")
    give back block_id
}

task v4_mir_lower_return_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, give_token: int, stmt_end: int) -> int {
    pilot back_token = v4_mir_skip_trivia(stream_id, give_token + 1)
    pilot rhs_start = give_token + 1
    if back_token < stmt_end {
        if v4_lex_token_value(stream_id, back_token) == "back" {
            rhs_start = back_token + 1
        }
    }

    pilot stmt_span = v4_mir_span_from_tokens(stream_id, give_token, stmt_end)
    pilot rhs = v4_mir_expr_text(stream_id, rhs_start, stmt_end)
    pilot rvalue_id = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, rhs_start, stmt_end, v4_mir_expected_return_type(mir_id, body_id))
    pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    v4_mir_check_return_type(mir_id, body_id, stmt_span, actual_ty)
    pilot return_ty = v4_mir_coerced_value_type(mir_id, body_id, v4_mir_expected_return_type(mir_id, body_id), actual_ty)
    pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_return, "_return", 0 - 1, "_return", 0 - 1, stmt_span, return_ty)
    pilot return_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, rvalue_id)
    v4_mir_add_stmt(mir_id, body_id, return_block, v4_mir_stmt_return, "_return", rhs, stmt_span, place_id, rvalue_id)
    v4_mir_set_body_block(mir_id, body_id, return_block, v4_mir_block_new_full(return_block, v4_mir_term_return, 0 - 1, 0 - 1, ""))
    give back return_block
}

task v4_mir_lower_break_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, break_token: int, stmt_end: int) -> int {
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, break_token, stmt_end)
    pilot break_target = v4_mir_current_loop_break_target()
    if break_target < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "break outside loop", "Yuuko cannot cut away from a loop that is not active")
        give back block_id
    }
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_break, "break", "exit#" + word_from_int(break_target), stmt_span, 0 - 1, 0 - 1)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_goto, break_target, 0 - 1, ""))
    give back block_id
}

task v4_mir_lower_continue_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, continue_token: int, stmt_end: int) -> int {
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, continue_token, stmt_end)
    pilot continue_target = v4_mir_current_loop_continue_target()
    if continue_target < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "continue outside loop", "Meiya cannot advance a loop that never started")
        give back block_id
    }
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_continue, "continue", "loop#" + word_from_int(continue_target), stmt_span, 0 - 1, 0 - 1)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_goto, continue_target, 0 - 1, ""))
    give back block_id
}

task v4_mir_find_arrow_token(stream_id: int, start: int, end_token: int) -> int {
    pilot idx = start
    pilot depth = 0
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if val == "(" or val == "[" {
                depth += 1
            } else if val == ")" or val == "]" {
                if depth > 0 { depth -= 1 }
            } else if val == "->" and depth == 0 {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_when_arm_body_end(stream_id: int, after_arrow: int, when_close: int) -> int {
    pilot first = v4_mir_skip_trivia(stream_id, after_arrow)
    if first >= when_close {
        give back when_close
    }
    if v4_lex_token_value(stream_id, first) == "{" {
        give back v4_mir_find_matching_brace(stream_id, first, when_close) + 1
    }
    pilot idx = after_arrow
    pilot depth = 0
    repeat until idx >= when_close {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if val == "(" or val == "[" or val == "{" {
                depth += 1
            } else if val == ")" or val == "]" {
                if depth > 0 { depth -= 1 }
            } else if val == "}" {
                if depth == 0 { give back idx }
                depth -= 1
            }
        } else if val == "\n" {
            if depth == 0 { give back idx }
        }
        idx += 1
    }
    give back when_close
}

task v4_mir_when_pattern_is_bool_literal(pattern: word) -> bool {
    give back pattern == "true" or pattern == "false" or pattern == "yes" or pattern == "no" or pattern == "hai" or pattern == "iie"
}

task v4_mir_when_pattern_bool_text(pattern: word) -> word {
    if pattern == "false" or pattern == "no" or pattern == "iie" {
        give back "false"
    }
    give back "true"
}

task v4_mir_when_pattern_is_string_literal(pattern: word) -> bool {
    if pattern.length() < 2 {
        give back false
    }
    give back pattern.char_at(0) == "\"" and pattern.char_at(pattern.length() - 1) == "\""
}

task v4_mir_when_pattern_is_numeric_literal(pattern: word) -> bool {
    if pattern == "" {
        give back false
    }

    pilot idx = 0
    if pattern.char_at(0) == "-" {
        if pattern.length() == 1 {
            give back false
        }
        idx = 1
    }

    pilot saw_digit = false
    pilot saw_dot = false
    repeat until idx >= pattern.length() {
        pilot ch = pattern.char_at(idx)
        if v4_lex_is_digit(ch) {
            saw_digit = true
        } else if ch == "." and saw_dot == false {
            saw_dot = true
        } else {
            give back false
        }
        idx += 1
    }

    if saw_digit == false {
        give back false
    }
    if pattern.char_at(pattern.length() - 1) == "." {
        give back false
    }
    give back true
}

task v4_mir_when_pattern_is_literal(pattern: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "_" {
        give back false
    }
    if v4_mir_when_pattern_is_bool_literal(pattern) {
        give back true
    }
    if v4_mir_when_pattern_is_string_literal(pattern) {
        give back true
    }
    if v4_mir_when_pattern_is_numeric_literal(pattern) {
        give back true
    }
    give back false
}

task v4_mir_when_pattern_true_rvalue(mir_id: int, body_id: int, stmt_span: word) -> int {
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_bool, "true", "", 0 - 1, 0 - 1, stmt_span, v4_ty_bool)
}

task v4_mir_when_pattern_false_rvalue(mir_id: int, body_id: int, stmt_span: word) -> int {
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_bool, "false", "", 0 - 1, 0 - 1, stmt_span, v4_ty_bool)
}

task v4_mir_when_pattern_literal_rvalue(mir_id: int, body_id: int, pattern: word, stmt_span: word) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if v4_mir_when_pattern_is_bool_literal(pattern) {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_bool, v4_mir_when_pattern_bool_text(pattern), "", 0 - 1, 0 - 1, stmt_span, v4_ty_bool)
    }
    if v4_mir_when_pattern_is_string_literal(pattern) {
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_word, pattern, "", 0 - 1, 0 - 1, stmt_span, v4_ty_word)
    }
    if v4_mir_when_pattern_is_numeric_literal(pattern) {
        if v4_index_of_from(pattern, ".", 0) >= 0 {
            give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_float, pattern, "", 0 - 1, 0 - 1, stmt_span, v4_ty_num)
        }
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, pattern, "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
    }
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_unknown, pattern, "", 0 - 1, 0 - 1, stmt_span, v4_ty_unknown)
}

task v4_mir_when_pattern_and_rvalue(mir_id: int, body_id: int, left_rvalue: int, right_rvalue: int, stmt_span: word) -> int {
    if left_rvalue < 0 {
        give back right_rvalue
    }
    if right_rvalue < 0 {
        give back left_rvalue
    }

    if v4_mir_rvalue_kind(mir_id, body_id, left_rvalue) == v4_mir_rvalue_const_bool and v4_mir_rvalue_text(mir_id, body_id, left_rvalue) == "true" {
        give back right_rvalue
    }
    if v4_mir_rvalue_kind(mir_id, body_id, right_rvalue) == v4_mir_rvalue_const_bool and v4_mir_rvalue_text(mir_id, body_id, right_rvalue) == "true" {
        give back left_rvalue
    }

    pilot text = v4_mir_rvalue_text(mir_id, body_id, left_rvalue) + " and " + v4_mir_rvalue_text(mir_id, body_id, right_rvalue)
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, text, v4_mir_bin_and, left_rvalue, right_rvalue, stmt_span, v4_ty_bool)
}

task v4_mir_route_pattern_message(context: word, kind: word) -> word {
    if context == "check route" {
        if kind == "needs-source" {
            give back "check route needs route source"
        }
        if kind == "lookup-failed" {
            give back "check route pattern lookup failed"
        }
        if kind == "wrong-route" {
            give back "check route pattern belongs to different route"
        }
        if kind == "case-lookup-failed" {
            give back "check route case lookup failed"
        }
        if kind == "fieldless" {
            give back "check route case has no payload"
        }
    }
    if context == "only on" {
        if kind == "needs-source" {
            give back "only on needs route source"
        }
        if kind == "lookup-failed" {
            give back "only on pattern lookup failed"
        }
        if kind == "wrong-route" {
            give back "only on pattern belongs to different route"
        }
        if kind == "case-lookup-failed" {
            give back "only on case lookup failed"
        }
        if kind == "fieldless" {
            give back "only on case has no payload"
        }
    }

    if kind == "needs-source" {
        give back "when route pattern needs route source"
    }
    if kind == "lookup-failed" {
        give back "when route pattern lookup failed"
    }
    if kind == "wrong-route" {
        give back "when route pattern belongs to different route"
    }
    if kind == "case-lookup-failed" {
        give back "when route case lookup failed"
    }
    if kind == "fieldless" {
        give back "when route case has no payload"
    }
    give back "when route pattern needs route source"
}

task v4_mir_try_lower_route_pattern_condition(mir_id: int, body_id: int, stmt_span: word, pattern: word, source_place: int, source_text: word, source_ty: word, context: word, bare_names_are_route_candidates: bool) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back 0 - 1
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_payload_head = v4_mir_named_brace_pattern_head(pattern)
    pilot route_payload_scope = v4_mir_path_left(route_payload_head)
    if route_payload_head != "" and (route_payload_scope != "" or v4_ty_is_route_type(ty_id, source_ty) or bare_names_are_route_candidates) {
        if v4_ty_is_known(source_ty) and not v4_ty_is_route_type(ty_id, source_ty) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "needs-source"), "got " + source_ty)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }

        pilot route_name = source_ty
        pilot case_name = route_payload_head
        pilot pattern_text = route_payload_head
        if route_payload_scope != "" {
            route_name = v4_mir_compact_type_text(route_payload_scope)
            case_name = v4_mir_path_right(route_payload_head)
            pattern_text = v4_mir_route_case_text(route_name, case_name)
            if not v4_ty_is_route_type(ty_id, route_name) {
                v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "lookup-failed"), route_name + " is not a known route")
                give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
            }
            if v4_ty_is_known(source_ty) and v4_ty_is_route_type(ty_id, source_ty) and not v4_mir_route_names_match(ty_id, route_name, source_ty) {
                v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "wrong-route"), "scrutinee is " + source_ty + " but pattern names " + route_name)
                give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
            }
        }

        if route_name == "" or not v4_ty_is_route_type(ty_id, route_name) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "needs-source"), "got " + source_ty)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "case-lookup-failed"), route_name + " exposes no case " + case_name)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }
        if not v4_ty_route_case_has_payload(ty_id, route_lookup_name, case_name) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "fieldless"), route_name + "::" + case_name + " carries no fields")
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }

        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
        pilot tag_rvalue = v4_mir_route_case_rvalue(mir_id, body_id, pattern_text, route_lookup_name, case_name, stmt_span)
        pilot cond_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, source_text + " == " + pattern_text, v4_mir_bin_eq, source_rvalue, tag_rvalue, stmt_span, v4_ty_bool)
        pilot seen_fields = ""
        pilot field_idx = 0
        pilot field_count = v4_mir_named_brace_pattern_field_count(pattern)
        repeat until field_idx >= field_count {
            pilot field_segment = v4_mir_named_brace_pattern_field(pattern, field_idx)
            pilot field_name = v4_mir_named_brace_field_name(field_segment)
            pilot child_pattern = v4_mir_named_brace_field_pattern(field_segment)
            if field_name == "" {
                v4_mir_add_type_error(mir_id, stmt_span, "malformed route pattern field", "expected field or field: pattern inside " + route_name + "::" + case_name)
            } else if v4_mir_name_list_contains(seen_fields, field_name) {
                v4_mir_add_type_error(mir_id, stmt_span, "duplicate route pattern field", field_name + " already appears in " + route_name + "::" + case_name)
            } else {
                seen_fields = v4_mir_name_list_add(seen_fields, field_name)
                pilot field_ty = v4_ty_route_case_field_type_for_name(ty_id, route_lookup_name, case_name, field_name)
                if field_ty == v4_ty_unknown {
                    v4_mir_add_type_error(mir_id, stmt_span, "unknown route pattern field", route_name + "::" + case_name + " has no field " + field_name)
                } else {
                    pilot field_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, source_place) + "." + field_name, source_place, field_name, 0 - 1, stmt_span, field_ty)
                    pilot field_cond = v4_mir_lower_when_pattern_condition(mir_id, body_id, stmt_span, child_pattern, field_place, source_text + "." + field_name, field_ty)
                    cond_rvalue = v4_mir_when_pattern_and_rvalue(mir_id, body_id, cond_rvalue, field_cond, stmt_span)
                }
            }
            field_idx += 1
        }
        give back cond_rvalue
    }

    pilot route_pattern_sep = v4_mir_path_scope_separator(pattern)
    pilot treat_simple_name_as_route = bare_names_are_route_candidates and v4_mir_pattern_is_simple_local(pattern)
    if route_pattern_sep >= 0 or (v4_ty_is_route_type(ty_id, source_ty) and v4_ty_route_has_case(ty_id, source_ty, pattern)) or treat_simple_name_as_route {
        if v4_ty_is_known(source_ty) and not v4_ty_is_route_type(ty_id, source_ty) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "needs-source"), "got " + source_ty)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }

        pilot route_name = source_ty
        pilot case_name = pattern
        pilot pattern_text = pattern
        if route_pattern_sep >= 0 {
            route_name = v4_mir_compact_type_text(v4_mir_path_left(pattern))
            case_name = v4_mir_path_right(pattern)
            pattern_text = v4_mir_route_case_text(route_name, case_name)
            if not v4_ty_is_route_type(ty_id, route_name) {
                v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "lookup-failed"), route_name + " is not a known route")
                give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
            }
            if v4_ty_is_known(source_ty) and v4_ty_is_route_type(ty_id, source_ty) and not v4_mir_route_names_match(ty_id, route_name, source_ty) {
                v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "wrong-route"), "scrutinee is " + source_ty + " but pattern names " + route_name)
                give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
            }
        }

        if route_name == "" or not v4_ty_is_route_type(ty_id, route_name) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "needs-source"), "got " + source_ty)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
            v4_mir_add_type_error(mir_id, stmt_span, v4_mir_route_pattern_message(context, "case-lookup-failed"), route_name + " exposes no case " + case_name)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }

        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
        pilot pattern_rvalue = v4_mir_route_case_rvalue(mir_id, body_id, pattern_text, route_lookup_name, case_name, stmt_span)
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, source_text + " == " + pattern_text, v4_mir_bin_eq, source_rvalue, pattern_rvalue, stmt_span, v4_ty_bool)
    }

    give back 0 - 1
}

task v4_mir_lower_when_pattern_condition(mir_id: int, body_id: int, stmt_span: word, pattern: word, source_place: int, source_text: word, source_ty: word) -> int {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back v4_mir_when_pattern_true_rvalue(mir_id, body_id, stmt_span)
    }

    if v4_mir_when_pattern_is_literal(pattern) {
        pilot pattern_rvalue = v4_mir_when_pattern_literal_rvalue(mir_id, body_id, pattern, stmt_span)
        pilot pattern_ty = v4_mir_rvalue_ty(mir_id, body_id, pattern_rvalue)
        if v4_ty_is_known(source_ty) and v4_ty_is_known(pattern_ty) {
            if not v4_ty_types_compatible(source_ty, pattern_ty) {
                v4_mir_add_type_error(mir_id, stmt_span, "when arm pattern type mismatch", "scrutinee is " + source_ty + " but pattern is " + pattern_ty)
            }
        }
        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
        give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, source_text + " == " + pattern, v4_mir_bin_eq, source_rvalue, pattern_rvalue, stmt_span, v4_ty_bool)
    }

    pilot route_cond = v4_mir_try_lower_route_pattern_condition(mir_id, body_id, stmt_span, pattern, source_place, source_text, source_ty, "when", false)
    if route_cond >= 0 {
        give back route_cond
    }

    if v4_mir_is_tuple_pattern(pattern) {
        if v4_ty_is_known(source_ty) and not v4_ty_is_tuple_type(source_ty) {
            v4_mir_add_type_error(mir_id, stmt_span, "when tuple pattern needs tuple source", "got " + source_ty)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }

        pilot pattern_slots = v4_mir_tuple_pattern_slot_count(pattern)
        if v4_ty_is_tuple_type(source_ty) {
            pilot source_slots = v4_ty_tuple_slot_count(source_ty)
            if source_slots != pattern_slots {
                v4_mir_add_type_error(mir_id, stmt_span, "when tuple pattern arity mismatch", "pattern wants " + word_from_int(pattern_slots) + " slots but source has " + word_from_int(source_slots))
            }
        }

        pilot cond_rvalue = v4_mir_when_pattern_true_rvalue(mir_id, body_id, stmt_span)
        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_name = word_from_int(slot_idx)
            pilot slot_ty = v4_ty_unknown
            if v4_ty_is_tuple_type(source_ty) {
                slot_ty = v4_ty_tuple_slot_type(source_ty, slot_idx)
            }
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, source_place) + "." + slot_name, source_place, slot_name, 0 - 1, stmt_span, slot_ty)
            pilot slot_cond = v4_mir_lower_when_pattern_condition(mir_id, body_id, stmt_span, v4_mir_tuple_pattern_slot(pattern, slot_idx), slot_place, source_text + "." + slot_name, slot_ty)
            cond_rvalue = v4_mir_when_pattern_and_rvalue(mir_id, body_id, cond_rvalue, slot_cond, stmt_span)
            slot_idx += 1
        }
        give back cond_rvalue
    }

    if v4_mir_is_bracket_pattern(pattern) {
        pilot source_is_sequence = false
        if v4_ty_is_known(source_ty) == false or v4_ty_list_element_type(source_ty) != v4_ty_unknown or v4_ty_is_fixed_array_type(source_ty) {
            source_is_sequence = true
        }
        if v4_ty_is_known(source_ty) and not source_is_sequence {
            v4_mir_add_type_error(mir_id, stmt_span, "when sequence pattern needs list or array source", "got " + source_ty)
            give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
        }

        pilot pattern_slots = v4_mir_bracket_pattern_slot_count(pattern)
        if v4_ty_is_fixed_array_type(source_ty) {
            pilot source_slots = v4_mir_fixed_array_slot_count(mir_id, source_ty)
            if source_slots >= 0 and source_slots != pattern_slots {
                v4_mir_add_type_error(mir_id, stmt_span, "when sequence pattern arity mismatch", "pattern wants " + word_from_int(pattern_slots) + " slots but source has " + word_from_int(source_slots))
            }
        }

        pilot element_ty = v4_ty_unknown
        if v4_ty_list_element_type(source_ty) != v4_ty_unknown {
            element_ty = v4_ty_list_element_type(source_ty)
        } else if v4_ty_is_fixed_array_type(source_ty) {
            element_ty = v4_ty_fixed_array_element_type(source_ty)
        }

        pilot cond_rvalue = v4_mir_when_pattern_true_rvalue(mir_id, body_id, stmt_span)
        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_text = word_from_int(slot_idx)
            pilot index_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, slot_text, "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_index, v4_mir_place_text(mir_id, body_id, source_place) + "[" + slot_text + "]", source_place, "", index_rvalue, stmt_span, element_ty)
            pilot slot_cond = v4_mir_lower_when_pattern_condition(mir_id, body_id, stmt_span, v4_mir_bracket_pattern_slot(pattern, slot_idx), slot_place, source_text + "[" + slot_text + "]", element_ty)
            cond_rvalue = v4_mir_when_pattern_and_rvalue(mir_id, body_id, cond_rvalue, slot_cond, stmt_span)
            slot_idx += 1
        }
        give back cond_rvalue
    }

    if v4_mir_pattern_is_simple_local(pattern) {
        give back v4_mir_when_pattern_true_rvalue(mir_id, body_id, stmt_span)
    }

    v4_mir_add_type_error(mir_id, stmt_span, "unsupported when arm pattern", "use literals, _, names, Route::Case, route payload patterns, (a, b, ...), or [a, b, ...]")
    give back v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
}

task v4_mir_lower_when_pattern_bindings(mir_id: int, body_id: int, block_id: int, stmt_span: word, pattern: word, source_place: int, source_ty: word) -> void {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back
    }

    if v4_mir_when_pattern_is_literal(pattern) {
        give back
    }

    if v4_mir_try_lower_route_pattern_bindings(mir_id, body_id, block_id, stmt_span, pattern, source_place, source_ty, false) {
        give back
    }

    if v4_mir_pattern_is_simple_local(pattern) {
        if v4_mir_find_local_visible_at(mir_id, body_id, pattern, v4_span_start(stmt_span)) >= 0 {
            v4_mir_add_type_error(mir_id, stmt_span, "when arm duplicate binding", pattern + " already exists in this scope")
            give back
        }

        pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
        pilot local_id = v4_mir_add_local(mir_id, body_id, pattern, source_ty, stmt_span)
        pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, pattern, local_id, pattern, 0 - 1, stmt_span, source_ty)
        v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, pattern, v4_mir_place_text(mir_id, body_id, source_place), stmt_span, place_id, source_rvalue)
        give back
    }

    if v4_mir_is_tuple_pattern(pattern) {
        if v4_ty_is_known(source_ty) and not v4_ty_is_tuple_type(source_ty) {
            give back
        }

        pilot pattern_slots = v4_mir_tuple_pattern_slot_count(pattern)
        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_name = word_from_int(slot_idx)
            pilot slot_ty = v4_ty_unknown
            if v4_ty_is_tuple_type(source_ty) {
                slot_ty = v4_ty_tuple_slot_type(source_ty, slot_idx)
            }
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, source_place) + "." + slot_name, source_place, slot_name, 0 - 1, stmt_span, slot_ty)
            v4_mir_lower_when_pattern_bindings(mir_id, body_id, block_id, stmt_span, v4_mir_tuple_pattern_slot(pattern, slot_idx), slot_place, slot_ty)
            slot_idx += 1
        }
        give back
    }

    if v4_mir_is_bracket_pattern(pattern) {
        pilot source_is_sequence = false
        if v4_ty_is_known(source_ty) == false or v4_ty_list_element_type(source_ty) != v4_ty_unknown or v4_ty_is_fixed_array_type(source_ty) {
            source_is_sequence = true
        }
        if v4_ty_is_known(source_ty) and not source_is_sequence {
            give back
        }

        pilot element_ty = v4_ty_unknown
        if v4_ty_list_element_type(source_ty) != v4_ty_unknown {
            element_ty = v4_ty_list_element_type(source_ty)
        } else if v4_ty_is_fixed_array_type(source_ty) {
            element_ty = v4_ty_fixed_array_element_type(source_ty)
        }

        pilot pattern_slots = v4_mir_bracket_pattern_slot_count(pattern)
        pilot slot_idx = 0
        repeat until slot_idx >= pattern_slots {
            pilot slot_text = word_from_int(slot_idx)
            pilot index_rvalue = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_const_int, slot_text, "", 0 - 1, 0 - 1, stmt_span, v4_ty_int)
            pilot slot_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_index, v4_mir_place_text(mir_id, body_id, source_place) + "[" + slot_text + "]", source_place, "", index_rvalue, stmt_span, element_ty)
            v4_mir_lower_when_pattern_bindings(mir_id, body_id, block_id, stmt_span, v4_mir_bracket_pattern_slot(pattern, slot_idx), slot_place, element_ty)
            slot_idx += 1
        }
        give back
    }

    v4_mir_add_type_error(mir_id, stmt_span, "unsupported when arm pattern", "use literals, _, names, Route::Case, route payload patterns, (a, b, ...), or [a, b, ...]")
}

task v4_mir_when_pattern_is_irrefutable(mir_id: int, pattern: word, source_ty: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back true
    }
    if v4_mir_when_pattern_is_literal(pattern) {
        give back false
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_payload_head = v4_mir_named_brace_pattern_head(pattern)
    pilot route_payload_scope = v4_mir_path_left(route_payload_head)
    if route_payload_head != "" and (route_payload_scope != "" or v4_ty_is_route_type(ty_id, source_ty)) {
        pilot route_name = source_ty
        pilot case_name = route_payload_head
        if route_payload_scope != "" {
            route_name = v4_mir_compact_type_text(route_payload_scope)
            case_name = v4_mir_path_right(route_payload_head)
        }
        if route_name == "" or not v4_ty_is_route_type(ty_id, route_name) {
            give back false
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
            give back false
        }
        if not v4_ty_route_case_has_payload(ty_id, route_lookup_name, case_name) {
            give back false
        }

        pilot seen_fields = ""
        pilot field_idx = 0
        pilot field_count = v4_mir_named_brace_pattern_field_count(pattern)
        repeat until field_idx >= field_count {
            pilot field_segment = v4_mir_named_brace_pattern_field(pattern, field_idx)
            pilot field_name = v4_mir_named_brace_field_name(field_segment)
            pilot child_pattern = v4_mir_named_brace_field_pattern(field_segment)
            if field_name == "" or v4_mir_name_list_contains(seen_fields, field_name) {
                give back false
            }
            seen_fields = v4_mir_name_list_add(seen_fields, field_name)
            pilot field_ty = v4_ty_route_case_field_type_for_name(ty_id, route_lookup_name, case_name, field_name)
            if field_ty == v4_ty_unknown {
                give back false
            }
            if not v4_mir_when_pattern_is_irrefutable(mir_id, child_pattern, field_ty) {
                give back false
            }
            field_idx += 1
        }
        give back true
    }

    pilot route_pattern_sep = v4_mir_path_scope_separator(pattern)
    if route_pattern_sep >= 0 or (v4_ty_is_route_type(ty_id, source_ty) and v4_ty_route_has_case(ty_id, source_ty, pattern)) {
        pilot route_name = source_ty
        pilot case_name = pattern
        if route_pattern_sep >= 0 {
            route_name = v4_mir_compact_type_text(v4_mir_path_left(pattern))
            case_name = v4_mir_path_right(pattern)
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        give back route_name != "" and v4_mir_route_names_match(ty_id, route_name, source_ty) and v4_ty_route_has_case(ty_id, route_lookup_name, case_name)
    }

    if v4_mir_pattern_is_simple_local(pattern) {
        give back true
    }

    if v4_mir_is_tuple_pattern(pattern) {
        if not v4_ty_is_tuple_type(source_ty) {
            give back false
        }
        if v4_mir_tuple_pattern_slot_count(pattern) != v4_ty_tuple_slot_count(source_ty) {
            give back false
        }
        pilot slot_idx = 0
        pilot slot_count = v4_mir_tuple_pattern_slot_count(pattern)
        repeat until slot_idx >= slot_count {
            if not v4_mir_when_pattern_is_irrefutable(mir_id, v4_mir_tuple_pattern_slot(pattern, slot_idx), v4_ty_tuple_slot_type(source_ty, slot_idx)) {
                give back false
            }
            slot_idx += 1
        }
        give back true
    }

    if v4_mir_is_bracket_pattern(pattern) {
        if not v4_ty_is_fixed_array_type(source_ty) {
            give back false
        }
        pilot slot_count = v4_mir_bracket_pattern_slot_count(pattern)
        pilot length_text = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), source_ty)
        if length_text != word_from_int(slot_count) {
            give back false
        }
        pilot element_ty = v4_ty_fixed_array_element_type(source_ty)
        pilot slot_idx = 0
        repeat until slot_idx >= slot_count {
            if not v4_mir_when_pattern_is_irrefutable(mir_id, v4_mir_bracket_pattern_slot(pattern, slot_idx), element_ty) {
                give back false
            }
            slot_idx += 1
        }
        give back true
    }

    give back false
}

task v4_mir_when_pattern_route_case(mir_id: int, pattern: word, source_ty: word) -> word {
    pattern = v4_mir_pattern_trim(pattern)
    pilot ty_id = v4_mir_ty_id(mir_id)
    if not v4_ty_is_route_type(ty_id, source_ty) {
        give back ""
    }

    pilot route_payload_head = v4_mir_named_brace_pattern_head(pattern)
    pilot route_payload_scope = v4_mir_path_left(route_payload_head)
    if route_payload_head != "" and (route_payload_scope != "" or v4_ty_route_has_case(ty_id, source_ty, route_payload_head)) {
        pilot route_name = source_ty
        pilot case_name = route_payload_head
        if route_payload_scope != "" {
            route_name = v4_mir_compact_type_text(route_payload_scope)
            case_name = v4_mir_path_right(route_payload_head)
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        if not v4_mir_route_names_match(ty_id, route_name, source_ty) {
            give back ""
        }
        if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
            give back ""
        }
        if not v4_ty_route_case_has_payload(ty_id, route_lookup_name, case_name) {
            give back ""
        }
        give back case_name
    }

    pilot route_pattern_sep = v4_mir_path_scope_separator(pattern)
    if route_pattern_sep >= 0 or v4_ty_route_has_case(ty_id, source_ty, pattern) {
        pilot route_name = source_ty
        pilot case_name = pattern
        if route_pattern_sep >= 0 {
            route_name = v4_mir_compact_type_text(v4_mir_path_left(pattern))
            case_name = v4_mir_path_right(pattern)
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        if v4_mir_route_names_match(ty_id, route_name, source_ty) and v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
            give back case_name
        }
    }
    give back ""
}

task v4_mir_when_pattern_full_route_case(mir_id: int, pattern: word, source_ty: word) -> word {
    pilot case_name = v4_mir_when_pattern_route_case(mir_id, pattern, source_ty)
    if case_name == "" {
        give back ""
    }
    if v4_mir_when_pattern_is_irrefutable(mir_id, pattern, source_ty) {
        give back case_name
    }
    give back ""
}

task v4_mir_route_covered_case_count(mir_id: int, route_name: word, covered_cases: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back 0
    }

    pilot covered = 0
    pilot case_idx = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_idx >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_idx)
        if v4_mir_name_list_contains(covered_cases, case_name) {
            covered += 1
        }
        case_idx += 1
    }
    give back covered
}

task v4_mir_route_all_cases_covered(mir_id: int, route_name: word, covered_cases: word) -> bool {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back false
    }
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    if case_count <= 0 {
        give back false
    }
    give back v4_mir_route_covered_case_count(mir_id, route_name, covered_cases) >= case_count
}

task v4_mir_route_missing_cases_text(mir_id: int, route_name: word, covered_cases: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_ty_route_signature_id_for_name(ty_id, route_name)
    if sig_id < 0 {
        give back ""
    }

    pilot missing = ""
    pilot case_idx = 0
    pilot case_count = v4_ty_route_case_count(ty_id, sig_id)
    repeat until case_idx >= case_count {
        pilot case_name = v4_ty_route_case_name(ty_id, sig_id, case_idx)
        if not v4_mir_name_list_contains(covered_cases, case_name) {
            pilot case_text = v4_mir_route_case_text(route_name, case_name)
            if missing == "" {
                missing = case_text
            } else {
                missing = missing + ", " + case_text
            }
        }
        case_idx += 1
    }
    give back missing
}

task v4_mir_lower_arm_body(mir_id: int, body_id: int, block_id: int, stream_id: int, arrow_token: int, arm_end: int) -> int {
    pilot first_body = v4_mir_skip_trivia(stream_id, arrow_token + 1)
    if first_body < arm_end {
        if v4_lex_token_value(stream_id, first_body) == "{" {
            give back v4_mir_lower_block_body(mir_id, body_id, block_id, stream_id, first_body, arm_end)
        } else {
            give back v4_mir_lower_statement(mir_id, body_id, block_id, stream_id, first_body, arm_end)
        }
    }
    give back block_id
}

task v4_mir_check_condition_rvalue(mir_id: int, body_id: int, stmt_span: word, op: word, source_place: int, source_text: word) -> int {
    pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
    give back v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_check, "check " + source_text + " " + op, op, source_rvalue, 0 - 1, stmt_span, v4_ty_bool)
}

task v4_mir_lower_checked_binding(mir_id: int, body_id: int, block_id: int, stmt_span: word, local_name: word, source_place: int, source_ty: word, duplicate_message: word) -> void {
    local_name = v4_mir_pattern_trim(local_name)
    if local_name == "" or local_name == "_" {
        give back
    }
    if v4_mir_find_local_visible_at(mir_id, body_id, local_name, v4_span_start(stmt_span)) >= 0 {
        v4_mir_add_type_error(mir_id, stmt_span, duplicate_message, local_name + " already exists in this scope")
        give back
    }
    pilot source_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, source_place, stmt_span)
    pilot local_id = v4_mir_add_local(mir_id, body_id, local_name, source_ty, stmt_span)
    pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, local_name, local_id, local_name, 0 - 1, stmt_span, source_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, local_name, v4_mir_place_text(mir_id, body_id, source_place), stmt_span, place_id, source_rvalue)
}

task v4_mir_checked_pattern_supported(pattern: word) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" {
        give back false
    }
    if pattern == "_" or v4_mir_pattern_is_simple_local(pattern) {
        give back true
    }
    give back v4_mir_destructure_pattern_kind(pattern) != ""
}

task v4_mir_lower_checked_pattern(mir_id: int, body_id: int, block_id: int, stmt_span: word, pattern: word, source_place: int, source_ty: word, duplicate_message: word, malformed_message: word, malformed_help: word) -> void {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" {
        v4_mir_add_type_error(mir_id, stmt_span, malformed_message, malformed_help)
        give back
    }
    if pattern == "_" {
        give back
    }
    if v4_mir_pattern_is_simple_local(pattern) {
        v4_mir_lower_checked_binding(mir_id, body_id, block_id, stmt_span, pattern, source_place, source_ty, duplicate_message)
        give back
    }

    pilot pattern_kind = v4_mir_destructure_pattern_kind(pattern)
    if pattern_kind == "" {
        v4_mir_add_type_error(mir_id, stmt_span, malformed_message, malformed_help)
        give back
    }
    v4_mir_lower_destructure_pattern(mir_id, body_id, block_id, stmt_span, pattern_kind, pattern, source_place, source_ty)
}

task v4_mir_try_lower_route_pattern_bindings(mir_id: int, body_id: int, block_id: int, stmt_span: word, pattern: word, source_place: int, source_ty: word, bare_names_are_route_candidates: bool) -> bool {
    pattern = v4_mir_pattern_trim(pattern)
    if pattern == "" or pattern == "_" {
        give back false
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_payload_head = v4_mir_named_brace_pattern_head(pattern)
    pilot route_payload_scope = v4_mir_path_left(route_payload_head)
    if route_payload_head != "" and (route_payload_scope != "" or v4_ty_is_route_type(ty_id, source_ty) or bare_names_are_route_candidates) {
        pilot route_name = source_ty
        pilot case_name = route_payload_head
        if route_payload_scope != "" {
            route_name = v4_mir_compact_type_text(route_payload_scope)
            case_name = v4_mir_path_right(route_payload_head)
        }
        if route_name == "" or not v4_ty_is_route_type(ty_id, route_name) {
            give back true
        }
        pilot route_lookup_name = v4_mir_route_effective_name(ty_id, route_name, source_ty)
        if not v4_ty_route_has_case(ty_id, route_lookup_name, case_name) {
            give back true
        }
        if not v4_ty_route_case_has_payload(ty_id, route_lookup_name, case_name) {
            give back true
        }

        pilot seen_fields = ""
        pilot field_idx = 0
        pilot field_count = v4_mir_named_brace_pattern_field_count(pattern)
        repeat until field_idx >= field_count {
            pilot field_segment = v4_mir_named_brace_pattern_field(pattern, field_idx)
            pilot field_name = v4_mir_named_brace_field_name(field_segment)
            pilot child_pattern = v4_mir_named_brace_field_pattern(field_segment)
            if field_name != "" and not v4_mir_name_list_contains(seen_fields, field_name) {
                seen_fields = v4_mir_name_list_add(seen_fields, field_name)
                pilot field_ty = v4_ty_route_case_field_type_for_name(ty_id, route_lookup_name, case_name, field_name)
                if field_ty != v4_ty_unknown {
                    pilot field_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, source_place) + "." + field_name, source_place, field_name, 0 - 1, stmt_span, field_ty)
                    v4_mir_lower_when_pattern_bindings(mir_id, body_id, block_id, stmt_span, child_pattern, field_place, field_ty)
                }
            }
            field_idx += 1
        }
        give back true
    }

    pilot route_pattern_sep = v4_mir_path_scope_separator(pattern)
    if route_pattern_sep >= 0 or (v4_ty_is_route_type(ty_id, source_ty) and v4_ty_route_has_case(ty_id, source_ty, pattern)) or (bare_names_are_route_candidates and v4_mir_pattern_is_simple_local(pattern)) {
        give back true
    }
    give back false
}

task v4_mir_lower_check_maybe_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, check_token: int, stmt_end: int) -> int {
    pilot open_token = v4_mir_find_token_value(stream_id, check_token, stmt_end, "{")
    if open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, check_token, stmt_end)
    }

    pilot check_close = v4_mir_find_matching_brace(stream_id, open_token, stmt_end)
    pilot subject_text = v4_mir_expr_text(stream_id, check_token + 1, open_token)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, check_token, stmt_end)
    pilot subject_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, check_token + 1, open_token)
    pilot subject_ty = v4_mir_rvalue_ty(mir_id, body_id, subject_rvalue)
    if v4_ty_is_known(subject_ty) and not v4_ty_is_maybe_type(subject_ty) {
        v4_mir_add_type_error(mir_id, stmt_span, "check needs maybe source", "got " + subject_ty)
    }

    pilot subject_name = v4_mir_unique_local_name(mir_id, body_id, "_check_subject")
    pilot subject_id = v4_mir_add_local(mir_id, body_id, subject_name, subject_ty, stmt_span)
    pilot subject_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, subject_name, subject_id, subject_name, 0 - 1, stmt_span, subject_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, subject_name, subject_text, stmt_span, subject_place, subject_rvalue)

    pilot got_arrow = 0 - 1
    pilot got_end = 0 - 1
    pilot got_span = V4_NO_SPAN
      pilot got_pattern = ""
    pilot nobody_arrow = 0 - 1
    pilot nobody_end = 0 - 1
    pilot nobody_span = V4_NO_SPAN
    pilot idx = open_token + 1
    repeat until idx >= check_close {
        idx = v4_mir_skip_trivia(stream_id, idx)
        if idx >= check_close {
            idx = check_close
        }
        pilot arrow = v4_mir_find_arrow_token(stream_id, idx, check_close)
        if arrow < 0 {
            idx = check_close
        } else {
            pilot arm_end = v4_mir_when_arm_body_end(stream_id, arrow + 1, check_close)
            pilot arm_first = v4_mir_skip_trivia(stream_id, idx)
            pilot arm_head = ""
            if arm_first < arrow {
                arm_head = v4_lex_token_value(stream_id, arm_first)
            }
              if arm_head == "got" {
                  if got_arrow >= 0 {
                      v4_mir_add_type_error(mir_id, v4_mir_span_from_tokens(stream_id, idx, arm_end), "check maybe duplicate got arm", "got already appears in this check")
                  } else {
                      got_pattern = v4_mir_pattern_trim(v4_mir_expr_text(stream_id, arm_first + 1, arrow))
                      if not v4_mir_checked_pattern_supported(got_pattern) {
                          v4_mir_add_type_error(mir_id, v4_mir_span_from_tokens(stream_id, idx, arm_end), "check maybe arm malformed", "use got pattern -> ...")
                      } else {
                          got_arrow = arrow
                          got_end = arm_end
                          got_span = v4_mir_span_from_tokens(stream_id, idx, arm_end)
                      }
                }
            } else if arm_head == "nobody" {
                if nobody_arrow >= 0 {
                    v4_mir_add_type_error(mir_id, v4_mir_span_from_tokens(stream_id, idx, arm_end), "check maybe duplicate nobody arm", "nobody already appears in this check")
                  } else {
                      nobody_arrow = arrow
                      nobody_end = arm_end
                      nobody_span = v4_mir_span_from_tokens(stream_id, idx, arm_end)
                  }
              } else {
                  v4_mir_add_type_error(mir_id, v4_mir_span_from_tokens(stream_id, idx, arm_end), "check maybe arm malformed", "use got pattern -> ... or nobody -> ...")
              }
              idx = arm_end + 1
          }
      }

    if got_arrow < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "check maybe missing got arm", "add got pattern -> ...")
    }
    if nobody_arrow < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "check maybe missing nobody arm", "add nobody -> ...")
    }

    pilot got_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot nobody_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot cond_rvalue = v4_mir_check_condition_rvalue(mir_id, body_id, stmt_span, "HasSome", subject_place, subject_text)
    pilot cond_text = v4_mir_rvalue_text(mir_id, body_id, cond_rvalue)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_if, got_block, nobody_block, cond_text))
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_branch, cond_text, "got#" + word_from_int(got_block) + " nobody#" + word_from_int(nobody_block), stmt_span, 0 - 1, cond_rvalue)

      if got_arrow >= 0 {
          pilot value_ty = v4_ty_maybe_value_type(subject_ty)
          pilot value_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, subject_place) + ".some", subject_place, "some", 0 - 1, stmt_span, value_ty)
          v4_mir_push_scope_span(got_span)
          v4_mir_lower_checked_pattern(mir_id, body_id, got_block, got_span, got_pattern, value_place, value_ty, "check maybe binding duplicate local", "check maybe arm malformed", "use got pattern -> ...")
          got_block = v4_mir_lower_arm_body(mir_id, body_id, got_block, stream_id, got_arrow, got_end)
          v4_mir_pop_scope_span()
      }
    v4_mir_seal_block_goto_if_live(mir_id, body_id, got_block, after_block)

    if nobody_arrow >= 0 {
        v4_mir_push_scope_span(nobody_span)
        nobody_block = v4_mir_lower_arm_body(mir_id, body_id, nobody_block, stream_id, nobody_arrow, nobody_end)
        v4_mir_pop_scope_span()
    }
    v4_mir_seal_block_goto_if_live(mir_id, body_id, nobody_block, after_block)
    give back after_block
}

task v4_mir_lower_check_result_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, check_token: int, stmt_end: int) -> int {
    pilot result_token = v4_mir_skip_trivia(stream_id, check_token + 1)
    pilot open_token = v4_mir_find_token_value(stream_id, result_token, stmt_end, "{")
    if result_token >= stmt_end or v4_lex_token_value(stream_id, result_token) != "result" or open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, check_token, stmt_end)
    }

    pilot check_close = v4_mir_find_matching_brace(stream_id, open_token, stmt_end)
    pilot subject_text = v4_mir_expr_text(stream_id, result_token + 1, open_token)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, check_token, stmt_end)
    pilot subject_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, result_token + 1, open_token)
    pilot subject_ty = v4_mir_rvalue_ty(mir_id, body_id, subject_rvalue)
    if v4_ty_is_known(subject_ty) and not v4_ty_is_result_type(subject_ty) {
        v4_mir_add_type_error(mir_id, stmt_span, "check result needs result source", "got " + subject_ty)
    }

    pilot subject_name = v4_mir_unique_local_name(mir_id, body_id, "_check_result_subject")
    pilot subject_id = v4_mir_add_local(mir_id, body_id, subject_name, subject_ty, stmt_span)
    pilot subject_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, subject_name, subject_id, subject_name, 0 - 1, stmt_span, subject_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, subject_name, subject_text, stmt_span, subject_place, subject_rvalue)

    pilot ok_arrow = 0 - 1
    pilot ok_end = 0 - 1
    pilot ok_span = V4_NO_SPAN
      pilot ok_pattern = ""
    pilot err_arrow = 0 - 1
    pilot err_end = 0 - 1
    pilot err_span = V4_NO_SPAN
      pilot err_pattern = ""
    pilot idx = open_token + 1
    repeat until idx >= check_close {
        idx = v4_mir_skip_trivia(stream_id, idx)
        if idx >= check_close {
            idx = check_close
        }
        pilot arrow = v4_mir_find_arrow_token(stream_id, idx, check_close)
        if arrow < 0 {
            idx = check_close
        } else {
            pilot arm_end = v4_mir_when_arm_body_end(stream_id, arrow + 1, check_close)
            pilot arm_first = v4_mir_skip_trivia(stream_id, idx)
            pilot arm_head = ""
            if arm_first < arrow {
                arm_head = v4_lex_token_value(stream_id, arm_first)
            }
            pilot head_span = v4_mir_span_from_tokens(stream_id, idx, arm_end)
            pilot head_last = v4_mir_last_nontrivia_before(stream_id, arrow)
              pilot bind_pattern = ""
              pilot malformed = false
              if arm_head == "ok" or arm_head == "err" {
                  pilot open_paren = v4_mir_skip_trivia(stream_id, arm_first + 1)
                  if open_paren >= arrow or v4_lex_token_value(stream_id, open_paren) != "(" {
                      malformed = true
                  } else {
                      pilot close_paren = v4_mir_find_matching_paren(stream_id, open_paren, arrow)
                      if close_paren != head_last {
                          malformed = true
                      } else {
                          bind_pattern = v4_mir_pattern_trim(v4_mir_expr_text(stream_id, open_paren + 1, close_paren))
                          if not v4_mir_checked_pattern_supported(bind_pattern) {
                              malformed = true
                          }
                      }
                  }
              }

            if arm_head == "ok" {
                  if ok_arrow >= 0 {
                      v4_mir_add_type_error(mir_id, head_span, "check result duplicate ok arm", "ok already appears in this check result")
                  } else if malformed {
                      v4_mir_add_type_error(mir_id, head_span, "check result arm malformed", "use ok(pattern) -> ...")
                  } else {
                      ok_arrow = arrow
                      ok_end = arm_end
                      ok_span = head_span
                      ok_pattern = bind_pattern
                  }
              } else if arm_head == "err" {
                  if err_arrow >= 0 {
                      v4_mir_add_type_error(mir_id, head_span, "check result duplicate err arm", "err already appears in this check result")
                  } else if malformed {
                      v4_mir_add_type_error(mir_id, head_span, "check result arm malformed", "use err(pattern) -> ...")
                  } else {
                      err_arrow = arrow
                      err_end = arm_end
                      err_span = head_span
                      err_pattern = bind_pattern
                  }
              } else {
                  v4_mir_add_type_error(mir_id, head_span, "check result arm malformed", "use ok(pattern) -> ... or err(pattern) -> ...")
              }
              idx = arm_end + 1
          }
    }

    if ok_arrow < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "check result missing ok arm", "add ok(pattern) -> ...")
    }
    if err_arrow < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "check result missing err arm", "add err(pattern) -> ...")
    }

    pilot ok_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot err_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot cond_rvalue = v4_mir_check_condition_rvalue(mir_id, body_id, stmt_span, "IsOk", subject_place, subject_text)
    pilot cond_text = v4_mir_rvalue_text(mir_id, body_id, cond_rvalue)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_if, ok_block, err_block, cond_text))
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_branch, cond_text, "ok#" + word_from_int(ok_block) + " err#" + word_from_int(err_block), stmt_span, 0 - 1, cond_rvalue)

      if ok_arrow >= 0 {
          pilot ok_ty = v4_ty_result_ok_type(subject_ty)
          pilot ok_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, subject_place) + ".ok", subject_place, "ok", 0 - 1, stmt_span, ok_ty)
          v4_mir_push_scope_span(ok_span)
          v4_mir_lower_checked_pattern(mir_id, body_id, ok_block, ok_span, ok_pattern, ok_place, ok_ty, "check result binding duplicate local", "check result arm malformed", "use ok(pattern) -> ...")
          ok_block = v4_mir_lower_arm_body(mir_id, body_id, ok_block, stream_id, ok_arrow, ok_end)
          v4_mir_pop_scope_span()
      }
    v4_mir_seal_block_goto_if_live(mir_id, body_id, ok_block, after_block)

      if err_arrow >= 0 {
          pilot err_ty = v4_ty_result_err_type(subject_ty)
          pilot err_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_field, v4_mir_place_text(mir_id, body_id, subject_place) + ".err", subject_place, "err", 0 - 1, stmt_span, err_ty)
          v4_mir_push_scope_span(err_span)
          v4_mir_lower_checked_pattern(mir_id, body_id, err_block, err_span, err_pattern, err_place, err_ty, "check result binding duplicate local", "check result arm malformed", "use err(pattern) -> ...")
          err_block = v4_mir_lower_arm_body(mir_id, body_id, err_block, stream_id, err_arrow, err_end)
          v4_mir_pop_scope_span()
      }
    v4_mir_seal_block_goto_if_live(mir_id, body_id, err_block, after_block)
    give back after_block
}

task v4_mir_lower_check_route_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, check_token: int, stmt_end: int) -> int {
    pilot route_token = v4_mir_skip_trivia(stream_id, check_token + 1)
    pilot open_token = v4_mir_find_token_value(stream_id, route_token, stmt_end, "{")
    if route_token >= stmt_end or v4_lex_token_value(stream_id, route_token) != "route" or open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, check_token, stmt_end)
    }

    pilot check_close = v4_mir_find_matching_brace(stream_id, open_token, stmt_end)
    pilot subject_text = v4_mir_expr_text(stream_id, route_token + 1, open_token)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, check_token, stmt_end)
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot subject_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, route_token + 1, open_token)
    pilot subject_ty = v4_mir_rvalue_ty(mir_id, body_id, subject_rvalue)
    if v4_ty_is_known(subject_ty) and not v4_ty_is_route_type(v4_mir_ty_id(mir_id), subject_ty) {
        v4_mir_add_type_error(mir_id, stmt_span, "check route needs route source", "got " + subject_ty)
    }

    pilot subject_name = v4_mir_unique_local_name(mir_id, body_id, "_check_route_subject")
    pilot subject_id = v4_mir_add_local(mir_id, body_id, subject_name, subject_ty, stmt_span)
    pilot subject_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, subject_name, subject_id, subject_name, 0 - 1, stmt_span, subject_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, subject_name, subject_text, stmt_span, subject_place, subject_rvalue)

    pilot route_covered_cases = ""
    pilot current_check = block_id
    pilot current_check_live = true
    pilot idx = open_token + 1
    repeat until idx >= check_close {
        idx = v4_mir_skip_trivia(stream_id, idx)
        if idx >= check_close {
            idx = check_close
        }
        pilot arrow = v4_mir_find_arrow_token(stream_id, idx, check_close)
        if arrow < 0 {
            idx = check_close
        }
        if idx < check_close {
            pilot pattern = v4_mir_expr_text(stream_id, idx, arrow)
            pilot arm_end = v4_mir_when_arm_body_end(stream_id, arrow + 1, check_close)
            pilot arm_span = v4_mir_span_from_tokens(stream_id, idx, arm_end)
            pilot trimmed_pattern = v4_mir_pattern_trim(pattern)
            pilot pattern_full_route_case = v4_mir_when_pattern_full_route_case(mir_id, trimmed_pattern, subject_ty)
            pilot pattern_catch_all: bool = trimmed_pattern == "_"
            pilot route_all_covered = v4_mir_route_all_cases_covered(mir_id, subject_ty, route_covered_cases)
            pilot arm_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
            pilot arm_unreachable = false
            pilot arm_help = ""
            if not current_check_live {
                arm_unreachable = true
                arm_help = "earlier arms already cover every " + subject_ty + " case"
            } else if route_all_covered {
                arm_unreachable = true
                arm_help = "earlier arms already cover every " + subject_ty + " case"
            } else if pattern_full_route_case != "" and v4_mir_name_list_contains(route_covered_cases, pattern_full_route_case) {
                arm_unreachable = true
                arm_help = v4_mir_route_case_text(subject_ty, pattern_full_route_case) + " was already covered by an earlier arm"
            }
            if arm_unreachable {
                v4_mir_add_type_error(mir_id, arm_span, "unreachable check route arm", arm_help)
            } else if pattern_catch_all {
                v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_goto, arm_block, 0 - 1, ""))
                current_check_live = false
            } else {
                pilot cond_rvalue = v4_mir_try_lower_route_pattern_condition(mir_id, body_id, stmt_span, trimmed_pattern, subject_place, subject_text, subject_ty, "check route", true)
                if cond_rvalue < 0 {
                    v4_mir_add_type_error(mir_id, arm_span, "check route arm malformed", "use Route::Case -> ..., Case -> ..., Route::Case payload -> ..., Case payload -> ..., or _ -> ...")
                    cond_rvalue = v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
                }
                pilot cond_text = v4_mir_rvalue_text(mir_id, body_id, cond_rvalue)
                pilot next_check = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
                v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_if, arm_block, next_check, cond_text))
                v4_mir_add_stmt(mir_id, body_id, current_check, v4_mir_stmt_branch, cond_text, "arm#" + word_from_int(arm_block) + " next#" + word_from_int(next_check), stmt_span, 0 - 1, cond_rvalue)
                current_check = next_check
            }
            v4_mir_push_scope_span(arm_span)
            v4_mir_try_lower_route_pattern_bindings(mir_id, body_id, arm_block, arm_span, trimmed_pattern, subject_place, subject_ty, true)
            pilot arm_tail = v4_mir_lower_arm_body(mir_id, body_id, arm_block, stream_id, arrow, arm_end)
            v4_mir_pop_scope_span()
            v4_mir_seal_block_goto_if_live(mir_id, body_id, arm_tail, after_block)
            if not arm_unreachable and pattern_full_route_case != "" {
                route_covered_cases = v4_mir_name_list_add(route_covered_cases, pattern_full_route_case)
                if v4_mir_route_all_cases_covered(mir_id, subject_ty, route_covered_cases) {
                    current_check_live = false
                    v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_unreachable, 0 - 1, 0 - 1, "exhaustive check route"))
                }
            }
            idx = arm_end + 1
        }
    }
    if current_check_live {
        v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_goto, after_block, 0 - 1, ""))
    }
    if current_check_live {
        pilot missing_cases = v4_mir_route_missing_cases_text(mir_id, subject_ty, route_covered_cases)
        if missing_cases != "" {
            v4_mir_add_type_error(mir_id, stmt_span, "non-exhaustive check route", "missing " + missing_cases)
        }
    }
    give back after_block
}

task v4_mir_lower_only_on_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, only_token: int, stmt_end: int) -> int {
    pilot on_token = v4_mir_skip_trivia(stream_id, only_token + 1)
    if on_token >= stmt_end or v4_lex_token_value(stream_id, on_token) != "on" {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, only_token, stmt_end)
    }

    pilot stmt_span = v4_mir_span_from_tokens(stream_id, only_token, stmt_end)
    pilot from_token = v4_mir_find_top_level_token(stream_id, on_token + 1, stmt_end, "from")
    if from_token < 0 or from_token <= on_token + 1 {
        v4_mir_add_type_error(mir_id, stmt_span, "only on statement malformed", "use only on Route::Case from value with a guarded block")
        give back block_id
    }

    pilot open_token = v4_mir_find_open_brace_token(stream_id, from_token + 1, stmt_end)
    if open_token < 0 or from_token + 1 >= open_token {
        v4_mir_add_type_error(mir_id, stmt_span, "only on statement malformed", "use only on Route::Case from value with a guarded block")
        give back block_id
    }

    pilot pattern = v4_mir_pattern_trim(v4_mir_expr_text(stream_id, on_token + 1, from_token))
    pilot subject_text = v4_mir_expr_text(stream_id, from_token + 1, open_token)
    if pattern == "" or subject_text == "" {
        v4_mir_add_type_error(mir_id, stmt_span, "only on statement malformed", "use only on Route::Case from value with a guarded block")
        give back block_id
    }

    pilot subject_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, from_token + 1, open_token)
    pilot subject_ty = v4_mir_rvalue_ty(mir_id, body_id, subject_rvalue)

    pilot subject_name = v4_mir_unique_local_name(mir_id, body_id, "_only_on_subject")
    pilot subject_id = v4_mir_add_local(mir_id, body_id, subject_name, subject_ty, stmt_span)
    pilot subject_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, subject_name, subject_id, subject_name, 0 - 1, stmt_span, subject_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, subject_name, subject_text, stmt_span, subject_place, subject_rvalue)

    pilot body_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot cond_rvalue = v4_mir_try_lower_route_pattern_condition(mir_id, body_id, stmt_span, pattern, subject_place, subject_text, subject_ty, "only on", true)
    if cond_rvalue < 0 {
        v4_mir_add_type_error(mir_id, stmt_span, "only on statement malformed", "use only on Route::Case from value with a guarded block")
        cond_rvalue = v4_mir_when_pattern_false_rvalue(mir_id, body_id, stmt_span)
    }
    pilot cond_text = v4_mir_rvalue_text(mir_id, body_id, cond_rvalue)
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_if, body_block, after_block, cond_text))
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_branch, cond_text, "body#" + word_from_int(body_block) + " after#" + word_from_int(after_block), stmt_span, 0 - 1, cond_rvalue)

    pilot body_scope = v4_mir_span_from_tokens(stream_id, open_token, stmt_end)
    pilot pattern_span = v4_mir_span_from_tokens(stream_id, on_token + 1, from_token)
    v4_mir_push_scope_span(body_scope)
    v4_mir_try_lower_route_pattern_bindings(mir_id, body_id, body_block, pattern_span, pattern, subject_place, subject_ty, true)
    pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, body_block, stream_id, open_token, stmt_end)
    v4_mir_pop_scope_span()
    v4_mir_seal_block_goto_if_live(mir_id, body_id, body_tail, after_block)
    give back after_block
}

task v4_mir_lower_trust_me_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, trust_token: int, stmt_end: int) -> int {
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, trust_token, stmt_end)
    pilot me_token = v4_mir_skip_trivia(stream_id, trust_token + 1)
    if me_token >= stmt_end or v4_lex_token_value(stream_id, me_token) != "me" {
        v4_mir_add_type_error(mir_id, stmt_span, "trust me block needs me keyword", "write 'trust me \"reason\" on my honor as .level' followed by a braced body")
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, trust_token, stmt_end)
    }

    pilot cursor = v4_mir_skip_trivia(stream_id, me_token + 1)
    if cursor < stmt_end and v4_lex_token_type(stream_id, cursor) == v4_tok_string {
        cursor = v4_mir_skip_trivia(stream_id, cursor + 1)
    }
    pilot honor_rank = v4_mir_honor_rank("cadet")
    if cursor < stmt_end and v4_lex_token_value(stream_id, cursor) == "on" {
        pilot honor_diag = ""
        pilot honor_msg = "trust me honor clause malformed"
        pilot my_token = v4_mir_skip_trivia(stream_id, cursor + 1)
        if my_token >= stmt_end or v4_lex_token_value(stream_id, my_token) != "my" {
            honor_diag = "use on my honor as .level"
        }
        pilot honor_token = v4_mir_skip_trivia(stream_id, my_token + 1)
        if honor_diag == "" and (honor_token >= stmt_end or v4_lex_token_value(stream_id, honor_token) != "honor") {
            honor_diag = "use on my honor as .level"
        }
        pilot as_token = v4_mir_skip_trivia(stream_id, honor_token + 1)
        if honor_diag == "" and (as_token >= stmt_end or v4_lex_token_value(stream_id, as_token) != "as") {
            honor_diag = "use on my honor as .level"
        }
        pilot dot_token = v4_mir_skip_trivia(stream_id, as_token + 1)
        if honor_diag == "" and (dot_token >= stmt_end or v4_lex_token_value(stream_id, dot_token) != ".") {
            honor_diag = "follow as with .level, e.g. as .pilot"
        }
        pilot level_token = v4_mir_skip_trivia(stream_id, dot_token + 1)
        pilot level_type = ""
        if level_token < stmt_end {
            level_type = v4_lex_token_type(stream_id, level_token)
        }
        pilot level_ok = false
        if level_token < stmt_end {
            if level_type == v4_tok_ident or level_type == v4_tok_keyword {
                level_ok = true
            }
        }
        if honor_diag == "" and level_ok == false {
            honor_diag = "name the honor level after the dot, e.g. .pilot"
        }
        if honor_diag == "" {
            pilot parsed_level = v4_lex_token_value(stream_id, level_token)
            honor_rank = v4_mir_honor_rank(parsed_level)
            if honor_rank == 0 {
                honor_msg = "trust me honor level unknown"
                honor_diag = "valid honor levels: .cadet, .pilot, .ace, .commander, .humanity"
            }
        }
        if honor_diag != "" {
            if honor_diag == "name the honor level after the dot, e.g. .pilot" or honor_diag == "follow as with .level, e.g. as .pilot" {
                honor_msg = "trust me block needs honor level"
            }
            honor_rank = 0
            v4_mir_add_type_error(mir_id, stmt_span, honor_msg, honor_diag)
            -- Skip past the malformed honor clause to the next opening brace so the body still lowers.
            pilot brace_scan = cursor
            repeat until brace_scan >= stmt_end or v4_lex_token_value(stream_id, brace_scan) == "{" {
                brace_scan += 1
            }
            cursor = brace_scan
        } else {
            cursor = v4_mir_skip_trivia(stream_id, level_token + 1)
        }
    }

    if cursor >= stmt_end or v4_lex_token_value(stream_id, cursor) != "{" {
        v4_mir_add_type_error(mir_id, stmt_span, "trust me block needs body", "open the trust me block with a brace after the optional reason and honor clause")
        give back block_id
    }

    pilot body_scope = v4_mir_span_from_tokens(stream_id, cursor, stmt_end)
    v4_mir_push_scope_span(body_scope)
    v4_mir_push_trust_me_honor(honor_rank)
    pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, block_id, stream_id, cursor, stmt_end)
    v4_mir_pop_trust_me()
    v4_mir_pop_scope_span()
    give back body_tail
}

task v4_mir_lower_when_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, when_token: int, stmt_end: int) -> int {
    pilot open_token = v4_mir_find_token_value(stream_id, when_token, stmt_end, "{")
    if open_token < 0 {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, when_token, stmt_end)
    }

    pilot when_close = v4_mir_find_matching_brace(stream_id, open_token, stmt_end)
    pilot scrutinee = v4_mir_expr_text(stream_id, when_token + 1, open_token)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, when_token, stmt_end)
    pilot after_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
    pilot scrutinee_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, when_token + 1, open_token)
    pilot scrutinee_ty = v4_mir_rvalue_ty(mir_id, body_id, scrutinee_rvalue)
    pilot subject_name = v4_mir_unique_local_name(mir_id, body_id, "_when_subject")
    pilot subject_id = v4_mir_add_local(mir_id, body_id, subject_name, scrutinee_ty, stmt_span)
    pilot subject_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, subject_name, subject_id, subject_name, 0 - 1, stmt_span, scrutinee_ty)
    v4_mir_add_stmt(mir_id, body_id, block_id, v4_mir_stmt_local, subject_name, scrutinee, stmt_span, subject_place, scrutinee_rvalue)

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot route_when = v4_ty_is_route_type(ty_id, scrutinee_ty)
    pilot route_covered_cases = ""
    pilot current_check = block_id
    pilot current_check_live = true
    pilot idx = open_token + 1
    repeat until idx >= when_close {
        idx = v4_mir_skip_trivia(stream_id, idx)
        if idx >= when_close {
            idx = when_close
        }
        pilot arrow = v4_mir_find_arrow_token(stream_id, idx, when_close)
        if arrow < 0 {
            idx = when_close
        }
        if idx < when_close {
            pilot pattern = v4_mir_expr_text(stream_id, idx, arrow)
            pilot arm_end = v4_mir_when_arm_body_end(stream_id, arrow + 1, when_close)
            pilot arm_span = v4_mir_span_from_tokens(stream_id, idx, arm_end)
            pilot pattern_route_case = ""
            pilot pattern_full_route_case = ""
            if route_when {
                pattern_route_case = v4_mir_when_pattern_route_case(mir_id, pattern, scrutinee_ty)
                pattern_full_route_case = v4_mir_when_pattern_full_route_case(mir_id, pattern, scrutinee_ty)
            }
            pilot pattern_irrefutable = v4_mir_when_pattern_is_irrefutable(mir_id, pattern, scrutinee_ty)
            pilot pattern_catch_all = false
            if pattern_irrefutable and pattern_full_route_case == "" {
                pattern_catch_all = true
            }
            pilot route_all_covered = false
            if route_when {
                route_all_covered = v4_mir_route_all_cases_covered(mir_id, scrutinee_ty, route_covered_cases)
            }
            pilot arm_block = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
            pilot arm_unreachable = false
            pilot arm_help = ""
            if not current_check_live {
                arm_unreachable = true
                if route_when {
                    arm_help = "earlier arms already cover every " + scrutinee_ty + " case"
                } else {
                    arm_help = "an earlier arm already matches every remaining value"
                }
            } else if route_when and route_all_covered {
                arm_unreachable = true
                arm_help = "earlier arms already cover every " + scrutinee_ty + " case"
            } else if route_when and pattern_route_case != "" and v4_mir_name_list_contains(route_covered_cases, pattern_route_case) {
                arm_unreachable = true
                arm_help = v4_mir_route_case_text(scrutinee_ty, pattern_route_case) + " was already covered by an earlier arm"
            }
            if arm_unreachable {
                v4_mir_add_type_error(mir_id, arm_span, "unreachable when arm", arm_help)
            } else if pattern_catch_all {
                v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_goto, arm_block, 0 - 1, ""))
                current_check_live = false
            } else {
                pilot cond_rvalue = v4_mir_lower_when_pattern_condition(mir_id, body_id, stmt_span, pattern, subject_place, scrutinee, scrutinee_ty)
                pilot cond_text = v4_mir_rvalue_text(mir_id, body_id, cond_rvalue)
                pilot next_check = v4_mir_add_block(mir_id, body_id, v4_mir_term_return, 0 - 1, 0 - 1, "")
                v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_if, arm_block, next_check, cond_text))
                v4_mir_add_stmt(mir_id, body_id, current_check, v4_mir_stmt_branch, cond_text, "arm#" + word_from_int(arm_block) + " next#" + word_from_int(next_check), stmt_span, 0 - 1, cond_rvalue)
                current_check = next_check
            }
            v4_mir_push_scope_span(arm_span)
            v4_mir_lower_when_pattern_bindings(mir_id, body_id, arm_block, arm_span, pattern, subject_place, scrutinee_ty)
            pilot arm_tail = v4_mir_lower_arm_body(mir_id, body_id, arm_block, stream_id, arrow, arm_end)
            v4_mir_pop_scope_span()
            v4_mir_seal_block_goto_if_live(mir_id, body_id, arm_tail, after_block)
            if not arm_unreachable and route_when and pattern_full_route_case != "" {
                route_covered_cases = v4_mir_name_list_add(route_covered_cases, pattern_full_route_case)
                if v4_mir_route_all_cases_covered(mir_id, scrutinee_ty, route_covered_cases) {
                    current_check_live = false
                    v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_unreachable, 0 - 1, 0 - 1, "exhaustive route when"))
                }
            }
            idx = arm_end + 1
        }
    }
    if current_check_live {
        v4_mir_set_body_block(mir_id, body_id, current_check, v4_mir_block_new_full(current_check, v4_mir_term_goto, after_block, 0 - 1, ""))
    }
    if route_when and current_check_live {
        pilot missing_cases = v4_mir_route_missing_cases_text(mir_id, scrutinee_ty, route_covered_cases)
        if missing_cases != "" {
            v4_mir_add_type_error(mir_id, stmt_span, "non-exhaustive route when", "missing " + missing_cases)
        }
    }
    give back after_block
}

task v4_mir_lower_assign_or_expr_stmt(mir_id: int, body_id: int, block_id: int, stream_id: int, stmt_start: int, stmt_end: int) -> int {
    pilot eq_token = v4_mir_find_assignment_operator_token(stream_id, stmt_start, stmt_end)
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, stmt_start, stmt_end)
    if eq_token > stmt_start {
        pilot lhs = v4_mir_expr_text(stream_id, stmt_start, eq_token)
        pilot rhs = v4_mir_expr_text(stream_id, eq_token + 1, stmt_end)
        pilot op_text = v4_lex_token_value(stream_id, eq_token)
        pilot pattern_kind = v4_mir_destructure_pattern_kind(lhs)
        if pattern_kind != "" {
            if op_text != "=" {
                v4_mir_add_type_error(mir_id, stmt_span, "destructure assignment only supports =", "use = with tuple or sequence patterns")
                give back block_id
            }

            if pattern_kind == "route" {
                v4_mir_add_type_error(mir_id, stmt_span, "refutable destructure assignment pattern", "route patterns can fail at runtime; use when to handle every case")
                give back block_id
            }

            pilot source_rvalue = v4_mir_lower_expr(mir_id, body_id, stream_id, eq_token + 1, stmt_end)
            pilot source_ty = v4_mir_rvalue_ty(mir_id, body_id, source_rvalue)
            pilot temp_prefix = "_tuple_assign"
            if pattern_kind == "sequence" {
                temp_prefix = "_seq_assign"
            }
            pilot temp_name = v4_mir_unique_local_name(mir_id, body_id, temp_prefix)
            pilot temp_id = v4_mir_add_local(mir_id, body_id, temp_name, source_ty, stmt_span)
            pilot temp_place = v4_mir_add_place(mir_id, body_id, v4_mir_place_local, temp_name, temp_id, temp_name, 0 - 1, stmt_span, source_ty)
            pilot value_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, source_rvalue)
            v4_mir_add_stmt(mir_id, body_id, value_block, v4_mir_stmt_local, temp_name, rhs, stmt_span, temp_place, source_rvalue)
            v4_mir_lower_destructure_assignment_pattern(mir_id, body_id, value_block, stmt_span, pattern_kind, lhs, temp_place, source_ty)
            give back value_block
        }
        pilot place_id = v4_mir_lower_place(mir_id, body_id, stream_id, stmt_start, eq_token)
        pilot value_rvalue = v4_mir_lower_expr_expected(mir_id, body_id, stream_id, eq_token + 1, stmt_end, v4_mir_place_ty(mir_id, body_id, place_id))
        pilot rvalue_id = value_rvalue
        pilot place_ty = v4_mir_place_ty(mir_id, body_id, place_id)
        pilot value_ty = v4_mir_rvalue_ty(mir_id, body_id, value_rvalue)
        if op_text == "=" {
            v4_mir_check_assignment_types(mir_id, body_id, stmt_span, place_id, place_ty, value_ty)
            pilot coerced_value_ty = v4_mir_coerced_value_type(mir_id, body_id, place_ty, value_ty)
            if coerced_value_ty != value_ty {
                v4_mir_set_rvalue_ty(mir_id, body_id, value_rvalue, coerced_value_ty)
                value_ty = coerced_value_ty
            }
        } else {
            pilot result_ty = v4_mir_compound_assignment_result_ty(mir_id, stmt_span, op_text, place_ty, value_ty)
            if v4_ty_is_known(result_ty) {
                v4_mir_check_assignment_types(mir_id, body_id, stmt_span, place_id, place_ty, result_ty)
                pilot left_rvalue = v4_mir_place_read_rvalue(mir_id, body_id, place_id, stmt_span)
                pilot binary_text = v4_mir_place_text(mir_id, body_id, place_id) + " " + v4_mir_compound_assignment_expr_op(op_text) + " " + rhs
                pilot overload_rvalue = v4_mir_try_lower_binary_operator_overload(mir_id, body_id, left_rvalue, value_rvalue, binary_text, stmt_span, v4_mir_compound_assignment_op_kind(op_text), place_ty, value_ty)
                if overload_rvalue >= 0 {
                    rvalue_id = overload_rvalue
                } else {
                    rvalue_id = v4_mir_add_rvalue(mir_id, body_id, v4_mir_rvalue_binary, binary_text, v4_mir_compound_assignment_op_kind(op_text), left_rvalue, value_rvalue, stmt_span, result_ty)
                }
            }
        }
        if v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_local {
            pilot local_id = v4_mir_find_local_visible_at(mir_id, body_id, v4_mir_place_text(mir_id, body_id, place_id), v4_span_start(stmt_span))
            if local_id >= 0 and v4_mir_local_ty(mir_id, body_id, local_id) == v4_ty_unknown {
                v4_mir_set_local_ty(mir_id, body_id, local_id, value_ty)
            }
        }
        pilot value_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, rvalue_id)
        v4_mir_add_stmt(mir_id, body_id, value_block, v4_mir_stmt_assign, lhs, rhs, stmt_span, place_id, rvalue_id)
        give back value_block
    } else {
        pilot expr = v4_mir_expr_text(stream_id, stmt_start, stmt_end)
        if expr != "" {
            pilot rvalue_id = v4_mir_lower_expr(mir_id, body_id, stream_id, stmt_start, stmt_end)
            pilot value_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, rvalue_id)
            v4_mir_add_stmt(mir_id, body_id, value_block, v4_mir_stmt_expr, "", expr, stmt_span, 0 - 1, rvalue_id)
            give back value_block
        }
    }
    give back block_id
}

task v4_mir_lower_statement(mir_id: int, body_id: int, block_id: int, stream_id: int, stmt_start: int, stmt_end: int) -> int {
    pilot first = v4_mir_skip_trivia(stream_id, stmt_start)
    if first >= stmt_end {
        give back block_id
    }

    pilot first_val = v4_lex_token_value(stream_id, first)
    if first_val == "pilot" {
        give back v4_mir_lower_pilot_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "fixed" {
        pilot maybe_pilot = v4_mir_skip_trivia(stream_id, first + 1)
        if maybe_pilot < stmt_end and v4_lex_token_value(stream_id, maybe_pilot) == "pilot" {
            give back v4_mir_lower_pilot_stmt(mir_id, body_id, block_id, stream_id, maybe_pilot, stmt_end)
        } else {
            give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
        }
    } else if first_val == "give" {
        give back v4_mir_lower_return_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "break" {
        give back v4_mir_lower_break_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "continue" {
        give back v4_mir_lower_continue_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "check" {
        pilot next_token = v4_mir_skip_trivia(stream_id, first + 1)
        if next_token < stmt_end and v4_lex_token_value(stream_id, next_token) == "result" {
            give back v4_mir_lower_check_result_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
        }
        if next_token < stmt_end and v4_lex_token_value(stream_id, next_token) == "route" {
            give back v4_mir_lower_check_route_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
        }
        give back v4_mir_lower_check_maybe_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "if" {
        give back v4_mir_lower_if_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "repeat" {
        give back v4_mir_lower_repeat_until_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "for" {
        give back v4_mir_lower_for_each_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "training" {
        give back v4_mir_lower_training_arc_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "when" {
        give back v4_mir_lower_when_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "only" {
        give back v4_mir_lower_only_on_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else if first_val == "trust" {
        give back v4_mir_lower_trust_me_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    } else {
        give back v4_mir_lower_assign_or_expr_stmt(mir_id, body_id, block_id, stream_id, first, stmt_end)
    }
    give back block_id
}

task v4_mir_lower_block_body(mir_id: int, body_id: int, block_id: int, stream_id: int, open_token: int, end_token: int) -> int {
    pilot close_token = v4_mir_find_matching_brace(stream_id, open_token, end_token)
    pilot block_span = v4_mir_span_from_tokens(stream_id, open_token, close_token + 1)
    v4_mir_push_scope_span(block_span)
    pilot idx = open_token + 1
    pilot current_block = block_id
    repeat until idx >= close_token {
        idx = v4_mir_skip_trivia(stream_id, idx)
        if idx >= close_token {
            idx = close_token
        } else {
            pilot stmt_end = v4_mir_statement_end(stream_id, idx, close_token)
            current_block = v4_mir_lower_statement(mir_id, body_id, current_block, stream_id, idx, stmt_end)
            if v4_mir_block_has_terminal_stmt(mir_id, body_id, current_block) {
                idx = close_token
            } else if stmt_end <= idx {
                idx += 1
            } else {
                idx = stmt_end + 1
            }
        }
    }
    v4_mir_pop_scope_span()
    give back current_block
}

task v4_mir_lower_arrow_body(mir_id: int, body_id: int, block_id: int, stream_id: int, arrow_token: int, end_token: int) -> int {
    pilot stmt_span = v4_mir_span_from_tokens(stream_id, arrow_token, end_token)
    pilot rhs = v4_mir_expr_text(stream_id, arrow_token + 1, end_token)
    if rhs != "" {
        pilot rvalue_id = v4_mir_lower_expr(mir_id, body_id, stream_id, arrow_token + 1, end_token)
        pilot actual_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        v4_mir_check_return_type(mir_id, body_id, stmt_span, actual_ty)
        pilot return_ty = v4_mir_coerced_value_type(mir_id, body_id, v4_mir_expected_return_type(mir_id, body_id), actual_ty)
        pilot place_id = v4_mir_add_place(mir_id, body_id, v4_mir_place_return, "_return", 0 - 1, "_return", 0 - 1, stmt_span, return_ty)
        pilot return_block = v4_mir_wire_try_propagation(mir_id, body_id, block_id, stmt_span, rvalue_id)
        v4_mir_add_stmt(mir_id, body_id, return_block, v4_mir_stmt_return, "_return", rhs, stmt_span, place_id, rvalue_id)
        v4_mir_set_body_block(mir_id, body_id, return_block, v4_mir_block_new_full(return_block, v4_mir_term_return, 0 - 1, 0 - 1, ""))
        give back return_block
    }
    give back block_id
}

task v4_mir_lower_task_body_token_range(mir_id: int, body_id: int, stream_id: int, start_token: int, end_token: int, item_span: word) -> void {
    pilot body_token = v4_mir_find_body_token(stream_id, start_token, end_token)
    if body_token < 0 {
        v4_mir_add_diag(mir_id, v4_diag_new(v4_diag_warning, item_span, "task body not lowered into MIR", "Meiya sees only a signature shell here"))
        give back
    }

    v4_mir_clear_loop_context()
    v4_mir_clear_scope_context()
    pilot body_marker = v4_lex_token_value(stream_id, body_token)
    if body_marker == "{" {
        pilot body_tail = v4_mir_lower_block_body(mir_id, body_id, 0, stream_id, body_token, end_token)
    } else if body_marker == "=>" {
        pilot body_tail = v4_mir_lower_arrow_body(mir_id, body_id, 0, stream_id, body_token, end_token)
    }
    v4_mir_validate_body_cfg(mir_id, body_id, item_span)
    v4_mir_validate_body_return_coverage(mir_id, body_id, item_span)
}

task v4_mir_lower_task_body_tokens(mir_id: int, body_id: int, stream_id: int, item_span: word) -> void {
    pilot start_token = v4_mir_first_token_at_or_after(stream_id, v4_span_start(item_span))
    pilot end_token = v4_mir_first_token_at_or_after(stream_id, v4_span_end(item_span))
    v4_mir_lower_task_body_token_range(mir_id, body_id, stream_id, start_token, end_token, item_span)
}

task v4_mir_seed_param_local(mir_id: int, body_id: int, param_name: word, param_ty: word, param_mode: word, item_span: word, duplicate_help: word) -> void {
    if param_name == "" {
        give back
    }
    if v4_mir_find_local_visible_at(mir_id, body_id, param_name, v4_span_start(item_span)) >= 0 {
        v4_mir_add_type_error(mir_id, item_span, "duplicate parameter binding", param_name + " already exists in " + duplicate_help)
        give back
    }
    pilot local_id = v4_mir_add_local(mir_id, body_id, param_name, param_ty, item_span)
    v4_mir_set_local_mode(mir_id, body_id, local_id, param_mode)
}

task v4_mir_seed_signature_params(mir_id: int, body_id: int, ty_id: int, sig_id: int, item_span: word) -> void {
    pilot param_idx = 0
    pilot param_count = v4_ty_signature_param_count(ty_id, sig_id)
    repeat until param_idx >= param_count {
        pilot param_name = v4_ty_signature_param_name(ty_id, sig_id, param_idx)
        if param_name != "" {
            pilot param_ty = v4_ty_signature_param_type(ty_id, sig_id, param_idx)
            pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_idx)
            v4_mir_seed_param_local(mir_id, body_id, param_name, param_ty, param_mode, item_span, "this signature")
        }
        param_idx += 1
    }
}

task v4_mir_seed_impl_method_params(mir_id: int, body_id: int, ty_id: int, hir_item: int, method_id: int, item_span: word) -> void {
    pilot param_idx = 0
    pilot param_count = v4_ty_impl_method_param_count(ty_id, hir_item, method_id)
    repeat until param_idx >= param_count {
        pilot param_name = v4_ty_impl_method_param_name(ty_id, hir_item, method_id, param_idx)
        if param_name != "" {
            pilot param_ty = v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_idx)
            pilot param_mode = v4_ty_impl_method_param_mode(ty_id, hir_item, method_id, param_idx)
            v4_mir_seed_param_local(mir_id, body_id, param_name, param_ty, param_mode, item_span, "this method signature")
        }
        param_idx += 1
    }
}

task v4_mir_lower_ty(file_id: int, ty_id: int) -> int {
    v4_mir_init()
    pilot mir_id = v4_mir_file_new(file_id, ty_id)
    v4_mir_copy_ty_diags(mir_id, ty_id)
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot stream_id = v4_parse_stream_id(tree_id)

    pilot sig_idx = 0
    pilot sig_count = v4_ty_signature_count(ty_id)
    repeat until sig_idx >= sig_count {
        pilot sig_kind = v4_ty_signature_kind(ty_id, sig_idx)
        if sig_kind == v4_ty_task_sig and v4_ty_signature_extern_member_id(ty_id, sig_idx) < 0 {
            pilot def_id = v4_ty_signature_def(ty_id, sig_idx)
            pilot body_name = v4_ty_signature_name(ty_id, sig_idx)
            pilot sig_display = v4_ty_signature_display(ty_id, sig_idx)
            pilot body_id = v4_mir_add_body(mir_id, def_id, body_name, sig_display)
            pilot hir_item = v4_ty_signature_hir_item(ty_id, sig_idx)
            pilot parse_node = v4_hir_item_parse_node(hir_id, hir_item)
            pilot item_span = v4_parse_node_span(tree_id, parse_node)
            v4_mir_seed_signature_params(mir_id, body_id, ty_id, sig_idx, item_span)
            v4_mir_lower_task_body_tokens(mir_id, body_id, stream_id, item_span)
        }
        sig_idx += 1
    }

    pilot hir_item = 0
    pilot hir_count = v4_hir_item_count(hir_id)
    repeat until hir_item >= hir_count {
        if v4_hir_item_kind(hir_id, hir_item) == v4_hir_impl {
            pilot owner_ty = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
            pilot method_id = 0
            pilot method_count = v4_ty_impl_method_count(ty_id, hir_item)
            repeat until method_id >= method_count {
                pilot method_name = v4_ty_impl_method_name(ty_id, hir_item, method_id)
                pilot method_def = v4_ty_impl_method_def(ty_id, hir_item, method_id)
                pilot method_sig = v4_ty_impl_method_display(ty_id, hir_item, method_id)
                pilot body_name = owner_ty + "::" + method_name
                pilot body_id = v4_mir_add_body(mir_id, method_def, body_name, method_sig)
                pilot method_start = v4_ty_impl_method_start_token(ty_id, hir_item, method_id)
                pilot method_end = v4_ty_impl_method_end_token(ty_id, hir_item, method_id)
                pilot method_span = v4_mir_span_from_tokens(stream_id, method_start, method_end)
                v4_mir_seed_impl_method_params(mir_id, body_id, ty_id, hir_item, method_id, method_span)
                v4_mir_lower_task_body_token_range(mir_id, body_id, stream_id, method_start, method_end, method_span)
                method_id += 1
            }
        }
        hir_item += 1
    }

    give back mir_id
}

task v4_mir_lookup_body(mir_id: int, def_id: word) -> int {
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        if v4_mir_body_def(mir_id, body_idx) == def_id {
            give back body_idx
        }
        body_idx += 1
    }
    give back 0 - 1
}

task v4_mir_local_count(mir_id: int) -> int {
    pilot total = 0
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        total = total + v4_mir_body_local_count(mir_id, body_idx)
        body_idx += 1
    }
    give back total
}

task v4_mir_stmt_count(mir_id: int) -> int {
    pilot total = 0
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        total = total + v4_mir_body_stmt_count(mir_id, body_idx)
        body_idx += 1
    }
    give back total
}

task v4_mir_block_count(mir_id: int) -> int {
    pilot total = 0
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        total = total + v4_mir_body_block_count(mir_id, body_idx)
        body_idx += 1
    }
    give back total
}

task v4_mir_rvalue_count(mir_id: int) -> int {
    pilot total = 0
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        total = total + v4_mir_body_rvalue_count(mir_id, body_idx)
        body_idx += 1
    }
    give back total
}

task v4_mir_place_count(mir_id: int) -> int {
    pilot total = 0
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        total = total + v4_mir_body_place_count(mir_id, body_idx)
        body_idx += 1
    }
    give back total
}

task v4_mir_summary(mir_id: int) -> word {
    pilot summary = "mir-ok mir=" + word_from_int(mir_id)
    summary = summary + " bodies=" + word_from_int(v4_mir_body_count(mir_id))
    summary = summary + " blocks=" + word_from_int(v4_mir_block_count(mir_id))
    summary = summary + " locals=" + word_from_int(v4_mir_local_count(mir_id))
    summary = summary + " statements=" + word_from_int(v4_mir_stmt_count(mir_id))
    summary = summary + " places=" + word_from_int(v4_mir_place_count(mir_id))
    summary = summary + " rvalues=" + word_from_int(v4_mir_rvalue_count(mir_id))
    summary = summary + " diagnostics=" + word_from_int(v4_mir_diag_count(mir_id))
    give back summary
}

task v4_mir_snapshot_escape(value: word) -> word {
    give back v4_ty_snapshot_escape(value)
}

task v4_mir_snapshot_unescape(value: word) -> word {
    give back v4_ty_snapshot_unescape(value)
}

task v4_mir_snapshot_line_count(payload: word) -> int {
    give back v4_ty_snapshot_line_count(payload)
}

task v4_mir_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_ty_snapshot_line(payload, wanted)
}

task v4_mir_snapshot_field_count(line: word) -> int {
    give back v4_ty_snapshot_field_count(line)
}

task v4_mir_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_ty_snapshot_field_raw(line, wanted)
}

task v4_mir_snapshot_field(line: word, wanted: int) -> word {
    give back v4_ty_snapshot_field(line, wanted)
}

task v4_mir_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_ty_snapshot_key_value(line, wanted_key)
}

task v4_mir_snapshot_body_total() -> int {
    v4_mir_init()
    pilot total = 0
    pilot mir_id = 0
    repeat until mir_id >= v4_mir_file_count() {
        total += v4_mir_body_count(mir_id)
        mir_id += 1
    }
    give back total
}

task v4_mir_snapshot_block_total() -> int {
    v4_mir_init()
    pilot total = 0
    pilot mir_id = 0
    repeat until mir_id >= v4_mir_file_count() {
        total += v4_mir_block_count(mir_id)
        mir_id += 1
    }
    give back total
}

