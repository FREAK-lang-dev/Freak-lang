pilot v4_mir_rvalue_binary = "Binary"
pilot v4_mir_rvalue_call = "Call"
pilot v4_mir_rvalue_loop_item = "LoopItem"
pilot v4_mir_rvalue_some = "Some"
pilot v4_mir_rvalue_nobody = "Nobody"
pilot v4_mir_rvalue_ok = "Ok"
pilot v4_mir_rvalue_err = "Err"
pilot v4_mir_rvalue_check = "Check"
