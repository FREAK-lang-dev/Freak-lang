task v4_mir_snapshot_summary() -> word {
    pilot summary = "mir-snapshot"
    summary = summary + " format=" + v4_mir_snapshot_format
    summary = summary + " files=" + word_from_int(v4_mir_file_count())
    summary = summary + " bodies=" + word_from_int(v4_mir_snapshot_body_total())
    summary = summary + " blocks=" + word_from_int(v4_mir_snapshot_block_total())
    summary = summary + " locals=" + word_from_int(v4_mir_snapshot_local_total())
    summary = summary + " statements=" + word_from_int(v4_mir_snapshot_stmt_total())
    summary = summary + " places=" + word_from_int(v4_mir_snapshot_place_total())
    summary = summary + " rvalues=" + word_from_int(v4_mir_snapshot_rvalue_total())
    summary = summary + " diagnostics=" + word_from_int(v4_mir_snapshot_diag_total())
    give back summary
}

task v4_mir_snapshot_header() -> word {
    pilot out = "mir-snapshot"
    out = out + "|format=" + v4_mir_snapshot_format
    out = out + "|files=" + word_from_int(v4_mir_file_count())
    out = out + "|bodies=" + word_from_int(v4_mir_snapshot_body_total())
    out = out + "|blocks=" + word_from_int(v4_mir_snapshot_block_total())
    out = out + "|locals=" + word_from_int(v4_mir_snapshot_local_total())
    out = out + "|statements=" + word_from_int(v4_mir_snapshot_stmt_total())
    out = out + "|places=" + word_from_int(v4_mir_snapshot_place_total())
    out = out + "|rvalues=" + word_from_int(v4_mir_snapshot_rvalue_total())
    out = out + "|diagnostics=" + word_from_int(v4_mir_snapshot_diag_total())
    give back out
}

task v4_mir_snapshot_file_line(mir_id: int) -> word {
    pilot out = "mir"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(v4_mir_file_id(mir_id))
    out = out + "|" + word_from_int(v4_mir_ty_id(mir_id))
    out = out + "|" + word_from_int(v4_mir_body_count(mir_id))
    out = out + "|" + word_from_int(v4_mir_diag_count(mir_id))
    give back out
}

task v4_mir_snapshot_body_line(mir_id: int, body_id: int) -> word {
    pilot out = "mir-body"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(body_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_body_def(mir_id, body_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_body_name(mir_id, body_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_body_signature(mir_id, body_id))
    out = out + "|" + word_from_int(v4_mir_body_block_count(mir_id, body_id))
    out = out + "|" + word_from_int(v4_mir_body_local_count(mir_id, body_id))
    out = out + "|" + word_from_int(v4_mir_body_stmt_count(mir_id, body_id))
    out = out + "|" + word_from_int(v4_mir_body_place_count(mir_id, body_id))
    out = out + "|" + word_from_int(v4_mir_body_rvalue_count(mir_id, body_id))
    give back out
}

task v4_mir_snapshot_block_line(mir_id: int, body_id: int, block_id: int) -> word {
    pilot out = "mir-block"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(body_id)
    out = out + "|" + word_from_int(block_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_body_block(mir_id, body_id, block_id))
    give back out
}

task v4_mir_snapshot_local_line(mir_id: int, body_id: int, local_id: int) -> word {
    pilot out = "mir-local"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(body_id)
    out = out + "|" + word_from_int(local_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_local_name(mir_id, body_id, local_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_local_ty(mir_id, body_id, local_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_local_mode(mir_id, body_id, local_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_local_span(mir_id, body_id, local_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_local_scope_span(mir_id, body_id, local_id))
    give back out
}

task v4_mir_snapshot_stmt_line(mir_id: int, body_id: int, stmt_id: int) -> word {
    pilot out = "mir-stmt"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(body_id)
    out = out + "|" + word_from_int(stmt_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_stmt_kind(mir_id, body_id, stmt_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_stmt_lhs(mir_id, body_id, stmt_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_stmt_rhs(mir_id, body_id, stmt_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_stmt_span(mir_id, body_id, stmt_id))
    out = out + "|" + word_from_int(v4_mir_stmt_block(mir_id, body_id, stmt_id))
    out = out + "|" + word_from_int(v4_mir_stmt_place(mir_id, body_id, stmt_id))
    out = out + "|" + word_from_int(v4_mir_stmt_rvalue(mir_id, body_id, stmt_id))
    give back out
}

task v4_mir_snapshot_place_line(mir_id: int, body_id: int, place_id: int) -> word {
    pilot out = "mir-place"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(body_id)
    out = out + "|" + word_from_int(place_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_place_kind(mir_id, body_id, place_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_place_text(mir_id, body_id, place_id))
    out = out + "|" + word_from_int(v4_mir_place_base(mir_id, body_id, place_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_place_field(mir_id, body_id, place_id))
    out = out + "|" + word_from_int(v4_mir_place_index(mir_id, body_id, place_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_place_span(mir_id, body_id, place_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_place_ty(mir_id, body_id, place_id))
    give back out
}

task v4_mir_snapshot_rvalue_line(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot out = "mir-rvalue"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(body_id)
    out = out + "|" + word_from_int(rvalue_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
    out = out + "|" + word_from_int(v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    out = out + "|" + word_from_int(v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_span(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_abi(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id))
    give back out
}

task v4_mir_snapshot_diag_line(mir_id: int, diag_id: int) -> word {
    pilot out = "mir-diag"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_diag(mir_id, diag_id))
    give back out
}

task v4_mir_snapshot() -> word {
    v4_mir_init()
    pilot parts = array_new()
    array_push(parts, v4_mir_snapshot_header())
    pilot mir_id = 0
    repeat until mir_id >= v4_mir_file_count() {
        array_push(parts, "\n")
        array_push(parts, v4_mir_snapshot_file_line(mir_id))

        pilot body_id = 0
        pilot body_count = v4_mir_body_count(mir_id)
        repeat until body_id >= body_count {
            array_push(parts, "\n")
            array_push(parts, v4_mir_snapshot_body_line(mir_id, body_id))

            pilot block_id = 0
            pilot block_count = v4_mir_body_block_count(mir_id, body_id)
            repeat until block_id >= block_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_block_line(mir_id, body_id, block_id))
                block_id += 1
            }

            pilot local_id = 0
            pilot local_count = v4_mir_body_local_count(mir_id, body_id)
            repeat until local_id >= local_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_local_line(mir_id, body_id, local_id))
                local_id += 1
            }

            pilot stmt_id = 0
            pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
            repeat until stmt_id >= stmt_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_stmt_line(mir_id, body_id, stmt_id))
                stmt_id += 1
            }

            pilot place_id = 0
            pilot place_count = v4_mir_body_place_count(mir_id, body_id)
            repeat until place_id >= place_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_place_line(mir_id, body_id, place_id))
                place_id += 1
            }

            pilot rvalue_id = 0
            pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
            repeat until rvalue_id >= rvalue_count {
                array_push(parts, "\n")
                array_push(parts, v4_mir_snapshot_rvalue_line(mir_id, body_id, rvalue_id))
                rvalue_id += 1
            }
            body_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_mir_diag_count(mir_id)
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_mir_snapshot_diag_line(mir_id, diag_id))
            diag_id += 1
        }
        mir_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_mir_snapshot_format)
    give back word_join(parts)
}

task v4_mir_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "mir-snapshot" { give back 10 }
    if kind == "mir" { give back 6 }
    if kind == "mir-body" { give back 11 }
    if kind == "mir-block" { give back 5 }
    if kind == "mir-local" { give back 9 }
    if kind == "mir-stmt" { give back 11 }
    if kind == "mir-place" { give back 11 }
    if kind == "mir-rvalue" { give back 14 }
    if kind == "mir-diag" { give back 4 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_mir_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_mir_snapshot_field_raw(line, 0)
    pilot expected = v4_mir_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_mir_snapshot_field_count(line) != expected {
        give back false
    }
    give back true
}

task v4_mir_snapshot_nonnegative_int_is_valid(raw: word) -> bool {
    if raw == "" { give back false }
    pilot value = word_to_int(raw)
    if value < 0 { give back false }
    give back word_from_int(value) == raw
}

task v4_mir_snapshot_signed_int_is_valid(raw: word) -> bool {
    if raw == "" { give back false }
    pilot value = word_to_int(raw)
    give back word_from_int(value) == raw
}

task v4_mir_snapshot_ref_is_valid(raw: word, upper_bound: int, allow_missing: bool) -> bool {
    if not v4_mir_snapshot_signed_int_is_valid(raw) { give back false }
    pilot value = word_to_int(raw)
    if value == 0 - 1 { give back allow_missing }
    if value < 0 or value >= upper_bound { give back false }
    give back true
}

task v4_mir_snapshot_prior_rvalue_ref_is_valid(raw: word, parent_id: int, allow_missing: bool) -> bool {
    give back v4_mir_snapshot_ref_is_valid(raw, parent_id, allow_missing)
}

task v4_mir_snapshot_comma_part(payload: word, wanted: int) -> word {
    if payload == "" or wanted < 0 { give back "" }
    pilot part = 0
    pilot start_pos = 0
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            if part == wanted {
                give back v4_slice(payload, start_pos, idx)
            }
            part += 1
            start_pos = idx + 1
        }
        idx += 1
    }
    if part == wanted {
        give back v4_slice(payload, start_pos, payload.length())
    }
    give back ""
}

task v4_mir_snapshot_rvalue_payload_is_valid(payload: word, parent_id: int) -> bool {
    if payload == "" { give back true }
    pilot child_count = v4_mir_call_args_payload_count(payload)
    pilot child_id = 0
    repeat until child_id >= child_count {
        pilot raw_child = v4_mir_snapshot_comma_part(payload, child_id)
        if not v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_child, parent_id, false) {
            give back false
        }
        child_id += 1
    }
    give back true
}

task v4_mir_snapshot_terminator_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_term_return or kind == v4_mir_term_unreachable or kind == v4_mir_term_goto or kind == v4_mir_term_if
}

task v4_mir_snapshot_stmt_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_stmt_local or kind == v4_mir_stmt_assign or kind == v4_mir_stmt_return or kind == v4_mir_stmt_expr or kind == v4_mir_stmt_branch or kind == v4_mir_stmt_loop or kind == v4_mir_stmt_break or kind == v4_mir_stmt_continue
}

task v4_mir_snapshot_place_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_place_local or kind == v4_mir_place_field or kind == v4_mir_place_index or kind == v4_mir_place_deref or kind == v4_mir_place_return or kind == v4_mir_place_unknown
}

task v4_mir_snapshot_rvalue_kind_is_known(kind: word) -> bool {
    give back kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float or kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_const_bool or kind == v4_mir_rvalue_const_char or kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place or kind == v4_mir_rvalue_use_symbol or kind == v4_mir_rvalue_construct or kind == v4_mir_rvalue_array or kind == v4_mir_rvalue_list or kind == v4_mir_rvalue_tuple or kind == v4_mir_rvalue_map or kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_call or kind == v4_mir_rvalue_loop_item or kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_or_else or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut or kind == v4_mir_rvalue_closure or kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut or kind == v4_mir_rvalue_capture_copy or kind == v4_mir_rvalue_capture_move or kind == v4_mir_rvalue_unknown
}

task v4_mir_snapshot_block_record_is_valid(block_record: word, block_id: int, block_count: int) -> bool {
    pilot raw_id = v4_mir_block_part(block_record, 0)
    pilot terminator = v4_mir_block_part(block_record, 1)
    pilot raw_target = v4_mir_block_part(block_record, 2)
    pilot raw_else_target = v4_mir_block_part(block_record, 3)
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw_id) or word_to_int(raw_id) != block_id {
        give back false
    }
    if not v4_mir_snapshot_terminator_kind_is_known(terminator) { give back false }
    if terminator == v4_mir_term_goto {
        give back v4_mir_snapshot_ref_is_valid(raw_target, block_count, false) and raw_else_target == "-1"
    }
    if terminator == v4_mir_term_if {
        give back v4_mir_snapshot_ref_is_valid(raw_target, block_count, false) and v4_mir_snapshot_ref_is_valid(raw_else_target, block_count, false)
    }
    give back raw_target == "-1" and raw_else_target == "-1"
}

task v4_mir_snapshot_place_refs_are_valid(kind: word, raw_base: word, raw_index: word, place_id: int, local_count: int, rvalue_count: int) -> bool {
    if not v4_mir_snapshot_place_kind_is_known(kind) { give back false }
    if kind == v4_mir_place_local {
        give back v4_mir_snapshot_ref_is_valid(raw_base, local_count, true) and raw_index == "-1"
    }
    if kind == v4_mir_place_field {
        give back v4_mir_snapshot_ref_is_valid(raw_base, place_id, false) and raw_index == "-1"
    }
    if kind == v4_mir_place_index {
        give back v4_mir_snapshot_ref_is_valid(raw_base, place_id, false) and v4_mir_snapshot_ref_is_valid(raw_index, rvalue_count, false)
    }
    if kind == v4_mir_place_deref {
        give back raw_base == "-1" and v4_mir_snapshot_ref_is_valid(raw_index, rvalue_count, false)
    }
    give back raw_base == "-1" and raw_index == "-1"
}

task v4_mir_snapshot_rvalue_refs_are_valid(kind: word, raw_lhs: word, raw_rhs: word, args_payload: word, rvalue_id: int, place_count: int) -> bool {
    if not v4_mir_snapshot_rvalue_kind_is_known(kind) { give back false }

    if kind == v4_mir_rvalue_use_place {
        give back v4_mir_snapshot_ref_is_valid(raw_lhs, place_count, false) and raw_rhs == "-1" and args_payload == ""
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        give back raw_lhs == "-1" and raw_rhs == "-1" and v4_mir_snapshot_rvalue_payload_is_valid(args_payload, rvalue_id)
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, false) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, false) and args_payload == ""
    }
    if kind == v4_mir_rvalue_unary {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, false) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, true) and args_payload == ""
    }
    if kind == v4_mir_rvalue_call {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, true) and v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_rhs, rvalue_id, true) and v4_mir_snapshot_rvalue_payload_is_valid(args_payload, rvalue_id)
    }
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_mir_snapshot_prior_rvalue_ref_is_valid(raw_lhs, rvalue_id, false) and raw_rhs == "-1" and args_payload == ""
    }
    give back raw_lhs == "-1" and raw_rhs == "-1" and args_payload == ""
}

task v4_mir_snapshot_graph_ref_is_done(states: int, offset: int, raw_ref: word, allow_negative: bool) -> bool {
    if raw_ref == "-1" { give back allow_negative }
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw_ref) { give back false }
    pilot node_id = offset + word_to_int(raw_ref)
    if node_id < 0 or node_id >= array_len(states) { give back false }
    pilot state: word = array_get(states, node_id)
    give back state == "1"
}

task v4_mir_snapshot_graph_payload_is_done(states: int, offset: int, payload: word) -> bool {
    if payload == "" { give back true }
    pilot child_id = 0
    pilot child_count = v4_mir_call_args_payload_count(payload)
    repeat until child_id >= child_count {
        if not v4_mir_snapshot_graph_ref_is_done(states, offset, v4_mir_snapshot_comma_part(payload, child_id), false) {
            give back false
        }
        child_id += 1
    }
    give back true
}

task v4_mir_snapshot_graph_place_is_ready(place_id: int, place_count: int, states: int, kinds: int, bases: int, indexes: int) -> bool {
    pilot kind: word = array_get(kinds, place_id)
    pilot raw_base: word = array_get(bases, place_id)
    pilot raw_index: word = array_get(indexes, place_id)
    if kind == v4_mir_place_field {
        give back v4_mir_snapshot_graph_ref_is_done(states, 0, raw_base, false)
    }
    if kind == v4_mir_place_index {
        give back v4_mir_snapshot_graph_ref_is_done(states, 0, raw_base, false) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_index, false)
    }
    if kind == v4_mir_place_deref {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_index, false)
    }
    give back true
}

task v4_mir_snapshot_graph_rvalue_is_ready(rvalue_id: int, place_count: int, states: int, kinds: int, lhs_refs: int, rhs_refs: int, args_payloads: int) -> bool {
    pilot kind: word = array_get(kinds, rvalue_id)
    pilot raw_lhs: word = array_get(lhs_refs, rvalue_id)
    pilot raw_rhs: word = array_get(rhs_refs, rvalue_id)
    pilot args_payload: word = array_get(args_payloads, rvalue_id)
    if kind == v4_mir_rvalue_use_place {
        give back v4_mir_snapshot_graph_ref_is_done(states, 0, raw_lhs, false)
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        give back v4_mir_snapshot_graph_payload_is_done(states, place_count, args_payload)
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, false) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, false)
    }
    if kind == v4_mir_rvalue_unary {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, false) and v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, true)
    }
    if kind == v4_mir_rvalue_call {
        if not v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, true) { give back false }
        if not v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_rhs, true) { give back false }
        give back v4_mir_snapshot_graph_payload_is_done(states, place_count, args_payload)
    }
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_mir_snapshot_graph_ref_is_done(states, place_count, raw_lhs, false)
    }
    give back true
}

task v4_mir_snapshot_body_graph_is_acyclic(place_kinds: int, place_bases: int, place_indexes: int, rvalue_kinds: int, rvalue_lhs: int, rvalue_rhs: int, rvalue_args: int) -> bool {
    pilot place_count = array_len(place_kinds)
    pilot rvalue_count = array_len(rvalue_kinds)
    if array_len(place_bases) != place_count or array_len(place_indexes) != place_count { give back false }
    if array_len(rvalue_lhs) != rvalue_count or array_len(rvalue_rhs) != rvalue_count or array_len(rvalue_args) != rvalue_count { give back false }

    pilot states = array_new()
    pilot total = place_count + rvalue_count
    pilot node_id = 0
    repeat until node_id >= total {
        array_push(states, "0")
        node_id += 1
    }

    pilot processed = 0
    repeat until processed >= total {
        pilot progress = 0
        pilot place_id = 0
        repeat until place_id >= place_count {
            pilot place_state: word = array_get(states, place_id)
            if place_state == "0" {
                if v4_mir_snapshot_graph_place_is_ready(place_id, place_count, states, place_kinds, place_bases, place_indexes) {
                    array_set(states, place_id, "1")
                    processed += 1
                    progress += 1
                }
            }
            place_id += 1
        }

        pilot rvalue_id = 0
        repeat until rvalue_id >= rvalue_count {
            pilot rvalue_node = place_count + rvalue_id
            pilot rvalue_state: word = array_get(states, rvalue_node)
            if rvalue_state == "0" {
                if v4_mir_snapshot_graph_rvalue_is_ready(rvalue_id, place_count, states, rvalue_kinds, rvalue_lhs, rvalue_rhs, rvalue_args) {
                    array_set(states, rvalue_node, "1")
                    processed += 1
                    progress += 1
                }
            }
            rvalue_id += 1
        }
        if progress == 0 {
            array_release(states)
            give back false
        }
    }
    array_release(states)
    give back true
}

task v4_mir_snapshot_release_body_graph_arrays(place_kinds: int, place_bases: int, place_indexes: int, rvalue_kinds: int, rvalue_lhs: int, rvalue_rhs: int, rvalue_args: int) -> void {
    array_release(rvalue_args)
    array_release(rvalue_rhs)
    array_release(rvalue_lhs)
    array_release(rvalue_kinds)
    array_release(place_indexes)
    array_release(place_bases)
    array_release(place_kinds)
}

task v4_mir_snapshot_validate(payload: word) -> word {
    pilot lines = v4_mir_snapshot_line_count(payload)
    pilot files = 0
    pilot bodies = 0
    pilot blocks = 0
    pilot locals = 0
    pilot statements = 0
    pilot places = 0
    pilot rvalues = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_files = 0 - 1
    pilot declared_bodies = 0 - 1
    pilot declared_blocks = 0 - 1
    pilot declared_locals = 0 - 1
    pilot declared_statements = 0 - 1
    pilot declared_places = 0 - 1
    pilot declared_rvalues = 0 - 1
    pilot declared_diagnostics = 0 - 1

    pilot current_mir = 0 - 1
    pilot current_body = 0 - 1
    pilot file_declared_bodies = 0
    pilot file_declared_diagnostics = 0
    pilot file_bodies = 0
    pilot file_diagnostics = 0
    pilot file_phase = 0
    pilot body_declared_blocks = 0
    pilot body_declared_locals = 0
    pilot body_declared_statements = 0
    pilot body_declared_places = 0
    pilot body_declared_rvalues = 0
    pilot body_blocks = 0
    pilot body_locals = 0
    pilot body_statements = 0
    pilot body_places = 0
    pilot body_rvalues = 0
    pilot body_phase = 0
    pilot body_graph_place_kinds = array_new()
    pilot body_graph_place_bases = array_new()
    pilot body_graph_place_indexes = array_new()
    pilot body_graph_rvalue_kinds = array_new()
    pilot body_graph_rvalue_lhs = array_new()
    pilot body_graph_rvalue_rhs = array_new()
    pilot body_graph_rvalue_args = array_new()

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_mir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_mir_snapshot_field_raw(line, 0)
            if saw_end > 0 {
                malformed += 1
            } else if v4_mir_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "mir-snapshot" {
                saw_header += 1
                format = v4_mir_snapshot_key_value(line, "format")
                if line_id != 0 { malformed += 1 }
                if format != v4_mir_snapshot_format { malformed += 1 }

                pilot raw_files = v4_mir_snapshot_key_value(line, "files")
                pilot raw_bodies = v4_mir_snapshot_key_value(line, "bodies")
                pilot raw_blocks = v4_mir_snapshot_key_value(line, "blocks")
                pilot raw_locals = v4_mir_snapshot_key_value(line, "locals")
                pilot raw_statements = v4_mir_snapshot_key_value(line, "statements")
                pilot raw_places = v4_mir_snapshot_key_value(line, "places")
                pilot raw_rvalues = v4_mir_snapshot_key_value(line, "rvalues")
                pilot raw_diagnostics = v4_mir_snapshot_key_value(line, "diagnostics")
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_files) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_bodies) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_blocks) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_locals) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_statements) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_places) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_rvalues) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_diagnostics) { malformed += 1 }
                declared_files = word_to_int(raw_files)
                declared_bodies = word_to_int(raw_bodies)
                declared_blocks = word_to_int(raw_blocks)
                declared_locals = word_to_int(raw_locals)
                declared_statements = word_to_int(raw_statements)
                declared_places = word_to_int(raw_places)
                declared_rvalues = word_to_int(raw_rvalues)
                declared_diagnostics = word_to_int(raw_diagnostics)
            } else if kind == "mir" {
                if saw_header != 1 { malformed += 1 }
                if current_body >= 0 {
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                    current_body = 0 - 1
                }
                if current_mir >= 0 {
                    if file_bodies != file_declared_bodies { malformed += 1 }
                    if file_diagnostics != file_declared_diagnostics { malformed += 1 }
                }

                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_file_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_ty_id = v4_mir_snapshot_field_raw(line, 3)
                pilot raw_body_count = v4_mir_snapshot_field_raw(line, 4)
                pilot raw_diag_count = v4_mir_snapshot_field_raw(line, 5)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_file_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_ty_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_diag_count) { malformed += 1 }
                if word_to_int(raw_mir_id) != files { malformed += 1 }

                current_mir = word_to_int(raw_mir_id)
                file_declared_bodies = word_to_int(raw_body_count)
                file_declared_diagnostics = word_to_int(raw_diag_count)
                file_bodies = 0
                file_diagnostics = 0
                file_phase = 0
                files += 1
            } else if kind == "mir-body" {
                if current_body >= 0 {
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                }

                v4_mir_snapshot_release_body_graph_arrays(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args)

                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_block_count = v4_mir_snapshot_field_raw(line, 6)
                pilot raw_local_count = v4_mir_snapshot_field_raw(line, 7)
                pilot raw_stmt_count = v4_mir_snapshot_field_raw(line, 8)
                pilot raw_place_count = v4_mir_snapshot_field_raw(line, 9)
                pilot raw_rvalue_count = v4_mir_snapshot_field_raw(line, 10)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_block_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_local_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_stmt_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_place_count) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_rvalue_count) { malformed += 1 }
                if current_mir < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != file_bodies { malformed += 1 }
                if file_phase != 0 { malformed += 1 }

                current_body = word_to_int(raw_body_id)
                body_declared_blocks = word_to_int(raw_block_count)
                body_declared_locals = word_to_int(raw_local_count)
                body_declared_statements = word_to_int(raw_stmt_count)
                body_declared_places = word_to_int(raw_place_count)
                body_declared_rvalues = word_to_int(raw_rvalue_count)
                body_blocks = 0
                body_locals = 0
                body_statements = 0
                body_places = 0
                body_rvalues = 0
                body_phase = 0
                body_graph_place_kinds = array_new()
                body_graph_place_bases = array_new()
                body_graph_place_indexes = array_new()
                body_graph_rvalue_kinds = array_new()
                body_graph_rvalue_lhs = array_new()
                body_graph_rvalue_rhs = array_new()
                body_graph_rvalue_args = array_new()
                file_bodies += 1
                bodies += 1
            } else if kind == "mir-block" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_blocks { malformed += 1 }
                if body_phase > 1 { malformed += 1 }
                pilot block_record = v4_mir_snapshot_field(line, 4)
                if not v4_mir_snapshot_block_record_is_valid(block_record, word_to_int(raw_child_id), body_declared_blocks) { malformed += 1 }
                body_phase = 1
                body_blocks += 1
                blocks += 1
            } else if kind == "mir-local" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_locals { malformed += 1 }
                if body_phase > 2 { malformed += 1 }
                body_phase = 2
                body_locals += 1
                locals += 1
            } else if kind == "mir-stmt" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_statements { malformed += 1 }
                if body_phase > 3 { malformed += 1 }
                pilot stmt_kind = v4_mir_snapshot_field(line, 4)
                pilot raw_stmt_block = v4_mir_snapshot_field_raw(line, 8)
                pilot raw_stmt_place = v4_mir_snapshot_field_raw(line, 9)
                pilot raw_stmt_rvalue = v4_mir_snapshot_field_raw(line, 10)
                if not v4_mir_snapshot_stmt_kind_is_known(stmt_kind) { malformed += 1 }
                if not v4_mir_snapshot_ref_is_valid(raw_stmt_block, body_declared_blocks, false) { malformed += 1 }
                if not v4_mir_snapshot_ref_is_valid(raw_stmt_place, body_declared_places, true) { malformed += 1 }
                if not v4_mir_snapshot_ref_is_valid(raw_stmt_rvalue, body_declared_rvalues, true) { malformed += 1 }
                body_phase = 3
                body_statements += 1
                statements += 1
            } else if kind == "mir-place" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_places { malformed += 1 }
                if body_phase > 4 { malformed += 1 }
                pilot place_kind = v4_mir_snapshot_field(line, 4)
                pilot raw_place_base = v4_mir_snapshot_field_raw(line, 6)
                pilot raw_place_index = v4_mir_snapshot_field_raw(line, 8)
                if not v4_mir_snapshot_place_refs_are_valid(place_kind, raw_place_base, raw_place_index, word_to_int(raw_child_id), body_declared_locals, body_declared_rvalues) { malformed += 1 }
                array_push(body_graph_place_kinds, place_kind)
                array_push(body_graph_place_bases, raw_place_base)
                array_push(body_graph_place_indexes, raw_place_index)
                body_phase = 4
                body_places += 1
                places += 1
            } else if kind == "mir-rvalue" {
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_body_id = v4_mir_snapshot_field_raw(line, 2)
                pilot raw_child_id = v4_mir_snapshot_field_raw(line, 3)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_body_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_child_id) { malformed += 1 }
                if current_mir < 0 or current_body < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_body_id) != current_body { malformed += 1 }
                if word_to_int(raw_child_id) != body_rvalues { malformed += 1 }
                pilot rvalue_kind = v4_mir_snapshot_field(line, 4)
                pilot raw_lhs = v4_mir_snapshot_field_raw(line, 7)
                pilot raw_rhs = v4_mir_snapshot_field_raw(line, 8)
                pilot args_payload = v4_mir_snapshot_field(line, 12)
                if not v4_mir_snapshot_rvalue_refs_are_valid(rvalue_kind, raw_lhs, raw_rhs, args_payload, word_to_int(raw_child_id), body_declared_places) { malformed += 1 }
                array_push(body_graph_rvalue_kinds, rvalue_kind)
                array_push(body_graph_rvalue_lhs, raw_lhs)
                array_push(body_graph_rvalue_rhs, raw_rhs)
                array_push(body_graph_rvalue_args, args_payload)
                pilot builtin_method = v4_mir_snapshot_field(line, 13)
                if builtin_method != "" and not v4_mir_builtin_shared_method_identity_is_known(builtin_method) {
                    malformed += 1
                }
                if builtin_method != "" and rvalue_kind != v4_mir_rvalue_call { malformed += 1 }
                body_phase = 5
                body_rvalues += 1
                rvalues += 1
            } else if kind == "mir-diag" {
                if current_body >= 0 {
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                    current_body = 0 - 1
                }
                pilot raw_mir_id = v4_mir_snapshot_field_raw(line, 1)
                pilot raw_diag_id = v4_mir_snapshot_field_raw(line, 2)
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_mir_id) { malformed += 1 }
                if not v4_mir_snapshot_nonnegative_int_is_valid(raw_diag_id) { malformed += 1 }
                if current_mir < 0 { malformed += 1 }
                if word_to_int(raw_mir_id) != current_mir { malformed += 1 }
                if word_to_int(raw_diag_id) != file_diagnostics { malformed += 1 }
                file_phase = 1
                file_diagnostics += 1
                diagnostics += 1
            } else if kind == "end" {
                if current_body >= 0 {
                    if body_blocks != body_declared_blocks { malformed += 1 }
                    if body_locals != body_declared_locals { malformed += 1 }
                    if body_statements != body_declared_statements { malformed += 1 }
                    if body_places != body_declared_places { malformed += 1 }
                    if body_rvalues != body_declared_rvalues { malformed += 1 }
                    if not v4_mir_snapshot_body_graph_is_acyclic(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args) { malformed += 1 }
                    current_body = 0 - 1
                }
                if current_mir >= 0 {
                    if file_bodies != file_declared_bodies { malformed += 1 }
                    if file_diagnostics != file_declared_diagnostics { malformed += 1 }
                    current_mir = 0 - 1
                }
                saw_end += 1
                if v4_mir_snapshot_field(line, 1) != v4_mir_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    v4_mir_snapshot_release_body_graph_arrays(body_graph_place_kinds, body_graph_place_bases, body_graph_place_indexes, body_graph_rvalue_kinds, body_graph_rvalue_lhs, body_graph_rvalue_rhs, body_graph_rvalue_args)

    if files != declared_files { malformed += 1 }
    if bodies != declared_bodies { malformed += 1 }
    if blocks != declared_blocks { malformed += 1 }
    if locals != declared_locals { malformed += 1 }
    if statements != declared_statements { malformed += 1 }
    if places != declared_places { malformed += 1 }
    if rvalues != declared_rvalues { malformed += 1 }
    if diagnostics != declared_diagnostics { malformed += 1 }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "mir-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " bodies=" + word_from_int(bodies)
    out = out + " blocks=" + word_from_int(blocks)
    out = out + " locals=" + word_from_int(locals)
    out = out + " statements=" + word_from_int(statements)
    out = out + " places=" + word_from_int(places)
    out = out + " rvalues=" + word_from_int(rvalues)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_mir_restore_file_slot(mir_id: int, file_id: int, ty_id: int) -> int {
    if mir_id < 0 or file_id < 0 or ty_id < 0 { give back 0 }
    v4_mir_init()
    repeat until array_len(v4_mir_files) > mir_id {
        v4_mir_file_new(0, 0)
    }

    array_set(v4_mir_files, mir_id, word_from_int(file_id))
    array_set(v4_mir_tys, mir_id, word_from_int(ty_id))
    array_set(v4_mir_body_defs, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_names, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_sigs, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_blocks, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_local_names, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_local_tys, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_local_modes, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_local_spans, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_local_scope_spans, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_kinds, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_lhs, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_rhs, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_spans, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_blocks, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_places, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_stmt_rvalues, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_kinds, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_texts, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_bases, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_fields, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_indices, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_spans, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_place_tys, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_kinds, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_texts, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_ops, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_lhs, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_rhs, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_spans, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_tys, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_abis, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_args, mir_id, word_from_int(array_new()))
    array_set(v4_mir_body_rvalue_builtin_methods, mir_id, word_from_int(array_new()))
    array_set(v4_mir_diags, mir_id, word_from_int(array_new()))
    give back 1
}

task v4_mir_restore_body_slot(mir_id: int, body_id: int, def_id: word, body_name: word, signature: word) -> int {
    if mir_id < 0 or body_id < 0 { give back 0 }
    if v4_mir_file_exists(mir_id) == false {
        give back 0
    }
    repeat until v4_mir_body_count(mir_id) > body_id {
        v4_mir_add_body(mir_id, "", "", "")
    }

    array_set(v4_mir_defs_handle(mir_id), body_id, def_id)
    array_set(v4_mir_names_handle(mir_id), body_id, body_name)
    array_set(v4_mir_sigs_handle(mir_id), body_id, signature)
    array_set(v4_mir_blocks_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_local_names_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_local_tys_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_local_modes_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_local_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_local_scope_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_kinds_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_lhs_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_rhs_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_blocks_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_places_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_stmt_rvalues_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_kinds_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_texts_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_bases_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_fields_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_indices_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_place_tys_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_kinds_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_texts_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_ops_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_lhs_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_rhs_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_spans_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_tys_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_abis_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_args_index_handle(mir_id), body_id, word_from_int(array_new()))
    array_set(v4_mir_rvalue_builtin_methods_index_handle(mir_id), body_id, word_from_int(array_new()))
    give back 1
}

task v4_mir_body_slot_exists(mir_id: int, body_id: int) -> bool {
    if v4_mir_file_exists(mir_id) == false { give back false }
    if body_id < 0 { give back false }
    if body_id >= v4_mir_body_count(mir_id) { give back false }
    give back true
}

task v4_mir_restore_block_slot(mir_id: int, body_id: int, block_id: int, block_record: word) -> int {
    if block_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    repeat until v4_mir_body_block_count(mir_id, body_id) > block_id {
        pilot next_block = v4_mir_body_block_count(mir_id, body_id)
        array_push(v4_mir_body_blocks_handle(mir_id, body_id), v4_mir_block_new(next_block, v4_mir_term_unreachable, 0 - 1))
    }
    array_set(v4_mir_body_blocks_handle(mir_id, body_id), block_id, block_record)
    give back 1
}

task v4_mir_restore_local_slot(mir_id: int, body_id: int, local_id: int, local_name: word, local_ty: word, local_mode: word, span: word, scope_span: word) -> int {
    if local_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    if local_mode == "" {
        local_mode = v4_ty_param_mode_value
    }
    repeat until v4_mir_body_local_count(mir_id, body_id) > local_id {
        array_push(v4_mir_body_local_names_handle(mir_id, body_id), "")
        array_push(v4_mir_body_local_tys_handle(mir_id, body_id), v4_ty_unknown)
        array_push(v4_mir_body_local_modes_handle(mir_id, body_id), v4_ty_param_mode_value)
        array_push(v4_mir_body_local_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_local_scope_spans_handle(mir_id, body_id), V4_NO_SPAN)
    }
    array_set(v4_mir_body_local_names_handle(mir_id, body_id), local_id, local_name)
    array_set(v4_mir_body_local_tys_handle(mir_id, body_id), local_id, local_ty)
    array_set(v4_mir_body_local_modes_handle(mir_id, body_id), local_id, local_mode)
    array_set(v4_mir_body_local_spans_handle(mir_id, body_id), local_id, span)
    array_set(v4_mir_body_local_scope_spans_handle(mir_id, body_id), local_id, scope_span)
    give back 1
}

task v4_mir_restore_stmt_slot(mir_id: int, body_id: int, stmt_id: int, stmt_kind: word, lhs: word, rhs: word, span: word, block_id: int, place_id: int, rvalue_id: int) -> int {
    if stmt_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    repeat until v4_mir_body_stmt_count(mir_id, body_id) > stmt_id {
        array_push(v4_mir_body_stmt_kinds_handle(mir_id, body_id), "")
        array_push(v4_mir_body_stmt_lhs_handle(mir_id, body_id), "")
        array_push(v4_mir_body_stmt_rhs_handle(mir_id, body_id), "")
        array_push(v4_mir_body_stmt_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_stmt_blocks_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_stmt_places_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), word_from_int(0 - 1))
    }
    array_set(v4_mir_body_stmt_kinds_handle(mir_id, body_id), stmt_id, stmt_kind)
    array_set(v4_mir_body_stmt_lhs_handle(mir_id, body_id), stmt_id, lhs)
    array_set(v4_mir_body_stmt_rhs_handle(mir_id, body_id), stmt_id, rhs)
    array_set(v4_mir_body_stmt_spans_handle(mir_id, body_id), stmt_id, span)
    array_set(v4_mir_body_stmt_blocks_handle(mir_id, body_id), stmt_id, word_from_int(block_id))
    array_set(v4_mir_body_stmt_places_handle(mir_id, body_id), stmt_id, word_from_int(place_id))
    array_set(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), stmt_id, word_from_int(rvalue_id))
    give back 1
}

task v4_mir_restore_place_slot(mir_id: int, body_id: int, place_id: int, place_kind: word, text: word, base: int, field: word, index_id: int, span: word, place_ty: word) -> int {
    if place_id < 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    repeat until v4_mir_body_place_count(mir_id, body_id) > place_id {
        array_push(v4_mir_body_place_kinds_handle(mir_id, body_id), v4_mir_place_unknown)
        array_push(v4_mir_body_place_texts_handle(mir_id, body_id), "")
        array_push(v4_mir_body_place_bases_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_place_fields_handle(mir_id, body_id), "")
        array_push(v4_mir_body_place_indices_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_place_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_place_tys_handle(mir_id, body_id), v4_ty_unknown)
    }
    array_set(v4_mir_body_place_kinds_handle(mir_id, body_id), place_id, place_kind)
    array_set(v4_mir_body_place_texts_handle(mir_id, body_id), place_id, text)
    array_set(v4_mir_body_place_bases_handle(mir_id, body_id), place_id, word_from_int(base))
    array_set(v4_mir_body_place_fields_handle(mir_id, body_id), place_id, field)
    array_set(v4_mir_body_place_indices_handle(mir_id, body_id), place_id, word_from_int(index_id))
    array_set(v4_mir_body_place_spans_handle(mir_id, body_id), place_id, span)
    array_set(v4_mir_body_place_tys_handle(mir_id, body_id), place_id, place_ty)
    give back 1
}

task v4_mir_restore_rvalue_slot(mir_id: int, body_id: int, rvalue_id: int, rvalue_kind: word, text: word, op: word, lhs: int, rhs: int, span: word, rvalue_ty: word, rvalue_abi: word, rvalue_args: word, builtin_method: word) -> int {
    if rvalue_id < 0 { give back 0 }
    pilot builtin_method_code = v4_mir_builtin_shared_method_identity_code(builtin_method)
    if builtin_method != "" and builtin_method_code == 0 { give back 0 }
    if v4_mir_body_slot_exists(mir_id, body_id) == false {
        give back 0
    }
    repeat until v4_mir_body_rvalue_count(mir_id, body_id) > rvalue_id {
        array_push(v4_mir_body_rvalue_kinds_handle(mir_id, body_id), v4_mir_rvalue_unknown)
        array_push(v4_mir_body_rvalue_texts_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_ops_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), word_from_int(0 - 1))
        array_push(v4_mir_body_rvalue_spans_handle(mir_id, body_id), V4_NO_SPAN)
        array_push(v4_mir_body_rvalue_tys_handle(mir_id, body_id), v4_ty_unknown)
        array_push(v4_mir_body_rvalue_abis_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_args_handle(mir_id, body_id), "")
        array_push(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), "")
    }
    pilot builtin_methods_handle = v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id)
    if builtin_method_code == 1 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_new)
    } else if builtin_method_code == 2 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_clone)
    } else if builtin_method_code == 3 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_downgrade)
    } else if builtin_method_code == 4 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_borrow)
    } else if builtin_method_code == 5 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_borrow_mut)
    } else if builtin_method_code == 6 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_shared_get_mut)
    } else if builtin_method_code == 7 {
        array_set(builtin_methods_handle, rvalue_id, v4_mir_builtin_weak_upgrade)
    } else {
        array_set(builtin_methods_handle, rvalue_id, "")
    }
    array_set(v4_mir_body_rvalue_kinds_handle(mir_id, body_id), rvalue_id, rvalue_kind)
    array_set(v4_mir_body_rvalue_texts_handle(mir_id, body_id), rvalue_id, text)
    array_set(v4_mir_body_rvalue_ops_handle(mir_id, body_id), rvalue_id, op)
    array_set(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), rvalue_id, word_from_int(lhs))
    array_set(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), rvalue_id, word_from_int(rhs))
    array_set(v4_mir_body_rvalue_spans_handle(mir_id, body_id), rvalue_id, span)
    array_set(v4_mir_body_rvalue_tys_handle(mir_id, body_id), rvalue_id, rvalue_ty)
    array_set(v4_mir_body_rvalue_abis_handle(mir_id, body_id), rvalue_id, rvalue_abi)
    array_set(v4_mir_body_rvalue_args_handle(mir_id, body_id), rvalue_id, rvalue_args)
    give back 1
}

task v4_mir_restore_diag_slot(mir_id: int, diag_id: int, diag: word) -> int {
    if mir_id < 0 or diag_id < 0 { give back 0 }
    if v4_mir_file_exists(mir_id) == false {
        give back 0
    }
    repeat until v4_mir_diag_count(mir_id) > diag_id {
        array_push(v4_mir_diags_handle(mir_id), "")
    }
    array_set(v4_mir_diags_handle(mir_id), diag_id, diag)
    give back 1
}

task v4_mir_snapshot_restore_file_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot ty_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    give back v4_mir_restore_file_slot(mir_id, file_id, ty_id)
}

task v4_mir_snapshot_restore_body_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-body" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot def_id = v4_mir_snapshot_field(line, 3)
    pilot body_name = v4_mir_snapshot_field(line, 4)
    pilot signature = v4_mir_snapshot_field(line, 5)
    give back v4_mir_restore_body_slot(mir_id, body_id, def_id, body_name, signature)
}

task v4_mir_snapshot_restore_block_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-block" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot block_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot block_record = v4_mir_snapshot_field(line, 4)
    give back v4_mir_restore_block_slot(mir_id, body_id, block_id, block_record)
}

task v4_mir_snapshot_restore_local_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-local" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot local_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    give back v4_mir_restore_local_slot(mir_id, body_id, local_id, v4_mir_snapshot_field(line, 4), v4_mir_snapshot_field(line, 5), v4_mir_snapshot_field(line, 6), v4_mir_snapshot_field(line, 7), v4_mir_snapshot_field(line, 8))
}

task v4_mir_snapshot_restore_stmt_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-stmt" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot stmt_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot stmt_kind = v4_mir_snapshot_field(line, 4)
    pilot lhs = v4_mir_snapshot_field(line, 5)
    pilot rhs = v4_mir_snapshot_field(line, 6)
    pilot span = v4_mir_snapshot_field(line, 7)
    pilot block_id = word_to_int(v4_mir_snapshot_field_raw(line, 8))
    pilot place_id = word_to_int(v4_mir_snapshot_field_raw(line, 9))
    pilot rvalue_id = word_to_int(v4_mir_snapshot_field_raw(line, 10))
    give back v4_mir_restore_stmt_slot(mir_id, body_id, stmt_id, stmt_kind, lhs, rhs, span, block_id, place_id, rvalue_id)
}

task v4_mir_snapshot_restore_place_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-place" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot place_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot place_kind = v4_mir_snapshot_field(line, 4)
    pilot text = v4_mir_snapshot_field(line, 5)
    pilot base = word_to_int(v4_mir_snapshot_field_raw(line, 6))
    pilot field = v4_mir_snapshot_field(line, 7)
    pilot index_id = word_to_int(v4_mir_snapshot_field_raw(line, 8))
    pilot span = v4_mir_snapshot_field(line, 9)
    pilot place_ty = v4_mir_snapshot_field(line, 10)
    give back v4_mir_restore_place_slot(mir_id, body_id, place_id, place_kind, text, base, field, index_id, span, place_ty)
}

task v4_mir_snapshot_restore_rvalue_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-rvalue" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot body_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot rvalue_id = word_to_int(v4_mir_snapshot_field_raw(line, 3))
    pilot rvalue_kind = v4_mir_snapshot_field(line, 4)
    pilot text = v4_mir_snapshot_field(line, 5)
    pilot op = v4_mir_snapshot_field(line, 6)
    pilot lhs = word_to_int(v4_mir_snapshot_field_raw(line, 7))
    pilot rhs = word_to_int(v4_mir_snapshot_field_raw(line, 8))
    pilot span = v4_mir_snapshot_field(line, 9)
    pilot rvalue_ty = v4_mir_snapshot_field(line, 10)
    pilot rvalue_abi = v4_mir_snapshot_field(line, 11)
    pilot rvalue_args = v4_mir_snapshot_field(line, 12)
    pilot builtin_method = v4_mir_snapshot_field(line, 13)
    give back v4_mir_restore_rvalue_slot(mir_id, body_id, rvalue_id, rvalue_kind, text, op, lhs, rhs, span, rvalue_ty, rvalue_abi, rvalue_args, builtin_method)
}

task v4_mir_snapshot_restore_diag_line(line: word) -> int {
    if v4_mir_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_mir_snapshot_field_raw(line, 0) != "mir-diag" { give back 0 }
    pilot mir_id = word_to_int(v4_mir_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_mir_snapshot_field_raw(line, 2))
    pilot diag = v4_mir_snapshot_field(line, 3)
    give back v4_mir_restore_diag_slot(mir_id, diag_id, diag)
}

task v4_mir_snapshot_restore_component(payload: word) -> word {
    pilot validation = v4_mir_snapshot_validate(payload)
    if validation.starts_with("mir-snapshot-import ok=1") == false {
        give back "mir-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_files = 0
    pilot restored_bodies = 0
    pilot restored_blocks = 0
    pilot restored_locals = 0
    pilot restored_statements = 0
    pilot restored_places = 0
    pilot restored_rvalues = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot restore_failures = 0
    pilot line_id = 0
    pilot line_count = v4_mir_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_mir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_mir_snapshot_field_raw(line, 0)
            if kind == "mir" {
                pilot file_applied = v4_mir_snapshot_restore_file_line(line)
                restored_files += file_applied
                if file_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-body" {
                pilot body_applied = v4_mir_snapshot_restore_body_line(line)
                restored_bodies += body_applied
                if body_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-block" {
                pilot block_applied = v4_mir_snapshot_restore_block_line(line)
                restored_blocks += block_applied
                if block_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-local" {
                pilot local_applied = v4_mir_snapshot_restore_local_line(line)
                restored_locals += local_applied
                if local_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-stmt" {
                pilot stmt_applied = v4_mir_snapshot_restore_stmt_line(line)
                restored_statements += stmt_applied
                if stmt_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-place" {
                pilot place_applied = v4_mir_snapshot_restore_place_line(line)
                restored_places += place_applied
                if place_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-rvalue" {
                pilot rvalue_applied = v4_mir_snapshot_restore_rvalue_line(line)
                restored_rvalues += rvalue_applied
                if rvalue_applied != 1 { restore_failures += 1 }
            } else if kind == "mir-diag" {
                pilot diag_applied = v4_mir_snapshot_restore_diag_line(line)
                restored_diagnostics += diag_applied
                if diag_applied != 1 { restore_failures += 1 }
            } else if kind != "mir-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot restore_ok = 1
    if restore_failures > 0 { restore_ok = 0 }
    pilot out = "mir-snapshot-restore ok=" + word_from_int(restore_ok)
    out = out + " files=" + word_from_int(restored_files)
    out = out + " bodies=" + word_from_int(restored_bodies)
    out = out + " blocks=" + word_from_int(restored_blocks)
    out = out + " locals=" + word_from_int(restored_locals)
    out = out + " statements=" + word_from_int(restored_statements)
    out = out + " places=" + word_from_int(restored_places)
    out = out + " rvalues=" + word_from_int(restored_rvalues)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " failures=" + word_from_int(restore_failures)
    out = out + " live-files=" + word_from_int(v4_mir_file_count())
    give back out
}
