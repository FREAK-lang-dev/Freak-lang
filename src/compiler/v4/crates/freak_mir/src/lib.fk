    array_release(word_to_int(array_get(v4_mir_stmt_rhs_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_rhs_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_scope_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_scope_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_blocks_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_blocks_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_places_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_places_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_stmt_rvalues_index_handle(mir_id), body_id)))
    array_set(v4_mir_stmt_rvalues_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_kinds_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_kinds_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_texts_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_texts_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_bases_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_bases_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_fields_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_fields_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_indices_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_indices_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_place_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_place_spans_index_handle(mir_id), body_id, "-1")
