}

-- Binding immutability is independent of ownership/passing mode. These
-- authored prefixes survive snapshot restoration and declaration-ID compaction.
task v4_mir_binding_prefix_is_valid(prefix: word) -> bool {
    give back prefix == "" or prefix == "fixed pilot" or prefix == "grounded pilot"
}

task v4_mir_local_binding_prefix(mir_id: int, body_id: int, local_id: int) -> word {
    if local_id < 0 or local_id >= v4_mir_body_local_count(mir_id, body_id) { give back "" }
    give back array_get(v4_mir_body_local_binding_prefixes_handle(mir_id, body_id), local_id)
}

task v4_mir_set_local_binding_prefix(mir_id: int, body_id: int, local_id: int, prefix: word) -> void {
    if local_id < 0 or local_id >= v4_mir_body_local_count(mir_id, body_id) { give back }
    array_set(v4_mir_body_local_binding_prefixes_handle(mir_id, body_id), local_id, prefix)
}

task v4_mir_place_binding_local(mir_id: int, body_id: int, place_id: int) -> int {
    pilot remaining = v4_mir_body_place_count(mir_id, body_id)
    repeat until place_id < 0 or place_id >= v4_mir_body_place_count(mir_id, body_id) or remaining <= 0 {
        pilot kind = v4_mir_place_kind(mir_id, body_id, place_id)
        if kind == v4_mir_place_local { give back v4_mir_place_base(mir_id, body_id, place_id) }
        if kind != v4_mir_place_field and kind != v4_mir_place_index { give back -1 }
        place_id = v4_mir_place_base(mir_id, body_id, place_id)
        remaining -= 1
    }
    give back -1
}

task v4_mir_local_mode(mir_id: int, body_id: int, local_id: int) -> word {
    give back array_get(v4_mir_body_local_modes_handle(mir_id, body_id), local_id)
}

