    array_release(word_to_int(array_get(v4_mir_body_stmt_places, mir_id)))
    array_set(v4_mir_body_stmt_places, mir_id, "-1")
    array_release(word_to_int(array_get(v4_mir_body_stmt_rvalues, mir_id)))
    array_set(v4_mir_body_stmt_rvalues, mir_id, "-1")
    array_release(word_to_int(array_get(v4_mir_body_place_kinds, mir_id)))
    array_set(v4_mir_body_place_kinds, mir_id, "-1")
