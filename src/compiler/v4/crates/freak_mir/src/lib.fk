pilot v4_mir_rvalue_capture_copy = "CaptureCopy"
pilot v4_mir_rvalue_capture_move = "CaptureMove"
pilot v4_mir_rvalue_unknown = "Unknown"

-- MIR stores semantic truth independently of source spelling. This reader
-- also accepts the numeric facts used by older manual/snapshot fixtures.
task v4_mir_bool_literal_value(text: word) -> word {
    pilot lower = text.to_lower()
    if lower == "true" or lower == "yes" or lower == "hai" or lower == "1" {
        give back "true"
    }
    if lower == "false" or lower == "no" or lower == "iie" or lower == "0" {
        give back "false"
    }
    give back ""
}

pilot v4_mir_unary_neg = "Neg"
pilot v4_mir_unary_not = "Not"
pilot v4_mir_unary_ptr_is_null = "PtrIsNull"
pilot v4_mir_unary_deref = "Deref"
pilot v4_mir_unary_ptr_offset = "PtrOffset"
pilot v4_mir_unary_ptr_cast = "PtrCast"
pilot v4_mir_unary_num_convert = "NumConvert"
-- A slot read from a temporary aggregate (a call result), which is not a
-- place: Project's rhs is a ConstInt child holding the declared slot (shape
-- fields in declaration order, tuple slots by number); ProjectIndex's rhs is
-- the index operand into a fixed array.
pilot v4_mir_unary_project = "Project"
pilot v4_mir_unary_project_index = "ProjectIndex"
pilot v4_mir_call_raw_ptr_write = "#RawPtrWrite"
pilot v4_mir_call_say_literal = "#SayLiteral"

pilot v4_mir_builtin_shared_new = "builtin::Shared::new"
pilot v4_mir_builtin_shared_clone = "builtin::Shared::clone"
pilot v4_mir_builtin_shared_downgrade = "builtin::Shared::downgrade"
