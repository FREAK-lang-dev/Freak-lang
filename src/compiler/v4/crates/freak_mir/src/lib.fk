    give back array_get(v4_mir_body_local_scope_spans_handle(mir_id, body_id), local_id)
}

task v4_mir_local_visible_at(mir_id: int, body_id: int, local_id: int, offset: int) -> bool {
    if local_id < 0 {
        give back false
    }
    pilot def_span = v4_mir_local_span(mir_id, body_id, local_id)
    pilot scope_span = v4_mir_local_scope_span(mir_id, body_id, local_id)
    pilot start_offset = v4_span_start(def_span)
    pilot end_offset = v4_span_end(scope_span)
    if end_offset <= start_offset {
        end_offset = v4_span_end(def_span)
    }
    give back offset >= start_offset and offset < end_offset
}

task v4_mir_stmt_kind(mir_id: int, body_id: int, stmt_id: int) -> word {
    give back array_get(v4_mir_body_stmt_kinds_handle(mir_id, body_id), stmt_id)
}

task v4_mir_stmt_lhs(mir_id: int, body_id: int, stmt_id: int) -> word {
    give back array_get(v4_mir_body_stmt_lhs_handle(mir_id, body_id), stmt_id)
}

task v4_mir_stmt_rhs(mir_id: int, body_id: int, stmt_id: int) -> word {
    give back array_get(v4_mir_body_stmt_rhs_handle(mir_id, body_id), stmt_id)
}

task v4_mir_stmt_span(mir_id: int, body_id: int, stmt_id: int) -> word {
    give back array_get(v4_mir_body_stmt_spans_handle(mir_id, body_id), stmt_id)
}

task v4_mir_stmt_block(mir_id: int, body_id: int, stmt_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_stmt_blocks_handle(mir_id, body_id), stmt_id))
}

task v4_mir_stmt_place(mir_id: int, body_id: int, stmt_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_stmt_places_handle(mir_id, body_id), stmt_id))
}

task v4_mir_stmt_rvalue(mir_id: int, body_id: int, stmt_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), stmt_id))
}

task v4_mir_place_kind(mir_id: int, body_id: int, place_id: int) -> word {
    give back array_get(v4_mir_body_place_kinds_handle(mir_id, body_id), place_id)
}

task v4_mir_place_text(mir_id: int, body_id: int, place_id: int) -> word {
    give back array_get(v4_mir_body_place_texts_handle(mir_id, body_id), place_id)
}

task v4_mir_place_base(mir_id: int, body_id: int, place_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_place_bases_handle(mir_id, body_id), place_id))
}

task v4_mir_place_field(mir_id: int, body_id: int, place_id: int) -> word {
    give back array_get(v4_mir_body_place_fields_handle(mir_id, body_id), place_id)
}

-- Sealed shape facts for native lowering. A shape type is a concrete
-- (non-generic) shape signature; its field slot is the declaration index,
-- the same order Construct children use. Anything else answers -1.
-- A generic shape instance such as Box<int> is a shape type too when every
-- type argument is concrete (v4_mir_type_is_concrete); its field types are
-- the declared ones with the arguments substituted (v4_mir_shape_field_type).
-- Box<T> inside a template, and shapes with lifetime parameters, answer -1.
task v4_mir_shape_signature(mir_id: int, type_text: word) -> int {
    pilot ty_id = v4_mir_ty_id(mir_id)
    if type_text == "" or type_text == v4_ty_unknown { give back 0 - 1 }
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, canonical)
    if sig_id < 0 { give back 0 - 1 }
    if v4_ty_signature_generic_count(ty_id, sig_id) > 0 {
        if not v4_mir_generic_aggregate_instance_is_native(ty_id, sig_id, canonical) { give back 0 - 1 }
    } else if v4_ty_is_generic_instance_type(canonical) { give back 0 - 1 }
    give back sig_id
}

task v4_mir_generic_aggregate_instance_is_native(ty_id: int, sig_id: int, canonical: word) -> bool {
    if not v4_ty_is_generic_instance_type(canonical) or v4_ty_signature_lifetime_count(ty_id, sig_id) > 0 { give back false }
    if v4_ty_signature_generic_count(ty_id, sig_id) != v4_ty_generic_arg_count(canonical) { give back false }
    give back v4_mir_type_is_concrete(ty_id, canonical, 0)
}

-- A type that names no type parameter: builtin scalars and words, concrete
-- or fully applied shapes and routes, builtin generic carriers of concrete
-- types, tuples, fixed arrays, lends and raw pointers of concrete types.
-- Shared<T>, Weak<T> and SharedMut<T> are left out on purpose: native code
-- has no layout for them, so a Box<Shared<int>> local is refused by name
-- ("native type not yet supported: Shared<int>") whether or not the
-- predicate admits the instance. Admit them here when the carriers land.
task v4_mir_type_is_concrete(ty_id: int, surface: word, depth: int) -> bool {
    if depth > 32 or surface == "" or surface == v4_ty_unknown { give back false }
    pilot type_text = v4_ty_canonical_type(ty_id, surface)
    if type_text == v4_ty_int or type_text == v4_ty_uint or type_text == v4_ty_tiny or type_text == v4_ty_num or type_text == v4_ty_float or type_text == v4_ty_float32 { give back true }
    if type_text == v4_ty_bool or type_text == v4_ty_char or type_text == v4_ty_word or type_text == v4_ty_void or type_text == v4_ty_big { give back true }
    if v4_ty_is_lend_type(type_text) { give back v4_mir_type_is_concrete(ty_id, v4_ty_lend_target_type(type_text), depth + 1) }
    -- never is concrete only behind a raw pointer (*mut never); a by-value
    -- never field or formal stays refused.
    if v4_ty_is_raw_pointer_type(type_text) {
        pilot pointee = v4_ty_canonical_type(ty_id, v4_ty_raw_pointer_target_type(type_text))
        if pointee == v4_ty_never { give back true }
        give back v4_mir_type_is_concrete(ty_id, pointee, depth + 1)
    }
    if v4_ty_is_fixed_array_type(type_text) { give back v4_mir_type_is_concrete(ty_id, v4_ty_fixed_array_element_type(type_text), depth + 1) }
    if v4_ty_is_tuple_type(type_text) {
        pilot slot = 0
        repeat until slot >= v4_ty_tuple_slot_count(type_text) {
            if not v4_mir_type_is_concrete(ty_id, v4_ty_tuple_slot_type(type_text, slot), depth + 1) { give back false }
            slot += 1
        }
        give back true
    }
    if v4_ty_is_generic_instance_type(type_text) {
        pilot base = v4_ty_generic_base_name(type_text)
        pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, type_text)
        if sig_id < 0 { sig_id = v4_ty_route_signature_id_for_name(ty_id, type_text) }
        if sig_id < 0 and base != "maybe" and base != "result" and base != "List" and base != "Map" and base != "Set" and base != "Lineup" { give back false }
        pilot arg = 0
        repeat until arg >= v4_ty_generic_arg_count(type_text) {
            if not v4_mir_type_is_concrete(ty_id, v4_ty_generic_arg(type_text, arg), depth + 1) { give back false }
            arg += 1
        }
        give back true
    }
    pilot named = v4_ty_shape_signature_id_for_name(ty_id, type_text)
    if named < 0 { named = v4_ty_route_signature_id_for_name(ty_id, type_text) }
    give back named >= 0 and v4_ty_signature_generic_count(ty_id, named) == 0
}

task v4_mir_shape_field_count(mir_id: int, type_text: word) -> int {
    pilot sig_id = v4_mir_shape_signature(mir_id, type_text)
    if sig_id < 0 { give back 0 - 1 }
    give back v4_ty_shape_field_count(v4_mir_ty_id(mir_id), sig_id)
}

task v4_mir_shape_field_type(mir_id: int, type_text: word, field_id: int) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_shape_signature(mir_id, type_text)
    if sig_id < 0 { give back v4_ty_unknown }
    pilot field_ty = v4_ty_shape_field_type(ty_id, sig_id, field_id)
    if v4_ty_signature_generic_count(ty_id, sig_id) == 0 { give back field_ty }
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_signature_generics(ty_id, sig_id, v4_ty_canonical_type(ty_id, type_text), field_ty))
}

task v4_mir_place_shape_field_slot(mir_id: int, body_id: int, place_id: int) -> int {
    if v4_mir_place_kind(mir_id, body_id, place_id) != v4_mir_place_field { give back 0 - 1 }
    pilot base = v4_mir_place_base(mir_id, body_id, place_id)
    if base < 0 or base >= place_id { give back 0 - 1 }
    pilot base_ty = v4_mir_place_ty(mir_id, body_id, base)
    -- A field of a borrowed place (`lend T`) is the field of its referent.
    if v4_ty_is_lend_type(base_ty) { base_ty = v4_ty_lend_target_type(base_ty) }
    if v4_mir_shape_signature(mir_id, base_ty) < 0 { give back 0 - 1 }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_shape_field_id_for_name(ty_id, v4_ty_canonical_type(ty_id, base_ty), v4_mir_place_field(mir_id, body_id, place_id))
}

-- Sealed route payload facts. A pattern that selected a route case names
-- its payload field places Case::field, so the case travels with the place
-- and native lowering never guesses it from the field name. A plain field
-- name (no case) answers "" for the case and itself for the field.
task v4_mir_route_payload_field_key(case_name: word, field_name: word) -> word {
    give back case_name + "::" + field_name
}

task v4_mir_route_payload_key_separator(key: word) -> int {
    pilot idx = 0
    repeat until idx + 1 >= key.length() {
        if key.char_at(idx) == ":" and key.char_at(idx + 1) == ":" { give back idx }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_place_route_payload_case(mir_id: int, body_id: int, place_id: int) -> word {
    if v4_mir_place_kind(mir_id, body_id, place_id) != v4_mir_place_field { give back "" }
    pilot key = v4_mir_place_field(mir_id, body_id, place_id)
    pilot sep = v4_mir_route_payload_key_separator(key)
    if sep <= 0 { give back "" }
    give back v4_slice(key, 0, sep)
}

task v4_mir_place_route_payload_field(mir_id: int, body_id: int, place_id: int) -> word {
    pilot key = v4_mir_place_field(mir_id, body_id, place_id)
    pilot sep = v4_mir_route_payload_key_separator(key)
    if sep <= 0 { give back key }
    give back v4_slice(key, sep + 2, key.length())
}

task v4_mir_place_index(mir_id: int, body_id: int, place_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_place_indices_handle(mir_id, body_id), place_id))
}

task v4_mir_place_span(mir_id: int, body_id: int, place_id: int) -> word {
    give back array_get(v4_mir_body_place_spans_handle(mir_id, body_id), place_id)
}

task v4_mir_place_ty(mir_id: int, body_id: int, place_id: int) -> word {
    give back array_get(v4_mir_body_place_tys_handle(mir_id, body_id), place_id)
}

task v4_mir_rvalue_kind(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back array_get(v4_mir_body_rvalue_kinds_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_rvalue_text(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back array_get(v4_mir_body_rvalue_texts_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_rvalue_op(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back array_get(v4_mir_body_rvalue_ops_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_rvalue_lhs(mir_id: int, body_id: int, rvalue_id: int) -> int {
    give back word_to_int(array_get(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), rvalue_id))
}

task v4_mir_rvalue_rhs(mir_id: int, body_id: int, rvalue_id: int) -> int {

    give back word_to_int(array_get(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), rvalue_id))
}

task v4_mir_rvalue_span(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back array_get(v4_mir_body_rvalue_spans_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_rvalue_ty(mir_id: int, body_id: int, rvalue_id: int) -> word {
    v4_mir_rvalue_ty_reads += 1
    give back array_get(v4_mir_body_rvalue_tys_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_set_rvalue_ty(mir_id: int, body_id: int, rvalue_id: int, rvalue_ty: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    pilot never_count = v4_mir_body_never_summary_begin_write(mir_id, body_id)
    if never_count >= 0 and v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) == v4_ty_never { never_count -= 1 }
    array_set(v4_mir_body_rvalue_tys_handle(mir_id, body_id), rvalue_id, rvalue_ty)
    if never_count >= 0 {
        if rvalue_ty == v4_ty_never { never_count += 1 }
        v4_mir_publish_body_never_summary(mir_id, body_id, v4_mir_body_rvalue_count(mir_id, body_id), never_count)
    }
}

task v4_mir_set_rvalue_children(mir_id: int, body_id: int, rvalue_id: int, lhs: int, rhs: int) -> void {
    array_set(v4_mir_body_rvalue_lhs_handle(mir_id, body_id), rvalue_id, word_from_int(lhs))
    array_set(v4_mir_body_rvalue_rhs_handle(mir_id, body_id), rvalue_id, word_from_int(rhs))
}

task v4_mir_rvalue_abi(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back array_get(v4_mir_body_rvalue_abis_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_rvalue_args_payload(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back array_get(v4_mir_body_rvalue_args_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_rvalue_builtin_method(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if mir_id < 0 or mir_id >= v4_mir_file_count() {
        give back ""
    }
    if body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back ""
    }
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back ""
    }
    give back array_get(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), rvalue_id)
}

task v4_mir_diag(mir_id: int, diag_id: int) -> word {
    give back array_get(v4_mir_diags_handle(mir_id), diag_id)
}

task v4_mir_add_diag(mir_id: int, diag: word) -> void {
    array_push(v4_mir_diags_handle(mir_id), diag)
}

-- Keep every diagnostic before `start` and only the errors from it on.
task v4_mir_diag_repeats(diags: int, before: int, diag: word) -> bool {
    pilot idx = 0
    repeat until idx >= before {
        pilot seen: word = array_get(diags, idx)
        if seen == diag { give back true }
        idx += 1
    }
    give back false
}

task v4_mir_retain_error_diags_from(mir_id: int, start: int) -> void {
    pilot old = v4_mir_diags_handle(mir_id)
    if start < 0 or start >= array_len(old) { give back }
    pilot kept = array_new()
    if kept < 0 { give back }
    pilot idx = 0
    repeat until idx >= array_len(old) {
        pilot diag: word = array_get(old, idx)
        if idx < start {
            array_push(kept, diag)
        } else if v4_diag_severity(diag) >= v4_diag_error and not v4_mir_diag_repeats(old, start, diag) {
            -- An instance error the template already reported is one error.
            array_push(kept, diag)
        }
        idx += 1
    }
    array_set(v4_mir_diags, mir_id, word_from_int(kept))
    array_release(old)
}

task v4_mir_add_type_error(mir_id: int, span: word, message: word, help: word) -> void {
    v4_mir_add_diag(mir_id, v4_diag_new(v4_diag_error, span, message, help))
}

task v4_mir_add_type_warning(mir_id: int, span: word, message: word, help: word) -> void {
    v4_mir_add_diag(mir_id, v4_diag_new(v4_diag_warning, span, message, help))
}

task v4_mir_block_new_full(block_id: int, terminator: word, target: int, else_target: int, condition: word) -> word {
    give back word_from_int(block_id) + "|" + terminator + "|" + word_from_int(target) + "|" + word_from_int(else_target) + "|" + v4_mir_snapshot_escape(condition) + "|" + V4_NO_SPAN
}

task v4_mir_block_new(block_id: int, terminator: word, target: int) -> word {
    give back v4_mir_block_new_full(block_id, terminator, target, 0 - 1, "")
}

task v4_mir_block_part(block_record: word, wanted: int) -> word {
    pilot part = 0
    pilot start_pos = 0
    pilot i = 0
    repeat until i >= block_record.length() {
        if block_record.char_at(i) == "|" {
            if part == wanted {
                give back v4_slice(block_record, start_pos, i)
            }
            part += 1
            start_pos = i + 1
        }
        i += 1
    }
    if part == wanted {
        give back v4_slice(block_record, start_pos, block_record.length())
    }
    give back ""
}

task v4_mir_block_id(block_record: word) -> int {
    pilot raw = v4_mir_block_part(block_record, 0)
    if raw == "" {
        give back 0
    }
    give back word_to_int(raw)
}

task v4_mir_block_terminator(block_record: word) -> word {
    give back v4_mir_block_part(block_record, 1)
}

task v4_mir_block_target(block_record: word) -> int {
    v4_mir_block_edge_reads += 1
    pilot raw = v4_mir_block_part(block_record, 2)
    if raw == "" {
        give back 0 - 1
    }
    give back word_to_int(raw)
}

task v4_mir_block_else_target(block_record: word) -> int {
    v4_mir_block_edge_reads += 1
    pilot raw = v4_mir_block_part(block_record, 3)
    if raw == "" {
        give back 0 - 1
    }
    give back word_to_int(raw)
}

task v4_mir_block_condition(block_record: word) -> word {
    give back v4_mir_snapshot_unescape(v4_mir_block_part(block_record, 4))
}

task v4_mir_body_block(mir_id: int, body_id: int, block_id: int) -> word {
    v4_mir_body_block_reads += 1
    give back array_get(v4_mir_body_blocks_handle(mir_id, body_id), block_id)
}

task v4_mir_set_body_block(mir_id: int, body_id: int, block_id: int, block_record: word) -> void {
    pilot old_scope = v4_mir_block_scope_span(mir_id, body_id, block_id)
    if v4_mir_block_part(block_record, 5) == V4_NO_SPAN and old_scope != (V4_NO_SPAN) {
        block_record = v4_mir_block_with_scope(block_record, old_scope)
    }
    array_set(v4_mir_body_blocks_handle(mir_id, body_id), block_id, block_record)
}

task v4_mir_add_block(mir_id: int, body_id: int, terminator: word, target: int, else_target: int, condition: word) -> int {
    pilot block_id = v4_mir_body_block_count(mir_id, body_id)
    array_push(v4_mir_body_blocks_handle(mir_id, body_id), v4_mir_block_new_full(block_id, terminator, target, else_target, condition))
    v4_mir_block_index_added(mir_id, body_id, block_id)
    give back block_id
}

task v4_mir_block_has_return_stmt(mir_id: int, body_id: int, block_id: int) -> bool {
    give back v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_return) > 0
}

task v4_mir_block_has_terminal_stmt(mir_id: int, body_id: int, block_id: int) -> bool {
    if v4_mir_block_terminator(v4_mir_body_block(mir_id, body_id, block_id)) == v4_mir_term_unreachable { give back true }
    give back v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_return) > 0 or v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_break) > 0 or v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_continue) > 0
}

task v4_mir_seal_block_goto_if_live(mir_id: int, body_id: int, block_id: int, target: int) -> void {
    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    if v4_mir_block_terminator(block_record) != v4_mir_term_return {
        give back
    }
    if v4_mir_block_has_return_stmt(mir_id, body_id, block_id) {
        v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_return, 0 - 1, 0 - 1, ""))
        give back
    }
    v4_mir_set_body_block(mir_id, body_id, block_id, v4_mir_block_new_full(block_id, v4_mir_term_goto, target, 0 - 1, ""))
}

task v4_mir_block_can_fallthrough_without_return_seen(mir_id: int, body_id: int, block_id: int, seen: int) -> bool {
    if block_id < 0 {
        give back false
    }
    if block_id >= v4_mir_body_block_count(mir_id, body_id) {
        give back false
    }

    repeat until array_len(seen) > block_id {
        array_push(seen, "false")
    }
    pilot visited: word = array_get(seen, block_id)
    if visited == "true" {
        give back false
    }
    array_set(seen, block_id, "true")

    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    pilot terminator = v4_mir_block_terminator(block_record)
    if terminator == v4_mir_term_return {
        give back not v4_mir_block_has_return_stmt(mir_id, body_id, block_id)
    }
    if terminator == v4_mir_term_unreachable {
        give back false
    }
    if terminator == v4_mir_term_goto {
        give back v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, v4_mir_block_target(block_record), seen)
    }
    if terminator == v4_mir_term_if {
        if v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, v4_mir_block_target(block_record), seen) {
            give back true
        }
        give back v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, v4_mir_block_else_target(block_record), seen)
    }
    give back false
}

task v4_mir_body_can_fallthrough_without_return(mir_id: int, body_id: int) -> bool {
    pilot seen = array_new()
    pilot can_fallthrough = v4_mir_block_can_fallthrough_without_return_seen(mir_id, body_id, 0, seen)
    array_release(seen)
    give back can_fallthrough
}

task v4_mir_validate_body_return_coverage(mir_id: int, body_id: int, item_span: word) -> void {
    pilot expected_ty = v4_mir_expected_return_type(mir_id, body_id)
    if expected_ty == v4_ty_unknown or expected_ty == v4_ty_void {
        give back
    }
    if v4_mir_body_can_fallthrough_without_return(mir_id, body_id) {
        v4_mir_add_type_error(mir_id, item_span, "missing return", v4_mir_body_name(mir_id, body_id) + " must give back " + expected_ty + " on every route")
    }
}

task v4_mir_body_stmt_count_for_block(mir_id: int, body_id: int, block_id: int) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 }
    if block_id >= 0 and block_id < v4_mir_body_block_count(mir_id, body_id) and v4_mir_block_stmt_index_is_ready(mir_id, body_id) {
        v4_mir_block_stmt_lookup_steps += 1
        give back word_to_int(array_get(v4_mir_block_stmt_index_handle(mir_id, body_id), 3 + 11 * block_id + 2))
    }
    pilot total = 0
    pilot stmt_id = v4_mir_block_first_stmt(mir_id, body_id, block_id)
    repeat until stmt_id < 0 {
        total += 1
        stmt_id = v4_mir_block_next_stmt(mir_id, body_id, block_id, stmt_id)
    }
    give back total
}

task v4_mir_body_stmt_kind_count_for_block(mir_id: int, body_id: int, block_id: int, wanted_kind: word) -> int {
    if not v4_mir_lookup_body_exists(mir_id, body_id) { give back 0 }
    pilot kind_slot = v4_mir_block_stmt_kind_slot(wanted_kind)
    if kind_slot >= 0 and block_id >= 0 and block_id < v4_mir_body_block_count(mir_id, body_id) and v4_mir_block_stmt_index_is_ready(mir_id, body_id) {
        v4_mir_block_stmt_lookup_steps += 1
        give back word_to_int(array_get(v4_mir_block_stmt_index_handle(mir_id, body_id), 3 + 11 * block_id + kind_slot))
    }
    pilot total = 0
    pilot stmt_id = v4_mir_block_first_stmt(mir_id, body_id, block_id)
    repeat until stmt_id < 0 {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == wanted_kind { total += 1 }
        stmt_id = v4_mir_block_next_stmt(mir_id, body_id, block_id, stmt_id)
    }
    give back total
}

task v4_mir_body_block_has_stmt_after_return(mir_id: int, body_id: int, block_id: int) -> bool {
    pilot saw_return = false
    pilot stmt_id = v4_mir_block_first_stmt(mir_id, body_id, block_id)
    repeat until stmt_id < 0 {
        if saw_return { give back true }
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_return { saw_return = true }
        stmt_id = v4_mir_block_next_stmt(mir_id, body_id, block_id, stmt_id)
    }
    give back false
}

task v4_mir_body_block_predecessor_count(mir_id: int, body_id: int, wanted_block: int) -> int {
    pilot total = 0
    pilot block_id = 0
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    repeat until block_id >= block_count {
        pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
        pilot terminator = v4_mir_block_terminator(block_record)
        if terminator == v4_mir_term_goto {
            if v4_mir_block_target(block_record) == wanted_block {
                total += 1
            }
        } else if terminator == v4_mir_term_if {
            if v4_mir_block_target(block_record) == wanted_block {
                total += 1
            }
            if v4_mir_block_else_target(block_record) == wanted_block {
                total += 1
            }
        }
        block_id += 1
    }
    give back total
}

-- Validation owns this scratch for one immutable body traversal. Count both
-- If arms, including identical targets, from physical slots just as the cold
-- scanner does. Invalid targets cannot name a validated block and are ignored.
task v4_mir_body_block_predecessor_counts(mir_id: int, body_id: int) -> int {
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    if block_count <= 1 { give back -1 }
    pilot counts = array_new()
    if counts < 0 { give back -1 }
    pilot block_id = 0
    repeat until block_id >= block_count {
        array_push(counts, "0")
        if array_len(counts) != block_id + 1 {
            array_release(counts)
            give back -1
        }
        block_id += 1
    }
    block_id = 0
    repeat until block_id >= block_count {
        pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
        pilot terminator = v4_mir_block_terminator(block_record)
        if terminator == v4_mir_term_goto or terminator == v4_mir_term_if {
            pilot target = v4_mir_block_target(block_record)
            if target >= 0 and target < block_count {
                array_set(counts, target, word_from_int(word_to_int(array_get(counts, target)) + 1))
            }
            if terminator == v4_mir_term_if {
                target = v4_mir_block_else_target(block_record)
                if target >= 0 and target < block_count {
                    array_set(counts, target, word_from_int(word_to_int(array_get(counts, target)) + 1))
                }
            }
        }
        block_id += 1
    }
    give back counts
}

task v4_mir_block_target_is_valid(mir_id: int, body_id: int, target: int) -> bool {
    give back target >= 0 and target < v4_mir_body_block_count(mir_id, body_id)
}

task v4_mir_validate_body_cfg(mir_id: int, body_id: int, item_span: word) -> void {
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    pilot place_count = v4_mir_body_place_count(mir_id, body_id)
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)

    pilot stmt_id = 0
    repeat until stmt_id >= stmt_count {
        pilot stmt_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
        if stmt_block < 0 or stmt_block >= block_count {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg stmt block out of range", body_name + " statement " + word_from_int(stmt_id) + " points at missing block " + word_from_int(stmt_block))
        }

        pilot stmt_place = v4_mir_stmt_place(mir_id, body_id, stmt_id)
        if stmt_place >= place_count {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg stmt place out of range", body_name + " statement " + word_from_int(stmt_id) + " points at missing place " + word_from_int(stmt_place))
        }

        pilot stmt_rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
        if stmt_rvalue >= rvalue_count {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg stmt rvalue out of range", body_name + " statement " + word_from_int(stmt_id) + " points at missing rvalue " + word_from_int(stmt_rvalue))
        }
        stmt_id += 1
    }

    pilot predecessor_counts = v4_mir_body_block_predecessor_counts(mir_id, body_id)
    pilot block_id = 0
    repeat until block_id >= block_count {
        pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
        pilot record_id = v4_mir_block_id(block_record)
        pilot terminator = v4_mir_block_terminator(block_record)
        pilot stmt_in_block = v4_mir_body_stmt_count_for_block(mir_id, body_id, block_id)
        pilot return_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_return)
        pilot branch_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_branch)
        pilot loop_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_loop)
        pilot break_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_break)
        pilot continue_count = v4_mir_body_stmt_kind_count_for_block(mir_id, body_id, block_id, v4_mir_stmt_continue)

        if record_id != block_id {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg block id drift", body_name + " stores block " + word_from_int(record_id) + " in slot " + word_from_int(block_id))
        }

        if terminator == v4_mir_term_goto {
            if not v4_mir_block_target_is_valid(mir_id, body_id, v4_mir_block_target(block_record)) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg invalid goto target", body_name + " block " + word_from_int(block_id) + " jumps to missing block " + word_from_int(v4_mir_block_target(block_record)))
            }
        } else if terminator == v4_mir_term_if {
            if not v4_mir_block_target_is_valid(mir_id, body_id, v4_mir_block_target(block_record)) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg invalid if target", body_name + " block " + word_from_int(block_id) + " branches to missing block " + word_from_int(v4_mir_block_target(block_record)))
            }
            if not v4_mir_block_target_is_valid(mir_id, body_id, v4_mir_block_else_target(block_record)) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg invalid else target", body_name + " block " + word_from_int(block_id) + " falls through to missing block " + word_from_int(v4_mir_block_else_target(block_record)))
            }
            if branch_count + loop_count == 0 {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg if terminator missing control stmt", body_name + " block " + word_from_int(block_id) + " ends with If but records no branch or loop statement")
            }
        } else if terminator != v4_mir_term_return and terminator != v4_mir_term_unreachable {

            v4_mir_add_type_error(mir_id, item_span, "mir cfg unknown terminator", body_name + " block " + word_from_int(block_id) + " uses unsupported terminator " + terminator)
        }

        if return_count > 0 and terminator != v4_mir_term_return {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg return terminator mismatch", body_name + " block " + word_from_int(block_id) + " contains return value statements but ends with " + terminator)
        }
        if branch_count + loop_count > 0 and terminator != v4_mir_term_if {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg branch terminator mismatch", body_name + " block " + word_from_int(block_id) + " contains branch or loop statements but ends with " + terminator)
        }
        if break_count + continue_count > 0 and terminator != v4_mir_term_goto {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg jump terminator mismatch", body_name + " block " + word_from_int(block_id) + " contains break or continue statements but ends with " + terminator)
        }
        if v4_mir_body_block_has_stmt_after_return(mir_id, body_id, block_id) {
            v4_mir_add_type_error(mir_id, item_span, "mir cfg statement after return", body_name + " block " + word_from_int(block_id) + " keeps lowering statements after a return")
        }

        if block_id != 0 {
            pilot preds = 0
            if predecessor_counts >= 0 {
                preds = word_to_int(array_get(predecessor_counts, block_id))
            } else {
                preds = v4_mir_body_block_predecessor_count(mir_id, body_id, block_id)
            }
            if preds == 0 and (stmt_in_block > 0 or terminator == v4_mir_term_goto or terminator == v4_mir_term_if) {
                v4_mir_add_type_error(mir_id, item_span, "mir cfg unreachable live block", body_name + " block " + word_from_int(block_id) + " has no predecessors but still carries live statements or control flow")
            }
        }
        block_id += 1
    }
    array_release(predecessor_counts)
}

task v4_mir_find_local(mir_id: int, body_id: int, local_name: word) -> int {
    pilot local_idx = 0
    pilot local_count = v4_mir_body_local_count(mir_id, body_id)
    repeat until local_idx >= local_count {
        if v4_mir_local_name(mir_id, body_id, local_idx) == local_name {
            give back local_idx
        }
        local_idx += 1
    }
    give back 0 - 1
}

task v4_mir_local_ty_for_name(mir_id: int, body_id: int, local_name: word) -> word {
    pilot local_id = v4_mir_find_local(mir_id, body_id, local_name)
    if local_id < 0 {
        give back v4_ty_unknown
    }
    give back v4_mir_local_ty(mir_id, body_id, local_id)
}

task v4_mir_local_mode_for_name(mir_id: int, body_id: int, local_name: word) -> word {
    pilot local_id = v4_mir_find_local(mir_id, body_id, local_name)
    if local_id < 0 {
        give back v4_ty_param_mode_value
    }
    give back v4_mir_local_mode(mir_id, body_id, local_id)
}

task v4_mir_find_local_visible_at(mir_id: int, body_id: int, local_name: word, offset: int) -> int {
    pilot local_idx = v4_mir_body_local_count(mir_id, body_id)
    repeat until local_idx <= 0 {
        local_idx -= 1
        if v4_mir_local_name(mir_id, body_id, local_idx) == local_name and v4_mir_local_visible_at(mir_id, body_id, local_idx, offset) {
            give back local_idx
        }
    }
    give back 0 - 1
}

-- Synthetic UseLocal identities occupy the existing op field, rather than
-- lhs/rhs (which are rvalue graph edges). Legacy facts still resolve by name.
task v4_mir_rvalue_local_id(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back 0 - 1
    }
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_use_local {
        give back 0 - 1
    }
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    if op.starts_with("local#") {
        pilot raw = v4_slice(op, 6, op.length())
        if not v4_mir_snapshot_nonnegative_int_is_valid(raw) { give back 0 - 1 }
        pilot local_id = word_to_int(raw)
        if local_id < 0 or local_id >= v4_mir_body_local_count(mir_id, body_id) or word_from_int(local_id) != raw {
            give back 0 - 1
        }
        if v4_mir_rvalue_text(mir_id, body_id, rvalue_id) != v4_mir_local_name(mir_id, body_id, local_id) or v4_mir_rvalue_ty(mir_id, body_id, rvalue_id) != v4_mir_local_ty(mir_id, body_id, local_id) {
            give back 0 - 1
        }
        give back local_id
    }
    give back v4_mir_find_local_visible_at(mir_id, body_id, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), v4_span_start(v4_mir_rvalue_span(mir_id, body_id, rvalue_id)))
}

task v4_mir_set_local_ty(mir_id: int, body_id: int, local_id: int, local_ty: word) -> void {
    if local_id < 0 {
        give back
    }
    array_set(v4_mir_body_local_tys_handle(mir_id, body_id), local_id, local_ty)
}

task v4_mir_set_local_mode(mir_id: int, body_id: int, local_id: int, local_mode: word) -> void {
    if local_id < 0 {
        give back
    }
    if local_mode == "" {
        local_mode = v4_ty_param_mode_value
    }
    array_set(v4_mir_body_local_modes_handle(mir_id, body_id), local_id, local_mode)
}

task v4_mir_add_place(mir_id: int, body_id: int, place_kind: word, text: word, base: int, field: word, index: int, span: word, place_ty: word) -> int {
    pilot place_id = array_len(v4_mir_body_place_kinds_handle(mir_id, body_id))
    array_push(v4_mir_body_place_kinds_handle(mir_id, body_id), place_kind)
    array_push(v4_mir_body_place_texts_handle(mir_id, body_id), text)
    array_push(v4_mir_body_place_bases_handle(mir_id, body_id), word_from_int(base))
    array_push(v4_mir_body_place_fields_handle(mir_id, body_id), field)
    array_push(v4_mir_body_place_indices_handle(mir_id, body_id), word_from_int(index))
    array_push(v4_mir_body_place_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_place_tys_handle(mir_id, body_id), place_ty)
    give back place_id
}

task v4_mir_add_rvalue(mir_id: int, body_id: int, rvalue_kind: word, text: word, op: word, lhs: int, rhs: int, span: word, rvalue_ty: word) -> int {
    pilot kinds_handle: int = v4_mir_body_rvalue_kinds_handle(mir_id, body_id)
    pilot texts_handle: int = v4_mir_body_rvalue_texts_handle(mir_id, body_id)
    pilot ops_handle: int = v4_mir_body_rvalue_ops_handle(mir_id, body_id)
    pilot lhs_handle: int = v4_mir_body_rvalue_lhs_handle(mir_id, body_id)
    pilot rhs_handle: int = v4_mir_body_rvalue_rhs_handle(mir_id, body_id)
    pilot spans_handle: int = v4_mir_body_rvalue_spans_handle(mir_id, body_id)
    pilot tys_handle: int = v4_mir_body_rvalue_tys_handle(mir_id, body_id)
    pilot abis_handle: int = v4_mir_body_rvalue_abis_handle(mir_id, body_id)
    pilot args_handle: int = v4_mir_body_rvalue_args_handle(mir_id, body_id)
    pilot builtin_methods_handle: int = v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id)
    pilot rvalue_id = array_len(kinds_handle)
    pilot never_count = v4_mir_body_never_summary_begin_write(mir_id, body_id)
    array_push(kinds_handle, rvalue_kind)
    array_push(texts_handle, text)
    array_push(ops_handle, op)
    array_push(lhs_handle, word_from_int(lhs))
    array_push(rhs_handle, word_from_int(rhs))
    array_push(spans_handle, span)
    array_push(tys_handle, rvalue_ty)
    array_push(abis_handle, "")
    array_push(args_handle, "")
    array_push(builtin_methods_handle, "")
    -- A partial append must keep the optional summary cold, even when the
    -- kinds/type columns advanced but another authoritative column did not.
    if never_count >= 0 and array_len(kinds_handle) == rvalue_id + 1 and array_len(texts_handle) == rvalue_id + 1 and array_len(ops_handle) == rvalue_id + 1 and array_len(lhs_handle) == rvalue_id + 1 and array_len(rhs_handle) == rvalue_id + 1 and array_len(spans_handle) == rvalue_id + 1 and array_len(tys_handle) == rvalue_id + 1 and array_len(abis_handle) == rvalue_id + 1 and array_len(args_handle) == rvalue_id + 1 and array_len(builtin_methods_handle) == rvalue_id + 1 {
        if rvalue_ty == v4_ty_never { never_count += 1 }
        v4_mir_publish_body_never_summary(mir_id, body_id, rvalue_id + 1, never_count)
    }
    give back rvalue_id
}

task v4_mir_set_rvalue_abi(mir_id: int, body_id: int, rvalue_id: int, abi: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    array_set(v4_mir_body_rvalue_abis_handle(mir_id, body_id), rvalue_id, abi)
}

task v4_mir_set_rvalue_args_payload(mir_id: int, body_id: int, rvalue_id: int, args_payload: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    array_set(v4_mir_body_rvalue_args_handle(mir_id, body_id), rvalue_id, args_payload)
}

task v4_mir_set_rvalue_builtin_method(mir_id: int, body_id: int, rvalue_id: int, builtin_method: word) -> void {
    if rvalue_id < 0 {
        give back
    }
    if rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) {
        give back
    }
    array_set(v4_mir_body_rvalue_builtin_methods_handle(mir_id, body_id), rvalue_id, builtin_method)
}

task v4_mir_add_local_at_scope(mir_id: int, body_id: int, local_name: word, local_ty: word, span: word, scope_span: word) -> int {
    pilot local_id = array_len(v4_mir_body_local_names_handle(mir_id, body_id))
    array_push(v4_mir_body_local_names_handle(mir_id, body_id), local_name)
    array_push(v4_mir_body_local_tys_handle(mir_id, body_id), local_ty)
    array_push(v4_mir_body_local_modes_handle(mir_id, body_id), v4_ty_param_mode_value)
    array_push(v4_mir_body_local_binding_prefixes_handle(mir_id, body_id), "")
    array_push(v4_mir_body_local_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_local_scope_spans_handle(mir_id, body_id), scope_span)
    give back local_id
}

task v4_mir_add_stmt(mir_id: int, body_id: int, block_id: int, stmt_kind: word, lhs: word, rhs: word, span: word, place_id: int, rvalue_id: int) -> int {
    pilot stmt_id = array_len(v4_mir_body_stmt_kinds_handle(mir_id, body_id))
    array_push(v4_mir_body_stmt_kinds_handle(mir_id, body_id), stmt_kind)
    array_push(v4_mir_body_stmt_lhs_handle(mir_id, body_id), lhs)
    array_push(v4_mir_body_stmt_rhs_handle(mir_id, body_id), rhs)
    array_push(v4_mir_body_stmt_spans_handle(mir_id, body_id), span)
    array_push(v4_mir_body_stmt_scope_spans_handle(mir_id, body_id), v4_mir_block_scope_span(mir_id, body_id, block_id))
    array_push(v4_mir_body_stmt_blocks_handle(mir_id, body_id), word_from_int(block_id))
    array_push(v4_mir_body_stmt_places_handle(mir_id, body_id), word_from_int(place_id))
    array_push(v4_mir_body_stmt_rvalues_handle(mir_id, body_id), word_from_int(rvalue_id))
    v4_mir_block_stmt_added(mir_id, body_id, block_id, stmt_id)
    give back stmt_id
}

task v4_mir_add_body(mir_id: int, def_id: word, body_name: word, signature: word) -> int {
    if not v4_mir_file_exists(mir_id) { give back -1 }
    pilot body_id = array_len(v4_mir_defs_handle(mir_id))
    pilot blocks_handle = array_new()
    pilot local_names_handle = array_new()
    pilot local_tys_handle = array_new()
    pilot local_modes_handle = array_new()
    pilot local_binding_prefixes_handle = array_new()
    pilot local_spans_handle = array_new()
    pilot local_scope_spans_handle = array_new()
    pilot stmt_kinds_handle = array_new()
    pilot stmt_lhs_handle = array_new()
    pilot stmt_rhs_handle = array_new()
    pilot stmt_spans_handle = array_new()
    pilot stmt_scope_spans_handle = array_new()
    pilot stmt_blocks_handle = array_new()
    pilot stmt_places_handle = array_new()
    pilot stmt_rvalues_handle = array_new()
    pilot place_kinds_handle = array_new()
    pilot place_texts_handle = array_new()
    pilot place_bases_handle = array_new()
    pilot place_fields_handle = array_new()
    pilot place_indices_handle = array_new()
    pilot place_spans_handle = array_new()
    pilot place_tys_handle = array_new()
    pilot rvalue_kinds_handle = array_new()
    pilot rvalue_texts_handle = array_new()
    pilot rvalue_ops_handle = array_new()
    pilot rvalue_lhs_handle = array_new()
    pilot rvalue_rhs_handle = array_new()
    pilot rvalue_spans_handle = array_new()
    pilot rvalue_tys_handle = array_new()
    pilot rvalue_abis_handle = array_new()
    pilot rvalue_args_handle = array_new()
    pilot rvalue_builtin_methods_handle = array_new()
    if blocks_handle < 0 or local_names_handle < 0 or local_tys_handle < 0 or local_modes_handle < 0 or local_binding_prefixes_handle < 0 or local_spans_handle < 0 or local_scope_spans_handle < 0 or stmt_kinds_handle < 0 or stmt_lhs_handle < 0 or stmt_rhs_handle < 0 or stmt_spans_handle < 0 or stmt_scope_spans_handle < 0 or stmt_blocks_handle < 0 or stmt_places_handle < 0 or stmt_rvalues_handle < 0 or place_kinds_handle < 0 or place_texts_handle < 0 or place_bases_handle < 0 or place_fields_handle < 0 or place_indices_handle < 0 or place_spans_handle < 0 or place_tys_handle < 0 or rvalue_kinds_handle < 0 or rvalue_texts_handle < 0 or rvalue_ops_handle < 0 or rvalue_lhs_handle < 0 or rvalue_rhs_handle < 0 or rvalue_spans_handle < 0 or rvalue_tys_handle < 0 or rvalue_abis_handle < 0 or rvalue_args_handle < 0 or rvalue_builtin_methods_handle < 0 {
        array_release(blocks_handle)
        array_release(local_names_handle)
        array_release(local_tys_handle)
        array_release(local_modes_handle)
        array_release(local_binding_prefixes_handle)
        array_release(local_spans_handle)
        array_release(local_scope_spans_handle)
        array_release(stmt_kinds_handle)
        array_release(stmt_lhs_handle)
        array_release(stmt_rhs_handle)
        array_release(stmt_spans_handle)
        array_release(stmt_scope_spans_handle)
        array_release(stmt_blocks_handle)
        array_release(stmt_places_handle)
        array_release(stmt_rvalues_handle)
        array_release(place_kinds_handle)
        array_release(place_texts_handle)
        array_release(place_bases_handle)
        array_release(place_fields_handle)
        array_release(place_indices_handle)
        array_release(place_spans_handle)
        array_release(place_tys_handle)
        array_release(rvalue_kinds_handle)
        array_release(rvalue_texts_handle)
        array_release(rvalue_ops_handle)
        array_release(rvalue_lhs_handle)
        array_release(rvalue_rhs_handle)
        array_release(rvalue_spans_handle)
        array_release(rvalue_tys_handle)
        array_release(rvalue_abis_handle)
        array_release(rvalue_args_handle)
        array_release(rvalue_builtin_methods_handle)
        give back -1
    }
    if not v4_mir_restore_building {
        array_push(blocks_handle, v4_mir_block_new(0, v4_mir_term_return, 0 - 1))
    }
    array_push(v4_mir_defs_handle(mir_id), def_id)
    array_push(v4_mir_names_handle(mir_id), body_name)
    array_push(v4_mir_sigs_handle(mir_id), signature)
    array_push(v4_mir_blocks_handle(mir_id), word_from_int(blocks_handle))
    array_push(v4_mir_local_names_index_handle(mir_id), word_from_int(local_names_handle))
    array_push(v4_mir_local_tys_index_handle(mir_id), word_from_int(local_tys_handle))
    array_push(v4_mir_local_modes_index_handle(mir_id), word_from_int(local_modes_handle))
    array_push(v4_mir_local_binding_prefixes_index_handle(mir_id), word_from_int(local_binding_prefixes_handle))
    array_push(v4_mir_local_spans_index_handle(mir_id), word_from_int(local_spans_handle))
    array_push(v4_mir_local_scope_spans_index_handle(mir_id), word_from_int(local_scope_spans_handle))
    array_push(v4_mir_stmt_kinds_index_handle(mir_id), word_from_int(stmt_kinds_handle))
    array_push(v4_mir_stmt_lhs_index_handle(mir_id), word_from_int(stmt_lhs_handle))
    array_push(v4_mir_stmt_rhs_index_handle(mir_id), word_from_int(stmt_rhs_handle))
    array_push(v4_mir_stmt_spans_index_handle(mir_id), word_from_int(stmt_spans_handle))
    array_push(v4_mir_stmt_scope_spans_index_handle(mir_id), word_from_int(stmt_scope_spans_handle))

    array_push(v4_mir_stmt_blocks_index_handle(mir_id), word_from_int(stmt_blocks_handle))
    array_push(v4_mir_stmt_places_index_handle(mir_id), word_from_int(stmt_places_handle))
    array_push(v4_mir_stmt_rvalues_index_handle(mir_id), word_from_int(stmt_rvalues_handle))
    array_push(v4_mir_place_kinds_index_handle(mir_id), word_from_int(place_kinds_handle))
    array_push(v4_mir_place_texts_index_handle(mir_id), word_from_int(place_texts_handle))
    array_push(v4_mir_place_bases_index_handle(mir_id), word_from_int(place_bases_handle))
    array_push(v4_mir_place_fields_index_handle(mir_id), word_from_int(place_fields_handle))
    array_push(v4_mir_place_indices_index_handle(mir_id), word_from_int(place_indices_handle))
    array_push(v4_mir_place_spans_index_handle(mir_id), word_from_int(place_spans_handle))
    array_push(v4_mir_place_tys_index_handle(mir_id), word_from_int(place_tys_handle))
    array_push(v4_mir_rvalue_kinds_index_handle(mir_id), word_from_int(rvalue_kinds_handle))
    array_push(v4_mir_rvalue_texts_index_handle(mir_id), word_from_int(rvalue_texts_handle))
    array_push(v4_mir_rvalue_ops_index_handle(mir_id), word_from_int(rvalue_ops_handle))
    array_push(v4_mir_rvalue_lhs_index_handle(mir_id), word_from_int(rvalue_lhs_handle))
    array_push(v4_mir_rvalue_rhs_index_handle(mir_id), word_from_int(rvalue_rhs_handle))
    array_push(v4_mir_rvalue_spans_index_handle(mir_id), word_from_int(rvalue_spans_handle))
    array_push(v4_mir_rvalue_tys_index_handle(mir_id), word_from_int(rvalue_tys_handle))
    array_push(v4_mir_rvalue_abis_index_handle(mir_id), word_from_int(rvalue_abis_handle))
    array_push(v4_mir_rvalue_args_index_handle(mir_id), word_from_int(rvalue_args_handle))
    array_push(v4_mir_rvalue_builtin_methods_index_handle(mir_id), word_from_int(rvalue_builtin_methods_handle))
    if not v4_mir_restore_building {
        v4_mir_body_lookup_added(mir_id, body_id)
        v4_mir_finalize_block_stmt_index(mir_id, body_id)
        v4_mir_finalize_body_never_summary(mir_id, body_id)
    }
    give back body_id
}

task v4_mir_name_list_range_equals(names: word, start_idx: int, end_idx: int, wanted: word) -> bool {
    if end_idx - start_idx != wanted.length() {
        give back false
    }

    pilot offset = 0
    repeat until start_idx + offset >= end_idx {
        if names.char_at(start_idx + offset) != wanted.char_at(offset) {
            give back false
        }
        offset += 1
    }
    give back true
}

task v4_mir_name_list_contains(names: word, wanted: word) -> bool {
    if names == "" or wanted == "" {
        give back false
    }

    pilot segment_start = 0
    pilot idx = 0
    repeat until idx >= names.length() {
        if names.char_at(idx) == "|" {
            if v4_mir_name_list_range_equals(names, segment_start, idx, wanted) {
                give back true
            }
            segment_start = idx + 1
        }
        idx += 1
    }
    give back v4_mir_name_list_range_equals(names, segment_start, names.length(), wanted)
}

task v4_mir_name_list_add(names: word, wanted: word) -> word {
    if wanted == "" {
        give back names
    }
    if v4_mir_name_list_contains(names, wanted) {
        give back names
    }
    if names == "" {
        give back wanted
    }
    give back names + "|" + wanted
}

task v4_mir_expected_return_type(mir_id: int, body_id: int) -> word {
    give back v4_mir_body_callable_return_type(mir_id, body_id)
}

task v4_mir_body_signature_id(mir_id: int, body_id: int) -> int {
    give back v4_ty_lookup_signature(v4_mir_ty_id(mir_id), v4_mir_body_def(mir_id, body_id))
}

-- Callable facts include concrete impl bodies without inventing ordinary TY
-- signature rows. The ordinary-only signature accessor above remains the gate
-- for generic/lifetime and returned-loan contracts. These facts describe the
-- declared method; they do not monomorphize generic impls or define an aggregate ABI.
task v4_mir_body_impl_method_index(mir_id: int, body_id: int, part: int) -> int {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back 0 - 1
    }
    pilot def = v4_mir_body_def(mir_id, body_id)
    if v4_mir_def_is_generic_instance(def) { def = v4_mir_generic_def_base(def) }
    give back v4_ty_impl_method_index_for_def(v4_mir_ty_id(mir_id), def, part)
}

-- An impl whose target names its own type parameters, such as
-- `impl Box<T>`: its methods are templates, lowered per concrete owner.
task v4_mir_impl_is_generic(ty_id: int, hir_item: int) -> bool {
    if hir_item < 0 { give back false }
    pilot target = v4_ty_impl_target_type_from_hir(ty_id, hir_item)
    if not v4_ty_is_generic_instance_type(target) { give back false }
    pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, target)
    if sig_id < 0 { sig_id = v4_ty_route_signature_id_for_name(ty_id, target) }
    give back sig_id >= 0 and v4_ty_signature_generic_count(ty_id, sig_id) > 0 and not v4_mir_type_is_concrete(ty_id, target, 0)
}

-- An impl method type seen from its body: substituted in an instance.
task v4_mir_body_impl_type(mir_id: int, body_id: int, type_text: word) -> word {
    if not v4_mir_body_is_generic_instance(mir_id, body_id) { give back type_text }
    give back v4_mir_body_generic_type(mir_id, body_id, type_text)
}

-- The synthetic bootstrap-mode module initializer: void, no parameters,
-- language ABI, run once before main. Its def has no TY signature row.
pilot v4_mir_module_init_name = "freak.module.init"
pilot v4_mir_module_init_def = "module-init"

-- Bootstrap root globals are TY global signatures; MIR names them for codegen.
task v4_mir_symbol_global_sig(mir_id: int, name: word) -> int {
    if not v4_mir_file_exists(mir_id) or name == "" { give back 0 - 1 }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig = v4_ty_const_signature_id_for_name(ty_id, name)
    if sig >= 0 and v4_ty_signature_kind(ty_id, sig) == v4_ty_global_sig { give back sig }
    give back 0 - 1
}

task v4_mir_symbol_is_global(mir_id: int, name: word) -> bool {
    give back v4_mir_symbol_global_sig(mir_id, name) >= 0
}

-- Globals in TY signature order (source order within the file).
task v4_mir_global_count(mir_id: int) -> int {
    if not v4_mir_file_exists(mir_id) { give back 0 }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot count = 0
    pilot sig = 0
    repeat until sig >= v4_ty_signature_count(ty_id) {
        if v4_ty_signature_kind(ty_id, sig) == v4_ty_global_sig { count += 1 }
        sig += 1
    }
    give back count
}

task v4_mir_global_sig_at(mir_id: int, wanted: int) -> int {
    if not v4_mir_file_exists(mir_id) or wanted < 0 { give back 0 - 1 }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot seen = 0
    pilot sig = 0
    repeat until sig >= v4_ty_signature_count(ty_id) {
        if v4_ty_signature_kind(ty_id, sig) == v4_ty_global_sig {
            if seen == wanted { give back sig }
            seen += 1
        }
        sig += 1
    }
    give back 0 - 1
}

task v4_mir_global_name(mir_id: int, wanted: int) -> word {
    pilot sig = v4_mir_global_sig_at(mir_id, wanted)
    if sig < 0 { give back "" }
    give back v4_ty_signature_name(v4_mir_ty_id(mir_id), sig)
}

task v4_mir_global_ty(mir_id: int, wanted: int) -> word {
    pilot sig = v4_mir_global_sig_at(mir_id, wanted)
    if sig < 0 { give back v4_ty_unknown }
    give back v4_ty_const_value_type_for_sig(v4_mir_ty_id(mir_id), sig)
}

task v4_mir_body_is_module_init(mir_id: int, body_id: int) -> bool {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) { give back false }
    give back v4_mir_body_def(mir_id, body_id) == v4_mir_module_init_def and v4_mir_body_name(mir_id, body_id) == v4_mir_module_init_name
}

task v4_mir_module_init_body(mir_id: int) -> int {
    if not v4_mir_file_exists(mir_id) { give back 0 - 1 }
    pilot body_id = v4_mir_body_count(mir_id) - 1
    repeat until body_id < 0 {
        if v4_mir_body_is_module_init(mir_id, body_id) { give back body_id }
        body_id -= 1
    }
    give back 0 - 1
}

-- Closure bodies (tier 3). A closure lowers to its own callable body whose
-- def names the creating body, the closure's source offset and its capture
-- count: "closure:<parent def>@<offset>#<captures>". The body's signature is
-- the closure type (with its inferred return type). Its locals start with the
-- closure parameters, in order, then one local per capture in capture order:
-- a `lend` local for a default (borrow) capture, a `lend mut` local for a mut
-- capture, and a value local for a copy or move capture. These are the sealed
-- facts codegen reads; it never rediscovers a capture or its mode.
pilot v4_mir_closure_def_prefix = "closure:"

task v4_mir_closure_body_def(parent_def: word, offset: int, capture_count: int) -> word {
    give back v4_mir_closure_def_prefix + parent_def + "@" + word_from_int(offset) + "#" + word_from_int(capture_count)
}

task v4_mir_body_is_closure(mir_id: int, body_id: int) -> bool {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) { give back false }
    give back v4_mir_body_def(mir_id, body_id).starts_with(v4_mir_closure_def_prefix) and v4_ty_is_closure_type(v4_mir_body_signature(mir_id, body_id))
}

task v4_mir_closure_def_last(def: word, wanted: word) -> int {
    pilot idx = def.length() - 1
    repeat until idx < 0 {
        if def.char_at(idx) == wanted { give back idx }
        idx -= 1
    }
    give back 0 - 1
}

-- The def of the body a closure body was lowered from, or "".
task v4_mir_closure_body_parent_def(mir_id: int, body_id: int) -> word {
    if not v4_mir_body_is_closure(mir_id, body_id) { give back "" }
    pilot def = v4_mir_body_def(mir_id, body_id)
    pilot at = v4_mir_closure_def_last(def, "@")
    if at <= v4_mir_closure_def_prefix.length() { give back "" }
    give back v4_slice(def, v4_mir_closure_def_prefix.length(), at)
}

-- The TY signature whose HIR item, generics and annotations a body's source
-- belongs to: its own, or for a closure body the signature it was lowered in.
task v4_mir_body_context_signature_id(mir_id: int, body_id: int) -> int {
    if v4_mir_body_is_closure(mir_id, body_id) {
        pilot root = v4_mir_closure_def_root(v4_mir_closure_body_parent_def(mir_id, body_id))
        -- A closure lowered in a generic instance reads the generic signature.
        if v4_mir_def_is_generic_instance(root) { root = v4_mir_generic_def_base(root) }
        give back v4_ty_lookup_signature(v4_mir_ty_id(mir_id), root)
    }
    if v4_mir_body_is_generic_instance(mir_id, body_id) { give back v4_mir_body_generic_signature_id(mir_id, body_id) }
    give back v4_mir_body_signature_id(mir_id, body_id)
}

-- The task def a closure def was lowered in: a nested closure's parent is
-- itself a closure def, `closure:<parent>@<offset>#<captures>`.
task v4_mir_closure_def_root(def: word) -> word {
    pilot root = def
    pilot depth = 0
    repeat until not root.starts_with(v4_mir_closure_def_prefix) or depth > 64 {
        pilot at = v4_mir_closure_def_last(root, "@")
        if at <= v4_mir_closure_def_prefix.length() { give back "" }
        root = v4_slice(root, v4_mir_closure_def_prefix.length(), at)
        depth += 1
    }
    give back root
}

-- The capture count sealed in a closure body's def, or -1.
task v4_mir_body_closure_capture_count(mir_id: int, body_id: int) -> int {
    if not v4_mir_body_is_closure(mir_id, body_id) { give back 0 - 1 }
    pilot def = v4_mir_body_def(mir_id, body_id)
    pilot hash = v4_mir_closure_def_last(def, "#")
    if hash < 0 { give back 0 - 1 }
    pilot raw = v4_slice(def, hash + 1, def.length())
    if not v4_mir_snapshot_nonnegative_int_is_valid(raw) { give back 0 - 1 }
    pilot count = word_to_int(raw)
    if word_from_int(count) != raw { give back 0 - 1 }
    if v4_mir_body_callable_param_count(mir_id, body_id) + count > v4_mir_body_local_count(mir_id, body_id) { give back 0 - 1 }
    give back count
}

-- The closure body local holding capture `capture_id`, or -1.
task v4_mir_body_closure_capture_local(mir_id: int, body_id: int, capture_id: int) -> int {
    pilot count = v4_mir_body_closure_capture_count(mir_id, body_id)
    if capture_id < 0 or capture_id >= count { give back 0 - 1 }
    give back v4_mir_body_callable_param_count(mir_id, body_id) + capture_id
}

-- True when a closure body local is one of its captures.
task v4_mir_body_local_is_closure_capture(mir_id: int, body_id: int, local_id: int) -> bool {
    pilot count = v4_mir_body_closure_capture_count(mir_id, body_id)
    if count <= 0 { give back false }
    pilot first = v4_mir_body_callable_param_count(mir_id, body_id)
    give back local_id >= first and local_id < first + count
}

-- The closure body a Closure rvalue created, or -1 when none was lowered.
task v4_mir_closure_rvalue_body(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_closure { give back 0 - 1 }
    pilot def = v4_mir_closure_body_def(v4_mir_body_def(mir_id, body_id), v4_span_start(v4_mir_rvalue_span(mir_id, body_id, rvalue_id)), v4_mir_closure_capture_count(mir_id, body_id, rvalue_id))
    pilot closure_body = v4_mir_lookup_body(mir_id, def)
    if closure_body < 0 or not v4_mir_body_is_closure(mir_id, closure_body) { give back 0 - 1 }
    give back closure_body
}

-- The creating body's local that capture `capture_id` of a Closure rvalue
-- names: the binding visible where the closure starts, as MIR Build chose it.
task v4_mir_closure_capture_local(mir_id: int, body_id: int, rvalue_id: int, capture_id: int) -> int {
    pilot capture = v4_mir_closure_capture(mir_id, body_id, rvalue_id, capture_id)
    if capture < 0 { give back 0 - 1 }
    -- The local this closure initializes is declared after its initializer
    -- was lowered, so it was not visible to the capture: skip it.
    pilot bound = 0 - 1
    pilot stmt = 0
    repeat until stmt >= v4_mir_body_stmt_count(mir_id, body_id) or bound >= 0 {
        if v4_mir_stmt_kind(mir_id, body_id, stmt) == v4_mir_stmt_local and v4_mir_stmt_rvalue(mir_id, body_id, stmt) == rvalue_id {
            pilot place = v4_mir_stmt_place(mir_id, body_id, stmt)
            if place >= 0 and v4_mir_place_kind(mir_id, body_id, place) == v4_mir_place_local { bound = v4_mir_place_base(mir_id, body_id, place) }
        }
        stmt += 1
    }
    pilot name = v4_mir_rvalue_text(mir_id, body_id, capture)
    pilot offset = v4_span_start(v4_mir_rvalue_span(mir_id, body_id, rvalue_id))
    pilot local_id = v4_mir_body_local_count(mir_id, body_id)
    repeat until local_id <= 0 {
        local_id -= 1
        if local_id != bound and v4_mir_local_name(mir_id, body_id, local_id) == name and v4_mir_local_visible_at(mir_id, body_id, local_id, offset) {
            if v4_mir_local_ty(mir_id, body_id, local_id) != v4_mir_rvalue_ty(mir_id, body_id, capture) { give back 0 - 1 }
            give back local_id
        }
    }
    give back 0 - 1
}

-- The callee of a call through a closure value: the call's target child,
-- whose type is a closure type. Its doctrine names the call path.
task v4_mir_rvalue_closure_callee(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call { give back 0 - 1 }
    pilot lhs = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    if lhs < 0 or lhs >= rvalue_id or not v4_ty_is_closure_type(v4_mir_rvalue_ty(mir_id, body_id, lhs)) { give back 0 - 1 }
    give back lhs
}

-- Callable, MutCallable or OneShot for a closure call, "" otherwise.
task v4_mir_closure_call_doctrine(mir_id: int, body_id: int, rvalue_id: int) -> word {
    pilot callee = v4_mir_rvalue_closure_callee(mir_id, body_id, rvalue_id)
    if callee < 0 { give back "" }
    give back v4_ty_closure_doctrine(v4_mir_rvalue_ty(mir_id, body_id, callee))
}

-- Dyn doctrine facts (tier 3). MIR Build seals them once a module is
-- lowered; codegen reads them and never looks up an
-- impl. One process-wide table of tab-separated records keyed by MIR id,
-- allocated on the first fact, so a module without `dyn` costs no handle:
--   V mir vtable concrete doctrine type_id slot-body...  one vtable per
--     (concrete type, doctrine) pair erased in the module; slot k is the
--     impl body of the doctrine's k-th method in declaration order
--   E mir body rvalue vtable  a Lend/LendMut that erases a concrete place
--     into `lend dyn D` / `lend mut dyn D` through that vtable
--   C mir body rvalue slot    a call dispatched through vtable slot `slot`
--   D mir index doctrine slots  a doctrine some vtable or sealed call uses,
--     so its vtable type exists even in a module that only dispatches
pilot v4_mir_dyn_facts = 0 - 1
-- Lowest cell that may hold a tombstone.
pilot v4_mir_dyn_free_hint = 0
-- Restored MIR slots whose sealed dyn facts the restore dropped.
pilot v4_mir_dyn_restore_drops = 0

task v4_mir_dyn_record_field(record: word, wanted: int) -> word {
    pilot start = 0
    pilot field = 0
    repeat until field >= wanted {
        pilot tab = v4_index_of_from(record, "\t", start)
        if tab < 0 { give back "" }
        start = tab + 1
        field += 1
    }
    pilot stop = v4_index_of_from(record, "\t", start)
    if stop < 0 { stop = record.length() }
    give back v4_slice(record, start, stop)
}

task v4_mir_dyn_record_field_count(record: word) -> int {
    pilot count = 1
    pilot start = v4_index_of_from(record, "\t", 0)
    repeat until start < 0 {
        count += 1
        start = v4_index_of_from(record, "\t", start + 1)
    }
    give back count
}

-- Drop every fact of one MIR id (a fresh lowering or a restored slot).
task v4_mir_dyn_facts_clear(mir_id: int) -> void {
    if v4_mir_dyn_facts < 0 { give back }
    -- Tombstone in place so the clear cannot fail on allocation: an empty
    -- record matches no prefix, so readers and the digest skip it. The
    -- next insert reuses the cell.
    pilot key = "\t" + word_from_int(mir_id) + "\t"
    pilot idx = 0
    repeat until idx >= array_len(v4_mir_dyn_facts) {
        pilot record: word = array_get(v4_mir_dyn_facts, idx)
        if v4_slice(record, 1, 1 + key.length()) == key {
            array_set(v4_mir_dyn_facts, idx, "")
            if idx < v4_mir_dyn_free_hint { v4_mir_dyn_free_hint = idx }
        }
        idx += 1
    }
}

-- Cells in the fact table, tombstones included.
task v4_mir_dyn_fact_cell_count() -> int {
    if v4_mir_dyn_facts < 0 { give back 0 }
    give back array_len(v4_mir_dyn_facts)
}

-- True when some fact of this MIR id is sealed.
task v4_mir_dyn_facts_present(mir_id: int) -> bool {
    if v4_mir_dyn_facts < 0 { give back false }
    pilot key = "\t" + word_from_int(mir_id) + "\t"
    pilot idx = 0
    repeat until idx >= array_len(v4_mir_dyn_facts) {
        pilot record: word = array_get(v4_mir_dyn_facts, idx)
        if v4_slice(record, 1, 1 + key.length()) == key { give back true }
        idx += 1
    }
    give back false
}

task v4_mir_dyn_add_record(record: word) -> bool {
    if v4_mir_dyn_facts < 0 { v4_mir_dyn_facts = array_new() }
    if v4_mir_dyn_facts < 0 { give back false }
    -- Reuse the first tombstone at or after the hint, so reseals do not grow
    -- the table.
    pilot idx = v4_mir_dyn_free_hint
    if idx < 0 { idx = 0 }
    repeat until idx >= array_len(v4_mir_dyn_facts) {
        pilot cell: word = array_get(v4_mir_dyn_facts, idx)
        if cell == "" {
            array_set(v4_mir_dyn_facts, idx, record)
            v4_mir_dyn_free_hint = idx + 1
            give back true
        }
        idx += 1
    }
    array_push(v4_mir_dyn_facts, record)
    v4_mir_dyn_free_hint = array_len(v4_mir_dyn_facts)
    give back true
}

-- The record whose prefix is `prefix`, or "".
task v4_mir_dyn_find(prefix: word) -> word {
    if v4_mir_dyn_facts < 0 { give back "" }
    pilot idx = 0
    repeat until idx >= array_len(v4_mir_dyn_facts) {
        pilot record: word = array_get(v4_mir_dyn_facts, idx)
        if record.starts_with(prefix) { give back record }
        idx += 1
    }
    give back ""
}

task v4_mir_dyn_vtable_record(mir_id: int, vtable_id: int) -> word {
    if vtable_id < 0 { give back "" }
    give back v4_mir_dyn_find("V\t" + word_from_int(mir_id) + "\t" + word_from_int(vtable_id) + "\t")
}

task v4_mir_dyn_vtable_count(mir_id: int) -> int {
    pilot count = 0
    repeat until v4_mir_dyn_vtable_record(mir_id, count) == "" { count += 1 }
    give back count
}

-- The vtable already sealed for (concrete, doctrine), or -1.
task v4_mir_dyn_vtable_for(mir_id: int, concrete: word, doctrine_name: word) -> int {
    pilot vtable_id = 0
    pilot count = v4_mir_dyn_vtable_count(mir_id)
    repeat until vtable_id >= count {
        if v4_mir_dyn_vtable_concrete(mir_id, vtable_id) == concrete and v4_mir_dyn_vtable_doctrine(mir_id, vtable_id) == doctrine_name { give back vtable_id }
        vtable_id += 1
    }
    give back 0 - 1
}

task v4_mir_dyn_vtable_concrete(mir_id: int, vtable_id: int) -> word {
    give back v4_mir_dyn_record_field(v4_mir_dyn_vtable_record(mir_id, vtable_id), 3)
}

task v4_mir_dyn_vtable_doctrine(mir_id: int, vtable_id: int) -> word {
    give back v4_mir_dyn_record_field(v4_mir_dyn_vtable_record(mir_id, vtable_id), 4)
}

-- A small id per concrete type erased in the module (bible 1.6 type_id).
task v4_mir_dyn_vtable_type_id(mir_id: int, vtable_id: int) -> int {
    pilot raw = v4_mir_dyn_record_field(v4_mir_dyn_vtable_record(mir_id, vtable_id), 5)
    if raw == "" { give back 0 - 1 }
    give back word_to_int(raw)
}

task v4_mir_dyn_vtable_slot_count(mir_id: int, vtable_id: int) -> int {
    pilot record = v4_mir_dyn_vtable_record(mir_id, vtable_id)
    if record == "" { give back 0 - 1 }
    give back v4_mir_dyn_record_field_count(record) - 6
}

-- The impl body of slot `slot`, or -1 when the impl has no such method.
task v4_mir_dyn_vtable_slot_body(mir_id: int, vtable_id: int, slot: int) -> int {
    if slot < 0 or slot >= v4_mir_dyn_vtable_slot_count(mir_id, vtable_id) { give back 0 - 1 }
    give back word_to_int(v4_mir_dyn_record_field(v4_mir_dyn_vtable_record(mir_id, vtable_id), 6 + slot))
}

-- slot_bodies: one body id per doctrine method, tab-separated.
task v4_mir_dyn_add_vtable(mir_id: int, concrete: word, doctrine_name: word, type_id: int, slot_bodies: word) -> int {
    pilot vtable_id = v4_mir_dyn_vtable_count(mir_id)
    pilot record = "V\t" + word_from_int(mir_id) + "\t" + word_from_int(vtable_id) + "\t" + concrete + "\t" + doctrine_name + "\t" + word_from_int(type_id)
    if slot_bodies != "" { record = record + "\t" + slot_bodies }
    if not v4_mir_dyn_add_record(record) { give back 0 - 1 }
    give back vtable_id
}

task v4_mir_dyn_doctrine_record(mir_id: int, index: int) -> word {
    if index < 0 { give back "" }
    give back v4_mir_dyn_find("D\t" + word_from_int(mir_id) + "\t" + word_from_int(index) + "\t")
}

-- Doctrines whose vtable type the module needs, in first-use order.
task v4_mir_dyn_doctrine_count(mir_id: int) -> int {
    pilot count = 0
    repeat until v4_mir_dyn_doctrine_record(mir_id, count) == "" { count += 1 }
    give back count
}

task v4_mir_dyn_doctrine_name(mir_id: int, index: int) -> word {
    give back v4_mir_dyn_record_field(v4_mir_dyn_doctrine_record(mir_id, index), 3)
}

task v4_mir_dyn_doctrine_slot_count(mir_id: int, index: int) -> int {
    pilot raw = v4_mir_dyn_record_field(v4_mir_dyn_doctrine_record(mir_id, index), 4)
    if raw == "" { give back 0 - 1 }
    give back word_to_int(raw)
}

-- Record that the module uses doctrine `doctrine_name` (with `slots` methods)
-- once; gives back its index, or -1.
task v4_mir_dyn_add_doctrine(mir_id: int, doctrine_name: word, slots: int) -> int {
    pilot count = v4_mir_dyn_doctrine_count(mir_id)
    pilot index = 0
    repeat until index >= count {
        if v4_mir_dyn_doctrine_name(mir_id, index) == doctrine_name { give back index }
        index += 1
    }
    if not v4_mir_dyn_add_record("D\t" + word_from_int(mir_id) + "\t" + word_from_int(count) + "\t" + doctrine_name + "\t" + word_from_int(slots)) { give back 0 - 1 }
    give back count
}

-- Every fact of one MIR id, for borrow-check result digests: a cached result
-- must not survive a change of the sealed dyn facts.
task v4_mir_dyn_facts_digest(mir_id: int) -> word {
    if v4_mir_dyn_facts < 0 { give back "" }
    pilot parts = array_new()
    if parts < 0 { give back "" }
    pilot key = "\t" + word_from_int(mir_id) + "\t"
    pilot idx = 0
    repeat until idx >= array_len(v4_mir_dyn_facts) {
        pilot record: word = array_get(v4_mir_dyn_facts, idx)
        if v4_slice(record, 1, 1 + key.length()) == key { array_push(parts, record + "\n") }
        idx += 1
    }
    pilot out = word_join(parts)
    array_release(parts)
    give back out
}

task v4_mir_dyn_rvalue_key(kind: word, mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back kind + "\t" + word_from_int(mir_id) + "\t" + word_from_int(body_id) + "\t" + word_from_int(rvalue_id) + "\t"
}

task v4_mir_dyn_add_erase(mir_id: int, body_id: int, rvalue_id: int, vtable_id: int) -> bool {
    give back v4_mir_dyn_add_record(v4_mir_dyn_rvalue_key("E", mir_id, body_id, rvalue_id) + word_from_int(vtable_id))
}

task v4_mir_dyn_add_call(mir_id: int, body_id: int, rvalue_id: int, slot: int) -> bool {
    give back v4_mir_dyn_add_record(v4_mir_dyn_rvalue_key("C", mir_id, body_id, rvalue_id) + word_from_int(slot))
}

-- The vtable a Lend/LendMut erases its concrete place through, or -1.
task v4_mir_dyn_erase_vtable(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if v4_mir_dyn_facts < 0 { give back 0 - 1 }
    pilot record = v4_mir_dyn_find(v4_mir_dyn_rvalue_key("E", mir_id, body_id, rvalue_id))
    if record == "" { give back 0 - 1 }
    give back word_to_int(v4_mir_dyn_record_field(record, 4))
}

-- The vtable slot a dyn method call dispatches through, or -1.
task v4_mir_dyn_call_slot(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if v4_mir_dyn_facts < 0 { give back 0 - 1 }
    pilot record = v4_mir_dyn_find(v4_mir_dyn_rvalue_key("C", mir_id, body_id, rvalue_id))
    if record == "" { give back 0 - 1 }
    give back word_to_int(v4_mir_dyn_record_field(record, 4))
}

-- Generic instances (tier 3, monomorphization). Native MIR Build lowers one
-- body per distinct instance of a generic task (the callee's TY signature
-- plus its concrete type arguments) and per concrete owner of a generic impl
-- method. The substitution is the sealed fact:
--   def   "generic:<generic def> with <env>", env "T=int|U=word" in the
--         signature's type-generic order (lifetimes are erased), or in the
--         impl target's order for a method;
--   name  "<callee><int,word>" for a task and "Box<int>::get" for a method,
--         which is also the LLVM symbol;
--   call  a generic call's op names the instance body (a method call keeps
--         its "Box<int>.get" op, which codegen reads as Box<int>::get), so
--         the call carries its substitution through compaction and snapshots.
-- An instance body's locals, places and rvalues hold concrete types, and its
-- callable facts below answer with the env applied. The generic body itself
-- (the template) stays in MIR for diagnostics and Meiya, and native codegen
-- never emits it (v4_mir_body_is_generic_template).
pilot v4_mir_generic_def_prefix = "generic:"
pilot v4_mir_generic_def_env_mark = " with "

task v4_mir_generic_instance_def(generic_def: word, env: word) -> word {
    give back v4_mir_generic_def_prefix + generic_def + v4_mir_generic_def_env_mark + env
}

-- The signature text an instance body carries: its symbol and the generic
-- signature it was built from. Snapshot validation rebuilds it to match.
task v4_mir_generic_instance_signature(name: word, display: word) -> word {
    give back "task " + name + " from " + display
}

-- Where the env starts. Defs carry no spaces, while an impl method def may
-- spell its owner with angle brackets, so the mark is a spaced word.
task v4_mir_generic_def_env_at(def: word) -> int {
    if not def.starts_with(v4_mir_generic_def_prefix) { give back 0 - 1 }
    pilot mark = v4_mir_generic_def_env_mark
    pilot idx = v4_mir_generic_def_prefix.length()
    repeat until idx + mark.length() > def.length() {
        if def.char_at(idx) == " " {
            if v4_slice(def, idx, idx + mark.length()) == mark { give back idx }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_def_is_generic_instance(def: word) -> bool {
    give back v4_mir_generic_def_env_at(def) > v4_mir_generic_def_prefix.length()
}

task v4_mir_generic_def_base(def: word) -> word {
    pilot at = v4_mir_generic_def_env_at(def)
    if at <= v4_mir_generic_def_prefix.length() { give back "" }
    give back v4_slice(def, v4_mir_generic_def_prefix.length(), at)
}

task v4_mir_generic_def_env(def: word) -> word {
    pilot at = v4_mir_generic_def_env_at(def)
    if at <= v4_mir_generic_def_prefix.length() { give back "" }
    give back v4_slice(def, at + v4_mir_generic_def_env_mark.length(), def.length())
}

task v4_mir_body_is_generic_instance(mir_id: int, body_id: int) -> bool {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) { give back false }
    give back v4_mir_def_is_generic_instance(v4_mir_body_def(mir_id, body_id))
}

-- The def of the generic task an instance body was made from, or "".
task v4_mir_body_generic_def(mir_id: int, body_id: int) -> word {
    if not v4_mir_body_is_generic_instance(mir_id, body_id) { give back "" }
    give back v4_mir_generic_def_base(v4_mir_body_def(mir_id, body_id))
}

-- The substitution an instance body was lowered under, or "".
task v4_mir_body_generic_env(mir_id: int, body_id: int) -> word {
    if not v4_mir_body_is_generic_instance(mir_id, body_id) { give back "" }
    give back v4_mir_generic_def_env(v4_mir_body_def(mir_id, body_id))
}

-- The TY task a call op names: an ordinary task by name, or for an instance
-- name "f<A,B>" the generic task f, with the env its type arguments bind.
-- These read only TY and the op, so row validators without a MIR id agree
-- with the body facts above.
task v4_mir_task_call_signature(ty_id: int, op: word) -> int {
    pilot sig_id = v4_ty_task_signature_id_for_name(ty_id, op)
    if sig_id >= 0 or not v4_ty_is_generic_instance_type(op) { give back sig_id }
    sig_id = v4_ty_task_signature_id_for_name(ty_id, v4_ty_generic_base_name(op))
    if sig_id < 0 or v4_ty_signature_type_generic_count(ty_id, sig_id) != v4_ty_generic_arg_count(op) { give back 0 - 1 }
    give back sig_id
}

task v4_mir_task_call_env(ty_id: int, op: word) -> word {
    if v4_ty_task_signature_id_for_name(ty_id, op) >= 0 { give back "" }
    pilot sig_id = v4_mir_task_call_signature(ty_id, op)
    if sig_id < 0 { give back "" }
    pilot env = ""
    pilot arg = 0
    pilot generic_id = 0
    repeat until generic_id >= v4_ty_signature_generic_count(ty_id, sig_id) {
        if not v4_ty_signature_generic_is_lifetime(ty_id, sig_id, generic_id) {
            if env != "" { env = env + "|" }
            env = env + v4_ty_signature_generic_name(ty_id, sig_id, generic_id) + "=" + v4_ty_generic_arg(op, arg)
            arg += 1
        }
        generic_id += 1
    }
    give back env
}

-- The body def a call op must name: the task's def, or its instance def.
task v4_mir_task_call_def(ty_id: int, op: word) -> word {
    pilot sig_id = v4_mir_task_call_signature(ty_id, op)
    if sig_id < 0 { give back "" }
    pilot env = v4_mir_task_call_env(ty_id, op)
    if env == "" { give back v4_ty_signature_def(ty_id, sig_id) }
    give back v4_mir_generic_instance_def(v4_ty_signature_def(ty_id, sig_id), env)
}

-- Callable facts by def, for ordinary and instance bodies alike.
-- An instance reads its generic task's or generic impl method's return type
-- with the env applied (Box<int>::opt gives back maybe<int>).
task v4_mir_callable_return_type_for_def(ty_id: int, def: word) -> word {
    if not v4_mir_def_is_generic_instance(def) { give back v4_ty_callable_return_type_for_def(ty_id, def) }
    pilot generic_return = v4_ty_callable_return_type_for_def(ty_id, v4_mir_generic_def_base(def))
    if generic_return == v4_ty_unknown { give back v4_ty_unknown }
    give back v4_ty_canonical_type(ty_id, v4_ty_apply_generic_env(generic_return, v4_mir_generic_def_env(def)))
}

task v4_mir_callable_param_count_for_def(ty_id: int, def: word) -> int {
    if not v4_mir_def_is_generic_instance(def) { give back v4_ty_callable_param_count_for_def(ty_id, def) }
    give back v4_ty_callable_param_count_for_def(ty_id, v4_mir_generic_def_base(def))
}

task v4_mir_callable_source_span_for_def(ty_id: int, def: word) -> word {
    if not v4_mir_def_is_generic_instance(def) { give back v4_ty_callable_source_span_for_def(ty_id, def) }
    give back v4_ty_callable_source_span_for_def(ty_id, v4_mir_generic_def_base(def))
}

-- The generic TY signature of an instance body, or -1.
task v4_mir_body_generic_signature_id(mir_id: int, body_id: int) -> int {
    pilot def = v4_mir_body_generic_def(mir_id, body_id)
    if def == "" { give back 0 - 1 }
    give back v4_ty_lookup_signature(v4_mir_ty_id(mir_id), def)
}

-- A type of the generic signature, seen from an instance body.
task v4_mir_body_generic_type(mir_id: int, body_id: int, type_text: word) -> word {
    give back v4_ty_canonical_type(v4_mir_ty_id(mir_id), v4_ty_apply_generic_env(type_text, v4_mir_body_generic_env(mir_id, body_id)))
}

-- A body written with type parameters and lowered with them unsubstituted:
-- a generic task, or a closure lowered inside one. Native code emits only its
-- instances.
task v4_mir_body_is_generic_template(mir_id: int, body_id: int) -> bool {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) { give back false }
    if v4_mir_body_is_generic_instance(mir_id, body_id) { give back false }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if v4_mir_body_is_closure(mir_id, body_id) {
        pilot parent = v4_mir_lookup_body(mir_id, v4_mir_closure_body_parent_def(mir_id, body_id))
        if parent >= 0 and parent != body_id { give back v4_mir_body_is_generic_template(mir_id, parent) }
        sig_id = v4_mir_body_context_signature_id(mir_id, body_id)
    }
    if sig_id < 0 and not v4_mir_body_is_closure(mir_id, body_id) { give back v4_mir_impl_is_generic(v4_mir_ty_id(mir_id), v4_mir_body_impl_method_index(mir_id, body_id, 0)) }
    give back sig_id >= 0 and v4_ty_signature_type_generic_count(v4_mir_ty_id(mir_id), sig_id) > 0
}

-- The instance body a call names, or -1 for every other call.
task v4_mir_rvalue_generic_instance_body(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or rvalue_id >= v4_mir_body_rvalue_count(mir_id, body_id) or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call { give back 0 - 1 }
    pilot op = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
    pilot callee = v4_mir_lookup_body_name(mir_id, op)
    if callee < 0 {
        -- A method call keeps its Box<int>.get op; the instance body is named
        -- Box<int>::get. Method names carry no dot, so the last one splits.
        pilot dot = op.length() - 1
        repeat until dot < 0 or op.char_at(dot) == "." { dot -= 1 }
        if dot > 0 { callee = v4_mir_lookup_body_name(mir_id, v4_slice(op, 0, dot) + "::" + v4_slice(op, dot + 1, op.length())) }
    }
    if callee < 0 or not v4_mir_body_is_generic_instance(mir_id, callee) { give back 0 - 1 }
    give back callee
}

-- The substitution a call was lowered with ("" for a non-generic call).
task v4_mir_rvalue_generic_env(mir_id: int, body_id: int, rvalue_id: int) -> word {
    give back v4_mir_body_generic_env(mir_id, v4_mir_rvalue_generic_instance_body(mir_id, body_id, rvalue_id))
}

task v4_mir_set_body_signature(mir_id: int, body_id: int, signature: word) -> void {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) { give back }
    array_set(v4_mir_sigs_handle(mir_id), body_id, signature)
}

task v4_mir_body_callable_return_type(mir_id: int, body_id: int) -> word {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back v4_ty_unknown
    }
    if v4_mir_body_is_module_init(mir_id, body_id) { give back v4_ty_void }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_mir_body_is_closure(mir_id, body_id) { give back v4_ty_canonical_type(ty_id, v4_ty_closure_return_type(v4_mir_body_signature(mir_id, body_id))) }
    pilot generic_sig = v4_mir_body_generic_signature_id(mir_id, body_id)
    if generic_sig >= 0 { give back v4_mir_body_generic_type(mir_id, body_id, v4_ty_signature_return_type(ty_id, generic_sig)) }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id >= 0 { give back v4_ty_signature_return_type(ty_id, sig_id) }
    pilot hir_item = v4_mir_body_impl_method_index(mir_id, body_id, 0)
    if hir_item < 0 { give back v4_ty_unknown }
    pilot method_id = v4_mir_body_impl_method_index(mir_id, body_id, 1)
    give back v4_mir_body_impl_type(mir_id, body_id, v4_ty_impl_method_return_type(ty_id, hir_item, method_id))
}

task v4_mir_body_callable_abi(mir_id: int, body_id: int) -> word {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back ""
    }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 { sig_id = v4_mir_body_generic_signature_id(mir_id, body_id) }
    if sig_id >= 0 { give back v4_ty_signature_call_abi(v4_mir_ty_id(mir_id), sig_id) }
    -- An impl body uses the language ABI, represented by the empty ABI name.
    give back ""
}

-- Count only fixed parameters, matching ordinary LLVM signature lowering.
-- An impl receiver, when present, is the first declared parameter.
task v4_mir_body_callable_param_count(mir_id: int, body_id: int) -> int {
    if not v4_mir_file_exists(mir_id) or body_id < 0 or body_id >= v4_mir_body_count(mir_id) {
        give back 0
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_mir_body_is_module_init(mir_id, body_id) { give back 0 }
    if v4_mir_body_is_closure(mir_id, body_id) { give back v4_ty_closure_param_count(v4_mir_body_signature(mir_id, body_id)) }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 { sig_id = v4_mir_body_generic_signature_id(mir_id, body_id) }
    if sig_id >= 0 { give back v4_ty_signature_fixed_param_count(ty_id, sig_id) }
    pilot hir_item = v4_mir_body_impl_method_index(mir_id, body_id, 0)
    if hir_item < 0 { give back 0 }
    pilot method_id = v4_mir_body_impl_method_index(mir_id, body_id, 1)
    give back v4_ty_impl_method_param_count(ty_id, hir_item, method_id)
}

task v4_mir_body_callable_param_name(mir_id: int, body_id: int, param_id: int) -> word {
    if param_id < 0 or param_id >= v4_mir_body_callable_param_count(mir_id, body_id) {
        give back ""
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_mir_body_is_closure(mir_id, body_id) { give back v4_mir_local_name(mir_id, body_id, param_id) }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 { sig_id = v4_mir_body_generic_signature_id(mir_id, body_id) }
    if sig_id >= 0 { give back v4_ty_signature_param_name(ty_id, sig_id, param_id) }
    pilot hir_item = v4_mir_body_impl_method_index(mir_id, body_id, 0)
    pilot method_id = v4_mir_body_impl_method_index(mir_id, body_id, 1)
    give back v4_ty_impl_method_param_name(ty_id, hir_item, method_id, param_id)
}

task v4_mir_body_callable_param_type(mir_id: int, body_id: int, param_id: int) -> word {
    if param_id < 0 or param_id >= v4_mir_body_callable_param_count(mir_id, body_id) {
        give back v4_ty_unknown
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_mir_body_is_closure(mir_id, body_id) { give back v4_ty_canonical_type(ty_id, v4_ty_closure_param_type(v4_mir_body_signature(mir_id, body_id), param_id)) }
    pilot generic_sig = v4_mir_body_generic_signature_id(mir_id, body_id)
    if generic_sig >= 0 { give back v4_mir_body_generic_type(mir_id, body_id, v4_ty_signature_param_type(ty_id, generic_sig, param_id)) }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id >= 0 { give back v4_ty_signature_param_type(ty_id, sig_id, param_id) }
    pilot hir_item = v4_mir_body_impl_method_index(mir_id, body_id, 0)
    pilot method_id = v4_mir_body_impl_method_index(mir_id, body_id, 1)
    give back v4_mir_body_impl_type(mir_id, body_id, v4_ty_impl_method_param_type(ty_id, hir_item, method_id, param_id))
}

task v4_mir_body_callable_param_mode(mir_id: int, body_id: int, param_id: int) -> word {
    if param_id < 0 or param_id >= v4_mir_body_callable_param_count(mir_id, body_id) {
        give back v4_ty_param_mode_value
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    if v4_mir_body_is_closure(mir_id, body_id) { give back v4_ty_param_mode_value }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 { sig_id = v4_mir_body_generic_signature_id(mir_id, body_id) }
    if sig_id >= 0 { give back v4_ty_signature_param_mode(ty_id, sig_id, param_id) }
    pilot hir_item = v4_mir_body_impl_method_index(mir_id, body_id, 0)
    pilot method_id = v4_mir_body_impl_method_index(mir_id, body_id, 1)
    give back v4_ty_impl_method_param_mode(ty_id, hir_item, method_id, param_id)
}

task v4_mir_rvalue_is_aggregate_kind(kind: word) -> bool {
    give back kind == v4_mir_rvalue_construct or kind == v4_mir_rvalue_array or kind == v4_mir_rvalue_list or kind == v4_mir_rvalue_tuple or kind == v4_mir_rvalue_map or kind == v4_mir_rvalue_closure
}

task v4_mir_call_args_payload_count(payload: word) -> int {
    if payload == "" {
        give back 0
    }
    pilot count = 1
    pilot idx = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            count += 1
        }
        idx += 1
    }
    give back count
}

task v4_mir_call_args_payload_at(payload: word, wanted: int) -> int {
    if payload == "" or wanted < 0 {
        give back 0 - 1
    }
    pilot idx = 0
    pilot start_pos = 0
    pilot current = 0
    repeat until idx >= payload.length() {
        if payload.char_at(idx) == "," {
            if current == wanted {
                give back word_to_int(v4_slice(payload, start_pos, idx))
            }
            current += 1
            start_pos = idx + 1
        }
        idx += 1
    }
    if current == wanted and start_pos < payload.length() {
        give back word_to_int(v4_slice(payload, start_pos, payload.length()))
    }
    give back 0 - 1
}

task v4_mir_rvalue_call_arg_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    give back v4_mir_call_args_payload_count(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id))
}

task v4_mir_rvalue_call_arg(mir_id: int, body_id: int, rvalue_id: int, arg_id: int) -> int {
    give back v4_mir_call_args_payload_at(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), arg_id)
}

task v4_mir_rvalue_aggregate_child_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or not v4_mir_rvalue_is_aggregate_kind(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)) {
        give back 0
    }
    give back v4_mir_call_args_payload_count(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id))
}

task v4_mir_rvalue_aggregate_child(mir_id: int, body_id: int, rvalue_id: int, child_id: int) -> int {
    if rvalue_id < 0 or not v4_mir_rvalue_is_aggregate_kind(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)) {
        give back 0 - 1
    }
    give back v4_mir_call_args_payload_at(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id), child_id)
}

task v4_mir_closure_capture_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_closure {
        give back 0
    }
    give back v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
}

task v4_mir_closure_capture(mir_id: int, body_id: int, rvalue_id: int, capture_id: int) -> int {
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_closure {
        give back 0 - 1
    }
    give back v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, capture_id)
}

task v4_mir_capture_mode_for_kind(kind: word) -> word {
    if kind == v4_mir_rvalue_capture_borrow { give back v4_ty_closure_mode_borrow }
    if kind == v4_mir_rvalue_capture_borrow_mut { give back v4_ty_closure_mode_mut }
    if kind == v4_mir_rvalue_capture_copy { give back v4_ty_closure_mode_copy }
    if kind == v4_mir_rvalue_capture_move { give back v4_ty_closure_mode_move }
    give back ""
}

task v4_mir_closure_capture_mode_at(mir_id: int, body_id: int, local_name: word, offset: int) -> word {
    pilot rvalue_id = 0
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
    repeat until rvalue_id >= rvalue_count {
        if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_closure {
            pilot closure_span = v4_mir_rvalue_span(mir_id, body_id, rvalue_id)
            if offset >= v4_span_start(closure_span) and offset < v4_span_end(closure_span) {
                pilot capture_id = 0
                pilot capture_count = v4_mir_closure_capture_count(mir_id, body_id, rvalue_id)
                repeat until capture_id >= capture_count {
                    pilot capture_rvalue = v4_mir_closure_capture(mir_id, body_id, rvalue_id, capture_id)
                    if v4_mir_rvalue_text(mir_id, body_id, capture_rvalue) == local_name {
                        give back v4_mir_capture_mode_for_kind(v4_mir_rvalue_kind(mir_id, body_id, capture_rvalue))
                    }
                    capture_id += 1
                }
            }
        }
        rvalue_id += 1
    }
    give back ""
}

task v4_mir_method_ref(hir_item: int, method_id: int) -> word {
    give back word_from_int(hir_item) + "|" + word_from_int(method_id)
}

task v4_mir_method_ref_pipe(method_ref: word) -> int {
    pilot idx = 0
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_method_ref_hir_item(method_ref: word) -> int {
    pilot pipe = v4_mir_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(method_ref.substring(0, pipe))
}

task v4_mir_method_ref_method_id(method_ref: word) -> int {
    pilot pipe = v4_mir_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(method_ref.substring(pipe + 1, method_ref.length()))
}

task v4_mir_bound_method_ref(sig_id: int, method_id: int) -> word {
    give back word_from_int(sig_id) + "|" + word_from_int(method_id)
}

task v4_mir_bound_method_ref_with_doctrine(sig_id: int, method_id: int, doctrine_instance: word) -> word {
    pilot method_ref = v4_mir_bound_method_ref(sig_id, method_id)
    if doctrine_instance == "" or doctrine_instance == v4_ty_unknown {
        give back method_ref
    }
    give back method_ref + "|" + doctrine_instance
}

task v4_mir_bound_method_ref_pipe(method_ref: word) -> int {
    pilot idx = 0
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            give back idx
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_bound_method_ref_sig_id(method_ref: word) -> int {
    pilot pipe = v4_mir_bound_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    give back word_to_int(method_ref.substring(0, pipe))
}

task v4_mir_bound_method_ref_method_id(method_ref: word) -> int {
    pilot pipe = v4_mir_bound_method_ref_pipe(method_ref)
    if pipe < 0 {
        give back 0 - 1
    }
    pilot end = method_ref.length()
    pilot idx = pipe + 1
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            end = idx
            idx = method_ref.length()
        }
        idx += 1
    }
    give back word_to_int(method_ref.substring(pipe + 1, end))
}

task v4_mir_bound_method_ref_doctrine_instance(method_ref: word) -> word {
    pilot first_pipe = v4_mir_bound_method_ref_pipe(method_ref)
    if first_pipe < 0 {
        give back ""
    }
    pilot idx = first_pipe + 1
    repeat until idx >= method_ref.length() {
        if method_ref.char_at(idx) == "|" {
            give back method_ref.substring(idx + 1, method_ref.length())
        }
        idx += 1
    }
    give back ""
}

task v4_mir_builtin_shared_method_identity_is_known(builtin_method: word) -> bool {
    give back builtin_method == v4_mir_builtin_shared_new or builtin_method == v4_mir_builtin_shared_clone or builtin_method == v4_mir_builtin_shared_downgrade or builtin_method == v4_mir_builtin_shared_borrow or builtin_method == v4_mir_builtin_shared_borrow_mut or builtin_method == v4_mir_builtin_shared_get_mut or builtin_method == v4_mir_builtin_weak_upgrade
}

task v4_mir_builtin_shared_method_identity_code(builtin_method: word) -> int {
    if builtin_method == v4_mir_builtin_shared_new { give back 1 }
    if builtin_method == v4_mir_builtin_shared_clone { give back 2 }
    if builtin_method == v4_mir_builtin_shared_downgrade { give back 3 }
    if builtin_method == v4_mir_builtin_shared_borrow { give back 4 }
    if builtin_method == v4_mir_builtin_shared_borrow_mut { give back 5 }
    if builtin_method == v4_mir_builtin_shared_get_mut { give back 6 }
    if builtin_method == v4_mir_builtin_weak_upgrade { give back 7 }
    give back 0
}

task v4_mir_builtin_shared_method_receiver_mode(builtin_method: word) -> word {
    if builtin_method == v4_mir_builtin_shared_borrow_mut or builtin_method == v4_mir_builtin_shared_get_mut {
        give back v4_ty_param_mode_lend_mut
    }
    if builtin_method == v4_mir_builtin_shared_clone or builtin_method == v4_mir_builtin_shared_downgrade or builtin_method == v4_mir_builtin_shared_borrow or builtin_method == v4_mir_builtin_weak_upgrade {
        give back v4_ty_param_mode_lend
    }
    give back ""
}

task v4_mir_nominal_builtin_shared_base(mir_id: int, type_text: word) -> word {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot canonical = v4_ty_canonical_type(ty_id, type_text)
    if canonical != "" and canonical != v4_ty_unknown {
        type_text = canonical
    }
    if not v4_ty_is_generic_instance_type(type_text) {
        give back ""
    }
    pilot base_name = v4_ty_generic_base_name(type_text)
    if base_name != "Shared" and base_name != "Weak" and base_name != "SharedMut" {
        give back ""
    }
    -- Declared value types are nominal and shadow the prelude ownership carriers.
    if v4_ty_type_signature_id_for_name(ty_id, base_name) >= 0 {
        give back ""
    }
    give back base_name
}

task v4_mir_builtin_shared_method_surface_name(builtin_method: word) -> word {
    if builtin_method == v4_mir_builtin_shared_new { give back "new" }
    if builtin_method == v4_mir_builtin_shared_clone { give back "clone" }
    if builtin_method == v4_mir_builtin_shared_downgrade { give back "downgrade" }
    if builtin_method == v4_mir_builtin_shared_borrow { give back "borrow" }
    if builtin_method == v4_mir_builtin_shared_borrow_mut { give back "borrow_mut" }
    if builtin_method == v4_mir_builtin_shared_get_mut { give back "get_mut" }
    if builtin_method == v4_mir_builtin_weak_upgrade { give back "upgrade" }
    give back ""
}

task v4_mir_builtin_shared_method_result_type(builtin_method: word, owner_ty: word) -> word {
    pilot target_ty = v4_ty_shared_target_type(owner_ty)
    if builtin_method == v4_mir_builtin_shared_new or builtin_method == v4_mir_builtin_shared_clone {
        give back owner_ty
    }
    if builtin_method == v4_mir_builtin_shared_downgrade {
        give back v4_ty_weak_type(target_ty)
    }
    if builtin_method == v4_mir_builtin_shared_borrow {
        give back v4_ty_lend_type(target_ty, v4_ty_param_mode_lend)
    }
    if builtin_method == v4_mir_builtin_shared_borrow_mut {
        give back "result<" + v4_ty_shared_mut_type(target_ty) + ",BorrowError>"
    }
    if builtin_method == v4_mir_builtin_shared_get_mut {
        give back "maybe<" + v4_ty_lend_type(target_ty, v4_ty_param_mode_lend_mut) + ">"
    }
    if builtin_method == v4_mir_builtin_weak_upgrade {
        give back "maybe<" + v4_ty_shared_type(target_ty) + ">"
    }
    give back v4_ty_unknown
}

-- Exact identity plus structural checks keep restored or text-forged calls from
-- impersonating prelude Shared/Weak intrinsics in downstream ownership passes.
task v4_mir_rvalue_is_builtin_shared_method(mir_id: int, body_id: int, rvalue_id: int, builtin_method: word) -> bool {
    if not v4_mir_builtin_shared_method_identity_is_known(builtin_method) {
        give back false
    }
    if v4_mir_rvalue_builtin_method(mir_id, body_id, rvalue_id) != builtin_method {
        give back false
    }
    if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call {
        give back false
    }
    if v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id) != 1 {
        give back false
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, 0)
    if arg_rvalue < 0 {
        give back false
    }

    if builtin_method == v4_mir_builtin_shared_new {
        if v4_mir_nominal_builtin_shared_base(mir_id, result_ty) != "Shared" {
            give back false
        }
        if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) != result_ty + "::new" {
            give back false
        }
        pilot target_ty = v4_ty_shared_target_type(result_ty)
        pilot arg_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
        give back v4_ty_types_compatible(target_ty, arg_ty)
    }

    pilot receiver_mode = v4_mir_builtin_shared_method_receiver_mode(builtin_method)
    pilot receiver_kind = v4_mir_rvalue_lend
    if receiver_mode == v4_ty_param_mode_lend_mut {
        receiver_kind = v4_mir_rvalue_lend_mut
    }
    if v4_mir_rvalue_kind(mir_id, body_id, arg_rvalue) != receiver_kind {
        give back false
    }
    pilot receiver_loan_ty = v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)
    if not v4_ty_is_lend_type(receiver_loan_ty) or v4_ty_lend_mode(receiver_loan_ty) != receiver_mode {
        give back false
    }
    pilot owner_ty = v4_ty_canonical_type(ty_id, v4_ty_lend_target_type(receiver_loan_ty))
    pilot expected_base = "Shared"
    if builtin_method == v4_mir_builtin_weak_upgrade {
        expected_base = "Weak"
    }
    if v4_mir_nominal_builtin_shared_base(mir_id, owner_ty) != expected_base {
        give back false
    }
    pilot receiver_rvalue = v4_mir_rvalue_lhs(mir_id, body_id, arg_rvalue)
    if receiver_rvalue < 0 {
        give back false
    }
    pilot receiver_ty = v4_ty_canonical_type(ty_id, v4_mir_rvalue_ty(mir_id, body_id, receiver_rvalue))
    if receiver_ty != owner_ty {
        give back false
    }
    pilot surface_name = v4_mir_builtin_shared_method_surface_name(builtin_method)
    if v4_mir_rvalue_op(mir_id, body_id, rvalue_id) != owner_ty + "." + surface_name {
        give back false
    }
    give back result_ty == v4_mir_builtin_shared_method_result_type(builtin_method, owner_ty)
}

task v4_mir_fixed_array_slot_count(mir_id: int, array_ty: word) -> int {
    pilot length_text = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), array_ty)
    if length_text == "" or length_text == v4_ty_unknown {
        give back 0 - 1
    }
    if not v4_ty_is_integer_text_literal(length_text) {
        give back 0 - 1
    }
    if length_text.char_at(0) == "-" {
        give back 0 - 1
    }
    give back word_to_int(length_text)
}

task v4_mir_rvalue_contains_mut_lend(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_lend_mut or v4_ty_type_may_store_mut_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back true
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_mir_rvalue_contains_mut_lend(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)) {
                give back true
            }
            child_id += 1
        }
    }
    give back false
}

task v4_mir_path_scope_separator(path: word) -> int {
    pilot idx = 0
    pilot depth = 0
    repeat until idx + 1 >= path.length() {
        pilot ch = path.char_at(idx)
        if depth == 0 and ch == ":" and path.char_at(idx + 1) == ":" {
            give back idx
        }
        depth = v4_ty_type_depth_after_char(depth, ch)
        idx += 1
    }
    give back 0 - 1
}

task v4_mir_path_right(path: word) -> word {
    pilot sep = v4_mir_path_scope_separator(path)
    if sep < 0 or sep + 2 > path.length() {
        give back ""
    }
    give back v4_mir_pattern_trim(v4_slice(path, sep + 2, path.length()))
}

task v4_mir_rvalue_aggregate_child_projection(mir_id: int, body_id: int, rvalue_id: int, child_id: int) -> word {
    if v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id) < 0 {
        give back ""
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_tuple {
        give back "." + word_from_int(child_id)
    }
    if kind == v4_mir_rvalue_array {
        pilot slot_count = v4_mir_fixed_array_slot_count(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        if slot_count < 0 {
            give back ""
        }
        if v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id) == 1 and slot_count > 1 {
            give back "[*]"
        }
        if child_id >= slot_count {
            give back ""
        }
        give back "[" + word_from_int(child_id) + "]"
    }
    if kind != v4_mir_rvalue_construct {
        give back ""
    }

    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot aggregate_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot field_name = ""
    if v4_ty_is_route_type(ty_id, aggregate_ty) {
        pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
        pilot next_case = v4_mir_path_right(case_name)
        repeat until next_case == "" {
            case_name = next_case
            next_case = v4_mir_path_right(case_name)
        }
        field_name = v4_ty_route_case_field_name(ty_id, aggregate_ty, case_name, child_id)
    } else {
        pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, aggregate_ty)
        if sig_id >= 0 {
            field_name = v4_ty_shape_field_name(ty_id, sig_id, child_id)
        }
    }
    if field_name == "" {
        give back ""
    }
    give back "." + field_name
}

task v4_mir_pattern_is_space(ch: word) -> bool {
    give back ch == " " or ch == "\n" or ch == "\t" or ch == "\r"
}

task v4_mir_pattern_trim(pattern: word) -> word {
    pilot start_pos = 0
    pilot found_start = false
    repeat until start_pos >= pattern.length() {
        if not v4_mir_pattern_is_space(pattern.char_at(start_pos)) {
            found_start = true
            start_pos = pattern.length()
        } else {
            start_pos += 1
        }
    }

    if found_start == false {
        give back ""
    }

    pilot trim_start = 0
    repeat until trim_start >= pattern.length() {
        if not v4_mir_pattern_is_space(pattern.char_at(trim_start)) {
            start_pos = trim_start
            trim_start = pattern.length()
        } else {
            trim_start += 1
        }
    }

    pilot end_pos = pattern.length()
    repeat until end_pos <= start_pos {
        if not v4_mir_pattern_is_space(pattern.char_at(end_pos - 1)) {
            give back v4_slice(pattern, start_pos, end_pos)
        }
        end_pos -= 1
    }
    give back ""
}

task v4_mir_lookup_body(mir_id: int, def_id: word) -> int {
    if not v4_mir_lookup_owner_exists(mir_id) { give back 0 - 1 }
    if v4_mir_body_lookup_index_is_ready(mir_id) {
        pilot packed = v4_mir_body_lookup_index_handle(mir_id)
        pilot capacity = word_to_int(array_get(packed, 1))
        if capacity > 0 {
            pilot bucket: int = def_id.checksum() % capacity
            pilot visited = 0
            repeat until visited >= capacity {
                v4_mir_body_lookup_probes += 1
                pilot body_id = word_to_int(array_get(packed, 3 + bucket)) - 1
                if body_id < 0 { give back 0 - 1 }
                if v4_mir_body_def(mir_id, body_id) == def_id { give back body_id }
                bucket = (bucket + 1) % capacity
                visited += 1
            }
        }
    }
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        v4_mir_body_lookup_linear_steps += 1
        if v4_mir_body_def(mir_id, body_idx) == def_id { give back body_idx }
        body_idx += 1
    }
    give back 0 - 1
}

-- Name identity shares publication and lifetime with definition identity.
-- Cold fallback preserves the first exact name in ascending physical order.
task v4_mir_lookup_body_name(mir_id: int, name: word) -> int {
    if not v4_mir_lookup_owner_exists(mir_id) { give back 0 - 1 }
    if v4_mir_body_lookup_index_is_ready(mir_id) {
        pilot packed = v4_mir_body_lookup_index_handle(mir_id)
        pilot capacity = word_to_int(array_get(packed, 1))
        pilot bucket: int = name.checksum() % capacity
        pilot visited = 0
        repeat until visited >= capacity {
            v4_mir_body_lookup_probes += 1
            pilot body_id = word_to_int(array_get(packed, 3 + capacity + bucket)) - 1
            if body_id < 0 { give back 0 - 1 }
            if v4_mir_body_name(mir_id, body_id) == name { give back body_id }
            bucket = (bucket + 1) % capacity
            visited += 1
        }
    }
    pilot body_id = 0
    pilot count = v4_mir_body_count(mir_id)
    repeat until body_id >= count {
        v4_mir_body_lookup_linear_steps += 1
        if v4_mir_body_name(mir_id, body_id) == name { give back body_id }
        body_id += 1
    }
    give back 0 - 1
}

task v4_mir_local_count(mir_id: int) -> int {
    pilot total = 0
    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        total = total + v4_mir_body_local_count(mir_id, body_idx)
        body_idx += 1
    }
    give back total
}

