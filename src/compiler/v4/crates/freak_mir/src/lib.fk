-- ===================================================================
-- freak_mir - persistent V4 Built-MIR representation
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_ty.
-- Owns Built-MIR storage, stable ids, CFG/local/place/rvalue accessors,
-- validation, diagnostics storage, and the byte-stable snapshot v9
-- format. Source construction policy lives in freak_mir_build.

pilot v4_mir_term_return = "Return"
