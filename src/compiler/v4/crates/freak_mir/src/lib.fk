-- MIR files MIR Build lowers only to seal analysis closure results: the
-- snapshot publishes each as an empty file, since its bodies (closure bodies
-- without the tasks they call) are not part of the published program.
pilot v4_mir_unpublished_files: int = 0 - 1

task v4_mir_mark_unpublished(mir_id: int) -> void {
    if v4_mir_unpublished_files < 0 { v4_mir_unpublished_files = array_new() }
    array_push(v4_mir_unpublished_files, word_from_int(mir_id))
}

task v4_mir_snapshot_publishes(mir_id: int) -> bool {
    if v4_mir_unpublished_files < 0 { give back true }
    pilot idx = 0
    repeat until idx >= array_len(v4_mir_unpublished_files) {
        if word_to_int(array_get(v4_mir_unpublished_files, idx)) == mir_id { give back false }
        idx += 1
    }
    give back true
}

task v4_mir_snapshot_body_total() -> int {
    v4_mir_init()
    pilot total = 0
    pilot mir_id = 0
    repeat until mir_id >= v4_mir_file_count() {
        if v4_mir_snapshot_publishes(mir_id) { total += v4_mir_body_count(mir_id) }
        mir_id += 1
    }
    give back total
}

