-- ===================================================================
-- freak_mir - persistent V4 Built-MIR representation
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_ty.
-- Owns Built-MIR storage, stable ids, CFG/local/place/rvalue accessors,
-- validation, diagnostics storage, and the byte-stable snapshot v5
-- format. Source construction policy lives in freak_mir_build.

pilot v4_mir_term_return = "Return"
pilot v4_mir_term_unreachable = "Unreachable"
pilot v4_mir_term_goto = "Goto"
pilot v4_mir_term_if = "If"

pilot v4_mir_stmt_local = "LocalInit"
pilot v4_mir_stmt_assign = "Assign"
pilot v4_mir_stmt_return = "ReturnValue"
pilot v4_mir_stmt_expr = "Expr"
pilot v4_mir_stmt_branch = "Branch"
pilot v4_mir_stmt_loop = "Loop"
pilot v4_mir_stmt_break = "Break"
pilot v4_mir_stmt_continue = "Continue"
pilot v4_mir_local_unknown = "unknown"

