    array_set(v4_mir_rvalue_ops_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_lhs_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_lhs_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_rhs_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_rhs_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_spans_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_spans_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_tys_index_handle(mir_id), body_id)))
    array_set(v4_mir_rvalue_tys_index_handle(mir_id), body_id, "-1")
    array_release(word_to_int(array_get(v4_mir_rvalue_abis_index_handle(mir_id), body_id)))
