}

task v4_mir_local_visible_at(mir_id: int, body_id: int, local_id: int, offset: int) -> bool {
    if local_id < 0 {
        give back false
    }
    pilot def_span = v4_mir_local_span(mir_id, body_id, local_id)
    pilot scope_span = v4_mir_local_scope_span(mir_id, body_id, local_id)
    pilot start_offset = v4_span_start(def_span)
    pilot end_offset = v4_span_end(scope_span)
    if end_offset <= start_offset {
        end_offset = v4_span_end(def_span)
    }
    give back offset >= start_offset and offset < end_offset
}

