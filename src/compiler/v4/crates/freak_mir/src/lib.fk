pilot v4_mir_bin_mul = "Mul"
pilot v4_mir_bin_div = "Div"
pilot v4_mir_bin_mod = "Mod"
pilot v4_mir_bin_gt = "Gt"
pilot v4_mir_bin_lt = "Lt"
pilot v4_mir_bin_ge = "Ge"
pilot v4_mir_bin_le = "Le"
pilot v4_mir_bin_eq = "Eq"
pilot v4_mir_bin_ne = "Ne"
pilot v4_mir_bin_and = "And"
pilot v4_mir_bin_or = "Or"

pilot v4_mir_place_local = "Local"
pilot v4_mir_place_field = "Field"
pilot v4_mir_place_index = "Index"
pilot v4_mir_place_return = "Return"
pilot v4_mir_place_unknown = "Unknown"
pilot v4_mir_snapshot_format = "freak-mir-snapshot-v1"

pilot v4_mir_files = 0
pilot v4_mir_tys = 0
pilot v4_mir_body_defs = 0
pilot v4_mir_body_names = 0
pilot v4_mir_body_sigs = 0
pilot v4_mir_body_blocks = 0
pilot v4_mir_body_local_names = 0
pilot v4_mir_body_local_tys = 0
pilot v4_mir_body_local_spans = 0
pilot v4_mir_body_stmt_kinds = 0
pilot v4_mir_body_stmt_lhs = 0
pilot v4_mir_body_stmt_rhs = 0
pilot v4_mir_body_stmt_spans = 0
pilot v4_mir_body_stmt_blocks = 0
pilot v4_mir_body_stmt_places = 0
pilot v4_mir_body_stmt_rvalues = 0
pilot v4_mir_body_place_kinds = 0
pilot v4_mir_body_place_texts = 0
pilot v4_mir_body_place_bases = 0
pilot v4_mir_body_place_fields = 0
pilot v4_mir_body_place_indices = 0
pilot v4_mir_body_place_spans = 0
pilot v4_mir_body_place_tys = 0
pilot v4_mir_body_rvalue_kinds = 0
pilot v4_mir_body_rvalue_texts = 0
pilot v4_mir_body_rvalue_ops = 0
