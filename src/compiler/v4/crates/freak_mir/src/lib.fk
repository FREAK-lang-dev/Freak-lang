    out = out + "|" + word_from_int(rvalue_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_op(mir_id, body_id, rvalue_id))
    out = out + "|" + word_from_int(v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    out = out + "|" + word_from_int(v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_span(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_abi(mir_id, body_id, rvalue_id))
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_rvalue_args_payload(mir_id, body_id, rvalue_id))
    give back out
}

task v4_mir_snapshot_diag_line(mir_id: int, diag_id: int) -> word {
    pilot out = "mir-diag"
    out = out + "|" + word_from_int(mir_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_mir_snapshot_escape(v4_mir_diag(mir_id, diag_id))
    give back out
}

task v4_mir_snapshot() -> word {
    v4_mir_init()
    pilot out = v4_mir_snapshot_header()
    pilot mir_id = 0
    repeat until mir_id >= v4_mir_file_count() {
        out = out + "\n" + v4_mir_snapshot_file_line(mir_id)

        pilot body_id = 0
        pilot body_count = v4_mir_body_count(mir_id)
        repeat until body_id >= body_count {
            out = out + "\n" + v4_mir_snapshot_body_line(mir_id, body_id)

            pilot block_id = 0
            pilot block_count = v4_mir_body_block_count(mir_id, body_id)
            repeat until block_id >= block_count {
                out = out + "\n" + v4_mir_snapshot_block_line(mir_id, body_id, block_id)
                block_id += 1
            }

            pilot local_id = 0
            pilot local_count = v4_mir_body_local_count(mir_id, body_id)
            repeat until local_id >= local_count {
                out = out + "\n" + v4_mir_snapshot_local_line(mir_id, body_id, local_id)
                local_id += 1
            }

            pilot stmt_id = 0
            pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
            repeat until stmt_id >= stmt_count {
                out = out + "\n" + v4_mir_snapshot_stmt_line(mir_id, body_id, stmt_id)
                stmt_id += 1
            }

            pilot place_id = 0
            pilot place_count = v4_mir_body_place_count(mir_id, body_id)
            repeat until place_id >= place_count {
                out = out + "\n" + v4_mir_snapshot_place_line(mir_id, body_id, place_id)
                place_id += 1
            }

            pilot rvalue_id = 0
            pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
            repeat until rvalue_id >= rvalue_count {
                out = out + "\n" + v4_mir_snapshot_rvalue_line(mir_id, body_id, rvalue_id)
                rvalue_id += 1
            }
            body_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_mir_diag_count(mir_id)
        repeat until diag_id >= diag_count {
            out = out + "\n" + v4_mir_snapshot_diag_line(mir_id, diag_id)
            diag_id += 1
        }
        mir_id += 1
    }
    out = out + "\nend|" + v4_mir_snapshot_format
    give back out
}

task v4_mir_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "mir-snapshot" { give back 10 }
    if kind == "mir" { give back 6 }
    if kind == "mir-body" { give back 11 }
    if kind == "mir-block" { give back 5 }
    if kind == "mir-local" { give back 8 }
    if kind == "mir-stmt" { give back 11 }
    if kind == "mir-place" { give back 11 }
    if kind == "mir-rvalue" { give back 13 }
    if kind == "mir-diag" { give back 4 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_mir_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_mir_snapshot_field_raw(line, 0)
    pilot expected = v4_mir_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_mir_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_mir_snapshot_validate(payload: word) -> word {
    pilot lines = v4_mir_snapshot_line_count(payload)
    pilot files = 0
    pilot bodies = 0
    pilot blocks = 0
    pilot locals = 0
    pilot statements = 0
    pilot places = 0
    pilot rvalues = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_mir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_mir_snapshot_field_raw(line, 0)
            if v4_mir_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "mir-snapshot" {
                saw_header += 1
                format = v4_mir_snapshot_key_value(line, "format")
                if format != v4_mir_snapshot_format {
                    malformed += 1
                }
            } else if kind == "mir" {
                files += 1
            } else if kind == "mir-body" {
                bodies += 1
            } else if kind == "mir-block" {
                blocks += 1
            } else if kind == "mir-local" {
                locals += 1
            } else if kind == "mir-stmt" {
                statements += 1
            } else if kind == "mir-place" {
                places += 1
            } else if kind == "mir-rvalue" {
                rvalues += 1
            } else if kind == "mir-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_mir_snapshot_field(line, 1) != v4_mir_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "mir-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " bodies=" + word_from_int(bodies)
    out = out + " blocks=" + word_from_int(blocks)
    out = out + " locals=" + word_from_int(locals)
    out = out + " statements=" + word_from_int(statements)
    out = out + " places=" + word_from_int(places)
    out = out + " rvalues=" + word_from_int(rvalues)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_mir_restore_file_slot(mir_id: int, file_id: int, ty_id: int) -> int {
    v4_mir_init()
    repeat until array_len(v4_mir_files) > mir_id {
