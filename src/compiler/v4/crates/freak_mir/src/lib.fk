pilot v4_mir_rvalue_unknown = "Unknown"

-- MIR stores semantic truth independently of source spelling. This reader
-- also accepts the numeric facts used by older manual/snapshot fixtures.
task v4_mir_bool_literal_value(text: word) -> word {
    pilot lower = text.to_lower()
    if lower == "true" or lower == "yes" or lower == "hai" or lower == "1" {
        give back "true"
    }
    if lower == "false" or lower == "no" or lower == "iie" or lower == "0" {
        give back "false"
    }
    give back ""
}

