task v4_mir_init() -> void {
    if v4_mir_ready == 0 {
        v4_mir_files = array_new()
        v4_mir_tys = array_new()
        v4_mir_body_defs = array_new()
        v4_mir_body_names = array_new()
        v4_mir_body_sigs = array_new()
        v4_mir_body_blocks = array_new()
        v4_mir_body_local_names = array_new()
        v4_mir_body_local_tys = array_new()
        v4_mir_body_local_modes = array_new()
        v4_mir_body_local_spans = array_new()
        v4_mir_body_local_scope_spans = array_new()
        v4_mir_body_stmt_kinds = array_new()
        v4_mir_body_stmt_lhs = array_new()
        v4_mir_body_stmt_rhs = array_new()
        v4_mir_body_stmt_spans = array_new()
        v4_mir_body_stmt_blocks = array_new()
        v4_mir_body_stmt_places = array_new()
        v4_mir_body_stmt_rvalues = array_new()
        v4_mir_body_place_kinds = array_new()
        v4_mir_body_place_texts = array_new()
        v4_mir_body_place_bases = array_new()
        v4_mir_body_place_fields = array_new()
        v4_mir_body_place_indices = array_new()
        v4_mir_body_place_spans = array_new()
        v4_mir_body_place_tys = array_new()
        v4_mir_body_rvalue_kinds = array_new()
        v4_mir_body_rvalue_texts = array_new()
        v4_mir_body_rvalue_ops = array_new()
        v4_mir_body_rvalue_lhs = array_new()
        v4_mir_body_rvalue_rhs = array_new()
        v4_mir_body_rvalue_spans = array_new()
        v4_mir_body_rvalue_tys = array_new()
        v4_mir_body_rvalue_abis = array_new()
        v4_mir_body_rvalue_args = array_new()
        v4_mir_body_rvalue_builtin_methods = array_new()
        v4_mir_diags = array_new()
        v4_mir_loop_break_targets = array_new()
        v4_mir_loop_continue_targets = array_new()
        v4_mir_loop_depth = 0
        v4_mir_scope_spans = array_new()
        v4_mir_scope_depth = 0
        v4_mir_trust_me_depth = 0
        v4_mir_trust_me_honor_ranks = array_new()
        v4_mir_ready = 1
    }
}

task v4_mir_clear_loop_context() -> void {
    array_release(v4_mir_loop_break_targets)
    array_release(v4_mir_loop_continue_targets)
    v4_mir_loop_break_targets = array_new()
    v4_mir_loop_continue_targets = array_new()
    v4_mir_loop_depth = 0
}

task v4_mir_clear_scope_context() -> void {
    array_release(v4_mir_scope_spans)
    array_release(v4_mir_trust_me_honor_ranks)
    v4_mir_scope_spans = array_new()
    v4_mir_scope_depth = 0
    v4_mir_trust_me_depth = 0
    v4_mir_trust_me_honor_ranks = array_new()
}

task v4_mir_honor_rank(level: word) -> int {
    if level == "cadet" { give back 1 }
    if level == "pilot" { give back 2 }
    if level == "ace" { give back 3 }
    if level == "commander" { give back 4 }
    if level == "humanity" { give back 5 }
    give back 0
}

task v4_mir_honor_name(rank: int) -> word {
    if rank == 1 { give back "cadet" }
    if rank == 2 { give back "pilot" }
    if rank == 3 { give back "ace" }
    if rank == 4 { give back "commander" }
    if rank == 5 { give back "humanity" }
    give back "unknown"
}

task v4_mir_push_trust_me_honor(honor_rank: int) -> void {
    if array_len(v4_mir_trust_me_honor_ranks) > v4_mir_trust_me_depth {
        array_set(v4_mir_trust_me_honor_ranks, v4_mir_trust_me_depth, word_from_int(honor_rank))
    } else {
        array_push(v4_mir_trust_me_honor_ranks, word_from_int(honor_rank))
    }
    v4_mir_trust_me_depth += 1
}

task v4_mir_push_trust_me() -> void {
    v4_mir_push_trust_me_honor(v4_mir_honor_rank("cadet"))
}

task v4_mir_pop_trust_me() -> void {
    if v4_mir_trust_me_depth > 0 {
        v4_mir_trust_me_depth -= 1
    }
}

task v4_mir_inside_trust_me() -> bool {
    give back v4_mir_trust_me_depth > 0
}

task v4_mir_current_trust_honor_rank() -> int {
    if v4_mir_trust_me_depth <= 0 {
        give back 0
    }
    give back word_to_int(array_get(v4_mir_trust_me_honor_ranks, v4_mir_trust_me_depth - 1))
}

task v4_mir_current_trust_honor_name() -> word {
    give back v4_mir_honor_name(v4_mir_current_trust_honor_rank())
}

task v4_mir_trust_honor_allows(required_rank: int) -> bool {
    give back v4_mir_current_trust_honor_rank() >= required_rank
}

task v4_mir_trust_honor_help(operation: word, required_level: word) -> word {
    give back operation + " requires ." + required_level + " or higher; current honor is ." + v4_mir_current_trust_honor_name()
}

task v4_mir_check_trust_honor(mir_id: int, span: word, operation: word, required_level: word) -> void {
    pilot required_rank = v4_mir_honor_rank(required_level)
    if v4_mir_inside_trust_me() == false {
        give back
    }
    if v4_mir_trust_honor_allows(required_rank) == false {
        v4_mir_add_type_error(mir_id, span, "trust me honor level too low", v4_mir_trust_honor_help(operation, required_level))
    }
}

task v4_mir_push_scope_span(span: word) -> void {
    if array_len(v4_mir_scope_spans) > v4_mir_scope_depth {
        array_set(v4_mir_scope_spans, v4_mir_scope_depth, span)
    } else {
        array_push(v4_mir_scope_spans, span)
    }
    v4_mir_scope_depth += 1
}

task v4_mir_pop_scope_span() -> void {
    if v4_mir_scope_depth > 0 {
        v4_mir_scope_depth -= 1
    }
}

task v4_mir_current_scope_span(fallback_span: word) -> word {
    if v4_mir_scope_depth == 0 {
        give back fallback_span
    }
    give back array_get(v4_mir_scope_spans, v4_mir_scope_depth - 1)
}

task v4_mir_push_loop_context(break_target: int, continue_target: int) -> void {
    if v4_mir_loop_depth >= array_len(v4_mir_loop_break_targets) {
        array_push(v4_mir_loop_break_targets, word_from_int(break_target))
        array_push(v4_mir_loop_continue_targets, word_from_int(continue_target))
    } else {
        array_set(v4_mir_loop_break_targets, v4_mir_loop_depth, word_from_int(break_target))
        array_set(v4_mir_loop_continue_targets, v4_mir_loop_depth, word_from_int(continue_target))
    }
    v4_mir_loop_depth += 1
}

task v4_mir_pop_loop_context() -> void {
    if v4_mir_loop_depth > 0 {
        v4_mir_loop_depth -= 1
    }
}

task v4_mir_current_loop_break_target() -> int {
    if v4_mir_loop_depth <= 0 {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_mir_loop_break_targets, v4_mir_loop_depth - 1))
}

task v4_mir_current_loop_continue_target() -> int {
    if v4_mir_loop_depth <= 0 {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_mir_loop_continue_targets, v4_mir_loop_depth - 1))
}

task v4_mir_file_new(file_id: int, ty_id: int) -> int {
    v4_mir_init()
    pilot mir_id = array_len(v4_mir_files)
    array_push(v4_mir_files, word_from_int(file_id))
    array_push(v4_mir_tys, word_from_int(ty_id))
    array_push(v4_mir_body_defs, word_from_int(array_new()))
    array_push(v4_mir_body_names, word_from_int(array_new()))
    array_push(v4_mir_body_sigs, word_from_int(array_new()))
    array_push(v4_mir_body_blocks, word_from_int(array_new()))
    array_push(v4_mir_body_local_names, word_from_int(array_new()))
    array_push(v4_mir_body_local_tys, word_from_int(array_new()))
    array_push(v4_mir_body_local_modes, word_from_int(array_new()))
    array_push(v4_mir_body_local_spans, word_from_int(array_new()))
    array_push(v4_mir_body_local_scope_spans, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_kinds, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_lhs, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_rhs, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_spans, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_blocks, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_places, word_from_int(array_new()))
    array_push(v4_mir_body_stmt_rvalues, word_from_int(array_new()))
    array_push(v4_mir_body_place_kinds, word_from_int(array_new()))
    array_push(v4_mir_body_place_texts, word_from_int(array_new()))
    array_push(v4_mir_body_place_bases, word_from_int(array_new()))
    array_push(v4_mir_body_place_fields, word_from_int(array_new()))
    array_push(v4_mir_body_place_indices, word_from_int(array_new()))
    array_push(v4_mir_body_place_spans, word_from_int(array_new()))
    array_push(v4_mir_body_place_tys, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_kinds, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_texts, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_ops, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_lhs, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_rhs, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_spans, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_tys, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_abis, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_args, word_from_int(array_new()))
    array_push(v4_mir_body_rvalue_builtin_methods, word_from_int(array_new()))
    array_push(v4_mir_diags, word_from_int(array_new()))
    give back mir_id
}

