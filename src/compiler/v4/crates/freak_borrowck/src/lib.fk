task v4_borrowck_store_provenance_telemetry(borrow_id: int) -> void {
    if not v4_borrowck_file_exists(borrow_id) { give back }
    array_set(v4_borrowck_fixed_point_rounds_by_file, borrow_id, word_from_int(v4_borrowck_provenance_fixed_point_rounds_value))
    array_set(v4_borrowck_fixed_point_limits_by_file, borrow_id, word_from_int(v4_borrowck_provenance_fixed_point_limit_value))
    array_set(v4_borrowck_fixed_point_solves_by_file, borrow_id, word_from_int(v4_borrowck_provenance_fixed_point_solves_value))
    array_set(v4_borrowck_fixed_point_converged_by_file, borrow_id, word_from_bool(v4_borrowck_provenance_fixed_point_converged_value))
    array_set(v4_borrowck_resource_exhausted_by_file, borrow_id, word_from_bool(v4_borrowck_provenance_resource_exhausted_value))
    array_set(v4_borrowck_fixed_point_work_items_by_file, borrow_id, word_from_int(v4_borrowck_provenance_fixed_point_work_items_value))
}

task v4_borrowck_provenance_exists(provenance_id: int) -> bool {
    give back provenance_id >= 0 and provenance_id < v4_borrowck_provenance_state_active
}

task v4_borrowck_provenance_new(state: word) -> int {
    v4_borrowck_init()
    pilot provenance_id = v4_borrowck_provenance_state_active
    pilot stored_state = state
    if stored_state != v4_borrowck_provenance_known and stored_state != v4_borrowck_provenance_known_empty and stored_state != v4_borrowck_provenance_opaque {
        stored_state = v4_borrowck_provenance_opaque
    }
    v4_borrowck_provenance_scratch_store(v4_borrowck_provenance_states, provenance_id, stored_state)
    v4_borrowck_provenance_state_active += 1
    give back provenance_id
}

task v4_borrowck_provenance_state(provenance_id: int) -> word {
    if not v4_borrowck_provenance_exists(provenance_id) {
        give back v4_borrowck_provenance_opaque
    }
    give back array_get(v4_borrowck_provenance_states, provenance_id)
}

task v4_borrowck_provenance_is_known(provenance_id: int) -> bool {
    if not v4_borrowck_provenance_exists(provenance_id) { give back false }
    pilot state = v4_borrowck_provenance_state(provenance_id)
    give back state == v4_borrowck_provenance_known or state == v4_borrowck_provenance_known_empty
}

task v4_borrowck_provenance_mark_known_empty(provenance_id: int) -> void {
    if v4_borrowck_provenance_exists(provenance_id) and v4_borrowck_provenance_count(provenance_id) == 0 and v4_borrowck_provenance_state(provenance_id) != v4_borrowck_provenance_known_empty {
        array_set(v4_borrowck_provenance_states, provenance_id, v4_borrowck_provenance_known_empty)
        v4_borrowck_provenance_revision_value += 1
    }
}

task v4_borrowck_provenance_mark_opaque(provenance_id: int) -> void {
    if v4_borrowck_provenance_exists(provenance_id) and v4_borrowck_provenance_state(provenance_id) != v4_borrowck_provenance_opaque {
        array_set(v4_borrowck_provenance_states, provenance_id, v4_borrowck_provenance_opaque)
        v4_borrowck_provenance_revision_value += 1
    }
}

task v4_borrowck_provenance_count(provenance_id: int) -> int {
    if not v4_borrowck_provenance_exists(provenance_id) {
        give back 0
    }
    pilot source_count = 0
    pilot row_id = 0
    repeat until row_id >= v4_borrowck_provenance_source_active {
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == provenance_id {
            source_count += 1
        }
        row_id += 1
    }
    give back source_count
}

task v4_borrowck_provenance_is_known_empty(provenance_id: int) -> bool {
    give back v4_borrowck_provenance_is_known(provenance_id) and v4_borrowck_provenance_count(provenance_id) == 0
}

task v4_borrowck_provenance_source_row_at(provenance_id: int, source_id: int) -> int {
    if not v4_borrowck_provenance_exists(provenance_id) or source_id < 0 {
        give back 0 - 1
    }
    pilot seen_sources = 0
    pilot row_id = 0
    repeat until row_id >= v4_borrowck_provenance_source_active {
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == provenance_id {
            if seen_sources == source_id {
                give back row_id
            }
            seen_sources += 1
        }
        row_id += 1
    }
    give back 0 - 1
}

task v4_borrowck_provenance_path_at(provenance_id: int, source_id: int) -> word {
    pilot row_id = v4_borrowck_provenance_source_row_at(provenance_id, source_id)
    if row_id < 0 {
        give back ""
    }
    give back array_get(v4_borrowck_source_paths, row_id)
}

task v4_borrowck_provenance_origin_at(provenance_id: int, source_id: int) -> int {
    pilot row_id = v4_borrowck_provenance_source_row_at(provenance_id, source_id)
    if row_id < 0 {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_borrowck_source_origins, row_id))
}

task v4_borrowck_provenance_route_guard_at(provenance_id: int, source_id: int) -> word {
    pilot row_id = v4_borrowck_provenance_source_row_at(provenance_id, source_id)
    if row_id < 0 { give back "" }
    give back array_get(v4_borrowck_source_route_guards, row_id)
}

task v4_borrowck_provenance_contains_source(provenance_id: int, source_text: word, route_guard: word) -> bool {
    if not v4_borrowck_provenance_exists(provenance_id) { give back false }
    pilot source_canon = v4_borrowck_path_canon(source_text)
    pilot row_id = 0
    repeat until row_id >= v4_borrowck_provenance_source_active {
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == provenance_id {
            pilot stored_path: word = array_get(v4_borrowck_source_paths, row_id)
            pilot stored_guard: word = array_get(v4_borrowck_source_route_guards, row_id)
            if stored_path == source_canon and stored_guard == route_guard {
                give back true
            }
        }
        row_id += 1
    }
    give back false
}
task v4_borrowck_provenance_contains_path(provenance_id: int, source_text: word) -> bool {
    if not v4_borrowck_provenance_exists(provenance_id) {
        give back false
    }
    pilot source_canon = v4_borrowck_path_canon(source_text)
    pilot row_id = 0
    repeat until row_id >= v4_borrowck_provenance_source_active {
        pilot stored_path: word = array_get(v4_borrowck_source_paths, row_id)
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == provenance_id and stored_path == source_canon {
            give back true
        }
        row_id += 1
    }
    give back false
}

task v4_borrowck_provenance_overlaps_path(provenance_id: int, source_text: word) -> bool {
    if not v4_borrowck_provenance_is_known(provenance_id) {
        give back true
    }
    pilot row_id = 0
    repeat until row_id >= v4_borrowck_provenance_source_active {
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == provenance_id and v4_borrowck_paths_overlap(array_get(v4_borrowck_source_paths, row_id), source_text) {
            give back true
        }
        row_id += 1
    }
    give back false
}

task v4_borrowck_provenance_add_source_guarded(provenance_id: int, source_text: word, origin_id: int, route_guard: word) -> void {
    if not v4_borrowck_provenance_exists(provenance_id) or v4_borrowck_provenance_resource_exhausted_value { give back }
    if source_text.length() > v4_borrowck_provenance_path_byte_limit_value or route_guard.length() > v4_borrowck_provenance_path_byte_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back
    }
    pilot source_canon = v4_borrowck_path_canon(source_text)
    if source_canon == "" {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }
    if source_canon.length() > v4_borrowck_provenance_path_byte_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back
    }
    if v4_borrowck_provenance_contains_source(provenance_id, source_canon, route_guard) { give back }
    if v4_borrowck_provenance_state(provenance_id) == v4_borrowck_provenance_known_empty {
        array_set(v4_borrowck_provenance_states, provenance_id, v4_borrowck_provenance_known)
        v4_borrowck_provenance_revision_value += 1
    }
    if v4_borrowck_provenance_source_active >= v4_borrowck_provenance_source_fact_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back
    }
    pilot row_id = v4_borrowck_provenance_source_active
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_source_provenance_ids, row_id, provenance_id)
    v4_borrowck_provenance_scratch_store(v4_borrowck_source_paths, row_id, source_canon)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_source_origins, row_id, origin_id)
    v4_borrowck_provenance_scratch_store(v4_borrowck_source_route_guards, row_id, route_guard)
    v4_borrowck_provenance_source_active += 1
    v4_borrowck_provenance_revision_value += 1
}

task v4_borrowck_provenance_add_source(provenance_id: int, source_text: word, origin_id: int) -> void {
    v4_borrowck_provenance_add_source_guarded(provenance_id, source_text, origin_id, "")
}
task v4_borrowck_provenance_union_into(provenance_id: int, incoming_id: int) -> void {
    if not v4_borrowck_provenance_exists(provenance_id) { give back }
    if not v4_borrowck_provenance_exists(incoming_id) {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }
    pilot row_id = 0
    pilot row_count = v4_borrowck_provenance_source_active
    repeat until row_id >= row_count {
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == incoming_id {
            pilot source_guard: word = array_get(v4_borrowck_source_route_guards, row_id)
            v4_borrowck_provenance_add_source_guarded(provenance_id, array_get(v4_borrowck_source_paths, row_id), word_to_int(array_get(v4_borrowck_source_origins, row_id)), source_guard)
        }
        row_id += 1
    }
    if not v4_borrowck_provenance_is_known(incoming_id) { v4_borrowck_provenance_mark_opaque(provenance_id) }
}
task v4_borrowck_provenance_memo_body_head(body_id: int) -> int {
    if body_id < 0 or body_id >= array_len(v4_borrowck_provenance_memo_body_heads) {
        give back 0 - 1
    }
    if body_id >= array_len(v4_borrowck_provenance_memo_body_head_generations) {
        give back 0 - 1
    }
    if word_to_int(array_get(v4_borrowck_provenance_memo_body_head_generations, body_id)) != v4_borrowck_provenance_generation_value {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_borrowck_provenance_memo_body_heads, body_id))
}

task v4_borrowck_provenance_memo_index_insert(body_id: int, memo_id: int) -> void {
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_memo_next_by_body, memo_id, 0 - 1)
    if body_id < 0 {
        give back
    }
    repeat until array_len(v4_borrowck_provenance_memo_body_heads) > body_id {
        array_push(v4_borrowck_provenance_memo_body_heads, word_from_int(0 - 1))
    }
    repeat until array_len(v4_borrowck_provenance_memo_body_head_generations) > body_id {
        array_push(v4_borrowck_provenance_memo_body_head_generations, word_from_int(0 - 1))
    }
    pilot previous_head = v4_borrowck_provenance_memo_body_head(body_id)
    array_set(v4_borrowck_provenance_memo_next_by_body, memo_id, word_from_int(previous_head))
    array_set(v4_borrowck_provenance_memo_body_heads, body_id, word_from_int(memo_id))
    array_set(v4_borrowck_provenance_memo_body_head_generations, body_id, word_from_int(v4_borrowck_provenance_generation_value))
}

task v4_borrowck_provenance_memo_lookup(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word) -> int {
    projection = v4_borrowck_path_canon(projection)
    pilot memo_id = v4_borrowck_provenance_memo_body_head(body_id)
    repeat until memo_id < 0 {
        pilot memo_projection: word = array_get(v4_borrowck_provenance_memo_projections, memo_id)
        if word_to_int(array_get(v4_borrowck_provenance_memo_mir_ids, memo_id)) == mir_id and word_to_int(array_get(v4_borrowck_provenance_memo_body_ids, memo_id)) == body_id and word_to_int(array_get(v4_borrowck_provenance_memo_use_stmts, memo_id)) == use_stmt and word_to_int(array_get(v4_borrowck_provenance_memo_rvalues, memo_id)) == rvalue_id and memo_projection == projection {
            give back memo_id
        }
        memo_id = word_to_int(array_get(v4_borrowck_provenance_memo_next_by_body, memo_id))
    }
    give back 0 - 1
}

task v4_borrowck_provenance_memo_add(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word, provenance_id: int) -> int {
    if v4_borrowck_provenance_memo_active >= v4_borrowck_provenance_memo_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back 0 - 1
    }
    pilot memo_id = v4_borrowck_provenance_memo_active
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_memo_mir_ids, memo_id, mir_id)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_memo_body_ids, memo_id, body_id)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_memo_use_stmts, memo_id, use_stmt)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_memo_rvalues, memo_id, rvalue_id)
    v4_borrowck_provenance_scratch_store(v4_borrowck_provenance_memo_projections, memo_id, v4_borrowck_path_canon(projection))
    v4_borrowck_provenance_scratch_store(v4_borrowck_provenance_memo_states, memo_id, v4_borrowck_provenance_memo_in_progress)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_memo_provenance_ids, memo_id, provenance_id)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_dependency_heads, memo_id, 0 - 1)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_dependency_tails, memo_id, 0 - 1)
    v4_borrowck_provenance_scratch_store(v4_borrowck_provenance_worklist_queued, memo_id, "false")
    v4_borrowck_provenance_memo_index_insert(body_id, memo_id)
    v4_borrowck_provenance_memo_active += 1
    v4_borrowck_provenance_solver_dirty = true
    give back memo_id
}

task v4_borrowck_provenance_memo_provenance(memo_id: int) -> int {
    if memo_id < 0 or memo_id >= v4_borrowck_provenance_memo_active {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_borrowck_provenance_memo_provenance_ids, memo_id))
}

task v4_borrowck_provenance_memo_is_in_progress(memo_id: int) -> bool {
    if memo_id < 0 or memo_id >= v4_borrowck_provenance_memo_active {
        give back false
    }
    pilot memo_state: word = array_get(v4_borrowck_provenance_memo_states, memo_id)
    give back memo_state == v4_borrowck_provenance_memo_in_progress
}

task v4_borrowck_provenance_memo_mark_ready(memo_id: int) -> void {
    if memo_id >= 0 and memo_id < v4_borrowck_provenance_memo_active {
        array_set(v4_borrowck_provenance_memo_states, memo_id, v4_borrowck_provenance_memo_ready)
    }
}

task v4_borrowck_provenance_dependency_add(source_memo: int, dependent_memo: int) -> void {
    if source_memo < 0 or dependent_memo < 0 or source_memo == dependent_memo or v4_borrowck_provenance_resource_exhausted_value {
        give back
    }
    pilot edge_id = word_to_int(array_get(v4_borrowck_provenance_dependency_heads, source_memo))
    repeat until edge_id < 0 {
        if word_to_int(array_get(v4_borrowck_provenance_dependency_dependents, edge_id)) == dependent_memo {
            give back
        }
        edge_id = word_to_int(array_get(v4_borrowck_provenance_dependency_next, edge_id))
    }
    if v4_borrowck_provenance_dependency_active >= v4_borrowck_provenance_dependency_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back
    }
    edge_id = v4_borrowck_provenance_dependency_active
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_dependency_sources, edge_id, source_memo)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_dependency_dependents, edge_id, dependent_memo)
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_dependency_next, edge_id, 0 - 1)
    pilot tail_id = word_to_int(array_get(v4_borrowck_provenance_dependency_tails, source_memo))
    if tail_id < 0 {
        array_set(v4_borrowck_provenance_dependency_heads, source_memo, word_from_int(edge_id))
    } else {
        array_set(v4_borrowck_provenance_dependency_next, tail_id, word_from_int(edge_id))
    }
    array_set(v4_borrowck_provenance_dependency_tails, source_memo, word_from_int(edge_id))
    v4_borrowck_provenance_dependency_active += 1
}

task v4_borrowck_provenance_worklist_reset() -> void {
    pilot work_id = 0
    repeat until work_id >= v4_borrowck_provenance_worklist_active {
        pilot memo_id = word_to_int(array_get(v4_borrowck_provenance_worklist_memos, work_id))
        if memo_id >= 0 and memo_id < array_len(v4_borrowck_provenance_worklist_queued) {
            array_set(v4_borrowck_provenance_worklist_queued, memo_id, "false")
        }
        work_id += 1
    }
    v4_borrowck_provenance_worklist_active = 0
    v4_borrowck_provenance_worklist_cursor = 0
}

task v4_borrowck_provenance_worklist_enqueue(memo_id: int) -> void {
    if memo_id < 0 or memo_id >= v4_borrowck_provenance_memo_active or v4_borrowck_provenance_resource_exhausted_value {
        give back
    }
    if memo_id < array_len(v4_borrowck_provenance_worklist_queued) {
        pilot queued: word = array_get(v4_borrowck_provenance_worklist_queued, memo_id)
        if queued == "true" { give back }
    }
    if v4_borrowck_provenance_worklist_active >= v4_borrowck_provenance_work_item_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back
    }
    v4_borrowck_provenance_scratch_store_integer(v4_borrowck_provenance_worklist_memos, v4_borrowck_provenance_worklist_active, memo_id)
    v4_borrowck_provenance_worklist_active += 1
    v4_borrowck_provenance_scratch_store(v4_borrowck_provenance_worklist_queued, memo_id, "true")
}

task v4_borrowck_provenance_worklist_enqueue_dependents(source_memo: int) -> void {
    if source_memo < 0 or source_memo >= v4_borrowck_provenance_memo_active { give back }
    pilot edge_id = word_to_int(array_get(v4_borrowck_provenance_dependency_heads, source_memo))
    repeat until edge_id < 0 or v4_borrowck_provenance_resource_exhausted_value {
        v4_borrowck_provenance_worklist_enqueue(word_to_int(array_get(v4_borrowck_provenance_dependency_dependents, edge_id)))
        edge_id = word_to_int(array_get(v4_borrowck_provenance_dependency_next, edge_id))
    }
}

task v4_borrowck_path_prefix_conflicts(prefix: word, path_text: word) -> bool {
    if prefix == "" or path_text == "" {
        give back false
    }
    if prefix.length() >= path_text.length() {
        give back false
    }
    if v4_slice(path_text, 0, prefix.length()) != prefix {
        give back false
    }
    pilot next = path_text.char_at(prefix.length())
    give back next == "." or next == "["
}

task v4_borrowck_path_projection_end(path_text: word, start_idx: int) -> int {
    pilot idx = start_idx
    repeat until idx >= path_text.length() {
        pilot ch = path_text.char_at(idx)
        if ch == "." or ch == "[" or ch == "]" {
            give back idx
        }
        idx += 1
    }
    give back path_text.length()
}

task v4_borrowck_path_index_close(path_text: word, open_idx: int) -> int {
    if open_idx < 0 or open_idx >= path_text.length() or path_text.char_at(open_idx) != "[" {
        give back 0 - 1
    }
    pilot depth = 1
    pilot idx = open_idx + 1
    repeat until idx >= path_text.length() {
        pilot ch = path_text.char_at(idx)
        if ch == "[" {
            depth += 1
        } else if ch == "]" {
            depth -= 1
            if depth == 0 {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_borrowck_path_index_char_is_digit(ch: word) -> bool {
    give back ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"
}

task v4_borrowck_path_index_is_integer_literal(index_text: word) -> bool {
    if index_text == "" {
        give back false
    }
    pilot idx = 0
    pilot first = index_text.char_at(0)
    if first == "+" or first == "-" {
        idx = 1
    }
    if idx >= index_text.length() {
        give back false
    }
    repeat until idx >= index_text.length() {
        if not v4_borrowck_path_index_char_is_digit(index_text.char_at(idx)) {
            give back false
        }
        idx += 1
    }
    give back true
}

-- Only integer literal indices prove disjoint; every other index pair may alias.
task v4_borrowck_projection_paths_may_alias(left: word, right: word) -> bool {
    pilot left_idx = v4_borrowck_path_projection_end(left, 0)
    pilot right_idx = v4_borrowck_path_projection_end(right, 0)
    if v4_slice(left, 0, left_idx) != v4_slice(right, 0, right_idx) {
        give back false
    }

    repeat until left_idx >= left.length() and right_idx >= right.length() {
        if left_idx >= left.length() or right_idx >= right.length() {
            give back true
        }
        pilot left_kind = left.char_at(left_idx)
        pilot right_kind = right.char_at(right_idx)
        if left_kind == "." and right_kind == "." {
            pilot left_end = v4_borrowck_path_projection_end(left, left_idx + 1)
            pilot right_end = v4_borrowck_path_projection_end(right, right_idx + 1)
            if left_end <= left_idx + 1 or right_end <= right_idx + 1 {
                give back false
            }
            if v4_slice(left, left_idx + 1, left_end) != v4_slice(right, right_idx + 1, right_end) {
                give back false
            }
            left_idx = left_end
            right_idx = right_end
        } else if left_kind == "[" and right_kind == "[" {
            pilot left_close = v4_borrowck_path_index_close(left, left_idx)
            pilot right_close = v4_borrowck_path_index_close(right, right_idx)
            if left_close < 0 or right_close < 0 {
                give back true
            }
            pilot left_index = v4_slice(left, left_idx + 1, left_close)
            pilot right_index = v4_slice(right, right_idx + 1, right_close)
            if v4_borrowck_path_index_is_integer_literal(left_index) and v4_borrowck_path_index_is_integer_literal(right_index) {
                if word_to_int(left_index) != word_to_int(right_index) {
                    give back false
                }
            } else {
                give back true
            }
            left_idx = left_close + 1
            right_idx = right_close + 1
        } else {
            give back false
        }
    }
    give back true
}

task v4_borrowck_paths_overlap(left: word, right: word) -> bool {
    pilot left_canon = v4_borrowck_path_canon(left)
    pilot right_canon = v4_borrowck_path_canon(right)
    if left_canon == "" or right_canon == "" {
        give back false
    }
    if left_canon == right_canon {
        give back true
    }
    if v4_borrowck_path_prefix_conflicts(left_canon, right_canon) {
        give back true
    }
    if v4_borrowck_path_prefix_conflicts(right_canon, left_canon) {
        give back true
    }
    give back v4_borrowck_projection_paths_may_alias(left_canon, right_canon)
}

task v4_borrowck_path_has_symbolic_index(path_text: word) -> bool {
    pilot canon = v4_borrowck_path_canon(path_text)
    pilot idx = 0
    repeat until idx >= canon.length() {
        if canon.char_at(idx) == "[" {
            pilot close_idx = v4_borrowck_path_index_close(canon, idx)
            if close_idx < 0 {
                give back true
            }
            pilot index_text = v4_slice(canon, idx + 1, close_idx)
            if not v4_borrowck_path_index_is_integer_literal(index_text) {
                give back true
            }
            idx = close_idx + 1
        } else {
            idx += 1
        }
    }
    give back false
}

task v4_borrowck_path_write_definitely_covers(write_path: word, holder_path: word) -> bool {
    pilot write_canon = v4_borrowck_path_canon(write_path)
    pilot holder_canon = v4_borrowck_path_canon(holder_path)
    if write_canon == "" or holder_canon == "" or v4_borrowck_path_has_symbolic_index(write_canon) {
        give back false
    }
    if write_canon == holder_canon {
        give back true
    }
    give back v4_borrowck_path_prefix_conflicts(write_canon, holder_canon)
}

task v4_borrowck_path_projection_depth(path_text: word) -> int {
    pilot canon = v4_borrowck_path_canon(path_text)
    pilot idx = v4_borrowck_path_projection_end(canon, 0)
    pilot depth = 0
    repeat until idx >= canon.length() {
        pilot kind = canon.char_at(idx)
        if kind == "." {
            idx = v4_borrowck_path_projection_end(canon, idx + 1)
            depth += 1
        } else if kind == "[" {
            pilot close_idx = v4_borrowck_path_index_close(canon, idx)
            if close_idx < 0 {
                give back depth + 1
            }
            idx = close_idx + 1
            depth += 1
        } else {
            idx += 1
        }
    }
    give back depth
}

-- A descendant write mutates through a holder; it does not define the holder.
task v4_borrowck_path_write_may_bind(write_path: word, holder_path: word) -> bool {
    pilot write_canon = v4_borrowck_path_canon(write_path)
    pilot holder_canon = v4_borrowck_path_canon(holder_path)
    if not v4_borrowck_paths_overlap(write_canon, holder_canon) {
        give back false
    }
    give back v4_borrowck_path_projection_depth(write_canon) <= v4_borrowck_path_projection_depth(holder_canon)
}

task v4_borrowck_path_root(path_text: word) -> word {
    pilot canon = v4_borrowck_path_canon(path_text)
    if canon == "" {
        give back ""
    }
    pilot idx = 0
    repeat until idx >= canon.length() {
        pilot ch = canon.char_at(idx)
        if ch == "." or ch == "[" {
            give back v4_slice(canon, 0, idx)
        }
        idx += 1
    }
    give back canon
}

task v4_borrowck_local_mode_for_path(mir_id: int, body_id: int, path_text: word) -> word {
    pilot root = v4_borrowck_path_root(path_text)
    if root == "" {
        give back v4_ty_param_mode_value
    }
    give back v4_mir_local_mode_for_name(mir_id, body_id, root)
}

task v4_borrowck_lend_holder_mode_for_projection(mir_id: int, body_id: int, path_text: word, skip_leaf: bool) -> word {
    pilot canon = v4_borrowck_path_canon(path_text)
    pilot root = v4_borrowck_path_root(canon)
    if root == "" or canon == root {
        give back v4_ty_param_mode_value
    }

    pilot mode = v4_ty_param_mode_value
    pilot place_id = 0
    pilot place_count = v4_mir_body_place_count(mir_id, body_id)
    repeat until place_id >= place_count {
        if v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id)) == canon {
            pilot current_place = place_id
            if skip_leaf {
                current_place = v4_mir_place_base(mir_id, body_id, current_place)
            }
            pilot depth = 0
            repeat until current_place < 0 or depth > place_count {
                pilot place_ty = v4_mir_place_ty(mir_id, body_id, current_place)
                if v4_ty_is_lend_type(place_ty) {
                    pilot place_mode = v4_ty_lend_mode(place_ty)
                    if place_mode == v4_ty_param_mode_lend {
                        give back place_mode
                    }
                    if place_mode == v4_ty_param_mode_lend_mut {
                        mode = place_mode
                    }
                }
                current_place = v4_mir_place_base(mir_id, body_id, current_place)
                depth += 1
            }
        }
        place_id += 1
    }

    pilot local_ty = v4_mir_local_ty_for_name(mir_id, body_id, root)
    if v4_ty_is_lend_type(local_ty) {
        pilot local_mode = v4_ty_lend_mode(local_ty)
        if local_mode == v4_ty_param_mode_lend {
            give back local_mode
        }
        if local_mode == v4_ty_param_mode_lend_mut {
            mode = local_mode
        }
    }
    give back mode
}

task v4_borrowck_path_is_lent(mir_id: int, body_id: int, path_text: word) -> bool {
    pilot mode = v4_borrowck_local_mode_for_path(mir_id, body_id, path_text)
    give back mode == v4_ty_param_mode_lend or mode == v4_ty_param_mode_lend_mut
}

task v4_borrowck_lend_contract_help(path_text: word, mode: word, path_kind: word, stmt_id: int, block_id: int) -> word {
    pilot root = v4_borrowck_path_root(path_text)
    pilot out = root + " is a " + mode + " parameter"
    out = out + " in block " + word_from_int(block_id)
    out = out + " at statement " + word_from_int(stmt_id)
    if path_kind == v4_borrowck_path_write {
        out = out + "; use lend mut only when the caller grants exclusive mutation"
    } else if path_kind == v4_borrowck_path_move {
        out = out + "; borrowed parameters stay owned by the caller"
    }
    give back out
}

task v4_borrowck_lend_holder_write_help(path_text: word, stmt_id: int, block_id: int) -> word {
    pilot root = v4_borrowck_path_root(path_text)
    pilot out = root + " is an immutable loan holder in block " + word_from_int(block_id)
    out = out + " at statement " + word_from_int(stmt_id)
    out = out + "; use lend mut when writing through " + v4_borrowck_path_canon(path_text)
    give back out
}

task v4_borrowck_lend_holder_move_help(path_text: word, mode: word, stmt_id: int, block_id: int) -> word {
    pilot root = v4_borrowck_path_root(path_text)
    pilot out = root + " is a " + mode + " loan holder in block " + word_from_int(block_id)
    out = out + " at statement " + word_from_int(stmt_id)
    out = out + "; " + v4_borrowck_path_canon(path_text) + " remains owned behind the loan"
    give back out
}

task v4_borrowck_check_lend_contracts(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot path_idx = 0
    repeat until path_idx >= path_count {
        pilot path_kind = v4_borrowck_path_kind(borrow_id, result_id, path_idx)
        pilot path_text = v4_borrowck_path_text(borrow_id, result_id, path_idx)
        pilot mode = v4_borrowck_local_mode_for_path(mir_id, body_id, path_text)
        pilot holder_projection = false
        if (path_kind == v4_borrowck_path_write or path_kind == v4_borrowck_path_move) and mode == v4_ty_param_mode_value {
            mode = v4_borrowck_lend_holder_mode_for_projection(mir_id, body_id, path_text, path_kind == v4_borrowck_path_write)
            holder_projection = mode != v4_ty_param_mode_value
        }
        if mode == v4_ty_param_mode_lend or mode == v4_ty_param_mode_lend_mut {
            pilot stmt_id = v4_borrowck_path_stmt(borrow_id, result_id, path_idx)
            pilot block_id = v4_borrowck_path_block(borrow_id, result_id, path_idx)
            if path_kind == v4_borrowck_path_move {
                pilot stmt_span = v4_borrowck_use_diag_span(mir_id, body_id, stmt_id)
                pilot move_message = "Meiya refuses to move out of a borrowed parameter"
                pilot help = v4_borrowck_lend_contract_help(path_text, mode, path_kind, stmt_id, block_id)
                if holder_projection {
                    move_message = "Meiya refuses to move out through a lend holder"
                    help = v4_borrowck_lend_holder_move_help(path_text, mode, stmt_id, block_id)
                }
                v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, move_message, help))
                v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                conflicts += 1
            } else if path_kind == v4_borrowck_path_write and mode == v4_ty_param_mode_lend {
                pilot write_span = v4_borrowck_write_diag_span(mir_id, body_id, stmt_id)
                pilot write_message = "Meiya refuses to mutate an immutable lend parameter"
                pilot write_help = v4_borrowck_lend_contract_help(path_text, mode, path_kind, stmt_id, block_id)
                if holder_projection {
                    write_message = "Meiya refuses to mutate through an immutable lend"
                    write_help = v4_borrowck_lend_holder_write_help(path_text, stmt_id, block_id)
                }
                v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, write_span, write_message, write_help))
                v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                conflicts += 1
            }
        }
        path_idx += 1
    }
    give back conflicts
}

task v4_borrowck_stmt_for_rvalue(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 {
        give back 0 - 1
    }
    pilot rvalue_span = v4_mir_rvalue_span(mir_id, body_id, rvalue_id)
    pilot rvalue_start = v4_span_start(rvalue_span)
    pilot rvalue_end = v4_span_end(rvalue_span)
    pilot enclosing_stmt = 0 - 1
    pilot enclosing_width = 0 - 1
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_rvalue(mir_id, body_id, stmt_id) == rvalue_id {
            give back stmt_id
        }
        pilot stmt_span = v4_mir_stmt_span(mir_id, body_id, stmt_id)
        pilot stmt_start = v4_span_start(stmt_span)
        pilot stmt_end = v4_span_end(stmt_span)
        if rvalue_end >= rvalue_start and stmt_end >= stmt_start and stmt_start <= rvalue_start and stmt_end >= rvalue_end {
            pilot width = stmt_end - stmt_start
            if enclosing_stmt < 0 or width < enclosing_width {
                enclosing_stmt = stmt_id
                enclosing_width = width
            }
        }
        stmt_id += 1
    }
    give back enclosing_stmt
}

task v4_borrowck_type_retains_aggregate_children(mir_id: int, type_text: word) -> bool {
    if v4_ty_is_fixed_array_type(type_text) {
        give back v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), type_text) != "0"
    }
    give back true
}

task v4_borrowck_rvalue_retains_aggregate_children(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 { give back false }
    give back v4_borrowck_type_retains_aggregate_children(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
}

task v4_borrowck_ty_is_fixed_aggregate(mir_id: int, type_text: word) -> bool {
    if v4_ty_is_tuple_type(type_text) or v4_ty_is_fixed_array_type(type_text) {
        give back true
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_shape_signature_id_for_name(ty_id, type_text) >= 0 or v4_ty_route_signature_id_for_name(ty_id, type_text) >= 0
}

task v4_borrowck_path_type_may_hide_borrow(mir_id: int, body_id: int, path: word) -> bool {
    pilot root = v4_borrowck_path_root(path)
    if root == "" {
        give back false
    }
    pilot local_ty = v4_mir_local_ty_for_name(mir_id, body_id, root)
    give back v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), local_ty) or v4_ty_is_closure_type(local_ty) or local_ty.contains("closure[")
}

task v4_borrowck_rvalue_projection_is_borrow_capable_depth(mir_id: int, body_id: int, rvalue_id: int, projection: word, use_stmt: int, depth: int, seen: word) -> bool {
    if projection == "" {
        give back v4_borrowck_rvalue_is_borrow_capable_depth(mir_id, body_id, rvalue_id, use_stmt, depth, seen)
    }
    if rvalue_id < 0 or depth > 32 {
        if rvalue_id < 0 {
            give back false
        }
        pilot deep_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        give back v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), deep_ty) or v4_ty_is_closure_type(deep_ty) or deep_ty.contains("closure[")
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        pilot projected_path = v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) + projection
        if v4_borrowck_path_is_lent(mir_id, body_id, projected_path) {
            give back true
        }
        give back v4_borrowck_path_has_reaching_borrow(mir_id, body_id, projected_path, use_stmt, depth + 1, seen)
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot segment = v4_borrowck_projection_first(projection)
        pilot tail = v4_borrowck_projection_tail(projection)
        pilot child_id = v4_borrowck_aggregate_child_for_segment(mir_id, body_id, rvalue_id, segment)
        if child_id == 0 - 2 {
            pilot candidate_id = 0
            pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
            repeat until candidate_id >= child_count {
                if v4_borrowck_rvalue_projection_is_borrow_capable_depth(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, candidate_id), tail, use_stmt, depth + 1, seen) {
                    give back true
                }
                candidate_id += 1
            }
            give back false
        }
        if child_id >= 0 {
            give back v4_borrowck_rvalue_projection_is_borrow_capable_depth(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), tail, use_stmt, depth + 1, seen)
        }
    }
    give back v4_borrowck_rvalue_is_borrow_capable_depth(mir_id, body_id, rvalue_id, use_stmt, depth + 1, seen)
}

task v4_borrowck_path_has_reaching_borrow(mir_id: int, body_id: int, path: word, use_stmt: int, depth: int, seen: word) -> bool {
    pilot path_canon = v4_borrowck_path_canon(path)
    pilot path_root = v4_borrowck_path_root(path_canon)
    if path_canon == "" or path_root == "" {
        give back false
    }
    if depth > 32 or v4_borrowck_holder_seen(seen, path_canon, use_stmt) {
        give back v4_borrowck_path_type_may_hide_borrow(mir_id, body_id, path_canon)
    }
    seen = v4_borrowck_holder_seen_append(seen, path_canon, use_stmt)

    pilot projected_query: bool = path_canon != path_root
    pilot use_block = 0 - 1
    if use_stmt >= 0 {
        use_block = v4_mir_stmt_block(mir_id, body_id, use_stmt)
    }
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
        if stmt_id != use_stmt and (stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign) {
            pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
            if place_id >= 0 {
                pilot assigned_path = v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id))
                pilot may_define: bool = v4_borrowck_path_root(assigned_path) == path_root
                if projected_query {
                    may_define = v4_borrowck_path_write_may_bind(assigned_path, path_canon)
                }
                if may_define {
                    pilot assigned_rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
                    if assigned_rvalue >= 0 {
                        pilot tracked_path = assigned_path
                        pilot assigned_projection = ""
                        if projected_query {
                            tracked_path = path_canon
                            if assigned_path != path_canon and v4_borrowck_path_prefix_conflicts(assigned_path, path_canon) {
                                assigned_projection = v4_slice(path_canon, assigned_path.length(), path_canon.length())
                            }
                        }
                        pilot reaches = use_stmt < 0
                        if not reaches {
                            pilot origin_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
                            reaches = v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, tracked_path, stmt_id, stmt_id, origin_block, use_stmt, use_block)
                        }
                        if reaches and v4_borrowck_rvalue_projection_is_borrow_capable_depth(mir_id, body_id, assigned_rvalue, assigned_projection, stmt_id, depth + 1, seen) {
                            give back true
                        }
                    }
                }
            }
        }
        stmt_id += 1
    }
    give back false
}

task v4_borrowck_rvalue_is_borrow_capable_depth(mir_id: int, body_id: int, rvalue_id: int, use_stmt: int, depth: int, seen: word) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    if depth > 32 {
        pilot deep_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        give back v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), deep_ty) or v4_ty_is_closure_type(deep_ty) or deep_ty.contains("closure[")
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back true
    }
    if v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        give back true
    }
    if kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut {
        give back true
    }
    if kind == v4_mir_rvalue_capture_copy or kind == v4_mir_rvalue_capture_move {
        if v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
            give back true
        }
        pilot capture_path = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if v4_borrowck_path_is_lent(mir_id, body_id, capture_path) {
            give back true
        }
        give back v4_borrowck_path_has_reaching_borrow(mir_id, body_id, capture_path, use_stmt, depth, seen)
    }
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        pilot local_path = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if v4_borrowck_path_is_lent(mir_id, body_id, local_path) {
            give back true
        }
        give back v4_borrowck_path_has_reaching_borrow(mir_id, body_id, local_path, use_stmt, depth, seen)
    }
    if kind == v4_mir_rvalue_call and v4_ty_is_closure_type(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
        pilot call_stmt = v4_borrowck_stmt_for_rvalue(mir_id, body_id, rvalue_id)
        if call_stmt < 0 {
            call_stmt = use_stmt
        }
        pilot arg_id = 0
        pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
        repeat until arg_id >= arg_count {
            if v4_borrowck_rvalue_is_borrow_capable_depth(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id), call_stmt, depth + 1, seen) {
                give back true
            }
            arg_id += 1
        }
        give back false
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) and v4_borrowck_rvalue_retains_aggregate_children(mir_id, body_id, rvalue_id) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_borrowck_rvalue_is_borrow_capable_depth(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), use_stmt, depth + 1, seen) {
                give back true
            }
            child_id += 1
        }
    }
    give back false
}

task v4_borrowck_rvalue_is_borrow_capable(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    pilot use_stmt = v4_borrowck_stmt_for_rvalue(mir_id, body_id, rvalue_id)
    give back v4_borrowck_rvalue_is_borrow_capable_depth(mir_id, body_id, rvalue_id, use_stmt, 0, "")
}

task v4_borrowck_provenance_union_borrow_capable_call_args(mir_id: int, body_id: int, use_stmt: int, call_rvalue: int, provenance_id: int) -> void {
    pilot arg_id = 0
    pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, call_rvalue)
    repeat until arg_id >= arg_count {
        pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue, arg_id)
        if v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, arg_rvalue) {
            pilot arg_provenance = v4_borrowck_return_lend_provenance(mir_id, body_id, use_stmt, arg_rvalue)
            v4_borrowck_provenance_union_into(provenance_id, arg_provenance)
        }
        arg_id += 1
    }
}

task v4_borrowck_projection_match_tail(pattern: word, actual: word) -> word {
    pattern = v4_borrowck_path_canon(pattern)
    actual = v4_borrowck_path_canon(actual)
    if pattern == "" { give back actual }
    if actual == "" { give back "#no-match" }
    pilot pattern_segment = v4_borrowck_projection_first(pattern)
    pilot actual_segment = v4_borrowck_projection_first(actual)
    pilot segment_matches: bool = pattern_segment == actual_segment
    if pattern_segment == "[*]" and actual_segment.length() > 2 and actual_segment.char_at(0) == "[" {
        segment_matches = true
    }
    if not segment_matches { give back "#no-match" }
    give back v4_borrowck_projection_match_tail(v4_borrowck_projection_tail(pattern), v4_borrowck_projection_tail(actual))
}

task v4_borrowck_fill_return_call_lend_provenance(mir_id: int, body_id: int, use_stmt: int, call_rvalue: int, projection: word, provenance_id: int) -> void {
    projection = v4_borrowck_path_canon(projection)
    pilot leaf_count = v4_mir_rvalue_call_return_lend_leaf_count(mir_id, body_id, call_rvalue)
    if leaf_count < 0 {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        v4_borrowck_provenance_union_borrow_capable_call_args(mir_id, body_id, use_stmt, call_rvalue, provenance_id)
        give back
    }
    if leaf_count == 0 {
        v4_borrowck_provenance_mark_known_empty(provenance_id)
        give back
    }

    pilot matched_leaf = false
    pilot mapped_source = false
    pilot mapping_failed = false
    pilot leaf_id = 0
    repeat until leaf_id >= leaf_count {
        pilot return_projection = v4_mir_rvalue_call_return_lend_leaf_projection_at(mir_id, body_id, call_rvalue, leaf_id)
        pilot projection_tail = ""
        pilot leaf_matches: bool = projection == ""
        if not leaf_matches {
            projection_tail = v4_borrowck_projection_match_tail(return_projection, projection)
            leaf_matches = projection_tail != "#no-match"
        }
        if leaf_matches {
            matched_leaf = true
            pilot source_payload = v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id, body_id, call_rvalue, leaf_id)
            pilot source_count = v4_ty_return_lend_source_payload_count(source_payload)
            if source_count <= 0 {
                mapping_failed = true
                v4_borrowck_provenance_mark_opaque(provenance_id)
            } else {
                pilot source_id = 0
                repeat until source_id >= source_count {
                    pilot source_edge = v4_ty_return_lend_source_payload_at(source_payload, source_id)
                    pilot source_arg = word_to_int(v4_resolve_snapshot_field_raw(source_edge, 0))
                    pilot source_projection = v4_resolve_snapshot_field_raw(source_edge, 1)
                    pilot source_guard = v4_resolve_snapshot_field_raw(source_edge, 2)
                    if source_edge == "" or source_arg < 0 {
                        mapping_failed = true
                        v4_borrowck_provenance_mark_opaque(provenance_id)
                    } else if v4_borrowck_rvalue_matches_route_guard_projected_at(mir_id, body_id, use_stmt, source_arg, source_projection, source_guard) {
                        mapped_source = true
                        pilot source_provenance = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, use_stmt, source_arg, source_projection + projection_tail)
                        v4_borrowck_provenance_union_into(provenance_id, source_provenance)
                    }
                    source_id += 1
                }
            }
        }
        leaf_id += 1
    }
    if not matched_leaf {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        mapping_failed = true
    }
    if mapping_failed {
        v4_borrowck_provenance_union_borrow_capable_call_args(mir_id, body_id, use_stmt, call_rvalue, provenance_id)
    } else if matched_leaf and not mapped_source {
        v4_borrowck_provenance_mark_known_empty(provenance_id)
    }
}

task v4_borrowck_provenance_union_projected_into(provenance_id: int, incoming_id: int, suffix: word) -> void {
    if not v4_borrowck_provenance_exists(provenance_id) or not v4_borrowck_provenance_exists(incoming_id) {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }
    if provenance_id == incoming_id {
        if suffix != "" {
            v4_borrowck_provenance_mark_opaque(provenance_id)
        }
        give back
    }

    pilot row_id = 0
    pilot row_count = v4_borrowck_provenance_source_active
    repeat until row_id >= row_count {
        if word_to_int(array_get(v4_borrowck_source_provenance_ids, row_id)) == incoming_id {
            pilot source_path: word = array_get(v4_borrowck_source_paths, row_id)
            if source_path.length() + suffix.length() > v4_borrowck_provenance_path_byte_limit_value {
                v4_borrowck_provenance_trip_resource_limit()
                give back
            }
            pilot projected: word = source_path + suffix
            pilot origin_id = word_to_int(array_get(v4_borrowck_source_origins, row_id))
            pilot route_guard: word = array_get(v4_borrowck_source_route_guards, row_id)
            v4_borrowck_provenance_add_source_guarded(provenance_id, projected, origin_id, route_guard)
        }
        row_id += 1
    }
    if not v4_borrowck_provenance_is_known(incoming_id) {
        v4_borrowck_provenance_mark_opaque(provenance_id)
    }
}
task v4_borrowck_projection_segment_end(projection: word) -> int {
    projection = v4_borrowck_path_canon(projection)
    if projection == "" {
        give back 0
    }
    if projection.char_at(0) == "[" {
        pilot idx = 1
        repeat until idx >= projection.length() {
            if projection.char_at(idx) == "]" {
                give back idx + 1
            }
            idx += 1
        }
        give back projection.length()
    }
    if projection.char_at(0) == "." {
        pilot idx = 1
        repeat until idx >= projection.length() {
            pilot ch = projection.char_at(idx)
            if ch == "." or ch == "[" {
                give back idx
            }
            idx += 1
        }
        give back projection.length()
    }
    give back 0
}

task v4_borrowck_projection_first(projection: word) -> word {
    projection = v4_borrowck_path_canon(projection)
    pilot segment_end = v4_borrowck_projection_segment_end(projection)
    if segment_end <= 0 {
        give back ""
    }
    give back v4_slice(projection, 0, segment_end)
}

task v4_borrowck_projection_tail(projection: word) -> word {
    projection = v4_borrowck_path_canon(projection)
    pilot segment_end = v4_borrowck_projection_segment_end(projection)
    if segment_end <= 0 or segment_end >= projection.length() {
        give back ""
    }
    give back v4_slice(projection, segment_end, projection.length())
}

task v4_borrowck_projection_field_name(segment: word) -> word {
    if segment.length() <= 1 or segment.char_at(0) != "." {
        give back ""
    }
    give back v4_slice(segment, 1, segment.length())
}

task v4_borrowck_projection_index_text(segment: word) -> word {
    if segment.length() <= 2 or segment.char_at(0) != "[" or segment.char_at(segment.length() - 1) != "]" {
        give back ""
    }
    give back v4_slice(segment, 1, segment.length() - 1)
}

-- -2 means a dynamic fixed-array projection must conservatively union every child.
task v4_borrowck_aggregate_child_for_segment(mir_id: int, body_id: int, rvalue_id: int, segment: word) -> int {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_tuple {
        pilot slot_text = v4_borrowck_projection_field_name(segment)
        if slot_text != "" and v4_ty_is_integer_text_literal(slot_text) and slot_text.char_at(0) != "-" {
            pilot slot_id = word_to_int(slot_text)
            if slot_id >= 0 and slot_id < child_count {
                give back slot_id
            }
        }
        give back 0 - 1
    }
    if kind == v4_mir_rvalue_array {
        pilot index_text = v4_borrowck_projection_index_text(segment)
        if child_count == 1 {
            give back 0
        }
        if index_text != "" and v4_ty_is_integer_text_literal(index_text) and index_text.char_at(0) != "-" {
            pilot element_id = word_to_int(index_text)
            if element_id >= 0 and element_id < child_count {
                give back element_id
            }
            give back 0 - 1
        }
        give back 0 - 2
    }
    if kind == v4_mir_rvalue_construct {
        pilot field_name = v4_borrowck_projection_field_name(segment)
        if field_name == "" {
            give back 0 - 1
        }
        pilot ty_id = v4_mir_ty_id(mir_id)
        pilot aggregate_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        if v4_ty_is_route_type(ty_id, aggregate_ty) {
            pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
            pilot next_case = v4_mir_path_right(case_name)
            repeat until next_case == "" {
                case_name = next_case
                next_case = v4_mir_path_right(case_name)
            }
            give back v4_ty_route_case_field_id_for_name(ty_id, aggregate_ty, case_name, field_name)
        }
        give back v4_ty_shape_field_id_for_name(ty_id, aggregate_ty, field_name)
    }
    give back 0 - 1
}

task v4_borrowck_fill_aggregate_projection_provenance(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word, provenance_id: int) -> void {
    pilot segment = v4_borrowck_projection_first(projection)
    pilot tail = v4_borrowck_projection_tail(projection)
    if segment == "" {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }

    pilot child_id = v4_borrowck_aggregate_child_for_segment(mir_id, body_id, rvalue_id, segment)
    if child_id == 0 - 2 {
        pilot candidate_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        child_id = 0
        repeat until child_id >= child_count {
            pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
            if child_rvalue >= 0 {
                candidate_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, use_stmt, child_rvalue, tail)
                v4_borrowck_provenance_union_into(provenance_id, candidate_id)
            } else {
                v4_borrowck_provenance_mark_opaque(provenance_id)
            }
            child_id += 1
        }
        give back
    }
    if child_id < 0 {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }

    pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
    if child_rvalue < 0 {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }
    pilot candidate_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, use_stmt, child_rvalue, tail)
    v4_borrowck_provenance_union_into(provenance_id, candidate_id)
}

task v4_borrowck_fill_param_lend_provenance(mir_id: int, body_id: int, holder: word, suffix: word, provenance_id: int) -> bool {
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 { give back false }
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_id = v4_ty_signature_param_index_for_name(ty_id, sig_id, holder)
    if param_id < 0 { give back false }

    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        v4_borrowck_provenance_add_source(provenance_id, holder + suffix, 0 - 1)
        give back true
    }

    pilot param_type = v4_ty_signature_param_type(ty_id, sig_id, param_id)
    pilot leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, param_type)
    if leaf_count < 0 {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back true
    }
    pilot matched: bool = false
    pilot leaf_id = 0
    repeat until leaf_id >= leaf_count {
        pilot leaf_projection = v4_ty_fixed_lend_leaf_projection_at(ty_id, param_type, leaf_id)
        pilot leaf_guard = v4_ty_fixed_lend_leaf_route_guard_at(ty_id, param_type, leaf_id)
        if suffix == "" {
            v4_borrowck_provenance_add_source_guarded(provenance_id, holder + leaf_projection, 0 - 1, leaf_guard)
            matched = true
        } else if v4_borrowck_projection_match_tail(leaf_projection, suffix) != "#no-match" {
            v4_borrowck_provenance_add_source_guarded(provenance_id, holder + suffix, 0 - 1, leaf_guard)
            matched = true
        }
        leaf_id += 1
    }
    give back matched
}
task v4_borrowck_fill_holder_lend_provenance(mir_id: int, body_id: int, use_stmt: int, holder: word, suffix: word, provenance_id: int) -> void {
    pilot holder_canon = v4_borrowck_path_canon(holder)
    suffix = v4_borrowck_path_canon(suffix)
    pilot holder_ty = v4_mir_local_ty_for_name(mir_id, body_id, holder_canon)
    pilot aggregate_holder = not v4_ty_is_lend_type(holder_ty) and v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), holder_ty)
    pilot queried_holder = holder_canon + suffix
    pilot seeded_param = v4_borrowck_fill_param_lend_provenance(mir_id, body_id, holder_canon, suffix, provenance_id)

    pilot use_block = v4_mir_stmt_block(mir_id, body_id, use_stmt)
    if holder_canon == "" {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }

    pilot found_reaching_binding = false
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if stmt_id != use_stmt and v4_borrowck_stmt_may_bind_holder(mir_id, body_id, stmt_id, queried_holder) {
            pilot origin_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
            if v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, queried_holder, stmt_id, stmt_id, origin_block, use_stmt, use_block) {
                found_reaching_binding = true
                pilot origin_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
                if origin_id < 0 {
                    v4_borrowck_provenance_mark_opaque(provenance_id)
                } else {
                    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
                    pilot place_canon = ""
                    if place_id >= 0 {
                        place_canon = v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id))
                    }
                    if aggregate_holder {
                        pilot projection_known = true
                        pilot origin_projection = ""
                        if place_canon == holder_canon {
                            origin_projection = suffix
                        } else if place_canon == queried_holder {
                            origin_projection = ""
                        } else if v4_borrowck_path_prefix_conflicts(place_canon, queried_holder) {
                            origin_projection = v4_slice(queried_holder, place_canon.length(), queried_holder.length())
                        } else if v4_borrowck_paths_overlap(place_canon, queried_holder) {
                            origin_projection = ""
                        } else {
                            projection_known = false
                            v4_borrowck_provenance_mark_opaque(provenance_id)
                        }
                        if projection_known {
                            pilot candidate_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, stmt_id, origin_id, origin_projection)
                            v4_borrowck_provenance_union_into(provenance_id, candidate_id)
                        }
                    } else {
                        pilot candidate_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, stmt_id, origin_id, "")
                        v4_borrowck_provenance_union_projected_into(provenance_id, candidate_id, suffix)
                    }
                }
            }
        }
        stmt_id += 1
    }
    if not found_reaching_binding and not seeded_param {
        v4_borrowck_provenance_mark_opaque(provenance_id)
    }
}

task v4_borrowck_fill_explicit_lend_provenance(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, provenance_id: int) -> void {
    pilot source_text = v4_borrowck_path_canon(v4_borrowck_lend_source_text(mir_id, body_id, rvalue_id))
    pilot source_root = v4_borrowck_path_root(source_text)
    if source_root == "" {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }

    pilot source_mode = v4_borrowck_local_mode_for_path(mir_id, body_id, source_text)
    pilot source_ty = v4_mir_local_ty_for_name(mir_id, body_id, source_root)
    pilot projection_mode = v4_borrowck_lend_holder_mode_for_projection(mir_id, body_id, source_text, false)
    pilot projected_holder: bool = projection_mode == v4_ty_param_mode_lend or projection_mode == v4_ty_param_mode_lend_mut
    if source_mode == v4_ty_param_mode_lend or source_mode == v4_ty_param_mode_lend_mut {
        v4_borrowck_provenance_add_source(provenance_id, source_text, rvalue_id)
        give back
    }
    if not v4_ty_is_lend_type(source_ty) and not projected_holder {
        v4_borrowck_provenance_add_source(provenance_id, source_text, rvalue_id)
        give back
    }

    pilot suffix = ""
    if source_text.length() > source_root.length() {
        suffix = v4_slice(source_text, source_root.length(), source_text.length())
    }
    v4_borrowck_fill_holder_lend_provenance(mir_id, body_id, use_stmt, source_root, suffix, provenance_id)
}

task v4_borrowck_fill_return_lend_provenance(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word, provenance_id: int) -> void {
    if rvalue_id < 0 {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        give back
    }

    projection = v4_borrowck_path_canon(projection)
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        if projection != "" {
            v4_borrowck_fill_aggregate_projection_provenance(mir_id, body_id, use_stmt, rvalue_id, projection, provenance_id)
            give back
        }

        pilot found_child = false
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
            if child_rvalue >= 0 and v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, child_rvalue) {
                found_child = true
                pilot candidate_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, use_stmt, child_rvalue, "")
                v4_borrowck_provenance_union_into(provenance_id, candidate_id)
            }
            child_id += 1
        }
        if not found_child and v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
            v4_borrowck_provenance_mark_opaque(provenance_id)
        }
        give back
    }

    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        pilot holder_path = v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        pilot holder_root = v4_borrowck_path_root(holder_path)
        if holder_root == "" {
            v4_borrowck_provenance_mark_opaque(provenance_id)
            give back
        }
        pilot holder_projection = ""
        if holder_path.length() > holder_root.length() {
            holder_projection = v4_slice(holder_path, holder_root.length(), holder_path.length())
        }
        v4_borrowck_fill_holder_lend_provenance(mir_id, body_id, use_stmt, holder_root, holder_projection + projection, provenance_id)
        give back
    }

    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        if projection == "" {
            v4_borrowck_fill_explicit_lend_provenance(mir_id, body_id, use_stmt, rvalue_id, provenance_id)
        } else {
            pilot base_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, use_stmt, rvalue_id, "")
            v4_borrowck_provenance_union_projected_into(provenance_id, base_id, projection)
        }
        give back
    }
    if kind == v4_mir_rvalue_call {
        v4_borrowck_fill_return_call_lend_provenance(mir_id, body_id, use_stmt, rvalue_id, projection, provenance_id)
        give back
    }

    v4_borrowck_provenance_mark_opaque(provenance_id)
}

task v4_borrowck_provenance_refill_memo(memo_id: int) -> void {
    if memo_id < 0 or memo_id >= v4_borrowck_provenance_memo_active or v4_borrowck_provenance_resource_exhausted_value {
        give back
    }
    pilot mir_id = word_to_int(array_get(v4_borrowck_provenance_memo_mir_ids, memo_id))
    pilot body_id = word_to_int(array_get(v4_borrowck_provenance_memo_body_ids, memo_id))
    pilot use_stmt = word_to_int(array_get(v4_borrowck_provenance_memo_use_stmts, memo_id))
    pilot rvalue_id = word_to_int(array_get(v4_borrowck_provenance_memo_rvalues, memo_id))
    pilot projection: word = array_get(v4_borrowck_provenance_memo_projections, memo_id)
    pilot provenance_id = v4_borrowck_provenance_memo_provenance(memo_id)
    pilot previous_memo = v4_borrowck_provenance_current_memo
    v4_borrowck_provenance_current_memo = memo_id
    v4_borrowck_fill_return_lend_provenance(mir_id, body_id, use_stmt, rvalue_id, projection, provenance_id)
    v4_borrowck_provenance_current_memo = previous_memo
    v4_borrowck_provenance_memo_mark_ready(memo_id)
}

-- Discover dependencies iteratively so long acyclic holder chains cannot use
-- the native call stack as an accidental worklist.
task v4_borrowck_provenance_discover_memos() -> bool {
    pilot memo_id = v4_borrowck_provenance_solved_memo_active
    repeat until memo_id >= v4_borrowck_provenance_memo_active or v4_borrowck_provenance_resource_exhausted_value {
        v4_borrowck_provenance_refill_memo(memo_id)
        memo_id += 1
    }
    give back not v4_borrowck_provenance_resource_exhausted_value
}

task v4_borrowck_provenance_effective_round_limit(default_limit: int) -> int {
    pilot limit = default_limit
    if v4_borrowck_provenance_round_limit_test_override > 0 and v4_borrowck_provenance_round_limit_test_override < limit {
        limit = v4_borrowck_provenance_round_limit_test_override
    }
    give back limit
}

task v4_borrowck_provenance_run_fixed_point_phase(round_limit: int) -> bool {
    pilot limit = round_limit
    if limit < 1 { limit = 1 }
    v4_borrowck_provenance_fixed_point_limit_value += limit

    v4_borrowck_provenance_worklist_reset()
    pilot memo_id = v4_borrowck_provenance_solved_memo_active
    repeat until memo_id >= v4_borrowck_provenance_memo_active or v4_borrowck_provenance_resource_exhausted_value {
        v4_borrowck_provenance_worklist_enqueue(memo_id)
        memo_id += 1
    }

    pilot rounds = 0
    repeat until v4_borrowck_provenance_worklist_cursor >= v4_borrowck_provenance_worklist_active or rounds >= limit or v4_borrowck_provenance_resource_exhausted_value {
        pilot wave_end = v4_borrowck_provenance_worklist_active
        repeat until v4_borrowck_provenance_worklist_cursor >= wave_end or v4_borrowck_provenance_resource_exhausted_value {
            memo_id = word_to_int(array_get(v4_borrowck_provenance_worklist_memos, v4_borrowck_provenance_worklist_cursor))
            v4_borrowck_provenance_worklist_cursor += 1
            array_set(v4_borrowck_provenance_worklist_queued, memo_id, "false")
            if v4_borrowck_provenance_fixed_point_work_items_value >= v4_borrowck_provenance_work_item_limit_value {
                v4_borrowck_provenance_trip_resource_limit()
            } else {
                pilot revision_before = v4_borrowck_provenance_revision_value
                v4_borrowck_provenance_refill_memo(memo_id)
                v4_borrowck_provenance_fixed_point_work_items_value += 1
                if revision_before != v4_borrowck_provenance_revision_value {
                    v4_borrowck_provenance_worklist_enqueue_dependents(memo_id)
                }
            }
        }
        rounds += 1
    }
    v4_borrowck_provenance_fixed_point_rounds_value += rounds
    give back v4_borrowck_provenance_worklist_cursor >= v4_borrowck_provenance_worklist_active and not v4_borrowck_provenance_resource_exhausted_value
}

task v4_borrowck_provenance_finalize_empty_memos() -> void {
    pilot memo_id = v4_borrowck_provenance_solved_memo_active
    repeat until memo_id >= v4_borrowck_provenance_memo_active {
        pilot provenance_id = v4_borrowck_provenance_memo_provenance(memo_id)
        if v4_borrowck_provenance_count(provenance_id) == 0 and v4_borrowck_provenance_state(provenance_id) == v4_borrowck_provenance_known {
            v4_borrowck_provenance_mark_opaque(provenance_id)
        }
        memo_id += 1
    }
}

task v4_borrowck_provenance_mark_all_opaque() -> void {
    pilot provenance_id = 0
    repeat until provenance_id >= v4_borrowck_provenance_state_active {
        v4_borrowck_provenance_mark_opaque(provenance_id)
        provenance_id += 1
    }
    v4_borrowck_provenance_fixed_point_converged_value = false
}

task v4_borrowck_provenance_trip_resource_limit() -> void {
    v4_borrowck_provenance_resource_exhausted_value = true
    v4_borrowck_provenance_mark_all_opaque()
}

task v4_borrowck_provenance_overflow() -> int {
    if v4_borrowck_provenance_exists(v4_borrowck_provenance_overflow_id) {
        give back v4_borrowck_provenance_overflow_id
    }
    v4_borrowck_provenance_overflow_id = v4_borrowck_provenance_new(v4_borrowck_provenance_opaque)
    give back v4_borrowck_provenance_overflow_id
}

task v4_borrowck_provenance_solve_fixed_point() -> void {
    if v4_borrowck_provenance_solver_active or not v4_borrowck_provenance_solver_dirty {
        give back
    }

    v4_borrowck_provenance_solver_active = true
    v4_borrowck_provenance_fixed_point_solves_value += 1
    pilot converged = v4_borrowck_provenance_discover_memos()
    pilot solve_memo_count = v4_borrowck_provenance_memo_active - v4_borrowck_provenance_solved_memo_active
    if converged {
        pilot source_limit = v4_borrowck_provenance_effective_round_limit(solve_memo_count + 1)
        converged = v4_borrowck_provenance_run_fixed_point_phase(source_limit)
    }
    if converged {
        v4_borrowck_provenance_finalize_empty_memos()
        pilot opacity_limit = v4_borrowck_provenance_effective_round_limit(solve_memo_count + 1)
        converged = v4_borrowck_provenance_run_fixed_point_phase(opacity_limit)
    }
    if not converged {
        v4_borrowck_provenance_mark_all_opaque()
    }
    v4_borrowck_provenance_solved_memo_active = v4_borrowck_provenance_memo_active
    v4_borrowck_provenance_solver_dirty = false
    v4_borrowck_provenance_solver_active = false
}

task v4_borrowck_return_lend_provenance_projected(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word) -> int {
    v4_borrowck_init()
    projection = v4_borrowck_path_canon(projection)
    pilot dependent_memo = v4_borrowck_provenance_current_memo
    pilot memo_id = v4_borrowck_provenance_memo_lookup(mir_id, body_id, use_stmt, rvalue_id, projection)
    if memo_id >= 0 {
        v4_borrowck_provenance_memo_hits_value += 1
        v4_borrowck_provenance_dependency_add(memo_id, dependent_memo)
        give back v4_borrowck_provenance_memo_provenance(memo_id)
    }

    if v4_borrowck_provenance_memo_active >= v4_borrowck_provenance_memo_limit_value {
        v4_borrowck_provenance_trip_resource_limit()
        give back v4_borrowck_provenance_overflow()
    }
    pilot provenance_id = v4_borrowck_provenance_new(v4_borrowck_provenance_known)
    memo_id = v4_borrowck_provenance_memo_add(mir_id, body_id, use_stmt, rvalue_id, projection, provenance_id)
    if memo_id < 0 {
        give back v4_borrowck_provenance_overflow()
    }
    v4_borrowck_provenance_dependency_add(memo_id, dependent_memo)
    if not v4_borrowck_provenance_solver_active {
        v4_borrowck_provenance_solve_fixed_point()
    }
    give back provenance_id
}

task v4_borrowck_return_lend_provenance(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int) -> int {
    give back v4_borrowck_return_lend_provenance_projected(mir_id, body_id, use_stmt, rvalue_id, "")
}

task v4_borrowck_return_call_lend_provenance(mir_id: int, body_id: int, use_stmt: int, call_rvalue: int) -> int {
    give back v4_borrowck_return_lend_provenance(mir_id, body_id, use_stmt, call_rvalue)
}

-- Compatibility query: -1 means opaque/unproven; -2 means more than one source.
task v4_borrowck_return_lend_origin(mir_id: int, body_id: int, return_stmt: int, rvalue_id: int) -> int {
    pilot provenance_id = v4_borrowck_return_lend_provenance(mir_id, body_id, return_stmt, rvalue_id)
    if not v4_borrowck_provenance_is_known(provenance_id) or v4_borrowck_provenance_count(provenance_id) <= 0 {
        give back 0 - 1
    }
    if v4_borrowck_provenance_count(provenance_id) > 1 {
        give back 0 - 2
    }
    give back v4_borrowck_provenance_origin_at(provenance_id, 0)
}

task v4_borrowck_return_unproven_help(body_name: word) -> word {
    pilot out = body_name + " returns a lend whose complete source set cannot be tied to borrowed inputs"
    out = out + "; use explicit lends or an ordinary static call whose borrowed return sources are fully known"
    give back out
}

task v4_borrowck_return_owned_help(body_name: word, source_text: word) -> word {
    pilot out = v4_borrowck_path_canon(source_text) + " is owned by " + body_name
    out = out + "; returning a lend would let it survive the owner's drop"
    give back out
}

task v4_borrowck_return_mut_upgrade_help(source_text: word) -> word {
    pilot out = v4_borrowck_path_canon(source_text) + " arrived through lend"
    out = out + "; only a lend mut input can be returned as lend mut"
    give back out
}

task v4_borrowck_return_source_param(mir_id: int, body_id: int, source_text: word) -> int {
    pilot source_name = v4_borrowck_path_root(source_text)
    if source_name == "" {
        give back 0 - 1
    }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 {
        give back 0 - 1
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_signature_param_index_for_name(ty_id, sig_id, source_name)
}

task v4_borrowck_return_source_contract_count_guarded(mir_id: int, body_id: int, source_text: word, route_guard: word) -> int {
    pilot param_id = v4_borrowck_return_source_param(mir_id, body_id, source_text)
    if param_id < 0 { give back 0 }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut { give back 1 }

    pilot source_root = v4_borrowck_path_root(source_text)
    pilot suffix = ""
    if source_text.length() > source_root.length() {
        suffix = v4_slice(v4_borrowck_path_canon(source_text), source_root.length(), v4_borrowck_path_canon(source_text).length())
    }
    pilot param_type = v4_ty_signature_param_type(ty_id, sig_id, param_id)
    pilot leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, param_type)
    if leaf_count < 0 { give back 0 - 1 }
    pilot count = 0
    pilot leaf_id = 0
    repeat until leaf_id >= leaf_count {
        pilot leaf_projection = v4_ty_fixed_lend_leaf_projection_at(ty_id, param_type, leaf_id)
        pilot leaf_guard = v4_ty_fixed_lend_leaf_route_guard_at(ty_id, param_type, leaf_id)
        if v4_borrowck_projection_match_tail(leaf_projection, suffix) != "#no-match" {
            if route_guard == "" or leaf_guard == route_guard { count += 1 }
        }
        leaf_id += 1
    }
    give back count
}

task v4_borrowck_return_source_contract_count(mir_id: int, body_id: int, source_text: word) -> int {
    give back v4_borrowck_return_source_contract_count_guarded(mir_id, body_id, source_text, "")
}
task v4_borrowck_return_source_contract_at_guarded(mir_id: int, body_id: int, source_text: word, route_guard: word, contract_id: int) -> word {
    if contract_id < 0 { give back v4_ty_unknown }
    pilot param_id = v4_borrowck_return_source_param(mir_id, body_id, source_text)
    if param_id < 0 { give back v4_ty_unknown }
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot param_type = v4_ty_signature_param_type(ty_id, sig_id, param_id)
    pilot param_mode = v4_ty_signature_param_mode(ty_id, sig_id, param_id)
    if param_mode == v4_ty_param_mode_lend or param_mode == v4_ty_param_mode_lend_mut {
        if contract_id == 0 { give back v4_ty_lend_type_with_lifetime(param_type, param_mode, v4_ty_signature_param_lifetime(ty_id, sig_id, param_id)) }
        give back v4_ty_unknown
    }

    pilot source_root = v4_borrowck_path_root(source_text)
    pilot source_canon = v4_borrowck_path_canon(source_text)
    pilot suffix = ""
    if source_canon.length() > source_root.length() {
        suffix = v4_slice(source_canon, source_root.length(), source_canon.length())
    }
    pilot seen = 0
    pilot leaf_id = 0
    pilot leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, param_type)
    repeat until leaf_id >= leaf_count {
        pilot leaf_projection = v4_ty_fixed_lend_leaf_projection_at(ty_id, param_type, leaf_id)
        pilot leaf_guard = v4_ty_fixed_lend_leaf_route_guard_at(ty_id, param_type, leaf_id)
        if v4_borrowck_projection_match_tail(leaf_projection, suffix) != "#no-match" {
            if route_guard == "" or leaf_guard == route_guard {
                if seen == contract_id { give back v4_ty_fixed_lend_leaf_type_at(ty_id, param_type, leaf_id) }
                seen += 1
            }
        }
        leaf_id += 1
    }
    give back v4_ty_unknown
}

task v4_borrowck_return_source_contract_at(mir_id: int, body_id: int, source_text: word, contract_id: int) -> word {
    give back v4_borrowck_return_source_contract_at_guarded(mir_id, body_id, source_text, "", contract_id)
}
task v4_borrowck_return_source_lifetime(mir_id: int, body_id: int, source_text: word) -> word {
    pilot source_contract = v4_borrowck_return_source_contract_at(mir_id, body_id, source_text, 0)
    if not v4_ty_is_lend_type(source_contract) { give back "" }
    give back v4_ty_lend_lifetime(source_contract)
}

task v4_borrowck_return_lifetime_mismatch_help(body_name: word, source_text: word, source_lifetime: word, return_lifetime: word) -> word {
    pilot source_display = source_lifetime
    if source_display == "" {
        source_display = "an elided lifetime"
    }
    give back body_name + " promises " + return_lifetime + " but " + v4_borrowck_path_canon(source_text) + " belongs to " + source_display + "; that source lifetime must outlive " + return_lifetime
}

task v4_borrowck_rvalue_matches_route_guard_projected_seen(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word, guard: word, depth: int) -> bool {
    if guard == "" or rvalue_id < 0 { give back true }
    if depth > v4_ty_lend_storage_depth_limit { give back true }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)

    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        if use_stmt < 0 { give back true }
        pilot holder_path = v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        pilot holder_root = v4_borrowck_path_root(holder_path)
        if holder_root == "" { give back true }
        pilot queried_holder = holder_path + v4_borrowck_path_canon(projection)
        pilot use_block = v4_mir_stmt_block(mir_id, body_id, use_stmt)
        pilot found_reaching_binding = false
        pilot stmt_id = 0
        pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
        repeat until stmt_id >= stmt_count {
            if stmt_id != use_stmt and v4_borrowck_stmt_may_bind_holder(mir_id, body_id, stmt_id, queried_holder) {
                pilot origin_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
                if v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, queried_holder, stmt_id, stmt_id, origin_block, use_stmt, use_block) {
                    found_reaching_binding = true
                    pilot origin_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
                    if origin_id < 0 { give back true }
                    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
                    if place_id < 0 { give back true }
                    pilot place_canon = v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id))
                    pilot origin_projection = ""
                    if place_canon == holder_path {
                        origin_projection = projection
                    } else if place_canon == queried_holder {
                        origin_projection = ""
                    } else if v4_borrowck_path_prefix_conflicts(place_canon, queried_holder) {
                        origin_projection = v4_slice(queried_holder, place_canon.length(), queried_holder.length())
                    } else if not v4_borrowck_paths_overlap(place_canon, queried_holder) {
                        give back true
                    }
                    if v4_borrowck_rvalue_matches_route_guard_projected_seen(mir_id, body_id, stmt_id, origin_id, origin_projection, guard, depth + 1) {
                        give back true
                    }
                }
            }
            stmt_id += 1
        }
        if found_reaching_binding { give back false }
        give back true
    }

    if kind == v4_mir_rvalue_use_symbol {
        pilot symbol_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        if v4_ty_is_route_type(v4_mir_ty_id(mir_id), symbol_ty) {
            pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
            pilot next_case = v4_mir_path_right(case_name)
            repeat until next_case == "" {
                case_name = next_case
                next_case = v4_mir_path_right(case_name)
            }
            pilot guard_head = guard
            pilot slash = 0
            repeat until slash >= guard_head.length() or guard_head.char_at(slash) == "/" {
                slash += 1
            }
            if slash < guard_head.length() { guard_head = v4_slice(guard_head, 0, slash) }
            pilot guard_case = guard_head
            pilot next_guard_case = v4_mir_path_right(guard_case)
            if next_guard_case == "" { give back true }
            repeat until next_guard_case == "" {
                guard_case = next_guard_case
                next_guard_case = v4_mir_path_right(guard_case)
            }
            give back guard_case == case_name
        }
    }

    if not v4_mir_rvalue_is_aggregate_kind(kind) { give back true }
    pilot remaining_guard = guard
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot aggregate_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if v4_ty_is_route_type(ty_id, aggregate_ty) {
        if kind != v4_mir_rvalue_construct { give back true }
        pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
        pilot next_case = v4_mir_path_right(case_name)
        repeat until next_case == "" {
            case_name = next_case
            next_case = v4_mir_path_right(case_name)
        }

        pilot guard_head = remaining_guard
        pilot guard_tail = ""
        pilot slash = 0
        repeat until slash >= guard_head.length() or guard_head.char_at(slash) == "/" {
            slash += 1
        }
        if slash < guard_head.length() {
            guard_tail = v4_slice(guard_head, slash + 1, guard_head.length())
            guard_head = v4_slice(guard_head, 0, slash)
        }
        pilot guard_case = guard_head
        pilot next_guard_case = v4_mir_path_right(guard_case)
        if next_guard_case == "" {
            -- Malformed internal guard metadata must not suppress a loan check.
            give back true
        }
        repeat until next_guard_case == "" {
            guard_case = next_guard_case
            next_guard_case = v4_mir_path_right(guard_case)
        }
        if guard_case != case_name { give back false }
        if guard_tail == "" { give back true }
        remaining_guard = guard_tail
    }

    pilot segment = v4_borrowck_projection_first(projection)
    if segment == "" { give back true }
    pilot tail = v4_borrowck_projection_tail(projection)
    pilot child_id = v4_borrowck_aggregate_child_for_segment(mir_id, body_id, rvalue_id, segment)
    if child_id == 0 - 2 {
        pilot candidate_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until candidate_id >= child_count {
            pilot candidate = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, candidate_id)
            if candidate < 0 or v4_borrowck_rvalue_matches_route_guard_projected_seen(mir_id, body_id, use_stmt, candidate, tail, remaining_guard, depth + 1) {
                give back true
            }
            candidate_id += 1
        }
        give back false
    }
    if child_id < 0 { give back true }
    pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
    if child_rvalue < 0 { give back true }
    give back v4_borrowck_rvalue_matches_route_guard_projected_seen(mir_id, body_id, use_stmt, child_rvalue, tail, remaining_guard, depth + 1)
}

task v4_borrowck_rvalue_matches_route_guard_projected_at(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, projection: word, guard: word) -> bool {
    give back v4_borrowck_rvalue_matches_route_guard_projected_seen(mir_id, body_id, use_stmt, rvalue_id, projection, guard, 0)
}

task v4_borrowck_rvalue_matches_route_guard_projected(mir_id: int, body_id: int, rvalue_id: int, projection: word, guard: word) -> bool {
    give back v4_borrowck_rvalue_matches_route_guard_projected_seen(mir_id, body_id, 0 - 1, rvalue_id, projection, guard, 0)
}
task v4_borrowck_return_rvalue_matches_route_guard(mir_id: int, body_id: int, rvalue_id: int, guard: word) -> bool {
    give back v4_borrowck_rvalue_matches_route_guard_projected(mir_id, body_id, rvalue_id, "", guard)
}
task v4_borrowck_check_returned_lends(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot expected_ty = v4_mir_expected_return_type(mir_id, body_id)
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot outer_lend = v4_ty_is_lend_type(expected_ty)
    pilot leaf_count = 0
    if outer_lend {
        leaf_count = 1
    } else if v4_ty_type_supports_fixed_lend_storage(ty_id, expected_ty) {
        leaf_count = v4_ty_fixed_lend_leaf_count(ty_id, expected_ty)
    }
    if leaf_count <= 0 { give back 0 }

    pilot conflicts = 0
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_return {
            pilot return_rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
            if return_rvalue >= 0 and v4_ty_type_may_store_lend(ty_id, v4_mir_rvalue_ty(mir_id, body_id, return_rvalue)) {
                pilot leaf_id = 0
                repeat until leaf_id >= leaf_count {
                    pilot expected_leaf_type = expected_ty
                    pilot return_projection = ""
                    pilot return_guard = ""
                    if not outer_lend {
                        expected_leaf_type = v4_ty_fixed_lend_leaf_type_at(ty_id, expected_ty, leaf_id)
                        return_projection = v4_ty_fixed_lend_leaf_projection_at(ty_id, expected_ty, leaf_id)
                        return_guard = v4_ty_fixed_lend_leaf_route_guard_at(ty_id, expected_ty, leaf_id)
                    }
                    if v4_borrowck_rvalue_matches_route_guard_projected_at(mir_id, body_id, stmt_id, return_rvalue, return_projection, return_guard) {
                        pilot message = ""
                        pilot help = ""
                        pilot provenance_id = v4_borrowck_return_lend_provenance_projected(mir_id, body_id, stmt_id, return_rvalue, return_projection)
                        pilot source_count = v4_borrowck_provenance_count(provenance_id)
                        if not v4_borrowck_provenance_is_known(provenance_id) or source_count <= 0 {
                            message = "Meiya cannot establish the origin of this returned loan"
                            if return_projection != "" { message = "Meiya cannot establish the origin of this returned aggregate loan at " + return_projection }
                            help = v4_borrowck_return_unproven_help(body_name)
                        } else {
                            pilot return_lifetime = v4_ty_lend_lifetime(expected_leaf_type)
                            pilot source_id = 0
                            repeat until source_id >= source_count or message != "" {
                                pilot source_text = v4_borrowck_provenance_path_at(provenance_id, source_id)
                                pilot source_guard = v4_borrowck_provenance_route_guard_at(provenance_id, source_id)
                                pilot contract_count = v4_borrowck_return_source_contract_count_guarded(mir_id, body_id, source_text, source_guard)
                                if contract_count <= 0 {
                                    message = "Meiya refuses to return a loan of an owned value"
                                    if return_projection != "" { message = "Meiya refuses to return an aggregate loan of an owned value" }
                                    help = v4_borrowck_return_owned_help(body_name, source_text)
                                } else {
                                    pilot contract_id = 0
                                    repeat until contract_id >= contract_count or message != "" {
                                        pilot source_contract = v4_borrowck_return_source_contract_at_guarded(mir_id, body_id, source_text, source_guard, contract_id)
                                        pilot source_lifetime = v4_ty_lend_lifetime(source_contract)
                                        if return_lifetime != "" and return_lifetime != "'_" and not v4_ty_signature_lifetime_outlives(ty_id, sig_id, source_lifetime, return_lifetime) {
                                            message = "Meiya refuses a returned loan from the wrong lifetime"
                                            if return_projection != "" { message = "Meiya refuses a returned aggregate loan from the wrong lifetime" }
                                            help = v4_borrowck_return_lifetime_mismatch_help(body_name, source_text, source_lifetime, return_lifetime)
                                        } else if v4_ty_is_lend_mut_type(expected_leaf_type) and not v4_ty_is_lend_mut_type(source_contract) {
                                            message = "Meiya refuses a mutable reloan from an immutable lend"
                                            if return_projection != "" { message = "Meiya refuses a mutable aggregate reloan from an immutable lend" }
                                            help = v4_borrowck_return_mut_upgrade_help(source_text)
                                        }
                                        contract_id += 1
                                    }
                                }
                                source_id += 1
                            }
                            if message == "" {
                                pilot path_kind = v4_borrowck_path_return_loan
                                if v4_ty_is_lend_mut_type(expected_leaf_type) { path_kind = v4_borrowck_path_return_loan_mut }
                                source_id = 0
                                repeat until source_id >= source_count {
                                    v4_borrowck_add_path(borrow_id, result_id, path_kind, v4_borrowck_provenance_path_at(provenance_id, source_id), stmt_id, v4_mir_stmt_block(mir_id, body_id, stmt_id))
                                    source_id += 1
                                }
                            }
                        }
                        if message != "" {
                            pilot span = v4_borrowck_use_diag_span(mir_id, body_id, stmt_id)
                            v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, span, message, help))
                            v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                            conflicts += 1
                        }
                    }
                    leaf_id += 1
                }
            }
        }
        stmt_id += 1
    }
    give back conflicts
}

task v4_borrowck_shared_guard_escape_help(body_name: word, return_ty: word) -> word {
    pilot out = body_name + " tries to return " + return_ty
    out = out + "; SharedMut<T> is a runtime mutable-borrow guard and must drop before the shared allocation leaves this scope"
    give back out
}

task v4_borrowck_rvalue_returns_shared_mut_guard(mir_id: int, body_id: int, rvalue_id: int) -> bool {
    if rvalue_id < 0 {
        give back false
    }

    pilot return_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    if v4_ty_is_shared_mut_type(return_ty) {
        give back true
    }

    pilot return_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if return_kind == v4_mir_rvalue_some or return_kind == v4_mir_rvalue_ok {
        give back v4_borrowck_rvalue_returns_shared_mut_guard(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    if return_kind == v4_mir_rvalue_err {
        give back false
    }
    if v4_mir_rvalue_is_aggregate_kind(return_kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_borrowck_rvalue_returns_shared_mut_guard(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)) {
                give back true
            }
            child_id += 1
        }
    }

    give back false
}

task v4_borrowck_check_shared_guard_escapes(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_kind(mir_id, body_id, stmt_id) == v4_mir_stmt_return {
            pilot return_rvalue = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
            if return_rvalue >= 0 {
                pilot return_ty = v4_mir_rvalue_ty(mir_id, body_id, return_rvalue)
                if v4_borrowck_rvalue_returns_shared_mut_guard(mir_id, body_id, return_rvalue) {
                    pilot span = v4_borrowck_use_diag_span(mir_id, body_id, stmt_id)
                    pilot message = "Meiya refuses to let a SharedMut guard escape"
                    pilot help = v4_borrowck_shared_guard_escape_help(body_name, return_ty)
                    v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, span, message, help))
                    v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                    conflicts += 1
                }
            }
        }
        stmt_id += 1
    }
    give back conflicts
}

task v4_borrowck_stored_call_loan_help(body_name: word) -> word {
    pilot out = body_name + " stores a lend returned by a call"
    out = out + "; storage requires a static signature that maps every possible returned-loan source"
    give back out
}

task v4_borrowck_call_is_shared_borrow_with_receiver(mir_id: int, body_id: int, call_rvalue: int) -> bool {
    give back v4_mir_rvalue_is_builtin_shared_method(mir_id, body_id, call_rvalue, v4_mir_builtin_shared_borrow)
}

task v4_borrowck_call_returns_hidden_lend(mir_id: int, body_id: int, call_rvalue: int) -> bool {
    if call_rvalue < 0 or v4_mir_rvalue_kind(mir_id, body_id, call_rvalue) != v4_mir_rvalue_call {
        give back false
    }
    pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, call_rvalue)
    give back not v4_ty_is_lend_type(result_ty) and v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), result_ty)
}

-- Hidden-loan calls conservatively retain their direct mutable loan arguments.
task v4_borrowck_call_has_direct_mut_lend_arg(mir_id: int, body_id: int, call_rvalue: int) -> bool {
    if call_rvalue < 0 or v4_mir_rvalue_kind(mir_id, body_id, call_rvalue) != v4_mir_rvalue_call {
        give back false
    }
    pilot arg_id = 0
    pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, call_rvalue)
    repeat until arg_id >= arg_count {
        pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue, arg_id)
        if arg_rvalue >= 0 and v4_mir_rvalue_kind(mir_id, body_id, arg_rvalue) == v4_mir_rvalue_lend_mut {
            give back true
        }
        arg_id += 1
    }
    give back false
}

task v4_borrowck_call_direct_mut_lends_source(mir_id: int, body_id: int, call_rvalue: int, loan_text: word) -> bool {
    if not v4_borrowck_call_returns_hidden_lend(mir_id, body_id, call_rvalue) {
        give back false
    }
    pilot arg_id = 0
    pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, call_rvalue)
    repeat until arg_id >= arg_count {
        pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue, arg_id)
        if arg_rvalue >= 0 and v4_mir_rvalue_kind(mir_id, body_id, arg_rvalue) == v4_mir_rvalue_lend_mut {
            if v4_borrowck_rvalue_lends_source(mir_id, body_id, 0 - 1, arg_rvalue, loan_text) {
                give back true
            }
        }
        arg_id += 1
    }
    give back false
}

task v4_borrowck_call_has_known_lend_provenance(mir_id: int, body_id: int, call_stmt: int, call_rvalue: int) -> bool {
    if call_rvalue < 0 or v4_mir_rvalue_kind(mir_id, body_id, call_rvalue) != v4_mir_rvalue_call {
        give back false
    }
    if v4_borrowck_call_returns_hidden_lend(mir_id, body_id, call_rvalue) and v4_borrowck_call_has_direct_mut_lend_arg(mir_id, body_id, call_rvalue) {
        give back true
    }
    pilot provenance_id = v4_borrowck_return_lend_provenance(mir_id, body_id, call_stmt, call_rvalue)
    if v4_borrowck_provenance_is_known(provenance_id) {
        give back true
    }
    give back v4_borrowck_call_is_shared_borrow_with_receiver(mir_id, body_id, call_rvalue)
}

task v4_borrowck_check_stored_call_lends(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
        if stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign {
            pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
            if rvalue_id >= 0 and v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_call {
                if v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
                    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
                    pilot has_local_holder = v4_borrowck_place_is_local_storage_projection(mir_id, body_id, place_id)
                    if not has_local_holder or not v4_borrowck_call_has_known_lend_provenance(mir_id, body_id, stmt_id, rvalue_id) {
                        pilot span = v4_borrowck_use_diag_span(mir_id, body_id, stmt_id)
                        pilot message = "Meiya cannot store this borrowed call result yet"
                        pilot help = v4_borrowck_stored_call_loan_help(body_name)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, span, message, help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                    }
                }
            }
        }
        stmt_id += 1
    }
    give back conflicts
}

task v4_borrowck_rvalue_is_dynamic_lend_storage_kind(kind: word) -> bool {
    give back kind == v4_mir_rvalue_list or kind == v4_mir_rvalue_map or kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err
}

task v4_borrowck_type_is_dynamic_lend_storage(type_text: word) -> bool {
    if not v4_ty_is_generic_instance_type(type_text) { give back false }
    pilot base_name = v4_ty_generic_base_name(type_text)
    give back base_name == "List" or base_name == "Map" or base_name == "Set" or base_name == "Lineup" or base_name == "maybe" or base_name == "result"
}

-- MIR emits the construction diagnostic while Meiya blocks the owning body.
task v4_borrowck_check_dynamic_lend_storage(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot conflicts = 0
    pilot rvalue_id = 0
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
    repeat until rvalue_id >= rvalue_count {
        pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
        pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        pilot dynamic_value: bool = v4_borrowck_rvalue_is_dynamic_lend_storage_kind(kind)
        pilot dynamic_call: bool = kind == v4_mir_rvalue_call and result_ty.contains("closure[") and v4_borrowck_type_is_dynamic_lend_storage(result_ty)
        if dynamic_value or dynamic_call {
            pilot stores_lend = v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), result_ty)
            pilot hidden_closure_lend = false
            if not stores_lend {
                if dynamic_call {
                    pilot arg_id = 0
                    pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
                    repeat until arg_id >= arg_count or stores_lend {
                        pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
                        stores_lend = v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, arg_rvalue)
                        if stores_lend and not v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, arg_rvalue)) {
                            hidden_closure_lend = true
                        }
                        arg_id += 1
                    }
                } else if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err {
                    pilot child_rvalue = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
                    stores_lend = v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, child_rvalue)
                    if stores_lend and not v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, child_rvalue)) {
                        hidden_closure_lend = true
                    }
                } else if v4_mir_rvalue_is_aggregate_kind(kind) {
                    pilot child_id = 0
                    pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
                    repeat until child_id >= child_count or stores_lend {
                        pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
                        stores_lend = v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, child_rvalue)
                        if stores_lend and not v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, child_rvalue)) {
                            hidden_closure_lend = true
                        }
                        child_id += 1
                    }
                }
            }
            if stores_lend {
                if hidden_closure_lend {
                    pilot span = v4_mir_rvalue_span(mir_id, body_id, rvalue_id)
                    pilot help = body_name + " stores a closure whose environment still borrows a local value; keep the closure in a scalar local until dynamic closure provenance is implemented"
                    v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, span, "Meiya cannot store a loan-capturing closure inside dynamic storage yet", help))
                }
                v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                conflicts += 1
            }
        }
        rvalue_id += 1
    }
    give back conflicts
}

task v4_borrowck_rvalue_is_fixed_aggregate_storage_kind(kind: word) -> bool {
    give back kind == v4_mir_rvalue_construct or kind == v4_mir_rvalue_array or kind == v4_mir_rvalue_tuple
}

task v4_borrowck_check_fixed_hidden_closure_storage(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot body_name = v4_mir_body_name(mir_id, body_id)
    pilot conflicts = 0
    pilot rvalue_id = 0
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
    repeat until rvalue_id >= rvalue_count {
        pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
        pilot aggregate_value: bool = v4_borrowck_rvalue_is_fixed_aggregate_storage_kind(kind)
        pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        pilot aggregate_call: bool = kind == v4_mir_rvalue_call and result_ty.contains("closure[") and v4_borrowck_ty_is_fixed_aggregate(mir_id, result_ty) and v4_borrowck_type_retains_aggregate_children(mir_id, result_ty)
        if (aggregate_value and v4_borrowck_rvalue_retains_aggregate_children(mir_id, body_id, rvalue_id)) or aggregate_call {
            pilot hidden_closure_lend = false
            pilot child_id = 0
            pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
            if aggregate_call {
                child_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
            }
            repeat until child_id >= child_count or hidden_closure_lend {
                pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
                if aggregate_call {
                    child_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, child_id)
                }
                if v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, child_rvalue) {
                    if not v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, child_rvalue)) {
                        hidden_closure_lend = true
                    }
                }
                child_id += 1
            }
            if hidden_closure_lend {
                pilot span = v4_mir_rvalue_span(mir_id, body_id, rvalue_id)
                pilot help = body_name + " stores a closure whose hidden environment still borrows a local value; keep the closure in a scalar local until fixed aggregate closure provenance is implemented"
                v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, span, "Meiya cannot store a loan-capturing closure inside fixed aggregate storage yet", help))
                v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                conflicts += 1
            }
        }
        rvalue_id += 1
    }
    give back conflicts
}

-- MIR owns the diagnostic; Meiya owns whether the containing body is executable.
task v4_borrowck_check_repeated_mut_lend_aggregates(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot rvalue_id = 0
    pilot rvalue_count = v4_mir_body_rvalue_count(mir_id, body_id)
    repeat until rvalue_id >= rvalue_count {
        if v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_array {
            pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
            pilot slot_count = v4_mir_fixed_array_slot_count(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
            if child_count == 1 and slot_count > 1 {
                pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, 0)
                if v4_mir_rvalue_contains_mut_lend(mir_id, body_id, child_rvalue) {
                    v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                    conflicts += 1
                }
            }
        }
        rvalue_id += 1
    }
    give back conflicts
}

task v4_borrowck_mutable_conflict_help(loan_text: word, loan_stmt: int, block_id: int, write_text: word, write_stmt: int) -> word {
    pilot loan_canon = v4_borrowck_path_canon(loan_text)
    pilot write_canon = v4_borrowck_path_canon(write_text)
    pilot out = loan_canon + " stays on loan in block " + word_from_int(block_id)
    out = out + " from statement " + word_from_int(loan_stmt)
    out = out + ", so statement " + word_from_int(write_stmt)
    out = out + " cannot rewrite " + write_canon + " yet"
    give back out
}

task v4_borrowck_mutable_conflict_message(loan_block: int, write_block: int) -> word {
    if loan_block == write_block {
        give back "Meiya refuses this rewrite while the value is borrowed"
    }
    give back "Meiya tracks this loan into a later block"
}

task v4_borrowck_cross_block_conflict_help(loan_text: word, loan_stmt: int, loan_block: int, write_text: word, write_stmt: int, write_block: int) -> word {
    pilot loan_canon = v4_borrowck_path_canon(loan_text)
    pilot write_canon = v4_borrowck_path_canon(write_text)
    pilot out = loan_canon + " stays on loan from block " + word_from_int(loan_block)
    out = out + " into block " + word_from_int(write_block)
    out = out + " after statement " + word_from_int(loan_stmt)
    out = out + ", so statement " + word_from_int(write_stmt)
    out = out + " cannot rewrite " + write_canon + " yet"
    give back out
}

task v4_borrowck_seen_index(seen: int, index: int) -> bool {
    if index < 0 or index >= array_len(seen) {
        give back false
    }
    pilot state: word = array_get(seen, index)
    give back state == "true"
}

task v4_borrowck_mark_seen_index(seen: int, index: int) -> bool {
    if index < 0 {
        give back false
    }
    repeat until array_len(seen) > index {
        array_push(seen, "false")
    }
    if v4_borrowck_seen_index(seen, index) {
        give back false
    }
    array_set(seen, index, "true")
    give back true
}

task v4_borrowck_block_reaches(mir_id: int, body_id: int, start_block: int, wanted_block: int) -> bool {
    if start_block < 0 or wanted_block < 0 {
        give back false
    }
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    if start_block >= block_count or wanted_block >= block_count {
        give back false
    }

    pilot seen = array_new()
    pilot queue = array_new()
    array_push(queue, word_from_int(start_block))
    pilot cursor = 0
    pilot reaches = false
    repeat until cursor >= array_len(queue) or reaches {
        pilot block_id = word_to_int(array_get(queue, cursor))
        cursor += 1
        if block_id == wanted_block {
            reaches = true
        } else if block_id >= 0 and block_id < block_count and v4_borrowck_mark_seen_index(seen, block_id) {
            pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
            pilot terminator = v4_mir_block_terminator(block_record)
            if terminator == v4_mir_term_goto {
                array_push(queue, word_from_int(v4_mir_block_target(block_record)))
            }
            if terminator == v4_mir_term_if {
                array_push(queue, word_from_int(v4_mir_block_target(block_record)))
                array_push(queue, word_from_int(v4_mir_block_else_target(block_record)))
            }
        }
    }
    array_release(queue)
    array_release(seen)
    give back reaches
}

task v4_borrowck_loan_spans_successors(mir_id: int, body_id: int, loan_stmt: int) -> bool {
    if loan_stmt < 0 {
        give back false
    }
    give back v4_mir_stmt_kind(mir_id, body_id, loan_stmt) == v4_mir_stmt_expr
}

task v4_borrowck_path_is_move_use_kind(path_kind: word) -> bool {
    give back v4_borrowck_path_is_loan_kind(path_kind) or path_kind == v4_borrowck_path_copy or path_kind == v4_borrowck_path_move
}

task v4_borrowck_write_repairs_move(move_text: word, write_text: word) -> bool {
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot write_canon = v4_borrowck_path_canon(write_text)
    if move_canon == "" or write_canon == "" {
        give back false
    }
    if move_canon == write_canon {
        give back true
    }
    give back v4_borrowck_path_prefix_conflicts(write_canon, move_canon)
}

task v4_borrowck_stmt_repairs_move(borrow_id: int, result_id: int, move_text: word, stmt_id: int, block_id: int) -> bool {
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot path_idx = 0
    repeat until path_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, path_idx) == v4_borrowck_path_write {
            if v4_borrowck_path_stmt(borrow_id, result_id, path_idx) == stmt_id and v4_borrowck_path_block(borrow_id, result_id, path_idx) == block_id {
                if v4_borrowck_write_repairs_move(move_text, v4_borrowck_path_text(borrow_id, result_id, path_idx)) {
                    give back true
                }
            }
        }
        path_idx += 1
    }
    give back false
}

task v4_borrowck_repair_state_key(block_id: int, start_stmt: int, repaired: bool) -> word {
    pilot state = "open"
    if repaired {
        state = "repaired"
    }
    give back word_from_int(block_id) + "@" + word_from_int(start_stmt) + "#" + state
}

task v4_borrowck_partial_move_conflict_help(move_text: word, move_stmt: int, use_text: word, use_stmt: int) -> word {
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot use_canon = v4_borrowck_path_canon(use_text)
    pilot out = move_canon + " was moved at statement " + word_from_int(move_stmt)
    out = out + ", so statement " + word_from_int(use_stmt)
    out = out + " cannot use " + use_canon + " yet"
    give back out
}

task v4_borrowck_partial_move_conflict_message(move_block: int, use_block: int) -> word {
    if move_block == use_block {
        give back "Meiya remembers the field you already moved"
    }
    give back "Meiya carries that partial move across the CFG"
}

task v4_borrowck_cross_block_partial_move_help(move_text: word, move_stmt: int, move_block: int, use_text: word, use_stmt: int, use_block: int) -> word {
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot use_canon = v4_borrowck_path_canon(use_text)
    pilot out = move_canon + " was moved in block " + word_from_int(move_block)
    out = out + " at statement " + word_from_int(move_stmt)
    out = out + ", so block " + word_from_int(use_block)
    out = out + " statement " + word_from_int(use_stmt)
    out = out + " cannot use " + use_canon + " yet"
    give back out
}

task v4_borrowck_move_repaired_on_all_paths_seen(borrow_id: int, result_id: int, mir_id: int, body_id: int, block_id: int, start_stmt: int, move_text: word, use_stmt: int, use_block: int, repaired: bool, seen: word) -> bool {
    if block_id < 0 or use_block < 0 {
        give back false
    }
    if block_id >= v4_mir_body_block_count(mir_id, body_id) {
        give back false
    }

    pilot key = v4_borrowck_repair_state_key(block_id, start_stmt, repaired)
    if v4_mir_name_list_contains(seen, key) {
        give back repaired
    }
    seen = v4_mir_name_list_add(seen, key)

    pilot current_repaired = repaired
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id and stmt_id > start_stmt {
            if block_id == use_block and stmt_id == use_stmt {
                give back current_repaired
            }
            if v4_borrowck_stmt_repairs_move(borrow_id, result_id, move_text, stmt_id, block_id) {
                current_repaired = true
            }
        }
        stmt_id += 1
    }

    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    pilot terminator = v4_mir_block_terminator(block_record)
    if terminator == v4_mir_term_goto {
        give back v4_borrowck_move_repaired_on_all_paths_seen(borrow_id, result_id, mir_id, body_id, v4_mir_block_target(block_record), 0 - 1, move_text, use_stmt, use_block, current_repaired, seen)
    }
    if terminator == v4_mir_term_if {
        pilot target_repaired = v4_borrowck_move_repaired_on_all_paths_seen(borrow_id, result_id, mir_id, body_id, v4_mir_block_target(block_record), 0 - 1, move_text, use_stmt, use_block, current_repaired, seen)
        pilot else_repaired = v4_borrowck_move_repaired_on_all_paths_seen(borrow_id, result_id, mir_id, body_id, v4_mir_block_else_target(block_record), 0 - 1, move_text, use_stmt, use_block, current_repaired, seen)
        give back target_repaired and else_repaired
    }
    give back true
}

task v4_borrowck_move_repaired_before_use(borrow_id: int, result_id: int, mir_id: int, body_id: int, move_stmt: int, move_block: int, move_text: word, use_stmt: int, use_block: int) -> bool {
    if move_stmt < 0 or use_stmt < 0 {
        give back false
    }
    give back v4_borrowck_move_repaired_on_all_paths_seen(borrow_id, result_id, mir_id, body_id, move_block, move_stmt, move_text, use_stmt, use_block, false, "")
}

task v4_borrowck_is_no_span(span: word) -> bool {
    give back v4_span_start(span) == 0 and v4_span_end(span) == 0
}

task v4_borrowck_write_diag_span(mir_id: int, body_id: int, stmt_id: int) -> word {
    if stmt_id < 0 {
        give back V4_NO_SPAN
    }
    pilot stmt_span = v4_mir_stmt_span(mir_id, body_id, stmt_id)
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    if place_id < 0 {
        give back stmt_span
    }
    pilot place_span = v4_mir_place_span(mir_id, body_id, place_id)
    if v4_borrowck_is_no_span(place_span) {
        give back stmt_span
    }
    give back place_span
}

task v4_borrowck_use_diag_span(mir_id: int, body_id: int, stmt_id: int) -> word {
    if stmt_id < 0 {
        give back V4_NO_SPAN
    }
    pilot stmt_span = v4_mir_stmt_span(mir_id, body_id, stmt_id)
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    if rvalue_id < 0 {
        give back stmt_span
    }
    pilot rvalue_span = v4_mir_rvalue_span(mir_id, body_id, rvalue_id)
    if v4_borrowck_is_no_span(rvalue_span) {
        give back stmt_span
    }
    give back rvalue_span
}

task v4_borrowck_add_place_path(borrow_id: int, result_id: int, mir_id: int, body_id: int, place_id: int, path_kind: word, stmt_id: int, block_id: int) -> void {
    if place_id < 0 {
        give back
    }
    v4_borrowck_add_path(borrow_id, result_id, path_kind, v4_mir_place_text(mir_id, body_id, place_id), stmt_id, block_id)
}

task v4_borrowck_lend_source_text(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back ""
    }
    pilot source_id = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
    if source_id >= 0 {
        pilot source_text = v4_mir_rvalue_text(mir_id, body_id, source_id)
        if source_text != "" {
            give back source_text
        }
    }
    give back v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
}

task v4_borrowck_lend_path_kind(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id >= 0 and v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_lend_mut {
        give back v4_borrowck_path_loan_mut
    }
    give back v4_borrowck_path_loan
}

task v4_borrowck_rvalue_lends_source(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, loan_text: word) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if rvalue_kind == v4_mir_rvalue_lend or rvalue_kind == v4_mir_rvalue_lend_mut {
        give back v4_borrowck_paths_overlap(v4_borrowck_lend_source_text(mir_id, body_id, rvalue_id), loan_text)
    }
    if v4_mir_rvalue_is_aggregate_kind(rvalue_kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_borrowck_rvalue_lends_source(mir_id, body_id, use_stmt, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), loan_text) {
                give back true
            }
            child_id += 1
        }
    }
    if rvalue_kind == v4_mir_rvalue_call and use_stmt >= 0 {
        give back v4_borrowck_call_lends_source(mir_id, body_id, use_stmt, rvalue_id, loan_text)
    }
    give back false
}

task v4_borrowck_rvalue_resolves_lend_source(mir_id: int, body_id: int, use_stmt: int, rvalue_id: int, loan_text: word) -> bool {
    pilot provenance_id = v4_borrowck_return_lend_provenance(mir_id, body_id, use_stmt, rvalue_id)
    give back v4_borrowck_provenance_overlaps_path(provenance_id, loan_text)
}

task v4_borrowck_call_lends_source(mir_id: int, body_id: int, call_stmt: int, call_rvalue: int, loan_text: word) -> bool {
    if call_rvalue < 0 or v4_mir_rvalue_kind(mir_id, body_id, call_rvalue) != v4_mir_rvalue_call {
        give back false
    }
    pilot provenance_id = v4_borrowck_return_lend_provenance(mir_id, body_id, call_stmt, call_rvalue)
    give back v4_borrowck_provenance_overlaps_path(provenance_id, loan_text)
}

task v4_borrowck_stored_call_return_holder(mir_id: int, body_id: int, loan_stmt: int, loan_text: word) -> word {
    if loan_stmt < 0 {
        give back ""
    }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, loan_stmt)
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_call {
        give back ""
    }
    pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot outer_lend = v4_ty_is_lend_type(result_ty)
    pilot hidden_lend = v4_borrowck_call_returns_hidden_lend(mir_id, body_id, rvalue_id)
    if not outer_lend and not hidden_lend {
        give back ""
    }
    if outer_lend and not v4_borrowck_call_lends_source(mir_id, body_id, loan_stmt, rvalue_id, loan_text) {
        give back ""
    }
    if hidden_lend and not v4_borrowck_call_direct_mut_lends_source(mir_id, body_id, rvalue_id, loan_text) {
        give back ""
    }
    pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, loan_stmt)
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, loan_stmt)
    if (stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign) and place_id >= 0 {
        if v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_local {
            give back v4_mir_place_text(mir_id, body_id, place_id)
        }
    }
    give back ""
}

task v4_borrowck_closure_lends_source(mir_id: int, body_id: int, closure_rvalue: int, loan_text: word) -> bool {
    if closure_rvalue < 0 or v4_mir_rvalue_kind(mir_id, body_id, closure_rvalue) != v4_mir_rvalue_closure {
        give back false
    }
    pilot capture_id = 0
    pilot capture_count = v4_mir_closure_capture_count(mir_id, body_id, closure_rvalue)
    repeat until capture_id >= capture_count {
        pilot capture_rvalue = v4_mir_closure_capture(mir_id, body_id, closure_rvalue, capture_id)
        pilot capture_kind = v4_mir_rvalue_kind(mir_id, body_id, capture_rvalue)
        if capture_kind == v4_mir_rvalue_capture_borrow or capture_kind == v4_mir_rvalue_capture_borrow_mut {
            if v4_borrowck_paths_overlap(v4_mir_rvalue_text(mir_id, body_id, capture_rvalue), loan_text) {
                give back true
            }
        }
        capture_id += 1
    }
    give back false
}

task v4_borrowck_stored_closure_holder(mir_id: int, body_id: int, loan_stmt: int, loan_text: word) -> word {
    if loan_stmt < 0 {
        give back ""
    }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, loan_stmt)
    if not v4_borrowck_closure_lends_source(mir_id, body_id, rvalue_id, loan_text) {
        give back ""
    }
    pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, loan_stmt)
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, loan_stmt)
    if (stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign) and place_id >= 0 {
        if v4_mir_place_kind(mir_id, body_id, place_id) == v4_mir_place_local {
            give back v4_mir_place_text(mir_id, body_id, place_id)
        }
    }
    give back "@temporary"
}

task v4_borrowck_place_is_local_storage_projection(mir_id: int, body_id: int, place_id: int) -> bool {
    pilot place_count = v4_mir_body_place_count(mir_id, body_id)
    pilot current_place = place_id
    pilot depth = 0
    repeat until current_place < 0 or depth > place_count {
        pilot place_kind = v4_mir_place_kind(mir_id, body_id, current_place)
        if place_kind == v4_mir_place_local {
            give back true
        }
        if place_kind != v4_mir_place_field and place_kind != v4_mir_place_index {
            give back false
        }
        current_place = v4_mir_place_base(mir_id, body_id, current_place)
        depth += 1
    }
    give back false
}

task v4_borrowck_explicit_loan_holder(mir_id: int, body_id: int, loan_stmt: int, loan_text: word) -> word {
    if loan_stmt < 0 {
        give back ""
    }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, loan_stmt)
    if v4_borrowck_rvalue_lends_source(mir_id, body_id, loan_stmt, rvalue_id, loan_text) {
        pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, loan_stmt)
        pilot place_id = v4_mir_stmt_place(mir_id, body_id, loan_stmt)
        if (stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign) and v4_borrowck_place_is_local_storage_projection(mir_id, body_id, place_id) {
            pilot holder = v4_mir_place_text(mir_id, body_id, place_id)
            pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
            if v4_mir_rvalue_is_aggregate_kind(rvalue_kind) or rvalue_kind == v4_mir_rvalue_call {
                pilot projection = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, rvalue_id, loan_text)
                if projection == v4_borrowck_holder_projection_none {
                    give back "@temporary"
                }
                if projection != v4_borrowck_holder_projection_whole {
                    holder = holder + projection
                }
            }
            give back holder
        }
        give back "@temporary"
    }
    pilot closure_holder = v4_borrowck_stored_closure_holder(mir_id, body_id, loan_stmt, loan_text)
    if closure_holder != "" {
        give back closure_holder
    }
    pilot call_holder = v4_borrowck_stored_call_return_holder(mir_id, body_id, loan_stmt, loan_text)
    if call_holder != "" {
        give back call_holder
    }
    if v4_borrowck_call_lends_source(mir_id, body_id, loan_stmt, rvalue_id, loan_text) {
        give back "@temporary"
    }
    if rvalue_id >= 0 and v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) == v4_mir_rvalue_call {
        give back "@temporary"
    }
    give back ""
}

task v4_borrowck_rvalue_uses_holder(mir_id: int, body_id: int, rvalue_id: int, holder: word) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        give back v4_borrowck_paths_overlap(holder, v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        if v4_borrowck_rvalue_uses_holder(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id), holder) {
            give back true
        }
        give back v4_borrowck_rvalue_uses_holder(mir_id, body_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id), holder)
    }
    if kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_try or kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err or kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_borrowck_rvalue_uses_holder(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id), holder)
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_borrowck_rvalue_uses_holder(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), holder) {
                give back true
            }
            child_id += 1
        }
    }
    if kind == v4_mir_rvalue_call {
        if v4_borrowck_rvalue_uses_holder(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id), holder) {
            give back true
        }
        pilot arg_id = 0
        pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
        repeat until arg_id >= arg_count {
            if v4_borrowck_rvalue_uses_holder(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id), holder) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_borrowck_block_can_cycle(mir_id: int, body_id: int, block_id: int) -> bool {
    if block_id < 0 or block_id >= v4_mir_body_block_count(mir_id, body_id) {
        give back false
    }
    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
    pilot terminator = v4_mir_block_terminator(block_record)
    if terminator == v4_mir_term_goto {
        give back v4_borrowck_block_reaches(mir_id, body_id, v4_mir_block_target(block_record), block_id)
    }
    if terminator == v4_mir_term_if {
        if v4_borrowck_block_reaches(mir_id, body_id, v4_mir_block_target(block_record), block_id) {
            give back true
        }
        give back v4_borrowck_block_reaches(mir_id, body_id, v4_mir_block_else_target(block_record), block_id)
    }
    give back false
}

task v4_borrowck_rvalue_returns_holder(mir_id: int, body_id: int, rvalue_id: int, holder: word) -> bool {
    if rvalue_id < 0 {
        give back false
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        give back v4_borrowck_paths_overlap(holder, v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_borrowck_rvalue_returns_holder(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id), holder)
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            if v4_borrowck_rvalue_returns_holder(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), holder) {
                give back true
            }
            child_id += 1
        }
    }
    if kind == v4_mir_rvalue_call {
        pilot result_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        if v4_ty_is_closure_type(result_ty) {
            pilot closure_arg_id = 0
            pilot closure_arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
            repeat until closure_arg_id >= closure_arg_count {
                pilot closure_arg = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, closure_arg_id)
                if v4_borrowck_rvalue_returns_holder(mir_id, body_id, closure_arg, holder) { give back true }
                closure_arg_id += 1
            }
            give back false
        }

        if v4_ty_is_lend_type(result_ty) {
            pilot source_count = v4_mir_rvalue_call_borrowed_source_arg_count(mir_id, body_id, rvalue_id)
            if source_count >= 0 {
                pilot source_id = 0
                repeat until source_id >= source_count {
                    pilot source_arg = v4_mir_rvalue_call_borrowed_source_arg_at(mir_id, body_id, rvalue_id, source_id)
                    if source_arg >= 0 and v4_borrowck_rvalue_returns_holder(mir_id, body_id, source_arg, holder) { give back true }
                    source_id += 1
                }
                give back false
            }
        } else if v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), result_ty) {
            pilot leaf_id = 0
            pilot leaf_count = v4_mir_rvalue_call_return_lend_leaf_count(mir_id, body_id, rvalue_id)
            if leaf_count < 0 { give back true }
            repeat until leaf_id >= leaf_count {
                pilot source_payload = v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id, body_id, rvalue_id, leaf_id)
                pilot source_count = v4_ty_return_lend_source_payload_count(source_payload)
                if source_count < 0 { give back true }
                pilot source_id = 0
                repeat until source_id >= source_count {
                    pilot source_edge = v4_ty_return_lend_source_payload_at(source_payload, source_id)
                    if source_edge == "" { give back true }
                    pilot source_arg = word_to_int(v4_resolve_snapshot_field_raw(source_edge, 0))
                    if source_arg < 0 { give back true }
                    if v4_borrowck_rvalue_returns_holder(mir_id, body_id, source_arg, holder) { give back true }
                    source_id += 1
                }
                leaf_id += 1
            }
            give back false
        }
        pilot arg_id = 0
        pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
        repeat until arg_id >= arg_count {
            pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id)
            if v4_borrowck_rvalue_is_borrow_capable(mir_id, body_id, arg_rvalue) and v4_borrowck_rvalue_returns_holder(mir_id, body_id, arg_rvalue, holder) {
                give back true
            }
            arg_id += 1
        }
    }
    give back false
}

task v4_borrowck_aggregate_child_projection_segment(mir_id: int, body_id: int, rvalue_id: int, child_id: int) -> word {
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_tuple {
        give back "." + word_from_int(child_id)
    }
    if kind == v4_mir_rvalue_array {
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        pilot length_text = v4_ty_fixed_array_length_normalized_text(v4_mir_ty_id(mir_id), v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
        if child_count == 1 {
            if length_text == "0" {
                give back v4_borrowck_holder_projection_none
            }
            if length_text != "1" {
                give back "[*]"
            }
        }
        give back "[" + word_from_int(child_id) + "]"
    }
    if kind == v4_mir_rvalue_construct {
        pilot ty_id = v4_mir_ty_id(mir_id)
        pilot aggregate_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        if v4_ty_is_route_type(ty_id, aggregate_ty) {
            pilot case_name = v4_mir_rvalue_op(mir_id, body_id, rvalue_id)
            pilot next_case = v4_mir_path_right(case_name)
            repeat until next_case == "" {
                case_name = next_case
                next_case = v4_mir_path_right(case_name)
            }
            pilot field_name = v4_ty_route_case_field_name(ty_id, aggregate_ty, case_name, child_id)
            if field_name != "" {
                give back "." + field_name
            }
            give back v4_borrowck_holder_projection_none
        }
        pilot sig_id = v4_ty_shape_signature_id_for_name(ty_id, aggregate_ty)
        if sig_id >= 0 {
            pilot field_name = v4_ty_shape_field_name(ty_id, sig_id, child_id)
            if field_name != "" {
                give back "." + field_name
            }
        }
        give back v4_borrowck_holder_projection_none
    }
    give back v4_borrowck_holder_projection_whole
}

task v4_borrowck_projection_array_push_unique(projections: int, projection: word) -> void {
    pilot projection_id = 0
    pilot has_whole = false
    repeat until projection_id >= array_len(projections) {
        pilot existing: word = array_get(projections, projection_id)
        if existing == projection { give back }
        if existing == v4_borrowck_holder_projection_whole { has_whole = true }
        projection_id += 1
    }
    if array_len(projections) >= v4_ty_fixed_lend_leaf_limit {
        if not has_whole {
            array_push(projections, v4_borrowck_holder_projection_whole)
        }
        give back
    }
    array_push(projections, projection)
}

task v4_borrowck_projection_array_has_whole(projections: int) -> bool {
    pilot projection_id = 0
    repeat until projection_id >= array_len(projections) {
        pilot projection: word = array_get(projections, projection_id)
        if projection == v4_borrowck_holder_projection_whole { give back true }
        projection_id += 1
    }
    give back false
}

task v4_borrowck_collect_call_holder_projections(mir_id: int, body_id: int, rvalue_id: int, holder: word, prefix: word, projections: int) -> void {
    pilot leaf_id = 0
    pilot relation_count = 0
    pilot call_stmt = v4_borrowck_stmt_for_rvalue(mir_id, body_id, rvalue_id)
    pilot leaf_count = v4_mir_rvalue_call_return_lend_leaf_count(mir_id, body_id, rvalue_id)
    if leaf_count < 0 {
        v4_borrowck_projection_array_push_unique(projections, v4_borrowck_holder_projection_whole)
        give back
    }
    repeat until leaf_id >= leaf_count {
        pilot return_projection = v4_mir_rvalue_call_return_lend_leaf_projection_at(mir_id, body_id, rvalue_id, leaf_id)
        pilot source_payload = v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id, body_id, rvalue_id, leaf_id)
        pilot source_count = v4_ty_return_lend_source_payload_count(source_payload)
        if source_count < 0 {
            v4_borrowck_projection_array_push_unique(projections, v4_borrowck_holder_projection_whole)
            give back
        }
        pilot source_id = 0
        repeat until source_id >= source_count {
            if relation_count >= v4_borrowck_call_projection_relation_limit_value {
                v4_borrowck_projection_array_push_unique(projections, v4_borrowck_holder_projection_whole)
                give back
            }
            relation_count += 1
            pilot source_edge = v4_ty_return_lend_source_payload_at(source_payload, source_id)
            if source_edge == "" {
                v4_borrowck_projection_array_push_unique(projections, v4_borrowck_holder_projection_whole)
                give back
            }
            pilot source_arg = word_to_int(v4_resolve_snapshot_field_raw(source_edge, 0))
            pilot source_projection = v4_resolve_snapshot_field_raw(source_edge, 1)
            pilot source_guard = v4_resolve_snapshot_field_raw(source_edge, 2)
            if source_arg < 0 {
                v4_borrowck_projection_array_push_unique(projections, v4_borrowck_holder_projection_whole)
                give back
            }
            pilot nested = v4_borrowck_holder_projection_none
            if v4_borrowck_rvalue_matches_route_guard_projected_at(mir_id, body_id, call_stmt, source_arg, source_projection, source_guard) {
                nested = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, source_arg, holder)
            }
            if nested != v4_borrowck_holder_projection_none {
                pilot candidate = v4_borrowck_holder_projection_none
                if nested == v4_borrowck_holder_projection_whole {
                    candidate = return_projection
                } else {
                    pilot tail = v4_borrowck_projection_match_tail(source_projection, nested)
                    if tail != "#no-match" {
                        candidate = return_projection + tail
                    } else if v4_borrowck_projection_match_tail(nested, source_projection) != "#no-match" {
                        candidate = return_projection
                    }
                }
                if candidate == "" { candidate = v4_borrowck_holder_projection_whole }
                if candidate != v4_borrowck_holder_projection_none {
                    pilot projected = prefix
                    if candidate != v4_borrowck_holder_projection_whole {
                        projected = prefix + candidate
                    }
                    if projected == "" { projected = v4_borrowck_holder_projection_whole }
                    v4_borrowck_projection_array_push_unique(projections, projected)
                    if v4_borrowck_projection_array_has_whole(projections) { give back }
                }
            }
            source_id += 1
        }
        leaf_id += 1
    }
}

task v4_borrowck_collect_rvalue_holder_projections(mir_id: int, body_id: int, rvalue_id: int, holder: word, prefix: word, projections: int) -> void {
    if rvalue_id < 0 { give back }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            pilot segment = v4_borrowck_aggregate_child_projection_segment(mir_id, body_id, rvalue_id, child_id)
            if segment != v4_borrowck_holder_projection_none {
                pilot child_prefix = prefix
                if segment != v4_borrowck_holder_projection_whole {
                    child_prefix = prefix + segment
                }
                v4_borrowck_collect_rvalue_holder_projections(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), holder, child_prefix, projections)
            }
            child_id += 1
        }
        give back
    }

    if kind == v4_mir_rvalue_call {
        v4_borrowck_collect_call_holder_projections(mir_id, body_id, rvalue_id, holder, prefix, projections)
        give back
    }
    pilot nested = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, rvalue_id, holder)
    if nested == v4_borrowck_holder_projection_none { give back }
    pilot candidate = prefix
    if nested != v4_borrowck_holder_projection_whole {
        candidate = prefix + nested
    }
    if candidate == "" {
        candidate = v4_borrowck_holder_projection_whole
    }
    v4_borrowck_projection_array_push_unique(projections, candidate)
}

task v4_borrowck_rvalue_unique_holder_projection(mir_id: int, body_id: int, rvalue_id: int, holder: word) -> word {
    if rvalue_id < 0 {
        give back v4_borrowck_holder_projection_none
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot holder_canon = v4_borrowck_path_canon(holder)
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place or kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut or kind == v4_mir_rvalue_capture_copy or kind == v4_mir_rvalue_capture_move {
        pilot source = v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, rvalue_id))
        if source == holder_canon {
            give back v4_borrowck_holder_projection_whole
        }
        if v4_borrowck_path_prefix_conflicts(source, holder_canon) {
            give back v4_slice(holder_canon, source.length(), holder_canon.length())
        }
        if v4_borrowck_paths_overlap(source, holder_canon) {
            give back v4_borrowck_holder_projection_whole
        }
        give back v4_borrowck_holder_projection_none
    }
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut {
        give back v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id), holder_canon)
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot unique = v4_borrowck_holder_projection_none
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id)
            pilot nested = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, child_rvalue, holder_canon)
            if nested != v4_borrowck_holder_projection_none {
                pilot segment = v4_borrowck_aggregate_child_projection_segment(mir_id, body_id, rvalue_id, child_id)
                if segment == v4_borrowck_holder_projection_none {
                    give back v4_borrowck_holder_projection_none
                }
                pilot candidate = segment
                if segment == v4_borrowck_holder_projection_whole {
                    candidate = v4_borrowck_holder_projection_whole
                } else if nested != v4_borrowck_holder_projection_whole {
                    candidate = segment + nested
                }
                if unique == v4_borrowck_holder_projection_none {
                    unique = candidate
                } else if unique != candidate {
                    give back v4_borrowck_holder_projection_whole
                }
            }
            child_id += 1
        }
        give back unique
    }
    if kind == v4_mir_rvalue_call {
        pilot unique = v4_borrowck_holder_projection_none
        pilot leaf_id = 0
        pilot leaf_count = v4_mir_rvalue_call_return_lend_leaf_count(mir_id, body_id, rvalue_id)
        if leaf_count < 0 {
            give back v4_borrowck_holder_projection_whole
        }
        repeat until leaf_id >= leaf_count {
            pilot return_projection = v4_mir_rvalue_call_return_lend_leaf_projection_at(mir_id, body_id, rvalue_id, leaf_id)
            pilot source_payload = v4_mir_rvalue_call_borrowed_source_payload_for_leaf(mir_id, body_id, rvalue_id, leaf_id)
            pilot source_count = v4_ty_return_lend_source_payload_count(source_payload)
            if source_count < 0 {
                give back v4_borrowck_holder_projection_whole
            }
            pilot source_id = 0
            repeat until source_id >= source_count {
                pilot source_edge = v4_ty_return_lend_source_payload_at(source_payload, source_id)
                if source_edge == "" {
                    give back v4_borrowck_holder_projection_whole
                }
                pilot source_arg = word_to_int(v4_resolve_snapshot_field_raw(source_edge, 0))
                pilot source_projection = v4_resolve_snapshot_field_raw(source_edge, 1)
                if source_arg < 0 {
                    give back v4_borrowck_holder_projection_whole
                }
                pilot nested = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, source_arg, holder_canon)
                if nested != v4_borrowck_holder_projection_none {
                    pilot candidate = v4_borrowck_holder_projection_none
                    if nested == v4_borrowck_holder_projection_whole {
                        candidate = return_projection
                    } else {
                        pilot tail = v4_borrowck_projection_match_tail(source_projection, nested)
                        if tail != "#no-match" {
                            candidate = return_projection + tail
                        } else if v4_borrowck_projection_match_tail(nested, source_projection) != "#no-match" {
                            candidate = return_projection
                        }
                    }
                    if candidate == "" {
                        candidate = v4_borrowck_holder_projection_whole
                    }
                    if candidate != v4_borrowck_holder_projection_none {
                        if unique == v4_borrowck_holder_projection_none {
                            unique = candidate
                        } else if unique != candidate {
                            give back v4_borrowck_holder_projection_whole
                        }
                    }
                }
                source_id += 1
            }
            leaf_id += 1
        }
        give back unique
    }
    if v4_borrowck_rvalue_returns_holder(mir_id, body_id, rvalue_id, holder_canon) {
        give back v4_borrowck_holder_projection_whole
    }
    give back v4_borrowck_holder_projection_none
}

task v4_borrowck_holder_alias_from_stmt(mir_id: int, body_id: int, stmt_id: int, holder: word) -> word {
    pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
    if stmt_kind != v4_mir_stmt_local and stmt_kind != v4_mir_stmt_assign {
        give back ""
    }
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    if not v4_borrowck_place_is_local_storage_projection(mir_id, body_id, place_id) { give back "" }
    pilot alias = v4_mir_place_text(mir_id, body_id, place_id)
    if v4_borrowck_path_canon(alias) == v4_borrowck_path_canon(holder) {
        give back ""
    }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    if rvalue_id < 0 {
        give back ""
    }
    pilot alias_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
    pilot carries_holder = v4_ty_type_may_store_lend(v4_mir_ty_id(mir_id), alias_ty)
    if v4_ty_is_closure_type(alias_ty) {
        -- Any capture mode can retain a loan-bearing aggregate in the closure environment.
        carries_holder = true
    }
    if not carries_holder {
        give back ""
    }

    pilot projection = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, rvalue_id, holder)
    if projection == v4_borrowck_holder_projection_none {
        give back ""
    }
    if projection == v4_borrowck_holder_projection_whole {
        give back alias
    }
    give back alias + projection
}

task v4_borrowck_collect_holder_aliases_from_stmt(mir_id: int, body_id: int, stmt_id: int, holder: word, aliases: int) -> void {
    pilot alias = v4_borrowck_holder_alias_from_stmt(mir_id, body_id, stmt_id, holder)
    if alias == "" { give back }
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    pilot alias_base = v4_mir_place_text(mir_id, body_id, place_id)
    if alias != alias_base {
        v4_borrowck_projection_array_push_unique(aliases, alias)
        give back
    }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if not v4_mir_rvalue_is_aggregate_kind(kind) and kind != v4_mir_rvalue_call {
        v4_borrowck_projection_array_push_unique(aliases, alias)
        give back
    }

    pilot projections = array_new()
    v4_borrowck_collect_rvalue_holder_projections(mir_id, body_id, rvalue_id, holder, "", projections)
    if array_len(projections) == 0 {
        v4_borrowck_projection_array_push_unique(aliases, alias)
    }
    pilot projection_id = 0
    repeat until projection_id >= array_len(projections) {
        pilot projection: word = array_get(projections, projection_id)
        pilot projected_alias = alias_base
        if projection != v4_borrowck_holder_projection_whole {
            projected_alias = alias_base + projection
        }
        v4_borrowck_projection_array_push_unique(aliases, projected_alias)
        projection_id += 1
    }
    array_release(projections)
}

task v4_borrowck_holder_state(holder: word, holder_stmt: int) -> word {
    give back v4_borrowck_path_canon(holder) + "@" + word_from_int(holder_stmt)
}

task v4_borrowck_holder_seen(seen: word, holder: word, holder_stmt: int) -> bool {
    give back ("|" + seen + "|").contains("|" + v4_borrowck_holder_state(holder, holder_stmt) + "|")
}

task v4_borrowck_holder_seen_append(seen: word, holder: word, holder_stmt: int) -> word {
    pilot state = v4_borrowck_holder_state(holder, holder_stmt)
    if seen == "" {
        give back state
    }
    give back seen + "|" + state
}

task v4_borrowck_stmt_may_bind_holder(mir_id: int, body_id: int, stmt_id: int, holder: word) -> bool {
    pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
    if stmt_kind != v4_mir_stmt_local and stmt_kind != v4_mir_stmt_assign {
        give back false
    }
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    if place_id < 0 {
        give back false
    }

    pilot holder_canon = v4_borrowck_path_canon(holder)
    pilot place_canon = v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id))
    if not v4_borrowck_path_write_may_bind(place_canon, holder_canon) {
        give back false
    }

    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
    if rvalue_id >= 0 {
        pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
        if rvalue_kind == v4_mir_rvalue_use_local or rvalue_kind == v4_mir_rvalue_use_place {
            if v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, rvalue_id)) == place_canon {
                give back false
            }
        }
    }
    give back true
}

task v4_borrowck_stmt_rebinds_holder(mir_id: int, body_id: int, stmt_id: int, holder: word) -> bool {
    if not v4_borrowck_stmt_may_bind_holder(mir_id, body_id, stmt_id, holder) {
        give back false
    }
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    give back v4_borrowck_path_write_definitely_covers(v4_mir_place_text(mir_id, body_id, place_id), holder)
}

task v4_borrowck_resolve_projected_lend_alias_before(mir_id: int, body_id: int, path: word, use_stmt: int, alias_depth: int) -> word {
    if alias_depth > 16 or use_stmt < 0 {
        give back ""
    }
    pilot path_canon = v4_borrowck_path_canon(path)
    pilot alias_root = v4_borrowck_path_root(path_canon)
    if alias_root == "" {
        give back ""
    }
    if not v4_ty_is_lend_type(v4_mir_local_ty_for_name(mir_id, body_id, alias_root)) {
        give back ""
    }
    pilot suffix = ""
    if path_canon.length() > alias_root.length() {
        suffix = v4_slice(path_canon, alias_root.length(), path_canon.length())
    }
    if suffix == "" {
        give back ""
    }
    pilot use_block = v4_mir_stmt_block(mir_id, body_id, use_stmt)
    pilot resolved = ""
    pilot found = false
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if stmt_id != use_stmt {
            pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
            if place_id >= 0 and v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id)) == alias_root {
                pilot origin_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
                if v4_borrowck_holder_reaches_stmt_without_rebind_depth(mir_id, body_id, alias_root, stmt_id, stmt_id, origin_block, use_stmt, use_block, alias_depth + 1) {
                    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
                    if rvalue_id < 0 {
                        give back ""
                    }
                    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
                    if kind != v4_mir_rvalue_lend and kind != v4_mir_rvalue_lend_mut {
                        give back ""
                    }
                    pilot source_rvalue = v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id)
                    if source_rvalue < 0 {
                        give back ""
                    }
                    pilot source_kind = v4_mir_rvalue_kind(mir_id, body_id, source_rvalue)
                    if source_kind != v4_mir_rvalue_use_local and source_kind != v4_mir_rvalue_use_place {
                        give back ""
                    }
                    pilot candidate = v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, source_rvalue)) + suffix
                    if not found {
                        resolved = candidate
                        found = true
                    } else if resolved != candidate {
                        give back ""
                    }
                }
            }
        }
        stmt_id += 1
    }
    if found {
        pilot transitive = v4_borrowck_resolve_projected_lend_alias_before(mir_id, body_id, resolved, use_stmt, alias_depth + 1)
        if transitive != "" and transitive != resolved {
            give back transitive
        }
        give back resolved
    }
    give back ""
}

task v4_borrowck_stmt_rebinds_holder_at(mir_id: int, body_id: int, stmt_id: int, holder: word, alias_depth: int) -> bool {
    if v4_borrowck_stmt_rebinds_holder(mir_id, body_id, stmt_id, holder) {
        give back true
    }
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    if place_id < 0 {
        give back false
    }
    pilot place_text = v4_borrowck_path_canon(v4_mir_place_text(mir_id, body_id, place_id))
    if v4_borrowck_path_root(place_text) == v4_borrowck_path_root(holder) {
        give back false
    }
    pilot resolved = v4_borrowck_resolve_projected_lend_alias_before(mir_id, body_id, place_text, stmt_id, alias_depth)
    give back resolved != "" and v4_borrowck_path_write_definitely_covers(resolved, holder)
}

task v4_borrowck_holder_reaches_stmt_without_rebind_depth(mir_id: int, body_id: int, holder: word, provenance_stmt: int, start_stmt: int, start_block: int, wanted_stmt: int, wanted_block: int, alias_depth: int) -> bool {
    if holder == "" or holder == "@temporary" or start_block < 0 or wanted_block < 0 {
        give back false
    }
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    if start_block >= block_count or wanted_block >= block_count {
        give back false
    }

    pilot seen = array_new()
    pilot block_queue = array_new()
    pilot stmt_queue = array_new()
    array_push(block_queue, word_from_int(start_block))
    array_push(stmt_queue, word_from_int(start_stmt))
    pilot cursor = 0
    pilot reaches = false
    repeat until cursor >= array_len(block_queue) or reaches {
        pilot block_id = word_to_int(array_get(block_queue, cursor))
        pilot block_start_stmt = word_to_int(array_get(stmt_queue, cursor))
        cursor += 1
        if block_id >= 0 and block_id < block_count and not v4_borrowck_seen_index(seen, block_id) {
            if block_id == wanted_block and block_start_stmt == wanted_stmt {
                reaches = true
            } else if block_id == wanted_block and wanted_stmt < block_start_stmt and v4_borrowck_block_can_cycle(mir_id, body_id, block_id) {
                pilot blocked_after_start = false
                pilot trailing_stmt = 0
                pilot trailing_count = v4_mir_body_stmt_count(mir_id, body_id)
                repeat until trailing_stmt >= trailing_count or blocked_after_start {
                    if v4_mir_stmt_block(mir_id, body_id, trailing_stmt) == block_id and trailing_stmt > block_start_stmt and trailing_stmt != provenance_stmt and v4_borrowck_stmt_rebinds_holder_at(mir_id, body_id, trailing_stmt, holder, alias_depth) {
                        blocked_after_start = true
                    }
                    trailing_stmt += 1
                }
                if not blocked_after_start {
                    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
                    pilot terminator = v4_mir_block_terminator(block_record)
                    if terminator == v4_mir_term_goto {
                        reaches = v4_borrowck_holder_reaches_stmt_without_rebind_depth(mir_id, body_id, holder, provenance_stmt, 0 - 1, v4_mir_block_target(block_record), wanted_stmt, wanted_block, alias_depth)
                    } else if terminator == v4_mir_term_if {
                        reaches = v4_borrowck_holder_reaches_stmt_without_rebind_depth(mir_id, body_id, holder, provenance_stmt, 0 - 1, v4_mir_block_target(block_record), wanted_stmt, wanted_block, alias_depth)
                        if not reaches {
                            reaches = v4_borrowck_holder_reaches_stmt_without_rebind_depth(mir_id, body_id, holder, provenance_stmt, 0 - 1, v4_mir_block_else_target(block_record), wanted_stmt, wanted_block, alias_depth)
                        }
                    }
                }
            } else {
                v4_borrowck_mark_seen_index(seen, block_id)
                pilot blocked = false
                pilot stmt_id = 0
                pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
                repeat until stmt_id >= stmt_count or blocked or reaches {
                    if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id and stmt_id > block_start_stmt {
                        if block_id == wanted_block and stmt_id == wanted_stmt {
                            reaches = true
                        } else if stmt_id != provenance_stmt and v4_borrowck_stmt_rebinds_holder_at(mir_id, body_id, stmt_id, holder, alias_depth) {
                            blocked = true
                        }
                    }
                    stmt_id += 1
                }
                if not blocked and not reaches {
                    pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
                    pilot terminator = v4_mir_block_terminator(block_record)
                    if terminator == v4_mir_term_goto {
                        array_push(block_queue, word_from_int(v4_mir_block_target(block_record)))
                        array_push(stmt_queue, word_from_int(0 - 1))
                    }
                    if terminator == v4_mir_term_if {
                        array_push(block_queue, word_from_int(v4_mir_block_target(block_record)))
                        array_push(stmt_queue, word_from_int(0 - 1))
                        array_push(block_queue, word_from_int(v4_mir_block_else_target(block_record)))
                        array_push(stmt_queue, word_from_int(0 - 1))
                    }
                }
            }
        }
    }
    array_release(stmt_queue)
    array_release(block_queue)
    array_release(seen)
    give back reaches
}

task v4_borrowck_holder_reaches_stmt_without_rebind(mir_id: int, body_id: int, holder: word, provenance_stmt: int, start_stmt: int, start_block: int, wanted_stmt: int, wanted_block: int) -> bool {
    give back v4_borrowck_holder_reaches_stmt_without_rebind_depth(mir_id, body_id, holder, provenance_stmt, start_stmt, start_block, wanted_stmt, wanted_block, 0)
}

task v4_borrowck_holder_worklist_contains(holders: int, stmts: int, holder: word, holder_stmt: int) -> bool {
    pilot item_id = 0
    repeat until item_id >= array_len(holders) {
        pilot queued_holder: word = array_get(holders, item_id)
        if queued_holder == holder and word_to_int(array_get(stmts, item_id)) == holder_stmt { give back true }
        item_id += 1
    }
    give back false
}

task v4_borrowck_hidden_holder_reaches_access(mir_id: int, body_id: int, holder: word, holder_stmt: int, write_stmt: int, write_block: int) -> bool {
    if holder == "" or holder == "@temporary" { give back false }
    pilot holders = array_new()
    pilot holder_stmts = array_new()
    array_push(holders, holder)
    array_push(holder_stmts, word_from_int(holder_stmt))
    pilot cursor = 0
    pilot reaches = false
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until cursor >= array_len(holders) or reaches {
        pilot current_holder: word = array_get(holders, cursor)
        pilot current_stmt = word_to_int(array_get(holder_stmts, cursor))
        cursor += 1
        pilot reverse_alias = v4_borrowck_resolve_projected_lend_alias_before(mir_id, body_id, current_holder, current_stmt, 0)
        if reverse_alias != "" and reverse_alias != current_holder and not v4_borrowck_holder_worklist_contains(holders, holder_stmts, reverse_alias, current_stmt) {
            array_push(holders, reverse_alias)
            array_push(holder_stmts, word_from_int(current_stmt))
        }
        pilot holder_block = v4_mir_stmt_block(mir_id, body_id, current_stmt)
        if v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, current_holder, current_stmt, current_stmt, holder_block, write_stmt, write_block) {
            reaches = true
        }
        pilot stmt_id = 0
        repeat until stmt_id >= stmt_count or reaches {
            pilot alias_hint = v4_borrowck_holder_alias_from_stmt(mir_id, body_id, stmt_id, current_holder)
            if alias_hint != "" {
                pilot aliases = array_new()
                v4_borrowck_collect_holder_aliases_from_stmt(mir_id, body_id, stmt_id, current_holder, aliases)
                pilot alias_id = 0
                repeat until alias_id >= array_len(aliases) or reaches {
                    pilot alias: word = array_get(aliases, alias_id)
                    if alias != "" {
                        pilot alias_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
                        if v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, current_holder, current_stmt, current_stmt, holder_block, stmt_id, alias_block) and not v4_borrowck_holder_worklist_contains(holders, holder_stmts, alias, stmt_id) {
                            array_push(holders, alias)
                            array_push(holder_stmts, word_from_int(stmt_id))
                        }
                    }
                    alias_id += 1
                }
                array_release(aliases)
            }
            stmt_id += 1
        }
    }
    array_release(holder_stmts)
    array_release(holders)
    give back reaches
}

task v4_borrowck_holder_used_at_or_after_write(mir_id: int, body_id: int, holder: word, holder_stmt: int, write_stmt: int, write_block: int) -> bool {
    if holder == "" or holder == "@temporary" { give back false }
    pilot holders = array_new()
    pilot holder_stmts = array_new()
    array_push(holders, holder)
    array_push(holder_stmts, word_from_int(holder_stmt))
    pilot cursor = 0
    pilot used = false
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until cursor >= array_len(holders) or used {
        pilot current_holder: word = array_get(holders, cursor)
        pilot current_stmt = word_to_int(array_get(holder_stmts, cursor))
        cursor += 1
        pilot reverse_alias = v4_borrowck_resolve_projected_lend_alias_before(mir_id, body_id, current_holder, current_stmt, 0)
        if reverse_alias != "" and reverse_alias != current_holder and not v4_borrowck_holder_worklist_contains(holders, holder_stmts, reverse_alias, current_stmt) {
            array_push(holders, reverse_alias)
            array_push(holder_stmts, word_from_int(current_stmt))
        }
        pilot holder_block = v4_mir_stmt_block(mir_id, body_id, current_stmt)
        pilot holder_live_at_write = v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, current_holder, current_stmt, current_stmt, holder_block, write_stmt, write_block)
        pilot stmt_id = 0
        repeat until stmt_id >= stmt_count or used {
            pilot use_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
            pilot reaches_use = false
            if use_block == write_block and stmt_id >= write_stmt {
                reaches_use = true
            } else if use_block == write_block and v4_borrowck_block_can_cycle(mir_id, body_id, write_block) {
                reaches_use = true
            } else if use_block != write_block and v4_borrowck_block_reaches(mir_id, body_id, write_block, use_block) {
                reaches_use = true
            }
            if holder_live_at_write and reaches_use {
                reaches_use = v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, current_holder, current_stmt, write_stmt, write_block, stmt_id, use_block)
            }
            if holder_live_at_write and reaches_use {
                pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
                if place_id >= 0 {
                    pilot place_text = v4_mir_place_text(mir_id, body_id, place_id)
                    if v4_borrowck_paths_overlap(current_holder, place_text) and not v4_borrowck_path_write_definitely_covers(place_text, current_holder) {
                        used = true
                    }
                }
                pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
                if v4_borrowck_rvalue_uses_holder(mir_id, body_id, rvalue_id, current_holder) {
                    used = true
                }
            }
            pilot alias_hint = v4_borrowck_holder_alias_from_stmt(mir_id, body_id, stmt_id, current_holder)
            if alias_hint != "" {
                pilot aliases = array_new()
                v4_borrowck_collect_holder_aliases_from_stmt(mir_id, body_id, stmt_id, current_holder, aliases)
                pilot alias_id = 0
                repeat until alias_id >= array_len(aliases) or used {
                    pilot alias: word = array_get(aliases, alias_id)
                    if alias != "" {
                        pilot alias_block = v4_mir_stmt_block(mir_id, body_id, stmt_id)
                        if v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, current_holder, current_stmt, current_stmt, holder_block, stmt_id, alias_block) {
                            if v4_borrowck_holder_reaches_stmt_without_rebind(mir_id, body_id, alias, stmt_id, stmt_id, alias_block, write_stmt, write_block) {
                                if not v4_borrowck_holder_worklist_contains(holders, holder_stmts, alias, stmt_id) {
                                    array_push(holders, alias)
                                    array_push(holder_stmts, word_from_int(stmt_id))
                                }
                            }
                        }
                    }
                    alias_id += 1
                }
                array_release(aliases)
            }
            stmt_id += 1
        }
    }
    array_release(holder_stmts)
    array_release(holders)
    give back used
}

task v4_borrowck_repeat_direct_slot_index(base_holder: word, place_text: word) -> int {
    pilot base = v4_borrowck_path_canon(base_holder)
    pilot place = v4_borrowck_path_canon(place_text)
    if base == "" or place.length() <= base.length() + 2 {
        give back 0 - 1
    }
    if v4_slice(place, 0, base.length()) != base or place.char_at(base.length()) != "[" {
        give back 0 - 1
    }
    pilot close_idx = v4_borrowck_path_index_close(place, base.length())
    if close_idx != place.length() - 1 {
        give back 0 - 1
    }
    pilot index_text = v4_slice(place, base.length() + 1, close_idx)
    if not v4_borrowck_path_index_is_integer_literal(index_text) {
        give back 0 - 1
    }
    give back word_to_int(index_text)
}

task v4_borrowck_repeat_slots_rebound_in_block(mir_id: int, body_id: int, loan_stmt: int, loan_text: word, write_stmt: int, base_holder: word, slot_count: int) -> bool {
    if v4_mir_stmt_block(mir_id, body_id, loan_stmt) != v4_mir_stmt_block(mir_id, body_id, write_stmt) {
        give back false
    }

    pilot rebound = array_new()
    pilot slot_id = 0
    repeat until slot_id >= slot_count {
        array_push(rebound, "false")
        slot_id += 1
    }

    pilot rebound_count = 0
    pilot cached_replacement_local = ""
    pilot cached_replacement_provenance = 0 - 1
    pilot stmt_id = loan_stmt + 1
    repeat until stmt_id >= write_stmt {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == v4_mir_stmt_block(mir_id, body_id, loan_stmt) {
            pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
            if stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign {
                pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
                if place_id >= 0 {
                    pilot place_text = v4_mir_place_text(mir_id, body_id, place_id)
                    if cached_replacement_local != "" and v4_borrowck_path_write_definitely_covers(place_text, cached_replacement_local) {
                        cached_replacement_local = ""
                        cached_replacement_provenance = 0 - 1
                    }
                    pilot rebound_slot = v4_borrowck_repeat_direct_slot_index(base_holder, place_text)
                    pilot rebound_state = ""
                    if rebound_slot >= 0 and rebound_slot < slot_count { rebound_state = array_get(rebound, rebound_slot) }
                    if rebound_slot >= 0 and rebound_slot < slot_count and rebound_state != "true" {
                        pilot replacement = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)
                        if replacement >= 0 and v4_ty_is_lend_type(v4_mir_rvalue_ty(mir_id, body_id, replacement)) {
                            pilot replacement_provenance = 0 - 1
                            pilot replacement_kind = v4_mir_rvalue_kind(mir_id, body_id, replacement)
                            pilot replacement_local = ""
                            if replacement_kind == v4_mir_rvalue_use_local {
                                replacement_local = v4_borrowck_path_canon(v4_mir_rvalue_text(mir_id, body_id, replacement))
                            }
                            if replacement_local != "" and replacement_local == cached_replacement_local {
                                replacement_provenance = cached_replacement_provenance
                            } else {
                                replacement_provenance = v4_borrowck_return_lend_provenance(mir_id, body_id, stmt_id, replacement)
                                cached_replacement_local = replacement_local
                                cached_replacement_provenance = replacement_provenance
                            }
                            if v4_borrowck_provenance_is_known(replacement_provenance) and not v4_borrowck_provenance_overlaps_path(replacement_provenance, loan_text) {
                                array_set(rebound, rebound_slot, "true")
                                rebound_count += 1
                            }
                        }
                    }
                }
            }
        }
        stmt_id += 1
    }
    array_release(rebound)
    give back rebound_count == slot_count
}

-- Returns -1 when the initializer is not a repeat fill, otherwise 0/1 for dead/live.
task v4_borrowck_repeat_fill_loan_live_at_write(mir_id: int, body_id: int, loan_stmt: int, loan_text: word, write_stmt: int, write_block: int) -> int {
    if loan_stmt < 0 { give back 0 - 1 }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, loan_stmt)
    if rvalue_id < 0 or v4_mir_rvalue_kind(mir_id, body_id, rvalue_id) != v4_mir_rvalue_array {
        give back 0 - 1
    }
    if v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id) != 1 or v4_mir_rvalue_aggregate_child_projection(mir_id, body_id, rvalue_id, 0) != "[*]" {
        give back 0 - 1
    }
    pilot slot_count = v4_mir_fixed_array_slot_count(mir_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id))
    if slot_count <= 1 { give back 0 - 1 }

    pilot child_rvalue = v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, 0)
    pilot nested = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, child_rvalue, loan_text)
    if nested == v4_borrowck_holder_projection_none { give back 0 - 1 }
    pilot loan_place = v4_mir_stmt_place(mir_id, body_id, loan_stmt)
    if not v4_borrowck_place_is_local_storage_projection(mir_id, body_id, loan_place) { give back 1 }
    pilot base_holder = v4_mir_place_text(mir_id, body_id, loan_place)

    -- Sparse bodies cannot contain a distinct retirement for every slot.
    if slot_count >= 256 {
        if slot_count <= v4_mir_body_stmt_count(mir_id, body_id) and v4_borrowck_repeat_slots_rebound_in_block(mir_id, body_id, loan_stmt, loan_text, write_stmt, base_holder, slot_count) {
            give back 0
        }
        if slot_count > v4_borrowck_repeat_projection_scan_limit_value {
            if v4_borrowck_holder_used_at_or_after_write(mir_id, body_id, base_holder, loan_stmt, write_stmt, write_block) { give back 1 }
            give back 0
        }
    }

    pilot slot_id = 0
    repeat until slot_id >= slot_count {
        pilot projected_holder = base_holder + "[" + word_from_int(slot_id) + "]"
        if nested != v4_borrowck_holder_projection_whole {
            projected_holder = projected_holder + nested
        }
        if v4_borrowck_holder_used_at_or_after_write(mir_id, body_id, projected_holder, loan_stmt, write_stmt, write_block) {
            give back 1
        }
        slot_id += 1
    }
    give back 0
}

-- 0 means no matching source, 1 means every occurrence is dead, and 2 means live.
task v4_borrowck_aggregate_source_liveness_at_write(mir_id: int, body_id: int, rvalue_id: int, loan_text: word, projected_holder: word, holder_stmt: int, write_stmt: int, write_block: int, depth: int) -> int {
    if rvalue_id < 0 or depth > 32 {
        give back 2
    }
    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot found = false
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            pilot segment = v4_borrowck_aggregate_child_projection_segment(mir_id, body_id, rvalue_id, child_id)
            if segment == v4_borrowck_holder_projection_none {
                give back 2
            }
            pilot child_holder = projected_holder
            if segment != v4_borrowck_holder_projection_whole {
                child_holder = child_holder + segment
            }
            pilot child_state = v4_borrowck_aggregate_source_liveness_at_write(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id), loan_text, child_holder, holder_stmt, write_stmt, write_block, depth + 1)
            if child_state == 2 {
                give back 2
            }
            if child_state == 1 {
                found = true
            }
            child_id += 1
        }
        if found { give back 1 }
        give back 0
    }
    pilot nested = v4_borrowck_rvalue_unique_holder_projection(mir_id, body_id, rvalue_id, loan_text)
    if nested == v4_borrowck_holder_projection_none {
        give back 0
    }
    pilot holder = projected_holder
    if nested != v4_borrowck_holder_projection_whole {
        holder = holder + nested
    }
    if v4_borrowck_holder_used_at_or_after_write(mir_id, body_id, holder, holder_stmt, write_stmt, write_block) {
        give back 2
    }
    give back 1
}

task v4_borrowck_explicit_loan_live_at_write(mir_id: int, body_id: int, loan_stmt: int, loan_text: word, write_stmt: int, write_block: int) -> bool {
    pilot repeat_live = v4_borrowck_repeat_fill_loan_live_at_write(mir_id, body_id, loan_stmt, loan_text, write_stmt, write_block)
    if repeat_live >= 0 { give back repeat_live == 1 }
    pilot loan_rvalue = v4_mir_stmt_rvalue(mir_id, body_id, loan_stmt)
    if loan_rvalue >= 0 {
        pilot loan_kind = v4_mir_rvalue_kind(mir_id, body_id, loan_rvalue)
        pilot projections = array_new()
        if v4_mir_rvalue_is_aggregate_kind(loan_kind) or loan_kind == v4_mir_rvalue_call { v4_borrowck_collect_rvalue_holder_projections(mir_id, body_id, loan_rvalue, loan_text, "", projections) }
        pilot projection_count = array_len(projections)
        pilot loan_place = v4_mir_stmt_place(mir_id, body_id, loan_stmt)
        if projection_count > 1 and v4_borrowck_place_is_local_storage_projection(mir_id, body_id, loan_place) {
            pilot base_holder = v4_mir_place_text(mir_id, body_id, loan_place)
            pilot any_live = false
            pilot projection_id = 0
            repeat until projection_id >= projection_count {
                pilot projection: word = array_get(projections, projection_id)
                pilot projected_holder = base_holder
                if projection != v4_borrowck_holder_projection_whole {
                    projected_holder = base_holder + projection
                }
                if v4_borrowck_holder_used_at_or_after_write(mir_id, body_id, projected_holder, loan_stmt, write_stmt, write_block) {
                    any_live = true
                }
                projection_id += 1
            }
            array_release(projections)
            give back any_live
        }
        array_release(projections)
    }
    pilot holder = v4_borrowck_explicit_loan_holder(mir_id, body_id, loan_stmt, loan_text)
    if holder == "" {
        give back true
    }
    if holder == "@temporary" {
        give back false
    }
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, loan_stmt)
    if rvalue_id >= 0 and v4_mir_rvalue_is_aggregate_kind(v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)) {
        pilot loan_place = v4_mir_stmt_place(mir_id, body_id, loan_stmt)
        if v4_borrowck_place_is_local_storage_projection(mir_id, body_id, loan_place) {
            pilot aggregate_state = v4_borrowck_aggregate_source_liveness_at_write(mir_id, body_id, rvalue_id, loan_text, v4_mir_place_text(mir_id, body_id, loan_place), loan_stmt, write_stmt, write_block, 0)
            if aggregate_state > 0 {
                give back aggregate_state == 2
            }
        }
    }
    if v4_borrowck_call_direct_mut_lends_source(mir_id, body_id, rvalue_id, loan_text) {
        -- Aggregate loan extraction/drop facts do not exist yet, so rebind is the release point.
        give back v4_borrowck_hidden_holder_reaches_access(mir_id, body_id, holder, loan_stmt, write_stmt, write_block)
    }
    give back v4_borrowck_holder_used_at_or_after_write(mir_id, body_id, holder, loan_stmt, write_stmt, write_block)
}

task v4_borrowck_explicit_loan_live_at_move(mir_id: int, body_id: int, loan_stmt: int, loan_text: word, move_stmt: int, move_block: int) -> bool {
    give back v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, loan_stmt, loan_text, move_stmt, move_block)
}

task v4_borrowck_collect_call_transfer_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int, block_id: int, call_rvalue: int) -> void {
    pilot arg_id = 0
    pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, call_rvalue)
    repeat until arg_id >= arg_count {
        pilot arg_rvalue = v4_mir_rvalue_call_arg(mir_id, body_id, call_rvalue, arg_id)
        if arg_rvalue >= 0 {
            v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, arg_rvalue)
        }
        arg_id += 1
    }
}

task v4_borrowck_collect_call_callee_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int, block_id: int, callee_rvalue: int) -> void {
    if callee_rvalue < 0 {
        give back
    }

    pilot callee_ty = v4_mir_rvalue_ty(mir_id, body_id, callee_rvalue)
    if v4_ty_is_closure_type(callee_ty) {
        pilot closure_contract = v4_ty_closure_doctrine(callee_ty)
        if closure_contract == v4_ty_closure_one_shot {
            v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, callee_rvalue)
            give back
        }
        if closure_contract == v4_ty_closure_mut_callable {
            v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_path_loan_mut, v4_mir_rvalue_text(mir_id, body_id, callee_rvalue), stmt_id, block_id)
            give back
        }
    }

    v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, callee_rvalue)
}

task v4_borrowck_capture_path_kind(rvalue_kind: word) -> word {
    if rvalue_kind == v4_mir_rvalue_capture_borrow_mut {
        give back v4_borrowck_path_loan_mut
    }
    if rvalue_kind == v4_mir_rvalue_capture_borrow {
        give back v4_borrowck_path_loan
    }
    if rvalue_kind == v4_mir_rvalue_capture_copy {
        give back v4_borrowck_path_copy
    }
    give back ""
}

task v4_borrowck_collect_transfer_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int, block_id: int, rvalue_id: int) -> void {
    if rvalue_id < 0 {
        give back
    }

    pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot transfer_kind = v4_borrowck_rvalue_transfer_kind(mir_id, body_id, rvalue_id)
    if transfer_kind != "" {
        v4_borrowck_add_path(borrow_id, result_id, transfer_kind, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_capture_borrow or rvalue_kind == v4_mir_rvalue_capture_borrow_mut {
        v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_capture_path_kind(rvalue_kind), v4_mir_rvalue_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_lend or rvalue_kind == v4_mir_rvalue_lend_mut {
        v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_lend_path_kind(mir_id, body_id, rvalue_id), v4_borrowck_lend_source_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_binary or rvalue_kind == v4_mir_rvalue_or_else {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_unary or rvalue_kind == v4_mir_rvalue_check or rvalue_kind == v4_mir_rvalue_try {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_some or rvalue_kind == v4_mir_rvalue_ok or rvalue_kind == v4_mir_rvalue_err {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if v4_mir_rvalue_is_aggregate_kind(rvalue_kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id))
            child_id += 1
        }
    } else if rvalue_kind == v4_mir_rvalue_call {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        v4_borrowck_collect_call_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    }
}

task v4_borrowck_collect_read_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int, block_id: int, rvalue_id: int) -> void {
    if rvalue_id < 0 {
        give back
    }

    pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if rvalue_kind == v4_mir_rvalue_use_local or rvalue_kind == v4_mir_rvalue_use_place {
        v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_path_loan, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_capture_borrow or rvalue_kind == v4_mir_rvalue_capture_borrow_mut or rvalue_kind == v4_mir_rvalue_capture_copy or rvalue_kind == v4_mir_rvalue_capture_move {
        pilot capture_kind = v4_borrowck_capture_path_kind(rvalue_kind)
        if capture_kind == "" {
            capture_kind = v4_borrowck_rvalue_transfer_kind(mir_id, body_id, rvalue_id)
        }
        if capture_kind != "" {
            v4_borrowck_add_path(borrow_id, result_id, capture_kind, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
        }
    } else if rvalue_kind == v4_mir_rvalue_lend or rvalue_kind == v4_mir_rvalue_lend_mut {
        v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_lend_path_kind(mir_id, body_id, rvalue_id), v4_borrowck_lend_source_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_binary or rvalue_kind == v4_mir_rvalue_or_else {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_unary or rvalue_kind == v4_mir_rvalue_check or rvalue_kind == v4_mir_rvalue_try {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_some or rvalue_kind == v4_mir_rvalue_ok or rvalue_kind == v4_mir_rvalue_err {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if v4_mir_rvalue_is_aggregate_kind(rvalue_kind) {
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id))
            child_id += 1
        }
    } else if rvalue_kind == v4_mir_rvalue_call {
        v4_borrowck_collect_call_callee_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        v4_borrowck_collect_call_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    } else if rvalue_kind == v4_mir_rvalue_unknown {
        pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if v4_borrowck_rhs_needs_move(text) {
            v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_path_loan, text, stmt_id, block_id)
        }
    }
}

task v4_borrowck_path_exact_local(path_text: word, local_name: word) -> bool {
    if path_text == "" or local_name == "" {
        give back false
    }
    give back v4_borrowck_path_canon(path_text) == v4_borrowck_path_canon(local_name)
}

task v4_borrowck_stmt_has_exact_local_path(borrow_id: int, result_id: int, stmt_id: int, local_name: word, wanted_kind: word) -> bool {
    pilot path_id = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    repeat until path_id >= path_count {
        if v4_borrowck_path_stmt(borrow_id, result_id, path_id) == stmt_id {
            if v4_borrowck_path_kind(borrow_id, result_id, path_id) == wanted_kind {
                if v4_borrowck_path_exact_local(v4_borrowck_path_text(borrow_id, result_id, path_id), local_name) {
                    give back true
                }
            }
        }
        path_id += 1
    }
    give back false
}

task v4_borrowck_drop_state_index(block_id: int, initialized: bool) -> int {
    pilot state_index = block_id * 2
    if initialized {
        state_index += 1
    }
    give back state_index
}

task v4_borrowck_local_state_after_block(borrow_id: int, result_id: int, mir_id: int, body_id: int, local_name: word, block_id: int, initialized: bool) -> bool {
    pilot current_initialized = initialized
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_mir_stmt_block(mir_id, body_id, stmt_id) == block_id {
            if v4_borrowck_stmt_has_exact_local_path(borrow_id, result_id, stmt_id, local_name, v4_borrowck_path_move) {
                current_initialized = false
            }
            if v4_borrowck_stmt_has_exact_local_path(borrow_id, result_id, stmt_id, local_name, v4_borrowck_path_write) {
                current_initialized = true
            }
        }
        stmt_id += 1
    }
    give back current_initialized
}

task v4_borrowck_enqueue_drop_state(seen: int, blocks: int, states: int, block_count: int, block_id: int, initialized: bool) -> void {
    if block_id < 0 or block_id >= block_count {
        give back
    }
    if v4_borrowck_mark_seen_index(seen, v4_borrowck_drop_state_index(block_id, initialized)) {
        array_push(blocks, word_from_int(block_id))
        array_push(states, word_from_bool(initialized))
    }
}

task v4_borrowck_local_initially_initialized(mir_id: int, body_id: int, local_name: word) -> bool {
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    if sig_id < 0 {
        give back false
    }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_ty_signature_param_index_for_name(ty_id, sig_id, local_name) >= 0
}

task v4_borrowck_local_moved_without_reinit_linear(borrow_id: int, result_id: int, mir_id: int, body_id: int, local_name: word) -> bool {
    if v4_mir_body_block_count(mir_id, body_id) != 1 {
        give back false
    }

    pilot initialized = v4_borrowck_local_initially_initialized(mir_id, body_id, local_name)
    pilot stmt_id = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_id >= stmt_count {
        if v4_borrowck_stmt_has_exact_local_path(borrow_id, result_id, stmt_id, local_name, v4_borrowck_path_move) {
            initialized = false
        }
        if v4_borrowck_stmt_has_exact_local_path(borrow_id, result_id, stmt_id, local_name, v4_borrowck_path_write) {
            initialized = true
        }
        stmt_id += 1
    }
    give back not initialized
}

task v4_borrowck_local_moved_without_reinit(borrow_id: int, result_id: int, mir_id: int, body_id: int, local_name: word) -> bool {
    if v4_mir_body_block_count(mir_id, body_id) == 1 {
        give back v4_borrowck_local_moved_without_reinit_linear(borrow_id, result_id, mir_id, body_id, local_name)
    }
    give back not v4_borrowck_local_has_exit_state(borrow_id, result_id, mir_id, body_id, local_name, true)
}

task v4_borrowck_local_has_exit_state(borrow_id: int, result_id: int, mir_id: int, body_id: int, local_name: word, wanted_initialized: bool) -> bool {
    pilot block_count = v4_mir_body_block_count(mir_id, body_id)
    pilot seen = array_new()
    pilot pending_blocks = array_new()
    pilot pending_states = array_new()
    pilot initially_initialized = v4_borrowck_local_initially_initialized(mir_id, body_id, local_name)
    v4_borrowck_enqueue_drop_state(seen, pending_blocks, pending_states, block_count, 0, initially_initialized)

    pilot found = false
    pilot pending_id = 0
    repeat until pending_id >= array_len(pending_blocks) or found {
        pilot block_id = word_to_int(array_get(pending_blocks, pending_id))
        pilot initialized_text: word = array_get(pending_states, pending_id)
        pilot initialized: bool = initialized_text == "true"
        pilot block_record = v4_mir_body_block(mir_id, body_id, block_id)
        pilot terminator = v4_mir_block_terminator(block_record)
        pilot current_initialized = v4_borrowck_local_state_after_block(borrow_id, result_id, mir_id, body_id, local_name, block_id, initialized)

        if terminator == v4_mir_term_goto {
            v4_borrowck_enqueue_drop_state(seen, pending_blocks, pending_states, block_count, v4_mir_block_target(block_record), current_initialized)
        } else if terminator == v4_mir_term_if {
            v4_borrowck_enqueue_drop_state(seen, pending_blocks, pending_states, block_count, v4_mir_block_target(block_record), current_initialized)
            v4_borrowck_enqueue_drop_state(seen, pending_blocks, pending_states, block_count, v4_mir_block_else_target(block_record), current_initialized)
        } else if terminator != v4_mir_term_unreachable {
            if current_initialized == wanted_initialized {
                found = true
            }
        }
        pending_id += 1
    }

    array_release(pending_states)
    array_release(pending_blocks)
    array_release(seen)
    give back found
}

task v4_borrowck_local_moved_on_any_exit(borrow_id: int, result_id: int, mir_id: int, body_id: int, local_name: word) -> bool {
    give back v4_borrowck_local_has_exit_state(borrow_id, result_id, mir_id, body_id, local_name, false)
}

task v4_borrowck_collect_drop_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> void {
    pilot local_count = v4_mir_body_local_count(mir_id, body_id)
    pilot local_idx = local_count - 1
    repeat until local_idx < 0 {
        pilot local_mode = v4_mir_local_mode(mir_id, body_id, local_idx)
        pilot local_ty = v4_mir_local_ty(mir_id, body_id, local_idx)
        pilot local_name = v4_mir_local_name(mir_id, body_id, local_idx)
        if local_mode != v4_ty_param_mode_lend and local_mode != v4_ty_param_mode_lend_mut and not v4_ty_is_lend_type(local_ty) {
            if not v4_borrowck_local_moved_without_reinit(borrow_id, result_id, mir_id, body_id, local_name) {
                pilot drop_kind = v4_borrowck_path_drop
                if v4_borrowck_local_moved_on_any_exit(borrow_id, result_id, mir_id, body_id, local_name) {
                    drop_kind = v4_borrowck_path_drop_if
                }
                v4_borrowck_add_path(borrow_id, result_id, drop_kind, local_name, 0 - 1, 0 - 1)
            }
        }
        local_idx -= 1
    }
}

task v4_borrowck_collect_stmt_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int) -> void {
    pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
    pilot block_id = v4_mir_stmt_block(mir_id, body_id, stmt_id)
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)

    if stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign {
        v4_borrowck_add_place_path(borrow_id, result_id, mir_id, body_id, place_id, v4_borrowck_path_write, stmt_id, block_id)
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    } else if stmt_kind == v4_mir_stmt_return {
        v4_borrowck_add_place_path(borrow_id, result_id, mir_id, body_id, place_id, v4_borrowck_path_return, stmt_id, block_id)
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    } else if stmt_kind == v4_mir_stmt_branch or stmt_kind == v4_mir_stmt_loop or stmt_kind == v4_mir_stmt_expr {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    }
}

task v4_borrowck_collect_body_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> void {
    pilot stmt_idx = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_idx >= stmt_count {
        v4_borrowck_collect_stmt_paths(borrow_id, result_id, mir_id, body_id, stmt_idx)
        stmt_idx += 1
    }
    v4_borrowck_collect_drop_paths(borrow_id, result_id, mir_id, body_id)
}

task v4_borrowck_check_mutable_exclusivity(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot write_idx = 0
    repeat until write_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, write_idx) == v4_borrowck_path_write {
            pilot write_stmt = v4_borrowck_path_stmt(borrow_id, result_id, write_idx)
            pilot write_block = v4_borrowck_path_block(borrow_id, result_id, write_idx)
            pilot write_text = v4_borrowck_path_text(borrow_id, result_id, write_idx)
            pilot loan_idx = 0
            repeat until loan_idx >= path_count {
                if v4_borrowck_path_is_loan_kind(v4_borrowck_path_kind(borrow_id, result_id, loan_idx)) {
                    pilot loan_stmt = v4_borrowck_path_stmt(borrow_id, result_id, loan_idx)
                    pilot loan_block = v4_borrowck_path_block(borrow_id, result_id, loan_idx)
                    pilot loan_text = v4_borrowck_path_text(borrow_id, result_id, loan_idx)
                    pilot loan_conflicts = false
                    pilot help = ""
                    if loan_block == write_block and loan_stmt >= 0 and write_stmt >= 0 and loan_stmt < write_stmt {
                        if v4_borrowck_paths_overlap(loan_text, write_text) {
                            if v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, loan_stmt, loan_text, write_stmt, write_block) {
                                loan_conflicts = true
                                help = v4_borrowck_mutable_conflict_help(loan_text, loan_stmt, write_block, write_text, write_stmt)
                            }
                        }
                    } else if loan_stmt >= 0 and write_stmt >= 0 and loan_block >= 0 and write_block >= 0 and loan_block != write_block {
                        pilot loan_spans = v4_borrowck_loan_spans_successors(mir_id, body_id, loan_stmt)
                        if v4_borrowck_explicit_loan_holder(mir_id, body_id, loan_stmt, loan_text) != "" {
                            loan_spans = true
                        }
                        if loan_spans {
                            if v4_borrowck_block_reaches(mir_id, body_id, loan_block, write_block) {
                                if v4_borrowck_paths_overlap(loan_text, write_text) {
                                    if v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, loan_stmt, loan_text, write_stmt, write_block) {
                                        loan_conflicts = true
                                        help = v4_borrowck_cross_block_conflict_help(loan_text, loan_stmt, loan_block, write_text, write_stmt, write_block)
                                    }
                                }
                            }
                        }
                    }
                    if loan_conflicts {
                        pilot stmt_span = v4_borrowck_write_diag_span(mir_id, body_id, write_stmt)
                        pilot message = v4_borrowck_mutable_conflict_message(loan_block, write_block)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, message, help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                        loan_idx = path_count
                    }
                }
                loan_idx += 1
            }
        }
        write_idx += 1
    }
    give back conflicts
}

task v4_borrowck_exclusive_loan_help(active_text: word, active_stmt: int, active_block: int, new_text: word, new_stmt: int, new_block: int) -> word {
    pilot active_canon = v4_borrowck_path_canon(active_text)
    pilot new_canon = v4_borrowck_path_canon(new_text)
    pilot out = active_canon + " is already on loan in block " + word_from_int(active_block)
    out = out + " from statement " + word_from_int(active_stmt)
    if active_block != new_block {
        out = out + " and remains live into block " + word_from_int(new_block)
    }
    out = out + ", so statement " + word_from_int(new_stmt)
    out = out + " cannot grant an overlapping exclusive lend of " + new_canon
    give back out
}

task v4_borrowck_exclusive_loan_message(active_block: int, new_block: int) -> word {
    if active_block == new_block {
        give back "Meiya refuses overlapping mutable lends"
    }
    give back "Meiya carries an exclusive lend across another loan boundary"
}

task v4_borrowck_explicit_loan_reaches_access(mir_id: int, body_id: int, active_stmt: int, active_block: int, active_text: word, new_stmt: int, new_block: int, new_text: word) -> bool {
    if active_stmt < 0 or new_stmt < 0 or not v4_borrowck_paths_overlap(active_text, new_text) {
        give back false
    }
    if v4_borrowck_explicit_loan_holder(mir_id, body_id, active_stmt, active_text) == "" {
        give back false
    }
    if active_block == new_block {
        if active_stmt == new_stmt {
            give back true
        }
        if active_stmt < new_stmt or v4_borrowck_block_can_cycle(mir_id, body_id, active_block) {
            give back v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, active_stmt, active_text, new_stmt, new_block)
        }
        give back false
    }
    if active_block >= 0 and new_block >= 0 and v4_borrowck_block_reaches(mir_id, body_id, active_block, new_block) {
        give back v4_borrowck_explicit_loan_live_at_write(mir_id, body_id, active_stmt, active_text, new_stmt, new_block)
    }
    give back false
}

task v4_borrowck_check_exclusive_loans(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot first_idx = 0
    repeat until first_idx >= path_count {
        pilot first_kind = v4_borrowck_path_kind(borrow_id, result_id, first_idx)
        if v4_borrowck_path_is_loan_kind(first_kind) {
            pilot second_idx = first_idx + 1
            repeat until second_idx >= path_count {
                pilot second_kind = v4_borrowck_path_kind(borrow_id, result_id, second_idx)
                if v4_borrowck_path_is_loan_kind(second_kind) and (first_kind == v4_borrowck_path_loan_mut or second_kind == v4_borrowck_path_loan_mut) {
                    pilot first_stmt = v4_borrowck_path_stmt(borrow_id, result_id, first_idx)
                    pilot first_block = v4_borrowck_path_block(borrow_id, result_id, first_idx)
                    pilot first_text = v4_borrowck_path_text(borrow_id, result_id, first_idx)
                    pilot second_stmt = v4_borrowck_path_stmt(borrow_id, result_id, second_idx)
                    pilot second_block = v4_borrowck_path_block(borrow_id, result_id, second_idx)
                    pilot second_text = v4_borrowck_path_text(borrow_id, result_id, second_idx)
                    pilot first_holder = v4_borrowck_explicit_loan_holder(mir_id, body_id, first_stmt, first_text)
                    pilot second_holder = v4_borrowck_explicit_loan_holder(mir_id, body_id, second_stmt, second_text)
                    if first_holder != "" and second_holder != "" {
                        pilot conflicts_at_second = v4_borrowck_explicit_loan_reaches_access(mir_id, body_id, first_stmt, first_block, first_text, second_stmt, second_block, second_text)
                        pilot conflicts_at_first = false
                        if not conflicts_at_second {
                            conflicts_at_first = v4_borrowck_explicit_loan_reaches_access(mir_id, body_id, second_stmt, second_block, second_text, first_stmt, first_block, first_text)
                        }
                        if conflicts_at_second or conflicts_at_first {
                            pilot active_text = first_text
                            pilot active_stmt = first_stmt
                            pilot active_block = first_block
                            pilot new_text = second_text
                            pilot new_stmt = second_stmt
                            pilot new_block = second_block
                            if conflicts_at_first {
                                active_text = second_text
                                active_stmt = second_stmt
                                active_block = second_block
                                new_text = first_text
                                new_stmt = first_stmt
                                new_block = first_block
                            }
                            pilot stmt_span = v4_borrowck_use_diag_span(mir_id, body_id, new_stmt)
                            pilot message = v4_borrowck_exclusive_loan_message(active_block, new_block)
                            pilot help = v4_borrowck_exclusive_loan_help(active_text, active_stmt, active_block, new_text, new_stmt, new_block)
                            v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, message, help))
                            v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                            conflicts += 1
                            second_idx = path_count
                        }
                    }
                }
                second_idx += 1
            }
        }
        first_idx += 1
    }
    give back conflicts
}

task v4_borrowck_exclusive_read_help(loan_text: word, loan_stmt: int, loan_block: int, read_text: word, read_stmt: int, read_block: int) -> word {
    pilot loan_canon = v4_borrowck_path_canon(loan_text)
    pilot read_canon = v4_borrowck_path_canon(read_text)
    pilot out = loan_canon + " is exclusively borrowed in block " + word_from_int(loan_block)
    out = out + " from statement " + word_from_int(loan_stmt)
    if loan_block != read_block {
        out = out + " and remains live into block " + word_from_int(read_block)
    }
    out = out + ", so statement " + word_from_int(read_stmt)
    out = out + " cannot observe " + read_canon + " through its owner"
    give back out
}

task v4_borrowck_exclusive_read_message(loan_block: int, read_block: int) -> word {
    if loan_block == read_block {
        give back "Meiya refuses observation through an exclusive lend"
    }
    give back "Meiya carries an exclusive lend across an observation boundary"
}

task v4_borrowck_path_is_owner_observation(path_kind: word) -> bool {
    give back path_kind == v4_borrowck_path_loan or path_kind == v4_borrowck_path_copy
}

task v4_borrowck_check_mutable_loan_reads(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot loan_idx = 0
    repeat until loan_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, loan_idx) == v4_borrowck_path_loan_mut {
            pilot loan_stmt = v4_borrowck_path_stmt(borrow_id, result_id, loan_idx)
            pilot loan_block = v4_borrowck_path_block(borrow_id, result_id, loan_idx)
            pilot loan_text = v4_borrowck_path_text(borrow_id, result_id, loan_idx)
            if v4_borrowck_explicit_loan_holder(mir_id, body_id, loan_stmt, loan_text) != "" {
                pilot read_idx = 0
                repeat until read_idx >= path_count {
                    pilot read_kind = v4_borrowck_path_kind(borrow_id, result_id, read_idx)
                    if read_idx != loan_idx and v4_borrowck_path_is_owner_observation(read_kind) {
                        pilot read_stmt = v4_borrowck_path_stmt(borrow_id, result_id, read_idx)
                        pilot read_block = v4_borrowck_path_block(borrow_id, result_id, read_idx)
                        pilot read_text = v4_borrowck_path_text(borrow_id, result_id, read_idx)
                        pilot read_is_explicit_loan = false
                        if read_kind == v4_borrowck_path_loan {
                            read_is_explicit_loan = v4_borrowck_explicit_loan_holder(mir_id, body_id, read_stmt, read_text) != ""
                        }
                        if not read_is_explicit_loan and v4_borrowck_explicit_loan_reaches_access(mir_id, body_id, loan_stmt, loan_block, loan_text, read_stmt, read_block, read_text) {
                            pilot stmt_span = v4_borrowck_use_diag_span(mir_id, body_id, read_stmt)
                            pilot message = v4_borrowck_exclusive_read_message(loan_block, read_block)
                            pilot help = v4_borrowck_exclusive_read_help(loan_text, loan_stmt, loan_block, read_text, read_stmt, read_block)
                            v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, message, help))
                            v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                            conflicts += 1
                            read_idx = path_count
                        }
                    }
                    read_idx += 1
                }
            }
        }
        loan_idx += 1
    }
    give back conflicts
}

task v4_borrowck_loan_move_conflict_help(loan_text: word, loan_stmt: int, loan_block: int, move_text: word, move_stmt: int, move_block: int) -> word {
    pilot loan_canon = v4_borrowck_path_canon(loan_text)
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot out = loan_canon + " is borrowed in block " + word_from_int(loan_block)
    out = out + " from statement " + word_from_int(loan_stmt)
    if loan_block != move_block {
        out = out + " and remains live into block " + word_from_int(move_block)
    }
    out = out + ", so statement " + word_from_int(move_stmt)
    out = out + " cannot move " + move_canon + " while its lend is live"
    give back out
}

task v4_borrowck_loan_move_conflict_message(loan_block: int, move_block: int) -> word {
    if loan_block == move_block {
        give back "Meiya refuses this move while the value is borrowed"
    }
    give back "Meiya carries this loan across a move boundary"
}

task v4_borrowck_check_explicit_loan_moves(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot move_idx = 0
    repeat until move_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, move_idx) == v4_borrowck_path_move {
            pilot move_stmt = v4_borrowck_path_stmt(borrow_id, result_id, move_idx)
            pilot move_block = v4_borrowck_path_block(borrow_id, result_id, move_idx)
            pilot move_text = v4_borrowck_path_text(borrow_id, result_id, move_idx)
            pilot loan_idx = 0
            repeat until loan_idx >= path_count {
                if v4_borrowck_path_is_loan_kind(v4_borrowck_path_kind(borrow_id, result_id, loan_idx)) {
                    pilot loan_stmt = v4_borrowck_path_stmt(borrow_id, result_id, loan_idx)
                    pilot loan_block = v4_borrowck_path_block(borrow_id, result_id, loan_idx)
                    pilot loan_text = v4_borrowck_path_text(borrow_id, result_id, loan_idx)
                    pilot holder = v4_borrowck_explicit_loan_holder(mir_id, body_id, loan_stmt, loan_text)
                    pilot loan_conflicts = false
                    if holder != "" and loan_stmt >= 0 and move_stmt >= 0 and v4_borrowck_paths_overlap(loan_text, move_text) {
                        -- A later loan statement can still be live at the next loop iteration.
                        if loan_block == move_block {
                            if loan_stmt == move_stmt {
                                loan_conflicts = true
                            } else if loan_stmt < move_stmt or v4_borrowck_block_can_cycle(mir_id, body_id, move_block) {
                                loan_conflicts = v4_borrowck_explicit_loan_live_at_move(mir_id, body_id, loan_stmt, loan_text, move_stmt, move_block)
                            }
                        } else if loan_block != move_block and loan_block >= 0 and move_block >= 0 {
                            if v4_borrowck_block_reaches(mir_id, body_id, loan_block, move_block) {
                                loan_conflicts = v4_borrowck_explicit_loan_live_at_move(mir_id, body_id, loan_stmt, loan_text, move_stmt, move_block)
                            }
                        }
                    }
                    if loan_conflicts {
                        pilot stmt_span = v4_borrowck_use_diag_span(mir_id, body_id, move_stmt)
                        pilot message = v4_borrowck_loan_move_conflict_message(loan_block, move_block)
                        pilot help = v4_borrowck_loan_move_conflict_help(loan_text, loan_stmt, loan_block, move_text, move_stmt, move_block)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, message, help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                        loan_idx = path_count
                    }
                }
                loan_idx += 1
            }
        }
        move_idx += 1
    }
    give back conflicts
}

task v4_borrowck_check_partial_moves(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot move_idx = 0
    repeat until move_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, move_idx) == v4_borrowck_path_move {
            pilot move_stmt = v4_borrowck_path_stmt(borrow_id, result_id, move_idx)
            pilot move_block = v4_borrowck_path_block(borrow_id, result_id, move_idx)
            pilot move_text = v4_borrowck_path_text(borrow_id, result_id, move_idx)
            pilot use_idx = 0
            repeat until use_idx >= path_count {
                if use_idx != move_idx and v4_borrowck_path_is_move_use_kind(v4_borrowck_path_kind(borrow_id, result_id, use_idx)) {
                    pilot use_stmt = v4_borrowck_path_stmt(borrow_id, result_id, use_idx)
                    pilot use_block = v4_borrowck_path_block(borrow_id, result_id, use_idx)
                    pilot use_text = v4_borrowck_path_text(borrow_id, result_id, use_idx)
                    pilot move_conflicts = false
                    pilot help = ""
                    if move_stmt >= 0 and use_stmt >= 0 and move_block == use_block and move_stmt < use_stmt {
                        if not v4_borrowck_move_repaired_before_use(borrow_id, result_id, mir_id, body_id, move_stmt, move_block, move_text, use_stmt, use_block) {
                            if v4_borrowck_paths_overlap(move_text, use_text) {
                                move_conflicts = true
                                help = v4_borrowck_partial_move_conflict_help(move_text, move_stmt, use_text, use_stmt)
                            }
                        }
                    } else if move_stmt >= 0 and use_stmt >= 0 and move_block >= 0 and use_block >= 0 {
                        -- Earlier same-block uses are only after the move through a loop backedge.
                        if move_block != use_block or v4_borrowck_block_can_cycle(mir_id, body_id, move_block) {
                            if not v4_borrowck_move_repaired_before_use(borrow_id, result_id, mir_id, body_id, move_stmt, move_block, move_text, use_stmt, use_block) {
                                if v4_borrowck_block_reaches(mir_id, body_id, move_block, use_block) {
                                    if v4_borrowck_paths_overlap(move_text, use_text) {
                                        move_conflicts = true
                                        help = v4_borrowck_cross_block_partial_move_help(move_text, move_stmt, move_block, use_text, use_stmt, use_block)
                                    }
                                }
                            }
                        }
                    }
                    if move_conflicts {
                        pilot stmt_span = v4_borrowck_use_diag_span(mir_id, body_id, use_stmt)
                        pilot message = v4_borrowck_partial_move_conflict_message(move_block, use_block)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, message, help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                        use_idx = path_count
                    }
                }
                use_idx += 1
            }
        }
        move_idx += 1
    }
    give back conflicts
}

task v4_borrowck_check_mir(file_id: int, mir_id: int) -> int {
    v4_borrowck_init()
    v4_borrowck_provenance_scratch_reset()
    pilot borrow_id = v4_borrowck_file_new(file_id, mir_id)
    v4_borrowck_copy_mir_diags(borrow_id, mir_id)

    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        pilot def_id = v4_mir_body_def(mir_id, body_idx)
        pilot body_name = v4_mir_body_name(mir_id, body_idx)
        pilot block_count = v4_mir_body_block_count(mir_id, body_idx)
        pilot status = v4_borrowck_clean
        if block_count == 0 {
            status = v4_borrowck_blocked
            v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, V4_NO_SPAN, "MIR body has no blocks", body_name))
        }
        pilot result_id = v4_borrowck_add_result(borrow_id, def_id, body_name, status, 0, 0, 0)
        v4_borrowck_collect_body_paths(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_lend_contracts(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_returned_lends(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_shared_guard_escapes(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_stored_call_lends(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_dynamic_lend_storage(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_fixed_hidden_closure_storage(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_repeated_mut_lend_aggregates(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_mutable_exclusivity(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_exclusive_loans(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_mutable_loan_reads(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_explicit_loan_moves(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_partial_moves(borrow_id, result_id, mir_id, body_idx)
        pilot loan_count = v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_loan)
        loan_count = loan_count + v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_loan_mut)
        pilot move_count = v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_move)
        pilot drop_count = v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_drop)
        drop_count = drop_count + v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_drop_if)
        v4_borrowck_set_result_counts(borrow_id, result_id, loan_count, move_count, drop_count)
        body_idx += 1
    }

    v4_borrowck_store_provenance_telemetry(borrow_id)
    give back borrow_id
}

task v4_borrowck_lookup_result(borrow_id: int, def_id: word) -> int {
    pilot result_idx = 0
    pilot result_count = v4_borrowck_result_count(borrow_id)
    repeat until result_idx >= result_count {
        if v4_borrowck_result_def(borrow_id, result_idx) == def_id {
            give back result_idx
        }
        result_idx += 1
    }
    give back 0 - 1
}

task v4_borrowck_summary(borrow_id: int) -> word {
    pilot summary = "borrowck-ok borrow=" + word_from_int(borrow_id)
    summary = summary + " results=" + word_from_int(v4_borrowck_result_count(borrow_id))
    summary = summary + " paths=" + word_from_int(v4_borrowck_path_count(borrow_id))
    summary = summary + " diagnostics=" + word_from_int(v4_borrowck_diag_count(borrow_id))
    give back summary
}

task v4_borrowck_snapshot_escape(value: word) -> word {
    give back v4_mir_snapshot_escape(value)
}

task v4_borrowck_snapshot_unescape(value: word) -> word {
    give back v4_mir_snapshot_unescape(value)
}

task v4_borrowck_snapshot_line_count(payload: word) -> int {
    give back v4_mir_snapshot_line_count(payload)
}

task v4_borrowck_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_mir_snapshot_line(payload, wanted)
}

task v4_borrowck_snapshot_field_count(line: word) -> int {
    give back v4_mir_snapshot_field_count(line)
}

task v4_borrowck_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_mir_snapshot_field_raw(line, wanted)
}

task v4_borrowck_snapshot_field(line: word, wanted: int) -> word {
    give back v4_mir_snapshot_field(line, wanted)
}

task v4_borrowck_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_mir_snapshot_key_value(line, wanted_key)
}

task v4_borrowck_snapshot_format_supported(format: word) -> bool {
    give back format == v4_borrowck_snapshot_format or format == v4_borrowck_snapshot_legacy_format
}

task v4_borrowck_snapshot_payload_format(payload: word) -> word {
    pilot line_id = 0
    pilot line_count = v4_borrowck_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_borrowck_snapshot_line(payload, line_id)
        if v4_borrowck_snapshot_field_raw(line, 0) == "borrowck-snapshot" {
            give back v4_borrowck_snapshot_key_value(line, "format")
        }
        line_id += 1
    }
    give back ""
}

task v4_borrowck_snapshot_result_total() -> int {
    v4_borrowck_init()
    pilot total = 0
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        total += v4_borrowck_result_count(borrow_id)
        borrow_id += 1
    }
    give back total
}

task v4_borrowck_snapshot_path_total() -> int {
    v4_borrowck_init()
    pilot total = 0
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        total += v4_borrowck_path_count(borrow_id)
        borrow_id += 1
    }
    give back total
}

task v4_borrowck_snapshot_diag_total() -> int {
    v4_borrowck_init()
    pilot total = 0
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        total += v4_borrowck_diag_count(borrow_id)
        borrow_id += 1
    }
    give back total
}

task v4_borrowck_snapshot_summary() -> word {
    pilot summary = "borrowck-snapshot"
    summary = summary + " format=" + v4_borrowck_snapshot_format
    summary = summary + " files=" + word_from_int(v4_borrowck_file_count())
    summary = summary + " results=" + word_from_int(v4_borrowck_snapshot_result_total())
    summary = summary + " paths=" + word_from_int(v4_borrowck_snapshot_path_total())
    summary = summary + " diagnostics=" + word_from_int(v4_borrowck_snapshot_diag_total())
    give back summary
}

task v4_borrowck_snapshot_header() -> word {
    pilot out = "borrowck-snapshot"
    out = out + "|format=" + v4_borrowck_snapshot_format
    out = out + "|files=" + word_from_int(v4_borrowck_file_count())
    out = out + "|results=" + word_from_int(v4_borrowck_snapshot_result_total())
    out = out + "|paths=" + word_from_int(v4_borrowck_snapshot_path_total())
    out = out + "|diagnostics=" + word_from_int(v4_borrowck_snapshot_diag_total())
    give back out
}

task v4_borrowck_snapshot_file_line(borrow_id: int) -> word {
    pilot out = "borrowck"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(v4_borrowck_file_id(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_mir_id(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_result_count(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_diag_count(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_provenance_fixed_point_rounds(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_provenance_fixed_point_limit(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_provenance_fixed_point_solve_count(borrow_id))
    out = out + "|" + word_from_bool(v4_borrowck_provenance_fixed_point_converged(borrow_id))
    out = out + "|" + word_from_bool(v4_borrowck_provenance_resource_exhausted(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_provenance_fixed_point_work_items(borrow_id))
    give back out
}

task v4_borrowck_snapshot_result_line(borrow_id: int, result_id: int) -> word {
    pilot out = "borrowck-result"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(result_id)
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_result_def(borrow_id, result_id))
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_result_name(borrow_id, result_id))
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_result_status(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_loans(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_moves(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_drops(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_path_count(borrow_id, result_id))
    give back out
}

task v4_borrowck_snapshot_path_line(borrow_id: int, result_id: int, path_id: int) -> word {
    pilot out = "borrowck-path"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(result_id)
    out = out + "|" + word_from_int(path_id)
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_path_kind(borrow_id, result_id, path_id))
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_path_text(borrow_id, result_id, path_id))
    out = out + "|" + word_from_int(v4_borrowck_path_stmt(borrow_id, result_id, path_id))
    out = out + "|" + word_from_int(v4_borrowck_path_block(borrow_id, result_id, path_id))
    give back out
}

task v4_borrowck_snapshot_diag_line(borrow_id: int, diag_id: int) -> word {
    pilot out = "borrowck-diag"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_diag(borrow_id, diag_id))
    give back out
}

task v4_borrowck_snapshot() -> word {
    v4_borrowck_init()
    pilot parts = array_new()
    array_push(parts, v4_borrowck_snapshot_header())
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        array_push(parts, "\n")
        array_push(parts, v4_borrowck_snapshot_file_line(borrow_id))

        pilot result_id = 0
        pilot result_count = v4_borrowck_result_count(borrow_id)
        repeat until result_id >= result_count {
            array_push(parts, "\n")
            array_push(parts, v4_borrowck_snapshot_result_line(borrow_id, result_id))

            pilot path_id = 0
            pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
            repeat until path_id >= path_count {
                array_push(parts, "\n")
                array_push(parts, v4_borrowck_snapshot_path_line(borrow_id, result_id, path_id))
                path_id += 1
            }
            result_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_borrowck_diag_count(borrow_id)
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_borrowck_snapshot_diag_line(borrow_id, diag_id))
            diag_id += 1
        }
        borrow_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_borrowck_snapshot_format)
    give back word_join(parts)
}

task v4_borrowck_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "borrowck-snapshot" { give back 6 }
    if kind == "borrowck" { give back 6 }
    if kind == "borrowck-result" { give back 10 }
    if kind == "borrowck-path" { give back 8 }
    if kind == "borrowck-diag" { give back 4 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_borrowck_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_borrowck_snapshot_field_raw(line, 0)
    pilot expected = v4_borrowck_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_borrowck_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_borrowck_snapshot_validate(payload: word) -> word {
    pilot lines = v4_borrowck_snapshot_line_count(payload)
    pilot files = 0
    pilot results = 0
    pilot paths = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = v4_borrowck_snapshot_payload_format(payload)

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_borrowck_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_borrowck_snapshot_field_raw(line, 0)
            if v4_borrowck_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "borrowck-snapshot" {
                saw_header += 1
                pilot header_format = v4_borrowck_snapshot_key_value(line, "format")
                if header_format != format or not v4_borrowck_snapshot_format_supported(format) {
                    malformed += 1
                }
            } else if kind == "borrowck" {
                files += 1
                if format == v4_borrowck_snapshot_format and v4_borrowck_snapshot_field_count(line) < 12 {
                    malformed += 1
                }
            } else if kind == "borrowck-result" {
                results += 1
            } else if kind == "borrowck-path" {
                paths += 1
            } else if kind == "borrowck-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_borrowck_snapshot_field(line, 1) != format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "borrowck-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " results=" + word_from_int(results)
    out = out + " paths=" + word_from_int(paths)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_borrowck_restore_file_slot(borrow_id: int, file_id: int, mir_id: int) -> int {
    v4_borrowck_init()
    repeat until array_len(v4_borrowck_files) > borrow_id {
        v4_borrowck_file_new(0, 0)
    }

    array_set(v4_borrowck_files, borrow_id, word_from_int(file_id))
    array_set(v4_borrowck_mirs, borrow_id, word_from_int(mir_id))
    array_set(v4_borrowck_body_defs, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_body_names, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_statuses, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_loan_counts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_move_counts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_drop_counts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_kinds, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_texts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_stmt_ids, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_block_ids, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_diags, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_fixed_point_rounds_by_file, borrow_id, "0")
    array_set(v4_borrowck_fixed_point_limits_by_file, borrow_id, "0")
    array_set(v4_borrowck_fixed_point_solves_by_file, borrow_id, "0")
    array_set(v4_borrowck_fixed_point_converged_by_file, borrow_id, "true")
    array_set(v4_borrowck_resource_exhausted_by_file, borrow_id, "false")
    array_set(v4_borrowck_fixed_point_work_items_by_file, borrow_id, "0")
    give back borrow_id
}

task v4_borrowck_restore_telemetry_slot(borrow_id: int, rounds: int, limit: int, solves: int, converged: bool, resource_exhausted: bool, work_items: int) -> int {
    if not v4_borrowck_file_exists(borrow_id) { give back 0 }
    array_set(v4_borrowck_fixed_point_rounds_by_file, borrow_id, word_from_int(rounds))
    array_set(v4_borrowck_fixed_point_limits_by_file, borrow_id, word_from_int(limit))
    array_set(v4_borrowck_fixed_point_solves_by_file, borrow_id, word_from_int(solves))
    array_set(v4_borrowck_fixed_point_converged_by_file, borrow_id, word_from_bool(converged))
    array_set(v4_borrowck_resource_exhausted_by_file, borrow_id, word_from_bool(resource_exhausted))
    array_set(v4_borrowck_fixed_point_work_items_by_file, borrow_id, word_from_int(work_items))
    give back 1
}

task v4_borrowck_restore_result_slot(borrow_id: int, result_id: int, def_id: word, body_name: word, status: word, loans: int, moves: int, drops: int) -> int {
    if v4_borrowck_file_exists(borrow_id) == false {
        give back 0
    }
    repeat until v4_borrowck_result_count(borrow_id) > result_id {
        v4_borrowck_add_result(borrow_id, "", "", v4_borrowck_clean, 0, 0, 0)
    }

    array_set(v4_borrowck_defs_handle(borrow_id), result_id, def_id)
    array_set(v4_borrowck_names_handle(borrow_id), result_id, body_name)
    array_set(v4_borrowck_statuses_handle(borrow_id), result_id, status)
    array_set(v4_borrowck_loans_handle(borrow_id), result_id, word_from_int(loans))
    array_set(v4_borrowck_moves_handle(borrow_id), result_id, word_from_int(moves))
    array_set(v4_borrowck_drops_handle(borrow_id), result_id, word_from_int(drops))
    array_set(v4_borrowck_path_kinds_index_handle(borrow_id), result_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_texts_index_handle(borrow_id), result_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_stmt_ids_index_handle(borrow_id), result_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_block_ids_index_handle(borrow_id), result_id, word_from_int(array_new()))
    give back 1
}

task v4_borrowck_result_slot_exists(borrow_id: int, result_id: int) -> bool {
    if v4_borrowck_file_exists(borrow_id) == false { give back false }
    if result_id < 0 { give back false }
    if result_id >= v4_borrowck_result_count(borrow_id) { give back false }
    give back true
}

task v4_borrowck_restore_path_slot(borrow_id: int, result_id: int, path_id: int, path_kind: word, path_text: word, stmt_id: int, block_id: int) -> int {
    if v4_borrowck_result_slot_exists(borrow_id, result_id) == false {
        give back 0
    }
    repeat until v4_borrowck_result_path_count(borrow_id, result_id) > path_id {
        array_push(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), "")
        array_push(v4_borrowck_result_path_texts_handle(borrow_id, result_id), "")
        array_push(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), word_from_int(0 - 1))
        array_push(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), word_from_int(0 - 1))
    }
    array_set(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), path_id, path_kind)
    array_set(v4_borrowck_result_path_texts_handle(borrow_id, result_id), path_id, path_text)
    array_set(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), path_id, word_from_int(stmt_id))
    array_set(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), path_id, word_from_int(block_id))
    give back 1
}

task v4_borrowck_restore_diag_slot(borrow_id: int, diag_id: int, diag: word) -> int {
    if v4_borrowck_file_exists(borrow_id) == false {
        give back 0
    }
    repeat until v4_borrowck_diag_count(borrow_id) > diag_id {
        array_push(v4_borrowck_diags_handle(borrow_id), "")
    }
    array_set(v4_borrowck_diags_handle(borrow_id), diag_id, diag)
    give back 1
}

task v4_borrowck_snapshot_restore_file_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot mir_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 3))
    v4_borrowck_restore_file_slot(borrow_id, file_id, mir_id)
    if v4_borrowck_snapshot_field_count(line) >= 12 {
        v4_borrowck_restore_telemetry_slot(borrow_id, word_to_int(v4_borrowck_snapshot_field_raw(line, 6)), word_to_int(v4_borrowck_snapshot_field_raw(line, 7)), word_to_int(v4_borrowck_snapshot_field_raw(line, 8)), v4_borrowck_snapshot_field_raw(line, 9) == "true", v4_borrowck_snapshot_field_raw(line, 10) == "true", word_to_int(v4_borrowck_snapshot_field_raw(line, 11)))
    }
    give back 1
}

task v4_borrowck_snapshot_restore_result_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck-result" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot result_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot def_id = v4_borrowck_snapshot_field(line, 3)
    pilot body_name = v4_borrowck_snapshot_field(line, 4)
    pilot status = v4_borrowck_snapshot_field(line, 5)
    pilot loans = word_to_int(v4_borrowck_snapshot_field_raw(line, 6))
    pilot moves = word_to_int(v4_borrowck_snapshot_field_raw(line, 7))
    pilot drops = word_to_int(v4_borrowck_snapshot_field_raw(line, 8))
    give back v4_borrowck_restore_result_slot(borrow_id, result_id, def_id, body_name, status, loans, moves, drops)
}

task v4_borrowck_snapshot_restore_path_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck-path" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot result_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot path_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 3))
    pilot path_kind = v4_borrowck_snapshot_field(line, 4)
    pilot path_text = v4_borrowck_snapshot_field(line, 5)
    pilot stmt_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 6))
    pilot block_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 7))
    give back v4_borrowck_restore_path_slot(borrow_id, result_id, path_id, path_kind, path_text, stmt_id, block_id)
}

task v4_borrowck_snapshot_restore_diag_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck-diag" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot diag = v4_borrowck_snapshot_field(line, 3)
    give back v4_borrowck_restore_diag_slot(borrow_id, diag_id, diag)
}

task v4_borrowck_snapshot_restore(payload: word) -> word {
    pilot validation = v4_borrowck_snapshot_validate(payload)
    if validation.starts_with("borrowck-snapshot-import ok=1") == false {
        give back "borrowck-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }
    v4_borrowck_provenance_scratch_reset()

    pilot restored_files = 0
    pilot restored_results = 0
    pilot restored_paths = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_borrowck_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_borrowck_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_borrowck_snapshot_field_raw(line, 0)
            if kind == "borrowck" {
                restored_files += v4_borrowck_snapshot_restore_file_line(line)
            } else if kind == "borrowck-result" {
                restored_results += v4_borrowck_snapshot_restore_result_line(line)
            } else if kind == "borrowck-path" {
                restored_paths += v4_borrowck_snapshot_restore_path_line(line)
            } else if kind == "borrowck-diag" {
                restored_diagnostics += v4_borrowck_snapshot_restore_diag_line(line)
            } else if kind != "borrowck-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "borrowck-snapshot-restore ok=1"
    out = out + " files=" + word_from_int(restored_files)
    out = out + " results=" + word_from_int(restored_results)
    out = out + " paths=" + word_from_int(restored_paths)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-files=" + word_from_int(v4_borrowck_file_count())
    give back out
}
