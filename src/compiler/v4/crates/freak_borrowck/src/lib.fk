    give back v4_borrowck_path_canon_cache_limit
}

task v4_borrowck_path_canon_value_cache_eviction_count() -> int {
    give back v4_borrowck_path_canon_value_cache_evictions
}

task v4_borrowck_provenance_scratch_store(handle: int, index: int, value: word) -> void {
    if index < 0 or index > array_len(handle) {
        give back
    }
    if index < array_len(handle) {
        array_set(handle, index, value)
    } else {
        array_push(handle, value)
    }
}

task v4_borrowck_provenance_scratch_store_integer(handle: int, index: int, value: int) -> void {
    v4_borrowck_provenance_scratch_store(handle, index, v4_borrowck_provenance_integer_word(value))
}

task v4_borrowck_provenance_scratch_reset() -> void {
    v4_borrowck_init()
    v4_borrowck_provenance_state_active = 0
    v4_borrowck_provenance_source_active = 0
    v4_borrowck_provenance_memo_active = 0
    v4_borrowck_provenance_solved_memo_active = 0
    v4_borrowck_provenance_memo_hits_value = 0
    v4_borrowck_provenance_dependency_active = 0
    v4_borrowck_provenance_worklist_active = 0
    v4_borrowck_provenance_worklist_cursor = 0
    v4_borrowck_provenance_current_memo = 0 - 1
    v4_borrowck_provenance_solver_active = false
    v4_borrowck_provenance_solver_dirty = false
    v4_borrowck_provenance_fixed_point_rounds_value = 0
    v4_borrowck_provenance_fixed_point_limit_value = 0
    v4_borrowck_provenance_fixed_point_solves_value = 0
    v4_borrowck_provenance_fixed_point_converged_value = true
    v4_borrowck_provenance_revision_value = 0
    v4_borrowck_provenance_resource_exhausted_value = false
    v4_borrowck_provenance_fixed_point_work_items_value = 0
    v4_borrowck_provenance_overflow_id = 0 - 1
    v4_borrowck_provenance_generation_value += 1
}

task v4_borrowck_provenance_scratch_generation() -> int {
    give back v4_borrowck_provenance_generation_value
}

