pilot v4_borrowck_copy_cache_values = 0
pilot v4_borrowck_copy_cache_limit_value = 128
pilot v4_borrowck_copy_cache_entry_count_value = 0
pilot v4_borrowck_copy_cache_cursor = 0
pilot v4_borrowck_copy_cache_evictions = 0
