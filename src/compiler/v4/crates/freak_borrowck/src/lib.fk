-- ===================================================================
-- freak_borrowck - Meiya borrow-check scaffold
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_mir.
-- This first Meiya layer creates borrow-check result records for MIR
-- bodies. Move paths, loans, linear drop flags, and first region-adjacent
-- checks now fill in these counters; full region solving still expands.

pilot v4_borrowck_clean = "clean"
pilot v4_borrowck_blocked = "blocked"

pilot v4_borrowck_path_write = "Write"
pilot v4_borrowck_path_copy = "Copy"
