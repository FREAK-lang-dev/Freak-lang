}

task v4_borrowck_result_path_count(borrow_id: int, result_id: int) -> int {
    give back array_len(v4_borrowck_result_path_kinds_handle(borrow_id, result_id))
}

task v4_borrowck_path_kind(borrow_id: int, result_id: int, path_id: int) -> word {
    give back array_get(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), path_id)
}

task v4_borrowck_path_text(borrow_id: int, result_id: int, path_id: int) -> word {
    give back array_get(v4_borrowck_result_path_texts_handle(borrow_id, result_id), path_id)
}

task v4_borrowck_path_stmt(borrow_id: int, result_id: int, path_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), path_id))
}

task v4_borrowck_path_block(borrow_id: int, result_id: int, path_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), path_id))
}

task v4_borrowck_diag(borrow_id: int, diag_id: int) -> word {
    give back array_get(v4_borrowck_diags_handle(borrow_id), diag_id)
}

task v4_borrowck_add_diag(borrow_id: int, diag: word) -> void {
    array_push(v4_borrowck_diags_handle(borrow_id), diag)
}

task v4_borrowck_copy_mir_diags(borrow_id: int, mir_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_mir_diag_count(mir_id)
    repeat until diag_idx >= diag_count {
        v4_borrowck_add_diag(borrow_id, v4_mir_diag(mir_id, diag_idx))
        diag_idx += 1
    }
}

task v4_borrowck_add_result(borrow_id: int, def_id: word, body_name: word, status: word, loans: int, moves: int, drops: int) -> int {
    pilot result_id = array_len(v4_borrowck_defs_handle(borrow_id))
    pilot path_kinds_handle = array_new()
    pilot path_texts_handle = array_new()
    pilot path_stmt_ids_handle = array_new()
    pilot path_block_ids_handle = array_new()
    array_push(v4_borrowck_defs_handle(borrow_id), def_id)
    array_push(v4_borrowck_names_handle(borrow_id), body_name)
    array_push(v4_borrowck_statuses_handle(borrow_id), status)
    array_push(v4_borrowck_loans_handle(borrow_id), word_from_int(loans))
    array_push(v4_borrowck_moves_handle(borrow_id), word_from_int(moves))
    array_push(v4_borrowck_drops_handle(borrow_id), word_from_int(drops))
    array_push(v4_borrowck_path_kinds_index_handle(borrow_id), word_from_int(path_kinds_handle))
    array_push(v4_borrowck_path_texts_index_handle(borrow_id), word_from_int(path_texts_handle))
    array_push(v4_borrowck_path_stmt_ids_index_handle(borrow_id), word_from_int(path_stmt_ids_handle))
    array_push(v4_borrowck_path_block_ids_index_handle(borrow_id), word_from_int(path_block_ids_handle))
    give back result_id
}

task v4_borrowck_set_result_counts(borrow_id: int, result_id: int, loans: int, moves: int, drops: int) -> void {
    array_set(v4_borrowck_loans_handle(borrow_id), result_id, word_from_int(loans))
    array_set(v4_borrowck_moves_handle(borrow_id), result_id, word_from_int(moves))
    array_set(v4_borrowck_drops_handle(borrow_id), result_id, word_from_int(drops))
}

task v4_borrowck_set_result_status(borrow_id: int, result_id: int, status: word) -> void {
    array_set(v4_borrowck_statuses_handle(borrow_id), result_id, status)
}

task v4_borrowck_add_path(borrow_id: int, result_id: int, path_kind: word, path_text: word, stmt_id: int, block_id: int) -> int {
    pilot path_id = array_len(v4_borrowck_result_path_kinds_handle(borrow_id, result_id))
    array_push(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), path_kind)
    array_push(v4_borrowck_result_path_texts_handle(borrow_id, result_id), path_text)
    array_push(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), word_from_int(stmt_id))
    array_push(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), word_from_int(block_id))
    give back path_id
}

task v4_borrowck_rhs_starts_digit(rhs: word) -> bool {
    if rhs == "" {
        give back false
    }
    pilot ch = rhs.char_at(0)
    give back ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"
}

task v4_borrowck_rhs_is_literal(rhs: word) -> bool {
    if rhs == "" {
        give back true
    }
    if v4_borrowck_rhs_starts_digit(rhs) {
        give back true
    }
    if rhs == "true" or rhs == "false" or rhs == "yes" or rhs == "no" or rhs == "hai" or rhs == "iie" {
        give back true
    }
    if rhs == "nobody" {
        give back true
    }
    give back false
}

task v4_borrowck_rhs_needs_move(rhs: word) -> bool {
    if v4_borrowck_rhs_is_literal(rhs) {
        give back false
    }
    if v4_index_of_from(rhs, "+", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "-", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "*", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "/", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "(", 0) >= 0 { give back false }
    give back true
}

task v4_borrowck_copy_cache_lookup(mir_id: int, sig_id: int, ty_name: word) -> word {
    v4_borrowck_init()
    pilot cache_id = 0
    repeat until cache_id >= v4_borrowck_copy_cache_entry_count_value {
        pilot cached_type: word = array_get(v4_borrowck_copy_cache_types, cache_id)
        if word_to_int(array_get(v4_borrowck_copy_cache_mir_ids, cache_id)) == mir_id and word_to_int(array_get(v4_borrowck_copy_cache_sig_ids, cache_id)) == sig_id and cached_type == ty_name {
            pilot cached_value: word = array_get(v4_borrowck_copy_cache_values, cache_id)
            give back cached_value
        }
        cache_id += 1
    }
    give back ""
}

task v4_borrowck_copy_cache_store(mir_id: int, sig_id: int, ty_name: word, is_copy: bool) -> void {
    v4_borrowck_init()
    pilot encoded = "false"
    if is_copy { encoded = "true" }
    if v4_borrowck_copy_cache_entry_count_value < v4_borrowck_copy_cache_limit_value {
        pilot row = v4_borrowck_copy_cache_entry_count_value
        v4_borrowck_copy_cache_entry_count_value += 1
        if row < array_len(v4_borrowck_copy_cache_types) {
            array_set(v4_borrowck_copy_cache_mir_ids, row, word_from_int(mir_id))
            array_set(v4_borrowck_copy_cache_sig_ids, row, word_from_int(sig_id))
            array_set(v4_borrowck_copy_cache_types, row, ty_name)
            array_set(v4_borrowck_copy_cache_values, row, encoded)
        } else {
            array_push(v4_borrowck_copy_cache_mir_ids, word_from_int(mir_id))
            array_push(v4_borrowck_copy_cache_sig_ids, word_from_int(sig_id))
            array_push(v4_borrowck_copy_cache_types, ty_name)
            array_push(v4_borrowck_copy_cache_values, encoded)
        }
        give back
    }
    array_set(v4_borrowck_copy_cache_mir_ids, v4_borrowck_copy_cache_cursor, word_from_int(mir_id))
    array_set(v4_borrowck_copy_cache_sig_ids, v4_borrowck_copy_cache_cursor, word_from_int(sig_id))
    array_set(v4_borrowck_copy_cache_types, v4_borrowck_copy_cache_cursor, ty_name)
    array_set(v4_borrowck_copy_cache_values, v4_borrowck_copy_cache_cursor, encoded)
    v4_borrowck_copy_cache_cursor += 1
    if v4_borrowck_copy_cache_cursor >= v4_borrowck_copy_cache_limit_value {
        v4_borrowck_copy_cache_cursor = 0
    }
    v4_borrowck_copy_cache_evictions += 1
}

task v4_borrowck_copy_cache_count() -> int {
    v4_borrowck_init()
    give back v4_borrowck_copy_cache_entry_count_value
}

task v4_borrowck_copy_cache_limit() -> int {
    give back v4_borrowck_copy_cache_limit_value
}

task v4_borrowck_copy_cache_eviction_count() -> int {
    give back v4_borrowck_copy_cache_evictions
}

task v4_borrowck_ty_is_copy(mir_id: int, body_id: int, ty_name: word) -> bool {
    pilot ty_id = v4_mir_ty_id(mir_id)
    pilot sig_id = v4_mir_body_signature_id(mir_id, body_id)
    pilot cache_sig_id = sig_id
    if not v4_ty_type_mentions_signature_generics(ty_id, sig_id, ty_name) {
        cache_sig_id = 0 - 1
    }
    pilot cached = v4_borrowck_copy_cache_lookup(mir_id, cache_sig_id, ty_name)
    if cached != "" {
        give back cached == "true"
    }
    pilot is_copy = v4_ty_type_is_structurally_copy(ty_id, ty_name, 0)
    if not is_copy {
        is_copy = v4_ty_type_satisfies_repeat_doctrine(ty_id, sig_id, ty_name, "Copy")
    }
    v4_borrowck_copy_cache_store(mir_id, cache_sig_id, ty_name, is_copy)
    give back is_copy
}

task v4_borrowck_rvalue_transfer_kind(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back ""
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        pilot value_ty = v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)
        if v4_ty_is_closure_type(value_ty) {
            pilot closure_mode = v4_ty_closure_mode(value_ty)
            if closure_mode == v4_ty_closure_mode_move or closure_mode == v4_ty_closure_mode_mut {
                give back v4_borrowck_path_move
            }
            give back v4_borrowck_path_copy
        }
        if v4_borrowck_ty_is_copy(mir_id, body_id, value_ty) {
            give back v4_borrowck_path_copy
        }
        give back v4_borrowck_path_move
    }
    if kind == v4_mir_rvalue_capture_copy {
        give back v4_borrowck_path_copy
    }
    if kind == v4_mir_rvalue_capture_move {
        if v4_borrowck_ty_is_copy(mir_id, body_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
            give back v4_borrowck_path_copy
        }
        give back v4_borrowck_path_move
    }
    if kind == v4_mir_rvalue_unknown {
        pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if v4_borrowck_rhs_needs_move(text) {
            if v4_borrowck_ty_is_copy(mir_id, body_id, v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
                give back v4_borrowck_path_copy
            }
            give back v4_borrowck_path_move
        }
    }
    give back ""
}

task v4_borrowck_rvalue_move_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 {
        give back 0
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float or kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_const_bool or kind == v4_mir_rvalue_const_char {
        give back 0
    }
    if kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_use_symbol or kind == v4_mir_rvalue_loop_item {
        give back 0
    }
    if kind == v4_mir_rvalue_lend or kind == v4_mir_rvalue_lend_mut or kind == v4_mir_rvalue_capture_borrow or kind == v4_mir_rvalue_capture_borrow_mut or kind == v4_mir_rvalue_capture_copy {
        give back 0
    }
    if v4_borrowck_rvalue_transfer_kind(mir_id, body_id, rvalue_id) == v4_borrowck_path_move {
        give back 1
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        pilot left_moves = v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        pilot right_moves = v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
        give back left_moves + right_moves
    }
    if kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_try {
        give back v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err {
        give back v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_call {
        pilot moves = v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        pilot arg_id = 0
        pilot arg_count = v4_mir_rvalue_call_arg_count(mir_id, body_id, rvalue_id)
        repeat until arg_id >= arg_count {
            moves = moves + v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_call_arg(mir_id, body_id, rvalue_id, arg_id))
            arg_id += 1
        }
        give back moves
    }
    if v4_mir_rvalue_is_aggregate_kind(kind) {
        pilot moves = 0
        pilot child_id = 0
        pilot child_count = v4_mir_rvalue_aggregate_child_count(mir_id, body_id, rvalue_id)
        repeat until child_id >= child_count {
            moves += v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_aggregate_child(mir_id, body_id, rvalue_id, child_id))
            child_id += 1
        }
        give back moves
    }
    give back 0
}

task v4_borrowck_count_moves(mir_id: int, body_id: int) -> int {
    pilot moves = 0
    pilot stmt_idx = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_idx >= stmt_count {
        pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_idx)
        if stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign or stmt_kind == v4_mir_stmt_return {
            moves = moves + v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_stmt_rvalue(mir_id, body_id, stmt_idx))
        }
        stmt_idx += 1
    }
    give back moves
}

task v4_borrowck_path_count_by_kind(borrow_id: int, result_id: int, path_kind: word) -> int {
    pilot total = 0
    pilot path_idx = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    repeat until path_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, path_idx) == path_kind {
            total += 1
        }
        path_idx += 1
    }
    give back total
}

task v4_borrowck_path_is_loan_kind(path_kind: word) -> bool {
    give back path_kind == v4_borrowck_path_loan or path_kind == v4_borrowck_path_loan_mut
}

task v4_borrowck_path_count(borrow_id: int) -> int {
    pilot total = 0
    pilot result_idx = 0
    pilot result_count = v4_borrowck_result_count(borrow_id)
    repeat until result_idx >= result_count {
        total = total + v4_borrowck_result_path_count(borrow_id, result_idx)
        result_idx += 1
    }
    give back total
}

-- Cache row arrays stay bounded. Words replaced by ring eviction remain
-- bootstrap-runtime arena allocations; general arena reclamation is separate.
task v4_borrowck_provenance_integer_cache_store(encoded: word) -> void {
    if array_len(v4_borrowck_provenance_integer_words) < v4_borrowck_provenance_integer_cache_limit {
        array_push(v4_borrowck_provenance_integer_words, encoded)
        give back
    }
    array_set(v4_borrowck_provenance_integer_words, v4_borrowck_provenance_integer_cache_cursor, encoded)
    v4_borrowck_provenance_integer_cache_cursor += 1
    if v4_borrowck_provenance_integer_cache_cursor >= v4_borrowck_provenance_integer_cache_limit {
        v4_borrowck_provenance_integer_cache_cursor = 0
    }
    v4_borrowck_provenance_integer_cache_evictions += 1
}

task v4_borrowck_provenance_integer_word(value: int) -> word {
    v4_borrowck_init()
    pilot intern_id = 0
    repeat until intern_id >= array_len(v4_borrowck_provenance_integer_words) {
        pilot interned: word = array_get(v4_borrowck_provenance_integer_words, intern_id)
        if word_to_int(interned) == value {
            give back interned
        }
        intern_id += 1
    }
    pilot encoded = word_from_int(value)
    v4_borrowck_provenance_integer_cache_store(encoded)
    give back encoded
}

task v4_borrowck_provenance_integer_intern_count() -> int {
    v4_borrowck_init()
    give back array_len(v4_borrowck_provenance_integer_words)
}

task v4_borrowck_provenance_integer_intern_capacity() -> int {
    give back v4_borrowck_provenance_integer_cache_limit
}

task v4_borrowck_provenance_integer_intern_eviction_count() -> int {
    give back v4_borrowck_provenance_integer_cache_evictions
}

task v4_borrowck_path_matches_canonical(path_text: word, canonical: word) -> bool {
    pilot path_idx = 0
    pilot canonical_idx = 0
    pilot ch = ""
    repeat until path_idx >= path_text.length() {
        ch = path_text.char_at(path_idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n" {
            if canonical_idx >= canonical.length() or ch != canonical.char_at(canonical_idx) {
                give back false
            }
            canonical_idx += 1
        }
        path_idx += 1
    }
    give back canonical_idx == canonical.length()
}

task v4_borrowck_path_canon_cache_store(path_text: word, canonical: word) -> void {
    if array_len(v4_borrowck_path_canon_inputs) < v4_borrowck_path_canon_cache_limit {
        array_push(v4_borrowck_path_canon_inputs, path_text)
        array_push(v4_borrowck_path_canon_outputs, canonical)
        give back
    }
    array_set(v4_borrowck_path_canon_inputs, v4_borrowck_path_canon_cache_cursor, path_text)
    array_set(v4_borrowck_path_canon_outputs, v4_borrowck_path_canon_cache_cursor, canonical)
    v4_borrowck_path_canon_cache_cursor += 1
    if v4_borrowck_path_canon_cache_cursor >= v4_borrowck_path_canon_cache_limit {
        v4_borrowck_path_canon_cache_cursor = 0
    }
    v4_borrowck_path_canon_cache_evictions += 1
}

task v4_borrowck_path_canon_value_cache_store(canonical: word) -> void {
    if array_len(v4_borrowck_path_canon_values) < v4_borrowck_path_canon_cache_limit {
        array_push(v4_borrowck_path_canon_values, canonical)
        give back
    }
    array_set(v4_borrowck_path_canon_values, v4_borrowck_path_canon_value_cache_cursor, canonical)
    v4_borrowck_path_canon_value_cache_cursor += 1
    if v4_borrowck_path_canon_value_cache_cursor >= v4_borrowck_path_canon_cache_limit {
        v4_borrowck_path_canon_value_cache_cursor = 0
    }
    v4_borrowck_path_canon_value_cache_evictions += 1
}

task v4_borrowck_path_canon(path_text: word) -> word {
    v4_borrowck_init()
    if path_text == "" {
        give back ""
    }

    pilot cache_id = 0
    repeat until cache_id >= array_len(v4_borrowck_path_canon_inputs) {
        pilot cached_input: word = array_get(v4_borrowck_path_canon_inputs, cache_id)
        if cached_input == path_text {
            give back array_get(v4_borrowck_path_canon_outputs, cache_id)
        }
        cache_id += 1
    }

    pilot value_id = 0
    repeat until value_id >= array_len(v4_borrowck_path_canon_values) {
        pilot cached_value: word = array_get(v4_borrowck_path_canon_values, value_id)
        if v4_borrowck_path_matches_canonical(path_text, cached_value) {
            v4_borrowck_path_canon_cache_store(path_text, cached_value)
            give back cached_value
        }
        value_id += 1
    }

    pilot needs_rebuild = false
    pilot idx = 0
    pilot ch = ""
    repeat until idx >= path_text.length() {
        ch = path_text.char_at(idx)
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            needs_rebuild = true
        }
        idx += 1
    }

    pilot canonical = path_text
    if needs_rebuild {
        canonical = ""
        idx = 0
        repeat until idx >= path_text.length() {
            ch = path_text.char_at(idx)
            if ch != " " and ch != "\t" and ch != "\r" and ch != "\n" {
                canonical = canonical + ch
            }
            idx += 1
        }
    }

    v4_borrowck_path_canon_value_cache_store(canonical)
    v4_borrowck_path_canon_cache_store(path_text, canonical)
    give back canonical
}

task v4_borrowck_path_canon_cache_count() -> int {
    v4_borrowck_init()
    give back array_len(v4_borrowck_path_canon_inputs)
}

task v4_borrowck_path_canon_cache_capacity() -> int {
    give back v4_borrowck_path_canon_cache_limit
}

task v4_borrowck_path_canon_cache_eviction_count() -> int {
    give back v4_borrowck_path_canon_cache_evictions
}

task v4_borrowck_path_canon_value_cache_count() -> int {
    v4_borrowck_init()
    give back array_len(v4_borrowck_path_canon_values)
