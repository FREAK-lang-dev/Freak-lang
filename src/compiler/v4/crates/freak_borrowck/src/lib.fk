-- ===================================================================
-- freak_borrowck - Meiya borrow-check scaffold
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_mir.
-- This first Meiya layer creates borrow-check result records for MIR
-- bodies. Real move paths, loans, regions, and drop flags will fill in
-- these counters once body lowering becomes real.

pilot v4_borrowck_clean = "clean"
pilot v4_borrowck_blocked = "blocked"

pilot v4_borrowck_path_write = "Write"
pilot v4_borrowck_path_copy = "Copy"
pilot v4_borrowck_path_move = "Move"
pilot v4_borrowck_path_loan = "Loan"
pilot v4_borrowck_path_drop = "Drop"
pilot v4_borrowck_path_return = "Return"
pilot v4_borrowck_snapshot_format = "freak-borrowck-snapshot-v1"

pilot v4_borrowck_files = 0
pilot v4_borrowck_mirs = 0
pilot v4_borrowck_body_defs = 0
pilot v4_borrowck_body_names = 0
pilot v4_borrowck_statuses = 0
pilot v4_borrowck_loan_counts = 0
pilot v4_borrowck_move_counts = 0
pilot v4_borrowck_drop_counts = 0
pilot v4_borrowck_path_kinds = 0
pilot v4_borrowck_path_texts = 0
pilot v4_borrowck_path_stmt_ids = 0
pilot v4_borrowck_path_block_ids = 0
pilot v4_borrowck_diags = 0
pilot v4_borrowck_ready = 0

task v4_borrowck_init() -> void {
    if v4_borrowck_ready == 0 {
        v4_borrowck_files = array_new()
        v4_borrowck_mirs = array_new()
        v4_borrowck_body_defs = array_new()
        v4_borrowck_body_names = array_new()
        v4_borrowck_statuses = array_new()
        v4_borrowck_loan_counts = array_new()
        v4_borrowck_move_counts = array_new()
        v4_borrowck_drop_counts = array_new()
        v4_borrowck_path_kinds = array_new()
        v4_borrowck_path_texts = array_new()
        v4_borrowck_path_stmt_ids = array_new()
        v4_borrowck_path_block_ids = array_new()
        v4_borrowck_diags = array_new()
        v4_borrowck_ready = 1
    }
}

task v4_borrowck_file_new(file_id: int, mir_id: int) -> int {
    v4_borrowck_init()
    pilot borrow_id = array_len(v4_borrowck_files)
    array_push(v4_borrowck_files, word_from_int(file_id))
    array_push(v4_borrowck_mirs, word_from_int(mir_id))
    array_push(v4_borrowck_body_defs, word_from_int(array_new()))
    array_push(v4_borrowck_body_names, word_from_int(array_new()))
    array_push(v4_borrowck_statuses, word_from_int(array_new()))
    array_push(v4_borrowck_loan_counts, word_from_int(array_new()))
    array_push(v4_borrowck_move_counts, word_from_int(array_new()))
    array_push(v4_borrowck_drop_counts, word_from_int(array_new()))
    array_push(v4_borrowck_path_kinds, word_from_int(array_new()))
    array_push(v4_borrowck_path_texts, word_from_int(array_new()))
    array_push(v4_borrowck_path_stmt_ids, word_from_int(array_new()))
    array_push(v4_borrowck_path_block_ids, word_from_int(array_new()))
    array_push(v4_borrowck_diags, word_from_int(array_new()))
    give back borrow_id
}

task v4_borrowck_file_count() -> int {
    v4_borrowck_init()
    give back array_len(v4_borrowck_files)
}

task v4_borrowck_file_exists(borrow_id: int) -> bool {
    v4_borrowck_init()
    if borrow_id < 0 {
        give back false
    }
    if borrow_id >= array_len(v4_borrowck_files) {
        give back false
    }
    give back true
}

task v4_borrowck_file_id(borrow_id: int) -> int {
    if v4_borrowck_file_exists(borrow_id) == false {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_borrowck_files, borrow_id))
}

task v4_borrowck_mir_id(borrow_id: int) -> int {
    if v4_borrowck_file_exists(borrow_id) == false {
        give back 0 - 1
    }
    give back word_to_int(array_get(v4_borrowck_mirs, borrow_id))
}

task v4_borrowck_defs_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_body_defs, borrow_id))
}

task v4_borrowck_names_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_body_names, borrow_id))
}

task v4_borrowck_statuses_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_statuses, borrow_id))
}

task v4_borrowck_loans_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_loan_counts, borrow_id))
}

task v4_borrowck_moves_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_move_counts, borrow_id))
}

task v4_borrowck_drops_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_drop_counts, borrow_id))
}

task v4_borrowck_path_kinds_index_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_kinds, borrow_id))
}

task v4_borrowck_path_texts_index_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_texts, borrow_id))
}

task v4_borrowck_path_stmt_ids_index_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_stmt_ids, borrow_id))
}

task v4_borrowck_path_block_ids_index_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_block_ids, borrow_id))
}

task v4_borrowck_diags_handle(borrow_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_diags, borrow_id))
}

task v4_borrowck_result_count(borrow_id: int) -> int {
    give back array_len(v4_borrowck_defs_handle(borrow_id))
}

task v4_borrowck_diag_count(borrow_id: int) -> int {
    give back array_len(v4_borrowck_diags_handle(borrow_id))
}

task v4_borrowck_result_path_kinds_handle(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_kinds_index_handle(borrow_id), result_id))
}

task v4_borrowck_result_path_texts_handle(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_texts_index_handle(borrow_id), result_id))
}

task v4_borrowck_result_path_stmt_ids_handle(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_stmt_ids_index_handle(borrow_id), result_id))
}

task v4_borrowck_result_path_block_ids_handle(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_path_block_ids_index_handle(borrow_id), result_id))
}

task v4_borrowck_result_def(borrow_id: int, result_id: int) -> word {
    give back array_get(v4_borrowck_defs_handle(borrow_id), result_id)
}

task v4_borrowck_result_name(borrow_id: int, result_id: int) -> word {
    give back array_get(v4_borrowck_names_handle(borrow_id), result_id)
}

task v4_borrowck_result_status(borrow_id: int, result_id: int) -> word {
    give back array_get(v4_borrowck_statuses_handle(borrow_id), result_id)
}

task v4_borrowck_result_loans(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_loans_handle(borrow_id), result_id))
}

task v4_borrowck_result_moves(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_moves_handle(borrow_id), result_id))
}

task v4_borrowck_result_drops(borrow_id: int, result_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_drops_handle(borrow_id), result_id))
}

task v4_borrowck_result_path_count(borrow_id: int, result_id: int) -> int {
    give back array_len(v4_borrowck_result_path_kinds_handle(borrow_id, result_id))
}

task v4_borrowck_path_kind(borrow_id: int, result_id: int, path_id: int) -> word {
    give back array_get(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), path_id)
}

task v4_borrowck_path_text(borrow_id: int, result_id: int, path_id: int) -> word {
    give back array_get(v4_borrowck_result_path_texts_handle(borrow_id, result_id), path_id)
}

task v4_borrowck_path_stmt(borrow_id: int, result_id: int, path_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), path_id))
}

task v4_borrowck_path_block(borrow_id: int, result_id: int, path_id: int) -> int {
    give back word_to_int(array_get(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), path_id))
}

task v4_borrowck_diag(borrow_id: int, diag_id: int) -> word {
    give back array_get(v4_borrowck_diags_handle(borrow_id), diag_id)
}

task v4_borrowck_add_diag(borrow_id: int, diag: word) -> void {
    array_push(v4_borrowck_diags_handle(borrow_id), diag)
}

task v4_borrowck_copy_mir_diags(borrow_id: int, mir_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_mir_diag_count(mir_id)
    repeat until diag_idx >= diag_count {
        v4_borrowck_add_diag(borrow_id, v4_mir_diag(mir_id, diag_idx))
        diag_idx += 1
    }
}

task v4_borrowck_add_result(borrow_id: int, def_id: word, body_name: word, status: word, loans: int, moves: int, drops: int) -> int {
    pilot result_id = array_len(v4_borrowck_defs_handle(borrow_id))
    pilot path_kinds_handle = array_new()
    pilot path_texts_handle = array_new()
    pilot path_stmt_ids_handle = array_new()
    pilot path_block_ids_handle = array_new()
    array_push(v4_borrowck_defs_handle(borrow_id), def_id)
    array_push(v4_borrowck_names_handle(borrow_id), body_name)
    array_push(v4_borrowck_statuses_handle(borrow_id), status)
    array_push(v4_borrowck_loans_handle(borrow_id), word_from_int(loans))
    array_push(v4_borrowck_moves_handle(borrow_id), word_from_int(moves))
    array_push(v4_borrowck_drops_handle(borrow_id), word_from_int(drops))
    array_push(v4_borrowck_path_kinds_index_handle(borrow_id), word_from_int(path_kinds_handle))
    array_push(v4_borrowck_path_texts_index_handle(borrow_id), word_from_int(path_texts_handle))
    array_push(v4_borrowck_path_stmt_ids_index_handle(borrow_id), word_from_int(path_stmt_ids_handle))
    array_push(v4_borrowck_path_block_ids_index_handle(borrow_id), word_from_int(path_block_ids_handle))
    give back result_id
}

task v4_borrowck_set_result_counts(borrow_id: int, result_id: int, loans: int, moves: int, drops: int) -> void {
    array_set(v4_borrowck_loans_handle(borrow_id), result_id, word_from_int(loans))
    array_set(v4_borrowck_moves_handle(borrow_id), result_id, word_from_int(moves))
    array_set(v4_borrowck_drops_handle(borrow_id), result_id, word_from_int(drops))
}

task v4_borrowck_set_result_status(borrow_id: int, result_id: int, status: word) -> void {
    array_set(v4_borrowck_statuses_handle(borrow_id), result_id, status)
}

task v4_borrowck_add_path(borrow_id: int, result_id: int, path_kind: word, path_text: word, stmt_id: int, block_id: int) -> int {
    pilot path_id = array_len(v4_borrowck_result_path_kinds_handle(borrow_id, result_id))
    array_push(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), path_kind)
    array_push(v4_borrowck_result_path_texts_handle(borrow_id, result_id), path_text)
    array_push(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), word_from_int(stmt_id))
    array_push(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), word_from_int(block_id))
    give back path_id
}

task v4_borrowck_rhs_starts_digit(rhs: word) -> bool {
    if rhs == "" {
        give back false
    }
    pilot ch = rhs.char_at(0)
    give back ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"
}

task v4_borrowck_rhs_is_literal(rhs: word) -> bool {
    if rhs == "" {
        give back true
    }
    if v4_borrowck_rhs_starts_digit(rhs) {
        give back true
    }
    if rhs == "true" or rhs == "false" or rhs == "yes" or rhs == "no" or rhs == "hai" or rhs == "iie" {
        give back true
    }
    if rhs == "nobody" {
        give back true
    }
    give back false
}

task v4_borrowck_rhs_needs_move(rhs: word) -> bool {
    if v4_borrowck_rhs_is_literal(rhs) {
        give back false
    }
    if v4_index_of_from(rhs, "+", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "-", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "*", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "/", 0) >= 0 { give back false }
    if v4_index_of_from(rhs, "(", 0) >= 0 { give back false }
    give back true
}

task v4_borrowck_ty_is_copy(ty_name: word) -> bool {
    if ty_name == v4_ty_int or ty_name == v4_ty_num or ty_name == v4_ty_bool or ty_name == v4_ty_void {
        give back true
    }
    if ty_name == "uint" or ty_name == "tiny" or ty_name == "float" or ty_name == "float32" or ty_name == "char" {
        give back true
    }
    give back false
}

task v4_borrowck_rvalue_transfer_kind(mir_id: int, body_id: int, rvalue_id: int) -> word {
    if rvalue_id < 0 {
        give back ""
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_use_local or kind == v4_mir_rvalue_use_place {
        if v4_borrowck_ty_is_copy(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
            give back v4_borrowck_path_copy
        }
        give back v4_borrowck_path_move
    }
    if kind == v4_mir_rvalue_unknown {
        pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if v4_borrowck_rhs_needs_move(text) {
            if v4_borrowck_ty_is_copy(v4_mir_rvalue_ty(mir_id, body_id, rvalue_id)) {
                give back v4_borrowck_path_copy
            }
            give back v4_borrowck_path_move
        }
    }
    give back ""
}

task v4_borrowck_rvalue_move_count(mir_id: int, body_id: int, rvalue_id: int) -> int {
    if rvalue_id < 0 {
        give back 0
    }

    pilot kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if kind == v4_mir_rvalue_const_int or kind == v4_mir_rvalue_const_float or kind == v4_mir_rvalue_const_word or kind == v4_mir_rvalue_const_bool {
        give back 0
    }
    if kind == v4_mir_rvalue_nobody or kind == v4_mir_rvalue_use_symbol or kind == v4_mir_rvalue_loop_item {
        give back 0
    }
    if v4_borrowck_rvalue_transfer_kind(mir_id, body_id, rvalue_id) == v4_borrowck_path_move {
        give back 1
    }
    if kind == v4_mir_rvalue_binary or kind == v4_mir_rvalue_or_else {
        pilot left_moves = v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        pilot right_moves = v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
        give back left_moves + right_moves
    }
    if kind == v4_mir_rvalue_unary or kind == v4_mir_rvalue_check or kind == v4_mir_rvalue_try {
        give back v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_some or kind == v4_mir_rvalue_ok or kind == v4_mir_rvalue_err {
        give back v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    if kind == v4_mir_rvalue_call {
        give back v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
    give back 0
}

task v4_borrowck_count_moves(mir_id: int, body_id: int) -> int {
    pilot moves = 0
    pilot stmt_idx = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_idx >= stmt_count {
        pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_idx)
        if stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign or stmt_kind == v4_mir_stmt_return {
            moves = moves + v4_borrowck_rvalue_move_count(mir_id, body_id, v4_mir_stmt_rvalue(mir_id, body_id, stmt_idx))
        }
        stmt_idx += 1
    }
    give back moves
}

task v4_borrowck_path_count_by_kind(borrow_id: int, result_id: int, path_kind: word) -> int {
    pilot total = 0
    pilot path_idx = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    repeat until path_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, path_idx) == path_kind {
            total += 1
        }
        path_idx += 1
    }
    give back total
}

task v4_borrowck_path_count(borrow_id: int) -> int {
    pilot total = 0
    pilot result_idx = 0
    pilot result_count = v4_borrowck_result_count(borrow_id)
    repeat until result_idx >= result_count {
        total = total + v4_borrowck_result_path_count(borrow_id, result_idx)
        result_idx += 1
    }
    give back total
}

task v4_borrowck_path_canon(path_text: word) -> word {
    if path_text == "" {
        give back ""
    }
    pilot out = ""
    pilot idx = 0
    repeat until idx >= path_text.length() {
        pilot ch = path_text.char_at(idx)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n" {
            out = out + ch
        }
        idx += 1
    }
    give back out
}

task v4_borrowck_path_prefix_conflicts(prefix: word, path_text: word) -> bool {
    if prefix == "" or path_text == "" {
        give back false
    }
    if prefix.length() >= path_text.length() {
        give back false
    }
    if v4_slice(path_text, 0, prefix.length()) != prefix {
        give back false
    }
    pilot next = path_text.char_at(prefix.length())
    give back next == "." or next == "["
}

task v4_borrowck_paths_overlap(left: word, right: word) -> bool {
    pilot left_canon = v4_borrowck_path_canon(left)
    pilot right_canon = v4_borrowck_path_canon(right)
    if left_canon == "" or right_canon == "" {
        give back false
    }
    if left_canon == right_canon {
        give back true
    }
    if v4_borrowck_path_prefix_conflicts(left_canon, right_canon) {
        give back true
    }
    if v4_borrowck_path_prefix_conflicts(right_canon, left_canon) {
        give back true
    }
    give back false
}

task v4_borrowck_mutable_conflict_help(loan_text: word, loan_stmt: int, block_id: int, write_text: word, write_stmt: int) -> word {
    pilot loan_canon = v4_borrowck_path_canon(loan_text)
    pilot write_canon = v4_borrowck_path_canon(write_text)
    pilot out = loan_canon + " stays on loan in block " + word_from_int(block_id)
    out = out + " from statement " + word_from_int(loan_stmt)
    out = out + ", so statement " + word_from_int(write_stmt)
    out = out + " cannot rewrite " + write_canon + " yet"
    give back out
}

task v4_borrowck_cross_block_conflict_help(loan_text: word, loan_stmt: int, loan_block: int, write_text: word, write_stmt: int, write_block: int) -> word {
    pilot loan_canon = v4_borrowck_path_canon(loan_text)
    pilot write_canon = v4_borrowck_path_canon(write_text)
    pilot out = loan_canon + " stays on loan from block " + word_from_int(loan_block)
    out = out + " into block " + word_from_int(write_block)
    out = out + " after statement " + word_from_int(loan_stmt)
    out = out + ", so statement " + word_from_int(write_stmt)
    out = out + " cannot rewrite " + write_canon + " yet"
    give back out
}

task v4_borrowck_block_reaches_seen(mir_id: int, body_id: int, start_block: int, wanted_block: int, seen: word) -> bool {
    if start_block < 0 or wanted_block < 0 {
        give back false
    }
    if start_block == wanted_block {
        give back true
    }
    if start_block >= v4_mir_body_block_count(mir_id, body_id) {
        give back false
    }

    pilot key = word_from_int(start_block)
    if v4_mir_name_list_contains(seen, key) {
        give back false
    }
    seen = v4_mir_name_list_add(seen, key)

    pilot block_record = v4_mir_body_block(mir_id, body_id, start_block)
    pilot terminator = v4_mir_block_terminator(block_record)
    if terminator == v4_mir_term_goto {
        give back v4_borrowck_block_reaches_seen(mir_id, body_id, v4_mir_block_target(block_record), wanted_block, seen)
    }
    if terminator == v4_mir_term_if {
        if v4_borrowck_block_reaches_seen(mir_id, body_id, v4_mir_block_target(block_record), wanted_block, seen) {
            give back true
        }
        give back v4_borrowck_block_reaches_seen(mir_id, body_id, v4_mir_block_else_target(block_record), wanted_block, seen)
    }
    give back false
}

task v4_borrowck_block_reaches(mir_id: int, body_id: int, start_block: int, wanted_block: int) -> bool {
    give back v4_borrowck_block_reaches_seen(mir_id, body_id, start_block, wanted_block, "")
}

task v4_borrowck_loan_spans_successors(mir_id: int, body_id: int, loan_stmt: int) -> bool {
    if loan_stmt < 0 {
        give back false
    }
    give back v4_mir_stmt_kind(mir_id, body_id, loan_stmt) == v4_mir_stmt_expr
}

task v4_borrowck_path_is_move_use_kind(path_kind: word) -> bool {
    give back path_kind == v4_borrowck_path_loan or path_kind == v4_borrowck_path_copy or path_kind == v4_borrowck_path_move
}

task v4_borrowck_write_repairs_move(move_text: word, write_text: word) -> bool {
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot write_canon = v4_borrowck_path_canon(write_text)
    if move_canon == "" or write_canon == "" {
        give back false
    }
    if move_canon == write_canon {
        give back true
    }
    give back v4_borrowck_path_prefix_conflicts(write_canon, move_canon)
}

task v4_borrowck_partial_move_conflict_help(move_text: word, move_stmt: int, use_text: word, use_stmt: int) -> word {
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot use_canon = v4_borrowck_path_canon(use_text)
    pilot out = move_canon + " was moved at statement " + word_from_int(move_stmt)
    out = out + ", so statement " + word_from_int(use_stmt)
    out = out + " cannot use " + use_canon + " yet"
    give back out
}

task v4_borrowck_cross_block_partial_move_help(move_text: word, move_stmt: int, move_block: int, use_text: word, use_stmt: int, use_block: int) -> word {
    pilot move_canon = v4_borrowck_path_canon(move_text)
    pilot use_canon = v4_borrowck_path_canon(use_text)
    pilot out = move_canon + " was moved in block " + word_from_int(move_block)
    out = out + " at statement " + word_from_int(move_stmt)
    out = out + ", so block " + word_from_int(use_block)
    out = out + " statement " + word_from_int(use_stmt)
    out = out + " cannot use " + use_canon + " yet"
    give back out
}

task v4_borrowck_move_repaired_before_use(borrow_id: int, result_id: int, move_stmt: int, move_block: int, move_text: word, use_stmt: int, use_block: int) -> bool {
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot path_idx = 0
    repeat until path_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, path_idx) == v4_borrowck_path_write {
            pilot write_stmt = v4_borrowck_path_stmt(borrow_id, result_id, path_idx)
            pilot write_block = v4_borrowck_path_block(borrow_id, result_id, path_idx)
            pilot write_text = v4_borrowck_path_text(borrow_id, result_id, path_idx)
            if write_block == move_block and write_stmt > move_stmt {
                if use_block != move_block or write_stmt < use_stmt {
                    if v4_borrowck_write_repairs_move(move_text, write_text) {
                        give back true
                    }
                }
            }
        }
        path_idx += 1
    }
    give back false
}

task v4_borrowck_add_place_path(borrow_id: int, result_id: int, mir_id: int, body_id: int, place_id: int, path_kind: word, stmt_id: int, block_id: int) -> void {
    if place_id < 0 {
        give back
    }
    v4_borrowck_add_path(borrow_id, result_id, path_kind, v4_mir_place_text(mir_id, body_id, place_id), stmt_id, block_id)
}

task v4_borrowck_collect_transfer_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int, block_id: int, rvalue_id: int) -> void {
    if rvalue_id < 0 {
        give back
    }

    pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    pilot transfer_kind = v4_borrowck_rvalue_transfer_kind(mir_id, body_id, rvalue_id)
    if transfer_kind != "" {
        v4_borrowck_add_path(borrow_id, result_id, transfer_kind, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_binary or rvalue_kind == v4_mir_rvalue_or_else {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_unary or rvalue_kind == v4_mir_rvalue_check or rvalue_kind == v4_mir_rvalue_try {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_some or rvalue_kind == v4_mir_rvalue_ok or rvalue_kind == v4_mir_rvalue_err {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_call {
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    }
}

task v4_borrowck_collect_read_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int, block_id: int, rvalue_id: int) -> void {
    if rvalue_id < 0 {
        give back
    }

    pilot rvalue_kind = v4_mir_rvalue_kind(mir_id, body_id, rvalue_id)
    if rvalue_kind == v4_mir_rvalue_use_local or rvalue_kind == v4_mir_rvalue_use_place {
        v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_path_loan, v4_mir_rvalue_text(mir_id, body_id, rvalue_id), stmt_id, block_id)
    } else if rvalue_kind == v4_mir_rvalue_binary or rvalue_kind == v4_mir_rvalue_or_else {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_rhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_unary or rvalue_kind == v4_mir_rvalue_check or rvalue_kind == v4_mir_rvalue_try {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_some or rvalue_kind == v4_mir_rvalue_ok or rvalue_kind == v4_mir_rvalue_err {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_call {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, v4_mir_rvalue_lhs(mir_id, body_id, rvalue_id))
    } else if rvalue_kind == v4_mir_rvalue_unknown {
        pilot text = v4_mir_rvalue_text(mir_id, body_id, rvalue_id)
        if v4_borrowck_rhs_needs_move(text) {
            v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_path_loan, text, stmt_id, block_id)
        }
    }
}

task v4_borrowck_collect_drop_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> void {
    pilot local_count = v4_mir_body_local_count(mir_id, body_id)
    pilot local_idx = local_count - 1
    repeat until local_idx < 0 {
        v4_borrowck_add_path(borrow_id, result_id, v4_borrowck_path_drop, v4_mir_local_name(mir_id, body_id, local_idx), 0 - 1, 0 - 1)
        local_idx -= 1
    }
}

task v4_borrowck_collect_stmt_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int, stmt_id: int) -> void {
    pilot stmt_kind = v4_mir_stmt_kind(mir_id, body_id, stmt_id)
    pilot block_id = v4_mir_stmt_block(mir_id, body_id, stmt_id)
    pilot place_id = v4_mir_stmt_place(mir_id, body_id, stmt_id)
    pilot rvalue_id = v4_mir_stmt_rvalue(mir_id, body_id, stmt_id)

    if stmt_kind == v4_mir_stmt_local or stmt_kind == v4_mir_stmt_assign {
        v4_borrowck_add_place_path(borrow_id, result_id, mir_id, body_id, place_id, v4_borrowck_path_write, stmt_id, block_id)
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    } else if stmt_kind == v4_mir_stmt_return {
        v4_borrowck_add_place_path(borrow_id, result_id, mir_id, body_id, place_id, v4_borrowck_path_return, stmt_id, block_id)
        v4_borrowck_collect_transfer_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    } else if stmt_kind == v4_mir_stmt_branch or stmt_kind == v4_mir_stmt_loop or stmt_kind == v4_mir_stmt_expr {
        v4_borrowck_collect_read_paths(borrow_id, result_id, mir_id, body_id, stmt_id, block_id, rvalue_id)
    }
}

task v4_borrowck_collect_body_paths(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> void {
    pilot stmt_idx = 0
    pilot stmt_count = v4_mir_body_stmt_count(mir_id, body_id)
    repeat until stmt_idx >= stmt_count {
        v4_borrowck_collect_stmt_paths(borrow_id, result_id, mir_id, body_id, stmt_idx)
        stmt_idx += 1
    }
    v4_borrowck_collect_drop_paths(borrow_id, result_id, mir_id, body_id)
}

task v4_borrowck_check_mutable_exclusivity(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot write_idx = 0
    repeat until write_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, write_idx) == v4_borrowck_path_write {
            pilot write_stmt = v4_borrowck_path_stmt(borrow_id, result_id, write_idx)
            pilot write_block = v4_borrowck_path_block(borrow_id, result_id, write_idx)
            pilot write_text = v4_borrowck_path_text(borrow_id, result_id, write_idx)
            pilot loan_idx = 0
            repeat until loan_idx >= path_count {
                if v4_borrowck_path_kind(borrow_id, result_id, loan_idx) == v4_borrowck_path_loan {
                    pilot loan_stmt = v4_borrowck_path_stmt(borrow_id, result_id, loan_idx)
                    pilot loan_block = v4_borrowck_path_block(borrow_id, result_id, loan_idx)
                    pilot loan_text = v4_borrowck_path_text(borrow_id, result_id, loan_idx)
                    pilot loan_conflicts = false
                    pilot help = ""
                    if loan_block == write_block and loan_stmt >= 0 and write_stmt >= 0 and loan_stmt < write_stmt {
                        if v4_borrowck_paths_overlap(loan_text, write_text) {
                            loan_conflicts = true
                            help = v4_borrowck_mutable_conflict_help(loan_text, loan_stmt, write_block, write_text, write_stmt)
                        }
                    } else if loan_stmt >= 0 and write_stmt >= 0 and loan_block >= 0 and write_block >= 0 and loan_block != write_block {
                        if v4_borrowck_loan_spans_successors(mir_id, body_id, loan_stmt) {
                            if v4_borrowck_block_reaches(mir_id, body_id, loan_block, write_block) {
                                if v4_borrowck_paths_overlap(loan_text, write_text) {
                                    loan_conflicts = true
                                    help = v4_borrowck_cross_block_conflict_help(loan_text, loan_stmt, loan_block, write_text, write_stmt, write_block)
                                }
                            }
                        }
                    }
                    if loan_conflicts {
                        pilot stmt_span = v4_mir_stmt_span(mir_id, body_id, write_stmt)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, "mutable borrow conflict", help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                        loan_idx = path_count
                    }
                }
                loan_idx += 1
            }
        }
        write_idx += 1
    }
    give back conflicts
}

task v4_borrowck_check_partial_moves(borrow_id: int, result_id: int, mir_id: int, body_id: int) -> int {
    pilot conflicts = 0
    pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
    pilot move_idx = 0
    repeat until move_idx >= path_count {
        if v4_borrowck_path_kind(borrow_id, result_id, move_idx) == v4_borrowck_path_move {
            pilot move_stmt = v4_borrowck_path_stmt(borrow_id, result_id, move_idx)
            pilot move_block = v4_borrowck_path_block(borrow_id, result_id, move_idx)
            pilot move_text = v4_borrowck_path_text(borrow_id, result_id, move_idx)
            pilot use_idx = 0
            repeat until use_idx >= path_count {
                if use_idx != move_idx and v4_borrowck_path_is_move_use_kind(v4_borrowck_path_kind(borrow_id, result_id, use_idx)) {
                    pilot use_stmt = v4_borrowck_path_stmt(borrow_id, result_id, use_idx)
                    pilot use_block = v4_borrowck_path_block(borrow_id, result_id, use_idx)
                    pilot use_text = v4_borrowck_path_text(borrow_id, result_id, use_idx)
                    pilot move_conflicts = false
                    pilot help = ""
                    if move_stmt >= 0 and use_stmt >= 0 and move_block == use_block and move_stmt < use_stmt {
                        if not v4_borrowck_move_repaired_before_use(borrow_id, result_id, move_stmt, move_block, move_text, use_stmt, use_block) {
                            if v4_borrowck_paths_overlap(move_text, use_text) {
                                move_conflicts = true
                                help = v4_borrowck_partial_move_conflict_help(move_text, move_stmt, use_text, use_stmt)
                            }
                        }
                    } else if move_stmt >= 0 and use_stmt >= 0 and move_block >= 0 and use_block >= 0 {
                        if not v4_borrowck_move_repaired_before_use(borrow_id, result_id, move_stmt, move_block, move_text, use_stmt, use_block) {
                            if v4_borrowck_block_reaches(mir_id, body_id, move_block, use_block) {
                                if v4_borrowck_paths_overlap(move_text, use_text) {
                                    move_conflicts = true
                                    help = v4_borrowck_cross_block_partial_move_help(move_text, move_stmt, move_block, use_text, use_stmt, use_block)
                                }
                            }
                        }
                    }
                    if move_conflicts {
                        pilot stmt_span = v4_mir_stmt_span(mir_id, body_id, use_stmt)
                        v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, stmt_span, "partial move conflict", help))
                        v4_borrowck_set_result_status(borrow_id, result_id, v4_borrowck_blocked)
                        conflicts += 1
                        use_idx = path_count
                    }
                }
                use_idx += 1
            }
        }
        move_idx += 1
    }
    give back conflicts
}

task v4_borrowck_check_mir(file_id: int, mir_id: int) -> int {
    v4_borrowck_init()
    pilot borrow_id = v4_borrowck_file_new(file_id, mir_id)
    v4_borrowck_copy_mir_diags(borrow_id, mir_id)

    pilot body_idx = 0
    pilot body_count = v4_mir_body_count(mir_id)
    repeat until body_idx >= body_count {
        pilot def_id = v4_mir_body_def(mir_id, body_idx)
        pilot body_name = v4_mir_body_name(mir_id, body_idx)
        pilot block_count = v4_mir_body_block_count(mir_id, body_idx)
        pilot status = v4_borrowck_clean
        if block_count == 0 {
            status = v4_borrowck_blocked
            v4_borrowck_add_diag(borrow_id, v4_diag_new(v4_diag_error, V4_NO_SPAN, "MIR body has no blocks", body_name))
        }
        pilot result_id = v4_borrowck_add_result(borrow_id, def_id, body_name, status, 0, 0, 0)
        v4_borrowck_collect_body_paths(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_mutable_exclusivity(borrow_id, result_id, mir_id, body_idx)
        v4_borrowck_check_partial_moves(borrow_id, result_id, mir_id, body_idx)
        pilot loan_count = v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_loan)
        pilot move_count = v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_move)
        pilot drop_count = v4_borrowck_path_count_by_kind(borrow_id, result_id, v4_borrowck_path_drop)
        v4_borrowck_set_result_counts(borrow_id, result_id, loan_count, move_count, drop_count)
        body_idx += 1
    }

    give back borrow_id
}

task v4_borrowck_lookup_result(borrow_id: int, def_id: word) -> int {
    pilot result_idx = 0
    pilot result_count = v4_borrowck_result_count(borrow_id)
    repeat until result_idx >= result_count {
        if v4_borrowck_result_def(borrow_id, result_idx) == def_id {
            give back result_idx
        }
        result_idx += 1
    }
    give back 0 - 1
}

task v4_borrowck_summary(borrow_id: int) -> word {
    pilot summary = "borrowck-ok borrow=" + word_from_int(borrow_id)
    summary = summary + " results=" + word_from_int(v4_borrowck_result_count(borrow_id))
    summary = summary + " paths=" + word_from_int(v4_borrowck_path_count(borrow_id))
    summary = summary + " diagnostics=" + word_from_int(v4_borrowck_diag_count(borrow_id))
    give back summary
}

task v4_borrowck_snapshot_escape(value: word) -> word {
    give back v4_mir_snapshot_escape(value)
}

task v4_borrowck_snapshot_unescape(value: word) -> word {
    give back v4_mir_snapshot_unescape(value)
}

task v4_borrowck_snapshot_line_count(payload: word) -> int {
    give back v4_mir_snapshot_line_count(payload)
}

task v4_borrowck_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_mir_snapshot_line(payload, wanted)
}

task v4_borrowck_snapshot_field_count(line: word) -> int {
    give back v4_mir_snapshot_field_count(line)
}

task v4_borrowck_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_mir_snapshot_field_raw(line, wanted)
}

task v4_borrowck_snapshot_field(line: word, wanted: int) -> word {
    give back v4_mir_snapshot_field(line, wanted)
}

task v4_borrowck_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_mir_snapshot_key_value(line, wanted_key)
}

task v4_borrowck_snapshot_result_total() -> int {
    v4_borrowck_init()
    pilot total = 0
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        total += v4_borrowck_result_count(borrow_id)
        borrow_id += 1
    }
    give back total
}

task v4_borrowck_snapshot_path_total() -> int {
    v4_borrowck_init()
    pilot total = 0
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        total += v4_borrowck_path_count(borrow_id)
        borrow_id += 1
    }
    give back total
}

task v4_borrowck_snapshot_diag_total() -> int {
    v4_borrowck_init()
    pilot total = 0
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        total += v4_borrowck_diag_count(borrow_id)
        borrow_id += 1
    }
    give back total
}

task v4_borrowck_snapshot_summary() -> word {
    pilot summary = "borrowck-snapshot"
    summary = summary + " format=" + v4_borrowck_snapshot_format
    summary = summary + " files=" + word_from_int(v4_borrowck_file_count())
    summary = summary + " results=" + word_from_int(v4_borrowck_snapshot_result_total())
    summary = summary + " paths=" + word_from_int(v4_borrowck_snapshot_path_total())
    summary = summary + " diagnostics=" + word_from_int(v4_borrowck_snapshot_diag_total())
    give back summary
}

task v4_borrowck_snapshot_header() -> word {
    pilot out = "borrowck-snapshot"
    out = out + "|format=" + v4_borrowck_snapshot_format
    out = out + "|files=" + word_from_int(v4_borrowck_file_count())
    out = out + "|results=" + word_from_int(v4_borrowck_snapshot_result_total())
    out = out + "|paths=" + word_from_int(v4_borrowck_snapshot_path_total())
    out = out + "|diagnostics=" + word_from_int(v4_borrowck_snapshot_diag_total())
    give back out
}

task v4_borrowck_snapshot_file_line(borrow_id: int) -> word {
    pilot out = "borrowck"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(v4_borrowck_file_id(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_mir_id(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_result_count(borrow_id))
    out = out + "|" + word_from_int(v4_borrowck_diag_count(borrow_id))
    give back out
}

task v4_borrowck_snapshot_result_line(borrow_id: int, result_id: int) -> word {
    pilot out = "borrowck-result"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(result_id)
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_result_def(borrow_id, result_id))
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_result_name(borrow_id, result_id))
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_result_status(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_loans(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_moves(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_drops(borrow_id, result_id))
    out = out + "|" + word_from_int(v4_borrowck_result_path_count(borrow_id, result_id))
    give back out
}

task v4_borrowck_snapshot_path_line(borrow_id: int, result_id: int, path_id: int) -> word {
    pilot out = "borrowck-path"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(result_id)
    out = out + "|" + word_from_int(path_id)
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_path_kind(borrow_id, result_id, path_id))
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_path_text(borrow_id, result_id, path_id))
    out = out + "|" + word_from_int(v4_borrowck_path_stmt(borrow_id, result_id, path_id))
    out = out + "|" + word_from_int(v4_borrowck_path_block(borrow_id, result_id, path_id))
    give back out
}

task v4_borrowck_snapshot_diag_line(borrow_id: int, diag_id: int) -> word {
    pilot out = "borrowck-diag"
    out = out + "|" + word_from_int(borrow_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_borrowck_snapshot_escape(v4_borrowck_diag(borrow_id, diag_id))
    give back out
}

task v4_borrowck_snapshot() -> word {
    v4_borrowck_init()
    pilot out = v4_borrowck_snapshot_header()
    pilot borrow_id = 0
    repeat until borrow_id >= v4_borrowck_file_count() {
        out = out + "\n" + v4_borrowck_snapshot_file_line(borrow_id)

        pilot result_id = 0
        pilot result_count = v4_borrowck_result_count(borrow_id)
        repeat until result_id >= result_count {
            out = out + "\n" + v4_borrowck_snapshot_result_line(borrow_id, result_id)

            pilot path_id = 0
            pilot path_count = v4_borrowck_result_path_count(borrow_id, result_id)
            repeat until path_id >= path_count {
                out = out + "\n" + v4_borrowck_snapshot_path_line(borrow_id, result_id, path_id)
                path_id += 1
            }
            result_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_borrowck_diag_count(borrow_id)
        repeat until diag_id >= diag_count {
            out = out + "\n" + v4_borrowck_snapshot_diag_line(borrow_id, diag_id)
            diag_id += 1
        }
        borrow_id += 1
    }
    out = out + "\nend|" + v4_borrowck_snapshot_format
    give back out
}

task v4_borrowck_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "borrowck-snapshot" { give back 6 }
    if kind == "borrowck" { give back 6 }
    if kind == "borrowck-result" { give back 10 }
    if kind == "borrowck-path" { give back 8 }
    if kind == "borrowck-diag" { give back 4 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_borrowck_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_borrowck_snapshot_field_raw(line, 0)
    pilot expected = v4_borrowck_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_borrowck_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_borrowck_snapshot_validate(payload: word) -> word {
    pilot lines = v4_borrowck_snapshot_line_count(payload)
    pilot files = 0
    pilot results = 0
    pilot paths = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_borrowck_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_borrowck_snapshot_field_raw(line, 0)
            if v4_borrowck_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "borrowck-snapshot" {
                saw_header += 1
                format = v4_borrowck_snapshot_key_value(line, "format")
                if format != v4_borrowck_snapshot_format {
                    malformed += 1
                }
            } else if kind == "borrowck" {
                files += 1
            } else if kind == "borrowck-result" {
                results += 1
            } else if kind == "borrowck-path" {
                paths += 1
            } else if kind == "borrowck-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_borrowck_snapshot_field(line, 1) != v4_borrowck_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "borrowck-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " results=" + word_from_int(results)
    out = out + " paths=" + word_from_int(paths)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_borrowck_restore_file_slot(borrow_id: int, file_id: int, mir_id: int) -> int {
    v4_borrowck_init()
    repeat until array_len(v4_borrowck_files) > borrow_id {
        v4_borrowck_file_new(0, 0)
    }

    array_set(v4_borrowck_files, borrow_id, word_from_int(file_id))
    array_set(v4_borrowck_mirs, borrow_id, word_from_int(mir_id))
    array_set(v4_borrowck_body_defs, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_body_names, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_statuses, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_loan_counts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_move_counts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_drop_counts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_kinds, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_texts, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_stmt_ids, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_block_ids, borrow_id, word_from_int(array_new()))
    array_set(v4_borrowck_diags, borrow_id, word_from_int(array_new()))
    give back borrow_id
}

task v4_borrowck_restore_result_slot(borrow_id: int, result_id: int, def_id: word, body_name: word, status: word, loans: int, moves: int, drops: int) -> int {
    if v4_borrowck_file_exists(borrow_id) == false {
        give back 0
    }
    repeat until v4_borrowck_result_count(borrow_id) > result_id {
        v4_borrowck_add_result(borrow_id, "", "", v4_borrowck_clean, 0, 0, 0)
    }

    array_set(v4_borrowck_defs_handle(borrow_id), result_id, def_id)
    array_set(v4_borrowck_names_handle(borrow_id), result_id, body_name)
    array_set(v4_borrowck_statuses_handle(borrow_id), result_id, status)
    array_set(v4_borrowck_loans_handle(borrow_id), result_id, word_from_int(loans))
    array_set(v4_borrowck_moves_handle(borrow_id), result_id, word_from_int(moves))
    array_set(v4_borrowck_drops_handle(borrow_id), result_id, word_from_int(drops))
    array_set(v4_borrowck_path_kinds_index_handle(borrow_id), result_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_texts_index_handle(borrow_id), result_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_stmt_ids_index_handle(borrow_id), result_id, word_from_int(array_new()))
    array_set(v4_borrowck_path_block_ids_index_handle(borrow_id), result_id, word_from_int(array_new()))
    give back 1
}

task v4_borrowck_result_slot_exists(borrow_id: int, result_id: int) -> bool {
    if v4_borrowck_file_exists(borrow_id) == false { give back false }
    if result_id < 0 { give back false }
    if result_id >= v4_borrowck_result_count(borrow_id) { give back false }
    give back true
}

task v4_borrowck_restore_path_slot(borrow_id: int, result_id: int, path_id: int, path_kind: word, path_text: word, stmt_id: int, block_id: int) -> int {
    if v4_borrowck_result_slot_exists(borrow_id, result_id) == false {
        give back 0
    }
    repeat until v4_borrowck_result_path_count(borrow_id, result_id) > path_id {
        array_push(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), "")
        array_push(v4_borrowck_result_path_texts_handle(borrow_id, result_id), "")
        array_push(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), word_from_int(0 - 1))
        array_push(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), word_from_int(0 - 1))
    }
    array_set(v4_borrowck_result_path_kinds_handle(borrow_id, result_id), path_id, path_kind)
    array_set(v4_borrowck_result_path_texts_handle(borrow_id, result_id), path_id, path_text)
    array_set(v4_borrowck_result_path_stmt_ids_handle(borrow_id, result_id), path_id, word_from_int(stmt_id))
    array_set(v4_borrowck_result_path_block_ids_handle(borrow_id, result_id), path_id, word_from_int(block_id))
    give back 1
}

task v4_borrowck_restore_diag_slot(borrow_id: int, diag_id: int, diag: word) -> int {
    if v4_borrowck_file_exists(borrow_id) == false {
        give back 0
    }
    repeat until v4_borrowck_diag_count(borrow_id) > diag_id {
        array_push(v4_borrowck_diags_handle(borrow_id), "")
    }
    array_set(v4_borrowck_diags_handle(borrow_id), diag_id, diag)
    give back 1
}

task v4_borrowck_snapshot_restore_file_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot mir_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 3))
    v4_borrowck_restore_file_slot(borrow_id, file_id, mir_id)
    give back 1
}

task v4_borrowck_snapshot_restore_result_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck-result" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot result_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot def_id = v4_borrowck_snapshot_field(line, 3)
    pilot body_name = v4_borrowck_snapshot_field(line, 4)
    pilot status = v4_borrowck_snapshot_field(line, 5)
    pilot loans = word_to_int(v4_borrowck_snapshot_field_raw(line, 6))
    pilot moves = word_to_int(v4_borrowck_snapshot_field_raw(line, 7))
    pilot drops = word_to_int(v4_borrowck_snapshot_field_raw(line, 8))
    give back v4_borrowck_restore_result_slot(borrow_id, result_id, def_id, body_name, status, loans, moves, drops)
}

task v4_borrowck_snapshot_restore_path_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck-path" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot result_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot path_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 3))
    pilot path_kind = v4_borrowck_snapshot_field(line, 4)
    pilot path_text = v4_borrowck_snapshot_field(line, 5)
    pilot stmt_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 6))
    pilot block_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 7))
    give back v4_borrowck_restore_path_slot(borrow_id, result_id, path_id, path_kind, path_text, stmt_id, block_id)
}

task v4_borrowck_snapshot_restore_diag_line(line: word) -> int {
    if v4_borrowck_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_borrowck_snapshot_field_raw(line, 0) != "borrowck-diag" { give back 0 }
    pilot borrow_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_borrowck_snapshot_field_raw(line, 2))
    pilot diag = v4_borrowck_snapshot_field(line, 3)
    give back v4_borrowck_restore_diag_slot(borrow_id, diag_id, diag)
}

task v4_borrowck_snapshot_restore(payload: word) -> word {
    pilot validation = v4_borrowck_snapshot_validate(payload)
    if validation.starts_with("borrowck-snapshot-import ok=1") == false {
        give back "borrowck-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_files = 0
    pilot restored_results = 0
    pilot restored_paths = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_borrowck_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_borrowck_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_borrowck_snapshot_field_raw(line, 0)
            if kind == "borrowck" {
                restored_files += v4_borrowck_snapshot_restore_file_line(line)
            } else if kind == "borrowck-result" {
                restored_results += v4_borrowck_snapshot_restore_result_line(line)
            } else if kind == "borrowck-path" {
                restored_paths += v4_borrowck_snapshot_restore_path_line(line)
            } else if kind == "borrowck-diag" {
                restored_diagnostics += v4_borrowck_snapshot_restore_diag_line(line)
            } else if kind != "borrowck-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "borrowck-snapshot-restore ok=1"
    out = out + " files=" + word_from_int(restored_files)
    out = out + " results=" + word_from_int(restored_results)
    out = out + " paths=" + word_from_int(restored_paths)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-files=" + word_from_int(v4_borrowck_file_count())
    give back out
}
