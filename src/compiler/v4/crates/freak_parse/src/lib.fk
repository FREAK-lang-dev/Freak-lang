-- ===================================================================
-- freak_parse - V4 resilient parser prototype
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_lex.
-- This first parser slice indexes top-level items and records ErrorNode
-- and IncompleteNode entries instead of aborting on malformed source.

pilot v4_node_source_file = "SourceFile"
pilot v4_node_task = "TaskDecl"
pilot v4_node_shape = "ShapeDecl"
pilot v4_node_route = "RouteDecl"
pilot v4_node_alias = "AliasDecl"
pilot v4_node_const = "ConstDecl"
pilot v4_node_impl = "ImplDecl"
pilot v4_node_doctrine = "DoctrineDecl"
pilot v4_node_use = "UseImport"
pilot v4_node_extern = "ExternBlock"
pilot v4_node_attribute = "Attribute"
pilot v4_node_closure = "ClosureExpr"
pilot v4_node_closure_param = "ClosureParam"
pilot v4_node_closure_body = "ClosureBody"
pilot v4_node_error = "ErrorNode"
pilot v4_node_incomplete = "IncompleteNode"
pilot v4_parse_snapshot_format = "freak-parse-snapshot-v1"

pilot v4_parse_tree_files = 0
pilot v4_parse_tree_streams = 0
pilot v4_parse_tree_node_kinds = 0
pilot v4_parse_tree_node_values = 0
pilot v4_parse_tree_node_spans = 0
pilot v4_parse_tree_node_parents = 0
pilot v4_parse_tree_diags = 0
pilot v4_parse_ready = 0

task v4_parse_init() -> void {
    if v4_parse_ready == 0 {
        v4_parse_tree_files = array_new()
        v4_parse_tree_streams = array_new()
        v4_parse_tree_node_kinds = array_new()
        v4_parse_tree_node_values = array_new()
        v4_parse_tree_node_spans = array_new()
        v4_parse_tree_node_parents = array_new()
        v4_parse_tree_diags = array_new()
        v4_parse_ready = 1
    }
}

task v4_parse_tree_new(file_id: int, stream_id: int) -> int {
    v4_parse_init()
    pilot tree_id = array_len(v4_parse_tree_files)
    array_push(v4_parse_tree_files, word_from_int(file_id))
    array_push(v4_parse_tree_streams, word_from_int(stream_id))
    array_push(v4_parse_tree_node_kinds, word_from_int(array_new()))
    array_push(v4_parse_tree_node_values, word_from_int(array_new()))
    array_push(v4_parse_tree_node_spans, word_from_int(array_new()))
    array_push(v4_parse_tree_node_parents, word_from_int(array_new()))
    array_push(v4_parse_tree_diags, word_from_int(array_new()))
    give back tree_id
}

task v4_parse_kinds_handle(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_node_kinds, tree_id))
}

task v4_parse_values_handle(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_node_values, tree_id))
}

task v4_parse_spans_handle(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_node_spans, tree_id))
}

task v4_parse_parents_handle(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_node_parents, tree_id))
}

task v4_parse_diags_handle(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_diags, tree_id))
}

task v4_parse_file_id(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_files, tree_id))
}

task v4_parse_stream_id(tree_id: int) -> int {
    give back word_to_int(array_get(v4_parse_tree_streams, tree_id))
}

task v4_parse_tree_count() -> int {
    v4_parse_init()
    give back array_len(v4_parse_tree_files)
}

task v4_parse_tree_exists(tree_id: int) -> bool {
    v4_parse_init()
    if tree_id < 0 {
        give back false
    }
    if tree_id >= array_len(v4_parse_tree_files) {
        give back false
    }
    give back true
}

task v4_parse_add_node(tree_id: int, node_kind: word, value: word, span: word, parent: int) -> int {
    pilot node_id = array_len(v4_parse_kinds_handle(tree_id))
    array_push(v4_parse_kinds_handle(tree_id), node_kind)
    array_push(v4_parse_values_handle(tree_id), value)
    array_push(v4_parse_spans_handle(tree_id), span)
    array_push(v4_parse_parents_handle(tree_id), word_from_int(parent))
    give back node_id
}

task v4_parse_add_diag(tree_id: int, severity: int, span: word, message: word, help: word) -> void {
    array_push(v4_parse_diags_handle(tree_id), v4_diag_new(severity, span, message, help))
}

task v4_parse_node_count(tree_id: int) -> int {
    give back array_len(v4_parse_kinds_handle(tree_id))
}

task v4_parse_diag_count(tree_id: int) -> int {
    give back array_len(v4_parse_diags_handle(tree_id))
}

task v4_parse_node_kind(tree_id: int, node_id: int) -> word {
    give back array_get(v4_parse_kinds_handle(tree_id), node_id)
}

task v4_parse_node_value(tree_id: int, node_id: int) -> word {
    give back array_get(v4_parse_values_handle(tree_id), node_id)
}

task v4_parse_node_span(tree_id: int, node_id: int) -> word {
    give back array_get(v4_parse_spans_handle(tree_id), node_id)
}

task v4_parse_node_parent(tree_id: int, node_id: int) -> int {
    give back word_to_int(array_get(v4_parse_parents_handle(tree_id), node_id))
}

task v4_parse_child_count_by_kind(tree_id: int, parent_id: int, wanted_kind: word) -> int {
    pilot count = 0
    pilot node_id = 0
    pilot node_count = v4_parse_node_count(tree_id)
    repeat until node_id >= node_count {
        if v4_parse_node_parent(tree_id, node_id) == parent_id and v4_parse_node_kind(tree_id, node_id) == wanted_kind {
            count += 1
        }
        node_id += 1
    }
    give back count
}

task v4_parse_child_by_kind(tree_id: int, parent_id: int, wanted_kind: word, wanted: int) -> int {
    if wanted < 0 {
        give back 0 - 1
    }
    pilot found = 0
    pilot node_id = 0
    pilot node_count = v4_parse_node_count(tree_id)
    repeat until node_id >= node_count {
        if v4_parse_node_parent(tree_id, node_id) == parent_id and v4_parse_node_kind(tree_id, node_id) == wanted_kind {
            if found == wanted {
                give back node_id
            }
            found += 1
        }
        node_id += 1
    }
    give back 0 - 1
}

task v4_parse_closure_count(tree_id: int, owner_node: int) -> int {
    give back v4_parse_child_count_by_kind(tree_id, owner_node, v4_node_closure)
}

task v4_parse_closure_node(tree_id: int, owner_node: int, closure_id: int) -> int {
    give back v4_parse_child_by_kind(tree_id, owner_node, v4_node_closure, closure_id)
}

task v4_parse_closure_mode(tree_id: int, closure_node: int) -> word {
    if closure_node < 0 or closure_node >= v4_parse_node_count(tree_id) {
        give back ""
    }
    if v4_parse_node_kind(tree_id, closure_node) != v4_node_closure {
        give back ""
    }
    give back v4_parse_node_value(tree_id, closure_node)
}

task v4_parse_closure_param_count(tree_id: int, closure_node: int) -> int {
    give back v4_parse_child_count_by_kind(tree_id, closure_node, v4_node_closure_param)
}

task v4_parse_closure_param_node(tree_id: int, closure_node: int, param_id: int) -> int {
    give back v4_parse_child_by_kind(tree_id, closure_node, v4_node_closure_param, param_id)
}

task v4_parse_closure_param_name(tree_id: int, closure_node: int, param_id: int) -> word {
    pilot param_node = v4_parse_closure_param_node(tree_id, closure_node, param_id)
    if param_node < 0 {
        give back ""
    }
    give back v4_parse_node_value(tree_id, param_node)
}

task v4_parse_closure_param_span(tree_id: int, closure_node: int, param_id: int) -> word {
    pilot param_node = v4_parse_closure_param_node(tree_id, closure_node, param_id)
    if param_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_parse_node_span(tree_id, param_node)
}

task v4_parse_closure_body_node(tree_id: int, closure_node: int) -> int {
    give back v4_parse_child_by_kind(tree_id, closure_node, v4_node_closure_body, 0)
}

task v4_parse_closure_body_kind(tree_id: int, closure_node: int) -> word {
    pilot body_node = v4_parse_closure_body_node(tree_id, closure_node)
    if body_node < 0 {
        give back ""
    }
    give back v4_parse_node_value(tree_id, body_node)
}

task v4_parse_closure_body_span(tree_id: int, closure_node: int) -> word {
    pilot body_node = v4_parse_closure_body_node(tree_id, closure_node)
    if body_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_parse_node_span(tree_id, body_node)
}

task v4_parse_diag(tree_id: int, diag_id: int) -> word {
    give back array_get(v4_parse_diags_handle(tree_id), diag_id)
}

task v4_parse_token_is_trivia(stream_id: int, token_id: int) -> bool {
    give back v4_lex_token_type(stream_id, token_id) == v4_tok_trivia
}

task v4_parse_skip_trivia(stream_id: int, token_id: int) -> int {
    pilot idx = token_id
    pilot count = v4_lex_token_count(stream_id)
    repeat until idx >= count or not v4_parse_token_is_trivia(stream_id, idx) {
        idx += 1
    }
    give back idx
}

task v4_parse_is_eof(stream_id: int, token_id: int) -> bool {
    if token_id >= v4_lex_token_count(stream_id) {
        give back true
    }
    give back v4_lex_token_type(stream_id, token_id) == v4_tok_eof
}

task v4_parse_is_newline_token(stream_id: int, token_id: int) -> bool {
    if token_id >= v4_lex_token_count(stream_id) {
        give back false
    }
    give back v4_lex_token_type(stream_id, token_id) == v4_tok_trivia and v4_lex_token_value(stream_id, token_id) == "\n"
}

task v4_parse_is_top_keyword(value: word) -> bool {
    give back value == "task" or value == "shape" or value == "route" or value == "variant" or value == "alias" or value == "impl" or value == "doctrine" or value == "use" or value == "extern"
}

task v4_parse_is_fixed_pilot_keyword(stream_id: int, token_id: int) -> bool {
    if token_id < 0 or token_id >= v4_lex_token_count(stream_id) {
        give back false
    }
    if v4_lex_token_type(stream_id, token_id) != v4_tok_keyword or v4_lex_token_value(stream_id, token_id) != "fixed" {
        give back false
    }
    pilot pilot_token = v4_parse_skip_trivia(stream_id, token_id + 1)
    if pilot_token < 0 or pilot_token >= v4_lex_token_count(stream_id) {
        give back false
    }
    give back v4_lex_token_type(stream_id, pilot_token) == v4_tok_keyword and v4_lex_token_value(stream_id, pilot_token) == "pilot"
}

task v4_parse_top_keyword_text(stream_id: int, token_id: int) -> word {
    if v4_parse_is_fixed_pilot_keyword(stream_id, token_id) {
        give back "fixed pilot"
    }
    if token_id < 0 or token_id >= v4_lex_token_count(stream_id) {
        give back ""
    }
    give back v4_lex_token_value(stream_id, token_id)
}

task v4_parse_kind_for_keyword(value: word) -> word {
    if value == "task" { give back v4_node_task }
    if value == "shape" { give back v4_node_shape }
    if value == "route" { give back v4_node_route }
    if value == "variant" { give back v4_node_route }
    if value == "alias" { give back v4_node_alias }
    if value == "fixed pilot" { give back v4_node_const }
    if value == "impl" { give back v4_node_impl }
    if value == "doctrine" { give back v4_node_doctrine }
    if value == "use" { give back v4_node_use }
    if value == "extern" { give back v4_node_extern }
    give back v4_node_error
}

task v4_parse_keyword_requires_name(value: word) -> bool {
    give back value == "task" or value == "shape" or value == "route" or value == "variant" or value == "alias" or value == "fixed pilot" or value == "impl" or value == "doctrine"
}

task v4_parse_keyword_requires_body(value: word) -> bool {
    give back value == "task" or value == "shape" or value == "route" or value == "variant" or value == "impl" or value == "doctrine" or value == "extern"
}

task v4_parse_make_span(stream_id: int, start_token: int, end_token: int) -> word {
    pilot count = v4_lex_token_count(stream_id)
    if count == 0 {
        give back V4_NO_SPAN
    }
    pilot first = start_token
    if first < 0 { first = 0 }
    if first >= count { first = count - 1 }
    pilot last = end_token - 1
    if last < first { last = first }
    if last >= count { last = count - 1 }

    pilot first_span = v4_lex_token_span(stream_id, first)
    pilot last_span = v4_lex_token_span(stream_id, last)
    give back v4_span_new(v4_span_file(first_span), v4_span_start(first_span), v4_span_end(last_span))
}

task v4_parse_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot token_idx = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_idx >= token_count {
        pilot token_span = v4_lex_token_span(stream_id, token_idx)
        if v4_span_end(token_span) > offset {
            give back token_idx
        }
        token_idx += 1
    }
    give back token_count
}

task v4_parse_node_start_token(tree_id: int, node_id: int) -> int {
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot node_span = v4_parse_node_span(tree_id, node_id)
    give back v4_parse_first_token_at_or_after(stream_id, v4_span_start(node_span))
}

task v4_parse_node_end_token(tree_id: int, node_id: int) -> int {
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot node_span = v4_parse_node_span(tree_id, node_id)
    pilot end_token = v4_parse_first_token_at_or_after(stream_id, v4_span_end(node_span))
    if end_token <= v4_parse_node_start_token(tree_id, node_id) {
        end_token = v4_lex_token_count(stream_id)
    }
    give back end_token
}

task v4_parse_node_decl_keyword(tree_id: int, node_id: int) -> word {
    if v4_parse_tree_exists(tree_id) == false {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_skip_trivia(stream_id, v4_parse_node_start_token(tree_id, node_id))
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    pilot token_count = v4_lex_token_count(stream_id)
    if start_token < 0 or start_token >= token_count or start_token >= end_token {
        give back ""
    }
    give back v4_parse_top_keyword_text(stream_id, start_token)
}

task v4_parse_route_is_variant(tree_id: int, node_id: int) -> bool {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_route {
        give back false
    }
    give back v4_parse_node_decl_keyword(tree_id, node_id) == "variant"
}

task v4_parse_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            out = out + v4_lex_token_value(stream_id, idx)
        }
        idx += 1
    }
    give back out
}

task v4_parse_closure_param_type(tree_id: int, closure_node: int, param_id: int) -> word {
    pilot param_node = v4_parse_closure_param_node(tree_id, closure_node, param_id)
    if param_node < 0 {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, param_node)
    pilot end_token = v4_parse_node_end_token(tree_id, param_node)
    pilot colon_token = v4_parse_find_top_level_token(stream_id, start_token, end_token, ":")
    if colon_token < 0 {
        give back ""
    }
    give back v4_parse_text(stream_id, colon_token + 1, end_token)
}

task v4_parse_closure_body_start_token(tree_id: int, closure_node: int) -> int {
    pilot body_node = v4_parse_closure_body_node(tree_id, closure_node)
    if body_node < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot marker = v4_parse_skip_trivia(stream_id, v4_parse_node_start_token(tree_id, body_node))
    give back v4_parse_skip_trivia(stream_id, marker + 1)
}

task v4_parse_closure_body_end_token(tree_id: int, closure_node: int) -> int {
    pilot body_node = v4_parse_closure_body_node(tree_id, closure_node)
    if body_node < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot end_token = v4_parse_node_end_token(tree_id, body_node)
    if v4_parse_closure_body_kind(tree_id, closure_node) == "block" {
        pilot last = end_token - 1
        repeat until last < 0 or v4_lex_token_type(stream_id, last) != v4_tok_trivia {
            last -= 1
        }
        if last >= 0 and v4_lex_token_value(stream_id, last) == "}" {
            give back last
        }
    }
    give back end_token
}

task v4_parse_path_last_scope_separator(path: word) -> int {
    pilot idx = 0
    pilot last = 0 - 1
    repeat until idx + 1 >= path.length() {
        if path.char_at(idx) == ":" and path.char_at(idx + 1) == ":" {
            last = idx
            idx += 2
        } else {
            idx += 1
        }
    }
    give back last
}

task v4_parse_path_leaf(path: word) -> word {
    pilot sep = v4_parse_path_last_scope_separator(path)
    if sep < 0 or sep + 2 > path.length() {
        give back path
    }
    give back v4_slice(path, sep + 2, path.length())
}

task v4_parse_item_name_text(stream_id: int, start_token: int, end_token: int, keyword: word) -> word {
    pilot first = v4_parse_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }

    pilot idx = first
    pilot last_name = 0 - 1
    repeat until idx >= end_token {
        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot val = v4_lex_token_value(stream_id, idx)
        if tok_type != v4_tok_trivia {
            if keyword == "impl" and val == "for" {
                idx = end_token
            }
            if val == "<" or val == "(" or val == "{" or val == "=>" or val == "done" {
                idx = end_token
            }
            if idx >= end_token {
                -- name boundary reached
            } else if tok_type == v4_tok_ident or tok_type == v4_tok_keyword {
                last_name = idx
            } else if val == "::" {
                -- keep walking the path
            } else {
                if last_name >= first {
                    idx = end_token
                } else {
                    give back ""
                }
            }
        }
        idx += 1
    }
    if last_name < first {
        give back ""
    }
    give back v4_parse_text(stream_id, first, last_name + 1)
}

task v4_parse_use_as_token(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if v4_lex_token_value(stream_id, idx) == "as" {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_parse_use_path_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_parse_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    pilot as_token = v4_parse_use_as_token(stream_id, first, end_token)
    if as_token >= 0 {
        give back v4_parse_text(stream_id, first, as_token)
    }
    give back v4_parse_text(stream_id, first, end_token)
}

task v4_parse_use_alias_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot as_token = v4_parse_use_as_token(stream_id, start_token, end_token)
    if as_token < 0 {
        give back ""
    }
    pilot alias_token = v4_parse_skip_trivia(stream_id, as_token + 1)
    if alias_token >= end_token {
        give back ""
    }
    pilot alias_type = v4_lex_token_type(stream_id, alias_token)
    if alias_type == v4_tok_ident or alias_type == v4_tok_keyword {
        give back v4_lex_token_value(stream_id, alias_token)
    }
    give back ""
}

task v4_parse_use_binding_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot alias = v4_parse_use_alias_from_tokens(stream_id, start_token, end_token)
    if alias != "" {
        give back alias
    }
    give back v4_parse_path_leaf(v4_parse_use_path_from_tokens(stream_id, start_token, end_token))
}

task v4_parse_find_token_value(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            if v4_lex_token_value(stream_id, idx) == wanted {
                give back idx
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_parse_depth_after_token(depth: int, val: word) -> int {
    pilot next_depth = depth
    if val == "(" or val == "[" or val == "{" or val == "<" {
        next_depth += 1
    } else if val == ")" or val == "]" or val == "}" or val == ">" {
        if next_depth > 0 {
            next_depth -= 1
        }
    }
    give back next_depth
}

task v4_parse_find_top_level_token(stream_id: int, start_token: int, end_token: int, wanted: word) -> int {
    pilot depth = 0
    pilot idx = start_token
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if depth == 0 and val == wanted {
                give back idx
            }
            depth = v4_parse_depth_after_token(depth, val)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_parse_type_text_needs_separator(previous: word, before_previous: word, previous_type: word, value: word) -> bool {
    if previous == "lend" or previous == "dyn" {
        give back true
    }
    if previous == "mut" and before_previous == "lend" {
        give back true
    }
    if previous_type == v4_tok_lifetime {
        give back value != ":" and value != "+" and value != "," and value != ">" and value != ")" and value != "]" and value != ";"
    }
    give back false
}

task v4_parse_type_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot previous = ""
    pilot before_previous = ""
    pilot previous_type = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        if token_type != v4_tok_trivia and token_type != v4_tok_eof {
            pilot value = v4_lex_token_value(stream_id, idx)
            if out != "" and v4_parse_type_text_needs_separator(previous, before_previous, previous_type, value) {
                out = out + " "
            }
            out = out + value
            before_previous = previous
            previous = value
            previous_type = token_type
        }
        idx += 1
    }
    give back out
}

task v4_parse_alias_target_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot equals_token = v4_parse_find_token_value(stream_id, start_token, end_token, "=")
    if equals_token < 0 {
        give back ""
    }
    pilot target_start = v4_parse_skip_trivia(stream_id, equals_token + 1)
    if target_start >= end_token {
        give back ""
    }
    give back v4_parse_type_text(stream_id, target_start, end_token)
}

task v4_parse_const_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    give back v4_parse_item_name_text(stream_id, start_token, end_token, "fixed pilot")
}

task v4_parse_const_type_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot equals_token = v4_parse_find_top_level_token(stream_id, start_token, end_token, "=")
    if equals_token < 0 {
        give back ""
    }
    pilot colon_token = v4_parse_find_top_level_token(stream_id, start_token, equals_token, ":")
    if colon_token < 0 {
        give back ""
    }
    pilot type_start = v4_parse_skip_trivia(stream_id, colon_token + 1)
    if type_start >= equals_token {
        give back ""
    }
    give back v4_parse_text(stream_id, type_start, equals_token)
}

task v4_parse_const_init_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot equals_token = v4_parse_find_top_level_token(stream_id, start_token, end_token, "=")
    if equals_token < 0 {
        give back ""
    }
    pilot init_start = v4_parse_skip_trivia(stream_id, equals_token + 1)
    if init_start >= end_token {
        give back ""
    }
    give back v4_parse_text(stream_id, init_start, end_token)
}

task v4_parse_find_matching_token(stream_id: int, open_token: int, end_token: int, open_value: word, close_value: word) -> int {
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == open_value {
                depth += 1
            } else if val == close_value {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_parse_import_path(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_use {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    give back v4_parse_use_path_from_tokens(stream_id, start_token + 1, end_token)
}

task v4_parse_import_alias(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_use {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    give back v4_parse_use_alias_from_tokens(stream_id, start_token + 1, end_token)
}

task v4_parse_import_binding(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_use {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    give back v4_parse_use_binding_from_tokens(stream_id, start_token + 1, end_token)
}

task v4_parse_alias_target(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_alias {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    give back v4_parse_alias_target_from_tokens(stream_id, start_token + 1, end_token)
}

task v4_parse_alias_target_span(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_alias {
        give back V4_NO_SPAN
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back V4_NO_SPAN
    }

    pilot equals_token = v4_parse_find_token_value(stream_id, start_token + 1, end_token, "=")
    if equals_token < 0 {
        give back v4_parse_node_span(tree_id, node_id)
    }
    pilot target_start = v4_parse_skip_trivia(stream_id, equals_token + 1)
    if target_start >= end_token {
        give back v4_parse_node_span(tree_id, node_id)
    }
    pilot target_end = end_token
    if target_end > target_start and v4_lex_token_type(stream_id, target_end - 1) == v4_tok_eof {
        target_end -= 1
    }
    repeat until target_end <= target_start or v4_lex_token_type(stream_id, target_end - 1) != v4_tok_trivia {
        target_end -= 1
    }
    if target_end <= target_start {
        give back v4_parse_node_span(tree_id, node_id)
    }
    give back v4_parse_make_span(stream_id, target_start, target_end)
}

task v4_parse_const_type(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_const {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot pilot_token = v4_parse_skip_trivia(stream_id, start_token + 1)
    give back v4_parse_const_type_from_tokens(stream_id, pilot_token + 1, end_token)
}

task v4_parse_const_init(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_const {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot pilot_token = v4_parse_skip_trivia(stream_id, start_token + 1)
    give back v4_parse_const_init_from_tokens(stream_id, pilot_token + 1, end_token)
}

task v4_parse_attribute_arg_text(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_attribute {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }

    give back v4_parse_attribute_arg_text_from_tokens(stream_id, start_token, end_token)
}

task v4_parse_attribute_arg_text_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot name_token = v4_parse_skip_trivia(stream_id, start_token + 1)
    if name_token >= end_token {
        give back ""
    }
    pilot open_token = v4_parse_skip_trivia(stream_id, name_token + 1)
    if open_token >= end_token or v4_lex_token_value(stream_id, open_token) != "(" {
        give back ""
    }
    pilot close_token = v4_parse_find_matching_token(stream_id, open_token, end_token, "(", ")")
    if close_token < 0 {
        give back ""
    }
    pilot arg_start = v4_parse_skip_trivia(stream_id, open_token + 1)
    if arg_start >= close_token {
        give back ""
    }
    give back v4_parse_text(stream_id, arg_start, close_token)
}

task v4_parse_extern_abi(tree_id: int, node_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_parse_extern_abi_open_token(tree_id, node_id)
    pilot close_token = v4_parse_extern_abi_close_token(tree_id, node_id)
    if close_token < 0 {
        give back ""
    }
    pilot abi_start = v4_parse_skip_trivia(stream_id, open_token + 1)
    if abi_start >= close_token {
        give back ""
    }
    give back v4_parse_text(stream_id, abi_start, close_token)
}

task v4_parse_extern_abi_open_token(tree_id: int, node_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }

    pilot open_token = v4_parse_skip_trivia(stream_id, start_token + 1)
    if open_token >= end_token or v4_lex_token_value(stream_id, open_token) != "[" {
        give back 0 - 1
    }
    give back open_token
}

task v4_parse_extern_abi_close_token(tree_id: int, node_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_parse_extern_abi_open_token(tree_id, node_id)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_parse_find_matching_token(stream_id, open_token, v4_parse_node_end_token(tree_id, node_id), "[", "]")
}

task v4_parse_extern_body_open_token(tree_id: int, node_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_node_start_token(tree_id, node_id)
    pilot end_token = v4_parse_node_end_token(tree_id, node_id)
    if start_token < 0 or end_token <= start_token {
        give back 0 - 1
    }
    give back v4_parse_find_token_value(stream_id, start_token, end_token, "{")
}

task v4_parse_extern_body_close_token(tree_id: int, node_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_parse_extern_body_open_token(tree_id, node_id)
    if open_token < 0 {
        give back 0 - 1
    }
    give back v4_parse_find_matching_token(stream_id, open_token, v4_parse_node_end_token(tree_id, node_id), "{", "}")
}

task v4_parse_extern_member_count(tree_id: int, node_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back 0
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_parse_extern_body_open_token(tree_id, node_id)
    pilot close_token = v4_parse_extern_body_close_token(tree_id, node_id)
    if open_token < 0 or close_token <= open_token {
        give back 0
    }

    pilot count = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_parse_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            count += 1
            pilot next = v4_parse_skip_item(stream_id, idx)
            if next <= idx {
                idx += 1
            } else if next > close_token {
                idx = close_token
            } else {
                idx = next
            }
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_parse_extern_member_start_token(tree_id: int, node_id: int, member_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern or member_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot open_token = v4_parse_extern_body_open_token(tree_id, node_id)
    pilot close_token = v4_parse_extern_body_close_token(tree_id, node_id)
    if open_token < 0 or close_token <= open_token {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = open_token + 1
    repeat until idx >= close_token {
        idx = v4_parse_skip_trivia(stream_id, idx)
        if idx >= close_token {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "task" {
            if current == member_id {
                give back idx
            }
            current += 1
            pilot next = v4_parse_skip_item(stream_id, idx)
            if next <= idx {
                idx += 1
            } else if next > close_token {
                idx = close_token
            } else {
                idx = next
            }
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_parse_extern_member_end_token(tree_id: int, node_id: int, member_id: int) -> int {
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_extern_member_start_token(tree_id, node_id, member_id)
    pilot close_token = v4_parse_extern_body_close_token(tree_id, node_id)
    if start_token < 0 or close_token <= start_token {
        give back 0 - 1
    }
    pilot end_token = v4_parse_skip_item(stream_id, start_token)
    if end_token <= start_token {
        give back 0 - 1
    }
    if end_token > close_token {
        give back close_token
    }
    give back end_token
}

task v4_parse_extern_member_name(tree_id: int, node_id: int, member_id: int) -> word {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern {
        give back ""
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_extern_member_start_token(tree_id, node_id, member_id)
    pilot end_token = v4_parse_extern_member_end_token(tree_id, node_id, member_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    give back v4_parse_item_name_text(stream_id, start_token + 1, end_token, "task")
}

task v4_parse_extern_member_attr_search_start(tree_id: int, node_id: int, member_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern or member_id < 0 {
        give back 0 - 1
    }
    if member_id == 0 {
        give back v4_parse_extern_body_open_token(tree_id, node_id) + 1
    }
    give back v4_parse_extern_member_end_token(tree_id, node_id, member_id - 1)
}

task v4_parse_extern_member_attribute_count(tree_id: int, node_id: int, member_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern or member_id < 0 {
        give back 0
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot search_start = v4_parse_extern_member_attr_search_start(tree_id, node_id, member_id)
    pilot member_start = v4_parse_extern_member_start_token(tree_id, node_id, member_id)
    if search_start < 0 or member_start <= search_start {
        give back 0
    }

    pilot count = 0
    pilot idx = search_start
    repeat until idx >= member_start {
        idx = v4_parse_skip_trivia(stream_id, idx)
        if idx >= member_start {
            give back count
        }
        if v4_lex_token_value(stream_id, idx) == "@" {
            count += 1
            pilot next = v4_parse_skip_attribute(stream_id, idx)
            if next <= idx {
                idx += 1
            } else if next > member_start {
                idx = member_start
            } else {
                idx = next
            }
        } else {
            idx += 1
        }
    }
    give back count
}

task v4_parse_extern_member_attribute_start_token(tree_id: int, node_id: int, member_id: int, attr_id: int) -> int {
    if v4_parse_node_kind(tree_id, node_id) != v4_node_extern or member_id < 0 or attr_id < 0 {
        give back 0 - 1
    }
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot search_start = v4_parse_extern_member_attr_search_start(tree_id, node_id, member_id)
    pilot member_start = v4_parse_extern_member_start_token(tree_id, node_id, member_id)
    if search_start < 0 or member_start <= search_start {
        give back 0 - 1
    }

    pilot current = 0
    pilot idx = search_start
    repeat until idx >= member_start {
        idx = v4_parse_skip_trivia(stream_id, idx)
        if idx >= member_start {
            give back 0 - 1
        }
        if v4_lex_token_value(stream_id, idx) == "@" {
            if current == attr_id {
                give back idx
            }
            current += 1
            pilot next = v4_parse_skip_attribute(stream_id, idx)
            if next <= idx {
                idx += 1
            } else if next > member_start {
                idx = member_start
            } else {
                idx = next
            }
        } else {
            idx += 1
        }
    }
    give back 0 - 1
}

task v4_parse_extern_member_attribute_end_token(tree_id: int, node_id: int, member_id: int, attr_id: int) -> int {
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_extern_member_attribute_start_token(tree_id, node_id, member_id, attr_id)
    pilot member_start = v4_parse_extern_member_start_token(tree_id, node_id, member_id)
    if start_token < 0 or member_start <= start_token {
        give back 0 - 1
    }
    pilot end_token = v4_parse_skip_attribute(stream_id, start_token)
    if end_token <= start_token {
        give back 0 - 1
    }
    if end_token > member_start {
        give back member_start
    }
    give back end_token
}

task v4_parse_extern_member_attribute_name(tree_id: int, node_id: int, member_id: int, attr_id: int) -> word {
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_extern_member_attribute_start_token(tree_id, node_id, member_id, attr_id)
    pilot end_token = v4_parse_extern_member_attribute_end_token(tree_id, node_id, member_id, attr_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    pilot name_token = v4_parse_skip_trivia(stream_id, start_token + 1)
    if name_token >= end_token {
        give back ""
    }
    give back v4_lex_token_value(stream_id, name_token)
}

task v4_parse_extern_member_attribute_arg(tree_id: int, node_id: int, member_id: int, attr_id: int) -> word {
    pilot stream_id = v4_parse_stream_id(tree_id)
    pilot start_token = v4_parse_extern_member_attribute_start_token(tree_id, node_id, member_id, attr_id)
    pilot end_token = v4_parse_extern_member_attribute_end_token(tree_id, node_id, member_id, attr_id)
    if start_token < 0 or end_token <= start_token {
        give back ""
    }
    give back v4_parse_attribute_arg_text_from_tokens(stream_id, start_token, end_token)
}

task v4_parse_item_has_body(stream_id: int, start_token: int, end_token: int) -> bool {
    pilot idx = start_token
    repeat until idx >= end_token {
        pilot val = v4_lex_token_value(stream_id, idx)
        if val == "{" or val == "=>" or val == "done" {
            give back true
        }
        idx += 1
    }
    give back false
}

task v4_parse_skip_item(stream_id: int, start_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    pilot saw_body = false
    pilot count = v4_lex_token_count(stream_id)

    repeat until idx >= count {
        if v4_parse_is_eof(stream_id, idx) {
            give back idx
        }

        if v4_parse_is_newline_token(stream_id, idx) and not saw_body {
            give back idx + 1
        }

        if not v4_parse_token_is_trivia(stream_id, idx) {
            pilot val = v4_lex_token_value(stream_id, idx)
            if val == "{" {
                depth += 1
                saw_body = true
            } else if val == "}" {
                if depth > 0 {
                    depth -= 1
                }
                if saw_body and depth == 0 {
                    give back idx + 1
                }
            } else if val == "done" {
                if saw_body {
                    give back idx + 1
                }
            }
        }
        idx += 1
    }
    give back idx
}

task v4_parse_skip_attribute(stream_id: int, start_token: int) -> int {
    pilot count = v4_lex_token_count(stream_id)
    pilot name_token = v4_parse_skip_trivia(stream_id, start_token + 1)
    if name_token >= count {
        give back start_token + 1
    }

    pilot open_token = v4_parse_skip_trivia(stream_id, name_token + 1)
    if open_token < count and v4_lex_token_value(stream_id, open_token) == "(" {
        pilot close_token = v4_parse_find_matching_token(stream_id, open_token, count, "(", ")")
        if close_token >= 0 {
            give back close_token + 1
        }
        give back open_token + 1
    }
    give back name_token + 1
}

task v4_parse_add_incomplete(tree_id: int, parent: int, span: word, missing: word) -> void {
    v4_parse_add_node(tree_id, v4_node_incomplete, missing, span, parent)
    v4_parse_add_diag(tree_id, v4_diag_error, span, "incomplete syntax node", missing)
}

task v4_parse_closure_mode_at(stream_id: int, token_id: int, end_token: int) -> word {
    if token_id < 0 or token_id >= end_token {
        give back ""
    }
    pilot value = v4_lex_token_value(stream_id, token_id)
    if value == "|" {
        give back "borrow"
    }
    if value != "copy" and value != "move" and value != "mut" {
        give back ""
    }
    pilot open_token = v4_parse_skip_trivia(stream_id, token_id + 1)
    if open_token < end_token and v4_lex_token_value(stream_id, open_token) == "|" {
        give back value
    }
    give back ""
}

task v4_parse_closure_open_token(stream_id: int, token_id: int, end_token: int) -> int {
    if v4_parse_closure_mode_at(stream_id, token_id, end_token) == "" {
        give back 0 - 1
    }
    if v4_lex_token_value(stream_id, token_id) == "|" {
        give back token_id
    }
    give back v4_parse_skip_trivia(stream_id, token_id + 1)
}

task v4_parse_closure_close_pipe(stream_id: int, open_token: int, end_token: int) -> int {
    pilot idx = open_token + 1
    pilot depth = 0
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot token_value = v4_lex_token_value(stream_id, idx)
        if token_type == v4_tok_trivia and token_value == "\n" and depth == 0 {
            -- A malformed header must not steal the opening pipe from the next line.
            give back 0 - 1
        }
        if token_type != v4_tok_trivia {
            pilot value = token_value
            if value == "(" or value == "[" or value == "<" {
                depth += 1
            } else if value == ")" or value == "]" or value == ">" {
                if depth > 0 { depth -= 1 }
            } else if value == "|" and depth == 0 {
                give back idx
            } else if value == "{" or value == "}" or value == ";" {
                give back 0 - 1
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_parse_closure_expr_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot value = v4_lex_token_value(stream_id, idx)
        if token_type != v4_tok_trivia {
            if value == "(" or value == "[" or value == "{" {
                depth += 1
            } else if value == ")" or value == "]" or value == "}" {
                if depth == 0 {
                    give back idx
                }
                depth -= 1
            } else if (value == "," or value == ";") and depth == 0 {
                give back idx
            }
        } else if value == "\n" and depth == 0 {
            give back idx
        }
        idx += 1
    }
    give back end_token
}

task v4_parse_closure_param_name_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_parse_skip_trivia(stream_id, start_token)
    if first >= end_token {
        give back ""
    }
    pilot token_type = v4_lex_token_type(stream_id, first)
    if token_type != v4_tok_ident and token_type != v4_tok_keyword {
        give back ""
    }
    give back v4_lex_token_value(stream_id, first)
}

task v4_parse_add_closure_params(tree_id: int, stream_id: int, closure_node: int, open_token: int, close_token: int) -> void {
    pilot segment_start = open_token + 1
    pilot idx = segment_start
    pilot depth = 0
    repeat until idx > close_token {
        pilot split = idx == close_token
        if idx < close_token and v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "(" or value == "[" or value == "<" {
                depth += 1
            } else if value == ")" or value == "]" or value == ">" {
                if depth > 0 { depth -= 1 }
            } else if value == "," and depth == 0 {
                split = true
            }
        }
        if split {
            pilot first = v4_parse_skip_trivia(stream_id, segment_start)
            if first < idx {
                pilot param_span = v4_parse_make_span(stream_id, segment_start, idx)
                pilot param_name = v4_parse_closure_param_name_from_tokens(stream_id, segment_start, idx)
                pilot param_node = v4_parse_add_node(tree_id, v4_node_closure_param, param_name, param_span, closure_node)
                if param_name == "" {
                    v4_parse_add_incomplete(tree_id, param_node, param_span, "expected closure parameter name")
                }
            }
            segment_start = idx + 1
        }
        idx += 1
    }
}

task v4_parse_parse_closures_in_item(tree_id: int, stream_id: int, start_token: int, end_token: int, item_node: int) -> void {
    pilot idx = start_token
    repeat until idx >= end_token {
        idx = v4_parse_skip_trivia(stream_id, idx)
        if idx >= end_token {
            give back
        }

        pilot mode = v4_parse_closure_mode_at(stream_id, idx, end_token)
        if mode == "" {
            idx += 1
        } else {
            pilot open_token = v4_parse_closure_open_token(stream_id, idx, end_token)
            pilot close_token = v4_parse_closure_close_pipe(stream_id, open_token, end_token)
            pilot recovery_end = idx + 1
            if close_token < 0 {
                pilot closure_span = v4_parse_make_span(stream_id, idx, recovery_end)
                pilot closure_node = v4_parse_add_node(tree_id, v4_node_closure, mode, closure_span, item_node)
                v4_parse_add_incomplete(tree_id, closure_node, closure_span, "expected | after closure parameters")
                idx = recovery_end
            } else {
                pilot body_marker = v4_parse_skip_trivia(stream_id, close_token + 1)
                pilot closure_end = body_marker
                pilot body_end = body_marker
                pilot body_kind = ""
                if body_marker < end_token and v4_lex_token_value(stream_id, body_marker) == "=>" {
                    pilot body_start = v4_parse_skip_trivia(stream_id, body_marker + 1)
                    body_end = v4_parse_closure_expr_end(stream_id, body_start, end_token)
                    closure_end = body_end
                    body_kind = "expr"
                } else if body_marker < end_token and v4_lex_token_value(stream_id, body_marker) == "{" {
                    pilot close_body = v4_parse_find_matching_token(stream_id, body_marker, end_token, "{", "}")
                    if close_body >= 0 {
                        body_end = close_body + 1
                        closure_end = body_end
                        body_kind = "block"
                    }
                }

                if closure_end <= idx {
                    closure_end = close_token + 1
                }
                pilot closure_span = v4_parse_make_span(stream_id, idx, closure_end)
                pilot closure_node = v4_parse_add_node(tree_id, v4_node_closure, mode, closure_span, item_node)
                v4_parse_add_closure_params(tree_id, stream_id, closure_node, open_token, close_token)
                if body_kind == "" {
                    v4_parse_add_incomplete(tree_id, closure_node, closure_span, "expected => or { after closure parameters")
                } else {
                    pilot body_span = v4_parse_make_span(stream_id, body_marker, body_end)
                    v4_parse_add_node(tree_id, v4_node_closure_body, body_kind, body_span, closure_node)
                    if body_kind == "expr" and v4_parse_skip_trivia(stream_id, body_marker + 1) >= body_end {
                        v4_parse_add_incomplete(tree_id, closure_node, body_span, "expected expression after closure =>")
                    }
                }
                idx = closure_end
            }
        }
    }
}

task v4_parse_parse_attribute(tree_id: int, stream_id: int, token_id: int, root_id: int) -> int {
    pilot start_token = token_id
    pilot name_token = v4_parse_skip_trivia(stream_id, token_id + 1)
    pilot end_token = v4_parse_skip_attribute(stream_id, token_id)
    pilot attr_name = ""
    if name_token < v4_lex_token_count(stream_id) {
        attr_name = v4_lex_token_value(stream_id, name_token)
    }
    pilot attr_span = v4_parse_make_span(stream_id, start_token, end_token)
    pilot attr_node = v4_parse_add_node(tree_id, v4_node_attribute, attr_name, attr_span, root_id)
    if attr_name == "" {
        v4_parse_add_incomplete(tree_id, attr_node, attr_span, "expected attribute name after @")
    }
    give back end_token
}

task v4_parse_parse_top_item(tree_id: int, stream_id: int, token_id: int, root_id: int) -> int {
    pilot keyword = v4_parse_top_keyword_text(stream_id, token_id)
    pilot node_kind = v4_parse_kind_for_keyword(keyword)
    pilot end_token = v4_parse_skip_item(stream_id, token_id)
    pilot item_span = v4_parse_make_span(stream_id, token_id, end_token)
    pilot name_value = ""

    if keyword == "fixed pilot" {
        pilot pilot_token = v4_parse_skip_trivia(stream_id, token_id + 1)
        name_value = v4_parse_const_name_from_tokens(stream_id, pilot_token + 1, end_token)
    } else if v4_parse_keyword_requires_name(keyword) {
        name_value = v4_parse_item_name_text(stream_id, token_id + 1, end_token, keyword)
    } else if keyword == "use" {
        name_value = v4_parse_use_binding_from_tokens(stream_id, token_id + 1, end_token)
    } else if keyword == "extern" {
        name_value = "extern"
    }

    pilot item_node = v4_parse_add_node(tree_id, node_kind, name_value, item_span, root_id)

    if v4_parse_keyword_requires_name(keyword) and name_value == "" {
        v4_parse_add_incomplete(tree_id, item_node, item_span, "expected name after " + keyword)
    }

    if keyword == "use" {
        if v4_parse_use_path_from_tokens(stream_id, token_id + 1, end_token) == "" {
            v4_parse_add_incomplete(tree_id, item_node, item_span, "expected import path after use")
        }
        if v4_parse_use_as_token(stream_id, token_id + 1, end_token) >= 0 {
            if v4_parse_use_alias_from_tokens(stream_id, token_id + 1, end_token) == "" {
                v4_parse_add_incomplete(tree_id, item_node, item_span, "expected alias name after as")
            }
        }
    } else if keyword == "alias" {
        if v4_parse_find_token_value(stream_id, token_id + 1, end_token, "=") < 0 {
            v4_parse_add_incomplete(tree_id, item_node, item_span, "expected = in alias")
        } else if v4_parse_alias_target_from_tokens(stream_id, token_id + 1, end_token) == "" {
            v4_parse_add_incomplete(tree_id, item_node, item_span, "expected target type after =")
        }
    } else if keyword == "fixed pilot" {
        pilot pilot_token = v4_parse_skip_trivia(stream_id, token_id + 1)
        pilot const_start = pilot_token + 1
        if v4_parse_find_top_level_token(stream_id, const_start, end_token, "=") < 0 {
            v4_parse_add_incomplete(tree_id, item_node, item_span, "expected = in fixed pilot")
        } else if v4_parse_const_init_from_tokens(stream_id, const_start, end_token) == "" {
            v4_parse_add_incomplete(tree_id, item_node, item_span, "expected constant initializer after =")
        }
    }

    if v4_parse_keyword_requires_body(keyword) {
        if not v4_parse_item_has_body(stream_id, token_id, end_token) {
            v4_parse_add_incomplete(tree_id, item_node, item_span, "expected body for " + keyword)
        }
    }

    v4_parse_parse_closures_in_item(tree_id, stream_id, token_id, end_token, item_node)

    give back end_token
}

task v4_parse_parse_error(tree_id: int, stream_id: int, token_id: int, root_id: int) -> int {
    pilot end_token = v4_parse_skip_item(stream_id, token_id)
    pilot err_span = v4_parse_make_span(stream_id, token_id, end_token)
    pilot val = v4_lex_token_value(stream_id, token_id)
    v4_parse_add_node(tree_id, v4_node_error, val, err_span, root_id)
    v4_parse_add_diag(tree_id, v4_diag_error, err_span, "unexpected token at top level", val)
    give back end_token
}

task v4_parse_stream(file_id: int, stream_id: int) -> int {
    v4_parse_init()
    pilot tree_id = v4_parse_tree_new(file_id, stream_id)
    pilot root_id = v4_parse_add_node(tree_id, v4_node_source_file, word_from_int(file_id), V4_NO_SPAN, 0 - 1)
    pilot idx = 0
    pilot count = v4_lex_token_count(stream_id)

    repeat until idx >= count {
        idx = v4_parse_skip_trivia(stream_id, idx)
        if v4_parse_is_eof(stream_id, idx) {
            give back tree_id
        }

        pilot tok_type = v4_lex_token_type(stream_id, idx)
        pilot tok_value = v4_lex_token_value(stream_id, idx)

        if tok_type == v4_tok_symbol and tok_value == "@" {
            idx = v4_parse_parse_attribute(tree_id, stream_id, idx, root_id)
        } else if tok_type == v4_tok_keyword and (v4_parse_is_top_keyword(tok_value) or v4_parse_is_fixed_pilot_keyword(stream_id, idx)) {
            idx = v4_parse_parse_top_item(tree_id, stream_id, idx, root_id)
        } else if tok_type == v4_tok_unknown {
            idx = v4_parse_parse_error(tree_id, stream_id, idx, root_id)
        } else {
            idx = v4_parse_parse_error(tree_id, stream_id, idx, root_id)
        }
    }

    give back tree_id
}

task v4_parse_summary(tree_id: int) -> word {
    pilot summary = "parse-ok tree=" + word_from_int(tree_id)
    summary = summary + " nodes=" + word_from_int(v4_parse_node_count(tree_id))
    summary = summary + " diagnostics=" + word_from_int(v4_parse_diag_count(tree_id))
    give back summary
}

task v4_parse_snapshot_escape(value: word) -> word {
    give back v4_lex_snapshot_escape(value)
}

task v4_parse_snapshot_unescape(value: word) -> word {
    give back v4_lex_snapshot_unescape(value)
}

task v4_parse_snapshot_line_count(payload: word) -> int {
    give back v4_lex_snapshot_line_count(payload)
}

task v4_parse_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_lex_snapshot_line(payload, wanted)
}

task v4_parse_snapshot_field_count(line: word) -> int {
    give back v4_lex_snapshot_field_count(line)
}

task v4_parse_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_lex_snapshot_field_raw(line, wanted)
}

task v4_parse_snapshot_field(line: word, wanted: int) -> word {
    give back v4_lex_snapshot_field(line, wanted)
}

task v4_parse_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_lex_snapshot_key_value(line, wanted_key)
}

task v4_parse_snapshot_node_total() -> int {
    v4_parse_init()
    pilot total = 0
    pilot tree_id = 0
    repeat until tree_id >= v4_parse_tree_count() {
        total += v4_parse_node_count(tree_id)
        tree_id += 1
    }
    give back total
}

task v4_parse_snapshot_diag_total() -> int {
    v4_parse_init()
    pilot total = 0
    pilot tree_id = 0
    repeat until tree_id >= v4_parse_tree_count() {
        total += v4_parse_diag_count(tree_id)
        tree_id += 1
    }
    give back total
}

task v4_parse_snapshot_summary() -> word {
    pilot summary = "parse-snapshot"
    summary = summary + " format=" + v4_parse_snapshot_format
    summary = summary + " trees=" + word_from_int(v4_parse_tree_count())
    summary = summary + " nodes=" + word_from_int(v4_parse_snapshot_node_total())
    summary = summary + " diagnostics=" + word_from_int(v4_parse_snapshot_diag_total())
    give back summary
}

task v4_parse_snapshot_header() -> word {
    pilot out = "parse-snapshot"
    out = out + "|format=" + v4_parse_snapshot_format
    out = out + "|trees=" + word_from_int(v4_parse_tree_count())
    out = out + "|nodes=" + word_from_int(v4_parse_snapshot_node_total())
    out = out + "|diagnostics=" + word_from_int(v4_parse_snapshot_diag_total())
    give back out
}

task v4_parse_snapshot_tree_line(tree_id: int) -> word {
    pilot out = "tree"
    out = out + "|" + word_from_int(tree_id)
    out = out + "|" + word_from_int(v4_parse_file_id(tree_id))
    out = out + "|" + word_from_int(v4_parse_stream_id(tree_id))
    out = out + "|" + word_from_int(v4_parse_node_count(tree_id))
    out = out + "|" + word_from_int(v4_parse_diag_count(tree_id))
    give back out
}

task v4_parse_snapshot_node_line(tree_id: int, node_id: int) -> word {
    pilot out = "node"
    out = out + "|" + word_from_int(tree_id)
    out = out + "|" + word_from_int(node_id)
    out = out + "|" + v4_parse_snapshot_escape(v4_parse_node_kind(tree_id, node_id))
    out = out + "|" + v4_parse_snapshot_escape(v4_parse_node_value(tree_id, node_id))
    out = out + "|" + v4_parse_snapshot_escape(v4_parse_node_span(tree_id, node_id))
    out = out + "|" + word_from_int(v4_parse_node_parent(tree_id, node_id))
    give back out
}

task v4_parse_snapshot_diag_line(tree_id: int, diag_id: int) -> word {
    pilot out = "parse-diag"
    out = out + "|" + word_from_int(tree_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_parse_snapshot_escape(v4_parse_diag(tree_id, diag_id))
    give back out
}

task v4_parse_snapshot() -> word {
    v4_parse_init()
    pilot parts = array_new()
    array_push(parts, v4_parse_snapshot_header())
    pilot tree_id = 0
    repeat until tree_id >= v4_parse_tree_count() {
        array_push(parts, "\n")
        array_push(parts, v4_parse_snapshot_tree_line(tree_id))

        pilot node_id = 0
        pilot node_count = v4_parse_node_count(tree_id)
        repeat until node_id >= node_count {
            array_push(parts, "\n")
            array_push(parts, v4_parse_snapshot_node_line(tree_id, node_id))
            node_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_parse_diag_count(tree_id)
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_parse_snapshot_diag_line(tree_id, diag_id))
            diag_id += 1
        }
        tree_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_parse_snapshot_format)
    give back word_join(parts)
}

task v4_parse_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "parse-snapshot" {
        give back 5
    }
    if kind == "tree" {
        give back 6
    }
    if kind == "node" {
        give back 7
    }
    if kind == "parse-diag" {
        give back 4
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_parse_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_parse_snapshot_field_raw(line, 0)
    pilot expected = v4_parse_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_parse_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_parse_snapshot_validate(payload: word) -> word {
    pilot lines = v4_parse_snapshot_line_count(payload)
    pilot trees = 0
    pilot nodes = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_parse_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_parse_snapshot_field_raw(line, 0)
            if v4_parse_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "parse-snapshot" {
                saw_header += 1
                format = v4_parse_snapshot_key_value(line, "format")
                if format != v4_parse_snapshot_format {
                    malformed += 1
                }
            } else if kind == "tree" {
                trees += 1
            } else if kind == "node" {
                nodes += 1
            } else if kind == "parse-diag" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_parse_snapshot_field(line, 1) != v4_parse_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }

    pilot out = "parse-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " trees=" + word_from_int(trees)
    out = out + " nodes=" + word_from_int(nodes)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_parse_restore_tree_slot(tree_id: int, file_id: int, stream_id: int) -> int {
    v4_parse_init()
    repeat until array_len(v4_parse_tree_files) > tree_id {
        array_push(v4_parse_tree_files, "0")
        array_push(v4_parse_tree_streams, "0")
        array_push(v4_parse_tree_node_kinds, word_from_int(array_new()))
        array_push(v4_parse_tree_node_values, word_from_int(array_new()))
        array_push(v4_parse_tree_node_spans, word_from_int(array_new()))
        array_push(v4_parse_tree_node_parents, word_from_int(array_new()))
        array_push(v4_parse_tree_diags, word_from_int(array_new()))
    }

    array_set(v4_parse_tree_files, tree_id, word_from_int(file_id))
    array_set(v4_parse_tree_streams, tree_id, word_from_int(stream_id))
    array_set(v4_parse_tree_node_kinds, tree_id, word_from_int(array_new()))
    array_set(v4_parse_tree_node_values, tree_id, word_from_int(array_new()))
    array_set(v4_parse_tree_node_spans, tree_id, word_from_int(array_new()))
    array_set(v4_parse_tree_node_parents, tree_id, word_from_int(array_new()))
    array_set(v4_parse_tree_diags, tree_id, word_from_int(array_new()))
    give back tree_id
}

task v4_parse_restore_node_slot(tree_id: int, node_id: int, node_kind: word, value: word, span: word, parent: int) -> int {
    if v4_parse_tree_exists(tree_id) == false {
        give back 0
    }
    repeat until v4_parse_node_count(tree_id) > node_id {
        array_push(v4_parse_kinds_handle(tree_id), "")
        array_push(v4_parse_values_handle(tree_id), "")
        array_push(v4_parse_spans_handle(tree_id), V4_NO_SPAN)
        array_push(v4_parse_parents_handle(tree_id), word_from_int(0 - 1))
    }
    array_set(v4_parse_kinds_handle(tree_id), node_id, node_kind)
    array_set(v4_parse_values_handle(tree_id), node_id, value)
    array_set(v4_parse_spans_handle(tree_id), node_id, span)
    array_set(v4_parse_parents_handle(tree_id), node_id, word_from_int(parent))
    give back 1
}

task v4_parse_restore_diag_slot(tree_id: int, diag_id: int, diag: word) -> int {
    if v4_parse_tree_exists(tree_id) == false {
        give back 0
    }
    repeat until array_len(v4_parse_diags_handle(tree_id)) > diag_id {
        array_push(v4_parse_diags_handle(tree_id), "")
    }
    array_set(v4_parse_diags_handle(tree_id), diag_id, diag)
    give back 1
}

task v4_parse_snapshot_restore_tree_line(line: word) -> int {
    if v4_parse_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_parse_snapshot_field_raw(line, 0) != "tree" {
        give back 0
    }
    pilot tree_id = word_to_int(v4_parse_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_parse_snapshot_field_raw(line, 2))
    pilot stream_id = word_to_int(v4_parse_snapshot_field_raw(line, 3))
    v4_parse_restore_tree_slot(tree_id, file_id, stream_id)
    give back 1
}

task v4_parse_snapshot_restore_node_line(line: word) -> int {
    if v4_parse_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_parse_snapshot_field_raw(line, 0) != "node" {
        give back 0
    }
    pilot tree_id = word_to_int(v4_parse_snapshot_field_raw(line, 1))
    pilot node_id = word_to_int(v4_parse_snapshot_field_raw(line, 2))
    pilot node_kind = v4_parse_snapshot_field(line, 3)
    pilot value = v4_parse_snapshot_field(line, 4)
    pilot span = v4_parse_snapshot_field(line, 5)
    pilot parent = word_to_int(v4_parse_snapshot_field_raw(line, 6))
    give back v4_parse_restore_node_slot(tree_id, node_id, node_kind, value, span, parent)
}

task v4_parse_snapshot_restore_diag_line(line: word) -> int {
    if v4_parse_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_parse_snapshot_field_raw(line, 0) != "parse-diag" {
        give back 0
    }
    pilot tree_id = word_to_int(v4_parse_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_parse_snapshot_field_raw(line, 2))
    pilot diag = v4_parse_snapshot_field(line, 3)
    give back v4_parse_restore_diag_slot(tree_id, diag_id, diag)
}

task v4_parse_snapshot_restore(payload: word) -> word {
    pilot validation = v4_parse_snapshot_validate(payload)
    if validation.starts_with("parse-snapshot-import ok=1") == false {
        give back "parse-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_trees = 0
    pilot restored_nodes = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_parse_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_parse_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_parse_snapshot_field_raw(line, 0)
            if kind == "tree" {
                restored_trees += v4_parse_snapshot_restore_tree_line(line)
            } else if kind == "node" {
                restored_nodes += v4_parse_snapshot_restore_node_line(line)
            } else if kind == "parse-diag" {
                restored_diagnostics += v4_parse_snapshot_restore_diag_line(line)
            } else if kind != "parse-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "parse-snapshot-restore ok=1"
    out = out + " trees=" + word_from_int(restored_trees)
    out = out + " nodes=" + word_from_int(restored_nodes)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-trees=" + word_from_int(v4_parse_tree_count())
    v4_session_semantic_restore_generation_advance()
    give back out
}
