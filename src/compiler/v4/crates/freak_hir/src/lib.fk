}

task v4_hir_add_local_annotation(hir_id: int, item_id: int, stmt_span: word, type_text: word, type_span: word) -> int {
    pilot record_id = v4_hir_local_annotation_record_count(hir_id)
    array_push(v4_hir_local_annotation_items_handle(hir_id), word_from_int(item_id))
    array_push(v4_hir_local_annotation_stmt_spans_handle(hir_id), stmt_span)
    array_push(v4_hir_local_annotation_types_handle(hir_id), type_text)
    array_push(v4_hir_local_annotation_type_spans_handle(hir_id), type_span)
    give back record_id
}

