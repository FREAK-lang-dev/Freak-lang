task v4_hir_lower_alias_target_type(hir_id: int, item_id: int, expansion_id: int, expanded_node: int) -> void {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_alias {
        give back
    }
    array_set(v4_hir_alias_target_types_handle(hir_id), item_id, v4_expand_alias_target(expansion_id, expanded_node))
    array_set(v4_hir_alias_target_spans_handle(hir_id), item_id, v4_expand_alias_target_span(expansion_id, expanded_node))
}

task v4_hir_local_annotation_record_count(hir_id: int) -> int {
    give back array_len(v4_hir_local_annotation_items_handle(hir_id))
}

task v4_hir_local_annotation_record_id(hir_id: int, item_id: int, annotation_id: int) -> int {
    if item_id < 0 or annotation_id < 0 {
        give back 0 - 1
    }
    pilot record_id = 0
    pilot local_id = 0
    pilot record_count = v4_hir_local_annotation_record_count(hir_id)
    repeat until record_id >= record_count {
        if word_to_int(array_get(v4_hir_local_annotation_items_handle(hir_id), record_id)) == item_id {
            if local_id == annotation_id {
                give back record_id
            }
            local_id += 1
        }
        record_id += 1
    }
    give back 0 - 1
}

task v4_hir_local_annotation_count(hir_id: int, item_id: int) -> int {
    pilot count = 0
    pilot record_id = 0
    pilot record_count = v4_hir_local_annotation_record_count(hir_id)
    repeat until record_id >= record_count {
        if word_to_int(array_get(v4_hir_local_annotation_items_handle(hir_id), record_id)) == item_id {
            count += 1
        }
        record_id += 1
    }
    give back count
}

task v4_hir_local_annotation_stmt_span(hir_id: int, item_id: int, annotation_id: int) -> word {
    pilot record_id = v4_hir_local_annotation_record_id(hir_id, item_id, annotation_id)
    if record_id < 0 {
        give back V4_NO_SPAN
    }
    give back array_get(v4_hir_local_annotation_stmt_spans_handle(hir_id), record_id)
}

