-- ===================================================================
-- freak_hir - V4 top-level HIR item lowering prototype
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_expand.
-- HIR is the first compiler-owned representation. This initial slice
-- lowers identity-expanded nodes into syntax-independent top-level item
-- records with stable-ish def ids and carried diagnostics.

pilot v4_hir_task = "Task"
pilot v4_hir_shape = "Shape"
pilot v4_hir_route = "Route"
pilot v4_hir_alias = "Alias"
pilot v4_hir_const = "Const"
pilot v4_hir_impl = "Impl"
pilot v4_hir_doctrine = "Doctrine"
pilot v4_hir_import = "Import"
pilot v4_hir_extern = "Extern"
pilot v4_hir_attribute = "Attribute"
pilot v4_hir_error = "Error"
pilot v4_hir_snapshot_format = "freak-hir-snapshot-v4"

pilot v4_hir_files = 0
pilot v4_hir_expansions = 0
pilot v4_hir_item_kinds = 0
pilot v4_hir_item_names = 0
pilot v4_hir_item_defs = 0
pilot v4_hir_item_spans = 0
pilot v4_hir_item_parse_nodes = 0
-- The first No Syntax Past HIR family: normalized alias target type facts.
pilot v4_hir_alias_target_types = 0
pilot v4_hir_alias_target_spans = 0
-- Task-local declaration annotations are normalized once at the HIR boundary.
-- MIR may still use body tokens for CFG and pattern boundaries, but declared
-- types and their semantic spans come from these stored facts.
pilot v4_hir_local_annotation_items = 0
pilot v4_hir_local_annotation_stmt_spans = 0
pilot v4_hir_local_annotation_types = 0
pilot v4_hir_local_annotation_type_spans = 0
pilot v4_hir_diags = 0
pilot v4_hir_file_len = 0
pilot v4_hir_ready = 0

task v4_hir_init() -> void {
    if v4_hir_ready == 0 {
        v4_hir_files = array_new()
        v4_hir_expansions = array_new()
        v4_hir_item_kinds = array_new()
        v4_hir_item_names = array_new()
        v4_hir_item_defs = array_new()
        v4_hir_item_spans = array_new()
        v4_hir_item_parse_nodes = array_new()
        v4_hir_alias_target_types = array_new()
        v4_hir_alias_target_spans = array_new()
        v4_hir_local_annotation_items = array_new()
        v4_hir_local_annotation_stmt_spans = array_new()
        v4_hir_local_annotation_types = array_new()
        v4_hir_local_annotation_type_spans = array_new()
        v4_hir_diags = array_new()
        v4_hir_file_len = 0
        v4_hir_ready = 1
    }
}

task v4_hir_file_new(file_id: int, expansion_id: int) -> int {
    v4_hir_init()
    pilot hir_id = v4_hir_file_len
    repeat until array_len(v4_hir_files) > hir_id {
        array_push(v4_hir_files, "0")
        array_push(v4_hir_expansions, "0")
        array_push(v4_hir_item_kinds, word_from_int(array_new()))
        array_push(v4_hir_item_names, word_from_int(array_new()))
        array_push(v4_hir_item_defs, word_from_int(array_new()))
        array_push(v4_hir_item_spans, word_from_int(array_new()))
        array_push(v4_hir_item_parse_nodes, word_from_int(array_new()))
        array_push(v4_hir_alias_target_types, word_from_int(array_new()))
        array_push(v4_hir_alias_target_spans, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_items, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_stmt_spans, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_types, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_type_spans, word_from_int(array_new()))
        array_push(v4_hir_diags, word_from_int(array_new()))
    }
    array_set(v4_hir_files, hir_id, word_from_int(file_id))
    array_set(v4_hir_expansions, hir_id, word_from_int(expansion_id))
    array_set(v4_hir_item_kinds, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_names, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_defs, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_parse_nodes, hir_id, word_from_int(array_new()))
    array_set(v4_hir_alias_target_types, hir_id, word_from_int(array_new()))
    array_set(v4_hir_alias_target_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_items, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_stmt_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_types, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_type_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_diags, hir_id, word_from_int(array_new()))
    v4_hir_file_len = hir_id + 1
    give back hir_id
}

task v4_hir_kinds_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_kinds, hir_id))
}

task v4_hir_names_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_names, hir_id))
}

task v4_hir_defs_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_defs, hir_id))
}

task v4_hir_spans_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_spans, hir_id))
}

task v4_hir_parse_nodes_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_parse_nodes, hir_id))
}

task v4_hir_alias_target_types_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_alias_target_types, hir_id))
}

task v4_hir_alias_target_spans_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_alias_target_spans, hir_id))
}

task v4_hir_local_annotation_items_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_local_annotation_items, hir_id))
}

task v4_hir_local_annotation_stmt_spans_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_local_annotation_stmt_spans, hir_id))
}

task v4_hir_local_annotation_types_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_local_annotation_types, hir_id))
}

task v4_hir_local_annotation_type_spans_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_local_annotation_type_spans, hir_id))
}

task v4_hir_diags_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_diags, hir_id))
}

task v4_hir_file_id(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_files, hir_id))
}

task v4_hir_expansion_id(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_expansions, hir_id))
}

-- Compatibility view for TY/MIR consumers that still read syntax-shaped
-- bodies. The stored HIR parent is always an expansion, never a parse tree.
task v4_hir_tree_id(hir_id: int) -> int {
    give back v4_expand_parse_tree_id(v4_hir_expansion_id(hir_id))
}

task v4_hir_file_count() -> int {
    v4_hir_init()
    give back v4_hir_file_len
}

task v4_hir_file_exists(hir_id: int) -> bool {
    v4_hir_init()
    if hir_id < 0 {
        give back false
    }
    if hir_id >= v4_hir_file_len {
        give back false
    }
    give back true
}

task v4_hir_def_id(file_id: int, item_kind: word, item_name: word, item_index: int) -> word {
    pilot safe_name = item_name
    if safe_name == "" {
        safe_name = "_"
    }
    give back "file" + word_from_int(file_id) + "::" + item_kind + "::" + safe_name + "#" + word_from_int(item_index)
}

task v4_hir_add_item(hir_id: int, item_kind: word, item_name: word, span: word, parse_node: int) -> int {
    pilot item_index = array_len(v4_hir_kinds_handle(hir_id))
    pilot file_id = word_to_int(array_get(v4_hir_files, hir_id))
    pilot def_id = v4_hir_def_id(file_id, item_kind, item_name, item_index)
    array_push(v4_hir_kinds_handle(hir_id), item_kind)
    array_push(v4_hir_names_handle(hir_id), item_name)
    array_push(v4_hir_defs_handle(hir_id), def_id)
    array_push(v4_hir_spans_handle(hir_id), span)
    array_push(v4_hir_parse_nodes_handle(hir_id), word_from_int(parse_node))
    array_push(v4_hir_alias_target_types_handle(hir_id), "")
    array_push(v4_hir_alias_target_spans_handle(hir_id), V4_NO_SPAN)
    give back item_index
}

task v4_hir_add_diag(hir_id: int, diag: word) -> void {
    array_push(v4_hir_diags_handle(hir_id), diag)
}

task v4_hir_item_count(hir_id: int) -> int {
    give back array_len(v4_hir_kinds_handle(hir_id))
}

task v4_hir_diag_count(hir_id: int) -> int {
    give back array_len(v4_hir_diags_handle(hir_id))
}

task v4_hir_item_kind(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_kinds_handle(hir_id), item_id)
}

task v4_hir_item_name(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_names_handle(hir_id), item_id)
}

task v4_hir_item_def(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_defs_handle(hir_id), item_id)
}

task v4_hir_item_span(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_spans_handle(hir_id), item_id)
}

task v4_hir_item_parse_node(hir_id: int, item_id: int) -> int {
    give back word_to_int(array_get(v4_hir_parse_nodes_handle(hir_id), item_id))
}

task v4_hir_item_expansion_id(hir_id: int) -> int {
    give back v4_hir_expansion_id(hir_id)
}

task v4_hir_item_stream_id(hir_id: int) -> int {
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back 0 - 1
    }
    give back v4_expand_stream_id(expansion_id)
}

task v4_hir_closure_count(hir_id: int, item_id: int) -> int {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0
    }
    pilot tree_id = v4_hir_expansion_id(hir_id)
    if v4_expand_tree_exists(tree_id) == false {
        give back 0
    }
    give back v4_expand_closure_count(tree_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_closure_parse_node(hir_id: int, item_id: int, closure_id: int) -> int {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_expansion_id(hir_id)
    if v4_expand_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    give back v4_expand_closure_node(tree_id, v4_hir_item_parse_node(hir_id, item_id), closure_id)
}

task v4_hir_closure_mode(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_expand_closure_mode(tree_id, closure_node)
}

task v4_hir_closure_span(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_expand_node_span(v4_hir_expansion_id(hir_id), closure_node)
}

task v4_hir_closure_body_kind(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_expand_closure_body_kind(tree_id, closure_node)
}

task v4_hir_closure_body_span(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_expand_closure_body_span(tree_id, closure_node)
}

task v4_hir_closure_body_start_token(hir_id: int, item_id: int, closure_id: int) -> int {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back 0 - 1
    }
    give back v4_expand_closure_body_start_token(tree_id, closure_node)
}

task v4_hir_closure_body_end_token(hir_id: int, item_id: int, closure_id: int) -> int {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back 0 - 1
    }
    give back v4_expand_closure_body_end_token(tree_id, closure_node)
}

task v4_hir_closure_param_count(hir_id: int, item_id: int, closure_id: int) -> int {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back 0
    }
    give back v4_expand_closure_param_count(tree_id, closure_node)
}

task v4_hir_closure_param_name(hir_id: int, item_id: int, closure_id: int, param_id: int) -> word {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_expand_closure_param_name(tree_id, closure_node, param_id)
}

task v4_hir_closure_param_type(hir_id: int, item_id: int, closure_id: int, param_id: int) -> word {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_expand_closure_param_type(tree_id, closure_node, param_id)
}

task v4_hir_closure_param_span(hir_id: int, item_id: int, closure_id: int, param_id: int) -> word {
    pilot tree_id = v4_hir_expansion_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_expand_closure_param_span(tree_id, closure_node, param_id)
}

task v4_hir_closure_at_offset(hir_id: int, item_id: int, offset: int) -> int {
    pilot closure_id = 0
    pilot closure_count = v4_hir_closure_count(hir_id, item_id)
    repeat until closure_id >= closure_count {
        pilot span = v4_hir_closure_span(hir_id, item_id, closure_id)
        if offset >= v4_span_start(span) and offset < v4_span_end(span) {
            give back closure_id
        }
        closure_id += 1
    }
    give back 0 - 1
}

task v4_hir_item_decl_keyword(hir_id: int, item_id: int) -> word {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_node_decl_keyword(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_route_is_variant(hir_id: int, item_id: int) -> bool {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_route {
        give back false
    }
    give back v4_hir_item_decl_keyword(hir_id, item_id) == "variant"
}

task v4_hir_import_path(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_import {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_import_path(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_import_alias(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_import {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_import_alias(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_import_binding(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_import {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_import_binding(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_attribute_arg(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_attribute {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_attribute_arg_text(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_alias_target(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_alias {
        give back ""
    }
    give back array_get(v4_hir_alias_target_types_handle(hir_id), item_id)
}

task v4_hir_alias_target_span(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_alias {
        give back V4_NO_SPAN
    }
    give back array_get(v4_hir_alias_target_spans_handle(hir_id), item_id)
}

task v4_hir_lower_alias_target_type(hir_id: int, item_id: int, expansion_id: int, expanded_node: int) -> void {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_alias {
        give back
    }
    array_set(v4_hir_alias_target_types_handle(hir_id), item_id, v4_expand_alias_target(expansion_id, expanded_node))
    array_set(v4_hir_alias_target_spans_handle(hir_id), item_id, v4_expand_alias_target_span(expansion_id, expanded_node))
}

task v4_hir_local_annotation_record_count(hir_id: int) -> int {
    give back array_len(v4_hir_local_annotation_items_handle(hir_id))
}

task v4_hir_local_annotation_record_id(hir_id: int, item_id: int, annotation_id: int) -> int {
    if item_id < 0 or annotation_id < 0 {
        give back 0 - 1
    }
    pilot record_id = 0
    pilot local_id = 0
    pilot record_count = v4_hir_local_annotation_record_count(hir_id)
    repeat until record_id >= record_count {
        if word_to_int(array_get(v4_hir_local_annotation_items_handle(hir_id), record_id)) == item_id {
            if local_id == annotation_id {
                give back record_id
            }
            local_id += 1
        }
        record_id += 1
    }
    give back 0 - 1
}

task v4_hir_local_annotation_count(hir_id: int, item_id: int) -> int {
    pilot count = 0
    pilot record_id = 0
    pilot record_count = v4_hir_local_annotation_record_count(hir_id)
    repeat until record_id >= record_count {
        if word_to_int(array_get(v4_hir_local_annotation_items_handle(hir_id), record_id)) == item_id {
            count += 1
        }
        record_id += 1
    }
    give back count
}

task v4_hir_local_annotation_stmt_span(hir_id: int, item_id: int, annotation_id: int) -> word {
    pilot record_id = v4_hir_local_annotation_record_id(hir_id, item_id, annotation_id)
    if record_id < 0 {
        give back V4_NO_SPAN
    }
    give back array_get(v4_hir_local_annotation_stmt_spans_handle(hir_id), record_id)
}

task v4_hir_local_annotation_type(hir_id: int, item_id: int, annotation_id: int) -> word {
    pilot record_id = v4_hir_local_annotation_record_id(hir_id, item_id, annotation_id)
    if record_id < 0 {
        give back ""
    }
    give back array_get(v4_hir_local_annotation_types_handle(hir_id), record_id)
}

task v4_hir_local_annotation_type_span(hir_id: int, item_id: int, annotation_id: int) -> word {
    pilot record_id = v4_hir_local_annotation_record_id(hir_id, item_id, annotation_id)
    if record_id < 0 {
        give back V4_NO_SPAN
    }
    give back array_get(v4_hir_local_annotation_type_spans_handle(hir_id), record_id)
}

task v4_hir_local_annotation_at_offset(hir_id: int, item_id: int, offset: int) -> int {
    pilot annotation_id = 0
    pilot annotation_count = v4_hir_local_annotation_count(hir_id, item_id)
    repeat until annotation_id >= annotation_count {
        pilot stmt_span = v4_hir_local_annotation_stmt_span(hir_id, item_id, annotation_id)
        if offset >= v4_span_start(stmt_span) and offset < v4_span_end(stmt_span) {
            give back annotation_id
        }
        annotation_id += 1
    }
    give back 0 - 1
}

task v4_hir_add_local_annotation(hir_id: int, item_id: int, stmt_span: word, type_text: word, type_span: word) -> int {
    pilot record_id = v4_hir_local_annotation_record_count(hir_id)
    array_push(v4_hir_local_annotation_items_handle(hir_id), word_from_int(item_id))
    array_push(v4_hir_local_annotation_stmt_spans_handle(hir_id), stmt_span)
    array_push(v4_hir_local_annotation_types_handle(hir_id), type_text)
    array_push(v4_hir_local_annotation_type_spans_handle(hir_id), type_span)
    give back record_id
}

task v4_hir_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_span_start(v4_lex_token_span(stream_id, token_id)) >= offset {
            give back token_id
        }
        token_id += 1
    }
    give back token_count
}

task v4_hir_skip_trivia(stream_id: int, token_id: int, end_token: int) -> int {
    pilot idx = token_id
    repeat until idx >= end_token or v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
        idx += 1
    }
    give back idx
}

task v4_hir_previous_nontrivia(stream_id: int, token_id: int, start_token: int) -> int {
    pilot idx = token_id
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_hir_has_newline_between(stream_id: int, earlier_token: int, later_token: int) -> bool {
    pilot idx = earlier_token + 1
    repeat until idx >= later_token {
        if v4_lex_token_type(stream_id, idx) == v4_tok_trivia and v4_lex_token_value(stream_id, idx) == "\n" {
            give back true
        }
        idx += 1
    }
    give back false
}

task v4_hir_token_starts_statement(stream_id: int, token_id: int, item_start: int) -> bool {
    pilot previous = v4_hir_previous_nontrivia(stream_id, token_id - 1, item_start)
    if previous < item_start {
        give back true
    }
    pilot previous_value = v4_lex_token_value(stream_id, previous)
    if previous_value == "{" or previous_value == "}" or previous_value == ";" {
        give back true
    }
    give back v4_hir_has_newline_between(stream_id, previous, token_id)
}

task v4_hir_pilot_starts_local_decl(stream_id: int, pilot_token: int, item_start: int) -> bool {
    if v4_hir_token_starts_statement(stream_id, pilot_token, item_start) {
        give back true
    }
    pilot previous = v4_hir_previous_nontrivia(stream_id, pilot_token - 1, item_start)
    if previous < item_start or v4_lex_token_value(stream_id, previous) != "fixed" {
        give back false
    }
    give back v4_hir_token_starts_statement(stream_id, previous, item_start)
}

task v4_hir_depth_after_token(depth: int, value: word) -> int {
    if value == "(" or value == "[" or value == "{" {
        give back depth + 1
    }
    if value == ")" or value == "]" or value == "}" {
        if depth > 0 {
            give back depth - 1
        }
    }
    give back depth
}

task v4_hir_statement_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot value = v4_lex_token_value(stream_id, idx)
        if token_type != v4_tok_trivia {
            if value == "}" and depth == 0 {
                give back idx
            }
            if value == ";" and depth == 0 {
                give back idx
            }
            depth = v4_hir_depth_after_token(depth, value)
        } else if value == "\n" and depth == 0 {
            give back idx
        }
        idx += 1
    }
    give back end_token
}

task v4_hir_find_local_assignment(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "=" and depth == 0 {
                give back idx
            }
            depth = v4_hir_depth_after_token(depth, value)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_find_local_annotation_colon(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == ":" and depth == 0 {
                give back idx
            }
            depth = v4_hir_depth_after_token(depth, value)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_hir_skip_trivia(stream_id, start_token, end_token)
    pilot last = v4_hir_previous_nontrivia(stream_id, end_token - 1, first)
    if first >= end_token or last < first {
        give back V4_NO_SPAN
    }
    pilot first_span = v4_lex_token_span(stream_id, first)
    pilot last_span = v4_lex_token_span(stream_id, last)
    give back v4_span_new(v4_span_file(first_span), v4_span_start(first_span), v4_span_end(last_span))
}

task v4_hir_local_annotation_type_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot previous_value = ""
    pilot previous_previous_value = ""
    pilot previous_type = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        if token_type != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            pilot needs_separator: bool = previous_value == "lend" or previous_value == "dyn"
            if previous_value == "mut" and previous_previous_value == "lend" {
                needs_separator = true
            }
            if previous_type == v4_tok_lifetime and value != ":" and value != "+" and value != "," and value != ">" and value != ")" and value != "]" and value != ";" {
                needs_separator = true
            }
            if out != "" and needs_separator {
                out = out + " "
            }
            out = out + value
            previous_previous_value = previous_value
            previous_value = value
            previous_type = token_type
        }
        idx += 1
    }
    give back out
}

task v4_hir_lower_local_annotations(hir_id: int, item_id: int) -> void {
    pilot item_kind = v4_hir_item_kind(hir_id, item_id)
    if item_kind != v4_hir_task and item_kind != v4_hir_impl and item_kind != v4_hir_doctrine {
        give back
    }
    pilot stream_id = v4_hir_item_stream_id(hir_id)
    if stream_id < 0 {
        give back
    }
    pilot item_span = v4_hir_item_span(hir_id, item_id)
    pilot item_start = v4_hir_first_token_at_or_after(stream_id, v4_span_start(item_span))
    pilot item_end = v4_hir_first_token_at_or_after(stream_id, v4_span_end(item_span))
    pilot idx = item_start
    repeat until idx >= item_end {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia and v4_lex_token_value(stream_id, idx) == "pilot" and v4_hir_pilot_starts_local_decl(stream_id, idx, item_start) {
            pilot stmt_end = v4_hir_statement_end(stream_id, idx, item_end)
            pilot pattern_start = v4_hir_skip_trivia(stream_id, idx + 1, stmt_end)
            pilot assignment = v4_hir_find_local_assignment(stream_id, pattern_start, stmt_end)
            pilot decl_end = stmt_end
            if assignment >= 0 {
                decl_end = assignment
            }
            pilot colon = v4_hir_find_local_annotation_colon(stream_id, pattern_start, decl_end)
            if colon >= 0 {
                pilot type_start = v4_hir_skip_trivia(stream_id, colon + 1, decl_end)
                if type_start < decl_end {
                    pilot type_text = v4_hir_local_annotation_type_text(stream_id, type_start, decl_end)
                    pilot type_span = v4_hir_span_from_tokens(stream_id, type_start, decl_end)
                    pilot stmt_span = v4_hir_span_from_tokens(stream_id, idx, stmt_end)
                    if type_text != "" {
                        v4_hir_add_local_annotation(hir_id, item_id, stmt_span, type_text, type_span)
                    }
                }
            }
        }
        idx += 1
    }
}

task v4_hir_const_type(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_const {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_const_type(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_const_init(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_const {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_const_init(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_item_attribute_start(hir_id: int, item_id: int) -> int {
    if item_id <= 0 {
        give back item_id
    }
    pilot idx = item_id - 1
    repeat until idx < 0 or v4_hir_item_kind(hir_id, idx) != v4_hir_attribute {
        idx -= 1
    }
    give back idx + 1
}

task v4_hir_item_attribute_count(hir_id: int, item_id: int) -> int {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0
    }
    if v4_hir_item_kind(hir_id, item_id) == v4_hir_attribute {
        give back 0
    }
    pilot start = v4_hir_item_attribute_start(hir_id, item_id)
    if start < 0 or start >= item_id {
        give back 0
    }
    give back item_id - start
}

task v4_hir_item_attribute_item(hir_id: int, item_id: int, attr_id: int) -> int {
    if attr_id < 0 {
        give back 0 - 1
    }
    pilot count = v4_hir_item_attribute_count(hir_id, item_id)
    if attr_id >= count {
        give back 0 - 1
    }
    give back v4_hir_item_attribute_start(hir_id, item_id) + attr_id
}

task v4_hir_item_attribute_name(hir_id: int, item_id: int, attr_id: int) -> word {
    pilot attr_item = v4_hir_item_attribute_item(hir_id, item_id, attr_id)
    if attr_item < 0 {
        give back ""
    }
    give back v4_hir_item_name(hir_id, attr_item)
}

task v4_hir_item_attribute_arg(hir_id: int, item_id: int, attr_id: int) -> word {
    pilot attr_item = v4_hir_item_attribute_item(hir_id, item_id, attr_id)
    if attr_item < 0 {
        give back ""
    }
    give back v4_hir_attribute_arg(hir_id, attr_item)
}

task v4_hir_item_has_attribute(hir_id: int, item_id: int, wanted_name: word) -> bool {
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, item_id)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, item_id, attr_idx) == wanted_name {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_hir_item_attribute_arg_for_name(hir_id: int, item_id: int, wanted_name: word) -> word {
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, item_id)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, item_id, attr_idx) == wanted_name {
            give back v4_hir_item_attribute_arg(hir_id, item_id, attr_idx)
        }
        attr_idx += 1
    }
    give back ""
}

task v4_hir_extern_abi(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_abi(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_extern_member_count(hir_id: int, item_id: int) -> int {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back 0
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back 0
    }
    give back v4_expand_extern_member_count(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_extern_member_name(hir_id: int, item_id: int, member_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_member_name(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id)
}

task v4_hir_extern_member_attribute_count(hir_id: int, item_id: int, member_id: int) -> int {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back 0
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back 0
    }
    give back v4_expand_extern_member_attribute_count(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id)
}

task v4_hir_extern_member_attribute_name(hir_id: int, item_id: int, member_id: int, attr_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_member_attribute_name(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id, attr_id)
}

task v4_hir_extern_member_attribute_arg(hir_id: int, item_id: int, member_id: int, attr_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_member_attribute_arg(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id, attr_id)
}

task v4_hir_diag(hir_id: int, diag_id: int) -> word {
    give back array_get(v4_hir_diags_handle(hir_id), diag_id)
}

task v4_hir_kind_from_parse(parse_kind: word) -> word {
    if parse_kind == v4_node_task { give back v4_hir_task }
    if parse_kind == v4_node_shape { give back v4_hir_shape }
    if parse_kind == v4_node_route { give back v4_hir_route }
    if parse_kind == v4_node_alias { give back v4_hir_alias }
    if parse_kind == v4_node_const { give back v4_hir_const }
    if parse_kind == v4_node_impl { give back v4_hir_impl }
    if parse_kind == v4_node_doctrine { give back v4_hir_doctrine }
    if parse_kind == v4_node_use { give back v4_hir_import }
    if parse_kind == v4_node_extern { give back v4_hir_extern }
    if parse_kind == v4_node_attribute { give back v4_hir_attribute }
    if parse_kind == v4_node_error { give back v4_hir_error }
    if parse_kind == v4_node_incomplete { give back v4_hir_error }
    give back ""
}

task v4_hir_should_lower_parse_node(parse_kind: word) -> bool {
    give back v4_hir_kind_from_parse(parse_kind) != ""
}

task v4_hir_copy_expand_diags(hir_id: int, expansion_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_expand_diag_count(expansion_id)
    repeat until diag_idx >= diag_count {
        v4_hir_add_diag(hir_id, v4_expand_diag(expansion_id, diag_idx))
        diag_idx += 1
    }
}

task v4_hir_lower_expanded(file_id: int, expansion_id: int) -> int {
    v4_hir_init()
    pilot hir_id = v4_hir_file_new(file_id, expansion_id)
    v4_hir_copy_expand_diags(hir_id, expansion_id)

    pilot node_idx = 0
    pilot node_count = v4_expand_node_count(expansion_id)
    repeat until node_idx >= node_count {
        pilot parse_kind = v4_expand_node_kind(expansion_id, node_idx)
        if v4_hir_should_lower_parse_node(parse_kind) {
            pilot hir_kind = v4_hir_kind_from_parse(parse_kind)
            pilot item_name = v4_expand_node_value(expansion_id, node_idx)
            pilot item_span = v4_expand_node_span(expansion_id, node_idx)
            pilot item_id = v4_hir_add_item(hir_id, hir_kind, item_name, item_span, node_idx)
            v4_hir_lower_alias_target_type(hir_id, item_id, expansion_id, node_idx)
            v4_hir_lower_local_annotations(hir_id, item_id)
        }
        node_idx += 1
    }

    give back hir_id
}

-- Compatibility entry for direct bootstrap fixtures. Even this path creates
-- an ExpandedFile first, so Parse -> HIR cannot bypass freak_expand.
task v4_hir_lower_tree(file_id: int, tree_id: int) -> int {
    pilot expansion_id = v4_expand_identity(file_id, tree_id)
    if expansion_id < 0 { give back 0 - 1 }
    give back v4_hir_lower_expanded(file_id, expansion_id)
}

task v4_hir_summary(hir_id: int) -> word {
    pilot summary = "hir-ok hir=" + word_from_int(hir_id)
    summary = summary + " items=" + word_from_int(v4_hir_item_count(hir_id))
    summary = summary + " diagnostics=" + word_from_int(v4_hir_diag_count(hir_id))
    give back summary
}

task v4_hir_snapshot_escape(value: word) -> word {
    give back v4_expand_snapshot_escape(value)
}

task v4_hir_snapshot_unescape(value: word) -> word {
    give back v4_expand_snapshot_unescape(value)
}

task v4_hir_snapshot_line_count(payload: word) -> int {
    give back v4_expand_snapshot_line_count(payload)
}

task v4_hir_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_expand_snapshot_line(payload, wanted)
}

task v4_hir_snapshot_field_count(line: word) -> int {
    give back v4_expand_snapshot_field_count(line)
}

task v4_hir_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_expand_snapshot_field_raw(line, wanted)
}

task v4_hir_snapshot_field(line: word, wanted: int) -> word {
    give back v4_expand_snapshot_field(line, wanted)
}

task v4_hir_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_expand_snapshot_key_value(line, wanted_key)
}

task v4_hir_snapshot_item_total() -> int {
    v4_hir_init()
    pilot total = 0
    pilot hir_id = 0
    repeat until hir_id >= v4_hir_file_count() {
        total += v4_hir_item_count(hir_id)
        hir_id += 1
    }
    give back total
}

task v4_hir_snapshot_alias_target_total() -> int {
    v4_hir_init()
    pilot total = 0
    pilot hir_id = 0
    repeat until hir_id >= v4_hir_file_count() {
        pilot item_id = 0
        pilot item_count = v4_hir_item_count(hir_id)
        repeat until item_id >= item_count {
            if v4_hir_alias_target(hir_id, item_id) != "" {
                total += 1
            }
            item_id += 1
        }
        hir_id += 1
    }
    give back total
}

task v4_hir_snapshot_local_annotation_total() -> int {
    v4_hir_init()
    pilot total = 0
    pilot hir_id = 0
    repeat until hir_id >= v4_hir_file_count() {
        total += v4_hir_local_annotation_record_count(hir_id)
        hir_id += 1
    }
    give back total
}

task v4_hir_snapshot_diag_total() -> int {
    v4_hir_init()
    pilot total = 0
    pilot hir_id = 0
    repeat until hir_id >= v4_hir_file_count() {
        total += v4_hir_diag_count(hir_id)
        hir_id += 1
    }
    give back total
}

task v4_hir_snapshot_summary() -> word {
    pilot summary = "hir-snapshot"
    summary = summary + " format=" + v4_hir_snapshot_format
    summary = summary + " files=" + word_from_int(v4_hir_file_count())
    summary = summary + " items=" + word_from_int(v4_hir_snapshot_item_total())
    summary = summary + " alias-targets=" + word_from_int(v4_hir_snapshot_alias_target_total())
    summary = summary + " local-annotations=" + word_from_int(v4_hir_snapshot_local_annotation_total())
    summary = summary + " diagnostics=" + word_from_int(v4_hir_snapshot_diag_total())
    give back summary
}

task v4_hir_snapshot_header() -> word {
    pilot out = "hir-snapshot"
    out = out + "|format=" + v4_hir_snapshot_format
    out = out + "|files=" + word_from_int(v4_hir_file_count())
    out = out + "|items=" + word_from_int(v4_hir_snapshot_item_total())
    out = out + "|alias-targets=" + word_from_int(v4_hir_snapshot_alias_target_total())
    out = out + "|local-annotations=" + word_from_int(v4_hir_snapshot_local_annotation_total())
    out = out + "|diagnostics=" + word_from_int(v4_hir_snapshot_diag_total())
    give back out
}

task v4_hir_snapshot_file_line(hir_id: int) -> word {
    pilot out = "hir"
    out = out + "|" + word_from_int(hir_id)
    out = out + "|" + word_from_int(v4_hir_file_id(hir_id))
    out = out + "|" + word_from_int(v4_hir_expansion_id(hir_id))
    out = out + "|" + word_from_int(v4_hir_item_count(hir_id))
    out = out + "|" + word_from_int(v4_hir_diag_count(hir_id))
    give back out
}

task v4_hir_snapshot_item_line(hir_id: int, item_id: int) -> word {
    pilot out = "hir-item"
    out = out + "|" + word_from_int(hir_id)
    out = out + "|" + word_from_int(item_id)
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_item_kind(hir_id, item_id))
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_item_name(hir_id, item_id))
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_item_def(hir_id, item_id))
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_item_span(hir_id, item_id))
    out = out + "|" + word_from_int(v4_hir_item_parse_node(hir_id, item_id))
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_alias_target(hir_id, item_id))
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_alias_target_span(hir_id, item_id))
    give back out
}

task v4_hir_snapshot_local_annotation_line(hir_id: int, record_id: int) -> word {
    pilot out = "hir-local-annotation"
    pilot item_id: word = array_get(v4_hir_local_annotation_items_handle(hir_id), record_id)
    out = out + "|" + word_from_int(hir_id)
    out = out + "|" + word_from_int(record_id)
    out = out + "|" + item_id
    out = out + "|" + v4_hir_snapshot_escape(array_get(v4_hir_local_annotation_stmt_spans_handle(hir_id), record_id))
    out = out + "|" + v4_hir_snapshot_escape(array_get(v4_hir_local_annotation_types_handle(hir_id), record_id))
    out = out + "|" + v4_hir_snapshot_escape(array_get(v4_hir_local_annotation_type_spans_handle(hir_id), record_id))
    give back out
}

task v4_hir_snapshot_diag_line(hir_id: int, diag_id: int) -> word {
    pilot out = "hir-diag"
    out = out + "|" + word_from_int(hir_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_hir_snapshot_escape(v4_hir_diag(hir_id, diag_id))
    give back out
}

task v4_hir_snapshot() -> word {
    v4_hir_init()
    pilot parts = array_new()
    array_push(parts, v4_hir_snapshot_header())
    pilot hir_id = 0
    repeat until hir_id >= v4_hir_file_count() {
        array_push(parts, "\n")
        array_push(parts, v4_hir_snapshot_file_line(hir_id))

        pilot item_id = 0
        pilot item_count = v4_hir_item_count(hir_id)
        repeat until item_id >= item_count {
            array_push(parts, "\n")
            array_push(parts, v4_hir_snapshot_item_line(hir_id, item_id))
            item_id += 1
        }

        pilot local_annotation_id = 0
        pilot local_annotation_count = v4_hir_local_annotation_record_count(hir_id)
        repeat until local_annotation_id >= local_annotation_count {
            array_push(parts, "\n")
            array_push(parts, v4_hir_snapshot_local_annotation_line(hir_id, local_annotation_id))
            local_annotation_id += 1
        }

        pilot diag_id = 0
        pilot diag_count = v4_hir_diag_count(hir_id)
        repeat until diag_id >= diag_count {
            array_push(parts, "\n")
            array_push(parts, v4_hir_snapshot_diag_line(hir_id, diag_id))
            diag_id += 1
        }
        hir_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_hir_snapshot_format)
    give back word_join(parts)
}

task v4_hir_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "hir-snapshot" {
        give back 7
    }
    if kind == "hir" {
        give back 6
    }
    if kind == "hir-item" {
        give back 10
    }
    if kind == "hir-local-annotation" {
        give back 7
    }
    if kind == "hir-diag" {
        give back 4
    }
    if kind == "end" {
        give back 2
    }
    give back 0
}

task v4_hir_snapshot_alias_target_is_valid(line: word) -> bool {
    pilot alias_target = v4_hir_snapshot_field(line, 8)
    pilot alias_target_span = v4_hir_snapshot_field(line, 9)
    pilot no_span = V4_NO_SPAN
    pilot no_file = V4_NO_FILE
    if alias_target == "" {
        give back alias_target_span == no_span
    }
    if v4_hir_snapshot_field(line, 3) != v4_hir_alias {
        give back false
    }
    if alias_target_span == no_span {
        give back false
    }
    pilot item_span = v4_hir_snapshot_field(line, 6)
    pilot item_file = v4_span_file(item_span)
    pilot item_start = v4_span_start(item_span)
    pilot item_end = v4_span_end(item_span)
    pilot span_file = v4_span_file(alias_target_span)
    pilot span_start = v4_span_start(alias_target_span)
    pilot span_end = v4_span_end(alias_target_span)
    if item_span == no_span or item_file == no_file or item_end < item_start or v4_span_new(item_file, item_start, item_end) != item_span {
        give back false
    }
    if span_file == no_file or span_end <= span_start or span_file != item_file or span_start < item_start or span_end > item_end {
        give back false
    }
    give back v4_span_new(span_file, span_start, span_end) == alias_target_span
}

task v4_hir_snapshot_file_for_hir(payload: word, wanted_hir_id: word) -> word {
    pilot found_file = V4_NO_FILE
    pilot matches = 0
    pilot line_id = 0
    pilot line_count = v4_hir_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_hir_snapshot_line(payload, line_id)
        if v4_hir_snapshot_field_raw(line, 0) == "hir" and v4_hir_snapshot_field_raw(line, 1) == wanted_hir_id {
            found_file = v4_hir_snapshot_field_raw(line, 2)
            matches += 1
        }
        line_id += 1
    }
    if matches != 1 {
        give back V4_NO_FILE
    }
    give back found_file
}

task v4_hir_snapshot_alias_target_owner_is_valid(payload: word, line: word) -> bool {
    if v4_hir_snapshot_field(line, 8) == "" {
        give back true
    }
    pilot no_file = V4_NO_FILE
    pilot snapshot_file = v4_hir_snapshot_file_for_hir(payload, v4_hir_snapshot_field_raw(line, 1))
    if snapshot_file == no_file {
        give back false
    }
    give back v4_span_file(v4_hir_snapshot_field(line, 6)) == snapshot_file and v4_span_file(v4_hir_snapshot_field(line, 9)) == snapshot_file
}

task v4_hir_snapshot_child_slots_are_valid(payload: word, hir_line: word) -> bool {
    pilot wanted_hir_id = v4_hir_snapshot_field_raw(hir_line, 1)
    pilot declared_items_word = v4_hir_snapshot_field_raw(hir_line, 4)
    pilot declared_diags_word = v4_hir_snapshot_field_raw(hir_line, 5)
    pilot declared_items = word_to_int(declared_items_word)
    pilot declared_diags = word_to_int(declared_diags_word)
    if declared_items < 0 or declared_diags < 0 or word_from_int(declared_items) != declared_items_word or word_from_int(declared_diags) != declared_diags_word {
        give back false
    }

    pilot hir_records = 0
    pilot item_records = 0
    pilot diag_records = 0
    pilot line_id = 0
    pilot line_count = v4_hir_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_hir_snapshot_line(payload, line_id)
        pilot kind = v4_hir_snapshot_field_raw(line, 0)
        if kind == "hir" and v4_hir_snapshot_field_raw(line, 1) == wanted_hir_id {
            hir_records += 1
        } else if kind == "hir-item" and v4_hir_snapshot_field_raw(line, 1) == wanted_hir_id {
            item_records += 1
        } else if kind == "hir-diag" and v4_hir_snapshot_field_raw(line, 1) == wanted_hir_id {
            diag_records += 1
        }
        line_id += 1
    }
    if hir_records != 1 or item_records != declared_items or diag_records != declared_diags {
        give back false
    }

    pilot expected_item = 0
    repeat until expected_item >= declared_items {
        pilot occurrences = 0
        line_id = 0
        repeat until line_id >= line_count {
            pilot line = v4_hir_snapshot_line(payload, line_id)
            if v4_hir_snapshot_field_raw(line, 0) == "hir-item" and v4_hir_snapshot_field_raw(line, 1) == wanted_hir_id and v4_hir_snapshot_field_raw(line, 2) == word_from_int(expected_item) {
                occurrences += 1
            }
            line_id += 1
        }
        if occurrences != 1 {
            give back false
        }
        expected_item += 1
    }

    pilot expected_diag = 0
    repeat until expected_diag >= declared_diags {
        pilot occurrences = 0
        line_id = 0
        repeat until line_id >= line_count {
            pilot line = v4_hir_snapshot_line(payload, line_id)
            if v4_hir_snapshot_field_raw(line, 0) == "hir-diag" and v4_hir_snapshot_field_raw(line, 1) == wanted_hir_id and v4_hir_snapshot_field_raw(line, 2) == word_from_int(expected_diag) {
                occurrences += 1
            }
            line_id += 1
        }
        if occurrences != 1 {
            give back false
        }
        expected_diag += 1
    }
    give back true
}

task v4_hir_snapshot_hir_slots_are_valid(payload: word, file_count: int) -> bool {
    pilot expected_hir = 0
    pilot line_count = v4_hir_snapshot_line_count(payload)
    repeat until expected_hir >= file_count {
        pilot occurrences = 0
        pilot line_id = 0
        repeat until line_id >= line_count {
            pilot line = v4_hir_snapshot_line(payload, line_id)
            if v4_hir_snapshot_field_raw(line, 0) == "hir" and v4_hir_snapshot_field_raw(line, 1) == word_from_int(expected_hir) {
                occurrences += 1
            }
            line_id += 1
        }
        if occurrences != 1 {
            give back false
        }
        expected_hir += 1
    }
    give back true
}

task v4_hir_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_hir_snapshot_field_raw(line, 0)
    pilot expected = v4_hir_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_hir_snapshot_field_count(line) < expected {
        give back false
    }
    if kind == "hir-item" and v4_hir_snapshot_alias_target_is_valid(line) == false {
        give back false
    }
    give back true
}

task v4_hir_snapshot_validate(payload: word) -> word {
    pilot lines = v4_hir_snapshot_line_count(payload)
    pilot files = 0
    pilot items = 0
    pilot alias_targets = 0
    pilot local_annotations = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_files = ""
    pilot declared_items = ""
    pilot declared_alias_targets = ""
    pilot declared_diagnostics = ""
    pilot no_file = V4_NO_FILE

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_hir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_hir_snapshot_field_raw(line, 0)
            if v4_hir_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "hir-snapshot" {
                saw_header += 1
                format = v4_hir_snapshot_key_value(line, "format")
                declared_files = v4_hir_snapshot_key_value(line, "files")
                declared_items = v4_hir_snapshot_key_value(line, "items")
                declared_alias_targets = v4_hir_snapshot_key_value(line, "alias-targets")
                declared_diagnostics = v4_hir_snapshot_key_value(line, "diagnostics")
                if format != v4_hir_snapshot_format {
                    malformed += 1
                }
            } else if kind == "hir" {
                files += 1
                if v4_hir_snapshot_child_slots_are_valid(payload, line) == false {
                    malformed += 1
                }
            } else if kind == "hir-item" {
                items += 1
                if v4_hir_snapshot_file_for_hir(payload, v4_hir_snapshot_field_raw(line, 1)) == no_file {
                    malformed += 1
                }
                if v4_hir_snapshot_field(line, 8) != "" {
                    alias_targets += 1
                    if v4_hir_snapshot_alias_target_owner_is_valid(payload, line) == false {
                        malformed += 1
                    }
                }
            } else if kind == "hir-local-annotation" {
                local_annotations += 1
            } else if kind == "hir-diag" {
                diagnostics += 1
                if v4_hir_snapshot_file_for_hir(payload, v4_hir_snapshot_field_raw(line, 1)) == no_file {
                    malformed += 1
                }
            } else if kind == "end" {
                saw_end += 1
                if v4_hir_snapshot_field(line, 1) != v4_hir_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 {
        import_ok = 0
    }
    if saw_end != 1 {
        import_ok = 0
    }
    if malformed > 0 {
        import_ok = 0
    }
    if declared_files != word_from_int(files) or declared_items != word_from_int(items) or declared_diagnostics != word_from_int(diagnostics) {
        import_ok = 0
    }
    if declared_alias_targets != word_from_int(alias_targets) {
        import_ok = 0
    }
    if v4_hir_snapshot_hir_slots_are_valid(payload, files) == false {
        import_ok = 0
    }

    pilot out = "hir-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " items=" + word_from_int(items)
    out = out + " alias-targets=" + word_from_int(alias_targets)
    out = out + " declared-alias-targets=" + declared_alias_targets
    out = out + " local-annotations=" + word_from_int(local_annotations)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_hir_restore_file_slot(hir_id: int, file_id: int, expansion_id: int) -> int {
    v4_hir_init()
    repeat until array_len(v4_hir_files) > hir_id {
        array_push(v4_hir_files, "0")
        array_push(v4_hir_expansions, "0")
        array_push(v4_hir_item_kinds, word_from_int(array_new()))
        array_push(v4_hir_item_names, word_from_int(array_new()))
        array_push(v4_hir_item_defs, word_from_int(array_new()))
        array_push(v4_hir_item_spans, word_from_int(array_new()))
        array_push(v4_hir_item_parse_nodes, word_from_int(array_new()))
        array_push(v4_hir_alias_target_types, word_from_int(array_new()))
        array_push(v4_hir_alias_target_spans, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_items, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_stmt_spans, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_types, word_from_int(array_new()))
        array_push(v4_hir_local_annotation_type_spans, word_from_int(array_new()))
        array_push(v4_hir_diags, word_from_int(array_new()))
    }

    array_set(v4_hir_files, hir_id, word_from_int(file_id))
    array_set(v4_hir_expansions, hir_id, word_from_int(expansion_id))
    array_set(v4_hir_item_kinds, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_names, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_defs, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_item_parse_nodes, hir_id, word_from_int(array_new()))
    array_set(v4_hir_alias_target_types, hir_id, word_from_int(array_new()))
    array_set(v4_hir_alias_target_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_items, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_stmt_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_types, hir_id, word_from_int(array_new()))
    array_set(v4_hir_local_annotation_type_spans, hir_id, word_from_int(array_new()))
    array_set(v4_hir_diags, hir_id, word_from_int(array_new()))
    if hir_id >= v4_hir_file_len {
        v4_hir_file_len = hir_id + 1
    }
    give back hir_id
}

task v4_hir_restore_item_slot(hir_id: int, item_id: int, item_kind: word, item_name: word, def_id: word, span: word, parse_node: int, alias_target: word, alias_target_span: word) -> int {
    if v4_hir_file_exists(hir_id) == false {
        give back 0
    }
    repeat until v4_hir_item_count(hir_id) > item_id {
        array_push(v4_hir_kinds_handle(hir_id), "")
        array_push(v4_hir_names_handle(hir_id), "")
        array_push(v4_hir_defs_handle(hir_id), "")
        array_push(v4_hir_spans_handle(hir_id), V4_NO_SPAN)
        array_push(v4_hir_parse_nodes_handle(hir_id), word_from_int(0 - 1))
        array_push(v4_hir_alias_target_types_handle(hir_id), "")
        array_push(v4_hir_alias_target_spans_handle(hir_id), V4_NO_SPAN)
    }
    array_set(v4_hir_kinds_handle(hir_id), item_id, item_kind)
    array_set(v4_hir_names_handle(hir_id), item_id, item_name)
    array_set(v4_hir_defs_handle(hir_id), item_id, def_id)
    array_set(v4_hir_spans_handle(hir_id), item_id, span)
    array_set(v4_hir_parse_nodes_handle(hir_id), item_id, word_from_int(parse_node))
    array_set(v4_hir_alias_target_types_handle(hir_id), item_id, alias_target)
    array_set(v4_hir_alias_target_spans_handle(hir_id), item_id, alias_target_span)
    give back 1
}

task v4_hir_restore_diag_slot(hir_id: int, diag_id: int, diag: word) -> int {
    if v4_hir_file_exists(hir_id) == false {
        give back 0
    }
    repeat until array_len(v4_hir_diags_handle(hir_id)) > diag_id {
        array_push(v4_hir_diags_handle(hir_id), "")
    }
    array_set(v4_hir_diags_handle(hir_id), diag_id, diag)
    give back 1
}

task v4_hir_snapshot_restore_file_line(line: word) -> int {
    if v4_hir_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_hir_snapshot_field_raw(line, 0) != "hir" {
        give back 0
    }
    pilot hir_id = word_to_int(v4_hir_snapshot_field_raw(line, 1))
    pilot file_id = word_to_int(v4_hir_snapshot_field_raw(line, 2))
    pilot expansion_id = word_to_int(v4_hir_snapshot_field_raw(line, 3))
    v4_hir_restore_file_slot(hir_id, file_id, expansion_id)
    give back 1
}

task v4_hir_snapshot_restore_item_line(line: word) -> int {
    if v4_hir_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_hir_snapshot_field_raw(line, 0) != "hir-item" {
        give back 0
    }
    pilot hir_id = word_to_int(v4_hir_snapshot_field_raw(line, 1))
    pilot item_id = word_to_int(v4_hir_snapshot_field_raw(line, 2))
    pilot item_kind = v4_hir_snapshot_field(line, 3)
    pilot item_name = v4_hir_snapshot_field(line, 4)
    pilot def_id = v4_hir_snapshot_field(line, 5)
    pilot span = v4_hir_snapshot_field(line, 6)
    pilot parse_node = word_to_int(v4_hir_snapshot_field_raw(line, 7))
    pilot alias_target = v4_hir_snapshot_field(line, 8)
    pilot alias_target_span = v4_hir_snapshot_field(line, 9)
    give back v4_hir_restore_item_slot(hir_id, item_id, item_kind, item_name, def_id, span, parse_node, alias_target, alias_target_span)
}

task v4_hir_restore_local_annotation_slot(hir_id: int, record_id: int, item_id: int, stmt_span: word, type_text: word, type_span: word) -> int {
    if v4_hir_file_exists(hir_id) == false {
        give back 0
    }
    repeat until v4_hir_local_annotation_record_count(hir_id) > record_id {
        array_push(v4_hir_local_annotation_items_handle(hir_id), word_from_int(0 - 1))
        array_push(v4_hir_local_annotation_stmt_spans_handle(hir_id), V4_NO_SPAN)
        array_push(v4_hir_local_annotation_types_handle(hir_id), "")
        array_push(v4_hir_local_annotation_type_spans_handle(hir_id), V4_NO_SPAN)
    }
    array_set(v4_hir_local_annotation_items_handle(hir_id), record_id, word_from_int(item_id))
    array_set(v4_hir_local_annotation_stmt_spans_handle(hir_id), record_id, stmt_span)
    array_set(v4_hir_local_annotation_types_handle(hir_id), record_id, type_text)
    array_set(v4_hir_local_annotation_type_spans_handle(hir_id), record_id, type_span)
    give back 1
}

task v4_hir_snapshot_restore_local_annotation_line(line: word) -> int {
    if v4_hir_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_hir_snapshot_field_raw(line, 0) != "hir-local-annotation" {
        give back 0
    }
    pilot hir_id = word_to_int(v4_hir_snapshot_field_raw(line, 1))
    pilot record_id = word_to_int(v4_hir_snapshot_field_raw(line, 2))
    pilot item_id = word_to_int(v4_hir_snapshot_field_raw(line, 3))
    pilot stmt_span = v4_hir_snapshot_field(line, 4)
    pilot type_text = v4_hir_snapshot_field(line, 5)
    pilot type_span = v4_hir_snapshot_field(line, 6)
    give back v4_hir_restore_local_annotation_slot(hir_id, record_id, item_id, stmt_span, type_text, type_span)
}

task v4_hir_snapshot_restore_diag_line(line: word) -> int {
    if v4_hir_snapshot_record_is_valid(line) == false {
        give back 0
    }
    if v4_hir_snapshot_field_raw(line, 0) != "hir-diag" {
        give back 0
    }
    pilot hir_id = word_to_int(v4_hir_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_hir_snapshot_field_raw(line, 2))
    pilot diag = v4_hir_snapshot_field(line, 3)
    give back v4_hir_restore_diag_slot(hir_id, diag_id, diag)
}

task v4_hir_begin_snapshot_restore() -> void {
    v4_hir_init()
    v4_hir_file_len = 0
}

task v4_hir_snapshot_restore(payload: word) -> word {
    pilot validation = v4_hir_snapshot_validate(payload)
    if validation.starts_with("hir-snapshot-import ok=1") == false {
        give back "hir-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_files = 0
    pilot restored_items = 0
    pilot restored_local_annotations = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    v4_hir_begin_snapshot_restore()

    pilot line_id = 0
    pilot line_count = v4_hir_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_hir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_hir_snapshot_field_raw(line, 0)
            if kind == "hir" {
                restored_files += v4_hir_snapshot_restore_file_line(line)
            } else if kind != "hir-item" and kind != "hir-diag" and kind != "hir-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    line_id = 0
    repeat until line_id >= line_count {
        pilot line = v4_hir_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_hir_snapshot_field_raw(line, 0)
            if kind == "hir-item" {
                restored_items += v4_hir_snapshot_restore_item_line(line)
            } else if kind == "hir-local-annotation" {
                restored_local_annotations += v4_hir_snapshot_restore_local_annotation_line(line)
            } else if kind == "hir-diag" {
                restored_diagnostics += v4_hir_snapshot_restore_diag_line(line)
            }
        }
        line_id += 1
    }

    pilot out = "hir-snapshot-restore ok=1"
    out = out + " files=" + word_from_int(restored_files)
    out = out + " items=" + word_from_int(restored_items)
    out = out + " local-annotations=" + word_from_int(restored_local_annotations)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-files=" + word_from_int(v4_hir_file_count())
    v4_session_semantic_restore_generation_advance()
    give back out
}
