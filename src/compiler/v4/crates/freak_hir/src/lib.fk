-- ===================================================================
-- freak_hir - V4 top-level HIR item lowering prototype
-- ===================================================================
-- Depends on freak_span, freak_diag, and freak_parse.
-- HIR is the first compiler-owned representation. This initial slice
-- lowers resilient parse nodes into syntax-independent top-level item
-- records with stable-ish def ids and carried diagnostics.

pilot v4_hir_task = "Task"
pilot v4_hir_shape = "Shape"
pilot v4_hir_route = "Route"
pilot v4_hir_alias = "Alias"
pilot v4_hir_const = "Const"
pilot v4_hir_impl = "Impl"
pilot v4_hir_doctrine = "Doctrine"
pilot v4_hir_import = "Import"
pilot v4_hir_extern = "Extern"
pilot v4_hir_attribute = "Attribute"
pilot v4_hir_error = "Error"
pilot v4_hir_snapshot_format = "freak-hir-snapshot-v1"

pilot v4_hir_files = 0
pilot v4_hir_trees = 0
pilot v4_hir_item_kinds = 0
pilot v4_hir_item_names = 0
pilot v4_hir_item_defs = 0
pilot v4_hir_item_spans = 0
pilot v4_hir_item_parse_nodes = 0
pilot v4_hir_diags = 0
pilot v4_hir_ready = 0

task v4_hir_init() -> void {
    if v4_hir_ready == 0 {
        v4_hir_files = array_new()
        v4_hir_trees = array_new()
        v4_hir_item_kinds = array_new()
        v4_hir_item_names = array_new()
        v4_hir_item_defs = array_new()
        v4_hir_item_spans = array_new()
        v4_hir_item_parse_nodes = array_new()
        v4_hir_diags = array_new()
        v4_hir_ready = 1
    }
}

task v4_hir_file_new(file_id: int, tree_id: int) -> int {
    v4_hir_init()
    pilot hir_id = array_len(v4_hir_files)
    array_push(v4_hir_files, word_from_int(file_id))
    array_push(v4_hir_trees, word_from_int(tree_id))
    array_push(v4_hir_item_kinds, word_from_int(array_new()))
    array_push(v4_hir_item_names, word_from_int(array_new()))
    array_push(v4_hir_item_defs, word_from_int(array_new()))
    array_push(v4_hir_item_spans, word_from_int(array_new()))
    array_push(v4_hir_item_parse_nodes, word_from_int(array_new()))
    array_push(v4_hir_diags, word_from_int(array_new()))
    give back hir_id
}

task v4_hir_kinds_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_kinds, hir_id))
}

task v4_hir_names_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_names, hir_id))
}

task v4_hir_defs_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_defs, hir_id))
}

task v4_hir_spans_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_spans, hir_id))
}

task v4_hir_parse_nodes_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_item_parse_nodes, hir_id))
}

task v4_hir_diags_handle(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_diags, hir_id))
}

task v4_hir_file_id(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_files, hir_id))
}

task v4_hir_tree_id(hir_id: int) -> int {
    give back word_to_int(array_get(v4_hir_trees, hir_id))
}

task v4_hir_file_count() -> int {
    v4_hir_init()
    give back array_len(v4_hir_files)
}

task v4_hir_file_exists(hir_id: int) -> bool {
    v4_hir_init()
    if hir_id < 0 {
        give back false
    }
    if hir_id >= array_len(v4_hir_files) {
        give back false
    }
    give back true
}

task v4_hir_def_id(file_id: int, item_kind: word, item_name: word, item_index: int) -> word {
    pilot safe_name = item_name
    if safe_name == "" {
        safe_name = "_"
    }
    give back "file" + word_from_int(file_id) + "::" + item_kind + "::" + safe_name + "#" + word_from_int(item_index)
}

task v4_hir_add_item(hir_id: int, item_kind: word, item_name: word, span: word, parse_node: int) -> int {
    pilot item_index = array_len(v4_hir_kinds_handle(hir_id))
    pilot file_id = word_to_int(array_get(v4_hir_files, hir_id))
    pilot def_id = v4_hir_def_id(file_id, item_kind, item_name, item_index)
    array_push(v4_hir_kinds_handle(hir_id), item_kind)
    array_push(v4_hir_names_handle(hir_id), item_name)
    array_push(v4_hir_defs_handle(hir_id), def_id)
    array_push(v4_hir_spans_handle(hir_id), span)
    array_push(v4_hir_parse_nodes_handle(hir_id), word_from_int(parse_node))
    give back item_index
}

task v4_hir_add_diag(hir_id: int, diag: word) -> void {
    array_push(v4_hir_diags_handle(hir_id), diag)
}

task v4_hir_item_count(hir_id: int) -> int {
    give back array_len(v4_hir_kinds_handle(hir_id))
}

task v4_hir_diag_count(hir_id: int) -> int {
    give back array_len(v4_hir_diags_handle(hir_id))
}

task v4_hir_item_kind(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_kinds_handle(hir_id), item_id)
}

task v4_hir_item_name(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_names_handle(hir_id), item_id)
}

task v4_hir_item_def(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_defs_handle(hir_id), item_id)
}

task v4_hir_item_span(hir_id: int, item_id: int) -> word {
    give back array_get(v4_hir_spans_handle(hir_id), item_id)
}

task v4_hir_item_parse_node(hir_id: int, item_id: int) -> int {
    give back word_to_int(array_get(v4_hir_parse_nodes_handle(hir_id), item_id))
}

task v4_hir_item_tree_id(hir_id: int) -> int {
    give back v4_hir_tree_id(hir_id)
}

task v4_hir_item_stream_id(hir_id: int) -> int {
    pilot tree_id = v4_hir_item_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    give back v4_parse_stream_id(tree_id)
}

task v4_hir_closure_count(hir_id: int, item_id: int) -> int {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back 0
    }
    give back v4_parse_closure_count(tree_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_closure_parse_node(hir_id: int, item_id: int, closure_id: int) -> int {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0 - 1
    }
    pilot tree_id = v4_hir_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back 0 - 1
    }
    give back v4_parse_closure_node(tree_id, v4_hir_item_parse_node(hir_id, item_id), closure_id)
}

task v4_hir_closure_mode(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_parse_closure_mode(tree_id, closure_node)
}

task v4_hir_closure_span(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_parse_node_span(v4_hir_tree_id(hir_id), closure_node)
}

task v4_hir_closure_body_kind(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_parse_closure_body_kind(tree_id, closure_node)
}

task v4_hir_closure_body_span(hir_id: int, item_id: int, closure_id: int) -> word {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_parse_closure_body_span(tree_id, closure_node)
}

task v4_hir_closure_body_start_token(hir_id: int, item_id: int, closure_id: int) -> int {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back 0 - 1
    }
    give back v4_parse_closure_body_start_token(tree_id, closure_node)
}

task v4_hir_closure_body_end_token(hir_id: int, item_id: int, closure_id: int) -> int {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back 0 - 1
    }
    give back v4_parse_closure_body_end_token(tree_id, closure_node)
}

task v4_hir_closure_param_count(hir_id: int, item_id: int, closure_id: int) -> int {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back 0
    }
    give back v4_parse_closure_param_count(tree_id, closure_node)
}

task v4_hir_closure_param_name(hir_id: int, item_id: int, closure_id: int, param_id: int) -> word {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_parse_closure_param_name(tree_id, closure_node, param_id)
}

task v4_hir_closure_param_type(hir_id: int, item_id: int, closure_id: int, param_id: int) -> word {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back ""
    }
    give back v4_parse_closure_param_type(tree_id, closure_node, param_id)
}

task v4_hir_closure_param_span(hir_id: int, item_id: int, closure_id: int, param_id: int) -> word {
    pilot tree_id = v4_hir_tree_id(hir_id)
    pilot closure_node = v4_hir_closure_parse_node(hir_id, item_id, closure_id)
    if closure_node < 0 {
        give back V4_NO_SPAN
    }
    give back v4_parse_closure_param_span(tree_id, closure_node, param_id)
}

task v4_hir_closure_at_offset(hir_id: int, item_id: int, offset: int) -> int {
    pilot closure_id = 0
    pilot closure_count = v4_hir_closure_count(hir_id, item_id)
    repeat until closure_id >= closure_count {
        pilot span = v4_hir_closure_span(hir_id, item_id, closure_id)
        if offset >= v4_span_start(span) and offset < v4_span_end(span) {
            give back closure_id
        }
        closure_id += 1
    }
    give back 0 - 1
}

task v4_hir_item_decl_keyword(hir_id: int, item_id: int) -> word {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back ""
    }
    pilot tree_id = v4_hir_item_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back ""
    }
    give back v4_parse_node_decl_keyword(tree_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_route_is_variant(hir_id: int, item_id: int) -> bool {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_route {
        give back false
    }
    give back v4_hir_item_decl_keyword(hir_id, item_id) == "variant"
}

task v4_hir_import_path(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_import {
        give back ""
    }
    pilot tree_id = v4_hir_item_tree_id(hir_id)
    if v4_parse_tree_exists(tree_id) == false {
        give back ""
    }
    give back v4_parse_import_path(tree_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_import_alias(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_import {
