    pilot record_id = v4_hir_task_param_owner_record_count(hir_id)
    array_push(v4_hir_task_param_owner_items_handle(hir_id), word_from_int(item_id))
    array_push(v4_hir_task_param_owner_counts_handle(hir_id), word_from_int(count))
    give back record_id
}

task v4_hir_add_task_param(hir_id: int, item_id: int, ordinal: int, name: word, name_span: word, mode: word, lifetime_name: word, lifetime_span: word, type_text: word, type_span: word, segment_span: word) -> int {
    pilot record_id = v4_hir_task_param_record_count(hir_id)
    array_push(v4_hir_task_param_items_handle(hir_id), word_from_int(item_id))
    array_push(v4_hir_task_param_ordinals_handle(hir_id), word_from_int(ordinal))
    array_push(v4_hir_task_param_names_handle(hir_id), name)
    array_push(v4_hir_task_param_name_spans_handle(hir_id), name_span)
    array_push(v4_hir_task_param_modes_handle(hir_id), mode)
    array_push(v4_hir_task_param_lifetimes_handle(hir_id), lifetime_name)
    array_push(v4_hir_task_param_lifetime_spans_handle(hir_id), lifetime_span)
    array_push(v4_hir_task_param_types_handle(hir_id), type_text)
    array_push(v4_hir_task_param_type_spans_handle(hir_id), type_span)
    array_push(v4_hir_task_param_segment_spans_handle(hir_id), segment_span)
    give back record_id
}

task v4_hir_first_token_at_or_after(stream_id: int, offset: int) -> int {
    pilot token_id = 0
    pilot token_count = v4_lex_token_count(stream_id)
    repeat until token_id >= token_count {
        if v4_span_start(v4_lex_token_span(stream_id, token_id)) >= offset {
            give back token_id
        }
        token_id += 1
    }
    give back token_count
}

task v4_hir_skip_trivia(stream_id: int, token_id: int, end_token: int) -> int {
    pilot idx = token_id
    repeat until idx >= end_token or v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
        idx += 1
    }
    give back idx
}

task v4_hir_previous_nontrivia(stream_id: int, token_id: int, start_token: int) -> int {
    pilot idx = token_id
    repeat until idx < start_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            give back idx
        }
        idx -= 1
    }
    give back 0 - 1
}

task v4_hir_has_newline_between(stream_id: int, earlier_token: int, later_token: int) -> bool {
    pilot idx = earlier_token + 1
    repeat until idx >= later_token {
        if v4_lex_token_type(stream_id, idx) == v4_tok_trivia and v4_lex_token_value(stream_id, idx) == "\n" {
            give back true
        }
        idx += 1
    }
    give back false
}

task v4_hir_token_starts_statement(stream_id: int, token_id: int, item_start: int) -> bool {
    pilot previous = v4_hir_previous_nontrivia(stream_id, token_id - 1, item_start)
    if previous < item_start {
        give back true
    }
    pilot previous_value = v4_lex_token_value(stream_id, previous)
    if previous_value == "{" or previous_value == "}" or previous_value == ";" {
        give back true
    }
    give back v4_hir_has_newline_between(stream_id, previous, token_id)
}

task v4_hir_pilot_starts_local_decl(stream_id: int, pilot_token: int, item_start: int) -> bool {
    if v4_hir_token_starts_statement(stream_id, pilot_token, item_start) {
        give back true
    }
    pilot previous = v4_hir_previous_nontrivia(stream_id, pilot_token - 1, item_start)
    if previous < item_start or v4_lex_token_value(stream_id, previous) != "fixed" {
        give back false
    }
    give back v4_hir_token_starts_statement(stream_id, previous, item_start)
}

task v4_hir_depth_after_token(depth: int, value: word) -> int {
    if value == "(" or value == "[" or value == "{" {
        give back depth + 1
    }
    if value == ")" or value == "]" or value == "}" {
        if depth > 0 {
            give back depth - 1
        }
    }
    give back depth
}

task v4_hir_statement_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot value = v4_lex_token_value(stream_id, idx)
        if token_type != v4_tok_trivia {
            if value == "}" and depth == 0 {
                give back idx
            }
            if value == ";" and depth == 0 {
                give back idx
            }
            depth = v4_hir_depth_after_token(depth, value)
        } else if value == "\n" and depth == 0 {
            give back idx
        }
        idx += 1
    }
    give back end_token
}

task v4_hir_find_local_assignment(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "=" and depth == 0 {
                give back idx
            }
            depth = v4_hir_depth_after_token(depth, value)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_find_local_annotation_colon(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == ":" and depth == 0 {
                give back idx
            }
            depth = v4_hir_depth_after_token(depth, value)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_span_from_tokens(stream_id: int, start_token: int, end_token: int) -> word {
    pilot first = v4_hir_skip_trivia(stream_id, start_token, end_token)
    pilot last = v4_hir_previous_nontrivia(stream_id, end_token - 1, first)
    if first >= end_token or last < first {
        give back V4_NO_SPAN
    }
    pilot first_span = v4_lex_token_span(stream_id, first)
    pilot last_span = v4_lex_token_span(stream_id, last)
    give back v4_span_new(v4_span_file(first_span), v4_span_start(first_span), v4_span_end(last_span))
}

task v4_hir_local_annotation_type_text(stream_id: int, start_token: int, end_token: int) -> word {
    pilot out = ""
    pilot previous_value = ""
    pilot previous_previous_value = ""
    pilot previous_type = ""
    pilot idx = start_token
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        if token_type != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            pilot needs_separator: bool = previous_value == "lend" or previous_value == "dyn"
            if previous_value == "mut" and previous_previous_value == "lend" {
                needs_separator = true
            }
            if previous_type == v4_tok_lifetime and value != ":" and value != "+" and value != "," and value != ">" and value != ")" and value != "]" and value != ";" {
                needs_separator = true
            }
            if out != "" and needs_separator {
                out = out + " "
            }
            out = out + value
            previous_previous_value = previous_value
            previous_value = value
            previous_type = token_type
        }
        idx += 1
    }
    give back out
}

task v4_hir_task_param_open_token(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot generic_depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "(" and generic_depth == 0 {
                give back idx
            }
            if value == "<" {
                generic_depth += 1
            } else if value == ">" and generic_depth > 0 {
                generic_depth -= 1
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_task_param_close_token(stream_id: int, open_token: int, end_token: int) -> int {
    if open_token < 0 {
        give back 0 - 1
    }
    pilot idx = open_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "(" {
                depth += 1
            } else if value == ")" {
                depth -= 1
                if depth == 0 {
                    give back idx
                }
            }
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_task_param_depth_after_token(depth: int, value: word) -> int {
    if value == "(" or value == "[" or value == "{" or value == "<" {
        give back depth + 1
    }
    if value == ")" or value == "]" or value == "}" or value == ">" {
        if depth > 0 {
            give back depth - 1
        }
    }
    give back depth
}

task v4_hir_task_param_find_colon(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == ":" and depth == 0 {
                give back idx
            }
            depth = v4_hir_task_param_depth_after_token(depth, value)
        }
        idx += 1
    }
    give back 0 - 1
}

task v4_hir_task_param_add_error(hir_id: int, span: word, help: word) -> void {
    v4_hir_add_diag(hir_id, v4_diag_new(v4_diag_error, span, "invalid ordinary task parameter declaration", help))
}

task v4_hir_lower_task_param_segment(hir_id: int, item_id: int, stream_id: int, start_token: int, end_token: int, ordinal: int) -> int {
    pilot segment_span = v4_hir_span_from_tokens(stream_id, start_token, end_token)
    pilot no_span = V4_NO_SPAN
    if segment_span == no_span {
        pilot item_span = v4_hir_item_span(hir_id, item_id)
        v4_hir_task_param_add_error(hir_id, item_span, "remove the empty parameter segment or add name: Type")
        give back 0
    }

    pilot colon = v4_hir_task_param_find_colon(stream_id, start_token, end_token)
    if colon < 0 {
        v4_hir_task_param_add_error(hir_id, segment_span, "ordinary task parameters require name: Type")
        give back 0
    }

    pilot cursor = v4_hir_skip_trivia(stream_id, start_token, colon)
    pilot mode = v4_hir_task_param_mode_value
    pilot lifetime_name = ""
    pilot lifetime_span = no_span
    if cursor < colon and v4_lex_token_value(stream_id, cursor) == "lend" {
        mode = v4_hir_task_param_mode_lend
        cursor = v4_hir_skip_trivia(stream_id, cursor + 1, colon)
        if cursor < colon and v4_lex_token_value(stream_id, cursor) == "mut" {
            mode = v4_hir_task_param_mode_lend_mut
            cursor = v4_hir_skip_trivia(stream_id, cursor + 1, colon)
        }
        if cursor < colon and v4_lex_token_type(stream_id, cursor) == v4_tok_lifetime {
            pilot candidate_lifetime = v4_lex_token_value(stream_id, cursor)
            if candidate_lifetime != "'_" {
                lifetime_name = candidate_lifetime
                lifetime_span = v4_lex_token_span(stream_id, cursor)
            }
            cursor = v4_hir_skip_trivia(stream_id, cursor + 1, colon)
        }
    }

    if cursor >= colon or v4_lex_token_type(stream_id, cursor) != v4_tok_ident {
        v4_hir_task_param_add_error(hir_id, segment_span, "add one identifier before the parameter colon")
        give back 0
    }
    pilot name = v4_lex_token_value(stream_id, cursor)
    pilot name_span = v4_lex_token_span(stream_id, cursor)
    cursor = v4_hir_skip_trivia(stream_id, cursor + 1, colon)
    if cursor != colon {
        v4_hir_task_param_add_error(hir_id, segment_span, "keep only lend, optional mut/lifetime, and one name before the colon")
        give back 0
    }

    pilot type_start = v4_hir_skip_trivia(stream_id, colon + 1, end_token)
    if type_start >= end_token {
        v4_hir_task_param_add_error(hir_id, segment_span, "add a parameter type after the colon")
        give back 0
    }
    pilot type_text = v4_hir_local_annotation_type_text(stream_id, type_start, end_token)
    pilot type_span = v4_hir_span_from_tokens(stream_id, type_start, end_token)
    if type_text == "" or type_span == no_span {
        v4_hir_task_param_add_error(hir_id, segment_span, "add a complete parameter type after the colon")
        give back 0
    }

    v4_hir_add_task_param(hir_id, item_id, ordinal, name, name_span, mode, lifetime_name, lifetime_span, type_text, type_span, segment_span)
    give back 1
}

task v4_hir_lower_task_params(hir_id: int, item_id: int) -> void {
    if not v4_hir_item_decl_is_ordinary_task(hir_id, item_id) {
        give back
    }
    pilot stream_id = v4_hir_item_stream_id(hir_id)
    if stream_id < 0 {
        v4_hir_task_param_add_error(hir_id, v4_hir_item_span(hir_id, item_id), "the expanded task signature has no token stream")
        v4_hir_add_task_param_owner(hir_id, item_id, 0)
        give back
    }
    pilot item_span = v4_hir_item_span(hir_id, item_id)
    pilot item_start = v4_hir_first_token_at_or_after(stream_id, v4_span_start(item_span))
    pilot item_end = v4_hir_first_token_at_or_after(stream_id, v4_span_end(item_span))
    pilot param_open = v4_hir_task_param_open_token(stream_id, item_start, item_end)
    pilot param_close = v4_hir_task_param_close_token(stream_id, param_open, item_end)
    if param_open < 0 or param_close < 0 {
        v4_hir_task_param_add_error(hir_id, item_span, "add a complete (...) parameter list")
        v4_hir_add_task_param_owner(hir_id, item_id, 0)
        give back
    }

    pilot first = v4_hir_skip_trivia(stream_id, param_open + 1, param_close)
    if first >= param_close {
        v4_hir_add_task_param_owner(hir_id, item_id, 0)
        give back
    }

    pilot valid_count = 0
    pilot segment_start = param_open + 1
    pilot depth = 0
    pilot idx = param_open + 1
    repeat until idx > param_close {
        pilot at_end = idx == param_close
        pilot separator = false
        if not at_end and v4_lex_token_type(stream_id, idx) != v4_tok_trivia {
            pilot value = v4_lex_token_value(stream_id, idx)
            if value == "," and depth == 0 {
                separator = true
            } else {
                depth = v4_hir_task_param_depth_after_token(depth, value)
            }
        }
        if at_end or separator {
            valid_count += v4_hir_lower_task_param_segment(hir_id, item_id, stream_id, segment_start, idx, valid_count)
            segment_start = idx + 1
        }
        idx += 1
    }
    v4_hir_add_task_param_owner(hir_id, item_id, valid_count)
}

task v4_hir_task_return_type_end(stream_id: int, start_token: int, end_token: int) -> int {
    pilot idx = start_token
    pilot depth = 0
    repeat until idx >= end_token {
        pilot token_type = v4_lex_token_type(stream_id, idx)
        pilot value = v4_lex_token_value(stream_id, idx)
        if token_type == v4_tok_trivia {
            if value == "\n" and depth == 0 {
                give back idx
            }
        } else {
            if depth == 0 and (value == "{" or value == "=>") {
                give back idx
            }
            if value == "(" or value == "[" or value == "<" {
                depth += 1
            } else if value == ")" or value == "]" or value == ">" {
                if depth > 0 {
                    depth -= 1
                }
            }
        }
        idx += 1
    }
    give back end_token
}

task v4_hir_lower_task_return(hir_id: int, item_id: int) -> void {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_task {
        give back
    }
    pilot stream_id = v4_hir_item_stream_id(hir_id)
    if stream_id < 0 {
        give back
    }
    pilot item_span = v4_hir_item_span(hir_id, item_id)
    pilot item_start = v4_hir_first_token_at_or_after(stream_id, v4_span_start(item_span))
    pilot item_end = v4_hir_first_token_at_or_after(stream_id, v4_span_end(item_span))
    pilot param_open = v4_hir_task_param_open_token(stream_id, item_start, item_end)
    pilot param_close = v4_hir_task_param_close_token(stream_id, param_open, item_end)
    if param_close < 0 {
        pilot missing_params_record = v4_hir_add_task_return(hir_id, item_id, v4_hir_task_return_implicit_block, "", V4_NO_SPAN)
        give back
    }
    pilot after_params = v4_hir_skip_trivia(stream_id, param_close + 1, item_end)
    if after_params >= item_end {
        pilot missing_body_record = v4_hir_add_task_return(hir_id, item_id, v4_hir_task_return_implicit_block, "", V4_NO_SPAN)
        give back
    }

    pilot marker = v4_lex_token_value(stream_id, after_params)
    pilot no_span = V4_NO_SPAN
    if marker == "->" {
        pilot type_start = v4_hir_skip_trivia(stream_id, after_params + 1, item_end)
        pilot type_end = v4_hir_task_return_type_end(stream_id, type_start, item_end)
        pilot type_text = v4_hir_local_annotation_type_text(stream_id, type_start, type_end)
        pilot type_span = v4_hir_span_from_tokens(stream_id, type_start, type_end)
        if type_text != "" and type_span != no_span {
            pilot explicit_record = v4_hir_add_task_return(hir_id, item_id, v4_hir_task_return_explicit, type_text, type_span)
            give back
        }
    } else if marker == "=>" {
        pilot arrow_record = v4_hir_add_task_return(hir_id, item_id, v4_hir_task_return_arrow, "", V4_NO_SPAN)
        give back
    }
    pilot implicit_record = v4_hir_add_task_return(hir_id, item_id, v4_hir_task_return_implicit_block, "", V4_NO_SPAN)
}

task v4_hir_lower_local_annotations(hir_id: int, item_id: int) -> void {
    pilot item_kind = v4_hir_item_kind(hir_id, item_id)
    if item_kind != v4_hir_task and item_kind != v4_hir_impl and item_kind != v4_hir_doctrine {
        give back
    }
    pilot stream_id = v4_hir_item_stream_id(hir_id)
    if stream_id < 0 {
        give back
    }
    pilot item_span = v4_hir_item_span(hir_id, item_id)
    pilot item_start = v4_hir_first_token_at_or_after(stream_id, v4_span_start(item_span))
    pilot item_end = v4_hir_first_token_at_or_after(stream_id, v4_span_end(item_span))
    pilot idx = item_start
    repeat until idx >= item_end {
        if v4_lex_token_type(stream_id, idx) != v4_tok_trivia and v4_lex_token_value(stream_id, idx) == "pilot" and v4_hir_pilot_starts_local_decl(stream_id, idx, item_start) {
            pilot stmt_end = v4_hir_statement_end(stream_id, idx, item_end)
            pilot pattern_start = v4_hir_skip_trivia(stream_id, idx + 1, stmt_end)
            pilot assignment = v4_hir_find_local_assignment(stream_id, pattern_start, stmt_end)
            pilot decl_end = stmt_end
            if assignment >= 0 {
                decl_end = assignment
            }
            pilot colon = v4_hir_find_local_annotation_colon(stream_id, pattern_start, decl_end)
            if colon >= 0 {
                pilot type_start = v4_hir_skip_trivia(stream_id, colon + 1, decl_end)
                if type_start < decl_end {
                    pilot type_text = v4_hir_local_annotation_type_text(stream_id, type_start, decl_end)
                    pilot type_span = v4_hir_span_from_tokens(stream_id, type_start, decl_end)
                    pilot stmt_span = v4_hir_span_from_tokens(stream_id, idx, stmt_end)
                    if type_text != "" {
                        v4_hir_add_local_annotation(hir_id, item_id, stmt_span, type_text, type_span)
                    }
                }
            }
        }
        idx += 1
    }
}

task v4_hir_const_type(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_const {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_const_type(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_const_init(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_const {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_const_init(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_item_attribute_start(hir_id: int, item_id: int) -> int {
    if item_id <= 0 {
        give back item_id
    }
    pilot idx = item_id - 1
    repeat until idx < 0 or v4_hir_item_kind(hir_id, idx) != v4_hir_attribute {
        idx -= 1
    }
    give back idx + 1
}

task v4_hir_item_attribute_count(hir_id: int, item_id: int) -> int {
    if item_id < 0 or item_id >= v4_hir_item_count(hir_id) {
        give back 0
    }
    if v4_hir_item_kind(hir_id, item_id) == v4_hir_attribute {
        give back 0
    }
    pilot start = v4_hir_item_attribute_start(hir_id, item_id)
    if start < 0 or start >= item_id {
        give back 0
    }
    give back item_id - start
}

task v4_hir_item_attribute_item(hir_id: int, item_id: int, attr_id: int) -> int {
    if attr_id < 0 {
        give back 0 - 1
    }
    pilot count = v4_hir_item_attribute_count(hir_id, item_id)
    if attr_id >= count {
        give back 0 - 1
    }
    give back v4_hir_item_attribute_start(hir_id, item_id) + attr_id
}

task v4_hir_item_attribute_name(hir_id: int, item_id: int, attr_id: int) -> word {
    pilot attr_item = v4_hir_item_attribute_item(hir_id, item_id, attr_id)
    if attr_item < 0 {
        give back ""
    }
    give back v4_hir_item_name(hir_id, attr_item)
}

task v4_hir_item_attribute_arg(hir_id: int, item_id: int, attr_id: int) -> word {
    pilot attr_item = v4_hir_item_attribute_item(hir_id, item_id, attr_id)
    if attr_item < 0 {
        give back ""
    }
    give back v4_hir_attribute_arg(hir_id, attr_item)
}

task v4_hir_item_has_attribute(hir_id: int, item_id: int, wanted_name: word) -> bool {
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, item_id)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, item_id, attr_idx) == wanted_name {
            give back true
        }
        attr_idx += 1
    }
    give back false
}

task v4_hir_item_attribute_arg_for_name(hir_id: int, item_id: int, wanted_name: word) -> word {
    pilot attr_idx = 0
    pilot attr_count = v4_hir_item_attribute_count(hir_id, item_id)
    repeat until attr_idx >= attr_count {
        if v4_hir_item_attribute_name(hir_id, item_id, attr_idx) == wanted_name {
            give back v4_hir_item_attribute_arg(hir_id, item_id, attr_idx)
        }
        attr_idx += 1
    }
    give back ""
}

task v4_hir_extern_abi(hir_id: int, item_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_abi(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_extern_member_count(hir_id: int, item_id: int) -> int {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back 0
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back 0
    }
    give back v4_expand_extern_member_count(expansion_id, v4_hir_item_parse_node(hir_id, item_id))
}

task v4_hir_extern_member_name(hir_id: int, item_id: int, member_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_member_name(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id)
}

task v4_hir_extern_member_attribute_count(hir_id: int, item_id: int, member_id: int) -> int {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back 0
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back 0
    }
    give back v4_expand_extern_member_attribute_count(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id)
}

task v4_hir_extern_member_attribute_name(hir_id: int, item_id: int, member_id: int, attr_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_member_attribute_name(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id, attr_id)
}

task v4_hir_extern_member_attribute_arg(hir_id: int, item_id: int, member_id: int, attr_id: int) -> word {
    if v4_hir_item_kind(hir_id, item_id) != v4_hir_extern {
        give back ""
    }
    pilot expansion_id = v4_hir_item_expansion_id(hir_id)
    if v4_expand_tree_exists(expansion_id) == false {
        give back ""
    }
    give back v4_expand_extern_member_attribute_arg(expansion_id, v4_hir_item_parse_node(hir_id, item_id), member_id, attr_id)
}

task v4_hir_diag(hir_id: int, diag_id: int) -> word {
    give back array_get(v4_hir_diags_handle(hir_id), diag_id)
}

task v4_hir_kind_from_parse(parse_kind: word) -> word {
    if parse_kind == v4_node_task { give back v4_hir_task }
    if parse_kind == v4_node_shape { give back v4_hir_shape }
    if parse_kind == v4_node_route { give back v4_hir_route }
    if parse_kind == v4_node_alias { give back v4_hir_alias }
    if parse_kind == v4_node_const { give back v4_hir_const }
    if parse_kind == v4_node_impl { give back v4_hir_impl }
    if parse_kind == v4_node_doctrine { give back v4_hir_doctrine }
    if parse_kind == v4_node_use { give back v4_hir_import }
    if parse_kind == v4_node_extern { give back v4_hir_extern }
    if parse_kind == v4_node_attribute { give back v4_hir_attribute }
    if parse_kind == v4_node_error { give back v4_hir_error }
    if parse_kind == v4_node_incomplete { give back v4_hir_error }
    give back ""
}

task v4_hir_should_lower_parse_node(parse_kind: word) -> bool {
    give back v4_hir_kind_from_parse(parse_kind) != ""
}

task v4_hir_copy_expand_diags(hir_id: int, expansion_id: int) -> void {
    pilot diag_idx = 0
    pilot diag_count = v4_expand_diag_count(expansion_id)
    repeat until diag_idx >= diag_count {
        v4_hir_add_diag(hir_id, v4_expand_diag(expansion_id, diag_idx))
        diag_idx += 1
    }
}

task v4_hir_lower_expanded(file_id: int, expansion_id: int) -> int {
    v4_hir_init()
    pilot hir_id = v4_hir_file_new(file_id, expansion_id)
    v4_hir_copy_expand_diags(hir_id, expansion_id)

    pilot node_idx = 0
    pilot node_count = v4_expand_node_count(expansion_id)
    repeat until node_idx >= node_count {
        pilot parse_kind = v4_expand_node_kind(expansion_id, node_idx)
        if v4_hir_should_lower_parse_node(parse_kind) {
            pilot hir_kind = v4_hir_kind_from_parse(parse_kind)
            pilot item_name = v4_expand_node_value(expansion_id, node_idx)
            pilot item_span = v4_expand_node_span(expansion_id, node_idx)
            pilot item_id = v4_hir_add_item(hir_id, hir_kind, item_name, item_span, node_idx)
            v4_hir_lower_alias_target_type(hir_id, item_id, expansion_id, node_idx)
            v4_hir_lower_task_params(hir_id, item_id)
            v4_hir_lower_task_return(hir_id, item_id)
            v4_hir_lower_local_annotations(hir_id, item_id)
        }
        node_idx += 1
    }

    give back hir_id
}

-- Compatibility entry for direct bootstrap fixtures. Even this path creates
-- an ExpandedFile first, so Parse -> HIR cannot bypass freak_expand.
task v4_hir_lower_tree(file_id: int, tree_id: int) -> int {
    pilot expansion_id = v4_expand_identity(file_id, tree_id)
    if expansion_id < 0 { give back 0 - 1 }
    give back v4_hir_lower_expanded(file_id, expansion_id)
}

task v4_hir_summary(hir_id: int) -> word {
    pilot summary = "hir-ok hir=" + word_from_int(hir_id)
    summary = summary + " items=" + word_from_int(v4_hir_item_count(hir_id))
    summary = summary + " diagnostics=" + word_from_int(v4_hir_diag_count(hir_id))
    give back summary
}

