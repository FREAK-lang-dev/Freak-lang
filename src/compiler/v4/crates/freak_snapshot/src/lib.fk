    out = out + "|" + v4_definition_snapshot_escape(v4_definition_at_kind(defn_id))
    out = out + "|" + v4_definition_snapshot_escape(v4_definition_at_def(defn_id))
    out = out + "|" + word_from_int(v4_definition_at_hir_item(defn_id))
    out = out + "|" + v4_definition_snapshot_escape(v4_definition_at_span(defn_id))
