    if ch == "X" { give back 60 }
    if ch == "Y" { give back 61 }
    if ch == "Z" { give back 62 }
    if ch == "[" { give back 63 }
    if ch == "\\" { give back 64 }
    if ch == "]" { give back 65 }
    if ch == "^" { give back 66 }
    if ch == "_" { give back 67 }
    if ch == "a" { give back 68 }
    if ch == "b" { give back 69 }
    if ch == "c" { give back 70 }
    if ch == "d" { give back 71 }
    if ch == "e" { give back 72 }
    if ch == "f" { give back 73 }
    if ch == "g" { give back 74 }
    if ch == "h" { give back 75 }
    if ch == "i" { give back 76 }
    if ch == "j" { give back 77 }
    if ch == "k" { give back 78 }
    if ch == "l" { give back 79 }
    if ch == "m" { give back 80 }
    if ch == "n" { give back 81 }
    if ch == "o" { give back 82 }
