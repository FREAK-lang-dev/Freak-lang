-- ===================================================================
-- freak_snapshot - V4 00-Unit workspace snapshot layer
-- ===================================================================
-- Depends on freak_driver and the lower V4 crates. This crate owns
-- the unified workspace snapshot envelope, manifest, diff, health,
-- and restore coordination so the driver does not become the new monolith.

pilot v4_diagnostics_snapshot_format = "freak-diagnostics-snapshot-v1"
pilot v4_semantic_snapshot_format = "freak-semantic-snapshot-v1"
pilot v4_hover_snapshot_format = "freak-hover-snapshot-v1"
pilot v4_definition_snapshot_format = "freak-definition-snapshot-v1"
pilot v4_document_symbols_snapshot_format = "freak-document-symbols-snapshot-v1"
pilot v4_completion_snapshot_format = "freak-completion-snapshot-v1"

task v4_diagnostics_snapshot_escape(value: word) -> word {
    give back v4_borrowck_snapshot_escape(value)
}

task v4_diagnostics_snapshot_unescape(value: word) -> word {
    give back v4_borrowck_snapshot_unescape(value)
}

task v4_diagnostics_snapshot_line_count(payload: word) -> int {
    give back v4_borrowck_snapshot_line_count(payload)
}

task v4_diagnostics_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_borrowck_snapshot_line(payload, wanted)
}

task v4_diagnostics_snapshot_field_count(line: word) -> int {
    give back v4_borrowck_snapshot_field_count(line)
}

task v4_diagnostics_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_borrowck_snapshot_field_raw(line, wanted)
}

task v4_diagnostics_snapshot_field(line: word, wanted: int) -> word {
    give back v4_borrowck_snapshot_field(line, wanted)
}

task v4_diagnostics_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_borrowck_snapshot_key_value(line, wanted_key)
}

task v4_diagnostics_snapshot_diag_total() -> int {
    v4_driver_init()
    pilot total = 0
    pilot diag_set_id = 0
    repeat until diag_set_id >= v4_diagnostics_set_count() {
        total += v4_diagnostics_count(diag_set_id)
        diag_set_id += 1
    }
    give back total
}

task v4_diagnostics_snapshot_summary() -> word {
    pilot summary = "diagnostics-snapshot"
    summary = summary + " format=" + v4_diagnostics_snapshot_format
    summary = summary + " sets=" + word_from_int(v4_diagnostics_set_count())
    summary = summary + " diagnostics=" + word_from_int(v4_diagnostics_snapshot_diag_total())
    give back summary
}

task v4_diagnostics_snapshot_header() -> word {
    pilot out = "diagnostics-snapshot"
    out = out + "|format=" + v4_diagnostics_snapshot_format
    out = out + "|sets=" + word_from_int(v4_diagnostics_set_count())
    out = out + "|diagnostics=" + word_from_int(v4_diagnostics_snapshot_diag_total())
    give back out
}

task v4_diagnostics_snapshot_set_line(diag_set_id: int) -> word {
    pilot out = "diagnostics"
    out = out + "|" + word_from_int(diag_set_id)
    out = out + "|" + v4_diagnostics_snapshot_escape(v4_diagnostics_path(diag_set_id))
    out = out + "|" + word_from_int(v4_diagnostics_count(diag_set_id))
    give back out
}

task v4_diagnostics_snapshot_diag_line(diag_set_id: int, diag_id: int) -> word {
    pilot out = "diagnostic"
    out = out + "|" + word_from_int(diag_set_id)
    out = out + "|" + word_from_int(diag_id)
    out = out + "|" + v4_diagnostics_snapshot_escape(v4_diagnostics_diag(diag_set_id, diag_id))
    give back out
}

task v4_diagnostics_snapshot() -> word {
    v4_driver_init()
    pilot out = v4_diagnostics_snapshot_header()
    pilot diag_set_id = 0
    repeat until diag_set_id >= v4_diagnostics_set_count() {
        out = out + "\n" + v4_diagnostics_snapshot_set_line(diag_set_id)

        pilot diag_id = 0
        pilot diag_count = v4_diagnostics_count(diag_set_id)
        repeat until diag_id >= diag_count {
            out = out + "\n" + v4_diagnostics_snapshot_diag_line(diag_set_id, diag_id)
            diag_id += 1
        }
        diag_set_id += 1
    }
    out = out + "\nend|" + v4_diagnostics_snapshot_format
    give back out
}

task v4_diagnostics_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "diagnostics-snapshot" { give back 4 }
    if kind == "diagnostics" { give back 4 }
    if kind == "diagnostic" { give back 4 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_diagnostics_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_diagnostics_snapshot_field_raw(line, 0)
    pilot expected = v4_diagnostics_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_diagnostics_snapshot_field_count(line) < expected {
        give back false
    }
    give back true
}

task v4_diagnostics_snapshot_validate(payload: word) -> word {
    pilot lines = v4_diagnostics_snapshot_line_count(payload)
    pilot sets = 0
    pilot diagnostics = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_diagnostics_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_diagnostics_snapshot_field_raw(line, 0)
            if v4_diagnostics_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "diagnostics-snapshot" {
                saw_header += 1
                format = v4_diagnostics_snapshot_key_value(line, "format")
                if format != v4_diagnostics_snapshot_format {
                    malformed += 1
                }
            } else if kind == "diagnostics" {
                sets += 1
            } else if kind == "diagnostic" {
                diagnostics += 1
            } else if kind == "end" {
                saw_end += 1
                if v4_diagnostics_snapshot_field(line, 1) != v4_diagnostics_snapshot_format {
                    malformed += 1
                }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }

    pilot out = "diagnostics-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " sets=" + word_from_int(sets)
    out = out + " diagnostics=" + word_from_int(diagnostics)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}


task v4_diagnostics_snapshot_restore_set_line(line: word) -> int {
    if v4_diagnostics_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_diagnostics_snapshot_field_raw(line, 0) != "diagnostics" { give back 0 }
    pilot diag_set_id = word_to_int(v4_diagnostics_snapshot_field_raw(line, 1))
    pilot path = v4_diagnostics_snapshot_field(line, 2)
    v4_diagnostics_restore_set_slot(diag_set_id, path)
    give back 1
}

task v4_diagnostics_snapshot_restore_diag_line(line: word) -> int {
    if v4_diagnostics_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_diagnostics_snapshot_field_raw(line, 0) != "diagnostic" { give back 0 }
    pilot diag_set_id = word_to_int(v4_diagnostics_snapshot_field_raw(line, 1))
    pilot diag_id = word_to_int(v4_diagnostics_snapshot_field_raw(line, 2))
    pilot diag = v4_diagnostics_snapshot_field(line, 3)
    give back v4_diagnostics_restore_diag_slot(diag_set_id, diag_id, diag)
}

task v4_diagnostics_snapshot_restore(payload: word) -> word {
    pilot validation = v4_diagnostics_snapshot_validate(payload)
    if validation.starts_with("diagnostics-snapshot-import ok=1") == false {
        give back "diagnostics-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot restored_sets = 0
    pilot restored_diagnostics = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_diagnostics_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_diagnostics_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_diagnostics_snapshot_field_raw(line, 0)
            if kind == "diagnostics" {
                restored_sets += v4_diagnostics_snapshot_restore_set_line(line)
            } else if kind == "diagnostic" {
                restored_diagnostics += v4_diagnostics_snapshot_restore_diag_line(line)
            } else if kind != "diagnostics-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "diagnostics-snapshot-restore ok=1"
    out = out + " sets=" + word_from_int(restored_sets)
    out = out + " diagnostics=" + word_from_int(restored_diagnostics)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-sets=" + word_from_int(v4_diagnostics_set_count())
    give back out
}


