task v4_definition_snapshot_validate(payload: word) -> word {
    pilot lines = v4_definition_snapshot_line_count(payload)
    pilot definitions = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_definitions = ""
    pilot declared_semantic_facts = ""
    pilot semantic_fact_bound = 0 - 1
    pilot invalid_ids = 0
    pilot invalid_offsets = 0
    pilot invalid_semantic_refs = 0
    pilot invalid_hir_refs = 0
    pilot invalid_found_flags = 0
    pilot ordering_errors = 0

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_definition_snapshot_line(payload, line_id)
        if line == "" {
            malformed += 1
        } else {
            pilot kind = v4_definition_snapshot_field_raw(line, 0)
            if v4_definition_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "definition-snapshot" {
                saw_header += 1
                if line_id != 0 { ordering_errors += 1 }
                format = v4_definition_snapshot_key_value(line, "format")
                declared_definitions = v4_definition_snapshot_key_value(line, "definitions")
                declared_semantic_facts = v4_definition_snapshot_key_value(line, "semantic-facts")
                semantic_fact_bound = v4_snapshot_canonical_nonnegative_int(declared_semantic_facts)
                if format != v4_definition_snapshot_format { malformed += 1 }
                if v4_snapshot_canonical_nonnegative_int(declared_definitions) < 0 { malformed += 1 }
                if semantic_fact_bound < 0 { malformed += 1 }
                if v4_definition_snapshot_field_raw(line, 1) != "format=" + v4_definition_snapshot_format { malformed += 1 }
                if v4_definition_snapshot_field_raw(line, 2) != "definitions=" + declared_definitions { malformed += 1 }
                if v4_definition_snapshot_field_raw(line, 3) != "semantic-facts=" + declared_semantic_facts { malformed += 1 }
            } else if kind == "definition" {
                if saw_header != 1 or saw_end > 0 { ordering_errors += 1 }
                pilot defn_id = v4_snapshot_canonical_nonnegative_int(v4_definition_snapshot_field_raw(line, 1))
                pilot offset = v4_snapshot_canonical_nonnegative_int(v4_definition_snapshot_field_raw(line, 3))
                pilot semantic_id = v4_snapshot_canonical_nonnegative_int(v4_definition_snapshot_field_raw(line, 4))
                pilot hir_raw = v4_definition_snapshot_field_raw(line, 8)
                pilot found = v4_snapshot_canonical_nonnegative_int(v4_definition_snapshot_field_raw(line, 10))
                if defn_id < 0 or defn_id != definitions { invalid_ids += 1 }
                if offset < 0 { invalid_offsets += 1 }
                if semantic_id < 0 or semantic_id >= semantic_fact_bound { invalid_semantic_refs += 1 }
                if v4_snapshot_canonical_int_is_valid(hir_raw) == false or word_to_int(hir_raw) < 0 - 1 { invalid_hir_refs += 1 }
                if found < 0 or found > 1 { invalid_found_flags += 1 }
                definitions += 1
            } else if kind == "end" {
                saw_end += 1
                if line_id != lines - 1 { ordering_errors += 1 }
                if v4_definition_snapshot_field(line, 1) != v4_definition_snapshot_format { malformed += 1 }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }
    if declared_definitions != word_from_int(definitions) { import_ok = 0 }
    if invalid_ids > 0 { import_ok = 0 }
    if invalid_offsets > 0 { import_ok = 0 }
    if invalid_semantic_refs > 0 { import_ok = 0 }
    if invalid_hir_refs > 0 { import_ok = 0 }
    if invalid_found_flags > 0 { import_ok = 0 }
    if ordering_errors > 0 { import_ok = 0 }

    pilot out = "definition-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " definitions=" + word_from_int(definitions)
    out = out + " declared-definitions=" + declared_definitions
    out = out + " semantic-facts=" + declared_semantic_facts
    out = out + " invalid-ids=" + word_from_int(invalid_ids)
    out = out + " invalid-offsets=" + word_from_int(invalid_offsets)
    out = out + " invalid-semantic-refs=" + word_from_int(invalid_semantic_refs)
    out = out + " invalid-hir-refs=" + word_from_int(invalid_hir_refs)
    out = out + " invalid-found-flags=" + word_from_int(invalid_found_flags)
    out = out + " ordering-errors=" + word_from_int(ordering_errors)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}


task v4_definition_snapshot_restore_definition_line(line: word) -> int {
    if v4_definition_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_definition_snapshot_field_raw(line, 0) != "definition" { give back 0 }
    pilot defn_id = word_to_int(v4_definition_snapshot_field_raw(line, 1))
    pilot path = v4_definition_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_definition_snapshot_field_raw(line, 3))
    pilot semantic_id = word_to_int(v4_definition_snapshot_field_raw(line, 4))
    pilot name = v4_definition_snapshot_field(line, 5)
    pilot kind = v4_definition_snapshot_field(line, 6)
    pilot def_id = v4_definition_snapshot_field(line, 7)
    pilot hir_item = word_to_int(v4_definition_snapshot_field_raw(line, 8))
    pilot span = v4_definition_snapshot_field(line, 9)
    pilot found = word_to_int(v4_definition_snapshot_field_raw(line, 10))
    give back v4_definition_restore_slot(defn_id, path, offset, semantic_id, name, kind, def_id, hir_item, span, found)
}

task v4_definition_snapshot_restore(payload: word) -> word {
    pilot validation = v4_definition_snapshot_validate(payload)
    if validation.starts_with("definition-snapshot-import ok=1") == false {
        give back "definition-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot header = v4_definition_snapshot_line(payload, 0)
    pilot declared_definitions = word_to_int(v4_definition_snapshot_key_value(header, "definitions"))
    v4_editor_begin_definition_snapshot_restore()
    pilot restored_definitions = 0
    pilot insertion_failures = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_definition_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_definition_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_definition_snapshot_field_raw(line, 0)
            if kind == "definition" {
                pilot inserted = v4_definition_snapshot_restore_definition_line(line)
                if inserted == 1 { restored_definitions += 1 } else { insertion_failures += 1 }
            } else if kind != "definition-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    if insertion_failures > 0 or restored_definitions != declared_definitions {
        pilot out = "definition-snapshot-restore ok=0 reason=insertion-failed"
        out = out + " definitions=" + word_from_int(restored_definitions)
        out = out + " declared-definitions=" + word_from_int(declared_definitions)
        out = out + " insertion-failures=" + word_from_int(insertion_failures)
        give back out
    }

    pilot out = "definition-snapshot-restore ok=1"
    out = out + " definitions=" + word_from_int(restored_definitions)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-definitions=" + word_from_int(v4_definition_at_count())
    give back out
}


