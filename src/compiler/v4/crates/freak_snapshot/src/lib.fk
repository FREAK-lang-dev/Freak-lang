    pilot out = "hover-snapshot"
    out = out + "|format=" + v4_hover_snapshot_format
    out = out + "|hovers=" + word_from_int(v4_hover_count())
    out = out + "|semantic-facts=" + word_from_int(v4_semantic_fact_count())
    give back out
}

task v4_hover_snapshot_hover_line(hover_id: int) -> word {
    pilot out = "hover"
    out = out + "|" + word_from_int(hover_id)
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_path(hover_id))
    out = out + "|" + word_from_int(v4_hover_offset(hover_id))
    out = out + "|" + word_from_int(v4_hover_semantic_id(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_name(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_kind(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_type(hover_id))
    out = out + "|" + v4_hover_snapshot_escape(v4_hover_markdown(hover_id))
    give back out
}

task v4_hover_snapshot() -> word {
    v4_driver_init()
    pilot parts = array_new()
    array_push(parts, v4_hover_snapshot_header())
    pilot hover_id = 0
    pilot hover_count = v4_hover_count()
    repeat until hover_id >= hover_count {
        array_push(parts, "\n")
        array_push(parts, v4_hover_snapshot_hover_line(hover_id))
        hover_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_hover_snapshot_format)
    give back word_join(parts)
}

task v4_hover_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "hover-snapshot" { give back 4 }
    if kind == "hover" { give back 9 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_hover_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_hover_snapshot_field_raw(line, 0)
    pilot expected = v4_hover_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_hover_snapshot_field_count(line) != expected {
        give back false
    }
    give back true
}

task v4_hover_snapshot_validate(payload: word) -> word {
    pilot lines = v4_hover_snapshot_line_count(payload)
    pilot hovers = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_hovers = ""
    pilot declared_semantic_facts = ""
    pilot semantic_fact_bound = 0 - 1
    pilot invalid_ids = 0
    pilot invalid_offsets = 0
    pilot invalid_semantic_refs = 0
    pilot ordering_errors = 0

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_hover_snapshot_line(payload, line_id)
        if line == "" {
            malformed += 1
        } else {
            pilot kind = v4_hover_snapshot_field_raw(line, 0)
            if v4_hover_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "hover-snapshot" {
                saw_header += 1
                if line_id != 0 { ordering_errors += 1 }
                format = v4_hover_snapshot_key_value(line, "format")
                declared_hovers = v4_hover_snapshot_key_value(line, "hovers")
                declared_semantic_facts = v4_hover_snapshot_key_value(line, "semantic-facts")
                semantic_fact_bound = v4_snapshot_canonical_nonnegative_int(declared_semantic_facts)
                if format != v4_hover_snapshot_format { malformed += 1 }
                if v4_snapshot_canonical_nonnegative_int(declared_hovers) < 0 { malformed += 1 }
                if semantic_fact_bound < 0 { malformed += 1 }
                if v4_hover_snapshot_field_raw(line, 1) != "format=" + v4_hover_snapshot_format { malformed += 1 }
                if v4_hover_snapshot_field_raw(line, 2) != "hovers=" + declared_hovers { malformed += 1 }
                if v4_hover_snapshot_field_raw(line, 3) != "semantic-facts=" + declared_semantic_facts { malformed += 1 }
            } else if kind == "hover" {
                if saw_header != 1 or saw_end > 0 { ordering_errors += 1 }
                pilot hover_id = v4_snapshot_canonical_nonnegative_int(v4_hover_snapshot_field_raw(line, 1))
                pilot offset = v4_snapshot_canonical_nonnegative_int(v4_hover_snapshot_field_raw(line, 3))
                pilot semantic_id = v4_snapshot_canonical_nonnegative_int(v4_hover_snapshot_field_raw(line, 4))
                if hover_id < 0 or hover_id != hovers { invalid_ids += 1 }
                if offset < 0 { invalid_offsets += 1 }
                if semantic_id < 0 or semantic_id >= semantic_fact_bound { invalid_semantic_refs += 1 }
                hovers += 1
            } else if kind == "end" {
                saw_end += 1
                if line_id != lines - 1 { ordering_errors += 1 }
                if v4_hover_snapshot_field(line, 1) != v4_hover_snapshot_format { malformed += 1 }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }
    if declared_hovers != word_from_int(hovers) { import_ok = 0 }
    if invalid_ids > 0 { import_ok = 0 }
    if invalid_offsets > 0 { import_ok = 0 }
    if invalid_semantic_refs > 0 { import_ok = 0 }
    if ordering_errors > 0 { import_ok = 0 }

    pilot out = "hover-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " hovers=" + word_from_int(hovers)
    out = out + " declared-hovers=" + declared_hovers
    out = out + " semantic-facts=" + declared_semantic_facts
    out = out + " invalid-ids=" + word_from_int(invalid_ids)
    out = out + " invalid-offsets=" + word_from_int(invalid_offsets)
    out = out + " invalid-semantic-refs=" + word_from_int(invalid_semantic_refs)
    out = out + " ordering-errors=" + word_from_int(ordering_errors)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}


task v4_hover_snapshot_restore_hover_line(line: word) -> int {
    if v4_hover_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_hover_snapshot_field_raw(line, 0) != "hover" { give back 0 }
    pilot hover_id = word_to_int(v4_hover_snapshot_field_raw(line, 1))
    pilot path = v4_hover_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_hover_snapshot_field_raw(line, 3))
    pilot semantic_id = word_to_int(v4_hover_snapshot_field_raw(line, 4))
    pilot name = v4_hover_snapshot_field(line, 5)
    pilot kind = v4_hover_snapshot_field(line, 6)
    pilot type_display = v4_hover_snapshot_field(line, 7)
    pilot markdown = v4_hover_snapshot_field(line, 8)
    give back v4_hover_restore_slot(hover_id, path, offset, semantic_id, name, kind, type_display, markdown)
}

task v4_hover_snapshot_restore(payload: word) -> word {
    pilot validation = v4_hover_snapshot_validate(payload)
    if validation.starts_with("hover-snapshot-import ok=1") == false {
        give back "hover-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot header = v4_hover_snapshot_line(payload, 0)
    pilot declared_hovers = word_to_int(v4_hover_snapshot_key_value(header, "hovers"))
    v4_editor_begin_hover_snapshot_restore()
    pilot restored_hovers = 0
    pilot insertion_failures = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_hover_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_hover_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_hover_snapshot_field_raw(line, 0)
            if kind == "hover" {
                pilot inserted = v4_hover_snapshot_restore_hover_line(line)
                if inserted == 1 { restored_hovers += 1 } else { insertion_failures += 1 }
            } else if kind != "hover-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    if insertion_failures > 0 or restored_hovers != declared_hovers {
        pilot out = "hover-snapshot-restore ok=0 reason=insertion-failed"
        out = out + " hovers=" + word_from_int(restored_hovers)
        out = out + " declared-hovers=" + word_from_int(declared_hovers)
        out = out + " insertion-failures=" + word_from_int(insertion_failures)
        give back out
    }

    pilot out = "hover-snapshot-restore ok=1"
    out = out + " hovers=" + word_from_int(restored_hovers)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-hovers=" + word_from_int(v4_hover_count())
    give back out
}


