    repeat until doc_id >= doc_count {
        array_push(parts, "\n")
        array_push(parts, v4_document_symbols_snapshot_document_line(doc_id))
        pilot symbol_id = 0
        pilot symbol_count = v4_document_symbol_count(doc_id)
        repeat until symbol_id >= symbol_count {
            array_push(parts, "\n")
            array_push(parts, v4_document_symbols_snapshot_symbol_line(doc_id, symbol_id))
            symbol_id += 1
        }
        doc_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_document_symbols_snapshot_format)
    give back word_join(parts)
}

task v4_document_symbols_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "document-symbols-snapshot" { give back 4 }
    if kind == "document-symbols" { give back 4 }
    if kind == "document-symbol" { give back 9 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_document_symbols_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_document_symbols_snapshot_field_raw(line, 0)
    pilot expected = v4_document_symbols_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_document_symbols_snapshot_field_count(line) != expected {
        give back false
    }
    give back true
}

task v4_document_symbols_snapshot_validate(payload: word) -> word {
    pilot lines = v4_document_symbols_snapshot_line_count(payload)
    pilot documents = 0
    pilot symbols = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_documents = ""
    pilot declared_symbols = ""
    pilot declared_document_bound = 0 - 1
    pilot declared_symbol_bound = 0 - 1
    pilot invalid_ids = 0
    pilot invalid_references = 0
    pilot ordering_errors = 0
    pilot child_count_mismatches = 0
    pilot declared_child_total = 0
    pilot active_doc_id = 0 - 1
    pilot active_declared_symbols = 0
    pilot active_seen_symbols = 0

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_document_symbols_snapshot_line(payload, line_id)
        if line == "" {
            malformed += 1
        } else {
            pilot kind = v4_document_symbols_snapshot_field_raw(line, 0)
            if v4_document_symbols_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "document-symbols-snapshot" {
                saw_header += 1
                if line_id != 0 { ordering_errors += 1 }
                format = v4_document_symbols_snapshot_key_value(line, "format")
                declared_documents = v4_document_symbols_snapshot_key_value(line, "documents")
                declared_symbols = v4_document_symbols_snapshot_key_value(line, "symbols")
                declared_document_bound = v4_snapshot_canonical_nonnegative_int(declared_documents)
                declared_symbol_bound = v4_snapshot_canonical_nonnegative_int(declared_symbols)
                if format != v4_document_symbols_snapshot_format { malformed += 1 }
                if declared_document_bound < 0 { malformed += 1 }
                if declared_symbol_bound < 0 { malformed += 1 }
                if v4_document_symbols_snapshot_field_raw(line, 1) != "format=" + v4_document_symbols_snapshot_format { malformed += 1 }
                if v4_document_symbols_snapshot_field_raw(line, 2) != "documents=" + declared_documents { malformed += 1 }
                if v4_document_symbols_snapshot_field_raw(line, 3) != "symbols=" + declared_symbols { malformed += 1 }
            } else if kind == "document-symbols" {
                if saw_header != 1 or saw_end > 0 { ordering_errors += 1 }
                if active_doc_id >= 0 and active_seen_symbols != active_declared_symbols { child_count_mismatches += 1 }
                pilot doc_id = v4_snapshot_canonical_nonnegative_int(v4_document_symbols_snapshot_field_raw(line, 1))
                pilot child_count = v4_snapshot_canonical_nonnegative_int(v4_document_symbols_snapshot_field_raw(line, 3))
                if doc_id < 0 or doc_id != documents or doc_id >= declared_document_bound { invalid_ids += 1 }
                if child_count < 0 {
                    child_count_mismatches += 1
                    child_count = 0
                }
                active_doc_id = doc_id
                active_declared_symbols = child_count
                active_seen_symbols = 0
                declared_child_total += child_count
                documents += 1
            } else if kind == "document-symbol" {
                if saw_header != 1 or saw_end > 0 or active_doc_id < 0 { ordering_errors += 1 }
                pilot parent_id = v4_snapshot_canonical_nonnegative_int(v4_document_symbols_snapshot_field_raw(line, 1))
                pilot symbol_id = v4_snapshot_canonical_nonnegative_int(v4_document_symbols_snapshot_field_raw(line, 2))
                pilot hir_raw = v4_document_symbols_snapshot_field_raw(line, 6)
                if parent_id < 0 or parent_id != active_doc_id or parent_id >= declared_document_bound { invalid_ids += 1 }
                if symbol_id < 0 or symbol_id != active_seen_symbols or symbol_id >= active_declared_symbols or symbol_id >= declared_symbol_bound { invalid_ids += 1 }
                if v4_snapshot_canonical_int_is_valid(hir_raw) == false or word_to_int(hir_raw) < 0 - 1 { invalid_references += 1 }
                if active_seen_symbols >= active_declared_symbols { child_count_mismatches += 1 }
                active_seen_symbols += 1
                symbols += 1
            } else if kind == "end" {
                if active_doc_id >= 0 and active_seen_symbols != active_declared_symbols { child_count_mismatches += 1 }
                active_doc_id = 0 - 1
                saw_end += 1
                if line_id != lines - 1 { ordering_errors += 1 }
                if v4_document_symbols_snapshot_field(line, 1) != v4_document_symbols_snapshot_format { malformed += 1 }
            }
        }
        line_id += 1
    }

    if active_doc_id >= 0 and active_seen_symbols != active_declared_symbols { child_count_mismatches += 1 }
    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }
    if declared_documents != word_from_int(documents) { import_ok = 0 }
    if declared_symbols != word_from_int(symbols) { import_ok = 0 }
    if declared_child_total != symbols { import_ok = 0 }
    if invalid_ids > 0 { import_ok = 0 }
    if invalid_references > 0 { import_ok = 0 }
    if ordering_errors > 0 { import_ok = 0 }
    if child_count_mismatches > 0 { import_ok = 0 }

    pilot out = "document-symbols-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " documents=" + word_from_int(documents)
    out = out + " declared-documents=" + declared_documents
    out = out + " symbols=" + word_from_int(symbols)
    out = out + " declared-symbols=" + declared_symbols
    out = out + " invalid-ids=" + word_from_int(invalid_ids)
    out = out + " invalid-references=" + word_from_int(invalid_references)
    out = out + " ordering-errors=" + word_from_int(ordering_errors)
    out = out + " child-count-mismatches=" + word_from_int(child_count_mismatches)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}


task v4_document_symbols_snapshot_restore_document_line(line: word) -> int {
    if v4_document_symbols_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_document_symbols_snapshot_field_raw(line, 0) != "document-symbols" { give back 0 }
    pilot doc_id = word_to_int(v4_document_symbols_snapshot_field_raw(line, 1))
    pilot path = v4_document_symbols_snapshot_field(line, 2)
    give back v4_document_symbols_restore_document_slot(doc_id, path)
}

task v4_document_symbols_snapshot_restore_symbol_line(line: word) -> int {
    if v4_document_symbols_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_document_symbols_snapshot_field_raw(line, 0) != "document-symbol" { give back 0 }
    pilot doc_id = word_to_int(v4_document_symbols_snapshot_field_raw(line, 1))
    pilot symbol_id = word_to_int(v4_document_symbols_snapshot_field_raw(line, 2))
    pilot name = v4_document_symbols_snapshot_field(line, 3)
    pilot kind = v4_document_symbols_snapshot_field(line, 4)
    pilot def_id = v4_document_symbols_snapshot_field(line, 5)
    pilot hir_item = word_to_int(v4_document_symbols_snapshot_field_raw(line, 6))
    pilot span = v4_document_symbols_snapshot_field(line, 7)
    pilot type_display = v4_document_symbols_snapshot_field(line, 8)
    give back v4_document_symbols_restore_symbol_slot(doc_id, symbol_id, name, kind, def_id, hir_item, span, type_display)
}

task v4_document_symbols_snapshot_restore(payload: word) -> word {
    pilot validation = v4_document_symbols_snapshot_validate(payload)
    if validation.starts_with("document-symbols-snapshot-import ok=1") == false {
        give back "document-symbols-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot header = v4_document_symbols_snapshot_line(payload, 0)
    pilot declared_documents = word_to_int(v4_document_symbols_snapshot_key_value(header, "documents"))
    pilot declared_symbols = word_to_int(v4_document_symbols_snapshot_key_value(header, "symbols"))
    v4_editor_begin_document_symbols_snapshot_restore()
    pilot restored_documents = 0
    pilot restored_symbols = 0
    pilot insertion_failures = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_document_symbols_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_document_symbols_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_document_symbols_snapshot_field_raw(line, 0)
            if kind == "document-symbols" {
                pilot inserted = v4_document_symbols_snapshot_restore_document_line(line)
                if inserted == 1 { restored_documents += 1 } else { insertion_failures += 1 }
            } else if kind == "document-symbol" {
                pilot inserted = v4_document_symbols_snapshot_restore_symbol_line(line)
                if inserted == 1 { restored_symbols += 1 } else { insertion_failures += 1 }
            } else if kind != "document-symbols-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    if insertion_failures > 0 or restored_documents != declared_documents or restored_symbols != declared_symbols {
        pilot out = "document-symbols-snapshot-restore ok=0 reason=insertion-failed"
        out = out + " documents=" + word_from_int(restored_documents)
        out = out + " declared-documents=" + word_from_int(declared_documents)
        out = out + " symbols=" + word_from_int(restored_symbols)
        out = out + " declared-symbols=" + word_from_int(declared_symbols)
        out = out + " insertion-failures=" + word_from_int(insertion_failures)
        give back out
    }

    pilot out = "document-symbols-snapshot-restore ok=1"
    out = out + " documents=" + word_from_int(restored_documents)
    out = out + " symbols=" + word_from_int(restored_symbols)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-documents=" + word_from_int(v4_document_symbols_count())
    give back out
}


task v4_completion_snapshot_escape(value: word) -> word {
    give back v4_document_symbols_snapshot_escape(value)
}

task v4_completion_snapshot_unescape(value: word) -> word {
    give back v4_document_symbols_snapshot_unescape(value)
}

task v4_completion_snapshot_line_count(payload: word) -> int {
    give back v4_document_symbols_snapshot_line_count(payload)
}

task v4_completion_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_document_symbols_snapshot_line(payload, wanted)
}

task v4_completion_snapshot_field_count(line: word) -> int {
    give back v4_document_symbols_snapshot_field_count(line)
}

task v4_completion_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_document_symbols_snapshot_field_raw(line, wanted)
}

task v4_completion_snapshot_field(line: word, wanted: int) -> word {
    give back v4_document_symbols_snapshot_field(line, wanted)
}

task v4_completion_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_document_symbols_snapshot_key_value(line, wanted_key)
}

task v4_completion_snapshot_item_total() -> int {
    v4_driver_init()
    pilot total = 0
    pilot completion_id = 0
    repeat until completion_id >= v4_completion_set_count() {
        total += v4_completion_count(completion_id)
        completion_id += 1
    }
    give back total
}

task v4_completion_snapshot_summary() -> word {
    pilot summary = "completion-snapshot"
    summary = summary + " format=" + v4_completion_snapshot_format
    summary = summary + " completions=" + word_from_int(v4_completion_set_count())
    summary = summary + " items=" + word_from_int(v4_completion_snapshot_item_total())
    give back summary
}

task v4_completion_snapshot_header() -> word {
    pilot out = "completion-snapshot"
    out = out + "|format=" + v4_completion_snapshot_format
    out = out + "|completions=" + word_from_int(v4_completion_set_count())
    out = out + "|items=" + word_from_int(v4_completion_snapshot_item_total())
    give back out
}

task v4_completion_snapshot_completion_line(completion_id: int) -> word {
    pilot out = "completion"
    out = out + "|" + word_from_int(completion_id)
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_path(completion_id))
    out = out + "|" + word_from_int(v4_completion_offset(completion_id))
    out = out + "|" + word_from_int(v4_completion_count(completion_id))
    give back out
}

task v4_completion_snapshot_item_line(completion_id: int, item_id: int) -> word {
    pilot out = "completion-item"
    out = out + "|" + word_from_int(completion_id)
    out = out + "|" + word_from_int(item_id)
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_label(completion_id, item_id))
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_kind(completion_id, item_id))
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_detail(completion_id, item_id))
    out = out + "|" + v4_completion_snapshot_escape(v4_completion_insert_text(completion_id, item_id))
    give back out
}

task v4_completion_snapshot() -> word {
    v4_driver_init()
    pilot parts = array_new()
    array_push(parts, v4_completion_snapshot_header())
    pilot completion_id = 0
    pilot completion_count = v4_completion_set_count()
    repeat until completion_id >= completion_count {
        array_push(parts, "\n")
        array_push(parts, v4_completion_snapshot_completion_line(completion_id))
        pilot item_id = 0
        pilot item_count = v4_completion_count(completion_id)
        repeat until item_id >= item_count {
            array_push(parts, "\n")
            array_push(parts, v4_completion_snapshot_item_line(completion_id, item_id))
            item_id += 1
        }
        completion_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_completion_snapshot_format)
    give back word_join(parts)
}

task v4_completion_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "completion-snapshot" { give back 4 }
    if kind == "completion" { give back 5 }
    if kind == "completion-item" { give back 7 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_completion_snapshot_record_is_valid(line: word) -> bool {
    pilot kind = v4_completion_snapshot_field_raw(line, 0)
    pilot expected = v4_completion_snapshot_record_expected_fields(kind)
    if expected == 0 {
        give back false
    }
    if v4_completion_snapshot_field_count(line) != expected {
        give back false
    }
    give back true
}

task v4_completion_snapshot_validate(payload: word) -> word {
    pilot lines = v4_completion_snapshot_line_count(payload)
    pilot completions = 0
    pilot items = 0
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot declared_completions = ""
    pilot declared_items = ""
    pilot declared_completion_bound = 0 - 1
    pilot declared_item_bound = 0 - 1
    pilot invalid_ids = 0
    pilot invalid_offsets = 0
    pilot ordering_errors = 0
    pilot child_count_mismatches = 0
    pilot declared_child_total = 0
    pilot active_completion_id = 0 - 1
    pilot active_declared_items = 0
    pilot active_seen_items = 0

    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_completion_snapshot_line(payload, line_id)
        if line == "" {
            malformed += 1
        } else {
            pilot kind = v4_completion_snapshot_field_raw(line, 0)
            if v4_completion_snapshot_record_is_valid(line) == false {
                malformed += 1
            } else if kind == "completion-snapshot" {
                saw_header += 1
                if line_id != 0 { ordering_errors += 1 }
                format = v4_completion_snapshot_key_value(line, "format")
                declared_completions = v4_completion_snapshot_key_value(line, "completions")
                declared_items = v4_completion_snapshot_key_value(line, "items")
                declared_completion_bound = v4_snapshot_canonical_nonnegative_int(declared_completions)
                declared_item_bound = v4_snapshot_canonical_nonnegative_int(declared_items)
                if format != v4_completion_snapshot_format { malformed += 1 }
                if declared_completion_bound < 0 { malformed += 1 }
                if declared_item_bound < 0 { malformed += 1 }
                if v4_completion_snapshot_field_raw(line, 1) != "format=" + v4_completion_snapshot_format { malformed += 1 }
                if v4_completion_snapshot_field_raw(line, 2) != "completions=" + declared_completions { malformed += 1 }
                if v4_completion_snapshot_field_raw(line, 3) != "items=" + declared_items { malformed += 1 }
            } else if kind == "completion" {
                if saw_header != 1 or saw_end > 0 { ordering_errors += 1 }
                if active_completion_id >= 0 and active_seen_items != active_declared_items { child_count_mismatches += 1 }
                pilot completion_id = v4_snapshot_canonical_nonnegative_int(v4_completion_snapshot_field_raw(line, 1))
                pilot offset = v4_snapshot_canonical_nonnegative_int(v4_completion_snapshot_field_raw(line, 3))
                pilot child_count = v4_snapshot_canonical_nonnegative_int(v4_completion_snapshot_field_raw(line, 4))
                if completion_id < 0 or completion_id != completions or completion_id >= declared_completion_bound { invalid_ids += 1 }
                if offset < 0 { invalid_offsets += 1 }
                if child_count < 0 {
                    child_count_mismatches += 1
                    child_count = 0
                }
                active_completion_id = completion_id
                active_declared_items = child_count
                active_seen_items = 0
                declared_child_total += child_count
                completions += 1
            } else if kind == "completion-item" {
                if saw_header != 1 or saw_end > 0 or active_completion_id < 0 { ordering_errors += 1 }
                pilot parent_id = v4_snapshot_canonical_nonnegative_int(v4_completion_snapshot_field_raw(line, 1))
                pilot item_id = v4_snapshot_canonical_nonnegative_int(v4_completion_snapshot_field_raw(line, 2))
                if parent_id < 0 or parent_id != active_completion_id or parent_id >= declared_completion_bound { invalid_ids += 1 }
                if item_id < 0 or item_id != active_seen_items or item_id >= active_declared_items or item_id >= declared_item_bound { invalid_ids += 1 }
                if active_seen_items >= active_declared_items { child_count_mismatches += 1 }
                active_seen_items += 1
                items += 1
            } else if kind == "end" {
                if active_completion_id >= 0 and active_seen_items != active_declared_items { child_count_mismatches += 1 }
                active_completion_id = 0 - 1
                saw_end += 1
                if line_id != lines - 1 { ordering_errors += 1 }
                if v4_completion_snapshot_field(line, 1) != v4_completion_snapshot_format { malformed += 1 }
            }
        }
        line_id += 1
    }

    if active_completion_id >= 0 and active_seen_items != active_declared_items { child_count_mismatches += 1 }
    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }
    if declared_completions != word_from_int(completions) { import_ok = 0 }
    if declared_items != word_from_int(items) { import_ok = 0 }
    if declared_child_total != items { import_ok = 0 }
    if invalid_ids > 0 { import_ok = 0 }
    if invalid_offsets > 0 { import_ok = 0 }
    if ordering_errors > 0 { import_ok = 0 }
    if child_count_mismatches > 0 { import_ok = 0 }

    pilot out = "completion-snapshot-import"
    out = out + " ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " completions=" + word_from_int(completions)
    out = out + " declared-completions=" + declared_completions
    out = out + " items=" + word_from_int(items)
    out = out + " declared-items=" + declared_items
    out = out + " invalid-ids=" + word_from_int(invalid_ids)
    out = out + " invalid-offsets=" + word_from_int(invalid_offsets)
    out = out + " ordering-errors=" + word_from_int(ordering_errors)
    out = out + " child-count-mismatches=" + word_from_int(child_count_mismatches)
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}


task v4_completion_snapshot_restore_completion_line(line: word) -> int {
    if v4_completion_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_completion_snapshot_field_raw(line, 0) != "completion" { give back 0 }
    pilot completion_id = word_to_int(v4_completion_snapshot_field_raw(line, 1))
    pilot path = v4_completion_snapshot_field(line, 2)
    pilot offset = word_to_int(v4_completion_snapshot_field_raw(line, 3))
    give back v4_completion_restore_completion_slot(completion_id, path, offset)
}

task v4_completion_snapshot_restore_item_line(line: word) -> int {
    if v4_completion_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_completion_snapshot_field_raw(line, 0) != "completion-item" { give back 0 }
    pilot completion_id = word_to_int(v4_completion_snapshot_field_raw(line, 1))
    pilot item_id = word_to_int(v4_completion_snapshot_field_raw(line, 2))
    pilot label = v4_completion_snapshot_field(line, 3)
    pilot kind = v4_completion_snapshot_field(line, 4)
    pilot detail = v4_completion_snapshot_field(line, 5)
    pilot insert_text = v4_completion_snapshot_field(line, 6)
    give back v4_completion_restore_item_slot(completion_id, item_id, label, kind, detail, insert_text)
}

task v4_completion_snapshot_restore(payload: word) -> word {
    pilot validation = v4_completion_snapshot_validate(payload)
    if validation.starts_with("completion-snapshot-import ok=1") == false {
        give back "completion-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    pilot header = v4_completion_snapshot_line(payload, 0)
    pilot declared_completions = word_to_int(v4_completion_snapshot_key_value(header, "completions"))
    pilot declared_items = word_to_int(v4_completion_snapshot_key_value(header, "items"))
    v4_editor_begin_completion_snapshot_restore()
    pilot restored_completions = 0
    pilot restored_items = 0
    pilot insertion_failures = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_completion_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_completion_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_completion_snapshot_field_raw(line, 0)
            if kind == "completion" {
                pilot inserted = v4_completion_snapshot_restore_completion_line(line)
                if inserted == 1 { restored_completions += 1 } else { insertion_failures += 1 }
            } else if kind == "completion-item" {
                pilot inserted = v4_completion_snapshot_restore_item_line(line)
                if inserted == 1 { restored_items += 1 } else { insertion_failures += 1 }
            } else if kind != "completion-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    if insertion_failures > 0 or restored_completions != declared_completions or restored_items != declared_items {
        pilot out = "completion-snapshot-restore ok=0 reason=insertion-failed"
        out = out + " completions=" + word_from_int(restored_completions)
        out = out + " declared-completions=" + word_from_int(declared_completions)
        out = out + " items=" + word_from_int(restored_items)
        out = out + " declared-items=" + word_from_int(declared_items)
        out = out + " insertion-failures=" + word_from_int(insertion_failures)
        give back out
    }

    pilot out = "completion-snapshot-restore ok=1"
    out = out + " completions=" + word_from_int(restored_completions)
    out = out + " items=" + word_from_int(restored_items)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " arena-completions=" + word_from_int(v4_completion_set_count())
    give back out
}


task v4_driver_query_key_matches_path(path: word, key: word) -> bool {
    if key == v4_check_syntax_query_key(path) { give back true }
    if key == v4_lex_query_key(path) { give back true }
    if key == v4_parse_query_key(path) { give back true }
    if key == v4_expand_query_key(path) { give back true }
    if key == v4_hir_query_key(path) { give back true }
    if key == v4_resolve_query_key(path) { give back true }
    if key == v4_ty_query_key(path) { give back true }
    if key == v4_mir_query_key(path) { give back true }
    if key == v4_borrowck_query_key(path) { give back true }
    if key == v4_diagnostics_query_key(path) { give back true }
    if key.starts_with("semantic-at:" + path + ":") { give back true }
    if key.starts_with("hover:" + path + ":") { give back true }
    if key.starts_with("definition-at:" + path + ":") { give back true }
    if key == v4_document_symbols_query_key(path) { give back true }
    if key.starts_with("completion:" + path + ":") { give back true }
    give back false
}

task v4_unit_invalidation_family_matches_path_key(path: word, family: word, key: word) -> bool {
    if family == "syntax" { give back key == v4_check_syntax_query_key(path) }
    if family == "lex" { give back key == v4_lex_query_key(path) }
    if family == "parse" { give back key == v4_parse_query_key(path) }
    if family == "expand" { give back key == v4_expand_query_key(path) }
    if family == "hir" { give back key == v4_hir_query_key(path) }
    if family == "resolve" { give back key == v4_resolve_query_key(path) }
    if family == "ty" { give back key == v4_ty_query_key(path) }
    if family == "mir" { give back key == v4_mir_query_key(path) }
    if family == "borrowck" { give back key == v4_borrowck_query_key(path) }
    if family == "diagnostics" { give back key == v4_diagnostics_query_key(path) }
    if family == "semantic-at" { give back key.starts_with("semantic-at:" + path + ":") }
    if family == "hover" { give back key.starts_with("hover:" + path + ":") }
    if family == "definition-at" { give back key.starts_with("definition-at:" + path + ":") }
    if family == "document-symbols" { give back key == v4_document_symbols_query_key(path) }
    if family == "completion" { give back key.starts_with("completion:" + path + ":") }
    if family == "core" {
        if v4_unit_invalidation_family_matches_path_key(path, "syntax", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "lex", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "parse", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "expand", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "hir", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "resolve", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "ty", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "mir", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "borrowck", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "diagnostics", key) { give back true }
    }
    if family == "editor" {
        if v4_unit_invalidation_family_matches_path_key(path, "semantic-at", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "hover", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "definition-at", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "document-symbols", key) { give back true }
        if v4_unit_invalidation_family_matches_path_key(path, "completion", key) { give back true }
    }
    if family == "all" { give back v4_driver_query_key_matches_path(path, key) }
    give back false
}

task v4_unit_invalidation_family_matches_any_key(family: word, key: word) -> bool {
    if family == "syntax" { give back key.starts_with("syntax:") }
    if family == "lex" { give back key.starts_with("lex:") }
    if family == "parse" { give back key.starts_with("parse:") }
    if family == "expand" { give back key.starts_with("expand:") }
    if family == "hir" { give back key.starts_with("hir:") }
    if family == "resolve" { give back key.starts_with("resolve:") }
    if family == "ty" { give back key.starts_with("ty:") }
    if family == "mir" { give back key.starts_with("mir:") }
    if family == "borrowck" { give back key.starts_with("borrowck:") }
    if family == "diagnostics" { give back key.starts_with("diagnostics:") }
    if family == "semantic-at" { give back key.starts_with("semantic-at:") }
    if family == "hover" { give back key.starts_with("hover:") }
    if family == "definition-at" { give back key.starts_with("definition-at:") }
    if family == "document-symbols" { give back key.starts_with("document-symbols:") }
    if family == "completion" { give back key.starts_with("completion:") }
    if family == "core" {
        if v4_unit_invalidation_family_matches_any_key("syntax", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("lex", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("parse", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("expand", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("hir", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("resolve", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("ty", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("mir", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("borrowck", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("diagnostics", key) { give back true }
    }
    if family == "editor" {
        if v4_unit_invalidation_family_matches_any_key("semantic-at", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("hover", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("definition-at", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("document-symbols", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("completion", key) { give back true }
    }
    if family == "all" {
        if v4_unit_invalidation_family_matches_any_key("core", key) { give back true }
        if v4_unit_invalidation_family_matches_any_key("editor", key) { give back true }
    }
    give back false
}

task v4_unit_invalidation_family_count(path: word, family: word) -> int {
    pilot total = 0
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        if v4_unit_invalidation_family_matches_path_key(path, family, key) {
            total += 1
        }
        idx += 1
    }
    give back total
}

task v4_unit_invalidation_family_count_at_generation(path: word, family: word, generation: int) -> int {
    pilot total = 0
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        pilot invalidation_generation = v4_query_invalidated_generation(idx)
        if generation <= 0 or invalidation_generation == generation {
            if v4_unit_invalidation_family_matches_path_key(path, family, key) {
                total += 1
            }
        }
        idx += 1
    }
    give back total
}

task v4_unit_invalidation_latest_generation(path: word) -> int {
    pilot latest = 0
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        if v4_unit_invalidation_family_matches_path_key(path, "all", key) {
            latest = v4_query_invalidated_generation(idx)
        }
        idx += 1
    }
    give back latest
}

task v4_unit_invalidation_resolve_generation(path: word, generation: int) -> int {
    if generation > 0 {
        give back generation
    }
    give back v4_unit_invalidation_latest_generation(path)
}

task v4_unit_invalidation_latest_reason(path: word) -> word {
    pilot latest = ""
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        if v4_unit_invalidation_family_matches_path_key(path, "all", key) {
            latest = v4_query_invalidated_reason(idx)
        }
        idx += 1
    }
    give back latest
}

task v4_unit_invalidation_first_key(path: word) -> word {
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        if v4_unit_invalidation_family_matches_path_key(path, "all", key) {
            give back key
        }
        idx += 1
    }
    give back ""
}

task v4_unit_invalidation_first_key_at_generation(path: word, generation: int) -> word {
    pilot idx = 0
    pilot count = v4_query_invalidated_count()
    repeat until idx >= count {
        pilot key = v4_query_invalidated_key(idx)
        pilot invalidation_generation = v4_query_invalidated_generation(idx)
        if generation <= 0 or invalidation_generation == generation {
            if v4_unit_invalidation_family_matches_path_key(path, "all", key) {
                give back key
            }
        }
        idx += 1
    }
    give back ""
}

task v4_unit_invalidation_report_at_generation(path: word, generation: int) -> word {
    pilot resolved_generation = v4_unit_invalidation_resolve_generation(path, generation)
    pilot out = "invalidation-contract"
    out = out + "|path=" + v4_unit_snapshot_escape(path)
    out = out + "|generation=" + word_from_int(resolved_generation)
    out = out + "|reason=" + v4_unit_snapshot_escape(v4_query_generation_reason(resolved_generation))
    out = out + "|query-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "all", resolved_generation))
    out = out + "|core-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "core", resolved_generation))
    out = out + "|syntax-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "syntax", resolved_generation))
    out = out + "|lex-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "lex", resolved_generation))
    out = out + "|parse-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "parse", resolved_generation))
    out = out + "|expand-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "expand", resolved_generation))
    out = out + "|hir-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "hir", resolved_generation))
    out = out + "|resolve-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "resolve", resolved_generation))
    out = out + "|ty-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "ty", resolved_generation))
    out = out + "|mir-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "mir", resolved_generation))
    out = out + "|borrowck-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "borrowck", resolved_generation))
    out = out + "|diagnostics-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "diagnostics", resolved_generation))
    out = out + "|editor-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "editor", resolved_generation))
    out = out + "|semantic-at-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "semantic-at", resolved_generation))
    out = out + "|hover-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "hover", resolved_generation))
    out = out + "|definition-at-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "definition-at", resolved_generation))
    out = out + "|document-symbols-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "document-symbols", resolved_generation))
    out = out + "|completion-invalidations-added=" + word_from_int(v4_unit_invalidation_family_count_at_generation(path, "completion", resolved_generation))
    out = out + "|dirty=" + word_from_int(v4_query_dirty_count())
    pilot first_key = v4_unit_invalidation_first_key_at_generation(path, resolved_generation)
    if first_key != "" {
        out = out + "|first=" + v4_unit_snapshot_escape(first_key)
    }
    give back out
}

task v4_unit_invalidation_report(path: word) -> word {
    give back v4_unit_invalidation_report_at_generation(path, 0)
}

task v4_driver_restored_output_id(entry_id: int) -> int {
    if entry_id < 0 or entry_id >= v4_query_cache_size() { give back 0 - 1 }
    pilot raw = v4_query_entry_output(entry_id)
    pilot output_id = word_to_int(raw)
    if output_id < 0 or word_from_int(output_id) != raw { give back 0 - 1 }
    give back output_id
}

task v4_driver_restored_parent_id(key: word, fingerprint: word) -> int {
    give back v4_driver_restored_output_id(v4_query_find(key, fingerprint))
}

task v4_driver_restored_lex_matches(path: word, file_id: int, fingerprint: word, stream_id: int) -> bool {
    if v4_lex_stream_exists(stream_id) == false { give back false }
    if v4_lex_stream_file(stream_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_lex_query_key(path), fingerprint) != stream_id { give back false }
    give back true
}

task v4_driver_restored_parse_matches(path: word, file_id: int, fingerprint: word, tree_id: int) -> bool {
    if v4_parse_tree_exists(tree_id) == false { give back false }
    if v4_parse_file_id(tree_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_parse_query_key(path), fingerprint) != tree_id { give back false }
    pilot stream_id = v4_parse_stream_id(tree_id)
    give back v4_driver_restored_lex_matches(path, file_id, fingerprint, stream_id)
}

task v4_driver_restored_expand_matches(path: word, file_id: int, fingerprint: word, expansion_id: int) -> bool {
    if v4_expand_file_exists(expansion_id) == false { give back false }
    if v4_expand_file_id(expansion_id) != file_id { give back false }
    if v4_expand_provenance_kind(expansion_id) != v4_expand_provenance_identity { give back false }
    if v4_driver_restored_parent_id(v4_expand_query_key(path), fingerprint) != expansion_id { give back false }
    pilot tree_id = v4_expand_parse_tree_id(expansion_id)
    give back v4_driver_restored_parse_matches(path, file_id, fingerprint, tree_id)
}

task v4_driver_restored_hir_matches(path: word, file_id: int, fingerprint: word, hir_id: int) -> bool {
    if v4_hir_file_exists(hir_id) == false { give back false }
    if v4_hir_file_id(hir_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_hir_query_key(path), fingerprint) != hir_id { give back false }
    pilot expansion_id = v4_hir_expansion_id(hir_id)
    give back v4_driver_restored_expand_matches(path, file_id, fingerprint, expansion_id)
}

task v4_driver_restored_resolve_matches(path: word, file_id: int, fingerprint: word, resolve_id: int) -> bool {
    if v4_resolve_exists(resolve_id) == false { give back false }
    if v4_resolve_file_id(resolve_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_resolve_query_key(path), fingerprint) != resolve_id { give back false }
    pilot hir_id = v4_resolve_hir_id(resolve_id)
    give back v4_driver_restored_hir_matches(path, file_id, fingerprint, hir_id)
}

task v4_driver_restored_ty_matches(path: word, file_id: int, fingerprint: word, ty_id: int) -> bool {
    if v4_ty_file_exists(ty_id) == false { give back false }
    if v4_ty_file_id(ty_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_ty_query_key(path), fingerprint) != ty_id { give back false }
    pilot resolve_id = v4_ty_resolve_id(ty_id)
    give back v4_driver_restored_resolve_matches(path, file_id, fingerprint, resolve_id)
}

task v4_driver_restored_mir_matches(path: word, file_id: int, fingerprint: word, mir_id: int) -> bool {
    if v4_mir_file_exists(mir_id) == false { give back false }
    if v4_mir_file_id(mir_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_mir_query_key(path), fingerprint) != mir_id { give back false }
    pilot ty_id = v4_mir_ty_id(mir_id)
    give back v4_driver_restored_ty_matches(path, file_id, fingerprint, ty_id)
}

task v4_driver_restored_borrowck_matches(path: word, file_id: int, fingerprint: word, borrow_id: int) -> bool {
    if v4_borrowck_file_exists(borrow_id) == false { give back false }
    if v4_borrowck_file_id(borrow_id) != file_id { give back false }
    if v4_driver_restored_parent_id(v4_borrowck_query_key(path), fingerprint) != borrow_id { give back false }
    pilot mir_id = v4_borrowck_mir_id(borrow_id)
    give back v4_driver_restored_mir_matches(path, file_id, fingerprint, mir_id)
}

task v4_driver_query_output_can_promote(path: word, key: word) -> int {
    if key == v4_check_syntax_query_key(path) {
        give back 1
    }
    give back 0
}

task v4_driver_query_entry_can_promote(path: word, entry_id: int) -> int {
    pilot key = v4_query_entry_key(entry_id)
    pilot file_id = v4_source_find(path)
    if file_id < 0 { give back 0 }
    pilot fingerprint = v4_query_entry_input(entry_id)
    if v4_source_fingerprint(file_id) != fingerprint { give back 0 }
    if v4_driver_query_output_can_promote(path, key) == 1 { give back 1 }

    pilot output_id = v4_driver_restored_output_id(entry_id)
    if output_id < 0 { give back 0 }
    if key == v4_lex_query_key(path) {
        if v4_driver_restored_lex_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_parse_query_key(path) {
        if v4_driver_restored_parse_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_expand_query_key(path) {
        if v4_driver_restored_expand_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_hir_query_key(path) {
        if v4_driver_restored_hir_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_resolve_query_key(path) {
        if v4_driver_restored_resolve_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_ty_query_key(path) {
        if v4_driver_restored_ty_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_mir_query_key(path) {
        if v4_driver_restored_mir_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_borrowck_query_key(path) {
        if v4_driver_restored_borrowck_matches(path, file_id, fingerprint, output_id) { give back 1 }
    }
    if key == v4_diagnostics_query_key(path) {
        pilot diag_set_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_diagnostics_set_exists(diag_set_id) {
            if v4_diagnostics_path(diag_set_id) == path {
                pilot fingerprint = v4_query_entry_input(entry_id)
                pilot lex_entry = v4_query_find(v4_lex_query_key(path), fingerprint)
                pilot borrow_entry = v4_query_find(v4_borrowck_query_key(path), fingerprint)
                if lex_entry >= 0 and borrow_entry >= 0 {
                    pilot stream_id = word_to_int(v4_query_entry_output(lex_entry))
                    pilot borrow_id = word_to_int(v4_query_entry_output(borrow_entry))
                    if v4_lex_stream_exists(stream_id) and v4_borrowck_file_exists(borrow_id) {
                        pilot mir_id = v4_borrowck_mir_id(borrow_id)
                        if v4_mir_file_exists(mir_id) {
                            pilot ty_id = v4_mir_ty_id(mir_id)
                            if v4_ty_file_exists(ty_id) {
                                pilot resolve_id = v4_ty_resolve_id(ty_id)
                                if v4_resolve_exists(resolve_id) {
                                    pilot hir_id = v4_resolve_hir_id(resolve_id)
                                    if v4_hir_file_exists(hir_id) {
                                        pilot expansion_id = v4_hir_expansion_id(hir_id)
                                        if v4_expand_tree_exists(expansion_id) {
                                            give back 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if key.starts_with("semantic-at:" + path + ":") {
        pilot fact_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_semantic_fact_exists(fact_id) {
            if v4_semantic_at_path(fact_id) == path {
                if v4_semantic_at_query_key(path, v4_semantic_at_offset(fact_id)) == key {
                    pilot fingerprint = v4_query_entry_input(entry_id)
                    pilot lex_entry = v4_query_find(v4_lex_query_key(path), fingerprint)
                    pilot hir_entry = v4_query_find(v4_hir_query_key(path), fingerprint)
                    pilot resolve_entry = v4_query_find(v4_resolve_query_key(path), fingerprint)
                    pilot ty_entry = v4_query_find(v4_ty_query_key(path), fingerprint)
                    if lex_entry >= 0 and hir_entry >= 0 and resolve_entry >= 0 and ty_entry >= 0 {
                        pilot stream_id = word_to_int(v4_query_entry_output(lex_entry))
                        pilot hir_id = word_to_int(v4_query_entry_output(hir_entry))
                        pilot resolve_id = word_to_int(v4_query_entry_output(resolve_entry))
                        pilot ty_id = word_to_int(v4_query_entry_output(ty_entry))
                        if v4_lex_stream_exists(stream_id) and v4_hir_file_exists(hir_id) and v4_resolve_exists(resolve_id) and v4_ty_file_exists(ty_id) {
                            give back 1
                        }
                    }
                }
            }
        }
    }
    if key.starts_with("hover:" + path + ":") {
        pilot hover_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_hover_exists(hover_id) {
            if v4_hover_path(hover_id) == path {
                pilot offset = v4_hover_offset(hover_id)
                if v4_hover_query_key(path, offset) == key {
                    pilot semantic_id = v4_hover_semantic_id(hover_id)
                    if v4_semantic_fact_exists(semantic_id) {
                        pilot fingerprint = v4_query_entry_input(entry_id)
                        pilot semantic_entry = v4_query_find(v4_semantic_at_query_key(path, offset), fingerprint)
                        if semantic_entry >= 0 {
                            pilot restored_semantic = word_to_int(v4_query_entry_output(semantic_entry))
                            if restored_semantic == semantic_id {
                                give back 1
                            }
                        }
                    }
                }
            }
        }
    }
    if key.starts_with("definition-at:" + path + ":") {
        pilot defn_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_definition_at_exists(defn_id) {
            if v4_definition_at_path(defn_id) == path {
                pilot offset = v4_definition_at_offset(defn_id)
                if v4_definition_at_query_key(path, offset) == key {
                    pilot semantic_id = v4_definition_at_semantic_id(defn_id)
                    if v4_semantic_fact_exists(semantic_id) {
                        pilot fingerprint = v4_query_entry_input(entry_id)
                        pilot semantic_entry = v4_query_find(v4_semantic_at_query_key(path, offset), fingerprint)
                        pilot hir_entry = v4_query_find(v4_hir_query_key(path), fingerprint)
                        if semantic_entry >= 0 and hir_entry >= 0 {
                            pilot restored_semantic = word_to_int(v4_query_entry_output(semantic_entry))
                            pilot hir_id = word_to_int(v4_query_entry_output(hir_entry))
                            if restored_semantic == semantic_id and v4_hir_file_exists(hir_id) {
                                give back 1
                            }
                        }
                    }
                }
            }
        }
    }
    if key == v4_document_symbols_query_key(path) {
        pilot doc_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_document_symbols_exists(doc_id) {
            if v4_document_symbols_path(doc_id) == path {
                pilot fingerprint = v4_query_entry_input(entry_id)
                pilot hir_entry = v4_query_find(v4_hir_query_key(path), fingerprint)
                pilot resolve_entry = v4_query_find(v4_resolve_query_key(path), fingerprint)
                pilot ty_entry = v4_query_find(v4_ty_query_key(path), fingerprint)
                if hir_entry >= 0 and resolve_entry >= 0 and ty_entry >= 0 {
                    pilot hir_id = word_to_int(v4_query_entry_output(hir_entry))
                    pilot resolve_id = word_to_int(v4_query_entry_output(resolve_entry))
                    pilot ty_id = word_to_int(v4_query_entry_output(ty_entry))
                    if v4_hir_file_exists(hir_id) and v4_resolve_exists(resolve_id) and v4_ty_file_exists(ty_id) {
                        give back 1
                    }
                }
            }
        }
    }
    if key.starts_with("completion:" + path + ":") {
        pilot completion_id = word_to_int(v4_query_entry_output(entry_id))
        if v4_completion_exists(completion_id) {
            if v4_completion_path(completion_id) == path {
                pilot offset = v4_completion_offset(completion_id)
                if v4_completion_query_key(path, offset) == key {
                    pilot fingerprint = v4_query_entry_input(entry_id)
                    pilot doc_entry = v4_query_find(v4_document_symbols_query_key(path), fingerprint)
                    if doc_entry >= 0 {
                        pilot doc_id = word_to_int(v4_query_entry_output(doc_entry))
                        if v4_document_symbols_exists(doc_id) {
                            give back 1
                        }
                    }
                }
            }
        }
    }
    give back 0
}

task v4_driver_confirm_restored_key(path: word, key: word) -> word {
    v4_driver_init()
    pilot file_id = v4_source_find(path)
    if file_id < 0 {
        give back "query-confirm-key ok=0 reason=source-missing path=" + path + " key=" + key
    }
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot allow_promote = v4_driver_query_output_can_promote(path, key)
    give back v4_query_confirm_key_input(key, fingerprint, "source-confirm:" + path, allow_promote)
}

task v4_driver_confirm_restored_document(path: word) -> word {
    v4_driver_init()
    pilot file_id = v4_source_find(path)
    if file_id < 0 {
        give back "query-confirm ok=0 reason=source-missing path=" + path
    }

    pilot generation = v4_query_bump_generation("source-confirm:" + path)
    pilot fingerprint = v4_source_fingerprint(file_id)
    pilot considered = 0
    pilot matched = 0
    pilot promoted = 0
    pilot blocked = 0
    pilot already_valid = 0
    pilot dirty_nonrestored = 0
    pilot mismatched = 0

    pilot entry_id = 0
    pilot entry_count = v4_query_cache_size()
    repeat until entry_id >= entry_count {
        pilot key = v4_query_entry_key(entry_id)
        if v4_driver_query_key_matches_path(path, key) {
            considered += 1
            pilot allow_promote = v4_driver_query_entry_can_promote(path, entry_id)
            pilot code = v4_query_confirm_entry_input(entry_id, fingerprint, "source-confirm:" + path, allow_promote)
            if code == 1 {
                matched += 1
                promoted += 1
            } else if code == 2 {
                matched += 1
                blocked += 1
            } else if code == 3 {
                matched += 1
                already_valid += 1
            } else if code == 4 {
                matched += 1
                dirty_nonrestored += 1
            } else {
                mismatched += 1
            }
        }
        entry_id += 1
    }

    pilot out = "query-confirm ok=1"
    out = out + " path=" + path
    out = out + " generation=" + word_from_int(generation)
    out = out + " considered=" + word_from_int(considered)
    out = out + " matched=" + word_from_int(matched)
    out = out + " promoted=" + word_from_int(promoted)
    out = out + " blocked=" + word_from_int(blocked)
    out = out + " already-valid=" + word_from_int(already_valid)
    out = out + " dirty-nonrestored=" + word_from_int(dirty_nonrestored)
    out = out + " mismatched=" + word_from_int(mismatched)
    out = out + " dirty=" + word_from_int(v4_query_dirty_count())
    give back out
}

task v4_driver_confirm_restored_document_text(path: word, text: word) -> word {
    v4_source_set_text(path, text)
    give back v4_driver_confirm_restored_document(path)
}


pilot v4_unit_snapshot_format = "freak-00-unit-snapshot-v3"
pilot v4_unit_snapshot_manifest_format = "freak-00-unit-manifest-v1"
pilot v4_unit_snapshot_diff_format = "freak-00-unit-snapshot-diff-v1"
pilot v4_unit_snapshot_diff_input_format = "freak-00-unit-snapshot-diff-input-v1"
pilot v4_unit_snapshot_health_format = "freak-00-unit-health-v1"
pilot v4_unit_snapshot_ref_names = 0
pilot v4_unit_snapshot_ref_payloads = 0
pilot v4_unit_snapshot_ref_ready = 0

task v4_unit_snapshot_ref_init() -> void {
    if v4_unit_snapshot_ref_ready == 0 {
        v4_unit_snapshot_ref_names = array_new()
        v4_unit_snapshot_ref_payloads = array_new()
        v4_unit_snapshot_ref_ready = 1
    }
}

task v4_unit_snapshot_ref_find(name: word) -> int {
    v4_unit_snapshot_ref_init()
    pilot ref_id = 0
    pilot ref_count = array_len(v4_unit_snapshot_ref_names)
    repeat until ref_id >= ref_count {
        pilot ref_name: word = array_get(v4_unit_snapshot_ref_names, ref_id)
        if ref_name == name {
            give back ref_id
        }
        ref_id += 1
    }
    give back 0 - 1
}

task v4_unit_snapshot_ref_store(name: word, payload: word) -> word {
    v4_unit_snapshot_ref_init()
    pilot ref_id = v4_unit_snapshot_ref_find(name)
    if ref_id < 0 {
        ref_id = array_len(v4_unit_snapshot_ref_names)
        array_push(v4_unit_snapshot_ref_names, name)
        array_push(v4_unit_snapshot_ref_payloads, payload)
    } else {
        array_set(v4_unit_snapshot_ref_payloads, ref_id, payload)
    }
    pilot out = "00-unit-snapshot-ref"
    out = out + "|name=" + v4_unit_snapshot_escape(name)
    out = out + "|bytes=" + word_from_int(payload.length())
    out = out + "\nend|00-unit-snapshot-ref"
    give back out
}

task v4_unit_snapshot_ref_text(name: word) -> word {
    v4_unit_snapshot_ref_init()
    pilot ref_id = v4_unit_snapshot_ref_find(name)
    if ref_id < 0 {
        give back ""
    }
    give back array_get(v4_unit_snapshot_ref_payloads, ref_id)
}

task v4_unit_snapshot_escape(value: word) -> word {
    give back v4_diagnostics_snapshot_escape(value)
}

task v4_unit_snapshot_unescape(value: word) -> word {
    give back v4_diagnostics_snapshot_unescape(value)
}

task v4_unit_snapshot_line_count(payload: word) -> int {
    give back v4_diagnostics_snapshot_line_count(payload)
}

task v4_unit_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_diagnostics_snapshot_line(payload, wanted)
}

task v4_unit_snapshot_field_count(line: word) -> int {
    give back v4_diagnostics_snapshot_field_count(line)
}

task v4_unit_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_diagnostics_snapshot_field_raw(line, wanted)
}

task v4_unit_snapshot_field(line: word, wanted: int) -> word {
    give back v4_diagnostics_snapshot_field(line, wanted)
}

task v4_unit_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_diagnostics_snapshot_key_value(line, wanted_key)
}

task v4_unit_snapshot_section_count() -> int {
    give back 15
}

task v4_unit_snapshot_section_name_at(section_id: int) -> word {
    if section_id == 0 { give back "lex" }
    if section_id == 1 { give back "parse" }
    if section_id == 2 { give back "expand" }
    if section_id == 3 { give back "hir" }
    if section_id == 4 { give back "resolve" }
    if section_id == 5 { give back "ty" }
    if section_id == 6 { give back "mir" }
    if section_id == 7 { give back "borrowck" }
    if section_id == 8 { give back "diagnostics" }
    if section_id == 9 { give back "semantic" }
    if section_id == 10 { give back "hover" }
    if section_id == 11 { give back "definition" }
    if section_id == 12 { give back "document-symbols" }
    if section_id == 13 { give back "completion" }
    if section_id == 14 { give back "query" }
    give back ""
}

task v4_unit_snapshot_section_id(section_name: word) -> int {
    pilot section_id = 0
    repeat until section_id >= v4_unit_snapshot_section_count() {
        if v4_unit_snapshot_section_name_at(section_id) == section_name {
            give back section_id
        }
        section_id += 1
    }
    give back 0 - 1
}

task v4_unit_snapshot_section_occurrences(payload: word, section_name: word) -> int {
    pilot occurrences = 0
    pilot line_id = 0
    pilot line_count = v4_unit_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_unit_snapshot_line(payload, line_id)
        if line != "" {
            if v4_unit_snapshot_field_raw(line, 0) == "unit-section" {
                if v4_unit_snapshot_field_raw(line, 1) == section_name {
                    occurrences += 1
                }
            }
        }
        line_id += 1
    }
    give back occurrences
}

task v4_unit_snapshot_visible_source_count() -> int {
    pilot visible = 0
    pilot file_id = 0
    pilot source_capacity = v4_source_count()
    repeat until file_id >= source_capacity {
        if v4_source_path(file_id) != "" {
            visible += 1
        }
        file_id += 1
    }
    give back visible
}

task v4_unit_snapshot_identity_char_code(ch: word) -> int {
    -- Keep this allocation-constant. The bootstrap word runtime does not yet
    -- reclaim the temporary words produced by nested char_at scans.
    if ch == "\n" { give back 1 }
    if ch == "\r" { give back 2 }
    if ch == "\t" { give back 3 }
    if ch == " " { give back 4 }
    if ch == "!" { give back 5 }
    if ch == "\"" { give back 6 }
    if ch == "#" { give back 7 }
    if ch == "$" { give back 8 }
    if ch == "%" { give back 9 }
    if ch == "&" { give back 10 }
    if ch == "'" { give back 11 }
    if ch == "(" { give back 12 }
    if ch == ")" { give back 13 }
    if ch == "*" { give back 14 }
    if ch == "+" { give back 15 }
    if ch == "," { give back 16 }
    if ch == "-" { give back 17 }
    if ch == "." { give back 18 }
    if ch == "/" { give back 19 }
    if ch == "0" { give back 20 }
    if ch == "1" { give back 21 }
    if ch == "2" { give back 22 }
    if ch == "3" { give back 23 }
    if ch == "4" { give back 24 }
    if ch == "5" { give back 25 }
    if ch == "6" { give back 26 }
    if ch == "7" { give back 27 }
    if ch == "8" { give back 28 }
    if ch == "9" { give back 29 }
    if ch == ":" { give back 30 }
    if ch == ";" { give back 31 }
    if ch == "<" { give back 32 }
    if ch == "=" { give back 33 }
    if ch == ">" { give back 34 }
    if ch == "?" { give back 35 }
    if ch == "@" { give back 36 }
    if ch == "A" { give back 37 }
    if ch == "B" { give back 38 }
    if ch == "C" { give back 39 }
    if ch == "D" { give back 40 }
    if ch == "E" { give back 41 }
    if ch == "F" { give back 42 }
    if ch == "G" { give back 43 }
    if ch == "H" { give back 44 }
    if ch == "I" { give back 45 }
    if ch == "J" { give back 46 }
    if ch == "K" { give back 47 }
    if ch == "L" { give back 48 }
    if ch == "M" { give back 49 }
    if ch == "N" { give back 50 }
    if ch == "O" { give back 51 }
    if ch == "P" { give back 52 }
    if ch == "Q" { give back 53 }
    if ch == "R" { give back 54 }
    if ch == "S" { give back 55 }
    if ch == "T" { give back 56 }
