task v4_expand_snapshot_escape(value: word) -> word {
    give back v4_parse_snapshot_escape(value)
}

task v4_expand_snapshot_unescape(value: word) -> word {
    give back v4_parse_snapshot_unescape(value)
}

task v4_expand_snapshot_line_count(payload: word) -> int {
    give back v4_parse_snapshot_line_count(payload)
}

task v4_expand_snapshot_line(payload: word, wanted: int) -> word {
    give back v4_parse_snapshot_line(payload, wanted)
}

task v4_expand_snapshot_field_count(line: word) -> int {
    give back v4_parse_snapshot_field_count(line)
}

task v4_expand_snapshot_field_raw(line: word, wanted: int) -> word {
    give back v4_parse_snapshot_field_raw(line, wanted)
}

task v4_expand_snapshot_field(line: word, wanted: int) -> word {
    give back v4_parse_snapshot_field(line, wanted)
}

task v4_expand_snapshot_key_value(line: word, wanted_key: word) -> word {
    give back v4_parse_snapshot_key_value(line, wanted_key)
}

task v4_expand_snapshot_summary() -> word {
    pilot out = "expand-snapshot"
    out = out + " format=" + v4_expand_snapshot_format
    out = out + " files=" + word_from_int(v4_expand_file_count())
    give back out
}

task v4_expand_snapshot_header() -> word {
    pilot out = "expand-snapshot"
    out = out + "|format=" + v4_expand_snapshot_format
    out = out + "|files=" + word_from_int(v4_expand_file_count())
    give back out
}

task v4_expand_snapshot_file_line(expansion_id: int) -> word {
    pilot out = "expanded"
    out = out + "|" + word_from_int(expansion_id)
    out = out + "|" + word_from_int(v4_expand_file_id(expansion_id))
    out = out + "|" + word_from_int(v4_expand_parse_tree_id(expansion_id))
    out = out + "|" + v4_expand_snapshot_escape(v4_expand_provenance_kind(expansion_id))
    out = out + "|" + v4_expand_snapshot_escape(v4_expand_provenance(expansion_id))
    give back out
}

task v4_expand_snapshot() -> word {
    v4_expand_init()
    pilot parts = array_new()
    array_push(parts, v4_expand_snapshot_header())
    pilot expansion_id = 0
    repeat until expansion_id >= v4_expand_file_count() {
        array_push(parts, "\n")
        array_push(parts, v4_expand_snapshot_file_line(expansion_id))
        expansion_id += 1
    }
    array_push(parts, "\nend|")
    array_push(parts, v4_expand_snapshot_format)
    give back word_join(parts)
}

task v4_expand_snapshot_record_expected_fields(kind: word) -> int {
    if kind == "expand-snapshot" { give back 3 }
    if kind == "expanded" { give back 6 }
    if kind == "end" { give back 2 }
    give back 0
}

task v4_expand_snapshot_record_is_valid(line: word) -> bool {
    pilot expected = v4_expand_snapshot_record_expected_fields(v4_expand_snapshot_field_raw(line, 0))
    if expected == 0 { give back false }
    give back v4_expand_snapshot_field_count(line) >= expected
}

task v4_expand_snapshot_nonnegative_int_is_valid(raw: word) -> bool {
    if raw == "" { give back false }
    pilot value = word_to_int(raw)
    if value < 0 { give back false }
    give back word_from_int(value) == raw
}

task v4_expand_snapshot_validate(payload: word) -> word {
    pilot lines = v4_expand_snapshot_line_count(payload)
    pilot files = 0
    pilot declared_files = ""
    pilot malformed = 0
    pilot saw_header = 0
    pilot saw_end = 0
    pilot format = ""
    pilot line_id = 0
    repeat until line_id >= lines {
        pilot line = v4_expand_snapshot_line(payload, line_id)
        if line == "" {
            malformed += 1
        } else if v4_expand_snapshot_record_is_valid(line) == false {
            malformed += 1
        } else {
            pilot kind = v4_expand_snapshot_field_raw(line, 0)
            if kind == "expand-snapshot" {
                saw_header += 1
                if line_id != 0 { malformed += 1 }
                format = v4_expand_snapshot_key_value(line, "format")
                declared_files = v4_expand_snapshot_key_value(line, "files")
                if format != v4_expand_snapshot_format { malformed += 1 }
                if v4_expand_snapshot_nonnegative_int_is_valid(declared_files) == false { malformed += 1 }
            } else if kind == "expanded" {
                pilot expansion_id = v4_expand_snapshot_field_raw(line, 1)
                pilot file_id = v4_expand_snapshot_field_raw(line, 2)
                pilot tree_id = v4_expand_snapshot_field_raw(line, 3)
                pilot provenance_kind = v4_expand_snapshot_field(line, 4)
                pilot provenance = v4_expand_snapshot_field(line, 5)
                if v4_expand_snapshot_nonnegative_int_is_valid(expansion_id) == false { malformed += 1 }
                if v4_expand_snapshot_nonnegative_int_is_valid(file_id) == false { malformed += 1 }
                if v4_expand_snapshot_nonnegative_int_is_valid(tree_id) == false { malformed += 1 }
                if word_to_int(expansion_id) != files { malformed += 1 }
                if provenance_kind != v4_expand_provenance_identity { malformed += 1 }
                pilot expected_provenance = provenance_kind + ":file" + file_id + ":tree" + tree_id
                if provenance != expected_provenance { malformed += 1 }
                files += 1
            } else if kind == "end" {
                saw_end += 1
                if line_id != lines - 1 { malformed += 1 }
                if v4_expand_snapshot_field(line, 1) != v4_expand_snapshot_format { malformed += 1 }
            }
        }
        line_id += 1
    }

    pilot import_ok = 1
    if saw_header != 1 { import_ok = 0 }
    if saw_end != 1 { import_ok = 0 }
    if declared_files != word_from_int(files) { import_ok = 0 }
    if malformed > 0 { import_ok = 0 }
    pilot out = "expand-snapshot-import ok=" + word_from_int(import_ok)
    out = out + " format=" + format
    out = out + " lines=" + word_from_int(lines)
    out = out + " files=" + word_from_int(files)
    out = out + " declared-files=" + declared_files
    out = out + " malformed=" + word_from_int(malformed)
    out = out + " headers=" + word_from_int(saw_header)
    out = out + " ends=" + word_from_int(saw_end)
    give back out
}

task v4_expand_restore_file_slot(expansion_id: int, file_id: int, tree_id: int, provenance_kind: word) -> int {
    v4_expand_init()
    repeat until array_len(v4_expand_files) > expansion_id {
        array_push(v4_expand_files, "0")
        array_push(v4_expand_trees, "0")
        array_push(v4_expand_provenance_kinds, v4_expand_provenance_identity)
    }
    array_set(v4_expand_files, expansion_id, word_from_int(file_id))
    array_set(v4_expand_trees, expansion_id, word_from_int(tree_id))
    array_set(v4_expand_provenance_kinds, expansion_id, provenance_kind)
    if expansion_id >= v4_expand_file_len { v4_expand_file_len = expansion_id + 1 }
    give back 1
}

task v4_expand_begin_snapshot_restore() -> void {
    v4_expand_init()
    v4_expand_file_len = 0
}

task v4_expand_snapshot_restore_file_line(line: word) -> int {
    if v4_expand_snapshot_record_is_valid(line) == false { give back 0 }
    if v4_expand_snapshot_field_raw(line, 0) != "expanded" { give back 0 }
    give back v4_expand_restore_file_slot(word_to_int(v4_expand_snapshot_field_raw(line, 1)), word_to_int(v4_expand_snapshot_field_raw(line, 2)), word_to_int(v4_expand_snapshot_field_raw(line, 3)), v4_expand_snapshot_field(line, 4))
}

task v4_expand_snapshot_restore(payload: word) -> word {
    pilot validation = v4_expand_snapshot_validate(payload)
    if validation.starts_with("expand-snapshot-import ok=1") == false {
        give back "expand-snapshot-restore ok=0 reason=validation-failed\n" + validation
    }

    v4_expand_begin_snapshot_restore()
    pilot restored_files = 0
    pilot skipped_other = 0
    pilot line_id = 0
    pilot line_count = v4_expand_snapshot_line_count(payload)
    repeat until line_id >= line_count {
        pilot line = v4_expand_snapshot_line(payload, line_id)
        if line != "" {
            pilot kind = v4_expand_snapshot_field_raw(line, 0)
            if kind == "expanded" {
                restored_files += v4_expand_snapshot_restore_file_line(line)
            } else if kind != "expand-snapshot" and kind != "end" {
                skipped_other += 1
            }
        }
        line_id += 1
    }

    pilot out = "expand-snapshot-restore ok=1"
    out = out + " files=" + word_from_int(restored_files)
    out = out + " skipped-other=" + word_from_int(skipped_other)
    out = out + " live-files=" + word_from_int(v4_expand_file_count())
    v4_session_semantic_restore_generation_advance()
    give back out
}
