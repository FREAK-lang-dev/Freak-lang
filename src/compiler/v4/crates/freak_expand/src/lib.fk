-- ===================================================================
-- freak_expand - V4 identity expansion bootstrap
-- ===================================================================
-- Depends on freak_macro_api and freak_parse. This crate is the only
-- Parse -> Expand bridge.
-- The bootstrap ExpandedFile carrier records a stable arena id, its source
-- file, the forwarded parse tree, and identity provenance. It deliberately
-- defines no public macro API, hygiene model, or syntax-rewriting contract;
-- a later freak_macro_api slice can wrap or replace these internal carriers.

pilot v4_expand_provenance_identity = "identity"
pilot v4_expand_snapshot_format = "freak-expand-snapshot-v1"

pilot v4_expand_files = 0
pilot v4_expand_trees = 0
pilot v4_expand_provenance_kinds = 0
pilot v4_expand_file_len = 0
pilot v4_expand_ready = 0

task v4_expand_init() -> void {
    if v4_expand_ready == 0 {
        v4_expand_files = array_new()
        v4_expand_trees = array_new()
        v4_expand_provenance_kinds = array_new()
        v4_expand_file_len = 0
        v4_expand_ready = 1
    }
}

task v4_expand_file_count() -> int {
    v4_expand_init()
    give back v4_expand_file_len
}

task v4_expand_file_exists(expansion_id: int) -> bool {
    v4_expand_init()
    if expansion_id < 0 { give back false }
    if expansion_id >= v4_expand_file_len { give back false }
    give back true
}

task v4_expand_file_id(expansion_id: int) -> int {
    if v4_expand_file_exists(expansion_id) == false { give back 0 - 1 }
    give back word_to_int(array_get(v4_expand_files, expansion_id))
}

task v4_expand_parse_tree_id(expansion_id: int) -> int {
    if v4_expand_file_exists(expansion_id) == false { give back 0 - 1 }
    give back word_to_int(array_get(v4_expand_trees, expansion_id))
}

task v4_expand_provenance_kind(expansion_id: int) -> word {
    if v4_expand_file_exists(expansion_id) == false { give back "" }
    give back array_get(v4_expand_provenance_kinds, expansion_id)
}

task v4_expand_provenance(expansion_id: int) -> word {
    if v4_expand_file_exists(expansion_id) == false { give back "" }
    pilot out = v4_expand_provenance_kind(expansion_id)
    out = out + ":file" + word_from_int(v4_expand_file_id(expansion_id))
    out = out + ":tree" + word_from_int(v4_expand_parse_tree_id(expansion_id))
    give back out
}

-- Public macro-facing identity values are defined only by freak_macro_api.
-- The integer accepted here is an internal ExpandedFile arena key, not a
-- competing ExpansionId type.
task v4_expand_contract_expansion_id(expanded_file_id: int) -> word {
    if v4_expand_file_exists(expanded_file_id) == false { give back "" }
    pilot source_id = word_from_int(v4_expand_file_id(expanded_file_id))
    give back v4_expansion_id_new(source_id, expanded_file_id, 0)
}

task v4_expand_contract_expansion_matches(expanded_file_id: int, expansion_id: word) -> bool {
    give back v4_expansion_id_valid(expansion_id) and expansion_id == v4_expand_contract_expansion_id(expanded_file_id)
}

task v4_expand_contract_generated_provenance(expanded_file_id: int, origin_span: word, output_index: int) -> word {
    pilot expansion_id = v4_expand_contract_expansion_id(expanded_file_id)
    if expansion_id == "" { give back "" }
    give back v4_generated_node_provenance_new(expansion_id, origin_span, output_index)
}

task v4_expand_find_identity(file_id: int, tree_id: int) -> int {
    v4_expand_init()
    pilot expansion_id = 0
    repeat until expansion_id >= v4_expand_file_count() {
        if v4_expand_file_id(expansion_id) == file_id and v4_expand_parse_tree_id(expansion_id) == tree_id {
            if v4_expand_provenance_kind(expansion_id) == v4_expand_provenance_identity {
                give back expansion_id
            }
        }
        expansion_id += 1
    }
    give back 0 - 1
}

task v4_expand_identity(file_id: int, tree_id: int) -> int {
    v4_expand_init()
    if v4_parse_tree_exists(tree_id) == false { give back 0 - 1 }
    if v4_parse_file_id(tree_id) != file_id { give back 0 - 1 }

    pilot existing = v4_expand_find_identity(file_id, tree_id)
    if existing >= 0 { give back existing }

    pilot expansion_id = v4_expand_file_count()
    if expansion_id < array_len(v4_expand_files) {
        array_set(v4_expand_files, expansion_id, word_from_int(file_id))
        array_set(v4_expand_trees, expansion_id, word_from_int(tree_id))
        array_set(v4_expand_provenance_kinds, expansion_id, v4_expand_provenance_identity)
    } else {
        array_push(v4_expand_files, word_from_int(file_id))
        array_push(v4_expand_trees, word_from_int(tree_id))
        array_push(v4_expand_provenance_kinds, v4_expand_provenance_identity)
    }
    v4_expand_file_len += 1
    give back expansion_id
}

task v4_expand_summary(expansion_id: int) -> word {
    pilot out = "expand-ok expansion=" + word_from_int(expansion_id)
    out = out + " file=" + word_from_int(v4_expand_file_id(expansion_id))
    out = out + " tree=" + word_from_int(v4_expand_parse_tree_id(expansion_id))
    out = out + " provenance=" + v4_expand_provenance(expansion_id)
    give back out
}

-- Identity syntax view. HIR consumes these accessors instead of reaching
-- through the expansion boundary into freak_parse.
task v4_expand_tree_exists(expansion_id: int) -> bool {
    if v4_expand_file_exists(expansion_id) == false { give back false }
    give back v4_parse_tree_exists(v4_expand_parse_tree_id(expansion_id))
}

