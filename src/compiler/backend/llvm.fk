-- ===================================================================
-- FREAK LLVM IR EMITTER (v2)
-- ===================================================================

pilot llvm_out_buf = ""
pilot llvm_out_file = ""
pilot llvm_line_count = 0
pilot temp_reg_counter = 0
pilot string_literals = ""
pilot string_literals_count = 0

-- Variable type tracking: parallel pipe-delimited lists
-- Names: "x|y|greeting|" and Types: "i|w|w|" (i=int, w=word/string, n=num/double)
pilot llvm_var_names = ""
pilot llvm_var_types = ""
-- IR name mapping: source name -> unique IR name (handles shadowed locals)
pilot llvm_var_src_names = ""
pilot llvm_var_ir_names = ""

-- Task return type registry: tracks return types of user-defined tasks
-- So llvm_infer_expr_type can resolve calls to user tasks correctly
pilot llvm_task_reg_names = ""
pilot llvm_task_reg_types = ""
pilot llvm_task_reg_count = 0

-- Track current function context for correct ret emission
pilot llvm_cur_func_is_void = false
pilot llvm_declared_funcs = ""

-- Track current loop labels for break/continue
pilot llvm_loop_end_label = ""
pilot llvm_loop_cond_label = ""

-- Track global variables (top-level pilots)
pilot llvm_global_names = ""

-- Flush the LLVM output buffer to file (streaming mode)
task llvm_flush() -> void {
    if llvm_out_file != "" {
        if llvm_out_buf != "" {
            fs::append(llvm_out_file, llvm_out_buf)
            llvm_out_buf = ""
            llvm_line_count = 0
        }
    }
}

task llvm_emit(s: word) -> void {
    llvm_out_buf = llvm_out_buf + s
}

task llvm_emit_line(s: word) -> void {
    llvm_out_buf = llvm_out_buf + s
    llvm_out_buf = llvm_out_buf + "\n"
    llvm_line_count += 1
    -- In streaming mode, flush every 50 lines to prevent O(n^2) blowup
    if llvm_out_file != "" {
        if llvm_line_count >= 50 {
            llvm_flush()
        }
    }
}

task next_reg() -> word {
    pilot r = "%t" + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    give back r
}

task llvm_flush_strs() -> void {
    if llvm_out_file != "" {
        if string_literals != "" {
            fs::append(llvm_out_file + ".strs", string_literals)
            string_literals = ""
        }
    }
}

task llvm_escape_str(s: word) -> word {
    -- Escape special characters for LLVM IR c"..." string literals
    pilot esc_out = ""
    pilot esc_len = s.length()
    pilot esc_i = 0
    repeat until esc_i >= esc_len {
        pilot ch = s.char_at(esc_i)
        if ch == "\\" and esc_i + 3 < esc_len {
            pilot nx = s.char_at(esc_i + 1)
            if nx == "x" {
                -- \xNN hex escape from lexer -> LLVM IR \NN (uppercase)
                pilot h1 = s.char_at(esc_i + 2)
                pilot h2 = s.char_at(esc_i + 3)
                esc_out = esc_out + "\\" + h1 + h2
                esc_i += 4
            } else {
                esc_out = esc_out + "\\5C"
                esc_i += 1
            }
        } else if ch == "\"" {
            esc_out = esc_out + "\\22"
            esc_i += 1
        } else if ch == "\\" {
            esc_out = esc_out + "\\5C"
            esc_i += 1
        } else if ch == "\n" {
            esc_out = esc_out + "\\0A"
            esc_i += 1
        } else if ch == "\r" {
            esc_out = esc_out + "\\0D"
            esc_i += 1
        } else if ch == "\t" {
            esc_out = esc_out + "\\09"
            esc_i += 1
        } else {
            esc_out = esc_out + ch
            esc_i += 1
        }
    }
    give back esc_out
}

task register_string_literal(val: word) -> word {
    pilot id = "@.str." + word_from_int(string_literals_count)
    string_literals_count += 1

    -- Restore escaped pipe characters from lexer
    pilot real_val = val.replace("<<PIPE>>", "|")
    -- Calculate actual byte length (account for \xNN -> 1 byte)
    pilot len = real_val.length()
    pilot adj_i = 0
    repeat until adj_i >= len {
        pilot adj_ch = real_val.char_at(adj_i)
        if adj_ch == "\\" and adj_i + 3 < len {
            pilot adj_nx = real_val.char_at(adj_i + 1)
            if adj_nx == "x" {
                -- \xNN is 4 chars in source but 1 byte in output
                len -= 3
                adj_i += 4
            } else {
                adj_i += 1
            }
        } else {
            adj_i += 1
        }
    }
    pilot null_term_len = len + 1

    -- Escape for LLVM IR c"..." syntax
    pilot escaped = llvm_escape_str(real_val)

    -- Format: @.str.0 = private unnamed_addr constant [13 x i8] c"Hello World!\00", align 1
    pilot decl = id + " = private unnamed_addr constant [" + word_from_int(null_term_len) + " x i8] c\"" + escaped + "\\00\", align 1\n"
    string_literals = string_literals + decl

    -- In streaming mode, flush string literals periodically
    if llvm_out_file != "" {
        if string_literals_count % 50 == 0 {
            llvm_flush_strs()
        }
    }

    give back id
}

task llvm_c_safe_ident(s: word) -> word {
    pilot res = ""
    pilot slen = s.length()
    pilot i = 0
    repeat slen times {
        pilot c = s.char_at(i)
        if c == ":" {
            if i + 1 < slen {
                if s.char_at(i + 1) == ":" {
                    res = res + "_"
                    i += 1
                } else {
                    res = res + c
                }
            } else {
                res = res + c
            }
        } else {
            res = res + c
        }
        i += 1
    }
    give back res
}

-- ===================== TYPE TRACKING ===============================

-- Register a unique IR name for a local variable (handles shadowed names)
task llvm_register_local(src_name: word) -> word {
    pilot ir_name = src_name + "." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    llvm_var_src_names = llvm_var_src_names + src_name + "|"
    llvm_var_ir_names = llvm_var_ir_names + ir_name + "|"
    give back ir_name
}

-- Look up the most recent IR name for a source variable name
task llvm_resolve_local(src_name: word) -> word {
    pilot nlen = llvm_var_src_names.length()
    pilot i = nlen - 1
    pilot cur = ""
    pilot idx = 0
    -- Count total entries first
    pilot total = 0
    pilot ci = 0
    repeat until ci >= nlen {
        if llvm_var_src_names.char_at(ci) == "|" { total += 1 }
        ci += 1
    }
    -- Walk backwards through entries to find last match
    pilot best_ir = ""
    pilot wi = 0
    pilot wname = ""
    pilot widx = 0
    repeat until wi >= nlen {
        pilot c = llvm_var_src_names.char_at(wi)
        if c == "|" {
            if wname == src_name {
                -- Found a match at widx, get the IR name at the same index
                pilot ti = 0
                pilot tname = ""
                pilot tidx = 0
                pilot tlen = llvm_var_ir_names.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_var_ir_names.char_at(ti)
                    if tc == "|" {
                        if tidx == widx {
                            best_ir = tname
                        }
                        tidx += 1
                        tname = ""
                    } else {
                        tname = tname + tc
                    }
                    ti += 1
                }
            }
            widx += 1
            wname = ""
        } else {
            wname = wname + c
        }
        wi += 1
    }
    if best_ir.length() > 0 { give back best_ir }
    -- Fallback: variable not registered (parameter or old-style), use raw name
    give back src_name
}

task llvm_set_var_type(name: word, vtype: word) -> void {
    llvm_var_names = llvm_var_names + name + "|"
    llvm_var_types = llvm_var_types + vtype + "|"
}

task llvm_get_var_type(name: word) -> word {
    -- Walk through llvm_var_names looking for the matching name
    -- Return the corresponding type from llvm_var_types
    pilot nlen = llvm_var_names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    repeat until i >= nlen {
        pilot c = llvm_var_names.char_at(i)
        if c == "|" {
            if cur_name == name {
                -- Found it, now get the type at the same index
                pilot ti = 0
                pilot cur_type = ""
                pilot tidx = 0
                pilot tlen = llvm_var_types.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_var_types.char_at(ti)
                    if tc == "|" {
                        if tidx == idx {
                            give back cur_type
                        }
                        tidx += 1
                        cur_type = ""
                    } else {
                        cur_type = cur_type + tc
                    }
                    ti += 1
                }
            }
            idx += 1
            cur_name = ""
        } else {
            cur_name = cur_name + c
        }
        i += 1
    }
    give back "i"
}

-- Register a task's return type
task llvm_register_task(name: word, ret_type: word) -> void {
    pilot t = "i"
    if ret_type == "word" { t = "w" }
    if ret_type == "bool" { t = "b" }
    if ret_type == "num" { t = "n" }
    if ret_type == "int" { t = "i" }
    if ret_type == "void" { t = "v" }
    llvm_task_reg_names = llvm_task_reg_names + name + "|"
    llvm_task_reg_types = llvm_task_reg_types + t + "|"
    llvm_task_reg_count += 1
}

-- Look up a task's return type ("w", "i", "n", "b", "v", or "" if not found)
task llvm_get_task_ret_type(name: word) -> word {
    pilot nlen = llvm_task_reg_names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    repeat until i >= nlen {
        pilot c = llvm_task_reg_names.char_at(i)
        if c == "|" {
            if cur_name == name {
                pilot ti = 0
                pilot cur_type = ""
                pilot tidx = 0
                pilot tlen = llvm_task_reg_types.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_task_reg_types.char_at(ti)
                    if tc == "|" {
                        if tidx == idx {
                            give back cur_type
                        }
                        tidx += 1
                        cur_type = ""
                    } else {
                        cur_type = cur_type + tc
                    }
                    ti += 1
                }
            }
            idx += 1
            cur_name = ""
        } else {
            cur_name = cur_name + c
        }
        i += 1
    }
    give back ""
}

-- Infer the type of an expression ("i" for int, "w" for word/string, "n" for num/double)
task llvm_infer_expr_type(expr_id: word) -> word {
    if expr_id.length() == 0 { give back "i" }
    pilot i = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)

    if kind == EXPR_STR { give back "w" }
    if kind == EXPR_INT { give back "i" }
    if kind == EXPR_FLOAT { give back "n" }
    if kind == EXPR_BOOL { give back "b" }
    if kind == EXPR_IDENT { give back llvm_get_var_type(val) }

    if kind == EXPR_METHOD {
        -- Methods that return strings
        if val == "trim" { give back "w" }
        if val == "to_upper" { give back "w" }
        if val == "to_lower" { give back "w" }
        if val == "replace" { give back "w" }
        if val == "char_at" { give back "w" }
        -- Methods that return ints
        if val == "length" { give back "i" }
        if val == "to_int" { give back "i" }
        if val == "contains" { give back "i" }
        if val == "starts_with" { give back "i" }
        if val == "ends_with" { give back "i" }
        -- Check user-defined impl methods via task registry
        pilot mi = 0
        repeat shape_registry_count times {
            pilot msname: word = "" + array_get(shape_registry_names, mi)
            pilot impl_ret: word = llvm_get_task_ret_type(msname + "_" + val)
            if impl_ret.length() > 0 {
                give back impl_ret
            }
            mi += 1
        }
    }

    if kind == EXPR_FIELD {
        -- Look up the field type from shape registry
        pilot fi = 0
        repeat shape_registry_count times {
            pilot sname: word = "" + array_get(shape_registry_names, fi)
            pilot fields: word = "" + array_get(shape_registry_fields, fi)
            pilot flen = fields.length()
            pilot fj = 0
            pilot fname = ""
            pilot ftype = ""
            pilot in_ftype = false
            repeat flen times {
                pilot ftc: word = "" + fields.char_at(fj)
                if ftc == "," {
                    if fname == val {
                        if ftype == "num" or ftype == "float" { give back "n" }
                        if ftype == "word" { give back "w" }
                        if ftype == "bool" { give back "b" }
                        give back "i"
                    }
                    fname = ""
                    ftype = ""
                    in_ftype = false
                } else if ftc == ":" {
                    in_ftype = true
                } else {
                    if in_ftype { ftype = ftype + ftc }
                    else { fname = fname + ftc }
                }
                fj += 1
            }
            if fname == val {
                if ftype == "num" or ftype == "float" { give back "n" }
                if ftype == "word" { give back "w" }
                if ftype == "bool" { give back "b" }
                give back "i"
            }
            fi += 1
        }
    }

    if kind == EXPR_BINOP {
        pilot left: word = array_get(ast_expr_lefts, i)
        pilot right: word = array_get(ast_expr_rights, i)
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        if val == "+" {
            -- Check if either operand is a string
            if lt.starts_with("w") or rt.starts_with("w") { give back "w" }
        }
        -- Num propagation: if either operand is num, result is num
        if lt.starts_with("n") or rt.starts_with("n") {
            if val == "+" or val == "-" or val == "*" or val == "/" or val == "%" {
                give back "n"
            }
        }
    }

    if kind == EXPR_CALL {
        -- Built-in calls that return strings
        if val == "fs::read" { give back "w" }
        if val == "fs::list_dir" { give back "w" }
        if val == "process::arg" { give back "w" }
        if val == "process::exec_capture" { give back "w" }
        if val == "ask" { give back "w" }
        if val == "word_from_int" { give back "w" }
        if val == "word_from_bool" { give back "w" }
        if val == "word_concat" { give back "w" }
        -- Runtime helpers used by the compiler itself
        if val == "get_nth" { give back "w" }
        if val == "push_item" { give back "w" }
        if val == "array_get" { give back "w" }
        if val == "array_new" { give back "i" }
        if val == "array_len" { give back "i" }
        -- Shape constructors return an opaque handle (int)
        if val.starts_with("shape::ctor::") { give back "i" }
        -- Look up user-defined task return types from the registry
        pilot task_ret = llvm_get_task_ret_type(val)
        if task_ret.length() > 0 { give back task_ret }
    }

    give back "i"
}

-- ===================== RUNTIME BINDINGS ============================
task llvm_emit_runtime_decls() -> void {
    -- C library declarations
    llvm_emit_line("declare i32 @puts(i8*)")
    llvm_emit_line("declare i32 @printf(i8*, ...)")
    llvm_emit_line("declare i32 @snprintf(i8*, i64, i8*, ...)")
    llvm_emit_line("declare i64 @strlen(i8*)")
    llvm_emit_line("declare i8* @calloc(i64, i64)")
    llvm_emit_line("declare i8* @malloc(i64)")
    llvm_emit_line("declare i8* @realloc(i8*, i64)")
    llvm_emit_line("declare void @free(i8*)")
    llvm_emit_line("declare i32 @putchar(i32)")
    llvm_emit_line("declare i32 @strcmp(i8*, i8*)")
    llvm_emit_line("declare i32 @memcmp(i8*, i8*, i64)")
    llvm_emit_line("declare i8* @memcpy(i8*, i8*, i64)")
    llvm_emit_line("declare i64 @atoll(i8*)")
    llvm_emit_line("declare i8* @strstr(i8*, i8*)")
    llvm_emit_line("declare void @exit(i32)")
    llvm_emit_line("declare i32 @system(i8*)")
    llvm_emit_line("declare i32 @strncmp(i8*, i8*, i64)")
    -- Globals for argc/argv (set by setup_args intrinsic)
    llvm_emit_line("@__freak_argc = internal global i64 0")
    llvm_emit_line("@__freak_argv = internal global i64 0")
    -- Format strings and string constants for intrinsics
    llvm_emit_line("@.fmt_int = private unnamed_addr constant [5 x i8] c\"%lld\\00\"")
    llvm_emit_line("@.fmt_str = private unnamed_addr constant [3 x i8] c\"%s\\00\"")
    llvm_emit_line("@.fmt_str_nl = private unnamed_addr constant [4 x i8] c\"%s\\0A\\00\"")
    llvm_emit_line("@.fmt_num = private unnamed_addr constant [3 x i8] c\"%g\\00\"")
    llvm_emit_line("@.fmt_lld = private unnamed_addr constant [5 x i8] c\"%lld\\00\"")
    llvm_emit_line("@.str_true = private unnamed_addr constant [5 x i8] c\"true\\00\"")
    llvm_emit_line("@.str_false = private unnamed_addr constant [6 x i8] c\"false\\00\"")
    llvm_emit_line("@.str_empty = private unnamed_addr constant [1 x i8] c\"\\00\"")
    llvm_emit_line("")

    -- ═══ Word (string) intrinsics — pure IR ═══

    -- word_length: strlen wrapper
    llvm_emit_line("define i64 @freak_word_length(i64 %sp) {")
    llvm_emit_line("    %p = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %len = call i64 @strlen(i8* %p)")
    llvm_emit_line("    ret i64 %len")
    llvm_emit_line("}")

    -- word_eq: strcmp == 0
    llvm_emit_line("define i64 @freak_word_eq(i64 %ap, i64 %bp) {")
    llvm_emit_line("    %a = inttoptr i64 %ap to i8*")
    llvm_emit_line("    %b = inttoptr i64 %bp to i8*")
    llvm_emit_line("    %cmp = call i32 @strcmp(i8* %a, i8* %b)")
    llvm_emit_line("    %eq = icmp eq i32 %cmp, 0")
    llvm_emit_line("    %r = zext i1 %eq to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_neq: strcmp != 0
    llvm_emit_line("define i64 @freak_word_neq(i64 %ap, i64 %bp) {")
    llvm_emit_line("    %a = inttoptr i64 %ap to i8*")
    llvm_emit_line("    %b = inttoptr i64 %bp to i8*")
    llvm_emit_line("    %cmp = call i32 @strcmp(i8* %a, i8* %b)")
    llvm_emit_line("    %ne = icmp ne i32 %cmp, 0")
    llvm_emit_line("    %r = zext i1 %ne to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- Aliases for llvm_word_eq/neq (emitter uses both naming conventions)
    llvm_emit_line("@freak_llvm_word_eq = alias i64 (i64, i64), i64 (i64, i64)* @freak_word_eq")
    llvm_emit_line("@freak_llvm_word_neq = alias i64 (i64, i64), i64 (i64, i64)* @freak_word_neq")

    -- word_concat: strlen(a) + strlen(b) + malloc + memcpy
    llvm_emit_line("define i64 @freak_word_concat(i64 %ap, i64 %bp) {")
    llvm_emit_line("    %a = inttoptr i64 %ap to i8*")
    llvm_emit_line("    %b = inttoptr i64 %bp to i8*")
    llvm_emit_line("    %la = call i64 @strlen(i8* %a)")
    llvm_emit_line("    %lb = call i64 @strlen(i8* %b)")
    llvm_emit_line("    %total = add i64 %la, %lb")
    llvm_emit_line("    %alloc = add i64 %total, 1")
    llvm_emit_line("    %buf = call i8* @malloc(i64 %alloc)")
    llvm_emit_line("    call i8* @memcpy(i8* %buf, i8* %a, i64 %la)")
    llvm_emit_line("    %dst = getelementptr i8, i8* %buf, i64 %la")
    llvm_emit_line("    call i8* @memcpy(i8* %dst, i8* %b, i64 %lb)")
    llvm_emit_line("    %end = getelementptr i8, i8* %buf, i64 %total")
    llvm_emit_line("    store i8 0, i8* %end")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_from_int: snprintf into malloc'd buffer
    llvm_emit_line("define i64 @freak_word_from_int(i64 %n) {")
    llvm_emit_line("    %buf = call i8* @malloc(i64 32)")
    llvm_emit_line("    %fmt = getelementptr [5 x i8], [5 x i8]* @.fmt_lld, i64 0, i64 0")
    llvm_emit_line("    call i32 (i8*, i64, i8*, ...) @snprintf(i8* %buf, i64 32, i8* %fmt, i64 %n)")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_from_bool: select between "true" and "false" string literals
    llvm_emit_line("define i64 @freak_word_from_bool(i64 %b) {")
    llvm_emit_line("    %cond = icmp ne i64 %b, 0")
    llvm_emit_line("    %t = getelementptr [5 x i8], [5 x i8]* @.str_true, i64 0, i64 0")
    llvm_emit_line("    %f = getelementptr [6 x i8], [6 x i8]* @.str_false, i64 0, i64 0")
    llvm_emit_line("    %sel = select i1 %cond, i8* %t, i8* %f")
    llvm_emit_line("    %r = ptrtoint i8* %sel to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_char_at: bounds check + malloc(2) + copy one byte
    llvm_emit_line("define i64 @freak_word_char_at(i64 %sp, i64 %idx) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %len = call i64 @strlen(i8* %s)")
    llvm_emit_line("    %oob = icmp uge i64 %idx, %len")
    llvm_emit_line("    br i1 %oob, label %empty, label %ok")
    llvm_emit_line("empty:")
    llvm_emit_line("    %e = getelementptr [1 x i8], [1 x i8]* @.str_empty, i64 0, i64 0")
    llvm_emit_line("    %er = ptrtoint i8* %e to i64")
    llvm_emit_line("    ret i64 %er")
    llvm_emit_line("ok:")
    llvm_emit_line("    %buf = call i8* @malloc(i64 2)")
    llvm_emit_line("    %cp = getelementptr i8, i8* %s, i64 %idx")
    llvm_emit_line("    %ch = load i8, i8* %cp")
    llvm_emit_line("    store i8 %ch, i8* %buf")
    llvm_emit_line("    %buf1 = getelementptr i8, i8* %buf, i64 1")
    llvm_emit_line("    store i8 0, i8* %buf1")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_starts_with: strlen(prefix) + memcmp first N bytes
    llvm_emit_line("define i64 @freak_word_starts_with(i64 %sp, i64 %pp) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %p = inttoptr i64 %pp to i8*")
    llvm_emit_line("    %pl = call i64 @strlen(i8* %p)")
    llvm_emit_line("    %sl = call i64 @strlen(i8* %s)")
    llvm_emit_line("    %short = icmp ugt i64 %pl, %sl")
    llvm_emit_line("    br i1 %short, label %no, label %check")
    llvm_emit_line("check:")
    llvm_emit_line("    %cmp = call i32 @memcmp(i8* %s, i8* %p, i64 %pl)")
    llvm_emit_line("    %eq = icmp eq i32 %cmp, 0")
    llvm_emit_line("    %r = zext i1 %eq to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("no:")
    llvm_emit_line("    ret i64 0")
    llvm_emit_line("}")

    -- word_ends_with: strlen(s) - strlen(p) + memcmp at offset
    llvm_emit_line("define i64 @freak_word_ends_with(i64 %sp, i64 %pp) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %p = inttoptr i64 %pp to i8*")
    llvm_emit_line("    %sl = call i64 @strlen(i8* %s)")
    llvm_emit_line("    %pl = call i64 @strlen(i8* %p)")
    llvm_emit_line("    %short = icmp ugt i64 %pl, %sl")
    llvm_emit_line("    br i1 %short, label %no, label %check")
    llvm_emit_line("check:")
    llvm_emit_line("    %off = sub i64 %sl, %pl")
    llvm_emit_line("    %tail = getelementptr i8, i8* %s, i64 %off")
    llvm_emit_line("    %cmp = call i32 @memcmp(i8* %tail, i8* %p, i64 %pl)")
    llvm_emit_line("    %eq = icmp eq i32 %cmp, 0")
    llvm_emit_line("    %r = zext i1 %eq to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("no:")
    llvm_emit_line("    ret i64 0")
    llvm_emit_line("}")

    -- word_to_int: atoll wrapper
    llvm_emit_line("define i64 @freak_word_to_int(i64 %sp) {")
    llvm_emit_line("    %p = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %n = call i64 @atoll(i8* %p)")
    llvm_emit_line("    ret i64 %n")
    llvm_emit_line("}")

    -- word_contains: strstr wrapper
    llvm_emit_line("define i64 @freak_word_contains(i64 %sp, i64 %np) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %n = inttoptr i64 %np to i8*")
    llvm_emit_line("    %found = call i8* @strstr(i8* %s, i8* %n)")
    llvm_emit_line("    %isnull = icmp eq i8* %found, null")
    llvm_emit_line("    %r = select i1 %isnull, i64 0, i64 1")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_to_upper: loop over bytes, a-z → A-Z (subtract 32)
    llvm_emit_line("define i64 @freak_word_to_upper(i64 %sp) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %len = call i64 @strlen(i8* %s)")
    llvm_emit_line("    %alloc = add i64 %len, 1")
    llvm_emit_line("    %buf = call i8* @malloc(i64 %alloc)")
    llvm_emit_line("    br label %loop")
    llvm_emit_line("loop:")
    llvm_emit_line("    %i = phi i64 [0, %0], [%i1, %next]")
    llvm_emit_line("    %done = icmp uge i64 %i, %len")
    llvm_emit_line("    br i1 %done, label %end, label %body")
    llvm_emit_line("body:")
    llvm_emit_line("    %sp2 = getelementptr i8, i8* %s, i64 %i")
    llvm_emit_line("    %ch = load i8, i8* %sp2")
    llvm_emit_line("    %ge_a = icmp uge i8 %ch, 97")
    llvm_emit_line("    %le_z = icmp ule i8 %ch, 122")
    llvm_emit_line("    %is_lower = and i1 %ge_a, %le_z")
    llvm_emit_line("    %upper = sub i8 %ch, 32")
    llvm_emit_line("    %out = select i1 %is_lower, i8 %upper, i8 %ch")
    llvm_emit_line("    %dp = getelementptr i8, i8* %buf, i64 %i")
    llvm_emit_line("    store i8 %out, i8* %dp")
    llvm_emit_line("    br label %next")
    llvm_emit_line("next:")
    llvm_emit_line("    %i1 = add i64 %i, 1")
    llvm_emit_line("    br label %loop")
    llvm_emit_line("end:")
    llvm_emit_line("    %ep = getelementptr i8, i8* %buf, i64 %len")
    llvm_emit_line("    store i8 0, i8* %ep")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_to_lower: loop over bytes, A-Z → a-z (add 32)
    llvm_emit_line("define i64 @freak_word_to_lower(i64 %sp) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %len = call i64 @strlen(i8* %s)")
    llvm_emit_line("    %alloc = add i64 %len, 1")
    llvm_emit_line("    %buf = call i8* @malloc(i64 %alloc)")
    llvm_emit_line("    br label %loop")
    llvm_emit_line("loop:")
    llvm_emit_line("    %i = phi i64 [0, %0], [%i1, %next]")
    llvm_emit_line("    %done = icmp uge i64 %i, %len")
    llvm_emit_line("    br i1 %done, label %end, label %body")
    llvm_emit_line("body:")
    llvm_emit_line("    %sp2 = getelementptr i8, i8* %s, i64 %i")
    llvm_emit_line("    %ch = load i8, i8* %sp2")
    llvm_emit_line("    %ge_A = icmp uge i8 %ch, 65")
    llvm_emit_line("    %le_Z = icmp ule i8 %ch, 90")
    llvm_emit_line("    %is_upper = and i1 %ge_A, %le_Z")
    llvm_emit_line("    %lower = add i8 %ch, 32")
    llvm_emit_line("    %out = select i1 %is_upper, i8 %lower, i8 %ch")
    llvm_emit_line("    %dp = getelementptr i8, i8* %buf, i64 %i")
    llvm_emit_line("    store i8 %out, i8* %dp")
    llvm_emit_line("    br label %next")
    llvm_emit_line("next:")
    llvm_emit_line("    %i1 = add i64 %i, 1")
    llvm_emit_line("    br label %loop")
    llvm_emit_line("end:")
    llvm_emit_line("    %ep = getelementptr i8, i8* %buf, i64 %len")
    llvm_emit_line("    store i8 0, i8* %ep")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- word_trim: skip leading/trailing spaces (0x20), tabs (0x09), newlines (0x0A, 0x0D)
    llvm_emit_line("define i64 @freak_word_trim(i64 %sp) {")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %len = call i64 @strlen(i8* %s)")
    llvm_emit_line("    br label %skip_start")
    llvm_emit_line("skip_start:")
    llvm_emit_line("    %si = phi i64 [0, %0], [%si1, %skip_cont]")
    llvm_emit_line("    %sdone = icmp uge i64 %si, %len")
    llvm_emit_line("    br i1 %sdone, label %build, label %scheck")
    llvm_emit_line("scheck:")
    llvm_emit_line("    %scp = getelementptr i8, i8* %s, i64 %si")
    llvm_emit_line("    %sch = load i8, i8* %scp")
    llvm_emit_line("    %s1 = icmp eq i8 %sch, 32")
    llvm_emit_line("    %s2 = icmp eq i8 %sch, 9")
    llvm_emit_line("    %s3 = icmp eq i8 %sch, 10")
    llvm_emit_line("    %s4 = icmp eq i8 %sch, 13")
    llvm_emit_line("    %s12 = or i1 %s1, %s2")
    llvm_emit_line("    %s34 = or i1 %s3, %s4")
    llvm_emit_line("    %sws = or i1 %s12, %s34")
    llvm_emit_line("    br i1 %sws, label %skip_cont, label %build")
    llvm_emit_line("skip_cont:")
    llvm_emit_line("    %si1 = add i64 %si, 1")
    llvm_emit_line("    br label %skip_start")
    llvm_emit_line("build:")
    llvm_emit_line("    %start = phi i64 [%si, %scheck], [%si, %skip_start]")
    llvm_emit_line("    br label %skip_end")
    llvm_emit_line("skip_end:")
    llvm_emit_line("    %ei = phi i64 [%len, %build], [%ei1, %econt]")
    llvm_emit_line("    %ezero = icmp ule i64 %ei, %start")
    llvm_emit_line("    br i1 %ezero, label %alloc, label %echeck")
    llvm_emit_line("echeck:")
    llvm_emit_line("    %ei1 = sub i64 %ei, 1")
    llvm_emit_line("    %ecp = getelementptr i8, i8* %s, i64 %ei1")
    llvm_emit_line("    %ech = load i8, i8* %ecp")
    llvm_emit_line("    %e1 = icmp eq i8 %ech, 32")
    llvm_emit_line("    %e2 = icmp eq i8 %ech, 9")
    llvm_emit_line("    %e3 = icmp eq i8 %ech, 10")
    llvm_emit_line("    %e4 = icmp eq i8 %ech, 13")
    llvm_emit_line("    %e12 = or i1 %e1, %e2")
    llvm_emit_line("    %e34 = or i1 %e3, %e4")
    llvm_emit_line("    %ews = or i1 %e12, %e34")
    llvm_emit_line("    br i1 %ews, label %econt, label %alloc")
    llvm_emit_line("econt:")
    llvm_emit_line("    br label %skip_end")
    llvm_emit_line("alloc:")
    llvm_emit_line("    %end_idx = phi i64 [%ei, %skip_end], [%ei1, %echeck]")
    llvm_emit_line("    %tlen = sub i64 %end_idx, %start")
    llvm_emit_line("    %talloc = add i64 %tlen, 1")
    llvm_emit_line("    %tbuf = call i8* @malloc(i64 %talloc)")
    llvm_emit_line("    %tsrc = getelementptr i8, i8* %s, i64 %start")
    llvm_emit_line("    call i8* @memcpy(i8* %tbuf, i8* %tsrc, i64 %tlen)")
    llvm_emit_line("    %tnull = getelementptr i8, i8* %tbuf, i64 %tlen")
    llvm_emit_line("    store i8 0, i8* %tnull")
    llvm_emit_line("    %tr = ptrtoint i8* %tbuf to i64")
    llvm_emit_line("    ret i64 %tr")
    llvm_emit_line("}")

    -- word_replace: pure LLVM IR — count occurrences, alloc result, copy with replacements
    llvm_emit_line("define i64 @freak_word_replace(i64 %sp, i64 %old_p, i64 %new_p) {")
    llvm_emit_line("entry:")
    llvm_emit_line("    %s = inttoptr i64 %sp to i8*")
    llvm_emit_line("    %old = inttoptr i64 %old_p to i8*")
    llvm_emit_line("    %new = inttoptr i64 %new_p to i8*")
    llvm_emit_line("    %old_len = call i64 @strlen(i8* %old)")
    llvm_emit_line("    %new_len = call i64 @strlen(i8* %new)")
    llvm_emit_line("    %s_len = call i64 @strlen(i8* %s)")
    llvm_emit_line("    %old_empty = icmp eq i64 %old_len, 0")
    llvm_emit_line("    br i1 %old_empty, label %ret_orig, label %count_hdr")
    -- Phase 1: count occurrences of old in s
    llvm_emit_line("count_hdr:")
    llvm_emit_line("    br label %count_loop")
    llvm_emit_line("count_loop:")
    llvm_emit_line("    %ci = phi i64 [0, %count_hdr], [%ci_adv, %count_next]")
    llvm_emit_line("    %cnt = phi i64 [0, %count_hdr], [%cnt_n, %count_next]")
    llvm_emit_line("    %ci_left = sub i64 %s_len, %ci")
    llvm_emit_line("    %ci_done = icmp ult i64 %ci_left, %old_len")
    llvm_emit_line("    br i1 %ci_done, label %alloc, label %count_body")
    llvm_emit_line("count_body:")
    llvm_emit_line("    %cp = getelementptr i8, i8* %s, i64 %ci")
    llvm_emit_line("    %cmp = call i32 @strncmp(i8* %cp, i8* %old, i64 %old_len)")
    llvm_emit_line("    %is_match = icmp eq i32 %cmp, 0")
    llvm_emit_line("    br i1 %is_match, label %count_hit, label %count_miss")
    llvm_emit_line("count_hit:")
    llvm_emit_line("    %cnt_h = add i64 %cnt, 1")
    llvm_emit_line("    %ci_h = add i64 %ci, %old_len")
    llvm_emit_line("    br label %count_next")
    llvm_emit_line("count_miss:")
    llvm_emit_line("    %ci_m = add i64 %ci, 1")
    llvm_emit_line("    br label %count_next")
    llvm_emit_line("count_next:")
    llvm_emit_line("    %ci_adv = phi i64 [%ci_h, %count_hit], [%ci_m, %count_miss]")
    llvm_emit_line("    %cnt_n = phi i64 [%cnt_h, %count_hit], [%cnt, %count_miss]")
    llvm_emit_line("    br label %count_loop")
    -- Phase 2: allocate result buffer
    llvm_emit_line("alloc:")
    llvm_emit_line("    %cnt_final = phi i64 [%cnt, %count_loop]")
    llvm_emit_line("    %diff = sub i64 %new_len, %old_len")
    llvm_emit_line("    %extra = mul i64 %cnt_final, %diff")
    llvm_emit_line("    %rlen = add i64 %s_len, %extra")
    llvm_emit_line("    %rlen1 = add i64 %rlen, 1")
    llvm_emit_line("    %buf = call i8* @malloc(i64 %rlen1)")
    llvm_emit_line("    br label %copy_loop")
    -- Phase 3: copy with replacements
    llvm_emit_line("copy_loop:")
    llvm_emit_line("    %si = phi i64 [0, %alloc], [%si_adv, %copy_next]")
    llvm_emit_line("    %di = phi i64 [0, %alloc], [%di_adv, %copy_next]")
    llvm_emit_line("    %si_end = icmp uge i64 %si, %s_len")
    llvm_emit_line("    br i1 %si_end, label %done, label %copy_body")
    llvm_emit_line("copy_body:")
    llvm_emit_line("    %si_rem = sub i64 %s_len, %si")
    llvm_emit_line("    %can_match = icmp uge i64 %si_rem, %old_len")
    llvm_emit_line("    br i1 %can_match, label %copy_try, label %copy_char")
    llvm_emit_line("copy_try:")
    llvm_emit_line("    %srcp = getelementptr i8, i8* %s, i64 %si")
    llvm_emit_line("    %mc = call i32 @strncmp(i8* %srcp, i8* %old, i64 %old_len)")
    llvm_emit_line("    %found = icmp eq i32 %mc, 0")
    llvm_emit_line("    br i1 %found, label %copy_repl, label %copy_char")
    llvm_emit_line("copy_repl:")
    llvm_emit_line("    %dstp_r = getelementptr i8, i8* %buf, i64 %di")
    llvm_emit_line("    call i8* @memcpy(i8* %dstp_r, i8* %new, i64 %new_len)")
    llvm_emit_line("    %si_r = add i64 %si, %old_len")
    llvm_emit_line("    %di_r = add i64 %di, %new_len")
    llvm_emit_line("    br label %copy_next")
    llvm_emit_line("copy_char:")
    llvm_emit_line("    %srcp2 = getelementptr i8, i8* %s, i64 %si")
    llvm_emit_line("    %ch = load i8, i8* %srcp2")
    llvm_emit_line("    %dstp_c = getelementptr i8, i8* %buf, i64 %di")
    llvm_emit_line("    store i8 %ch, i8* %dstp_c")
    llvm_emit_line("    %si_c = add i64 %si, 1")
    llvm_emit_line("    %di_c = add i64 %di, 1")
    llvm_emit_line("    br label %copy_next")
    llvm_emit_line("copy_next:")
    llvm_emit_line("    %si_adv = phi i64 [%si_r, %copy_repl], [%si_c, %copy_char]")
    llvm_emit_line("    %di_adv = phi i64 [%di_r, %copy_repl], [%di_c, %copy_char]")
    llvm_emit_line("    br label %copy_loop")
    llvm_emit_line("done:")
    llvm_emit_line("    %di_final = phi i64 [%di, %copy_loop]")
    llvm_emit_line("    %ep = getelementptr i8, i8* %buf, i64 %di_final")
    llvm_emit_line("    store i8 0, i8* %ep")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("ret_orig:")
    llvm_emit_line("    ret i64 %sp")
    llvm_emit_line("}")
    -- I/O intrinsics (pure IR — no C runtime needed)
    llvm_emit_line("define void @freak_llvm_say(i64 %s) {")
    llvm_emit_line("    %p = inttoptr i64 %s to i8*")
    llvm_emit_line("    call i32 @puts(i8* %p)")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    llvm_emit_line("define void @freak_llvm_print_str(i64 %s) {")
    llvm_emit_line("    %p = inttoptr i64 %s to i8*")
    llvm_emit_line("    %fmt = getelementptr [3 x i8], [3 x i8]* @.fmt_str, i64 0, i64 0")
    llvm_emit_line("    call i32 (i8*, ...) @printf(i8* %fmt, i8* %p)")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    llvm_emit_line("define void @freak_llvm_print_int(i64 %n) {")
    llvm_emit_line("    %fmt = getelementptr [5 x i8], [5 x i8]* @.fmt_int, i64 0, i64 0")
    llvm_emit_line("    call i32 (i8*, ...) @printf(i8* %fmt, i64 %n)")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    llvm_emit_line("define void @freak_llvm_print_newline() {")
    llvm_emit_line("    call i32 @putchar(i32 10)")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    -- ask: still in C runtime (fgets + fflush use opaque FILE* — platform-specific)
    llvm_emit_line("declare i64 @freak_llvm_ask(i64)")
    -- File I/O: FREAK tasks in std/runtime.fk call these i64 wrappers,
    -- which bridge to the actual i8*-typed libc functions.
    llvm_emit_line("declare i8* @fopen(i8*, i8*)")
    llvm_emit_line("declare i32 @fclose(i8*)")
    llvm_emit_line("declare i32 @fseek(i8*, i64, i32)")
    llvm_emit_line("declare i64 @ftell(i8*)")
    llvm_emit_line("declare i64 @fread(i8*, i64, i64, i8*)")
    llvm_emit_line("declare i64 @fwrite(i8*, i64, i64, i8*)")
    llvm_emit_line("declare i32 @remove(i8*)")
    -- freak_fopen: i64 wrapper around fopen
    llvm_emit_line("define i64 @freak_fopen(i64 %path, i64 %mode) {")
    llvm_emit_line("    %p = inttoptr i64 %path to i8*")
    llvm_emit_line("    %m = inttoptr i64 %mode to i8*")
    llvm_emit_line("    %f = call i8* @fopen(i8* %p, i8* %m)")
    llvm_emit_line("    %r = ptrtoint i8* %f to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    -- freak_fclose: i64 wrapper around fclose
    llvm_emit_line("define i64 @freak_fclose(i64 %file) {")
    llvm_emit_line("    %f = inttoptr i64 %file to i8*")
    llvm_emit_line("    %r = call i32 @fclose(i8* %f)")
    llvm_emit_line("    %rr = sext i32 %r to i64")
    llvm_emit_line("    ret i64 %rr")
    llvm_emit_line("}")
    -- freak_fseek: i64 wrapper around fseek
    llvm_emit_line("define i64 @freak_fseek(i64 %file, i64 %offset, i64 %whence) {")
    llvm_emit_line("    %f = inttoptr i64 %file to i8*")
    llvm_emit_line("    %w = trunc i64 %whence to i32")
    llvm_emit_line("    %r = call i32 @fseek(i8* %f, i64 %offset, i32 %w)")
    llvm_emit_line("    %rr = sext i32 %r to i64")
    llvm_emit_line("    ret i64 %rr")
    llvm_emit_line("}")
    -- freak_ftell: i64 wrapper around ftell
    llvm_emit_line("define i64 @freak_ftell(i64 %file) {")
    llvm_emit_line("    %f = inttoptr i64 %file to i8*")
    llvm_emit_line("    %r = call i64 @ftell(i8* %f)")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    -- freak_fread: i64 wrapper around fread
    llvm_emit_line("define i64 @freak_fread(i64 %buf, i64 %size, i64 %count, i64 %file) {")
    llvm_emit_line("    %b = inttoptr i64 %buf to i8*")
    llvm_emit_line("    %f = inttoptr i64 %file to i8*")
    llvm_emit_line("    %r = call i64 @fread(i8* %b, i64 %size, i64 %count, i8* %f)")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    -- freak_fwrite: i64 wrapper around fwrite
    llvm_emit_line("define i64 @freak_fwrite(i64 %buf, i64 %size, i64 %count, i64 %file) {")
    llvm_emit_line("    %b = inttoptr i64 %buf to i8*")
    llvm_emit_line("    %f = inttoptr i64 %file to i8*")
    llvm_emit_line("    %r = call i64 @fwrite(i8* %b, i64 %size, i64 %count, i8* %f)")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    -- freak_calloc: i64 wrapper around calloc (calloc already declared above)
    llvm_emit_line("define i64 @freak_calloc(i64 %count, i64 %size) {")
    llvm_emit_line("    %p = call i8* @calloc(i64 %count, i64 %size)")
    llvm_emit_line("    %r = ptrtoint i8* %p to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    -- freak_remove: i64 wrapper around remove
    llvm_emit_line("define i64 @freak_remove(i64 %path) {")
    llvm_emit_line("    %p = inttoptr i64 %path to i8*")
    llvm_emit_line("    %r = call i32 @remove(i8* %p)")
    llvm_emit_line("    %rr = sext i32 %r to i64")
    llvm_emit_line("    ret i64 %rr")
    llvm_emit_line("}")
    -- Process args intrinsics (pure IR — read from globals)
    llvm_emit_line("define i64 @freak_llvm_process_args_count() {")
    llvm_emit_line("    %c = load i64, i64* @__freak_argc")
    llvm_emit_line("    ret i64 %c")
    llvm_emit_line("}")
    llvm_emit_line("define i64 @freak_llvm_process_arg(i64 %idx) {")
    llvm_emit_line("    %argv_i = load i64, i64* @__freak_argv")
    llvm_emit_line("    %argv_p = inttoptr i64 %argv_i to i8**")
    llvm_emit_line("    %arg_p = getelementptr i8*, i8** %argv_p, i64 %idx")
    llvm_emit_line("    %arg = load i8*, i8** %arg_p")
    llvm_emit_line("    %r = ptrtoint i8* %arg to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    -- process_exit: call exit()
    llvm_emit_line("define void @freak_llvm_process_exit(i64 %code) {")
    llvm_emit_line("    %c = trunc i64 %code to i32")
    llvm_emit_line("    call void @exit(i32 %c)")
    llvm_emit_line("    unreachable")
    llvm_emit_line("}")
    -- process_exec: call system()
    llvm_emit_line("define i64 @freak_llvm_process_exec(i64 %cmdp) {")
    llvm_emit_line("    %cmd = inttoptr i64 %cmdp to i8*")
    llvm_emit_line("    %r = call i32 @system(i8* %cmd)")
    llvm_emit_line("    %r64 = sext i32 %r to i64")
    llvm_emit_line("    ret i64 %r64")
    llvm_emit_line("}")
    -- process_exec_capture stays in C (popen is platform-specific)
    llvm_emit_line("declare i64 @freak_llvm_process_exec_capture(i64)")
    -- Panic: print message + exit(1)
    llvm_emit_line("define void @freak_llvm_panic(i64 %msgp) {")
    llvm_emit_line("    %msg = inttoptr i64 %msgp to i8*")
    llvm_emit_line("    %pfmt = getelementptr [3 x i8], [3 x i8]* @.fmt_str, i64 0, i64 0")
    llvm_emit_line("    call i32 (i8*, ...) @printf(i8* %pfmt, i8* %msg)")
    llvm_emit_line("    call i32 @putchar(i32 10)")
    llvm_emit_line("    call void @exit(i32 1)")
    llvm_emit_line("    unreachable")
    llvm_emit_line("}")
    -- Shape intrinsics (pure IR — struct field access via pointer math)
    llvm_emit_line("define i64 @freak_llvm_shape_alloc(i64 %count) {")
    llvm_emit_line("    %p = call i8* @calloc(i64 %count, i64 8)")
    llvm_emit_line("    %r = ptrtoint i8* %p to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")
    llvm_emit_line("define i64 @freak_llvm_shape_get(i64 %ptr, i64 %idx) {")
    llvm_emit_line("    %base = inttoptr i64 %ptr to i64*")
    llvm_emit_line("    %gep = getelementptr i64, i64* %base, i64 %idx")
    llvm_emit_line("    %val = load i64, i64* %gep")
    llvm_emit_line("    ret i64 %val")
    llvm_emit_line("}")
    llvm_emit_line("define void @freak_llvm_shape_set(i64 %ptr, i64 %idx, i64 %val) {")
    llvm_emit_line("    %base = inttoptr i64 %ptr to i64*")
    llvm_emit_line("    %gep = getelementptr i64, i64* %base, i64 %idx")
    llvm_emit_line("    store i64 %val, i64* %gep")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    -- Setup args intrinsic (stores argc/argv in globals)
    llvm_emit_line("define void @freak_llvm_setup_args(i64 %argc, i64 %argv) {")
    llvm_emit_line("    store i64 %argc, i64* @__freak_argc")
    llvm_emit_line("    store i64 %argv, i64* @__freak_argv")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")

    -- Num (double) intrinsics (pure IR — bitcast between i64 and double)
    llvm_emit_line("define i64 @freak_llvm_int_to_num(i64 %n) {")
    llvm_emit_line("    %d = sitofp i64 %n to double")
    llvm_emit_line("    %bits = bitcast double %d to i64")
    llvm_emit_line("    ret i64 %bits")
    llvm_emit_line("}")
    llvm_emit_line("define i64 @freak_llvm_num_to_int(i64 %bits) {")
    llvm_emit_line("    %d = bitcast i64 %bits to double")
    llvm_emit_line("    %n = fptosi double %d to i64")
    llvm_emit_line("    ret i64 %n")
    llvm_emit_line("}")
    llvm_emit_line("define void @freak_llvm_print_num(i64 %bits) {")
    llvm_emit_line("    %d = bitcast i64 %bits to double")
    llvm_emit_line("    %fmt = getelementptr [3 x i8], [3 x i8]* @.fmt_num, i64 0, i64 0")
    llvm_emit_line("    call i32 (i8*, ...) @printf(i8* %fmt, double %d)")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    -- word_from_num: bitcast i64→double, snprintf %g into malloc'd buffer
    llvm_emit_line("define i64 @freak_llvm_word_from_num(i64 %bits) {")
    llvm_emit_line("    %d = bitcast i64 %bits to double")
    llvm_emit_line("    %buf = call i8* @malloc(i64 32)")
    llvm_emit_line("    %fmt = getelementptr [3 x i8], [3 x i8]* @.fmt_num, i64 0, i64 0")
    llvm_emit_line("    call i32 (i8*, i64, i8*, ...) @snprintf(i8* %buf, i64 32, i8* %fmt, double %d)")
    llvm_emit_line("    %r = ptrtoint i8* %buf to i64")
    llvm_emit_line("    ret i64 %r")
    llvm_emit_line("}")

    -- UI
    llvm_emit_line("declare i64 @freak_llvm_ui_create_native(i64, i64, i64)")
    llvm_emit_line("declare i64 @freak_llvm_ui_poll_events(i64)")
    llvm_emit_line("declare void @freak_llvm_ui_begin_frame(i64)")
    llvm_emit_line("declare void @freak_llvm_ui_end_frame(i64)")
    llvm_emit_line("declare void @freak_llvm_ui_clear(i64, i64, i64, i64, i64)")
    llvm_emit_line("declare void @freak_llvm_ui_fill_rect(i64, i64, i64, i64, i64, i64, i64, i64, i64)")

    -- String comparison: strcmp → -1/0/1
    llvm_emit_line("define i64 @freak_word_compare(i64 %ap, i64 %bp) {")
    llvm_emit_line("    %a = inttoptr i64 %ap to i8*")
    llvm_emit_line("    %b = inttoptr i64 %bp to i8*")
    llvm_emit_line("    %cmp = call i32 @strcmp(i8* %a, i8* %b)")
    llvm_emit_line("    %neg = icmp slt i32 %cmp, 0")
    llvm_emit_line("    br i1 %neg, label %ret_neg, label %check_pos")
    llvm_emit_line("ret_neg:")
    llvm_emit_line("    ret i64 -1")
    llvm_emit_line("check_pos:")
    llvm_emit_line("    %pos = icmp sgt i32 %cmp, 0")
    llvm_emit_line("    br i1 %pos, label %ret_pos, label %ret_zero")
    llvm_emit_line("ret_pos:")
    llvm_emit_line("    ret i64 1")
    llvm_emit_line("ret_zero:")
    llvm_emit_line("    ret i64 0")
    llvm_emit_line("}")

    -- Dynamic arrays — pure LLVM IR (pool of 256 arrays)
    -- Each array slot: { i64* data, i64 length, i64 capacity }
    llvm_emit_line("%freak_dyn_array = type { i64*, i64, i64 }")
    llvm_emit_line("@__freak_array_pool = internal global [256 x %freak_dyn_array] zeroinitializer")
    llvm_emit_line("@__freak_array_count = internal global i64 0")
    -- freak_array_new: allocate a new array slot, malloc initial capacity 64
    llvm_emit_line("define i64 @freak_array_new() {")
    llvm_emit_line("    %idx = load i64, i64* @__freak_array_count")
    llvm_emit_line("    %next = add i64 %idx, 1")
    llvm_emit_line("    store i64 %next, i64* @__freak_array_count")
    llvm_emit_line("    %data = call i8* @malloc(i64 512)")
    llvm_emit_line("    %dp = bitcast i8* %data to i64*")
    llvm_emit_line("    %slot = getelementptr [256 x %freak_dyn_array], [256 x %freak_dyn_array]* @__freak_array_pool, i64 0, i64 %idx")
    llvm_emit_line("    %data_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 0")
    llvm_emit_line("    store i64* %dp, i64** %data_p")
    llvm_emit_line("    %len_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 1")
    llvm_emit_line("    store i64 0, i64* %len_p")
    llvm_emit_line("    %cap_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 2")
    llvm_emit_line("    store i64 64, i64* %cap_p")
    llvm_emit_line("    ret i64 %idx")
    llvm_emit_line("}")
    -- freak_array_push: append item, grow if needed
    llvm_emit_line("define void @freak_array_push(i64 %handle, i64 %item) {")
    llvm_emit_line("    %slot = getelementptr [256 x %freak_dyn_array], [256 x %freak_dyn_array]* @__freak_array_pool, i64 0, i64 %handle")
    llvm_emit_line("    %len_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 1")
    llvm_emit_line("    %len = load i64, i64* %len_p")
    llvm_emit_line("    %cap_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 2")
    llvm_emit_line("    %cap = load i64, i64* %cap_p")
    llvm_emit_line("    %need_grow = icmp sge i64 %len, %cap")
    llvm_emit_line("    br i1 %need_grow, label %grow, label %store_item")
    llvm_emit_line("grow:")
    llvm_emit_line("    %new_cap = mul i64 %cap, 2")
    llvm_emit_line("    store i64 %new_cap, i64* %cap_p")
    llvm_emit_line("    %data_p1 = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 0")
    llvm_emit_line("    %old_data = load i64*, i64** %data_p1")
    llvm_emit_line("    %old_raw = bitcast i64* %old_data to i8*")
    llvm_emit_line("    %new_bytes = mul i64 %new_cap, 8")
    llvm_emit_line("    %new_raw = call i8* @realloc(i8* %old_raw, i64 %new_bytes)")
    llvm_emit_line("    %new_data = bitcast i8* %new_raw to i64*")
    llvm_emit_line("    store i64* %new_data, i64** %data_p1")
    llvm_emit_line("    br label %store_item")
    llvm_emit_line("store_item:")
    llvm_emit_line("    %data_p2 = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 0")
    llvm_emit_line("    %data2 = load i64*, i64** %data_p2")
    llvm_emit_line("    %elem_p = getelementptr i64, i64* %data2, i64 %len")
    llvm_emit_line("    store i64 %item, i64* %elem_p")
    llvm_emit_line("    %new_len = add i64 %len, 1")
    llvm_emit_line("    store i64 %new_len, i64* %len_p")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")
    -- freak_array_get: return item at index (or empty string ptr if out of bounds)
    llvm_emit_line("define i64 @freak_array_get(i64 %handle, i64 %index) {")
    llvm_emit_line("    %slot = getelementptr [256 x %freak_dyn_array], [256 x %freak_dyn_array]* @__freak_array_pool, i64 0, i64 %handle")
    llvm_emit_line("    %len_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 1")
    llvm_emit_line("    %len = load i64, i64* %len_p")
    llvm_emit_line("    %oob = icmp sge i64 %index, %len")
    llvm_emit_line("    br i1 %oob, label %out_of_bounds, label %in_bounds")
    llvm_emit_line("in_bounds:")
    llvm_emit_line("    %data_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 0")
    llvm_emit_line("    %data = load i64*, i64** %data_p")
    llvm_emit_line("    %elem_p = getelementptr i64, i64* %data, i64 %index")
    llvm_emit_line("    %val = load i64, i64* %elem_p")
    llvm_emit_line("    ret i64 %val")
    llvm_emit_line("out_of_bounds:")
    llvm_emit_line("    %empty = getelementptr [1 x i8], [1 x i8]* @.str_empty, i64 0, i64 0")
    llvm_emit_line("    %er = ptrtoint i8* %empty to i64")
    llvm_emit_line("    ret i64 %er")
    llvm_emit_line("}")
    -- freak_array_len: return length of array
    llvm_emit_line("define i64 @freak_array_len(i64 %handle) {")
    llvm_emit_line("    %slot = getelementptr [256 x %freak_dyn_array], [256 x %freak_dyn_array]* @__freak_array_pool, i64 0, i64 %handle")
    llvm_emit_line("    %len_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 1")
    llvm_emit_line("    %len = load i64, i64* %len_p")
    llvm_emit_line("    ret i64 %len")
    llvm_emit_line("}")
    -- freak_array_set: set item at index (no-op if out of bounds)
    llvm_emit_line("define void @freak_array_set(i64 %handle, i64 %index, i64 %item) {")
    llvm_emit_line("    %slot = getelementptr [256 x %freak_dyn_array], [256 x %freak_dyn_array]* @__freak_array_pool, i64 0, i64 %handle")
    llvm_emit_line("    %len_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 1")
    llvm_emit_line("    %len = load i64, i64* %len_p")
    llvm_emit_line("    %oob = icmp sge i64 %index, %len")
    llvm_emit_line("    br i1 %oob, label %skip, label %do_set")
    llvm_emit_line("do_set:")
    llvm_emit_line("    %data_p = getelementptr %freak_dyn_array, %freak_dyn_array* %slot, i32 0, i32 0")
    llvm_emit_line("    %data = load i64*, i64** %data_p")
    llvm_emit_line("    %elem_p = getelementptr i64, i64* %data, i64 %index")
    llvm_emit_line("    store i64 %item, i64* %elem_p")
    llvm_emit_line("    ret void")
    llvm_emit_line("skip:")
    llvm_emit_line("    ret void")
    llvm_emit_line("}")

    -- TCP sockets
    llvm_emit_line("declare i64 @freak_llvm_tcp_connect(i64, i64)")
    llvm_emit_line("declare i64 @freak_llvm_tcp_send(i64, i64)")
    llvm_emit_line("declare i64 @freak_llvm_tcp_recv(i64, i64)")
    llvm_emit_line("declare i64 @freak_llvm_tcp_recv_all(i64, i64)")
    llvm_emit_line("declare void @freak_llvm_tcp_close(i64)")

    -- Track all runtime function names so extern decls don't duplicate them
    llvm_declared_funcs = "|puts|printf|strlen|freak_word_from_int|freak_word_from_bool|freak_word_concat|freak_word_eq|freak_word_neq|freak_llvm_word_eq|freak_llvm_word_neq|freak_word_length|freak_word_char_at|freak_word_contains|freak_word_starts_with|freak_word_ends_with|freak_word_to_upper|freak_word_to_lower|freak_word_trim|freak_word_replace|freak_word_to_int|freak_llvm_say|freak_llvm_print_str|freak_llvm_print_int|freak_llvm_print_newline|freak_llvm_ask|freak_llvm_process_args_count|freak_llvm_process_arg|freak_llvm_process_exit|freak_llvm_process_exec|freak_llvm_process_exec_capture|freak_llvm_panic|freak_llvm_shape_alloc|freak_llvm_shape_get|freak_llvm_shape_set|freak_llvm_setup_args|freak_llvm_word_from_num|freak_llvm_print_num|freak_llvm_int_to_num|freak_llvm_num_to_int|freak_llvm_ui_create_native|freak_llvm_ui_poll_events|freak_llvm_ui_begin_frame|freak_llvm_ui_end_frame|freak_llvm_ui_clear|freak_llvm_ui_fill_rect|freak_array_new|freak_array_push|freak_array_get|freak_array_len|freak_array_set|freak_word_compare|freak_llvm_tcp_connect|freak_llvm_tcp_send|freak_llvm_tcp_recv|freak_llvm_tcp_recv_all|freak_llvm_tcp_close|fopen|fclose|fseek|ftell|fread|fwrite|calloc|remove|freak_fopen|freak_fclose|freak_fseek|freak_ftell|freak_fread|freak_fwrite|freak_calloc|freak_remove|freak_word_length|"
}

task llvm_is_runtime_func(fname: word) -> bool {
    pilot needle = "|" + fname + "|"
    give back llvm_declared_funcs.contains(needle)
}

task llvm_is_global(vname: word) -> bool {
    pilot needle = "|" + vname + "|"
    give back llvm_global_names.contains(needle)
}

task llvm_var_ptr(vname: word) -> word {
    if llvm_is_global(vname) {
        give back "@g_" + vname
    }
    pilot ir_name = llvm_resolve_local(vname)
    give back "%" + ir_name
}

-- Check if a string value contains interpolation placeholders
task llvm_str_has_interp(val: word) -> bool {
    pilot slen = val.length()
    pilot i = 0
    repeat slen times {
        if val.char_at(i) == "{" {
            give back true
        }
        i += 1
    }
    give back false
}

-- Emit say for an interpolated string:
-- Uses a single-loop state machine with `in_var` flag.
-- Literal segments -> freak_llvm_print_str
-- {varname} segments -> freak_llvm_print_int (loads variable from stack)
-- Final -> freak_llvm_print_newline
task llvm_emit_say_interp(val: word) -> void {
    pilot slen = val.length()
    pilot i = 0
    pilot buf = ""
    pilot vname = ""
    pilot in_var = false

    repeat until i >= slen {
        pilot c = val.char_at(i)
        if in_var {
            if c == "}" {
                -- Check if vname contains a dot (field access like p.x)
                pilot has_dot = false
                pilot dot_pos = 0
                pilot vi = 0
                pilot vnamelen = vname.length()
                repeat vnamelen times {
                    if vname.char_at(vi) == "." { has_dot = true  dot_pos = vi }
                    vi += 1
                }
                if has_dot {
                    -- Split: obj_name = before dot, field_name = after dot
                    pilot obj_name = ""
                    pilot field_nm = ""
                    pilot si = 0
                    repeat vnamelen times {
                        if si < dot_pos { obj_name = obj_name + vname.char_at(si) }
                        if si > dot_pos { field_nm = field_nm + vname.char_at(si) }
                        si += 1
                    }
                    -- Load the object pointer
                    pilot obj_reg = next_reg()
                    llvm_emit_line("    " + obj_reg + " = load i64, i64* " + llvm_var_ptr(obj_name))
                    -- Get field index
                    pilot fidx = 0 - 1
                    pilot sri = 0
                    repeat shape_registry_count times {
                        pilot tmpidx = get_shape_field_index("" + array_get(shape_registry_names, sri), field_nm)
                        if tmpidx >= 0 { fidx = tmpidx }
                        sri += 1
                    }
                    if fidx < 0 { fidx = 0 }
                    pilot field_reg = next_reg()
                    llvm_emit_line("    " + field_reg + " = call i64 @freak_llvm_shape_get(i64 " + obj_reg + ", i64 " + word_from_int(fidx) + ")")
                    -- Determine field type from shape registry
                    pilot ftype = "int"
                    pilot fsi = 0
                    repeat shape_registry_count times {
                        pilot flds: word = array_get(shape_registry_fields, fsi)
                        pilot ftidx = get_shape_field_index(array_get(shape_registry_names, fsi), field_nm)
                        if ftidx >= 0 {
                            -- Parse field type from "x:num,y:num" at index ftidx
                            pilot fc = 0
                            pilot fci = 0
                            pilot fclen = flds.length()
                            pilot cur_ftype = ""
                            pilot in_ftype = false
                            repeat fclen times {
                                pilot fch = flds.char_at(fci)
                                if fch == "," {
                                    if fc == ftidx { ftype = cur_ftype }
                                    fc += 1
                                    cur_ftype = ""
                                    in_ftype = false
                                } else if fch == ":" {
                                    in_ftype = true
                                } else {
                                    if in_ftype { cur_ftype = cur_ftype + fch }
                                }
                                fci += 1
                            }
                            if fc == ftidx { ftype = cur_ftype }
                        }
                        fsi += 1
                    }
                    if ftype == "num" or ftype == "float" {
                        llvm_emit_line("    call void @freak_llvm_print_num(i64 " + field_reg + ")")
                    } else if ftype == "word" {
                        llvm_emit_line("    call void @freak_llvm_print_str(i64 " + field_reg + ")")
                    } else {
                        llvm_emit_line("    call void @freak_llvm_print_int(i64 " + field_reg + ")")
                    }
                } else {
                    -- Regular variable interpolation
                    pilot var_reg = next_reg()
                    llvm_emit_line("    " + var_reg + " = load i64, i64* " + llvm_var_ptr(vname))
                    pilot var_type = llvm_get_var_type(vname)
                    if var_type.starts_with("w") {
                        llvm_emit_line("    call void @freak_llvm_print_str(i64 " + var_reg + ")")
                    } else if var_type.starts_with("n") {
                        llvm_emit_line("    call void @freak_llvm_print_num(i64 " + var_reg + ")")
                    } else {
                        llvm_emit_line("    call void @freak_llvm_print_int(i64 " + var_reg + ")")
                    }
                }
                vname = ""
                in_var = false
            } else {
                vname = vname + c
            }
        } else {
            if c == "{" {
                -- Flush buffered literal text
                if buf.length() > 0 {
                    pilot lit_id = register_string_literal(buf)
                    pilot lit_len = buf.length() + 1
                    pilot gep = next_reg()
                    llvm_emit_line("    " + gep + " = getelementptr inbounds [" + word_from_int(lit_len) + " x i8], [" + word_from_int(lit_len) + " x i8]* " + lit_id + ", i64 0, i64 0")
                    pilot ptr = next_reg()
                    llvm_emit_line("    " + ptr + " = ptrtoint i8* " + gep + " to i64")
                    llvm_emit_line("    call void @freak_llvm_print_str(i64 " + ptr + ")")
                    buf = ""
                }
                in_var = true
            } else {
                buf = buf + c
            }
        }
        i += 1
    }

    -- Flush remaining literal text
    if buf.length() > 0 {
        pilot lit_id = register_string_literal(buf)
        pilot lit_len = buf.length() + 1
        pilot gep = next_reg()
        llvm_emit_line("    " + gep + " = getelementptr inbounds [" + word_from_int(lit_len) + " x i8], [" + word_from_int(lit_len) + " x i8]* " + lit_id + ", i64 0, i64 0")
        pilot ptr = next_reg()
        llvm_emit_line("    " + ptr + " = ptrtoint i8* " + gep + " to i64")
        llvm_emit_line("    call void @freak_llvm_print_str(i64 " + ptr + ")")
    }
    -- Print newline at the end
    llvm_emit_line("    call void @freak_llvm_print_newline()")
}

task llvm_emit_args(args: word) -> word {
    pilot res = ""
    pilot i = 0
    pilot slen = args.length()
    pilot cur_id = ""
    pilot first = true
    repeat slen times {
        pilot c = args.char_at(i)
        if c == "," {
            pilot reg: word = llvm_emit_expr(cur_id)
            if not first { res = res + ", " }
            res = res + "i64 " + reg
            cur_id = ""
            first = false
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id.length() > 0 {
        pilot reg: word = llvm_emit_expr(cur_id)
        if not first { res = res + ", " }
        res = res + "i64 " + reg
    }
    give back res
}

-- ===================== NUM HELPERS =================================
-- Bitcast i64 → double, return the double register name
task llvm_i64_to_double(i64_reg: word) -> word {
    pilot dbl = next_reg()
    llvm_emit_line("    " + dbl + " = bitcast i64 " + i64_reg + " to double")
    give back dbl
}

-- Bitcast double → i64, return the i64 register name
task llvm_double_to_i64(dbl_reg: word) -> word {
    pilot i64r = next_reg()
    llvm_emit_line("    " + i64r + " = bitcast double " + dbl_reg + " to i64")
    give back i64r
}

-- Check if an expression (by id string) infers to num type
task llvm_is_num_expr(expr_id: word) -> bool {
    pilot t = llvm_infer_expr_type(expr_id)
    if t.starts_with("n") { give back true }
    give back false
}

-- ===================== EXPRESSIONS =================================

-- Emit an expression and return the register that holds the result
-- We return a string like "%t0"
task llvm_emit_expr(id: word) -> word {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)
    pilot left: word = array_get(ast_expr_lefts, i)
    pilot right: word = array_get(ast_expr_rights, i)

    if kind == EXPR_INT {
        give back val
    }

    if kind == EXPR_BOOL {
        if val == "true" { give back "1" }
        give back "0"
    }

    if kind == EXPR_FLOAT {
        -- Store double as i64 via bitcast: bitcast double <val> to i64
        pilot dbl_reg = next_reg()
        pilot cast_reg = next_reg()
        llvm_emit_line("    " + dbl_reg + " = fadd double 0.0, " + val)
        llvm_emit_line("    " + cast_reg + " = bitcast double " + dbl_reg + " to i64")
        give back cast_reg
    }

    if kind == EXPR_STR {
        pilot str_id = register_string_literal(val)
        -- Use real length (after unescaping pipe placeholders)
        pilot len = val.replace("<<PIPE>>", "|").length() + 1
        pilot get_ptr = next_reg()
        llvm_emit_line("    " + get_ptr + " = getelementptr inbounds [" + word_from_int(len) + " x i8], [" + word_from_int(len) + " x i8]* " + str_id + ", i64 0, i64 0")
        pilot cast_reg = next_reg()
        llvm_emit_line("    " + cast_reg + " = ptrtoint i8* " + get_ptr + " to i64")
        give back cast_reg
    }

    if kind == EXPR_IDENT {
        pilot res_reg = next_reg()
        llvm_emit_line("    " + res_reg + " = load i64, i64* " + llvm_var_ptr(val))
        give back res_reg
    }

    if kind == EXPR_CALL {
        pilot arg_str = ""
        if left.length() > 0 { arg_str = llvm_emit_args(left) }

        pilot func_name = "@freak_" + llvm_c_safe_ident(val)
        -- Extern functions: use name directly without freak_ prefix
        if emt_is_extern(val) {
            func_name = "@" + llvm_c_safe_ident(val)
        }
        pilot is_void_call = false

        -- Shape constructor: shape::ctor::Name with field value expr IDs in left
        if val.starts_with("shape::ctor::") {
            -- Extract shape name from val (after "shape::ctor::")
            pilot sname = ""
            pilot vi = 13
            pilot vlen = val.length()
            repeat vlen times {
                if vi < vlen {
                    sname = sname + val.char_at(vi)
                }
                vi += 1
            }
            pilot fcount = get_shape_field_count(sname)
            -- Allocate the shape
            pilot alloc_reg = next_reg()
            llvm_emit_line("    " + alloc_reg + " = call i64 @freak_llvm_shape_alloc(i64 " + word_from_int(fcount) + ")")
            -- Set each field value
            if left.length() > 0 {
                pilot fi = 0
                pilot ci = 0
                pilot cslen = left.length()
                pilot cur = ""
                repeat cslen times {
                    pilot cc = left.char_at(ci)
                    if cc == "," {
                        if cur.length() > 0 {
                            pilot fval_reg = llvm_emit_expr(cur)
                            llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + alloc_reg + ", i64 " + word_from_int(fi) + ", i64 " + fval_reg + ")")
                            fi += 1
                        }
                        cur = ""
                    } else {
                        cur = cur + cc
                    }
                    ci += 1
                }
                if cur.length() > 0 {
                    pilot fval_reg = llvm_emit_expr(cur)
                    llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + alloc_reg + ", i64 " + word_from_int(fi) + ", i64 " + fval_reg + ")")
                }
            }
            give back alloc_reg
        }

        if val == "say" {
             func_name = "@freak_llvm_say"
             is_void_call = true
        } else if val == "word_from_int" {
             func_name = "@freak_word_from_int"
        } else if val == "word_from_bool" {
             func_name = "@freak_word_from_bool"
        } else if val == "fs::read" {
             func_name = "@freak_llvm_fs_read"
        } else if val == "fs::write" {
             func_name = "@freak_llvm_fs_write"
             is_void_call = true
        } else if val == "fs::append" {
             func_name = "@freak_llvm_fs_append"
             is_void_call = true
        } else if val == "fs::exists" {
             func_name = "@freak_llvm_fs_exists"
        } else if val == "fs::delete" {
             func_name = "@freak_llvm_fs_delete"
             is_void_call = true
        } else if val == "process::args_count" {
             func_name = "@freak_llvm_process_args_count"
        } else if val == "process::arg" {
             func_name = "@freak_llvm_process_arg"
        } else if val == "process::exit" {
             func_name = "@freak_llvm_process_exit"
             is_void_call = true
        } else if val == "process::exec" {
             func_name = "@freak_llvm_process_exec"
        } else if val == "process::exec_capture" {
             func_name = "@freak_llvm_process_exec_capture"
        } else if val == "ask" {
             func_name = "@freak_llvm_ask"
        } else if val == "panic" {
             func_name = "@freak_llvm_panic"
             is_void_call = true
        } else if val == "shape::alloc" {
             func_name = "@freak_llvm_shape_alloc"
        } else if val == "shape::get" {
             func_name = "@freak_llvm_shape_get"
        } else if val == "shape::set" {
             func_name = "@freak_llvm_shape_set"
             is_void_call = true
        } else if val == "ui::create_native" {
             func_name = "@freak_llvm_ui_create_native"
        } else if val == "ui::poll_events" {
             func_name = "@freak_llvm_ui_poll_events"
        } else if val == "ui::begin_frame" {
             func_name = "@freak_llvm_ui_begin_frame"
             is_void_call = true
        } else if val == "ui::end_frame" {
             func_name = "@freak_llvm_ui_end_frame"
             is_void_call = true
        } else if val == "ui::clear" {
             func_name = "@freak_llvm_ui_clear"
             is_void_call = true
        } else if val == "ui::fill_rect" {
             func_name = "@freak_llvm_ui_fill_rect"
             is_void_call = true
        } else if val == "array_push" {
             func_name = "@freak_array_push"
             is_void_call = true
        } else if val == "array_set" {
             func_name = "@freak_array_set"
             is_void_call = true
        } else if val == "array_new" {
             func_name = "@freak_array_new"
        } else if val == "array_get" {
             func_name = "@freak_array_get"
        } else if val == "array_len" {
             func_name = "@freak_array_len"
        } else if val == "tcp_connect" {
             func_name = "@freak_llvm_tcp_connect"
        } else if val == "tcp_send" {
             func_name = "@freak_llvm_tcp_send"
        } else if val == "tcp_recv" {
             func_name = "@freak_llvm_tcp_recv"
        } else if val == "tcp_recv_all" {
             func_name = "@freak_llvm_tcp_recv_all"
        } else if val == "tcp_close" {
             func_name = "@freak_llvm_tcp_close"
             is_void_call = true
        }
        -- Check task registry for user-defined void functions
        if not is_void_call {
            pilot call_ret: word = llvm_get_task_ret_type(val)
            if call_ret == "v" { is_void_call = true }
        }
        if is_void_call {
            llvm_emit_line("    call void " + func_name + "(" + arg_str + ")")
            give back "0"
        }
        pilot res_reg = next_reg()
        llvm_emit_line("    " + res_reg + " = call i64 " + func_name + "(" + arg_str + ")")
        give back res_reg
    }

    if kind == EXPR_BINOP {
        pilot l_reg = llvm_emit_expr(left)
        pilot r_reg = llvm_emit_expr(right)
        pilot res_reg = next_reg()

        -- Check if this is a num (double) operation
        pilot is_num_op = llvm_is_num_expr(left) or llvm_is_num_expr(right)

        if val == "+" {
            pilot vtype = llvm_infer_expr_type(id)
            if vtype.starts_with("w") {
                -- Ensure both operands are words for concat
                pilot lt: word = llvm_infer_expr_type(left)
                pilot rt: word = llvm_infer_expr_type(right)
                pilot lw = l_reg
                pilot rw = r_reg
                if not lt.starts_with("w") {
                    lw = next_reg()
                    llvm_emit_line("    " + lw + " = call i64 @freak_word_from_int(i64 " + l_reg + ")")
                }
                if not rt.starts_with("w") {
                    rw = next_reg()
                    llvm_emit_line("    " + rw + " = call i64 @freak_word_from_int(i64 " + r_reg + ")")
                }
                llvm_emit_line("    " + res_reg + " = call i64 @freak_word_concat(i64 " + lw + ", i64 " + rw + ")")
            } else if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot dres = next_reg()
                llvm_emit_line("    " + dres + " = fadd double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
            } else {
                llvm_emit_line("    " + res_reg + " = add i64 " + l_reg + ", " + r_reg)
            }
        } else if val == "-" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot dres = next_reg()
                llvm_emit_line("    " + dres + " = fsub double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
            } else {
                llvm_emit_line("    " + res_reg + " = sub i64 " + l_reg + ", " + r_reg)
            }
        } else if val == "*" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot dres = next_reg()
                llvm_emit_line("    " + dres + " = fmul double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
            } else {
                llvm_emit_line("    " + res_reg + " = mul i64 " + l_reg + ", " + r_reg)
            }
        } else if val == "/" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot dres = next_reg()
                llvm_emit_line("    " + dres + " = fdiv double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
            } else {
                llvm_emit_line("    " + res_reg + " = sdiv i64 " + l_reg + ", " + r_reg)
            }
        } else if val == "%" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot dres = next_reg()
                llvm_emit_line("    " + dres + " = frem double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
            } else {
                llvm_emit_line("    " + res_reg + " = srem i64 " + l_reg + ", " + r_reg)
            }
        } else if val == "==" {
            pilot ltype = llvm_infer_expr_type(left)
            if ltype.starts_with("w") {
                llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_eq(i64 " + l_reg + ", i64 " + r_reg + ")")
            } else if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = fcmp oeq double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            } else {
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + l_reg + ", " + r_reg)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            }
        } else if val == "!=" {
            pilot ltype = llvm_infer_expr_type(left)
            if ltype.starts_with("w") {
                llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_neq(i64 " + l_reg + ", i64 " + r_reg + ")")
            } else if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = fcmp une double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            } else {
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = icmp ne i64 " + l_reg + ", " + r_reg)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            }
        } else if val == "<" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = fcmp olt double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            } else {
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = icmp slt i64 " + l_reg + ", " + r_reg)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            }
        } else if val == ">" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = fcmp ogt double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            } else {
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = icmp sgt i64 " + l_reg + ", " + r_reg)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            }
        } else if val == "<=" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = fcmp ole double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            } else {
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = icmp sle i64 " + l_reg + ", " + r_reg)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            }
        } else if val == ">=" {
            if is_num_op {
                pilot ld = llvm_i64_to_double(l_reg)
                pilot rd = llvm_i64_to_double(r_reg)
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = fcmp oge double " + ld + ", " + rd)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            } else {
                pilot cmp_reg = next_reg()
                llvm_emit_line("    " + cmp_reg + " = icmp sge i64 " + l_reg + ", " + r_reg)
                llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
            }
        } else if val == "and" {
            pilot cmp_l = next_reg()
            llvm_emit_line("    " + cmp_l + " = icmp ne i64 " + l_reg + ", 0")
            pilot cmp_r = next_reg()
            llvm_emit_line("    " + cmp_r + " = icmp ne i64 " + r_reg + ", 0")
            pilot and_res = next_reg()
            llvm_emit_line("    " + and_res + " = and i1 " + cmp_l + ", " + cmp_r)
            llvm_emit_line("    " + res_reg + " = zext i1 " + and_res + " to i64")
        } else if val == "or" {
            pilot cmp_l = next_reg()
            llvm_emit_line("    " + cmp_l + " = icmp ne i64 " + l_reg + ", 0")
            pilot cmp_r = next_reg()
            llvm_emit_line("    " + cmp_r + " = icmp ne i64 " + r_reg + ", 0")
            pilot or_res = next_reg()
            llvm_emit_line("    " + or_res + " = or i1 " + cmp_l + ", " + cmp_r)
            llvm_emit_line("    " + res_reg + " = zext i1 " + or_res + " to i64")
        } else if val == "NAKAMA" {
            -- left + right + (left * right / 10)
            pilot t1 = next_reg()
            llvm_emit_line("    " + t1 + " = add i64 " + l_reg + ", " + r_reg)
            pilot t2 = next_reg()
            llvm_emit_line("    " + t2 + " = mul i64 " + l_reg + ", " + r_reg)
            pilot t3 = next_reg()
            llvm_emit_line("    " + t3 + " = sdiv i64 " + t2 + ", 10")
            llvm_emit_line("    " + res_reg + " = add i64 " + t1 + ", " + t3)
        }

        give back res_reg
    }

    if kind == EXPR_UNARYOP {
        pilot op_reg = llvm_emit_expr(left)
        pilot res_reg = next_reg()

        if val == "not" {
            pilot cmp_reg = next_reg()
            llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + op_reg + ", 0")
            llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
        } else if val == "-" {
            llvm_emit_line("    " + res_reg + " = sub i64 0, " + op_reg)
        } else if val == "PLUS ULTRA" {
            llvm_emit_line("    " + res_reg + " = mul i64 " + op_reg + ", 2")
        } else if val == "FINAL FORM" {
            llvm_emit_line("    " + res_reg + " = mul i64 " + op_reg + ", " + op_reg)
        } else if val == "TSUNDERE" {
            llvm_emit_line("    " + res_reg + " = sub i64 0, " + op_reg)
        }

        give back res_reg
    }

    if kind == EXPR_METHOD {
        pilot obj_reg = llvm_emit_expr(left)
        pilot res_reg = next_reg()
        if val == "length" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_length(i64 " + obj_reg + ")")
        } else if val == "char_at" {
            pilot arg_reg = llvm_emit_expr(right)
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_char_at(i64 " + obj_reg + ", i64 " + arg_reg + ")")
        } else if val == "contains" {
            pilot arg_reg = llvm_emit_expr(right)
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_contains(i64 " + obj_reg + ", i64 " + arg_reg + ")")
        } else if val == "starts_with" {
            pilot arg_reg = llvm_emit_expr(right)
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_starts_with(i64 " + obj_reg + ", i64 " + arg_reg + ")")
        } else if val == "ends_with" {
            pilot arg_reg = llvm_emit_expr(right)
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_ends_with(i64 " + obj_reg + ", i64 " + arg_reg + ")")
        } else if val == "to_upper" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_to_upper(i64 " + obj_reg + ")")
        } else if val == "to_lower" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_to_lower(i64 " + obj_reg + ")")
        } else if val == "trim" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_trim(i64 " + obj_reg + ")")
        } else if val == "replace" {
            -- replace has 2 args: old_str, new_str — encoded as comma-separated expr IDs in right
            pilot args_str = llvm_emit_args(right)
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_replace(i64 " + obj_reg + ", " + args_str + ")")
        } else if val == "to_int" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_word_to_int(i64 " + obj_reg + ")")
        } else {
            -- Try user-defined impl method: look up ShapeName_method
            -- The object is passed as the first arg (self)
            pilot found_impl = false
            pilot si = 0
            repeat shape_registry_count times {
                pilot sname: word = "" + array_get(shape_registry_names, si)
                pilot impl_fname = "freak_" + sname + "_" + val
                -- Check if this function exists in our task registry
                pilot call_ret: word = llvm_get_task_ret_type(sname + "_" + val)
                if call_ret.length() > 0 {
                    found_impl = true
                    if call_ret == "v" {
                        llvm_emit_line("    call void @" + impl_fname + "(i64 " + obj_reg + ")")
                        llvm_emit_line("    " + res_reg + " = add i64 0, 0")
                    } else {
                        llvm_emit_line("    " + res_reg + " = call i64 @" + impl_fname + "(i64 " + obj_reg + ")")
                    }
                }
                si += 1
            }
            if not found_impl {
                llvm_emit_line("    ; unsupported method " + val)
                llvm_emit_line("    " + res_reg + " = add i64 0, 0")
            }
        }
        give back res_reg
    }

    if kind == EXPR_FIELD {
        -- Field access: obj.field_name
        -- val = field name, left = object expression
        pilot obj_reg = llvm_emit_expr(left)
        -- We need to figure out the object's shape type to get the field index
        -- For now, look up the field name across all registered shapes
        pilot fidx = 0 - 1
        pilot si = 0
        repeat shape_registry_count times {
            pilot tmpidx = get_shape_field_index(array_get(shape_registry_names, si), val)
            if tmpidx >= 0 { fidx = tmpidx }
            si += 1
        }
        if fidx < 0 { fidx = 0 }
        pilot idx_val = word_from_int(fidx)
        pilot res_reg = next_reg()
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_shape_get(i64 " + obj_reg + ", i64 " + idx_val + ")")
        give back res_reg
    }

    if kind == EXPR_INDEX {
        pilot obj_reg = llvm_emit_expr(left)
        pilot idx_reg = llvm_emit_expr(right)
        pilot res_reg = next_reg()
        pilot ptr_reg = next_reg()
        llvm_emit_line("    " + ptr_reg + " = inttoptr i64 " + obj_reg + " to i8*")
        pilot gep_reg = next_reg()
        llvm_emit_line("    " + gep_reg + " = getelementptr inbounds i8, i8* " + ptr_reg + ", i64 " + idx_reg)
        pilot char_reg = next_reg()
        llvm_emit_line("    " + char_reg + " = load i8, i8* " + gep_reg)
        llvm_emit_line("    " + res_reg + " = zext i8 " + char_reg + " to i64")
        give back res_reg
    }

    give back "0"
}

task llvm_emit_block(block: word) -> void {
    pilot i = 0
    pilot fin = false
    pilot slen = block.length()
    pilot cur_id = ""
    repeat slen times {
        if not fin {
            pilot c = block.char_at(i)
            if c == "," {
                if cur_id.length() > 0 {
                    llvm_emit_stmt(cur_id)
                }
                cur_id = ""
            } else {
                cur_id = cur_id + c
            }
        }
        i += 1
    }
    if cur_id.length() > 0 {
        llvm_emit_stmt(cur_id)
    }
}

-- ===================== STATEMENTS ==================================

task llvm_emit_stmt(eid: word) -> void {
    if eid.length() == 0 { give back }

    pilot i = word_to_int(eid)
    pilot kind: word = array_get(ast_stmt_kinds, i)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    if kind == STMT_PILOT {
        -- Use explicit type annotation if available, otherwise infer
        pilot type_ann: word = array_get(ast_stmt_extras, i)
        pilot vtype = ""
        if type_ann == "word" { vtype = "w" }
        else if type_ann == "num" { vtype = "n" }
        else if type_ann == "bool" { vtype = "b" }
        else if type_ann == "int" { vtype = "i" }
        else { vtype = llvm_infer_expr_type(expr_id_w) }
        llvm_set_var_type(name_w, vtype)
        -- Emit the expression (BINOP "+" on words already produces concat via llvm_emit_expr)
        pilot reg = llvm_emit_expr(expr_id_w)
        -- Globals already have @g_ declarations, just store
        if llvm_is_global(name_w) {
            llvm_emit_line("    store i64 " + reg + ", i64* @g_" + name_w)
        } else {
            pilot ir_name = llvm_register_local(name_w)
            llvm_emit_line("    %" + ir_name + " = alloca i64")
            llvm_emit_line("    store i64 " + reg + ", i64* %" + ir_name)
        }
    } else if kind == STMT_SAY {
        -- Check if the expression is an interpolated string
        pilot say_expr_kind: word = array_get(ast_expr_kinds, word_to_int(expr_id_w))
        pilot say_expr_val: word = array_get(ast_expr_vals, word_to_int(expr_id_w))
        if say_expr_kind == EXPR_STR and llvm_str_has_interp(say_expr_val) {
            llvm_emit_say_interp(say_expr_val)
        } else {
            pilot reg = llvm_emit_expr(expr_id_w)
            llvm_emit_line("    call void @freak_llvm_say(i64 " + reg + ")")
        }
    } else if kind == STMT_EXPR {
        llvm_emit_expr(expr_id_w)
    } else if kind == STMT_GIVE_BACK {
        if llvm_cur_func_is_void {
            llvm_emit_line("    ret void")
        } else if expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            pilot reg = llvm_emit_expr(expr_id_w)
            llvm_emit_line("    ret i64 " + reg)
        } else {
            llvm_emit_line("    ret i64 0")
        }
    } else if kind == STMT_IF {
        pilot cond_reg = llvm_emit_expr(expr_id_w)
        pilot l_then = "if.then." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot l_else = "if.else." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot l_end = "if.end." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1

        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp ne i64 " + cond_reg + ", 0")

        pilot else_body_w: word = array_get(ast_stmt_else_bodies, i)
        if else_body_w.length() > 0 {
            llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_then + ", label %" + l_else)
        } else {
            llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_then + ", label %" + l_end)
        }

        llvm_emit_line(l_then + ":")
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        llvm_emit_line("    br label %" + l_end)

        if else_body_w.length() > 0 {
            llvm_emit_line(l_else + ":")
            llvm_emit_block(else_body_w)
            llvm_emit_line("    br label %" + l_end)
        }

        llvm_emit_line(l_end + ":")
    } else if kind == STMT_REPEAT {
        if name_w == "until" {
            pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1
            pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1
            pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1

            pilot save_end = llvm_loop_end_label
            pilot save_cond = llvm_loop_cond_label
            llvm_loop_end_label = l_end
            llvm_loop_cond_label = l_cond

            llvm_emit_line("    br label %" + l_cond)
            llvm_emit_line(l_cond + ":")
            pilot cond_reg = llvm_emit_expr(expr_id_w)
            pilot cmp_reg = next_reg()
            llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + cond_reg + ", 0")
            llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_body + ", label %" + l_end)

            llvm_emit_line(l_body + ":")
            llvm_emit_block(array_get(ast_stmt_bodies, i))
            llvm_emit_line("    br label %" + l_cond)

            llvm_emit_line(l_end + ":")
            llvm_loop_end_label = save_end
            llvm_loop_cond_label = save_cond
        } else {
            pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1
            pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1
            pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1

            pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1
            pilot rep_var = "rep." + word_from_int(temp_reg_counter)
            temp_reg_counter += 1

            pilot count_reg = llvm_emit_expr(expr_id_w)

            llvm_emit_line("    %" + rep_var + " = alloca i64")
            llvm_emit_line("    store i64 0, i64* %" + rep_var)
            llvm_emit_line("    br label %" + l_cond)

            llvm_emit_line(l_cond + ":")
            pilot curr_val = next_reg()
            llvm_emit_line("    " + curr_val + " = load i64, i64* %" + rep_var)
            pilot cmp_reg = next_reg()
            llvm_emit_line("    " + cmp_reg + " = icmp slt i64 " + curr_val + ", " + count_reg)
            llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_body + ", label %" + l_end)

            pilot save_end2 = llvm_loop_end_label
            pilot save_cond2 = llvm_loop_cond_label
            llvm_loop_end_label = l_end
            llvm_loop_cond_label = l_inc

            llvm_emit_line(l_body + ":")
            llvm_emit_block(array_get(ast_stmt_bodies, i))

            llvm_emit_line("    br label %" + l_inc)
            llvm_emit_line(l_inc + ":")
            pilot next_val = next_reg()
            llvm_emit_line("    " + next_val + " = load i64, i64* %" + rep_var)
            pilot inc_val = next_reg()
            llvm_emit_line("    " + inc_val + " = add i64 " + next_val + ", 1")
            llvm_emit_line("    store i64 " + inc_val + ", i64* %" + rep_var)
            llvm_emit_line("    br label %" + l_cond)

            llvm_emit_line(l_end + ":")
            llvm_loop_end_label = save_end2
            llvm_loop_cond_label = save_cond2
        }
    } else if kind == STMT_TRAINING_ARC {
        pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1

        pilot rep_var = "rep." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1

        pilot max_reg = llvm_emit_expr(array_get(ast_stmt_extras, i))

        llvm_emit_line("    %" + rep_var + " = alloca i64")
        llvm_emit_line("    store i64 0, i64* %" + rep_var)
        llvm_emit_line("    br label %" + l_cond)

        llvm_emit_line(l_cond + ":")
        pilot curr_val = next_reg()
        llvm_emit_line("    " + curr_val + " = load i64, i64* %" + rep_var)
        pilot cmp_max = next_reg()
        llvm_emit_line("    " + cmp_max + " = icmp slt i64 " + curr_val + ", " + max_reg)

        pilot cond_reg = llvm_emit_expr(expr_id_w)
        pilot cmp_cond = next_reg()
        llvm_emit_line("    " + cmp_cond + " = icmp eq i64 " + cond_reg + ", 0")

        pilot loop_continue = next_reg()
        llvm_emit_line("    " + loop_continue + " = and i1 " + cmp_max + ", " + cmp_cond)
        llvm_emit_line("    br i1 " + loop_continue + ", label %" + l_body + ", label %" + l_end)

        pilot save_end3 = llvm_loop_end_label
        pilot save_cond3 = llvm_loop_cond_label
        llvm_loop_end_label = l_end
        llvm_loop_cond_label = l_inc

        llvm_emit_line(l_body + ":")
        llvm_emit_block(array_get(ast_stmt_bodies, i))

        llvm_emit_line("    br label %" + l_inc)
        llvm_emit_line(l_inc + ":")
        pilot next_val = next_reg()
        llvm_emit_line("    " + next_val + " = load i64, i64* %" + rep_var)
        pilot inc_val = next_reg()
        llvm_emit_line("    " + inc_val + " = add i64 " + next_val + ", 1")
        llvm_emit_line("    store i64 " + inc_val + ", i64* %" + rep_var)
        llvm_emit_line("    br label %" + l_cond)

        llvm_emit_line(l_end + ":")
        llvm_loop_end_label = save_end3
        llvm_loop_cond_label = save_cond3
    } else if kind == STMT_WHEN {
        pilot target_reg = llvm_emit_expr(expr_id_w)
        pilot cases_str: word = array_get(ast_stmt_bodies, i)

        pilot l_end = "when.end." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1

        pilot cases_len = cases_str.length()
        pilot ci = 0
        pilot case_fin = false
        pilot cur_case = ""

        pilot current_block = "when.case." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line("    br label %" + current_block)

        repeat until case_fin {
            pilot cc = cases_str.char_at(ci)
            if cc == "," or ci >= cases_len {
                if cur_case.length() > 0 {
                    llvm_emit_line(current_block + ":")
                    pilot c_expr = ""
                    pilot c_stmt = ""
                    pilot colon_idx = 0
                    pilot in_expr = true
                    pilot c_len = cur_case.length()
                    repeat c_len times {
                        pilot p = cur_case.char_at(colon_idx)
                        if p == ":" {
                            in_expr = false
                        } else {
                            if in_expr { c_expr = c_expr + p }
                            else { c_stmt = c_stmt + p }
                        }
                        colon_idx += 1
                    }

                    pilot next_block = "when.case." + word_from_int(temp_reg_counter)
                    temp_reg_counter += 1
                    pilot do_block = "when.do." + word_from_int(temp_reg_counter)
                    temp_reg_counter += 1

                    if c_expr.length() == 2 {
                        if c_expr.char_at(0) == "-" {
                            if c_expr.char_at(1) == "1" {
                                -- default case
                                llvm_emit_line("    br label %" + do_block)
                            } else {
                                pilot cmp_val = llvm_emit_expr(c_expr)
                                pilot cmp_res = next_reg()
                                llvm_emit_line("    " + cmp_res + " = icmp eq i64 " + target_reg + ", " + cmp_val)
                                llvm_emit_line("    br i1 " + cmp_res + ", label %" + do_block + ", label %" + next_block)
                            }
                        } else {
                            pilot cmp_val = llvm_emit_expr(c_expr)
                            pilot cmp_res = next_reg()
                            llvm_emit_line("    " + cmp_res + " = icmp eq i64 " + target_reg + ", " + cmp_val)
                            llvm_emit_line("    br i1 " + cmp_res + ", label %" + do_block + ", label %" + next_block)
                        }
                    } else {
                        pilot cmp_val = llvm_emit_expr(c_expr)
                        pilot cmp_res = next_reg()
                        llvm_emit_line("    " + cmp_res + " = icmp eq i64 " + target_reg + ", " + cmp_val)
                        llvm_emit_line("    br i1 " + cmp_res + ", label %" + do_block + ", label %" + next_block)
                    }

                    llvm_emit_line(do_block + ":")
                    llvm_emit_stmt(c_stmt)
                    llvm_emit_line("    br label %" + l_end)

                    current_block = next_block
                }
                cur_case = ""
                if ci >= cases_len { case_fin = true }
            } else {
                cur_case = cur_case + cc
            }
            ci += 1
        }
        llvm_emit_line(current_block + ":")
        llvm_emit_line("    br label %" + l_end)
        llvm_emit_line(l_end + ":")
    } else if kind == STMT_BLOCK {
        llvm_emit_block(array_get(ast_stmt_bodies, i))
    } else if kind == STMT_ASSIGN {
        pilot rhs_w: word = array_get(ast_stmt_bodies, i)
        pilot var_name_expr: word = array_get(ast_expr_vals, word_to_int(expr_id_w))
        pilot reg = llvm_emit_expr(rhs_w)
        pilot var_ptr = llvm_var_ptr(var_name_expr)
        if name_w == "=" {
            llvm_emit_line("    store i64 " + reg + ", i64* " + var_ptr)
        } else {
            -- +=, -=, etc. Need to load first, modify, then store
            pilot load_reg = next_reg()
            llvm_emit_line("    " + load_reg + " = load i64, i64* " + var_ptr)
            pilot op_reg = next_reg()
            if name_w == "+=" {
                llvm_emit_line("    " + op_reg + " = add i64 " + load_reg + ", " + reg)
            } else if name_w == "-=" {
                llvm_emit_line("    " + op_reg + " = sub i64 " + load_reg + ", " + reg)
            } else if name_w == "*=" {
                llvm_emit_line("    " + op_reg + " = mul i64 " + load_reg + ", " + reg)
            }
            llvm_emit_line("    store i64 " + op_reg + ", i64* " + var_ptr)
        }
    } else if kind == STMT_BREAK {
        llvm_emit_line("    br label %" + llvm_loop_end_label)
        pilot break_dead = "break.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line(break_dead + ":")
    } else if kind == STMT_CONTINUE {
        llvm_emit_line("    br label %" + llvm_loop_cond_label)
        pilot cont_dead = "cont.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line(cont_dead + ":")
    } else if kind == STMT_SHAPE {
        -- Shape definitions are handled at parse time via register_shape()
        -- No IR needs to be emitted
        llvm_emit_line("    ; shape " + name_w + " defined")
    } else if kind == STMT_EVENTUALLY {
        -- Emit eventually body inline (deferred execution)
        llvm_emit_line("    ; eventually block")
        pilot ev_body_w: word = array_get(ast_stmt_bodies, i)
        if ev_body_w.length() > 0 {
            llvm_emit_block(ev_body_w)
        }
    }
}

task llvm_translate_params(p: word) -> word {
    pilot res = ""
    pilot cur_name = ""
    pilot cur_type = ""
    pilot in_type = false

    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" {
            in_type = true
        } else if c == "," {
            if res.length() > 0 { res = res + ", " }
            res = res + "i64 %arg_" + cur_name
            cur_name = ""
            cur_type = ""
            in_type = false
        } else {
            if in_type {
                cur_type = cur_type + c
            } else {
                cur_name = cur_name + c
            }
        }
        i += 1
    }
    if cur_name.length() > 0 {
        if res.length() > 0 { res = res + ", " }
        res = res + "i64 %arg_" + cur_name
    }
    give back res
}

task llvm_allocate_params(p: word) -> void {
    pilot cur_name = ""
    pilot cur_type = ""
    pilot in_type = false
    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" {
            in_type = true
        } else if c == "," {
            llvm_emit_line("    %" + cur_name + " = alloca i64")
            llvm_emit_line("    store i64 %arg_" + cur_name + ", i64* %" + cur_name)
            -- Track the parameter type for correct inference
            pilot pt = "i"
            if cur_type == "word" { pt = "w" }
            if cur_type == "num" { pt = "n" }
            if cur_type == "bool" { pt = "b" }
            llvm_set_var_type(cur_name, pt)
            cur_name = ""
            cur_type = ""
            in_type = false
        } else {
            if in_type {
                cur_type = cur_type + c
            } else {
                cur_name = cur_name + c
            }
        }
        i += 1
    }
    if cur_name.length() > 0 {
        llvm_emit_line("    %" + cur_name + " = alloca i64")
        llvm_emit_line("    store i64 %arg_" + cur_name + ", i64* %" + cur_name)
        pilot pt = "i"
        if cur_type == "word" { pt = "w" }
        if cur_type == "num" { pt = "n" }
        if cur_type == "bool" { pt = "b" }
        llvm_set_var_type(cur_name, pt)
    }
}

task llvm_emit_task(eid: word) -> void {
    -- Reset variable type tracking for this function scope
    llvm_var_names = ""
    llvm_var_types = ""
    llvm_var_src_names = ""
    llvm_var_ir_names = ""

    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot body_id_w: word = array_get(ast_stmt_bodies, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)

    pilot ret_type = "i64"
    pilot is_void = false
    if returns_w == "void" or returns_w == "" {
        ret_type = "void"
        is_void = true
    }
    llvm_cur_func_is_void = is_void

    pilot p_str = ""
    if params_w.length() > 0 {
        p_str = llvm_translate_params(params_w)
    }

    llvm_emit_line("define " + ret_type + " @freak_" + name_w + "(" + p_str + ") {")
    llvm_emit_line("entry:")

    if params_w.length() > 0 {
        llvm_allocate_params(params_w)
    }

    llvm_emit_block(body_id_w)

    if is_void {
        llvm_emit_line("    ret void")
    } else {
        llvm_emit_line("    ret i64 0")
    }
    llvm_emit_line("}")
    llvm_emit_line("")
}

-- ===================== PROGRAM =====================================

task emit_llvm_program() -> void {
    llvm_out_buf = ""
    temp_reg_counter = 0
    string_literals = ""
    string_literals_count = 0

    -- If streaming mode, initialize temp file for string literals
    if llvm_out_file != "" {
        fs::write(llvm_out_file + ".strs", "")
    }

    llvm_emit_line("; FREAK LLVM IR Generator")
    -- Omit target triple — let clang/llc infer from host
    -- This enables cross-compilation by passing --target to clang
    llvm_emit_line("")

    llvm_emit_runtime_decls()
    llvm_emit_line("")

    -- Pre-scan: Register return types for all user-defined tasks and externs
    pilot top_count = array_len(ast_top_stmts)
    pilot prescan_i = 0
    repeat top_count times {
        pilot prescan_id: word = array_get(ast_top_stmts, prescan_i)
        pilot prescan_kind: word = array_get(ast_stmt_kinds, word_to_int(prescan_id))
        if prescan_kind == STMT_TASK {
            pilot prescan_name: word = array_get(ast_stmt_names, word_to_int(prescan_id))
            pilot prescan_ret: word = array_get(ast_task_returns, word_to_int(prescan_id))
            llvm_register_task(prescan_name, prescan_ret)
        }
        if prescan_kind == STMT_EXTERN {
            pilot ext_name: word = array_get(ast_stmt_names, word_to_int(prescan_id))
            pilot ext_ret: word = array_get(ast_task_returns, word_to_int(prescan_id))
            llvm_register_task(ext_name, ext_ret)
            emt_register_extern(ext_name, ext_ret)
        }
        prescan_i += 1
    }

    -- Pre-scan: Register and emit top-level pilot variables as LLVM globals
    llvm_global_names = ""
    pilot glob_i = 0
    repeat top_count times {
        pilot glob_id: word = array_get(ast_top_stmts, glob_i)
        pilot glob_kind: word = array_get(ast_stmt_kinds, word_to_int(glob_id))
        if glob_kind == STMT_PILOT {
            pilot glob_name: word = array_get(ast_stmt_names, word_to_int(glob_id))
            llvm_global_names = llvm_global_names + "|" + glob_name + "|"
            llvm_emit_line("@g_" + glob_name + " = global i64 0")
        }
        glob_i += 1
    }
    llvm_emit_line("")

    -- Emit extern function declarations
    pilot ext_i = 0
    repeat top_count times {
        pilot ext_id: word = array_get(ast_top_stmts, ext_i)
        pilot ext_kind: word = array_get(ast_stmt_kinds, word_to_int(ext_id))
        if ext_kind == STMT_EXTERN {
            pilot ext_nm: word = array_get(ast_stmt_names, word_to_int(ext_id))
            pilot ext_rt: word = array_get(ast_task_returns, word_to_int(ext_id))
            pilot ext_pm: word = array_get(ast_task_params, word_to_int(ext_id))
            pilot llvm_ret = "i64"
            if ext_rt == "void" { llvm_ret = "void" }
            pilot llvm_params = ""
            if ext_pm != "" {
                -- Count params by counting commas + 1
                pilot plen = ext_pm.length()
                pilot pi = 0
                pilot pcount = 1
                repeat plen times {
                    if ext_pm.char_at(pi) == "," { pcount += 1 }
                    pi += 1
                }
                pilot pj = 0
                repeat pcount times {
                    if pj > 0 { llvm_params = llvm_params + ", " }
                    llvm_params = llvm_params + "i64"
                    pj += 1
                }
            }
            -- Skip if already declared as a runtime function
            if not llvm_is_runtime_func(ext_nm) {
                llvm_emit_line("declare " + llvm_ret + " @" + ext_nm + "(" + llvm_params + ")")
            }
        }
        ext_i += 1
    }
    llvm_emit_line("")

    -- First pass: Tasks (emitted before @main and @freak_main so they're visible)
    pilot i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { llvm_emit_task(cur_id) }
        -- STMT_EXTERN already handled above as declare
        i += 1
    }

    -- Emit main function wrapper
    llvm_emit_line("define i32 @main(i32 %argc, i8** %argv) {")
    llvm_emit_line("entry:")
    llvm_emit_line("    %argc_ext = sext i32 %argc to i64")
    llvm_emit_line("    %argv_ptr = ptrtoint i8** %argv to i64")
    llvm_emit_line("    call void @freak_llvm_setup_args(i64 %argc_ext, i64 %argv_ptr)")
    llvm_emit_line("    call void @freak_main()")
    llvm_emit_line("    ret i32 0")
    llvm_emit_line("}")
    llvm_emit_line("")

    -- Check if user defined a main task (already emitted in first pass)
    pilot has_main_task = false
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" { has_main_task = true }
        }
        i += 1
    }

    -- Only emit @freak_main wrapper if user didn't define task main()
    if not has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_src_names = ""
        llvm_var_ir_names = ""
        llvm_emit_line("define void @freak_main() {")
        llvm_emit_line("entry:")

        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind != STMT_TASK and kind != STMT_EXTERN { llvm_emit_stmt(cur_id) }
            i += 1
        }

        llvm_emit_line("    ret void")
        llvm_emit_line("}")
    }

    llvm_emit_line("")
    llvm_emit_line("; String Literals")

    if llvm_out_file != "" {
        -- Flush any remaining IR buffer
        llvm_flush()
        -- Flush remaining string literals
        llvm_flush_strs()
        -- Read string literals from temp file and append to main output
        pilot strs_file = llvm_out_file + ".strs"
        if fs::exists(strs_file) {
            pilot strs_data = fs::read(strs_file)
            fs::append(llvm_out_file, strs_data)
            fs::delete(strs_file)
        }
    } else {
        llvm_emit_line(string_literals)
    }
}
