-- ===================================================================
-- FREAK CLI — Run Pipeline
-- ===================================================================
-- Handles: freshness check, build when needed, then execute the binary.
-- ===================================================================

pilot CLI_RUN_CACHE_SCHEMA = "freak-run-cache-v6"
pilot CLI_RUN_UNHASHABLE = "<unhashable>"

task cli_run_valid_sha256(token: word) -> bool {
    if token.length() != 64 { give back false }
    pilot hi = 0
    repeat until hi >= token.length() {
        if not is_hex_digit(token.char_at(hi)) { give back false }
        hi += 1
    }
    give back true
}

task cli_run_sha256_from_output(output: word) -> word {
    pilot token = ""
    pilot oi = 0
    repeat until oi > output.length() {
        pilot at_end = oi == output.length()
        pilot ch = " "
        if not at_end { ch = output.char_at(oi) }
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            if cli_run_valid_sha256(token) { give back token.to_lower() }
            -- GNU-compatible hash tools mark escaped filenames by prefixing
            -- the digest with one backslash. The digest bytes stay unchanged.
            if token.length() == 65 and token.starts_with("\\") {
                pilot digest = token.substring(1, 64)
                if cli_run_valid_sha256(digest) { give back digest.to_lower() }
            }
            token = ""
        } else {
            token = token + ch
        }
        oi += 1
    }
    give back ""
}

task cli_run_sha256_from_bytes(output: ByteBuffer) -> word {
    -- Certutil headers use the active Windows code page. Validate only the
    -- complete ASCII digest line without converting localized bytes to word.
    if output.status() != 0 { give back "" }
    output.seek(0)
    pilot digest = ""
    pilot token = ""
    pilot valid_line = true
    pilot overlong = false
    pilot complete_line = false
    repeat until output.remaining() == 0 {
        pilot value = output.read_byte()
        if value == 0 { give back "" }
        if value == 10 {
            if valid_line and token != "" {
                if overlong or not cli_run_valid_sha256(token) { give back "" }
                if digest != "" { give back "" }
                digest = token.to_lower()
            }
            token = ""
            valid_line = true
            overlong = false
            complete_line = true
        } else {
            complete_line = false
            if value != 9 and value != 13 and value != 32 {
                if value < 128 and "0123456789abcdefABCDEF".contains(char_to_word(value)) {
                    if token.length() < 64 { token = token + char_to_word(value) }
                    else { overlong = true }
                } else { valid_line = false }
            }
        }
    }
    if not complete_line or output.status() != 0 { give back "" }
    give back digest
}

task cli_run_windows_file_sha256(path: word) -> word {
    pilot executable = hangar_native_tool_executable("certutil")
    if executable == "" { give back "" }
    pilot command = process::command_new(executable)
    process::command_arg(command, "-hashfile")
    process::command_arg(command, path)
    process::command_arg(command, "SHA256")
    pilot state = process::command_run(command, 10000, 65536, 65536)
    pilot digest = ""
    if state == 2 and process::command_exit_code(command) == 0 {
        pilot output: ByteBuffer = process::command_stdout_bytes(command)
        pilot errors: ByteBuffer = process::command_stderr_bytes(command)
        if output.status() == 0 and errors.status() == 0 {
            -- Diagnostics may use a non-UTF8 locale; embedded NUL is still
            -- malformed tool output and must not admit a freshness proof.
            pilot clean_errors = true
            errors.seek(0)
            repeat until errors.remaining() == 0 {
                if errors.read_byte() == 0 { clean_errors = false }
            }
            if clean_errors and errors.status() == 0 {
                digest = cli_run_sha256_from_bytes(output)
            }
        }
        output.release()
        errors.release()
    }
    process::command_release(command)
    give back digest
}

task cli_run_file_sha256(path: word) -> word {
    if path == "" or not fs::exists(path) { give back "" }
    pilot output = ""
    if cli_is_windows() {
        give back cli_run_windows_file_sha256(path)
    } else {
        output = process::exec_capture("sha256sum " + cli_quote_cmd_path(path) + " 2>/dev/null")
        if cli_run_sha256_from_output(output) == "" {
            output = process::exec_capture("shasum -a 256 " + cli_quote_cmd_path(path) + " 2>/dev/null")
        }
    }
    give back cli_run_sha256_from_output(output)
}

task cli_run_file_fingerprint(path: word) -> word {
    if path == "" { give back "<empty-path>:missing" }
    if not fs::exists(path) { give back path + ":missing" }
    pilot digest = cli_run_file_sha256(path)
    if digest == "" { give back CLI_RUN_UNHASHABLE + ":" + path }
    give back path + ":sha256=" + digest
}

task cli_run_fingerprint(src_file: word, target: word, profile: word, opt: word, lto: word, runtime_policy: word, runtime_stats: word, cross: word) -> word {
    pilot source: word = fs::read(src_file)
    if source == "" { give back "" }

    pilot std_source: word = cli_load_std(source, target)
    pilot runtime_dir: word = cli_find_runtime_dir()
    pilot std_dir: word = cli_find_std_dir()
    pilot pending_marker: word = cli_pending_upgrade_marker()
    -- Tool identity uses the same raw executable selected for native argv.
    pilot clang_cmd = cli_find_clang_executable()
    pilot link_plan = cli_runtime_link_plan(runtime_dir, lto, cross)
    pilot strict_label = "0"
    if strict_borrow { strict_label = "1" }

    pilot material = CLI_RUN_CACHE_SCHEMA
    material = material + "|cli=" + CLI_VERSION + "|compiler=" + FREAKC_VERSION
    material = material + "|self=" + cli_run_file_fingerprint(cli_executable_path())
    material = material + "|source=" + cli_run_file_fingerprint(src_file)
    material = material + "|std=" + word_from_int(std_source.length()) + ":" + word_from_int(std_source.checksum())
    material = material + "|target=" + target + "|profile=" + profile + "|clang-opt=" + opt + "|lto=" + lto
    material = material + "|runtime-policy=" + runtime_policy + "|runtime-stats=" + runtime_stats + "|cross=" + cross + "|strict=" + strict_label
    material = material + "|clang=" + cli_run_clang_identity(clang_cmd)
    material = material + "|linker=" + cli_run_linker_identity(clang_cmd, lto, cross) + "|link-plan=" + link_plan
    material = material + "|runtime-dir=" + runtime_dir
    if runtime_dir != "" {
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.c")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.h")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_llvm_runtime.c")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_v35_process.inc")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_v35_fs.inc")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_v35_json.inc")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_v35_http.inc")
        -- Match freak_v35_http.inc's __has_include selection. The same
        -- amalgamation compiles these headers and C sources into the runtime.
        pilot http_vendor = runtime_dir + "/../../third_party/llhttp"
        if fs::exists(runtime_dir + "/third_party/llhttp/freak_amalgamation.inc") {
            http_vendor = runtime_dir + "/third_party/llhttp"
        }
        material = material + "|http-vendor=" + http_vendor
        material = material + "|" + cli_run_file_fingerprint(http_vendor + "/freak_amalgamation.inc")
        material = material + "|" + cli_run_file_fingerprint(http_vendor + "/include/llhttp.h")
        material = material + "|" + cli_run_file_fingerprint(http_vendor + "/src/api.c")
        material = material + "|" + cli_run_file_fingerprint(http_vendor + "/src/http.c")
        material = material + "|" + cli_run_file_fingerprint(http_vendor + "/src/llhttp.c")
        material = material + "|" + cli_run_file_fingerprint(http_vendor + "/src/llhttp.h")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.o")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_llvm_runtime.o")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.obj")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_llvm_runtime.obj")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_ui_win32.obj")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_ui_win32.o")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/ui/win32_backend.c")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/ui/freak_ui_platform.h")
    }
    material = material + "|runtime-abi=" + cli_run_file_fingerprint(runtime_dir + "/freak_abi")
    material = material + "|std-abi=" + cli_run_file_fingerprint(std_dir + "/freak_abi")
    material = material + "|pending-upgrade=" + cli_run_file_fingerprint(pending_marker)

    if material.contains(CLI_RUN_UNHASHABLE) { give back "" }
    give back word_from_int(material.checksum())
}

task cli_run_resolve_program(command: word) -> word {
    if command == "" { give back "" }
    pilot resolved = ""
    -- POSIX argv searches PATH for a slash-free name, even when a same-named
    -- file exists in the working directory. Only literal paths bypass lookup.
    if (cli_is_windows() or command.contains("/")) and fs::exists(command) {
        resolved = command
    } else if cli_is_windows() and fs::exists(command + ".exe") {
        resolved = command + ".exe"
    } else if cli_is_windows() {
        resolved = cli_first_line(process::exec_capture("where " + cli_quote_cmd_path(command) + " 2>nul"))
    } else {
        if command.contains("/") { give back "" }
        -- The argv runtime defaults an absent PATH to /bin:/usr/bin. A shell
        -- may invent a different default; preserve an explicitly empty PATH.
        pilot search_path = process::env("PATH")
        if search_path == "" {
            -- V3's scalar env read cannot distinguish empty from absent.
            -- Probe presence through native argv; never guess after a failed
            -- utility launch or a malformed/concurrently changed response.
            pilot presence = process::command_new("/usr/bin/printenv")
            process::command_arg(presence, "PATH")
            pilot state = process::command_run(presence, 10000, 65536, 65536)
            pilot exit_code = process::command_exit_code(presence)
            pilot valid = false
            if state == 2 {
                pilot output: ByteBuffer = process::command_stdout_bytes(presence)
                pilot errors: ByteBuffer = process::command_stderr_bytes(presence)
                pilot text = output.to_word()
                pilot diagnostic = errors.to_word()
                if output.status() == 0 and errors.status() == 0 and diagnostic == "" {
                    if exit_code == 0 and text == "\n" { valid = true }
                    if exit_code == 1 and text == "" {
                        search_path = "/bin:/usr/bin"
                        valid = true
                    }
                }
                output.release()
                errors.release()
            }
            process::command_release(presence)
            if not valid { give back "" }
        }
        -- Match native execve's PATH order without shell builtin precedence.
        -- Empty entries denote cwd. Keep the slash in the resolved candidate
        -- so its identity probe cannot search later PATH entries.
        pilot directory = ""
        pilot pi = 0
        repeat until pi > search_path.length() {
            pilot at_end = pi == search_path.length()
            pilot ch = ":"
            if not at_end { ch = search_path.char_at(pi) }
            if ch == ":" {
                pilot candidate = "./" + command
                if directory != "" { candidate = directory + "/" + command }
                pilot quoted = cli_quote_cmd_path(candidate)
                if process::exec("test -f " + quoted + " && test -x " + quoted) == 0 {
                    give back candidate
                }
                directory = ""
            } else {
                directory = directory + ch
            }
            pi += 1
        }
    }
    give back resolved
}

task cli_run_tool_version(executable: word, allow_nonzero: bool) -> word {
    pilot command = process::command_new(executable)
    process::command_arg(command, "--version")
    -- Some native linkers (including Apple ld) report an unsupported-option
    -- diagnostic with a normal nonzero exit. Preserve that version identity
    -- while keeping the probe bounded and entirely in argv.
    pilot state = process::command_run(command, 10000, 65536, 65536)
    pilot exit_code = process::command_exit_code(command)
    pilot version = ""
    if state == 2 and (allow_nonzero or exit_code == 0) {
        pilot output: ByteBuffer = process::command_stdout_bytes(command)
        pilot errors: ByteBuffer = process::command_stderr_bytes(command)
        pilot text = output.to_word()
        pilot diagnostic = errors.to_word()
        if output.status() == 0 and errors.status() == 0 {
            if text == "" { text = diagnostic }
            version = cli_first_line(text)
        }
        output.release()
        errors.release()
    }
    process::command_release(command)
    give back version
}

task cli_run_clang_identity(clang_cmd: word) -> word {
    if clang_cmd == "" { give back CLI_RUN_UNHASHABLE + ":clang-command" }
    pilot resolved = cli_run_resolve_program(clang_cmd)
    if resolved == "" { give back CLI_RUN_UNHASHABLE + ":clang-resolution:" + clang_cmd }
    pilot digest = cli_run_file_sha256(resolved)
    if digest == "" { give back CLI_RUN_UNHASHABLE + ":clang-digest:" + resolved }
    pilot version = cli_run_tool_version(resolved, false)
    if version == "" { give back CLI_RUN_UNHASHABLE + ":clang-version:" + clang_cmd }
    give back "command=" + clang_cmd + "|resolved=" + resolved + "|digest=" + digest + "|version=" + version
}

task cli_run_clang_target(clang_cmd: word) -> word {
    -- Keep the strict target probe's argv, limits and stdout acceptance. Its
    -- command must remain live until a rejected probe's evidence is retained.
    pilot command = process::command_new(clang_cmd)
    process::command_arg(command, "-dumpmachine")
    cli_tool_capture_problem = ""
    pilot started = time::monotonic_ns()
    pilot state = process::command_run(command, 10000, 65536, 65536)
    pilot elapsed = (time::monotonic_ns() - started) / 1000000
    pilot exit_code = process::command_exit_code(command)
    pilot signal_number = process::command_signal(command)
    pilot error = process::command_error(command)
    pilot text = ""
    pilot text_status = -1
    if state == 2 and exit_code == 0 {
        pilot bytes: ByteBuffer = process::command_stdout_bytes(command)
        text = bytes.to_word()
        text_status = bytes.status()
        bytes.release()
        if text_status != 0 {
            text = ""
            cli_tool_capture_problem = "tool probe emitted bytes that are not NUL-free UTF-8"
        }
    } else {
        if state == 2 {
            cli_tool_capture_problem = "tool probe exited with status " + word_from_int(exit_code)
        } else {
            cli_tool_capture_problem = "tool probe failed with process status " + word_from_int(state)
        }
        if error != "" { cli_tool_capture_problem = cli_tool_capture_problem + ": " + error }
    }
    pilot target = cli_first_line(text).trim()
    pilot problem = cli_tool_capture_problem
    if target == "" {
        if problem == "" { problem = "tool probe returned an empty target" }
        say "  " + C_DIM + "Selected compiler target probe failed: " + problem + C_RESET
    }
    if process::env("FREAK_RUN_TOOL_DIAGNOSTICS") == "1" {
        -- These are fresh copies of immutable captures, independent of the
        -- stdout text view above. Retain positive completions as well so a
        -- later trace failure cannot be mistaken for a rejected target.
        pilot output: ByteBuffer = process::command_stdout_bytes(command)
        pilot errors: ByteBuffer = process::command_stderr_bytes(command)
        pilot output_status = output.status()
        pilot error_status = errors.status()
        pilot accepted = "false"
        if target != "" { accepted = "true" }
        pilot receipt = "FREAK_RUN_TARGET_PROBE {\"schema\":\"freak.run-target-probe.v1\",\"executable\":\"" + cli_test_json_escape(clang_cmd) + "\",\"caller_pid\":" + word_from_int(process::pid()) + ",\"child_pid\":null"
        receipt = receipt + ",\"state\":" + word_from_int(state) + ",\"exit_code\":" + word_from_int(exit_code) + ",\"signal\":" + word_from_int(signal_number) + ",\"elapsed_ms\":" + word_from_int(elapsed) + ",\"accepted\":" + accepted + ",\"target\":\"" + cli_test_json_escape(target) + "\""
        receipt = receipt + ",\"error\":\"" + cli_test_json_escape(error) + "\",\"problem\":\"" + cli_test_json_escape(problem) + "\",\"stdout_buffer_status\":" + word_from_int(output_status) + ",\"stderr_buffer_status\":" + word_from_int(error_status) + ",\"stdout_text_status\":" + word_from_int(text_status)
        receipt = receipt + ",\"stdout_hex\":\"" + cli_test_bytes_hex(output) + "\",\"stderr_hex\":\"" + cli_test_bytes_hex(errors) + "\",\"pid_scope\":\"CLI caller; child PID unavailable through public command API\",\"stdout_text_status_scope\":\"-1 means strict text conversion was not attempted\"}"
        say receipt
    }
    process::command_release(command)
    give back target
}

task cli_run_linker_identity(clang_cmd: word, lto: word, cross: word) -> word {
    pilot clang_target = cross
    if clang_target == "" {
        clang_target = cli_run_clang_target(clang_cmd)
    }
    if clang_target == "" { give back CLI_RUN_UNHASHABLE + ":clang-target" }
    pilot linker_cmd = cli_selected_linker_executable(clang_cmd, lto, cross)
    if linker_cmd == "" { give back CLI_RUN_UNHASHABLE + ":linker-trace" }
    pilot resolved = cli_run_resolve_program(linker_cmd)
    if resolved == "" { give back CLI_RUN_UNHASHABLE + ":linker-resolution:" + linker_cmd }
    pilot digest = cli_run_file_sha256(resolved)
    if digest == "" { give back CLI_RUN_UNHASHABLE + ":linker-digest:" + resolved }
    pilot version = cli_run_tool_version(resolved, true)
    if version == "" { give back CLI_RUN_UNHASHABLE + ":linker-version:" + linker_cmd }
    -- GNU coreutils link can shadow the Windows linker after PATH fallback.
    -- Its hash and version identify a file-link utility, not a native linker.
    if version.to_lower().contains("gnu coreutils") {
        give back CLI_RUN_UNHASHABLE + ":linker-not-linker:" + resolved
    }
    give back "target=" + clang_target + "|command=" + linker_cmd + "|resolved=" + resolved + "|digest=" + digest + "|version=" + version
}

task cli_run_cache_record(fingerprint: word, binary: word) -> word {
    pilot artifact = cli_run_file_fingerprint(binary)
    if artifact.contains(CLI_RUN_UNHASHABLE) { give back "" }
    give back fingerprint + "|artifact=" + artifact
}

task cli_run_program(run_path: word, program_arg_start: int) -> int {
    -- Program arguments are independent argv entries. Never render them as
    -- shell text: empty words and metacharacters must reach the child intact.
    pilot command = process::command_new(run_path)
    pilot arg_index = program_arg_start
    pilot arg_count = process::args_count()
    repeat until arg_index >= arg_count {
        process::command_arg(command, process::arg(arg_index))
        arg_index += 1
    }
    -- User programs inherit the terminal and have no CLI-imposed deadline.
    pilot status = process::command_run_inherit(command, 0)
    pilot run_code = 1
    if status == 2 {
        run_code = process::command_exit_code(command)
    } else if status == 4 {
        run_code = 128 + process::command_signal(command)
    } else {
        pilot error = process::command_error(command)
        say "  " + C_BRED + SYM_CROSS + " RUN FAILED" + C_RESET + " " + error
    }
    process::command_release(command)
    give back run_code
}

task cli_run(src_file: word, target: word, profile: word, opt: word, lto: word, runtime_policy: word, runtime_stats: word, cross: word, program_arg_start: int) -> int {
    -- Cross-compiled binaries cannot run on this host. Refuse before any
    -- build artifact or cache entry changes; freak build stays the
    -- cross-compile path.
    if cross != "" and not cli_host_can_execute_target(cross) {
        pilot host_triple = cli_host_native_triple()
        if host_triple == "" { host_triple = "(toolchain unavailable)" }
        say ""
        say "  " + C_BRED + SYM_CROSS + " FOREIGN TARGET" + C_RESET + " freak run refused --target=" + C_BWHITE + cross + C_RESET
        say "  " + C_DIM + "Host toolchain builds for: " + host_triple + C_RESET
        say "  " + C_DIM + "freak run only executes binaries the host can run." + C_RESET
        say "  " + C_DIM + "Fix: " + C_RESET + "freak build " + src_file + " --target=" + cross + C_DIM + ", then execute the binary on the target machine." + C_RESET
        say ""
        give back 1
    }
    -- Cache hits are still build operations from the distribution contract's
    -- perspective: never launch an artifact with a mismatched payload or while
    -- a Windows executable replacement is pending.
    if not cli_build_environment_ready() { give back 1 }

    pilot binary: word = cli_binary_path(src_file)
    pilot cache_file = binary + ".freak-run-cache"
    pilot fingerprint = cli_run_fingerprint(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
    pilot cache_hit = false

    if fingerprint == "" {
        say ""
        say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " Build inputs or the selected toolchain could not be hashed."
        say "  " + C_DIM + "Install a platform SHA-256 tool and verify Clang can report its linker with -###." + C_RESET
        give back 1
    }

    if fingerprint != "" and fs::exists(binary) and fs::exists(cache_file) {
        pilot expected_record = cli_run_cache_record(fingerprint, binary)
        if expected_record != "" and fs::read(cache_file) == expected_record { cache_hit = true }
    }

    if cache_hit {
        say ""
        say "  " + C_BGREEN + SYM_CHECK + " FRESH" + C_RESET + C_DIM + "  run cache hit" + C_RESET
    } else {
        -- Invalidate first. A rejected rebuild may leave an older binary on
        -- disk, but it must never leave proof that the binary is fresh.
        if fs::exists(cache_file) { fs::delete(cache_file) }
        binary = cli_build_profile(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
        if binary == "" { give back 1 }

        pilot confirmed = cli_run_fingerprint(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
        if confirmed == "" or confirmed != fingerprint {
            say ""
            say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " Build inputs changed while compiling."
            say "  " + C_DIM + "Run the command again after the files stop changing." + C_RESET
            give back 1
        }
        pilot confirmed_record = cli_run_cache_record(confirmed, binary)
        if confirmed_record == "" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " The built executable could not be hashed."
            give back 1
        }
        fs::write(cache_file, confirmed_record)
    }

    -- Revalidate both inputs and the output artifact immediately before
    -- launch. This rejects edits, failed/racing rebuilds, and externally
    -- replaced binaries that appear after the initial cache decision.
    pilot launch_fingerprint = cli_run_fingerprint(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
    pilot launch_record = cli_run_cache_record(launch_fingerprint, binary)
    if launch_fingerprint == "" or launch_record == "" or launch_fingerprint != fingerprint or not fs::exists(cache_file) or fs::read(cache_file) != launch_record {
        if fs::exists(cache_file) { fs::delete(cache_file) }
        say ""
        say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " Build inputs or output changed before launch."
        say "  " + C_DIM + "Run the command again after competing writers stop." + C_RESET
        give back 1
    }
    if not cli_build_environment_ready() {
        if fs::exists(cache_file) { fs::delete(cache_file) }
        give back 1
    }

    say cli_box_top(45)
    say cli_box_mid(" " + C_G5 + SYM_ARROW + " RUNNING" + C_RESET + "  " + C_BWHITE + binary + C_RESET, 45)
    say cli_box_bot(45)
    say ""
    pilot run_path = binary
    if cli_is_windows() {
        run_path = run_path.replace("/", "\\")
    } else if not run_path.contains("/") {
        -- POSIX executable lookup does not search the current directory. A source passed
        -- as `hello.fk` produces `hello`, which must be launched as `./hello`.
        run_path = "./" + run_path
    }
    pilot run_start = time::now_ms()
    pilot run_code = cli_run_program(run_path, program_arg_start)
    pilot run_elapsed = time::now_ms() - run_start
    say ""
    if run_code != 0 {
        pilot rc_str: word = word_from_int(run_code)
        say "  " + C_BYELLOW + SYM_BOLT + " EXIT" + C_RESET + C_DIM + " code " + rc_str + " (" + word_from_int(run_elapsed) + "ms)" + C_RESET
    } else {
        say "  " + C_BGREEN + SYM_CHECK + " DONE" + C_RESET + C_DIM + " (" + word_from_int(run_elapsed) + "ms)" + C_RESET
    }
    say ""
    give back run_code
}
