-- ===================================================================
-- FREAK CLI — Run Pipeline
-- ===================================================================
-- Handles: freshness check, build when needed, then execute the binary.
-- ===================================================================

pilot CLI_RUN_CACHE_SCHEMA = "freak-run-cache-v6"
pilot CLI_RUN_UNHASHABLE = "<unhashable>"

task cli_run_valid_sha256(token: word) -> bool {
    if token.length() != 64 { give back false }
    pilot hi = 0
    repeat until hi >= token.length() {
        if not is_hex_digit(token.char_at(hi)) { give back false }
        hi += 1
    }
    give back true
}

task cli_run_sha256_from_output(output: word) -> word {
    pilot token = ""
    pilot oi = 0
    repeat until oi > output.length() {
        pilot at_end = oi == output.length()
        pilot ch = " "
        if not at_end { ch = output.char_at(oi) }
        if ch == " " or ch == "\t" or ch == "\r" or ch == "\n" {
            if cli_run_valid_sha256(token) { give back token.to_lower() }
            token = ""
        } else {
            token = token + ch
        }
        oi += 1
    }
    give back ""
}

task cli_run_file_sha256(path: word) -> word {
    if path == "" or not fs::exists(path) { give back "" }
    pilot output = ""
    if cli_is_windows() {
        output = process::exec_capture("certutil -hashfile " + cli_quote_cmd_path(path) + " SHA256 2>nul")
    } else {
        output = process::exec_capture("sha256sum " + cli_quote_cmd_path(path) + " 2>/dev/null")
        if cli_run_sha256_from_output(output) == "" {
            output = process::exec_capture("shasum -a 256 " + cli_quote_cmd_path(path) + " 2>/dev/null")
        }
    }
    give back cli_run_sha256_from_output(output)
}

task cli_run_file_fingerprint(path: word) -> word {
    if path == "" { give back "<empty-path>:missing" }
    if not fs::exists(path) { give back path + ":missing" }
    pilot digest = cli_run_file_sha256(path)
    if digest == "" { give back CLI_RUN_UNHASHABLE + ":" + path }
    give back path + ":sha256=" + digest
}

task cli_run_fingerprint(src_file: word, target: word, profile: word, opt: word, lto: word, runtime_policy: word, runtime_stats: word, cross: word) -> word {
    pilot source: word = fs::read(src_file)
    if source == "" { give back "" }

    pilot std_source: word = cli_load_std(source, target)
    pilot runtime_dir: word = cli_find_runtime_dir()
    pilot std_dir: word = cli_find_std_dir()
    pilot pending_marker: word = cli_pending_upgrade_marker()
    pilot clang_cmd = cli_find_clang_command()
    pilot link_plan = cli_runtime_link_plan(runtime_dir, lto, cross)
    pilot strict_label = "0"
    if strict_borrow { strict_label = "1" }

    pilot material = CLI_RUN_CACHE_SCHEMA
    material = material + "|cli=" + CLI_VERSION + "|compiler=" + FREAKC_VERSION
    material = material + "|self=" + cli_run_file_fingerprint(cli_executable_path())
    material = material + "|source=" + cli_run_file_fingerprint(src_file)
    material = material + "|std=" + word_from_int(std_source.length()) + ":" + word_from_int(std_source.checksum())
    material = material + "|target=" + target + "|profile=" + profile + "|clang-opt=" + opt + "|lto=" + lto
    material = material + "|runtime-policy=" + runtime_policy + "|runtime-stats=" + runtime_stats + "|cross=" + cross + "|strict=" + strict_label
    material = material + "|clang=" + cli_run_clang_identity(clang_cmd)
    material = material + "|linker=" + cli_run_linker_identity(clang_cmd, lto, cross) + "|link-plan=" + link_plan
    material = material + "|runtime-dir=" + runtime_dir
    if runtime_dir != "" {
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.c")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.h")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_llvm_runtime.c")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.o")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_llvm_runtime.o")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_runtime.obj")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_llvm_runtime.obj")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_ui_win32.obj")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/freak_ui_win32.o")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/ui/win32_backend.c")
        material = material + "|" + cli_run_file_fingerprint(runtime_dir + "/ui/freak_ui_platform.h")
    }
    material = material + "|runtime-abi=" + cli_run_file_fingerprint(runtime_dir + "/freak_abi")
    material = material + "|std-abi=" + cli_run_file_fingerprint(std_dir + "/freak_abi")
    material = material + "|pending-upgrade=" + cli_run_file_fingerprint(pending_marker)

    if material.contains(CLI_RUN_UNHASHABLE) { give back "" }
    give back word_from_int(material.checksum())
}

task cli_run_resolve_program(command: word) -> word {
    if command == "" { give back "" }
    pilot clean_cmd = command.replace("\"", "")
    pilot resolved = ""
    if fs::exists(clean_cmd) {
        resolved = clean_cmd
    } else if cli_is_windows() and fs::exists(clean_cmd + ".exe") {
        resolved = clean_cmd + ".exe"
    } else if cli_is_windows() {
        resolved = cli_first_line(process::exec_capture("where " + cli_quote_cmd_path(clean_cmd) + " 2>nul"))
    } else {
        resolved = cli_first_line(process::exec_capture("command -v " + cli_quote_cmd_path(clean_cmd) + " 2>/dev/null"))
    }
    give back resolved.trim()
}

task cli_run_clang_identity(clang_cmd: word) -> word {
    if clang_cmd == "" { give back CLI_RUN_UNHASHABLE + ":clang-command" }
    pilot resolved = cli_run_resolve_program(clang_cmd)
    if resolved == "" { give back CLI_RUN_UNHASHABLE + ":clang-resolution:" + clang_cmd }
    pilot digest = cli_run_file_sha256(resolved)
    if digest == "" { give back CLI_RUN_UNHASHABLE + ":clang-digest:" + resolved }
    give back "command=" + clang_cmd + "|resolved=" + resolved + "|digest=" + digest + "|version=" + cli_clang_version_line(clang_cmd)
}

task cli_run_linker_identity(clang_cmd: word, lto: word, cross: word) -> word {
    pilot clang_target = cli_clang_target_triple(clang_cmd, cross)
    if clang_target == "" { give back CLI_RUN_UNHASHABLE + ":clang-target" }
    pilot linker_cmd = cli_selected_linker_command(clang_cmd, lto, cross)
    if linker_cmd == "" { give back CLI_RUN_UNHASHABLE + ":linker-trace" }
    pilot resolved = cli_run_resolve_program(linker_cmd)
    if resolved == "" { give back CLI_RUN_UNHASHABLE + ":linker-resolution:" + linker_cmd }
    pilot digest = cli_run_file_sha256(resolved)
    if digest == "" { give back CLI_RUN_UNHASHABLE + ":linker-digest:" + resolved }
    pilot version = cli_first_line(process::exec_capture(cli_shell_command_prefix(linker_cmd) + " --version 2>&1"))
    give back "target=" + clang_target + "|command=" + linker_cmd + "|resolved=" + resolved + "|digest=" + digest + "|version=" + version
}

task cli_run_cache_record(fingerprint: word, binary: word) -> word {
    pilot artifact = cli_run_file_fingerprint(binary)
    if artifact.contains(CLI_RUN_UNHASHABLE) { give back "" }
    give back fingerprint + "|artifact=" + artifact
}

task cli_run(src_file: word, target: word, profile: word, opt: word, lto: word, runtime_policy: word, runtime_stats: word, cross: word) -> int {
    -- Cache hits are still build operations from the distribution contract's
    -- perspective: never launch an artifact with a mismatched payload or while
    -- a Windows executable replacement is pending.
    if not cli_build_environment_ready() { give back 1 }

    pilot binary: word = cli_binary_path(src_file)
    pilot cache_file = binary + ".freak-run-cache"
    pilot fingerprint = cli_run_fingerprint(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
    pilot cache_hit = false

    if fingerprint == "" {
        say ""
        say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " Build inputs or the selected toolchain could not be hashed."
        say "  " + C_DIM + "Install a platform SHA-256 tool and verify Clang can report its linker with -###." + C_RESET
        give back 1
    }

    if fingerprint != "" and fs::exists(binary) and fs::exists(cache_file) {
        pilot expected_record = cli_run_cache_record(fingerprint, binary)
        if expected_record != "" and fs::read(cache_file) == expected_record { cache_hit = true }
    }

    if cache_hit {
        say ""
        say "  " + C_BGREEN + SYM_CHECK + " FRESH" + C_RESET + C_DIM + "  run cache hit" + C_RESET
    } else {
        -- Invalidate first. A rejected rebuild may leave an older binary on
        -- disk, but it must never leave proof that the binary is fresh.
        if fs::exists(cache_file) { fs::delete(cache_file) }
        binary = cli_build_profile(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
        if binary == "" { give back 1 }

        pilot confirmed = cli_run_fingerprint(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
        if confirmed == "" or confirmed != fingerprint {
            say ""
            say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " Build inputs changed while compiling."
            say "  " + C_DIM + "Run the command again after the files stop changing." + C_RESET
            give back 1
        }
        pilot confirmed_record = cli_run_cache_record(confirmed, binary)
        if confirmed_record == "" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " The built executable could not be hashed."
            give back 1
        }
        fs::write(cache_file, confirmed_record)
    }

    -- Revalidate both inputs and the output artifact immediately before
    -- launch. This rejects edits, failed/racing rebuilds, and externally
    -- replaced binaries that appear after the initial cache decision.
    pilot launch_fingerprint = cli_run_fingerprint(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
    pilot launch_record = cli_run_cache_record(launch_fingerprint, binary)
    if launch_fingerprint == "" or launch_record == "" or launch_fingerprint != fingerprint or not fs::exists(cache_file) or fs::read(cache_file) != launch_record {
        if fs::exists(cache_file) { fs::delete(cache_file) }
        say ""
        say "  " + C_BRED + SYM_CROSS + " RUN ABORTED" + C_RESET + " Build inputs or output changed before launch."
        say "  " + C_DIM + "Run the command again after competing writers stop." + C_RESET
        give back 1
    }
    if not cli_build_environment_ready() {
        if fs::exists(cache_file) { fs::delete(cache_file) }
        give back 1
    }

    say cli_box_top(45)
    say cli_box_mid(" " + C_G5 + SYM_ARROW + " RUNNING" + C_RESET + "  " + C_BWHITE + binary + C_RESET, 45)
    say cli_box_bot(45)
    say ""
    pilot run_path = binary
    if cli_is_windows() {
        run_path = run_path.replace("/", "\\")
    } else if not run_path.contains("/") {
        -- POSIX shells do not search the current directory. A source passed
        -- as `hello.fk` produces `hello`, which must be launched as `./hello`.
        run_path = "./" + run_path
    }
    pilot run_cmd: word = cli_shell_command_prefix(cli_quote_cmd_path(run_path))
    pilot run_start = time::now_ms()
    pilot run_code = process::exec(run_cmd)
    pilot run_elapsed = time::now_ms() - run_start
    say ""
    if run_code != 0 {
        pilot rc_str: word = word_from_int(run_code)
        say "  " + C_BYELLOW + SYM_BOLT + " EXIT" + C_RESET + C_DIM + " code " + rc_str + " (" + word_from_int(run_elapsed) + "ms)" + C_RESET
    } else {
        say "  " + C_BGREEN + SYM_CHECK + " DONE" + C_RESET + C_DIM + " (" + word_from_int(run_elapsed) + "ms)" + C_RESET
    }
    say ""
    give back run_code
}
