-- ===================================================================
-- FREAK Hangar — Lockfile (hangar.lock)
-- ===================================================================
-- Deterministic lockfile for reproducible builds.
-- Format: TOML with [[package]] entries.
-- Generated on first install, committed to version control.
-- ===================================================================

-- Lockfile data: parallel arrays for package entries
pilot lock_pkg_names = 0
pilot lock_pkg_versions = 0
pilot lock_pkg_sources = 0
pilot lock_pkg_sha256s = 0
pilot lock_pkg_count = 0

task lock_clear() -> void {
    lock_pkg_names = array_new()
    lock_pkg_versions = array_new()
    lock_pkg_sources = array_new()
    lock_pkg_sha256s = array_new()
    lock_pkg_count = 0
}

task lock_add_entry(name: word, version: word, source: word, sha256: word) -> void {
    -- Check if entry already exists, update if so
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot existing: word = array_get(lock_pkg_names, i)
        if existing == name {
            array_set(lock_pkg_versions, i, version)
            array_set(lock_pkg_sources, i, source)
            array_set(lock_pkg_sha256s, i, sha256)
            give back
        }
        i += 1
    }
    array_push(lock_pkg_names, name)
    array_push(lock_pkg_versions, version)
    array_push(lock_pkg_sources, source)
    array_push(lock_pkg_sha256s, sha256)
    lock_pkg_count += 1
}

task lock_remove_entry(name: word) -> void {
    pilot new_names = array_new()
    pilot new_versions = array_new()
    pilot new_sources = array_new()
    pilot new_sha256s = array_new()
    pilot new_count = 0
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n != name {
            array_push(new_names, array_get(lock_pkg_names, i))
            array_push(new_versions, array_get(lock_pkg_versions, i))
            array_push(new_sources, array_get(lock_pkg_sources, i))
            array_push(new_sha256s, array_get(lock_pkg_sha256s, i))
            new_count += 1
        }
        i += 1
    }
    lock_pkg_names = new_names
    lock_pkg_versions = new_versions
    lock_pkg_sources = new_sources
    lock_pkg_sha256s = new_sha256s
    lock_pkg_count = new_count
}

task lock_get_version(name: word) -> word {
    -- Returns the locked version for a package, or "" if not locked
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_versions, i)
        }
        i += 1
    }
    give back ""
}

task lock_get_source(name: word) -> word {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_sources, i)
        }
        i += 1
    }
    give back ""
}

task lock_has(name: word) -> bool {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back true
        }
        i += 1
    }
    give back false
}

-- ===================== LOCKFILE WRITING ==============================

task lock_write(path: word) -> void {
    pilot out = "# This file is auto-generated by Hangar. Do not edit manually.\n"
    out = out + "# Commit this file to version control for reproducible builds.\n\n"

    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot name: word = array_get(lock_pkg_names, i)
        pilot version: word = array_get(lock_pkg_versions, i)
        pilot source: word = array_get(lock_pkg_sources, i)
        pilot sha256: word = array_get(lock_pkg_sha256s, i)

        out = out + "[[package]]\n"
        out = out + "name    = \"" + name + "\"\n"
        out = out + "version = \"" + version + "\"\n"
        out = out + "source  = \"" + source + "\"\n"
        out = out + "sha256  = \"" + sha256 + "\"\n"
        out = out + "\n"
        i += 1
    }

    fs::write(path, out)
}

-- ===================== LOCKFILE PARSING ==============================

task lock_parse(content: word) -> void {
    lock_clear()

    -- Parse [[package]] entries from lockfile content
    -- Each entry has: name, version, source, sha256
    pilot pos = 0
    pilot clen = content.length()
    pilot cur_name = ""
    pilot cur_version = ""
    pilot cur_source = ""
    pilot cur_sha256 = ""
    pilot in_package = false

    repeat until pos >= clen {
        pilot line: word = toml_get_line(content, pos)
        pos = toml_line_end(content, pos)

        pilot trimmed: word = line.trim()

        if trimmed == "" {
            -- Empty line: if we have a complete package entry, save it
            if in_package and cur_name != "" {
                lock_add_entry(cur_name, cur_version, cur_source, cur_sha256)
                cur_name = ""
                cur_version = ""
                cur_source = ""
                cur_sha256 = ""
                in_package = false
            }
        } else if trimmed.starts_with("#") {
            -- Skip comments
        } else if trimmed == "[[package]]" {
            -- Save previous entry if any
            if in_package and cur_name != "" {
                lock_add_entry(cur_name, cur_version, cur_source, cur_sha256)
            }
            cur_name = ""
            cur_version = ""
            cur_source = ""
            cur_sha256 = ""
            in_package = true
        } else if in_package and trimmed.contains("=") {
            -- Parse key = "value" within a [[package]] block
            pilot kv_key: word = lock_parse_key(trimmed)
            pilot kv_val: word = lock_parse_val(trimmed)
            if kv_key == "name" {
                cur_name = kv_val
            } else if kv_key == "version" {
                cur_version = kv_val
            } else if kv_key == "source" {
                cur_source = kv_val
            } else if kv_key == "sha256" {
                cur_sha256 = kv_val
            }
        }
    }

    -- Don't forget the last entry
    if in_package and cur_name != "" {
        lock_add_entry(cur_name, cur_version, cur_source, cur_sha256)
    }
}

task lock_parse_key(line: word) -> word {
    -- Extract key from "key    = \"value\""
    pilot key = ""
    pilot i = 0
    pilot llen = line.length()
    repeat until i >= llen {
        pilot c: word = line.char_at(i)
        if c == " " or c == "\t" or c == "=" {
            if key != "" {
                give back key
            }
        } else {
            key = key + c
        }
        i += 1
    }
    give back key
}

task lock_parse_val(line: word) -> word {
    -- Extract value from "key    = \"value\""
    -- Find the = sign first, then extract quoted value
    pilot found_eq = false
    pilot i = 0
    pilot llen = line.length()
    repeat until i >= llen {
        pilot c: word = line.char_at(i)
        if c == "=" {
            found_eq = true
        } else if found_eq and c == "\"" {
            -- Start of quoted value
            pilot val = ""
            i += 1
            repeat until i >= llen {
                pilot vc: word = line.char_at(i)
                if vc == "\"" {
                    give back val
                }
                val = val + vc
                i += 1
            }
            give back val
        }
        i += 1
    }
    give back ""
}

-- ===================== LOCKFILE LOADING ==============================

task lock_load(path: word) -> bool {
    -- Load lockfile from disk. Returns true if loaded successfully.
    if fs::exists(path) == false {
        give back false
    }
    pilot content: word = fs::read(path)
    if content == "" {
        give back false
    }
    lock_parse(content)
    give back true
}
