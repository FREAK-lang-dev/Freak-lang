-- ===================================================================
-- FREAK Hangar — Lockfile (hangar.lock)
-- ===================================================================
-- Deterministic lockfile for reproducible builds.
-- Format: TOML with [[package]] entries.
-- Generated on first install, committed to version control.
-- ===================================================================

-- Lockfile data: parallel arrays for package entries
pilot lock_pkg_names = 0
pilot lock_pkg_versions = 0
pilot lock_pkg_sources = 0
pilot lock_pkg_sha256s = 0
pilot lock_pkg_count = 0

task lock_clear() -> void {
    lock_pkg_names = array_new()
    lock_pkg_versions = array_new()
    lock_pkg_sources = array_new()
    lock_pkg_sha256s = array_new()
    lock_pkg_count = 0
}

task lock_add_entry(name: word, version: word, source: word, sha256: word) -> void {
    -- Check if entry already exists, update if so
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot existing: word = array_get(lock_pkg_names, i)
        if existing == name {
            array_set(lock_pkg_versions, i, version)
            array_set(lock_pkg_sources, i, source)
            array_set(lock_pkg_sha256s, i, sha256)
            give back
        }
        i += 1
    }
    array_push(lock_pkg_names, name)
    array_push(lock_pkg_versions, version)
    array_push(lock_pkg_sources, source)
    array_push(lock_pkg_sha256s, sha256)
    lock_pkg_count += 1
}

task lock_remove_entry(name: word) -> void {
    pilot new_names = array_new()
    pilot new_versions = array_new()
    pilot new_sources = array_new()
    pilot new_sha256s = array_new()
    pilot new_count = 0
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n != name {
            array_push(new_names, array_get(lock_pkg_names, i))
            array_push(new_versions, array_get(lock_pkg_versions, i))
            array_push(new_sources, array_get(lock_pkg_sources, i))
            array_push(new_sha256s, array_get(lock_pkg_sha256s, i))
            new_count += 1
        }
        i += 1
    }
    lock_pkg_names = new_names
    lock_pkg_versions = new_versions
    lock_pkg_sources = new_sources
    lock_pkg_sha256s = new_sha256s
    lock_pkg_count = new_count
}

task lock_get_version(name: word) -> word {
    -- Returns the locked version for a package, or "" if not locked
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_versions, i)
        }
        i += 1
    }
    give back ""
}

task lock_get_source(name: word) -> word {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_sources, i)
        }
        i += 1
    }
    give back ""
}

task lock_has(name: word) -> bool {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back true
        }
        i += 1
    }
    give back false
}

-- ===================== LOCKFILE WRITING ==============================

task lock_write(path: word) -> void {
    pilot out = "# This file is auto-generated by Hangar. Do not edit manually.\n"
    out = out + "# Commit this file to version control for reproducible builds.\n\n"

    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot name: word = array_get(lock_pkg_names, i)
        pilot version: word = array_get(lock_pkg_versions, i)
        pilot source: word = array_get(lock_pkg_sources, i)
        pilot sha256: word = array_get(lock_pkg_sha256s, i)

        out = out + "[[package]]\n"
        out = out + "name    = " + toml_quote(name) + "\n"
        out = out + "version = " + toml_quote(version) + "\n"
        out = out + "source  = " + toml_quote(source) + "\n"
        out = out + "sha256  = " + toml_quote(sha256) + "\n"
        out = out + "\n"
        i += 1
    }

    fs::write(path, out)
}

-- ===================== LOCKFILE PARSING ==============================

-- Admission is deliberately legacy-only. A rejected existing graph is never
-- an absent generation; public callers must check lock_error before effects.
pilot lock_error = ""
pilot lock_loaded = false

task lock_fail(detail: word) -> bool {
    lock_error = detail
    lock_clear()
    give back false
}

task lock_legacy_entry(name: word, version: word, source: word, checksum: word) -> bool {
    if not hangar_valid_package_name(name) or version == "" or source == "" {
        give back lock_fail("partial legacy package entry: name, version and source are required")
    }
    if lock_has(name) { give back lock_fail("duplicate legacy package name") }
    if checksum != "" {
        if checksum.length() != 64 { give back lock_fail("invalid legacy SHA-256") }
        pilot i = 0
        repeat until i >= 64 {
            if not "0123456789abcdefABCDEF".contains(checksum.char_at(i)) { give back lock_fail("invalid legacy SHA-256") }
            i += 1
        }
    }
    lock_add_entry(name, version, source, checksum.to_lower())
    give back true
}

task lock_parse(content: word) -> bool {
    lock_clear()
    lock_error = ""
    if content == "" { give back lock_fail("empty lock document") }
    pilot pos = 0
    pilot name = ""
    pilot version = ""
    pilot source = ""
    pilot checksum = ""
    pilot seen = ""
    pilot in_package = false
    pilot saved_error = toml_error
    toml_error = ""
    repeat until pos >= content.length() {
        pilot line = toml_get_line(content, pos)
        pos = toml_line_end(content, pos)
        if line.length() > 8192 { toml_error = saved_error give back lock_fail("legacy lock line exceeds byte limit") }
        pilot trimmed = toml_strip_comment(line)
        if toml_error != "" { toml_error = saved_error give back lock_fail("malformed quoted legacy value") }
        if trimmed == "[[package]]" {
            if in_package and not lock_legacy_entry(name, version, source, checksum) { toml_error = saved_error give back false }
            if lock_pkg_count >= 1024 { toml_error = saved_error give back lock_fail("legacy package count exceeds limit") }
            name = ""
            version = ""
            source = ""
            checksum = ""
            seen = ""
            in_package = true
        } else if trimmed != "" {
            if not in_package { toml_error = saved_error give back lock_fail("unsupported lock schema; expected legacy [[package]] records") }
            pilot eq = toml_find_equals(trimmed)
            if eq <= 0 { toml_error = saved_error give back lock_fail("malformed legacy package field") }
            pilot key = trimmed.substring(0, eq).trim()
            if key != "name" and key != "version" and key != "source" and key != "sha256" { toml_error = saved_error give back lock_fail("unknown legacy package field") }
            pilot token = "|" + key + "|"
            if seen.contains(token) { toml_error = saved_error give back lock_fail("duplicate legacy package field") }
            seen = seen + token
            pilot raw = trimmed.substring(eq + 1, trimmed.length()).trim()
            if not raw.starts_with("\"") and not raw.starts_with("'") { toml_error = saved_error give back lock_fail("legacy package fields must be quoted strings") }
            pilot value = toml_unquote(raw)
            if toml_error != "" or value.contains("\n") or value.contains("\r") or value.contains("\t") { toml_error = saved_error give back lock_fail("malformed quoted legacy value") }
            if key == "name" { name = value } else if key == "version" { version = value } else if key == "source" { source = value } else { checksum = value }
        }
    }
    toml_error = saved_error
    if in_package and not lock_legacy_entry(name, version, source, checksum) { give back false }
    give back true
}

-- ===================== LOCKFILE LOADING ==============================

task lock_get_sha256(name: word) -> word {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_sha256s, i)
        }
        i += 1
    }
    give back ""
}

task lock_load(path: word) -> bool {
    lock_clear()
    lock_error = ""
    lock_loaded = false
    pilot directory = fs::open_dir_ticket(package_parent_path(path))
    if not fs::result_ok(directory) {
        lock_error = "cannot anchor legacy lock directory: " + fs::result_error(directory)
        fs::result_release(directory)
        give back false
    }
    pilot read = fs::read_relative_bytes_limit_ticket(directory, package_leaf_path(path), 1048576)
    fs::result_release(directory)
    if not fs::result_ok(read) {
        if not fs::result_missing(read) { lock_error = "cannot read legacy lock: " + fs::result_error(read) }
        fs::result_release(read)
        give back false
    }
    pilot bytes: ByteBuffer = fs::result_bytes(read)
    fs::result_release(read)
    pilot content = bytes.to_word()
    pilot text = bytes.status() == 0
    pilot index = 0
    repeat until index >= bytes.length() {
        pilot byte = bytes.read_byte()
        if byte == 127 or (byte < 32 and byte != 9 and byte != 10 and byte != 13) { text = false }
        index += 1
    }
    bytes.release()
    if not text { give back lock_fail("legacy lock must be UTF-8 text without NUL") }
    lock_loaded = lock_parse(content)
    give back lock_loaded
}
