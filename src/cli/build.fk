-- ===================================================================
-- FREAK CLI — Build Pipeline
-- ===================================================================
-- Handles: transpile .fk → .c/.ll, then invoke clang to produce binary.
-- ===================================================================

task cli_transpile(src_file: word, source: word, target: word) -> word {
    -- Returns the output file path (.c or .ll), or "" on error.
    init_arrays()

    say "[1/4] Lexing..."
    tokenize(source)

    say "[2/4] Parsing..."
    parse_program()

    say "[3/4] Type Checking..."
    check_program()

    say "[4/4] Emitting..."
    if target == "llvm" {
        pilot out_ll = src_file + ".ll"
        llvm_out_file = out_ll
        fs::write(out_ll, "")
        emit_llvm_program()
        llvm_out_file = ""
        pilot msg_ll = "Generated LLVM IR at " + out_ll
        say msg_ll
        give back out_ll
    } else {
        emit_program()
        pilot out_c = src_file + ".c"
        fs::write(out_c, out_buf)
        pilot msg_c = "Generated C code at " + out_c
        say msg_c
        give back out_c
    }
}

task cli_find_runtime_dir() -> word {
    -- Try to find the runtime directory.
    -- 1. Check relative to CWD (dev / repo layout)
    if fs::exists("freakc/runtime/freak_runtime.c") {
        give back "freakc/runtime"
    }
    -- 2. Check ~/.freak/runtime/ (install.sh layout)
    pilot home_dir: word = process::env("HOME")
    if home_dir != "" {
        pilot home_rt = home_dir + "/.freak/runtime/freak_runtime.c"
        if fs::exists(home_rt) {
            give back home_dir + "/.freak/runtime"
        }
    }
    -- 3. Check %APPDATA%\freak\runtime\ (install.ps1 layout on Windows)
    pilot appdata_dir: word = process::env("APPDATA")
    if appdata_dir != "" {
        pilot appdata_rt = appdata_dir + "/freak/runtime/freak_runtime.c"
        if fs::exists(appdata_rt) {
            give back appdata_dir + "/freak/runtime"
        }
    }
    -- 4. Check $FREAK_HOME/runtime/ (custom install location)
    pilot freak_home: word = process::env("FREAK_HOME")
    if freak_home != "" {
        pilot fh_rt = freak_home + "/runtime/freak_runtime.c"
        if fs::exists(fh_rt) {
            give back freak_home + "/runtime"
        }
    }
    -- 5. Fallback: check if runtime is in current dir
    if fs::exists("freak_runtime.c") {
        give back "."
    }
    give back ""
}

task cli_build_binary(transpiled_file: word, src_file: word, target: word, opt: word, cross: word) -> word {
    -- Compile the transpiled .c or .ll file into a native binary.
    -- Returns the output binary path, or "" on error.

    pilot runtime_dir: word = cli_find_runtime_dir()
    if runtime_dir == "" {
        say "Error: Could not find FREAK runtime directory."
        say "Expected: freakc/runtime/freak_runtime.c"
        give back ""
    }

    -- Determine output binary name (strip .fk extension, add .exe on Windows)
    pilot out_bin = src_file
    -- Strip .fk suffix if present
    if src_file.ends_with(".fk") {
        pilot oi = 0
        pilot oname = ""
        pilot olen = src_file.length() - 3
        repeat until oi >= olen {
            oname = oname + src_file.char_at(oi)
            oi += 1
        }
        out_bin = oname
    }
    -- Only add .exe on Windows
    pilot windir: word = process::env("WINDIR")
    if windir != "" {
        out_bin = out_bin + ".exe"
    }

    -- Build clang command
    pilot runtime_c = ""
    if target == "llvm" {
        runtime_c = runtime_dir + "/freak_llvm_runtime.c"
    } else {
        runtime_c = runtime_dir + "/freak_runtime.c"
    }

    pilot cmd = "clang -o " + out_bin + " " + transpiled_file + " " + runtime_c + " -I" + runtime_dir + " -O" + opt + " -w -D_CRT_SECURE_NO_WARNINGS"

    -- Linux requires -lm for math functions
    if windir == "" {
        cmd = cmd + " -lm"
    }

    if cross != "" {
        cmd = cmd + " --target=" + cross
    }

    pilot compile_msg = "Compiling: " + cmd
    say compile_msg

    pilot exit_code = process::exec(cmd)
    if exit_code != 0 {
        say "Error: clang compilation failed."
        give back ""
    }

    pilot done_msg = "Built: " + out_bin
    say done_msg
    give back out_bin
}

task cli_build(src_file: word, target: word, opt: word, cross: word) -> word {
    -- Full build pipeline: read source, transpile, compile.
    -- Returns the output binary path, or "" on error.
    pilot source: word = fs::read(src_file)
    if source == "" {
        pilot err_msg = "Error: Could not read file: " + src_file
        say err_msg
        give back ""
    }

    pilot transpiled: word = cli_transpile(src_file, source, target)
    if transpiled == "" {
        give back ""
    }

    pilot binary: word = cli_build_binary(transpiled, src_file, target, opt, cross)
    give back binary
}
