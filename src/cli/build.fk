-- ===================================================================
-- FREAK CLI — Build Pipeline
-- ===================================================================
-- Handles: transpile .fk → .c/.ll, then invoke clang to produce binary.
-- ===================================================================

-- Timing state for build steps
pilot cli_build_start_ms = 0
pilot cli_step_ms = 0

task cli_step_start() -> void {
    cli_step_ms = time::now_ms()
}

task cli_step_done(label: word) -> void {
    pilot elapsed = time::now_ms() - cli_step_ms
    pilot elapsed_str = word_from_int(elapsed)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + "  " + label + C_DIM + " (" + elapsed_str + "ms)" + C_RESET
}

task cli_count_lines(s: word) -> int {
    if s == "" { give back 0 }
    pilot count = 1
    pilot i = 0
    pilot slen = s.length()
    repeat until i >= slen {
        if s.char_at(i) == "\n" {
            count += 1
        }
        i += 1
    }
    give back count
}

task cli_strip_resolved_use_lines(source: word) -> word {
    pilot out = ""
    pilot line = ""
    pilot i = 0
    pilot slen = source.length()
    -- When `in_use_block` is set we're inside a multi-line `use std::x::{ ... }`
    -- that spans newlines. Keep stripping until we see the closing brace.
    pilot in_use_block = false
    repeat until i >= slen {
        pilot ch = source.char_at(i)
        if ch == "\n" {
            pilot trimmed = line.trim()
            if in_use_block {
                out = out + "-- [resolved cont] " + trimmed + "\n"
                if trimmed.contains("}") { in_use_block = false }
            } else {
                if trimmed.starts_with("use ") {
                    out = out + "-- [resolved] " + trimmed + "\n"
                    -- Multi-line use? Look for `{` without a matching `}` on
                    -- the same line — keep eating lines until we see `}`.
                    if trimmed.contains("{") and not trimmed.contains("}") {
                        in_use_block = true
                    }
                } else {
                    out = out + line + "\n"
                }
            }
            line = ""
        } else if ch != "\r" {
            line = line + ch
        }
        i += 1
    }
    if line != "" {
        pilot trimmed_last = line.trim()
        if in_use_block or trimmed_last.starts_with("use ") {
            out = out + "-- [resolved] " + trimmed_last
        } else {
            out = out + line
        }
    }
    give back out
}

task cli_transpile(src_file: word, source: word, target: word) -> word {
    -- Returns the output file path (.c or .ll), or "" on error.
    input_file = src_file
    init_arrays()

    cli_step_start()
    tokenize(source)
    adjust_token_lines(source_line_offset)
    cli_step_done("Lexing")

    cli_step_start()
    parse_program()
    cli_step_done("Parsing")

    cli_step_start()
    check_program()
    if strict_borrow {
        cli_step_done("Borrow checking")
        if error_count > 0 {
            say "  " + C_BRED + SYM_CROSS + " " + word_from_int(error_count) + " borrow-check error(s)" + C_RESET
            give back ""
        }
    } else {
        cli_step_done("Type checking")
    }

    cli_step_start()
    if target == "llvm" {
        pilot out_ll = src_file + ".ll"
        out_file = out_ll
        fs::write(out_ll, "")
        emit_llvm_program()
        out_file = ""
        cli_step_done("Emit LLVM IR")
        give back out_ll
    } else {
        pilot out_c = src_file + ".c"
        out_file = out_c
        fs::write(out_c, "")
        emit_c_program()
        out_file = ""
        cli_step_done("Emit C")
        give back out_c
    }
}

task cli_has_runtime(dir: word) -> bool {
    -- Check if a directory contains runtime files (.o or .c)
    pilot c_path = dir + "/freak_runtime.c"
    pilot o_path = dir + "/freak_runtime.o"
    if fs::exists(c_path) { give back true }
    if fs::exists(o_path) { give back true }
    give back false
}

task cli_find_runtime_dir() -> word {
    -- Try to find the runtime directory.
    -- 1. Check relative to CWD (dev / repo layout)
    if cli_has_runtime("freakc/runtime") {
        give back "freakc/runtime"
    }
    -- 2. Check ~/.freak/runtime/ (install.sh layout)
    pilot home_dir: word = process::env("HOME")
    if home_dir != "" {
        pilot home_rt = home_dir + "/.freak/runtime"
        if cli_has_runtime(home_rt) {
            give back home_rt
        }
    }
    -- 3. Check %APPDATA%\freak\runtime\ (install.ps1 layout on Windows)
    pilot appdata_dir: word = process::env("APPDATA")
    if appdata_dir != "" {
        pilot appdata_rt = appdata_dir + "/freak/runtime"
        if cli_has_runtime(appdata_rt) {
            give back appdata_rt
        }
    }
    -- 4. Check $FREAK_HOME/runtime/ (custom install location)
    pilot freak_home: word = process::env("FREAK_HOME")
    if freak_home != "" {
        pilot fh_rt = freak_home + "/runtime"
        if cli_has_runtime(fh_rt) {
            give back fh_rt
        }
    }
    -- 5. Fallback: check if runtime is in current dir
    if fs::exists("freak_runtime.c") {
        give back "."
    }
    if fs::exists("freak_runtime.o") {
        give back "."
    }
    give back ""
}

task cli_strip_fk(path: word) -> word {
    -- Strip .fk suffix from a file path
    if path.ends_with(".fk") {
        pilot oi = 0
        pilot oname = ""
        pilot olen = path.length() - 3
        repeat until oi >= olen {
            oname = oname + path.char_at(oi)
            oi += 1
        }
        give back oname
    }
    give back path
}

task cli_is_windows() -> bool {
    pilot windir: word = process::env("WINDIR")
    if windir != "" { give back true }
    give back false
}

task cli_first_line(text: word) -> word {
    pilot line = ""
    pilot i = 0
    pilot finished = false
    repeat until finished {
        if i >= text.length() { finished = true }
        else {
            pilot ch: word = text.char_at(i)
            if ch == "\n" or ch == "\r" { finished = true }
            else { line = line + ch }
        }
        i += 1
    }
    give back line
}

task cli_quote_cmd_path(path: word) -> word {
    give back "\"" + path + "\""
}

task cli_find_clang_command() -> word {
    pilot override: word = process::env("FREAK_CLANG")
    if override != "" {
        give back override
    }

    if cli_is_windows() {
        if process::exec("where clang >nul 2>nul") == 0 { give back "clang" }
        if process::exec("where clang.exe >nul 2>nul") == 0 { give back "clang" }

        pilot llvm_home: word = process::env("LLVM_HOME")
        if llvm_home != "" {
            pilot llvm_home_clang = llvm_home + "/bin/clang.exe"
            if fs::exists(llvm_home_clang) { give back cli_quote_cmd_path(llvm_home_clang) }
        }

        pilot program_files: word = process::env("ProgramFiles")
        if program_files != "" {
            pilot pf_clang = program_files + "/LLVM/bin/clang.exe"
            if fs::exists(pf_clang) { give back cli_quote_cmd_path(pf_clang) }
        }

        pilot program_w6432: word = process::env("ProgramW6432")
        if program_w6432 != "" {
            pilot pw_clang = program_w6432 + "/LLVM/bin/clang.exe"
            if fs::exists(pw_clang) { give back cli_quote_cmd_path(pw_clang) }
        }

        pilot program_files_x86: word = process::env("ProgramFiles(x86)")
        if program_files_x86 != "" {
            pilot pfx_clang = program_files_x86 + "/LLVM/bin/clang.exe"
            if fs::exists(pfx_clang) { give back cli_quote_cmd_path(pfx_clang) }
        }

        pilot local_appdata: word = process::env("LOCALAPPDATA")
        if local_appdata != "" {
            pilot local_clang = local_appdata + "/Programs/LLVM/bin/clang.exe"
            if fs::exists(local_clang) { give back cli_quote_cmd_path(local_clang) }
        }
    } else {
        if process::exec("clang --version >/dev/null 2>/dev/null") == 0 { give back "clang" }
        if process::exec("clang-18 --version >/dev/null 2>/dev/null") == 0 { give back "clang-18" }
        if process::exec("clang-17 --version >/dev/null 2>/dev/null") == 0 { give back "clang-17" }
        if process::exec("clang-16 --version >/dev/null 2>/dev/null") == 0 { give back "clang-16" }
    }

    give back ""
}

task cli_clang_version_line(clang_cmd: word) -> word {
    if clang_cmd == "" { give back "" }
    pilot clang_ver: word = process::exec_capture(clang_cmd + " --version")
    give back cli_first_line(clang_ver)
}

task cli_clang_command_works(clang_cmd: word) -> bool {
    if clang_cmd == "" { give back false }
    if cli_is_windows() {
        if process::exec(clang_cmd + " --version >nul 2>nul") == 0 { give back true }
    } else {
        if process::exec(clang_cmd + " --version >/dev/null 2>/dev/null") == 0 { give back true }
    }
    give back false
}

task cli_has_precompiled_runtime(runtime_dir: word) -> bool {
    -- Check if pre-compiled .obj/.o runtime files exist (bundle mode)
    pilot rt_obj = runtime_dir + "/freak_runtime.obj"
    pilot llvm_obj = runtime_dir + "/freak_llvm_runtime.obj"
    if fs::exists(rt_obj) {
        if fs::exists(llvm_obj) { give back true }
    }
    -- Also check .o extension (Linux/macOS)
    pilot rt_o = runtime_dir + "/freak_runtime.o"
    pilot llvm_o = runtime_dir + "/freak_llvm_runtime.o"
    if fs::exists(rt_o) {
        if fs::exists(llvm_o) { give back true }
    }
    give back false
}

task cli_build_binary(transpiled_file: word, src_file: word, target: word, opt: word, cross: word) -> word {
    -- Compile the transpiled .c or .ll file into a native binary.
    -- Returns the output binary path, or "" on error.

    pilot runtime_dir: word = cli_find_runtime_dir()
    if runtime_dir == "" {
        say ""
        say C_BRED + "  RUNTIME NOT FOUND" + C_RESET
        say ""
        say C_DIM + "  The runtime is needed to compile FREAK programs." + C_RESET
        say C_DIM + "  Searched in:" + C_RESET
        say "    freakc/runtime/           " + C_DIM + "(dev/repo)" + C_RESET
        say "    ~/.freak/runtime/         " + C_DIM + "(install.sh)" + C_RESET
        say "    %APPDATA%\\freak\\runtime\\  " + C_DIM + "(install.ps1)" + C_RESET
        say "    $FREAK_HOME/runtime/      " + C_DIM + "(custom)" + C_RESET
        say ""
        say C_DIM + "  Fix: Re-run the install script, or run '" + C_RESET + "freak doctor" + C_DIM + "'." + C_RESET
        give back ""
    }

    -- Determine output binary name
    pilot out_bin = cli_strip_fk(src_file)
    if cli_is_windows() { out_bin = out_bin + ".exe" }

    pilot is_win = cli_is_windows()
    pilot use_bundle = false

    -- Bundle mode: pre-compiled .obj + lld-link (LLVM backend only, no clang needed for link)
    if target == "llvm" {
        if cli_has_precompiled_runtime(runtime_dir) and not is_win {
            use_bundle = true
        }
    }

    if use_bundle {
        -- BUNDLE MODE: .ll -> .obj (clang -c), then lld-link with pre-compiled runtime
        pilot obj_ext = ".obj"
        if not is_win { obj_ext = ".o" }

        -- Step 1: Compile LLVM IR to object file
        pilot user_obj = cli_strip_fk(src_file) + obj_ext
        pilot clang_cmd = cli_find_clang_command()
        if clang_cmd == "" { clang_cmd = "clang" }
        pilot cc_cmd = clang_cmd + " -c -g -o " + user_obj + " " + transpiled_file + " -O" + opt + " -w"
        if cross != "" { cc_cmd = cc_cmd + " --target=" + cross }

        say "  " + C_DIM + SYM_GEAR + "  Compiling IR..." + C_RESET
        pilot cc_exit = process::exec(cc_cmd)
        if cc_exit != 0 {
            say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- IR compilation error" + C_RESET
            give back ""
        }

        -- Step 2: Link with lld-link (Windows) or ld.lld (Linux/macOS)
        pilot rt_obj = runtime_dir + "/freak_runtime" + obj_ext
        pilot llvm_rt_obj = runtime_dir + "/freak_llvm_runtime" + obj_ext
        pilot ui_obj = runtime_dir + "/freak_ui_win32" + obj_ext

        if is_win {
            -- user_obj first (FREAK impls), then llvm_rt_obj (libc wrappers), then rt_obj (word/array fns)
            -- /FORCE:MULTIPLE resolves duplicates by using first definition seen
            pilot link_cmd = "lld-link /FORCE:MULTIPLE " + user_obj + " " + llvm_rt_obj + " " + rt_obj
            -- Add UI runtime if it exists
            if fs::exists(ui_obj) {
                link_cmd = link_cmd + " " + ui_obj
            }
            link_cmd = link_cmd + " /out:" + out_bin + " /subsystem:console"
            pilot pdb_out = cli_strip_fk(src_file) + ".pdb"
            link_cmd = link_cmd + " /debug /pdb:" + pdb_out
            link_cmd = link_cmd + " libcmt.lib user32.lib gdi32.lib msimg32.lib ws2_32.lib"
            say "  " + C_DIM + SYM_GEAR + "  Linking..." + C_RESET
            pilot link_exit = process::exec(link_cmd)
            if link_exit != 0 {
                say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- link error" + C_RESET
                give back ""
            }
        }
        if not is_win {
            -- user_obj first (FREAK), then llvm_rt_obj (libc wrappers), then rt_obj (word/array fns)
            pilot link_cmd = "ld.lld --allow-multiple-definition -o " + out_bin + " " + user_obj + " " + llvm_rt_obj + " " + rt_obj
            if fs::exists(ui_obj) {
                link_cmd = link_cmd + " " + ui_obj
            }
            link_cmd = link_cmd + " -lc -lm"
            say "  " + C_DIM + SYM_GEAR + "  Linking..." + C_RESET
            pilot link_exit = process::exec(link_cmd)
            if link_exit != 0 {
                say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- link error" + C_RESET
                give back ""
            }
        }

        give back out_bin
    }

    -- LEGACY MODE: clang does everything (transpiled + runtime source -> binary)
    -- LLVM builds need both runtimes: freak_runtime.c (word/array/io functions)
    -- and freak_llvm_runtime.c (math/tcp/time bridge functions)
    pilot runtime_file = ""
    if target == "llvm" {
        -- llvm_runtime first (libc wrappers + LLVM bridge), then freak_runtime (word/array fns)
        -- -z muldefs on Linux allows duplicate symbols (freak_word_length, freak_llvm_fs_*)
        pilot llvm_rt_c = runtime_dir + "/freak_llvm_runtime.c"
        pilot rt_c = runtime_dir + "/freak_runtime.c"
        runtime_file = llvm_rt_c + " " + rt_c
    } else {
        runtime_file = runtime_dir + "/freak_runtime.c"
    }

    pilot clang_cmd = cli_find_clang_command()
    if clang_cmd == "" { clang_cmd = "clang" }
    pilot cmd = clang_cmd + " -g -o " + out_bin + " " + transpiled_file + " " + runtime_file
    cmd = cmd + " -I" + runtime_dir + " -O" + opt + " -w -D_CRT_SECURE_NO_WARNINGS"

    if not is_win {
        cmd = cmd + " -lm"
    }
    if is_win {
        cmd = cmd + " -lws2_32"
    }

    -- Add UI runtime if source file uses ui:: functions.
    -- -DFREAK_HAS_UI activates the LLVM-side bridge wrappers
    -- (freak_llvm_ui_*) inside freak_llvm_runtime.c.
    pilot ui_c = runtime_dir + "/ui/win32_backend.c"
    if is_win {
        if fs::exists(ui_c) {
            cmd = cmd + " " + ui_c + " -DFREAK_HAS_UI -luser32 -lgdi32 -lmsimg32"
        }
    }

    if cross != "" {
        cmd = cmd + " --target=" + cross
    }

    say "  " + C_DIM + SYM_GEAR + "  Compiling native binary..." + C_RESET

    pilot exit_code = process::exec(cmd)
    if exit_code != 0 {
        say ""
        say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- clang compilation error" + C_RESET
        say ""
        say C_DIM + "  Make sure clang is installed and in your PATH:" + C_RESET
        say "    Windows: " + C_CYAN + "choco install llvm" + C_RESET + "  or  " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
        say "    macOS:   " + C_CYAN + "xcode-select --install" + C_RESET + "  or  " + C_CYAN + "brew install llvm" + C_RESET
        say "    Linux:   " + C_CYAN + "sudo apt install clang" + C_RESET + "  or  " + C_CYAN + "sudo dnf install clang" + C_RESET
        say ""
        say C_DIM + "  Run '" + C_RESET + "freak doctor" + C_DIM + "' to diagnose your setup." + C_RESET
        give back ""
    }

    give back out_bin
}

task cli_find_std_dir() -> word {
    -- Try to find the std/ directory.
    if fs::exists("std/math.fk") { give back "std" }
    pilot home_dir: word = process::env("HOME")
    if home_dir != "" {
        pilot home_std = home_dir + "/.freak/std"
        if fs::exists(home_std + "/math.fk") { give back home_std }
    }
    pilot appdata_dir: word = process::env("APPDATA")
    if appdata_dir != "" {
        pilot app_std = appdata_dir + "/freak/std"
        if fs::exists(app_std + "/math.fk") { give back app_std }
    }
    pilot freak_home: word = process::env("FREAK_HOME")
    if freak_home != "" {
        pilot fh_std = freak_home + "/std"
        if fs::exists(fh_std + "/math.fk") { give back fh_std }
    }
    give back ""
}

task cli_load_std(source: word, target: word) -> word {
    -- Load the standard library source files.
    -- Returns concatenated source, or "" if std not found.
    pilot std_dir: word = cli_find_std_dir()
    if std_dir == "" { give back "" }
    pilot std_src = ""
    pilot math_path = std_dir + "/math.fk"
    if fs::exists(math_path) {
        std_src = std_src + fs::read(math_path) + "\n"
    }
    pilot string_path = std_dir + "/string.fk"
    if fs::exists(string_path) {
        std_src = std_src + fs::read(string_path) + "\n"
    }
    pilot convert_path = std_dir + "/convert.fk"
    if fs::exists(convert_path) {
        std_src = std_src + fs::read(convert_path) + "\n"
    }
    pilot algo_path = std_dir + "/algorithm.fk"
    if fs::exists(algo_path) {
        std_src = std_src + fs::read(algo_path) + "\n"
    }
    pilot need_math3d = false
    if source.contains("use std::math3d") {
        need_math3d = true
    }
    if source.contains("use std::math3d::{") {
        need_math3d = true
    }
    pilot math3d_path = std_dir + "/math3d.fk"
    if need_math3d and fs::exists(math3d_path) {
        std_src = std_src + fs::read(math3d_path) + "\n"
    }
    pilot need_zip = false
    if source.contains("use std::zip") {
        need_zip = true
    }
    if source.contains("use std::zip::{") {
        need_zip = true
    }
    pilot zip_path = std_dir + "/zip.fk"
    if need_zip and fs::exists(zip_path) {
        std_src = std_src + fs::read(zip_path) + "\n"
    }
    pilot json_path = std_dir + "/json.fk"
    if fs::exists(json_path) {
        std_src = std_src + fs::read(json_path) + "\n"
    }
    pilot version_path = std_dir + "/version.fk"
    if fs::exists(version_path) {
        std_src = std_src + fs::read(version_path) + "\n"
    }
    -- std::ui — window and canvas types. Loaded conditionally because most
    -- programs don't need it, and pulling its shape definitions into every
    -- compile would slow plain CLI builds. Without it, programs that
    -- `use std::ui` would parse `WindowConfig { ... }` as an identifier
    -- followed by an unrecognized block, since `is_shape_name` looks at
    -- the current shape registry only.
    pilot need_ui = false
    if source.contains("use std::ui") {
        need_ui = true
    }
    pilot ui_path = std_dir + "/ui/window.fk"
    if need_ui and fs::exists(ui_path) {
        std_src = std_src + fs::read(ui_path) + "\n"
    }
    -- cockpit — UI framework Hangar package. Mirrors the std::ui pattern:
    -- if the source mentions `use cockpit`, append the cockpit src files
    -- so its shapes (UI, Theme) and module-level pilots (btn_*, label_*)
    -- are in scope. Order matters: containers first, then theme, layout,
    -- widgets, ui (the dispatcher).
    pilot need_cockpit = false
    if source.contains("use cockpit") {
        need_cockpit = true
    }
    if need_cockpit {
        pilot cockpit_root = "packages/cockpit/src"
        if fs::exists(cockpit_root + "/containers.fk") {
            std_src = std_src + fs::read(cockpit_root + "/containers.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/theme.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/layout.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/widgets.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/ui.fk") + "\n"
        }
    }
    -- http.fk uses TCP socket functions (tcp_recv_all returns freak_word)
    -- which only work correctly with the LLVM backend's i64 representation.
    -- The C backend's freak_word struct type causes type mismatches.
    if target == "llvm" {
        pilot http_path = std_dir + "/http.fk"
        if fs::exists(http_path) {
            std_src = std_src + fs::read(http_path) + "\n"
        }
    }
    -- Runtime must be loaded FIRST so its extern declarations and task
    -- definitions are available before user code that calls fs::read, etc.
    -- NOTE: runtime.fk contains i64-based extern declarations designed for
    -- the LLVM backend. The C backend gets these from freak_runtime.h via
    -- #include, so loading runtime.fk with --c causes type conflicts.
    if target == "llvm" {
        pilot rt_path = std_dir + "/runtime.fk"
        if fs::exists(rt_path) {
            std_src = fs::read(rt_path) + "\n" + std_src
        }
    }
    give back std_src
}

task cli_build(src_file: word, target: word, opt: word, cross: word) -> word {
    -- Full build pipeline: read source, transpile, compile.
    -- Returns the output binary path, or "" on error.
    cli_build_start_ms = time::now_ms()

    pilot source: word = fs::read(src_file)
    if source == "" {
        say ""
        say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + C_BWHITE + src_file + C_RESET
        give back ""
    }

    -- Build header with box
    pilot backend_label = "LLVM IR"
    if target == "c" { backend_label = "C" }
    say ""
    say cli_box_top(45)
    say cli_box_mid(" " + C_G1 + SYM_BOLT + " FREAK" + C_RESET + "  " + C_BWHITE + src_file + C_RESET, 45)
    say cli_box_mid(" " + C_DIM + "  Backend: " + C_RESET + C_BCYAN + backend_label + C_RESET + C_DIM + "  Opt: -O" + opt + C_RESET, 45)
    say cli_box_bot(45)
    say ""

    -- Auto-include standard library if available
    pilot std_source: word = cli_load_std(source, target)
    source_line_offset = 0
    if std_source != "" {
        std_source = cli_strip_resolved_use_lines(std_source)
        source_line_offset = cli_count_lines(std_source)
        source = cli_strip_resolved_use_lines(source)
        source = std_source + source
    }

    pilot transpiled: word = cli_transpile(src_file, source, target)
    if transpiled == "" {
        say ""
        say "  " + C_BRED + SYM_SKULL + " BUILD FAILED" + C_RESET
        say "  " + C_DIM + C_ITALIC + cli_fail_quote(time::now_ms()) + C_RESET
        say ""
        give back ""
    }

    cli_step_start()
    pilot binary: word = cli_build_binary(transpiled, src_file, target, opt, cross)
    if binary == "" {
        say ""
        say "  " + C_BRED + SYM_SKULL + " BUILD FAILED" + C_RESET
        say "  " + C_DIM + C_ITALIC + cli_fail_quote(time::now_ms()) + C_RESET
        say ""
        give back ""
    }
    cli_step_done("Native binary")

    -- Success summary
    pilot total_ms = time::now_ms() - cli_build_start_ms
    pilot total_str = word_from_int(total_ms)
    say ""
    say cli_box_top(45)
    say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " BUILD SUCCESSFUL" + C_RESET, 45)
    say cli_box_sep(45)
    say cli_box_mid("  " + C_DIM + "Binary: " + C_RESET + C_BWHITE + binary + C_RESET, 45)
    say cli_box_mid("  " + C_DIM + "Time:   " + C_RESET + C_BCYAN + total_str + "ms" + C_RESET, 45)
    say cli_box_bot(45)
    say ""
    say "  " + C_DIM + C_ITALIC + cli_random_quote(total_ms) + C_RESET
    say ""

    give back binary
}
