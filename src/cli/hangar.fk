-- ===================================================================
-- FREAK Hangar — Package Manager (native FREAK implementation)
-- ===================================================================
-- Commands: init, add, remove, install, update, version
-- Uses toml.fk for hangar.toml parsing/writing.
-- Uses lockfile.fk for hangar.lock generation/reading.
-- Uses git clone for package downloads (no zip handling needed).
-- ===================================================================

pilot HANGAR_DEFAULT_REGISTRY = "https://index.hangar.dev"

-- Arg offset for standalone mode: when invoked as "hangar <cmd>",
-- args are shifted by 1 compared to "freak hangar <cmd>".
pilot hangar_arg_offset = 0

task hangar_arg(idx: int) -> word {
    give back process::arg(idx - hangar_arg_offset)
}

task hangar_init(project_dir: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) {
        pilot msg = "  hangar.toml already exists in " + project_dir
        say msg
        give back 1
    }

    -- Create project directory if it doesn't exist
    if fs::exists(project_dir) == false {
        fs::make_dir(project_dir)
    }

    -- Get project name from directory (last component)
    pilot project_name: word = hangar_basename(project_dir)

    toml_clear()
    toml_set("project.name", project_name)
    toml_set("project.version", "0.1.0")
    toml_write_file(manifest)

    -- Create src/main.fk
    pilot src_dir = project_dir + "/src"
    pilot src_main = src_dir + "/main.fk"
    if fs::exists(src_dir) == false {
        fs::make_dir(src_dir)
    }
    if fs::exists(src_main) == false {
        pilot main_content = "-- " + project_name + " -- a FREAK project\n\nsay \"Hello from " + project_name + "!\"\n"
        fs::write(src_main, main_content)
    }

    -- Create hangar_modules/
    pilot modules_dir = project_dir + "/hangar_modules"
    if fs::exists(modules_dir) == false {
        fs::make_dir(modules_dir)
    }

    say ""
    say C_BGREEN + "  INITIALIZED" + C_RESET + " " + C_BWHITE + project_name + C_RESET
    say ""
    say C_DIM + "    hangar.toml" + C_RESET
    say C_DIM + "    src/main.fk" + C_RESET
    say C_DIM + "    hangar_modules/" + C_RESET
    say ""
    pilot next_msg = C_DIM + "  Next: " + C_RESET + "cd " + project_dir + " && freak run src/main.fk"
    say next_msg
    say ""
    give back 0
}

task hangar_add(project_dir: word, pkg_name: word, repo: word, ver: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    if repo == "" {
        -- Short syntax: version constraint only (e.g. hangar add muvluv ^1.0)
        pilot ver_key = "dependencies." + pkg_name + ".version"
        toml_set(ver_key, ver)
        toml_write_file(manifest)

        pilot msg = C_BGREEN + "  + " + C_RESET + C_BWHITE + pkg_name + C_RESET + C_DIM + " (" + ver + ")" + C_RESET
        say msg
        give back 0
    }

    pilot git_key = "dependencies." + pkg_name + ".git"
    pilot ver_key2 = "dependencies." + pkg_name + ".version"
    toml_set(git_key, repo)
    toml_set(ver_key2, ver)
    toml_write_file(manifest)

    pilot msg2 = C_BGREEN + "  + " + C_RESET + C_BWHITE + pkg_name + C_RESET + C_DIM + " (" + repo + " @ " + ver + ")" + C_RESET
    say msg2

    -- Also install it
    pilot install_res = hangar_install_one(project_dir, pkg_name, repo, ver)

    -- Update lockfile
    if install_res == 0 {
        pilot lockfile = project_dir + "/hangar.lock"
        lock_load(lockfile)
        pilot lock_source = "git+" + repo
        if repo == "" { lock_source = "local" }
        lock_add_entry(pkg_name, ver, lock_source, "")
        lock_write(lockfile)
    }

    give back install_res
}

task hangar_remove(project_dir: word, pkg_name: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot git_key = "dependencies." + pkg_name + ".git"
    pilot ver_only_key = "dependencies." + pkg_name + ".version"
    if toml_has(git_key) == false and toml_has(ver_only_key) == false {
        pilot msg = "  Package '" + pkg_name + "' is not in hangar.toml"
        say msg
        give back 1
    }

    -- Remove from toml
    pilot prefix = "dependencies." + pkg_name
    toml_remove_prefix(prefix)
    toml_write_file(manifest)

    -- Remove from lockfile if present
    pilot lockfile = project_dir + "/hangar.lock"
    if fs::exists(lockfile) {
        lock_load(lockfile)
        lock_remove_entry(pkg_name)
        lock_write(lockfile)
    }

    -- Remove cached files
    pilot pkg_dir = project_dir + "/hangar_modules/" + pkg_name
    if fs::exists(pkg_dir) {
        pilot rm_cmd: word = hangar_rm_cmd(pkg_dir)
        process::exec(rm_cmd)
    }

    pilot msg2 = C_BRED + "  - " + C_RESET + C_BWHITE + pkg_name + C_RESET
    say msg2
    give back 0
}

-- ===================== HG6: DEPENDENCY RESOLUTION ====================
-- A resolver that collects transitive dependencies and detects conflicts.
-- Uses parallel arrays to track the resolution graph.

pilot resolve_names = 0
pilot resolve_versions = 0
pilot resolve_sources = 0
pilot resolve_constraints = 0
pilot resolve_requested_by = 0
pilot resolve_count = 0

task resolve_clear() -> void {
    resolve_names = array_new()
    resolve_versions = array_new()
    resolve_sources = array_new()
    resolve_constraints = array_new()
    resolve_requested_by = array_new()
    resolve_count = 0
}

task resolve_find(name: word) -> int {
    -- Returns index of package in resolution set, or -1
    pilot i = 0
    repeat until i >= resolve_count {
        pilot n: word = array_get(resolve_names, i)
        if n == name { give back i }
        i += 1
    }
    give back -1
}

task resolve_add(name: word, version: word, source: word, constraint: word, requested_by: word) -> bool {
    -- Add a package to the resolution set.
    -- Returns false if there's a conflict.
    pilot idx = resolve_find(name)
    if idx >= 0 {
        -- Package already in resolution set.
        -- Check if the existing resolved version satisfies the new constraint.
        pilot existing_ver: word = array_get(resolve_versions, idx)
        if constraint != "latest" and constraint != "*" and constraint != "" {
            if version_matches_constraint(existing_ver, constraint) == false {
                -- CONFLICT
                pilot existing_by: word = array_get(resolve_requested_by, idx)
                say ""
                say C_BRED + "  [YUUKO] Resolution failed." + C_RESET + " Two dependencies want incompatible versions of " + C_BWHITE + name + C_RESET + ":"
                pilot conflict_msg1 = "        " + C_BCYAN + existing_by + C_RESET + "  requires  " + name + " " + array_get(resolve_constraints, idx)
                pilot conflict_msg2 = "        " + C_BCYAN + requested_by + C_RESET + "  requires  " + name + " " + constraint
                say conflict_msg1
                say conflict_msg2
                say "        These ranges do not overlap."
                say C_DIM + "        Suggestion: update one of the constraints to allow a compatible version." + C_RESET
                say ""
                give back false
            }
        }
        -- Compatible — keep existing resolution
        give back true
    }

    -- New package
    array_push(resolve_names, name)
    array_push(resolve_versions, version)
    array_push(resolve_sources, source)
    array_push(resolve_constraints, constraint)
    array_push(resolve_requested_by, requested_by)
    resolve_count += 1
    give back true
}

task resolve_collect_transitive(project_dir: word, pkg_name: word, depth: int) -> bool {
    -- After a package is installed, read its hangar.toml for transitive deps.
    -- Returns false if a conflict is detected.
    if depth > 10 {
        say C_BYELLOW + "  WARNING" + C_RESET + " Dependency depth limit reached for " + pkg_name
        give back true
    }

    pilot pkg_dir = project_dir + "/hangar_modules/" + pkg_name
    pilot pkg_manifest = pkg_dir + "/hangar.toml"

    if fs::exists(pkg_manifest) == false {
        -- No manifest = no transitive deps
        give back true
    }

    -- Save current TOML state and load the sub-package manifest
    -- (We don't have TOML stack, so we re-load the root manifest after)
    pilot sub_content: word = fs::read(pkg_manifest)
    if sub_content == "" { give back true }

    -- Parse transitive deps from the sub-package
    -- Simple: look for [dependencies] section and extract names
    pilot pos = 0
    pilot clen = sub_content.length()
    pilot in_deps = false

    repeat until pos >= clen {
        pilot line: word = toml_get_line(sub_content, pos)
        pos = toml_line_end(sub_content, pos)
        pilot trimmed: word = line.trim()

        if trimmed == "[dependencies]" {
            in_deps = true
        } else if trimmed.starts_with("[") and trimmed != "[dependencies]" {
            in_deps = false
        } else if in_deps and trimmed != "" and trimmed.starts_with("#") == false {
            -- Parse dependency line
            pilot dep_name = ""
            pilot di = 0
            pilot tlen = trimmed.length()
            repeat until di >= tlen {
                pilot c: word = trimmed.char_at(di)
                if c == " " or c == "=" or c == "\t" {
                    if dep_name != "" {
                        -- Got the name, now extract version constraint
                        pilot dep_constraint = "latest"
                        -- Check for short syntax: name = "^1.0"
                        if trimmed.contains("\"") {
                            -- Extract quoted value
                            pilot qi = 0
                            pilot found_eq = false
                            repeat until qi >= tlen {
                                pilot qc: word = trimmed.char_at(qi)
                                if qc == "=" { found_eq = true }
                                if found_eq and qc == "\"" {
                                    qi += 1
                                    pilot qval = ""
                                    repeat until qi >= tlen {
                                        pilot qvc: word = trimmed.char_at(qi)
                                        if qvc == "\"" {
                                            dep_constraint = qval
                                            qi = tlen
                                        } else {
                                            qval = qval + qvc
                                        }
                                        qi += 1
                                    }
                                }
                                qi += 1
                            }
                        }

                        -- Resolve this transitive dep
                        pilot resolved_ver = dep_constraint
                        pilot resolved_src = ""

                        -- Check registry for version resolution
                        if dep_constraint != "latest" and dep_constraint != "*" {
                            pilot reg_result: word = hangar_resolve_from_registry(dep_name, dep_constraint)
                            if reg_result != "" {
                                resolved_ver = hangar_extract_colon(reg_result, 0)
                                resolved_src = hangar_extract_colon(reg_result, 1)
                            }
                        }

                        pilot is_ok = resolve_add(dep_name, resolved_ver, resolved_src, dep_constraint, pkg_name)
                        if is_ok == false {
                            give back false
                        }
                        di = tlen
                    }
                } else {
                    dep_name = dep_name + c
                }
                di += 1
            }
        }
    }

    give back true
}

-- ===================== HANGAR INSTALL ================================

task hangar_install(project_dir: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot dep_cnt = toml_dep_count()
    if dep_cnt == 0 {
        say "  No dependencies to install."
        give back 0
    }

    -- Check for existing lockfile
    pilot lockfile = project_dir + "/hangar.lock"
    pilot has_lockfile = lock_load(lockfile)
    if has_lockfile {
        say C_DIM + "  >> " + C_RESET + "Using versions from hangar.lock"
    }

    -- Phase 1: Resolve all dependencies (detect conflicts before installing)
    resolve_clear()
    pilot dep_arr = toml_dep_names_arr()
    pilot di = 0
    pilot conflicts = false

    repeat until di >= dep_cnt {
        pilot dname: word = array_get(dep_arr, di)
        pilot git_key = "dependencies." + dname + ".git"
        pilot ver_key = "dependencies." + dname + ".version"
        pilot git_val: word = toml_get(git_key)
        pilot ver_val: word = toml_get(ver_key)
        if ver_val == "" { ver_val = "latest" }

        -- If lockfile exists, prefer locked version
        pilot use_ver = ver_val
        if has_lockfile and lock_has(dname) {
            use_ver = lock_get_version(dname)
        }

        pilot is_ok = resolve_add(dname, use_ver, git_val, ver_val, "your project")
        if is_ok == false {
            conflicts = true
        }
        di += 1
    }

    if conflicts {
        say C_BRED + "  RESOLUTION FAILED" + C_RESET + " — fix the conflicts above before installing."
        give back 1
    }

    say C_DIM + "  >> " + C_RESET + "Resolved " + word_from_int(resolve_count) + " package(s)"

    -- Phase 2: Install resolved packages
    -- Initialize lockfile state if no lockfile exists
    if has_lockfile == false {
        lock_clear()
    }

    pilot errors = 0
    pilot ri = 0
    repeat until ri >= resolve_count {
        pilot rname: word = array_get(resolve_names, ri)
        pilot rver: word = array_get(resolve_versions, ri)
        pilot rsrc: word = array_get(resolve_sources, ri)

        if has_lockfile and lock_has(rname) {
            pilot locked_ver: word = lock_get_version(rname)
            pilot lock_msg = C_DIM + "  >> " + C_RESET + "Locked: " + C_BWHITE + rname + C_RESET + C_DIM + " @ " + locked_ver + C_RESET
            say lock_msg
            rver = locked_ver
        }

        pilot ires = hangar_install_one(project_dir, rname, rsrc, rver)
        if ires != 0 {
            errors += 1
        }

        -- Phase 3: Collect transitive deps from installed package
        pilot trans_ok = resolve_collect_transitive(project_dir, rname, 0)
        if trans_ok == false {
            say C_BRED + "  TRANSITIVE CONFLICT" + C_RESET + " — stopping installation."
            give back 1
        }

        ri += 1
    }

    -- Install any newly discovered transitive deps
    -- (resolve_count may have grown during Phase 3)
    repeat until ri >= resolve_count {
        pilot tname: word = array_get(resolve_names, ri)
        pilot tver: word = array_get(resolve_versions, ri)
        pilot tsrc: word = array_get(resolve_sources, ri)

        pilot tmsg = C_DIM + "  >> " + C_RESET + "Transitive: " + C_BWHITE + tname + C_RESET
        say tmsg

        pilot tres = hangar_install_one(project_dir, tname, tsrc, tver)
        if tres != 0 {
            errors += 1
        }
        ri += 1
    }

    -- Write lockfile
    lock_write(lockfile)
    say C_DIM + "  >> " + C_RESET + "Lockfile written: hangar.lock"

    if errors > 0 {
        pilot err_str: word = word_from_int(errors)
        pilot errmsg = "  " + err_str + " package(s) failed to install."
        say errmsg
        give back 1
    }

    pilot cnt_str: word = word_from_int(resolve_count)
    pilot ok_msg = "  All " + cnt_str + " package(s) installed."
    say ok_msg
    give back 0
}

-- ===================== HANGAR UPDATE =================================

task hangar_update(project_dir: word, pkg_name: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot dep_cnt = toml_dep_count()
    if dep_cnt == 0 {
        say "  No dependencies to update."
        give back 0
    }

    pilot lockfile = project_dir + "/hangar.lock"

    if pkg_name != "" {
        -- Update a single package: re-resolve just this one
        pilot git_key = "dependencies." + pkg_name + ".git"
        pilot ver_key = "dependencies." + pkg_name + ".version"
        pilot git_val: word = toml_get(git_key)
        pilot ver_val: word = toml_get(ver_key)
        if ver_val == "" { ver_val = "latest" }

        if toml_has(git_key) == false and toml_has(ver_key) == false {
            pilot not_found = "  Package '" + pkg_name + "' is not in hangar.toml"
            say not_found
            give back 1
        }

        say C_DIM + "  >> " + C_RESET + "Updating " + C_BWHITE + pkg_name + C_RESET + "..."

        -- Load existing lockfile to preserve other entries
        lock_load(lockfile)

        -- Remove old entry for this package so it gets re-resolved
        lock_remove_entry(pkg_name)

        -- Re-install with the constraint from hangar.toml (not locked version)
        pilot ires = hangar_install_one(project_dir, pkg_name, git_val, ver_val)
        if ires == 0 {
            pilot lock_source = "git+" + git_val
            if git_val == "" { lock_source = "local" }
            lock_add_entry(pkg_name, ver_val, lock_source, "")
        }

        lock_write(lockfile)
        say C_DIM + "  >> " + C_RESET + "Lockfile updated: hangar.lock"
        give back ires
    }

    -- Update all packages: re-resolve everything fresh
    say C_DIM + "  >> " + C_RESET + "Re-resolving all dependencies..."
    lock_clear()

    pilot dep_arr = toml_dep_names_arr()
    pilot errors = 0
    pilot di = 0
    repeat until di >= dep_cnt {
        pilot dname: word = array_get(dep_arr, di)
        pilot git_key2 = "dependencies." + dname + ".git"
        pilot ver_key2 = "dependencies." + dname + ".version"
        pilot git_val2: word = toml_get(git_key2)
        pilot ver_val2: word = toml_get(ver_key2)
        if ver_val2 == "" { ver_val2 = "latest" }

        pilot ires2 = hangar_install_one(project_dir, dname, git_val2, ver_val2)
        if ires2 != 0 {
            errors += 1
        } else {
            pilot lock_source2 = "git+" + git_val2
            if git_val2 == "" { lock_source2 = "local" }
            lock_add_entry(dname, ver_val2, lock_source2, "")
        }
        di += 1
    }

    lock_write(lockfile)
    say C_DIM + "  >> " + C_RESET + "Lockfile updated: hangar.lock"

    if errors > 0 {
        pilot err_str: word = word_from_int(errors)
        pilot errmsg = "  " + err_str + " package(s) failed to update."
        say errmsg
        give back 1
    }

    pilot cnt_str: word = word_from_int(dep_cnt)
    pilot ok_msg = "  All " + cnt_str + " package(s) updated."
    say ok_msg
    give back 0
}

task hangar_get_index_path(name: word) -> word {
    -- Registry index path: /mu/mv/muvluv
    if name.length() < 2 {
        give back "/" + name + "/" + name
    }
    pilot p1: word = name.char_at(0).to_lower()
    pilot p2: word = name.char_at(1).to_lower()
    give back "/" + p1 + "/" + p2 + "/" + name
}

task hangar_resolve_from_registry(name: word, constraint: word) -> word {
    -- Resolves a package name and constraint to a (version, repo_url) pair.
    -- Returns "version:repo_url" or "" if not found.
    pilot registry: word = toml_get("registries.default")
    if registry == "" { registry = HANGAR_DEFAULT_REGISTRY }

    pilot index_url = registry + hangar_get_index_path(name)
    pilot fetch_cmd = "curl -sL " + index_url
    pilot index_content: word = process::exec_capture(fetch_cmd)

    if index_content == "" or index_content.contains("404") {
        give back ""
    }

    -- index_content is newline-delimited JSON. One line per version.
    -- Find the best matching version.
    pilot pos = 0
    pilot clen = index_content.length()
    pilot best_ver = ""
    pilot best_repo = ""

    repeat until pos >= clen {
        pilot line: word = toml_get_line(index_content, pos)
        pos = toml_line_end(index_content, pos)
        if line.trim() != "" {
            pilot v: word = hangar_extract_json_field(line, "vers")
            pilot r: word = hangar_extract_json_field(line, "repo")
            -- Use std/version.fk's satisfies
            if version_matches_constraint(v, constraint) {
                -- Since index lines are usually chronological, the last one is latest.
                -- A real resolver would pick the highest version.
                if best_ver == "" or ver_gt(ver_parse(v), ver_parse(best_ver)) {
                    best_ver = v
                    best_repo = r
                }
            }
        }
    }

    if best_ver != "" {
        give back best_ver + ":" + best_repo
    }
    give back ""
}

task hangar_install_one(project_dir: word, pkg_name: word, repo: word, ver: word) -> int {
    pilot modules_dir = project_dir + "/hangar_modules"
    if fs::exists(modules_dir) == false {
        fs::make_dir(modules_dir)
    }
    pilot pkg_dir = modules_dir + "/" + pkg_name

    pilot actual_repo = repo
    pilot actual_ver = ver

    if actual_repo == "" {
        -- Resolve from registry
        pilot resolved: word = hangar_resolve_from_registry(pkg_name, ver)
        if resolved == "" {
            pilot msg = "  Package '" + pkg_name + "' not found in registry and no git repo specified."
            say msg
            give back 1
        }
        -- Extract version:repo_url
        actual_ver = hangar_extract_colon(resolved, 0)
        actual_repo = hangar_extract_colon(resolved, 1)
        pilot res_msg = C_DIM + "  >> " + C_RESET + "Resolved " + C_BWHITE + pkg_name + C_RESET + C_DIM + " to " + actual_ver + " (" + actual_repo + ")" + C_RESET
        say res_msg
    }

    pilot fetch_msg = C_DIM + "  >> " + C_RESET + "Fetching " + C_BWHITE + pkg_name + C_RESET + C_DIM + " from " + actual_repo + "..." + C_RESET
    say fetch_msg

    -- Remove existing package dir if present
    if fs::exists(pkg_dir) {
        pilot rm_cmd: word = hangar_rm_cmd(pkg_dir)
        process::exec(rm_cmd)
    }

    -- Construct git URL
    pilot git_url = ""
    if actual_repo.starts_with("https://") {
        git_url = actual_repo
    } else {
        git_url = "https://github.com/" + actual_repo + ".git"
    }

    -- Clone with git
    pilot clone_cmd = "git clone --depth 1 --quiet " + git_url + " " + pkg_dir
    if actual_ver != "latest" and actual_ver != "*" {
        clone_cmd = "git clone --depth 1 --quiet --branch v" + actual_ver + " " + git_url + " " + pkg_dir
    }
    pilot clone_res = process::exec(clone_cmd)
    if clone_res != 0 {
        -- Try without v prefix on tag
        if actual_ver != "latest" and actual_ver != "*" {
            pilot clone2 = "git clone --depth 1 --quiet --branch " + actual_ver + " " + git_url + " " + pkg_dir
            pilot clone2_res = process::exec(clone2)
            if clone2_res != 0 {
                pilot fail_msg = "  Could not fetch " + pkg_name + ". Creating stub..."
                say fail_msg
                hangar_create_stub(pkg_dir, pkg_name)
                give back 0
            }
        } else {
            pilot fail_msg2 = "  Could not fetch " + pkg_name + ". Creating stub..."
            say fail_msg2
            hangar_create_stub(pkg_dir, pkg_name)
            give back 0
        }
    }

    -- Remove .git directory from cloned package (not needed)
    pilot git_dir = pkg_dir + "/.git"
    if fs::exists(git_dir) {
        pilot rm_git: word = hangar_rm_cmd(git_dir)
        process::exec(rm_git)
    }

    -- Compute SHA-256 for integrity verification
    pilot pkg_sha: word = hangar_compute_dir_sha256(pkg_dir)
    if pkg_sha != "" {
        say C_DIM + "  >> " + C_RESET + "SHA-256: " + pkg_sha.substring(0, 16) + "..."
    }

    -- Update lockfile with hash
    pilot lockfile = project_dir + "/hangar.lock"
    lock_load(lockfile)
    pilot lock_source = actual_repo
    lock_add_entry(pkg_name, actual_ver, lock_source, pkg_sha)
    lock_write(lockfile)

    pilot ok_msg = C_BGREEN + "  INSTALLED" + C_RESET + " " + C_BWHITE + pkg_name + C_RESET + C_DIM + " -> hangar_modules/" + pkg_name + "/" + C_RESET
    say ok_msg
    give back 0
}

task hangar_create_stub(pkg_dir: word, pkg_name: word) -> void {
    fs::make_dir(pkg_dir)
    pilot stub_path = pkg_dir + "/" + pkg_name + ".fk"
    pilot stub_content = "-- " + pkg_name + " (stub module -- install with 'hangar install')\n-- This stub was created because the package could not be downloaded.\n\n"
    fs::write(stub_path, stub_content)
    pilot msg = "  Created stub: hangar_modules/" + pkg_name + "/" + pkg_name + ".fk"
    say msg
}

task hangar_version_cmd(project_dir: word, bump: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)
    pilot pname: word = toml_get("project.name")
    pilot current: word = toml_get("project.version")
    if pname == "" { pname = "unknown" }
    if current == "" { current = "0.0.0" }

    if bump == "" {
        pilot show_msg = "  " + C_BWHITE + pname + C_RESET + " " + C_BMAGENTA + "v" + current + C_RESET
        say show_msg
        give back 0
    }

    -- Parse current version using std/version.fk
    pilot parsed: word = ver_parse(current)
    pilot maj = ver_major(parsed)
    pilot min = ver_minor(parsed)
    pilot pat = ver_patch(parsed)
    pilot new_ver = ""

    if bump == "major" {
        new_ver = word_from_int(maj + 1) + ".0.0"
    } else if bump == "minor" {
        pilot new_min: word = word_from_int(min + 1)
        new_ver = word_from_int(maj) + "." + new_min + ".0"
    } else if bump == "patch" {
        pilot new_pat: word = word_from_int(pat + 1)
        new_ver = word_from_int(maj) + "." + word_from_int(min) + "." + new_pat
    } else {
        -- Explicit version string
        new_ver = bump
    }

    toml_set("project.version", new_ver)
    toml_write_file(manifest)

    pilot done_msg = "  " + C_BWHITE + pname + C_RESET + " " + C_DIM + current + C_RESET + " -> " + C_BMAGENTA + new_ver + C_RESET
    say done_msg
    give back 0
}

-- ===================== TOOLCHAIN BOOTSTRAP ==========================

-- Download a file to a local path.
-- Returns 0 on success, non-zero on failure.
task hangar_download_file(url: word, dest: word, is_win: bool) -> int {
    if is_win {
        -- Try PowerShell first (ships with all Windows versions, handles HTTPS/redirects)
        pilot ps_cmd = "powershell -NoProfile -NonInteractive -Command \"(New-Object Net.WebClient).DownloadFile('" + url + "', '" + dest + "')\""
        pilot ps_res = process::exec(ps_cmd)
        if ps_res == 0 { give back 0 }
        -- Fallback: curl (available on Windows 10 1803+)
        pilot curl_cmd = "curl -fsSL -o \"" + dest + "\" \"" + url + "\""
        give back process::exec(curl_cmd)
    } else {
        pilot curl_cmd = "curl -fsSL -o \"" + dest + "\" \"" + url + "\""
        give back process::exec(curl_cmd)
    }
}

-- Ensure a directory exists (cross-platform).
task hangar_mkdir(path: word, is_win: bool) -> void {
    if is_win {
        -- powershell New-Item handles nested dirs and ignores already-exists
        pilot cmd = "powershell -NoProfile -NonInteractive -Command \"New-Item -Force -ItemType Directory -Path '" + path + "' | Out-Null\""
        process::exec(cmd)
    } else {
        process::exec("mkdir -p \"" + path + "\"")
    }
}

task hangar_install_freak() -> int {
    say "  Detecting platform..."

    -- Detect OS via environment variables (reliable, no shell expansion needed)
    pilot os_tag = ""
    pilot ext = ""

    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        ext = ".exe"
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Linux") {
            os_tag = "linux"
        } else if uname_out.contains("Darwin") {
            os_tag = "macos"
        } else {
            say "  " + C_BRED + SYM_CROSS + C_RESET + " Unsupported OS."
            say "  Download manually: https://github.com/FREAK-lang-dev/Freak-lang/releases"
            give back 1
        }
    }

    pilot is_win = os_tag == "windows"

    -- Detect architecture
    pilot arch_tag = "x64"
    if not is_win {
        pilot arch_out: word = process::exec_capture("uname -m 2>/dev/null")
        if arch_out.contains("aarch64") or arch_out.contains("arm64") {
            arch_tag = "arm64"
        }
    }

    pilot platform = os_tag + "-" + arch_tag
    say "  Platform: " + C_BWHITE + platform + C_RESET

    -- Determine install location using env vars (no shell expansion)
    pilot freak_home = ""
    if is_win {
        pilot appdata: word = process::env("APPDATA")
        if appdata == "" {
            pilot userprofile: word = process::env("USERPROFILE")
            appdata = userprofile + "/AppData/Roaming"
        }
        freak_home = appdata + "/freak"
    } else {
        pilot home_dir: word = process::env("HOME")
        freak_home = home_dir + "/.freak"
    }

    pilot bin_dir = freak_home + "/bin"
    pilot runtime_dir = freak_home + "/runtime"
    pilot std_dir = freak_home + "/std"
    pilot binary_path = bin_dir + "/freak" + ext
    pilot hangar_path = bin_dir + "/hangar" + ext

    -- Fetch latest release tag via GitHub API
    say "  Checking latest version..."
    pilot api_resp: word = ""
    if is_win {
        pilot ps_api = "powershell -NoProfile -NonInteractive -Command \"(New-Object Net.WebClient).DownloadString('https://api.github.com/repos/FREAK-lang-dev/Freak-lang/releases/latest')\""
        api_resp = process::exec_capture(ps_api)
        if api_resp == "" {
            api_resp = process::exec_capture("curl -fsSL \"https://api.github.com/repos/FREAK-lang-dev/Freak-lang/releases/latest\"")
        }
    } else {
        api_resp = process::exec_capture("curl -fsSL \"https://api.github.com/repos/FREAK-lang-dev/Freak-lang/releases/latest\"")
    }

    pilot version: word = hangar_extract_json_field(api_resp, "tag_name")
    if version == "" {
        say "  " + C_BRED + SYM_CROSS + C_RESET + " Could not fetch latest release."
        say "  Check your internet connection and try again."
        say "  Manual download: https://github.com/FREAK-lang-dev/Freak-lang/releases"
        give back 1
    }
    say "  Latest: " + C_BGREEN + version + C_RESET

    -- Create directories
    say "  Creating directories..."
    hangar_mkdir(bin_dir, is_win)
    hangar_mkdir(runtime_dir, is_win)
    hangar_mkdir(std_dir, is_win)

    -- Download freak binary
    pilot artifact = "freak-" + platform + ext
    pilot base_url = "https://github.com/FREAK-lang-dev/Freak-lang/releases/download/" + version
    pilot freak_url = base_url + "/" + artifact
    say "  Downloading " + C_BWHITE + artifact + C_RESET + "..."
    pilot dl_res = hangar_download_file(freak_url, binary_path, is_win)
    if dl_res != 0 {
        say "  " + C_BRED + SYM_CROSS + C_RESET + " Download failed."
        say "  URL tried: " + freak_url
        say "  Try: " + C_DIM + "curl -fsSL -o freak" + ext + " \"" + freak_url + "\"" + C_RESET
        give back 1
    }
    if not is_win {
        process::exec("chmod +x \"" + binary_path + "\"")
    }

    -- Download hangar binary (same binary, BusyBox pattern)
    pilot hangar_artifact = "hangar-" + platform + ext
    pilot hangar_url = base_url + "/" + hangar_artifact
    pilot hg_res = hangar_download_file(hangar_url, hangar_path, is_win)
    if hg_res == 0 {
        if not is_win { process::exec("chmod +x \"" + hangar_path + "\"") }
    }

    -- Download runtime files (prefer .o pre-compiled for bundle mode; fall back to .c)
    say "  Downloading runtime..."
    pilot raw_base = "https://raw.githubusercontent.com/FREAK-lang-dev/Freak-lang/" + version

    -- Pre-compiled object files (needed for bundle mode — no clang for linking)
    pilot rt_o_ext = ".o"
    if is_win { rt_o_ext = ".obj" }
    pilot rt_o_url = raw_base + "/freakc/runtime/freak_runtime" + rt_o_ext
    pilot llvm_o_url = raw_base + "/freakc/runtime/freak_llvm_runtime" + rt_o_ext
    hangar_download_file(rt_o_url, runtime_dir + "/freak_runtime" + rt_o_ext, is_win)
    hangar_download_file(llvm_o_url, runtime_dir + "/freak_llvm_runtime" + rt_o_ext, is_win)

    -- C source fallbacks
    hangar_download_file(raw_base + "/freakc/runtime/freak_runtime.c",    runtime_dir + "/freak_runtime.c",    is_win)
    hangar_download_file(raw_base + "/freakc/runtime/freak_runtime.h",    runtime_dir + "/freak_runtime.h",    is_win)
    hangar_download_file(raw_base + "/freakc/runtime/freak_llvm_runtime.c", runtime_dir + "/freak_llvm_runtime.c", is_win)

    -- Standard library
    say "  Downloading standard library..."
    pilot std_files = array_new()
    array_push(std_files, "math.fk")
    array_push(std_files, "math3d.fk")
    array_push(std_files, "zip.fk")
    array_push(std_files, "string.fk")
    array_push(std_files, "convert.fk")
    array_push(std_files, "algorithm.fk")
    array_push(std_files, "json.fk")
    array_push(std_files, "http.fk")
    array_push(std_files, "version.fk")
    array_push(std_files, "runtime.fk")
    pilot si = 0
    repeat 8 times {
        pilot sf: word = array_get(std_files, si)
        hangar_download_file(raw_base + "/std/" + sf, std_dir + "/" + sf, is_win)
        si += 1
    }

    say ""
    say cli_box_top(48)
    say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " FREAK " + version + " installed!" + C_RESET, 48)
    say cli_box_sep(48)
    say cli_box_mid("  " + C_DIM + "Compiler: " + C_RESET + binary_path, 48)
    say cli_box_mid("  " + C_DIM + "Runtime:  " + C_RESET + runtime_dir, 48)
    say cli_box_mid("  " + C_DIM + "Stdlib:   " + C_RESET + std_dir, 48)
    say cli_box_sep(48)
    if is_win {
        say cli_box_mid("  Add to PATH (PowerShell):", 48)
        pilot ps_path_cmd = "$env:PATH += ';' + '" + bin_dir + "'"
        say cli_box_mid("  " + C_CYAN + ps_path_cmd + C_RESET, 48)
        say cli_box_mid("  Or: " + C_DIM + "setx PATH \"%PATH%;" + bin_dir + "\"" + C_RESET, 48)
    } else {
        say cli_box_mid("  Add to PATH:", 48)
        say cli_box_mid("  " + C_CYAN + "export PATH=\"" + bin_dir + ":$PATH\"" + C_RESET, 48)
    }
    say cli_box_bot(48)
    say ""

    -- Check if clang is available; suggest install if not
    pilot clang_test = process::exec("clang --version")
    if clang_test != 0 {
        say "  " + C_BYELLOW + SYM_BOLT + " clang not found" + C_RESET + " — needed to compile .fk programs."
        if is_win {
            say "  Install with: " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
            say "           or: " + C_CYAN + "choco install llvm" + C_RESET
            say "  Then reopen terminal and run: " + C_BWHITE + "freak doctor" + C_RESET
        } else if os_tag == "linux" {
            say "  Install with: " + C_CYAN + "sudo apt install clang lld" + C_RESET + "  (Debian/Ubuntu)"
            say "            or: " + C_CYAN + "sudo dnf install clang lld" + C_RESET + "  (Fedora/RHEL)"
        } else if os_tag == "macos" {
            say "  Install with: " + C_CYAN + "xcode-select --install" + C_RESET
            say "            or: " + C_CYAN + "brew install llvm" + C_RESET
        }
        say ""
    } else {
        say "  " + C_BGREEN + SYM_CHECK + " clang found" + C_RESET + " — ready to compile!"
        say ""
        say "  " + C_DIM + "Try: " + C_RESET + C_BWHITE + "freak build hello.fk" + C_RESET
        say ""
    }

    give back 0
}

-- ===================== OUTDATED CHECK ================================

task hangar_outdated(project_dir: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot dep_cnt = toml_dep_count()
    if dep_cnt == 0 {
        say "  No dependencies to check."
        give back 0
    }

    say ""
    say C_BMAGENTA + "  OUTDATED" + C_RESET + C_DIM + " -- checking installed packages" + C_RESET
    say ""

    pilot dep_arr = toml_dep_names_arr()
    pilot found_outdated = 0
    pilot di = 0
    repeat until di >= dep_cnt {
        pilot dname: word = array_get(dep_arr, di)
        pilot ver_val: word = toml_dep_get_version(dname)

        -- Check installed version from hangar_modules/<pkg>/hangar.toml
        pilot pkg_manifest = project_dir + "/hangar_modules/" + dname + "/hangar.toml"
        pilot installed_ver = ""
        if fs::exists(pkg_manifest) {
            -- Save current toml state, load package manifest, then restore
            pilot saved_keys = toml_keys_arr
            pilot saved_vals = toml_vals_arr
            pilot saved_count = toml_count

            toml_load(pkg_manifest)
            installed_ver = toml_get("project.version")

            -- Restore main toml state
            toml_keys_arr = saved_keys
            toml_vals_arr = saved_vals
            toml_count = saved_count
        }

        if installed_ver == "" {
            installed_ver = "unknown"
        }

        -- Display constraint vs installed version
        pilot constraint_str = ver_val
        if constraint_str == "" { constraint_str = "latest" }

        pilot status_line = "  " + C_BWHITE + dname + C_RESET
        status_line = status_line + C_DIM + "  installed: " + C_RESET + installed_ver
        status_line = status_line + C_DIM + "  constraint: " + C_RESET + constraint_str

        -- Check if installed version satisfies constraint
        if installed_ver != "unknown" and ver_val != "" and ver_val != "latest" and ver_val != "*" {
            pilot satisfies = ver_satisfies(installed_ver, ver_val)
            if satisfies == false {
                status_line = status_line + "  " + C_BYELLOW + "UPDATE AVAILABLE" + C_RESET
                found_outdated += 1
            } else {
                status_line = status_line + "  " + C_BGREEN + "OK" + C_RESET
            }
        } else {
            status_line = status_line + "  " + C_DIM + "skip (no constraint)" + C_RESET
        }

        say status_line
        di += 1
    }

    say ""
    if found_outdated > 0 {
        pilot cnt_str: word = word_from_int(found_outdated)
        pilot summary = C_BYELLOW + "  " + cnt_str + " package(s) may need updating." + C_RESET
        say summary
    } else {
        say C_BGREEN + "  All packages satisfy their constraints." + C_RESET
    }
    say ""
    give back 0
}

-- ===================== HELPERS =====================================

task hangar_basename(path: word) -> word {
    -- Get last component of a path
    pilot last = ""
    pilot i = 0
    pilot plen = path.length()
    repeat until i >= plen {
        pilot c: word = path.char_at(i)
        if c == "/" or c == "\\" {
            last = ""
        } else {
            last = last + c
        }
        i += 1
    }
    if last == "" or last == "." { last = "my-project" }
    give back last
}

task hangar_rm_cmd(path: word) -> word {
    -- Cross-platform remove directory command
    -- Detect Windows vs Unix
    pilot win_check: word = process::exec_capture("echo %OS%")
    if win_check.contains("Windows") {
        pilot win_path: word = path.replace("/", "\\")
        give back "rmdir /s /q \"" + win_path + "\""
    } else {
        give back "rm -rf \"" + path + "\""
    }
}

task hangar_extract_json_field(json: word, field: word) -> word {
    -- Very simple JSON field extractor
    -- Finds "field": "value" and returns value
    pilot search = "\"" + field + "\""
    pilot jlen = json.length()
    pilot slen = search.length()
    pilot i = 0
    repeat until i >= jlen {
        -- Check if search string matches at position i
        pilot match = true
        pilot si = 0
        repeat until si >= slen {
            if i + si >= jlen {
                match = false
            }
            if match {
                pilot jc: word = json.char_at(i + si)
                pilot sc: word = search.char_at(si)
                if jc != sc { match = false }
            }
            si += 1
        }
        if match {
            -- Found the field, now skip ": " and extract value
            pilot vi = i + slen
            -- Skip whitespace and colon
            repeat until vi >= jlen {
                pilot vc: word = json.char_at(vi)
                if vc != ":" and vc != " " and vc != "\t" {
                    -- At the start of value
                    if vc == "\"" {
                        vi += 1
                        pilot val = ""
                        repeat until vi >= jlen {
                            pilot vv: word = json.char_at(vi)
                            if vv == "\"" {
                                give back val
                            }
                            val = val + vv
                            vi += 1
                        }
                    }
                }
                vi += 1
            }
        }
        i += 1
    }
    give back ""
}

-- ===================== HG5: CHECKSUM VERIFICATION ====================

task hangar_compute_sha256(path: word) -> word {
    -- Compute SHA-256 hash of a file using platform tools.
    -- Returns lowercase hex string, or "" on failure.
    pilot win_check: word = process::exec_capture("echo %OS%")
    pilot cmd = ""
    if win_check.contains("Windows") {
        -- Windows: certutil outputs "SHA256 hash of file:\n<hash>\n..."
        cmd = "certutil -hashfile \"" + path + "\" SHA256"
    } else {
        -- Unix: sha256sum outputs "<hash>  <file>"
        cmd = "sha256sum \"" + path + "\" 2>/dev/null || shasum -a 256 \"" + path + "\""
    }

    pilot output: word = process::exec_capture(cmd)
    if output == "" { give back "" }

    -- Extract the hex hash from output
    if win_check.contains("Windows") {
        -- certutil: second line is the hash
        pilot pos = 0
        pilot olen = output.length()
        pilot line_num = 0
        repeat until pos >= olen {
            pilot line: word = toml_get_line(output, pos)
            pos = toml_line_end(output, pos)
            line_num += 1
            if line_num == 2 {
                -- This line should be the hash (with possible spaces)
                give back line.trim().replace(" ", "")
            }
        }
    } else {
        -- sha256sum: first 64 chars are the hash
        pilot hash = ""
        pilot i = 0
        pilot olen = output.length()
        repeat until i >= 64 or i >= olen {
            pilot c: word = output.char_at(i)
            if c != " " and c != "\t" {
                hash = hash + c
            }
            i += 1
        }
        give back hash
    }
    give back ""
}

task hangar_compute_dir_sha256(pkg_dir: word) -> word {
    -- Compute a reproducible hash for a package directory.
    -- We tar the directory contents and hash the tarball.
    pilot tmp_tar = pkg_dir + ".tmp.tar.gz"
    pilot win_check: word = process::exec_capture("echo %OS%")
    pilot tar_cmd = ""
    if win_check.contains("Windows") {
        tar_cmd = "tar -czf \"" + tmp_tar + "\" -C \"" + pkg_dir + "\" ."
    } else {
        tar_cmd = "tar -czf \"" + tmp_tar + "\" -C \"" + pkg_dir + "\" ."
    }
    pilot tar_res = process::exec(tar_cmd)
    if tar_res != 0 {
        give back ""
    }
    pilot hash: word = hangar_compute_sha256(tmp_tar)
    -- Clean up temp tarball
    fs::delete(tmp_tar)
    give back hash
}

task hangar_verify_package(pkg_name: word, pkg_dir: word, expected_sha256: word) -> bool {
    -- Verify a package's integrity against stored SHA-256.
    -- Returns true if valid, false if mismatch or unable to verify.
    if expected_sha256 == "" {
        -- No hash stored, can't verify but don't block
        give back true
    }

    pilot actual: word = hangar_compute_dir_sha256(pkg_dir)
    if actual == "" {
        say C_BYELLOW + "  WARNING" + C_RESET + " Could not compute hash for " + pkg_name
        give back true
    }

    if actual == expected_sha256 {
        give back true
    } else {
        say C_BRED + "  INTEGRITY FAILURE" + C_RESET + " " + pkg_name
        say C_DIM + "    expected: " + C_RESET + expected_sha256
        say C_DIM + "    actual:   " + C_RESET + actual
        give back false
    }
}

task hangar_audit(project_dir: word, fix_mode: bool) -> int {
    say ""
    say C_BMAGENTA + "  HANGAR AUDIT" + C_RESET
    say ""

    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found."
        give back 1
    }

    toml_load(manifest)
    pilot lockfile = project_dir + "/hangar.lock"
    pilot has_lock = lock_load(lockfile)

    if has_lock == false {
        say "  No hangar.lock found. Run 'hangar install' first."
        give back 1
    }

    pilot modules_dir = project_dir + "/hangar_modules"
    pilot issues = 0
    pilot verified = 0

    -- Check each locked package
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot name: word = array_get(lock_pkg_names, i)
        pilot version: word = array_get(lock_pkg_versions, i)
        pilot sha256: word = array_get(lock_pkg_sha256s, i)
        pilot pkg_dir = modules_dir + "/" + name

        if fs::exists(pkg_dir) == false {
            say C_BRED + "  MISSING" + C_RESET + " " + name + " v" + version + " (not installed)"
            issues += 1
            if fix_mode {
                say C_DIM + "  >> " + C_RESET + "Reinstalling " + name + "..."
                pilot source: word = array_get(lock_pkg_sources, i)
                hangar_install_one(project_dir, name, source, version)
            }
        } else if sha256 != "" {
            -- Verify integrity
            pilot valid = hangar_verify_package(name, pkg_dir, sha256)
            if valid {
                say C_BGREEN + "  OK" + C_RESET + " " + name + " v" + version
                verified += 1
            } else {
                issues += 1
                if fix_mode {
                    say C_DIM + "  >> " + C_RESET + "Reinstalling " + name + "..."
                    pilot source2: word = array_get(lock_pkg_sources, i)
                    hangar_install_one(project_dir, name, source2, version)
                    -- Recompute hash after reinstall
                    pilot new_hash: word = hangar_compute_dir_sha256(pkg_dir)
                    if new_hash != "" {
                        array_set(lock_pkg_sha256s, i, new_hash)
                    }
                }
            }
        } else {
            say C_BYELLOW + "  UNVERIFIED" + C_RESET + " " + name + " v" + version + " (no checksum in lockfile)"
            if fix_mode {
                -- Compute and store hash
                pilot new_hash2: word = hangar_compute_dir_sha256(pkg_dir)
                if new_hash2 != "" {
                    array_set(lock_pkg_sha256s, i, new_hash2)
                    say C_DIM + "  >> " + C_RESET + "Computed SHA-256: " + new_hash2.substring(0, 16) + "..."
                    verified += 1
                }
            }
        }

        i += 1
    }

    if fix_mode {
        lock_write(lockfile)
    }

    say ""
    if issues == 0 {
        pilot ok_msg = C_BGREEN + "  ALL CLEAR" + C_RESET + " " + word_from_int(verified) + " packages verified"
        say ok_msg
    } else {
        pilot issue_msg = C_BYELLOW + "  " + word_from_int(issues) + " issue(s) found" + C_RESET
        say issue_msg
        if fix_mode == false {
            say C_DIM + "  Run 'hangar audit --fix' to auto-repair." + C_RESET
        }
    }
    say ""
    give back issues
}

-- ===================== HG3: LOGIN & PUBLISH ==========================

task hangar_login() -> int {
    say ""
    say C_BMAGENTA + "  HANGAR LOGIN" + C_RESET
    say ""
    say "  Please enter your Hangar API token:"
    pilot token: word = process::input()
    if token == "" {
        say "  Login cancelled."
        give back 1
    }

    -- Store in ~/.hangar/credentials
    pilot home_dir: word = process::env("HOME")
    if home_dir == "" {
        -- Windows fallback
        home_dir = process::env("APPDATA") + "/freak"
    }
    pilot hangar_dir = home_dir + "/.hangar"
    if fs::exists(hangar_dir) == false {
        fs::make_dir(hangar_dir)
    }
    pilot creds_path = hangar_dir + "/credentials"
    fs::write(creds_path, token)

    say ""
    say C_BGREEN + "  SUCCESS" + C_RESET + " Token stored in " + creds_path
    say ""
    give back 0
}

task hangar_publish(project_dir: word, dry_run: bool) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Cannot publish."
        give back 1
    }

    toml_load(manifest)
    pilot pname: word = toml_get("project.name")
    pilot pver: word = toml_get("project.version")

    if pname == "" or pver == "" {
        say "  Invalid hangar.toml: name and version are required."
        give back 1
    }

    say ""
    say C_BMAGENTA + "  HANGAR PUBLISH" + C_RESET + " " + C_BWHITE + pname + C_RESET + " v" + pver
    say ""

    -- Dry run: show what would be included
    if dry_run {
        say C_DIM + "  [DRY RUN] Would include:" + C_RESET
        say "    hangar.toml"
        say "    src/"
        if fs::exists(project_dir + "/README.md") { say "    README.md" }
        if fs::exists(project_dir + "/LICENSE") { say "    LICENSE" }
        say ""
        say "  Dry run complete. No files uploaded."
        give back 0
    }

    -- Create tarball: name-version.tar.gz
    pilot tarball = pname + "-" + pver + ".tar.gz"
    say C_DIM + "  >> " + C_RESET + "Packaging " + tarball + "..."

    -- For simplicity in MVP, we shell out to 'tar'
    -- Only include: hangar.toml, src/, README.md, LICENSE
    pilot include_list = "hangar.toml src"
    if fs::exists(project_dir + "/README.md") { include_list = include_list + " README.md" }
    if fs::exists(project_dir + "/LICENSE") { include_list = include_list + " LICENSE" }

    pilot tar_cmd = "tar -czf " + tarball + " " + include_list
    pilot tar_res = process::exec(tar_cmd)
    if tar_res != 0 {
        say "  Failed to create tarball. Make sure 'tar' is in your PATH."
        give back 1
    }

    -- Get token
    pilot home_dir: word = process::env("HOME")
    if home_dir == "" { home_dir = process::env("APPDATA") + "/freak" }
    pilot creds_path = home_dir + "/.hangar/credentials"
    if fs::exists(creds_path) == false {
        say C_BYELLOW + "  NOT LOGGED IN" + C_RESET
        say "  Run 'hangar login' first."
        give back 1
    }
    pilot token: word = fs::read(creds_path)

    -- Upload to registry API
    pilot registry: word = toml_get("registries.default")
    if registry == "" { registry = HANGAR_DEFAULT_REGISTRY }
    -- Convert index URL to API URL (mock)
    -- index.hangar.dev -> api.hangar.dev
    pilot api_url = "https://api.hangar.dev/api/v1/publish"

    say C_DIM + "  >> " + C_RESET + "Uploading to " + api_url + "..."

    pilot curl_cmd = "curl -s -X POST -H \"Authorization: Bearer " + token + "\" "
    curl_cmd = curl_cmd + "-F \"package=@" + tarball + "\" " + api_url

    pilot curl_res = process::exec(curl_cmd)

    -- Clean up tarball
    pilot rm_cmd = hangar_rm_cmd(tarball)
    -- Use simple delete if it's just a file
    fs::delete(tarball)

    if curl_res == 0 {
        say ""
        say C_BGREEN + "  PUBLISHED" + C_RESET + " " + C_BWHITE + pname + C_RESET + " v" + pver
        say ""
        give back 0
    } else {
        say ""
        say C_BRED + "  UPLOAD FAILED" + C_RESET
        give back 1
    }
}

task hangar_extract_colon(s: word, idx: int) -> word {
    pilot res = ""
    pilot cur_idx = 0
    pilot i = 0
    pilot slen = s.length()
    repeat until i >= slen {
        pilot c: word = s.char_at(i)
        if c == ":" {
            if cur_idx == idx {
                give back res
            }
            cur_idx += 1
            res = ""
        } else {
            res = res + c
        }
        i += 1
    }
    if cur_idx == idx {
        give back res
    }
    give back ""
}

-- ===================== MAIN DISPATCH ================================

task hangar_dispatch(args_cnt: int) -> void {
    if args_cnt < 3 {
        say ""
        say C_BMAGENTA + "  HANGAR" + C_RESET + C_DIM + " -- FREAK package manager" + C_RESET
        say ""
        say C_BWHITE + "  COMMANDS" + C_RESET
        say C_BCYAN + "    init" + C_RESET + "                         " + C_DIM + "Create new project" + C_RESET
        say C_BCYAN + "    add" + C_RESET + " <name> [constraint]       " + C_DIM + "Add dependency with version" + C_RESET
        say C_BCYAN + "    add" + C_RESET + " <name> <repo> [version]  " + C_DIM + "Add dependency with git repo" + C_RESET
        say C_BCYAN + "    remove" + C_RESET + " <name>                " + C_DIM + "Remove dependency" + C_RESET
        say C_BCYAN + "    install" + C_RESET + "                      " + C_DIM + "Install all dependencies" + C_RESET
        say C_BCYAN + "    install freak" + C_RESET + "                " + C_DIM + "Install FREAK compiler" + C_RESET
        say C_BCYAN + "    update" + C_RESET + " [package]              " + C_DIM + "Re-resolve and update lockfile" + C_RESET
        say C_BCYAN + "    outdated" + C_RESET + "                     " + C_DIM + "Check for outdated packages" + C_RESET
        say C_BCYAN + "    version" + C_RESET + "                      " + C_DIM + "Show project version" + C_RESET
        say C_BCYAN + "    version" + C_RESET + " patch|minor|major    " + C_DIM + "Bump version" + C_RESET
        say ""
        say C_BCYAN + "    audit" + C_RESET + "                        " + C_DIM + "Verify package integrity" + C_RESET
        say C_BCYAN + "    audit" + C_RESET + " --fix                 " + C_DIM + "Fix integrity issues" + C_RESET
        say C_BCYAN + "    login" + C_RESET + "                        " + C_DIM + "Authenticate with registry" + C_RESET
        say C_BCYAN + "    publish" + C_RESET + " [--dry-run]          " + C_DIM + "Publish to registry" + C_RESET
        say ""
        give back
    }

    pilot subcmd: word = hangar_arg(2)
    pilot project_dir = "."

    if subcmd == "init" {
        if args_cnt >= 4 {
            project_dir = hangar_arg(3)
        }
        hangar_init(project_dir)
    } else if subcmd == "add" {
        if args_cnt < 4 {
            say "Usage: hangar add <name> [constraint]"
            say "       hangar add <name> <repo> [version]"
            give back
        }
        pilot pkg: word = hangar_arg(3)
        if args_cnt == 4 {
            -- hangar add muvluv (no constraint, defaults to latest)
            hangar_add(project_dir, pkg, "", "latest")
        } else if args_cnt == 5 {
            -- Could be: hangar add muvluv ^1.0  OR  hangar add muvluv repo_url
            pilot arg4: word = hangar_arg(4)
            if arg4.starts_with("^") or arg4.starts_with("~") or arg4.starts_with("=") or arg4.starts_with(">") or arg4.starts_with("<") {
                -- SemVer constraint: hangar add muvluv ^1.0
                hangar_add(project_dir, pkg, "", arg4)
            } else {
                -- Git repo: hangar add muvluv https://github.com/...
                hangar_add(project_dir, pkg, arg4, "latest")
            }
        } else {
            -- hangar add muvluv repo version
            pilot repo: word = hangar_arg(4)
            pilot ver = "latest"
            if args_cnt >= 6 {
                ver = hangar_arg(5)
            }
            hangar_add(project_dir, pkg, repo, ver)
        }
    } else if subcmd == "remove" {
        if args_cnt < 4 {
            say "Usage: hangar remove <name>"
            give back
        }
        pilot pkg2: word = hangar_arg(3)
        hangar_remove(project_dir, pkg2)
    } else if subcmd == "install" {
        -- Check if "install freak" (toolchain bootstrap)
        if args_cnt >= 4 {
            pilot install_target: word = hangar_arg(3)
            if install_target == "freak" {
                hangar_install_freak()
                give back
            }
        }
        hangar_install(project_dir)
    } else if subcmd == "update" {
        pilot update_pkg = ""
        if args_cnt >= 4 {
            update_pkg = hangar_arg(3)
        }
        hangar_update(project_dir, update_pkg)
    } else if subcmd == "outdated" {
        hangar_outdated(project_dir)
    } else if subcmd == "version" {
        pilot bump = ""
        if args_cnt >= 4 {
            bump = hangar_arg(3)
        }
        hangar_version_cmd(project_dir, bump)
    } else if subcmd == "audit" {
        pilot fix_mode = false
        if args_cnt >= 4 {
            pilot arg3: word = hangar_arg(3)
            if arg3 == "--fix" { fix_mode = true }
        }
        hangar_audit(project_dir, fix_mode)
    } else if subcmd == "login" {
        hangar_login()
    } else if subcmd == "publish" {
        pilot dry_run = false
        if args_cnt >= 4 {
            pilot arg3: word = hangar_arg(3)
            if arg3 == "--dry-run" { dry_run = true }
        }
        hangar_publish(project_dir, dry_run)
    } else {
        pilot msg = "Unknown hangar command: " + subcmd
        say msg
        say "Run 'hangar' for usage."
    }
}
