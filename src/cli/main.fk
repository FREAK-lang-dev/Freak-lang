-- ===================================================================
-- FREAK CLI — Main Entry Point
-- ===================================================================
-- Replaces the Python `python -m freakc` CLI with a native FREAK binary.
-- Dispatches to subcommands: build, run, check, transpile, version, help.
-- ===================================================================

task cli_parse_flags(start_idx: int, args_cnt: int) -> word {
    -- Parse flags from command line args starting at start_idx.
    -- Returns a colon-delimited string: "target:opt:cross"
    pilot target = "llvm"
    pilot opt = "2"
    pilot cross = ""

    pilot fi = start_idx
    repeat until fi >= args_cnt {
        pilot flag: word = process::arg(fi)
        if flag == "--c" {
            target = "c"
        } else if flag == "--llvm" {
            target = "llvm"
        } else if flag.starts_with("--opt=") {
            opt = flag.char_at(6)
        } else if flag.starts_with("--target=") {
            pilot ti = 9
            pilot tval = ""
            repeat until ti >= flag.length() {
                tval = tval + flag.char_at(ti)
                ti += 1
            }
            cross = tval
        }
        fi += 1
    }

    give back target + ":" + opt + ":" + cross
}

task cli_extract_flag(flags: word, idx: int) -> word {
    -- Extract the nth colon-delimited field from flags string.
    pilot res = ""
    pilot current = 0
    pilot i = 0
    pilot flen = flags.length()
    repeat until i >= flen {
        pilot c: word = flags.char_at(i)
        if c == ":" {
            if current == idx {
                give back res
            }
            current += 1
            res = ""
        } else {
            res = res + c
        }
        i += 1
    }
    if current == idx {
        give back res
    }
    give back ""
}

task freakc_cli_main() -> void {
    pilot args_cnt = process::args_count()

    if args_cnt < 2 {
        cli_show_help()
        give back
    }

    pilot subcmd: word = process::arg(1)

    -- Handle global flags before subcommands
    if subcmd == "--version" or subcmd == "-V" {
        cli_show_version()
        give back
    }
    if subcmd == "--help" or subcmd == "-h" or subcmd == "help" {
        cli_show_help()
        give back
    }
    if subcmd == "version" {
        cli_show_version()
        give back
    }

    -- Subcommands that require a file argument
    if subcmd == "build" or subcmd == "run" or subcmd == "check" or subcmd == "transpile" {
        if args_cnt < 3 {
            say C_BRED + "  ERROR" + C_RESET + " " + subcmd + " requires a file argument."
            pilot usage_msg = C_DIM + "  Usage: " + C_RESET + "freakc " + subcmd + " <file.fk> [options]"
            say usage_msg
            give back
        }

        pilot src_file: word = process::arg(2)
        pilot flags: word = cli_parse_flags(3, args_cnt)
        pilot target: word = cli_extract_flag(flags, 0)
        pilot opt: word = cli_extract_flag(flags, 1)
        pilot cross: word = cli_extract_flag(flags, 2)

        if subcmd == "build" {
            pilot binary: word = cli_build(src_file, target, opt, cross)
            if binary == "" {
                process::exit(1)
            }
        } else if subcmd == "run" {
            cli_run(src_file, target, opt, cross)
        } else if subcmd == "check" {
            -- Type-check only: read, lex, parse, check — no emit
            pilot source: word = fs::read(src_file)
            if source == "" {
                say C_BRED + "  ERROR" + C_RESET + " Could not read file: " + C_BWHITE + src_file + C_RESET
                process::exit(1)
            }
            pilot chk_hdr = C_BMAGENTA + "  FREAKC" + C_RESET + " " + C_DIM + "checking" + C_RESET + " " + C_BWHITE + src_file + C_RESET
            say chk_hdr
            init_arrays()
            say C_DIM + "  >> " + C_RESET + "Lexing..."
            tokenize(source)
            say C_DIM + "  >> " + C_RESET + "Parsing..."
            parse_program()
            say C_DIM + "  >> " + C_RESET + "Type checking..."
            check_program()
            say C_BGREEN + "  PASSED" + C_RESET + C_DIM + " -- no type errors found" + C_RESET
        } else if subcmd == "transpile" {
            -- Transpile only (matches current freakc_v2 behavior)
            pilot source: word = fs::read(src_file)
            if source == "" {
                pilot ferr2 = "Error: Could not read file: " + src_file
                say ferr2
                process::exit(1)
            }
            pilot transpiled: word = cli_transpile(src_file, source, target)
            if transpiled == "" {
                process::exit(1)
            }
        }

        give back
    }

    -- Doctor (setup diagnostics)
    if subcmd == "doctor" {
        cli_doctor()
        give back
    }

    -- Hangar package manager
    if subcmd == "hangar" {
        hangar_dispatch(args_cnt)
        give back
    }

    -- Legacy mode: first arg is a .fk file (backwards compat with freakc_v2 behavior)
    if subcmd.ends_with(".fk") {
        pilot flags: word = cli_parse_flags(2, args_cnt)
        pilot target: word = cli_extract_flag(flags, 0)

        pilot source: word = fs::read(subcmd)
        if source == "" {
            pilot ferr3 = "Error: Could not read file: " + subcmd
            say ferr3
            process::exit(1)
        }

        pilot msg = "FREAK v2 Compiling: " + subcmd + " (Target: " + target + ")"
        say msg

        pilot transpiled: word = cli_transpile(subcmd, source, target)
        if transpiled == "" {
            process::exit(1)
        }
        give back
    }

    -- Unknown subcommand
    pilot unknown_msg = C_BRED + "  ERROR" + C_RESET + " Unknown command '" + C_BWHITE + subcmd + C_RESET + "'"
    say unknown_msg
    say C_DIM + "  Run '" + C_RESET + "freakc help" + C_DIM + "' for usage information." + C_RESET
}

freakc_cli_main()
