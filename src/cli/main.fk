-- ===================================================================
-- FREAK CLI — Main Entry Point
-- ===================================================================
-- Replaces the Python `python -m freakc` CLI with a native FREAK binary.
-- Dispatches to subcommands: build, run, check, transpile, version, help.
-- ===================================================================

-- Paths stay separate from the colon-delimited profile, including drive names.
pilot cli_requested_output = ""
pilot cli_requested_graph_snapshot = ""
pilot cli_requested_manifest = ""
pilot cli_requested_locked = false
pilot cli_requested_offline = false
pilot cli_requested_frozen = false

task cli_flag_value(flag: word, start_idx: int) -> word {
    pilot value = ""
    pilot vi = start_idx
    repeat until vi >= flag.length() {
        value = value + flag.char_at(vi)
        vi += 1
    }
    give back value
}

task cli_flag_error(message: word) -> word {
    give back "error:" + message
}

task cli_parse_flags(start_idx: int, args_cnt: int, subcommand_mode: word) -> word {
    -- Parse flags from command line args starting at start_idx.
    -- Returns the canonical build specification:
    --   ok:target:profile:clang-opt:lto:runtime-policy:runtime-stats:cross
    -- or error:message. Validation is complete before global state or build
    -- artifacts can change.
    pilot target = "llvm"
    pilot opt = "2"
    pilot profile = "o2"
    pilot lto = "off"
    pilot runtime_policy = "default"
    pilot runtime_stats = "off"
    pilot cross = ""
    pilot backend_seen = ""
    pilot opt_seen = ""
    pilot lto_seen = ""
    pilot cross_seen = ""
    pilot plus03_seen = false
    pilot strict_seen = false
    pilot output_requested = ""
    pilot graph_requested = ""
    pilot manifest_requested = ""
    pilot locked_requested = false
    pilot offline_requested = false
    pilot frozen_requested = false
    pilot allow_build_profile = subcommand_mode == "build" or subcommand_mode == "run"

    pilot fi = start_idx
    repeat until fi >= args_cnt {
        pilot flag: word = process::arg(fi)
        if subcommand_mode == "run" and flag == "--" { break }
        if flag == "--c" {
            if backend_seen != "" and backend_seen != "c" {
                give back cli_flag_error("conflicting backend flags")
            }
            target = "c"
            backend_seen = "c"
        } else if flag == "--llvm" {
            if backend_seen != "" and backend_seen != "llvm" {
                give back cli_flag_error("conflicting backend flags")
            }
            target = "llvm"
            backend_seen = "llvm"
        } else if flag == "--strict-borrow" {
            strict_seen = true
        } else if flag == "-o" or flag == "--output" or flag.starts_with("--output=") {
            if not allow_build_profile { give back cli_flag_error("--output is only valid for build and run") }
            pilot requested = ""
            if flag.starts_with("--output=") {
                requested = cli_flag_value(flag, 9)
            } else {
                fi += 1
                if fi >= args_cnt { give back cli_flag_error("--output requires a file path") }
                requested = process::arg(fi)
                if requested.starts_with("--") { give back cli_flag_error("--output requires a file path") }
            }
            if requested == "" { give back cli_flag_error("--output requires a file path") }
            if output_requested != "" and output_requested != requested { give back cli_flag_error("conflicting output paths") }
            output_requested = requested
        } else if flag.starts_with("--graph-snapshot=") {
            pilot requested = cli_flag_value(flag, 17)
            if requested == "" { give back cli_flag_error("--graph-snapshot requires a file path") }
            if graph_requested != "" and graph_requested != requested { give back cli_flag_error("conflicting graph snapshots") }
            graph_requested = requested
        } else if flag.starts_with("--manifest-path=") {
            pilot requested = cli_flag_value(flag, 16)
            if requested == "" { give back cli_flag_error("--manifest-path requires a file path") }
            if manifest_requested != "" and manifest_requested != requested { give back cli_flag_error("conflicting manifest paths") }
            manifest_requested = requested
        } else if flag == "--locked" {
            locked_requested = true
        } else if flag == "--offline" {
            offline_requested = true
        } else if flag == "--frozen" {
            frozen_requested = true
            locked_requested = true
            offline_requested = true
        } else if flag == "+03" {
            if not allow_build_profile {
                give back cli_flag_error("+03 is only valid for build and run")
            }
            plus03_seen = true
        } else if flag.starts_with("--opt=") {
            if not allow_build_profile {
                give back cli_flag_error("--opt is only valid for build and run")
            }
            pilot oval = cli_flag_value(flag, 6)
            if oval != "0" and oval != "1" and oval != "2" and oval != "3" {
                give back cli_flag_error("--opt must be exactly 0, 1, 2, or 3")
            }
            if opt_seen != "" and opt_seen != oval {
                give back cli_flag_error("conflicting --opt flags")
            }
            opt = oval
            opt_seen = oval
        } else if flag == "--lto" {
            if not allow_build_profile {
                give back cli_flag_error("--lto is only valid for build and run")
            }
            if lto_seen != "" and lto_seen != "thin" {
                give back cli_flag_error("conflicting --lto flags")
            }
            lto = "thin"
            lto_seen = "thin"
        } else if flag.starts_with("--lto=") {
            if not allow_build_profile {
                give back cli_flag_error("--lto is only valid for build and run")
            }
            pilot lval = cli_flag_value(flag, 6)
            if lval != "thin" and lval != "full" and lval != "off" {
                give back cli_flag_error("--lto must be thin, full, or off")
            }
            if lto_seen != "" and lto_seen != lval {
                give back cli_flag_error("conflicting --lto flags")
            }
            lto = lval
            lto_seen = lval
        } else if flag.starts_with("--target=") {
            pilot tval = cli_flag_value(flag, 9)
            if tval == "" or not cli_cross_target_is_safe(tval) {
                give back cli_flag_error("--target requires a safe target triple")
            }
            -- Friendly aliases resolve to canonical triples; raw triples pass
            -- through byte-exact so the recorded clang command line is stable.
            pilot resolved_target = cli_resolve_target_alias(tval)
            if cross_seen != "" and cross_seen != resolved_target {
                give back cli_flag_error("conflicting --target flags")
            }
            cross = resolved_target
            cross_seen = resolved_target
        } else {
            give back cli_flag_error("unknown or malformed flag " + flag)
        }
        fi += 1
    }

    if plus03_seen and opt_seen != "" {
        give back cli_flag_error("+03 cannot be combined with --opt")
    }
    if plus03_seen and lto_seen == "off" {
        give back cli_flag_error("+03 cannot disable LTO")
    }
    if plus03_seen {
        profile = "plus03"
        opt = "3"
        runtime_policy = "plus03"
        if lto_seen == "" { lto = "thin" }
    } else {
        profile = "o" + opt
    }
    if cross != "" and lto != "off" {
        if plus03_seen {
            give back cli_flag_error("+03 is not supported with --target")
        }
        give back cli_flag_error("LTO is not supported with --target; use --lto=off")
    }

    strict_borrow = strict_seen
    cli_requested_output = output_requested
    cli_requested_graph_snapshot = graph_requested
    cli_requested_manifest = manifest_requested
    cli_requested_locked = locked_requested
    cli_requested_offline = offline_requested
    cli_requested_frozen = frozen_requested
    give back "ok:" + target + ":" + profile + ":" + opt + ":" + lto + ":" + runtime_policy + ":" + runtime_stats + ":" + cross
}

task cli_extract_flag(flags: word, idx: int) -> word {
    -- Extract the nth colon-delimited field from flags string.
    pilot res = ""
    pilot current = 0
    pilot i = 0
    pilot flen = flags.length()
    repeat until i >= flen {
        pilot c: word = flags.char_at(i)
        if c == ":" {
            if current == idx {
                give back res
            }
            current += 1
            res = ""
        } else {
            res = res + c
        }
        i += 1
    }
    if current == idx {
        give back res
    }
    give back ""
}

-- ── Flex Command (easter egg) ────────────────────────
task cli_flex() -> void {
    cli_show_banner()

    say cli_box_top(50)
    say cli_box_mid(" " + C_G1 + SYM_FIRE + " FREAK FLEXING" + C_RESET, 50)
    say cli_box_sep(50)
    say cli_box_mid("  " + C_BWHITE + "Language" + C_RESET + "        FREAK " + C_DIM + "(.fk)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Version" + C_RESET + "         " + CLI_VERSION + " " + C_DIM + CLI_CODENAME + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Self-hosting" + C_RESET + "    " + C_BGREEN + SYM_CHECK + " YES" + C_RESET + C_DIM + " (compiler compiles itself)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Backends" + C_RESET + "        " + C_BCYAN + "LLVM IR" + C_RESET + " + " + C_BYELLOW + "C" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Cross-compile" + C_RESET + "   " + C_BGREEN + SYM_CHECK + " YES" + C_RESET + C_DIM + " (--target=TRIPLE)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Package mgr" + C_RESET + "     " + C_BGREEN + SYM_CHECK + " Hangar" + C_RESET + C_DIM + " (built-in)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "GUI framework" + C_RESET + "   " + C_BGREEN + SYM_CHECK + " freak-ui" + C_RESET + C_DIM + " (immediate mode)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Platforms" + C_RESET + "       " + C_BCYAN + "Windows" + C_RESET + " / " + C_BGREEN + "Linux" + C_RESET + " / " + C_BWHITE + "macOS" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Std library" + C_RESET + "     " + C_DIM + "math, string, json, http, fs..." + C_RESET, 50)
    say cli_box_sep(50)
    say cli_box_mid("  " + C_BWHITE + "Aesthetic" + C_RESET + "       " + C_G1 + "A" + C_G2 + "n" + C_G3 + "i" + C_G4 + "m" + C_G5 + "e" + C_G6 + "-" + C_G1 + "c" + C_G2 + "o" + C_G3 + "r" + C_G4 + "e" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Vibe" + C_RESET + "            " + C_BMAGENTA + "MAXIMUM" + C_RESET, 50)
    say cli_box_bot(50)
    say ""

    -- Count .fk files in tests/ as a flex metric
    say "  " + C_DIM + C_ITALIC + "\"My compiler compiles itself. Does yours?\"" + C_RESET
    say ""
}

-- ── About / Pioneers (optional, non-intrusive) ──────────
task cli_about() -> void {
    cli_show_banner()
    say "  FREAK is a compiled, statically typed, memory-safe systems language."
    say "  Shipping compiler: self-hosted V3 (LLVM IR + C backends)."
    say ""
    say "  " + C_DIM + "Full history: docs/history/pioneers.md" + C_RESET
    say "  " + C_DIM + "Try: freak about --pioneers" + C_RESET
    say ""
}

task cli_pioneers() -> void {
    say ""
    say "  " + C_G1 + "Generation 0 — Python bootstrap (FREAK Lite)" + C_RESET
    say "  Proved the language could exist. Still the audit runner."
    say ""
    say "  " + C_G2 + "Generation 1 — V3 self-hosted compiler" + C_RESET
    say "  FREAK learned to compile itself. Shipping; actively hardened."
    say ""
    say "  " + C_G3 + "Generation 2 — V4 Maverick / 00-Unit (in progress)" + C_RESET
    say "  The modular rewrite. Not yet a V3 replacement."
    say ""
    say "  " + C_DIM + "docs/history/pioneers.md" + C_RESET
    say ""
}

-- ── Init Command ─────────────────────────────────────
task cli_init(project_name: word) -> void {
    say ""
    say "  " + C_G1 + SYM_SPARK + " Creating project: " + C_RESET + C_BWHITE + project_name + C_RESET
    say ""

    -- Create project directory
    pilot mkdir_cmd = "mkdir " + project_name
    process::exec(mkdir_cmd)

    -- Create main.fk
    pilot main_content = "-- " + project_name + "\n-- Created with FREAK " + CLI_VERSION + "\n\nsay \"Hello from " + project_name + "!\"\n"
    fs::write(project_name + "/main.fk", main_content)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + " " + project_name + "/main.fk"

    -- Create hangar.toml
    pilot toml_content = "[project]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    fs::write(project_name + "/hangar.toml", toml_content)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + " " + project_name + "/hangar.toml"

    say ""
    say "  " + C_DIM + "Get started:" + C_RESET
    say "    " + C_BWHITE + "cd " + project_name + C_RESET
    say "    " + C_BWHITE + "freak run main.fk" + C_RESET
    say ""
}

-- ── Standalone Hangar Dispatch ────────────────────────
-- When invoked as "hangar" (BusyBox pattern), args shift by 1:
--   hangar init   → process::arg(0)="hangar", arg(1)="init"
-- vs freak hangar init → arg(0)="freak", arg(1)="hangar", arg(2)="init"
task hangar_standalone_main() -> void {
    pilot args_cnt = process::args_count()

    if args_cnt >= 2 {
        pilot standalone_flag: word = process::arg(1)
        if standalone_flag == "--version" or standalone_flag == "-V" {
            cli_show_version()
            give back
        }
        if standalone_flag == "--help" or standalone_flag == "-h" or standalone_flag == "help" {
            -- Force Hangar's own command list, not the compiler help screen.
            hangar_dispatch(0)
            give back
        }
    }

    -- Set the global offset so hangar_arg(N) reads process::arg(N-1)
    hangar_arg_offset = 1

    -- Adjust args_cnt to match what hangar_dispatch expects
    -- (it checks args_cnt < 3, expects subcmd at hangar_arg(2) which becomes arg(1))
    pilot standalone_hangar_status = hangar_dispatch(args_cnt + 1)
    if standalone_hangar_status != 0 {
        process::exit(standalone_hangar_status)
    }
}

-- ── Main Dispatch ────────────────────────────────────
task freakc_cli_main() -> void {
    cli_configure_output()

    pilot args_cnt = process::args_count()

    -- Private stages authenticate their nonce and held-directory metadata.
    if args_cnt >= 2 and process::arg(1) == "__bootstrap-stage" {
        if args_cnt != 4 { say "Invalid private bootstrap stage invocation" process::exit(1) }
        pilot stage_ok = cli_bootstrap_stage(process::arg(2), process::arg(3))
        cli_bootstrap_release()
        if not stage_ok { say "Bootstrap stage error: " + cli_bootstrap_error process::exit(1) }
        give back
    }

    -- BusyBox pattern: check if invoked as "hangar"
    pilot argv0: word = process::arg(0)
    if argv0.ends_with("hangar") or argv0.ends_with("hangar.exe") {
        hangar_standalone_main()
        give back
    }

    if args_cnt < 2 {
        cli_show_help()
        give back
    }

    pilot subcmd: word = process::arg(1)

    -- Handle global flags before subcommands
    if subcmd == "--version" or subcmd == "-V" {
        cli_show_version()
        give back
    }
    if subcmd == "--help" or subcmd == "-h" or subcmd == "help" {
        cli_show_help()
        give back
    }
    if subcmd == "version" {
        cli_show_version()
        give back
    }

    if subcmd == "bootstrap-v4" or subcmd == "bootstrap" {
        pilot source_root = ""
        pilot output = ""
        pilot source_seen = false
        pilot output_seen = false
        pilot locked = false
        pilot selected_v4 = subcmd == "bootstrap-v4"
        pilot index = 2
        repeat until index >= args_cnt {
            pilot flag = process::arg(index)
            if flag == "--v4" { selected_v4 = true }
            else if flag == "--locked" { locked = true }
            else if flag.starts_with("--source=") {
                if source_seen { say "Duplicate bootstrap --source" process::exit(1) }
                source_seen = true
                source_root = cli_flag_value(flag, 9)
                if source_root == "" { say "Bootstrap --source requires a path" process::exit(1) }
            } else if flag.starts_with("--output=") {
                if output_seen { say "Duplicate bootstrap --output" process::exit(1) }
                output_seen = true
                output = cli_flag_value(flag, 9)
                if output == "" { say "Bootstrap --output requires a path" process::exit(1) }
            } else if flag == "--source" or flag == "--output" {
                index += 1
                if index >= args_cnt { say "Bootstrap option requires a path: " + flag process::exit(1) }
                if flag == "--source" {
                    if source_seen { say "Duplicate bootstrap --source" process::exit(1) }
                    source_seen = true
                    source_root = process::arg(index)
                    if source_root == "" or source_root.starts_with("--") { say "Bootstrap --source requires a path" process::exit(1) }
                } else {
                    if output_seen { say "Duplicate bootstrap --output" process::exit(1) }
                    output_seen = true
                    output = process::arg(index)
                    if output == "" or output.starts_with("--") { say "Bootstrap --output requires a path" process::exit(1) }
                }
            } else if flag != "--target=host" {
                say "Unknown or unsupported bootstrap option: " + flag
                process::exit(1)
            }
            index += 1
        }
        if not selected_v4 or source_root == "" or output == "" {
            say "Usage: freak bootstrap-v4 --source=V4_ROOT --output=NEW_DIRECTORY [--locked]"
            process::exit(1)
        }
        if not cli_output_path_absolute(output) {
            pilot cwd = cli_current_dir()
            if cwd == "" { say "Cannot resolve bootstrap output working directory" process::exit(1) }
            output = cli_host_path_join(cwd, output)
        }
        pilot bootstrap_ok = cli_bootstrap_v4(source_root, output, locked)
        cli_bootstrap_release()
        if not bootstrap_ok { say "Bootstrap error: " + cli_bootstrap_error process::exit(1) }
        give back
    }

    -- Flex easter egg
    if subcmd == "flex" {
        cli_flex()
        give back
    }

    -- About / pioneers (optional, non-intrusive)
    if subcmd == "about" {
        if args_cnt >= 3 and process::arg(2) == "--pioneers" {
            cli_pioneers()
        } else {
            cli_about()
        }
        give back
    }

    if subcmd == "init" {
        if args_cnt < 3 { say "Usage: freak init <project-name> [--template=cli|lib|http]" process::exit(1) }
        pilot template_name = "cli" pilot index = 3
        repeat until index >= args_cnt {
            pilot flag = process::arg(index)
            if flag.starts_with("--template=") { template_name = cli_flag_value(flag, 11) }
            else if flag == "--template" {
                index += 1
                if index >= args_cnt { say "--template requires cli, lib, or http" process::exit(1) }
                template_name = process::arg(index)
            } else { say "Unknown init option " + flag process::exit(1) }
            index += 1
        }
        if not cli_create_template(template_name, process::arg(2)) { say "Init error: " + cli_template_error process::exit(1) }
        say "Created project " + process::arg(2)
        give back
    }

    -- Subcommands that require a file argument
    if subcmd == "build" or subcmd == "run" or subcmd == "check" or subcmd == "transpile" {
        pilot src_file = "" pilot flag_start = 2
        if args_cnt > 2 and not process::arg(2).starts_with("-") and process::arg(2) != "+03" {
            src_file = process::arg(2) flag_start = 3
        }
        pilot flags: word = cli_parse_flags(flag_start, args_cnt, subcmd)
        if cli_extract_flag(flags, 0) == "error" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " " + cli_extract_flag(flags, 1)
            say ""
            process::exit(1)
        }
        pilot target: word = cli_extract_flag(flags, 1)
        pilot profile: word = cli_extract_flag(flags, 2)
        pilot opt: word = cli_extract_flag(flags, 3)
        pilot lto: word = cli_extract_flag(flags, 4)
        pilot runtime_policy: word = cli_extract_flag(flags, 5)
        pilot runtime_stats: word = cli_extract_flag(flags, 6)
        pilot cross: word = cli_extract_flag(flags, 7)
        if src_file == "" {
            src_file = cli_project_entry(cli_requested_manifest)
            if src_file == "" { say "Project error: " + cli_project_source_error process::exit(1) }
        }

        pilot output_path = cli_requested_output
        if output_path != "" and not cli_output_path_absolute(output_path) {
            pilot current = fs::canonical_path(".")
            if not fs::result_ok(current) {
                pilot message = fs::result_error(current)
                fs::result_release(current)
                say "Cannot resolve output directory: " + message
                process::exit(1)
            }
            output_path = cli_host_path_join(fs::result_word(current), output_path)
            fs::result_release(current)
        }
        if not cli_set_output_path_override(src_file, output_path) { process::exit(1) }
        package_configure_source_options(cli_requested_manifest, cli_requested_graph_snapshot, cli_requested_locked, cli_requested_offline, cli_requested_frozen)

        if subcmd == "build" {
            pilot binary: word = cli_build_profile(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
            if binary == "" {
                process::exit(1)
            }
        } else if subcmd == "run" {
            pilot program_arg_start = args_cnt
            pilot separator_index = flag_start
            repeat until separator_index >= args_cnt {
                if process::arg(separator_index) == "--" {
                    program_arg_start = separator_index + 1
                    break
                }
                separator_index += 1
            }
            pilot run_exit = cli_run(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross, program_arg_start)
            if run_exit != 0 { process::exit(run_exit) }
        } else if subcmd == "check" {
            pilot source: word = cli_prepare_source(src_file, target)
            if cli_project_source_error != "" or hangar_graph_error != "" { process::exit(1) }
            say ""
            say "  " + C_G3 + SYM_GEAR + " CHECKING" + C_RESET + " " + C_BWHITE + src_file + C_RESET
            say ""
            input_file = src_file
            diagnostic_source = source
            error_count = 0
            parse_error_count = 0
            init_arrays()
            cli_step_start()
            tokenize(source)
            if not cli_project_bind_tokens() { cli_project_binding_release() process::exit(1) }
            cli_step_done("Lexing")
            cli_step_start()
            parse_program()
            if error_count == 0 { cli_project_bind_ast() }
            cli_step_done("Parsing")
            if error_count > 0 {
                say ""
                say "  " + C_BRED + SYM_CROSS + " FAILED" + C_RESET + C_DIM + " -- syntax errors found" + C_RESET
                say ""
                process::exit(1)
            }
            cli_step_start()
            check_program()
            cli_step_done("Type checking")
            if error_count > 0 {
                say ""
                say "  " + C_BRED + SYM_CROSS + " FAILED" + C_RESET + C_DIM + " -- type/borrow errors found" + C_RESET
                say ""
                process::exit(1)
            }
            say ""
            cli_project_binding_release()
            say "  " + C_BGREEN + SYM_SPARK + " PASSED" + C_RESET + C_DIM + " -- no type errors found" + C_RESET
            say ""
        } else if subcmd == "transpile" {
            -- Transpile only
            -- Even an unreadable input invalidates the selected output from a
            -- prior invocation. cli_transpile repeats this at frontend entry.
            if not cli_invalidate_backend_output(src_file, target) {
                process::exit(1)
            }
            pilot source: word = cli_prepare_source(src_file, target)
            if cli_project_source_error != "" or hangar_graph_error != "" { process::exit(1) }
            pilot transpiled: word = cli_transpile(src_file, source, target)
            if transpiled == "" {
                process::exit(1)
            }
        }

        give back
    }

    -- Upgrade (download latest FREAK)
    if subcmd == "upgrade" {
        say ""
        say cli_box_top(45)
        say cli_box_mid(" " + C_G1 + SYM_ROCKET + " FREAK UPGRADE" + C_RESET, 45)
        say cli_box_sep(45)
        say cli_box_mid("  " + C_DIM + "Current: " + C_RESET + C_BWHITE + CLI_VERSION + C_RESET + " " + C_DIM + CLI_CODENAME + C_RESET, 45)
        say cli_box_bot(45)
        say ""
        pilot upgrade_res = hangar_install_freak()
        if upgrade_res == 0 {
            say ""
            say "  " + C_DIM + C_ITALIC + cli_random_quote(time::now_ms()) + C_RESET
            say ""
        } else {
            process::exit(upgrade_res)
        }
        give back
    }

    -- Doctor (setup diagnostics)
    if subcmd == "doctor" {
        pilot fix_mode = false
        pilot json_mode = false
        pilot doctor_target_raw = ""
        pilot doctor_target = ""
        pilot doctor_arg_i = 2
        repeat until doctor_arg_i >= args_cnt {
            pilot doctor_arg: word = process::arg(doctor_arg_i)
            if doctor_arg == "--fix" { fix_mode = true }
            else if doctor_arg == "--json" { json_mode = true }
            else if doctor_arg.starts_with("--target=") {
                pilot doctor_tval = cli_flag_value(doctor_arg, 9)
                if doctor_tval == "" or not cli_cross_target_is_safe(doctor_tval) {
                    say ""
                    say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " --target requires a safe target triple or alias"
                    say "  " + C_DIM + "Supported aliases: linux-x64, linux-arm64, windows-x64, macos-arm64" + C_RESET
                    say ""
                    process::exit(1)
                }
                pilot doctor_resolved = cli_resolve_target_alias(doctor_tval)
                if doctor_target != "" and doctor_target != doctor_resolved {
                    say ""
                    say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " conflicting --target flags"
                    say ""
                    process::exit(1)
                }
                doctor_target_raw = doctor_tval
                doctor_target = doctor_resolved
            }
            else if doctor_arg.starts_with("--") {
                say ""
                say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " unknown doctor flag " + doctor_arg
                say "  " + C_DIM + "Usage: " + C_RESET + "freak doctor [--fix] [--json] [--target=ALIAS|TRIPLE]"
                say ""
                process::exit(1)
            }
            doctor_arg_i += 1
        }
        if doctor_target != "" {
            pilot doctor_target_exit = cli_doctor_target_report(doctor_target_raw, doctor_target, json_mode)
            if doctor_target_exit != 0 { process::exit(doctor_target_exit) }
            give back
        }
        if json_mode {
            pilot json_exit = cli_doctor_json()
            if json_exit != 0 { process::exit(json_exit) }
            give back
        }
        pilot doctor_exit = cli_doctor(fix_mode)
        if doctor_exit != 0 { process::exit(doctor_exit) }
        give back
    }

    -- Hangar package manager
    if subcmd == "hangar" {
        pilot hangar_status = hangar_dispatch(args_cnt)
        if hangar_status != 0 { process::exit(hangar_status) }
        give back
    }

    -- Audit commands (shell out to Python; native port lands in V4)
    if subcmd == "audit-science" or subcmd == "audit-trust" or subcmd == "audit-miracles" or subcmd == "foreshadow-audit" or subcmd == "audit-conformance" {
        pilot audit_exit = cli_audit_dispatch(subcmd, args_cnt)
        if audit_exit != 0 {
            process::exit(audit_exit)
        }
        give back
    }

    if subcmd == "test" {
        pilot test_exit = cli_test_command(args_cnt)
        if test_exit != 0 { process::exit(test_exit) }
        give back
    }

    -- Legacy mode: first arg is a .fk file (backwards compat with freakc_v2 behavior)
    if subcmd.ends_with(".fk") {
        pilot flags: word = cli_parse_flags(2, args_cnt, "transpile")
        if cli_extract_flag(flags, 0) == "error" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " " + cli_extract_flag(flags, 1)
            say ""
            process::exit(1)
        }
        pilot target: word = cli_extract_flag(flags, 1)

        if not cli_invalidate_backend_output(subcmd, target) {
            process::exit(1)
        }
        package_configure_source_options(cli_requested_manifest, cli_requested_graph_snapshot, cli_requested_locked, cli_requested_offline, cli_requested_frozen)
        pilot source: word = cli_prepare_source(subcmd, target)
        if cli_project_source_error != "" or hangar_graph_error != "" { process::exit(1) }

        pilot msg = "FREAK v2 Compiling: " + subcmd + " (Target: " + target + ")"
        say msg

        pilot transpiled: word = cli_transpile(subcmd, source, target)
        if transpiled == "" {
            process::exit(1)
        }
        give back
    }

    -- Unknown subcommand
    say ""
    say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Unknown command '" + C_BWHITE + subcmd + C_RESET + "'"
    say "  " + C_DIM + "Run '" + C_RESET + "freak help" + C_DIM + "' for usage." + C_RESET
    say ""
}

task main() { freakc_cli_main() cli_bootstrap_release() cli_project_binding_release() package_release_graph() }
