-- ===================================================================
-- FREAK CLI — Main Entry Point
-- ===================================================================
-- Replaces the Python `python -m freakc` CLI with a native FREAK binary.
-- Dispatches to subcommands: build, run, check, transpile, version, help.
-- ===================================================================

task cli_flag_value(flag: word, start_idx: int) -> word {
    pilot value = ""
    pilot vi = start_idx
    repeat until vi >= flag.length() {
        value = value + flag.char_at(vi)
        vi += 1
    }
    give back value
}

task cli_flag_error(message: word) -> word {
    give back "error:" + message
}

task cli_parse_flags(start_idx: int, args_cnt: int, subcommand_mode: word) -> word {
    -- Parse flags from command line args starting at start_idx.
    -- Returns the canonical build specification:
    --   ok:target:profile:clang-opt:lto:runtime-policy:runtime-stats:cross
    -- or error:message. Validation is complete before global state or build
    -- artifacts can change.
    pilot target = "llvm"
    pilot opt = "2"
    pilot profile = "o2"
    pilot lto = "off"
    pilot runtime_policy = "default"
    pilot runtime_stats = "off"
    pilot cross = ""
    pilot backend_seen = ""
    pilot opt_seen = ""
    pilot lto_seen = ""
    pilot cross_seen = ""
    pilot plus03_seen = false
    pilot strict_seen = false
    pilot allow_build_profile = subcommand_mode == "build" or subcommand_mode == "run"

    pilot fi = start_idx
    repeat until fi >= args_cnt {
        pilot flag: word = process::arg(fi)
        if flag == "--c" {
            if backend_seen != "" and backend_seen != "c" {
                give back cli_flag_error("conflicting backend flags")
            }
            target = "c"
            backend_seen = "c"
        } else if flag == "--llvm" {
            if backend_seen != "" and backend_seen != "llvm" {
                give back cli_flag_error("conflicting backend flags")
            }
            target = "llvm"
            backend_seen = "llvm"
        } else if flag == "--strict-borrow" {
            if subcommand_mode == "transpile" {
                give back cli_flag_error("--strict-borrow is only valid for build, run, and check")
            }
            strict_seen = true
        } else if flag == "+03" {
            if not allow_build_profile {
                give back cli_flag_error("+03 is only valid for build and run")
            }
            plus03_seen = true
        } else if flag.starts_with("--opt=") {
            if not allow_build_profile {
                give back cli_flag_error("--opt is only valid for build and run")
            }
            pilot oval = cli_flag_value(flag, 6)
            if oval != "0" and oval != "1" and oval != "2" and oval != "3" {
                give back cli_flag_error("--opt must be exactly 0, 1, 2, or 3")
            }
            if opt_seen != "" and opt_seen != oval {
                give back cli_flag_error("conflicting --opt flags")
            }
            opt = oval
            opt_seen = oval
        } else if flag == "--lto" {
            if not allow_build_profile {
                give back cli_flag_error("--lto is only valid for build and run")
            }
            if lto_seen != "" and lto_seen != "thin" {
                give back cli_flag_error("conflicting --lto flags")
            }
            lto = "thin"
            lto_seen = "thin"
        } else if flag.starts_with("--lto=") {
            if not allow_build_profile {
                give back cli_flag_error("--lto is only valid for build and run")
            }
            pilot lval = cli_flag_value(flag, 6)
            if lval != "thin" and lval != "full" and lval != "off" {
                give back cli_flag_error("--lto must be thin, full, or off")
            }
            if lto_seen != "" and lto_seen != lval {
                give back cli_flag_error("conflicting --lto flags")
            }
            lto = lval
            lto_seen = lval
        } else if flag.starts_with("--target=") {
            pilot tval = cli_flag_value(flag, 9)
            if tval == "" or not cli_cross_target_is_safe(tval) {
                give back cli_flag_error("--target requires a safe target triple")
            }
            if cross_seen != "" and cross_seen != tval {
                give back cli_flag_error("conflicting --target flags")
            }
            cross = tval
            cross_seen = tval
        } else {
            give back cli_flag_error("unknown or malformed flag " + flag)
        }
        fi += 1
    }

    if plus03_seen and opt_seen != "" {
        give back cli_flag_error("+03 cannot be combined with --opt")
    }
    if plus03_seen and lto_seen == "off" {
        give back cli_flag_error("+03 cannot disable LTO")
    }
    if plus03_seen {
        profile = "plus03"
        opt = "3"
        runtime_policy = "plus03"
        if lto_seen == "" { lto = "thin" }
    } else {
        profile = "o" + opt
    }

    strict_borrow = strict_seen
    give back "ok:" + target + ":" + profile + ":" + opt + ":" + lto + ":" + runtime_policy + ":" + runtime_stats + ":" + cross
}

task cli_extract_flag(flags: word, idx: int) -> word {
    -- Extract the nth colon-delimited field from flags string.
    pilot res = ""
    pilot current = 0
    pilot i = 0
    pilot flen = flags.length()
    repeat until i >= flen {
        pilot c: word = flags.char_at(i)
        if c == ":" {
            if current == idx {
                give back res
            }
            current += 1
            res = ""
        } else {
            res = res + c
        }
        i += 1
    }
    if current == idx {
        give back res
    }
    give back ""
}

-- ── Flex Command (easter egg) ────────────────────────
task cli_flex() -> void {
    cli_show_banner()

    say cli_box_top(50)
    say cli_box_mid(" " + C_G1 + SYM_FIRE + " FREAK FLEXING" + C_RESET, 50)
    say cli_box_sep(50)
    say cli_box_mid("  " + C_BWHITE + "Language" + C_RESET + "        FREAK " + C_DIM + "(.fk)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Version" + C_RESET + "         " + CLI_VERSION + " " + C_DIM + CLI_CODENAME + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Self-hosting" + C_RESET + "    " + C_BGREEN + SYM_CHECK + " YES" + C_RESET + C_DIM + " (compiler compiles itself)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Backends" + C_RESET + "        " + C_BCYAN + "LLVM IR" + C_RESET + " + " + C_BYELLOW + "C" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Cross-compile" + C_RESET + "   " + C_BGREEN + SYM_CHECK + " YES" + C_RESET + C_DIM + " (--target=TRIPLE)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Package mgr" + C_RESET + "     " + C_BGREEN + SYM_CHECK + " Hangar" + C_RESET + C_DIM + " (built-in)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "GUI framework" + C_RESET + "   " + C_BGREEN + SYM_CHECK + " freak-ui" + C_RESET + C_DIM + " (immediate mode)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Platforms" + C_RESET + "       " + C_BCYAN + "Windows" + C_RESET + " / " + C_BGREEN + "Linux" + C_RESET + " / " + C_BWHITE + "macOS" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Std library" + C_RESET + "     " + C_DIM + "math, string, json, http, fs..." + C_RESET, 50)
    say cli_box_sep(50)
    say cli_box_mid("  " + C_BWHITE + "Aesthetic" + C_RESET + "       " + C_G1 + "A" + C_G2 + "n" + C_G3 + "i" + C_G4 + "m" + C_G5 + "e" + C_G6 + "-" + C_G1 + "c" + C_G2 + "o" + C_G3 + "r" + C_G4 + "e" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Vibe" + C_RESET + "            " + C_BMAGENTA + "MAXIMUM" + C_RESET, 50)
    say cli_box_bot(50)
    say ""

    -- Count .fk files in tests/ as a flex metric
    say "  " + C_DIM + C_ITALIC + "\"My compiler compiles itself. Does yours?\"" + C_RESET
    say ""
}

-- ── Init Command ─────────────────────────────────────
task cli_init(project_name: word) -> void {
    say ""
    say "  " + C_G1 + SYM_SPARK + " Creating project: " + C_RESET + C_BWHITE + project_name + C_RESET
    say ""

    -- Create project directory
    pilot mkdir_cmd = "mkdir " + project_name
    process::exec(mkdir_cmd)

    -- Create main.fk
    pilot main_content = "-- " + project_name + "\n-- Created with FREAK " + CLI_VERSION + "\n\nsay \"Hello from " + project_name + "!\"\n"
    fs::write(project_name + "/main.fk", main_content)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + " " + project_name + "/main.fk"

    -- Create hangar.toml
    pilot toml_content = "[project]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    fs::write(project_name + "/hangar.toml", toml_content)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + " " + project_name + "/hangar.toml"

    say ""
    say "  " + C_DIM + "Get started:" + C_RESET
    say "    " + C_BWHITE + "cd " + project_name + C_RESET
    say "    " + C_BWHITE + "freak run main.fk" + C_RESET
    say ""
}

-- ── Standalone Hangar Dispatch ────────────────────────
-- When invoked as "hangar" (BusyBox pattern), args shift by 1:
--   hangar init   → process::arg(0)="hangar", arg(1)="init"
-- vs freak hangar init → arg(0)="freak", arg(1)="hangar", arg(2)="init"
task hangar_standalone_main() -> void {
    pilot args_cnt = process::args_count()

    if args_cnt >= 2 {
        pilot standalone_flag: word = process::arg(1)
        if standalone_flag == "--version" or standalone_flag == "-V" or standalone_flag == "version" {
            cli_show_version()
            give back
        }
        if standalone_flag == "--help" or standalone_flag == "-h" or standalone_flag == "help" {
            -- Force Hangar's own command list, not the compiler help screen.
            hangar_dispatch(0)
            give back
        }
    }

    -- Set the global offset so hangar_arg(N) reads process::arg(N-1)
    hangar_arg_offset = 1

    -- Adjust args_cnt to match what hangar_dispatch expects
    -- (it checks args_cnt < 3, expects subcmd at hangar_arg(2) which becomes arg(1))
    hangar_dispatch(args_cnt + 1)
}

-- ── Main Dispatch ────────────────────────────────────
task freakc_cli_main() -> void {
    cli_configure_output()

    pilot args_cnt = process::args_count()

    -- BusyBox pattern: check if invoked as "hangar"
    pilot argv0: word = process::arg(0)
    if argv0.ends_with("hangar") or argv0.ends_with("hangar.exe") {
        hangar_standalone_main()
        give back
    }

    if args_cnt < 2 {
        cli_show_help()
        give back
    }

    pilot subcmd: word = process::arg(1)

    -- Handle global flags before subcommands
    if subcmd == "--version" or subcmd == "-V" {
        cli_show_version()
        give back
    }
    if subcmd == "--help" or subcmd == "-h" or subcmd == "help" {
        cli_show_help()
        give back
    }
    if subcmd == "version" {
        cli_show_version()
        give back
    }

    -- Flex easter egg
    if subcmd == "flex" {
        cli_flex()
        give back
    }

    -- Quick init
    if subcmd == "init" {
        if args_cnt < 3 {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " init requires a project name."
            say "  " + C_DIM + "Usage: " + C_RESET + "freak init <project-name>"
            say ""
            give back
        }
        cli_init(process::arg(2))
        give back
    }

    -- Subcommands that require a file argument
    if subcmd == "build" or subcmd == "run" or subcmd == "check" or subcmd == "transpile" {
        if args_cnt < 3 {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " " + subcmd + " requires a file argument."
            say "  " + C_DIM + "Usage: " + C_RESET + "freak " + subcmd + " <file.fk> [options]"
            say ""
            process::exit(1)
        }

        pilot src_file: word = process::arg(2)
        pilot flags: word = cli_parse_flags(3, args_cnt, subcmd)
        if cli_extract_flag(flags, 0) == "error" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " " + cli_extract_flag(flags, 1)
            say ""
            process::exit(1)
        }
        pilot target: word = cli_extract_flag(flags, 1)
        pilot profile: word = cli_extract_flag(flags, 2)
        pilot opt: word = cli_extract_flag(flags, 3)
        pilot lto: word = cli_extract_flag(flags, 4)
        pilot runtime_policy: word = cli_extract_flag(flags, 5)
        pilot runtime_stats: word = cli_extract_flag(flags, 6)
        pilot cross: word = cli_extract_flag(flags, 7)

        if subcmd == "build" {
            pilot binary: word = cli_build_profile(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
            if binary == "" {
                process::exit(1)
            }
        } else if subcmd == "run" {
            pilot run_exit = cli_run(src_file, target, profile, opt, lto, runtime_policy, runtime_stats, cross)
            if run_exit != 0 { process::exit(run_exit) }
        } else if subcmd == "check" {
            -- Type-check only: read, lex, parse, check — no emit
            pilot source: word = fs::read(src_file)
            if source == "" {
                say ""
                say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + C_BWHITE + src_file + C_RESET
                say ""
                process::exit(1)
            }
            say ""
            say "  " + C_G3 + SYM_GEAR + " CHECKING" + C_RESET + " " + C_BWHITE + src_file + C_RESET
            say ""
            input_file = src_file
            diagnostic_source = source
            source_map_reset()
            source_map_register(src_file, source)
            error_count = 0
            parse_error_count = 0
            init_arrays()
            cli_step_start()
            tokenize(source)
            cli_step_done("Lexing")
            cli_step_start()
            parse_program()
            cli_step_done("Parsing")
            if error_count > 0 {
                say ""
                say "  " + C_BRED + SYM_CROSS + " FAILED" + C_RESET + C_DIM + " -- syntax errors found" + C_RESET
                say ""
                process::exit(1)
            }
            cli_step_start()
            check_program()
            cli_step_done("Type checking")
            if error_count > 0 {
                say ""
                say "  " + C_BRED + SYM_CROSS + " FAILED" + C_RESET + C_DIM + " -- type/borrow errors found" + C_RESET
                say ""
                process::exit(1)
            }
            say ""
            say "  " + C_BGREEN + SYM_SPARK + " PASSED" + C_RESET + C_DIM + " -- no type errors found" + C_RESET
            say ""
        } else if subcmd == "transpile" {
            -- Transpile only
            -- Even an unreadable input invalidates the selected output from a
            -- prior invocation. cli_transpile repeats this at frontend entry.
            if not cli_invalidate_backend_output(src_file, target) {
                process::exit(1)
            }
            pilot source: word = fs::read(src_file)
            if source == "" {
                say ""
                say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + src_file
                say ""
                process::exit(1)
            }
            pilot transpiled: word = cli_transpile(src_file, source, target)
            if transpiled == "" {
                process::exit(1)
            }
        }

        give back
    }

    -- Upgrade (download latest FREAK)
    if subcmd == "upgrade" {
        say ""
        say cli_box_top(45)
        say cli_box_mid(" " + C_G1 + SYM_ROCKET + " FREAK UPGRADE" + C_RESET, 45)
        say cli_box_sep(45)
        say cli_box_mid("  " + C_DIM + "Current: " + C_RESET + C_BWHITE + CLI_VERSION + C_RESET + " " + C_DIM + CLI_CODENAME + C_RESET, 45)
        say cli_box_bot(45)
        say ""
        pilot upgrade_res = hangar_install_freak()
        if upgrade_res == 0 {
            say ""
            say "  " + C_DIM + C_ITALIC + cli_random_quote(time::now_ms()) + C_RESET
            say ""
        } else {
            process::exit(upgrade_res)
        }
        give back
    }

    -- Doctor (setup diagnostics)
    if subcmd == "doctor" {
        pilot fix_mode = false
        pilot json_mode = false
        pilot doctor_arg_i = 2
        repeat until doctor_arg_i >= args_cnt {
            pilot doctor_arg: word = process::arg(doctor_arg_i)
            if doctor_arg == "--fix" { fix_mode = true }
            if doctor_arg == "--json" { json_mode = true }
            doctor_arg_i += 1
        }
        if json_mode {
            pilot json_exit = cli_doctor_json()
            if json_exit != 0 { process::exit(json_exit) }
            give back
        }
        pilot doctor_exit = cli_doctor(fix_mode)
        if doctor_exit != 0 { process::exit(doctor_exit) }
        give back
    }

    -- Hangar package manager
    if subcmd == "hangar" {
        hangar_dispatch(args_cnt)
        give back
    }

    -- Audit commands (shell out to Python; native port lands in V4)
    if subcmd == "audit-science" or subcmd == "audit-trust" or subcmd == "audit-miracles" or subcmd == "foreshadow-audit" or subcmd == "audit-conformance" {
        pilot audit_exit = cli_audit_dispatch(subcmd, args_cnt)
        if audit_exit != 0 {
            process::exit(audit_exit)
        }
        give back
    }

    -- Test runner shim (wraps the Python suite runner; native runner is V4)
    if subcmd == "test" {
        pilot test_exit = process::exec("python tests/suite/run_tests.py")
        if test_exit != 0 {
            process::exit(test_exit)
        }
        give back
    }

    -- Legacy mode: first arg is a .fk file (backwards compat with freakc_v2 behavior)
    if subcmd.ends_with(".fk") {
        pilot flags: word = cli_parse_flags(2, args_cnt, "transpile")
        if cli_extract_flag(flags, 0) == "error" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " " + cli_extract_flag(flags, 1)
            say ""
            process::exit(1)
        }
        pilot target: word = cli_extract_flag(flags, 1)

        if not cli_invalidate_backend_output(subcmd, target) {
            process::exit(1)
        }
        pilot source: word = fs::read(subcmd)
        if source == "" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + subcmd
            say ""
            process::exit(1)
        }

        pilot msg = "FREAK v2 Compiling: " + subcmd + " (Target: " + target + ")"
        say msg

        pilot transpiled: word = cli_transpile(subcmd, source, target)
        if transpiled == "" {
            process::exit(1)
        }
        give back
    }

    -- Unknown subcommand
    say ""
    say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Unknown command '" + C_BWHITE + subcmd + C_RESET + "'"
    say "  " + C_DIM + "Run '" + C_RESET + "freak help" + C_DIM + "' for usage." + C_RESET
    say ""
}

freakc_cli_main()
