-- ===================================================================
-- Simple TOML Parser/Writer for hangar.toml
-- ===================================================================
-- Data stored as flat dot-notation in parallel arrays.
-- ===================================================================

pilot toml_keys_arr = 0
pilot toml_vals_arr = 0
pilot toml_count = 0

task toml_clear() -> void {
    if toml_keys_arr != 0 {
        array_release(toml_keys_arr)
        array_release(toml_vals_arr)
        array_release(toml_types_arr)
        array_release(toml_sections_arr)
    }
    toml_keys_arr = array_new()
    toml_vals_arr = array_new()
    toml_count = 0
    toml_types_arr = array_new()
    toml_sections_arr = array_new()
    toml_error = ""
    toml_error_line = 0
}

task toml_set(key: word, val: word) -> void {
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k == key {
            array_set(toml_vals_arr, i, val)
            array_set(toml_types_arr, i, "string")
            give back
        }
        i += 1
    }
    array_push(toml_keys_arr, key)
    array_push(toml_vals_arr, val)
    array_push(toml_types_arr, "string")
    toml_count += 1
}

task toml_get(key: word) -> word {
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k == key {
            give back array_get(toml_vals_arr, i)
        }
        i += 1
    }
    give back ""
}

task toml_has(key: word) -> bool {
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k == key {
            give back true
        }
        i += 1
    }
    give back false
}

task toml_remove_prefix(prefix: word) -> void {
    pilot new_keys = array_new()
    pilot new_vals = array_new()
    pilot new_types = array_new()
    pilot new_count = 0
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        pilot v: word = array_get(toml_vals_arr, i)
        if k != prefix and not k.starts_with(prefix + ".") {
            array_push(new_keys, k)
            array_push(new_vals, v)
            array_push(new_types, array_get(toml_types_arr, i))
            new_count += 1
        }
        i += 1
    }
    array_release(toml_keys_arr)
    array_release(toml_vals_arr)
    array_release(toml_types_arr)
    toml_keys_arr = new_keys
    toml_vals_arr = new_vals
    toml_types_arr = new_types
    toml_count = new_count
}

-- ===================== LINE EXTRACTION ==============================

task toml_get_line(content: word, start: int) -> word {
    -- Extract one line from content starting at start, up to \n
    pilot line = ""
    pilot i = start
    pilot clen = content.length()
    repeat until i >= clen {
        pilot c: word = content.char_at(i)
        if c == "\n" {
            give back line
        }
        line = line + c
        i += 1
    }
    give back line
}

task toml_line_end(content: word, start: int) -> int {
    -- Return position after the newline
    pilot i = start
    pilot clen = content.length()
    repeat until i >= clen {
        pilot c: word = content.char_at(i)
        i += 1
        if c == "\n" {
            give back i
        }
    }
    give back clen
}

task toml_trim(s: word) -> word {
    give back s.trim()
}

-- ===================== STRICT MANIFEST SUBSET =======================
-- Native manifests support basic/literal strings, decimal integers, booleans,
-- ordinary dotted tables/keys, and flat inline tables. Unsupported syntax is
-- an error, never a partially parsed manifest. Values retain scalar kind for
-- round-trip writing; all parser state belongs to this one parse operation.

pilot toml_error = ""
pilot toml_error_line = 0
pilot toml_value_kind = "string"
pilot toml_types_arr = 0
pilot toml_sections_arr = 0

task toml_fail(message: word) -> void {
    if toml_error == "" { toml_error = message }
}

task toml_valid_key(key: word) -> bool {
    if key == "" or key.starts_with(".") or key.ends_with(".") { give back false }
    pilot allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-."
    pilot previous_dot = false
    pilot i = 0
    repeat until i >= key.length() {
        pilot ch = key.char_at(i)
        if not allowed.contains(ch) { give back false }
        if ch == "." and previous_dot { give back false }
        previous_dot = ch == "."
        i += 1
    }
    give back true
}

task toml_strip_comment(line: word) -> word {
    pilot out = ""
    pilot quote = ""
    pilot escaped = false
    pilot i = 0
    repeat until i >= line.length() {
        pilot ch = line.char_at(i)
        if quote == "" {
            if ch == "#" { give back out.trim() }
            if ch == "\"" or ch == "'" { quote = ch }
        } else if escaped {
            escaped = false
        } else if quote == "\"" and ch == "\\" {
            escaped = true
        } else if ch == quote {
            quote = ""
        }
        out = out + ch
        i += 1
    }
    if quote != "" { toml_fail("unterminated quoted value") }
    give back out.trim()
}

task toml_unquote(value: word) -> word {
    pilot out = ""
    pilot quote = value.char_at(0)
    pilot escaped = false
    pilot i = 1
    repeat until i >= value.length() {
        pilot ch = value.char_at(i)
        if escaped {
            if ch == "n" { out = out + "\n" } else if ch == "r" { out = out + "\r" } else if ch == "t" { out = out + "\t" } else if ch == "\\" or ch == "\"" { out = out + ch } else { toml_fail("unsupported escape in manifest string") }
            escaped = false
        } else if quote == "\"" and ch == "\\" {
            escaped = true
        } else if ch == quote {
            if i != value.length() - 1 { toml_fail("unexpected data after quoted value") }
            give back out
        } else {
            out = out + ch
        }
        i += 1
    }
    toml_fail("unterminated quoted value")
    give back ""
}

task toml_parse_scalar(value: word) -> word {
    toml_value_kind = "string"
    if value == "" {
        toml_fail("missing value after '='")
        give back ""
    }
    if value.starts_with("\"") or value.starts_with("'") { give back toml_unquote(value) }
    toml_value_kind = "bare"
    if value == "true" or value == "false" { give back value }
    pilot start = 0
    if value.starts_with("+") or value.starts_with("-") { start = 1 }
    if start == value.length() { toml_fail("invalid decimal value") give back "" }
    pilot i = start
    repeat until i >= value.length() {
        if not "0123456789".contains(value.char_at(i)) {
            toml_fail("unsupported manifest value; use a quoted string or a flat inline table")
            give back ""
        }
        i += 1
    }
    if value.length() - start > 1 and value.char_at(start) == "0" { toml_fail("leading zeros in decimal value") }
    give back value
}

task toml_insert(key: word, value: word) -> void {
    if toml_has(key) { toml_fail("duplicate manifest key: " + key) give back }
    pilot i = 0
    repeat until i >= toml_count {
        pilot existing = array_get(toml_keys_arr, i)
        if existing.starts_with(key + ".") or key.starts_with(existing + ".") {
            toml_fail("scalar/table conflict at manifest key: " + key)
            give back
        }
        i += 1
    }
    toml_set(key, value)
    array_set(toml_types_arr, toml_count - 1, toml_value_kind)
}

task toml_find_equals(line: word) -> int {
    pilot i = 0
    repeat until i >= line.length() {
        if line.char_at(i) == "=" { give back i }
        i += 1
    }
    give back 0 - 1
}

task toml_parse_inline_pair(pair: word, prefix: word) -> void {
    pilot trimmed = pair.trim()
    pilot eq = toml_find_equals(trimmed)
    if eq < 1 { toml_fail("expected key = value inside inline table") give back }
    pilot key = trimmed.substring(0, eq).trim()
    if not toml_valid_key(key) or key.contains(".") { toml_fail("invalid inline table key") give back }
    pilot value = toml_parse_scalar(trimmed.substring(eq + 1, trimmed.length()).trim())
    if toml_error != "" { give back }
    toml_insert(prefix + "." + key, value)
}

task toml_parse_inline_table(value: word, prefix: word) -> void {
    if not value.ends_with("}") { toml_fail("unterminated inline table") give back }
    pilot pair = ""
    pilot quote = ""
    pilot escaped = false
    pilot i = 1
    repeat until i >= value.length() - 1 {
        pilot ch = value.char_at(i)
        pilot separator = false
        if quote == "" {
            if ch == "\"" or ch == "'" { quote = ch } else if ch == "{" or ch == "}" or ch == "[" or ch == "]" {
                toml_fail("nested inline tables and arrays are unsupported")
                give back
            } else if ch == "," {
                toml_parse_inline_pair(pair, prefix)
                pair = ""
                separator = true
            }
        } else if escaped {
            escaped = false
        } else if quote == "\"" and ch == "\\" {
            escaped = true
        } else if ch == quote {
            quote = ""
        }
        if not separator { pair = pair + ch }
        i += 1
    }
    if quote != "" { toml_fail("unterminated inline table string") give back }
    if pair.trim() == "" {
        if value.substring(1, value.length() - 2).trim() != "" { toml_fail("trailing inline table comma") }
    } else { toml_parse_inline_pair(pair, prefix) }
}

task toml_parse_kv(line: word, section: word) -> void {
    pilot eq = toml_find_equals(line)
    if eq < 1 { toml_fail("expected key = value") give back }
    pilot key = line.substring(0, eq).trim()
    if not toml_valid_key(key) { toml_fail("invalid manifest key") give back }
    pilot full_key = key
    if section != "" { full_key = section + "." + key }
    pilot raw = line.substring(eq + 1, line.length()).trim()
    if raw.starts_with("{") { toml_parse_inline_table(raw, full_key) give back }
    pilot value = toml_parse_scalar(raw)
    if toml_error != "" { give back }
    if section == "dependencies" { full_key = full_key + ".version" }
    toml_insert(full_key, value)
}

task toml_extract_section(line: word) -> word {
    if line.starts_with("[[") or not line.ends_with("]") {
        toml_fail("unsupported or unterminated table header")
        give back ""
    }
    pilot name = line.substring(1, line.length() - 2).trim()
    if not toml_valid_key(name) { toml_fail("invalid table name") give back "" }
    if toml_arr_contains(toml_sections_arr, array_len(toml_sections_arr), name) {
        toml_fail("duplicate table: " + name)
        give back ""
    }
    array_push(toml_sections_arr, name)
    give back name
}

task toml_parse(content: word) -> bool {
    toml_clear()
    pilot section = ""
    pilot pos = 0
    toml_error_line = 0
    repeat until pos >= content.length() {
        toml_error_line += 1
        pilot raw = toml_get_line(content, pos)
        pos = toml_line_end(content, pos)
        pilot line = toml_strip_comment(raw)
        if toml_error != "" { give back false }
        if line != "" {
            if line.starts_with("[") { section = toml_extract_section(line) } else { toml_parse_kv(line, section) }
            if toml_error != "" { give back false }
        }
    }
    toml_error_line = 0
    give back true
}

-- Serialize every retained key, rather than dropping author/module/export/tool
-- metadata. Dotted keys are ordinary TOML and preserve nested table ownership.

task toml_quote(value: word) -> word {
    pilot out = "\""
    pilot i = 0
    repeat until i >= value.length() {
        pilot ch = value.char_at(i)
        if ch == "\\" { out = out + "\\\\" } else if ch == "\"" { out = out + "\\\"" } else if ch == "\n" { out = out + "\\n" } else if ch == "\r" { out = out + "\\r" } else if ch == "\t" { out = out + "\\t" } else { out = out + ch }
        i += 1
    }
    give back out + "\""
}

task toml_key_char_rank(ch: word) -> int {
    pilot ordered = "-.0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"
    pilot i = 0
    repeat until i >= ordered.length() {
        if ordered.char_at(i) == ch { give back i }
        i += 1
    }
    give back 0 - 1
}

task toml_key_before(left: word, right: word) -> bool {
    pilot i = 0
    repeat until i >= left.length() or i >= right.length() {
        pilot a = toml_key_char_rank(left.char_at(i))
        pilot b = toml_key_char_rank(right.char_at(i))
        if a != b { give back a < b }
        i += 1
    }
    give back left.length() < right.length()
}

task toml_render() -> word {
    pilot order = array_new()
    pilot i = 0
    repeat until i >= toml_count {
        array_push(order, word_from_int(i))
        pilot j = i
        repeat until j <= 0 {
            pilot current = word_to_int(array_get(order, j))
            pilot previous = word_to_int(array_get(order, j - 1))
            if not toml_key_before(array_get(toml_keys_arr, current), array_get(toml_keys_arr, previous)) {
                j = 0
            } else {
                array_set(order, j, word_from_int(previous))
                array_set(order, j - 1, word_from_int(current))
                j -= 1
            }
        }
        i += 1
    }
    pilot out = ""
    i = 0
    repeat until i >= toml_count {
        pilot item = word_to_int(array_get(order, i))
        pilot value = array_get(toml_vals_arr, item)
        if array_get(toml_types_arr, item) != "bare" { value = toml_quote(value) }
        out = out + array_get(toml_keys_arr, item) + " = " + value + "\n"
        i += 1
    }
    array_release(order)
    -- Dotted scalar keys retain populated tables, but cannot represent a
    -- declared empty table. Preserve those declarations as real headers.
    i = 0
    repeat until i >= array_len(toml_sections_arr) {
        pilot section = array_get(toml_sections_arr, i)
        pilot populated = false
        pilot item = 0
        repeat until item >= toml_count {
            pilot key = array_get(toml_keys_arr, item)
            if key == section or key.starts_with(section + ".") { populated = true }
            item += 1
        }
        if not populated { out = out + "[" + section + "]\n" }
        i += 1
    }
    give back out
}

task toml_write_file(path: word) -> void {
    fs::write(path, toml_render())
}

task toml_extract_dep_name(key: word) -> word {
    -- From "dependencies.muvluv.git" extract "muvluv"
    pilot prefix_len = 13
    pilot rest = ""
    pilot i = prefix_len
    pilot klen = key.length()
    repeat until i >= klen {
        pilot c: word = key.char_at(i)
        if c == "." {
            give back rest
        }
        rest = rest + c
        i += 1
    }
    give back rest
}

task toml_arr_contains(arr: int, count: int, item: word) -> bool {
    pilot i = 0
    repeat until i >= count {
        pilot v: word = array_get(arr, i)
        if v == item { give back true }
        i += 1
    }
    give back false
}

-- ===================== DEPENDENCY HELPERS ===========================

task toml_dep_get_version(dep_name: word) -> word {
    -- Get version constraint for a dependency (works with both syntaxes)
    pilot ver_key = "dependencies." + dep_name + ".version"
    give back toml_get(ver_key)
}

task toml_dep_get_git(dep_name: word) -> word {
    -- Get git URL for a dependency
    pilot git_key = "dependencies." + dep_name + ".git"
    give back toml_get(git_key)
}

task toml_dep_is_short_syntax(dep_name: word) -> bool {
    -- Returns true if dependency uses short syntax (version only, no git URL)
    pilot git_val: word = toml_dep_get_git(dep_name)
    pilot ver_val: word = toml_dep_get_version(dep_name)
    give back git_val == "" and ver_val != ""
}

-- ===================== READING FROM FILE ===========================

task toml_load(path: word) -> bool {
    pilot content: word = fs::read(path)
    if content == "" {
        toml_clear()
        toml_fail("manifest is empty or unreadable")
        give back false
    }
    give back toml_parse(content)
}

-- ===================== DEPENDENCY LISTING ===========================

task toml_dep_names_arr() -> int {
    -- Returns array handle with dep names
    pilot deps = array_new()
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k.starts_with("dependencies.") {
            pilot dn: word = toml_extract_dep_name(k)
            if dn != "" {
                if toml_arr_contains(deps, array_len(deps), dn) == false {
                    array_push(deps, dn)
                }
            }
        }
        i += 1
    }
    give back deps
}

task toml_dep_count() -> int {
    pilot deps = toml_dep_names_arr()
    give back array_len(deps)
}
