-- ===================================================================
-- FREAK CLI — Doctor (Setup Diagnostics + Auto-Fix)
-- ===================================================================
-- freak doctor        — diagnose your setup
-- freak doctor --fix  — diagnose AND auto-install missing tools
-- ===================================================================

task cli_doctor_json_escape(input: word) -> word {
    pilot out = ""
    pilot i = 0
    repeat until i >= input.length() {
        pilot ch: word = input.char_at(i)
        if ch == "\\" {
            out = out + "\\\\"
        } else if ch == "\"" {
            out = out + "\\\""
        } else if ch == "\n" {
            out = out + "\\n"
        } else if ch == "\r" {
            out = out + "\\r"
        } else {
            out = out + ch
        }
        i += 1
    }
    give back out
}

task cli_doctor_json_bool(value: bool) -> word {
    if value { give back "true" }
    give back "false"
}

task cli_doctor_first_line(text: word) -> word {
    pilot line = ""
    pilot i = 0
    pilot finished = false
    repeat until finished {
        if i >= text.length() {
            finished = true
        } else {
            pilot ch: word = text.char_at(i)
            if ch == "\n" or ch == "\r" {
                finished = true
            } else {
                line = line + ch
            }
        }
        i += 1
    }
    give back line
}

task cli_doctor_std_module_count(std_dir: word) -> int {
    if std_dir == "" { give back 0 }
    pilot mod_count = 0
    if fs::exists(std_dir + "/math.fk")      { mod_count += 1 }
    if fs::exists(std_dir + "/math3d.fk")    { mod_count += 1 }
    if fs::exists(std_dir + "/zip.fk")       { mod_count += 1 }
    if fs::exists(std_dir + "/string.fk")    { mod_count += 1 }
    if fs::exists(std_dir + "/convert.fk")   { mod_count += 1 }
    if fs::exists(std_dir + "/algorithm.fk") { mod_count += 1 }
    if fs::exists(std_dir + "/json.fk")      { mod_count += 1 }
    if fs::exists(std_dir + "/http.fk")      { mod_count += 1 }
    if fs::exists(std_dir + "/version.fk")   { mod_count += 1 }
    if fs::exists(std_dir + "/runtime.fk")   { mod_count += 1 }
    give back mod_count
}

task cli_doctor_json() -> void {
    pilot os_tag = "unix"
    pilot is_win = false
    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        is_win = true
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Darwin") { os_tag = "macos" }
        else { os_tag = "linux" }
    }

    pilot clang_cmd = "clang --version 2>/dev/null"
    if is_win { clang_cmd = "clang --version 2>nul" }
    pilot clang_out: word = process::exec_capture(clang_cmd)
    pilot clang_ok = clang_out != ""
    pilot clang_version = cli_doctor_first_line(clang_out)

    pilot lld_cmd = "ld.lld --version 2>/dev/null"
    if is_win { lld_cmd = "where lld-link 2>nul" }
    pilot lld_out: word = process::exec_capture(lld_cmd)
    pilot lld_ok = lld_out != ""
    pilot lld_version = cli_doctor_first_line(lld_out)

    pilot rt_dir: word = cli_find_runtime_dir()
    pilot runtime_ok = rt_dir != ""
    pilot runtime_obj = false
    pilot llvm_runtime = false
    if runtime_ok {
        if is_win {
            runtime_obj = fs::exists(rt_dir + "/freak_runtime.obj")
        } else {
            runtime_obj = fs::exists(rt_dir + "/freak_runtime.o")
        }
        llvm_runtime = fs::exists(rt_dir + "/freak_llvm_runtime.c")
    }

    pilot std_dir: word = cli_find_std_dir()
    pilot std_modules = cli_doctor_std_module_count(std_dir)
    pilot std_ok = std_modules >= 10

    pilot all_ok = clang_ok and runtime_ok and std_ok
    pilot status = "issues"
    if all_ok { status = "ok" }

    say "{"
    say "  \"schema\": \"freak.doctor.v1\","
    say "  \"version\": \"" + cli_doctor_json_escape(CLI_VERSION) + "\","
    say "  \"codename\": \"" + cli_doctor_json_escape(CLI_CODENAME) + "\","
    say "  \"status\": \"" + status + "\","
    say "  \"platform\": {"
    say "    \"os\": \"" + cli_doctor_json_escape(os_tag) + "\","
    say "    \"windows\": " + cli_doctor_json_bool(is_win)
    say "  },"
    say "  \"checks\": {"
    say "    \"clang\": {"
    say "      \"ok\": " + cli_doctor_json_bool(clang_ok) + ","
    say "      \"version\": \"" + cli_doctor_json_escape(clang_version) + "\""
    say "    },"
    say "    \"lld\": {"
    say "      \"ok\": " + cli_doctor_json_bool(lld_ok) + ","
    say "      \"optional\": true,"
    say "      \"version\": \"" + cli_doctor_json_escape(lld_version) + "\""
    say "    },"
    say "    \"runtime\": {"
    say "      \"ok\": " + cli_doctor_json_bool(runtime_ok) + ","
    say "      \"path\": \"" + cli_doctor_json_escape(rt_dir) + "\","
    say "      \"precompiled_objects\": " + cli_doctor_json_bool(runtime_obj) + ","
    say "      \"llvm_runtime\": " + cli_doctor_json_bool(llvm_runtime)
    say "    },"
    say "    \"stdlib\": {"
    say "      \"ok\": " + cli_doctor_json_bool(std_ok) + ","
    say "      \"path\": \"" + cli_doctor_json_escape(std_dir) + "\","
    say "      \"modules_found\": " + word_from_int(std_modules) + ","
    say "      \"modules_expected\": 10"
    say "    },"
    say "    \"compile_pipeline\": {"
    say "      \"ok\": null,"
    say "      \"skipped\": true,"
    say "      \"reason\": \"json mode is passive; run freak doctor for the full compile probe\""
    say "    }"
    say "  }"
    say "}"
}

-- Try to install clang/lld on the current platform.
-- Returns 0 if installation succeeded (or already installed).
task cli_install_clang(os_tag: word) -> int {
    say "  " + C_DIM + "Attempting to install clang..." + C_RESET
    if os_tag == "windows" {
        -- Try winget first (ships with Windows 10 1.0 and later)
        pilot wg_res = process::exec("winget install LLVM.LLVM --silent --accept-package-agreements --accept-source-agreements")
        if wg_res == 0 { give back 0 }
        -- Fallback: chocolatey
        pilot choco_res = process::exec("choco install llvm -y")
        if choco_res == 0 { give back 0 }
        say "  " + C_BYELLOW + "  Auto-install failed. Install manually:" + C_RESET
        say "    " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
        say "    " + C_CYAN + "choco install llvm" + C_RESET
        say "    https://github.com/llvm/llvm-project/releases"
        give back 1
    } else if os_tag == "linux" {
        -- Try apt (Debian/Ubuntu)
        pilot apt_res = process::exec("sudo apt-get install -y clang lld")
        if apt_res == 0 { give back 0 }
        -- Try dnf (Fedora/RHEL)
        pilot dnf_res = process::exec("sudo dnf install -y clang lld")
        if dnf_res == 0 { give back 0 }
        -- Try pacman (Arch)
        pilot pacman_res = process::exec("sudo pacman -S --noconfirm clang lld")
        if pacman_res == 0 { give back 0 }
        say "  " + C_BYELLOW + "  Could not auto-install. Try:" + C_RESET
        say "    " + C_CYAN + "sudo apt install clang lld" + C_RESET + "  (Debian/Ubuntu)"
        say "    " + C_CYAN + "sudo dnf install clang lld" + C_RESET + "  (Fedora)"
        give back 1
    } else if os_tag == "macos" {
        -- Try brew
        pilot brew_res = process::exec("brew install llvm")
        if brew_res == 0 { give back 0 }
        -- Fallback: xcode command line tools
        process::exec("xcode-select --install")
        say "  " + C_DIM + "If prompted, complete the Xcode CLT install then rerun 'freak doctor'" + C_RESET
        give back 0
    }
    give back 1
}

task cli_doctor(fix_mode: bool) -> void {
    -- Detect OS
    pilot os_tag = "unix"
    pilot is_win = false
    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        is_win = true
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Darwin") { os_tag = "macos" }
        else { os_tag = "linux" }
    }

    say ""
    say cli_box_top(50)
    if fix_mode {
        say cli_box_mid(" " + C_G1 + SYM_GEAR + " FREAK DOCTOR" + C_RESET + C_DIM + " --fix  repairing..." + C_RESET, 50)
    } else {
        say cli_box_mid(" " + C_G1 + SYM_GEAR + " FREAK DOCTOR" + C_RESET + C_DIM + "  diagnosing your setup..." + C_RESET, 50)
    }
    say cli_box_bot(50)
    say ""

    pilot all_ok = true
    pilot checks_passed = 0

    -- ── 1. clang ──────────────────────────────────────────
    say "  " + C_BWHITE + "[1/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " clang"
    pilot clang_exit = process::exec("clang --version")
    if clang_exit == 0 {
        pilot clang_ver: word = process::exec_capture("clang --version")
        -- First line of clang version output
        pilot cv_line = ""
        pilot cvi = 0
        pilot cv_done = false
        repeat until cv_done {
            if cvi >= clang_ver.length() { cv_done = true }
            else {
                pilot cch: word = clang_ver.char_at(cvi)
                if cch == "\n" or cch == "\r" { cv_done = true }
                else { cv_line = cv_line + cch }
            }
            cvi += 1
        }
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + C_DIM + cv_line + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " clang " + C_RED + "not found" + C_RESET
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Attempting auto-install..." + C_RESET
            pilot clang_fix = cli_install_clang(os_tag)
            if clang_fix == 0 {
                say "        " + C_BGREEN + SYM_CHECK + C_RESET + " clang installed!"
                checks_passed += 1
                all_ok = true
            }
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak doctor --fix" + C_RESET
            if is_win {
                say "         or: " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
            } else if os_tag == "linux" {
                say "         or: " + C_CYAN + "sudo apt install clang lld" + C_RESET
            } else if os_tag == "macos" {
                say "         or: " + C_CYAN + "xcode-select --install" + C_RESET
            }
        }
    }
    say ""

    -- ── 2. lld (linker) ───────────────────────────────────
    say "  " + C_BWHITE + "[2/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " lld linker"
    pilot lld_found = false
    if is_win {
        -- "where" checks PATH without running the binary
        pilot lld_exit = process::exec("where lld-link")
        if lld_exit == 0 { lld_found = true }
    } else {
        pilot lld_exit = process::exec("ld.lld --version")
        if lld_exit == 0 { lld_found = true }
    }
    if lld_found {
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " lld found " + C_DIM + "(bundle mode available)" + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BYELLOW + SYM_RING + C_RESET + " lld not found " + C_DIM + "(optional — clang can link too)" + C_RESET
        checks_passed += 1
    }
    say ""

    -- ── 3. Runtime ────────────────────────────────────────
    say "  " + C_BWHITE + "[3/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " runtime"
    pilot rt_dir: word = cli_find_runtime_dir()
    if rt_dir != "" {
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + C_DIM + rt_dir + C_RESET
        pilot has_obj = false
        if is_win {
            has_obj = fs::exists(rt_dir + "/freak_runtime.obj")
        } else {
            has_obj = fs::exists(rt_dir + "/freak_runtime.o")
        }
        if has_obj {
            say "        " + C_BGREEN + SYM_CHECK + C_RESET + C_DIM + " pre-compiled objects (fast bundle mode)" + C_RESET
        } else {
            say "        " + C_BYELLOW + SYM_RING + C_RESET + C_DIM + " no pre-compiled objects (source fallback active)" + C_RESET
        }
        if fs::exists(rt_dir + "/freak_llvm_runtime.c") {
            say "        " + C_BGREEN + SYM_CHECK + C_RESET + C_DIM + " LLVM runtime available" + C_RESET
        }
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " runtime directory not found"
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Downloading runtime..." + C_RESET
            -- Re-run the upgrade to get runtime files
            hangar_install_freak()
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak upgrade" + C_RESET + " or re-run install script"
        }
    }
    say ""

    -- ── 4. Standard library ───────────────────────────────
    say "  " + C_BWHITE + "[4/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " standard library"
    pilot std_dir: word = cli_find_std_dir()
    if std_dir != "" {
        pilot mod_count = cli_doctor_std_module_count(std_dir)
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + word_from_int(mod_count) + "/10 modules in " + C_DIM + std_dir + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " standard library not found"
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Re-run upgrade to download std..." + C_RESET
            hangar_install_freak()
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak upgrade" + C_RESET
        }
    }
    say ""

    -- ── 5. Compile pipeline test ──────────────────────────
    say "  " + C_BWHITE + "[5/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " compile pipeline"
    if clang_exit == 0 and rt_dir != "" {
        pilot test_src = "say \"FREAK doctor test\""
        pilot test_path = "_freak_doctor_test.fk"
        fs::write(test_path, test_src)
        pilot transpiled: word = cli_transpile(test_path, test_src, "llvm")
        if transpiled != "" {
            pilot bin: word = cli_build_binary(transpiled, test_path, "llvm", "2", "")
            if bin != "" {
                say "        " + C_BGREEN + SYM_CHECK + C_RESET + " full pipeline works"
                fs::delete(bin)
                checks_passed += 1
            } else {
                say "        " + C_BRED + SYM_CROSS + C_RESET + " clang compilation error (see above)"
                all_ok = false
            }
            fs::delete(transpiled)
        } else {
            say "        " + C_BRED + SYM_CROSS + C_RESET + " transpilation error"
            all_ok = false
        }
        fs::delete(test_path)
    } else {
        say "        " + C_BYELLOW + SYM_RING + C_RESET + C_DIM + " skipped (fix missing clang/runtime first)" + C_RESET
    }
    say ""

    -- ── Summary ───────────────────────────────────────────
    say cli_box_top(50)
    if all_ok {
        say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " ALL SYSTEMS GO" + C_RESET + "  " + C_DIM + word_from_int(checks_passed) + "/5 passed" + C_RESET, 50)
        say cli_box_sep(50)
        say cli_box_mid("  " + C_DIM + "Get started:" + C_RESET + "  freak build hello.fk", 50)
    } else {
        say cli_box_mid(" " + C_BRED + SYM_CROSS + " ISSUES FOUND" + C_RESET + "  " + C_DIM + word_from_int(checks_passed) + "/5 passed" + C_RESET, 50)
        say cli_box_sep(50)
        if fix_mode {
            say cli_box_mid("  Run " + C_BWHITE + "freak doctor" + C_RESET + " to verify fixes", 50)
        } else {
            say cli_box_mid("  Run " + C_BWHITE + "freak doctor --fix" + C_RESET + " to auto-repair", 50)
        }
    }
    say cli_box_bot(50)
    say ""
}
