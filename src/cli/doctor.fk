-- ===================================================================
-- FREAK CLI — Doctor (Setup Diagnostics + Auto-Fix)
-- ===================================================================
-- freak doctor        — diagnose your setup
-- freak doctor --fix  — diagnose AND auto-install missing tools
-- ===================================================================

task cli_doctor_json_escape(input: word) -> word {
    pilot out = ""
    pilot i = 0
    repeat until i >= input.length() {
        pilot ch: word = input.char_at(i)
        if ch == "\\" {
            out = out + "\\\\"
        } else if ch == "\"" {
            out = out + "\\\""
        } else if ch == "\n" {
            out = out + "\\n"
        } else if ch == "\r" {
            out = out + "\\r"
        } else {
            out = out + ch
        }
        i += 1
    }
    give back out
}

task cli_doctor_json_bool(value: bool) -> word {
    if value { give back "true" }
    give back "false"
}

task cli_doctor_normalize_cmd_override(cmd: word) -> word {
    if cmd == "" { give back "" }
    if cmd.char_at(0) == "\"" { give back cmd }
    if cmd.contains(" ") { give back "\"" + cmd + "\"" }
    give back cmd
}

task cli_doctor_find_clang_command() -> word {
    give back cli_find_clang_command()
}

task cli_doctor_clang_command_works(clang_cmd: word) -> bool {
    if clang_cmd == "" { give back false }
    pilot windir: word = process::env("WINDIR")
    if windir != "" {
        if process::exec(clang_cmd + " --version >nul 2>nul") == 0 { give back true }
    } else {
        if process::exec(clang_cmd + " --version >/dev/null 2>/dev/null") == 0 { give back true }
    }
    give back false
}

task cli_doctor_clang_version_line(clang_cmd: word) -> word {
    if clang_cmd == "" { give back "" }
    pilot clang_ver: word = process::exec_capture(clang_cmd + " --version")
    give back cli_doctor_first_line(clang_ver)
}

task cli_doctor_first_line(text: word) -> word {
    pilot line = ""
    pilot i = 0
    pilot finished = false
    repeat until finished {
        if i >= text.length() {
            finished = true
        } else {
            pilot ch: word = text.char_at(i)
            if ch == "\n" or ch == "\r" {
                finished = true
            } else {
                line = line + ch
            }
        }
        i += 1
    }
    give back line
}

task cli_doctor_std_module_count(std_dir: word) -> int {
    if std_dir == "" { give back 0 }
    pilot mod_count = 0
    if fs::exists(std_dir + "/math.fk")      { mod_count += 1 }
    if fs::exists(std_dir + "/math3d.fk")    { mod_count += 1 }
    if fs::exists(std_dir + "/zip.fk")       { mod_count += 1 }
    if fs::exists(std_dir + "/string.fk")    { mod_count += 1 }
    if fs::exists(std_dir + "/convert.fk")   { mod_count += 1 }
    if fs::exists(std_dir + "/algorithm.fk") { mod_count += 1 }
    if fs::exists(std_dir + "/json.fk")      { mod_count += 1 }
    if fs::exists(std_dir + "/http.fk")      { mod_count += 1 }
    if fs::exists(std_dir + "/version.fk")   { mod_count += 1 }
    if fs::exists(std_dir + "/runtime.fk")   { mod_count += 1 }
    if fs::exists(std_dir + "/ui/window.fk") { mod_count += 1 }
    give back mod_count
}

task cli_doctor_append_missing(missing: word, file: word) -> word {
    if missing == "" { give back file }
    give back missing + ", " + file
}

task cli_doctor_runtime_missing(runtime_dir: word) -> word {
    if runtime_dir == "" { give back "runtime directory" }
    pilot missing = ""
    if not fs::exists(runtime_dir + "/freak_runtime.c") {
        missing = cli_doctor_append_missing(missing, "freak_runtime.c")
    }
    if not fs::exists(runtime_dir + "/freak_runtime.h") {
        missing = cli_doctor_append_missing(missing, "freak_runtime.h")
    }
    if not fs::exists(runtime_dir + "/freak_llvm_runtime.c") {
        missing = cli_doctor_append_missing(missing, "freak_llvm_runtime.c")
    }
    if not fs::exists(runtime_dir + "/ui/win32_backend.c") {
        missing = cli_doctor_append_missing(missing, "ui/win32_backend.c")
    }
    if not fs::exists(runtime_dir + "/ui/freak_ui_platform.h") {
        missing = cli_doctor_append_missing(missing, "ui/freak_ui_platform.h")
    }
    give back missing
}

task cli_doctor_std_missing(std_dir: word) -> word {
    if std_dir == "" { give back "standard library directory" }
    pilot missing = ""
    if not fs::exists(std_dir + "/math.fk") { missing = cli_doctor_append_missing(missing, "math.fk") }
    if not fs::exists(std_dir + "/math3d.fk") { missing = cli_doctor_append_missing(missing, "math3d.fk") }
    if not fs::exists(std_dir + "/zip.fk") { missing = cli_doctor_append_missing(missing, "zip.fk") }
    if not fs::exists(std_dir + "/string.fk") { missing = cli_doctor_append_missing(missing, "string.fk") }
    if not fs::exists(std_dir + "/convert.fk") { missing = cli_doctor_append_missing(missing, "convert.fk") }
    if not fs::exists(std_dir + "/algorithm.fk") { missing = cli_doctor_append_missing(missing, "algorithm.fk") }
    if not fs::exists(std_dir + "/json.fk") { missing = cli_doctor_append_missing(missing, "json.fk") }
    if not fs::exists(std_dir + "/http.fk") { missing = cli_doctor_append_missing(missing, "http.fk") }
    if not fs::exists(std_dir + "/version.fk") { missing = cli_doctor_append_missing(missing, "version.fk") }
    if not fs::exists(std_dir + "/runtime.fk") { missing = cli_doctor_append_missing(missing, "runtime.fk") }
    if not fs::exists(std_dir + "/ui/window.fk") { missing = cli_doctor_append_missing(missing, "ui/window.fk") }
    give back missing
}

task cli_doctor_json() -> int {
    pilot os_tag = "unix"
    pilot is_win = false
    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        is_win = true
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Darwin") { os_tag = "macos" }
        else { os_tag = "linux" }
    }

    pilot clang_cmd = cli_doctor_find_clang_command()
    pilot clang_ok = cli_doctor_clang_command_works(clang_cmd)
    pilot clang_version = ""
    if clang_ok {
        clang_version = cli_doctor_clang_version_line(clang_cmd)
    }

    pilot lld_cmd = "ld.lld --version 2>/dev/null"
    if is_win { lld_cmd = "where lld-link 2>nul" }
    pilot lld_out: word = process::exec_capture(lld_cmd)
    pilot lld_ok = lld_out != ""
    pilot lld_version = cli_doctor_first_line(lld_out)

    pilot rt_dir: word = cli_find_runtime_dir()
    pilot runtime_missing = cli_doctor_runtime_missing(rt_dir)
    pilot runtime_ok = runtime_missing == ""
    pilot runtime_obj = false
    pilot llvm_runtime = false
    if rt_dir != "" {
        if is_win {
            runtime_obj = fs::exists(rt_dir + "/freak_runtime.obj")
        } else {
            runtime_obj = fs::exists(rt_dir + "/freak_runtime.o")
        }
        llvm_runtime = fs::exists(rt_dir + "/freak_llvm_runtime.c")
    }

    pilot std_dir: word = cli_find_std_dir()
    pilot std_modules = cli_doctor_std_module_count(std_dir)
    pilot std_missing = cli_doctor_std_missing(std_dir)
    pilot std_ok = std_missing == ""

    pilot all_ok = clang_ok and runtime_ok and std_ok
    pilot status = "issues"
    if all_ok { status = "ok" }

    say "{"
    say "  \"schema\": \"freak.doctor.v1\","
    say "  \"version\": \"" + cli_doctor_json_escape(CLI_VERSION) + "\","
    say "  \"codename\": \"" + cli_doctor_json_escape(CLI_CODENAME) + "\","
    say "  \"status\": \"" + status + "\","
    say "  \"platform\": {"
    say "    \"os\": \"" + cli_doctor_json_escape(os_tag) + "\","
    say "    \"windows\": " + cli_doctor_json_bool(is_win)
    say "  },"
    say "  \"checks\": {"
    say "    \"clang\": {"
    say "      \"ok\": " + cli_doctor_json_bool(clang_ok) + ","
    say "      \"command\": \"" + cli_doctor_json_escape(clang_cmd) + "\","
    say "      \"version\": \"" + cli_doctor_json_escape(clang_version) + "\""
    say "    },"
    say "    \"lld\": {"
    say "      \"ok\": " + cli_doctor_json_bool(lld_ok) + ","
    say "      \"optional\": true,"
    say "      \"version\": \"" + cli_doctor_json_escape(lld_version) + "\""
    say "    },"
    say "    \"runtime\": {"
    say "      \"ok\": " + cli_doctor_json_bool(runtime_ok) + ","
    say "      \"path\": \"" + cli_doctor_json_escape(rt_dir) + "\","
    say "      \"files_expected\": 5,"
    say "      \"missing\": \"" + cli_doctor_json_escape(runtime_missing) + "\","
    say "      \"precompiled_objects\": " + cli_doctor_json_bool(runtime_obj) + ","
    say "      \"llvm_runtime\": " + cli_doctor_json_bool(llvm_runtime)
    say "    },"
    say "    \"stdlib\": {"
    say "      \"ok\": " + cli_doctor_json_bool(std_ok) + ","
    say "      \"path\": \"" + cli_doctor_json_escape(std_dir) + "\","
    say "      \"modules_found\": " + word_from_int(std_modules) + ","
    say "      \"modules_expected\": 11,"
    say "      \"missing\": \"" + cli_doctor_json_escape(std_missing) + "\""
    say "    },"
    say "    \"compile_pipeline\": {"
    say "      \"ok\": null,"
    say "      \"skipped\": true,"
    say "      \"reason\": \"json mode is passive; run freak doctor for the full compile probe\""
    say "    }"
    say "  }"
    say "}"
    if all_ok { give back 0 }
    give back 1
}

-- Try to install clang/lld on the current platform.
-- Returns 0 if installation succeeded (or already installed).
task cli_install_clang(os_tag: word) -> int {
    say "  " + C_DIM + "Attempting to install clang..." + C_RESET
    if os_tag == "windows" {
        if process::exec("where winget >nul 2>nul") == 0 {
            pilot wg_res = process::exec("winget install --id MartinStorsjo.LLVM-MinGW.UCRT -e --silent --accept-package-agreements --accept-source-agreements")
            if wg_res == 0 { give back 0 }
        }
        if process::exec("where scoop >nul 2>nul") == 0 {
            pilot scoop_res = process::exec("scoop install llvm-mingw")
            if scoop_res == 0 { give back 0 }
        }
        say "  " + C_BYELLOW + "  Auto-install failed. Install manually:" + C_RESET
        say "    " + C_CYAN + "winget install --id MartinStorsjo.LLVM-MinGW.UCRT -e" + C_RESET
        say "    " + C_CYAN + "scoop install llvm-mingw" + C_RESET
        say "    https://github.com/mstorsjo/llvm-mingw/releases"
        give back 1
    } else if os_tag == "linux" {
        pilot elevate = "sudo "
        pilot user_id: word = process::exec_capture("id -u 2>/dev/null").trim()
        if user_id == "0" { elevate = "" }
        if elevate != "" and process::exec("command -v sudo >/dev/null 2>/dev/null") != 0 {
            say "  " + C_BYELLOW + "  Administrator privileges are required for dependency installation." + C_RESET
            give back 1
        }
        if process::exec("command -v apt-get >/dev/null 2>/dev/null") == 0 {
            if process::exec(elevate + "apt-get update") == 0 {
                pilot apt_res = process::exec(elevate + "apt-get install -y clang lld build-essential")
                if apt_res == 0 { give back 0 }
            }
        } else if process::exec("command -v dnf >/dev/null 2>/dev/null") == 0 {
            pilot dnf_res = process::exec(elevate + "dnf install -y clang lld gcc glibc-devel")
            if dnf_res == 0 { give back 0 }
        } else if process::exec("command -v yum >/dev/null 2>/dev/null") == 0 {
            pilot yum_res = process::exec(elevate + "yum install -y clang lld gcc glibc-devel")
            if yum_res == 0 { give back 0 }
        } else if process::exec("command -v pacman >/dev/null 2>/dev/null") == 0 {
            pilot pacman_res = process::exec(elevate + "pacman -S --needed --noconfirm clang lld base-devel")
            if pacman_res == 0 { give back 0 }
        } else if process::exec("command -v zypper >/dev/null 2>/dev/null") == 0 {
            pilot zypper_res = process::exec(elevate + "zypper --non-interactive install clang lld gcc")
            if zypper_res == 0 { give back 0 }
        } else if process::exec("command -v apk >/dev/null 2>/dev/null") == 0 {
            pilot apk_res = process::exec(elevate + "apk add clang lld build-base musl-dev")
            if apk_res == 0 { give back 0 }
        }
        say "  " + C_BYELLOW + "  Could not auto-install. Try:" + C_RESET
        say "    " + C_CYAN + "sudo apt install clang lld build-essential" + C_RESET + "  (Debian/Ubuntu)"
        say "    " + C_CYAN + "sudo dnf install clang lld gcc glibc-devel" + C_RESET + "  (Fedora)"
        give back 1
    } else if os_tag == "macos" {
        if process::exec("command -v brew >/dev/null 2>/dev/null") == 0 {
            pilot brew_res = process::exec("brew install llvm")
            if brew_res == 0 { give back 0 }
        }
        process::exec("xcode-select --install >/dev/null 2>/dev/null")
        say "  " + C_DIM + "Complete the Xcode Command Line Tools prompt, then rerun 'freak doctor'." + C_RESET
        give back 1
    }
    give back 1
}

task cli_doctor(fix_mode: bool) -> int {
    -- Detect OS
    pilot os_tag = "unix"
    pilot is_win = false
    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        is_win = true
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Darwin") { os_tag = "macos" }
        else { os_tag = "linux" }
    }

    say ""
    say cli_box_top(50)
    if fix_mode {
        say cli_box_mid(" " + C_G1 + SYM_GEAR + " FREAK DOCTOR" + C_RESET + C_DIM + " --fix  repairing..." + C_RESET, 50)
    } else {
        say cli_box_mid(" " + C_G1 + SYM_GEAR + " FREAK DOCTOR" + C_RESET + C_DIM + "  diagnosing your setup..." + C_RESET, 50)
    }
    say cli_box_bot(50)
    say ""

    pilot all_ok = true
    pilot checks_passed = 0

    -- ── 1. clang ──────────────────────────────────────────
    say "  " + C_BWHITE + "[1/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " clang"
    pilot clang_cmd = cli_find_clang_command()
    pilot clang_ok = false
    if cli_clang_command_works(clang_cmd) {
        clang_ok = true
        pilot cv_line: word = cli_clang_version_line(clang_cmd)
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + C_DIM + cv_line + C_RESET
        if clang_cmd != "clang" {
            say "        " + C_DIM + "using: " + clang_cmd + C_RESET
        }
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " clang " + C_RED + "not found" + C_RESET
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Attempting auto-install..." + C_RESET
            pilot clang_fix = cli_install_clang(os_tag)
            if clang_fix == 0 {
                clang_cmd = cli_find_clang_command()
                if cli_clang_command_works(clang_cmd) {
                    clang_ok = true
                    pilot cv_line2: word = cli_clang_version_line(clang_cmd)
                    say "        " + C_BGREEN + SYM_CHECK + C_RESET + " clang installed: " + C_DIM + cv_line2 + C_RESET
                    if clang_cmd != "clang" {
                        say "        " + C_DIM + "using: " + clang_cmd + C_RESET
                    }
                    checks_passed += 1
                    all_ok = true
                } else {
                    say "        " + C_BYELLOW + SYM_RING + C_RESET + " LLVM installer finished, but this terminal still cannot run clang."
                    if is_win {
                        say "        " + C_DIM + "Close and reopen the terminal so PATH refreshes, then rerun freak doctor." + C_RESET
                    }
                    all_ok = false
                }
            }
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak doctor --fix" + C_RESET
            if is_win {
                say "         or: " + C_CYAN + "winget install --id MartinStorsjo.LLVM-MinGW.UCRT -e" + C_RESET
            } else if os_tag == "linux" {
                say "         or: " + C_CYAN + "sudo apt install clang lld" + C_RESET
            } else if os_tag == "macos" {
                say "         or: " + C_CYAN + "xcode-select --install" + C_RESET
            }
        }
    }
    say ""

    -- ── 2. lld (linker) ───────────────────────────────────
    say "  " + C_BWHITE + "[2/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " lld linker"
    pilot lld_found = false
    if is_win {
        -- "where" checks PATH without running the binary
        pilot lld_exit = process::exec("where lld-link >nul 2>nul")
        if lld_exit == 0 { lld_found = true }
    } else {
        pilot lld_exit = process::exec("ld.lld --version >/dev/null 2>/dev/null")
        if lld_exit == 0 { lld_found = true }
    }
    if lld_found {
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " lld found " + C_DIM + "(bundle mode available)" + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BYELLOW + SYM_RING + C_RESET + " lld not found " + C_DIM + "(optional — clang can link too)" + C_RESET
        checks_passed += 1
    }
    say ""

    -- Repair the distribution as one staged unit. Calling upgrade separately
    -- for runtime and std could install twice and still leave mixed files.
    pilot rt_dir: word = cli_find_runtime_dir()
    pilot std_dir: word = cli_find_std_dir()
    pilot runtime_missing = cli_doctor_runtime_missing(rt_dir)
    pilot std_missing = cli_doctor_std_missing(std_dir)
    if fix_mode and (runtime_missing != "" or std_missing != "") {
        say "  " + C_DIM + "Repairing the compiler/runtime/stdlib payload as one unit..." + C_RESET
        pilot repair_res = hangar_install_freak()
        if repair_res == 0 {
            rt_dir = cli_find_runtime_dir()
            std_dir = cli_find_std_dir()
            runtime_missing = cli_doctor_runtime_missing(rt_dir)
            std_missing = cli_doctor_std_missing(std_dir)
        } else {
            say "  " + C_BRED + SYM_CROSS + C_RESET + " Distribution repair failed."
        }
        say ""
    }

    -- ── 3. Runtime ────────────────────────────────────────
    say "  " + C_BWHITE + "[3/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " runtime"
    if runtime_missing == "" {
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + C_DIM + rt_dir + C_RESET
        pilot has_obj = false
        if is_win {
            has_obj = fs::exists(rt_dir + "/freak_runtime.obj")
        } else {
            has_obj = fs::exists(rt_dir + "/freak_runtime.o")
        }
        if has_obj {
            say "        " + C_BGREEN + SYM_CHECK + C_RESET + C_DIM + " pre-compiled objects (fast bundle mode)" + C_RESET
        } else {
            say "        " + C_BYELLOW + SYM_RING + C_RESET + C_DIM + " no pre-compiled objects (source fallback active)" + C_RESET
        }
        if fs::exists(rt_dir + "/freak_llvm_runtime.c") {
            say "        " + C_BGREEN + SYM_CHECK + C_RESET + C_DIM + " LLVM runtime available" + C_RESET
        }
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " runtime incomplete"
        say "        " + C_DIM + "Missing: " + runtime_missing + C_RESET
        all_ok = false
        if not fix_mode {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak upgrade" + C_RESET + " or re-run install script"
        }
    }
    say ""

    -- ── 4. Standard library ───────────────────────────────
    say "  " + C_BWHITE + "[4/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " standard library"
    if std_missing == "" {
        pilot mod_count = cli_doctor_std_module_count(std_dir)
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + word_from_int(mod_count) + "/11 modules in " + C_DIM + std_dir + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " standard library incomplete"
        say "        " + C_DIM + "Missing: " + std_missing + C_RESET
        all_ok = false
        if not fix_mode {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak upgrade" + C_RESET
        }
    }
    say ""

    -- ── 5. Compile pipeline test ──────────────────────────
    say "  " + C_BWHITE + "[5/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " compile pipeline"
    if clang_ok and runtime_missing == "" and std_missing == "" {
        pilot test_src = "say \"FREAK doctor test\""
        pilot probe_id = word_from_int(time::now_ms())
        pilot test_path = "_freak_doctor_probe_" + probe_id + ".fk"
        fs::write(test_path, test_src)
        pilot bin: word = cli_build(test_path, "llvm", "0", "")
        if bin != "" {
            pilot probe_exit = process::exec("\"" + bin + "\"")
            if probe_exit == 0 {
                say "        " + C_BGREEN + SYM_CHECK + C_RESET + " compile, link, and execution work"
                checks_passed += 1
            } else {
                say "        " + C_BRED + SYM_CROSS + C_RESET + " compiled probe failed at runtime"
                all_ok = false
            }
        } else {
            say "        " + C_BRED + SYM_CROSS + C_RESET + " compiler/linker error (see above)"
            all_ok = false
        }
        pilot test_stem = cli_strip_fk(test_path)
        if fs::exists(test_path) { fs::delete(test_path) }
        if fs::exists(test_path + ".ll") { fs::delete(test_path + ".ll") }
        if fs::exists(test_path + ".c") { fs::delete(test_path + ".c") }
        if fs::exists(bin) { fs::delete(bin) }
        if fs::exists(bin + ".freak-run-cache") { fs::delete(bin + ".freak-run-cache") }
        if fs::exists(test_stem + ".o") { fs::delete(test_stem + ".o") }
        if fs::exists(test_stem + ".obj") { fs::delete(test_stem + ".obj") }
        if fs::exists(test_stem + ".pdb") { fs::delete(test_stem + ".pdb") }
    } else {
        say "        " + C_BYELLOW + SYM_RING + C_RESET + C_DIM + " skipped (fix missing clang/runtime first)" + C_RESET
    }
    say ""

    -- ── Summary ───────────────────────────────────────────
    say cli_box_top(50)
    if all_ok {
        say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " ALL SYSTEMS GO" + C_RESET + "  " + C_DIM + word_from_int(checks_passed) + "/5 passed" + C_RESET, 50)
        say cli_box_sep(50)
        say cli_box_mid("  " + C_DIM + "Get started:" + C_RESET + "  freak build hello.fk", 50)
    } else {
        say cli_box_mid(" " + C_BRED + SYM_CROSS + " ISSUES FOUND" + C_RESET + "  " + C_DIM + word_from_int(checks_passed) + "/5 passed" + C_RESET, 50)
        say cli_box_sep(50)
        if fix_mode {
            say cli_box_mid("  Run " + C_BWHITE + "freak doctor" + C_RESET + " to verify fixes", 50)
        } else {
            say cli_box_mid("  Run " + C_BWHITE + "freak doctor --fix" + C_RESET + " to auto-repair", 50)
        }
    }
    say cli_box_bot(50)
    say ""
    if all_ok { give back 0 }
    give back 1
}
