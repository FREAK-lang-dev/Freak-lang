    pilot panel_x = win_w / 2 - 300
    pilot panel_y = win_h / 2 - 230
    draw_rect(win, panel_x, panel_y, 600, 460, color_surface)
    draw_stroke(win, panel_x, panel_y, 600, 460, color_border)
    draw_text_bold(win, "FLEET COMMAND", panel_x + 28, panel_y + 28, 28, color_gold)
    draw_text(win, "A treaty-era naval command game in FREAK.", panel_x + 28, panel_y + 66, 15, color_text)

    draw_text(win, "Nation", panel_x + 28, panel_y + 116, 12, color_muted)
    draw_button(win, "Britain", panel_x + 28, panel_y + 136, 88, 30, player_country == country_britain, color_gold)
    draw_button(win, "Germany", panel_x + 124, panel_y + 136, 96, 30, player_country == country_germany, color_gold)
    draw_button(win, "USA", panel_x + 228, panel_y + 136, 76, 30, player_country == country_usa, color_gold)
    draw_button(win, "Japan", panel_x + 312, panel_y + 136, 80, 30, player_country == country_japan, color_gold)
    draw_button(win, "France", panel_x + 400, panel_y + 136, 86, 30, player_country == country_france, color_gold)
    draw_button(win, "Russia", panel_x + 494, panel_y + 136, 78, 30, player_country == country_russia, color_gold)

    draw_text(win, "Rival: " + enemy_name(), panel_x + 28, panel_y + 188, 13, color_text)
    draw_text(win, country_doctrine(player_country), panel_x + 28, panel_y + 210, 12, color_muted)

    draw_button(win, "New Campaign", panel_x + 28, panel_y + 270, 170, 36, false, color_player)
    draw_button(win, "Ship Designer", panel_x + 208, panel_y + 270, 170, 36, false, color_accent)
    draw_button(win, "Exit", panel_x + 388, panel_y + 270, 170, 36, false, color_warning)

    draw_text(win, "Campaign features", panel_x + 28, panel_y + 334, 13, color_muted)
    draw_text(win, "- selectable nations and rivalries", panel_x + 28, panel_y + 356, 12, color_text)
    draw_text(win, "- world map campaign surface", panel_x + 28, panel_y + 376, 12, color_text)
    draw_text(win, "- ship design math feeding cost, time, and strength", panel_x + 28, panel_y + 396, 12, color_text)
    draw_text(win, "- click into the campaign or the design bureau", panel_x + 28, panel_y + 416, 12, color_text)
}

