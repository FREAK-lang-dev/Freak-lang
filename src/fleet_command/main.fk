    if country == country_britain { give back "North Sea" }
    if country == country_germany { give back "Baltic Sea" }
    if country == country_usa { give back "Central Pacific" }
    if country == country_japan { give back "Sea of Japan" }
    if country == country_france { give back "Western Mediterranean" }
    give back "Vladivostok Approaches"
}

task country_rival(country: int) -> int {
    if country == country_britain { give back country_germany }
    if country == country_germany { give back country_britain }
    if country == country_usa { give back country_japan }
    if country == country_japan { give back country_usa }
    if country == country_france { give back country_germany }
    give back country_japan
}

