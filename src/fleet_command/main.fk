}

task rivalry_start_tension(a: int, b: int) -> int {
    if (a == country_britain and b == country_germany) or (a == country_germany and b == country_britain) { give back 46 }
    if (a == country_usa and b == country_japan) or (a == country_japan and b == country_usa) { give back 43 }
    if (a == country_france and b == country_germany) or (a == country_germany and b == country_france) { give back 40 }
    if (a == country_russia and b == country_japan) or (a == country_japan and b == country_russia) { give back 44 }
    give back 36
}

task player_name() -> word {
    give back country_name(player_country)
}

task enemy_name() -> word {
    give back country_name(enemy_country)
}

task side_name(side: int) -> word {
    if side == 0 { give back player_name() }
    give back enemy_name()
}

task rivalry_zone_name(slot: int) -> word {
    pilot a = player_country
    pilot b = enemy_country
    if (a == country_britain and b == country_germany) or (a == country_germany and b == country_britain) {
        if slot == 0 { give back "North Sea" }
        if slot == 1 { give back "Baltic Sea" }
        if slot == 2 { give back "Atlantic Approaches" }
        give back "Norwegian Sea"
    }
    if (a == country_usa and b == country_japan) or (a == country_japan and b == country_usa) {
        if slot == 0 { give back "Central Pacific" }
        if slot == 1 { give back "Philippine Sea" }
        if slot == 2 { give back "Sea of Japan" }
        give back "West Pacific"
    }
    if (a == country_france and b == country_germany) or (a == country_germany and b == country_france) {
        if slot == 0 { give back "English Channel" }
        if slot == 1 { give back "North Sea" }
        if slot == 2 { give back "Atlantic Approaches" }
        give back "Western Mediterranean"
    }
    if (a == country_russia and b == country_japan) or (a == country_japan and b == country_russia) {
        if slot == 0 { give back "Sea of Japan" }
        if slot == 1 { give back "Yellow Sea" }
        if slot == 2 { give back "North Pacific" }
        give back "Vladivostok Approaches"
    }
    if slot == 0 { give back "North Sea" }
    if slot == 1 { give back "Atlantic Approaches" }
    if slot == 2 { give back "Central Pacific" }
    give back "West Pacific"
}

task zone_is_active(zone: word) -> bool {
    pilot slot = 0
    repeat until slot >= 4 {
        if rivalry_zone_name(slot) == zone { give back true }
        slot += 1
    }
    give back false
}

task select_country(country: int) -> void {
    player_country = country
    enemy_country = country_rival(country)
    seed_designs_for_country(country)
    reset_campaign()
}

task design_class_name(class_id: int) -> word {
    if class_id == 0 { give back "Destroyer" }
    if class_id == 1 { give back "Cruiser" }
    give back "Battleship"
}

task design_gun_factor(class_id: int) -> int {
    if class_id == 0 { give back 90 }
    if class_id == 1 { give back 260 }
    give back 620
}

task design_tonnage_for_class(class_id: int) -> int {
    if class_id == 0 { give back dd_tonnage }
    if class_id == 1 { give back ca_tonnage }
    give back bb_tonnage
}

task design_speed_for_class(class_id: int) -> int {
    if class_id == 0 { give back dd_speed }
    if class_id == 1 { give back ca_speed }
    give back bb_speed
}

task design_guns_for_class(class_id: int) -> int {
    if class_id == 0 { give back dd_guns }
    if class_id == 1 { give back ca_guns }
    give back bb_guns
}

task design_armor_for_class(class_id: int) -> int {
    if class_id == 0 { give back dd_armor }
    if class_id == 1 { give back ca_armor }
    give back bb_armor
}

task design_class_from_kind(kind: word) -> int {
    if kind == "Destroyer" { give back 0 }
    if kind == "Cruiser" { give back 1 }
    give back 2
}

task selected_design_name() -> word {
    give back design_class_name(designer_class)
}

task current_design_tonnage() -> int {
    give back design_tonnage_for_class(designer_class)
}

task current_design_speed() -> int {
    give back design_speed_for_class(designer_class)
}

task current_design_guns() -> int {
    give back design_guns_for_class(designer_class)
}

task current_design_armor() -> int {
    give back design_armor_for_class(designer_class)
}

task design_weight_capacity(class_id: int) -> int {
    give back design_tonnage_for_class(class_id) * 1000
}

task design_hull_weight(class_id: int) -> int {
    give back design_tonnage_for_class(class_id) * 420
}

task design_machinery_weight(class_id: int) -> int {
    give back design_speed_for_class(class_id) * design_tonnage_for_class(class_id) / 3
}

task design_gun_weight(class_id: int) -> int {
    give back design_guns_for_class(class_id) * design_gun_factor(class_id)
}

task design_armor_weight(class_id: int) -> int {
    give back design_armor_for_class(class_id) * design_tonnage_for_class(class_id) / 12
}

task design_weight_used(class_id: int) -> int {
    give back design_hull_weight(class_id) + design_machinery_weight(class_id) + design_gun_weight(class_id) + design_armor_weight(class_id)
}

task design_weight_margin(class_id: int) -> int {
    give back design_weight_capacity(class_id) - design_weight_used(class_id)
}

task design_cost_for_class(class_id: int) -> int {
    pilot tonnage = design_tonnage_for_class(class_id)
    pilot speed = design_speed_for_class(class_id)
    pilot guns = design_guns_for_class(class_id)
    pilot armor = design_armor_for_class(class_id)
    pilot cost = tonnage / 48 + speed * 5 + guns * 24 + armor * 18
    if class_id == 2 { cost += 160 }
    if class_id == 1 { cost += 80 }
    if design_weight_margin(class_id) < 0 {
        cost += (0 - design_weight_margin(class_id)) / 280
    }
    give back cost
}

task design_eta_for_class(class_id: int) -> int {
    pilot eta = 2 + design_tonnage_for_class(class_id) / 5000 + design_armor_for_class(class_id) / 4 + design_guns_for_class(class_id) / 4
    if class_id == 2 and eta < 8 { eta = 8 }
    if class_id == 1 and eta < 5 { eta = 5 }
    if class_id == 0 and eta < 3 { eta = 3 }
    give back eta
}

task design_power_for_class(class_id: int) -> int {
    pilot power = design_guns_for_class(class_id) * 2 + design_armor_for_class(class_id) + design_speed_for_class(class_id) / 5 + design_tonnage_for_class(class_id) / 3200
    if class_id == 2 { power += 4 }
    if design_weight_margin(class_id) < 0 {
        power -= 2 + (0 - design_weight_margin(class_id)) / 2500
    }
    if power < 1 { power = 1 }
    give back power
}

task design_maintenance_for_class(class_id: int) -> int {
    give back design_cost_for_class(class_id) / 11
}

task seed_designs_for_country(country: int) -> void {
    if country == country_britain {
        dd_tonnage = 980; dd_speed = 30; dd_guns = 4; dd_armor = 1
        ca_tonnage = 10400; ca_speed = 24; ca_guns = 8; ca_armor = 5
        bb_tonnage = 17500; bb_speed = 20; bb_guns = 4; bb_armor = 11
    } else if country == country_germany {
        dd_tonnage = 920; dd_speed = 29; dd_guns = 4; dd_armor = 2
        ca_tonnage = 9600; ca_speed = 23; ca_guns = 8; ca_armor = 6
        bb_tonnage = 16800; bb_speed = 19; bb_guns = 4; bb_armor = 12
    } else if country == country_usa {
        dd_tonnage = 900; dd_speed = 30; dd_guns = 4; dd_armor = 1
        ca_tonnage = 9800; ca_speed = 24; ca_guns = 8; ca_armor = 5
        bb_tonnage = 17000; bb_speed = 19; bb_guns = 4; bb_armor = 11
    } else if country == country_japan {
        dd_tonnage = 860; dd_speed = 31; dd_guns = 4; dd_armor = 1
        ca_tonnage = 9200; ca_speed = 24; ca_guns = 8; ca_armor = 5
        bb_tonnage = 15800; bb_speed = 20; bb_guns = 4; bb_armor = 10
    } else if country == country_france {
        dd_tonnage = 880; dd_speed = 29; dd_guns = 4; dd_armor = 1
        ca_tonnage = 9000; ca_speed = 23; ca_guns = 7; ca_armor = 5
        bb_tonnage = 15200; bb_speed = 18; bb_guns = 4; bb_armor = 10
    } else {
        dd_tonnage = 940; dd_speed = 28; dd_guns = 4; dd_armor = 1
        ca_tonnage = 8800; ca_speed = 22; ca_guns = 7; ca_armor = 4
        bb_tonnage = 14800; bb_speed = 18; bb_guns = 4; bb_armor = 10
    }
    designer_class = 2
    designer_status = design_class_name(2) + " board seeded for " + country_label(country) + "."
}

task adjust_current_design(field_name: word, delta: int) -> void {
    if designer_class == 0 {
        if field_name == "tonnage" { dd_tonnage = fleet_clamp_int(dd_tonnage + delta * 40, 700, 2200) }
        if field_name == "speed" { dd_speed = fleet_clamp_int(dd_speed + delta, 24, 38) }
        if field_name == "guns" { dd_guns = fleet_clamp_int(dd_guns + delta, 2, 8) }
        if field_name == "armor" { dd_armor = fleet_clamp_int(dd_armor + delta, 0, 4) }
    } else if designer_class == 1 {
        if field_name == "tonnage" { ca_tonnage = fleet_clamp_int(ca_tonnage + delta * 200, 6000, 18000) }
        if field_name == "speed" { ca_speed = fleet_clamp_int(ca_speed + delta, 18, 32) }
        if field_name == "guns" { ca_guns = fleet_clamp_int(ca_guns + delta, 4, 12) }
        if field_name == "armor" { ca_armor = fleet_clamp_int(ca_armor + delta, 2, 10) }
    } else {
        if field_name == "tonnage" { bb_tonnage = fleet_clamp_int(bb_tonnage + delta * 300, 12000, 32000) }
        if field_name == "speed" { bb_speed = fleet_clamp_int(bb_speed + delta, 16, 28) }
        if field_name == "guns" { bb_guns = fleet_clamp_int(bb_guns + delta, 4, 10) }
        if field_name == "armor" { bb_armor = fleet_clamp_int(bb_armor + delta, 6, 18) }
    }
    if design_weight_margin(designer_class) < 0 {
        designer_status = selected_design_name() + " design is overweight."
    } else {
        designer_status = selected_design_name() + " design updated."
    }
}

task ship_cost(kind: word) -> int {
    give back design_cost_for_class(design_class_from_kind(kind))
}

task ship_eta(kind: word) -> int {
    give back design_eta_for_class(design_class_from_kind(kind))
}

task ship_power(kind: word) -> int {
    give back design_power_for_class(design_class_from_kind(kind))
}

task ship_short(kind: word) -> word {
    if kind == "Destroyer" { give back "DD" }
    if kind == "Cruiser" { give back "CA" }
    give back "BB"
}

task player_total_power() -> int {
    give back player_dd * 2 + player_ca * 5 + player_bb * 10
}

task enemy_total_power() -> int {
    give back enemy_dd * 2 + enemy_ca * 5 + enemy_bb * 10
}

task fleet_line(dd: int, ca: int, bb: int) -> word {
    give back word_from_int(dd) + " DD  " + word_from_int(ca) + " CA  " + word_from_int(bb) + " BB"
}

task log_trim() -> void {
    pilot keep = 13
    pilot total = array_len(log_lines)
    if total <= keep { give back }
    pilot trimmed = array_new()
    pilot i = total - keep
    repeat until i >= total {
        array_push(trimmed, array_get(log_lines, i))
        i += 1
    }
    log_lines = trimmed
}

task log_add(line: word) -> void {
    array_push(log_lines, line)
    log_trim()
}

task reset_campaign() -> void {
    campaign_year = 1898
    campaign_month = 1
    treasury = country_start_treasury(player_country)
    enemy_treasury = country_start_treasury(enemy_country)
    prestige = country_start_prestige(player_country)
    enemy_prestige = country_start_prestige(enemy_country)
    tension = rivalry_start_tension(player_country, enemy_country)
    sea_control = 50 + country_detection_bias(player_country) - country_detection_bias(enemy_country)
    sea_control = fleet_clamp_int(sea_control, 35, 65)
    posture = 1
    game_over = false
    game_status = player_name() + " fleet ready."
    player_dd = country_start_dd(player_country)
    player_ca = country_start_ca(player_country)
    player_bb = country_start_bb(player_country)
    enemy_dd = country_start_dd(enemy_country)
    enemy_ca = country_start_ca(enemy_country)
    enemy_bb = country_start_bb(enemy_country)
    build_sides = array_new()
    build_kinds = array_new()
    build_etas = array_new()
    log_lines = array_new()
    contact_exists = false
    contact_zone = ""
    contact_strength = 0
    contact_quality = 0
    log_add("1898 opens with " + player_name() + " facing " + enemy_name() + ".")
    log_add("Home waters: " + country_home_zone(player_country) + ". Rival base: " + country_home_zone(enemy_country) + ".")
    log_add(country_doctrine(player_country))
}

task queue_build(side: int, kind: word) -> void {
    pilot cost = ship_cost(kind)
    if side == 0 {
        if treasury < cost {
            game_status = player_name() + " cannot fund another " + kind + "."
            log_add("Treasury rejects a new " + kind + " order.")
            give back
        }
        treasury -= cost
        log_add(side_name(side) + " lays down a " + kind + " for " + word_from_int(cost) + " funds.")
    } else {
        if enemy_treasury < cost { give back }
        enemy_treasury -= cost
    }
    array_push(build_sides, word_from_int(side))
    array_push(build_kinds, kind)
    array_push(build_etas, word_from_int(ship_eta(kind)))
}

task complete_build(side: int, kind: word) -> void {
    if side == 0 {
        if kind == "Destroyer" { player_dd += 1 }
        if kind == "Cruiser" { player_ca += 1 }
        if kind == "Battleship" { player_bb += 1 }
        log_add(player_name() + " commissions a new " + kind + ".")
    } else {
        if kind == "Destroyer" { enemy_dd += 1 }
        if kind == "Cruiser" { enemy_ca += 1 }
        if kind == "Battleship" { enemy_bb += 1 }
        if rand_step(100) < 45 {
            log_add(enemy_name() + " commissions another " + ship_short(kind) + ".")
        }
    }
}

task process_build_queue() -> void {
    pilot new_sides = array_new()
    pilot new_kinds = array_new()
    pilot new_etas = array_new()
    pilot total = array_len(build_sides)
    pilot i = 0
    repeat until i >= total {
        pilot side = word_to_int(array_get(build_sides, i))
        pilot kind: word = array_get(build_kinds, i)
        pilot eta = word_to_int(array_get(build_etas, i)) - 1
        if eta <= 0 {
            complete_build(side, kind)
        } else {
            array_push(new_sides, word_from_int(side))
            array_push(new_kinds, kind)
            array_push(new_etas, word_from_int(eta))
        }
        i += 1
    }
    build_sides = new_sides
    build_kinds = new_kinds
    build_etas = new_etas
}

task ai_take_turn() -> void {
    if enemy_treasury < 120 { give back }
    pilot choice = ""
    if enemy_country == country_japan and enemy_treasury >= ship_cost("Battleship") and tension >= 38 {
        choice = "Battleship"
    } else if enemy_bb < player_bb and enemy_treasury >= ship_cost("Battleship") and tension >= 40 {
        choice = "Battleship"
    } else if enemy_country == country_britain and enemy_treasury >= ship_cost("Destroyer") and enemy_dd <= player_dd + 1 {
        choice = "Destroyer"
    } else if enemy_dd < player_dd and enemy_treasury >= ship_cost("Destroyer") {
        choice = "Destroyer"
    } else if enemy_ca < player_ca and enemy_treasury >= ship_cost("Cruiser") {
        choice = "Cruiser"
    } else {
        pilot roll = rand_step(3)
        if roll == 0 and enemy_treasury >= ship_cost("Destroyer") {
            choice = "Destroyer"
        } else if roll == 1 and enemy_treasury >= ship_cost("Cruiser") {
            choice = "Cruiser"
        } else if enemy_treasury >= ship_cost("Battleship") and tension >= 55 {
            choice = "Battleship"
        } else if enemy_treasury >= ship_cost("Cruiser") {
            choice = "Cruiser"
        } else {
            choice = "Destroyer"
        }
    }
    queue_build(1, choice)
}

task start_contact() -> void {
    contact_exists = true
    contact_zone = rivalry_zone_name(rand_step(4))
    contact_quality = 38 + rand_step(35) + posture * 8 + country_detection_bias(player_country)
    contact_strength = enemy_total_power() / 2 + rand_step(enemy_total_power() / 2 + 7) + country_battle_bias(enemy_country)
    if contact_strength < 8 { contact_strength = 8 }
    game_status = enemy_name() + " contact reported in " + contact_zone + "."
    log_add(player_name() + " scouts report " + enemy_name() + " movement in " + contact_zone + ".")
}

task maybe_start_contact() -> void {
    if contact_exists { give back }
    pilot chance = 12 + tension / 3 + posture * 9 + sea_control / 12 + country_detection_bias(player_country) - country_detection_bias(enemy_country)
    chance = fleet_clamp_int(chance, 8, 88)
    if rand_step(100) < chance {
        start_contact()
    }
}

task player_loss_report(lost_dd: int, lost_ca: int, lost_bb: int) -> word {
    give back word_from_int(lost_dd) + " DD, " + word_from_int(lost_ca) + " CA, " + word_from_int(lost_bb) + " BB"
}

task apply_player_losses(points: int) -> word {
    pilot left = points
    pilot lost_dd = 0
    pilot lost_ca = 0
    pilot lost_bb = 0
    repeat until left <= 0 {
        if left >= 10 and player_bb > 0 {
            player_bb -= 1
            lost_bb += 1
            left -= 10
        } else if left >= 5 and player_ca > 0 {
            player_ca -= 1
            lost_ca += 1
            left -= 5
        } else if player_dd > 0 {
            player_dd -= 1
            lost_dd += 1
            left -= 2
        } else if player_ca > 0 {
            player_ca -= 1
            lost_ca += 1
            left = 0
        } else if player_bb > 0 {
            player_bb -= 1
            lost_bb += 1
            left = 0
        } else {
            left = 0
        }
    }
    give back player_loss_report(lost_dd, lost_ca, lost_bb)
}

task apply_enemy_losses(points: int) -> word {
    pilot left = points
    pilot lost_dd = 0
    pilot lost_ca = 0
    pilot lost_bb = 0
    repeat until left <= 0 {
        if left >= 10 and enemy_bb > 0 {
            enemy_bb -= 1
            lost_bb += 1
            left -= 10
        } else if left >= 5 and enemy_ca > 0 {
            enemy_ca -= 1
            lost_ca += 1
            left -= 5
        } else if enemy_dd > 0 {
            enemy_dd -= 1
            lost_dd += 1
            left -= 2
        } else if enemy_ca > 0 {
            enemy_ca -= 1
            lost_ca += 1
            left = 0
        } else if enemy_bb > 0 {
            enemy_bb -= 1
            lost_bb += 1
            left = 0
        } else {
            left = 0
        }
    }
    give back player_loss_report(lost_dd, lost_ca, lost_bb)
}

task evaluate_campaign() -> void {
    if prestige <= 0 {
        game_over = true
        game_status = player_name() + " removes you from command."
        log_add(player_name() + " turns against your command under political fire.")
    }
    if player_total_power() <= 0 and array_len(build_sides) == 0 {
        game_over = true
        game_status = player_name() + " loses the fleet."
        log_add("No " + player_name() + " hulls remain to contest the sea.")
    }
    if enemy_total_power() <= 0 and enemy_treasury < 120 and array_len(build_sides) == 0 {
        game_over = true
        game_status = enemy_name() + " sea power breaks."
        log_add(enemy_name() + " can no longer contest the theater.")
    }
}

task engage_contact() -> void {
    if game_over { give back }
    if contact_exists == false {
        game_status = "No contact to engage."
        log_add(player_name() + " squadrons sortie into empty water.")
        give back
    }
    pilot player_power = player_total_power() + prestige / 5 + posture * 4 + country_battle_bias(player_country) + rand_step(18)
    pilot enemy_power = contact_strength + enemy_prestige / 5 + country_battle_bias(enemy_country) + rand_step(18)
    pilot diff = player_power - enemy_power
    pilot enemy_loss_points = 0
    pilot player_loss_points = 0
    if diff >= 18 {
        enemy_loss_points = 14 + rand_step(8)
        player_loss_points = 3 + rand_step(4)
        prestige += 4
        sea_control += 8
        game_status = player_name() + " wins decisively at " + contact_zone + "."
        log_add("A decisive action breaks " + enemy_name() + " at " + contact_zone + ".")
    } else if diff >= 5 {
        enemy_loss_points = 8 + rand_step(6)
        player_loss_points = 4 + rand_step(5)
        prestige += 2
        sea_control += 4
        game_status = player_name() + " holds the field."
        log_add(enemy_name() + " withdraws after a sharp action.")
    } else if diff >= 0 {
        enemy_loss_points = 5 + rand_step(5)
        player_loss_points = 5 + rand_step(5)
        game_status = "Battle indecisive."
        log_add("Smoke, weather, and confusion end the fight without decision.")
    } else if diff >= 0 - 12 {
        enemy_loss_points = 3 + rand_step(4)
        player_loss_points = 7 + rand_step(6)
        prestige -= 2
        sea_control -= 4
        game_status = enemy_name() + " gains the measure of the battle."
        log_add(player_name() + " breaks contact under pressure.")
    } else {
        enemy_loss_points = 2 + rand_step(3)
        player_loss_points = 12 + rand_step(8)
        prestige -= 5
        sea_control -= 8
        game_status = player_name() + " suffers defeat at " + contact_zone + "."
        log_add("A brutal defeat shakes confidence across " + player_name() + ".")
    }
    sea_control = fleet_clamp_int(sea_control, 0, 100)
    prestige = fleet_clamp_int(prestige, 0, 100)
    enemy_prestige = fleet_clamp_int(enemy_prestige + rand_step(3) - 1, 0, 100)
    pilot enemy_report = apply_enemy_losses(enemy_loss_points)
    pilot player_report = apply_player_losses(player_loss_points)
    log_add(enemy_name() + " losses: " + enemy_report)
    log_add(player_name() + " losses: " + player_report)
    tension = fleet_clamp_int(tension + 6 + rand_step(8), 0, 100)
    contact_exists = false
    contact_zone = ""
    contact_strength = 0
    contact_quality = 0
    evaluate_campaign()
}

task fade_contact_on_advance() -> void {
    if contact_exists == false { give back }
    if rand_step(100) < 45 - posture * 8 {
        log_add(enemy_name() + " fades into rain squalls before the fleet can close.")
        game_status = enemy_name() + " slips away."
    } else {
        pilot raid = 35 + rand_step(45)
        treasury -= raid
        if treasury < 0 { treasury = 0 }
        prestige = fleet_clamp_int(prestige - 1, 0, 100)
        log_add(enemy_name() + " raiders hit commerce for " + word_from_int(raid) + " funds.")
        game_status = "Missed interception costs the treasury."
    }
    contact_exists = false
    contact_zone = ""
    contact_strength = 0
    contact_quality = 0
}

task advance_month() -> void {
    if game_over { give back }
    if contact_exists {
        fade_contact_on_advance()
    }
    campaign_month += 1
    if campaign_month > 12 {
        campaign_month = 1
        campaign_year += 1
        log_add("A new year opens in the naval race.")
    }
    treasury += country_income(player_country) + prestige / 3
    enemy_treasury += country_income(enemy_country) + enemy_prestige / 3
    tension = fleet_clamp_int(tension + rand_step(11) - 4, 0, 100)
    process_build_queue()
    ai_take_turn()
    maybe_start_contact()
    evaluate_campaign()
    if game_over == false and contact_exists == false {
        game_status = month_name(campaign_month) + " " + word_from_int(campaign_year) + ": no enemy in sight."
    }
}

task draw_button(win: int, text: word, x: int, y: int, w: int, h: int, active: bool, accent: int) -> void {
    pilot bg = color_panel
    pilot border = color_border
    pilot fg = color_text
    if active {
        bg = accent
        border = accent
        fg = 16777215
    } else if hit_rect(mouse_x, mouse_y, x, y, w, h) {
        bg = 1644825
        border = accent
    }
    draw_rect(win, x, y, w, h, bg)
    draw_stroke(win, x, y, w, h, border)
    draw_text(win, text, x + 10, y + 8, 13, fg)
}

task draw_zone_box(win: int, x: int, y: int, w: int, h: int, zone: word) -> void {
    pilot fill = color_panel
    pilot border = color_border
    pilot fg = color_text
    if zone_is_active(zone) {
        fill = 1455682
        border = color_route
    }
    if zone == country_home_zone(player_country) {
        fill = color_player
        border = color_player
    }
    if zone == country_home_zone(enemy_country) {
        fill = color_enemy
        border = color_enemy
    }
    if zone == contact_zone {
        fill = color_contact
        border = color_warning
        fg = color_bg
    }
    draw_rect(win, x, y, w, h, fill)
    draw_stroke(win, x, y, w, h, border)
    draw_text(win, zone, x + 8, y + 10, 12, fg)
    if zone == country_home_zone(player_country) {
        draw_text(win, country_label(player_country), x + 8, y + 28, 11, 16777215)
    } else if zone == country_home_zone(enemy_country) {
        draw_text(win, country_label(enemy_country), x + 8, y + 28, 11, 16777215)
    }
}

task draw_map_country(win: int, country: int, x: int, y: int) -> void {
    pilot marker = color_muted
    pilot label_color = color_muted
    pilot radius = 7
    if country == player_country {
        marker = color_player
        label_color = color_text
        radius = 11
    } else if country == enemy_country {
        marker = color_enemy
        label_color = color_text
        radius = 11
    }
    draw_circle(win, x, y, radius, marker)
    draw_text(win, country_label(country), x + 12, y - 4, 12, label_color)
}

task map_px(x: int, w: int, permille: int) -> int {
    give back x + w * permille / 1000
}

task map_py(y: int, h: int, permille: int) -> int {
    give back y + h * permille / 1000
}

task draw_land_blob(win: int, x: int, y: int, w: int, h: int) -> void {
    draw_rect(win, x, y, w, h, color_land)
    draw_circle(win, x + w / 5, y + h / 4, h / 5, color_land)
    draw_circle(win, x + w / 2, y + h / 3, h / 4, color_land)
    draw_circle(win, x + w * 4 / 5, y + h / 2, h / 5, color_land)
    draw_stroke(win, x, y, w, h, color_land_dark)
}

task draw_world_map_base(win: int, x: int, y: int, w: int, h: int) -> void {
    draw_rect(win, x, y, w, h, color_sea)
    draw_stroke(win, x, y, w, h, color_border)

    draw_line(win, x, map_py(y, h, 333), x + w, map_py(y, h, 333), color_route, 1)
    draw_line(win, x, map_py(y, h, 666), x + w, map_py(y, h, 666), color_route, 1)
    draw_line(win, map_px(x, w, 250), y, map_px(x, w, 250), y + h, color_route, 1)
    draw_line(win, map_px(x, w, 500), y, map_px(x, w, 500), y + h, color_route, 1)
    draw_line(win, map_px(x, w, 750), y, map_px(x, w, 750), y + h, color_route, 1)

    draw_land_blob(win, map_px(x, w, 35), map_py(y, h, 210), w * 130 / 1000, h * 200 / 1000)
    draw_land_blob(win, map_px(x, w, 135), map_py(y, h, 500), w * 70 / 1000, h * 170 / 1000)
    draw_land_blob(win, map_px(x, w, 390), map_py(y, h, 170), w * 80 / 1000, h * 85 / 1000)
    draw_land_blob(win, map_px(x, w, 420), map_py(y, h, 315), w * 95 / 1000, h * 240 / 1000)
    draw_land_blob(win, map_px(x, w, 500), map_py(y, h, 140), w * 270 / 1000, h * 255 / 1000)
    draw_land_blob(win, map_px(x, w, 710), map_py(y, h, 610), w * 110 / 1000, h * 90 / 1000)
}

task draw_zone_marker(win: int, map_x0: int, map_y0: int, map_w: int, map_h: int, zone: word, px_pos: int, py_pos: int) -> void {
    pilot dot_x = map_px(map_x0, map_w, px_pos)
    pilot dot_y = map_py(map_y0, map_h, py_pos)
    pilot dot_color = color_muted
    if zone_is_active(zone) { dot_color = color_accent }
    if zone == contact_zone { dot_color = color_contact }
    draw_circle(win, dot_x, dot_y, 5, dot_color)
    draw_text(win, zone, dot_x + 10, dot_y - 4, 11, color_text)
}

task draw_tab_button(win: int, text: word, x: int, y: int, w: int, active: bool) -> void {
    draw_button(win, text, x, y, w, 28, active, color_accent)
}

