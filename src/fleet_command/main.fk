task country_battle_bias(country: int) -> int {
    if country == country_britain { give back 2 }
    if country == country_germany { give back 2 }
    if country == country_usa { give back 1 }
    if country == country_japan { give back 4 }
    if country == country_france { give back 1 }
    give back 0 - 1
}

