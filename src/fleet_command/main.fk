    draw_rect(win, 0, 0, win_w, top_h, color_surface)
    draw_text_bold(win, "SHIP DESIGNER", 18, 15, 24, color_gold)
    draw_tab_button(win, "Menu", win_w - 290, 14, 80, false)
    draw_tab_button(win, "Campaign", win_w - 198, 14, 88, false)
    draw_tab_button(win, "Designer", win_w - 98, 14, 84, true)

    pilot left_x = 24
    pilot left_y = top_h + 20
    pilot left_h = win_h - top_h - 40
    draw_rect(win, left_x, left_y, 310, left_h, color_surface)
    draw_stroke(win, left_x, left_y, 310, left_h, color_border)
