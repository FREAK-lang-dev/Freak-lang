    draw_text(win, "Build time " + word_from_int(design_eta_for_class(designer_class)) + " months", left_x + 18, left_y + 254, 13, color_text)
    draw_text(win, "Combat rating " + word_from_int(design_power_for_class(designer_class)), left_x + 18, left_y + 276, 13, color_text)
    draw_text(win, "Maintenance " + word_from_int(design_maintenance_for_class(designer_class)), left_x + 18, left_y + 298, 13, color_text)
    draw_text(win, "Weight margin " + word_from_int(design_weight_margin(designer_class)), left_x + 18, left_y + 320, 13, color_text)

    pilot center_x = 356
