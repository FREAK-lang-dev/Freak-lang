    draw_line(win, center_x + 80, blueprint_y + 90, center_x + center_w - 90, blueprint_y + 90, color_route, 3)
    draw_rect(win, center_x + 126, blueprint_y + 70, center_w - 250, 40, color_land_dark)
    draw_rect(win, center_x + center_w - 180, blueprint_y + 76, 64, 28, color_land_dark)
    draw_circle(win, center_x + 110, blueprint_y + 90, 20, color_land_dark)
    draw_circle(win, center_x + center_w - 116, blueprint_y + 90, 15, color_land_dark)
    draw_text(win, "Displacement " + word_from_int(current_design_tonnage()) + " tons", center_x + 38, blueprint_y + 144, 13, color_text)
    draw_text(win, "Speed " + word_from_int(current_design_speed()) + " kn", center_x + 272, blueprint_y + 144, 13, color_text)
    draw_text(win, "Guns " + word_from_int(current_design_guns()), center_x + 440, blueprint_y + 144, 13, color_text)
    draw_text(win, "Armor " + word_from_int(current_design_armor()) + " in", center_x + 560, blueprint_y + 144, 13, color_text)

    pilot row_x = center_x + 34
    pilot row_y = blueprint_y + 238
    draw_text(win, "Displacement", row_x, row_y, 13, color_muted)
    draw_button(win, "-", row_x + 170, row_y - 8, 32, 28, false, color_warning)
    draw_button(win, "+", row_x + 208, row_y - 8, 32, 28, false, color_success)
    draw_text(win, word_from_int(current_design_tonnage()), row_x + 254, row_y, 13, color_text)

    row_y += 46
    draw_text(win, "Speed", row_x, row_y, 13, color_muted)
    draw_button(win, "-", row_x + 170, row_y - 8, 32, 28, false, color_warning)
    draw_button(win, "+", row_x + 208, row_y - 8, 32, 28, false, color_success)
    draw_text(win, word_from_int(current_design_speed()), row_x + 254, row_y, 13, color_text)

    row_y += 46
    draw_text(win, "Guns", row_x, row_y, 13, color_muted)
    draw_button(win, "-", row_x + 170, row_y - 8, 32, 28, false, color_warning)
    draw_button(win, "+", row_x + 208, row_y - 8, 32, 28, false, color_success)
    draw_text(win, word_from_int(current_design_guns()), row_x + 254, row_y, 13, color_text)

    row_y += 46
    draw_text(win, "Armor", row_x, row_y, 13, color_muted)
    draw_button(win, "-", row_x + 170, row_y - 8, 32, 28, false, color_warning)
    draw_button(win, "+", row_x + 208, row_y - 8, 32, 28, false, color_success)
    draw_text(win, word_from_int(current_design_armor()), row_x + 254, row_y, 13, color_text)

    draw_text(win, "Used weight " + word_from_int(design_weight_used(designer_class)), center_x + 400, blueprint_y + 240, 13, color_text)
    draw_text(win, "Capacity " + word_from_int(design_weight_capacity(designer_class)), center_x + 400, blueprint_y + 264, 13, color_text)
    draw_text(win, "Margin " + word_from_int(design_weight_margin(designer_class)), center_x + 400, blueprint_y + 288, 13, color_text)
    draw_text(win, "Changes apply to future " + selected_design_name() + " builds immediately.", center_x + 400, blueprint_y + 334, 12, color_muted)
}

task draw_top_bar(win: int) -> void {
    draw_rect(win, 0, 0, win_w, top_h, color_surface)
    draw_text_bold(win, "FLEET COMMAND", 18, 15, 24, color_gold)
    draw_tab_button(win, "Menu", 252, 14, 74, false)
    draw_tab_button(win, "Campaign", 336, 14, 92, true)
    draw_tab_button(win, "Designer", 438, 14, 88, false)
    draw_text(win, player_name() + " vs " + enemy_name(), 548, 18, 15, color_text)
    draw_text(win, month_name(campaign_month) + " " + word_from_int(campaign_year), 820, 18, 15, color_text)
    draw_text(win, "Treasury " + word_from_int(treasury), 1018, 18, 15, color_text)
    draw_button(win, "Reset", win_w - 108, 14, 84, 28, false, color_warning)
}

task draw_left_panel(win: int) -> void {
    pilot panel_h = win_h - top_h - bottom_h
    draw_rect(win, 0, top_h, left_w, panel_h, color_surface)
    draw_stroke(win, 0, top_h, left_w, panel_h, color_border)

    draw_text_bold(win, "ADMIRALTY", 18, top_h + 18, 16, color_gold)
    draw_text(win, "Status", 18, top_h + 46, 12, color_muted)
    draw_text(win, game_status, 18, top_h + 66, 13, color_text)

    draw_text(win, "Nation", 18, top_h + 104, 12, color_muted)
    draw_button(win, "Britain", 18, top_h + 124, 74, 28, player_country == country_britain, color_gold)
    draw_button(win, "Germany", 100, top_h + 124, 84, 28, player_country == country_germany, color_gold)
    draw_button(win, "USA", 192, top_h + 124, 70, 28, player_country == country_usa, color_gold)
    draw_button(win, "Japan", 18, top_h + 160, 74, 28, player_country == country_japan, color_gold)
    draw_button(win, "France", 100, top_h + 160, 84, 28, player_country == country_france, color_gold)
    draw_button(win, "Russia", 192, top_h + 160, 70, 28, player_country == country_russia, color_gold)

    draw_text(win, "Home waters: " + country_home_zone(player_country), 18, top_h + 208, 12, color_text)
    draw_text(win, "Rival: " + enemy_name(), 18, top_h + 228, 12, color_muted)

    draw_text(win, "Fleet posture", 18, top_h + 266, 12, color_muted)
    draw_button(win, "Reserve", 18, top_h + 286, 76, 30, posture == 0, color_player)
    draw_button(win, "Patrol", 102, top_h + 286, 72, 30, posture == 1, color_player)
    draw_button(win, "Aggressive", 182, top_h + 286, 90, 30, posture == 2, color_player)

    draw_text(win, country_label(player_country) + " fleet", 18, top_h + 342, 12, color_muted)
    draw_text(win, fleet_line(player_dd, player_ca, player_bb), 18, top_h + 362, 14, color_text)
    draw_text(win, "Power " + word_from_int(player_total_power()), 18, top_h + 384, 13, color_player)

    draw_text(win, country_label(enemy_country) + " estimate", 18, top_h + 418, 12, color_muted)
    draw_text(win, fleet_line(enemy_dd, enemy_ca, enemy_bb), 18, top_h + 438, 14, color_text)
    draw_text(win, "Power " + word_from_int(enemy_total_power()), 18, top_h + 460, 13, color_enemy)

    draw_text(win, "Construction orders", 18, top_h + 496, 12, color_muted)
    draw_button(win, "Build DD (120)", 18, top_h + 516, 118, 30, false, color_player)
    draw_button(win, "Build CA (260)", 144, top_h + 516, 118, 30, false, color_player)
    draw_button(win, "Build BB (520)", 18, top_h + 554, 118, 30, false, color_player)
    draw_button(win, "Advance Month", 144, top_h + 554, 118, 30, false, color_gold)
    draw_button(win, "Engage Contact", 18, top_h + 592, 244, 34, contact_exists, color_danger)

    draw_text(win, "Keyboard", 18, top_h + 642, 12, color_muted)
    draw_text(win, "Space  advance month", 18, top_h + 662, 12, color_text)
    draw_text(win, "Enter  engage contact", 18, top_h + 680, 12, color_text)
    draw_text(win, "Escape quit", 18, top_h + 698, 12, color_text)

    if game_over {
        draw_text_bold(win, "CAMPAIGN ENDED", 18, top_h + 730 - 72, 18, color_warning)
        draw_text(win, game_status, 18, top_h + 730 - 46, 13, color_text)
    }
}

task draw_theater(win: int) -> void {
    pilot x = left_w
    pilot y = top_h
    pilot w = win_w - left_w - right_w
    pilot h = win_h - top_h - bottom_h
    pilot map_x0 = x + 18
    pilot map_y0 = y + 86
    pilot map_w = w - 36
    pilot map_h = h - 172
    if map_h < 250 { map_h = 250 }

    draw_text_bold(win, "WORLD THEATER", x + 18, y + 18, 18, color_gold)
    draw_text(win, player_name() + " against " + enemy_name(), x + 18, y + 42, 13, color_text)
    draw_text(win, "Operational map", x + w - 126, y + 18, 12, color_muted)

    draw_world_map_base(win, map_x0, map_y0, map_w, map_h)

    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Norwegian Sea", 360, 180)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "North Sea", 392, 240)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Baltic Sea", 470, 238)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "English Channel", 330, 300)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Atlantic Approaches", 250, 430)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Western Mediterranean", 415, 500)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "North Pacific", 706, 210)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Vladivostok Approaches", 760, 280)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Sea of Japan", 845, 346)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Yellow Sea", 812, 418)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Central Pacific", 600, 410)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "Philippine Sea", 860, 520)
    draw_zone_marker(win, map_x0, map_y0, map_w, map_h, "West Pacific", 822, 648)

    draw_map_country(win, country_usa, map_px(map_x0, map_w, 132), map_py(map_y0, map_h, 382))
    draw_map_country(win, country_britain, map_px(map_x0, map_w, 370), map_py(map_y0, map_h, 255))
    draw_map_country(win, country_france, map_px(map_x0, map_w, 396), map_py(map_y0, map_h, 348))
    draw_map_country(win, country_germany, map_px(map_x0, map_w, 452), map_py(map_y0, map_h, 258))
    draw_map_country(win, country_russia, map_px(map_x0, map_w, 678), map_py(map_y0, map_h, 248))
    draw_map_country(win, country_japan, map_px(map_x0, map_w, 846), map_py(map_y0, map_h, 355))

    draw_text(win, "Sea control", x + 18, y + h - 74, 12, color_muted)
    draw_rect(win, x + 18, y + h - 54, 280, 14, color_panel)
    draw_rect(win, x + 18, y + h - 54, sea_control * 28 / 10, 14, color_accent)
    draw_stroke(win, x + 18, y + h - 54, 280, 14, color_border)

    if contact_exists {
        draw_text_bold(win, "CONTACT REPORTED", x + 332, y + h - 74, 15, color_warning)
        draw_text(win, contact_zone + " | enemy strength " + word_from_int(contact_strength) + " | quality " + word_from_int(contact_quality), x + 332, y + h - 50, 12, color_text)
    } else {
        draw_text_bold(win, "NO CONTACT", x + 332, y + h - 74, 15, color_muted)
        draw_text(win, "Advance the month or change posture to force the naval race.", x + 332, y + h - 50, 12, color_text)
    }
    draw_text(win, "Active theaters: " + rivalry_zone_name(0) + ", " + rivalry_zone_name(1), x + 18, y + h - 24, 12, color_text)
    draw_text(win, rivalry_zone_name(2) + ", " + rivalry_zone_name(3), x + 330, y + h - 24, 12, color_text)
}

task draw_queue_item(win: int, y: int, side: int, kind: word, eta: int) -> void {
    pilot side_text = country_label(player_country)
    pilot side_color = color_player
    if side == 1 {
        side_text = country_label(enemy_country)
        side_color = color_enemy
    }
    draw_text(win, side_text + " " + ship_short(kind) + "  eta " + word_from_int(eta), win_w - right_w + 18, y, 13, side_color)
}

task draw_log_line(win: int, y: int, text: word) -> void {
    draw_text(win, text, win_w - right_w + 18, y, 12, color_text)
}

task draw_right_panel(win: int) -> void {
    pilot x = win_w - right_w
    pilot y = top_h
    pilot h = win_h - top_h - bottom_h
    draw_rect(win, x, y, right_w, h, color_surface)
    draw_stroke(win, x, y, right_w, h, color_border)

    draw_text_bold(win, "COUNTRY FILE", x + 18, y + 18, 16, color_gold)
    draw_text(win, "Player: " + player_name(), x + 18, y + 48, 13, color_text)
    draw_text(win, "Rival: " + enemy_name(), x + 18, y + 70, 13, color_text)
    draw_text(win, "Home waters: " + country_home_zone(player_country), x + 18, y + 92, 12, color_text)
    draw_text(win, "Rival base: " + country_home_zone(enemy_country), x + 18, y + 112, 12, color_text)
    draw_text(win, country_doctrine(player_country), x + 18, y + 134, 11, color_muted)
    draw_text(win, "Income " + word_from_int(country_income(player_country)) + " | Rival " + word_from_int(country_income(enemy_country)), x + 18, y + 156, 12, color_text)

    draw_text_bold(win, "BUILD QUEUE", x + 18, y + 192, 16, color_gold)
    pilot row_y = y + 222
    pilot total = array_len(build_sides)
    if total == 0 {
        draw_text(win, "No hulls under construction.", x + 18, row_y, 13, color_muted)
        row_y += 24
    } else {
        pilot i = 0
        repeat until i >= total {
            draw_queue_item(win, row_y, word_to_int(array_get(build_sides, i)), array_get(build_kinds, i), word_to_int(array_get(build_etas, i)))
            row_y += 22
            i += 1
        }
    }

    draw_text_bold(win, "WAR DIARY", x + 18, y + 346, 16, color_gold)
    pilot log_y = y + 378
    pilot log_total = array_len(log_lines)
    pilot li = 0
    repeat until li >= log_total {
        draw_log_line(win, log_y, array_get(log_lines, li))
        log_y += 20
        li += 1
    }
}

task draw_bottom_bar(win: int) -> void {
    pilot y = win_h - bottom_h
    draw_rect(win, 0, y, win_w, bottom_h, color_surface)
    draw_stroke(win, 0, y, win_w, bottom_h, color_border)
    draw_text_bold(win, "MISSION BOARD", 18, y + 16, 15, color_gold)
    draw_text(win, "Goal: keep " + player_name() + " prestige above zero and break " + enemy_name() + " sea power.", 18, y + 42, 13, color_text)
    if contact_exists {
        draw_text(win, "Current contact: " + contact_zone + " | enemy strength " + word_from_int(contact_strength) + " | posture " + posture_name(), 18, y + 62, 13, color_warning)
    } else {
        draw_text(win, "Current contact: none | posture " + posture_name() + " | rival " + enemy_name(), 18, y + 62, 13, color_muted)
    }
}

task handle_menu_click(x: int, y: int) -> void {
    pilot panel_x = win_w / 2 - 300
    pilot panel_y = win_h / 2 - 230
    if hit_rect(x, y, panel_x + 28, panel_y + 136, 88, 30) { select_country(country_britain); give back }
    if hit_rect(x, y, panel_x + 124, panel_y + 136, 96, 30) { select_country(country_germany); give back }
    if hit_rect(x, y, panel_x + 228, panel_y + 136, 76, 30) { select_country(country_usa); give back }
    if hit_rect(x, y, panel_x + 312, panel_y + 136, 80, 30) { select_country(country_japan); give back }
    if hit_rect(x, y, panel_x + 400, panel_y + 136, 86, 30) { select_country(country_france); give back }
    if hit_rect(x, y, panel_x + 494, panel_y + 136, 78, 30) { select_country(country_russia); give back }
    if hit_rect(x, y, panel_x + 28, panel_y + 270, 170, 36) {
        reset_campaign()
        current_screen = screen_campaign
        give back
    }
    if hit_rect(x, y, panel_x + 208, panel_y + 270, 170, 36) {
        current_screen = screen_designer
        give back
    }
    if hit_rect(x, y, panel_x + 388, panel_y + 270, 170, 36) {
        quit_requested = true
        give back
    }
}

task handle_campaign_click(x: int, y: int) -> void {
    if hit_rect(x, y, 252, 14, 74, 28) {
        current_screen = screen_menu
        give back
    }
    if hit_rect(x, y, 438, 14, 88, 28) {
        current_screen = screen_designer
        give back
    }
    if hit_rect(x, y, win_w - 108, 14, 84, 28) {
        reset_campaign()
        give back
    }
    if hit_rect(x, y, 18, top_h + 124, 74, 28) { select_country(country_britain); give back }
    if hit_rect(x, y, 100, top_h + 124, 84, 28) { select_country(country_germany); give back }
    if hit_rect(x, y, 192, top_h + 124, 70, 28) { select_country(country_usa); give back }
    if hit_rect(x, y, 18, top_h + 160, 74, 28) { select_country(country_japan); give back }
    if hit_rect(x, y, 100, top_h + 160, 84, 28) { select_country(country_france); give back }
    if hit_rect(x, y, 192, top_h + 160, 70, 28) { select_country(country_russia); give back }

    if hit_rect(x, y, 18, top_h + 286, 76, 30) { posture = 0; game_status = player_name() + " fleet held in reserve."; give back }
    if hit_rect(x, y, 102, top_h + 286, 72, 30) { posture = 1; game_status = player_name() + " fleet sent on patrol."; give back }
    if hit_rect(x, y, 182, top_h + 286, 90, 30) { posture = 2; game_status = player_name() + " fleet ordered forward aggressively."; give back }

    if hit_rect(x, y, 18, top_h + 516, 118, 30) { queue_build(0, "Destroyer"); give back }
    if hit_rect(x, y, 144, top_h + 516, 118, 30) { queue_build(0, "Cruiser"); give back }
    if hit_rect(x, y, 18, top_h + 554, 118, 30) { queue_build(0, "Battleship"); give back }
    if hit_rect(x, y, 144, top_h + 554, 118, 30) { advance_month(); give back }
    if hit_rect(x, y, 18, top_h + 592, 244, 34) { engage_contact(); give back }
}

task handle_designer_click(x: int, y: int) -> void {
    if hit_rect(x, y, win_w - 290, 14, 80, 28) {
        current_screen = screen_menu
        give back
    }
    if hit_rect(x, y, win_w - 198, 14, 88, 28) {
        current_screen = screen_campaign
        give back
    }

    pilot left_x = 24
    pilot left_y = top_h + 20
    if hit_rect(x, y, left_x + 18, left_y + 136, 88, 30) { designer_class = 0; designer_status = "Destroyer board active."; give back }
    if hit_rect(x, y, left_x + 114, left_y + 136, 80, 30) { designer_class = 1; designer_status = "Cruiser board active."; give back }
    if hit_rect(x, y, left_x + 202, left_y + 136, 90, 30) { designer_class = 2; designer_status = "Battleship board active."; give back }

    pilot center_x = 356
    pilot blueprint_y = left_y + 70
    pilot row_x = center_x + 34
    pilot row_y = blueprint_y + 238

    if hit_rect(x, y, row_x + 170, row_y - 8, 32, 28) { adjust_current_design("tonnage", 0 - 1); give back }
    if hit_rect(x, y, row_x + 208, row_y - 8, 32, 28) { adjust_current_design("tonnage", 1); give back }

    row_y += 46
    if hit_rect(x, y, row_x + 170, row_y - 8, 32, 28) { adjust_current_design("speed", 0 - 1); give back }
    if hit_rect(x, y, row_x + 208, row_y - 8, 32, 28) { adjust_current_design("speed", 1); give back }

    row_y += 46
    if hit_rect(x, y, row_x + 170, row_y - 8, 32, 28) { adjust_current_design("guns", 0 - 1); give back }
    if hit_rect(x, y, row_x + 208, row_y - 8, 32, 28) { adjust_current_design("guns", 1); give back }

    row_y += 46
    if hit_rect(x, y, row_x + 170, row_y - 8, 32, 28) { adjust_current_design("armor", 0 - 1); give back }
    if hit_rect(x, y, row_x + 208, row_y - 8, 32, 28) { adjust_current_design("armor", 1); give back }
}

task handle_click(x: int, y: int) -> void {
    if current_screen == screen_menu {
        handle_menu_click(x, y)
        give back
    }
    if current_screen == screen_designer {
        handle_designer_click(x, y)
        give back
    }
    handle_campaign_click(x, y)
}

@protagonist
task main() {
    rng_state = 117
    seed_designs_for_country(player_country)
    reset_campaign()
    current_screen = screen_menu
    quit_requested = false

    pilot win = ui::create_window("Fleet Command - FREAK prototype", default_win_w, default_win_h, 1)
    refresh_layout(win)
    pilot running = 1

    repeat 999999 times {
        if running == 0 or quit_requested { give back }

        pilot count = ui::poll_events(win)
        if count < 0 { running = 0 }
        refresh_layout(win)

        pilot i = 0
        repeat count times {
            pilot kind = ui::event_kind(i)
            if kind == event_quit {
                running = 0
            } else if kind == event_resize {
                refresh_layout(win)
            } else if kind == event_key and ui::event_pressed(i) == 1 {
                pilot key = ui::event_key(i)
                if key == key_escape {
                    if current_screen == screen_menu {
                        running = 0
                    } else {
                        current_screen = screen_menu
                    }
                } else if key == key_space and current_screen == screen_campaign {
                    advance_month()
                } else if key == key_enter and current_screen == screen_campaign {
                    engage_contact()
                } else if key == key_enter and current_screen == screen_menu {
                    reset_campaign()
                    current_screen = screen_campaign
                }
            } else if kind == event_mouse {
                mouse_x = ui::event_mouse_x(i)
                mouse_y = ui::event_mouse_y(i)
                if ui::event_pressed(i) == 1 and ui::event_button(i) == mouse_left {
                    handle_click(mouse_x, mouse_y)
                }
            }
            i += 1
        }

        refresh_layout(win)
        ui::begin_frame(win)
        if current_screen == screen_menu {
            draw_main_menu(win)
        } else if current_screen == screen_designer {
            draw_designer_screen(win)
        } else {
            draw_rect(win, 0, 0, win_w, win_h, color_bg)
            draw_top_bar(win)
            draw_left_panel(win)
            draw_theater(win)
            draw_right_panel(win)
            draw_bottom_bar(win)
        }
        ui::end_frame(win)
    }

    ui::destroy_window(win)
}
