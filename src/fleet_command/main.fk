-- Fleet Command
-- A compact naval-command prototype built inside the FREAK repo to stress
-- the language, native window stack, and turn-based game logic.

pilot event_quit = 1
pilot event_key = 2
pilot event_mouse = 4

pilot key_enter = 37
pilot key_escape = 38
pilot key_space = 39

pilot mouse_left = 1

pilot color_bg = 197379
pilot color_surface = 855836
pilot color_panel = 1185040
pilot color_border = 3488325
pilot color_text = 15790320
pilot color_muted = 9473672
pilot color_accent = 4244448
pilot color_gold = 15123099
pilot color_enemy = 13779547
pilot color_player = 5025774
pilot color_warning = 14518374
pilot color_danger = 13845555
pilot color_success = 6536541
pilot color_sea = 1067066
pilot color_route = 2771304
pilot color_contact = 16030792

pilot win_w = 1380
pilot win_h = 860

pilot left_w = 292
pilot right_w = 396
pilot top_h = 56
pilot bottom_h = 92

pilot mouse_x = 0
pilot mouse_y = 0

pilot rng_state = 1

pilot country_britain = 0
pilot country_germany = 1
pilot country_usa = 2
pilot country_japan = 3
pilot country_france = 4
pilot country_russia = 5

pilot player_country = 0
pilot enemy_country = 1

pilot campaign_year = 1898
pilot campaign_month = 1
pilot treasury = 1100
pilot enemy_treasury = 1100
pilot prestige = 50
pilot enemy_prestige = 50
pilot tension = 34
pilot sea_control = 50
pilot posture = 1
pilot game_over = false
pilot game_status = "Fleet ready."

pilot player_dd = 4
pilot player_ca = 2
pilot player_bb = 1

pilot enemy_dd = 4
pilot enemy_ca = 2
pilot enemy_bb = 1

pilot build_sides = array_new()
pilot build_kinds = array_new()
pilot build_etas = array_new()

pilot log_lines = array_new()

pilot contact_exists = false
pilot contact_zone = ""
pilot contact_strength = 0
pilot contact_quality = 0

task color_r(color: int) -> int {
    give back color / 65536
}

task color_g(color: int) -> int {
    give back (color / 256) % 256
}

task color_b(color: int) -> int {
    give back color % 256
}

task fleet_clamp_int(value: int, lo: int, hi: int) -> int {
    if value < lo { give back lo }
    if value > hi { give back hi }
    give back value
}

task hit_rect(px: int, py: int, x: int, y: int, w: int, h: int) -> bool {
    give back px >= x and px < x + w and py >= y and py < y + h
}

task draw_rect(win: int, x: int, y: int, w: int, h: int, color: int) -> void {
    ui::fill_rect(win, x, y, w, h, color_r(color), color_g(color), color_b(color), 255)
}

task draw_stroke(win: int, x: int, y: int, w: int, h: int, color: int) -> void {
    ui::stroke_rect(win, x, y, w, h, color_r(color), color_g(color), color_b(color), 255, 1)
}

task draw_text(win: int, text: word, x: int, y: int, size: int, color: int) -> void {
    ui::draw_text(win, text, x, y, color_r(color), color_g(color), color_b(color), size, 0, 0)
}

task draw_text_bold(win: int, text: word, x: int, y: int, size: int, color: int) -> void {
    ui::draw_text(win, text, x, y, color_r(color), color_g(color), color_b(color), size, 1, 0)
}

task draw_circle(win: int, x: int, y: int, radius: int, color: int) -> void {
    ui::fill_circle(win, x, y, radius, color_r(color), color_g(color), color_b(color), 255)
}

task draw_line(win: int, x1: int, y1: int, x2: int, y2: int, color: int, thickness: int) -> void {
    ui::draw_line(win, x1, y1, x2, y2, color_r(color), color_g(color), color_b(color), 255, thickness)
}

task posture_name() -> word {
    if posture == 0 { give back "Reserve" }
    if posture == 1 { give back "Patrol" }
    give back "Aggressive"
}

task month_name(month: int) -> word {
    if month == 1 { give back "January" }
    if month == 2 { give back "February" }
    if month == 3 { give back "March" }
    if month == 4 { give back "April" }
    if month == 5 { give back "May" }
    if month == 6 { give back "June" }
    if month == 7 { give back "July" }
    if month == 8 { give back "August" }
    if month == 9 { give back "September" }
    if month == 10 { give back "October" }
    if month == 11 { give back "November" }
    give back "December"
}

task rand_step(max_exclusive: int) -> int {
    if max_exclusive <= 0 { give back 0 }
    rng_state = (rng_state * 48271 + 17) % 2147483647
    if rng_state < 0 { rng_state = 0 - rng_state }
    give back rng_state % max_exclusive
}

task country_name(country: int) -> word {
    if country == country_britain { give back "Great Britain" }
    if country == country_germany { give back "German Empire" }
    if country == country_usa { give back "United States" }
    if country == country_japan { give back "Empire of Japan" }
    if country == country_france { give back "France" }
    give back "Russian Empire"
}

task country_label(country: int) -> word {
    if country == country_britain { give back "Britain" }
    if country == country_germany { give back "Germany" }
    if country == country_usa { give back "USA" }
    if country == country_japan { give back "Japan" }
    if country == country_france { give back "France" }
    give back "Russia"
}

task country_doctrine(country: int) -> word {
    if country == country_britain { give back "Doctrine: Trade shield and distant blockade." }
    if country == country_germany { give back "Doctrine: Fleet in being and sudden concentration." }
    if country == country_usa { give back "Doctrine: Industrial reserve and measured escalation." }
    if country == country_japan { give back "Doctrine: Decisive battle in home waters." }
    if country == country_france { give back "Doctrine: Cruiser war and Mediterranean pressure." }
    give back "Doctrine: Scattered squadrons and hard weather."
}

task country_home_zone(country: int) -> word {
    if country == country_britain { give back "North Sea" }
    if country == country_germany { give back "Baltic Sea" }
    if country == country_usa { give back "Central Pacific" }
    if country == country_japan { give back "Sea of Japan" }
    if country == country_france { give back "Western Mediterranean" }
    give back "Vladivostok Approaches"
}

task country_rival(country: int) -> int {
    if country == country_britain { give back country_germany }
    if country == country_germany { give back country_britain }
    if country == country_usa { give back country_japan }
    if country == country_japan { give back country_usa }
    if country == country_france { give back country_germany }
    give back country_japan
}

task country_start_treasury(country: int) -> int {
    if country == country_britain { give back 1320 }
    if country == country_germany { give back 1180 }
    if country == country_usa { give back 1260 }
    if country == country_japan { give back 1140 }
    if country == country_france { give back 1090 }
    give back 1010
}

task country_income(country: int) -> int {
    if country == country_britain { give back 230 }
    if country == country_germany { give back 205 }
    if country == country_usa { give back 220 }
    if country == country_japan { give back 192 }
    if country == country_france { give back 184 }
    give back 176
}

task country_start_prestige(country: int) -> int {
    if country == country_britain { give back 58 }
    if country == country_germany { give back 54 }
    if country == country_usa { give back 55 }
    if country == country_japan { give back 56 }
    if country == country_france { give back 50 }
    give back 47
}

task country_start_dd(country: int) -> int {
    if country == country_britain { give back 7 }
    if country == country_germany { give back 5 }
    if country == country_usa { give back 5 }
    if country == country_japan { give back 5 }
    if country == country_france { give back 4 }
    give back 6
}

task country_start_ca(country: int) -> int {
    if country == country_britain { give back 4 }
    if country == country_germany { give back 3 }
    if country == country_usa { give back 3 }
    if country == country_japan { give back 4 }
    if country == country_france { give back 3 }
    give back 2
}

task country_start_bb(country: int) -> int {
    if country == country_britain { give back 3 }
    if country == country_germany { give back 2 }
    if country == country_usa { give back 2 }
    if country == country_japan { give back 2 }
    if country == country_france { give back 2 }
    give back 2
}

task country_battle_bias(country: int) -> int {
    if country == country_britain { give back 2 }
    if country == country_germany { give back 2 }
    if country == country_usa { give back 1 }
    if country == country_japan { give back 4 }
    if country == country_france { give back 1 }
    give back 0 - 1
}

task country_detection_bias(country: int) -> int {
    if country == country_britain { give back 3 }
    if country == country_germany { give back 1 }
    if country == country_usa { give back 2 }
    if country == country_japan { give back 2 }
    if country == country_france { give back 1 }
    give back 0
}

task rivalry_start_tension(a: int, b: int) -> int {
    if (a == country_britain and b == country_germany) or (a == country_germany and b == country_britain) { give back 46 }
    if (a == country_usa and b == country_japan) or (a == country_japan and b == country_usa) { give back 43 }
    if (a == country_france and b == country_germany) or (a == country_germany and b == country_france) { give back 40 }
    if (a == country_russia and b == country_japan) or (a == country_japan and b == country_russia) { give back 44 }
    give back 36
}

task player_name() -> word {
    give back country_name(player_country)
}

task enemy_name() -> word {
    give back country_name(enemy_country)
}

task side_name(side: int) -> word {
    if side == 0 { give back player_name() }
    give back enemy_name()
}

task rivalry_zone_name(slot: int) -> word {
    pilot a = player_country
    pilot b = enemy_country
    if (a == country_britain and b == country_germany) or (a == country_germany and b == country_britain) {
        if slot == 0 { give back "North Sea" }
        if slot == 1 { give back "Baltic Sea" }
        if slot == 2 { give back "Atlantic Approaches" }
        give back "Norwegian Sea"
    }
    if (a == country_usa and b == country_japan) or (a == country_japan and b == country_usa) {
        if slot == 0 { give back "Central Pacific" }
        if slot == 1 { give back "Philippine Sea" }
        if slot == 2 { give back "Sea of Japan" }
        give back "West Pacific"
    }
    if (a == country_france and b == country_germany) or (a == country_germany and b == country_france) {
        if slot == 0 { give back "English Channel" }
        if slot == 1 { give back "North Sea" }
        if slot == 2 { give back "Atlantic Approaches" }
        give back "Western Mediterranean"
    }
    if (a == country_russia and b == country_japan) or (a == country_japan and b == country_russia) {
        if slot == 0 { give back "Sea of Japan" }
        if slot == 1 { give back "Yellow Sea" }
        if slot == 2 { give back "North Pacific" }
        give back "Vladivostok Approaches"
    }
    if slot == 0 { give back "North Sea" }
    if slot == 1 { give back "Atlantic Approaches" }
    if slot == 2 { give back "Central Pacific" }
    give back "West Pacific"
}

task zone_is_active(zone: word) -> bool {
    pilot slot = 0
    repeat until slot >= 4 {
        if rivalry_zone_name(slot) == zone { give back true }
        slot += 1
    }
    give back false
}

task select_country(country: int) -> void {
    player_country = country
    enemy_country = country_rival(country)
    reset_campaign()
}

task ship_cost(kind: word) -> int {
    if kind == "Destroyer" { give back 120 }
    if kind == "Cruiser" { give back 260 }
    give back 520
}

task ship_eta(kind: word) -> int {
    if kind == "Destroyer" { give back 3 }
    if kind == "Cruiser" { give back 5 }
    give back 8
}

task ship_power(kind: word) -> int {
    if kind == "Destroyer" { give back 2 }
    if kind == "Cruiser" { give back 5 }
    give back 10
}

task ship_short(kind: word) -> word {
    if kind == "Destroyer" { give back "DD" }
    if kind == "Cruiser" { give back "CA" }
    give back "BB"
}

task player_total_power() -> int {
    give back player_dd * 2 + player_ca * 5 + player_bb * 10
}

task enemy_total_power() -> int {
    give back enemy_dd * 2 + enemy_ca * 5 + enemy_bb * 10
}

task fleet_line(dd: int, ca: int, bb: int) -> word {
    give back word_from_int(dd) + " DD  " + word_from_int(ca) + " CA  " + word_from_int(bb) + " BB"
}

task log_trim() -> void {
    pilot keep = 13
    pilot total = array_len(log_lines)
    if total <= keep { give back }
    pilot trimmed = array_new()
    pilot i = total - keep
    repeat until i >= total {
        array_push(trimmed, array_get(log_lines, i))
        i += 1
    }
    log_lines = trimmed
}

task log_add(line: word) -> void {
    array_push(log_lines, line)
    log_trim()
}

task reset_campaign() -> void {
    campaign_year = 1898
    campaign_month = 1
    treasury = country_start_treasury(player_country)
    enemy_treasury = country_start_treasury(enemy_country)
    prestige = country_start_prestige(player_country)
    enemy_prestige = country_start_prestige(enemy_country)
    tension = rivalry_start_tension(player_country, enemy_country)
    sea_control = 50 + country_detection_bias(player_country) - country_detection_bias(enemy_country)
    sea_control = fleet_clamp_int(sea_control, 35, 65)
    posture = 1
    game_over = false
    game_status = player_name() + " fleet ready."
    player_dd = country_start_dd(player_country)
    player_ca = country_start_ca(player_country)
    player_bb = country_start_bb(player_country)
    enemy_dd = country_start_dd(enemy_country)
    enemy_ca = country_start_ca(enemy_country)
    enemy_bb = country_start_bb(enemy_country)
    build_sides = array_new()
    build_kinds = array_new()
    build_etas = array_new()
    log_lines = array_new()
    contact_exists = false
    contact_zone = ""
    contact_strength = 0
    contact_quality = 0
    log_add("1898 opens with " + player_name() + " facing " + enemy_name() + ".")
    log_add("Home waters: " + country_home_zone(player_country) + ". Rival base: " + country_home_zone(enemy_country) + ".")
    log_add(country_doctrine(player_country))
}

task queue_build(side: int, kind: word) -> void {
    pilot cost = ship_cost(kind)
    if side == 0 {
        if treasury < cost {
            game_status = player_name() + " cannot fund another " + kind + "."
            log_add("Treasury rejects a new " + kind + " order.")
            give back
        }
        treasury -= cost
        log_add(side_name(side) + " lays down a " + kind + " for " + word_from_int(cost) + " funds.")
    } else {
        if enemy_treasury < cost { give back }
        enemy_treasury -= cost
    }
    array_push(build_sides, word_from_int(side))
    array_push(build_kinds, kind)
    array_push(build_etas, word_from_int(ship_eta(kind)))
}

task complete_build(side: int, kind: word) -> void {
    if side == 0 {
        if kind == "Destroyer" { player_dd += 1 }
        if kind == "Cruiser" { player_ca += 1 }
        if kind == "Battleship" { player_bb += 1 }
        log_add(player_name() + " commissions a new " + kind + ".")
    } else {
        if kind == "Destroyer" { enemy_dd += 1 }
        if kind == "Cruiser" { enemy_ca += 1 }
        if kind == "Battleship" { enemy_bb += 1 }
        if rand_step(100) < 45 {
            log_add(enemy_name() + " commissions another " + ship_short(kind) + ".")
        }
    }
}

task process_build_queue() -> void {
    pilot new_sides = array_new()
    pilot new_kinds = array_new()
    pilot new_etas = array_new()
    pilot total = array_len(build_sides)
    pilot i = 0
    repeat until i >= total {
        pilot side = word_to_int(array_get(build_sides, i))
        pilot kind: word = array_get(build_kinds, i)
        pilot eta = word_to_int(array_get(build_etas, i)) - 1
        if eta <= 0 {
            complete_build(side, kind)
        } else {
            array_push(new_sides, word_from_int(side))
            array_push(new_kinds, kind)
            array_push(new_etas, word_from_int(eta))
        }
        i += 1
    }
    build_sides = new_sides
    build_kinds = new_kinds
    build_etas = new_etas
}

task ai_take_turn() -> void {
    if enemy_treasury < 120 { give back }
    pilot choice = ""
    if enemy_country == country_japan and enemy_treasury >= ship_cost("Battleship") and tension >= 38 {
        choice = "Battleship"
    } else if enemy_bb < player_bb and enemy_treasury >= ship_cost("Battleship") and tension >= 40 {
        choice = "Battleship"
    } else if enemy_country == country_britain and enemy_treasury >= ship_cost("Destroyer") and enemy_dd <= player_dd + 1 {
        choice = "Destroyer"
    } else if enemy_dd < player_dd and enemy_treasury >= ship_cost("Destroyer") {
        choice = "Destroyer"
    } else if enemy_ca < player_ca and enemy_treasury >= ship_cost("Cruiser") {
        choice = "Cruiser"
    } else {
        pilot roll = rand_step(3)
        if roll == 0 and enemy_treasury >= ship_cost("Destroyer") {
            choice = "Destroyer"
        } else if roll == 1 and enemy_treasury >= ship_cost("Cruiser") {
            choice = "Cruiser"
        } else if enemy_treasury >= ship_cost("Battleship") and tension >= 55 {
            choice = "Battleship"
        } else if enemy_treasury >= ship_cost("Cruiser") {
            choice = "Cruiser"
        } else {
            choice = "Destroyer"
        }
    }
    queue_build(1, choice)
}

task start_contact() -> void {
    contact_exists = true
    contact_zone = rivalry_zone_name(rand_step(4))
    contact_quality = 38 + rand_step(35) + posture * 8 + country_detection_bias(player_country)
    contact_strength = enemy_total_power() / 2 + rand_step(enemy_total_power() / 2 + 7) + country_battle_bias(enemy_country)
    if contact_strength < 8 { contact_strength = 8 }
    game_status = enemy_name() + " contact reported in " + contact_zone + "."
    log_add(player_name() + " scouts report " + enemy_name() + " movement in " + contact_zone + ".")
}

task maybe_start_contact() -> void {
    if contact_exists { give back }
    pilot chance = 12 + tension / 3 + posture * 9 + sea_control / 12 + country_detection_bias(player_country) - country_detection_bias(enemy_country)
    chance = fleet_clamp_int(chance, 8, 88)
    if rand_step(100) < chance {
        start_contact()
    }
}

task player_loss_report(lost_dd: int, lost_ca: int, lost_bb: int) -> word {
    give back word_from_int(lost_dd) + " DD, " + word_from_int(lost_ca) + " CA, " + word_from_int(lost_bb) + " BB"
}

task apply_player_losses(points: int) -> word {
    pilot left = points
    pilot lost_dd = 0
    pilot lost_ca = 0
    pilot lost_bb = 0
    repeat until left <= 0 {
        if left >= 10 and player_bb > 0 {
            player_bb -= 1
            lost_bb += 1
            left -= 10
        } else if left >= 5 and player_ca > 0 {
            player_ca -= 1
            lost_ca += 1
            left -= 5
        } else if player_dd > 0 {
            player_dd -= 1
            lost_dd += 1
            left -= 2
        } else if player_ca > 0 {
            player_ca -= 1
            lost_ca += 1
            left = 0
        } else if player_bb > 0 {
            player_bb -= 1
            lost_bb += 1
            left = 0
        } else {
            left = 0
        }
    }
    give back player_loss_report(lost_dd, lost_ca, lost_bb)
}

task apply_enemy_losses(points: int) -> word {
    pilot left = points
    pilot lost_dd = 0
    pilot lost_ca = 0
    pilot lost_bb = 0
    repeat until left <= 0 {
        if left >= 10 and enemy_bb > 0 {
            enemy_bb -= 1
            lost_bb += 1
            left -= 10
        } else if left >= 5 and enemy_ca > 0 {
            enemy_ca -= 1
            lost_ca += 1
            left -= 5
        } else if enemy_dd > 0 {
            enemy_dd -= 1
            lost_dd += 1
            left -= 2
        } else if enemy_ca > 0 {
            enemy_ca -= 1
            lost_ca += 1
            left = 0
        } else if enemy_bb > 0 {
            enemy_bb -= 1
            lost_bb += 1
            left = 0
        } else {
            left = 0
        }
    }
    give back player_loss_report(lost_dd, lost_ca, lost_bb)
}

task evaluate_campaign() -> void {
    if prestige <= 0 {
        game_over = true
        game_status = player_name() + " removes you from command."
        log_add(player_name() + " turns against your command under political fire.")
    }
    if player_total_power() <= 0 and array_len(build_sides) == 0 {
        game_over = true
        game_status = player_name() + " loses the fleet."
        log_add("No " + player_name() + " hulls remain to contest the sea.")
    }
    if enemy_total_power() <= 0 and enemy_treasury < 120 and array_len(build_sides) == 0 {
        game_over = true
        game_status = enemy_name() + " sea power breaks."
        log_add(enemy_name() + " can no longer contest the theater.")
    }
}

task engage_contact() -> void {
    if game_over { give back }
    if contact_exists == false {
        game_status = "No contact to engage."
        log_add(player_name() + " squadrons sortie into empty water.")
        give back
    }
    pilot player_power = player_total_power() + prestige / 5 + posture * 4 + country_battle_bias(player_country) + rand_step(18)
    pilot enemy_power = contact_strength + enemy_prestige / 5 + country_battle_bias(enemy_country) + rand_step(18)
    pilot diff = player_power - enemy_power
    pilot enemy_loss_points = 0
    pilot player_loss_points = 0
    if diff >= 18 {
        enemy_loss_points = 14 + rand_step(8)
        player_loss_points = 3 + rand_step(4)
        prestige += 4
        sea_control += 8
        game_status = player_name() + " wins decisively at " + contact_zone + "."
        log_add("A decisive action breaks " + enemy_name() + " at " + contact_zone + ".")
    } else if diff >= 5 {
        enemy_loss_points = 8 + rand_step(6)
        player_loss_points = 4 + rand_step(5)
        prestige += 2
        sea_control += 4
        game_status = player_name() + " holds the field."
        log_add(enemy_name() + " withdraws after a sharp action.")
    } else if diff >= 0 {
        enemy_loss_points = 5 + rand_step(5)
        player_loss_points = 5 + rand_step(5)
        game_status = "Battle indecisive."
        log_add("Smoke, weather, and confusion end the fight without decision.")
    } else if diff >= 0 - 12 {
        enemy_loss_points = 3 + rand_step(4)
        player_loss_points = 7 + rand_step(6)
        prestige -= 2
        sea_control -= 4
        game_status = enemy_name() + " gains the measure of the battle."
        log_add(player_name() + " breaks contact under pressure.")
    } else {
        enemy_loss_points = 2 + rand_step(3)
        player_loss_points = 12 + rand_step(8)
        prestige -= 5
        sea_control -= 8
        game_status = player_name() + " suffers defeat at " + contact_zone + "."
        log_add("A brutal defeat shakes confidence across " + player_name() + ".")
    }
    sea_control = fleet_clamp_int(sea_control, 0, 100)
    prestige = fleet_clamp_int(prestige, 0, 100)
    enemy_prestige = fleet_clamp_int(enemy_prestige + rand_step(3) - 1, 0, 100)
    pilot enemy_report = apply_enemy_losses(enemy_loss_points)
    pilot player_report = apply_player_losses(player_loss_points)
    log_add(enemy_name() + " losses: " + enemy_report)
    log_add(player_name() + " losses: " + player_report)
    tension = fleet_clamp_int(tension + 6 + rand_step(8), 0, 100)
    contact_exists = false
    contact_zone = ""
    contact_strength = 0
    contact_quality = 0
    evaluate_campaign()
}

task fade_contact_on_advance() -> void {
    if contact_exists == false { give back }
    if rand_step(100) < 45 - posture * 8 {
        log_add(enemy_name() + " fades into rain squalls before the fleet can close.")
        game_status = enemy_name() + " slips away."
    } else {
        pilot raid = 35 + rand_step(45)
        treasury -= raid
        if treasury < 0 { treasury = 0 }
        prestige = fleet_clamp_int(prestige - 1, 0, 100)
        log_add(enemy_name() + " raiders hit commerce for " + word_from_int(raid) + " funds.")
        game_status = "Missed interception costs the treasury."
    }
    contact_exists = false
    contact_zone = ""
    contact_strength = 0
    contact_quality = 0
}

task advance_month() -> void {
    if game_over { give back }
    if contact_exists {
        fade_contact_on_advance()
    }
    campaign_month += 1
    if campaign_month > 12 {
        campaign_month = 1
        campaign_year += 1
        log_add("A new year opens in the naval race.")
    }
    treasury += country_income(player_country) + prestige / 3
    enemy_treasury += country_income(enemy_country) + enemy_prestige / 3
    tension = fleet_clamp_int(tension + rand_step(11) - 4, 0, 100)
    process_build_queue()
    ai_take_turn()
    maybe_start_contact()
    evaluate_campaign()
    if game_over == false and contact_exists == false {
        game_status = month_name(campaign_month) + " " + word_from_int(campaign_year) + ": no enemy in sight."
    }
}

task draw_button(win: int, text: word, x: int, y: int, w: int, h: int, active: bool, accent: int) -> void {
    pilot bg = color_panel
    pilot border = color_border
    pilot fg = color_text
    if active {
        bg = accent
        border = accent
        fg = 16777215
    } else if hit_rect(mouse_x, mouse_y, x, y, w, h) {
        bg = 1644825
        border = accent
    }
    draw_rect(win, x, y, w, h, bg)
    draw_stroke(win, x, y, w, h, border)
    draw_text(win, text, x + 10, y + 8, 13, fg)
}

task draw_zone_box(win: int, x: int, y: int, w: int, h: int, zone: word) -> void {
    pilot fill = color_panel
    pilot border = color_border
    pilot fg = color_text
    if zone_is_active(zone) {
        fill = 1455682
        border = color_route
    }
    if zone == country_home_zone(player_country) {
        fill = color_player
        border = color_player
    }
    if zone == country_home_zone(enemy_country) {
        fill = color_enemy
        border = color_enemy
    }
    if zone == contact_zone {
        fill = color_contact
        border = color_warning
        fg = color_bg
    }
    draw_rect(win, x, y, w, h, fill)
    draw_stroke(win, x, y, w, h, border)
    draw_text(win, zone, x + 8, y + 10, 12, fg)
    if zone == country_home_zone(player_country) {
        draw_text(win, country_label(player_country), x + 8, y + 28, 11, 16777215)
    } else if zone == country_home_zone(enemy_country) {
        draw_text(win, country_label(enemy_country), x + 8, y + 28, 11, 16777215)
    }
}

task draw_map_country(win: int, country: int, x: int, y: int) -> void {
    pilot marker = color_muted
    pilot label_color = color_muted
    pilot radius = 7
    if country == player_country {
        marker = color_player
        label_color = color_text
        radius = 11
    } else if country == enemy_country {
        marker = color_enemy
        label_color = color_text
        radius = 11
    }
    draw_circle(win, x, y, radius, marker)
    draw_text(win, country_label(country), x + 12, y - 4, 12, label_color)
}

task draw_top_bar(win: int) -> void {
    draw_rect(win, 0, 0, win_w, top_h, color_surface)
    draw_text_bold(win, "FLEET COMMAND", 18, 15, 24, color_gold)
    draw_text(win, player_name() + " vs " + enemy_name(), 242, 18, 16, color_text)
    draw_text(win, month_name(campaign_month) + " " + word_from_int(campaign_year), 648, 18, 16, color_text)
    draw_text(win, "Treasury " + word_from_int(treasury), 840, 18, 16, color_text)
    draw_text(win, "Prestige " + word_from_int(prestige), 1016, 18, 16, color_text)
    draw_text(win, "Tension " + word_from_int(tension), 1164, 18, 16, color_text)
    draw_button(win, "Reset Campaign", win_w - 170, 12, 150, 30, false, color_warning)
}

task draw_left_panel(win: int) -> void {
    pilot panel_h = win_h - top_h - bottom_h
    draw_rect(win, 0, top_h, left_w, panel_h, color_surface)
    draw_stroke(win, 0, top_h, left_w, panel_h, color_border)

    draw_text_bold(win, "ADMIRALTY", 18, top_h + 18, 16, color_gold)
    draw_text(win, "Status", 18, top_h + 46, 12, color_muted)
    draw_text(win, game_status, 18, top_h + 66, 13, color_text)

    draw_text(win, "Nation", 18, top_h + 104, 12, color_muted)
    draw_button(win, "Britain", 18, top_h + 124, 74, 28, player_country == country_britain, color_gold)
    draw_button(win, "Germany", 100, top_h + 124, 84, 28, player_country == country_germany, color_gold)
    draw_button(win, "USA", 192, top_h + 124, 70, 28, player_country == country_usa, color_gold)
    draw_button(win, "Japan", 18, top_h + 160, 74, 28, player_country == country_japan, color_gold)
    draw_button(win, "France", 100, top_h + 160, 84, 28, player_country == country_france, color_gold)
    draw_button(win, "Russia", 192, top_h + 160, 70, 28, player_country == country_russia, color_gold)

    draw_text(win, "Home waters: " + country_home_zone(player_country), 18, top_h + 208, 12, color_text)
    draw_text(win, "Rival: " + enemy_name(), 18, top_h + 228, 12, color_muted)

    draw_text(win, "Fleet posture", 18, top_h + 266, 12, color_muted)
    draw_button(win, "Reserve", 18, top_h + 286, 76, 30, posture == 0, color_player)
    draw_button(win, "Patrol", 102, top_h + 286, 72, 30, posture == 1, color_player)
    draw_button(win, "Aggressive", 182, top_h + 286, 90, 30, posture == 2, color_player)

    draw_text(win, country_label(player_country) + " fleet", 18, top_h + 342, 12, color_muted)
    draw_text(win, fleet_line(player_dd, player_ca, player_bb), 18, top_h + 362, 14, color_text)
    draw_text(win, "Power " + word_from_int(player_total_power()), 18, top_h + 384, 13, color_player)

    draw_text(win, country_label(enemy_country) + " estimate", 18, top_h + 418, 12, color_muted)
    draw_text(win, fleet_line(enemy_dd, enemy_ca, enemy_bb), 18, top_h + 438, 14, color_text)
    draw_text(win, "Power " + word_from_int(enemy_total_power()), 18, top_h + 460, 13, color_enemy)

    draw_text(win, "Construction orders", 18, top_h + 496, 12, color_muted)
    draw_button(win, "Build DD (120)", 18, top_h + 516, 118, 30, false, color_player)
    draw_button(win, "Build CA (260)", 144, top_h + 516, 118, 30, false, color_player)
    draw_button(win, "Build BB (520)", 18, top_h + 554, 118, 30, false, color_player)
    draw_button(win, "Advance Month", 144, top_h + 554, 118, 30, false, color_gold)
    draw_button(win, "Engage Contact", 18, top_h + 592, 244, 34, contact_exists, color_danger)

    draw_text(win, "Keyboard", 18, top_h + 642, 12, color_muted)
    draw_text(win, "Space  advance month", 18, top_h + 662, 12, color_text)
    draw_text(win, "Enter  engage contact", 18, top_h + 680, 12, color_text)
    draw_text(win, "Escape quit", 18, top_h + 698, 12, color_text)

    if game_over {
        draw_text_bold(win, "CAMPAIGN ENDED", 18, top_h + 730 - 72, 18, color_warning)
        draw_text(win, game_status, 18, top_h + 730 - 46, 13, color_text)
    }
}

task draw_theater(win: int) -> void {
    pilot x = left_w
    pilot y = top_h
    pilot w = win_w - left_w - right_w
    pilot h = win_h - top_h - bottom_h
    draw_rect(win, x, y, w, h, color_sea)
    draw_stroke(win, x, y, w, h, color_border)

    draw_text_bold(win, "WORLD THEATER", x + 18, y + 18, 18, color_gold)
    draw_text(win, player_name() + " against " + enemy_name(), x + 18, y + 42, 13, color_text)

    draw_rect(win, x + 18, y + 118, 120, 250, color_surface)
    draw_rect(win, x + 212, y + 88, 150, 260, color_surface)
    draw_rect(win, x + 454, y + 82, 182, 250, color_surface)
    draw_rect(win, x + 430, y + 360, 196, 114, color_surface)

    draw_zone_box(win, x + 170, y + 92, 142, 42, "Norwegian Sea")
    draw_zone_box(win, x + 218, y + 146, 122, 44, "North Sea")
    draw_zone_box(win, x + 350, y + 146, 110, 44, "Baltic Sea")
    draw_zone_box(win, x + 142, y + 204, 132, 38, "English Channel")
    draw_zone_box(win, x + 70, y + 252, 184, 70, "Atlantic Approaches")
    draw_zone_box(win, x + 232, y + 318, 192, 54, "Western Mediterranean")
    draw_zone_box(win, x + 450, y + 112, 160, 54, "North Pacific")
    draw_zone_box(win, x + 462, y + 170, 170, 40, "Vladivostok Approaches")
    draw_zone_box(win, x + 548, y + 212, 112, 46, "Sea of Japan")
    draw_zone_box(win, x + 500, y + 264, 120, 44, "Yellow Sea")
    draw_zone_box(win, x + 358, y + 238, 160, 78, "Central Pacific")
    draw_zone_box(win, x + 536, y + 318, 124, 72, "Philippine Sea")
    draw_zone_box(win, x + 480, y + 414, 172, 76, "West Pacific")

    draw_map_country(win, country_usa, x + 46, y + 274)
    draw_map_country(win, country_britain, x + 198, y + 176)
    draw_map_country(win, country_france, x + 238, y + 286)
    draw_map_country(win, country_germany, x + 328, y + 188)
    draw_map_country(win, country_russia, x + 472, y + 178)
    draw_map_country(win, country_japan, x + 602, y + 236)

    draw_text(win, "Sea control", x + 18, y + h - 92, 12, color_muted)
    draw_rect(win, x + 18, y + h - 72, 280, 14, color_panel)
    draw_rect(win, x + 18, y + h - 72, sea_control * 28 / 10, 14, color_accent)
    draw_stroke(win, x + 18, y + h - 72, 280, 14, color_border)

    if contact_exists {
        draw_text_bold(win, "CONTACT REPORTED", x + 332, y + h - 92, 15, color_warning)
        draw_text(win, contact_zone + " | enemy strength " + word_from_int(contact_strength) + " | quality " + word_from_int(contact_quality), x + 332, y + h - 68, 12, color_text)
    } else {
        draw_text_bold(win, "NO CONTACT", x + 332, y + h - 92, 15, color_muted)
        draw_text(win, "Advance the month or change posture to force the naval race.", x + 332, y + h - 68, 12, color_text)
    }
    draw_text(win, "Active theaters: " + rivalry_zone_name(0) + ", " + rivalry_zone_name(1), x + 18, y + h - 40, 12, color_text)
    draw_text(win, rivalry_zone_name(2) + ", " + rivalry_zone_name(3), x + 18, y + h - 20, 12, color_text)
}

task draw_queue_item(win: int, y: int, side: int, kind: word, eta: int) -> void {
    pilot side_text = country_label(player_country)
    pilot side_color = color_player
    if side == 1 {
        side_text = country_label(enemy_country)
        side_color = color_enemy
    }
    draw_text(win, side_text + " " + ship_short(kind) + "  eta " + word_from_int(eta), win_w - right_w + 18, y, 13, side_color)
}

task draw_log_line(win: int, y: int, text: word) -> void {
    draw_text(win, text, win_w - right_w + 18, y, 12, color_text)
}

task draw_right_panel(win: int) -> void {
    pilot x = win_w - right_w
    pilot y = top_h
    pilot h = win_h - top_h - bottom_h
    draw_rect(win, x, y, right_w, h, color_surface)
    draw_stroke(win, x, y, right_w, h, color_border)

    draw_text_bold(win, "COUNTRY FILE", x + 18, y + 18, 16, color_gold)
    draw_text(win, "Player: " + player_name(), x + 18, y + 48, 13, color_text)
    draw_text(win, "Rival: " + enemy_name(), x + 18, y + 70, 13, color_text)
    draw_text(win, "Home waters: " + country_home_zone(player_country), x + 18, y + 92, 12, color_text)
    draw_text(win, "Rival base: " + country_home_zone(enemy_country), x + 18, y + 112, 12, color_text)
    draw_text(win, country_doctrine(player_country), x + 18, y + 134, 11, color_muted)
    draw_text(win, "Income " + word_from_int(country_income(player_country)) + " | Rival " + word_from_int(country_income(enemy_country)), x + 18, y + 156, 12, color_text)

    draw_text_bold(win, "BUILD QUEUE", x + 18, y + 192, 16, color_gold)
    pilot row_y = y + 222
    pilot total = array_len(build_sides)
    if total == 0 {
        draw_text(win, "No hulls under construction.", x + 18, row_y, 13, color_muted)
        row_y += 24
    } else {
        pilot i = 0
        repeat until i >= total {
            draw_queue_item(win, row_y, word_to_int(array_get(build_sides, i)), array_get(build_kinds, i), word_to_int(array_get(build_etas, i)))
            row_y += 22
            i += 1
        }
    }

    draw_text_bold(win, "WAR DIARY", x + 18, y + 346, 16, color_gold)
    pilot log_y = y + 378
    pilot log_total = array_len(log_lines)
    pilot li = 0
    repeat until li >= log_total {
        draw_log_line(win, log_y, array_get(log_lines, li))
        log_y += 20
        li += 1
    }
}

task draw_bottom_bar(win: int) -> void {
    pilot y = win_h - bottom_h
    draw_rect(win, 0, y, win_w, bottom_h, color_surface)
    draw_stroke(win, 0, y, win_w, bottom_h, color_border)
    draw_text_bold(win, "MISSION BOARD", 18, y + 16, 15, color_gold)
    draw_text(win, "Goal: keep " + player_name() + " prestige above zero and break " + enemy_name() + " sea power.", 18, y + 42, 13, color_text)
    if contact_exists {
        draw_text(win, "Current contact: " + contact_zone + " | enemy strength " + word_from_int(contact_strength) + " | posture " + posture_name(), 18, y + 62, 13, color_warning)
    } else {
        draw_text(win, "Current contact: none | posture " + posture_name() + " | rival " + enemy_name(), 18, y + 62, 13, color_muted)
    }
}

task handle_click(x: int, y: int) -> void {
    if hit_rect(x, y, win_w - 170, 12, 150, 30) {
        reset_campaign()
        give back
    }
    if hit_rect(x, y, 18, top_h + 124, 74, 28) { select_country(country_britain); give back }
    if hit_rect(x, y, 100, top_h + 124, 84, 28) { select_country(country_germany); give back }
    if hit_rect(x, y, 192, top_h + 124, 70, 28) { select_country(country_usa); give back }
    if hit_rect(x, y, 18, top_h + 160, 74, 28) { select_country(country_japan); give back }
    if hit_rect(x, y, 100, top_h + 160, 84, 28) { select_country(country_france); give back }
    if hit_rect(x, y, 192, top_h + 160, 70, 28) { select_country(country_russia); give back }

    if hit_rect(x, y, 18, top_h + 286, 76, 30) { posture = 0; game_status = player_name() + " fleet held in reserve."; give back }
    if hit_rect(x, y, 102, top_h + 286, 72, 30) { posture = 1; game_status = player_name() + " fleet sent on patrol."; give back }
    if hit_rect(x, y, 182, top_h + 286, 90, 30) { posture = 2; game_status = player_name() + " fleet ordered forward aggressively."; give back }

    if hit_rect(x, y, 18, top_h + 516, 118, 30) { queue_build(0, "Destroyer"); give back }
    if hit_rect(x, y, 144, top_h + 516, 118, 30) { queue_build(0, "Cruiser"); give back }
    if hit_rect(x, y, 18, top_h + 554, 118, 30) { queue_build(0, "Battleship"); give back }
    if hit_rect(x, y, 144, top_h + 554, 118, 30) { advance_month(); give back }
    if hit_rect(x, y, 18, top_h + 592, 244, 34) { engage_contact(); give back }
}

@protagonist
task main() {
    rng_state = 117
    reset_campaign()

    pilot win = ui::create_window("Fleet Command - FREAK prototype", win_w, win_h, 1)
    pilot running = 1

    repeat 999999 times {
        if running == 0 { give back }

        pilot count = ui::poll_events(win)
        if count < 0 { running = 0 }

        pilot i = 0
        repeat count times {
            pilot kind = ui::event_kind(i)
            if kind == event_quit {
                running = 0
            } else if kind == event_key and ui::event_pressed(i) == 1 {
                pilot key = ui::event_key(i)
                if key == key_escape {
                    running = 0
                } else if key == key_space {
                    advance_month()
                } else if key == key_enter {
                    engage_contact()
                }
            } else if kind == event_mouse {
                mouse_x = ui::event_mouse_x(i)
                mouse_y = ui::event_mouse_y(i)
                if ui::event_pressed(i) == 1 and ui::event_button(i) == mouse_left {
                    handle_click(mouse_x, mouse_y)
                }
            }
            i += 1
        }

        ui::begin_frame(win)
        draw_rect(win, 0, 0, win_w, win_h, color_bg)
        draw_top_bar(win)
        draw_left_panel(win)
        draw_theater(win)
        draw_right_panel(win)
        draw_bottom_bar(win)
        ui::end_frame(win)
    }

    ui::destroy_window(win)
}
