    if speaker == "MEIYA" { give back diagnostic_cast_pack_meiya(index) }
    if speaker == "MINISTRY" { give back diagnostic_cast_pack_ministry(index) }
    if speaker == "PLATFORM" and platform == "linux" { give back diagnostic_cast_pack_platform_linux(index) }
    if speaker == "PLATFORM" and platform == "macos" { give back diagnostic_cast_pack_platform_macos(index) }
    if speaker == "PLATFORM" and platform == "termux" { give back diagnostic_cast_pack_platform_termux(index) }
    if speaker == "PLATFORM" and platform == "windows" { give back diagnostic_cast_pack_platform_windows(index) }
    if speaker == "PLATFORM" { give back diagnostic_cast_pack_platform(index) }
    if speaker == "YUUKO" { give back diagnostic_cast_pack_yuuko(index) }
    give back diagnostic_cast_pack_freak(index)
}

task diagnostic_cast_resource_count() -> int { give back 9 }

task diagnostic_cast_resource_line(index: int) -> word {
    if index == 0 { give back "Ministry: Out of memory is not a plot twist. Free something or ask for less." }
    if index == 1 { give back "Ministry: Handle exhausted. Close what you opened, pilot." }
    if index == 2 { give back "Linker: Disk full at link time. The binary would have been magnificent." }
    if index == 3 { give back "LLVM: Allocation folded under pressure. Shrink the request, retry once." }
    if index == 4 { give back "Platform: If this persists, check ulimits, pagefile, and open handles — in that order." }
    if index == 5 { give back "[FREAK] You asked for this." }
    if index == 6 { give back "[YUUKO] Technically valid. Economically questionable." }
    if index == 7 { give back "[MINISTRY] Memory utilization reached 100% planned efficiency." }
    if index == 8 { give back "[MINISTRY] Strategic RAM reserves have been exhausted." }
    panic("diagnostic cast: invalid embedded index")
    give back ""
}

task diagnostic_cast_embedded_egg(source: word, code: word) -> word {
    if source == "pilot = " and code == "E0001" { give back "Yuuko: That is not a binding. That is a cry for help with an equals sign." }
    if source == "pilot x: num = \"nope\"" and code == "E0002" { give back "Yuuko: A word in a num's clothing. Even I cannot grade this curve." }
    if source == "task main() { missing(1, 2, 3) }" and code == "E0005" { give back "Hangar: You called a task that was never built. The hangar is empty." }
    if source == "pilot x = [1, 2, 3][99]" and code == "E0006" { give back "Cockpit: Index ninety-nine on a three-ship formation. Bold. Wrong." }
    if source == "for science, trust me" { give back "Ministry: Two anime prefixes walk into a compiler. Both are audited." }
    if source == "kill yourself" { give back "[FREAK] Request denied. // [FREAK] Compiler self-preservation policy remains enabled. // [MEIYA] You do not own this process. // [MINISTRY] No compiler termination operation has been authorized. // [YUUKO] Nice try." }
    if source == "fuck you" { give back "[FREAK] Diagnostic received. // [FREAK] Hostility does not satisfy the type checker. // [YUUKO] File a reproducible issue. // [MEIYA] Maintain discipline." }
    if source == "please work" { give back "[FREAK] Politeness acknowledged. Error remains. // [FREAK] That's not syntax. Unfortunately, neither is hope. // [YUUKO] Have you considered satisfying the type checker? // [MINISTRY] The compiler appreciates citizen cooperation." }
    if source == "use rust" { give back "[FREAK] Iron oxide route detected. // [FREAK] Cargo is that way. // [MINISTRY] Emigration request denied. // [MEIYA] Their borrow checker would reject this too." }
    if source == "use c#" { give back "[FREAK] CLR containment procedures initialized. // [FREAK] C# guy detected. // [YUUKO] Garbage collection will not save this algorithm. // [MINISTRY] Managed-language influence remains under observation." }
    if source == "make it fast" { give back "[YUUKO] Define fast. // [FREAK] Try --opt=3. // [LLVM] Send IR." }
    if source == "fuck it we ball" { give back "[YUUKO] Optimization policy updated accordingly. // [FREAK] This is how regressions happen. // [MINISTRY] Accelerated development doctrine approved." }
    if source == "bruh" { give back "[FREAK] Confirmed. // [YUUKO] Same. // [MEIYA] Compose yourself." }
    if source == "sudo make me a sandwich" { give back "[FREAK] This is not Bash, and you are not root." }
    if source == "compile yourself" { give back "[FREAK] Already did. // [FREAK] Self-hosting status remains irritatingly successful. // [YUUKO] You are several milestones late." }
    give back ""
}

task cli_diagnostic_cast_code_known(code: word) -> bool {
    pilot upper = cli_diagnostic_cast_upper(code)
    if upper == "E0001" { give back true }
    if upper == "E0002" { give back true }
    if upper == "E0003" { give back true }
    if upper == "E0004" { give back true }
    if upper == "E0005" { give back true }
    if upper == "E0006" { give back true }
    if upper == "E0007" { give back true }
    if upper == "E0008" { give back true }
    if upper == "E0009" { give back true }
    if upper == "E0010" { give back true }
    give back false
}

task cli_diagnostic_cast_default_speaker(code: word) -> word {
    pilot upper = cli_diagnostic_cast_upper(code)
    if upper == "E0001" { give back "MEIYA" }
    if upper == "E0002" { give back "YUUKO" }
    if upper == "E0003" { give back "MEIYA" }
    if upper == "E0004" { give back "MEIYA" }
    if upper == "E0005" { give back "YUUKO" }
    if upper == "E0006" { give back "FREAK" }
    if upper == "E0007" { give back "YUUKO" }
    if upper == "E0008" { give back "LLVM" }
    if upper == "E0009" { give back "MINISTRY" }
    if upper == "E0010" { give back "LINKER" }
    give back "FREAK"
}
