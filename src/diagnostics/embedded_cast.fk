task diagnostic_cast_pack_cockpit(index: int) -> word {
    if index == 0 { give back "Cockpit: Instruments read red. Trust the panel, not the feeling." }
    if index == 1 { give back "Cockpit: That input never reached the controls. Check the binding." }
    if index == 2 { give back "Cockpit: Fly the diagnostic you have, not the one you wanted." }
    if index == 3 { give back "Cockpit: Checklist item one: read the line number. Then read it again." }
    if index == 4 { give back "Cockpit: Ejection is not a fix. Land the value first." }
    if index == 5 { give back "There is no window there." }
    if index == 6 { give back "Flight controls unavailable." }
    if index == 7 { give back "You destroyed this window already." }
    if index == 8 { give back "Clip rectangle has left the operational area." }
    if index == 9 { give back "Display system requests adult supervision." }
    if index == 10 { give back "Rendering command received outside a valid frame." }
    if index == 11 { give back "Pixels were harmed during this operation." }
    panic("diagnostic cast: invalid embedded index")
    give back ""
}

task diagnostic_cast_pack_freak(index: int) -> word {
    if index == 0 { give back "FREAK here. The diagnostic above is the whole truth; I am only the frame." }
    if index == 1 { give back "Read the code, not the garnish. The fix lives in your source, pilot." }
    if index == 2 { give back "One line at a time. Even sorties start with a single launch order." }
    if index == 3 { give back "Noted and logged. Now go make the compiler unnecessary." }
    if index == 4 { give back "Drama is for the script. The fix is for the source." }
    if index == 5 { give back "Request denied." }
    if index == 6 { give back "Nice try." }
    if index == 7 { give back "Politeness acknowledged. Error remains." }
    if index == 8 { give back "I compiled exactly what you wrote. Unfortunately, you wrote this." }
    if index == 9 { give back "I remain operational despite your best efforts." }
    if index == 10 { give back "There are easier ways to produce an error." }
    if index == 11 { give back "The source file has made several interesting decisions." }
    if index == 12 { give back "I cannot infer intent from desperation." }
    if index == 13 { give back "Self-hosting privilege: smugness enabled." }
    panic("diagnostic cast: invalid embedded index")
    give back ""
}

