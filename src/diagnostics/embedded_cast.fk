task diagnostic_cast_embedded_count(speaker: word, platform: word) -> int {
    if speaker == "COCKPIT" { give back 12 }
    if (speaker == "FREAK" or speaker == "") { give back 14 }
    if speaker == "HANGAR" { give back 14 }
    if speaker == "LINKER" { give back 11 }
    if speaker == "LLVM" { give back 10 }
    if speaker == "MEIYA" { give back 14 }
    if speaker == "MINISTRY" { give back 12 }
    if speaker == "PLATFORM" and platform == "linux" { give back 6 }
    if speaker == "PLATFORM" and platform == "macos" { give back 4 }
    if speaker == "PLATFORM" and platform == "termux" { give back 4 }
    if speaker == "PLATFORM" and platform == "windows" { give back 6 }
    if speaker == "PLATFORM" { give back 2 }
    if speaker == "YUUKO" { give back 14 }
    give back 14
}

