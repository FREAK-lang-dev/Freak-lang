{
  "version": "0.13.3",
  "description": "FREAK programming language compiler and package manager",
  "homepage": "https://github.com/FREAK-lang-dev/Freak-lang",
  "license": "MIT",
  "url": "https://github.com/FREAK-lang-dev/Freak-lang/releases/download/v0.13.3/freak-windows-x64.zip",
  "hash": "SCOOP_HASH_PLACEHOLDER",
  "extract_dir": "freak",
  "bin": [
    ["bin\\freak.exe", "freak"],
    ["bin\\hangar.exe", "hangar"]
  ],
  "env_add_path": "bin",
  "env_set": {
    "FREAK_HOME": "$dir"
  },
  "post_install": "Write-Output 'FREAK $version (\"Shiranui\") installed. Run: freak version'",
  "checkver": {
    "github": "https://github.com/FREAK-lang-dev/Freak-lang",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "url": "https://github.com/FREAK-lang-dev/Freak-lang/releases/download/v$version/freak-windows-x64.zip",
    "hash": {
      "url": "https://github.com/FREAK-lang-dev/Freak-lang/releases/download/v$version/SHA256SUMS",
      "regex": "([a-fA-F0-9]{64})\\s+\\.?/?freak-windows-x64/freak-windows-x64\\.zip"
    }
  }
}
