task main() {
    pilot mut count: int = 100000000
    if process::args_count() > 1 { count = word_to_int(process::arg(1)) }
    if count <= 0 or count > 100000000 { process::exit(2) }
    pilot builder = word_builder::with_capacity(count)
    if word_builder::capacity(builder) < count { process::exit(3) }
    repeat count times { word_builder::append(builder, "x") }
    if word_builder::length(builder) != count { process::exit(4) }
    pilot text = word_builder::finish(builder)
    say text.length()
    say text.checksum()
}
