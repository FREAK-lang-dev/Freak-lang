task main() {
    pilot mut count: int = 100000000
    if process::args_count() > 1 { count = word_to_int(process::arg(1)) }
    if count <= 0 or count > 100000000 { process::exit(2) }
    pilot buffer = ByteBuffer::new()
    pilot mut index = 0
    repeat until index >= count {
        buffer.write_byte(index % 256)
        index += 1
    }
    say buffer.length()
    buffer.seek(0)
    pilot mut checksum = 0
    repeat count times {
        checksum = (checksum * 131 + buffer.read_byte()) % 1000000007
    }
    say checksum
    say buffer.position()
    say buffer.status()
    buffer.release()
}
