task main() {
    pilot mut iterations: int = 1000000
    if process::args_count() > 1 {
        iterations = word_to_int(process::arg(1))
    }
    if iterations <= 0 or iterations > 1000000 { process::exit(2) }

    pilot mut flags: List<bool> = List::with_capacity(iterations)
    pilot mut i: int = 0
    repeat iterations times {
        if i % 2 == 0 {
            flags.push(true)
        } else {
            flags.push(false)
        }
        i += 1
    }
    pilot mut hits: int = 0
    for each f in flags {
        if f {
            hits += 1
        }
    }
    say flags.length()
    say hits
}
