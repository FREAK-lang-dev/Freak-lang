task main() {
    pilot mut iterations: int = 10000000
    if process::args_count() > 1 {
        iterations = word_to_int(process::arg(1))
    }
    if iterations <= 0 or iterations > 10000000 { process::exit(2) }

    pilot mut checksum: int = 0
    pilot mut index: int = 0
    repeat iterations times {
        checksum = (checksum + index) % 1000000007
        index += 1
    }
    say checksum
}
