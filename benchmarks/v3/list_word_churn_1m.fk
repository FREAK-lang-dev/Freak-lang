task main() {
    pilot mut iterations: int = 1000000
    if process::args_count() > 1 {
        iterations = word_to_int(process::arg(1))
    }
    if iterations <= 0 or iterations > 1000000 { process::exit(2) }

    pilot mut words: List<word> = List::with_capacity(iterations)
    pilot mut i: int = 0
    repeat iterations times {
        words.push(i.to_word())
        i += 1
    }
    pilot mut taken: int = 0
    repeat iterations times {
        pilot w = words.pop()
        taken = taken + w.length()
    }
    say words.length()
    say taken
}
