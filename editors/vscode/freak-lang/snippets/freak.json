{
  "FREAK task": {
    "prefix": "task",
    "body": [
      "task ${1:name}(${2}) -> ${3:void} {",
      "    $0",
      "}"
    ],
    "description": "Declare a task"
  },
  "FREAK pilot": {
    "prefix": "pilot",
    "body": "pilot ${1:name} = ${2:0}$0",
    "description": "Declare a variable"
  },
  "FREAK fixed pilot": {
    "prefix": "fixed",
    "body": "fixed pilot ${1:name} = ${2:0}$0",
    "description": "Declare an immutable binding"
  },
  "FREAK if": {
    "prefix": "if",
    "body": [
      "if ${1:true} {",
      "    $0",
      "}"
    ],
    "description": "Conditional block"
  },
  "FREAK repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} times {",
      "    $0",
      "}"
    ],
    "description": "Counted loop"
  },
  "FREAK for each": {
    "prefix": "foreach",
    "body": [
      "for each ${1:item} in ${2:items} {",
      "    $0",
      "}"
    ],
    "description": "Iterate over a collection"
  },
  "FREAK shape": {
    "prefix": "shape",
    "body": [
      "shape ${1:Point} {",
      "    ${2:x}: ${3:num}",
      "    $0",
      "}"
    ],
    "description": "Declare a shape"
  },
  "FREAK say": {
    "prefix": "say",
    "body": "say \"${1:Hello, world!}\"$0",
    "description": "Print a message"
  },
  "FREAK give back": {
    "prefix": "giveback",
    "body": "give back ${1:value}$0",
    "description": "Return a value from a task"
  }
}
