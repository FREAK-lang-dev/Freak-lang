{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FREAK",
  "scopeName": "source.freak",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#annotations" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#task-definition" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.freak",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.freak",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.freak",
              "match": "\\{[^}]*\\}",
              "captures": {
                "0": { "name": "variable.other.freak" }
              }
            },
            {
              "name": "constant.character.escape.freak",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.freak",
          "match": "\\b(if|else|when|repeat|until|times|training arc|for each|break|continue|give back|isekai|bringing back|eventually|deus_ex_machina)\\b"
        },
        {
          "name": "keyword.declaration.freak",
          "match": "\\b(pilot|fixed pilot|task|shape|doctrine|impl|extern|launch|use)\\b"
        },
        {
          "name": "keyword.operator.freak",
          "match": "\\b(and|or|not|in|is|as|trust-me|foreshadow|payoff)\\b"
        },
        {
          "name": "keyword.other.freak",
          "match": "\\b(say|ask|panic)\\b"
        },
        {
          "name": "support.function.builtin.freak",
          "match": "\\b(word_from_int|word_to_int|int_to_word|array_new|array_push|array_get|array_set|array_len|process::exit|process::arg|fs::read|fs::write|fs::append|fs::exists|fs::delete|math::sqrt|math::pow|math::floor|math::ceil|math::sin|math::cos|math::tan)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.freak",
          "match": "\\b(int|uint|num|float|float32|big|word|bool|char|void|tiny|mood|prob|power|maybe|result|List|Map|Set|Lineup|route)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.freak",
          "match": "\\b(true|false|yes|no|hai|iie|nobody|some)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.annotation.freak",
          "match": "@(protagonist|nakige|experiment|season_finale|deprecated|done)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.freak",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.freak",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.freak",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.freak",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.freak",
          "match": "(=|\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.pipe.freak",
          "match": "\\|>"
        }
      ]
    },
    "task-definition": {
      "patterns": [
        {
          "name": "entity.name.function.freak",
          "match": "(?<=task\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.freak",
          "match": "(?<=shape\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.freak",
          "match": "(?<=doctrine\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.call.freak",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()"
        },
        {
          "name": "variable.other.freak",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
