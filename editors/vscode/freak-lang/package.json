{
  "name": "freak-lang",
  "displayName": "FREAK Language",
  "description": "FREAK syntax highlighting, snippets, file icons, and bracket matching for .fk files",
  "version": "0.13.3",
  "publisher": "freak-lang-dev",
  "license": "MIT",
  "files": ["README.md", "LICENSE", "language-configuration.json", "syntaxes/**", "icons/**", "snippets/**"],
  "repository": {
    "type": "git",
    "url": "https://github.com/FREAK-lang-dev/Freak-lang"
  },
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "freak",
    "fk",
    "anime",
    "compiled",
    "systems"
  ],
  "contributes": {
    "languages": [
      {
        "id": "freak",
        "aliases": [
          "FREAK",
          "freak",
          "Freak"
        ],
        "extensions": [
          ".fk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/freak-file.svg",
          "dark": "./icons/freak-file.svg"
        }
      }
    ],
    "snippets": [
      { "language": "freak", "path": "./snippets/freak.json" }
    ],
    "grammars": [
      {
        "language": "freak",
        "scopeName": "source.freak",
        "path": "./syntaxes/freak.tmLanguage.json"
      }
    ]
  }
}
