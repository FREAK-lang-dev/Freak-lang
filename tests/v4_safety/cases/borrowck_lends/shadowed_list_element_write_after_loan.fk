-- Writing an element of the outer list while the inner shadowing list is
-- lent is fine: the two bindings never alias.
-- expect: run
-- exit: 12

task main() -> int {
    pilot mut xs: List<int> = [1]
    pilot mut n = 0
    if n == 0 {
        pilot ys: List<int> = [1, 2]
        pilot xs: List<int> = [3, 4]
        pilot v = lend xs
        n = v.length() + ys.length()
    }
    xs[0] = 8
    give back n + xs[0]
}
