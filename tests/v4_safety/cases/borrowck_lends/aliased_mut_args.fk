-- Two exclusive lends of one owner in a single call.
-- expect: reject borrowck
-- error: Meiya refuses overlapping mutable lends

shape P { x: int }

task both(lend mut a: P, lend mut b: P) -> int { give back 0 }
task main() -> int {
    pilot mut a = P { x: 4 }
    give back both(lend mut a, lend mut a)
}
