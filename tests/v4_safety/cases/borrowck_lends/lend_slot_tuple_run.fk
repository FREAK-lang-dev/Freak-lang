-- A loan stored in a tuple where the tuple is declared is a pointer to its
-- owner's storage: writes through the slot reach the owner.
-- bible: 4.1
-- expect: run
-- stdout: 10
-- stdout: 3

shape Ship { hp: int }
task main() -> int {
    pilot mut a = Ship { hp: 7 }
    pilot mut holder = (lend mut a, 3)
    holder.0.hp = holder.0.hp + holder.1
    say a.hp
    say holder.1
    give back 0
}
