-- A holder of an exclusive lend may pass on an exclusive loan of a field.
-- expect: run
-- exit: 99

shape P { x: int }

task poke(lend mut x: int) -> int {
    x = 99
    give back 0
}
task main() -> int {
    pilot mut p = P { x: 1 }
    pilot q = lend mut p
    pilot z = poke(lend mut q.x)
    give back p.x
}
