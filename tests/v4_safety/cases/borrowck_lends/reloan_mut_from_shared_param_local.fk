-- The same upgrade through a local holder, then a write through it.
-- known: #244 Meiya lets an immutable lend be reloaned as lend mut
-- expect: reject borrowck
-- error: lend mut

shape P { x: int }

task relay(lend p: P) -> int {
    pilot q = lend mut p
    q.x = 5
    give back 0
}
task main() -> int { give back 0 }
