-- The same upgrade through a local holder, then a write through it.
-- Fixed (#244): Meiya refuses an exclusive lend rooted at a shared lend parameter.
-- expect: reject borrowck
-- error: lend mut

shape P { x: int }

task relay(lend p: P) -> int {
    pilot q = lend mut p
    q.x = 5
    give back 0
}
task main() -> int { give back 0 }
