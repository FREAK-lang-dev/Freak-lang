-- An immutable binding cannot grant a mutable lend.
-- expect: reject borrowck
-- error: fixed pilot cannot be modified
-- error: an immutable binding cannot grant a mutable lend

shape P { x: int }

task poke(lend mut p: P) -> int { give back 0 }
task main() -> int {
    fixed pilot a = P { x: 4 }
    give back poke(lend mut a)
}
