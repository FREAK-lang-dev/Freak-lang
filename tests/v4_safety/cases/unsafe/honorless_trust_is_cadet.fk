-- Without "on my honor", a trust me block only grants .cadet.
-- expect: reject mir
-- error: current honor is .cadet

use std::ffi
extern [C] {
    task malloc(size: std::ffi::c_size) -> *mut tiny
    task free(value: *mut tiny) -> void
}

task main() -> int {
    pilot p = malloc(8)
    trust me "x" {
        p.write(1t)
    }
    give back 0
}
