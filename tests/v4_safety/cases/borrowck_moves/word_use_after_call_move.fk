-- Passing a word by value moves it; reading it afterwards is refused.
-- bible: 4.1
-- expect: reject borrowck
-- error: a was moved at statement 1, so statement 2 cannot use a yet
-- at: 12:5

task eat(w: word) -> int { give back 0 }

task main() -> int {
    pilot a = "hi"
    eat(a)
    say a
    give back 0
}
