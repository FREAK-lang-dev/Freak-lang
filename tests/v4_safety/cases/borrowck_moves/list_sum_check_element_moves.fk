-- `check xs[i]` moves the element into the check's subject, even for a
-- carrier of scalars (maybe<int> is not Copy).
-- expect: reject borrowck
-- error: Meiya carries that partial move across the CFG

task main() -> int {
    pilot xs: List<maybe<int>> = [some(1)]
    check xs[0] {
        got v -> say v
        nobody -> say "none"
    }
    give back xs.length()
}
