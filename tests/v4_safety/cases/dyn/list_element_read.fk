-- Moving an element out of a List<dyn D> would leave a hole; it is lent instead.
-- bible: 1.6
-- expect: reject codegen
-- error: native reads of dyn values out of list elements are not yet supported; lend the element: xs [ 0 ]

doctrine Unit {
    task power(lend self) -> int
    task train(lend mut self, by: int) -> void
    task spend(self) -> int
}
shape Pilot { name: word, power: int }
impl Unit for Pilot {
    task power(lend self) -> int { give back self.power }
    task train(lend mut self, by: int) -> void { self.power = self.power + by }
    task spend(self) -> int { give back self.power }
}
impl Unit for int {
    task power(lend self) -> int { give back self }
    task train(lend mut self, by: int) -> void { self = self + by }
    task spend(self) -> int { give back self }
}
task make(k: int) -> dyn Unit {
    if k > 0 { give back Pilot { name: "P" + word_from_int(k), power: k } }
    give back k
}
task consume(u: dyn Unit) -> int { give back u.spend() }
task main() -> int {
    pilot xs: List<dyn Unit> = [make(1)]
    pilot y = xs[0]
    give back y.power()
}
