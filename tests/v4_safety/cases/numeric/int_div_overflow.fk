-- int min / -1 does not fit.
-- Checked arithmetic traps instead of wrapping. args_count() is 1 here, so
-- the operands are runtime values the optimizer cannot fold away.
-- expect: panic
-- exit: nonzero
-- panic: int division overflow

task main() -> int {
    pilot a = -9223372036854775808
    pilot z = 0 - process::args_count()
    say a / z
    give back 0
}
