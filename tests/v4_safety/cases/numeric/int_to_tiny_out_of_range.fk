-- Implicit integer narrowing is checked.
-- Checked arithmetic traps instead of wrapping. args_count() is 1 here, so
-- the operands are runtime values the optimizer cannot fold away.
-- expect: panic
-- exit: nonzero
-- panic: int to tiny conversion out of range

task main() -> int {
    pilot a = 255 + process::args_count()
    pilot b: tiny = a
    pilot c: int = b
    give back c
}
