-- Integer division by zero.
-- Checked arithmetic traps instead of wrapping. args_count() is 1 here, so
-- the operands are runtime values the optimizer cannot fold away.
-- expect: panic
-- exit: nonzero
-- panic: int division by zero

task main() -> int {
    pilot z = process::args_count() - 1
    say 10 / z
    give back 0
}
