-- Test: SemVer constraint parsing and matching
-- Tests all constraint types from HG1a spec

pilot pass_count = 0
pilot fail_count = 0

-- Helper: returns "PASS" or "FAIL"
task assert_match(ver: word, con: word, expected: bool) -> word {
    pilot matched = version_matches_constraint(ver, con)
    if matched == expected {
        pass_count += 1
        give back "PASS"
    }
    fail_count += 1
    give back "FAIL"
}

-- === Caret (^) — compatible with major ===
say "--- Caret (^) constraints ---"
say "[" + assert_match("1.2.0", "^1.2.0", true) + "] ^1.2.0 matches 1.2.0"
say "[" + assert_match("1.3.0", "^1.2.0", true) + "] ^1.2.0 matches 1.3.0"
say "[" + assert_match("1.9.9", "^1.2.0", true) + "] ^1.2.0 matches 1.9.9"
say "[" + assert_match("2.0.0", "^1.2.0", false) + "] ^1.2.0 rejects 2.0.0"
say "[" + assert_match("0.9.0", "^1.2.0", false) + "] ^1.2.0 rejects 0.9.0"
say "[" + assert_match("1.1.9", "^1.2.0", false) + "] ^1.2.0 rejects 1.1.9"

-- === Tilde (~) — patch-compatible ===
say "--- Tilde (~) constraints ---"
say "[" + assert_match("2.4.0", "~2.4.0", true) + "] ~2.4.0 matches 2.4.0"
say "[" + assert_match("2.4.5", "~2.4.0", true) + "] ~2.4.0 matches 2.4.5"
say "[" + assert_match("2.5.0", "~2.4.0", false) + "] ~2.4.0 rejects 2.5.0"
say "[" + assert_match("3.0.0", "~2.4.0", false) + "] ~2.4.0 rejects 3.0.0"
say "[" + assert_match("2.3.9", "~2.4.0", false) + "] ~2.4.0 rejects 2.3.9"

-- === Exact (=) ===
say "--- Exact (=) constraints ---"
say "[" + assert_match("0.9.1", "=0.9.1", true) + "] =0.9.1 matches 0.9.1"
say "[" + assert_match("0.9.2", "=0.9.1", false) + "] =0.9.1 rejects 0.9.2"
say "[" + assert_match("0.9.0", "=0.9.1", false) + "] =0.9.1 rejects 0.9.0"

-- === Comparison operators ===
say "--- Comparison operators ---"
say "[" + assert_match("1.0.0", ">=1.0.0", true) + "] >=1.0.0 matches 1.0.0"
say "[" + assert_match("2.0.0", ">=1.0.0", true) + "] >=1.0.0 matches 2.0.0"
say "[" + assert_match("0.9.9", ">=1.0.0", false) + "] >=1.0.0 rejects 0.9.9"
say "[" + assert_match("1.0.1", ">1.0.0", true) + "] >1.0.0 matches 1.0.1"
say "[" + assert_match("1.0.0", ">1.0.0", false) + "] >1.0.0 rejects 1.0.0"
say "[" + assert_match("1.9.9", "<2.0.0", true) + "] <2.0.0 matches 1.9.9"
say "[" + assert_match("2.0.0", "<2.0.0", false) + "] <2.0.0 rejects 2.0.0"
say "[" + assert_match("2.0.0", "<=2.0.0", true) + "] <=2.0.0 matches 2.0.0"
say "[" + assert_match("2.0.1", "<=2.0.0", false) + "] <=2.0.0 rejects 2.0.1"

-- === Bare version (treated as ^) ===
say "--- Bare version (treated as ^) ---"
say "[" + assert_match("1.2.0", "1.2.0", true) + "] 1.2.0 matches 1.2.0"
say "[" + assert_match("1.5.0", "1.2.0", true) + "] 1.2.0 matches 1.5.0"
say "[" + assert_match("2.0.0", "1.2.0", false) + "] 1.2.0 rejects 2.0.0"
say "[" + assert_match("0.9.0", "1.2.0", false) + "] 1.2.0 rejects 0.9.0"

-- === Compound constraints ===
say "--- Compound constraints ---"
say "[" + assert_match("1.5.0", ">=1.0.0 <2.0.0", true) + "] >=1.0.0 <2.0.0 matches 1.5.0"
say "[" + assert_match("1.0.0", ">=1.0.0 <2.0.0", true) + "] >=1.0.0 <2.0.0 matches 1.0.0"
say "[" + assert_match("2.0.0", ">=1.0.0 <2.0.0", false) + "] >=1.0.0 <2.0.0 rejects 2.0.0"
say "[" + assert_match("0.9.0", ">=1.0.0 <2.0.0", false) + "] >=1.0.0 <2.0.0 rejects 0.9.0"
say "[" + assert_match("2.0.0", ">1.0.0 <=3.0.0", true) + "] >1.0.0 <=3.0.0 matches 2.0.0"
say "[" + assert_match("1.0.0", ">1.0.0 <=3.0.0", false) + "] >1.0.0 <=3.0.0 rejects 1.0.0"

-- === Wildcards ===
say "--- Wildcards ---"
say "[" + assert_match("99.99.99", "*", true) + "] * matches anything"
say "[" + assert_match("0.0.1", "latest", true) + "] latest matches anything"

-- === Summary ===
say ""
say "Results: " + word_from_int(pass_count) + " passed, " + word_from_int(fail_count) + " failed"
