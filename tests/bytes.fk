-- Test: current explicit-release/sticky-status std::bytes contract

task main() {
    pilot buf: ByteBuffer = ByteBuffer::with_capacity(4)
    buf.write_word("Hello")
    say buf.length()

    buf.seek(0)
    say buf.read_word(5)
    say buf.status()

    -- Bounds errors are sticky until explicitly cleared.
    buf.seek(99)
    say buf.status()
    buf.seek(1)
    say buf.position()
    buf.clear_status()
    buf.seek(1)

    -- Slices own independent copies and must be released separately.
    pilot middle: ByteBuffer = buf.slice(1, 3)
    buf.clear()
    say middle.to_word()
    middle.release()
    buf.release()

    say "bytes module OK"
}
