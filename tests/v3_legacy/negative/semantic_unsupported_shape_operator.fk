shape Vector3 { x: num, y: num, z: num }

impl Add for Vector3 {
    task add(self, other: Vector3) -> Vector3 {
        give back Vector3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
    }
}

task main() {
    pilot left = Vector3 { x: 1, y: 2, z: 3 }
    pilot right = Vector3 { x: 4, y: 5, z: 6 }
    pilot invalid = left + right
    say invalid.x
}
