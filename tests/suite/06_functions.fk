task add(a: int, b: int) -> int {
    give back a + b
}

task multiply(a: int, b: int) -> int {
    give back a * b
}

task greet(name: word) -> void {
    say "Hello, {name}!"
}

task is_even(n: int) -> bool {
    give back n % 2 == 0
}

greet("Takeru")
say word_from_int(add(3, 4))
say word_from_int(multiply(6, 7))
if is_even(8) {
    say "even"
}
if not is_even(9) {
    say "odd"
}
