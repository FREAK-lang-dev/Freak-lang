pilot parts = string_split("one,two,three", ",")
pilot joined = string_join(parts, "-")

task main() {
    say string_repeat("ha", 3)
    say string_reverse("FREAK")
    say word_from_int(string_count("banana", "an"))
    say string_pad_left("42", 6, "0")
    say string_pad_right("hi", 5, ".")
    say parts
    say joined
}
