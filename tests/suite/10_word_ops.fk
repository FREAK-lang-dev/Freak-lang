-- word (string) built-in operations
pilot s = "Hello, FREAK!"

-- concatenation
pilot a = "Muv-"
pilot b = "Luv"

task main() {
    say word_from_int(s.length())
    say s.char_at(0)
    say s.char_at(7)
    say a + b

    -- word_from_int / word_from_bool
    say word_from_int(2025)
    say word_from_bool(true)
    say word_from_bool(false)
}
