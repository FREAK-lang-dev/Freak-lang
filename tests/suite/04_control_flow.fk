-- if / else if / else
pilot x = 15

-- when / pattern match
pilot day = 3

-- bool conditions
pilot active = true

task main() {
    if x > 20 {
        say "huge"
    } else if x > 10 {
        say "big"
    } else {
        say "small"
    }
    when day {
        1 -> say "Monday"
        2 -> say "Tuesday"
        3 -> say "Wednesday"
        _ -> say "Other"
    }
    if active {
        say "active"
    }
    if not active {
        say "inactive"
    }
}
