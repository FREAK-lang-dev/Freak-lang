-- SKIP: maybe<T> compound literal codegen has known C backend issue (assignment without cast)
-- Test: maybe<T> with some and nobody

pilot val = some(42)
pilot safe_val = val or else 0
say "safe_val = {safe_val}"

check val {
    got x -> say "Got value: {x}"
    nobody -> say "No value!"
}

pilot empty = nobody
check empty {
    got x -> say "Got: {x}"
    nobody -> say "Nobody home!"
}
