    llvm_declared_funcs = "|puts|printf|strlen|freak_llvm_word_from_int|freak_llvm_word_from_bool|freak_llvm_word_concat|freak_llvm_word_eq|freak_llvm_word_neq|freak_llvm_word_length|freak_llvm_word_char_at|freak_llvm_word_contains|freak_llvm_word_starts_with|freak_llvm_word_ends_with|freak_llvm_word_to_upper|freak_llvm_word_to_lower|freak_llvm_word_trim|freak_llvm_word_replace|freak_llvm_word_to_int|freak_llvm_say|freak_llvm_print_str|freak_llvm_print_int|freak_llvm_print_newline|freak_llvm_ask|freak_llvm_process_args_count|freak_llvm_process_arg|freak_llvm_process_exit|freak_llvm_process_exec|freak_llvm_process_exec_capture|freak_llvm_panic|freak_llvm_shape_alloc|freak_llvm_shape_get|freak_llvm_shape_set|freak_llvm_setup_args|freak_llvm_word_from_num|freak_llvm_print_num|freak_llvm_int_to_num|freak_llvm_num_to_int|freak_llvm_ui_create_window|freak_llvm_ui_destroy_window|freak_llvm_ui_poll_events|freak_llvm_ui_begin_frame|freak_llvm_ui_end_frame|freak_llvm_ui_event_kind|freak_llvm_ui_event_key|freak_llvm_ui_event_pressed|freak_llvm_ui_event_character|freak_llvm_ui_event_mouse_x|freak_llvm_ui_event_mouse_y|freak_llvm_ui_event_button|freak_llvm_ui_clear|freak_llvm_ui_fill_rect|freak_llvm_ui_stroke_rect|freak_llvm_ui_fill_circle|freak_llvm_ui_draw_line|freak_llvm_ui_draw_text|freak_llvm_ui_measure_text|freak_llvm_math_sqrt|freak_llvm_math_pow|freak_llvm_math_sin|freak_llvm_math_cos|freak_llvm_math_tan|freak_llvm_math_floor|freak_llvm_math_ceil|freak_llvm_parse_num|freak_llvm_format_num|freak_llvm_array_new|freak_llvm_array_push|freak_llvm_array_get|freak_llvm_array_len|freak_llvm_array_set|freak_word_compare|freak_llvm_tcp_connect|freak_llvm_tcp_send|freak_llvm_tcp_recv|freak_llvm_tcp_recv_all|freak_llvm_tcp_close|freak_llvm_time_now_ms|"
}

-- ===================== PROGRAM ASSEMBLY ==============================
-- v3 KEY CHANGE: proper freak_init_globals + freak_main split

task emit_llvm_program() -> void {
    temp_reg_counter = 0
    string_literals = ""
    string_literals_count = 0

    -- Write empty file (streaming appends from here)
    fs::write(out_file, "")

    llvm_emit_line("; FREAK LLVM IR Generator (v3)")
    llvm_emit_line("")
    llvm_emit_runtime_decls()
    llvm_emit_line("")

    pilot top_count = array_len(ast_top_stmts)

    -- Pre-scan: register task return types + externs
    pilot prescan_i = 0
    repeat top_count times {
        pilot pid: word = array_get(ast_top_stmts, prescan_i)
        pilot pk: word = array_get(ast_stmt_kinds, word_to_int(pid))
        if pk == STMT_TASK {
            pilot pn: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot pr: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(pn, pr)
        }
        if pk == STMT_EXTERN {
            pilot en: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot er: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(en, er)
            emt_register_extern(en, er)
        }
        prescan_i += 1
    }

    -- Emit global variable declarations
    llvm_global_names = ""
    pilot glob_i = 0
    repeat top_count times {
        pilot gid: word = array_get(ast_top_stmts, glob_i)
        pilot gk: word = array_get(ast_stmt_kinds, word_to_int(gid))
        if gk == STMT_PILOT {
            pilot gn: word = array_get(ast_stmt_names, word_to_int(gid))
            llvm_global_names = llvm_global_names + "|" + gn + "|"
            llvm_emit_line("@g_" + gn + " = global i64 0")
        }
        glob_i += 1
    }
    llvm_emit_line("")

    -- Emit extern declarations
    pilot ext_i = 0
    repeat top_count times {
        pilot eid: word = array_get(ast_top_stmts, ext_i)
        pilot ek: word = array_get(ast_stmt_kinds, word_to_int(eid))
        if ek == STMT_EXTERN {
            pilot enm: word = array_get(ast_stmt_names, word_to_int(eid))
            pilot ert: word = array_get(ast_task_returns, word_to_int(eid))
            pilot epm: word = array_get(ast_task_params, word_to_int(eid))
            pilot llvm_ret = "i64"
            if ert == "void" { llvm_ret = "void" }
            pilot llvm_params = ""
            if epm != "" {
                pilot plen = epm.length()
                pilot pi = 0
                pilot pcount = 1
                repeat plen times {
                    if epm.char_at(pi) == "," { pcount += 1 }
                    pi += 1
                }
                pilot pj = 0
                repeat pcount times {
                    if pj > 0 { llvm_params = llvm_params + ", " }
                    llvm_params = llvm_params + "i64"
                    pj += 1
                }
            }
            if not llvm_is_runtime_func(enm) {
                llvm_emit_line("declare " + llvm_ret + " @" + enm + "(" + llvm_params + ")")
            }
        }
        ext_i += 1
    }
    llvm_emit_line("")

    -- Emit user tasks
    pilot i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { llvm_emit_task(cur_id) }
        i += 1
    }

    -- Detect user-defined main
    pilot has_main_task = false
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" { has_main_task = true }
        }
        i += 1
    }

    -- v3 KEY FIX: emit freak_init_globals for programs with task main()
    if has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_cur_func_is_void = true
        llvm_emit_line("define void @freak_init_globals() {")
        llvm_emit_line("entry:")
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind == STMT_PILOT { llvm_emit_stmt(cur_id) }
            i += 1
        }
        llvm_emit_line("    ret void")
        llvm_emit_line("}")
        llvm_emit_line("")
    }

    -- Emit @freak_main wrapper (only if no user main)
    if not has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_cur_func_is_void = true
        llvm_emit_line("define void @freak_main() {")
        llvm_emit_line("entry:")
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind != STMT_TASK and kind != STMT_EXTERN { llvm_emit_stmt(cur_id) }
            i += 1
        }
        llvm_emit_line("    ret void")
        llvm_emit_line("}")
    }

    -- Emit C main entry
    llvm_emit_line("")
    llvm_emit_line("define i32 @main(i32 %argc, i8** %argv) {")
    llvm_emit_line("entry:")
    llvm_emit_line("    %argc_ext = sext i32 %argc to i64")
    llvm_emit_line("    %argv_ptr = ptrtoint i8** %argv to i64")
    llvm_emit_line("    call void @freak_llvm_setup_args(i64 %argc_ext, i64 %argv_ptr)")
    if has_main_task {
        llvm_emit_line("    call void @freak_init_globals()")
        llvm_emit_line("    call void @freak_main()")
    }
    if not has_main_task {
        llvm_emit_line("    call void @freak_main()")
    }
    llvm_emit_line("    ret i32 0")
    llvm_emit_line("}")

    -- Append string literals at end
    llvm_emit_line("")
    llvm_emit_line("; String Literals")
    llvm_emit_line(string_literals)
}
-- ===================================================================
-- FREAK v3 COMPILER — MAIN ENTRY POINT
-- ===================================================================
-- CLI arg parsing, file reading, backend dispatch.

task freakc_v3_main() -> void {
    pilot args_cnt = process::args_count()

    -- Handle --version and --help
    if args_cnt >= 2 {
        pilot first_arg: word = process::arg(1)
        if first_arg == "--version" or first_arg == "-V" {
            say "freakc " + FREAKC_VERSION + " (" + FREAKC_CODENAME + ")"
            give back
        }
        if first_arg == "--help" or first_arg == "-h" {
            say "FREAK Compiler " + FREAKC_VERSION + " (" + FREAKC_CODENAME + ")"
            say ""
            say "Usage: freakc <file.fk> [options]"
            say ""
            say "Options:"
            say "  --llvm             Use LLVM IR backend (default)"
            say "  --c                Use C backend"
            say "  --opt=N            Optimization level 0-3 (default: 2)"
            say "  --target=TRIPLE    Cross-compile target triple"
            say "  --version, -V      Show version"
            say "  --help, -h         Show this help"
            give back
        }
    }

    if args_cnt < 2 {
        say "Usage: freakc <file.fk> [--c] [--llvm] [--opt=N] [--target=TRIPLE]"
        say "       freakc --version | --help"
        give back
    }

    input_file = process::arg(1)

    -- Parse flags
    pilot fi = 2
    repeat until fi >= args_cnt {
        pilot flag = process::arg(fi)
        if flag == "--c" { emit_target = "c" }
        if flag == "--llvm" { emit_target = "llvm" }
        if flag.starts_with("--opt=") { opt_level = flag.char_at(6) }
        if flag.starts_with("--target=") {
            pilot ti = 9
            pilot tval = ""
            repeat until ti >= flag.length() {
                tval = tval + flag.char_at(ti)
                ti += 1
            }
            cross_target = tval
        }
        fi += 1
    }

    say "FREAK v3 Compiling: " + input_file + " (Target: " + emit_target + ")"

    pilot src = fs::read(input_file)
    if src == "" {
        say "Error: Could not read file."
        give back
    }

    init_arrays()

    say "[1/4] Lexing..."
    tokenize(src)

    say "[2/4] Parsing..."
    parse_program()

    say "[3/4] Type Checking..."
    check_program()

    say "[4/4] Emitting..."
    if emit_target == "llvm" {
        out_file = input_file + ".ll"
        emit_llvm_program()
        say "Generated LLVM IR at " + out_file
    } else {
        out_file = input_file + ".c"
        -- Clear the output file before streaming
        fs::write(out_file, "")
        emit_c_program()
        say "Generated C code at " + out_file
    }

    say "Done."
}

freakc_v3_main()
