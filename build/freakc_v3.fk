-- ===================================================================
-- FREAK v3 COMPILER — GLOBALS
-- ===================================================================
-- All global state in one file. Keeps other files pure logic.

-- ===================== VERSION =====================================
pilot FREAKC_VERSION = "0.13.0"
pilot FREAKC_CODENAME = "Shiranui"

-- ===================== TOKENS ======================================
pilot TOK_EOF = "0"
pilot TOK_IDENT = "1"
pilot TOK_NUM = "2"
pilot TOK_STR = "3"
pilot TOK_BOOL = "4"
pilot TOK_PUNCT = "5"
pilot TOK_KW = "6"

pilot tok_types = 0
pilot tok_vals  = 0
pilot tok_lines = 0
pilot tok_cols  = 0
pilot tokens_count = 0

-- ===================== AST EXPRESSION KINDS ========================
pilot EXPR_INT = "1"
pilot EXPR_FLOAT = "2"
pilot EXPR_STR = "3"
pilot EXPR_BOOL = "4"
pilot EXPR_IDENT = "5"
pilot EXPR_BINOP = "6"
pilot EXPR_UNARYOP = "7"
pilot EXPR_CALL = "8"
pilot EXPR_METHOD = "9"
pilot EXPR_FIELD = "10"
pilot EXPR_INDEX = "11"

pilot ast_expr_kinds = 0
pilot ast_expr_vals = 0
pilot ast_expr_lefts = 0
pilot ast_expr_rights = 0

-- ===================== AST STATEMENT KINDS =========================
pilot STMT_PILOT = "1"
pilot STMT_SAY = "2"
pilot STMT_TASK = "3"
pilot STMT_GIVE_BACK = "4"
pilot STMT_IF = "5"
pilot STMT_ASSIGN = "6"
pilot STMT_EXPR = "7"
pilot STMT_REPEAT = "8"
pilot STMT_TRAINING_ARC = "9"
pilot STMT_WHEN = "10"
pilot STMT_BLOCK = "11"
pilot STMT_SHAPE = "12"
pilot STMT_BREAK = "13"
pilot STMT_CONTINUE = "14"
pilot STMT_EVENTUALLY = "15"
pilot STMT_EXTERN = "16"

pilot ast_stmt_kinds = 0
pilot ast_stmt_names = 0
pilot ast_stmt_exprs = 0
pilot ast_stmt_bodies = 0
pilot ast_stmt_else_bodies = 0
pilot ast_stmt_extras = 0
pilot ast_task_params = 0
pilot ast_task_returns = 0

pilot ast_top_stmts = 0

-- ===================== SHAPE REGISTRY ==============================
pilot shape_registry_names = 0
pilot shape_registry_fields = 0
pilot shape_registry_count = 0

-- ===================== LEXER STATE =================================
pilot lex_source = ""
pilot lex_len = 0
pilot lex_pos = 0
pilot lex_line = 1
pilot lex_col = 1
pilot cur_tok_line = 1
pilot cur_tok_col = 1

-- ===================== PARSER STATE ================================
pilot parse_idx = 1
pilot tok_total = 0
pilot parse_error_count = 0
pilot next_expr_id = 0
pilot next_stmt_id = 0

-- ===================== EMIT STATE ==================================
-- v3 KEY CHANGE: out_file replaces out_buf. All emit() calls
-- append directly to this file. No O(n^2) string buffer.
pilot out_file = ""
pilot emit_target = "llvm"

-- C emitter variable tracking
pilot emt_var_names = 0
pilot emt_var_types = 0
pilot emt_var_count = 0
pilot emt_word_tasks = 0
pilot emt_word_task_count = 0
pilot emt_extern_names = 0
pilot emt_extern_rets = 0
pilot emt_extern_count = 0

-- LLVM emitter state
pilot llvm_line_count = 0
pilot temp_reg_counter = 0
pilot string_literals = ""
pilot string_literals_count = 0
pilot llvm_var_names = ""
pilot llvm_var_types = ""
pilot llvm_task_reg_names = ""
pilot llvm_task_reg_types = ""
pilot llvm_task_reg_count = 0
pilot llvm_cur_func_is_void = false
pilot llvm_declared_funcs = ""
pilot llvm_loop_end_label = ""
pilot llvm_loop_cond_label = ""
pilot llvm_global_names = ""
pilot llvm_var_reg_map = ""   -- "freak_name:llvm_name|..." latest binding wins

-- ===================== CLI STATE ===================================
pilot input_file = ""
pilot opt_level = "2"
pilot cross_target = ""
-- ===================================================================
-- FREAK v3 COMPILER — HELPERS
-- ===================================================================
-- Array init, shape registry, AST builders, emit infrastructure.

task init_arrays() -> void {
    tok_types = array_new()
    tok_vals = array_new()
    tok_lines = array_new()
    tok_cols = array_new()
    ast_expr_kinds = array_new()
    ast_expr_vals = array_new()
    ast_expr_lefts = array_new()
    ast_expr_rights = array_new()
    ast_stmt_kinds = array_new()
    ast_stmt_names = array_new()
    ast_stmt_exprs = array_new()
    ast_stmt_bodies = array_new()
    ast_stmt_else_bodies = array_new()
    ast_stmt_extras = array_new()
    ast_task_params = array_new()
    ast_task_returns = array_new()
    ast_top_stmts = array_new()
    shape_registry_names = array_new()
    shape_registry_fields = array_new()
    emt_var_names = array_new()
    emt_var_types = array_new()
    emt_word_tasks = array_new()
    emt_extern_names = array_new()
    emt_extern_rets = array_new()
}

-- ===================== AST BUILDERS ================================

task alloc_expr(kind: word, val: word, left: word, right: word) -> int {
    pilot id = next_expr_id
    next_expr_id += 1
    array_push(ast_expr_kinds, kind)
    array_push(ast_expr_vals, val)
    array_push(ast_expr_lefts, left)
    array_push(ast_expr_rights, right)
    give back id
}

task alloc_stmt(kind: word, name: word, expr_id: word, body_id: word, else_body: word, extra: word, params: word, returns: word) -> int {
    pilot id = next_stmt_id
    next_stmt_id += 1
    array_push(ast_stmt_kinds, kind)
    array_push(ast_stmt_names, name)
    array_push(ast_stmt_exprs, expr_id)
    array_push(ast_stmt_bodies, body_id)
    array_push(ast_stmt_else_bodies, else_body)
    array_push(ast_stmt_extras, extra)
    array_push(ast_task_params, params)
    array_push(ast_task_returns, returns)
    give back id
}

-- ===================== SHAPE REGISTRY ==============================

task register_shape(name: word, fields: word) -> void {
    array_push(shape_registry_names, name)
    array_push(shape_registry_fields, fields)
    shape_registry_count += 1
}

task is_shape_name(name: word) -> bool {
    pilot si = 0
    repeat shape_registry_count times {
        if array_get(shape_registry_names, si) == name { give back true }
        si += 1
    }
    give back false
}

task get_shape_fields(name: word) -> word {
    pilot si = 0
    repeat shape_registry_count times {
        if array_get(shape_registry_names, si) == name {
            give back array_get(shape_registry_fields, si)
        }
        si += 1
    }
    give back ""
}

task get_shape_field_count(shape_name: word) -> int {
    pilot fields = get_shape_fields(shape_name)
    if fields.length() == 0 { give back 0 }
    pilot count = 1
    pilot i = 0
    pilot slen = fields.length()
    repeat slen times {
        if fields.char_at(i) == "," { count += 1 }
        i += 1
    }
    give back count
}

task get_shape_field_index(shape_name: word, field_name: word) -> int {
    pilot fields = get_shape_fields(shape_name)
    if fields.length() == 0 { give back 0 - 1 }
    pilot idx = 0
    pilot cur_name = ""
    pilot in_type = false
    pilot slen = fields.length()
    pilot i = 0
    repeat slen times {
        pilot c = fields.char_at(i)
        if c == "," {
            if cur_name == field_name { give back idx }
            idx += 1
            cur_name = ""
            in_type = false
        } else if c == ":" {
            in_type = true
        } else {
            if not in_type { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name == field_name { give back idx }
    give back 0 - 1
}

-- ===================== STREAMING EMIT ==============================
-- v3 KEY CHANGE: emit writes directly to file. No buffer.

task emit(s: word) -> void {
    fs::append(out_file, s)
}

task emit_line(s: word) -> void {
    fs::append(out_file, s + "\n")
}

-- ===================== EMITTER VARIABLE TRACKING ===================

task emt_set_var_type(name: word, vtype: word) -> void {
    pilot i = 0
    repeat emt_var_count times {
        if array_get(emt_var_names, i) == name {
            array_set(emt_var_types, i, vtype)
            give back
        }
        i += 1
    }
    array_push(emt_var_names, name)
    array_push(emt_var_types, vtype)
    emt_var_count += 1
}

task emt_get_var_type(name: word) -> word {
    pilot i = 0
    repeat emt_var_count times {
        if array_get(emt_var_names, i) == name {
            give back array_get(emt_var_types, i)
        }
        i += 1
    }
    give back "i"
}

task emt_register_word_task(name: word) -> void {
    array_push(emt_word_tasks, name)
    emt_word_task_count += 1
}

task emt_is_word_task(name: word) -> bool {
    pilot i = 0
    repeat emt_word_task_count times {
        if array_get(emt_word_tasks, i) == name { give back true }
        i += 1
    }
    give back false
}

task emt_register_extern(name: word, ret: word) -> void {
    array_push(emt_extern_names, name)
    array_push(emt_extern_rets, ret)
    emt_extern_count += 1
}

task emt_is_extern(name: word) -> bool {
    pilot i = 0
    repeat emt_extern_count times {
        if array_get(emt_extern_names, i) == name { give back true }
        i += 1
    }
    give back false
}

task emt_get_extern_ret(name: word) -> word {
    pilot i = 0
    repeat emt_extern_count times {
        if array_get(emt_extern_names, i) == name {
            give back array_get(emt_extern_rets, i)
        }
        i += 1
    }
    give back ""
}

-- ===================== WORD TYPE DETECTION =========================

task is_ast_word(id: word) -> bool {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    if kind == EXPR_STR { give back true }
    if kind == EXPR_METHOD {
        pilot mname: word = array_get(ast_expr_vals, i)
        if mname == "length" { give back false }
        if mname == "to_int" { give back false }
        if mname == "starts_with" { give back false }
        if mname == "ends_with" { give back false }
        if mname == "contains" { give back false }
        give back true
    }
    if kind == EXPR_CALL {
        pilot cname: word = array_get(ast_expr_vals, i)
        if cname == "word_from_int" { give back true }
        if cname == "word_from_bool" { give back true }
        if cname == "ask" { give back true }
        if cname == "fs::read" { give back true }
        if cname == "process::arg" { give back true }
        if cname == "process::exec_capture" { give back true }
        if cname == "format_num" { give back true }
        if emt_is_word_task(cname) { give back true }
        pilot eret: word = emt_get_extern_ret(cname)
        if eret == "word" { give back true }
        give back false
    }
    if kind == EXPR_IDENT {
        pilot vname: word = array_get(ast_expr_vals, i)
        pilot vt: word = emt_get_var_type(vname)
        if vt == "w" { give back true }
        give back false
    }
    if kind == EXPR_BINOP {
        pilot op: word = array_get(ast_expr_vals, i)
        if op == "+" {
            pilot lft: word = array_get(ast_expr_lefts, i)
            if is_ast_word(lft) { give back true }
        }
        give back false
    }
    if kind == EXPR_FIELD { give back false }
    give back false
}
-- ===================================================================
-- FREAK v3 COMPILER — LEXER
-- ===================================================================
-- Character-by-character tokenizer. Reused from v2 with no changes.
-- The v2 lexer works correctly; no architectural issues here.

task lex_cur_ch() -> word {
    if lex_pos >= lex_len { give back "" }
    give back lex_source.char_at(lex_pos)
}

task lex_ch_at(offset: int) -> word {
    if lex_pos + offset >= lex_len { give back "" }
    give back lex_source.char_at(lex_pos + offset)
}

task lex_advance() -> word {
    if lex_pos >= lex_len { give back "" }
    pilot c = lex_source.char_at(lex_pos)
    lex_pos += 1
    if c == "\n" {
        lex_line += 1
        lex_col = 1
    } else {
        lex_col += 1
    }
    give back c
}

task push_token(kind: word, val: word) -> void {
    array_push(tok_types, kind)
    array_push(tok_vals, val)
    array_push(tok_lines, word_from_int(cur_tok_line))
    array_push(tok_cols, word_from_int(cur_tok_col))
    tokens_count += 1
}

task lex_skip_ws() -> void {
    pilot fin = false
    repeat until fin {
        pilot c = lex_cur_ch()
        if c == " " or c == "\n" or c == "\r" or c == "\t" {
            lex_advance()
        } else if c == "-" {
            if lex_ch_at(1) == "-" {
                lex_advance()
                lex_advance()
                pilot cline_fin = false
                repeat until cline_fin {
                    pilot cc = lex_cur_ch()
                    if cc == "" or cc == "\n" {
                        cline_fin = true
                    } else {
                        lex_advance()
                    }
                }
            } else {
                fin = true
            }
        } else {
            fin = true
        }
    }
}

task is_numeric(c: word) -> bool {
    if c == "0" or c == "1" or c == "2" or c == "3" or c == "4" { give back true }
    if c == "5" or c == "6" or c == "7" or c == "8" or c == "9" { give back true }
    give back false
}

task is_alphabetic(c: word) -> bool {
    if c == "_" { give back true }
    if c == "a" or c == "b" or c == "c" or c == "d" or c == "e" { give back true }
    if c == "f" or c == "g" or c == "h" or c == "i" or c == "j" { give back true }
    if c == "k" or c == "l" or c == "m" or c == "n" or c == "o" { give back true }
    if c == "p" or c == "q" or c == "r" or c == "s" or c == "t" { give back true }
    if c == "u" or c == "v" or c == "w" or c == "x" or c == "y" or c == "z" { give back true }
    if c == "A" or c == "B" or c == "C" or c == "D" or c == "E" { give back true }
    if c == "F" or c == "G" or c == "H" or c == "I" or c == "J" { give back true }
    if c == "K" or c == "L" or c == "M" or c == "N" or c == "O" { give back true }
    if c == "P" or c == "Q" or c == "R" or c == "S" or c == "T" { give back true }
    if c == "U" or c == "V" or c == "W" or c == "X" or c == "Y" or c == "Z" { give back true }
    give back false
}

task is_alnum_ext(c: word) -> bool {
    if is_alphabetic(c) { give back true }
    if is_numeric(c) { give back true }
    give back false
}

task lex_number() -> void {
    pilot res = ""
    pilot fin = false
    repeat until fin {
        pilot c = lex_cur_ch()
        if is_numeric(c) or c == "." {
            res = res + c
            lex_advance()
        } else {
            fin = true
        }
    }
    push_token(TOK_NUM, res)
}

task try_consume_word(target: word) -> bool {
    pilot s_pos = lex_pos
    pilot s_line = lex_line
    pilot s_col = lex_col
    lex_skip_ws()
    pilot res = ""
    pilot fin = false
    repeat until fin {
        pilot c = lex_cur_ch()
        if is_alnum_ext(c) {
            res = res + c
            lex_advance()
        } else {
            fin = true
        }
    }
    if res.to_lower() == target.to_lower() {
        give back true
    }
    lex_pos = s_pos
    lex_line = s_line
    lex_col = s_col
    give back false
}

task lex_ident() -> void {
    pilot res = ""
    pilot fin = false
    repeat until fin {
        pilot c = lex_cur_ch()
        if is_alnum_ext(c) {
            res = res + c
            lex_advance()
        } else {
            fin = true
        }
    }
    pilot lower = res.to_lower()
    -- Multi-word keywords
    if lower == "give" {
        if try_consume_word("back") { push_token(TOK_KW, "give back") give back }
    }
    if lower == "or" {
        if try_consume_word("else") { push_token(TOK_KW, "or else") give back }
    }
    if lower == "trust" {
        if try_consume_word("me") { push_token(TOK_KW, "trust me") give back }
    }
    if lower == "for" {
        if try_consume_word("each") { push_token(TOK_KW, "for each") give back }
        if try_consume_word("science") { push_token(TOK_KW, "for science") give back }
    }
    if lower == "training" {
        if try_consume_word("arc") { push_token(TOK_KW, "training arc") give back }
    }
    if lower == "bringing" {
        if try_consume_word("back") { push_token(TOK_KW, "bringing back") give back }
    }
    if lower == "only" {
        if try_consume_word("on") { push_token(TOK_KW, "only on") give back }
    }
    if lower == "plus" {
        if try_consume_word("ultra") { push_token(TOK_KW, "PLUS ULTRA") give back }
    }
    if lower == "final" {
        if try_consume_word("form") { push_token(TOK_KW, "FINAL FORM") give back }
    }
    -- Single-word keywords
    if lower == "pilot" or lower == "fixed" or lower == "task" or lower == "say" or lower == "shape" or lower == "impl" or lower == "doctrine" or lower == "launch" or lower == "use" or lower == "as" or lower == "in" or lower == "lend" or lower == "mut" or lower == "move" or lower == "copy" or lower == "break" or lower == "continue" or lower == "if" or lower == "else" or lower == "when" or lower == "repeat" or lower == "times" or lower == "until" or lower == "done" or lower == "for" or lower == "each" or lower == "check" or lower == "result" or lower == "got" or lower == "nobody" or lower == "some" or lower == "ok" or lower == "err" or lower == "sessions" or lower == "max" or lower == "foreshadow" or lower == "payoff" or lower == "route" or lower == "sadly" or lower == "deus_ex_machina" or lower == "isekai" or lower == "eventually" or lower == "and" or lower == "or" or lower == "not" or lower == "nakama" or lower == "tsundere" or lower == "extern" {
        push_token(TOK_KW, res)
    } else if lower == "true" or lower == "false" or lower == "yes" or lower == "no" or lower == "hai" or lower == "iie" {
        push_token(TOK_BOOL, res)
    } else {
        push_token(TOK_IDENT, res)
    }
}

task lex_string() -> void {
    lex_advance()
    pilot res = ""
    pilot fin = false
    repeat until fin {
        pilot c = lex_advance()
        if c == "\"" {
            fin = true
        } else if c == "" {
            fin = true
        } else if c == "\\" {
            pilot esc = lex_advance()
            if esc == "n" { res = res + "\n" }
            else if esc == "r" { res = res + "\r" }
            else if esc == "t" { res = res + "\t" }
            else if esc == "x" {
                -- Hex escape \xNN: store as \\xNN so C emitter passes it through
                pilot hex_hi = lex_advance()
                pilot hex_lo = lex_advance()
                res = res + "\\x" + hex_hi + hex_lo
            } else { res = res + esc }
        } else if c == "|" {
            res = res + "<<PIPE>>"
        } else {
            res = res + c
        }
    }
    push_token(TOK_STR, res)
}

task lex_operators() -> void {
    pilot c = lex_cur_ch()
    pilot op = c
    lex_advance()
    pilot next_c = lex_cur_ch()
    pilot is_double = false
    if op == "=" and next_c == "=" { is_double = true }
    if op == "!" and next_c == "=" { is_double = true }
    if op == "<" and next_c == "=" { is_double = true }
    if op == ">" and next_c == "=" { is_double = true }
    if op == "+" and next_c == "=" { is_double = true }
    if op == "-" and next_c == "=" { is_double = true }
    if op == "*" and next_c == "=" { is_double = true }
    if op == "/" and next_c == "=" { is_double = true }
    if op == "%" and next_c == "=" { is_double = true }
    if op == "-" and next_c == ">" { is_double = true }
    if op == "=" and next_c == ">" { is_double = true }
    if op == "*" and next_c == "*" { is_double = true }
    if op == "|" and next_c == ">" { is_double = true }
    if op == "|" and next_c == "|" { is_double = true }
    if op == ":" and next_c == ":" { is_double = true }
    if is_double {
        op = op + next_c
        lex_advance()
    }
    push_token(TOK_PUNCT, op)
}

task tokenize(source: word) -> void {
    lex_source = source
    lex_len = source.length()
    say "Source length: " + word_from_int(lex_len)
    lex_pos = 0
    lex_line = 1
    lex_col = 1
    tokens_count = 0
    pilot fin = false
    repeat until fin {
        lex_skip_ws()
        cur_tok_line = lex_line
        cur_tok_col = lex_col
        if lex_pos >= lex_len {
            fin = true
        } else {
            pilot c = lex_cur_ch()
            if is_numeric(c) {
                lex_number()
            } else if is_alphabetic(c) {
                lex_ident()
            } else if c == "\"" {
                lex_string()
            } else if c == "=" or c == "+" or c == "-" or c == "*" or c == "/" or c == "<" or c == ">" or c == "!" or c == ":" or c == "|" or c == "%" or c == "@" or c == "?" {
                lex_operators()
            } else if c == "{" or c == "}" or c == "(" or c == ")" or c == "[" or c == "]" or c == "," or c == "." {
                push_token(TOK_PUNCT, c)
                lex_advance()
            } else {
                push_token(TOK_PUNCT, c)
                lex_advance()
            }
        }
    }
    push_token(TOK_EOF, "")
}
-- ===================================================================
-- FREAK v3 COMPILER — PARSER
-- ===================================================================
-- Recursive descent parser. Builds AST in parallel arrays.
-- v3 changes: flat if chains (no else-if nesting), early returns.

task cur_tok_type() -> word {
    give back array_get(tok_types, parse_idx)
}

task cur_tok_val() -> word {
    give back array_get(tok_vals, parse_idx)
}

task advance_tok() -> void {
    parse_idx += 1
}

task match_tok(type: word, val: word) -> bool {
    if cur_tok_type() == type {
        if val == "" or cur_tok_val() == val {
            advance_tok()
            give back true
        }
    }
    give back false
}

task expect_tok(type: word, val: word) -> void {
    if not match_tok(type, val) {
        parse_error_count += 1
        if parse_error_count < 50 {
            pilot msg = "Syntax Error: Expected token type "
            msg = msg + type
            msg = msg + " with value '"
            msg = msg + val
            msg = msg + "' but got "
            msg = msg + cur_tok_type()
            msg = msg + " '"
            msg = msg + cur_tok_val()
            msg = msg + "'"
            say msg
        }
        if cur_tok_type() != TOK_EOF and cur_tok_type() != "" {
            advance_tok()
        }
    }
}

-- ===================== EXPRESSION PARSING ============================

task parse_primary() -> int {
    pilot ttype = cur_tok_type()
    pilot tval = cur_tok_val()

    if ttype == TOK_EOF or ttype == "" { give back 0 - 1 }

    if ttype == TOK_NUM {
        advance_tok()
        pilot is_float = false
        pilot nci = 0
        pilot nclen = tval.length()
        repeat nclen times {
            if tval.char_at(nci) == "." { is_float = true }
            nci += 1
        }
        if is_float { give back alloc_expr(EXPR_FLOAT, tval, "", "") }
        give back alloc_expr(EXPR_INT, tval, "", "")
    }
    if ttype == TOK_STR {
        advance_tok()
        give back alloc_expr(EXPR_STR, tval, "", "")
    }
    if ttype == TOK_BOOL {
        advance_tok()
        give back alloc_expr(EXPR_BOOL, tval, "", "")
    }
    if ttype == TOK_IDENT {
        advance_tok()

        -- Namespace: foo::bar
        if match_tok(TOK_PUNCT, "::") {
            pilot nttype = cur_tok_type()
            pilot ntval = cur_tok_val()
            if nttype == TOK_IDENT {
                tval = tval + "::" + ntval
                advance_tok()
            } else {
                say "Expected identifier after ::"
            }
        }
        -- Shape constructor: Name { field: val, ... }
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "{" {
            if is_shape_name(tval) {
                advance_tok()
                pilot val_ids = ""
                pilot cfin = false
                pilot cis_first = true
                if match_tok(TOK_PUNCT, "}") { cfin = true }
                repeat until cfin {
                    pilot fname = cur_tok_val()
                    advance_tok()
                    expect_tok(TOK_PUNCT, ":")
                    pilot fval_id = parse_expr()
                    if cis_first {
                        val_ids = word_from_int(fval_id)
                        cis_first = false
                    } else {
                        val_ids = val_ids + "," + word_from_int(fval_id)
                    }
                    if match_tok(TOK_PUNCT, "}") { cfin = true }
                    else { expect_tok(TOK_PUNCT, ",") }
                }
                give back alloc_expr(EXPR_CALL, "shape::ctor::" + tval, val_ids, "")
            }
        }

        -- Function call: name(args)
        if match_tok(TOK_PUNCT, "(") {
            pilot args = ""
            pilot fin = false
            pilot is_first = true
            if match_tok(TOK_PUNCT, ")") { fin = true }
            repeat until fin {
                pilot arg_id = parse_expr()
                if is_first {
                    args = word_from_int(arg_id)
                    is_first = false
                } else {
                    args = args + "," + word_from_int(arg_id)
                }
                if match_tok(TOK_PUNCT, ")") { fin = true }
                else { expect_tok(TOK_PUNCT, ",") }
            }
            give back alloc_expr(EXPR_CALL, tval, args, "")
        }

        give back alloc_expr(EXPR_IDENT, tval, "", "")
    }

    -- Parenthesized expression
    if ttype == TOK_PUNCT and tval == "(" {
        advance_tok()
        pilot inner = parse_expr()
        expect_tok(TOK_PUNCT, ")")
        give back inner
    }

    say "Unexpected token in primary: " + tval + " (" + ttype + ")"
    if ttype != TOK_EOF and ttype != "" { advance_tok() }
    give back 0 - 1
}

task parse_postfix() -> int {
    pilot left = parse_primary()
    pilot fin = false
    repeat until fin {
        if match_tok(TOK_PUNCT, ".") {
            pilot mname = cur_tok_val()
            expect_tok(TOK_IDENT, "")
            if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "(" {
                -- Method call: .name(args)
                advance_tok()
                pilot args = ""
                pilot argfin = false
                pilot is_first = true
                if match_tok(TOK_PUNCT, ")") { argfin = true }
                repeat until argfin {
                    pilot arg_id = parse_expr()
                    if is_first {
                        args = word_from_int(arg_id)
                        is_first = false
                    } else {
                        args = args + "," + word_from_int(arg_id)
                    }
                    if match_tok(TOK_PUNCT, ")") { argfin = true }
                    else { expect_tok(TOK_PUNCT, ",") }
                }
                left = alloc_expr(EXPR_METHOD, mname, word_from_int(left), args)
            } else {
                -- Field access: .name
                left = alloc_expr(EXPR_FIELD, mname, word_from_int(left), "")
            }
        } else if match_tok(TOK_PUNCT, "[") {
            pilot idx_expr = parse_expr()
            expect_tok(TOK_PUNCT, "]")
            left = alloc_expr(EXPR_INDEX, "", word_from_int(left), word_from_int(idx_expr))
        } else if match_tok(TOK_PUNCT, "|>") {
            -- Pipe: a |> f(args) => f(a, args)
            pilot fname = cur_tok_val()
            advance_tok()
            pilot pipe_args = word_from_int(left)
            if match_tok(TOK_PUNCT, "(") {
                if not match_tok(TOK_PUNCT, ")") {
                    pilot pfin = false
                    repeat until pfin {
                        pilot parg_id = parse_expr()
                        pipe_args = pipe_args + "," + word_from_int(parg_id)
                        if match_tok(TOK_PUNCT, ")") { pfin = true }
                        else { expect_tok(TOK_PUNCT, ",") }
                    }
                }
            }
            left = alloc_expr(EXPR_CALL, fname, pipe_args, "")
        } else {
            fin = true
        }
    }
    give back left
}

-- v3: flat if with early return (no else-if nesting)
task parse_unary() -> int {
    if match_tok(TOK_KW, "not") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "not", word_from_int(op), "")
    }
    if match_tok(TOK_PUNCT, "-") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "-", word_from_int(op), "")
    }
    if match_tok(TOK_KW, "PLUS ULTRA") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "PLUS ULTRA", word_from_int(op), "")
    }
    if match_tok(TOK_KW, "FINAL FORM") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "FINAL FORM", word_from_int(op), "")
    }
    if match_tok(TOK_KW, "TSUNDERE") {
        pilot op = parse_unary()
        give back alloc_expr(EXPR_UNARYOP, "TSUNDERE", word_from_int(op), "")
    }
    give back parse_postfix()
}

-- Precedence: or < and < comparison < add < mul < unary < postfix

task parse_mul() -> int {
    pilot left = parse_unary()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "*" or tval == "/" or tval == "%" {
            advance_tok()
            pilot right = parse_unary()
            left = alloc_expr(EXPR_BINOP, tval, word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_add() -> int {
    pilot left = parse_mul()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "+" or tval == "-" or tval == "NAKAMA" {
            advance_tok()
            pilot right = parse_mul()
            left = alloc_expr(EXPR_BINOP, tval, word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_comparison() -> int {
    pilot left = parse_add()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "==" or tval == "!=" or tval == "<" or tval == ">" or tval == "<=" or tval == ">=" {
            advance_tok()
            pilot right = parse_add()
            left = alloc_expr(EXPR_BINOP, tval, word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_and() -> int {
    pilot left = parse_comparison()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "and" {
            advance_tok()
            pilot right = parse_comparison()
            left = alloc_expr(EXPR_BINOP, "and", word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

task parse_expr() -> int {
    pilot left = parse_and()
    pilot fin = false
    repeat until fin {
        pilot tval = cur_tok_val()
        if tval == "or" {
            advance_tok()
            pilot right = parse_and()
            left = alloc_expr(EXPR_BINOP, "or", word_from_int(left), word_from_int(right))
        } else {
            fin = true
        }
    }
    give back left
}

-- ===================== BLOCK + STATEMENT PARSING =====================

task parse_block() -> word {
    expect_tok(TOK_PUNCT, "{")
    pilot block = ""
    pilot fin = false
    pilot is_first = true
    if match_tok(TOK_PUNCT, "}") { fin = true }
    repeat until fin {
        pilot stmt_id = parse_stmt()
        if is_first {
            block = word_from_int(stmt_id)
            is_first = false
        } else {
            block = block + "," + word_from_int(stmt_id)
        }
        if match_tok(TOK_PUNCT, "}") { fin = true }
    }
    give back block
}

task parse_stmt() -> int {
    pilot ttype = cur_tok_type()
    pilot tval = cur_tok_val()

    -- Skip @annotations
    if ttype == TOK_PUNCT and tval == "@" {
        advance_tok()
        advance_tok()
        ttype = cur_tok_type()
        tval = cur_tok_val()
    }

    -- say expr
    if match_tok(TOK_KW, "say") {
        pilot expr_id = parse_expr()
        give back alloc_stmt(STMT_SAY, "", word_from_int(expr_id), "", "", "", "", "")
    }

    -- shape Name { field: type, ... }
    if match_tok(TOK_KW, "shape") {
        give back parse_shape()
    }

    -- impl Name { task ... }
    if match_tok(TOK_KW, "impl") {
        give back parse_impl()
    }

    -- eventually { body }
    if match_tok(TOK_KW, "eventually") {
        pilot ev_body = parse_block()
        give back alloc_stmt(STMT_EVENTUALLY, "", "", ev_body, "", "", "", "")
    }

    -- pilot name = expr
    if match_tok(TOK_KW, "pilot") {
        pilot name = cur_tok_val()
        advance_tok()
        pilot type_ann = ""
        if cur_tok_type() == TOK_PUNCT and cur_tok_val() == ":" {
            advance_tok()
            type_ann = cur_tok_val()
            advance_tok()
        }
        expect_tok(TOK_PUNCT, "=")
        pilot expr_id = parse_expr()
        give back alloc_stmt(STMT_PILOT, name, word_from_int(expr_id), "", "", type_ann, "", "")
    }

    -- give back expr
    if match_tok(TOK_KW, "give back") {
        pilot expr_id = 0 - 1
        if cur_tok_type() != TOK_PUNCT or cur_tok_val() != "}" {
            expr_id = parse_expr()
        }
        give back alloc_stmt(STMT_GIVE_BACK, "", word_from_int(expr_id), "", "", "", "", "")
    }

    -- break / continue
    if match_tok(TOK_KW, "break") {
        give back alloc_stmt(STMT_BREAK, "", "", "", "", "", "", "")
    }
    if match_tok(TOK_KW, "continue") {
        give back alloc_stmt(STMT_CONTINUE, "", "", "", "", "", "", "")
    }

    -- if expr { body } else { body }
    if match_tok(TOK_KW, "if") {
        pilot expr_id = parse_expr()
        pilot body_id = parse_block()
        pilot else_body = ""
        if match_tok(TOK_KW, "else") {
            if cur_tok_type() == TOK_KW and cur_tok_val() == "if" {
                pilot elif_id = parse_stmt()
                else_body = word_from_int(elif_id)
            } else {
                else_body = parse_block()
            }
        }
        give back alloc_stmt(STMT_IF, "", word_from_int(expr_id), body_id, else_body, "", "", "")
    }

    -- repeat until cond { body }  /  repeat N times { body }
    if match_tok(TOK_KW, "repeat") {
        if match_tok(TOK_KW, "until") {
            pilot expr_id = parse_expr()
            pilot body_id = parse_block()
            give back alloc_stmt(STMT_REPEAT, "until", word_from_int(expr_id), body_id, "", "", "", "")
        }
        pilot expr_id = parse_expr()
        expect_tok(TOK_KW, "times")
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_REPEAT, "times", word_from_int(expr_id), body_id, "", "", "", "")
    }

    -- training arc until cond max N sessions { body }
    if match_tok(TOK_KW, "training arc") {
        expect_tok(TOK_KW, "until")
        pilot cond_id = parse_expr()
        expect_tok(TOK_KW, "max")
        pilot max_id = parse_expr()
        expect_tok(TOK_KW, "sessions")
        pilot body_id = parse_block()
        give back alloc_stmt(STMT_TRAINING_ARC, "", word_from_int(cond_id), body_id, "", word_from_int(max_id), "", "")
    }

    -- when expr { val -> stmt, ... }
    if match_tok(TOK_KW, "when") {
        give back parse_when()
    }

    -- extern task name(params) -> ret
    if match_tok(TOK_KW, "extern") {
        give back parse_extern()
    }

    -- task name(params) -> ret { body }
    if match_tok(TOK_KW, "task") {
        give back parse_task_def()
    }

    -- Bare block { ... }
    if cur_tok_type() == TOK_PUNCT and cur_tok_val() == "{" {
        pilot block_id = parse_block()
        give back alloc_stmt(STMT_BLOCK, "", "", block_id, "", "", "", "")
    }

    -- Expression statement (or assignment)
    pilot expr_id = parse_expr()

    if match_tok(TOK_PUNCT, "=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "")
    }
    if match_tok(TOK_PUNCT, "+=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "+=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "")
    }
    if match_tok(TOK_PUNCT, "-=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "-=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "")
    }
    if match_tok(TOK_PUNCT, "*=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "*=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "")
    }
    if match_tok(TOK_PUNCT, "/=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "/=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "")
    }
    if match_tok(TOK_PUNCT, "%=") {
        pilot rhs = parse_expr()
        give back alloc_stmt(STMT_ASSIGN, "%=", word_from_int(expr_id), word_from_int(rhs), "", "", "", "")
    }

    give back alloc_stmt(STMT_EXPR, "", word_from_int(expr_id), "", "", "", "", "")
}

-- ===================== HELPER PARSE TASKS ============================
-- v3: Split out from parse_stmt to keep functions short.

task parse_params() -> word {
    pilot params = ""
    pilot fin = false
    pilot is_first = true
    if match_tok(TOK_PUNCT, ")") { fin = true }
    repeat until fin {
        pilot pname = cur_tok_val()
        advance_tok()
        if pname == "self" {
            if match_tok(TOK_PUNCT, ")") { fin = true }
            else { expect_tok(TOK_PUNCT, ",") }
            if is_first {
                params = "self:word"
                is_first = false
            } else {
                params = params + ",self:word"
            }
        } else {
            expect_tok(TOK_PUNCT, ":")
            pilot ptype = cur_tok_val()
            advance_tok()
            pilot pstr = pname + ":" + ptype
            if is_first {
                params = pstr
                is_first = false
            } else {
                params = params + "," + pstr
            }
            if match_tok(TOK_PUNCT, ")") { fin = true }
            else { expect_tok(TOK_PUNCT, ",") }
        }
    }
    give back params
}

task parse_shape() -> int {
    pilot shape_name = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "{")
    pilot fields = ""
    pilot sfin = false
    pilot sis_first = true
    repeat until sfin {
        if match_tok(TOK_PUNCT, "}") {
            sfin = true
        } else {
            pilot fname = cur_tok_val()
            advance_tok()
            expect_tok(TOK_PUNCT, ":")
            pilot ftype = cur_tok_val()
            advance_tok()
            if sis_first {
                fields = fname + ":" + ftype
                sis_first = false
            } else {
                fields = fields + "," + fname + ":" + ftype
            }
        }
    }
    register_shape(shape_name, fields)
    give back alloc_stmt(STMT_SHAPE, shape_name, "", "", "", fields, "", "")
}

task parse_impl() -> int {
    pilot impl_name = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "{")

    repeat until cur_tok_type() == TOK_PUNCT and cur_tok_val() == "}" {
        if match_tok(TOK_KW, "task") {
            pilot mname = cur_tok_val()
            advance_tok()
            expect_tok(TOK_PUNCT, "(")
            pilot params = parse_params()
            pilot ret_type = "void"
            if match_tok(TOK_PUNCT, "->") {
                ret_type = cur_tok_val()
                advance_tok()
            }
            pilot body_id = parse_block()
            pilot full_name = impl_name + "_" + mname
            pilot sid = alloc_stmt(STMT_TASK, full_name, "", body_id, "", "", params, ret_type)
            array_push(ast_top_stmts, word_from_int(sid))
        } else {
            advance_tok()
        }
    }
    expect_tok(TOK_PUNCT, "}")
    give back alloc_stmt(STMT_BLOCK, "", "", "", "", "", "", "")
}

task parse_when() -> int {
    pilot target_id = parse_expr()
    expect_tok(TOK_PUNCT, "{")
    pilot cases_str = ""
    pilot fin = false
    pilot is_first = true
    repeat until fin {
        if match_tok(TOK_PUNCT, "}") {
            fin = true
        } else {
            pilot case_expr = 0 - 1
            if match_tok(TOK_IDENT, "_") {
                case_expr = 0 - 1
            } else {
                case_expr = parse_expr()
            }
            expect_tok(TOK_PUNCT, "->")
            pilot stmt_id = parse_stmt()
            pilot case_str = word_from_int(case_expr) + ":" + word_from_int(stmt_id)
            if is_first {
                cases_str = case_str
                is_first = false
            } else {
                cases_str = cases_str + "," + case_str
            }
        }
    }
    give back alloc_stmt(STMT_WHEN, "", word_from_int(target_id), cases_str, "", "", "", "")
}

task parse_extern() -> int {
    expect_tok(TOK_KW, "task")
    pilot ename = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "(")
    pilot eparams = ""
    pilot efin = false
    pilot eis_first = true
    if match_tok(TOK_PUNCT, ")") { efin = true }
    repeat until efin {
        pilot epname = cur_tok_val()
        advance_tok()
        expect_tok(TOK_PUNCT, ":")
        pilot eptype = cur_tok_val()
        advance_tok()
        pilot epstr = epname + ":" + eptype
        if eis_first {
            eparams = epstr
            eis_first = false
        } else {
            eparams = eparams + "," + epstr
        }
        if match_tok(TOK_PUNCT, ")") { efin = true }
        else { expect_tok(TOK_PUNCT, ",") }
    }
    expect_tok(TOK_PUNCT, "->")
    pilot eret_type = cur_tok_val()
    advance_tok()
    give back alloc_stmt(STMT_EXTERN, ename, "", "", "", "", eparams, eret_type)
}

task parse_task_def() -> int {
    pilot name = cur_tok_val()
    advance_tok()
    expect_tok(TOK_PUNCT, "(")
    pilot params = parse_params()
    pilot ret_type = "void"
    if match_tok(TOK_PUNCT, "->") {
        ret_type = cur_tok_val()
        advance_tok()
    }
    pilot body_id = parse_block()
    give back alloc_stmt(STMT_TASK, name, "", body_id, "", "", params, ret_type)
}

-- ===================== TOP-LEVEL PARSING =============================

task parse_program() -> void {
    parse_idx = 0
    tok_total = tokens_count
    parse_error_count = 0
    pilot pfin = false
    repeat until pfin {
        if cur_tok_type() == TOK_EOF or cur_tok_type() == "" {
            pfin = true
        } else if parse_error_count > 100 {
            say "Too many parse errors, aborting."
            pfin = true
        } else {
            pilot stmt_id = parse_stmt()
            array_push(ast_top_stmts, word_from_int(stmt_id))
        }
    }
}

task check_program() -> void {
    -- Type checker stub (v3 Phase 1)
}
-- ===================================================================
-- FREAK v3 COMPILER — C BACKEND EMITTER
-- ===================================================================
-- Streaming emit via fs::append. Flat if chains. No nesting limits.

task c_safe_ident(s: word) -> word {
    pilot res = ""
    pilot slen = s.length()
    pilot i = 0
    repeat slen times {
        pilot c = s.char_at(i)
        if c == ":" {
            if i + 1 < slen {
                if s.char_at(i + 1) == ":" {
                    res = res + "_"
                    i += 1
                } else {
                    res = res + c
                }
            } else {
                res = res + c
            }
        } else {
            res = res + c
        }
        i += 1
    }
    give back res
}

task emit_args(args: word) -> void {
    pilot i = 0
    pilot slen = args.length()
    pilot cur_id = ""
    pilot first = true
    repeat slen times {
        pilot c = args.char_at(i)
        if c == "," {
            if not first { emit(", ") }
            emit_expr(cur_id)
            cur_id = ""
            first = false
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id != "" {
        if not first { emit(", ") }
        emit_expr(cur_id)
    }
}

-- ===================== CALL MAPPING (FLAT) ============================
-- v3 KEY CHANGE: flat if + early return. Never truncated.

task c_map_call(val: word) -> word {
    if val == "say" { give back "freak_say" }
    if val == "ask" { give back "freak_ask" }
    if val == "word_from_int" { give back "freak_word_from_int" }
    if val == "word_from_bool" { give back "freak_word_from_bool" }
    if val == "word_to_int" { give back "freak_word_to_int" }
    if val == "array_new" { give back "freak_array_new" }
    if val == "array_push" { give back "freak_array_push" }
    if val == "array_get" { give back "freak_array_get" }
    if val == "array_set" { give back "freak_array_set" }
    if val == "array_len" { give back "freak_array_len" }
    if val == "process::args" { give back "freak_process_args" }
    if val == "process::exit" { give back "freak_process_exit" }
    if val == "process::exec" { give back "freak_process_exec" }
    if val == "process::exec_capture" { give back "freak_process_exec_capture" }
    if val == "process::env" { give back "freak_process_env" }
    if val == "process::arg" { give back "freak_process_arg" }
    if val == "process::args_count" { give back "freak_process_args_count" }
    if val == "fs::read" { give back "freak_fs_read" }
    if val == "fs::write" { give back "freak_fs_write" }
    if val == "fs::append" { give back "freak_fs_append" }
    if val == "fs::exists" { give back "freak_fs_exists" }
    if val == "fs::delete" { give back "freak_fs_delete" }
    if val == "fs::list_dir" { give back "freak_fs_list_dir" }
    if val == "math::sqrt" { give back "freak_math_sqrt" }
    if val == "math::pow" { give back "freak_math_pow" }
    if val == "math::sin" { give back "freak_math_sin" }
    if val == "math::cos" { give back "freak_math_cos" }
    if val == "math::tan" { give back "freak_math_tan" }
    if val == "math::floor" { give back "freak_math_floor" }
    if val == "math::ceil" { give back "freak_math_ceil" }
    if val == "parse_num" { give back "freak_parse_num" }
    if val == "format_num" { give back "freak_format_num" }
    if val == "ui::create_window" { give back "freak_ui_create_window_word" }
    if val == "ui::destroy_window" { give back "freak_ui_destroy_window" }
    if val == "ui::begin_frame" { give back "freak_ui_begin_frame" }
    if val == "ui::end_frame" { give back "freak_ui_end_frame" }
    if val == "ui::poll_events" { give back "freak_ui_poll_events" }
    if val == "ui::clear" { give back "freak_ui_clear" }
    if val == "ui::event_kind" { give back "freak_ui_event_kind" }
    if val == "ui::event_key" { give back "freak_ui_event_key" }
    if val == "ui::event_pressed" { give back "freak_ui_event_pressed" }
    if val == "ui::event_character" { give back "freak_ui_event_character" }
    if val == "ui::event_mouse_x" { give back "freak_ui_event_mouse_x" }
    if val == "ui::event_mouse_y" { give back "freak_ui_event_mouse_y" }
    if val == "ui::event_button" { give back "freak_ui_event_button" }
    if val == "ui::fill_rect" { give back "freak_ui_fill_rect" }
    if val == "ui::stroke_rect" { give back "freak_ui_stroke_rect" }
    if val == "ui::fill_circle" { give back "freak_ui_fill_circle" }
    if val == "ui::draw_line" { give back "freak_ui_draw_line" }
    if val == "ui::draw_text" { give back "freak_ui_draw_text_word" }
    if val == "ui::measure_text" { give back "freak_ui_measure_text_word" }
    if val == "tcp::connect" { give back "freak_tcp_connect" }
    if val == "tcp::send" { give back "freak_tcp_send" }
    if val == "tcp::recv" { give back "freak_tcp_recv" }
    if val == "tcp::recv_all" { give back "freak_tcp_recv_all" }
    if val == "tcp::close" { give back "freak_tcp_close" }
    give back ""
}

-- ===================== EXPRESSION EMIT ================================

task emit_expr(id: word) -> void {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)
    pilot left: word = array_get(ast_expr_lefts, i)
    pilot right: word = array_get(ast_expr_rights, i)

    if kind == EXPR_INT { emit(val) give back }
    if kind == EXPR_FLOAT { emit(val) give back }
    if kind == EXPR_BOOL {
        if val == "true" or val == "yes" or val == "hai" { emit("true") }
        else { emit("false") }
        give back
    }
    if kind == EXPR_IDENT { emit(val) give back }

    if kind == EXPR_STR {
        emit_c_string(val)
        give back
    }

    if kind == EXPR_CALL {
        emit_c_call(val, left)
        give back
    }

    if kind == EXPR_METHOD {
        emit_c_method(val, left, right)
        give back
    }

    if kind == EXPR_FIELD {
        emit_c_field(val, left)
        give back
    }

    if kind == EXPR_INDEX {
        if is_ast_word(left) {
            emit("freak_word_char_at(")
            emit_expr(left)
            emit(", ")
            emit_expr(right)
            emit(")")
        } else {
            emit_expr(left)
            emit(".data[")
            emit_expr(right)
            emit("]")
        }
        give back
    }

    if kind == EXPR_BINOP {
        emit_c_binop(val, left, right)
        give back
    }

    if kind == EXPR_UNARYOP {
        emit_c_unaryop(val, left)
        give back
    }

    emit("/* Unknown Expr */")
}

-- v3: Split emit helpers to keep functions short

task emit_c_string(val: word) -> void {
    pilot tmp = "freak_word_lit(\""
    pilot str_val = val.replace("<<PIPE>>", "|")
    pilot si = 0
    pilot sslen = str_val.length()
    repeat until si >= sslen {
        pilot sc = str_val.char_at(si)
        if sc == "\\" and si + 3 < sslen {
            pilot snx = str_val.char_at(si + 1)
            if snx == "x" {
                -- Pass \xNN hex escapes through to C as-is
                tmp = tmp + "\\x" + str_val.char_at(si + 2) + str_val.char_at(si + 3)
                si += 4
            } else {
                tmp = tmp + "\\\\"
                si += 1
            }
        } else if sc == "\n" { tmp = tmp + "\\n" si += 1 }
        else if sc == "\r" { tmp = tmp + "\\r" si += 1 }
        else if sc == "\t" { tmp = tmp + "\\t" si += 1 }
        else if sc == "\\" { tmp = tmp + "\\\\" si += 1 }
        else if sc == "\"" { tmp = tmp + "\\\"" si += 1 }
        else { tmp = tmp + sc si += 1 }
    }
    emit(tmp + "\")")
}

task emit_c_call(val: word, left: word) -> void {
    -- Shape constructor
    if val.starts_with("shape::ctor::") {
        pilot sname = val.replace("shape::ctor::", "")
        pilot field_count = get_shape_field_count(sname)
        emit("freak_shape_alloc(" + word_from_int(field_count) + ", ")
        if left != "" { emit_args(left) }
        emit(")")
        give back
    }

    -- Known builtin mapping
    pilot mapped = c_map_call(val)
    if mapped != "" {
        emit(mapped + "(")
        if left != "" { emit_args(left) }
        emit(")")
        give back
    }

    -- Extern function (no freak_ prefix)
    if emt_is_extern(val) {
        emit(c_safe_ident(val) + "(")
        if left != "" { emit_args(left) }
        emit(")")
        give back
    }

    -- User-defined function
    emit("freak_" + c_safe_ident(val) + "(")
    if left != "" { emit_args(left) }
    emit(")")
}

task emit_c_method(val: word, left: word, right: word) -> void {
    if val == "length" {
        emit("freak_word_length(")
        emit_expr(left)
        emit(")")
        give back
    }
    if val == "to_int" {
        emit("freak_word_to_int(")
        emit_expr(left)
        emit(")")
        give back
    }
    -- Generic word method: freak_word_METHOD(obj, args...)
    emit("freak_word_" + val + "(")
    emit_expr(left)
    if right != "" {
        emit(", ")
        emit_args(right)
    }
    emit(")")
}

task emit_c_field(val: word, left: word) -> void {
    pilot fidx = 0 - 1
    pilot si = 0
    repeat shape_registry_count times {
        pilot tmpidx = get_shape_field_index(array_get(shape_registry_names, si), val)
        if tmpidx >= 0 { fidx = tmpidx }
        si += 1
    }
    if fidx < 0 { fidx = 0 }
    emit("freak_llvm_shape_get(")
    emit_expr(left)
    emit(", " + word_from_int(fidx) + ")")
}

task emit_c_binop(val: word, left: word, right: word) -> void {
    if val == "+" {
        if is_ast_word(left) or is_ast_word(right) {
            emit("freak_word_concat(")
            emit_expr(left)
            emit(", ")
            emit_expr(right)
            emit(")")
            give back
        }
        emit("(")
        emit_expr(left)
        emit(" + ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "==" or val == "!=" {
        if is_ast_word(left) or is_ast_word(right) {
            if val == "!=" { emit("(!") }
            emit("freak_word_eq(")
            emit_expr(left)
            emit(", ")
            emit_expr(right)
            emit(")")
            if val == "!=" { emit(")") }
            give back
        }
        emit("(")
        emit_expr(left)
        emit(" " + val + " ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "and" {
        emit("(")
        emit_expr(left)
        emit(" && ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "or" {
        emit("(")
        emit_expr(left)
        emit(" || ")
        emit_expr(right)
        emit(")")
        give back
    }
    if val == "NAKAMA" {
        emit("(")
        emit_expr(left)
        emit(" + ")
        emit_expr(right)
        emit(" + (")
        emit_expr(left)
        emit(" * ")
        emit_expr(right)
        emit(" / 10))")
        give back
    }
    -- Default: generic binary operator
    emit("(")
    emit_expr(left)
    emit(" " + val + " ")
    emit_expr(right)
    emit(")")
}

task emit_c_unaryop(val: word, left: word) -> void {
    if val == "not" { emit("(!") emit_expr(left) emit(")") give back }
    if val == "-" { emit("(-") emit_expr(left) emit(")") give back }
    if val == "PLUS ULTRA" { emit("(") emit_expr(left) emit(" * 2)") give back }
    if val == "FINAL FORM" { emit("(") emit_expr(left) emit(" * ") emit_expr(left) emit(")") give back }
    if val == "TSUNDERE" { emit("(-") emit_expr(left) emit(")") give back }
}

-- ===================== BLOCK EMIT ====================================

task emit_block(block: word) -> void {
    pilot i = 0
    pilot slen = block.length()
    pilot cur_id = ""
    repeat slen times {
        pilot c = block.char_at(i)
        if c == "," {
            if cur_id != "" { emit_stmt(cur_id) }
            cur_id = ""
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id != "" { emit_stmt(cur_id) }
}

-- ===================== STATEMENT EMIT ================================

task emit_stmt(eid: word) -> void {
    if eid.length() == 0 { give back }

    pilot i = word_to_int(eid)
    pilot kind: word = array_get(ast_stmt_kinds, i)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    if kind == STMT_PILOT { emit_stmt_pilot(eid) give back }
    if kind == STMT_SAY {
        emit("freak_say(")
        emit_expr(expr_id_w)
        emit_line(");")
        give back
    }
    if kind == STMT_EXPR {
        emit_expr(expr_id_w)
        emit_line(";")
        give back
    }
    if kind == STMT_GIVE_BACK {
        emit("return ")
        if expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            emit_expr(expr_id_w)
        }
        emit_line(";")
        give back
    }
    if kind == STMT_IF {
        emit("if (")
        emit_expr(expr_id_w)
        emit_line(") {")
        emit_block(array_get(ast_stmt_bodies, i))
        emit_line("}")
        pilot else_body_w: word = array_get(ast_stmt_else_bodies, i)
        if else_body_w != "" {
            emit_line("else {")
            emit_block(else_body_w)
            emit_line("}")
        }
        give back
    }
    if kind == STMT_REPEAT {
        if name_w == "until" {
            emit("while (!(")
            emit_expr(expr_id_w)
            emit_line(")) {")
            emit_block(array_get(ast_stmt_bodies, i))
            emit_line("}")
        } else {
            emit("for (int64_t __rep = 0; __rep < ")
            emit_expr(expr_id_w)
            emit_line("; __rep++) {")
            emit_block(array_get(ast_stmt_bodies, i))
            emit_line("}")
        }
        give back
    }
    if kind == STMT_TRAINING_ARC {
        pilot max_id_w: word = array_get(ast_stmt_extras, i)
        emit("for (int64_t __arc = 0; __arc < ")
        emit_expr(max_id_w)
        emit_line("; __arc++) {")
        emit("    if (")
        emit_expr(expr_id_w)
        emit_line(") { break; }")
        emit_block(array_get(ast_stmt_bodies, i))
        emit_line("}")
        give back
    }
    if kind == STMT_WHEN {
        emit_stmt_when(eid)
        give back
    }
    if kind == STMT_BLOCK {
        emit_line("{")
        emit_block(array_get(ast_stmt_bodies, i))
        emit_line("}")
        give back
    }
    if kind == STMT_ASSIGN {
        pilot op_w = name_w
        pilot rhs_w: word = array_get(ast_stmt_bodies, i)
        emit_expr(expr_id_w)
        emit(" " + op_w + " ")
        emit_expr(rhs_w)
        emit_line(";")
        give back
    }
    if kind == STMT_SHAPE {
        emit_line("/* shape " + name_w + " */")
        give back
    }
    if kind == STMT_BREAK { emit_line("break;") give back }
    if kind == STMT_CONTINUE { emit_line("continue;") give back }
    if kind == STMT_EVENTUALLY {
        emit_line("/* eventually */")
        pilot ev_body_w: word = array_get(ast_stmt_bodies, i)
        if ev_body_w.length() > 0 { emit_block(ev_body_w) }
        give back
    }
}

task emit_stmt_pilot(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot e_idx = word_to_int(expr_id_w)
    pilot e_kind: word = array_get(ast_expr_kinds, e_idx)
    pilot type_ann_w: word = array_get(ast_stmt_extras, i)
    pilot ctype = "int64_t "
    pilot vtype = "i"
    if type_ann_w == "word" { ctype = "freak_word " vtype = "w" }
    if type_ann_w == "bool" { ctype = "bool " vtype = "b" }
    if type_ann_w == "num" { ctype = "double " vtype = "d" }
    if type_ann_w == "int" { ctype = "int64_t " vtype = "i" }
    if type_ann_w == "" {
        if is_ast_word(expr_id_w) { ctype = "freak_word " vtype = "w" }
        if e_kind == EXPR_BOOL { ctype = "bool " vtype = "b" }
        if e_kind == EXPR_FLOAT { ctype = "double " vtype = "d" }
    }
    emt_set_var_type(name_w, vtype)
    emit(ctype + name_w + " = ")
    emit_expr(expr_id_w)
    emit_line(";")
}

task emit_stmt_when(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot target_id_w: word = array_get(ast_stmt_exprs, i)
    pilot cases_str: word = array_get(ast_stmt_bodies, i)

    emit("{ int64_t __target = ")
    emit_expr(target_id_w)
    emit_line(";")

    pilot cases_len = cases_str.length()
    pilot ci = 0
    pilot cur_case = ""
    pilot is_first = true
    pilot case_fin = false

    repeat until case_fin {
        pilot cc = cases_str.char_at(ci)
        if cc == "," or ci >= cases_len {
            if cur_case != "" {
                pilot c_expr = ""
                pilot c_stmt = ""
                pilot in_expr = true
                pilot c_len = cur_case.length()
                pilot cj = 0
                repeat c_len times {
                    pilot p = cur_case.char_at(cj)
                    if p == ":" { in_expr = false }
                    else {
                        if in_expr { c_expr = c_expr + p }
                        else { c_stmt = c_stmt + p }
                    }
                    cj += 1
                }
                if c_expr == "-1" {
                    if not is_first { emit("else ") }
                    emit_line("{")
                    emit_stmt(c_stmt)
                    emit_line("}")
                } else {
                    if not is_first { emit("else ") }
                    emit("if (__target == ")
                    emit_expr(c_expr)
                    emit_line(") {")
                    emit_stmt(c_stmt)
                    emit_line("}")
                }
                is_first = false
            }
            cur_case = ""
            if ci >= cases_len { case_fin = true }
        } else {
            cur_case = cur_case + cc
        }
        ci += 1
    }
    emit_line("}")
}

-- ===================== TASK + GLOBAL EMIT ============================

task translate_params(p: word) -> word {
    pilot res = ""
    pilot cur_name = ""
    pilot cur_type = ""
    pilot in_type = false
    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" {
            in_type = true
        } else if c == "," {
            pilot ctype = "int64_t"
            if cur_type == "word" { ctype = "freak_word" }
            if cur_type == "bool" { ctype = "bool" }
            if cur_type == "num" { ctype = "double" }
            if res != "" { res = res + ", " }
            res = res + ctype + " " + cur_name
            cur_name = ""
            cur_type = ""
            in_type = false
        } else {
            if in_type { cur_type = cur_type + c }
            else { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name != "" {
        pilot ctype = "int64_t"
        if cur_type == "word" { ctype = "freak_word" }
        if cur_type == "bool" { ctype = "bool" }
        if cur_type == "num" { ctype = "double" }
        if res != "" { res = res + ", " }
        res = res + ctype + " " + cur_name
    }
    give back res
}

task c_ret_type(returns_w: word) -> word {
    if returns_w == "int" { give back "int64_t" }
    if returns_w == "word" { give back "freak_word" }
    if returns_w == "bool" { give back "bool" }
    if returns_w == "num" { give back "double" }
    give back "void"
}

task emit_task(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot body_id_w: word = array_get(ast_stmt_bodies, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)

    pilot c_ret = c_ret_type(returns_w)
    pilot c_params = "void"
    if params_w != "" {
        c_params = translate_params(params_w)
        register_param_types(params_w)
    }

    emit(c_ret + " freak_" + name_w + "(" + c_params)
    emit_line(") {")
    emit_block(body_id_w)
    emit_line("}")
}

task register_param_types(params_w: word) -> void {
    pilot pi = 0
    pilot pslen = params_w.length()
    pilot pname = ""
    pilot ptype = ""
    pilot in_ptype = false
    repeat pslen times {
        pilot pc = params_w.char_at(pi)
        if pc == ":" { in_ptype = true }
        else if pc == "," {
            if ptype == "word" { emt_set_var_type(pname, "w") }
            else if ptype == "bool" { emt_set_var_type(pname, "b") }
            else if ptype == "num" { emt_set_var_type(pname, "d") }
            else { emt_set_var_type(pname, "i") }
            pname = ""
            ptype = ""
            in_ptype = false
        } else {
            if in_ptype { ptype = ptype + pc }
            else { pname = pname + pc }
        }
        pi += 1
    }
    if pname != "" {
        if ptype == "word" { emt_set_var_type(pname, "w") }
        else if ptype == "bool" { emt_set_var_type(pname, "b") }
        else if ptype == "num" { emt_set_var_type(pname, "d") }
        else { emt_set_var_type(pname, "i") }
    }
}

task emit_global_decl(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot e_idx = word_to_int(expr_id_w)
    pilot e_kind: word = array_get(ast_expr_kinds, e_idx)
    pilot type_ann_w: word = array_get(ast_stmt_extras, i)
    pilot ctype = "int64_t "
    pilot defval = " = 0"
    pilot vtype = "i"
    if type_ann_w == "word" { ctype = "freak_word " defval = " = FREAK_WORD_EMPTY" vtype = "w" }
    if type_ann_w == "bool" { ctype = "bool " defval = " = false" vtype = "b" }
    if type_ann_w == "num" { ctype = "double " defval = " = 0.0" vtype = "d" }
    if type_ann_w == "" {
        if is_ast_word(expr_id_w) { ctype = "freak_word " defval = " = FREAK_WORD_EMPTY" vtype = "w" }
        if e_kind == EXPR_BOOL { ctype = "bool " defval = " = false" vtype = "b" }
        if e_kind == EXPR_FLOAT { ctype = "double " defval = " = 0.0" vtype = "d" }
    }
    emt_set_var_type(name_w, vtype)
    emit(ctype + name_w + defval)
    emit_line(";")
}

task emit_global_init(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    emit(name_w + " = ")
    emit_expr(expr_id_w)
    emit_line(";")
}

task emit_fwd_decl(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    if returns_w == "word" { emt_register_word_task(name_w) }
    pilot c_ret = c_ret_type(returns_w)
    pilot c_params = "void"
    if params_w != "" { c_params = translate_params(params_w) }
    emit(c_ret + " freak_" + name_w + "(" + c_params)
    emit_line(");")
}

task emit_extern_decl(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)
    emt_register_extern(name_w, returns_w)
    pilot c_ret = c_ret_type(returns_w)
    pilot c_params = "void"
    if params_w != "" { c_params = translate_params(params_w) }
    emit("extern " + c_ret + " " + name_w + "(" + c_params)
    emit_line(");")
}

-- ===================== PROGRAM EMIT ==================================

task emit_c_program() -> void {
    emit_line("#include \"freak_runtime.h\"")

    pilot top_count = array_len(ast_top_stmts)
    pilot i = 0

    -- Pass 0: Forward declarations + extern declarations
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { emit_fwd_decl(cur_id) }
        if kind == STMT_EXTERN { emit_extern_decl(cur_id) }
        i += 1
    }

    -- Pass 1: Global variable declarations
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_PILOT { emit_global_decl(cur_id) }
        i += 1
    }

    -- Pass 2: Task definitions
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { emit_task(cur_id) }
        i += 1
    }

    -- Detect user-defined main
    pilot has_user_main = false
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" { has_user_main = true }
        }
        i += 1
    }

    -- Pass 3: Global init + main wrapper
    if has_user_main {
        emit_line("void freak_init_globals(void) {")
    }
    if not has_user_main {
        emit_line("void freak_main(void) {")
    }

    -- Initialize globals
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_PILOT { emit_global_init(cur_id) }
        i += 1
    }

    -- Top-level statements
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind != STMT_TASK and kind != STMT_SHAPE and kind != STMT_PILOT and kind != STMT_EXTERN {
            emit_stmt(cur_id)
        }
        i += 1
    }
    emit_line("}")

    -- C main entry point
    emit_line("int main(int argc, char** argv) {")
    emit_line("    freak_argc = argc;")
    emit_line("    freak_argv = argv;")
    if has_user_main {
        emit_line("    freak_init_globals();")
        emit_line("    freak_main();")
    }
    if not has_user_main {
        emit_line("    freak_main();")
    }
    emit_line("    return 0;")
    emit_line("}")
}
-- ===================================================================
-- FREAK v3 COMPILER — LLVM IR BACKEND EMITTER
-- ===================================================================
-- v3 KEY CHANGES:
-- 1. Streaming emit via fs::append (no buffer, no flush, no O(n^2))
-- 2. Flat if + early return for call mapping (never truncated)
-- 3. Proper freak_init_globals emitted (no Python post-processing)
-- 4. Split into modular tasks (each <100 lines)

-- ===================== LLVM EMIT HELPERS =============================

task llvm_emit(s: word) -> void {
    fs::append(out_file, s)
}

task llvm_emit_line(s: word) -> void {
    fs::append(out_file, s + "\n")
}

task next_reg() -> word {
    pilot r = "%t" + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    give back r
}

task llvm_escape_str(s: word) -> word {
    pilot esc_out = ""
    pilot esc_len = s.length()
    pilot esc_i = 0
    repeat until esc_i >= esc_len {
        pilot ch = s.char_at(esc_i)
        if ch == "\\" and esc_i + 3 < esc_len {
            pilot nx = s.char_at(esc_i + 1)
            if nx == "x" {
                -- \xNN hex escape from lexer -> LLVM IR \NN
                pilot h1 = s.char_at(esc_i + 2)
                pilot h2 = s.char_at(esc_i + 3)
                esc_out = esc_out + "\\" + h1 + h2
                esc_i += 4
            } else {
                esc_out = esc_out + "\\5C"
                esc_i += 1
            }
        } else if ch == "\"" { esc_out = esc_out + "\\22" esc_i += 1 }
        else if ch == "\\" { esc_out = esc_out + "\\5C" esc_i += 1 }
        else if ch == "\n" { esc_out = esc_out + "\\0A" esc_i += 1 }
        else if ch == "\r" { esc_out = esc_out + "\\0D" esc_i += 1 }
        else if ch == "\t" { esc_out = esc_out + "\\09" esc_i += 1 }
        else { esc_out = esc_out + ch esc_i += 1 }
    }
    give back esc_out
}

task register_string_literal(val: word) -> word {
    pilot id = "@.str." + word_from_int(string_literals_count)
    string_literals_count += 1
    pilot real_val = val.replace("<<PIPE>>", "|")
    -- Calculate actual byte length (\xNN is 4 source chars but 1 byte)
    pilot len = real_val.length()
    pilot adj_i = 0
    repeat until adj_i >= len {
        pilot adj_ch = real_val.char_at(adj_i)
        if adj_ch == "\\" and adj_i + 3 < len {
            pilot adj_nx = real_val.char_at(adj_i + 1)
            if adj_nx == "x" {
                len -= 3
                adj_i += 4
            } else { adj_i += 1 }
        } else { adj_i += 1 }
    }
    pilot null_term_len = len + 1
    pilot escaped = llvm_escape_str(real_val)
    pilot decl = id + " = private unnamed_addr constant [" + word_from_int(null_term_len) + " x i8] c\"" + escaped + "\\00\", align 1\n"
    string_literals = string_literals + decl
    give back id
}

task llvm_c_safe_ident(s: word) -> word {
    pilot res = ""
    pilot slen = s.length()
    pilot i = 0
    repeat slen times {
        pilot c = s.char_at(i)
        if c == ":" {
            if i + 1 < slen {
                if s.char_at(i + 1) == ":" {
                    res = res + "_"
                    i += 1
                } else { res = res + c }
            } else { res = res + c }
        } else { res = res + c }
        i += 1
    }
    give back res
}

-- ===================== TYPE TRACKING =================================

task llvm_set_var_type(name: word, vtype: word) -> void {
    llvm_var_names = llvm_var_names + name + "|"
    llvm_var_types = llvm_var_types + vtype + "|"
}

task llvm_get_var_type(name: word) -> word {
    pilot nlen = llvm_var_names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    repeat until i >= nlen {
        pilot c = llvm_var_names.char_at(i)
        if c == "|" {
            if cur_name == name {
                pilot ti = 0
                pilot cur_type = ""
                pilot tidx = 0
                pilot tlen = llvm_var_types.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_var_types.char_at(ti)
                    if tc == "|" {
                        if tidx == idx { give back cur_type }
                        tidx += 1
                        cur_type = ""
                    } else { cur_type = cur_type + tc }
                    ti += 1
                }
            }
            idx += 1
            cur_name = ""
        } else { cur_name = cur_name + c }
        i += 1
    }
    give back "i"
}

task llvm_register_task(name: word, ret_type: word) -> void {
    pilot t = "i"
    if ret_type == "word" { t = "w" }
    if ret_type == "bool" { t = "b" }
    if ret_type == "num" { t = "n" }
    if ret_type == "int" { t = "i" }
    if ret_type == "void" { t = "v" }
    llvm_task_reg_names = llvm_task_reg_names + name + "|"
    llvm_task_reg_types = llvm_task_reg_types + t + "|"
    llvm_task_reg_count += 1
}

task llvm_get_task_ret_type(name: word) -> word {
    pilot nlen = llvm_task_reg_names.length()
    pilot i = 0
    pilot cur_name = ""
    pilot idx = 0
    repeat until i >= nlen {
        pilot c = llvm_task_reg_names.char_at(i)
        if c == "|" {
            if cur_name == name {
                pilot ti = 0
                pilot cur_type = ""
                pilot tidx = 0
                pilot tlen = llvm_task_reg_types.length()
                repeat until ti >= tlen {
                    pilot tc = llvm_task_reg_types.char_at(ti)
                    if tc == "|" {
                        if tidx == idx { give back cur_type }
                        tidx += 1
                        cur_type = ""
                    } else { cur_type = cur_type + tc }
                    ti += 1
                }
            }
            idx += 1
            cur_name = ""
        } else { cur_name = cur_name + c }
        i += 1
    }
    give back ""
}

task llvm_is_global(vname: word) -> bool {
    pilot needle = "|" + vname + "|"
    give back llvm_global_names.contains(needle)
}

-- Register a FREAK→LLVM name binding (latest entry wins on lookup)
task llvm_reg_var(freak_name: word, llvm_name: word) -> void {
    llvm_var_reg_map = llvm_var_reg_map + freak_name + ":" + llvm_name + "|"
}

-- Look up the latest LLVM name for a FREAK variable name (scan from end)
-- Format: "freak_name:llvm_name|freak_name2:llvm_name2|..."
task llvm_get_llvm_name(freak_name: word) -> word {
    pilot mlen = llvm_var_reg_map.length()
    pilot i = mlen - 1
    pilot cur_llvm = ""
    pilot cur_freak = ""
    pilot in_llvm = true
    repeat until i < 0 {
        pilot ch = llvm_var_reg_map.char_at(i)
        if ch == "|" {
            -- End of an entry: check the accumulated freak name
            if cur_freak == freak_name and cur_llvm.length() > 0 { give back cur_llvm }
            cur_llvm = ""
            cur_freak = ""
            in_llvm = true
        } else if ch == ":" {
            in_llvm = false
        } else if in_llvm {
            cur_llvm = ch + cur_llvm
        } else {
            cur_freak = ch + cur_freak
        }
        i -= 1
    }
    -- Check the first entry (no leading |)
    if cur_freak == freak_name and cur_llvm.length() > 0 { give back cur_llvm }
    give back ""
}

task llvm_var_ptr(vname: word) -> word {
    if llvm_is_global(vname) { give back "@g_" + vname }
    pilot unique = llvm_get_llvm_name(vname)
    if unique != "" { give back "%" + unique }
    give back "%" + vname
}

task llvm_is_runtime_func(fname: word) -> bool {
    pilot needle = "|" + fname + "|"
    give back llvm_declared_funcs.contains(needle)
}

-- ===================== TYPE INFERENCE ================================

task llvm_infer_expr_type(expr_id: word) -> word {
    if expr_id.length() == 0 { give back "i" }
    pilot i = word_to_int(expr_id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)

    if kind == EXPR_STR { give back "w" }
    if kind == EXPR_INT { give back "i" }
    if kind == EXPR_FLOAT { give back "n" }
    if kind == EXPR_BOOL { give back "b" }
    if kind == EXPR_IDENT { give back llvm_get_var_type(val) }

    if kind == EXPR_METHOD {
        if val == "trim" or val == "to_upper" or val == "to_lower" or val == "replace" or val == "char_at" { give back "w" }
        if val == "length" or val == "to_int" or val == "contains" or val == "starts_with" or val == "ends_with" { give back "i" }
        pilot mi = 0
        repeat shape_registry_count times {
            pilot msname: word = "" + array_get(shape_registry_names, mi)
            pilot impl_ret: word = llvm_get_task_ret_type(msname + "_" + val)
            if impl_ret.length() > 0 { give back impl_ret }
            mi += 1
        }
    }

    if kind == EXPR_FIELD {
        give back llvm_infer_field_type(val)
    }

    if kind == EXPR_BINOP {
        pilot left: word = array_get(ast_expr_lefts, i)
        pilot right: word = array_get(ast_expr_rights, i)
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        if val == "+" {
            if lt.starts_with("w") or rt.starts_with("w") { give back "w" }
        }
        if lt.starts_with("n") or rt.starts_with("n") {
            if val == "+" or val == "-" or val == "*" or val == "/" or val == "%" { give back "n" }
        }
    }

    if kind == EXPR_CALL {
        give back llvm_infer_call_type(val)
    }

    give back "i"
}

task llvm_infer_field_type(field_name: word) -> word {
    pilot fi = 0
    repeat shape_registry_count times {
        pilot fields: word = "" + array_get(shape_registry_fields, fi)
        pilot flen = fields.length()
        pilot fj = 0
        pilot fname = ""
        pilot ftype = ""
        pilot in_ftype = false
        repeat flen times {
            pilot ftc: word = "" + fields.char_at(fj)
            if ftc == "," {
                if fname == field_name {
                    if ftype == "num" or ftype == "float" { give back "n" }
                    if ftype == "word" { give back "w" }
                    if ftype == "bool" { give back "b" }
                    give back "i"
                }
                fname = ""
                ftype = ""
                in_ftype = false
            } else if ftc == ":" { in_ftype = true }
            else {
                if in_ftype { ftype = ftype + ftc }
                else { fname = fname + ftc }
            }
            fj += 1
        }
        if fname == field_name {
            if ftype == "num" or ftype == "float" { give back "n" }
            if ftype == "word" { give back "w" }
            if ftype == "bool" { give back "b" }
            give back "i"
        }
        fi += 1
    }
    give back "i"
}

task llvm_infer_call_type(val: word) -> word {
    if val == "fs::read" or val == "fs::list_dir" or val == "process::arg" { give back "w" }
    if val == "process::exec_capture" or val == "ask" { give back "w" }
    if val == "word_from_int" or val == "word_from_bool" or val == "word_concat" or val == "format_num" { give back "w" }
    if val == "array_get" { give back "w" }
    if val == "array_new" or val == "array_len" { give back "i" }
    if val.starts_with("shape::ctor::") { give back "i" }
    pilot task_ret = llvm_get_task_ret_type(val)
    if task_ret.length() > 0 { give back task_ret }
    give back "i"
}

-- ===================== NUM HELPERS ===================================

task llvm_i64_to_double(i64_reg: word) -> word {
    pilot dbl = next_reg()
    llvm_emit_line("    " + dbl + " = bitcast i64 " + i64_reg + " to double")
    give back dbl
}

task llvm_double_to_i64(dbl_reg: word) -> word {
    pilot i64r = next_reg()
    llvm_emit_line("    " + i64r + " = bitcast double " + dbl_reg + " to i64")
    give back i64r
}

task llvm_is_num_expr(expr_id: word) -> bool {
    pilot t = llvm_infer_expr_type(expr_id)
    if t.starts_with("n") { give back true }
    give back false
}

-- ===================== CALL MAPPING (FLAT) ============================
-- v3 KEY CHANGE: flat if + early return. Never truncated.

task llvm_map_call_name(val: word) -> word {
    if val == "say" { give back "@freak_llvm_say" }
    if val == "ask" { give back "@freak_llvm_ask" }
    if val == "word_from_int" { give back "@freak_llvm_word_from_int" }
    if val == "word_from_bool" { give back "@freak_llvm_word_from_bool" }
    if val == "word_to_int" { give back "@freak_llvm_word_to_int" }
    if val == "fs::read" { give back "@freak_llvm_fs_read" }
    if val == "fs::write" { give back "@freak_llvm_fs_write" }
    if val == "fs::append" { give back "@freak_llvm_fs_append" }
    if val == "fs::exists" { give back "@freak_llvm_fs_exists" }
    if val == "fs::delete" { give back "@freak_llvm_fs_delete" }
    if val == "process::args_count" { give back "@freak_llvm_process_args_count" }
    if val == "process::arg" { give back "@freak_llvm_process_arg" }
    if val == "process::exit" { give back "@freak_llvm_process_exit" }
    if val == "process::exec" { give back "@freak_llvm_process_exec" }
    if val == "process::exec_capture" { give back "@freak_llvm_process_exec_capture" }
    if val == "panic" { give back "@freak_llvm_panic" }
    if val == "array_new" { give back "@freak_llvm_array_new" }
    if val == "array_push" { give back "@freak_llvm_array_push" }
    if val == "array_get" { give back "@freak_llvm_array_get" }
    if val == "array_set" { give back "@freak_llvm_array_set" }
    if val == "array_len" { give back "@freak_llvm_array_len" }
    if val == "ui::create_window" { give back "@freak_llvm_ui_create_window" }
    if val == "ui::destroy_window" { give back "@freak_llvm_ui_destroy_window" }
    if val == "ui::poll_events" { give back "@freak_llvm_ui_poll_events" }
    if val == "ui::begin_frame" { give back "@freak_llvm_ui_begin_frame" }
    if val == "ui::end_frame" { give back "@freak_llvm_ui_end_frame" }
    if val == "ui::event_kind" { give back "@freak_llvm_ui_event_kind" }
    if val == "ui::event_key" { give back "@freak_llvm_ui_event_key" }
    if val == "ui::event_pressed" { give back "@freak_llvm_ui_event_pressed" }
    if val == "ui::event_character" { give back "@freak_llvm_ui_event_character" }
    if val == "ui::event_mouse_x" { give back "@freak_llvm_ui_event_mouse_x" }
    if val == "ui::event_mouse_y" { give back "@freak_llvm_ui_event_mouse_y" }
    if val == "ui::event_button" { give back "@freak_llvm_ui_event_button" }
    if val == "ui::clear" { give back "@freak_llvm_ui_clear" }
    if val == "ui::fill_rect" { give back "@freak_llvm_ui_fill_rect" }
    if val == "ui::stroke_rect" { give back "@freak_llvm_ui_stroke_rect" }
    if val == "ui::fill_circle" { give back "@freak_llvm_ui_fill_circle" }
    if val == "ui::draw_line" { give back "@freak_llvm_ui_draw_line" }
    if val == "ui::draw_text" { give back "@freak_llvm_ui_draw_text" }
    if val == "ui::measure_text" { give back "@freak_llvm_ui_measure_text" }
    if val == "math::sqrt" { give back "@freak_llvm_math_sqrt" }
    if val == "math::pow" { give back "@freak_llvm_math_pow" }
    if val == "math::sin" { give back "@freak_llvm_math_sin" }
    if val == "math::cos" { give back "@freak_llvm_math_cos" }
    if val == "math::tan" { give back "@freak_llvm_math_tan" }
    if val == "math::floor" { give back "@freak_llvm_math_floor" }
    if val == "math::ceil" { give back "@freak_llvm_math_ceil" }
    if val == "parse_num" { give back "@freak_llvm_parse_num" }
    if val == "format_num" { give back "@freak_llvm_format_num" }
    if val == "shape::alloc" { give back "@freak_llvm_shape_alloc" }
    if val == "shape::get" { give back "@freak_llvm_shape_get" }
    if val == "shape::set" { give back "@freak_llvm_shape_set" }
    if val == "tcp::connect" or val == "tcp_connect" { give back "@freak_llvm_tcp_connect" }
    if val == "tcp::send" or val == "tcp_send" { give back "@freak_llvm_tcp_send" }
    if val == "tcp::recv" or val == "tcp_recv" { give back "@freak_llvm_tcp_recv" }
    if val == "tcp::recv_all" or val == "tcp_recv_all" { give back "@freak_llvm_tcp_recv_all" }
    if val == "tcp::close" or val == "tcp_close" { give back "@freak_llvm_tcp_close" }
    give back ""
}

task llvm_is_void_call(val: word) -> bool {
    if val == "say" or val == "panic" { give back true }
    if val == "fs::write" or val == "fs::append" or val == "fs::delete" { give back true }
    if val == "process::exit" { give back true }
    if val == "array_push" or val == "array_set" { give back true }
    if val == "shape::set" { give back true }
    if val == "tcp::close" or val == "tcp_close" { give back true }
    if val == "ui::destroy_window" or val == "ui::begin_frame" or val == "ui::end_frame" { give back true }
    if val == "ui::clear" or val == "ui::fill_rect" or val == "ui::stroke_rect" { give back true }
    if val == "ui::fill_circle" or val == "ui::draw_line" { give back true }
    give back false
}

-- ===================== ARGS ==========================================

task llvm_emit_args(args: word) -> word {
    pilot res = ""
    pilot i = 0
    pilot slen = args.length()
    pilot cur_id = ""
    pilot first = true
    repeat slen times {
        pilot c = args.char_at(i)
        if c == "," {
            pilot reg: word = llvm_emit_expr(cur_id)
            if not first { res = res + ", " }
            res = res + "i64 " + reg
            cur_id = ""
            first = false
        } else {
            cur_id = cur_id + c
        }
        i += 1
    }
    if cur_id.length() > 0 {
        pilot reg: word = llvm_emit_expr(cur_id)
        if not first { res = res + ", " }
        res = res + "i64 " + reg
    }
    give back res
}

-- ===================== EXPRESSION EMIT ===============================

task llvm_emit_expr(id: word) -> word {
    pilot i = word_to_int(id)
    pilot kind: word = array_get(ast_expr_kinds, i)
    pilot val: word = array_get(ast_expr_vals, i)
    pilot left: word = array_get(ast_expr_lefts, i)
    pilot right: word = array_get(ast_expr_rights, i)

    if kind == EXPR_INT { give back val }
    if kind == EXPR_BOOL {
        if val == "true" or val == "yes" or val == "hai" { give back "1" }
        give back "0"
    }
    if kind == EXPR_FLOAT {
        pilot dbl_reg = next_reg()
        pilot cast_reg = next_reg()
        llvm_emit_line("    " + dbl_reg + " = fadd double 0.0, " + val)
        llvm_emit_line("    " + cast_reg + " = bitcast double " + dbl_reg + " to i64")
        give back cast_reg
    }
    if kind == EXPR_STR {
        pilot str_id = register_string_literal(val)
        pilot len = val.replace("<<PIPE>>", "|").length() + 1
        pilot get_ptr = next_reg()
        llvm_emit_line("    " + get_ptr + " = getelementptr inbounds [" + word_from_int(len) + " x i8], [" + word_from_int(len) + " x i8]* " + str_id + ", i64 0, i64 0")
        pilot cast_reg = next_reg()
        llvm_emit_line("    " + cast_reg + " = ptrtoint i8* " + get_ptr + " to i64")
        give back cast_reg
    }
    if kind == EXPR_IDENT {
        pilot res_reg = next_reg()
        llvm_emit_line("    " + res_reg + " = load i64, i64* " + llvm_var_ptr(val))
        give back res_reg
    }
    if kind == EXPR_CALL { give back llvm_emit_call(val, left) }
    if kind == EXPR_BINOP { give back llvm_emit_binop(val, left, right, id) }
    if kind == EXPR_UNARYOP { give back llvm_emit_unaryop(val, left) }
    if kind == EXPR_METHOD { give back llvm_emit_method(val, left, right) }
    if kind == EXPR_FIELD { give back llvm_emit_field(val, left) }
    if kind == EXPR_INDEX {
        pilot obj_reg = llvm_emit_expr(left)
        pilot idx_reg = llvm_emit_expr(right)
        pilot res_reg = next_reg()
        pilot ptr_reg = next_reg()
        llvm_emit_line("    " + ptr_reg + " = inttoptr i64 " + obj_reg + " to i8*")
        pilot gep_reg = next_reg()
        llvm_emit_line("    " + gep_reg + " = getelementptr inbounds i8, i8* " + ptr_reg + ", i64 " + idx_reg)
        pilot char_reg = next_reg()
        llvm_emit_line("    " + char_reg + " = load i8, i8* " + gep_reg)
        llvm_emit_line("    " + res_reg + " = zext i8 " + char_reg + " to i64")
        give back res_reg
    }
    give back "0"
}

-- ===================== CALL EMIT =====================================

task llvm_emit_call(val: word, left: word) -> word {
    pilot arg_str = ""
    if left.length() > 0 { arg_str = llvm_emit_args(left) }

    -- Shape constructor
    if val.starts_with("shape::ctor::") {
        give back llvm_emit_shape_ctor(val, left)
    }

    -- Map to LLVM function name
    pilot func_name = llvm_map_call_name(val)
    if func_name == "" {
        if emt_is_extern(val) {
            func_name = "@" + llvm_c_safe_ident(val)
        } else {
            func_name = "@freak_" + llvm_c_safe_ident(val)
        }
    }

    -- Check if void
    pilot is_void = llvm_is_void_call(val)
    if not is_void {
        pilot call_ret: word = llvm_get_task_ret_type(val)
        if call_ret == "v" { is_void = true }
    }

    if is_void {
        llvm_emit_line("    call void " + func_name + "(" + arg_str + ")")
        give back "0"
    }
    pilot res_reg = next_reg()
    llvm_emit_line("    " + res_reg + " = call i64 " + func_name + "(" + arg_str + ")")
    give back res_reg
}

task llvm_emit_shape_ctor(val: word, left: word) -> word {
    pilot sname = ""
    pilot vi = 13
    pilot vlen = val.length()
    repeat vlen times {
        if vi < vlen { sname = sname + val.char_at(vi) }
        vi += 1
    }
    pilot fcount = get_shape_field_count(sname)
    pilot alloc_reg = next_reg()
    llvm_emit_line("    " + alloc_reg + " = call i64 @freak_llvm_shape_alloc(i64 " + word_from_int(fcount) + ")")
    if left.length() > 0 {
        pilot fi = 0
        pilot ci = 0
        pilot cslen = left.length()
        pilot cur = ""
        repeat cslen times {
            pilot cc = left.char_at(ci)
            if cc == "," {
                if cur.length() > 0 {
                    pilot fval_reg = llvm_emit_expr(cur)
                    llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + alloc_reg + ", i64 " + word_from_int(fi) + ", i64 " + fval_reg + ")")
                    fi += 1
                }
                cur = ""
            } else { cur = cur + cc }
            ci += 1
        }
        if cur.length() > 0 {
            pilot fval_reg = llvm_emit_expr(cur)
            llvm_emit_line("    call void @freak_llvm_shape_set(i64 " + alloc_reg + ", i64 " + word_from_int(fi) + ", i64 " + fval_reg + ")")
        }
    }
    give back alloc_reg
}

-- ===================== BINOP EMIT ====================================

task llvm_emit_binop(val: word, left: word, right: word, id: word) -> word {
    pilot l_reg = llvm_emit_expr(left)
    pilot r_reg = llvm_emit_expr(right)
    pilot res_reg = next_reg()
    pilot is_num_op = llvm_is_num_expr(left) or llvm_is_num_expr(right)

    if val == "+" { give back llvm_emit_add(l_reg, r_reg, res_reg, left, right, id, is_num_op) }
    if val == "-" { give back llvm_emit_arith(l_reg, r_reg, res_reg, is_num_op, "sub", "fsub") }
    if val == "*" { give back llvm_emit_arith(l_reg, r_reg, res_reg, is_num_op, "mul", "fmul") }
    if val == "/" { give back llvm_emit_arith(l_reg, r_reg, res_reg, is_num_op, "sdiv", "fdiv") }
    if val == "%" { give back llvm_emit_arith(l_reg, r_reg, res_reg, is_num_op, "srem", "frem") }
    if val == "==" { give back llvm_emit_cmp(l_reg, r_reg, res_reg, left, is_num_op, "eq", "oeq") }
    if val == "!=" { give back llvm_emit_cmp(l_reg, r_reg, res_reg, left, is_num_op, "ne", "une") }
    if val == "<" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, is_num_op, "slt", "olt") }
    if val == ">" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, is_num_op, "sgt", "ogt") }
    if val == "<=" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, is_num_op, "sle", "ole") }
    if val == ">=" { give back llvm_emit_icmp(l_reg, r_reg, res_reg, is_num_op, "sge", "oge") }
    if val == "and" {
        pilot cmp_l = next_reg()
        llvm_emit_line("    " + cmp_l + " = icmp ne i64 " + l_reg + ", 0")
        pilot cmp_r = next_reg()
        llvm_emit_line("    " + cmp_r + " = icmp ne i64 " + r_reg + ", 0")
        pilot and_res = next_reg()
        llvm_emit_line("    " + and_res + " = and i1 " + cmp_l + ", " + cmp_r)
        llvm_emit_line("    " + res_reg + " = zext i1 " + and_res + " to i64")
        give back res_reg
    }
    if val == "or" {
        pilot cmp_l = next_reg()
        llvm_emit_line("    " + cmp_l + " = icmp ne i64 " + l_reg + ", 0")
        pilot cmp_r = next_reg()
        llvm_emit_line("    " + cmp_r + " = icmp ne i64 " + r_reg + ", 0")
        pilot or_res = next_reg()
        llvm_emit_line("    " + or_res + " = or i1 " + cmp_l + ", " + cmp_r)
        llvm_emit_line("    " + res_reg + " = zext i1 " + or_res + " to i64")
        give back res_reg
    }
    if val == "NAKAMA" {
        pilot t1 = next_reg()
        llvm_emit_line("    " + t1 + " = add i64 " + l_reg + ", " + r_reg)
        pilot t2 = next_reg()
        llvm_emit_line("    " + t2 + " = mul i64 " + l_reg + ", " + r_reg)
        pilot t3 = next_reg()
        llvm_emit_line("    " + t3 + " = sdiv i64 " + t2 + ", 10")
        llvm_emit_line("    " + res_reg + " = add i64 " + t1 + ", " + t3)
        give back res_reg
    }
    give back res_reg
}

task llvm_emit_add(l_reg: word, r_reg: word, res_reg: word, left: word, right: word, id: word, is_num_op: bool) -> word {
    pilot vtype = llvm_infer_expr_type(id)
    if vtype.starts_with("w") {
        pilot lt: word = llvm_infer_expr_type(left)
        pilot rt: word = llvm_infer_expr_type(right)
        pilot lw = l_reg
        pilot rw = r_reg
        if not lt.starts_with("w") {
            lw = next_reg()
            llvm_emit_line("    " + lw + " = call i64 @freak_llvm_word_from_int(i64 " + l_reg + ")")
        }
        if not rt.starts_with("w") {
            rw = next_reg()
            llvm_emit_line("    " + rw + " = call i64 @freak_llvm_word_from_int(i64 " + r_reg + ")")
        }
        llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_concat(i64 " + lw + ", i64 " + rw + ")")
        give back res_reg
    }
    if is_num_op {
        pilot ld = llvm_i64_to_double(l_reg)
        pilot rd = llvm_i64_to_double(r_reg)
        pilot dres = next_reg()
        llvm_emit_line("    " + dres + " = fadd double " + ld + ", " + rd)
        llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
        give back res_reg
    }
    llvm_emit_line("    " + res_reg + " = add i64 " + l_reg + ", " + r_reg)
    give back res_reg
}

task llvm_emit_arith(l_reg: word, r_reg: word, res_reg: word, is_num_op: bool, int_op: word, float_op: word) -> word {
    if is_num_op {
        pilot ld = llvm_i64_to_double(l_reg)
        pilot rd = llvm_i64_to_double(r_reg)
        pilot dres = next_reg()
        llvm_emit_line("    " + dres + " = " + float_op + " double " + ld + ", " + rd)
        llvm_emit_line("    " + res_reg + " = bitcast double " + dres + " to i64")
        give back res_reg
    }
    llvm_emit_line("    " + res_reg + " = " + int_op + " i64 " + l_reg + ", " + r_reg)
    give back res_reg
}

task llvm_emit_cmp(l_reg: word, r_reg: word, res_reg: word, left: word, is_num_op: bool, int_cmp: word, float_cmp: word) -> word {
    pilot ltype = llvm_infer_expr_type(left)
    if ltype.starts_with("w") {
        if int_cmp == "eq" {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_eq(i64 " + l_reg + ", i64 " + r_reg + ")")
        } else {
            llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_neq(i64 " + l_reg + ", i64 " + r_reg + ")")
        }
        give back res_reg
    }
    give back llvm_emit_icmp(l_reg, r_reg, res_reg, is_num_op, int_cmp, float_cmp)
}

task llvm_emit_icmp(l_reg: word, r_reg: word, res_reg: word, is_num_op: bool, int_cmp: word, float_cmp: word) -> word {
    if is_num_op {
        pilot ld = llvm_i64_to_double(l_reg)
        pilot rd = llvm_i64_to_double(r_reg)
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = fcmp " + float_cmp + " double " + ld + ", " + rd)
        llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
        give back res_reg
    }
    pilot cmp_reg = next_reg()
    llvm_emit_line("    " + cmp_reg + " = icmp " + int_cmp + " i64 " + l_reg + ", " + r_reg)
    llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
    give back res_reg
}

-- ===================== UNARY EMIT ====================================

task llvm_emit_unaryop(val: word, left: word) -> word {
    pilot op_reg = llvm_emit_expr(left)
    pilot res_reg = next_reg()
    if val == "not" {
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + op_reg + ", 0")
        llvm_emit_line("    " + res_reg + " = zext i1 " + cmp_reg + " to i64")
    }
    if val == "-" { llvm_emit_line("    " + res_reg + " = sub i64 0, " + op_reg) }
    if val == "PLUS ULTRA" { llvm_emit_line("    " + res_reg + " = mul i64 " + op_reg + ", 2") }
    if val == "FINAL FORM" { llvm_emit_line("    " + res_reg + " = mul i64 " + op_reg + ", " + op_reg) }
    if val == "TSUNDERE" { llvm_emit_line("    " + res_reg + " = sub i64 0, " + op_reg) }
    give back res_reg
}

-- ===================== METHOD EMIT ===================================

task llvm_emit_method(val: word, left: word, right: word) -> word {
    pilot obj_reg = llvm_emit_expr(left)
    pilot res_reg = next_reg()
    if val == "length" { llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_length(i64 " + obj_reg + ")") give back res_reg }
    if val == "char_at" { pilot a = llvm_emit_expr(right) llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_char_at(i64 " + obj_reg + ", i64 " + a + ")") give back res_reg }
    if val == "contains" { pilot a = llvm_emit_expr(right) llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_contains(i64 " + obj_reg + ", i64 " + a + ")") give back res_reg }
    if val == "starts_with" { pilot a = llvm_emit_expr(right) llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_starts_with(i64 " + obj_reg + ", i64 " + a + ")") give back res_reg }
    if val == "ends_with" { pilot a = llvm_emit_expr(right) llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_ends_with(i64 " + obj_reg + ", i64 " + a + ")") give back res_reg }
    if val == "to_upper" { llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_to_upper(i64 " + obj_reg + ")") give back res_reg }
    if val == "to_lower" { llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_to_lower(i64 " + obj_reg + ")") give back res_reg }
    if val == "trim" { llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_trim(i64 " + obj_reg + ")") give back res_reg }
    if val == "replace" { pilot a = llvm_emit_expr(right) llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_replace(i64 " + obj_reg + ", i64 " + a + ", i64 0)") give back res_reg }
    if val == "to_int" { llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_word_to_int(i64 " + obj_reg + ")") give back res_reg }
    -- User-defined impl methods
    pilot si = 0
    repeat shape_registry_count times {
        pilot sname: word = "" + array_get(shape_registry_names, si)
        pilot call_ret: word = llvm_get_task_ret_type(sname + "_" + val)
        if call_ret.length() > 0 {
            pilot impl_fname = "freak_" + sname + "_" + val
            if call_ret == "v" {
                llvm_emit_line("    call void @" + impl_fname + "(i64 " + obj_reg + ")")
                llvm_emit_line("    " + res_reg + " = add i64 0, 0")
            } else {
                llvm_emit_line("    " + res_reg + " = call i64 @" + impl_fname + "(i64 " + obj_reg + ")")
            }
            give back res_reg
        }
        si += 1
    }
    llvm_emit_line("    ; unsupported method " + val)
    llvm_emit_line("    " + res_reg + " = add i64 0, 0")
    give back res_reg
}

-- ===================== FIELD EMIT ====================================

task llvm_emit_field(val: word, left: word) -> word {
    pilot obj_reg = llvm_emit_expr(left)
    pilot fidx = 0 - 1
    pilot si = 0
    repeat shape_registry_count times {
        pilot tmpidx = get_shape_field_index(array_get(shape_registry_names, si), val)
        if tmpidx >= 0 { fidx = tmpidx }
        si += 1
    }
    if fidx < 0 { fidx = 0 }
    pilot res_reg = next_reg()
    llvm_emit_line("    " + res_reg + " = call i64 @freak_llvm_shape_get(i64 " + obj_reg + ", i64 " + word_from_int(fidx) + ")")
    give back res_reg
}

-- ===================== BLOCK EMIT ====================================

task llvm_emit_block(block: word) -> void {
    pilot i = 0
    pilot slen = block.length()
    pilot cur_id = ""
    repeat slen times {
        pilot c = block.char_at(i)
        if c == "," {
            if cur_id.length() > 0 { llvm_emit_stmt(cur_id) }
            cur_id = ""
        } else { cur_id = cur_id + c }
        i += 1
    }
    if cur_id.length() > 0 { llvm_emit_stmt(cur_id) }
}

-- ===================== STATEMENT EMIT ================================

task llvm_emit_stmt(eid: word) -> void {
    if eid.length() == 0 { give back }
    pilot i = word_to_int(eid)
    pilot kind: word = array_get(ast_stmt_kinds, i)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    if kind == STMT_PILOT { llvm_emit_stmt_pilot(eid) give back }
    if kind == STMT_SAY {
        pilot say_kind: word = array_get(ast_expr_kinds, word_to_int(expr_id_w))
        pilot say_val: word = array_get(ast_expr_vals, word_to_int(expr_id_w))
        if say_kind == EXPR_STR and llvm_str_has_interp(say_val) {
            llvm_emit_say_interp(say_val)
        } else {
            pilot reg = llvm_emit_expr(expr_id_w)
            llvm_emit_line("    call void @freak_llvm_say(i64 " + reg + ")")
        }
        give back
    }
    if kind == STMT_EXPR { llvm_emit_expr(expr_id_w) give back }
    if kind == STMT_GIVE_BACK {
        if llvm_cur_func_is_void {
            llvm_emit_line("    ret void")
        } else if expr_id_w.length() > 0 and not expr_id_w.starts_with("-") {
            pilot reg = llvm_emit_expr(expr_id_w)
            llvm_emit_line("    ret i64 " + reg)
        } else {
            llvm_emit_line("    ret i64 0")
        }
        give back
    }
    if kind == STMT_IF { llvm_emit_stmt_if(eid) give back }
    if kind == STMT_REPEAT { llvm_emit_stmt_repeat(eid) give back }
    if kind == STMT_TRAINING_ARC { llvm_emit_stmt_training_arc(eid) give back }
    if kind == STMT_WHEN { llvm_emit_stmt_when(eid) give back }
    if kind == STMT_BLOCK { llvm_emit_block(array_get(ast_stmt_bodies, i)) give back }
    if kind == STMT_ASSIGN { llvm_emit_stmt_assign(eid) give back }
    if kind == STMT_BREAK {
        llvm_emit_line("    br label %" + llvm_loop_end_label)
        pilot dead = "break.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line(dead + ":")
        give back
    }
    if kind == STMT_CONTINUE {
        llvm_emit_line("    br label %" + llvm_loop_cond_label)
        pilot dead = "cont.dead." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_emit_line(dead + ":")
        give back
    }
    if kind == STMT_SHAPE {
        llvm_emit_line("    ; shape " + name_w + " defined")
        give back
    }
    if kind == STMT_EVENTUALLY {
        llvm_emit_line("    ; eventually block")
        pilot ev_body: word = array_get(ast_stmt_bodies, i)
        if ev_body.length() > 0 { llvm_emit_block(ev_body) }
        give back
    }
}

task llvm_emit_stmt_pilot(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot type_ann: word = array_get(ast_stmt_extras, i)
    pilot vtype = ""
    if type_ann == "word" { vtype = "w" }
    if type_ann == "num" { vtype = "n" }
    if type_ann == "bool" { vtype = "b" }
    if type_ann == "int" { vtype = "i" }
    if vtype == "" { vtype = llvm_infer_expr_type(expr_id_w) }
    llvm_set_var_type(name_w, vtype)
    pilot reg = llvm_emit_expr(expr_id_w)
    if llvm_is_global(name_w) {
        llvm_emit_line("    store i64 " + reg + ", i64* @g_" + name_w)
    } else {
        pilot uniq = name_w + "_v" + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_reg_var(name_w, uniq)
        llvm_emit_line("    %" + uniq + " = alloca i64")
        llvm_emit_line("    store i64 " + reg + ", i64* %" + uniq)
    }
}

task llvm_emit_stmt_if(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot cond_reg = llvm_emit_expr(expr_id_w)
    pilot l_then = "if.then." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_else = "if.else." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "if.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot cmp_reg = next_reg()
    llvm_emit_line("    " + cmp_reg + " = icmp ne i64 " + cond_reg + ", 0")

    pilot else_body_w: word = array_get(ast_stmt_else_bodies, i)
    if else_body_w.length() > 0 {
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_then + ", label %" + l_else)
    } else {
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_then + ", label %" + l_end)
    }

    llvm_emit_line(l_then + ":")
    llvm_emit_block(array_get(ast_stmt_bodies, i))
    llvm_emit_line("    br label %" + l_end)

    if else_body_w.length() > 0 {
        llvm_emit_line(l_else + ":")
        llvm_emit_block(else_body_w)
        llvm_emit_line("    br label %" + l_end)
    }
    llvm_emit_line(l_end + ":")
}

task llvm_emit_stmt_repeat(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot save_end = llvm_loop_end_label
    pilot save_cond = llvm_loop_cond_label
    llvm_loop_end_label = l_end

    if name_w == "until" {
        llvm_loop_cond_label = l_cond
        llvm_emit_line("    br label %" + l_cond)
        llvm_emit_line(l_cond + ":")
        pilot cond_reg = llvm_emit_expr(expr_id_w)
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp eq i64 " + cond_reg + ", 0")
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_body + ", label %" + l_end)
        llvm_emit_line(l_body + ":")
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        llvm_emit_line("    br label %" + l_cond)
    } else {
        pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        pilot rep_var = "rep." + word_from_int(temp_reg_counter)
        temp_reg_counter += 1
        llvm_loop_cond_label = l_inc

        pilot count_reg = llvm_emit_expr(expr_id_w)
        llvm_emit_line("    %" + rep_var + " = alloca i64")
        llvm_emit_line("    store i64 0, i64* %" + rep_var)
        llvm_emit_line("    br label %" + l_cond)
        llvm_emit_line(l_cond + ":")
        pilot curr_val = next_reg()
        llvm_emit_line("    " + curr_val + " = load i64, i64* %" + rep_var)
        pilot cmp_reg = next_reg()
        llvm_emit_line("    " + cmp_reg + " = icmp slt i64 " + curr_val + ", " + count_reg)
        llvm_emit_line("    br i1 " + cmp_reg + ", label %" + l_body + ", label %" + l_end)

        llvm_emit_line(l_body + ":")
        llvm_emit_block(array_get(ast_stmt_bodies, i))
        llvm_emit_line("    br label %" + l_inc)
        llvm_emit_line(l_inc + ":")
        pilot next_val = next_reg()
        llvm_emit_line("    " + next_val + " = load i64, i64* %" + rep_var)
        pilot inc_val = next_reg()
        llvm_emit_line("    " + inc_val + " = add i64 " + next_val + ", 1")
        llvm_emit_line("    store i64 " + inc_val + ", i64* %" + rep_var)
        llvm_emit_line("    br label %" + l_cond)
    }

    llvm_emit_line(l_end + ":")
    llvm_loop_end_label = save_end
    llvm_loop_cond_label = save_cond
}

task llvm_emit_stmt_training_arc(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)

    pilot l_cond = "loop.cond." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_body = "loop.body." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_end = "loop.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot l_inc = "loop.inc." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot rep_var = "rep." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1

    pilot max_reg = llvm_emit_expr(array_get(ast_stmt_extras, i))
    llvm_emit_line("    %" + rep_var + " = alloca i64")
    llvm_emit_line("    store i64 0, i64* %" + rep_var)
    llvm_emit_line("    br label %" + l_cond)

    llvm_emit_line(l_cond + ":")
    pilot curr_val = next_reg()
    llvm_emit_line("    " + curr_val + " = load i64, i64* %" + rep_var)
    pilot cmp_max = next_reg()
    llvm_emit_line("    " + cmp_max + " = icmp slt i64 " + curr_val + ", " + max_reg)
    pilot cond_reg = llvm_emit_expr(expr_id_w)
    pilot cmp_cond = next_reg()
    llvm_emit_line("    " + cmp_cond + " = icmp eq i64 " + cond_reg + ", 0")
    pilot loop_continue = next_reg()
    llvm_emit_line("    " + loop_continue + " = and i1 " + cmp_max + ", " + cmp_cond)
    llvm_emit_line("    br i1 " + loop_continue + ", label %" + l_body + ", label %" + l_end)

    pilot save_end = llvm_loop_end_label
    pilot save_cond = llvm_loop_cond_label
    llvm_loop_end_label = l_end
    llvm_loop_cond_label = l_inc

    llvm_emit_line(l_body + ":")
    llvm_emit_block(array_get(ast_stmt_bodies, i))

    llvm_emit_line("    br label %" + l_inc)
    llvm_emit_line(l_inc + ":")
    pilot next_val = next_reg()
    llvm_emit_line("    " + next_val + " = load i64, i64* %" + rep_var)
    pilot inc_val = next_reg()
    llvm_emit_line("    " + inc_val + " = add i64 " + next_val + ", 1")
    llvm_emit_line("    store i64 " + inc_val + ", i64* %" + rep_var)
    llvm_emit_line("    br label %" + l_cond)

    llvm_emit_line(l_end + ":")
    llvm_loop_end_label = save_end
    llvm_loop_cond_label = save_cond
}

task llvm_emit_stmt_assign(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot rhs_w: word = array_get(ast_stmt_bodies, i)
    pilot var_name_expr: word = array_get(ast_expr_vals, word_to_int(expr_id_w))
    pilot reg = llvm_emit_expr(rhs_w)
    pilot var_ptr = llvm_var_ptr(var_name_expr)
    if name_w == "=" {
        llvm_emit_line("    store i64 " + reg + ", i64* " + var_ptr)
        give back
    }
    pilot load_reg = next_reg()
    llvm_emit_line("    " + load_reg + " = load i64, i64* " + var_ptr)
    pilot op_reg = next_reg()
    if name_w == "+=" { llvm_emit_line("    " + op_reg + " = add i64 " + load_reg + ", " + reg) }
    if name_w == "-=" { llvm_emit_line("    " + op_reg + " = sub i64 " + load_reg + ", " + reg) }
    if name_w == "*=" { llvm_emit_line("    " + op_reg + " = mul i64 " + load_reg + ", " + reg) }
    if name_w == "/=" { llvm_emit_line("    " + op_reg + " = sdiv i64 " + load_reg + ", " + reg) }
    if name_w == "%=" { llvm_emit_line("    " + op_reg + " = srem i64 " + load_reg + ", " + reg) }
    llvm_emit_line("    store i64 " + op_reg + ", i64* " + var_ptr)
}

task llvm_emit_stmt_when(eid: word) -> void {
    pilot i = word_to_int(eid)
    pilot expr_id_w: word = array_get(ast_stmt_exprs, i)
    pilot target_reg = llvm_emit_expr(expr_id_w)
    pilot cases_str: word = array_get(ast_stmt_bodies, i)

    pilot l_end = "when.end." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    pilot current_block = "when.case." + word_from_int(temp_reg_counter)
    temp_reg_counter += 1
    llvm_emit_line("    br label %" + current_block)

    pilot cases_len = cases_str.length()
    pilot ci = 0
    pilot cur_case = ""
    pilot case_fin = false

    repeat until case_fin {
        pilot cc = cases_str.char_at(ci)
        if cc == "," or ci >= cases_len {
            if cur_case.length() > 0 {
                llvm_emit_line(current_block + ":")
                pilot c_expr = ""
                pilot c_stmt = ""
                pilot in_expr = true
                pilot c_len = cur_case.length()
                pilot cj = 0
                repeat c_len times {
                    pilot p = cur_case.char_at(cj)
                    if p == ":" { in_expr = false }
                    else {
                        if in_expr { c_expr = c_expr + p }
                        else { c_stmt = c_stmt + p }
                    }
                    cj += 1
                }
                pilot next_block = "when.case." + word_from_int(temp_reg_counter)
                temp_reg_counter += 1
                pilot do_block = "when.do." + word_from_int(temp_reg_counter)
                temp_reg_counter += 1

                if c_expr == "-1" {
                    llvm_emit_line("    br label %" + do_block)
                } else {
                    pilot cmp_val = llvm_emit_expr(c_expr)
                    pilot cmp_res = next_reg()
                    llvm_emit_line("    " + cmp_res + " = icmp eq i64 " + target_reg + ", " + cmp_val)
                    llvm_emit_line("    br i1 " + cmp_res + ", label %" + do_block + ", label %" + next_block)
                }
                llvm_emit_line(do_block + ":")
                llvm_emit_stmt(c_stmt)
                llvm_emit_line("    br label %" + l_end)
                current_block = next_block
            }
            cur_case = ""
            if ci >= cases_len { case_fin = true }
        } else { cur_case = cur_case + cc }
        ci += 1
    }
    llvm_emit_line(current_block + ":")
    llvm_emit_line("    br label %" + l_end)
    llvm_emit_line(l_end + ":")
}

-- ===================== STRING INTERPOLATION ==========================

task llvm_str_has_interp(val: word) -> bool {
    pilot slen = val.length()
    pilot i = 0
    repeat slen times {
        if val.char_at(i) == "{" { give back true }
        i += 1
    }
    give back false
}

task llvm_emit_say_interp(val: word) -> void {
    pilot slen = val.length()
    pilot i = 0
    pilot buf = ""
    pilot vname = ""
    pilot in_var = false
    repeat until i >= slen {
        pilot c = val.char_at(i)
        if in_var {
            if c == "}" {
                pilot var_reg = next_reg()
                llvm_emit_line("    " + var_reg + " = load i64, i64* " + llvm_var_ptr(vname))
                pilot var_type = llvm_get_var_type(vname)
                if var_type.starts_with("w") {
                    llvm_emit_line("    call void @freak_llvm_print_str(i64 " + var_reg + ")")
                } else if var_type.starts_with("n") {
                    llvm_emit_line("    call void @freak_llvm_print_num(i64 " + var_reg + ")")
                } else {
                    llvm_emit_line("    call void @freak_llvm_print_int(i64 " + var_reg + ")")
                }
                vname = ""
                in_var = false
            } else { vname = vname + c }
        } else {
            if c == "{" {
                if buf.length() > 0 {
                    pilot lit_id = register_string_literal(buf)
                    pilot lit_len = buf.length() + 1
                    pilot gep = next_reg()
                    llvm_emit_line("    " + gep + " = getelementptr inbounds [" + word_from_int(lit_len) + " x i8], [" + word_from_int(lit_len) + " x i8]* " + lit_id + ", i64 0, i64 0")
                    pilot ptr = next_reg()
                    llvm_emit_line("    " + ptr + " = ptrtoint i8* " + gep + " to i64")
                    llvm_emit_line("    call void @freak_llvm_print_str(i64 " + ptr + ")")
                    buf = ""
                }
                in_var = true
            } else { buf = buf + c }
        }
        i += 1
    }
    if buf.length() > 0 {
        pilot lit_id = register_string_literal(buf)
        pilot lit_len = buf.length() + 1
        pilot gep = next_reg()
        llvm_emit_line("    " + gep + " = getelementptr inbounds [" + word_from_int(lit_len) + " x i8], [" + word_from_int(lit_len) + " x i8]* " + lit_id + ", i64 0, i64 0")
        pilot ptr = next_reg()
        llvm_emit_line("    " + ptr + " = ptrtoint i8* " + gep + " to i64")
        llvm_emit_line("    call void @freak_llvm_print_str(i64 " + ptr + ")")
    }
    llvm_emit_line("    call void @freak_llvm_print_newline()")
}

-- ===================== TASK + PARAMS =================================

task llvm_translate_params(p: word) -> word {
    pilot res = ""
    pilot cur_name = ""
    pilot in_type = false
    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" { in_type = true }
        else if c == "," {
            if res.length() > 0 { res = res + ", " }
            res = res + "i64 %arg_" + cur_name
            cur_name = ""
            in_type = false
        } else {
            if not in_type { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name.length() > 0 {
        if res.length() > 0 { res = res + ", " }
        res = res + "i64 %arg_" + cur_name
    }
    give back res
}

task llvm_allocate_params(p: word) -> void {
    pilot cur_name = ""
    pilot cur_type = ""
    pilot in_type = false
    pilot i = 0
    pilot slen = p.length()
    repeat slen times {
        pilot c = p.char_at(i)
        if c == ":" { in_type = true }
        else if c == "," {
            llvm_emit_line("    %" + cur_name + " = alloca i64")
            llvm_emit_line("    store i64 %arg_" + cur_name + ", i64* %" + cur_name)
            pilot pt = "i"
            if cur_type == "word" { pt = "w" }
            if cur_type == "num" { pt = "n" }
            if cur_type == "bool" { pt = "b" }
            llvm_set_var_type(cur_name, pt)
            cur_name = ""
            cur_type = ""
            in_type = false
        } else {
            if in_type { cur_type = cur_type + c }
            else { cur_name = cur_name + c }
        }
        i += 1
    }
    if cur_name.length() > 0 {
        llvm_emit_line("    %" + cur_name + " = alloca i64")
        llvm_emit_line("    store i64 %arg_" + cur_name + ", i64* %" + cur_name)
        pilot pt = "i"
        if cur_type == "word" { pt = "w" }
        if cur_type == "num" { pt = "n" }
        if cur_type == "bool" { pt = "b" }
        llvm_set_var_type(cur_name, pt)
    }
}

task llvm_emit_task(eid: word) -> void {
    llvm_var_names = ""
    llvm_var_types = ""
    llvm_var_reg_map = ""
    pilot i = word_to_int(eid)
    pilot name_w: word = array_get(ast_stmt_names, i)
    pilot body_id_w: word = array_get(ast_stmt_bodies, i)
    pilot params_w: word = array_get(ast_task_params, i)
    pilot returns_w: word = array_get(ast_task_returns, i)

    pilot ret_type = "i64"
    pilot is_void = false
    if returns_w == "void" or returns_w == "" { ret_type = "void" is_void = true }
    llvm_cur_func_is_void = is_void

    pilot p_str = ""
    if params_w.length() > 0 { p_str = llvm_translate_params(params_w) }
    llvm_emit_line("define " + ret_type + " @freak_" + name_w + "(" + p_str + ") {")
    llvm_emit_line("entry:")
    if params_w.length() > 0 { llvm_allocate_params(params_w) }
    llvm_emit_block(body_id_w)
    if is_void { llvm_emit_line("    ret void") }
    else { llvm_emit_line("    ret i64 0") }
    llvm_emit_line("}")
    llvm_emit_line("")
}

