-- FREAK Calculator v2 — Minimal Black + Purple
-- "The pilot calculates. The cockpit displays."

-- ================================================================
--  Shapes
-- ================================================================

shape WindowConfig {
    title: word
    width: int
    height: int
    resizable: int
}

shape Window {
    handle: int
    width: int
    height: int
}

impl Window {
    task open(config: WindowConfig) -> Window {
        pilot h = ui::create_window(config.title, config.width, config.height, config.resizable)
        give back Window { handle: h, width: config.width, height: config.height }
    }
}

-- ================================================================
--  Calculator state — now tracks expression history
-- ================================================================

shape CalcState {
    display:     word
    history:     word
    pending:     num
    has_pending: bool
    op:          int
    fresh:       bool
}

pilot op_none = 0
pilot op_add  = 1
pilot op_sub  = 2
pilot op_mul  = 3
pilot op_div  = 4

task op_symbol(op: int) -> word {
    if op == op_add { give back " + " }
    if op == op_sub { give back " - " }
    if op == op_mul { give back " x " }
    if op == op_div { give back " / " }
    give back ""
}

impl CalcState {
    task new() -> CalcState {
        give back CalcState { display: "0", history: "", pending: 0.0, has_pending: false, op: op_none, fresh: false }
    }

    task append_digit(self, digit: word) -> void {
        if self.fresh or self.display == "0" {
            self.display = digit
            self.fresh = false
        } else {
            self.display = self.display + digit
        }
    }

    task set_op(self, new_op: int) -> void {
        if self.has_pending {
            self.calculate()
        }
        self.history = self.display + op_symbol(new_op)
        self.pending = parse_num(self.display)
        self.has_pending = true
        self.op = new_op
        self.fresh = true
    }

    task clear(self) -> void {
        self.display = "0"
        self.history = ""
        self.pending = 0.0
        self.has_pending = false
        self.op = op_none
        self.fresh = false
    }

    task negate(self) -> void {
        pilot val = parse_num(self.display) * -1.0
        self.display = format_num(val)
    }

    task pct(self) -> void {
        pilot val = parse_num(self.display) / 100.0
        self.display = format_num(val)
    }

    task calculate(self) -> void {
        if not self.has_pending { give back }
        pilot current = parse_num(self.display)
        pilot answer = 0.0

        -- Build full expression for history: "5 + 3 ="
        self.history = format_num(self.pending) + op_symbol(self.op) + self.display + " ="

        if self.op == op_add { answer = self.pending + current }
        if self.op == op_sub { answer = self.pending - current }
        if self.op == op_mul { answer = self.pending * current }
        if self.op == op_div {
            if current == 0.0 {
                self.display = "Error"
                self.has_pending = false
                self.op = op_none
                self.fresh = true
                give back
            }
            answer = self.pending / current
        }
        self.display = format_num(answer)
        self.has_pending = false
        self.op = op_none
        self.fresh = true
    }
}

-- ================================================================
--  Button: minimal flat style, no borders
-- ================================================================

task draw_button(handle: int, text: word, x: int, y: int, w: int, h: int, bg_r: int, bg_g: int, bg_b: int, hover_r: int, hover_g: int, hover_b: int, text_r: int, text_g: int, text_b: int, font_size: int, mx: int, my: int, clicked: bool) -> bool {
    pilot hovered = false
    if mx >= x { if mx < x + w { if my >= y { if my < y + h { hovered = true } } } }

    if hovered {
        ui::fill_rect(handle, x, y, w, h, hover_r, hover_g, hover_b, 255)
    }
    if not hovered {
        ui::fill_rect(handle, x, y, w, h, bg_r, bg_g, bg_b, 255)
    }

    -- Center text
    pilot tw = ui::measure_text(text, font_size, 0, 0)
    pilot tx = x + (w - tw) / 2
    pilot ty = y + (h - font_size - 2) / 2
    ui::draw_text(handle, text, tx, ty, text_r, text_g, text_b, font_size, 0, 0)

    if hovered { if clicked { give back true } }
    give back false
}

-- ================================================================
--  Main
-- ================================================================

@protagonist
task main() {
    pilot win = Window::open(WindowConfig { title: "FREAK Calc", width: 340, height: 520, resizable: 0 })
    pilot state = CalcState::new()

    -- === COLOR PALETTE ===
    -- Background: pure black
    pilot bg_r = 0
    pilot bg_g = 0
    pilot bg_b = 0

    -- Number buttons: very dark gray
    pilot num_r = 28
    pilot num_g = 28
    pilot num_b = 30
    pilot num_hr = 45
    pilot num_hg = 45
    pilot num_hb = 48

    -- Operator buttons: dark purple
    pilot opr = 48
    pilot opg = 20
    pilot opb = 68
    pilot ophr = 75
    pilot ophg = 35
    pilot ophb = 100

    -- Equals button: vivid purple
    pilot eq_r = 120
    pilot eq_g = 50
    pilot eq_b = 180
    pilot eq_hr = 150
    pilot eq_hg = 70
    pilot eq_hb = 220

    -- Top row (C, +/-, %): slightly lighter surface
    pilot top_r = 38
    pilot top_g = 38
    pilot top_b = 40
    pilot top_hr = 55
    pilot top_hg = 55
    pilot top_hb = 58

    -- Text colors
    pilot txt_w = 240
    pilot txt_g2 = 240
    pilot txt_b2 = 245
    pilot txt_dim_r = 130
    pilot txt_dim_g = 110
    pilot txt_dim_b = 160

    pilot running = true
    pilot mx = 0
    pilot my = 0
    pilot mouse_clicked = false
    pilot prev_down = false

    repeat 9999999 times {
        if not running { give back }

        ui::begin_frame(win.handle)

        pilot count = ui::poll_events(win.handle)
        if count < 0 { running = false }

        mouse_clicked = false
        pilot i = 0
        repeat 64 times {
            if i < count {
                pilot kind = ui::event_kind(i)
                if kind == 1 { running = false }
                if kind == 4 {
                    mx = ui::event_mouse_x(i)
                    my = ui::event_mouse_y(i)
                    pilot btn = ui::event_button(i)
                    pilot pressed = ui::event_pressed(i)
                    if btn == 1 {
                        if pressed == 1 {
                            if not prev_down { mouse_clicked = true }
                            prev_down = true
                        }
                        if pressed == 0 { prev_down = false }
                    }
                }
            }
            i = i + 1
        }

        -- === BACKGROUND ===
        ui::fill_rect(win.handle, 0, 0, 340, 520, bg_r, bg_g, bg_b, 255)

        -- === DISPLAY AREA ===
        -- History line (small, dim purple text, right-aligned)
        pilot hw = ui::measure_text(state.history, 14, 0, 0)
        pilot hx = 320 - hw
        if hx < 20 { hx = 20 }
        ui::draw_text(win.handle, state.history, hx, 30, txt_dim_r, txt_dim_g, txt_dim_b, 14, 0, 0)

        -- Main display (large, white, right-aligned)
        pilot dw = ui::measure_text(state.display, 42, 1, 0)
        pilot dx = 320 - dw
        if dx < 20 { dx = 20 }
        ui::draw_text(win.handle, state.display, dx, 55, txt_w, txt_g2, txt_b2, 42, 1, 0)

        -- Thin purple separator line
        ui::fill_rect(win.handle, 20, 110, 300, 1, 80, 40, 120, 255)

        -- === BUTTON GRID ===
        -- 4 columns x 5 rows, 2px gaps for minimal look
        pilot bw = 78
        pilot bh = 64
        pilot gap = 4
        pilot sx = 10
        pilot sy = 122
        pilot fs = 20

        -- Row 1: C  +/-  %  /
        if draw_button(win.handle, "C", sx, sy, bw, bh, top_r, top_g, top_b, top_hr, top_hg, top_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.clear() }
        if draw_button(win.handle, "+/-", sx + 82, sy, bw, bh, top_r, top_g, top_b, top_hr, top_hg, top_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.negate() }
        if draw_button(win.handle, "%", sx + 164, sy, bw, bh, top_r, top_g, top_b, top_hr, top_hg, top_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.pct() }
        if draw_button(win.handle, "/", sx + 246, sy, bw, bh, opr, opg, opb, ophr, ophg, ophb, eq_r, eq_g, eq_b, fs, mx, my, mouse_clicked) { state.set_op(op_div) }

        -- Row 2: 7  8  9  *
        pilot r2 = sy + 68
        if draw_button(win.handle, "7", sx, r2, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("7") }
        if draw_button(win.handle, "8", sx + 82, r2, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("8") }
        if draw_button(win.handle, "9", sx + 164, r2, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("9") }
        if draw_button(win.handle, "x", sx + 246, r2, bw, bh, opr, opg, opb, ophr, ophg, ophb, eq_r, eq_g, eq_b, fs, mx, my, mouse_clicked) { state.set_op(op_mul) }

        -- Row 3: 4  5  6  -
        pilot r3 = sy + 136
        if draw_button(win.handle, "4", sx, r3, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("4") }
        if draw_button(win.handle, "5", sx + 82, r3, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("5") }
        if draw_button(win.handle, "6", sx + 164, r3, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("6") }
        if draw_button(win.handle, "-", sx + 246, r3, bw, bh, opr, opg, opb, ophr, ophg, ophb, eq_r, eq_g, eq_b, fs, mx, my, mouse_clicked) { state.set_op(op_sub) }

        -- Row 4: 1  2  3  +
        pilot r4 = sy + 204
        if draw_button(win.handle, "1", sx, r4, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("1") }
        if draw_button(win.handle, "2", sx + 82, r4, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("2") }
        if draw_button(win.handle, "3", sx + 164, r4, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("3") }
        if draw_button(win.handle, "+", sx + 246, r4, bw, bh, opr, opg, opb, ophr, ophg, ophb, eq_r, eq_g, eq_b, fs, mx, my, mouse_clicked) { state.set_op(op_add) }

        -- Row 5: 0 (wide)  .  =
        pilot r5 = sy + 272
        if draw_button(win.handle, "0", sx, r5, 160, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit("0") }
        if draw_button(win.handle, ".", sx + 164, r5, bw, bh, num_r, num_g, num_b, num_hr, num_hg, num_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.append_digit(".") }
        if draw_button(win.handle, "=", sx + 246, r5, bw, bh, eq_r, eq_g, eq_b, eq_hr, eq_hg, eq_hb, txt_w, txt_g2, txt_b2, fs, mx, my, mouse_clicked) { state.calculate() }

        -- Subtle branding at bottom
        ui::draw_text(win.handle, "FREAK Calc", 12, 500, 50, 30, 70, 11, 0, 0)

        ui::end_frame(win.handle)
    }

    ui::destroy_window(win.handle)
}
