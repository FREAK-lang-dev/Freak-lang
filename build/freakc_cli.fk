pilot bc_scope_depth = 0

-- ===================== SHAPE REGISTRY ==============================
pilot shape_registry_names = 0
pilot shape_registry_fields = 0
pilot shape_registry_count = 0

-- ===================== LEXER STATE =================================
pilot lex_source = ""
pilot lex_len = 0
pilot lex_pos = 0
pilot lex_line = 1
pilot lex_col = 1
pilot cur_tok_line = 1
pilot cur_tok_col = 1

-- ===================== PARSER STATE ================================
pilot parse_idx = 1
pilot tok_total = 0
pilot parse_error_count = 0
pilot error_count = 0
pilot next_expr_id = 0
pilot next_stmt_id = 0

-- ===================== EMIT STATE ==================================
