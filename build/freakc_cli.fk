}

-- ===================== PROGRAM ASSEMBLY ==============================
-- v3 KEY CHANGE: proper freak_init_globals + freak_main split

task emit_llvm_program() -> void {
    temp_reg_counter = 0
    string_literals = ""
    string_literals_count = 0
    llvm_dbg_init()

    -- Write empty file (streaming appends from here)
    fs::write(out_file, "")

    llvm_emit_line("; FREAK LLVM IR Generator (v3)")
    llvm_emit_line("")
    llvm_emit_runtime_decls()
    llvm_emit_line("")

    pilot top_count = array_len(ast_top_stmts)

    -- Pre-scan: register task return types + externs
    pilot prescan_i = 0
    repeat top_count times {
        pilot pid: word = array_get(ast_top_stmts, prescan_i)
        pilot pk: word = array_get(ast_stmt_kinds, word_to_int(pid))
        if pk == STMT_TASK {
            pilot pn: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot pr: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(pn, pr)
        }
        if pk == STMT_EXTERN {
            pilot en: word = array_get(ast_stmt_names, word_to_int(pid))
            pilot er: word = array_get(ast_task_returns, word_to_int(pid))
            llvm_register_task(en, er)
            emt_register_extern(en, er)
        }
        prescan_i += 1
    }

    -- Emit global variable declarations
    llvm_global_names = ""
    pilot glob_i = 0
    repeat top_count times {
        pilot gid: word = array_get(ast_top_stmts, glob_i)
        pilot gk: word = array_get(ast_stmt_kinds, word_to_int(gid))
        if gk == STMT_PILOT {
            pilot gn: word = array_get(ast_stmt_names, word_to_int(gid))
            llvm_global_names = llvm_global_names + "|" + gn + "|"
            llvm_emit_line("@g_" + gn + " = global i64 0")
        }
        glob_i += 1
    }
    llvm_emit_line("")

    -- Emit extern declarations
    pilot ext_i = 0
    repeat top_count times {
        pilot eid: word = array_get(ast_top_stmts, ext_i)
        pilot ek: word = array_get(ast_stmt_kinds, word_to_int(eid))
        if ek == STMT_EXTERN {
            pilot enm: word = array_get(ast_stmt_names, word_to_int(eid))
            pilot ert: word = array_get(ast_task_returns, word_to_int(eid))
            pilot epm: word = array_get(ast_task_params, word_to_int(eid))
            pilot llvm_ret = "i64"
            if ert == "void" { llvm_ret = "void" }
            pilot llvm_params = ""
            if epm != "" {
                pilot plen = epm.length()
                pilot pi = 0
                pilot pcount = 1
                repeat plen times {
                    if epm.char_at(pi) == "," { pcount += 1 }
                    pi += 1
                }
                pilot pj = 0
                repeat pcount times {
                    if pj > 0 { llvm_params = llvm_params + ", " }
                    llvm_params = llvm_params + "i64"
                    pj += 1
                }
            }
            if not llvm_is_runtime_func(enm) {
                llvm_emit_line("declare " + llvm_ret + " @" + enm + "(" + llvm_params + ")")
            }
        }
        ext_i += 1
    }
    llvm_emit_line("")

    -- Emit user tasks
    pilot i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK { llvm_emit_task(cur_id) }
        i += 1
    }

    -- Detect user-defined main
    pilot has_main_task = false
    i = 0
    repeat top_count times {
        pilot cur_id: word = array_get(ast_top_stmts, i)
        pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
        if kind == STMT_TASK {
            pilot tname: word = array_get(ast_stmt_names, word_to_int(cur_id))
            if tname == "main" { has_main_task = true }
        }
        i += 1
    }

    -- v3 KEY FIX: emit freak_init_globals for programs with task main()
    if has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_cur_func_is_void = true
        pilot init_dbg = llvm_dbg_begin_func("freak_init_globals", 1)
        llvm_emit_line("define void @freak_init_globals()" + init_dbg + " {")
        llvm_emit_line("entry:")
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind == STMT_PILOT { llvm_emit_stmt(cur_id) }
            i += 1
        }
        llvm_emit_line("    ret void")
        llvm_emit_line("}")
        llvm_emit_line("")
        llvm_dbg_current_scope_id = 0
        llvm_dbg_current_line = 0
    }

    -- Emit @freak_main wrapper (only if no user main)
    if not has_main_task {
        llvm_var_names = ""
        llvm_var_types = ""
        llvm_var_reg_map = ""
        llvm_cur_func_is_void = true
        pilot main_dbg = llvm_dbg_begin_func("freak_main", 1)
        llvm_emit_line("define void @freak_main()" + main_dbg + " {")
        llvm_emit_line("entry:")
        i = 0
        repeat top_count times {
            pilot cur_id: word = array_get(ast_top_stmts, i)
            pilot kind: word = array_get(ast_stmt_kinds, word_to_int(cur_id))
            if kind != STMT_TASK and kind != STMT_EXTERN { llvm_emit_stmt(cur_id) }
            i += 1
        }
        llvm_emit_line("    ret void")
        llvm_emit_line("}")
        llvm_dbg_current_scope_id = 0
        llvm_dbg_current_line = 0
    }

    -- Emit C main entry
    llvm_emit_line("")
    pilot cmain_dbg = llvm_dbg_begin_func("main", 1)
    llvm_emit_line("define i32 @main(i32 %argc, i8** %argv)" + cmain_dbg + " {")
    llvm_emit_line("entry:")
    llvm_emit_line("    %argc_ext = sext i32 %argc to i64")
    llvm_emit_line("    %argv_ptr = ptrtoint i8** %argv to i64")
    llvm_emit_line("    call void @freak_llvm_setup_args(i64 %argc_ext, i64 %argv_ptr)")
    if has_main_task {
        llvm_emit_line("    call void @freak_init_globals()")
        llvm_emit_line("    call void @freak_main()")
    }
    if not has_main_task {
        llvm_emit_line("    call void @freak_main()")
    }
    llvm_emit_line("    ret i32 0")
    llvm_emit_line("}")
    llvm_dbg_current_scope_id = 0
    llvm_dbg_current_line = 0

    -- Append string literals at end
    llvm_emit_line("")
    llvm_emit_line("; String Literals")
    llvm_emit_line(string_literals)
    llvm_emit_line("!llvm.dbg.cu = !{!" + word_from_int(llvm_dbg_cu_id) + "}")
    llvm_emit_line("!llvm.module.flags = !{!" + word_from_int(llvm_dbg_append("!{i32 7, !\"Dwarf Version\", i32 4}")) + ", !" + word_from_int(llvm_dbg_append("!{i32 2, !\"Debug Info Version\", i32 3}")) + "}")
    llvm_emit_line(llvm_dbg_md)
}
-- ===================================================================
-- FREAK CLI — Version, Colors, Banner, Quotes
-- ===================================================================
-- The visual identity of FREAK. Make it beautiful.
-- ===================================================================

pilot CLI_VERSION = "0.14.0"
pilot CLI_CODENAME = "Shiranui"

-- ── ANSI Reset & Styles ──────────────────────────────
pilot C_RESET   = "\x1b[0m"
pilot C_BOLD    = "\x1b[1m"
pilot C_DIM     = "\x1b[2m"
pilot C_ITALIC  = "\x1b[3m"
pilot C_ULINE   = "\x1b[4m"
pilot C_BLINK   = "\x1b[5m"
pilot C_STRIKE  = "\x1b[9m"

-- ── Standard Colors ──────────────────────────────────
pilot C_RED     = "\x1b[31m"
pilot C_GREEN   = "\x1b[32m"
pilot C_YELLOW  = "\x1b[33m"
pilot C_BLUE    = "\x1b[34m"
pilot C_MAGENTA = "\x1b[35m"
pilot C_CYAN    = "\x1b[36m"
pilot C_WHITE   = "\x1b[37m"

-- ── Bold Colors ──────────────────────────────────────
pilot C_BRED    = "\x1b[1;31m"
pilot C_BGREEN  = "\x1b[1;32m"
pilot C_BYELLOW = "\x1b[1;33m"
pilot C_BBLUE   = "\x1b[1;34m"
pilot C_BMAGENTA = "\x1b[1;35m"
pilot C_BCYAN   = "\x1b[1;36m"
pilot C_BWHITE  = "\x1b[1;37m"

-- ── 24-bit RGB Colors (gradient palette) ─────────────
-- Pink → Purple → Blue → Cyan gradient for the banner
pilot C_G1 = "\x1b[38;2;255;100;200m"
pilot C_G2 = "\x1b[38;2;220;80;220m"
pilot C_G3 = "\x1b[38;2;180;70;240m"
pilot C_G4 = "\x1b[38;2;140;80;255m"
pilot C_G5 = "\x1b[38;2;100;120;255m"
pilot C_G6 = "\x1b[38;2;60;180;255m"

-- ── Background accent ────────────────────────────────
pilot C_BG_DARK = "\x1b[48;2;20;20;30m"

-- ── Box Drawing Characters ───────────────────────────
pilot BOX_TL = "\xe2\x95\xad"
pilot BOX_TR = "\xe2\x95\xae"
pilot BOX_BL = "\xe2\x95\xb0"
pilot BOX_BR = "\xe2\x95\xaf"
pilot BOX_H  = "\xe2\x94\x80"
pilot BOX_V  = "\xe2\x94\x82"
pilot BOX_VR = "\xe2\x94\x9c"
pilot BOX_VL = "\xe2\x94\xa4"

-- ── Unicode Symbols ──────────────────────────────────
pilot SYM_CHECK  = "\xe2\x9c\x93"
pilot SYM_CROSS  = "\xe2\x9c\x97"
pilot SYM_SPARK  = "\xe2\x9c\xa8"
pilot SYM_BOLT   = "\xe2\x9a\xa1"
pilot SYM_GEAR   = "\xe2\x9a\x99"
pilot SYM_ARROW  = "\xe2\x96\xb8"
pilot SYM_DOT    = "\xe2\x97\x8f"
pilot SYM_RING   = "\xe2\x97\x8b"
pilot SYM_STAR   = "\xe2\x98\x85"
pilot SYM_SKULL  = "\xe2\x98\xa0"
pilot SYM_ROCKET = "\xf0\x9f\x9a\x80"
pilot SYM_FIRE   = "\xf0\x9f\x94\xa5"

-- ── RGB Helper ───────────────────────────────────────
task cli_rgb(r: int, g: int, b: int) -> word {
    give back "\x1b[38;2;" + word_from_int(r) + ";" + word_from_int(g) + ";" + word_from_int(b) + "m"
}

-- ── Box Drawing Helpers ──────────────────────────────
task cli_box_line(width: int) -> word {
    pilot line = ""
    pilot i = 0
    repeat until i >= width {
        line = line + BOX_H
        i += 1
    }
    give back line
}

task cli_box_top(width: int) -> word {
    give back "  " + C_DIM + BOX_TL + cli_box_line(width) + BOX_TR + C_RESET
}

task cli_box_bot(width: int) -> word {
    give back "  " + C_DIM + BOX_BL + cli_box_line(width) + BOX_BR + C_RESET
}

task cli_box_mid(content: word, width: int) -> word {
    -- Pad content to width (rough — no ANSI-aware length calc)
    give back "  " + C_DIM + BOX_V + C_RESET + " " + content
}

task cli_box_sep(width: int) -> word {
    give back "  " + C_DIM + BOX_VR + cli_box_line(width) + BOX_VL + C_RESET
}

-- ── Anime Quotes ─────────────────────────────────────
task cli_random_quote(seed: int) -> word {
    pilot idx = seed % 12
    if idx == 0  { give back "\"This is the choice of Steins;Gate.\"" }
    if idx == 1  { give back "\"People die when they are killed.\"" }
    if idx == 2  { give back "\"You can't change the past, but you can change the future.\"" }
    if idx == 3  { give back "\"The only ones who should kill are those prepared to be killed.\"" }
    if idx == 4  { give back "\"If you don't take risks, you can't create a future.\"" }
    if idx == 5  { give back "\"A lesson without pain is meaningless.\"" }
    if idx == 6  { give back "\"It was always going to end this way.\"" }
    if idx == 7  { give back "\"I am the bone of my sword.\"" }
    if idx == 8  { give back "\"Believe in the me that believes in you!\"" }
    if idx == 9  { give back "\"There is no way to take back a move once played.\"" }
    if idx == 10 { give back "\"The world is not beautiful; and that is why it is beautiful.\"" }
    give back "\"Even if I die, I can be replaced.\" -- Rei Ayanami"
}

task cli_fail_quote(seed: int) -> word {
    pilot idx = seed % 8
    if idx == 0  { give back "\"I mustn't run away. I mustn't run away.\"" }
    if idx == 1  { give back "\"How many times must I tell you? This is reality.\"" }
    if idx == 2  { give back "\"Omae wa mou shindeiru.\"" }
    if idx == 3  { give back "\"You thought it would compile? Too bad, it was me, Dio!\"" }
    if idx == 4  { give back "\"This pain... it's still not enough.\"" }
    if idx == 5  { give back "\"The cruelest thing is a held-out hope.\"" }
    if idx == 6  { give back "\"No one can escape the fate chosen for them.\"" }
    give back "\"I'll accept any curse. I don't care.\" -- Homura"
}

-- ── Version Display ──────────────────────────────────
task cli_show_version() -> void {
    pilot ver = C_G1 + "freak" + C_RESET + " " + C_BWHITE + CLI_VERSION + C_RESET + " " + C_DIM + "(" + CLI_CODENAME + ")" + C_RESET
    say ver
}

-- ── Gradient Banner ──────────────────────────────────
task cli_show_banner() -> void {
    say ""
    say "  " + C_G1 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_G2 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97 " + C_G3 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_G4 + " \xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97 " + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97  " + C_G6 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_RESET
    say "  " + C_G1 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x9d" + C_G2 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_G3 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x9d" + C_G4 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91 " + C_G6 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x9d" + C_RESET
    say "  " + C_G1 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97  " + C_G2 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x9d" + C_G3 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97  " + C_G4 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91" + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x9d " + C_RESET
    say "  " + C_G2 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x95\x9d  " + C_G3 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_G4 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x95\x9d  " + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x95\x90\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91" + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x94\xe2\x95\x90\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_RESET
    say "  " + C_G3 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91     " + C_G4 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91  \xe2\x96\x88\xe2\x96\x88\xe2\x95\x91" + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_G5 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91  \xe2\x96\x88\xe2\x96\x88\xe2\x95\x91" + C_G6 + "\xe2\x96\x88\xe2\x96\x88\xe2\x95\x91  \xe2\x96\x88\xe2\x96\x88\xe2\x95\x97" + C_RESET
    say "  " + C_G4 + "\xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d     " + C_G5 + "\xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d  \xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d" + C_G5 + "\xe2\x95\x9a\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x90\xe2\x95\x9d" + C_G5 + "\xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d  \xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d" + C_G6 + "\xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d  \xe2\x95\x9a\xe2\x95\x90\xe2\x95\x9d" + C_RESET
    say ""
    pilot tag = "  " + C_DIM + "v" + CLI_VERSION + C_RESET + " " + C_G1 + CLI_CODENAME + C_RESET + C_DIM + " " + BOX_V + " self-hosting compiler " + BOX_V + " LLVM backend" + C_RESET
    say tag
    say ""
}

-- ── Help Display ─────────────────────────────────────
task cli_show_help() -> void {
    cli_show_banner()

    say cli_box_top(45)
    say cli_box_mid(C_BWHITE + " COMMANDS" + C_RESET, 45)
    say cli_box_sep(45)
    say cli_box_mid("  " + C_G1 + "build" + C_RESET + "     <file.fk> [opts]  " + C_DIM + "Compile to binary" + C_RESET, 45)
    say cli_box_mid("  " + C_G2 + "run" + C_RESET + "       <file.fk> [opts]  " + C_DIM + "Build & execute" + C_RESET, 45)
    say cli_box_mid("  " + C_G3 + "check" + C_RESET + "     <file.fk>         " + C_DIM + "Type-check only" + C_RESET, 45)
    say cli_box_mid("  " + C_G4 + "transpile" + C_RESET + " <file.fk> [opts]  " + C_DIM + "Emit .c or .ll" + C_RESET, 45)
    say cli_box_mid("  " + C_G5 + "hangar" + C_RESET + "    <cmd>              " + C_DIM + "Package manager" + C_RESET, 45)
    say cli_box_mid("  " + C_G6 + "doctor" + C_RESET + "    [--fix]              " + C_DIM + "Check setup, auto-fix" + C_RESET, 45)
    say cli_box_mid("  " + C_G1 + "learn" + C_RESET + "     [cmd]              " + C_DIM + "FREAK Academy" + C_RESET, 45)
    say cli_box_mid("  " + C_G1 + "test" + C_RESET + "                          " + C_DIM + "Run regression suite" + C_RESET, 45)
    say cli_box_mid("  " + C_G2 + "audit-*" + C_RESET + "                       " + C_DIM + "audit-conformance/science/trust/miracles" + C_RESET, 45)
    say cli_box_mid("  " + C_G1 + "upgrade" + C_RESET + "                      " + C_DIM + "Download latest FREAK" + C_RESET, 45)
    say cli_box_mid("  " + C_BCYAN + "version" + C_RESET + "                      " + C_DIM + "Show version" + C_RESET, 45)
    say cli_box_mid("  " + C_BCYAN + "help" + C_RESET + "                         " + C_DIM + "This screen" + C_RESET, 45)
    say cli_box_bot(45)
    say ""

    say cli_box_top(45)
    say cli_box_mid(C_BWHITE + " OPTIONS" + C_RESET, 45)
    say cli_box_sep(45)
    say cli_box_mid("  " + C_BYELLOW + "--llvm" + C_RESET + "            " + C_DIM + "LLVM IR backend (default)" + C_RESET, 45)
    say cli_box_mid("  " + C_BYELLOW + "--c" + C_RESET + "               " + C_DIM + "C backend" + C_RESET, 45)
    say cli_box_mid("  " + C_BYELLOW + "--opt=N" + C_RESET + "           " + C_DIM + "Optimization 0-3 (default: 2)" + C_RESET, 45)
    say cli_box_mid("  " + C_BYELLOW + "--target=TRIPLE" + C_RESET + "   " + C_DIM + "Cross-compile target" + C_RESET, 45)
    say cli_box_bot(45)
    say ""

    say "  " + C_DIM + "EXAMPLES" + C_RESET
    say "  " + C_DIM + "  $ " + C_RESET + C_BWHITE + "freak build" + C_RESET + " hello.fk"
    say "  " + C_DIM + "  $ " + C_RESET + C_BWHITE + "freak run" + C_RESET + " hello.fk " + C_BYELLOW + "--c --opt=3" + C_RESET
    say "  " + C_DIM + "  $ " + C_RESET + C_BWHITE + "freak build" + C_RESET + " game.fk " + C_BYELLOW + "--target=x86_64-linux-gnu" + C_RESET
    say "  " + C_DIM + "  $ " + C_RESET + C_BWHITE + "freak hangar" + C_RESET + " init my-project"
    say "  " + C_DIM + "  $ " + C_RESET + C_BWHITE + "freak learn" + C_RESET + " list"
    say ""
    say "  " + C_DIM + C_ITALIC + cli_random_quote(42) + C_RESET
    say ""
}
-- ===================================================================
-- Simple TOML Parser/Writer for hangar.toml
-- ===================================================================
-- Data stored as flat dot-notation in parallel arrays.
-- ===================================================================

pilot toml_keys_arr = 0
pilot toml_vals_arr = 0
pilot toml_count = 0

task toml_clear() -> void {
    toml_keys_arr = array_new()
    toml_vals_arr = array_new()
    toml_count = 0
}

task toml_set(key: word, val: word) -> void {
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k == key {
            array_set(toml_vals_arr, i, val)
            give back
        }
        i += 1
    }
    array_push(toml_keys_arr, key)
    array_push(toml_vals_arr, val)
    toml_count += 1
}

task toml_get(key: word) -> word {
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k == key {
            give back array_get(toml_vals_arr, i)
        }
        i += 1
    }
    give back ""
}

task toml_has(key: word) -> bool {
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k == key {
            give back true
        }
        i += 1
    }
    give back false
}

task toml_remove_prefix(prefix: word) -> void {
    pilot new_keys = array_new()
    pilot new_vals = array_new()
    pilot new_count = 0
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        pilot v: word = array_get(toml_vals_arr, i)
        if k.starts_with(prefix) == false {
            array_push(new_keys, k)
            array_push(new_vals, v)
            new_count += 1
        }
        i += 1
    }
    toml_keys_arr = new_keys
    toml_vals_arr = new_vals
    toml_count = new_count
}

-- ===================== LINE EXTRACTION ==============================

task toml_get_line(content: word, start: int) -> word {
    -- Extract one line from content starting at start, up to \n
    pilot line = ""
    pilot i = start
    pilot clen = content.length()
    repeat until i >= clen {
        pilot c: word = content.char_at(i)
        if c == "\n" {
            give back line
        }
        line = line + c
        i += 1
    }
    give back line
}

task toml_line_end(content: word, start: int) -> int {
    -- Return position after the newline
    pilot i = start
    pilot clen = content.length()
    repeat until i >= clen {
        pilot c: word = content.char_at(i)
        i += 1
        if c == "\n" {
            give back i
        }
    }
    give back clen
}

task toml_trim(s: word) -> word {
    give back s.trim()
}

-- ===================== PARSING =====================================

task toml_parse(content: word) -> void {
    toml_clear()
    pilot section = ""
    pilot pos = 0
    pilot clen = content.length()

    repeat until pos >= clen {
        pilot line: word = toml_get_line(content, pos)
        pos = toml_line_end(content, pos)

        pilot trimmed: word = toml_trim(line)
        if trimmed == "" {
            -- skip empty line
        } else if trimmed.starts_with("#") {
            -- skip comment
        } else if trimmed.starts_with("[") {
            -- Section header: extract name between [ and ]
            section = toml_extract_section(trimmed)
        } else if trimmed.contains("=") {
            -- Key = value
            toml_parse_kv(trimmed, section)
        }
    }
}

task toml_extract_section(line: word) -> word {
    -- Extract "project" from "[project]"
    pilot name = ""
    pilot i = 1
    pilot llen = line.length()
    repeat until i >= llen {
        pilot c: word = line.char_at(i)
        if c == "]" {
            give back name
        }
        if c != " " {
            name = name + c
        }
        i += 1
    }
    give back name
}

task toml_parse_kv(line: word, section: word) -> void {
    -- Parse "key = value" or "key = { ... }"
    -- Find the = sign
    pilot eq_pos = 0 - 1
    pilot i = 0
    pilot llen = line.length()
    pilot in_quotes = false
    repeat until i >= llen {
        pilot c: word = line.char_at(i)
        if c == "\"" { in_quotes = in_quotes == false }
        if c == "=" and in_quotes == false and eq_pos < 0 {
            eq_pos = i
        }
        i += 1
    }
    if eq_pos < 0 { give back }

    -- Extract key (before =)
    pilot raw_key = ""
    pilot ki = 0
    repeat until ki >= eq_pos {
        pilot kc: word = line.char_at(ki)
        if kc != " " and kc != "\t" {
            raw_key = raw_key + kc
        }
        ki += 1
    }

    -- Extract value (after =), trimmed
    pilot raw_val = ""
    pilot vi = eq_pos + 1
    repeat until vi >= llen {
        raw_val = raw_val + line.char_at(vi)
        vi += 1
    }
    raw_val = toml_trim(raw_val)

    pilot full_key = ""
    if section != "" {
        full_key = section + "." + raw_key
    } else {
        full_key = raw_key
    }

    -- Check if value is a quoted string
    if raw_val.starts_with("\"") {
        pilot str_val: word = toml_unquote(raw_val)
        -- Check if this is a short dependency syntax: [dependencies] muvluv = "^1.2.0"
        if section == "dependencies" {
            -- Store as dependencies.name.version for uniform access
            toml_set(full_key + ".version", str_val)
        } else {
            toml_set(full_key, str_val)
        }
    } else if raw_val.starts_with("{") {
        -- Inline table: { git = "...", version = "..." }
        toml_parse_inline_table(raw_val, full_key)
    } else {
        -- Bare value (number, bool, etc)
        toml_set(full_key, raw_val)
    }
}

task toml_unquote(s: word) -> word {
    -- Remove surrounding quotes from "value"
    pilot slen = s.length()
    if slen < 2 { give back s }
    pilot out = ""
    pilot i = 1
    pilot end_pos = slen - 1
    repeat until i >= end_pos {
        out = out + s.char_at(i)
        i += 1
    }
    give back out
}

task toml_parse_inline_table(s: word, prefix: word) -> void {
    -- Parse { key = "val", key2 = "val2" }
    -- Strip { and }
    pilot inner = ""
    pilot i = 1
    pilot slen = s.length()
    repeat until i >= slen {
        pilot c: word = s.char_at(i)
        if c == "}" { i = slen }
        if c != "}" {
            inner = inner + c
        }
        i += 1
    }

    -- Split on commas and parse each pair
    pilot pair = ""
    pilot pi = 0
    pilot ilen = inner.length()
    repeat until pi >= ilen {
        pilot pc: word = inner.char_at(pi)
        if pc == "," {
            toml_parse_inline_pair(pair, prefix)
            pair = ""
        } else {
            pair = pair + pc
        }
        pi += 1
    }
    if pair != "" {
        toml_parse_inline_pair(pair, prefix)
    }
}

task toml_parse_inline_pair(pair: word, prefix: word) -> void {
    -- Parse "key = \"val\""
    pilot trimmed: word = toml_trim(pair)
    if trimmed == "" { give back }

    -- Find =
    pilot eq = 0 - 1
    pilot i = 0
    pilot plen = trimmed.length()
    repeat until i >= plen {
        pilot c: word = trimmed.char_at(i)
        if c == "=" and eq < 0 { eq = i }
        i += 1
    }
    if eq < 0 { give back }

    -- Extract key
    pilot subkey = ""
    pilot ki = 0
    repeat until ki >= eq {
        pilot kc: word = trimmed.char_at(ki)
        if kc != " " and kc != "\t" {
            subkey = subkey + kc
        }
        ki += 1
    }

    -- Extract value
    pilot raw_val = ""
    pilot vi = eq + 1
    repeat until vi >= plen {
        raw_val = raw_val + trimmed.char_at(vi)
        vi += 1
    }
    raw_val = toml_trim(raw_val)

    pilot full_key = prefix + "." + subkey
    if raw_val.starts_with("\"") {
        pilot uv: word = toml_unquote(raw_val)
        toml_set(full_key, uv)
    } else {
        toml_set(full_key, raw_val)
    }
}

-- ===================== WRITING =====================================

task toml_write_file(path: word) -> void {
    pilot out = ""

    -- Write [project] section
    if toml_has("project.name") or toml_has("project.version") {
        out = out + "[project]\n"
        pilot pname: word = toml_get("project.name")
        if pname != "" {
            out = out + "name = \"" + pname + "\"\n"
        }
        pilot pver: word = toml_get("project.version")
        if pver != "" {
            out = out + "version = \"" + pver + "\"\n"
        }
        out = out + "\n"
    }

    -- Collect unique dependency names
    pilot dep_names = array_new()
    pilot dep_names_count = 0
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k.starts_with("dependencies.") {
            pilot dname: word = toml_extract_dep_name(k)
            if dname != "" {
                if toml_arr_contains(dep_names, dep_names_count, dname) == false {
                    array_push(dep_names, dname)
                    dep_names_count += 1
                }
            }
        }
        i += 1
    }

    if dep_names_count > 0 {
        out = out + "[dependencies]\n"
        pilot di = 0
        repeat until di >= dep_names_count {
            pilot dn: word = array_get(dep_names, di)
            pilot git_key = "dependencies." + dn + ".git"
            pilot ver_key = "dependencies." + dn + ".version"
            pilot git_val: word = toml_get(git_key)
            pilot ver_val: word = toml_get(ver_key)
            if git_val == "" and ver_val != "" {
                -- Short syntax: muvluv = "^1.2.0"
                pilot ln_short = dn + " = \"" + ver_val + "\"\n"
                out = out + ln_short
            } else {
                -- Full inline table syntax: muvluv = { git = "...", version = "..." }
                pilot ln = dn + " = { "
                pilot has_f = false
                if git_val != "" {
                    ln = ln + "git = \"" + git_val + "\""
                    has_f = true
                }
                if ver_val != "" {
                    if has_f { ln = ln + ", " }
                    ln = ln + "version = \"" + ver_val + "\""
                }
                ln = ln + " }\n"
                out = out + ln
            }
            di += 1
        }
        out = out + "\n"
    }

    fs::write(path, out)
}

task toml_extract_dep_name(key: word) -> word {
    -- From "dependencies.muvluv.git" extract "muvluv"
    pilot prefix_len = 13
    pilot rest = ""
    pilot i = prefix_len
    pilot klen = key.length()
    repeat until i >= klen {
        pilot c: word = key.char_at(i)
        if c == "." {
            give back rest
        }
        rest = rest + c
        i += 1
    }
    give back rest
}

task toml_arr_contains(arr: int, count: int, item: word) -> bool {
    pilot i = 0
    repeat until i >= count {
        pilot v: word = array_get(arr, i)
        if v == item { give back true }
        i += 1
    }
    give back false
}

-- ===================== DEPENDENCY HELPERS ===========================

task toml_dep_get_version(dep_name: word) -> word {
    -- Get version constraint for a dependency (works with both syntaxes)
    pilot ver_key = "dependencies." + dep_name + ".version"
    give back toml_get(ver_key)
}

task toml_dep_get_git(dep_name: word) -> word {
    -- Get git URL for a dependency
    pilot git_key = "dependencies." + dep_name + ".git"
    give back toml_get(git_key)
}

task toml_dep_is_short_syntax(dep_name: word) -> bool {
    -- Returns true if dependency uses short syntax (version only, no git URL)
    pilot git_val: word = toml_dep_get_git(dep_name)
    pilot ver_val: word = toml_dep_get_version(dep_name)
    give back git_val == "" and ver_val != ""
}

-- ===================== READING FROM FILE ===========================

task toml_load(path: word) -> void {
    pilot content: word = fs::read(path)
    toml_parse(content)
}

-- ===================== DEPENDENCY LISTING ===========================

task toml_dep_names_arr() -> int {
    -- Returns array handle with dep names
    pilot deps = array_new()
    pilot i = 0
    repeat until i >= toml_count {
        pilot k: word = array_get(toml_keys_arr, i)
        if k.starts_with("dependencies.") {
            pilot dn: word = toml_extract_dep_name(k)
            if dn != "" {
                if toml_arr_contains(deps, array_len(deps), dn) == false {
                    array_push(deps, dn)
                }
            }
        }
        i += 1
    }
    give back deps
}

task toml_dep_count() -> int {
    pilot deps = toml_dep_names_arr()
    give back array_len(deps)
}
-- ===================================================================
-- FREAK Hangar — Lockfile (hangar.lock)
-- ===================================================================
-- Deterministic lockfile for reproducible builds.
-- Format: TOML with [[package]] entries.
-- Generated on first install, committed to version control.
-- ===================================================================

-- Lockfile data: parallel arrays for package entries
pilot lock_pkg_names = 0
pilot lock_pkg_versions = 0
pilot lock_pkg_sources = 0
pilot lock_pkg_sha256s = 0
pilot lock_pkg_count = 0

task lock_clear() -> void {
    lock_pkg_names = array_new()
    lock_pkg_versions = array_new()
    lock_pkg_sources = array_new()
    lock_pkg_sha256s = array_new()
    lock_pkg_count = 0
}

task lock_add_entry(name: word, version: word, source: word, sha256: word) -> void {
    -- Check if entry already exists, update if so
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot existing: word = array_get(lock_pkg_names, i)
        if existing == name {
            array_set(lock_pkg_versions, i, version)
            array_set(lock_pkg_sources, i, source)
            array_set(lock_pkg_sha256s, i, sha256)
            give back
        }
        i += 1
    }
    array_push(lock_pkg_names, name)
    array_push(lock_pkg_versions, version)
    array_push(lock_pkg_sources, source)
    array_push(lock_pkg_sha256s, sha256)
    lock_pkg_count += 1
}

task lock_remove_entry(name: word) -> void {
    pilot new_names = array_new()
    pilot new_versions = array_new()
    pilot new_sources = array_new()
    pilot new_sha256s = array_new()
    pilot new_count = 0
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n != name {
            array_push(new_names, array_get(lock_pkg_names, i))
            array_push(new_versions, array_get(lock_pkg_versions, i))
            array_push(new_sources, array_get(lock_pkg_sources, i))
            array_push(new_sha256s, array_get(lock_pkg_sha256s, i))
            new_count += 1
        }
        i += 1
    }
    lock_pkg_names = new_names
    lock_pkg_versions = new_versions
    lock_pkg_sources = new_sources
    lock_pkg_sha256s = new_sha256s
    lock_pkg_count = new_count
}

task lock_get_version(name: word) -> word {
    -- Returns the locked version for a package, or "" if not locked
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_versions, i)
        }
        i += 1
    }
    give back ""
}

task lock_get_source(name: word) -> word {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_sources, i)
        }
        i += 1
    }
    give back ""
}

task lock_has(name: word) -> bool {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back true
        }
        i += 1
    }
    give back false
}

-- ===================== LOCKFILE WRITING ==============================

task lock_write(path: word) -> void {
    pilot out = "# This file is auto-generated by Hangar. Do not edit manually.\n"
    out = out + "# Commit this file to version control for reproducible builds.\n\n"

    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot name: word = array_get(lock_pkg_names, i)
        pilot version: word = array_get(lock_pkg_versions, i)
        pilot source: word = array_get(lock_pkg_sources, i)
        pilot sha256: word = array_get(lock_pkg_sha256s, i)

        out = out + "[[package]]\n"
        out = out + "name    = \"" + name + "\"\n"
        out = out + "version = \"" + version + "\"\n"
        out = out + "source  = \"" + source + "\"\n"
        out = out + "sha256  = \"" + sha256 + "\"\n"
        out = out + "\n"
        i += 1
    }

    fs::write(path, out)
}

-- ===================== LOCKFILE PARSING ==============================

task lock_parse(content: word) -> void {
    lock_clear()

    -- Parse [[package]] entries from lockfile content
    -- Each entry has: name, version, source, sha256
    pilot pos = 0
    pilot clen = content.length()
    pilot cur_name = ""
    pilot cur_version = ""
    pilot cur_source = ""
    pilot cur_sha256 = ""
    pilot in_package = false

    repeat until pos >= clen {
        pilot line: word = toml_get_line(content, pos)
        pos = toml_line_end(content, pos)

        pilot trimmed: word = line.trim()

        if trimmed == "" {
            -- Empty line: if we have a complete package entry, save it
            if in_package and cur_name != "" {
                lock_add_entry(cur_name, cur_version, cur_source, cur_sha256)
                cur_name = ""
                cur_version = ""
                cur_source = ""
                cur_sha256 = ""
                in_package = false
            }
        } else if trimmed.starts_with("#") {
            -- Skip comments
        } else if trimmed == "[[package]]" {
            -- Save previous entry if any
            if in_package and cur_name != "" {
                lock_add_entry(cur_name, cur_version, cur_source, cur_sha256)
            }
            cur_name = ""
            cur_version = ""
            cur_source = ""
            cur_sha256 = ""
            in_package = true
        } else if in_package and trimmed.contains("=") {
            -- Parse key = "value" within a [[package]] block
            pilot kv_key: word = lock_parse_key(trimmed)
            pilot kv_val: word = lock_parse_val(trimmed)
            if kv_key == "name" {
                cur_name = kv_val
            } else if kv_key == "version" {
                cur_version = kv_val
            } else if kv_key == "source" {
                cur_source = kv_val
            } else if kv_key == "sha256" {
                cur_sha256 = kv_val
            }
        }
    }

    -- Don't forget the last entry
    if in_package and cur_name != "" {
        lock_add_entry(cur_name, cur_version, cur_source, cur_sha256)
    }
}

task lock_parse_key(line: word) -> word {
    -- Extract key from "key    = \"value\""
    pilot key = ""
    pilot i = 0
    pilot llen = line.length()
    repeat until i >= llen {
        pilot c: word = line.char_at(i)
        if c == " " or c == "\t" or c == "=" {
            if key != "" {
                give back key
            }
        } else {
            key = key + c
        }
        i += 1
    }
    give back key
}

task lock_parse_val(line: word) -> word {
    -- Extract value from "key    = \"value\""
    -- Find the = sign first, then extract quoted value
    pilot found_eq = false
    pilot i = 0
    pilot llen = line.length()
    repeat until i >= llen {
        pilot c: word = line.char_at(i)
        if c == "=" {
            found_eq = true
        } else if found_eq and c == "\"" {
            -- Start of quoted value
            pilot val = ""
            i += 1
            repeat until i >= llen {
                pilot vc: word = line.char_at(i)
                if vc == "\"" {
                    give back val
                }
                val = val + vc
                i += 1
            }
            give back val
        }
        i += 1
    }
    give back ""
}

-- ===================== LOCKFILE LOADING ==============================

task lock_get_sha256(name: word) -> word {
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot n: word = array_get(lock_pkg_names, i)
        if n == name {
            give back array_get(lock_pkg_sha256s, i)
        }
        i += 1
    }
    give back ""
}

task lock_load(path: word) -> bool {
    -- Load lockfile from disk. Returns true if loaded successfully.
    if fs::exists(path) == false {
        give back false
    }
    pilot content: word = fs::read(path)
    if content == "" {
        give back false
    }
    lock_parse(content)
    give back true
}
-- ===================================================================
-- FREAK CLI — Build Pipeline
-- ===================================================================
-- Handles: transpile .fk → .c/.ll, then invoke clang to produce binary.
-- ===================================================================

-- Timing state for build steps
pilot cli_build_start_ms = 0
pilot cli_step_ms = 0

task cli_step_start() -> void {
    cli_step_ms = time::now_ms()
}

task cli_step_done(label: word) -> void {
    pilot elapsed = time::now_ms() - cli_step_ms
    pilot elapsed_str = word_from_int(elapsed)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + "  " + label + C_DIM + " (" + elapsed_str + "ms)" + C_RESET
}

task cli_count_lines(s: word) -> int {
    if s == "" { give back 0 }
    pilot count = 1
    pilot i = 0
    pilot slen = s.length()
    repeat until i >= slen {
        if s.char_at(i) == "\n" {
            count += 1
        }
        i += 1
    }
    give back count
}

task cli_strip_resolved_use_lines(source: word) -> word {
    pilot out = ""
    pilot line = ""
    pilot i = 0
    pilot slen = source.length()
    -- When `in_use_block` is set we're inside a multi-line `use std::x::{ ... }`
    -- that spans newlines. Keep stripping until we see the closing brace.
    pilot in_use_block = false
    repeat until i >= slen {
        pilot ch = source.char_at(i)
        if ch == "\n" {
            pilot trimmed = line.trim()
            if in_use_block {
                out = out + "-- [resolved cont] " + trimmed + "\n"
                if trimmed.contains("}") { in_use_block = false }
            } else {
                if trimmed.starts_with("use ") {
                    out = out + "-- [resolved] " + trimmed + "\n"
                    -- Multi-line use? Look for `{` without a matching `}` on
                    -- the same line — keep eating lines until we see `}`.
                    if trimmed.contains("{") and not trimmed.contains("}") {
                        in_use_block = true
                    }
                } else {
                    out = out + line + "\n"
                }
            }
            line = ""
        } else if ch != "\r" {
            line = line + ch
        }
        i += 1
    }
    if line != "" {
        pilot trimmed_last = line.trim()
        if in_use_block or trimmed_last.starts_with("use ") {
            out = out + "-- [resolved] " + trimmed_last
        } else {
            out = out + line
        }
    }
    give back out
}

task cli_transpile(src_file: word, source: word, target: word) -> word {
    -- Returns the output file path (.c or .ll), or "" on error.
    input_file = src_file
    init_arrays()

    cli_step_start()
    tokenize(source)
    adjust_token_lines(source_line_offset)
    cli_step_done("Lexing")

    cli_step_start()
    parse_program()
    cli_step_done("Parsing")

    cli_step_start()
    check_program()
    if strict_borrow {
        cli_step_done("Borrow checking")
        if error_count > 0 {
            say "  " + C_BRED + SYM_CROSS + " " + word_from_int(error_count) + " borrow-check error(s)" + C_RESET
            give back ""
        }
    } else {
        cli_step_done("Type checking")
    }

    cli_step_start()
    if target == "llvm" {
        pilot out_ll = src_file + ".ll"
        out_file = out_ll
        fs::write(out_ll, "")
        emit_llvm_program()
        out_file = ""
        cli_step_done("Emit LLVM IR")
        give back out_ll
    } else {
        pilot out_c = src_file + ".c"
        out_file = out_c
        fs::write(out_c, "")
        emit_c_program()
        out_file = ""
        cli_step_done("Emit C")
        give back out_c
    }
}

task cli_has_runtime(dir: word) -> bool {
    -- Check if a directory contains runtime files (.o or .c)
    pilot c_path = dir + "/freak_runtime.c"
    pilot o_path = dir + "/freak_runtime.o"
    if fs::exists(c_path) { give back true }
    if fs::exists(o_path) { give back true }
    give back false
}

task cli_find_runtime_dir() -> word {
    -- Try to find the runtime directory.
    -- 1. Check relative to CWD (dev / repo layout)
    if cli_has_runtime("freakc/runtime") {
        give back "freakc/runtime"
    }
    -- 2. Check ~/.freak/runtime/ (install.sh layout)
    pilot home_dir: word = process::env("HOME")
    if home_dir != "" {
        pilot home_rt = home_dir + "/.freak/runtime"
        if cli_has_runtime(home_rt) {
            give back home_rt
        }
    }
    -- 3. Check %APPDATA%\freak\runtime\ (install.ps1 layout on Windows)
    pilot appdata_dir: word = process::env("APPDATA")
    if appdata_dir != "" {
        pilot appdata_rt = appdata_dir + "/freak/runtime"
        if cli_has_runtime(appdata_rt) {
            give back appdata_rt
        }
    }
    -- 4. Check $FREAK_HOME/runtime/ (custom install location)
    pilot freak_home: word = process::env("FREAK_HOME")
    if freak_home != "" {
        pilot fh_rt = freak_home + "/runtime"
        if cli_has_runtime(fh_rt) {
            give back fh_rt
        }
    }
    -- 5. Fallback: check if runtime is in current dir
    if fs::exists("freak_runtime.c") {
        give back "."
    }
    if fs::exists("freak_runtime.o") {
        give back "."
    }
    give back ""
}

task cli_strip_fk(path: word) -> word {
    -- Strip .fk suffix from a file path
    if path.ends_with(".fk") {
        pilot oi = 0
        pilot oname = ""
        pilot olen = path.length() - 3
        repeat until oi >= olen {
            oname = oname + path.char_at(oi)
            oi += 1
        }
        give back oname
    }
    give back path
}

task cli_is_windows() -> bool {
    pilot windir: word = process::env("WINDIR")
    if windir != "" { give back true }
    give back false
}

task cli_has_precompiled_runtime(runtime_dir: word) -> bool {
    -- Check if pre-compiled .obj/.o runtime files exist (bundle mode)
    pilot rt_obj = runtime_dir + "/freak_runtime.obj"
    pilot llvm_obj = runtime_dir + "/freak_llvm_runtime.obj"
    if fs::exists(rt_obj) {
        if fs::exists(llvm_obj) { give back true }
    }
    -- Also check .o extension (Linux/macOS)
    pilot rt_o = runtime_dir + "/freak_runtime.o"
    pilot llvm_o = runtime_dir + "/freak_llvm_runtime.o"
    if fs::exists(rt_o) {
        if fs::exists(llvm_o) { give back true }
    }
    give back false
}

task cli_build_binary(transpiled_file: word, src_file: word, target: word, opt: word, cross: word) -> word {
    -- Compile the transpiled .c or .ll file into a native binary.
    -- Returns the output binary path, or "" on error.

    pilot runtime_dir: word = cli_find_runtime_dir()
    if runtime_dir == "" {
        say ""
        say C_BRED + "  RUNTIME NOT FOUND" + C_RESET
        say ""
        say C_DIM + "  The runtime is needed to compile FREAK programs." + C_RESET
        say C_DIM + "  Searched in:" + C_RESET
        say "    freakc/runtime/           " + C_DIM + "(dev/repo)" + C_RESET
        say "    ~/.freak/runtime/         " + C_DIM + "(install.sh)" + C_RESET
        say "    %APPDATA%\\freak\\runtime\\  " + C_DIM + "(install.ps1)" + C_RESET
        say "    $FREAK_HOME/runtime/      " + C_DIM + "(custom)" + C_RESET
        say ""
        say C_DIM + "  Fix: Re-run the install script, or run '" + C_RESET + "freak doctor" + C_DIM + "'." + C_RESET
        give back ""
    }

    -- Determine output binary name
    pilot out_bin = cli_strip_fk(src_file)
    if cli_is_windows() { out_bin = out_bin + ".exe" }

    pilot is_win = cli_is_windows()
    pilot use_bundle = false

    -- Bundle mode: pre-compiled .obj + lld-link (LLVM backend only, no clang needed for link)
    if target == "llvm" {
        if cli_has_precompiled_runtime(runtime_dir) and not is_win {
            use_bundle = true
        }
    }

    if use_bundle {
        -- BUNDLE MODE: .ll -> .obj (clang -c), then lld-link with pre-compiled runtime
        pilot obj_ext = ".obj"
        if not is_win { obj_ext = ".o" }

        -- Step 1: Compile LLVM IR to object file
        pilot user_obj = cli_strip_fk(src_file) + obj_ext
        pilot cc_cmd = "clang -c -g -o " + user_obj + " " + transpiled_file + " -O" + opt + " -w"
        if cross != "" { cc_cmd = cc_cmd + " --target=" + cross }

        say "  " + C_DIM + SYM_GEAR + "  Compiling IR..." + C_RESET
        pilot cc_exit = process::exec(cc_cmd)
        if cc_exit != 0 {
            say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- IR compilation error" + C_RESET
            give back ""
        }

        -- Step 2: Link with lld-link (Windows) or ld.lld (Linux/macOS)
        pilot rt_obj = runtime_dir + "/freak_runtime" + obj_ext
        pilot llvm_rt_obj = runtime_dir + "/freak_llvm_runtime" + obj_ext
        pilot ui_obj = runtime_dir + "/freak_ui_win32" + obj_ext

        if is_win {
            -- user_obj first (FREAK impls), then llvm_rt_obj (libc wrappers), then rt_obj (word/array fns)
            -- /FORCE:MULTIPLE resolves duplicates by using first definition seen
            pilot link_cmd = "lld-link /FORCE:MULTIPLE " + user_obj + " " + llvm_rt_obj + " " + rt_obj
            -- Add UI runtime if it exists
            if fs::exists(ui_obj) {
                link_cmd = link_cmd + " " + ui_obj
            }
            link_cmd = link_cmd + " /out:" + out_bin + " /subsystem:console"
            pilot pdb_out = cli_strip_fk(src_file) + ".pdb"
            link_cmd = link_cmd + " /debug /pdb:" + pdb_out
            link_cmd = link_cmd + " libcmt.lib user32.lib gdi32.lib msimg32.lib ws2_32.lib"
            say "  " + C_DIM + SYM_GEAR + "  Linking..." + C_RESET
            pilot link_exit = process::exec(link_cmd)
            if link_exit != 0 {
                say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- link error" + C_RESET
                give back ""
            }
        }
        if not is_win {
            -- user_obj first (FREAK), then llvm_rt_obj (libc wrappers), then rt_obj (word/array fns)
            pilot link_cmd = "ld.lld --allow-multiple-definition -o " + out_bin + " " + user_obj + " " + llvm_rt_obj + " " + rt_obj
            if fs::exists(ui_obj) {
                link_cmd = link_cmd + " " + ui_obj
            }
            link_cmd = link_cmd + " -lc -lm"
            say "  " + C_DIM + SYM_GEAR + "  Linking..." + C_RESET
            pilot link_exit = process::exec(link_cmd)
            if link_exit != 0 {
                say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- link error" + C_RESET
                give back ""
            }
        }

        give back out_bin
    }

    -- LEGACY MODE: clang does everything (transpiled + runtime source -> binary)
    -- LLVM builds need both runtimes: freak_runtime.c (word/array/io functions)
    -- and freak_llvm_runtime.c (math/tcp/time bridge functions)
    pilot runtime_file = ""
    if target == "llvm" {
        -- llvm_runtime first (libc wrappers + LLVM bridge), then freak_runtime (word/array fns)
        -- -z muldefs on Linux allows duplicate symbols (freak_word_length, freak_llvm_fs_*)
        pilot llvm_rt_c = runtime_dir + "/freak_llvm_runtime.c"
        pilot rt_c = runtime_dir + "/freak_runtime.c"
        runtime_file = llvm_rt_c + " " + rt_c
    } else {
        runtime_file = runtime_dir + "/freak_runtime.c"
    }

    pilot cmd = "clang -g -o " + out_bin + " " + transpiled_file + " " + runtime_file
    cmd = cmd + " -I" + runtime_dir + " -O" + opt + " -w -D_CRT_SECURE_NO_WARNINGS"

    if not is_win {
        cmd = cmd + " -lm"
    }
    if is_win {
        cmd = cmd + " -lws2_32"
    }

    -- Add UI runtime if source file uses ui:: functions.
    -- -DFREAK_HAS_UI activates the LLVM-side bridge wrappers
    -- (freak_llvm_ui_*) inside freak_llvm_runtime.c.
    pilot ui_c = runtime_dir + "/ui/win32_backend.c"
    if is_win {
        if fs::exists(ui_c) {
            cmd = cmd + " " + ui_c + " -DFREAK_HAS_UI -luser32 -lgdi32 -lmsimg32"
        }
    }

    if cross != "" {
        cmd = cmd + " --target=" + cross
    }

    say "  " + C_DIM + SYM_GEAR + "  Compiling native binary..." + C_RESET

    pilot exit_code = process::exec(cmd)
    if exit_code != 0 {
        say ""
        say C_BRED + "  MISSION FAILED" + C_RESET + C_RED + " -- clang compilation error" + C_RESET
        say ""
        say C_DIM + "  Make sure clang is installed and in your PATH:" + C_RESET
        say "    Windows: " + C_CYAN + "choco install llvm" + C_RESET + "  or  " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
        say "    macOS:   " + C_CYAN + "xcode-select --install" + C_RESET + "  or  " + C_CYAN + "brew install llvm" + C_RESET
        say "    Linux:   " + C_CYAN + "sudo apt install clang" + C_RESET + "  or  " + C_CYAN + "sudo dnf install clang" + C_RESET
        say ""
        say C_DIM + "  Run '" + C_RESET + "freak doctor" + C_DIM + "' to diagnose your setup." + C_RESET
        give back ""
    }

    give back out_bin
}

task cli_find_std_dir() -> word {
    -- Try to find the std/ directory.
    if fs::exists("std/math.fk") { give back "std" }
    pilot home_dir: word = process::env("HOME")
    if home_dir != "" {
        pilot home_std = home_dir + "/.freak/std"
        if fs::exists(home_std + "/math.fk") { give back home_std }
    }
    pilot appdata_dir: word = process::env("APPDATA")
    if appdata_dir != "" {
        pilot app_std = appdata_dir + "/freak/std"
        if fs::exists(app_std + "/math.fk") { give back app_std }
    }
    pilot freak_home: word = process::env("FREAK_HOME")
    if freak_home != "" {
        pilot fh_std = freak_home + "/std"
        if fs::exists(fh_std + "/math.fk") { give back fh_std }
    }
    give back ""
}

task cli_load_std(source: word, target: word) -> word {
    -- Load the standard library source files.
    -- Returns concatenated source, or "" if std not found.
    pilot std_dir: word = cli_find_std_dir()
    if std_dir == "" { give back "" }
    pilot std_src = ""
    pilot math_path = std_dir + "/math.fk"
    if fs::exists(math_path) {
        std_src = std_src + fs::read(math_path) + "\n"
    }
    pilot string_path = std_dir + "/string.fk"
    if fs::exists(string_path) {
        std_src = std_src + fs::read(string_path) + "\n"
    }
    pilot convert_path = std_dir + "/convert.fk"
    if fs::exists(convert_path) {
        std_src = std_src + fs::read(convert_path) + "\n"
    }
    pilot algo_path = std_dir + "/algorithm.fk"
    if fs::exists(algo_path) {
        std_src = std_src + fs::read(algo_path) + "\n"
    }
    pilot need_math3d = false
    if source.contains("use std::math3d") {
        need_math3d = true
    }
    if source.contains("use std::math3d::{") {
        need_math3d = true
    }
    pilot math3d_path = std_dir + "/math3d.fk"
    if need_math3d and fs::exists(math3d_path) {
        std_src = std_src + fs::read(math3d_path) + "\n"
    }
    pilot need_zip = false
    if source.contains("use std::zip") {
        need_zip = true
    }
    if source.contains("use std::zip::{") {
        need_zip = true
    }
    pilot zip_path = std_dir + "/zip.fk"
    if need_zip and fs::exists(zip_path) {
        std_src = std_src + fs::read(zip_path) + "\n"
    }
    pilot json_path = std_dir + "/json.fk"
    if fs::exists(json_path) {
        std_src = std_src + fs::read(json_path) + "\n"
    }
    pilot version_path = std_dir + "/version.fk"
    if fs::exists(version_path) {
        std_src = std_src + fs::read(version_path) + "\n"
    }
    -- std::ui — window and canvas types. Loaded conditionally because most
    -- programs don't need it, and pulling its shape definitions into every
    -- compile would slow plain CLI builds. Without it, programs that
    -- `use std::ui` would parse `WindowConfig { ... }` as an identifier
    -- followed by an unrecognized block, since `is_shape_name` looks at
    -- the current shape registry only.
    pilot need_ui = false
    if source.contains("use std::ui") {
        need_ui = true
    }
    pilot ui_path = std_dir + "/ui/window.fk"
    if need_ui and fs::exists(ui_path) {
        std_src = std_src + fs::read(ui_path) + "\n"
    }
    -- cockpit — UI framework Hangar package. Mirrors the std::ui pattern:
    -- if the source mentions `use cockpit`, append the cockpit src files
    -- so its shapes (UI, Theme) and module-level pilots (btn_*, label_*)
    -- are in scope. Order matters: containers first, then theme, layout,
    -- widgets, ui (the dispatcher).
    pilot need_cockpit = false
    if source.contains("use cockpit") {
        need_cockpit = true
    }
    if need_cockpit {
        pilot cockpit_root = "packages/cockpit/src"
        if fs::exists(cockpit_root + "/containers.fk") {
            std_src = std_src + fs::read(cockpit_root + "/containers.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/theme.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/layout.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/widgets.fk") + "\n"
            std_src = std_src + fs::read(cockpit_root + "/ui.fk") + "\n"
        }
    }
    -- http.fk uses TCP socket functions (tcp_recv_all returns freak_word)
    -- which only work correctly with the LLVM backend's i64 representation.
    -- The C backend's freak_word struct type causes type mismatches.
    if target == "llvm" {
        pilot http_path = std_dir + "/http.fk"
        if fs::exists(http_path) {
            std_src = std_src + fs::read(http_path) + "\n"
        }
    }
    -- Runtime must be loaded FIRST so its extern declarations and task
    -- definitions are available before user code that calls fs::read, etc.
    -- NOTE: runtime.fk contains i64-based extern declarations designed for
    -- the LLVM backend. The C backend gets these from freak_runtime.h via
    -- #include, so loading runtime.fk with --c causes type conflicts.
    if target == "llvm" {
        pilot rt_path = std_dir + "/runtime.fk"
        if fs::exists(rt_path) {
            std_src = fs::read(rt_path) + "\n" + std_src
        }
    }
    give back std_src
}

task cli_build(src_file: word, target: word, opt: word, cross: word) -> word {
    -- Full build pipeline: read source, transpile, compile.
    -- Returns the output binary path, or "" on error.
    cli_build_start_ms = time::now_ms()

    pilot source: word = fs::read(src_file)
    if source == "" {
        say ""
        say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + C_BWHITE + src_file + C_RESET
        give back ""
    }

    -- Build header with box
    pilot backend_label = "LLVM IR"
    if target == "c" { backend_label = "C" }
    say ""
    say cli_box_top(45)
    say cli_box_mid(" " + C_G1 + SYM_BOLT + " FREAK" + C_RESET + "  " + C_BWHITE + src_file + C_RESET, 45)
    say cli_box_mid(" " + C_DIM + "  Backend: " + C_RESET + C_BCYAN + backend_label + C_RESET + C_DIM + "  Opt: -O" + opt + C_RESET, 45)
    say cli_box_bot(45)
    say ""

    -- Auto-include standard library if available
    pilot std_source: word = cli_load_std(source, target)
    source_line_offset = 0
    if std_source != "" {
        std_source = cli_strip_resolved_use_lines(std_source)
        source_line_offset = cli_count_lines(std_source)
        source = cli_strip_resolved_use_lines(source)
        source = std_source + source
    }

    pilot transpiled: word = cli_transpile(src_file, source, target)
    if transpiled == "" {
        say ""
        say "  " + C_BRED + SYM_SKULL + " BUILD FAILED" + C_RESET
        say "  " + C_DIM + C_ITALIC + cli_fail_quote(time::now_ms()) + C_RESET
        say ""
        give back ""
    }

    cli_step_start()
    pilot binary: word = cli_build_binary(transpiled, src_file, target, opt, cross)
    if binary == "" {
        say ""
        say "  " + C_BRED + SYM_SKULL + " BUILD FAILED" + C_RESET
        say "  " + C_DIM + C_ITALIC + cli_fail_quote(time::now_ms()) + C_RESET
        say ""
        give back ""
    }
    cli_step_done("Native binary")

    -- Success summary
    pilot total_ms = time::now_ms() - cli_build_start_ms
    pilot total_str = word_from_int(total_ms)
    say ""
    say cli_box_top(45)
    say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " BUILD SUCCESSFUL" + C_RESET, 45)
    say cli_box_sep(45)
    say cli_box_mid("  " + C_DIM + "Binary: " + C_RESET + C_BWHITE + binary + C_RESET, 45)
    say cli_box_mid("  " + C_DIM + "Time:   " + C_RESET + C_BCYAN + total_str + "ms" + C_RESET, 45)
    say cli_box_bot(45)
    say ""
    say "  " + C_DIM + C_ITALIC + cli_random_quote(total_ms) + C_RESET
    say ""

    give back binary
}
-- ===================================================================
-- FREAK CLI — Run Pipeline
-- ===================================================================
-- Handles: build + execute the resulting binary.
-- ===================================================================

task cli_run(src_file: word, target: word, opt: word, cross: word) -> void {
    pilot binary: word = cli_build(src_file, target, opt, cross)
    if binary == "" {
        give back
    }

    say cli_box_top(45)
    say cli_box_mid(" " + C_G5 + SYM_ARROW + " RUNNING" + C_RESET + "  " + C_BWHITE + binary + C_RESET, 45)
    say cli_box_bot(45)
    say ""
    -- Convert forward slashes to backslashes for Windows compatibility
    pilot run_cmd: word = binary.replace("/", "\\")
    pilot run_start = time::now_ms()
    pilot run_code = process::exec(run_cmd)
    pilot run_elapsed = time::now_ms() - run_start
    say ""
    if run_code != 0 {
        pilot rc_str: word = word_from_int(run_code)
        say "  " + C_BYELLOW + SYM_BOLT + " EXIT" + C_RESET + C_DIM + " code " + rc_str + " (" + word_from_int(run_elapsed) + "ms)" + C_RESET
    } else {
        say "  " + C_BGREEN + SYM_CHECK + " DONE" + C_RESET + C_DIM + " (" + word_from_int(run_elapsed) + "ms)" + C_RESET
    }
    say ""
}
-- ===================================================================
-- FREAK Hangar — Package Manager (native FREAK implementation)
-- ===================================================================
-- Commands: init, add, remove, install, update, version
-- Uses toml.fk for hangar.toml parsing/writing.
-- Uses lockfile.fk for hangar.lock generation/reading.
-- Uses git clone for package downloads (no zip handling needed).
-- ===================================================================

pilot HANGAR_DEFAULT_REGISTRY = "https://index.hangar.dev"

-- Arg offset for standalone mode: when invoked as "hangar <cmd>",
-- args are shifted by 1 compared to "freak hangar <cmd>".
pilot hangar_arg_offset = 0

task hangar_arg(idx: int) -> word {
    give back process::arg(idx - hangar_arg_offset)
}

task hangar_init(project_dir: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) {
        pilot msg = "  hangar.toml already exists in " + project_dir
        say msg
        give back 1
    }

    -- Create project directory if it doesn't exist
    if fs::exists(project_dir) == false {
        fs::make_dir(project_dir)
    }

    -- Get project name from directory (last component)
    pilot project_name: word = hangar_basename(project_dir)

    toml_clear()
    toml_set("project.name", project_name)
    toml_set("project.version", "0.1.0")
    toml_write_file(manifest)

    -- Create src/main.fk
    pilot src_dir = project_dir + "/src"
    pilot src_main = src_dir + "/main.fk"
    if fs::exists(src_dir) == false {
        fs::make_dir(src_dir)
    }
    if fs::exists(src_main) == false {
        pilot main_content = "-- " + project_name + " -- a FREAK project\n\nsay \"Hello from " + project_name + "!\"\n"
        fs::write(src_main, main_content)
    }

    -- Create hangar_modules/
    pilot modules_dir = project_dir + "/hangar_modules"
    if fs::exists(modules_dir) == false {
        fs::make_dir(modules_dir)
    }

    say ""
    say C_BGREEN + "  INITIALIZED" + C_RESET + " " + C_BWHITE + project_name + C_RESET
    say ""
    say C_DIM + "    hangar.toml" + C_RESET
    say C_DIM + "    src/main.fk" + C_RESET
    say C_DIM + "    hangar_modules/" + C_RESET
    say ""
    pilot next_msg = C_DIM + "  Next: " + C_RESET + "cd " + project_dir + " && freak run src/main.fk"
    say next_msg
    say ""
    give back 0
}

task hangar_add(project_dir: word, pkg_name: word, repo: word, ver: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    if repo == "" {
        -- Short syntax: version constraint only (e.g. hangar add muvluv ^1.0)
        pilot ver_key = "dependencies." + pkg_name + ".version"
        toml_set(ver_key, ver)
        toml_write_file(manifest)

        pilot msg = C_BGREEN + "  + " + C_RESET + C_BWHITE + pkg_name + C_RESET + C_DIM + " (" + ver + ")" + C_RESET
        say msg
        give back 0
    }

    pilot git_key = "dependencies." + pkg_name + ".git"
    pilot ver_key2 = "dependencies." + pkg_name + ".version"
    toml_set(git_key, repo)
    toml_set(ver_key2, ver)
    toml_write_file(manifest)

    pilot msg2 = C_BGREEN + "  + " + C_RESET + C_BWHITE + pkg_name + C_RESET + C_DIM + " (" + repo + " @ " + ver + ")" + C_RESET
    say msg2

    -- Also install it
    pilot install_res = hangar_install_one(project_dir, pkg_name, repo, ver)

    -- Update lockfile
    if install_res == 0 {
        pilot lockfile = project_dir + "/hangar.lock"
        lock_load(lockfile)
        pilot lock_source = "git+" + repo
        if repo == "" { lock_source = "local" }
        lock_add_entry(pkg_name, ver, lock_source, "")
        lock_write(lockfile)
    }

    give back install_res
}

task hangar_remove(project_dir: word, pkg_name: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot git_key = "dependencies." + pkg_name + ".git"
    pilot ver_only_key = "dependencies." + pkg_name + ".version"
    if toml_has(git_key) == false and toml_has(ver_only_key) == false {
        pilot msg = "  Package '" + pkg_name + "' is not in hangar.toml"
        say msg
        give back 1
    }

    -- Remove from toml
    pilot prefix = "dependencies." + pkg_name
    toml_remove_prefix(prefix)
    toml_write_file(manifest)

    -- Remove from lockfile if present
    pilot lockfile = project_dir + "/hangar.lock"
    if fs::exists(lockfile) {
        lock_load(lockfile)
        lock_remove_entry(pkg_name)
        lock_write(lockfile)
    }

    -- Remove cached files
    pilot pkg_dir = project_dir + "/hangar_modules/" + pkg_name
    if fs::exists(pkg_dir) {
        pilot rm_cmd: word = hangar_rm_cmd(pkg_dir)
        process::exec(rm_cmd)
    }

    pilot msg2 = C_BRED + "  - " + C_RESET + C_BWHITE + pkg_name + C_RESET
    say msg2
    give back 0
}

-- ===================== HG6: DEPENDENCY RESOLUTION ====================
-- A resolver that collects transitive dependencies and detects conflicts.
-- Uses parallel arrays to track the resolution graph.

pilot resolve_names = 0
pilot resolve_versions = 0
pilot resolve_sources = 0
pilot resolve_constraints = 0
pilot resolve_requested_by = 0
pilot resolve_count = 0

task resolve_clear() -> void {
    resolve_names = array_new()
    resolve_versions = array_new()
    resolve_sources = array_new()
    resolve_constraints = array_new()
    resolve_requested_by = array_new()
    resolve_count = 0
}

task resolve_find(name: word) -> int {
    -- Returns index of package in resolution set, or -1
    pilot i = 0
    repeat until i >= resolve_count {
        pilot n: word = array_get(resolve_names, i)
        if n == name { give back i }
        i += 1
    }
    give back -1
}

task resolve_add(name: word, version: word, source: word, constraint: word, requested_by: word) -> bool {
    -- Add a package to the resolution set.
    -- Returns false if there's a conflict.
    pilot idx = resolve_find(name)
    if idx >= 0 {
        -- Package already in resolution set.
        -- Check if the existing resolved version satisfies the new constraint.
        pilot existing_ver: word = array_get(resolve_versions, idx)
        if constraint != "latest" and constraint != "*" and constraint != "" {
            if version_matches_constraint(existing_ver, constraint) == false {
                -- CONFLICT
                pilot existing_by: word = array_get(resolve_requested_by, idx)
                say ""
                say C_BRED + "  [YUUKO] Resolution failed." + C_RESET + " Two dependencies want incompatible versions of " + C_BWHITE + name + C_RESET + ":"
                pilot conflict_msg1 = "        " + C_BCYAN + existing_by + C_RESET + "  requires  " + name + " " + array_get(resolve_constraints, idx)
                pilot conflict_msg2 = "        " + C_BCYAN + requested_by + C_RESET + "  requires  " + name + " " + constraint
                say conflict_msg1
                say conflict_msg2
                say "        These ranges do not overlap."
                say C_DIM + "        Suggestion: update one of the constraints to allow a compatible version." + C_RESET
                say ""
                give back false
            }
        }
        -- Compatible — keep existing resolution
        give back true
    }

    -- New package
    array_push(resolve_names, name)
    array_push(resolve_versions, version)
    array_push(resolve_sources, source)
    array_push(resolve_constraints, constraint)
    array_push(resolve_requested_by, requested_by)
    resolve_count += 1
    give back true
}

task resolve_collect_transitive(project_dir: word, pkg_name: word, depth: int) -> bool {
    -- After a package is installed, read its hangar.toml for transitive deps.
    -- Returns false if a conflict is detected.
    if depth > 10 {
        say C_BYELLOW + "  WARNING" + C_RESET + " Dependency depth limit reached for " + pkg_name
        give back true
    }

    pilot pkg_dir = project_dir + "/hangar_modules/" + pkg_name
    pilot pkg_manifest = pkg_dir + "/hangar.toml"

    if fs::exists(pkg_manifest) == false {
        -- No manifest = no transitive deps
        give back true
    }

    -- Save current TOML state and load the sub-package manifest
    -- (We don't have TOML stack, so we re-load the root manifest after)
    pilot sub_content: word = fs::read(pkg_manifest)
    if sub_content == "" { give back true }

    -- Parse transitive deps from the sub-package
    -- Simple: look for [dependencies] section and extract names
    pilot pos = 0
    pilot clen = sub_content.length()
    pilot in_deps = false

    repeat until pos >= clen {
        pilot line: word = toml_get_line(sub_content, pos)
        pos = toml_line_end(sub_content, pos)
        pilot trimmed: word = line.trim()

        if trimmed == "[dependencies]" {
            in_deps = true
        } else if trimmed.starts_with("[") and trimmed != "[dependencies]" {
            in_deps = false
        } else if in_deps and trimmed != "" and trimmed.starts_with("#") == false {
            -- Parse dependency line
            pilot dep_name = ""
            pilot di = 0
            pilot tlen = trimmed.length()
            repeat until di >= tlen {
                pilot c: word = trimmed.char_at(di)
                if c == " " or c == "=" or c == "\t" {
                    if dep_name != "" {
                        -- Got the name, now extract version constraint
                        pilot dep_constraint = "latest"
                        -- Check for short syntax: name = "^1.0"
                        if trimmed.contains("\"") {
                            -- Extract quoted value
                            pilot qi = 0
                            pilot found_eq = false
                            repeat until qi >= tlen {
                                pilot qc: word = trimmed.char_at(qi)
                                if qc == "=" { found_eq = true }
                                if found_eq and qc == "\"" {
                                    qi += 1
                                    pilot qval = ""
                                    repeat until qi >= tlen {
                                        pilot qvc: word = trimmed.char_at(qi)
                                        if qvc == "\"" {
                                            dep_constraint = qval
                                            qi = tlen
                                        } else {
                                            qval = qval + qvc
                                        }
                                        qi += 1
                                    }
                                }
                                qi += 1
                            }
                        }

                        -- Resolve this transitive dep
                        pilot resolved_ver = dep_constraint
                        pilot resolved_src = ""

                        -- Check registry for version resolution
                        if dep_constraint != "latest" and dep_constraint != "*" {
                            pilot reg_result: word = hangar_resolve_from_registry(dep_name, dep_constraint)
                            if reg_result != "" {
                                resolved_ver = hangar_extract_colon(reg_result, 0)
                                resolved_src = hangar_extract_colon(reg_result, 1)
                            }
                        }

                        pilot is_ok = resolve_add(dep_name, resolved_ver, resolved_src, dep_constraint, pkg_name)
                        if is_ok == false {
                            give back false
                        }
                        di = tlen
                    }
                } else {
                    dep_name = dep_name + c
                }
                di += 1
            }
        }
    }

    give back true
}

-- ===================== HANGAR INSTALL ================================

task hangar_install(project_dir: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot dep_cnt = toml_dep_count()
    if dep_cnt == 0 {
        say "  No dependencies to install."
        give back 0
    }

    -- Check for existing lockfile
    pilot lockfile = project_dir + "/hangar.lock"
    pilot has_lockfile = lock_load(lockfile)
    if has_lockfile {
        say C_DIM + "  >> " + C_RESET + "Using versions from hangar.lock"
    }

    -- Phase 1: Resolve all dependencies (detect conflicts before installing)
    resolve_clear()
    pilot dep_arr = toml_dep_names_arr()
    pilot di = 0
    pilot conflicts = false

    repeat until di >= dep_cnt {
        pilot dname: word = array_get(dep_arr, di)
        pilot git_key = "dependencies." + dname + ".git"
        pilot ver_key = "dependencies." + dname + ".version"
        pilot git_val: word = toml_get(git_key)
        pilot ver_val: word = toml_get(ver_key)
        if ver_val == "" { ver_val = "latest" }

        -- If lockfile exists, prefer locked version
        pilot use_ver = ver_val
        if has_lockfile and lock_has(dname) {
            use_ver = lock_get_version(dname)
        }

        pilot is_ok = resolve_add(dname, use_ver, git_val, ver_val, "your project")
        if is_ok == false {
            conflicts = true
        }
        di += 1
    }

    if conflicts {
        say C_BRED + "  RESOLUTION FAILED" + C_RESET + " — fix the conflicts above before installing."
        give back 1
    }

    say C_DIM + "  >> " + C_RESET + "Resolved " + word_from_int(resolve_count) + " package(s)"

    -- Phase 2: Install resolved packages
    -- Initialize lockfile state if no lockfile exists
    if has_lockfile == false {
        lock_clear()
    }

    pilot errors = 0
    pilot ri = 0
    repeat until ri >= resolve_count {
        pilot rname: word = array_get(resolve_names, ri)
        pilot rver: word = array_get(resolve_versions, ri)
        pilot rsrc: word = array_get(resolve_sources, ri)

        if has_lockfile and lock_has(rname) {
            pilot locked_ver: word = lock_get_version(rname)
            pilot lock_msg = C_DIM + "  >> " + C_RESET + "Locked: " + C_BWHITE + rname + C_RESET + C_DIM + " @ " + locked_ver + C_RESET
            say lock_msg
            rver = locked_ver
        }

        pilot ires = hangar_install_one(project_dir, rname, rsrc, rver)
        if ires != 0 {
            errors += 1
        }

        -- Phase 3: Collect transitive deps from installed package
        pilot trans_ok = resolve_collect_transitive(project_dir, rname, 0)
        if trans_ok == false {
            say C_BRED + "  TRANSITIVE CONFLICT" + C_RESET + " — stopping installation."
            give back 1
        }

        ri += 1
    }

    -- Install any newly discovered transitive deps
    -- (resolve_count may have grown during Phase 3)
    repeat until ri >= resolve_count {
        pilot tname: word = array_get(resolve_names, ri)
        pilot tver: word = array_get(resolve_versions, ri)
        pilot tsrc: word = array_get(resolve_sources, ri)

        pilot tmsg = C_DIM + "  >> " + C_RESET + "Transitive: " + C_BWHITE + tname + C_RESET
        say tmsg

        pilot tres = hangar_install_one(project_dir, tname, tsrc, tver)
        if tres != 0 {
            errors += 1
        }
        ri += 1
    }

    -- Write lockfile
    lock_write(lockfile)
    say C_DIM + "  >> " + C_RESET + "Lockfile written: hangar.lock"

    if errors > 0 {
        pilot err_str: word = word_from_int(errors)
        pilot errmsg = "  " + err_str + " package(s) failed to install."
        say errmsg
        give back 1
    }

    pilot cnt_str: word = word_from_int(resolve_count)
    pilot ok_msg = "  All " + cnt_str + " package(s) installed."
    say ok_msg
    give back 0
}

-- ===================== HANGAR UPDATE =================================

task hangar_update(project_dir: word, pkg_name: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot dep_cnt = toml_dep_count()
    if dep_cnt == 0 {
        say "  No dependencies to update."
        give back 0
    }

    pilot lockfile = project_dir + "/hangar.lock"

    if pkg_name != "" {
        -- Update a single package: re-resolve just this one
        pilot git_key = "dependencies." + pkg_name + ".git"
        pilot ver_key = "dependencies." + pkg_name + ".version"
        pilot git_val: word = toml_get(git_key)
        pilot ver_val: word = toml_get(ver_key)
        if ver_val == "" { ver_val = "latest" }

        if toml_has(git_key) == false and toml_has(ver_key) == false {
            pilot not_found = "  Package '" + pkg_name + "' is not in hangar.toml"
            say not_found
            give back 1
        }

        say C_DIM + "  >> " + C_RESET + "Updating " + C_BWHITE + pkg_name + C_RESET + "..."

        -- Load existing lockfile to preserve other entries
        lock_load(lockfile)

        -- Remove old entry for this package so it gets re-resolved
        lock_remove_entry(pkg_name)

        -- Re-install with the constraint from hangar.toml (not locked version)
        pilot ires = hangar_install_one(project_dir, pkg_name, git_val, ver_val)
        if ires == 0 {
            pilot lock_source = "git+" + git_val
            if git_val == "" { lock_source = "local" }
            lock_add_entry(pkg_name, ver_val, lock_source, "")
        }

        lock_write(lockfile)
        say C_DIM + "  >> " + C_RESET + "Lockfile updated: hangar.lock"
        give back ires
    }

    -- Update all packages: re-resolve everything fresh
    say C_DIM + "  >> " + C_RESET + "Re-resolving all dependencies..."
    lock_clear()

    pilot dep_arr = toml_dep_names_arr()
    pilot errors = 0
    pilot di = 0
    repeat until di >= dep_cnt {
        pilot dname: word = array_get(dep_arr, di)
        pilot git_key2 = "dependencies." + dname + ".git"
        pilot ver_key2 = "dependencies." + dname + ".version"
        pilot git_val2: word = toml_get(git_key2)
        pilot ver_val2: word = toml_get(ver_key2)
        if ver_val2 == "" { ver_val2 = "latest" }

        pilot ires2 = hangar_install_one(project_dir, dname, git_val2, ver_val2)
        if ires2 != 0 {
            errors += 1
        } else {
            pilot lock_source2 = "git+" + git_val2
            if git_val2 == "" { lock_source2 = "local" }
            lock_add_entry(dname, ver_val2, lock_source2, "")
        }
        di += 1
    }

    lock_write(lockfile)
    say C_DIM + "  >> " + C_RESET + "Lockfile updated: hangar.lock"

    if errors > 0 {
        pilot err_str: word = word_from_int(errors)
        pilot errmsg = "  " + err_str + " package(s) failed to update."
        say errmsg
        give back 1
    }

    pilot cnt_str: word = word_from_int(dep_cnt)
    pilot ok_msg = "  All " + cnt_str + " package(s) updated."
    say ok_msg
    give back 0
}

task hangar_get_index_path(name: word) -> word {
    -- Registry index path: /mu/mv/muvluv
    if name.length() < 2 {
        give back "/" + name + "/" + name
    }
    pilot p1: word = name.char_at(0).to_lower()
    pilot p2: word = name.char_at(1).to_lower()
    give back "/" + p1 + "/" + p2 + "/" + name
}

task hangar_resolve_from_registry(name: word, constraint: word) -> word {
    -- Resolves a package name and constraint to a (version, repo_url) pair.
    -- Returns "version:repo_url" or "" if not found.
    pilot registry: word = toml_get("registries.default")
    if registry == "" { registry = HANGAR_DEFAULT_REGISTRY }

    pilot index_url = registry + hangar_get_index_path(name)
    pilot fetch_cmd = "curl -sL " + index_url
    pilot index_content: word = process::exec_capture(fetch_cmd)

    if index_content == "" or index_content.contains("404") {
        give back ""
    }

    -- index_content is newline-delimited JSON. One line per version.
    -- Find the best matching version.
    pilot pos = 0
    pilot clen = index_content.length()
    pilot best_ver = ""
    pilot best_repo = ""

    repeat until pos >= clen {
        pilot line: word = toml_get_line(index_content, pos)
        pos = toml_line_end(index_content, pos)
        if line.trim() != "" {
            pilot v: word = hangar_extract_json_field(line, "vers")
            pilot r: word = hangar_extract_json_field(line, "repo")
            -- Use std/version.fk's satisfies
            if version_matches_constraint(v, constraint) {
                -- Since index lines are usually chronological, the last one is latest.
                -- A real resolver would pick the highest version.
                if best_ver == "" or ver_gt(ver_parse(v), ver_parse(best_ver)) {
                    best_ver = v
                    best_repo = r
                }
            }
        }
    }

    if best_ver != "" {
        give back best_ver + ":" + best_repo
    }
    give back ""
}

task hangar_install_one(project_dir: word, pkg_name: word, repo: word, ver: word) -> int {
    pilot modules_dir = project_dir + "/hangar_modules"
    if fs::exists(modules_dir) == false {
        fs::make_dir(modules_dir)
    }
    pilot pkg_dir = modules_dir + "/" + pkg_name

    pilot actual_repo = repo
    pilot actual_ver = ver

    if actual_repo == "" {
        -- Resolve from registry
        pilot resolved: word = hangar_resolve_from_registry(pkg_name, ver)
        if resolved == "" {
            pilot msg = "  Package '" + pkg_name + "' not found in registry and no git repo specified."
            say msg
            give back 1
        }
        -- Extract version:repo_url
        actual_ver = hangar_extract_colon(resolved, 0)
        actual_repo = hangar_extract_colon(resolved, 1)
        pilot res_msg = C_DIM + "  >> " + C_RESET + "Resolved " + C_BWHITE + pkg_name + C_RESET + C_DIM + " to " + actual_ver + " (" + actual_repo + ")" + C_RESET
        say res_msg
    }

    pilot fetch_msg = C_DIM + "  >> " + C_RESET + "Fetching " + C_BWHITE + pkg_name + C_RESET + C_DIM + " from " + actual_repo + "..." + C_RESET
    say fetch_msg

    -- Remove existing package dir if present
    if fs::exists(pkg_dir) {
        pilot rm_cmd: word = hangar_rm_cmd(pkg_dir)
        process::exec(rm_cmd)
    }

    -- Construct git URL
    pilot git_url = ""
    if actual_repo.starts_with("https://") {
        git_url = actual_repo
    } else {
        git_url = "https://github.com/" + actual_repo + ".git"
    }

    -- Clone with git
    pilot clone_cmd = "git clone --depth 1 --quiet " + git_url + " " + pkg_dir
    if actual_ver != "latest" and actual_ver != "*" {
        clone_cmd = "git clone --depth 1 --quiet --branch v" + actual_ver + " " + git_url + " " + pkg_dir
    }
    pilot clone_res = process::exec(clone_cmd)
    if clone_res != 0 {
        -- Try without v prefix on tag
        if actual_ver != "latest" and actual_ver != "*" {
            pilot clone2 = "git clone --depth 1 --quiet --branch " + actual_ver + " " + git_url + " " + pkg_dir
            pilot clone2_res = process::exec(clone2)
            if clone2_res != 0 {
                pilot fail_msg = "  Could not fetch " + pkg_name + ". Creating stub..."
                say fail_msg
                hangar_create_stub(pkg_dir, pkg_name)
                give back 0
            }
        } else {
            pilot fail_msg2 = "  Could not fetch " + pkg_name + ". Creating stub..."
            say fail_msg2
            hangar_create_stub(pkg_dir, pkg_name)
            give back 0
        }
    }

    -- Remove .git directory from cloned package (not needed)
    pilot git_dir = pkg_dir + "/.git"
    if fs::exists(git_dir) {
        pilot rm_git: word = hangar_rm_cmd(git_dir)
        process::exec(rm_git)
    }

    -- Compute SHA-256 for integrity verification
    pilot pkg_sha: word = hangar_compute_dir_sha256(pkg_dir)
    if pkg_sha != "" {
        say C_DIM + "  >> " + C_RESET + "SHA-256: " + pkg_sha.substring(0, 16) + "..."
    }

    -- Update lockfile with hash
    pilot lockfile = project_dir + "/hangar.lock"
    lock_load(lockfile)
    pilot lock_source = actual_repo
    lock_add_entry(pkg_name, actual_ver, lock_source, pkg_sha)
    lock_write(lockfile)

    pilot ok_msg = C_BGREEN + "  INSTALLED" + C_RESET + " " + C_BWHITE + pkg_name + C_RESET + C_DIM + " -> hangar_modules/" + pkg_name + "/" + C_RESET
    say ok_msg
    give back 0
}

task hangar_create_stub(pkg_dir: word, pkg_name: word) -> void {
    fs::make_dir(pkg_dir)
    pilot stub_path = pkg_dir + "/" + pkg_name + ".fk"
    pilot stub_content = "-- " + pkg_name + " (stub module -- install with 'hangar install')\n-- This stub was created because the package could not be downloaded.\n\n"
    fs::write(stub_path, stub_content)
    pilot msg = "  Created stub: hangar_modules/" + pkg_name + "/" + pkg_name + ".fk"
    say msg
}

task hangar_version_cmd(project_dir: word, bump: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)
    pilot pname: word = toml_get("project.name")
    pilot current: word = toml_get("project.version")
    if pname == "" { pname = "unknown" }
    if current == "" { current = "0.0.0" }

    if bump == "" {
        pilot show_msg = "  " + C_BWHITE + pname + C_RESET + " " + C_BMAGENTA + "v" + current + C_RESET
        say show_msg
        give back 0
    }

    -- Parse current version using std/version.fk
    pilot parsed: word = ver_parse(current)
    pilot maj = ver_major(parsed)
    pilot min = ver_minor(parsed)
    pilot pat = ver_patch(parsed)
    pilot new_ver = ""

    if bump == "major" {
        new_ver = word_from_int(maj + 1) + ".0.0"
    } else if bump == "minor" {
        pilot new_min: word = word_from_int(min + 1)
        new_ver = word_from_int(maj) + "." + new_min + ".0"
    } else if bump == "patch" {
        pilot new_pat: word = word_from_int(pat + 1)
        new_ver = word_from_int(maj) + "." + word_from_int(min) + "." + new_pat
    } else {
        -- Explicit version string
        new_ver = bump
    }

    toml_set("project.version", new_ver)
    toml_write_file(manifest)

    pilot done_msg = "  " + C_BWHITE + pname + C_RESET + " " + C_DIM + current + C_RESET + " -> " + C_BMAGENTA + new_ver + C_RESET
    say done_msg
    give back 0
}

-- ===================== TOOLCHAIN BOOTSTRAP ==========================

-- Download a file to a local path.
-- Returns 0 on success, non-zero on failure.
task hangar_download_file(url: word, dest: word, is_win: bool) -> int {
    if is_win {
        -- Try PowerShell first (ships with all Windows versions, handles HTTPS/redirects)
        pilot ps_cmd = "powershell -NoProfile -NonInteractive -Command \"(New-Object Net.WebClient).DownloadFile('" + url + "', '" + dest + "')\""
        pilot ps_res = process::exec(ps_cmd)
        if ps_res == 0 { give back 0 }
        -- Fallback: curl (available on Windows 10 1803+)
        pilot curl_cmd = "curl -fsSL -o \"" + dest + "\" \"" + url + "\""
        give back process::exec(curl_cmd)
    } else {
        pilot curl_cmd = "curl -fsSL -o \"" + dest + "\" \"" + url + "\""
        give back process::exec(curl_cmd)
    }
}

-- Ensure a directory exists (cross-platform).
task hangar_mkdir(path: word, is_win: bool) -> void {
    if is_win {
        -- powershell New-Item handles nested dirs and ignores already-exists
        pilot cmd = "powershell -NoProfile -NonInteractive -Command \"New-Item -Force -ItemType Directory -Path '" + path + "' | Out-Null\""
        process::exec(cmd)
    } else {
        process::exec("mkdir -p \"" + path + "\"")
    }
}

task hangar_install_freak() -> int {
    say "  Detecting platform..."

    -- Detect OS via environment variables (reliable, no shell expansion needed)
    pilot os_tag = ""
    pilot ext = ""

    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        ext = ".exe"
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Linux") {
            os_tag = "linux"
        } else if uname_out.contains("Darwin") {
            os_tag = "macos"
        } else {
            say "  " + C_BRED + SYM_CROSS + C_RESET + " Unsupported OS."
            say "  Download manually: https://github.com/FREAK-lang-dev/Freak-lang/releases"
            give back 1
        }
    }

    pilot is_win = os_tag == "windows"

    -- Detect architecture
    pilot arch_tag = "x64"
    if not is_win {
        pilot arch_out: word = process::exec_capture("uname -m 2>/dev/null")
        if arch_out.contains("aarch64") or arch_out.contains("arm64") {
            arch_tag = "arm64"
        }
    }

    pilot platform = os_tag + "-" + arch_tag
    say "  Platform: " + C_BWHITE + platform + C_RESET

    -- Determine install location using env vars (no shell expansion)
    pilot freak_home = ""
    if is_win {
        pilot appdata: word = process::env("APPDATA")
        if appdata == "" {
            pilot userprofile: word = process::env("USERPROFILE")
            appdata = userprofile + "/AppData/Roaming"
        }
        freak_home = appdata + "/freak"
    } else {
        pilot home_dir: word = process::env("HOME")
        freak_home = home_dir + "/.freak"
    }

    pilot bin_dir = freak_home + "/bin"
    pilot runtime_dir = freak_home + "/runtime"
    pilot std_dir = freak_home + "/std"
    pilot binary_path = bin_dir + "/freak" + ext
    pilot hangar_path = bin_dir + "/hangar" + ext

    -- Fetch latest release tag via GitHub API
    say "  Checking latest version..."
    pilot api_resp: word = ""
    if is_win {
        pilot ps_api = "powershell -NoProfile -NonInteractive -Command \"(New-Object Net.WebClient).DownloadString('https://api.github.com/repos/FREAK-lang-dev/Freak-lang/releases/latest')\""
        api_resp = process::exec_capture(ps_api)
        if api_resp == "" {
            api_resp = process::exec_capture("curl -fsSL \"https://api.github.com/repos/FREAK-lang-dev/Freak-lang/releases/latest\"")
        }
    } else {
        api_resp = process::exec_capture("curl -fsSL \"https://api.github.com/repos/FREAK-lang-dev/Freak-lang/releases/latest\"")
    }

    pilot version: word = hangar_extract_json_field(api_resp, "tag_name")
    if version == "" {
        say "  " + C_BRED + SYM_CROSS + C_RESET + " Could not fetch latest release."
        say "  Check your internet connection and try again."
        say "  Manual download: https://github.com/FREAK-lang-dev/Freak-lang/releases"
        give back 1
    }
    say "  Latest: " + C_BGREEN + version + C_RESET

    -- Create directories
    say "  Creating directories..."
    hangar_mkdir(bin_dir, is_win)
    hangar_mkdir(runtime_dir, is_win)
    hangar_mkdir(std_dir, is_win)

    -- Download freak binary
    pilot artifact = "freak-" + platform + ext
    pilot base_url = "https://github.com/FREAK-lang-dev/Freak-lang/releases/download/" + version
    pilot freak_url = base_url + "/" + artifact
    say "  Downloading " + C_BWHITE + artifact + C_RESET + "..."
    pilot dl_res = hangar_download_file(freak_url, binary_path, is_win)
    if dl_res != 0 {
        say "  " + C_BRED + SYM_CROSS + C_RESET + " Download failed."
        say "  URL tried: " + freak_url
        say "  Try: " + C_DIM + "curl -fsSL -o freak" + ext + " \"" + freak_url + "\"" + C_RESET
        give back 1
    }
    if not is_win {
        process::exec("chmod +x \"" + binary_path + "\"")
    }

    -- Download hangar binary (same binary, BusyBox pattern)
    pilot hangar_artifact = "hangar-" + platform + ext
    pilot hangar_url = base_url + "/" + hangar_artifact
    pilot hg_res = hangar_download_file(hangar_url, hangar_path, is_win)
    if hg_res == 0 {
        if not is_win { process::exec("chmod +x \"" + hangar_path + "\"") }
    }

    -- Download runtime files (prefer .o pre-compiled for bundle mode; fall back to .c)
    say "  Downloading runtime..."
    pilot raw_base = "https://raw.githubusercontent.com/FREAK-lang-dev/Freak-lang/" + version

    -- Pre-compiled object files (needed for bundle mode — no clang for linking)
    pilot rt_o_ext = ".o"
    if is_win { rt_o_ext = ".obj" }
    pilot rt_o_url = raw_base + "/freakc/runtime/freak_runtime" + rt_o_ext
    pilot llvm_o_url = raw_base + "/freakc/runtime/freak_llvm_runtime" + rt_o_ext
    hangar_download_file(rt_o_url, runtime_dir + "/freak_runtime" + rt_o_ext, is_win)
    hangar_download_file(llvm_o_url, runtime_dir + "/freak_llvm_runtime" + rt_o_ext, is_win)

    -- C source fallbacks
    hangar_download_file(raw_base + "/freakc/runtime/freak_runtime.c",    runtime_dir + "/freak_runtime.c",    is_win)
    hangar_download_file(raw_base + "/freakc/runtime/freak_runtime.h",    runtime_dir + "/freak_runtime.h",    is_win)
    hangar_download_file(raw_base + "/freakc/runtime/freak_llvm_runtime.c", runtime_dir + "/freak_llvm_runtime.c", is_win)

    -- Standard library
    say "  Downloading standard library..."
    pilot std_files = array_new()
    array_push(std_files, "math.fk")
    array_push(std_files, "math3d.fk")
    array_push(std_files, "zip.fk")
    array_push(std_files, "string.fk")
    array_push(std_files, "convert.fk")
    array_push(std_files, "algorithm.fk")
    array_push(std_files, "json.fk")
    array_push(std_files, "http.fk")
    array_push(std_files, "version.fk")
    array_push(std_files, "runtime.fk")
    pilot si = 0
    repeat 8 times {
        pilot sf: word = array_get(std_files, si)
        hangar_download_file(raw_base + "/std/" + sf, std_dir + "/" + sf, is_win)
        si += 1
    }

    say ""
    say cli_box_top(48)
    say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " FREAK " + version + " installed!" + C_RESET, 48)
    say cli_box_sep(48)
    say cli_box_mid("  " + C_DIM + "Compiler: " + C_RESET + binary_path, 48)
    say cli_box_mid("  " + C_DIM + "Runtime:  " + C_RESET + runtime_dir, 48)
    say cli_box_mid("  " + C_DIM + "Stdlib:   " + C_RESET + std_dir, 48)
    say cli_box_sep(48)
    if is_win {
        say cli_box_mid("  Add to PATH (PowerShell):", 48)
        pilot ps_path_cmd = "$env:PATH += ';' + '" + bin_dir + "'"
        say cli_box_mid("  " + C_CYAN + ps_path_cmd + C_RESET, 48)
        say cli_box_mid("  Or: " + C_DIM + "setx PATH \"%PATH%;" + bin_dir + "\"" + C_RESET, 48)
    } else {
        say cli_box_mid("  Add to PATH:", 48)
        say cli_box_mid("  " + C_CYAN + "export PATH=\"" + bin_dir + ":$PATH\"" + C_RESET, 48)
    }
    say cli_box_bot(48)
    say ""

    -- Check if clang is available; suggest install if not
    pilot clang_test = process::exec("clang --version")
    if clang_test != 0 {
        say "  " + C_BYELLOW + SYM_BOLT + " clang not found" + C_RESET + " — needed to compile .fk programs."
        if is_win {
            say "  Install with: " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
            say "           or: " + C_CYAN + "choco install llvm" + C_RESET
            say "  Then reopen terminal and run: " + C_BWHITE + "freak doctor" + C_RESET
        } else if os_tag == "linux" {
            say "  Install with: " + C_CYAN + "sudo apt install clang lld" + C_RESET + "  (Debian/Ubuntu)"
            say "            or: " + C_CYAN + "sudo dnf install clang lld" + C_RESET + "  (Fedora/RHEL)"
        } else if os_tag == "macos" {
            say "  Install with: " + C_CYAN + "xcode-select --install" + C_RESET
            say "            or: " + C_CYAN + "brew install llvm" + C_RESET
        }
        say ""
    } else {
        say "  " + C_BGREEN + SYM_CHECK + " clang found" + C_RESET + " — ready to compile!"
        say ""
        say "  " + C_DIM + "Try: " + C_RESET + C_BWHITE + "freak build hello.fk" + C_RESET
        say ""
    }

    give back 0
}

-- ===================== OUTDATED CHECK ================================

task hangar_outdated(project_dir: word) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Run 'hangar init' first."
        give back 1
    }

    toml_load(manifest)

    pilot dep_cnt = toml_dep_count()
    if dep_cnt == 0 {
        say "  No dependencies to check."
        give back 0
    }

    say ""
    say C_BMAGENTA + "  OUTDATED" + C_RESET + C_DIM + " -- checking installed packages" + C_RESET
    say ""

    pilot dep_arr = toml_dep_names_arr()
    pilot found_outdated = 0
    pilot di = 0
    repeat until di >= dep_cnt {
        pilot dname: word = array_get(dep_arr, di)
        pilot ver_val: word = toml_dep_get_version(dname)

        -- Check installed version from hangar_modules/<pkg>/hangar.toml
        pilot pkg_manifest = project_dir + "/hangar_modules/" + dname + "/hangar.toml"
        pilot installed_ver = ""
        if fs::exists(pkg_manifest) {
            -- Save current toml state, load package manifest, then restore
            pilot saved_keys = toml_keys_arr
            pilot saved_vals = toml_vals_arr
            pilot saved_count = toml_count

            toml_load(pkg_manifest)
            installed_ver = toml_get("project.version")

            -- Restore main toml state
            toml_keys_arr = saved_keys
            toml_vals_arr = saved_vals
            toml_count = saved_count
        }

        if installed_ver == "" {
            installed_ver = "unknown"
        }

        -- Display constraint vs installed version
        pilot constraint_str = ver_val
        if constraint_str == "" { constraint_str = "latest" }

        pilot status_line = "  " + C_BWHITE + dname + C_RESET
        status_line = status_line + C_DIM + "  installed: " + C_RESET + installed_ver
        status_line = status_line + C_DIM + "  constraint: " + C_RESET + constraint_str

        -- Check if installed version satisfies constraint
        if installed_ver != "unknown" and ver_val != "" and ver_val != "latest" and ver_val != "*" {
            pilot satisfies = ver_satisfies(installed_ver, ver_val)
            if satisfies == false {
                status_line = status_line + "  " + C_BYELLOW + "UPDATE AVAILABLE" + C_RESET
                found_outdated += 1
            } else {
                status_line = status_line + "  " + C_BGREEN + "OK" + C_RESET
            }
        } else {
            status_line = status_line + "  " + C_DIM + "skip (no constraint)" + C_RESET
        }

        say status_line
        di += 1
    }

    say ""
    if found_outdated > 0 {
        pilot cnt_str: word = word_from_int(found_outdated)
        pilot summary = C_BYELLOW + "  " + cnt_str + " package(s) may need updating." + C_RESET
        say summary
    } else {
        say C_BGREEN + "  All packages satisfy their constraints." + C_RESET
    }
    say ""
    give back 0
}

-- ===================== HELPERS =====================================

task hangar_basename(path: word) -> word {
    -- Get last component of a path
    pilot last = ""
    pilot i = 0
    pilot plen = path.length()
    repeat until i >= plen {
        pilot c: word = path.char_at(i)
        if c == "/" or c == "\\" {
            last = ""
        } else {
            last = last + c
        }
        i += 1
    }
    if last == "" or last == "." { last = "my-project" }
    give back last
}

task hangar_rm_cmd(path: word) -> word {
    -- Cross-platform remove directory command
    -- Detect Windows vs Unix
    pilot win_check: word = process::exec_capture("echo %OS%")
    if win_check.contains("Windows") {
        pilot win_path: word = path.replace("/", "\\")
        give back "rmdir /s /q \"" + win_path + "\""
    } else {
        give back "rm -rf \"" + path + "\""
    }
}

task hangar_extract_json_field(json: word, field: word) -> word {
    -- Very simple JSON field extractor
    -- Finds "field": "value" and returns value
    pilot search = "\"" + field + "\""
    pilot jlen = json.length()
    pilot slen = search.length()
    pilot i = 0
    repeat until i >= jlen {
        -- Check if search string matches at position i
        pilot match = true
        pilot si = 0
        repeat until si >= slen {
            if i + si >= jlen {
                match = false
            }
            if match {
                pilot jc: word = json.char_at(i + si)
                pilot sc: word = search.char_at(si)
                if jc != sc { match = false }
            }
            si += 1
        }
        if match {
            -- Found the field, now skip ": " and extract value
            pilot vi = i + slen
            -- Skip whitespace and colon
            repeat until vi >= jlen {
                pilot vc: word = json.char_at(vi)
                if vc != ":" and vc != " " and vc != "\t" {
                    -- At the start of value
                    if vc == "\"" {
                        vi += 1
                        pilot val = ""
                        repeat until vi >= jlen {
                            pilot vv: word = json.char_at(vi)
                            if vv == "\"" {
                                give back val
                            }
                            val = val + vv
                            vi += 1
                        }
                    }
                }
                vi += 1
            }
        }
        i += 1
    }
    give back ""
}

-- ===================== HG5: CHECKSUM VERIFICATION ====================

task hangar_compute_sha256(path: word) -> word {
    -- Compute SHA-256 hash of a file using platform tools.
    -- Returns lowercase hex string, or "" on failure.
    pilot win_check: word = process::exec_capture("echo %OS%")
    pilot cmd = ""
    if win_check.contains("Windows") {
        -- Windows: certutil outputs "SHA256 hash of file:\n<hash>\n..."
        cmd = "certutil -hashfile \"" + path + "\" SHA256"
    } else {
        -- Unix: sha256sum outputs "<hash>  <file>"
        cmd = "sha256sum \"" + path + "\" 2>/dev/null || shasum -a 256 \"" + path + "\""
    }

    pilot output: word = process::exec_capture(cmd)
    if output == "" { give back "" }

    -- Extract the hex hash from output
    if win_check.contains("Windows") {
        -- certutil: second line is the hash
        pilot pos = 0
        pilot olen = output.length()
        pilot line_num = 0
        repeat until pos >= olen {
            pilot line: word = toml_get_line(output, pos)
            pos = toml_line_end(output, pos)
            line_num += 1
            if line_num == 2 {
                -- This line should be the hash (with possible spaces)
                give back line.trim().replace(" ", "")
            }
        }
    } else {
        -- sha256sum: first 64 chars are the hash
        pilot hash = ""
        pilot i = 0
        pilot olen = output.length()
        repeat until i >= 64 or i >= olen {
            pilot c: word = output.char_at(i)
            if c != " " and c != "\t" {
                hash = hash + c
            }
            i += 1
        }
        give back hash
    }
    give back ""
}

task hangar_compute_dir_sha256(pkg_dir: word) -> word {
    -- Compute a reproducible hash for a package directory.
    -- We tar the directory contents and hash the tarball.
    pilot tmp_tar = pkg_dir + ".tmp.tar.gz"
    pilot win_check: word = process::exec_capture("echo %OS%")
    pilot tar_cmd = ""
    if win_check.contains("Windows") {
        tar_cmd = "tar -czf \"" + tmp_tar + "\" -C \"" + pkg_dir + "\" ."
    } else {
        tar_cmd = "tar -czf \"" + tmp_tar + "\" -C \"" + pkg_dir + "\" ."
    }
    pilot tar_res = process::exec(tar_cmd)
    if tar_res != 0 {
        give back ""
    }
    pilot hash: word = hangar_compute_sha256(tmp_tar)
    -- Clean up temp tarball
    fs::delete(tmp_tar)
    give back hash
}

task hangar_verify_package(pkg_name: word, pkg_dir: word, expected_sha256: word) -> bool {
    -- Verify a package's integrity against stored SHA-256.
    -- Returns true if valid, false if mismatch or unable to verify.
    if expected_sha256 == "" {
        -- No hash stored, can't verify but don't block
        give back true
    }

    pilot actual: word = hangar_compute_dir_sha256(pkg_dir)
    if actual == "" {
        say C_BYELLOW + "  WARNING" + C_RESET + " Could not compute hash for " + pkg_name
        give back true
    }

    if actual == expected_sha256 {
        give back true
    } else {
        say C_BRED + "  INTEGRITY FAILURE" + C_RESET + " " + pkg_name
        say C_DIM + "    expected: " + C_RESET + expected_sha256
        say C_DIM + "    actual:   " + C_RESET + actual
        give back false
    }
}

task hangar_audit(project_dir: word, fix_mode: bool) -> int {
    say ""
    say C_BMAGENTA + "  HANGAR AUDIT" + C_RESET
    say ""

    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found."
        give back 1
    }

    toml_load(manifest)
    pilot lockfile = project_dir + "/hangar.lock"
    pilot has_lock = lock_load(lockfile)

    if has_lock == false {
        say "  No hangar.lock found. Run 'hangar install' first."
        give back 1
    }

    pilot modules_dir = project_dir + "/hangar_modules"
    pilot issues = 0
    pilot verified = 0

    -- Check each locked package
    pilot i = 0
    repeat until i >= lock_pkg_count {
        pilot name: word = array_get(lock_pkg_names, i)
        pilot version: word = array_get(lock_pkg_versions, i)
        pilot sha256: word = array_get(lock_pkg_sha256s, i)
        pilot pkg_dir = modules_dir + "/" + name

        if fs::exists(pkg_dir) == false {
            say C_BRED + "  MISSING" + C_RESET + " " + name + " v" + version + " (not installed)"
            issues += 1
            if fix_mode {
                say C_DIM + "  >> " + C_RESET + "Reinstalling " + name + "..."
                pilot source: word = array_get(lock_pkg_sources, i)
                hangar_install_one(project_dir, name, source, version)
            }
        } else if sha256 != "" {
            -- Verify integrity
            pilot valid = hangar_verify_package(name, pkg_dir, sha256)
            if valid {
                say C_BGREEN + "  OK" + C_RESET + " " + name + " v" + version
                verified += 1
            } else {
                issues += 1
                if fix_mode {
                    say C_DIM + "  >> " + C_RESET + "Reinstalling " + name + "..."
                    pilot source2: word = array_get(lock_pkg_sources, i)
                    hangar_install_one(project_dir, name, source2, version)
                    -- Recompute hash after reinstall
                    pilot new_hash: word = hangar_compute_dir_sha256(pkg_dir)
                    if new_hash != "" {
                        array_set(lock_pkg_sha256s, i, new_hash)
                    }
                }
            }
        } else {
            say C_BYELLOW + "  UNVERIFIED" + C_RESET + " " + name + " v" + version + " (no checksum in lockfile)"
            if fix_mode {
                -- Compute and store hash
                pilot new_hash2: word = hangar_compute_dir_sha256(pkg_dir)
                if new_hash2 != "" {
                    array_set(lock_pkg_sha256s, i, new_hash2)
                    say C_DIM + "  >> " + C_RESET + "Computed SHA-256: " + new_hash2.substring(0, 16) + "..."
                    verified += 1
                }
            }
        }

        i += 1
    }

    if fix_mode {
        lock_write(lockfile)
    }

    say ""
    if issues == 0 {
        pilot ok_msg = C_BGREEN + "  ALL CLEAR" + C_RESET + " " + word_from_int(verified) + " packages verified"
        say ok_msg
    } else {
        pilot issue_msg = C_BYELLOW + "  " + word_from_int(issues) + " issue(s) found" + C_RESET
        say issue_msg
        if fix_mode == false {
            say C_DIM + "  Run 'hangar audit --fix' to auto-repair." + C_RESET
        }
    }
    say ""
    give back issues
}

-- ===================== HG3: LOGIN & PUBLISH ==========================

task hangar_login() -> int {
    say ""
    say C_BMAGENTA + "  HANGAR LOGIN" + C_RESET
    say ""
    say "  Please enter your Hangar API token:"
    pilot token: word = process::input()
    if token == "" {
        say "  Login cancelled."
        give back 1
    }

    -- Store in ~/.hangar/credentials
    pilot home_dir: word = process::env("HOME")
    if home_dir == "" {
        -- Windows fallback
        home_dir = process::env("APPDATA") + "/freak"
    }
    pilot hangar_dir = home_dir + "/.hangar"
    if fs::exists(hangar_dir) == false {
        fs::make_dir(hangar_dir)
    }
    pilot creds_path = hangar_dir + "/credentials"
    fs::write(creds_path, token)

    say ""
    say C_BGREEN + "  SUCCESS" + C_RESET + " Token stored in " + creds_path
    say ""
    give back 0
}

task hangar_publish(project_dir: word, dry_run: bool) -> int {
    pilot manifest = project_dir + "/hangar.toml"
    if fs::exists(manifest) == false {
        say "  No hangar.toml found. Cannot publish."
        give back 1
    }

    toml_load(manifest)
    pilot pname: word = toml_get("project.name")
    pilot pver: word = toml_get("project.version")

    if pname == "" or pver == "" {
        say "  Invalid hangar.toml: name and version are required."
        give back 1
    }

    say ""
    say C_BMAGENTA + "  HANGAR PUBLISH" + C_RESET + " " + C_BWHITE + pname + C_RESET + " v" + pver
    say ""

    -- Dry run: show what would be included
    if dry_run {
        say C_DIM + "  [DRY RUN] Would include:" + C_RESET
        say "    hangar.toml"
        say "    src/"
        if fs::exists(project_dir + "/README.md") { say "    README.md" }
        if fs::exists(project_dir + "/LICENSE") { say "    LICENSE" }
        say ""
        say "  Dry run complete. No files uploaded."
        give back 0
    }

    -- Create tarball: name-version.tar.gz
    pilot tarball = pname + "-" + pver + ".tar.gz"
    say C_DIM + "  >> " + C_RESET + "Packaging " + tarball + "..."

    -- For simplicity in MVP, we shell out to 'tar'
    -- Only include: hangar.toml, src/, README.md, LICENSE
    pilot include_list = "hangar.toml src"
    if fs::exists(project_dir + "/README.md") { include_list = include_list + " README.md" }
    if fs::exists(project_dir + "/LICENSE") { include_list = include_list + " LICENSE" }

    pilot tar_cmd = "tar -czf " + tarball + " " + include_list
    pilot tar_res = process::exec(tar_cmd)
    if tar_res != 0 {
        say "  Failed to create tarball. Make sure 'tar' is in your PATH."
        give back 1
    }

    -- Get token
    pilot home_dir: word = process::env("HOME")
    if home_dir == "" { home_dir = process::env("APPDATA") + "/freak" }
    pilot creds_path = home_dir + "/.hangar/credentials"
    if fs::exists(creds_path) == false {
        say C_BYELLOW + "  NOT LOGGED IN" + C_RESET
        say "  Run 'hangar login' first."
        give back 1
    }
    pilot token: word = fs::read(creds_path)

    -- Upload to registry API
    pilot registry: word = toml_get("registries.default")
    if registry == "" { registry = HANGAR_DEFAULT_REGISTRY }
    -- Convert index URL to API URL (mock)
    -- index.hangar.dev -> api.hangar.dev
    pilot api_url = "https://api.hangar.dev/api/v1/publish"

    say C_DIM + "  >> " + C_RESET + "Uploading to " + api_url + "..."

    pilot curl_cmd = "curl -s -X POST -H \"Authorization: Bearer " + token + "\" "
    curl_cmd = curl_cmd + "-F \"package=@" + tarball + "\" " + api_url

    pilot curl_res = process::exec(curl_cmd)

    -- Clean up tarball
    pilot rm_cmd = hangar_rm_cmd(tarball)
    -- Use simple delete if it's just a file
    fs::delete(tarball)

    if curl_res == 0 {
        say ""
        say C_BGREEN + "  PUBLISHED" + C_RESET + " " + C_BWHITE + pname + C_RESET + " v" + pver
        say ""
        give back 0
    } else {
        say ""
        say C_BRED + "  UPLOAD FAILED" + C_RESET
        give back 1
    }
}

task hangar_extract_colon(s: word, idx: int) -> word {
    pilot res = ""
    pilot cur_idx = 0
    pilot i = 0
    pilot slen = s.length()
    repeat until i >= slen {
        pilot c: word = s.char_at(i)
        if c == ":" {
            if cur_idx == idx {
                give back res
            }
            cur_idx += 1
            res = ""
        } else {
            res = res + c
        }
        i += 1
    }
    if cur_idx == idx {
        give back res
    }
    give back ""
}

-- ===================== MAIN DISPATCH ================================

task hangar_dispatch(args_cnt: int) -> void {
    if args_cnt < 3 {
        say ""
        say C_BMAGENTA + "  HANGAR" + C_RESET + C_DIM + " -- FREAK package manager" + C_RESET
        say ""
        say C_BWHITE + "  COMMANDS" + C_RESET
        say C_BCYAN + "    init" + C_RESET + "                         " + C_DIM + "Create new project" + C_RESET
        say C_BCYAN + "    add" + C_RESET + " <name> [constraint]       " + C_DIM + "Add dependency with version" + C_RESET
        say C_BCYAN + "    add" + C_RESET + " <name> <repo> [version]  " + C_DIM + "Add dependency with git repo" + C_RESET
        say C_BCYAN + "    remove" + C_RESET + " <name>                " + C_DIM + "Remove dependency" + C_RESET
        say C_BCYAN + "    install" + C_RESET + "                      " + C_DIM + "Install all dependencies" + C_RESET
        say C_BCYAN + "    install freak" + C_RESET + "                " + C_DIM + "Install FREAK compiler" + C_RESET
        say C_BCYAN + "    update" + C_RESET + " [package]              " + C_DIM + "Re-resolve and update lockfile" + C_RESET
        say C_BCYAN + "    outdated" + C_RESET + "                     " + C_DIM + "Check for outdated packages" + C_RESET
        say C_BCYAN + "    version" + C_RESET + "                      " + C_DIM + "Show project version" + C_RESET
        say C_BCYAN + "    version" + C_RESET + " patch|minor|major    " + C_DIM + "Bump version" + C_RESET
        say ""
        say C_BCYAN + "    audit" + C_RESET + "                        " + C_DIM + "Verify package integrity" + C_RESET
        say C_BCYAN + "    audit" + C_RESET + " --fix                 " + C_DIM + "Fix integrity issues" + C_RESET
        say C_BCYAN + "    login" + C_RESET + "                        " + C_DIM + "Authenticate with registry" + C_RESET
        say C_BCYAN + "    publish" + C_RESET + " [--dry-run]          " + C_DIM + "Publish to registry" + C_RESET
        say ""
        give back
    }

    pilot subcmd: word = hangar_arg(2)
    pilot project_dir = "."

    if subcmd == "init" {
        if args_cnt >= 4 {
            project_dir = hangar_arg(3)
        }
        hangar_init(project_dir)
    } else if subcmd == "add" {
        if args_cnt < 4 {
            say "Usage: hangar add <name> [constraint]"
            say "       hangar add <name> <repo> [version]"
            give back
        }
        pilot pkg: word = hangar_arg(3)
        if args_cnt == 4 {
            -- hangar add muvluv (no constraint, defaults to latest)
            hangar_add(project_dir, pkg, "", "latest")
        } else if args_cnt == 5 {
            -- Could be: hangar add muvluv ^1.0  OR  hangar add muvluv repo_url
            pilot arg4: word = hangar_arg(4)
            if arg4.starts_with("^") or arg4.starts_with("~") or arg4.starts_with("=") or arg4.starts_with(">") or arg4.starts_with("<") {
                -- SemVer constraint: hangar add muvluv ^1.0
                hangar_add(project_dir, pkg, "", arg4)
            } else {
                -- Git repo: hangar add muvluv https://github.com/...
                hangar_add(project_dir, pkg, arg4, "latest")
            }
        } else {
            -- hangar add muvluv repo version
            pilot repo: word = hangar_arg(4)
            pilot ver = "latest"
            if args_cnt >= 6 {
                ver = hangar_arg(5)
            }
            hangar_add(project_dir, pkg, repo, ver)
        }
    } else if subcmd == "remove" {
        if args_cnt < 4 {
            say "Usage: hangar remove <name>"
            give back
        }
        pilot pkg2: word = hangar_arg(3)
        hangar_remove(project_dir, pkg2)
    } else if subcmd == "install" {
        -- Check if "install freak" (toolchain bootstrap)
        if args_cnt >= 4 {
            pilot install_target: word = hangar_arg(3)
            if install_target == "freak" {
                hangar_install_freak()
                give back
            }
        }
        hangar_install(project_dir)
    } else if subcmd == "update" {
        pilot update_pkg = ""
        if args_cnt >= 4 {
            update_pkg = hangar_arg(3)
        }
        hangar_update(project_dir, update_pkg)
    } else if subcmd == "outdated" {
        hangar_outdated(project_dir)
    } else if subcmd == "version" {
        pilot bump = ""
        if args_cnt >= 4 {
            bump = hangar_arg(3)
        }
        hangar_version_cmd(project_dir, bump)
    } else if subcmd == "audit" {
        pilot fix_mode = false
        if args_cnt >= 4 {
            pilot arg3: word = hangar_arg(3)
            if arg3 == "--fix" { fix_mode = true }
        }
        hangar_audit(project_dir, fix_mode)
    } else if subcmd == "login" {
        hangar_login()
    } else if subcmd == "publish" {
        pilot dry_run = false
        if args_cnt >= 4 {
            pilot arg3: word = hangar_arg(3)
            if arg3 == "--dry-run" { dry_run = true }
        }
        hangar_publish(project_dir, dry_run)
    } else {
        pilot msg = "Unknown hangar command: " + subcmd
        say msg
        say "Run 'hangar' for usage."
    }
}
-- ===================================================================
-- FREAK CLI — Doctor (Setup Diagnostics + Auto-Fix)
-- ===================================================================
-- freak doctor        — diagnose your setup
-- freak doctor --fix  — diagnose AND auto-install missing tools
-- ===================================================================

-- Try to install clang/lld on the current platform.
-- Returns 0 if installation succeeded (or already installed).
task cli_install_clang(os_tag: word) -> int {
    say "  " + C_DIM + "Attempting to install clang..." + C_RESET
    if os_tag == "windows" {
        -- Try winget first (ships with Windows 10 1.0 and later)
        pilot wg_res = process::exec("winget install LLVM.LLVM --silent --accept-package-agreements --accept-source-agreements")
        if wg_res == 0 { give back 0 }
        -- Fallback: chocolatey
        pilot choco_res = process::exec("choco install llvm -y")
        if choco_res == 0 { give back 0 }
        say "  " + C_BYELLOW + "  Auto-install failed. Install manually:" + C_RESET
        say "    " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
        say "    " + C_CYAN + "choco install llvm" + C_RESET
        say "    https://github.com/llvm/llvm-project/releases"
        give back 1
    } else if os_tag == "linux" {
        -- Try apt (Debian/Ubuntu)
        pilot apt_res = process::exec("sudo apt-get install -y clang lld")
        if apt_res == 0 { give back 0 }
        -- Try dnf (Fedora/RHEL)
        pilot dnf_res = process::exec("sudo dnf install -y clang lld")
        if dnf_res == 0 { give back 0 }
        -- Try pacman (Arch)
        pilot pacman_res = process::exec("sudo pacman -S --noconfirm clang lld")
        if pacman_res == 0 { give back 0 }
        say "  " + C_BYELLOW + "  Could not auto-install. Try:" + C_RESET
        say "    " + C_CYAN + "sudo apt install clang lld" + C_RESET + "  (Debian/Ubuntu)"
        say "    " + C_CYAN + "sudo dnf install clang lld" + C_RESET + "  (Fedora)"
        give back 1
    } else if os_tag == "macos" {
        -- Try brew
        pilot brew_res = process::exec("brew install llvm")
        if brew_res == 0 { give back 0 }
        -- Fallback: xcode command line tools
        process::exec("xcode-select --install")
        say "  " + C_DIM + "If prompted, complete the Xcode CLT install then rerun 'freak doctor'" + C_RESET
        give back 0
    }
    give back 1
}

task cli_doctor(fix_mode: bool) -> void {
    -- Detect OS
    pilot os_tag = "unix"
    pilot is_win = false
    pilot windir_env: word = process::env("WINDIR")
    if windir_env != "" {
        os_tag = "windows"
        is_win = true
    } else {
        pilot uname_out: word = process::exec_capture("uname -s 2>/dev/null")
        if uname_out.contains("Darwin") { os_tag = "macos" }
        else { os_tag = "linux" }
    }

    say ""
    say cli_box_top(50)
    if fix_mode {
        say cli_box_mid(" " + C_G1 + SYM_GEAR + " FREAK DOCTOR" + C_RESET + C_DIM + " --fix  repairing..." + C_RESET, 50)
    } else {
        say cli_box_mid(" " + C_G1 + SYM_GEAR + " FREAK DOCTOR" + C_RESET + C_DIM + "  diagnosing your setup..." + C_RESET, 50)
    }
    say cli_box_bot(50)
    say ""

    pilot all_ok = true
    pilot checks_passed = 0

    -- ── 1. clang ──────────────────────────────────────────
    say "  " + C_BWHITE + "[1/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " clang"
    pilot clang_exit = process::exec("clang --version")
    if clang_exit == 0 {
        pilot clang_ver: word = process::exec_capture("clang --version")
        -- First line of clang version output
        pilot cv_line = ""
        pilot cvi = 0
        pilot cv_done = false
        repeat until cv_done {
            if cvi >= clang_ver.length() { cv_done = true }
            else {
                pilot cch: word = clang_ver.char_at(cvi)
                if cch == "\n" or cch == "\r" { cv_done = true }
                else { cv_line = cv_line + cch }
            }
            cvi += 1
        }
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + C_DIM + cv_line + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " clang " + C_RED + "not found" + C_RESET
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Attempting auto-install..." + C_RESET
            pilot clang_fix = cli_install_clang(os_tag)
            if clang_fix == 0 {
                say "        " + C_BGREEN + SYM_CHECK + C_RESET + " clang installed!"
                checks_passed += 1
                all_ok = true
            }
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak doctor --fix" + C_RESET
            if is_win {
                say "         or: " + C_CYAN + "winget install LLVM.LLVM" + C_RESET
            } else if os_tag == "linux" {
                say "         or: " + C_CYAN + "sudo apt install clang lld" + C_RESET
            } else if os_tag == "macos" {
                say "         or: " + C_CYAN + "xcode-select --install" + C_RESET
            }
        }
    }
    say ""

    -- ── 2. lld (linker) ───────────────────────────────────
    say "  " + C_BWHITE + "[2/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " lld linker"
    pilot lld_found = false
    if is_win {
        -- "where" checks PATH without running the binary
        pilot lld_exit = process::exec("where lld-link")
        if lld_exit == 0 { lld_found = true }
    } else {
        pilot lld_exit = process::exec("ld.lld --version")
        if lld_exit == 0 { lld_found = true }
    }
    if lld_found {
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " lld found " + C_DIM + "(bundle mode available)" + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BYELLOW + SYM_RING + C_RESET + " lld not found " + C_DIM + "(optional — clang can link too)" + C_RESET
        checks_passed += 1
    }
    say ""

    -- ── 3. Runtime ────────────────────────────────────────
    say "  " + C_BWHITE + "[3/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " runtime"
    pilot rt_dir: word = cli_find_runtime_dir()
    if rt_dir != "" {
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + C_DIM + rt_dir + C_RESET
        pilot has_obj = false
        if is_win {
            has_obj = fs::exists(rt_dir + "/freak_runtime.obj")
        } else {
            has_obj = fs::exists(rt_dir + "/freak_runtime.o")
        }
        if has_obj {
            say "        " + C_BGREEN + SYM_CHECK + C_RESET + C_DIM + " pre-compiled objects (fast bundle mode)" + C_RESET
        } else {
            say "        " + C_BYELLOW + SYM_RING + C_RESET + C_DIM + " no pre-compiled objects (source fallback active)" + C_RESET
        }
        if fs::exists(rt_dir + "/freak_llvm_runtime.c") {
            say "        " + C_BGREEN + SYM_CHECK + C_RESET + C_DIM + " LLVM runtime available" + C_RESET
        }
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " runtime directory not found"
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Downloading runtime..." + C_RESET
            -- Re-run the upgrade to get runtime files
            hangar_install_freak()
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak upgrade" + C_RESET + " or re-run install script"
        }
    }
    say ""

    -- ── 4. Standard library ───────────────────────────────
    say "  " + C_BWHITE + "[4/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " standard library"
    pilot std_dir: word = cli_find_std_dir()
    if std_dir != "" {
        pilot mod_count = 0
        if fs::exists(std_dir + "/math.fk")      { mod_count += 1 }
        if fs::exists(std_dir + "/math3d.fk")    { mod_count += 1 }
        if fs::exists(std_dir + "/zip.fk")       { mod_count += 1 }
        if fs::exists(std_dir + "/string.fk")    { mod_count += 1 }
        if fs::exists(std_dir + "/convert.fk")   { mod_count += 1 }
        if fs::exists(std_dir + "/algorithm.fk") { mod_count += 1 }
        if fs::exists(std_dir + "/json.fk")      { mod_count += 1 }
        if fs::exists(std_dir + "/http.fk")      { mod_count += 1 }
        if fs::exists(std_dir + "/version.fk")   { mod_count += 1 }
        if fs::exists(std_dir + "/runtime.fk")   { mod_count += 1 }
        say "        " + C_BGREEN + SYM_CHECK + C_RESET + " " + word_from_int(mod_count) + "/10 modules in " + C_DIM + std_dir + C_RESET
        checks_passed += 1
    } else {
        say "        " + C_BRED + SYM_CROSS + C_RESET + " standard library not found"
        all_ok = false
        if fix_mode {
            say "        " + C_DIM + "Re-run upgrade to download std..." + C_RESET
            hangar_install_freak()
        } else {
            say "        " + C_DIM + "Fix: " + C_RESET + "run " + C_BWHITE + "freak upgrade" + C_RESET
        }
    }
    say ""

    -- ── 5. Compile pipeline test ──────────────────────────
    say "  " + C_BWHITE + "[5/5]" + C_RESET + " " + C_DIM + "Checking" + C_RESET + " compile pipeline"
    if clang_exit == 0 and rt_dir != "" {
        pilot test_src = "say \"FREAK doctor test\""
        pilot test_path = "_freak_doctor_test.fk"
        fs::write(test_path, test_src)
        pilot transpiled: word = cli_transpile(test_path, test_src, "llvm")
        if transpiled != "" {
            pilot bin: word = cli_build_binary(transpiled, test_path, "llvm", "2", "")
            if bin != "" {
                say "        " + C_BGREEN + SYM_CHECK + C_RESET + " full pipeline works"
                fs::delete(bin)
                checks_passed += 1
            } else {
                say "        " + C_BRED + SYM_CROSS + C_RESET + " clang compilation error (see above)"
                all_ok = false
            }
            fs::delete(transpiled)
        } else {
            say "        " + C_BRED + SYM_CROSS + C_RESET + " transpilation error"
            all_ok = false
        }
        fs::delete(test_path)
    } else {
        say "        " + C_BYELLOW + SYM_RING + C_RESET + C_DIM + " skipped (fix missing clang/runtime first)" + C_RESET
    }
    say ""

    -- ── Summary ───────────────────────────────────────────
    say cli_box_top(50)
    if all_ok {
        say cli_box_mid(" " + C_BGREEN + SYM_SPARK + " ALL SYSTEMS GO" + C_RESET + "  " + C_DIM + word_from_int(checks_passed) + "/5 passed" + C_RESET, 50)
        say cli_box_sep(50)
        say cli_box_mid("  " + C_DIM + "Get started:" + C_RESET + "  freak build hello.fk", 50)
    } else {
        say cli_box_mid(" " + C_BRED + SYM_CROSS + " ISSUES FOUND" + C_RESET + "  " + C_DIM + word_from_int(checks_passed) + "/5 passed" + C_RESET, 50)
        say cli_box_sep(50)
        if fix_mode {
            say cli_box_mid("  Run " + C_BWHITE + "freak doctor" + C_RESET + " to verify fixes", 50)
        } else {
            say cli_box_mid("  Run " + C_BWHITE + "freak doctor --fix" + C_RESET + " to auto-repair", 50)
        }
    }
    say cli_box_bot(50)
    say ""
}
-- ===================================================================
-- FREAK CLI — Audit Command Shims
-- ===================================================================
-- Bridges native CLI audit subcommands to the Python implementation in
-- freakc/auditor.py. A native FREAK port of the audit logic is planned
-- for V4; this shim closes the v0.13.x conformance gap (bible §13).
-- Subcommands handled:
--   audit-science      list 'for science,' call sites
--   audit-trust        list 'trust me' blocks with honor levels
--   audit-miracles     list 'deus_ex_machina' blocks (>3 warn, >10 err)
--   foreshadow-audit   foreshadow/payoff pairs and unpaid debt
--   audit-conformance  v0.13.x conformance check vs the bible
-- ===================================================================

task cli_audit_dispatch(subcmd: word, args_cnt: int) -> int {
    -- Build the Python invocation from arg(1) (the subcommand) onwards.
    -- Native CLI argv: arg(0)=binary, arg(1)=subcmd, arg(2..)=user args.
    pilot cmd = "python -m freakc " + subcmd

    pilot ai = 2
    repeat until ai >= args_cnt {
        pilot extra: word = process::arg(ai)
        cmd = cmd + " " + extra
        ai += 1
    }

    pilot exit_code = process::exec(cmd)
    if exit_code != 0 {
        say ""
        say "  " + C_DIM + "Note: audit commands currently shell out to the Python CLI." + C_RESET
        say "  " + C_DIM + "If Python is missing, install Python 3.10+ and try again." + C_RESET
        say "  " + C_DIM + "(Native FREAK port of the auditor lands in V4.)" + C_RESET
    }
    give back exit_code
}
-- ===================================================================
-- FREAK CLI - Academy Learning Mode Shim
-- ===================================================================
-- Bridges native `freak learn` to the V3-first Python Academy
-- implementation. The Academy engine is still staged in Python until the
-- V4 query compiler and eventual FREAK rewrite can own it cleanly.
-- ===================================================================

task cli_learn_quote_arg(arg: word) -> word {
    give back "\"" + arg.replace("\"", "\\\"") + "\""
}

task cli_learn_dispatch(args_cnt: int) -> int {
    -- Native CLI argv: arg(0)=binary, arg(1)=learn, arg(2..)=learn args.
    pilot cmd = "python -m freakc learn"

    pilot ai = 2
    repeat until ai >= args_cnt {
        pilot extra: word = process::arg(ai)
        cmd = cmd + " " + cli_learn_quote_arg(extra)
        ai += 1
    }

    pilot exit_code = process::exec(cmd)
    if exit_code != 0 {
        say ""
        say "  " + C_DIM + "Note: `freak learn` currently shells out to the Python Academy CLI." + C_RESET
        say "  " + C_DIM + "If Python is missing, install Python 3.10+ and try again." + C_RESET
        say "  " + C_DIM + "(The FREAK-native Academy rewrite lands after the V4 query surface is ready.)" + C_RESET
    }
    give back exit_code
}
-- ===================================================================
-- FREAK CLI — Main Entry Point
-- ===================================================================
-- Replaces the Python `python -m freakc` CLI with a native FREAK binary.
-- Dispatches to subcommands: build, run, check, transpile, learn, version, help.
-- ===================================================================

task cli_parse_flags(start_idx: int, args_cnt: int) -> word {
    -- Parse flags from command line args starting at start_idx.
    -- Returns a colon-delimited string: "target:opt:cross"
    -- Side effect: --strict-borrow flips the global `strict_borrow`
    -- so check_program() runs the borrow checker in-process.
    pilot target = "llvm"
    pilot opt = "2"
    pilot cross = ""
    strict_borrow = false

    pilot fi = start_idx
    repeat until fi >= args_cnt {
        pilot flag: word = process::arg(fi)
        if flag == "--c" {
            target = "c"
        } else if flag == "--llvm" {
            target = "llvm"
        } else if flag == "--strict-borrow" {
            strict_borrow = true
        } else if flag.starts_with("--opt=") {
            opt = flag.char_at(6)
        } else if flag.starts_with("--target=") {
            pilot ti = 9
            pilot tval = ""
            repeat until ti >= flag.length() {
                tval = tval + flag.char_at(ti)
                ti += 1
            }
            cross = tval
        }
        fi += 1
    }

    give back target + ":" + opt + ":" + cross
}

task cli_extract_flag(flags: word, idx: int) -> word {
    -- Extract the nth colon-delimited field from flags string.
    pilot res = ""
    pilot current = 0
    pilot i = 0
    pilot flen = flags.length()
    repeat until i >= flen {
        pilot c: word = flags.char_at(i)
        if c == ":" {
            if current == idx {
                give back res
            }
            current += 1
            res = ""
        } else {
            res = res + c
        }
        i += 1
    }
    if current == idx {
        give back res
    }
    give back ""
}

-- ── Flex Command (easter egg) ────────────────────────
task cli_flex() -> void {
    cli_show_banner()

    say cli_box_top(50)
    say cli_box_mid(" " + C_G1 + SYM_FIRE + " FREAK FLEXING" + C_RESET, 50)
    say cli_box_sep(50)
    say cli_box_mid("  " + C_BWHITE + "Language" + C_RESET + "        FREAK " + C_DIM + "(.fk)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Version" + C_RESET + "         " + CLI_VERSION + " " + C_DIM + CLI_CODENAME + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Self-hosting" + C_RESET + "    " + C_BGREEN + SYM_CHECK + " YES" + C_RESET + C_DIM + " (compiler compiles itself)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Backends" + C_RESET + "        " + C_BCYAN + "LLVM IR" + C_RESET + " + " + C_BYELLOW + "C" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Cross-compile" + C_RESET + "   " + C_BGREEN + SYM_CHECK + " YES" + C_RESET + C_DIM + " (--target=TRIPLE)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Package mgr" + C_RESET + "     " + C_BGREEN + SYM_CHECK + " Hangar" + C_RESET + C_DIM + " (built-in)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "GUI framework" + C_RESET + "   " + C_BGREEN + SYM_CHECK + " freak-ui" + C_RESET + C_DIM + " (immediate mode)" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Platforms" + C_RESET + "       " + C_BCYAN + "Windows" + C_RESET + " / " + C_BGREEN + "Linux" + C_RESET + " / " + C_BWHITE + "macOS" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Std library" + C_RESET + "     " + C_DIM + "math, string, json, http, fs..." + C_RESET, 50)
    say cli_box_sep(50)
    say cli_box_mid("  " + C_BWHITE + "Aesthetic" + C_RESET + "       " + C_G1 + "A" + C_G2 + "n" + C_G3 + "i" + C_G4 + "m" + C_G5 + "e" + C_G6 + "-" + C_G1 + "c" + C_G2 + "o" + C_G3 + "r" + C_G4 + "e" + C_RESET, 50)
    say cli_box_mid("  " + C_BWHITE + "Vibe" + C_RESET + "            " + C_BMAGENTA + "MAXIMUM" + C_RESET, 50)
    say cli_box_bot(50)
    say ""

    -- Count .fk files in tests/ as a flex metric
    say "  " + C_DIM + C_ITALIC + "\"My compiler compiles itself. Does yours?\"" + C_RESET
    say ""
}

-- ── Init Command ─────────────────────────────────────
task cli_init(project_name: word) -> void {
    say ""
    say "  " + C_G1 + SYM_SPARK + " Creating project: " + C_RESET + C_BWHITE + project_name + C_RESET
    say ""

    -- Create project directory
    pilot mkdir_cmd = "mkdir " + project_name
    process::exec(mkdir_cmd)

    -- Create main.fk
    pilot main_content = "-- " + project_name + "\n-- Created with FREAK " + CLI_VERSION + "\n\nsay \"Hello from " + project_name + "!\"\n"
    fs::write(project_name + "/main.fk", main_content)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + " " + project_name + "/main.fk"

    -- Create hangar.toml
    pilot toml_content = "[project]\nname = \"" + project_name + "\"\nversion = \"0.1.0\"\n\n[dependencies]\n"
    fs::write(project_name + "/hangar.toml", toml_content)
    say "  " + C_BGREEN + SYM_CHECK + C_RESET + " " + project_name + "/hangar.toml"

    say ""
    say "  " + C_DIM + "Get started:" + C_RESET
    say "    " + C_BWHITE + "cd " + project_name + C_RESET
    say "    " + C_BWHITE + "freak run main.fk" + C_RESET
    say ""
}

-- ── Standalone Hangar Dispatch ────────────────────────
-- When invoked as "hangar" (BusyBox pattern), args shift by 1:
--   hangar init   → process::arg(0)="hangar", arg(1)="init"
-- vs freak hangar init → arg(0)="freak", arg(1)="hangar", arg(2)="init"
task hangar_standalone_main() -> void {
    pilot args_cnt = process::args_count()

    -- Set the global offset so hangar_arg(N) reads process::arg(N-1)
    hangar_arg_offset = 1

    -- Adjust args_cnt to match what hangar_dispatch expects
    -- (it checks args_cnt < 3, expects subcmd at hangar_arg(2) which becomes arg(1))
    hangar_dispatch(args_cnt + 1)
}

-- ── Main Dispatch ────────────────────────────────────
task freakc_cli_main() -> void {
    pilot args_cnt = process::args_count()

    -- BusyBox pattern: check if invoked as "hangar"
    pilot argv0: word = process::arg(0)
    if argv0.ends_with("hangar") or argv0.ends_with("hangar.exe") {
        hangar_standalone_main()
        give back
    }

    if args_cnt < 2 {
        cli_show_help()
        give back
    }

    pilot subcmd: word = process::arg(1)

    -- Handle global flags before subcommands
    if subcmd == "--version" or subcmd == "-V" {
        cli_show_version()
        give back
    }
    if subcmd == "--help" or subcmd == "-h" or subcmd == "help" {
        cli_show_help()
        give back
    }
    if subcmd == "version" {
        cli_show_version()
        give back
    }

    -- Flex easter egg
    if subcmd == "flex" {
        cli_flex()
        give back
    }

    -- Quick init
    if subcmd == "init" {
        if args_cnt < 3 {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " init requires a project name."
            say "  " + C_DIM + "Usage: " + C_RESET + "freak init <project-name>"
            say ""
            give back
        }
        cli_init(process::arg(2))
        give back
    }

    -- Subcommands that require a file argument
    if subcmd == "build" or subcmd == "run" or subcmd == "check" or subcmd == "transpile" {
        if args_cnt < 3 {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " " + subcmd + " requires a file argument."
            say "  " + C_DIM + "Usage: " + C_RESET + "freak " + subcmd + " <file.fk> [options]"
            say ""
            give back
        }

        pilot src_file: word = process::arg(2)
        pilot flags: word = cli_parse_flags(3, args_cnt)
        pilot target: word = cli_extract_flag(flags, 0)
        pilot opt: word = cli_extract_flag(flags, 1)
        pilot cross: word = cli_extract_flag(flags, 2)

        if subcmd == "build" {
            pilot binary: word = cli_build(src_file, target, opt, cross)
            if binary == "" {
                process::exit(1)
            }
        } else if subcmd == "run" {
            cli_run(src_file, target, opt, cross)
        } else if subcmd == "check" {
            -- Type-check only: read, lex, parse, check — no emit
            pilot source: word = fs::read(src_file)
            if source == "" {
                say ""
                say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + C_BWHITE + src_file + C_RESET
                say ""
                process::exit(1)
            }
            say ""
            say "  " + C_G3 + SYM_GEAR + " CHECKING" + C_RESET + " " + C_BWHITE + src_file + C_RESET
            say ""
            init_arrays()
            cli_step_start()
            tokenize(source)
            cli_step_done("Lexing")
            cli_step_start()
            parse_program()
            cli_step_done("Parsing")
            cli_step_start()
            check_program()
            cli_step_done("Type checking")
            say ""
            say "  " + C_BGREEN + SYM_SPARK + " PASSED" + C_RESET + C_DIM + " -- no type errors found" + C_RESET
            say ""
        } else if subcmd == "transpile" {
            -- Transpile only
            pilot source: word = fs::read(src_file)
            if source == "" {
                say ""
                say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + src_file
                say ""
                process::exit(1)
            }
            pilot transpiled: word = cli_transpile(src_file, source, target)
            if transpiled == "" {
                process::exit(1)
            }
        }

        give back
    }

    -- Upgrade (download latest FREAK)
    if subcmd == "upgrade" {
        say ""
        say cli_box_top(45)
        say cli_box_mid(" " + C_G1 + SYM_ROCKET + " FREAK UPGRADE" + C_RESET, 45)
        say cli_box_sep(45)
        say cli_box_mid("  " + C_DIM + "Current: " + C_RESET + C_BWHITE + CLI_VERSION + C_RESET + " " + C_DIM + CLI_CODENAME + C_RESET, 45)
        say cli_box_bot(45)
        say ""
        pilot upgrade_res = hangar_install_freak()
        if upgrade_res == 0 {
            say ""
            say "  " + C_DIM + C_ITALIC + cli_random_quote(time::now_ms()) + C_RESET
            say ""
        }
        give back
    }

    -- Doctor (setup diagnostics)
    if subcmd == "doctor" {
        pilot fix_mode = false
        if args_cnt >= 3 {
            if process::arg(2) == "--fix" { fix_mode = true }
        }
        cli_doctor(fix_mode)
        give back
    }

    -- Hangar package manager
    if subcmd == "hangar" {
        hangar_dispatch(args_cnt)
        give back
    }

    -- FREAK Academy terminal learner (V3 shim; native rewrite is V4+)
    if subcmd == "learn" {
        pilot learn_exit = cli_learn_dispatch(args_cnt)
        if learn_exit != 0 {
            process::exit(learn_exit)
        }
        give back
    }

    -- Audit commands (shell out to Python; native port lands in V4)
    if subcmd == "audit-science" or subcmd == "audit-trust" or subcmd == "audit-miracles" or subcmd == "foreshadow-audit" or subcmd == "audit-conformance" {
        pilot audit_exit = cli_audit_dispatch(subcmd, args_cnt)
        if audit_exit != 0 {
            process::exit(audit_exit)
        }
        give back
    }

    -- Test runner shim (wraps the Python suite runner; native runner is V4)
    if subcmd == "test" {
        pilot test_exit = process::exec("python tests/suite/run_tests.py")
        if test_exit != 0 {
            process::exit(test_exit)
        }
        give back
    }

    -- Legacy mode: first arg is a .fk file (backwards compat with freakc_v2 behavior)
    if subcmd.ends_with(".fk") {
        pilot flags: word = cli_parse_flags(2, args_cnt)
        pilot target: word = cli_extract_flag(flags, 0)

        pilot source: word = fs::read(subcmd)
        if source == "" {
            say ""
            say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Could not read file: " + subcmd
            say ""
            process::exit(1)
        }

        pilot msg = "FREAK v2 Compiling: " + subcmd + " (Target: " + target + ")"
        say msg

        pilot transpiled: word = cli_transpile(subcmd, source, target)
        if transpiled == "" {
            process::exit(1)
        }
        give back
    }

    -- Unknown subcommand
    say ""
    say "  " + C_BRED + SYM_CROSS + " ERROR" + C_RESET + " Unknown command '" + C_BWHITE + subcmd + C_RESET + "'"
    say "  " + C_DIM + "Run '" + C_RESET + "freak help" + C_DIM + "' for usage." + C_RESET
    say ""
}

freakc_cli_main()
