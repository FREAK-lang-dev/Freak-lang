-- MUVLUV library: declarations only; importing does not run a showcase.
-- The complete historical program lives in examples/beta_early_warning.fk.

shape Eishi {
    name: word,
    power: int,
    callsign: word,
    status: word
}

impl Eishi {
    task introduce(self) -> void {
        say "{self.callsign} ({self.name}) — Power: {self.power}, Status: {self.status}"
    }

    task power_up(self, amount: int) -> void {
        self.power = self.power + amount
    }
}

shape TSF {
    model: word,
    variant: word,
    weapon: word,
    os_ver: word
}

impl TSF {
    task display(self) -> void {
        say "TSF: {self.model} [{self.variant}] | Weapon: {self.weapon} | OS: {self.os_ver}"
    }
}

task tier_name(tier: int) -> word {
    when tier {
        1 -> give back "Soldier"
        2 -> give back "Grappler"
        3 -> give back "Destroyer"
        4 -> give back "Tank"
        5 -> give back "Laser"
        6 -> give back "Fort"
        7 -> give back "BRAIN"
    }
    give back "Unknown"
}

task required_power(tier: int) -> int {
    when tier {
        1 -> give back 10
        2 -> give back 25
        3 -> give back 50
        4 -> give back 100
        5 -> give back 200
        6 -> give back 500
        7 -> give back 9999
    }
    give back 0
}

task tier_threat(tier: int) -> word {
    if tier >= 7 { give back "EXTINCTION" }
    if tier >= 5 { give back "CRITICAL" }
    if tier >= 3 { give back "HIGH" }
    give back "MODERATE"
}

task cosmo_strike(target: word, power: int) -> void {
    say "=== COSMO ORBITAL STRIKE ==="
    say "Target: {target}"
    say "Yield: {power} terajoules"
    say "Status: CONFIRMED — Firing in 3... 2... 1..."
    say ">>> IMPACT <<<"
    say ""
}

task yuuko_analyze(subject: word) -> void {
    say "[YuukoLab] Analyzing: {subject}..."
    say "[YuukoLab] Analysis complete. Results classified."
}

task yuuko_log(msg: word) -> void {
    say "[YuukoLab] {msg}"
}
