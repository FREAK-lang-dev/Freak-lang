-- RFC 9112 section 5: validate field lines as bytes, with no obs-fold or
-- whitespace before the colon. This is bounded syntax validation, not a
-- general HTTP field-value/message-body implementation.
task ordnance_field_name_byte(byte: int) -> bool {
    if byte < 33 or byte > 126 { give back false }
    if byte >= 48 and byte <= 57 { give back true }
    if byte >= 65 and byte <= 90 { give back true }
    if byte >= 97 and byte <= 122 { give back true }
    give back "!#$%&'*+-.^_`|~".contains(char_to_word(byte))
}

task ordnance_headers_valid(request: ByteBuffer) -> bool {
    if request.status() != 0 or request.length() > 65536 { give back false }
    request.seek("GET /hello HTTP/1.1\r\n".length())
    repeat until request.remaining() <= 0 {
        pilot byte = request.read_byte()
        if byte == 13 {
            if request.remaining() <= 0 { give back false }
            give back request.read_byte() == 10
        }
        pilot name_length = 0
        repeat until byte == 58 {
            if not ordnance_field_name_byte(byte) { give back false }
            name_length += 1
            if request.remaining() <= 0 { give back false }
            byte = request.read_byte()
        }
        if name_length == 0 { give back false }
        pilot line_complete = false
        repeat until line_complete {
            if request.remaining() <= 0 { give back false }
            byte = request.read_byte()
            if byte == 13 {
                if request.remaining() <= 0 { give back false }
                if request.read_byte() != 10 { give back false }
                line_complete = true
            } else if (byte < 32 and byte != 9) or byte == 127 {
                give back false
            }
        }
    }
    give back false
}

task main() {
    pilot port = 0
    pilot connection_limit = 1
    if process::args_count() > 1 { port = word_to_int(process::arg(1)) }
    if process::args_count() > 2 {
        connection_limit = word_to_int(process::arg(2))
    }
    if port < 0 or port > 65535 or connection_limit <= 0 {
        say "ORDNANCE_ERROR invalid arguments"
        process::exit(2)
    }

    pilot listener = tcp::socket_listen("127.0.0.1", port, 16)
    if tcp::socket_status(listener) != 0 {
        say "ORDNANCE_ERROR listen " + word_from_int(tcp::socket_status(listener))
        tcp::socket_close(listener)
        process::exit(3)
    }
    say "ORDNANCE_READY " + word_from_int(tcp::socket_local_port(listener))

    pilot accepted = 0
    repeat until accepted >= connection_limit {
        pilot client = tcp::socket_accept(listener)
        if tcp::socket_status(client) != 0 {
            tcp::socket_close(client)
            tcp::socket_close(listener)
            process::exit(4)
        }
        -- Keep one idle or abandoned request from monopolizing this
        -- intentionally sequential acceptance server.
        tcp::socket_set_timeout(client, 250, 250)

        pilot request: ByteBuffer = ByteBuffer::with_capacity(4096)
        pilot request_text = ""
        pilot headers_complete = false
        pilot bad_request = false
        pilot header_start = time::monotonic_ns()
        if header_start < 0 { bad_request = true }
        repeat until headers_complete or bad_request {
            -- Bound the whole header, including clients that keep sending
            -- before each individual receive timeout expires.
            pilot header_now = time::monotonic_ns()
            if header_now < header_start or header_now - header_start >= 2000000000 {
                bad_request = true
            }
            pilot received = 0
            if not bad_request {
                received = tcp::socket_receive(client, request, 4096)
                header_now = time::monotonic_ns()
                if header_now < header_start or header_now - header_start >= 2000000000 {
                    bad_request = true
                }
            }
            if received > 0 {
                if request.length() > 65536 {
                    bad_request = true
                } else {
                    request_text = request.to_word()
                    if request.status() != 0 {
                        bad_request = true
                    } else if request_text.contains("\r\n\r\n") {
                        headers_complete = true
                    }
                }
            } else if tcp::socket_eof(client) {
                bad_request = true
            } else if tcp::socket_status(client) != 0 {
                bad_request = true
            }
        }

        pilot response: ByteBuffer = ByteBuffer::with_capacity(160)
        if headers_complete and not bad_request and request_text.starts_with("GET /hello HTTP/1.1\r\n") and ordnance_headers_valid(request) {
            response.write_word("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 28\r\nConnection: close\r\n\r\n{\"message\":\"FREAKING WORKS\"}")
        } else {
            response.write_word("HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nbad request")
        }
        tcp::socket_send_all(client, response, 0, response.length())
        response.release()
        request.release()
        tcp::socket_close(client)
        accepted += 1
    }
    tcp::socket_close(listener)
}
