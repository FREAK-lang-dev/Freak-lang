-- COCKPIT V3 compatibility: allocation-free LIFO integer layout.
-- One context is ten signed i64 fields in a preallocated ByteBuffer:
-- x, y, width, height, cursor_x, cursor_y, direction, gap, count, cross_max.

pilot cockpit_layout_vertical = 0
pilot cockpit_layout_horizontal = 1
pilot cockpit_layout_record_bytes = 80
pilot cockpit_layout_max_depth = 32

pilot cockpit_layout_error = 0
pilot cockpit_layout_rect_x = 0
pilot cockpit_layout_rect_y = 0
pilot cockpit_layout_rect_w = 0
pilot cockpit_layout_rect_h = 0
pilot cockpit_layout_consumed_w = 0
pilot cockpit_layout_consumed_h = 0

task cockpit_layout_capacity() -> int {
    give back cockpit_layout_record_bytes * cockpit_layout_max_depth
}

task cockpit_layout_release(layout: ByteBuffer) -> void {
    layout.release()
}

task cockpit_layout_clear(layout: ByteBuffer) -> void {
    if layout.status() != 0 { layout.clear_status() }
    layout.clear()
    cockpit_layout_error = 0
    cockpit_layout_rect_x = 0
    cockpit_layout_rect_y = 0
    cockpit_layout_rect_w = 0
    cockpit_layout_rect_h = 0
}

task cockpit_layout_status(layout: ByteBuffer) -> int {
    if layout.status() != 0 { give back layout.status() }
    give back cockpit_layout_error
}

task cockpit_layout_depth(layout: ByteBuffer) -> int {
    give back layout.length() / cockpit_layout_record_bytes
}

task cockpit_layout_field(layout: ByteBuffer, field: int) -> int {
    if layout.length() < cockpit_layout_record_bytes {
        cockpit_layout_error = 1
        give back 0
    }
    pilot offset = layout.length() - cockpit_layout_record_bytes + field * 8
    layout.seek(offset)
    give back layout.read_int()
}

task cockpit_layout_append_context(layout: ByteBuffer, x: int, y: int, width: int, height: int, direction: int, gap: int) -> void {
    if width < 0 { width = 0 }
    if height < 0 { height = 0 }
    if gap < 0 { gap = 0 }
    if cockpit_layout_depth(layout) >= cockpit_layout_max_depth {
        cockpit_layout_error = 2
        give back
    }
    layout.write_int(x)
    layout.write_int(y)
    layout.write_int(width)
    layout.write_int(height)
    layout.write_int(x)
    layout.write_int(y)
    layout.write_int(direction)
    layout.write_int(gap)
    layout.write_int(0)
    layout.write_int(0)
}

task cockpit_layout_begin_frame(layout: ByteBuffer, width: int, height: int, padding: int, gap: int) -> void {
    cockpit_layout_clear(layout)
    pilot inner_w = width - padding * 2
    pilot inner_h = height - padding * 2
    if inner_w < 0 { inner_w = 0 }
    if inner_h < 0 { inner_h = 0 }
    cockpit_layout_append_context(layout, padding, padding, inner_w, inner_h, cockpit_layout_vertical, gap)
}

task cockpit_layout_remaining_width(layout: ByteBuffer) -> int {
    pilot direction = cockpit_layout_field(layout, 6)
    pilot width = cockpit_layout_field(layout, 2)
    if direction == cockpit_layout_horizontal {
        pilot used = cockpit_layout_field(layout, 4) - cockpit_layout_field(layout, 0)
        pilot remaining = width - used
        if remaining < 0 { give back 0 }
        give back remaining
    }
    give back width
}

task cockpit_layout_remaining_height(layout: ByteBuffer) -> int {
    pilot direction = cockpit_layout_field(layout, 6)
    pilot height = cockpit_layout_field(layout, 3)
    if direction == cockpit_layout_vertical {
        pilot used = cockpit_layout_field(layout, 5) - cockpit_layout_field(layout, 1)
        pilot remaining = height - used
        if remaining < 0 { give back 0 }
        give back remaining
    }
    give back height
}

task cockpit_layout_replace_top(layout: ByteBuffer, x: int, y: int, width: int, height: int, cursor_x: int, cursor_y: int, direction: int, gap: int, count: int, cross_max: int) -> void {
    pilot top = layout.length() - cockpit_layout_record_bytes
    layout.truncate(top)
    layout.write_int(x)
    layout.write_int(y)
    layout.write_int(width)
    layout.write_int(height)
    layout.write_int(cursor_x)
    layout.write_int(cursor_y)
    layout.write_int(direction)
    layout.write_int(gap)
    layout.write_int(count)
    layout.write_int(cross_max)
}

task cockpit_layout_allocate(layout: ByteBuffer, width: int, height: int) -> void {
    if cockpit_layout_error != 0 { give back }
    if cockpit_layout_depth(layout) <= 0 {
        cockpit_layout_error = 1
        give back
    }
    if width < 0 { width = 0 }
    if height < 0 { height = 0 }
    pilot x = cockpit_layout_field(layout, 0)
    pilot y = cockpit_layout_field(layout, 1)
    pilot max_w = cockpit_layout_field(layout, 2)
    pilot max_h = cockpit_layout_field(layout, 3)
    pilot cursor_x = cockpit_layout_field(layout, 4)
    pilot cursor_y = cockpit_layout_field(layout, 5)
    pilot direction = cockpit_layout_field(layout, 6)
    pilot gap = cockpit_layout_field(layout, 7)
    pilot count = cockpit_layout_field(layout, 8)
    pilot cross_max = cockpit_layout_field(layout, 9)

    if count > 0 {
        if direction == cockpit_layout_horizontal { cursor_x += gap }
        else { cursor_y += gap }
    }
    pilot available_w = x + max_w - cursor_x
    pilot available_h = y + max_h - cursor_y
    if available_w < 0 { available_w = 0 }
    if available_h < 0 { available_h = 0 }
    if width > available_w { width = available_w }
    if height > available_h { height = available_h }
    cockpit_layout_rect_x = cursor_x
    cockpit_layout_rect_y = cursor_y
    cockpit_layout_rect_w = width
    cockpit_layout_rect_h = height

    if direction == cockpit_layout_horizontal {
        cursor_x += width
        if height > cross_max { cross_max = height }
    } else {
        cursor_y += height
        if width > cross_max { cross_max = width }
    }
    cockpit_layout_replace_top(layout, x, y, max_w, max_h, cursor_x, cursor_y, direction, gap, count + 1, cross_max)
}

task cockpit_layout_begin_row(layout: ByteBuffer, height: int, gap: int) -> void {
    cockpit_layout_begin_child(layout, cockpit_layout_remaining_width(layout), height, cockpit_layout_horizontal, gap)
}

task cockpit_layout_begin_column(layout: ByteBuffer, width: int, gap: int) -> void {
    cockpit_layout_begin_child(layout, width, cockpit_layout_remaining_height(layout), cockpit_layout_vertical, gap)
}

task cockpit_layout_begin_child(layout: ByteBuffer, width: int, height: int, direction: int, gap: int) -> void {
    if cockpit_layout_error != 0 { give back }
    pilot x = cockpit_layout_field(layout, 4)
    pilot y = cockpit_layout_field(layout, 5)
    pilot available_w = cockpit_layout_remaining_width(layout)
    pilot available_h = cockpit_layout_remaining_height(layout)
    if cockpit_layout_field(layout, 8) > 0 {
        pilot parent_gap = cockpit_layout_field(layout, 7)
        if cockpit_layout_field(layout, 6) == cockpit_layout_horizontal { x += parent_gap available_w -= parent_gap }
        else { y += parent_gap available_h -= parent_gap }
    }
    if width > available_w { width = available_w }
    if height > available_h { height = available_h }
    if width < 0 { width = 0 }
    if height < 0 { height = 0 }
    cockpit_layout_append_context(layout, x, y, width, height, direction, gap)
}

task cockpit_layout_end(layout: ByteBuffer) -> void {
    if cockpit_layout_error != 0 { give back }
    if cockpit_layout_depth(layout) <= 1 {
        cockpit_layout_error = 3
        give back
    }
    pilot x = cockpit_layout_field(layout, 0)
    pilot y = cockpit_layout_field(layout, 1)
    pilot cursor_x = cockpit_layout_field(layout, 4)
    pilot cursor_y = cockpit_layout_field(layout, 5)
    pilot direction = cockpit_layout_field(layout, 6)
    pilot cross_max = cockpit_layout_field(layout, 9)
    if direction == cockpit_layout_horizontal {
        cockpit_layout_consumed_w = cursor_x - x
        cockpit_layout_consumed_h = cross_max
    } else {
        cockpit_layout_consumed_w = cross_max
        cockpit_layout_consumed_h = cursor_y - y
    }
    layout.truncate(layout.length() - cockpit_layout_record_bytes)
    cockpit_layout_allocate(layout, cockpit_layout_consumed_w, cockpit_layout_consumed_h)
}

task cockpit_layout_last_x() -> int { give back cockpit_layout_rect_x }
task cockpit_layout_last_y() -> int { give back cockpit_layout_rect_y }
task cockpit_layout_last_width() -> int { give back cockpit_layout_rect_w }
task cockpit_layout_last_height() -> int { give back cockpit_layout_rect_h }
