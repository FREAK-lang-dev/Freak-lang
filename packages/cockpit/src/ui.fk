use self::layout::{
    cockpit_layout_begin_column,
    cockpit_layout_begin_frame,
    cockpit_layout_begin_row,
    cockpit_layout_end
}
use self::state::{
    cockpit_fail,
    cockpit_ui_begin_events,
    cockpit_ui_clip_depth,
    cockpit_ui_clip_stack,
    cockpit_ui_edits,
    cockpit_ui_feed_event,
    cockpit_ui_poll_result,
    cockpit_ui_reset
}
use self::theme::{
    cockpit_color_a,
    cockpit_color_b,
    cockpit_color_g,
    cockpit_color_r,
    cockpit_theme_bg,
    cockpit_theme_gap,
    cockpit_theme_get,
    cockpit_theme_padding
}
use self::widgets::{
    cockpit_popup_draw
}

-- COCKPIT frame/window facade. State and drawing modules are explicit inputs.

task cockpit_ui_open(title: word, width: int, height: int, resizable: bool) -> int {
    pilot resize_flag = 0
    if resizable { resize_flag = 1 }
    pilot window = ui::create_window(title, width, height, resize_flag)
    if window == 0 { give back 0 }
    cockpit_ui_reset()
    give back window
}

task cockpit_ui_close(window: int) -> void {
    ui::destroy_window(window)
    if cockpit_ui_edits != 0 { array_release(cockpit_ui_edits) cockpit_ui_edits = 0 }
    if cockpit_ui_clip_stack != 0 { array_release(cockpit_ui_clip_stack) cockpit_ui_clip_stack = 0 }
}

task cockpit_ui_begin_frame(window: int, layout: ByteBuffer, theme: int) -> void {
    cockpit_ui_clip_depth = 0
    cockpit_ui_begin_events()
    pilot event_count = ui::poll_events(window)
    cockpit_ui_poll_result(event_count)
    pilot index = 0
    repeat event_count times {
        pilot kind = ui::event_kind(index)
        pilot pressed = ui::event_pressed(index)
        if kind == 7 { pressed = ui::event_gained(index) }
        cockpit_ui_feed_event(kind, ui::event_key(index), ui::event_character(index), ui::event_button(index), pressed, ui::event_mouse_x(index), ui::event_mouse_y(index), ui::event_scroll_dy(index))
        index += 1
    }
    ui::begin_frame(window)
    pilot bg = cockpit_theme_get(theme, cockpit_theme_bg)
    ui::clear(window, cockpit_color_r(bg), cockpit_color_g(bg), cockpit_color_b(bg), cockpit_color_a(bg))
    cockpit_layout_begin_frame(layout, ui::get_width(window), ui::get_height(window), cockpit_theme_get(theme, cockpit_theme_padding), cockpit_theme_get(theme, cockpit_theme_gap))
}

task cockpit_ui_end_frame(window: int) -> void {
    if cockpit_ui_clip_depth != 0 { cockpit_fail("COCKPIT unclosed clipped container") }
    cockpit_popup_draw(window)
    ui::end_frame(window)
}

task cockpit_row_begin(layout: ByteBuffer, height: int, gap: int) -> void {
    cockpit_layout_begin_row(layout, height, gap)
}

task cockpit_column_begin(layout: ByteBuffer, width: int, gap: int) -> void {
    cockpit_layout_begin_column(layout, width, gap)
}

task cockpit_container_end(layout: ByteBuffer) -> void {
    cockpit_layout_end(layout)
}
