-- COCKPIT V3 compatibility: themes are explicitly owned scalar arrays.

pilot cockpit_theme_bg = 0
pilot cockpit_theme_surface = 1
pilot cockpit_theme_border = 2
pilot cockpit_theme_text = 3
pilot cockpit_theme_muted = 4
pilot cockpit_theme_accent = 5
pilot cockpit_theme_accent_hover = 6
pilot cockpit_theme_danger = 7
pilot cockpit_theme_success = 8
pilot cockpit_theme_font_size = 9
pilot cockpit_theme_padding = 10
pilot cockpit_theme_gap = 11

task cockpit_color_rgba(red: int, green: int, blue: int, alpha: int) -> int {
    give back red + green * 256 + blue * 65536 + alpha * 16777216
}

task cockpit_color_r(color: int) -> int { give back color % 256 }
task cockpit_color_g(color: int) -> int { give back (color / 256) % 256 }
task cockpit_color_b(color: int) -> int { give back (color / 65536) % 256 }
task cockpit_color_a(color: int) -> int { give back (color / 16777216) % 256 }

task cockpit_theme_make(bg: int, surface: int, border: int, text: int, muted: int, accent: int, accent_hover: int, danger: int, success: int, font_size: int, padding: int, gap: int) -> int {
    pilot theme = cockpit_values_new()
    cockpit_values_push_int(theme, bg)
    cockpit_values_push_int(theme, surface)
    cockpit_values_push_int(theme, border)
    cockpit_values_push_int(theme, text)
    cockpit_values_push_int(theme, muted)
    cockpit_values_push_int(theme, accent)
    cockpit_values_push_int(theme, accent_hover)
    cockpit_values_push_int(theme, danger)
    cockpit_values_push_int(theme, success)
    cockpit_values_push_int(theme, font_size)
    cockpit_values_push_int(theme, padding)
    cockpit_values_push_int(theme, gap)
    give back theme
}

task cockpit_theme_dark() -> int {
    give back cockpit_theme_make(cockpit_color_rgba(22, 22, 30, 255), cockpit_color_rgba(38, 38, 54, 255), cockpit_color_rgba(58, 58, 78, 255), cockpit_color_rgba(230, 230, 240, 255), cockpit_color_rgba(128, 128, 160, 255), cockpit_color_rgba(100, 140, 255, 255), cockpit_color_rgba(130, 165, 255, 255), cockpit_color_rgba(255, 80, 80, 255), cockpit_color_rgba(80, 200, 120, 255), 14, 12, 8)
}

task cockpit_theme_light() -> int {
    give back cockpit_theme_make(cockpit_color_rgba(245, 245, 248, 255), cockpit_color_rgba(255, 255, 255, 255), cockpit_color_rgba(210, 210, 220, 255), cockpit_color_rgba(30, 30, 40, 255), cockpit_color_rgba(120, 120, 140, 255), cockpit_color_rgba(60, 100, 220, 255), cockpit_color_rgba(80, 120, 240, 255), cockpit_color_rgba(220, 50, 50, 255), cockpit_color_rgba(40, 160, 80, 255), 14, 12, 8)
}

task cockpit_theme_terminal() -> int {
    give back cockpit_theme_make(cockpit_color_rgba(0, 0, 0, 255), cockpit_color_rgba(15, 15, 15, 255), cockpit_color_rgba(0, 80, 0, 255), cockpit_color_rgba(0, 220, 0, 255), cockpit_color_rgba(0, 140, 0, 255), cockpit_color_rgba(0, 255, 0, 255), cockpit_color_rgba(80, 255, 80, 255), cockpit_color_rgba(255, 0, 0, 255), cockpit_color_rgba(0, 255, 0, 255), 13, 8, 4)
}

task cockpit_theme_alternative() -> int {
    give back cockpit_theme_make(cockpit_color_rgba(12, 15, 35, 255), cockpit_color_rgba(25, 30, 60, 255), cockpit_color_rgba(60, 50, 100, 255), cockpit_color_rgba(220, 220, 240, 255), cockpit_color_rgba(140, 130, 180, 255), cockpit_color_rgba(255, 45, 120, 255), cockpit_color_rgba(255, 80, 150, 255), cockpit_color_rgba(255, 60, 60, 255), cockpit_color_rgba(60, 220, 160, 255), 14, 14, 10)
}

task cockpit_theme_get(theme: int, field: int) -> int {
    give back cockpit_values_get_int(theme, field)
}

task cockpit_theme_release(theme: int) -> void {
    cockpit_values_release(theme)
}
