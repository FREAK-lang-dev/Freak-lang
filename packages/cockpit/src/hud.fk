    cockpit_widget_badge,
    cockpit_widget_bar_chart,
    cockpit_widget_collapsing,
    cockpit_widget_list,
    cockpit_widget_radio,
    cockpit_widget_sparkline,
    cockpit_widget_stepper,
    cockpit_widget_toggle
}
use self::flight::{
    cockpit_flight_begin_frame,
    cockpit_flight_close,
    cockpit_flight_end_frame,
    cockpit_flight_open
}
use self::layout::{
    cockpit_layout_capacity,
    cockpit_layout_last_height,
    cockpit_layout_last_width,
    cockpit_layout_last_x,
    cockpit_layout_last_y,
    cockpit_layout_release
}
