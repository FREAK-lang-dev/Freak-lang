    cockpit_modal_begin,
    cockpit_modal_close,
    cockpit_modal_end,
    cockpit_modal_open,
    cockpit_panel_begin,
    cockpit_panel_end,
    cockpit_scroll_begin,
    cockpit_scroll_end,
    cockpit_widget_button,
    cockpit_widget_checkbox,
    cockpit_widget_dropdown,
    cockpit_widget_heading,
    cockpit_widget_input,
    cockpit_widget_input_ex,
    cockpit_widget_label,
