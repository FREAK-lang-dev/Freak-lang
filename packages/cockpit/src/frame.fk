use self::blackbox::{
    cockpit_bb_draw_clear,
    cockpit_blackbox_height,
    cockpit_blackbox_width
}
use self::layout::{
    cockpit_layout_begin_frame
}
use self::state::{
    cockpit_fail,
    cockpit_ui_clip_depth
}
use self::theme::{
    cockpit_theme_bg,
    cockpit_theme_gap,
    cockpit_theme_get,
    cockpit_theme_padding
}
use self::toast::{
    cockpit_toast_theme,
    cockpit_toasts_capture_click,
    cockpit_toasts_draw
}
use self::widgets::{
    cockpit_popup_draw
}

-- The part of a frame that doesn't care where events come from or where the
-- drawing goes. The window (ui.fk) and the flight sim (flight.fk) both call
-- these after they've fed the frame's events and sized the black box.

task cockpit_frame_start(layout: ByteBuffer, theme: int) -> void {
    cockpit_ui_clip_depth = 0
    cockpit_toast_theme = theme
    cockpit_toasts_capture_click()
    cockpit_bb_draw_clear(cockpit_theme_get(theme, cockpit_theme_bg))
    cockpit_layout_begin_frame(layout, cockpit_blackbox_width(), cockpit_blackbox_height(), cockpit_theme_get(theme, cockpit_theme_padding), cockpit_theme_get(theme, cockpit_theme_gap))
}

task cockpit_frame_finish() -> void {
    if cockpit_ui_clip_depth != 0 { cockpit_fail("COCKPIT unclosed clipped container") }
    cockpit_toasts_draw(0)
    cockpit_popup_draw(0)
}
