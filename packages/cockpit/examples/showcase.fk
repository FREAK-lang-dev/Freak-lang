-- COCKPIT V3 procedural showcase. Fixed-frame and single-window by design.

task main() {
    pilot window = cockpit_ui_open("FREAK COCKPIT V3", 720, 520, true)
    if window == 0 { panic("COCKPIT window creation failed") }
    pilot layout: ByteBuffer = ByteBuffer::with_capacity(cockpit_layout_capacity())
    pilot theme = cockpit_theme_alternative()
    pilot tabs = cockpit_words_new()
    cockpit_words_push(tabs, "Widgets")
    cockpit_words_push(tabs, "Status")
    pilot choices = cockpit_words_new()
    cockpit_words_push(choices, "Alternative")
    cockpit_words_push(choices, "Terminal")
    cockpit_words_push(choices, "Light")
    pilot selected_tab = 0
    pilot selected_choice = 0
    pilot enabled = true
    pilot input_text = "FREAKING WORKS"
    pilot progress = 0

    repeat 240 times {
        cockpit_ui_begin_frame(window, layout, theme)
        if cockpit_ui_should_close() {
            cockpit_words_release(choices)
            cockpit_words_release(tabs)
            cockpit_theme_release(theme)
            cockpit_layout_release(layout)
            cockpit_ui_close(window)
            give back
        }
        cockpit_widget_heading(window, layout, theme, "COCKPIT V3")
        cockpit_widget_label(window, layout, theme, "Procedural handles. Raw events. No retained tree.")
        cockpit_widget_separator(window, layout, theme)
        selected_tab = cockpit_widget_tabs(window, layout, theme, selected_tab, tabs)
        cockpit_widget_spacer(layout, 8)
        if selected_tab == 0 {
            cockpit_row_begin(layout, 190, cockpit_theme_get(theme, cockpit_theme_gap))
            cockpit_column_begin(layout, 310, cockpit_theme_get(theme, cockpit_theme_gap))
            cockpit_widget_label(window, layout, theme, "Input")
            input_text = cockpit_widget_input(window, layout, theme, input_text, 290)
            enabled = cockpit_widget_checkbox(window, layout, theme, "Enable launch", enabled)
            selected_choice = cockpit_widget_dropdown(window, layout, theme, selected_choice, choices)
            cockpit_container_end(layout)
            cockpit_column_begin(layout, 310, cockpit_theme_get(theme, cockpit_theme_gap))
            cockpit_widget_label(window, layout, theme, "Progress")
            cockpit_widget_progress(window, layout, theme, progress, word_from_int(progress / 10) + "%")
            if cockpit_widget_button(window, layout, theme, "Advance", 130) {
                progress += 100
                if progress > 1000 { progress = 0 }
            }
            cockpit_container_end(layout)
            cockpit_container_end(layout)
        } else {
            cockpit_widget_label(window, layout, theme, "Indexed event processing is active.")
            cockpit_widget_progress(window, layout, theme, 1000, "READY")
        }
        cockpit_ui_end_frame(window)
    }
    cockpit_words_release(choices)
    cockpit_words_release(tabs)
    cockpit_theme_release(theme)
    cockpit_layout_release(layout)
    cockpit_ui_close(window)
}
