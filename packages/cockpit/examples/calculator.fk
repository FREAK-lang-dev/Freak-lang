-- COCKPIT V3 calculator. Close the native window to exit.

task cockpit_calculate(pending: num, current: num, operation: int) -> num {
    if operation == 1 { give back pending + current }
    if operation == 2 { give back pending - current }
    if operation == 3 { give back pending * current }
    if operation == 4 and current != 0.0 { give back pending / current }
    give back current
}

task main() {
    pilot window = cockpit_ui_open("FREAK Calculator", 340, 470, false)
    if window == 0 { cockpit_fail("calculator window creation failed") }
    pilot layout: ByteBuffer = ByteBuffer::with_capacity(cockpit_layout_capacity())
    pilot theme = cockpit_theme_dark()
    pilot display = "0"
    pilot pending = 0.0
    pilot operation = 0
    pilot fresh = true

    repeat until cockpit_ui_should_close() {
        cockpit_ui_begin_frame(window, layout, theme)
        if cockpit_ui_should_close() {
            cockpit_theme_release(theme)
            cockpit_layout_release(layout)
            cockpit_ui_close(window)
            give back
        }
        cockpit_widget_heading(window, layout, theme, display)
        cockpit_widget_separator(window, layout, theme)
        cockpit_row_begin(layout, 48, 6)
        if cockpit_widget_button(window, layout, theme, "C", 70) { display = "0" operation = 0 fresh = true }
        if cockpit_widget_button(window, layout, theme, "/", 70) { pending = parse_num(display) operation = 4 fresh = true }
        if cockpit_widget_button(window, layout, theme, "*", 70) { pending = parse_num(display) operation = 3 fresh = true }
        if cockpit_widget_button(window, layout, theme, "-", 70) { pending = parse_num(display) operation = 2 fresh = true }
        cockpit_container_end(layout)

        pilot digit = 7
        repeat 3 times {
            cockpit_row_begin(layout, 48, 6)
            repeat 3 times {
                pilot label = word_from_int(digit)
                if cockpit_widget_button(window, layout, theme, label, 70) {
                    if fresh or display == "0" { display = label }
                    else { display = display + label }
                    fresh = false
                }
                digit += 1
            }
            if digit == 10 {
                if cockpit_widget_button(window, layout, theme, "+", 70) { pending = parse_num(display) operation = 1 fresh = true }
            } else { cockpit_widget_spacer(layout, 0) }
            cockpit_container_end(layout)
            if digit == 10 { digit = 4 }
            else if digit == 7 { digit = 1 }
        }

        cockpit_row_begin(layout, 48, 6)
        if cockpit_widget_button(window, layout, theme, "0", 146) {
            if fresh { display = "0" }
            else { display = display + "0" }
            fresh = false
        }
        if cockpit_widget_button(window, layout, theme, ".", 70) {
            if fresh { display = "0" }
            if not display.contains(".") { display = display + "." }
            fresh = false
        }
        if cockpit_widget_button(window, layout, theme, "=", 70) {
            display = format_num(cockpit_calculate(pending, parse_num(display), operation))
            operation = 0
            fresh = true
        }
        cockpit_container_end(layout)
        cockpit_ui_end_frame(window)
    }
    cockpit_theme_release(theme)
    cockpit_layout_release(layout)
    cockpit_ui_close(window)
}
