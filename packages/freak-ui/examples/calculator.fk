-- FREAK Calculator — freak-ui reference implementation
-- The app that proves freak-ui works.
--
-- "It was always going to be a calculator."

use std::ui::{Window, WindowConfig, Event, EVENT_QUIT}
use freak_ui::{UI, Theme, SizeHint, BTN_NORMAL, BTN_OPERATOR, BTN_EQUALS, LABEL_DISPLAY}

-- ================================================================
--  Calculator state
-- ================================================================

shape CalcState {
    display:   word
    pending:   num
    has_pending: bool
    op:        int
    fresh:     bool
}

-- Operation constants
fixed pilot OP_NONE = 0
fixed pilot OP_ADD  = 1
fixed pilot OP_SUB  = 2
fixed pilot OP_MUL  = 3
fixed pilot OP_DIV  = 4

impl CalcState {
    task new() -> CalcState {
        give back CalcState {
            display:     "0",
            pending:     0.0,
            has_pending: false,
            op:          OP_NONE,
            fresh:       false
        }
    }

    task append_digit(self, digit: word) -> void {
        if self.fresh or self.display == "0" {
            self.display = digit
            self.fresh = false
        } else {
            self.display = self.display + digit
        }
    }

    task set_op(self, op: int) -> void {
        self.pending = word_to_num(self.display)
        self.has_pending = true
        self.op = op
        self.fresh = true
    }

    task clear(self) -> void {
        self.display = "0"
        self.pending = 0.0
        self.has_pending = false
        self.op = OP_NONE
        self.fresh = false
    }

    task negate(self) -> void {
        pilot val = word_to_num(self.display) * -1.0
        self.display = num_to_word(val)
    }

    task percent(self) -> void {
        pilot val = word_to_num(self.display) / 100.0
        self.display = num_to_word(val)
    }

    task calculate(self) -> void {
        if not self.has_pending { give back }

        pilot current = word_to_num(self.display)
        pilot result = 0.0

        if self.op == OP_ADD { result = self.pending + current }
        if self.op == OP_SUB { result = self.pending - current }
        if self.op == OP_MUL { result = self.pending * current }
        if self.op == OP_DIV {
            if current == 0.0 {
                self.display = "Error"
                self.has_pending = false
                self.op = OP_NONE
                self.fresh = true
                give back
            }
            result = self.pending / current
        }

        self.display = num_to_word(result)
        self.has_pending = false
        self.op = OP_NONE
        self.fresh = true
    }
}

-- ================================================================
--  Main
-- ================================================================

@protagonist
task main() {
    pilot win = Window::open(WindowConfig {
        title:     "FREAK Calculator",
        width:     320,
        height:    480,
        resizable: false,
        vsync:     true
    })

    pilot state = CalcState::new()
    pilot ui = UI::new(win, Theme::alternative())

    pilot running = true
    repeat 999999 times {
        if not running { give back }

        pilot events = ui.begin_frame()

        -- Check for quit
        pilot e = 0
        repeat events.len() times {
            if events[e].kind == EVENT_QUIT {
                running = false
            }
            e = e + 1
        }

        -- Display
        ui.begin_column(8.0, 16.0)
            ui.label_styled(state.display, LABEL_DISPLAY)
            ui.spacer(8.0)

            -- Row 1: C, +/-, %, /
            ui.begin_row(8.0, 0.0)
                if ui.button_styled("C", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.clear()
                }
                if ui.button_styled("+/-", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.negate()
                }
                if ui.button_styled("%", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.percent()
                }
                if ui.button_styled("/", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.set_op(OP_DIV)
                }
            ui.end_row()

            -- Row 2: 7, 8, 9, *
            ui.begin_row(8.0, 0.0)
                if ui.button_styled("7", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("7")
                }
                if ui.button_styled("8", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("8")
                }
                if ui.button_styled("9", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("9")
                }
                if ui.button_styled("*", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.set_op(OP_MUL)
                }
            ui.end_row()

            -- Row 3: 4, 5, 6, -
            ui.begin_row(8.0, 0.0)
                if ui.button_styled("4", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("4")
                }
                if ui.button_styled("5", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("5")
                }
                if ui.button_styled("6", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("6")
                }
                if ui.button_styled("-", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.set_op(OP_SUB)
                }
            ui.end_row()

            -- Row 4: 1, 2, 3, +
            ui.begin_row(8.0, 0.0)
                if ui.button_styled("1", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("1")
                }
                if ui.button_styled("2", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("2")
                }
                if ui.button_styled("3", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit("3")
                }
                if ui.button_styled("+", BTN_OPERATOR, SizeHint::fraction(0.25)) {
                    state.set_op(OP_ADD)
                }
            ui.end_row()

            -- Row 5: 0, ., =
            ui.begin_row(8.0, 0.0)
                if ui.button_styled("0", BTN_NORMAL, SizeHint::fraction(0.5)) {
                    state.append_digit("0")
                }
                if ui.button_styled(".", BTN_NORMAL, SizeHint::fraction(0.25)) {
                    state.append_digit(".")
                }
                if ui.button_styled("=", BTN_EQUALS, SizeHint::fraction(0.25)) {
                    state.calculate()
                }
            ui.end_row()

        ui.end_column()

        ui.end_frame()
    }

    win.close()
}

-- ================================================================
--  Helpers (would normally be in std::convert)
-- ================================================================

task word_to_num(s: word) -> num {
    -- Runtime provides this
    give back parse_num(s)
}

task num_to_word(n: num) -> word {
    -- Runtime provides this
    give back format_num(n)
}
