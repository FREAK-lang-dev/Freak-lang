-- ===================================================================
-- FREAK Runtime — LLVM filesystem wrappers
-- ===================================================================
-- FREAK wrappers use a checked source reader and i64 libc stream bridges.
--
-- NOTE: Task names omit the "freak_" prefix because the LLVM backend
-- automatically adds "@freak_" to all user-defined tasks.
-- So "task llvm_fs_read(...)" becomes "@freak_llvm_fs_read" in IR.
-- ===================================================================

-- ── i64 wrapper declarations (defined by the native runtime) ─
-- These bridges carry pointers and owned filesystem tickets as integers.
extern task freak_fopen(path: int, mode: int) -> int
extern task freak_fclose(file: int) -> int
extern task freak_fseek(file: int, offset: int, whence: int) -> int
extern task freak_ftell(file: int) -> int
extern task freak_fread(buf: int, size: int, count: int, file: int) -> int
extern task freak_fwrite(buf: int, size: int, count: int, file: int) -> int
extern task freak_ferror(file: int) -> int
extern task freak_calloc(count: int, size: int) -> int
extern task freak_llvm_word_adopt(pointer: int) -> int
extern task freak_llvm_word_adopt_sized(pointer: int, length: int) -> int
extern task freak_remove(path: int) -> int
extern task freak_path_exists(path: int) -> int
extern task freak_llvm_word_length(s: int) -> int
extern task freak_llvm_fs_read_source_ticket(path: int) -> int
extern task freak_llvm_fs_result_ok(ticket: int) -> int
extern task freak_llvm_fs_result_word(ticket: int) -> int
extern task freak_llvm_fs_result_release(ticket: int) -> void

-- ── fs::read — read entire file contents ─────────────
task llvm_fs_read(path_p: int) -> int {
    -- Reuse the checked source reader: nonblocking regular-file admission,
    -- 64-bit measurement, seek/read/EOF/error/close checks, and sized raw bytes.
    -- The word getter clones its owner before the result ticket is released.
    pilot read_ticket = freak_llvm_fs_read_source_ticket(path_p)
    if freak_llvm_fs_result_ok(read_ticket) == 0 {
        freak_llvm_fs_result_release(read_ticket)
        panic("FREAK: cannot read complete file")
    }
    pilot contents = freak_llvm_fs_result_word(read_ticket)
    freak_llvm_fs_result_release(read_ticket)
    give back contents
}

-- ── fs::write — write string to file (overwrite) ────
task llvm_fs_write(path_p: int, content_p: int) -> void {
    pilot f = freak_fopen(path_p, "wb")
    if f == 0 {
        panic("FREAK: cannot write file")
    }
    pilot len = freak_llvm_word_length(content_p)
    pilot count = freak_fwrite(content_p, 1, len, f)
    pilot stream_error = freak_ferror(f)
    pilot closed = freak_fclose(f)
    if count != len or stream_error != 0 or closed != 0 {
        panic("FREAK: could not complete file write")
    }
}

-- ── fs::append — append string to file ───────────────
task llvm_fs_append(path_p: int, content_p: int) -> void {
    pilot f = freak_fopen(path_p, "ab")
    if f == 0 {
        panic("FREAK: cannot append file")
    }
    pilot len = freak_llvm_word_length(content_p)
    pilot count = freak_fwrite(content_p, 1, len, f)
    pilot stream_error = freak_ferror(f)
    pilot closed = freak_fclose(f)
    if count != len or stream_error != 0 or closed != 0 {
        panic("FREAK: could not complete file write")
    }
}

-- ── fs::exists — check if file exists ────────────────
task llvm_fs_exists(path_p: int) -> int {
    give back freak_path_exists(path_p)
}

-- ── fs::delete — delete a file ───────────────────────
task llvm_fs_delete(path_p: int) -> int {
    give back freak_remove(path_p)
}
