-- ===================================================================
-- FREAK Standard Library — std::algorithm
-- ===================================================================
-- Sorting, searching, and array utility algorithms in pure FREAK.
-- array_* tasks work on array_new() handles; list_* tasks take and give
-- back a List. Sorts are stable O(n log n) merge sorts.
-- ===================================================================

-- Sort an integer array in place (stable bottom-up merge sort, O(n log n)).
-- handle: array handle from array_new(). Elements keep their original text.
task array_sort_int(handle: int) -> void {
    pilot alen = array_len(handle)
    if alen <= 1 { give back }
    pilot mut keys: List<int> = []
    pilot mut words: List<word> = []
    pilot mut idx: List<int> = []
    pilot mut tmp: List<int> = []
    keys.reserve(alen)
    words.reserve(alen)
    idx.reserve(alen)
    tmp.reserve(alen)
    pilot mut i = 0
    pilot mut sorted = true
    repeat alen times {
        pilot w: word = array_get(handle, i)
        pilot k = word_to_int(w)
        if i > 0 and k < keys[i - 1] { sorted = false }
        keys.push(k)
        words.push(w)
        idx.push(i)
        tmp.push(0)
        i += 1
    }
    if sorted { give back }
    pilot mut width = 1
    repeat until width >= alen {
        pilot mut lo = 0
        repeat until lo >= alen {
            pilot mut mid = lo + width
            if mid > alen { mid = alen }
            pilot mut hi = lo + width * 2
            if hi > alen { hi = alen }
            pilot mut a = lo
            pilot mut b = mid
            pilot mut k = lo
            repeat until k >= hi {
                pilot mut take_left = false
                if a < mid {
                    if b >= hi {
                        take_left = true
                    } else if keys[idx[a]] <= keys[idx[b]] {
                        take_left = true
                    }
                }
                if take_left {
                    tmp[k] = idx[a]
                    a += 1
                } else {
                    tmp[k] = idx[b]
                    b += 1
                }
                k += 1
            }
            lo = hi
        }
        pilot mut c = 0
        repeat alen times {
            idx[c] = tmp[c]
            c += 1
        }
        width = width * 2
    }
    i = 0
    repeat alen times {
        array_set(handle, i, words[idx[i]])
        i += 1
    }
}

-- Sort a word array in place (stable merge sort by unsigned bytes, the
-- same order as freak_word_compare).
task array_sort_word(handle: int) -> void {
    pilot alen = array_len(handle)
    if alen <= 1 { give back }
    pilot mut words: List<word> = []
    pilot mut idx: List<int> = []
    pilot mut tmp: List<int> = []
    words.reserve(alen)
    idx.reserve(alen)
    tmp.reserve(alen)
    pilot mut i = 0
    repeat alen times {
        pilot w: word = array_get(handle, i)
        words.push(w)
        idx.push(i)
        tmp.push(0)
        i += 1
    }
    pilot mut width = 1
    repeat until width >= alen {
        pilot mut lo = 0
        repeat until lo >= alen {
            pilot mut mid = lo + width
            if mid > alen { mid = alen }
            pilot mut hi = lo + width * 2
            if hi > alen { hi = alen }
            pilot mut a = lo
            pilot mut b = mid
            pilot mut k = lo
            repeat until k >= hi {
                pilot mut take_left = false
                if a < mid {
                    if b >= hi {
                        take_left = true
                    } else if freak_word_compare(words[idx[a]], words[idx[b]]) <= 0 {
                        take_left = true
                    }
                }
                if take_left {
                    tmp[k] = idx[a]
                    a += 1
                } else {
                    tmp[k] = idx[b]
                    b += 1
                }
                k += 1
            }
            lo = hi
        }
        pilot mut c = 0
        repeat alen times {
            idx[c] = tmp[c]
            c += 1
        }
        width = width * 2
    }
    i = 0
    repeat alen times {
        array_set(handle, i, words[idx[i]])
        i += 1
    }
}

-- Lexicographic comparison: returns -1, 0, or 1.
-- Uses the C runtime's strcmp-based comparison for correct ordering.
extern task freak_word_compare(a: word, b: word) -> int

-- Binary search on a sorted integer array. Returns index or -1.
task array_binary_search_int(handle: int, target: int) -> int {
    pilot mut lo = 0
    pilot mut hi = array_len(handle) - 1
    repeat until lo > hi {
        pilot range = hi - lo
        pilot half = range / 2
        pilot mid = lo + half
        pilot mw: word = array_get(handle, mid)
        pilot mv = word_to_int(mw)
        if mv == target { give back mid }
        if mv < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    give back 0 - 1
}

-- Linear search in an array. Returns index or -1.
task array_find(handle: int, target: word) -> int {
    pilot alen = array_len(handle)
    pilot mut fi = 0
    repeat alen times {
        pilot fw: word = array_get(handle, fi)
        if fw == target { give back fi }
        fi += 1
    }
    give back 0 - 1
}

-- Check if an array contains a value.
task array_contains(handle: int, target: word) -> bool {
    give back array_find(handle, target) >= 0
}

-- Reverse an array in-place.
task array_reverse(handle: int) -> void {
    pilot alen = array_len(handle)
    if alen <= 1 { give back }
    pilot mut lo = 0
    pilot mut hi = alen - 1
    repeat until lo >= hi {
        pilot tmp: word = array_get(handle, lo)
        pilot hw: word = array_get(handle, hi)
        array_set(handle, lo, hw)
        array_set(handle, hi, tmp)
        lo += 1
        hi -= 1
    }
}

-- Copy elements from one array to a new array.
task array_copy(handle: int) -> int {
    pilot new_arr = array_new()
    pilot alen = array_len(handle)
    pilot mut ci = 0
    repeat alen times {
        pilot cw: word = array_get(handle, ci)
        array_push(new_arr, cw)
        ci += 1
    }
    give back new_arr
}

-- Join array elements into a single word with separator.
task array_join(handle: int, sep: word) -> word {
    pilot alen = array_len(handle)
    if alen == 0 { give back "" }
    pilot b = word_builder::new()
    pilot mut ji = 0
    repeat alen times {
        if ji > 0 { word_builder::append(b, sep) }
        word_builder::append(b, array_get(handle, ji))
        ji += 1
    }
    give back word_builder::finish(b)
}

-- Count occurrences of a value in an array.
task array_count(handle: int, target: word) -> int {
    pilot alen = array_len(handle)
    pilot mut cnt = 0
    pilot mut ci = 0
    repeat alen times {
        pilot cw: word = array_get(handle, ci)
        if cw == target { cnt += 1 }
        ci += 1
    }
    give back cnt
}

-- Remove duplicates from a sorted array (in-place). Returns new length.
task array_unique(handle: int) -> int {
    pilot alen = array_len(handle)
    if alen <= 1 { give back alen }
    pilot mut write_idx = 1
    pilot mut ri = 1
    repeat until ri >= alen {
        pilot cur: word = array_get(handle, ri)
        pilot prev: word = array_get(handle, ri - 1)
        if cur != prev {
            array_set(handle, write_idx, cur)
            write_idx += 1
        }
        ri += 1
    }
    give back write_idx
}

-- Sum all integer values in an array.
task array_sum_int(handle: int) -> int {
    pilot alen = array_len(handle)
    pilot mut total = 0
    pilot mut si = 0
    repeat alen times {
        pilot sw: word = array_get(handle, si)
        total += word_to_int(sw)
        si += 1
    }
    give back total
}

-- Find the maximum integer value in an array. Returns 0 for empty.
task array_max_int(handle: int) -> int {
    pilot alen = array_len(handle)
    if alen == 0 { give back 0 }
    pilot mw: word = array_get(handle, 0)
    pilot mut mx = word_to_int(mw)
    pilot mut mi = 1
    repeat until mi >= alen {
        pilot cw: word = array_get(handle, mi)
        pilot cv = word_to_int(cw)
        if cv > mx { mx = cv }
        mi += 1
    }
    give back mx
}

-- Find the minimum integer value in an array. Returns 0 for empty.
task array_min_int(handle: int) -> int {
    pilot alen = array_len(handle)
    if alen == 0 { give back 0 }
    pilot mw: word = array_get(handle, 0)
    pilot mut mn = word_to_int(mw)
    pilot mut mi = 1
    repeat until mi >= alen {
        pilot cw: word = array_get(handle, mi)
        pilot cv = word_to_int(cw)
        if cv < mn { mn = cv }
        mi += 1
    }
    give back mn
}

-- Sort a List<int> in place, ascending (stable merge sort), and give it back:
--   pilot sorted = list_sort_int(values)
task list_sort_int(values: List<int>) -> List<int> {
    pilot mut xs = values
    pilot n = xs.length()
    if n <= 1 { give back xs }
    pilot mut tmp: List<int> = []
    tmp.reserve(n)
    pilot mut i = 0
    pilot mut sorted = true
    repeat n times {
        if i > 0 and xs[i] < xs[i - 1] { sorted = false }
        tmp.push(0)
        i += 1
    }
    if sorted { give back xs }
    pilot mut width = 1
    repeat until width >= n {
        pilot mut lo = 0
        repeat until lo >= n {
            pilot mut mid = lo + width
            if mid > n { mid = n }
            pilot mut hi = lo + width * 2
            if hi > n { hi = n }
            pilot mut a = lo
            pilot mut b = mid
            pilot mut k = lo
            repeat until k >= hi {
                pilot mut take_left = false
                if a < mid {
                    if b >= hi {
                        take_left = true
                    } else if xs[a] <= xs[b] {
                        take_left = true
                    }
                }
                if take_left {
                    tmp[k] = xs[a]
                    a += 1
                } else {
                    tmp[k] = xs[b]
                    b += 1
                }
                k += 1
            }
            lo = hi
        }
        pilot mut c = 0
        repeat n times {
            xs[c] = tmp[c]
            c += 1
        }
        width = width * 2
    }
    give back xs
}

-- Sort a List<word> in place by unsigned bytes (stable) and give it back.
task list_sort_word(values: List<word>) -> List<word> {
    pilot mut xs = values
    pilot n = xs.length()
    if n <= 1 { give back xs }
    pilot mut idx: List<int> = []
    pilot mut tmp: List<int> = []
    idx.reserve(n)
    tmp.reserve(n)
    pilot mut i = 0
    repeat n times {
        idx.push(i)
        tmp.push(0)
        i += 1
    }
    pilot mut width = 1
    repeat until width >= n {
        pilot mut lo = 0
        repeat until lo >= n {
            pilot mut mid = lo + width
            if mid > n { mid = n }
            pilot mut hi = lo + width * 2
            if hi > n { hi = n }
            pilot mut a = lo
            pilot mut b = mid
            pilot mut k = lo
            repeat until k >= hi {
                pilot mut take_left = false
                if a < mid {
                    if b >= hi {
                        take_left = true
                    } else if freak_word_compare(xs[idx[a]], xs[idx[b]]) <= 0 {
                        take_left = true
                    }
                }
                if take_left {
                    tmp[k] = idx[a]
                    a += 1
                } else {
                    tmp[k] = idx[b]
                    b += 1
                }
                k += 1
            }
            lo = hi
        }
        pilot mut c = 0
        repeat n times {
            idx[c] = tmp[c]
            c += 1
        }
        width = width * 2
    }
    pilot mut out: List<word> = []
    out.reserve(n)
    i = 0
    repeat n times {
        out.push(xs[idx[i]])
        i += 1
    }
    give back out
}
