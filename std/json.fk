-- ===================================================================
-- FREAK Standard Library — std::json
-- ===================================================================
-- A JSON parser, builder and serializer written in pure FREAK.
-- For strict, document-scoped RFC 8259 parsing with explicit lifetimes
-- use std::json_document; this module is the lenient legacy pool.
--
-- Parse with: json_parse(source) -> handle (int)
--   json_ok() / json_last_error() / json_error_pos() report the first
--   problem of the last parse (nothing is printed). On error the handle of
--   whatever was read is still returned, as before.
-- Access with: json_get_type ("s" | "n" | "b" | "null" | "a" | "o"),
--   json_get_str, json_get_int, json_get_num, json_get_bool, json_is_null
-- Object access: json_obj_get(handle, key) -> child handle (-1 if absent),
--   json_obj_len, json_obj_key_at, json_obj_has
-- Array access: json_arr_len, json_arr_get(handle, index) -> child handle
-- Build with: json_new_null/bool/int/num/str/array/object,
--   json_arr_push(array, child), json_obj_set(object, key, child)
-- Serialize with: json_stringify(handle) -> word (compact, escaped)
--   json_stringify_pretty(handle, indent) -> word
-- Free every value with json_reset(); handles become invalid.
--
-- Strings decode \" \\ \/ \b \f \n \r \t and \uXXXX (surrogate pairs
-- become one code point; a lone surrogate becomes U+FFFD). Numbers keep
-- their source text, including exponents.
--
-- Storage: one pool of nodes in Lists, no array handle per container, so
-- documents of any size fit (the LLVM array pool allows 1024 live arrays).
-- A container's children (and object keys) are a slice of the shared edge
-- lists: json_start[h] .. json_start[h] + json_size[h]. Parsed containers
-- are packed exactly; pushing past json_cap[h] moves the slice to the end.
-- The parser is one loop over a ByteBuffer copy of the source with an
-- explicit container stack: reading integer bytes is about ten times
-- faster than comparing one-byte words, and nesting never recurses.
-- No ByteBuffer outlives a call.
-- ===================================================================

-- Node pool
pilot mut json_types: List<word> = []
pilot mut json_vals: List<word> = []
pilot mut json_start: List<int> = []
pilot mut json_size: List<int> = []
pilot mut json_cap: List<int> = []
pilot mut json_count = 0
pilot mut json_inited = 0

-- Children of every container, sliced by json_start/json_size.
pilot mut json_edges: List<int> = []
pilot mut json_edge_keys: List<word> = []

-- Parser state
pilot mut json_src = ""
pilot mut json_pos = 0
pilot mut json_len = 0
pilot mut json_depth = 0
pilot mut json_err = ""
pilot mut json_err_at = 0 - 1
pilot mut json_stack: List<int> = []
pilot mut json_stack_keys: List<word> = []

task json_init() -> void {
    json_inited = 1
}

-- Release every pooled value. All existing handles become invalid.
task json_reset() -> void {
    json_types.clear()
    json_vals.clear()
    json_start.clear()
    json_size.clear()
    json_cap.clear()
    json_edges.clear()
    json_edge_keys.clear()
    json_stack.clear()
    json_stack_keys.clear()
    json_src = ""
    json_count = 0
    json_inited = 0
}

-- Allocate a new JSON value slot, returns its index.
task json_alloc(jtype: word, jval: word) -> int {
    pilot idx = json_count
    json_types.push(jtype)
    json_vals.push(jval)
    json_start.push(0)
    json_size.push(0)
    json_cap.push(0)
    json_count += 1
    give back idx
}

-- === Errors ===

task json_fail(message: word) -> void {
    if json_err == "" {
        json_err = message
        json_err_at = json_pos
    }
}

-- True when the last json_parse found no error.
task json_ok() -> bool {
    give back json_err == ""
}

-- The first error of the last json_parse, or "".
task json_last_error() -> word {
    give back json_err + ""
}

-- Byte offset of the first error of the last json_parse, or -1.
task json_error_pos() -> int {
    give back json_err_at
}

-- === Accessors ===

task json_get_type(handle: int) -> word {
    give back json_types[handle]
}

task json_get_str(handle: int) -> word {
    give back json_vals[handle]
}

task json_get_int(handle: int) -> int {
    pilot v: word = json_vals[handle]
    give back word_to_int(v)
}

task json_get_num(handle: int) -> num {
    pilot v: word = json_vals[handle]
    give back v.to_num()
}

task json_get_bool(handle: int) -> bool {
    pilot v: word = json_vals[handle]
    give back v == "true"
}

task json_is_null(handle: int) -> bool {
    pilot t: word = json_types[handle]
    give back t == "null"
}

task json_arr_len(handle: int) -> int {
    give back json_size[handle]
}

task json_arr_get(handle: int, index: int) -> int {
    if index < 0 or index >= json_size[handle] { give back 0 - 1 }
    give back json_edges[json_start[handle] + index]
}

task json_obj_len(handle: int) -> int {
    give back json_size[handle]
}

task json_obj_get(handle: int, key: word) -> int {
    pilot base = json_start[handle]
    pilot mut ki = 0
    repeat json_size[handle] times {
        pilot k: word = json_edge_keys[base + ki]
        if k == key { give back json_edges[base + ki] }
        ki += 1
    }
    give back 0 - 1
}

task json_obj_has(handle: int, key: word) -> bool {
    give back json_obj_get(handle, key) >= 0
}

task json_obj_key_at(handle: int, index: int) -> word {
    if index < 0 or index >= json_size[handle] { give back "" }
    give back json_edge_keys[json_start[handle] + index]
}

-- === Builders ===

task json_new_null() -> int {
    give back json_alloc("null", "")
}

task json_new_bool(value: bool) -> int {
    if value { give back json_alloc("b", "true") }
    give back json_alloc("b", "false")
}

task json_new_int(value: int) -> int {
    give back json_alloc("n", word_from_int(value))
}

-- Shortest-effort text that parses back to exactly value: the 10-digit
-- num.to_word() form when it round-trips, otherwise 17 significant digits
-- nudged until strtod returns value. Finite input only.
task json_num_word(value: num) -> word {
    pilot quick = value.to_word()
    if quick.to_num() == value { give back quick }
    pilot mut x = value
    if value < 0.0 { x = 0.0 - value }
    pilot mut scaled = x
    pilot mut e = 0
    repeat until scaled < 10.0 {
        scaled = scaled / 10.0
        e += 1
    }
    repeat until scaled >= 1.0 {
        scaled = scaled * 10.0
        e -= 1
    }
    pilot mut m = math::floor(scaled * 10000000000000000.0 + 0.5).to_int()
    pilot mut tries = 0
    repeat until tries >= 64 {
        if m >= 100000000000000000 {
            m = m / 10
            e += 1
        }
        if m < 10000000000000000 {
            m = m * 10
            e -= 1
        }
        pilot digits = word_from_int(m)
        pilot mut cut = 17
        repeat until cut <= 1 or digits.char_at(cut - 1) != "0" { cut -= 1 }
        pilot mut text = digits.substring(0, 1)
        if cut > 1 { text = text + "." + digits.substring(1, cut - 1) }
        if e != 0 { text = text + "e" + word_from_int(e) }
        if value < 0.0 { text = "-" + text }
        pilot parsed = text.to_num()
        if parsed == value { give back text }
        -- Step the mantissa by the relative miss (at least one unit, at most
        -- a million); text that overflowed to infinity steps down.
        pilot mut step = 0 - 1
        if parsed - parsed == 0.0 {
            pilot mut miss = (value - parsed) / value * m.to_num()
            if miss > 1000000.0 { miss = 1000000.0 }
            if miss < 0.0 - 1000000.0 { miss = 0.0 - 1000000.0 }
            step = math::floor(miss + 0.5).to_int()
            if step == 0 {
                if (parsed < value) == (value > 0.0) { step = 1 } else { step = 0 - 1 }
            }
        }
        m += step
        tries += 1
    }
    give back quick
}

-- NaN and infinities have no JSON spelling and become null. Other values
-- keep full double precision (json_get_num gives back the same num).
task json_new_num(value: num) -> int {
    if value != value or value - value != 0.0 { give back json_alloc("null", "") }
    give back json_alloc("n", json_num_word(value))
}

task json_new_str(value: word) -> int {
    give back json_alloc("s", value)
}

task json_new_array() -> int {
    give back json_alloc("a", "")
}

task json_new_object() -> int {
    give back json_alloc("o", "")
}

-- Make room for one more child of container h, moving its slice to the
-- end of the edge lists when it is full.
task json_grow(h: int) -> void {
    pilot size = json_size[h]
    pilot cap = json_cap[h]
    if size < cap { give back }
    pilot mut new_cap = cap * 2
    if new_cap < 4 { new_cap = 4 }
    pilot old_start = json_start[h]
    pilot new_start = json_edges.length()
    pilot mut i = 0
    repeat new_cap times {
        if i < size {
            json_edges.push(json_edges[old_start + i])
            json_edge_keys.push(json_edge_keys[old_start + i])
        } else {
            json_edges.push(0 - 1)
            json_edge_keys.push("")
        }
        i += 1
    }
    json_start[h] = new_start
    json_cap[h] = new_cap
}

task json_arr_push(array: int, child: int) -> void {
    json_grow(array)
    pilot slot = json_start[array] + json_size[array]
    json_edges[slot] = child
    json_size[array] = json_size[array] + 1
}

-- Replaces the value of an existing key, otherwise appends the key.
task json_obj_set(object: int, key: word, child: int) -> void {
    pilot base = json_start[object]
    pilot mut ki = 0
    repeat json_size[object] times {
        pilot k: word = json_edge_keys[base + ki]
        if k == key {
            json_edges[base + ki] = child
            give back
        }
        ki += 1
    }
    json_grow(object)
    pilot slot = json_start[object] + json_size[object]
    json_edges[slot] = child
    json_edge_keys[slot] = key
    json_size[object] = json_size[object] + 1
}

-- === Parser ===

-- Pack the children collected on the parse stack since base into the
-- container's exact slice, then pop them. Object keys sit on their own
-- stack from key_base (-1 for arrays).
task json_close_container(h: int, base: int, key_base: int) -> void {
    pilot count = json_stack.length() - base
    json_start[h] = json_edges.length()
    json_size[h] = count
    json_cap[h] = count
    pilot mut i = 0
    repeat count times {
        json_edges.push(json_stack[base + i])
        if key_base >= 0 {
            json_edge_keys.push(json_stack_keys[key_base + i])
        } else {
            json_edge_keys.push("")
        }
        i += 1
    }
    repeat count times {
        pilot dropped_child = json_stack.pop()
        if key_base >= 0 { pilot dropped_key = json_stack_keys.pop() }
    }
}

-- Records "expected 'ch' got 'x'" (or "... but the input ended"). Like the
-- legacy parser, the error position is just past the offending byte.
task json_fail_expected(ch: word, pos: int) -> void {
    pilot c = json_src.char_at(pos)
    if c == "" {
        json_pos = pos
        json_fail("expected '" + ch + "' but the input ended")
    } else {
        json_pos = pos + 1
        json_fail("expected '" + ch + "' got '" + c + "'")
    }
}

-- One iterative pass over the source bytes (a ByteBuffer local to this
-- task) with an explicit container stack, so nesting never recurses.
-- Modes: 0 value, 1 object key, 2 colon, 3 just opened, 4 after a value.
task json_parse(source: word) -> int {
    json_init()
    json_len = source.length()
    pilot len = json_len
    pilot buf = ByteBuffer::with_capacity(len)
    buf.write_word(source.repeated(1))
    json_src = source
    json_pos = 0
    json_depth = 0
    json_err = ""
    json_err_at = 0 - 1
    json_stack.clear()
    json_stack_keys.clear()
    pilot mut frames: List<int> = []
    pilot mut frame_base: List<int> = []
    pilot mut frame_keys: List<int> = []
    pilot mut root = 0 - 1
    pilot mut pos = 0
    pilot mut mode = 0
    pilot mut finished = false
    repeat until finished {
        -- Skip whitespace and look at the next byte (-1 at the end).
        pilot mut b = 0 - 1
        if pos < len {
            buf.seek(pos)
            b = buf.read_byte()
            repeat until pos >= len or not (b == 32 or b == 10 or b == 13 or b == 9) {
                pos += 1
                if pos < len { b = buf.read_byte() } else { b = 0 - 1 }
            }
        }
        pilot depth = frames.length()
        pilot mut is_obj = false
        if depth > 0 { is_obj = frame_keys[depth - 1] >= 0 }
        pilot mut node = 0 - 2
        if mode == 2 {
            if b == 58 {
                pos += 1
            } else {
                json_fail_expected(":", pos)
                pos += 1
            }
            mode = 0
        } else if mode == 3 or mode == 4 {
            pilot mut close = 93
            pilot mut close_ch = "]"
            if is_obj {
                close = 125
                close_ch = "}"
            }
            if mode == 3 and b != close {
                if is_obj { mode = 1 } else { mode = 0 }
            } else if mode == 4 and b == 44 {
                pos += 1
                if is_obj { mode = 1 } else { mode = 0 }
            } else {
                if b != close { json_fail_expected(close_ch, pos) }
                pos += 1
                node = frames.pop()
                json_close_container(node, frame_base.pop(), frame_keys.pop())
                json_depth -= 1
            }
        } else if b == 34 {
            -- String (a value, or a key in mode 1)
            pos += 1
            pilot sb = word_builder::new()
            pilot mut run_start = pos
            pilot mut closed = false
            buf.seek(pos)
            repeat until closed or pos >= len {
                pilot v = buf.read_byte()
                if v == 34 {
                    if pos > run_start { word_builder::append(sb, json_src.substring(run_start, pos - run_start)) }
                    pos += 1
                    closed = true
                } else if v == 92 {
                    if pos > run_start { word_builder::append(sb, json_src.substring(run_start, pos - run_start)) }
                    pilot mut esc = 0 - 1
                    if pos + 1 < len { esc = buf.read_byte() }
                    pos += 2
                    if esc == 110 {
                        word_builder::append(sb, "\n")
                    } else if esc == 116 {
                        word_builder::append(sb, "\t")
                    } else if esc == 114 {
                        word_builder::append(sb, "\r")
                    } else if esc == 92 {
                        word_builder::append(sb, "\\")
                    } else if esc == 34 {
                        word_builder::append(sb, "\"")
                    } else if esc == 47 {
                        word_builder::append(sb, "/")
                    } else if esc == 98 {
                        word_builder::append(sb, char_to_word(8))
                    } else if esc == 102 {
                        word_builder::append(sb, char_to_word(12))
                    } else if esc == 117 {
                        -- \uXXXX, joining a surrogate pair into one code point
                        pilot mut cp = 65533
                        pilot mut units = 0
                        pilot mut first = 0 - 1
                        pilot mut reading = true
                        repeat until not reading {
                            pilot mut value = 0 - 1
                            if pos + 4 <= len {
                                buf.seek(pos)
                                value = 0
                                repeat 4 times {
                                    pilot h = buf.read_byte()
                                    pilot mut d = 0 - 1
                                    if h >= 48 and h <= 57 {
                                        d = h - 48
                                    } else if h >= 97 and h <= 102 {
                                        d = h - 87
                                    } else if h >= 65 and h <= 70 {
                                        d = h - 55
                                    }
                                    if d < 0 or value < 0 {
                                        value = 0 - 1
                                    } else {
                                        value = value * 16 + d
                                    }
                                }
                            }
                            reading = false
                            if value < 0 {
                                json_pos = pos
                                json_fail("bad \\u escape")
                                if units > 0 { pos -= 2 }
                            } else if units == 0 {
                                pos += 4
                                if value >= 55296 and value <= 56319 {
                                    first = value
                                    units = 1
                                    buf.seek(pos)
                                    if pos + 1 < len and buf.read_byte() == 92 and buf.read_byte() == 117 {
                                        pos += 2
                                        reading = true
                                    }
                                } else if value < 56320 or value > 57343 {
                                    cp = value
                                }
                            } else if value >= 56320 and value <= 57343 {
                                pos += 4
                                cp = 65536 + (first - 55296) * 1024 + (value - 56320)
                            } else {
                                -- Not a low surrogate: read it as its own escape.
                                pos -= 2
                            }
                        }
                        word_builder::append(sb, char_to_word(cp))
                    } else if esc < 0 {
                        pos = len
                    } else {
                        -- Unknown escape: keep the escaped character (lenient).
                        word_builder::append(sb, json_src.char_at(pos - 1))
                    }
                    run_start = pos
                    if pos < len { buf.seek(pos) }
                } else {
                    pos += 1
                }
            }
            if not closed {
                if len > run_start { word_builder::append(sb, json_src.substring(run_start, len - run_start)) }
                json_pos = len
                json_fail("unterminated string")
            }
            pilot text = word_builder::finish(sb)
            if mode == 1 {
                json_stack_keys.push(text)
                mode = 2
            } else {
                node = json_alloc("s", text)
            }
        } else if mode == 1 {
            json_fail_expected("\"", pos)
            pos += 1
            json_stack_keys.push("")
            mode = 2
        } else if b == 45 or (b >= 48 and b <= 57) {
            -- Number text, kept as written: -?digits[.digits][(e|E)[+-]digits]
            pilot start = pos
            pos += 1
            pilot mut prev = b
            pilot mut scanning = true
            repeat until not scanning or pos >= len {
                pilot v = buf.read_byte()
                if (v >= 48 and v <= 57) or v == 46 or v == 101 or v == 69 {
                    pos += 1
                } else if (v == 43 or v == 45) and (prev == 101 or prev == 69) {
                    pos += 1
                } else {
                    scanning = false
                }
                prev = v
            }
            node = json_alloc("n", json_src.substring(start, pos - start))
        } else if b == 116 and json_src.substring(pos, 4) == "true" {
            pos += 4
            node = json_alloc("b", "true")
        } else if b == 102 and json_src.substring(pos, 5) == "false" {
            pos += 5
            node = json_alloc("b", "false")
        } else if b == 110 and json_src.substring(pos, 4) == "null" {
            pos += 4
            node = json_alloc("null", "")
        } else if (b == 91 or b == 123) and depth >= 512 {
            json_pos = pos
            json_fail("nesting deeper than 512 levels")
            -- Unwind every open container without reading further.
            pos = len
            node = 0 - 1
        } else if b == 91 or b == 123 {
            pos += 1
            json_depth += 1
            if b == 91 {
                frames.push(json_alloc("a", ""))
                frame_keys.push(0 - 1)
            } else {
                frames.push(json_alloc("o", ""))
                frame_keys.push(json_stack_keys.length())
            }
            frame_base.push(json_stack.length())
            mode = 3
        } else {
            json_pos = pos
            if b < 0 {
                json_fail("unexpected end of input")
            } else {
                json_fail("unexpected '" + json_src.char_at(pos) + "'")
            }
            node = 0 - 1
        }
        if node != 0 - 2 {
            if frames.length() == 0 {
                root = node
                finished = true
            } else {
                json_stack.push(node)
                mode = 4
            }
        }
    }
    -- Anything but whitespace after the root value is an error.
    if pos < len {
        buf.seek(pos)
        pilot mut trailing = false
        repeat until trailing or pos >= len {
            pilot v = buf.read_byte()
            if v == 32 or v == 10 or v == 13 or v == 9 { pos += 1 } else { trailing = true }
        }
        if trailing {
            json_pos = pos
            json_fail("unexpected trailing characters")
        }
    }
    buf.release()
    json_pos = pos
    json_src = ""
    give back root
}

-- === Serializer ===

-- Appends value as a quoted JSON string: quote, backslash and control
-- characters are escaped; other bytes (including UTF-8) are copied.
-- Builder handles are owned, so writers take the builder and give it back.
task json_write_quoted(b: int, value: word) -> int {
    word_builder::append(b, "\"")
    pilot vlen = value.length()
    pilot buf = ByteBuffer::with_capacity(vlen)
    buf.write_word(value.repeated(1))
    buf.seek(0)
    pilot mut run_start = 0
    pilot mut i = 0
    repeat vlen times {
        pilot v = buf.read_byte()
        if v == 34 or v == 92 or v < 32 {
            if i > run_start { word_builder::append(b, value.substring(run_start, i - run_start)) }
            if v == 34 {
                word_builder::append(b, "\\\"")
            } else if v == 92 {
                word_builder::append(b, "\\\\")
            } else if v == 10 {
                word_builder::append(b, "\\n")
            } else if v == 13 {
                word_builder::append(b, "\\r")
            } else if v == 9 {
                word_builder::append(b, "\\t")
            } else if v == 8 {
                word_builder::append(b, "\\b")
            } else if v == 12 {
                word_builder::append(b, "\\f")
            } else {
                pilot digits = "0123456789abcdef"
                word_builder::append(b, "\\u00" + digits.char_at(v / 16) + digits.char_at(v - v / 16 * 16))
            }
            run_start = i + 1
        }
        i += 1
    }
    buf.release()
    if run_start == 0 {
        word_builder::append(b, value)
    } else if vlen > run_start {
        word_builder::append(b, value.substring(run_start, vlen - run_start))
    }
    word_builder::append(b, "\"")
    give back b
}

-- indent < 0 writes compact JSON; otherwise one value per line.
task json_write_value(b: int, handle: int, indent: int, depth: int) -> int {
    if handle < 0 {
        word_builder::append(b, "null")
        give back b
    }
    pilot t: word = json_types[handle]
    if t == "s" {
        give back json_write_quoted(b, json_vals[handle])
    }
    if t == "n" or t == "b" {
        word_builder::append(b, json_vals[handle])
        give back b
    }
    if t == "a" or t == "o" {
        pilot size = json_size[handle]
        if size == 0 {
            if t == "a" { word_builder::append(b, "[]") } else { word_builder::append(b, "{}") }
            give back b
        }
        pilot mut w = b
        if t == "a" { word_builder::append(w, "[") } else { word_builder::append(w, "{") }
        pilot base = json_start[handle]
        pilot mut i = 0
        repeat size times {
            if i > 0 { word_builder::append(w, ",") }
            if indent >= 0 { word_builder::append(w, "\n" + " ".repeated(indent * (depth + 1))) }
            if t == "o" {
                w = json_write_quoted(w, json_edge_keys[base + i])
                if indent >= 0 { word_builder::append(w, ": ") } else { word_builder::append(w, ":") }
            }
            w = json_write_value(w, json_edges[base + i], indent, depth + 1)
            i += 1
        }
        if indent >= 0 { word_builder::append(w, "\n" + " ".repeated(indent * depth)) }
        if t == "a" { word_builder::append(w, "]") } else { word_builder::append(w, "}") }
        give back w
    }
    word_builder::append(b, "null")
    give back b
}

task json_stringify(handle: int) -> word {
    pilot b = json_write_value(word_builder::new(), handle, 0 - 1, 0)
    give back word_builder::finish(b)
}

-- Pretty-printed JSON with indent spaces per level (indent < 0 is compact).
task json_stringify_pretty(handle: int, indent: int) -> word {
    pilot b = json_write_value(word_builder::new(), handle, indent, 0)
    give back word_builder::finish(b)
}
