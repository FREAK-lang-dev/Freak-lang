-- ===================================================================
-- FREAK Standard Library — std::string
-- ===================================================================
-- Word helpers in pure FREAK, built on the native word methods
-- (substring, contains, replace, repeated, char_at) and word_builder.
-- Every task here is linear in its input: results are built once with a
-- builder or a single substring instead of re-copying the partial result
-- for each character.
--
-- Offsets and lengths are UTF-8 byte counts, like word.length() and
-- word.substring(start, length). string_char_count counts code points.
--
-- Each task scans its own input with native methods instead of calling
-- another std task inside a loop, because a word passed to a task is
-- moved (under --strict-borrow) or copied (legacy builds).
-- ===================================================================

task string_repeat(s: word, count: int) -> word {
    give back s.repeated(count)
}

task string_pad_left(s: word, width: int, pad_char: word) -> word {
    pilot slen = s.length()
    if slen >= width { give back s }
    give back pad_char.repeated(width - slen) + s
}

task string_pad_right(s: word, width: int, pad_char: word) -> word {
    pilot slen = s.length()
    if slen >= width { give back s }
    give back s + pad_char.repeated(width - slen)
}

-- Pads both sides; the extra pad (odd remainder) goes on the right.
task string_center(s: word, width: int, pad_char: word) -> word {
    pilot slen = s.length()
    if slen >= width { give back s }
    pilot total = width - slen
    pilot left = total / 2
    give back pad_char.repeated(left) + s + pad_char.repeated(total - left)
}

-- Reverses by UTF-8 code point, so "héllo" becomes "olléh". Bytes that are
-- not part of a well-formed sequence (truncated, overlong, surrogate, stray
-- continuation) are reversed byte by byte; embedded NUL bytes are preserved.
task string_reverse(s: word) -> word {
    pilot slen = s.length()
    if slen <= 1 { give back s }
    pilot b = word_builder::with_capacity(slen)
    pilot mut end = slen
    repeat until end <= 0 {
        pilot c = s.char_at(end - 1)
        if c < "\x80" {
            word_builder::append(b, c)
            end -= 1
        } else {
            pilot mut start = end - 1
            pilot mut back = 0
            pilot mut scanning = c <= "\xBF"
            repeat until not scanning {
                if start > 0 and back < 3 {
                    start -= 1
                    back += 1
                    pilot p = s.char_at(start)
                    scanning = p >= "\x80" and p <= "\xBF"
                } else {
                    scanning = false
                }
            }
            if back > 0 {
                -- Keep the group only when it is one well-formed UTF-8 scalar:
                -- a lead byte whose length matches the continuation run, with
                -- no overlong, surrogate or above-U+10FFFF encoding. Anything
                -- else is malformed: emit the last byte alone.
                pilot lead = s.char_at(start)
                pilot second = s.char_at(start + 1)
                pilot mut want = 0
                if lead >= "\xC2" and lead <= "\xDF" { want = 2 }
                if lead >= "\xE0" and lead <= "\xEF" { want = 3 }
                if lead >= "\xF0" and lead <= "\xF4" { want = 4 }
                pilot mut good = want == end - start
                if lead == "\xE0" and second < "\xA0" { good = false }
                if lead == "\xED" and second > "\x9F" { good = false }
                if lead == "\xF0" and second < "\x90" { good = false }
                if lead == "\xF4" and second > "\x8F" { good = false }
                if not good { start = end - 1 }
            }
            if end - start == 1 {
                word_builder::append(b, c)
            } else {
                word_builder::append(b, s.substring(start, end - start))
            }
            end = start
        }
    }
    give back word_builder::finish(b)
}

-- Number of UTF-8 code points (bytes that are not continuation bytes).
task string_char_count(s: word) -> int {
    pilot slen = s.length()
    pilot mut count = 0
    pilot mut i = 0
    repeat until i >= slen {
        pilot c = s.char_at(i)
        if not (c >= "\x80" and c <= "\xBF") { count += 1 }
        i += 1
    }
    give back count
}

-- Overlapping occurrences: string_count("aaaa", "aa") == 3.
task string_count(haystack: word, needle: word) -> int {
    pilot hlen = haystack.length()
    pilot nlen = needle.length()
    if nlen == 0 or nlen > hlen { give back 0 }
    if not haystack.contains(needle.repeated(1)) { give back 0 }
    pilot first = needle.char_at(0)
    pilot last = needle.char_at(nlen - 1)
    pilot limit = hlen - nlen
    pilot mut count = 0
    pilot mut i = 0
    repeat until i > limit {
        if haystack.char_at(i) == first {
            if haystack.char_at(i + nlen - 1) == last {
                if nlen <= 2 {
                    count += 1
                } else if haystack.substring(i, nlen) == needle {
                    count += 1
                }
            }
        }
        i += 1
    }
    give back count
}

-- Returns pipe-delimited segments: string_split("a,b,c", ",") == "a|b|c".
-- Delimiters are matched left to right without overlap.
task string_split(s: word, delim: word) -> word {
    if delim.length() == 0 { give back s }
    give back s.replace(delim, "|")
}

-- Joins pipe-delimited segments: string_join("a|b|c", "-") == "a-b-c".
task string_join(parts: word, separator: word) -> word {
    if parts.length() == 0 { give back "" }
    give back parts.replace("|", separator)
}

task is_digit(c: word) -> bool {
    if c.length() != 1 { give back false }
    give back c >= "0" and c <= "9"
}

task is_alpha(c: word) -> bool {
    if c.length() != 1 { give back false }
    if c >= "a" and c <= "z" { give back true }
    give back c >= "A" and c <= "Z"
}

task is_whitespace(c: word) -> bool {
    give back c == " " or c == "\t" or c == "\n" or c == "\r"
}

task string_starts_with(s: word, prefix: word) -> bool {
    give back s.starts_with(prefix)
}

task string_ends_with(s: word, suffix: word) -> bool {
    give back s.ends_with(suffix)
}

-- An empty needle is not "contained" (kept from the original API).
task string_contains(haystack: word, needle: word) -> bool {
    if needle.length() == 0 { give back false }
    give back haystack.contains(needle)
}

-- Trims space, tab, CR and LF from both ends (not other whitespace).
task string_trim(s: word) -> word {
    pilot slen = s.length()
    pilot mut start = 0
    pilot mut scanning = true
    repeat until not scanning or start >= slen {
        pilot c = s.char_at(start)
        if c == " " or c == "\t" or c == "\n" or c == "\r" { start += 1 } else { scanning = false }
    }
    if start >= slen { give back "" }
    pilot mut end = slen
    scanning = true
    repeat until not scanning or end <= start {
        pilot c = s.char_at(end - 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r" { end -= 1 } else { scanning = false }
    }
    if start == 0 and end == slen { give back s }
    give back s.substring(start, end - start)
}

-- Legacy helper: the trimmed text from tstart to the last non-whitespace byte.
task string_trim_end(s: word, tstart: int) -> word {
    pilot mut end = s.length()
    pilot mut scanning = true
    repeat until not scanning or end <= tstart {
        pilot c = s.char_at(end - 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r" { end -= 1 } else { scanning = false }
    }
    if end <= tstart { give back "" }
    give back s.substring(tstart, end - tstart)
}

task string_trim_left(s: word) -> word {
    pilot slen = s.length()
    pilot mut start = 0
    pilot mut scanning = true
    repeat until not scanning or start >= slen {
        pilot c = s.char_at(start)
        if c == " " or c == "\t" or c == "\n" or c == "\r" { start += 1 } else { scanning = false }
    }
    if start == 0 { give back s }
    give back s.substring(start, slen - start)
}

task string_trim_right(s: word) -> word {
    pilot slen = s.length()
    pilot mut end = slen
    pilot mut scanning = true
    repeat until not scanning or end <= 0 {
        pilot c = s.char_at(end - 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r" { end -= 1 } else { scanning = false }
    }
    if end == slen { give back s }
    give back s.substring(0, end)
}

-- True for "" and for words made only of space, tab, CR and LF.
task string_is_blank(s: word) -> bool {
    pilot slen = s.length()
    pilot mut i = 0
    repeat until i >= slen {
        pilot c = s.char_at(i)
        if not (c == " " or c == "\t" or c == "\n" or c == "\r") { give back false }
        i += 1
    }
    give back true
}

-- Non-overlapping, left to right: string_replace("ababa", "ab", "X") == "XXa".
task string_replace(s: word, old_str: word, new_str: word) -> word {
    if old_str.length() == 0 { give back s }
    give back s.replace(old_str, new_str)
}

-- Bytes from start_idx up to (not including) end_idx, clamped to the word.
task string_substring(s: word, start_idx: int, end_idx: int) -> word {
    pilot slen = s.length()
    pilot mut ss = start_idx
    pilot mut se = end_idx
    if ss < 0 { ss = 0 }
    if se > slen { se = slen }
    if ss >= se { give back "" }
    give back s.substring(ss, se - ss)
}

-- First byte offset of needle, or -1. An empty needle is found at 0.
task string_index_of(s: word, needle: word) -> int {
    pilot slen = s.length()
    pilot nlen = needle.length()
    if nlen == 0 { give back 0 }
    if nlen > slen { give back 0 - 1 }
    if not s.contains(needle.repeated(1)) { give back 0 - 1 }
    pilot first = needle.char_at(0)
    pilot last = needle.char_at(nlen - 1)
    pilot limit = slen - nlen
    pilot mut i = 0
    repeat until i > limit {
        if s.char_at(i) == first {
            if s.char_at(i + nlen - 1) == last {
                if nlen <= 2 { give back i }
                if s.substring(i, nlen) == needle { give back i }
            }
        }
        i += 1
    }
    give back 0 - 1
}

-- First byte offset of needle at or after from (clamped to 0), or -1.
-- An empty needle is found at from when from is inside the word.
task string_index_of_from(s: word, needle: word, from: int) -> int {
    pilot slen = s.length()
    pilot nlen = needle.length()
    pilot mut i = from
    if i < 0 { i = 0 }
    if nlen == 0 {
        if i <= slen { give back i }
        give back 0 - 1
    }
    if i + nlen > slen { give back 0 - 1 }
    pilot first = needle.char_at(0)
    pilot last = needle.char_at(nlen - 1)
    pilot limit = slen - nlen
    repeat until i > limit {
        if s.char_at(i) == first {
            if s.char_at(i + nlen - 1) == last {
                if nlen <= 2 { give back i }
                if s.substring(i, nlen) == needle { give back i }
            }
        }
        i += 1
    }
    give back 0 - 1
}

-- Last byte offset of needle, or -1. An empty needle is found at the end.
task string_last_index_of(s: word, needle: word) -> int {
    pilot slen = s.length()
    pilot nlen = needle.length()
    if nlen == 0 { give back slen }
    if nlen > slen { give back 0 - 1 }
    if not s.contains(needle.repeated(1)) { give back 0 - 1 }
    pilot first = needle.char_at(0)
    pilot last = needle.char_at(nlen - 1)
    pilot mut i = slen - nlen
    repeat until i < 0 {
        if s.char_at(i) == first {
            if s.char_at(i + nlen - 1) == last {
                if nlen <= 2 { give back i }
                if s.substring(i, nlen) == needle { give back i }
            }
        }
        i -= 1
    }
    give back 0 - 1
}

-- Removes prefix once when present; otherwise returns s unchanged.
task string_strip_prefix(s: word, prefix: word) -> word {
    pilot plen = prefix.length()
    if plen == 0 or not s.starts_with(prefix) { give back s }
    give back s.substring(plen, s.length() - plen)
}

-- Removes suffix once when present; otherwise returns s unchanged.
task string_strip_suffix(s: word, suffix: word) -> word {
    pilot xlen = suffix.length()
    if xlen == 0 or not s.ends_with(suffix) { give back s }
    give back s.substring(0, s.length() - xlen)
}
