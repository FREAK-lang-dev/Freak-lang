# Tell GitHub linguist that .fk files are FREAK (show as primary language)
*.fk linguist-language=swift
*.fk linguist-detectable=true

# Python is only the bootstrap compiler — don't count it as primary
freakc/*.py linguist-vendored=true

# Generated C files from the compiler
*.fk.c linguist-generated=true
*.fk.ll linguist-generated=true

# Build artifacts
build/freakc_v2.fk linguist-generated=true
build/freakc_cli.fk linguist-generated=true

# Shell consumers parse this field-by-field; keep the canonical payload map LF.
packaging/distribution-files.manifest text eol=lf

# Windows CI and installed POSIX entrypoints must remain executable by Bash.
*.sh text eol=lf

# Checked-read byte fixture must retain LF in Windows checkouts.
src/compiler/v4/tests/data/h6_io_readable_source.fk text eol=lf

# FS bridge support is accepted by exact SHA-256; preserve its LF source bytes.
tests/v4_c_integer_runtime.py text eol=lf

# Typed OS fixture oracles pin these bootstrap sources by their exact LF bytes.
freakc/lexer.py text eol=lf
freakc/parser.py text eol=lf
freakc/type_checker.py text eol=lf

# Unicode generation is checked against the table header's exact UTF-8 LF bytes.
freakc/runtime/freak_v4_unicode_lower_tables.h text eol=lf
