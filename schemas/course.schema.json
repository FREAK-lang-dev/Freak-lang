{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freak-lang.dev/schemas/course.schema.json",
  "title": "FREAK Academy Course",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "languageVersion",
    "compilerTrack",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "languageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "compilerTrack": {
      "type": "string",
      "enum": ["v3", "v4"]
    },
    "repositoryPhase": {
      "type": "string",
      "enum": ["main-repo", "split-ready", "dedicated-repo"]
    },
    "websitePath": {
      "type": "string",
      "pattern": "^/"
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    }
  }
}
