{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freak-lang.dev/schemas/lesson.schema.json",
  "title": "FREAK Academy Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "courseId",
    "title",
    "order",
    "languageVersion",
    "compilerTrack",
    "objectives",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "languageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "compilerTrack": {
      "type": "string",
      "enum": ["v3", "v4"]
    },
    "supportLevel": {
      "type": "string",
      "enum": ["v3-mvp", "v4-planned", "stable"]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "conceptIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "introduction",
            "demonstration",
            "explanation",
            "exercise",
            "quiz",
            "summary"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "expectedOutput": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "starter": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "parses",
            "compiles",
            "symbol_exists",
            "symbol_type",
            "constant_value",
            "function_exists",
            "function_signature",
            "calls_function",
            "printed_symbol",
            "construct_used",
            "operator_used",
            "expected_output",
            "tests_pass",
            "diagnostic_expected",
            "diagnostic_absent"
          ]
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "choices", "answer"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
